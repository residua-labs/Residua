-- provenance: ours (searched: glue/std/Str.rsd)
-- glue/std/Json.rsd — JSON read/write for glue tools.
-- Cursor-style API over raw Bs slices: a parsed value is the byte slice of
-- its source text (zero-copy), accessors scan it; object member order is file
-- order and numbers keep their literal bytes. The arena rejects recursion
-- under a type parameter (inductive JVal with `List JVal`),
-- so values stay slices instead of a tree.
--
--   jParse bs        validate; [trimmed-value slice] or [] (Option patterns
--   are refused at check — maybe-results ride as 0-or-1 element lists)
--   jKindOf v        1 obj, 2 arr, 3 str, 4 num, 5 lit(true/false/null), 0 bad
--   jGet key obj     first member named key -> its value slice
--   jArrOf arr       element slices in order
--   jStrOf strlit    decoded bytes of a string literal
--   jNumOf numlit    literal bytes
--   jQ s / jObjB ps / jArrB vs / jLitB b — emit side (write)

import Glue.Std.Str

structure JP where
  rest : Bs
  err : Int   -- 0 ok

def jBad (r : Bs) : JP := { rest := r, err := 1 }
def jOk (r : Bs) : JP := { rest := r, err := 0 }

def jSkipWs : Bs → Bs
  | b :: bs => if sIsSpace b then jSkipWs bs else b :: bs
  | [] => []

def jLit (lit : Bs) (r : Bs) : Bool := sStarts lit r

-- decode a JSON string literal body start (after the opening quote):
-- decoded bytes + rest after the closing quote; err>0 on bad escape.
structure JStrOut where
  s : Bs
  rest : Bs
  err : Int

def jHexDig (b : Int) : Int :=
  if decide (48 <= b) && decide (b <= 57) then b - 48
  else if decide (97 <= b) && decide (b <= 102) then b - 87
  else if decide (65 <= b) && decide (b <= 70) then b - 55
  else -1

def jUtf8 (cp : Int) : Bs :=
  if cp < 128 then [cp]
  else if cp < 2048 then [192 + cp / 64, 128 + cp % 64]
  else [224 + cp / 4096, 128 + (cp / 64) % 64, 128 + cp % 64]

def jStrGo (acc : Bs) : Bs → JStrOut
  | [] => { s := sRev acc, rest := [], err := 1 }
  | 34 :: bs => { s := sRev acc, rest := bs, err := 0 }
  | 92 :: e :: bs =>
    if decide (e == 110) then jStrGo (10 :: acc) bs
    else if decide (e == 116) then jStrGo (9 :: acc) bs
    else if decide (e == 114) then jStrGo (13 :: acc) bs
    else if decide (e == 98) then jStrGo (8 :: acc) bs
    else if decide (e == 102) then jStrGo (12 :: acc) bs
    else if decide (e == 117) then
      match bs with
      | a :: b :: c :: d :: t =>
        let x1 := jHexDig a
        let x2 := jHexDig b
        let x3 := jHexDig c
        let x4 := jHexDig d
        if x1 < 0 || x2 < 0 || x3 < 0 || x4 < 0 then { s := sRev acc, rest := t, err := 1 }
        else jStrGo (sRev (jUtf8 (x1 * 4096 + x2 * 256 + x3 * 16 + x4)) ++ acc) t
      | _ => { s := sRev acc, rest := [], err := 1 }
    else if sInSet e [34, 92, 47] then jStrGo (e :: acc) bs
    else { s := sRev acc, rest := bs, err := 1 }
  | b :: bs => jStrGo (b :: acc) bs

structure JNumOut where
  lit : Bs
  rest : Bs

def jNumGo (acc : Bs) : Bs → JNumOut
  | [] => { lit := sRev acc, rest := [] }
  | b :: bs =>
    if sIsDigit b || sInSet b [45, 43, 46, 101, 69] then jNumGo (b :: acc) bs
    else { lit := sRev acc, rest := b :: bs }

-- scan one value's extent without materializing it; rest = bytes after it.
mutual
partial def jScanArr : Bs → JP
  | r =>
    match jSkipWs r with
    | [] => jBad []
    | 93 :: t => jOk t
    | r0 =>
      let p := jScan r0
      if p.err != 0 then jBad p.rest
      else match jSkipWs p.rest with
        | 44 :: t => jScanArr t
        | 93 :: t => jOk t
        | t => jBad t

partial def jScanObj : Bs → JP
  | r =>
    match jSkipWs r with
    | [] => jBad []
    | 125 :: t => jOk t
    | 34 :: t =>
      let sk := jStrGo [] t
      if sk.err != 0 then jBad sk.rest
      else match jSkipWs sk.rest with
        | 58 :: t2 =>
          let p := jScan (jSkipWs t2)
          if p.err != 0 then jBad p.rest
          else match jSkipWs p.rest with
            | 44 :: t3 => jScanObj t3
            | 125 :: t3 => jOk t3
            | t3 => jBad t3
        | t2 => jBad t2
    | r1 => jBad r1

partial def jScan : Bs → JP
  | r0 =>
    match jSkipWs r0 with
    | [] => jBad []
    | 123 :: t => jScanObj t
    | 91 :: t => jScanArr t
    | 34 :: t =>
      let sk := jStrGo [] t
      if sk.err != 0 then jBad sk.rest else jOk sk.rest
    | 116 :: t => if jLit [114, 117, 101] t then jOk (sDrop 3 t) else jBad t
    | 102 :: t => if jLit [97, 108, 115, 101] t then jOk (sDrop 4 t) else jBad t
    | 110 :: t => if jLit [117, 108, 108] t then jOk (sDrop 3 t) else jBad t
    | b :: t =>
      if sIsDigit b || decide (b == 45) then jOk (jNumGo [b] t).rest
      else jBad (b :: t)
end

def jParse (bs : Bs) : List Bs :=
  let v := jSkipWs bs
  let p := jScan v
  if p.err != 0 then []
  else if jSkipWs p.rest != [] then []
  else [sTake (sLen v - sLen p.rest) v]

def jKindOf (v : Bs) : Int :=
  match jSkipWs v with
  | [] => 0
  | b :: _ =>
    if decide (b == 123) then 1
    else if decide (b == 91) then 2
    else if decide (b == 34) then 3
    else if sIsDigit b || decide (b == 45) then 4
    else 5

-- object member walk: returns the value slice for the FIRST key match.
-- obj is a raw `{...}` slice (as produced by jParse / jGet / jArrOf).
structure JGetOut where
  hit : List Bs
  rest : Bs
  err : Int

def jGetGo (key : Bs) : Bs → JGetOut
  | r =>
    match jSkipWs r with
    | [] => { hit := [], rest := [], err := 1 }
    | 125 :: t => { hit := [], rest := t, err := 0 }
    | 34 :: t =>
      let sk := jStrGo [] t
      if sk.err != 0 then { hit := [], rest := sk.rest, err := 1 }
      else match jSkipWs sk.rest with
        | 58 :: t2 =>
          let v0 := jSkipWs t2
          let p := jScan v0
          if p.err != 0 then { hit := [], rest := p.rest, err := 1 }
          else
            let vslice := sTake (sLen v0 - sLen p.rest) v0
            if sEq sk.s key then { hit := [vslice], rest := p.rest, err := 0 }
            else match jSkipWs p.rest with
              | 44 :: t3 => jGetGo key t3
              | 125 :: t3 => { hit := [], rest := t3, err := 0 }
              | t3 => { hit := [], rest := t3, err := 1 }
        | t2 => { hit := [], rest := t2, err := 1 }
    | r1 => { hit := [], rest := r1, err := 1 }

def jStrOf (v : Bs) : Bs :=
  match jSkipWs v with
  | 34 :: t => (jStrGo [] t).s
  | _ => []

-- monomorphic map of jStrOf (no recursive HOFs in the subset)
def jStrsOf : List Bs → List Bs
  | [] => []
  | v :: vs => jStrOf v :: jStrsOf vs

def jGet (key : Bs) (obj : Bs) : List Bs :=
  match jSkipWs obj with
  | 123 :: t => (jGetGo key t).hit
  | _ => []

def jGetStr (key : Bs) (obj : Bs) : Bs :=
  match jGet key obj with
  | v :: _ => jStrOf v
  | [] => []

-- array element walk: collect each element's raw slice.
structure JArrOut where
  acc : List Bs
  rest : Bs
  err : Int

partial def jArrGo (acc : List Bs) : Bs → JArrOut
  | r =>
    match jSkipWs r with
    | [] => { acc := acc, rest := [], err := 1 }
    | 93 :: t => { acc := acc, rest := t, err := 0 }
    | r0 =>
      let p := jScan r0
      if p.err != 0 then { acc := acc, rest := p.rest, err := 1 }
      else
        let e := sTake (sLen r0 - sLen p.rest) r0
        match jSkipWs p.rest with
        | 44 :: t => jArrGo (e :: acc) t
        | 93 :: t => { acc := e :: acc, rest := t, err := 0 }
        | t => { acc := e :: acc, rest := t, err := 1 }

def jArrOf (arr : Bs) : List Bs :=
  match jSkipWs arr with
  | 91 :: t => sRevL (jArrGo [] t).acc
  | _ => []

def jNumOf (v : Bs) : Bs := sTrim v

def jBoolOf (v : Bs) : Bool := sStarts [116] (jSkipWs v)

-- ---------- emit (write side) ----------

def jEmitStr : Bs → Bs
  | [] => []
  | b :: bs =>
    if decide (b == 34) then [92, 34] ++ jEmitStr bs
    else if decide (b == 92) then [92, 92] ++ jEmitStr bs
    else if decide (b == 10) then [92, 110] ++ jEmitStr bs
    else if decide (b == 13) then [92, 114] ++ jEmitStr bs
    else if decide (b == 9) then [92, 116] ++ jEmitStr bs
    else b :: jEmitStr bs

-- quote a raw byte string as a JSON string literal
def jQ (s : Bs) : Bs := [34] ++ jEmitStr s ++ [34]

-- object member pair (no tuples in the rsdc subset)
structure JKV where
  k : Bs
  v : Bs

def jObjGo : List JKV → List Bs
  | [] => []
  | kv :: kvs => (jQ kv.k ++ [58] ++ kv.v) :: jObjGo kvs

-- object from already-encoded members; keys are raw strings
def jObjB (ps : List JKV) : Bs :=
  [123] ++ sJoin [44] (jObjGo ps) ++ [125]

-- array from already-encoded value bytes
def jArrB (vs : List Bs) : Bs := [91] ++ sJoin [44] vs ++ [93]

def jLitB (b : Bool) : Bs := if b then [116, 114, 117, 101] else [102, 97, 108, 115, 101]
