import WasmDecode

-- L19: clone the lowered source fast path, leaving drop_cold out of line.
-- Local banks belong to the caller and are reused by successive sites. Each
-- expansion restores Wasm's fresh-local semantics before running the body.
-- The block substitutes for the callee's implicit function label: a return
-- branches to that block, rather than returning from the enclosing caller.
structure RiCode where
  ok : Bool := false
  code : List Int := []

def riCat : List (List Int) → List Int → List Int
  | [], acc => acc
  | c :: cs, acc => riCat cs (c ++ acc)

def riJoin (chunks : List (List Int)) : List Int :=
  riCat chunks []

def riBody : Nat → Nat → Nat → Nat → List (List Int) → List Int → RiCode
  | 0, _, _, _, _, _ => {}
  | _ + 1, _, _, _, _, [] => {}
  | fuel + 1, base, slots, depth, acc, bs =>
    let i := rgStep bs
    if !i.ok then {}
    else if i.op == 11 && depth == 0 then
      if i.rest.isEmpty then { ok := true, code := riJoin ([11] :: acc) } else {}
    else if i.op == 32 || i.op == 33 || i.op == 34 then
      if i.n >= slots then {}
      else riBody fuel base slots depth ((i.op :: lebU (base + i.n)) :: acc) i.rest
    else if i.op == 15 then
      riBody fuel base slots depth (([12] ++ lebU depth) :: acc) i.rest
    else if i.op == 18 then {}
    else if i.op == 2 || i.op == 3 || i.op == 4 then
      riBody fuel base slots (depth + 1) (i.bs :: acc) i.rest
    else if i.op == 11 then
      riBody fuel base slots (depth - 1) (i.bs :: acc) i.rest
    else riBody fuel base slots depth (i.bs :: acc) i.rest

def riSaveArgs : Nat → Nat → List Int
  | _, 0 => []
  | base, n + 1 => ls (base + n) ++ riSaveArgs base n

def riZero : Nat → List Int → List Int
  | _, [] => []
  | base, ty :: tys =>
    (if ty == vtI64 then i64Const 0 else i32Const 0) ++ ls base ++ riZero (base + 1) tys

def riExpand (f : WFn) (base : Nat) : RiCode :=
  if !f.results.isEmpty || (f.params ++ f.locals).any (fun t => t != vtI64 && t != vtI32) then {}
  else
    let body := riBody (f.code.length + 1) base (f.params.length + f.locals.length) 0 [] f.code
    { ok := body.ok, code := riSaveArgs base f.params.length ++ riZero (base + f.params.length) f.locals
        ++ [2, 64] ++ body.code }

structure RiWalk where
  ok : Bool := false
  code : List Int := []
  locals : List Int := []
  dupBase : Nat := 0
  dropBase : Nat := 0
  dupCode : List Int := []
  dropCode : List Int := []
  hasDup : Bool := false
  hasDrop : Bool := false
  sites : Nat := 0
  size : Nat := 0

-- FABLE-EMIT-SIZE-0: the caller-size cap of the expansion, in bytes of the
-- caller's instruction code after it. A caller that would exceed the cap keeps its
-- `call 6` / `call 7` sites: the body stays in the runtime, as in Lean's
-- lean.h (lean_inc_ref, lean_dec_ref, lean_dec_ref_cold) and Koka's
-- kklib.h (kk_block_dup, kk_block_drop, kk_block_check_drop).
-- Rule: HotSpot C2 refuses an inline once the caller reaches
-- DesiredMethodLimit = 8000 bytecodes after inlining
-- (InlineTree::try_to_inline, opto/bytecodeInfo.cpp, "size >
-- DesiredMethodLimit"); GCC has the same shape in large-function-insns and
-- large-function-growth (ipa-inline.cc caller_growth_limits). The unit
-- here is the same: bytes of stack bytecode. The decision is per caller,
-- all or nothing: its sites carry no profile to rank them.
-- Cost: the initial code length and decoding can traverse the original
-- caller. With fixed runtime templates and bounded Wasm indices, the pass
-- is O(|code| + |params| + |locals|) plus attempted expansion work.
-- The cap counts instruction-code bytes, excluding encoded local groups.
def riCodeCap : Nat := 8000

mutual
partial def riSkipLeb1 (k fuel sz : Nat) : List Int → Bool
  | [] => false
  | b :: bs =>
    if k == 0 || sz > riCodeCap + 16 then false
    else if b < 128 then riHasSite fuel (sz + 1) bs
    else riSkipLeb1 (k - 1) fuel (sz + 1) bs

partial def riSkipLebN (m k fuel sz : Nat) : List Int → Bool
  | bs =>
    if m == 0 then riHasSite fuel sz bs
    else
      match bs with
      | [] => false
      | b :: rest =>
        if k == 0 || sz > riCodeCap + 16 then false
        else if b < 128 then riSkipLebN (m - 1) profile.lebSFuel fuel (sz + 1) rest
        else riSkipLebN m (k - 1) fuel (sz + 1) rest

partial def riCallIdx (k v place fuel sz : Nat) : List Int → Bool
  | [] => false
  | b :: bs =>
    if k == 0 || sz > riCodeCap + 16 then false
    else
      let low : Int := if b >= 128 then b - 128 else b
      let v2 := v + low.toNat * place
      if b < 128 then (v2 == 6 || v2 == 7) || riHasSite fuel (sz + 1) bs
      else riCallIdx (k - 1) v2 (place * 128) fuel (sz + 1) bs

partial def riBrTable (k v place fuel sz : Nat) : List Int → Bool
  | [] => false
  | b :: bs =>
    if k == 0 || sz > riCodeCap + 16 then false
    else
      let low : Int := if b >= 128 then b - 128 else b
      let v2 := v + low.toNat * place
      if b < 128 then riSkipLebN (v2 + 1) profile.lebSFuel fuel (sz + 1) bs
      else riBrTable (k - 1) v2 (place * 128) fuel (sz + 1) bs

partial def riHasSite (fuel sz : Nat) : List Int → Bool
  | [] => false
  | b :: r =>
    if fuel == 0 || sz > riCodeCap + 16 then false
    else if b == 16 then riCallIdx profile.lebSFuel 0 1 (fuel - 1) (sz + 1) r
    else if b == 65 || b == 66 || b == 32 || b == 33 || b == 34 || b == 12 || b == 13 || b == 18 || b == 8 then
      riSkipLeb1 profile.lebSFuel (fuel - 1) (sz + 1) r
    else if b == 2 || b == 3 || b == 4 then
      match r with
      | t :: r2 => (t == 64 || (t >= 123 && t <= 127)) && riHasSite (fuel - 1) (sz + 2) r2
      | [] => false
    else if b >= 40 && b <= 62 then
      riSkipLebN 2 profile.lebSFuel (fuel - 1) (sz + 1) r
    else if b == 63 || b == 64 then
      match r with
      | 0 :: r2 => riHasSite (fuel - 1) (sz + 2) r2
      | _ => false
    else if b == 14 then riBrTable profile.lebSFuel 0 1 (fuel - 1) (sz + 1) r
    else if b == 252 then
      match r with
      | 10 :: 0 :: 0 :: r2 => riHasSite (fuel - 1) (sz + 4) r2
      | 11 :: 0 :: r2 => riHasSite (fuel - 1) (sz + 3) r2
      | _ => false
    else if b == 0 || b == 1 || b == 5 || b == 11 || b == 15 || b == 26 || b == 27 || (b >= 69 && b <= 196) then
      riHasSite (fuel - 1) (sz + 1) r
    else false
end

-- Templates are exactly the two source-lowered functions, not guessed byte
-- sequences. A failed decode preserves the entire original function, and
-- so does a rewritten body larger than `cap` bytes.
def riWalk (dup drop : WFn) (np cap : Nat) : Nat → RiWalk → List (List Int) → List Int → RiWalk
  | 0, _, _, _ => {}
  | _ + 1, state, acc, [] => if state.sites == 0 then state else { state with ok := true, code := riJoin acc }
  | fuel + 1, state, acc, bs =>
    let i := rgStep bs
    if !i.ok || state.size > cap then {}
    else if i.op == 16 && (i.n == 6 || i.n == 7) then
      let isDup := i.n == 6
      let f := if isDup then dup else drop
      let present := if isDup then state.hasDup else state.hasDrop
      let base := if present then (if isDup then state.dupBase else state.dropBase) else np + state.locals.length
      let expansion := if present then { ok := true, code := if isDup then state.dupCode else state.dropCode } else riExpand f base
      if !expansion.ok then {}
      else
        let next := { state with
          locals := if present then state.locals else state.locals ++ f.params ++ f.locals
          dupBase := if isDup then base else state.dupBase
          dropBase := if isDup then state.dropBase else base
          dupCode := if isDup then expansion.code else state.dupCode
          dropCode := if isDup then state.dropCode else expansion.code
          hasDup := state.hasDup || isDup
          hasDrop := state.hasDrop || !isDup
          sites := state.sites + 1
          size := state.size + expansion.code.length }
        riWalk dup drop np cap fuel next (expansion.code :: acc) i.rest
    else riWalk dup drop np cap fuel { state with size := state.size + i.bs.length } (i.bs :: acc) i.rest

def riFunction (dup drop : WFn) (f : WFn) : WFn :=
  if !riHasSite (riCodeCap + 2) 0 f.code then f
  else
    let rewritten := riWalk dup drop f.params.length riCodeCap (f.code.length + 1) { locals := f.locals } [] f.code
    if rewritten.ok && rewritten.sites > 0 && rewritten.size ≤ riCodeCap then
      { f with code := rewritten.code, locals := rewritten.locals }
    else f

def runtimeInlineFns (lay : Layers) (rtCount : Nat) (fns : List WFn) : List WFn :=
  if !lay.rc then fns
  else
    let empty : WFn := { params := [], results := [], locals := [], code := [] }
    let dup := fns.getD 6 empty
    let drop := fns.getD 7 empty
    fns.take rtCount ++ (fns.drop rtCount).map (riFunction dup drop)
