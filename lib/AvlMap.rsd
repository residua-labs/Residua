-- Persistent size-bounded balanced map; balancing ported from Lean v4.36.0
-- Std/Data/DTreeMap/Internal/Def.lean and Balancing.lean (Copyright (c) 2024
-- Lean FRO, LLC; Apache-2.0; author Markus Himmel).
-- Referenced by q via Trellis declaration closure (import AvlMap).
-- closure_claim = 0.

-- avl begin
structure Map where
  tag : Int
  key : Int
  val : Int
  h : Int
  sa : Int
  sb : Int
  extra : List Int
  left : List Map
  right : List Map
  deriving Inhabited

structure MR where
  m : Map
  v : Int
  steps : Int
  xs : List Int
  hit : Map
  deriving Inhabited

def map0 : Nat -> Map
  | 0 => { tag := 0, key := 0, val := 0, h := 0, sa := 0, sb := 0, extra := [], left := [], right := [] : Map }
  | n + 1 => map0 n

def mr0 : Nat -> Map -> Int -> MR
  | 0, m, v => { m := m, v := v, steps := 0, xs := [], hit := map0 0 : MR }
  | n + 1, m, v => mr0 n m v

def kid : Nat -> List Map -> Map
  | 0, [] => map0 0
  | 0, m :: _ => m
  | _ + 1, xs => kid 0 xs

def box : Nat -> Map -> List Map
  | 0, m => if m.tag == 0 then [] else [m]
  | n + 1, m => box n m

def delta : Nat -> Int
  | 0 => 3
  | n + 1 => delta n

def ratio : Nat -> Int
  | 0 => 2
  | n + 1 => ratio n

def size : Nat -> Map -> Int
  | 0, m => if m.tag == 0 then 0 else m.h
  | _ + 1, m => size 0 m

def mkSz : Nat -> Int -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, sz, l, k, v, sa, sb, xs, r =>
    { tag := 1, key := k, val := v, h := sz, sa := sa, sb := sb, extra := xs, left := box 0 l, right := box 0 r : Map }
  | n + 1, sz, l, k, v, sa, sb, xs, r => mkSz n sz l k v sa sb xs r

def mk : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    mkSz 0 (1 + size 0 l + size 0 r) l k v sa sb xs r
  | n + 1, l, k, v, sa, sb, xs, r => mk n l k v sa sb xs r

def balanceL : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    if r.tag == 0 then
      if l.tag == 0 then mkSz 0 1 (map0 0) k v sa sb xs (map0 0)
      else
        let ll : Map := kid 0 (l.left);
        let lr : Map := kid 0 (l.right);
        if ll.tag == 0 && lr.tag == 0 then mkSz 0 2 l k v sa sb xs (map0 0)
        else if ll.tag == 0 then
          mkSz 0 3 (mkSz 0 1 (map0 0) l.key l.val l.sa l.sb l.extra (map0 0)) lr.key lr.val lr.sa lr.sb lr.extra (mkSz 0 1 (map0 0) k v sa sb xs (map0 0))
        else if lr.tag == 0 then
          mkSz 0 3 ll l.key l.val l.sa l.sb l.extra (mkSz 0 1 (map0 0) k v sa sb xs (map0 0))
        else
          mkSz 0 (1 + l.h) ll l.key l.val l.sa l.sb l.extra (mkSz 0 (1 + lr.h) lr k v sa sb xs (map0 0))
    else if l.tag == 0 then
      mkSz 0 (1 + r.h) (map0 0) k v sa sb xs r
    else
      let rs : Int := r.h;
      let ls : Int := l.h;
      if delta 0 * rs < ls then
        let ll : Map := kid 0 (l.left);
        let lr : Map := kid 0 (l.right);
        if ll.tag != 0 && lr.tag != 0 then
          let lls : Int := ll.h;
          let lrs : Int := lr.h;
          if lrs < ratio 0 * lls then
            mkSz 0 (1 + ls + rs) ll l.key l.val l.sa l.sb l.extra (mkSz 0 (1 + rs + lrs) lr k v sa sb xs r)
          else
            let lrl : Map := kid 0 (lr.left);
            let lrr : Map := kid 0 (lr.right);
            mkSz 0 (1 + ls + rs) (mkSz 0 (1 + lls + size 0 lrl) ll l.key l.val l.sa l.sb l.extra lrl) lr.key lr.val lr.sa lr.sb lr.extra (mkSz 0 (1 + rs + size 0 lrr) lrr k v sa sb xs r)
        else mkSz 0 (1 + ls + rs) l k v sa sb xs r
      else mkSz 0 (1 + ls + rs) l k v sa sb xs r
  | _ + 1, l, k, v, sa, sb, xs, r => balanceL 0 l k v sa sb xs r

def balanceR : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    if l.tag == 0 then
      if r.tag == 0 then mkSz 0 1 (map0 0) k v sa sb xs (map0 0)
      else
        let rl : Map := kid 0 (r.left);
        let rr : Map := kid 0 (r.right);
        if rl.tag == 0 && rr.tag == 0 then mkSz 0 2 (map0 0) k v sa sb xs r
        else if rl.tag == 0 then
          mkSz 0 3 (mkSz 0 1 (map0 0) k v sa sb xs (map0 0)) r.key r.val r.sa r.sb r.extra rr
        else if rr.tag == 0 then
          mkSz 0 3 (mkSz 0 1 (map0 0) k v sa sb xs (map0 0)) rl.key rl.val rl.sa rl.sb rl.extra (mkSz 0 1 (map0 0) r.key r.val r.sa r.sb r.extra (map0 0))
        else
          mkSz 0 (1 + r.h) (mkSz 0 (1 + rl.h) (map0 0) k v sa sb xs rl) r.key r.val r.sa r.sb r.extra rr
    else if r.tag == 0 then
      mkSz 0 (1 + l.h) l k v sa sb xs (map0 0)
    else
      let ls : Int := l.h;
      let rs : Int := r.h;
      if delta 0 * ls < rs then
        let rl : Map := kid 0 (r.left);
        let rr : Map := kid 0 (r.right);
        if rl.tag != 0 && rr.tag != 0 then
          let rls : Int := rl.h;
          let rrs : Int := rr.h;
          if rls < ratio 0 * rrs then
            mkSz 0 (1 + ls + rs) (mkSz 0 (1 + ls + rls) l k v sa sb xs rl) r.key r.val r.sa r.sb r.extra rr
          else
            let rll : Map := kid 0 (rl.left);
            let rlr : Map := kid 0 (rl.right);
            mkSz 0 (1 + ls + rs) (mkSz 0 (1 + ls + size 0 rll) l k v sa sb xs rll) rl.key rl.val rl.sa rl.sb rl.extra (mkSz 0 (1 + rrs + size 0 rlr) rlr r.key r.val r.sa r.sb r.extra rr)
        else mkSz 0 (1 + ls + rs) l k v sa sb xs r
      else mkSz 0 (1 + ls + rs) l k v sa sb xs r
  | _ + 1, l, k, v, sa, sb, xs, r => balanceR 0 l k v sa sb xs r

def balance : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    if l.tag == 0 then balanceR 0 l k v sa sb xs r
    else if r.tag == 0 then balanceL 0 l k v sa sb xs r
    else if delta 0 * l.h < r.h then balanceR 0 l k v sa sb xs r
    else if delta 0 * r.h < l.h then balanceL 0 l k v sa sb xs r
    else mkSz 0 (1 + l.h + r.h) l k v sa sb xs r
  | _ + 1, l, k, v, sa, sb, xs, r => balance 0 l k v sa sb xs r

def bal : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r => balance 0 l k v sa sb xs r
  | _ + 1, l, k, v, sa, sb, xs, r => bal 0 l k v sa sb xs r

def get : Map -> Int -> MR

  | { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right }, k =>
    let m : Map := { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right };
    if m.tag == 0 then { m := m, v := -1, steps := 1, xs := [], hit := map0 0 : MR }
    else if k == m.key then { m := m, v := m.val, steps := 1, xs := m.extra, hit := m : MR }
    else if k < m.key then
      match left with
      | [] => { m := m, v := -1, steps := 2, xs := [], hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := get child k;
        { m := m, v := a.v, steps := a.steps + 1, xs := a.xs, hit := a.hit : MR }
    else
      match right with
      | [] => { m := m, v := -1, steps := 2, xs := [], hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := get child k;
        { m := m, v := a.v, steps := a.steps + 1, xs := a.xs, hit := a.hit : MR }

def ins : Map -> Int -> Int -> Int -> Int -> List Int -> MR

  | { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right }, k, v, sa, sb, xs =>
    let m : Map := { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right };
    if m.tag == 0 then { m := mkSz 0 1 (map0 0) k v sa sb xs (map0 0), v := v, steps := 1, xs := xs, hit := map0 0 : MR }
    else if k == m.key then { m := mkSz 0 m.h (kid 0 (m.left)) k v sa sb xs (kid 0 (m.right)), v := v, steps := 1, xs := xs, hit := m : MR }
    else if k < m.key then
      match left with
      | [] =>
        let child : Map := mkSz 0 1 (map0 0) k v sa sb xs (map0 0);
        { m := balanceL 0 child m.key m.val m.sa m.sb m.extra (kid 0 (m.right)), v := v, steps := 2, xs := xs, hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := ins child k v sa sb xs;
        { m := balanceL 0 a.m m.key m.val m.sa m.sb m.extra (kid 0 (m.right)), v := v, steps := a.steps + 1, xs := xs, hit := map0 0 : MR }
    else
      match right with
      | [] =>
        let child : Map := mkSz 0 1 (map0 0) k v sa sb xs (map0 0);
        { m := balanceR 0 (kid 0 (m.left)) m.key m.val m.sa m.sb m.extra child, v := v, steps := 2, xs := xs, hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := ins child k v sa sb xs;
        { m := balanceR 0 (kid 0 (m.left)) m.key m.val m.sa m.sb m.extra a.m, v := v, steps := a.steps + 1, xs := xs, hit := map0 0 : MR }
-- avl end
