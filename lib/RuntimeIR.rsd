def rtNil : RtNode := { tag := 5, val := 0, ty := 2, args := [] }

def rtAt : Nat → List RtNode → RtNode
  | _, [] => rtNil
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtAt n xs

def rtTypeAt : Nat → List Int → Int
  | _, [] => -1
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtTypeAt n xs

def rtPrimAt : Nat → List RtPrim → RtPrim
  | _, [] => { name := "", args := [], result := -1, opcode := [], memory := false }
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtPrimAt n xs

def rtPrimIndex : Nat → List RtPrim → String → Int
  | _, [], _ => -1
  | i, x :: xs, name => if x.name == name then (i : Int) else rtPrimIndex (i + 1) xs name

def rtSigAt : Nat → List RtSignature → RtSignature
  | _, [] => { name := "", params := [], result := -1 }
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtSigAt n xs

def rtSigIndex : Nat → List RtSignature → String → Int
  | _, [], _ => -1
  | i, x :: xs, name => if x.name == name then (i : Int) else rtSigIndex (i + 1) xs name

-- Signed LEB is independent of a target backend. The wire carries scalar
-- values, type ids, and semantic node/primitive ids, never target code.
partial def rtLeb (value : Int) : List Int :=
  let byte := value % 128
  let rest := value / 128
  if (rest == 0 && byte < 64) || (rest == -1 && byte >= 64) then [byte]
  else (byte + 128) :: rtLeb rest

mutual
  def rtNodeWire : RtNode → List Int
    | ⟨tag, value, ty, args⟩ =>
      rtLeb tag ++ rtLeb value ++ rtLeb ty
      ++ rtLeb (args.length : Int) ++ rtNodesWire args
  def rtNodesWire : List RtNode → List Int
    | [] => []
    | node :: nodes => rtNodeWire node ++ rtNodesWire nodes
end

def rtIntsWire : List Int → List Int
  | [] => []
  | x :: xs => rtLeb x ++ rtIntsWire xs

def rtStringWire (name : String) : List Int :=
  let chars := name.toList
  rtLeb (chars.length : Int) ++ chars.map (fun c => (c.toNat : Int))

def rtFunctionWire (fn : RtFunction) : List Int :=
  rtStringWire fn.name ++ rtLeb (fn.params.length : Int) ++ rtIntsWire fn.params
  ++ rtLeb fn.result ++ rtLeb (fn.locals.length : Int) ++ rtIntsWire fn.locals
  ++ rtNodeWire fn.body

def rtFunctionsWire : List RtFunction → List Int
  | [] => []
  | fn :: rest => rtFunctionWire fn ++ rtFunctionsWire rest

def rtModuleWire (fns : List RtFunction) : List Int :=
  [82, 83, 67, 77, 127, 1] ++ rtLeb (fns.length : Int) ++ rtFunctionsWire fns
