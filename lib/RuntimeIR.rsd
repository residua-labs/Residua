-- Runtime dialect wire, RSCM extension 127 revision 1.  This is typed IR,
-- not target instruction bodies.  The primitive table is OBJECT-ABI v1.
-- Tree/list walks are structural; signed LEB follows its integer remainder.
structure RtPrim where
  name : String
  args : List Int
  result : Int
  opcode : List Int
  memory : Bool

-- Types: 0 = UInt64/USize, 1 = UInt32/address, 2 = Unit, 3 = bottom, 4 = Bool.
-- Nodes: 0 literal, 1 local, 2 primitive, 3 call, 4 value-if,
-- 5 sequence, 6 assignment, 7 while, 8 repeat, 9 break,
-- 10 continue, 11 early return, 12 final value, 13 configuration Rc.
structure RtNode where
  tag : Int
  val : Int
  ty : Int
  args : List RtNode

structure RtFunction where
  name : String
  params : List Int
  result : Int
  locals : List Int
  body : RtNode

structure RtSignature where
  name : String
  params : List Int
  result : Int

def rtSignaturesOf : List RtFunction → List RtSignature
  | [] => []
  | fn :: fns => { name := fn.name, params := fn.params, result := fn.result } :: rtSignaturesOf fns

