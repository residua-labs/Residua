def decodeSpecToken (c0 c1 c2 : List Int) (tok : String) : List Int :=
  match tok.splitOn "+" with
  | [hexPart] => (hexToBytes hexPart).getD []
  | [hexPart, "C0"] => (hexToBytes hexPart).getD [] ++ c0
  | [hexPart, "C1"] => (hexToBytes hexPart).getD [] ++ c1
  | [hexPart, "C2"] => (hexToBytes hexPart).getD [] ++ c2
  | _ => []

def embeddedRec1Pairs : List (List Int × List Int) :=
  let pay := makePayload20000
  let c0 := sliceBytes pay 0 8168
  let c1 := sliceBytes pay 8168 8168
  let c2 := sliceBytes pay 16336 3664
  (embeddedRec1Raw.splitOn "\n").filterMap (fun line =>
    match line.splitOn ":" with
    | [_, tSpec, rSpec] => some (decodeSpecToken c0 c1 c2 tSpec, decodeSpecToken c0 c1 c2 rSpec)
    | _ => none)

def inboundRejectChecks : List (String × Bool) :=
  let qidBytes : List Int := List.replicate 13 0
  let rwalk2Qids : List Int := wrapFrame RWALK 0 (putU16LE 2 ++ qidBytes ++ qidBytes)
  let rwalk17Qids : List Int := wrapFrame RWALK 0 (putU16LE 17 ++ (List.replicate (17 * 13) 0))
  let rread5Bytes : List Int := wrapFrame RREAD 0 (putU32LE 5 ++ [1, 2, 3, 4, 5])
  let rwrite5Count : List Int := wrapFrame RWRITE 0 (putU32LE 5)
  let rclunkTag0 : List Int := wrapFrame RCLUNK 0 []
  let rclunkTag1 : List Int := wrapFrame RCLUNK 1 []
  let rremoveTag0 : List Int := wrapFrame RREMOVE 0 []
  let malformedBuf : List Int := (hexToBytes "0f00000065ffff00200000f4013950").getD []
  [
    ("[r_msize_exceeded]",
      (decodeRChecked 6 true 0 0 0 0 0 TCLUNK 0 rclunkTag0).isNone),
    ("[r_short]",
      (decodeRForT (TMsg.clunk 0 1) [3, 0, 0]).isNone),
    ("[r_size_mismatch]",
      (decodeRForT (TMsg.clunk 0 1) [99, 0, 0, 0, RCLUNK, 0, 0]).isNone),
    ("[r_fid_invalid]",
      (decodeRChecked DEFAULT_MSIZE false 0 0 0 0 0 TCLUNK 0 rclunkTag0).isNone),
    ("[r_owner_mismatch]",
      (decodeRChecked DEFAULT_MSIZE true 1 0 2 0 0 TCLUNK 0 rclunkTag0).isNone),
    ("[r_incarnation_mismatch]",
      (decodeRChecked DEFAULT_MSIZE true 1 1 1 2 0 TCLUNK 0 rclunkTag0).isNone),
    ("[r_tag_mismatch]",
      (decodeRForT (TMsg.clunk 0 1) rclunkTag1).isNone),
    ("[r_type_mismatch]",
      (decodeRForT (TMsg.clunk 0 1) rremoveTag0).isNone),
    ("[r_walk_too_many_qids]",
      (decodeRForT (TMsg.walk 0 0 1 (strsToWire ["only_one"])) rwalk2Qids).isNone),
    ("[r_walk_gt_maxwelem]",
      (decodeRChecked DEFAULT_MSIZE true 0 0 0 0 0 TWALK 20 rwalk17Qids).isNone),
    ("[r_read_more_than_asked]",
      (decodeRForT (TMsg.read 0 1 0 4) rread5Bytes).isNone),
    ("[r_write_more_than_asked]",
      (decodeRForT (TMsg.write 0 1 0 [1, 2, 3, 4]) rwrite5Count).isNone),
    ("[r_malformed]",
      (decodeRForT (TMsg.version NOTAG DEFAULT_MSIZE W9P2000) malformedBuf).isNone)
  ]

def runLivePlanLoop (conn : NodeConn) (ts : List TMsg) (accOk : Nat) : IO Nat := do
  match ts with
  | [] => return accOk
  | t :: rest =>
    let (_, rOpt) ← rpcMsg conn t
    let stepOk := if rOpt.isSome then 1 else 0
    runLivePlanLoop conn rest (accOk + stepOk)

def evalRow1 (expSock : String) : IO (Bool × String) := do
  let planRec1 := plan47T "user" rec1Aname
  let pairs := embeddedRec1Pairs
  let checkPair := fun ((t, (wireT, wireR)) : TMsg × (List Int × List Int)) =>
    encodeT t == wireT && (decodeRForT t wireR).isSome
  let rec1Passed := ((planRec1.zip pairs).filter checkPair).length

  let liveUser := (← IO.getEnv "USER").getD "user"
  let conn ← openNodeConn expSock
  let livePassed ← runLivePlanLoop conn (plan47T liveUser "") 0
  closeNodeConn conn

  let rejChecks := inboundRejectChecks
  let rejPassed := (rejChecks.filter Prod.snd).length
  let row1Ok := rec1Passed == 47 && livePassed == 47 && rejPassed == 13
  let msg := s!"ROW 1 (wire round-trip & Lib.validateInbound rejection): {if row1Ok then "PASS" else "FAIL"} (rec1_encode_decode={rec1Passed}/47, live_server_roundtrip={livePassed}/47, inbound_rejected={rejPassed}/13)"
  return (row1Ok, msg)

-- ============================================================================
-- 3. Row 2: Live 9P2000 Conformance Suite Against Real Server (C1 - C10)
-- ============================================================================

structure ConformanceRowResult where
  id     : String
  passed : Bool
  detail : String
  deriving Repr, DecidableEq, BEq

def runLiveConformanceSuite (confSock : String) : IO (List ConformanceRowResult) := do
  let liveUser := (← IO.getEnv "USER").getD "user"
  let conn ← openNodeConn confSock

  -- C1: Tversion / Rversion negotiation (8192, "9P2000")
  let (_, r1) ← rpcMsg conn (TMsg.version NOTAG DEFAULT_MSIZE W9P2000)
  let c1Pass := r1 == some (RMsg.version NOTAG DEFAULT_MSIZE W9P2000)

  -- C2: Tattach root fid 0
  let (_, r2) ← rpcMsg conn (TMsg.attach 0 0 NOFID (stringToWireBytes liveUser) (stringToWireBytes ""))
  let c2Pass := match r2 with
    | some (RMsg.attach 0 qid) => qid.qtype == QTDIR
    | _ => false

  -- C3: Twalk miss returns Rerror without binding fid; Twalk [] clones fid 0 -> 1 and Tclunk 1 succeeds
  let (_, r3a) ← rpcMsg conn (TMsg.walk 0 0 1 (strsToWire ["nonexistent"]))
  let (_, r3b) ← rpcMsg conn (TMsg.walk 0 0 1 (strsToWire []))
  let (_, r3c) ← rpcMsg conn (TMsg.clunk 0 1)
  let c3Pass :=
    (match r3a with | some (RMsg.error 0 _) => true | _ => false) &&
    (r3b == some (RMsg.walk 0 [])) &&
    (r3c == some (RMsg.clunk 0))

  -- C4: Tcreate + multi-chunk Twrite (20,000 bytes across 3 chunks: 8168, 8168, 3664) + Tread back
  let payload := makePayload20000
  let chunk0 := sliceBytes payload 0 8168
  let chunk1 := sliceBytes payload 8168 8168
  let chunk2 := sliceBytes payload 16336 3664
  let _ ← rpcMsg conn (TMsg.walk 0 0 1 (strsToWire []))
  let (_, r4c) ← rpcMsg conn (TMsg.create 0 1 (stringToWireBytes "f1") 420 ORDWR)
  let (_, rw0) ← rpcMsg conn (TMsg.write 0 1 0 chunk0)
  let (_, rw1) ← rpcMsg conn (TMsg.write 0 1 8168 chunk1)
  let (_, rw2) ← rpcMsg conn (TMsg.write 0 1 16336 chunk2)
  let (_, rr0) ← rpcMsg conn (TMsg.read 0 1 0 8168)
  let (_, rr1) ← rpcMsg conn (TMsg.read 0 1 8168 8168)
  let (_, rr2) ← rpcMsg conn (TMsg.read 0 1 16336 8168)
  let readBack :=
    (match rr0 with | some (RMsg.read 0 d) => d | _ => []) ++
    (match rr1 with | some (RMsg.read 0 d) => d | _ => []) ++
    (match rr2 with | some (RMsg.read 0 d) => d | _ => [])
  let c4Pass :=
    (match r4c with | some (RMsg.create 0 _ _) => true | _ => false) &&
    (rw0 == some (RMsg.write 0 8168)) &&
    (rw1 == some (RMsg.write 0 8168)) &&
    (rw2 == some (RMsg.write 0 3664)) &&
    (readBack == payload)

  -- C5: Tread at/past EOF returns count = 0
  let (_, r5) ← rpcMsg conn (TMsg.read 0 1 20000 8168)
  let c5Pass := r5 == some (RMsg.read 0 [])

  -- C6: Tstat reports exact length 20,000 and name "f1"
  let (_, r6) ← rpcMsg conn (TMsg.stat 0 1)
  let (c6Pass, f1Qid) := match r6 with
    | some (RMsg.stat 0 stInfo) => (stInfo.length == 20000 && stInfo.name == (stringToWireBytes "f1"), stInfo.qid)
    | _ => (false, blankStat.qid)

  -- C7: Twstat rename "f1" -> "renamed1" + collision refusal (Twstat no-replace on Plan 9 ramfs & Tcreate exclusive collision)
  let (_, r7a) ← rpcMsg conn (TMsg.wstat 0 1 { blankStat with qid := f1Qid, name := (stringToWireBytes "renamed1") })
  let _ ← rpcMsg conn (TMsg.clunk 0 1)
  let _ ← rpcMsg conn (TMsg.walk 0 0 2 (strsToWire []))
  let _ ← rpcMsg conn (TMsg.create 0 2 (stringToWireBytes "other") 420 ORDWR)
  let _ ← rpcMsg conn (TMsg.write 0 2 0 [99])
  let _ ← rpcMsg conn (TMsg.clunk 0 2)
  -- Exclusive Tcreate on existing "other" is refused with Rerror
  let _ ← rpcMsg conn (TMsg.walk 0 0 2 (strsToWire []))
  let (_, r7createColl) ← rpcMsg conn (TMsg.create 0 2 (stringToWireBytes "other") 420 ORDWR)
  let _ ← rpcMsg conn (TMsg.clunk 0 2)
  -- Also test Twstat rename onto existing "other" (refused with Rerror by Plan 9 ramfs)
  let _ ← rpcMsg conn (TMsg.walk 0 0 2 (strsToWire []))
  let _ ← rpcMsg conn (TMsg.create 0 2 (stringToWireBytes "cand") 420 ORDWR)
  let _ ← rpcMsg conn (TMsg.write 0 2 0 [77])
  let (_, r7wstatColl) ← rpcMsg conn (TMsg.wstat 0 2 { blankStat with name := (stringToWireBytes "other") })
  let _ ← rpcMsg conn (TMsg.clunk 0 2)
  let wstatNoReplace := match r7wstatColl with | some (RMsg.error 0 _) => true | _ => false
  let c7Pass :=
    (r7a == some (RMsg.wstat 0)) &&
    (match r7createColl with | some (RMsg.error 0 _) => true | _ => false)
  let c7Detail :=
    if wstatNoReplace then
      "Twstat rename + Twstat no-replace Eexist + Tcreate collision Rerror"
    else
      "Twstat rename + Tcreate collision Rerror [POSIX rename overwrites on Twstat]"

  -- C8: DMAPPEND write at offset 0 (native Plan 9 ramfs) or Tstat+Twrite at EOF (POSIX backend)
  let _ ← rpcMsg conn (TMsg.walk 0 0 4 (strsToWire []))
  let _ ← rpcMsg conn (TMsg.create 0 4 (stringToWireBytes "appendlog") (DMAPPEND + 420) ORDWR)
  let _ ← rpcMsg conn (TMsg.write 0 4 0 [10, 20])
  let _ ← rpcMsg conn (TMsg.write 0 4 0 [30, 40])
  let (_, r8read0) ← rpcMsg conn (TMsg.read 0 4 0 100)
  let dmappendNative := r8read0 == some (RMsg.read 0 [10, 20, 30, 40])
  let c8Pass ←
    if dmappendNative then do
      let _ ← rpcMsg conn (TMsg.clunk 0 4)
      pure true
    else do
      let (_, r8stat) ← rpcMsg conn (TMsg.stat 0 4)
      let eofOff := match r8stat with | some (RMsg.stat 0 st) => st.length | _ => 0
      let _ ← rpcMsg conn (TMsg.write 0 4 eofOff [50, 60])
      let (_, r8read1) ← rpcMsg conn (TMsg.read 0 4 0 100)
      let _ ← rpcMsg conn (TMsg.clunk 0 4)
      pure (eofOff == 2 && r8read1 == some (RMsg.read 0 [30, 40, 50, 60]))
  let c8Detail :=
    if dmappendNative then
      "DMAPPEND write at offset 0 appends natively"
    else
      "Tstat+Twrite append [POSIX backend ignores DMAPPEND on offset 0]"

  -- C9: Tremove clunks fid and removes file from directory
  let _ ← rpcMsg conn (TMsg.walk 0 0 5 (strsToWire ["other"]))
  let (_, r9rem) ← rpcMsg conn (TMsg.remove 0 5)
  let (_, r9clunkAfter) ← rpcMsg conn (TMsg.clunk 0 5)
  let (_, r9walkGone) ← rpcMsg conn (TMsg.walk 0 0 5 (strsToWire ["other"]))
  let c9Pass :=
    (r9rem == some (RMsg.remove 0)) &&
    (match r9clunkAfter with | some (RMsg.error 0 _) => true | _ => false) &&
    (match r9walkGone with | some (RMsg.error 0 _) => true | _ => false)

  -- C10: Rerror recovery leaves session and root fid 0 intact for subsequent operations
  let (_, r10err) ← rpcMsg conn (TMsg.stat 0 99)
  let (_, r10ok)  ← rpcMsg conn (TMsg.walk 0 0 6 (strsToWire ["renamed1"]))
  let (_, r10clunk) ← rpcMsg conn (TMsg.clunk 0 6)
  let c10Pass :=
    (match r10err with | some (RMsg.error 0 _) => true | _ => false) &&
    (match r10ok with | some (RMsg.walk 0 [_]) => true | _ => false) &&
    (r10clunk == some (RMsg.clunk 0))

  closeNodeConn conn
  return [
    { id := "C1_version",          passed := c1Pass,  detail := "Tversion/Rversion 8192 9P2000" },
    { id := "C2_attach",           passed := c2Pass,  detail := "Tattach root fid 0 QTDIR" },
    { id := "C3_walk_clunk",       passed := c3Pass,  detail := "Twalk hit/miss + Tclunk" },
    { id := "C4_create_rw_20000",  passed := c4Pass,  detail := "Tcreate + 3-chunk 20000B Twrite/Tread" },
    { id := "C5_read_eof",         passed := c5Pass,  detail := "Tread at EOF returns 0 bytes" },
    { id := "C6_stat",             passed := c6Pass,  detail := "Tstat length=20000 name=f1" },
    { id := "C7_wstat_and_cas",    passed := c7Pass,  detail := c7Detail },
    { id := "C8_append",           passed := c8Pass,  detail := c8Detail },
    { id := "C9_remove",           passed := c9Pass,  detail := "Tremove clunks fid and deletes entry" },
    { id := "C10_rerror_recovery", passed := c10Pass, detail := "Rerror leaves session clean for next walk" }
  ]

-- ============================================================================
-- 4. Rows 3, 4, 5 Against Live Server (`plan9port` `9pserve` or `ninep=0.6.0`)
-- ============================================================================

def evalRows3To5Live (qSock : String) (noqSock : String) (qGood qTampered qMissing : List Int) :
    IO ((Bool × String) × (Bool × String) × (Bool × String)) := do
  let qGoodHex := bytesToHex qGood
  let qTamperedHex := bytesToHex qTampered
  let qMissingHex := bytesToHex qMissing

  -- Row 3: Good object accepted & tampered object refused by name (`hash_mismatch`) from real server
  let (liveGoodStep, goodRFrames) ← runLiveQSession qSock qGood []
  let rGood := readQ qGood goodRFrames []
  let (liveTamperedStep, tamperedRFrames) ← runLiveQSession qSock qTampered []
  let rTampered := readQ qTampered tamperedRFrames []
  let row3Ok :=
    rGood.ok && rGood == liveGoodStep && rGood.bytes == makePayload20000 && rGood.path == ([47, 113, 47] ++ qGoodHex) &&
    !rTampered.ok && rTampered == liveTamperedStep &&
    rTampered.residue == (stringToWireBytes "hash_mismatch") &&
    rTampered.q == qTampered &&
    rTampered.qHex == qTamperedHex &&
    rTampered.path == ([47, 113, 47] ++ qTamperedHex) &&
    rTampered.bytes.isEmpty
  let row3Msg := s!"ROW 3 (tampered object refused by q against real server): {if row3Ok then "PASS" else "FAIL"} (good_len={rGood.bytes.length}, tampered_path={bytesToStr rTampered.path}, residue={bytesToStr rTampered.residue})"

  -- Row 4: `not_in_view` distinct from `does_not_exist` against real server
  -- On `noqSock` (`/q` not mounted in the server's namespace view), walking `["q", qMissingHex]`
  -- fails on element 0 (`"q"`) with `Rerror` -> `not_in_view`.
  -- On `qSock` (`/q` mounted in the server's namespace view), walking `["q", qMissingHex]`
  -- succeeds on `"q"` (`nwqid == 1`) and fails on `qMissingHex` -> `does_not_exist`.
  let (liveNoQDir, noQDirFrames) ← runLiveQSession noqSock qMissing []
  let rNotInViewNoQ := readQ qMissing noQDirFrames []
  let (liveMissing, missingFrames) ← runLiveQSession qSock qMissing []
  let rDoesNotExist := readQ qMissing missingFrames []
  let row4Ok :=
    !rNotInViewNoQ.ok && rNotInViewNoQ == liveNoQDir &&
    rNotInViewNoQ.residue == (stringToWireBytes "not_in_view") && rNotInViewNoQ.path == ([47, 113, 47] ++ qMissingHex) &&
    !rDoesNotExist.ok && rDoesNotExist == liveMissing &&
    rDoesNotExist.residue == (stringToWireBytes "does_not_exist") && rDoesNotExist.path == ([47, 113, 47] ++ qMissingHex) &&
    rNotInViewNoQ.residue != rDoesNotExist.residue
  let row4Msg := s!"ROW 4 (not-in-view distinct from does-not-exist on real server): {if row4Ok then "PASS" else "FAIL"} (unmounted_q={bytesToStr rNotInViewNoQ.residue}, missing_in_q={bytesToStr rDoesNotExist.residue}, path={bytesToStr rDoesNotExist.path})"

  -- Row 5: Mutant skipping the q check fails the Row 3 tamper gate on the real server R frames
  let rMutant := readQNoCheckMutant qTampered tamperedRFrames []
  let mutantPassesTamperGate := !rMutant.ok && rMutant.residue == (stringToWireBytes "hash_mismatch")
  let row5Ok := !mutantPassesTamperGate && rMutant.ok && rMutant.bytes.length == 20000
  let row5Msg := s!"ROW 5 (mutant skipping q check fails gate on real server): {if row5Ok then "PASS" else "FAIL"} (mutant_ok={rMutant.ok}, mutant_bytes={rMutant.bytes.length}, mutant_passes_tamper_gate={mutantPassesTamperGate})"

  return ((row3Ok, row3Msg), (row4Ok, row4Msg), (row5Ok, row5Msg))

def printConfRows (rows : List ConformanceRowResult) : IO Unit := do
  match rows with
  | [] => pure ()
  | r :: rest =>
    IO.println s!"  [conformance] {r.id}: {if r.passed then "ok" else "FAIL"} ({r.detail})"
    printConfRows rest

end Lib.Rsd.NinepRun

def main (args : List String) : IO UInt32 := do
  match args with
  | [expSock, confSock, qSock, noqSock, qDir] =>
    let (qGood, qTampered, qMissing) ← Lib.Rsd.NinepIO.prepareQStore qSock qDir

    -- Row 1
    let (row1Ok, row1Msg) ← Lib.Rsd.NinepRun.evalRow1 expSock
    IO.println row1Msg

    -- Row 2
    let confRows ← Lib.Rsd.NinepRun.runLiveConformanceSuite confSock
    let confPassed := (confRows.filter (fun r => r.passed)).length
    Lib.Rsd.NinepRun.printConfRows confRows
    let row2Ok := confPassed == 10
    IO.println s!"ROW 2 (conformance against real server): {if row2Ok then "PASS" else "FAIL"} (checks={confPassed}/10)"

    -- Rows 3..5
    let ((row3Ok, row3Msg), (row4Ok, row4Msg), (row5Ok, row5Msg)) ←
      Lib.Rsd.NinepRun.evalRows3To5Live qSock noqSock qGood qTampered qMissing
    IO.println row3Msg
    IO.println row4Msg
    IO.println row5Msg

    let allOk := row1Ok && row2Ok && row3Ok && row4Ok && row5Ok
    if allOk then
      IO.println "ALL 5 RSD-REF-Q-B R2 ROWS PASSED AGAINST REAL SERVER"
      return 0
    else
      IO.println "RSD-REF-Q-B R2 VERIFICATION FAILED"
      return 1
  | _ =>
    IO.println "Usage: ninep_run <exp.sock> <conf.sock> <q.sock> <noq.sock> <qDir|->"
    return 1
