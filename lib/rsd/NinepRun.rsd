--Residuaellt
-- closure_claim = 0
-- Checkable surface: executable verification harness for lib/rsd/ninep.rsd
-- running all 5 RSD-REF-Q-B r2 acceptance rows against a real 9P2000 server
-- (plan9port `9pserve` + `ramfs` / `u9fs`, or `ninep=0.6.0`) over a live Unix domain socket
-- using the existing test host's `node` (`net.connect`), with zero custom C.
-- Concatenate after lib/Session.rsd, lib/Word32.rsd, lib/Word64.rsd, lib/Sha256.rsd, lib/rsd/store.rsd, lib/rsd/ninep.rsd.

namespace Lib.Rsd.NinepRun

open Lib.Rsd.Ninep
open Lib.Rsd.NinepIO

-- ============================================================================
-- 2. Row 1: 47-Step EFFECT-9P-0 Plan (`encodeT` / `decodeRForT`) & `Lib.validateInbound`
-- ============================================================================

def rec1Aname : String :=
  "5bc30adb4f3c77b911bd66074d2997c2a94717bd146762a5b933c93ce2d2172b"

def plan47T (uname : String) (aname : String) : List TMsg :=
  let pay := makePayload20000
  let c0 := sliceBytes pay 0 8168
  let c1 := sliceBytes pay 8168 8168
  let c2 := sliceBytes pay 16336 3664
  [
    TMsg.version NOTAG DEFAULT_MSIZE W9P2000,
    TMsg.attach 0 0 NOFID (stringToWireBytes uname) (stringToWireBytes aname),
    TMsg.walk 0 0 1 (strsToWire []),
    TMsg.create 0 1 (stringToWireBytes "a.txt") 438 OWRITE,
    TMsg.write 0 1 0 (stringToWireBytes "hello 9p\n"),
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire []),
    TMsg.create 0 1 (stringToWireBytes "log.jsonl") 438 OWRITE,
    TMsg.write 0 1 0 (stringToWireBytes "{\"i\":0}\n"),
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["log.jsonl"]),
    TMsg.stat 0 1,
    TMsg.open_ 0 1 OWRITE,
    TMsg.write 0 1 8 (stringToWireBytes "{\"i\":1}\n"),
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["log.jsonl"]),
    TMsg.stat 0 1,
    TMsg.open_ 0 1 OWRITE,
    TMsg.write 0 1 16 (stringToWireBytes "{\"i\":2}\n"),
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire []),
    TMsg.create 0 1 (stringToWireBytes "big.bin") 438 OWRITE,
    TMsg.write 0 1 0 c0,
    TMsg.write 0 1 8168 c1,
    TMsg.write 0 1 16336 c2,
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["a.txt"]),
    TMsg.open_ 0 1 OREAD,
    TMsg.read 0 1 0 8168,
    TMsg.read 0 1 9 8168,
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["log.jsonl"]),
    TMsg.open_ 0 1 OREAD,
    TMsg.read 0 1 0 8168,
    TMsg.read 0 1 24 8168,
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["big.bin"]),
    TMsg.open_ 0 1 OREAD,
    TMsg.read 0 1 0 8168,
    TMsg.read 0 1 8168 8168,
    TMsg.read 0 1 16336 8168,
    TMsg.read 0 1 20000 8168,
    TMsg.clunk 0 1,
    TMsg.walk 0 0 1 (strsToWire ["missing.txt"]),
    TMsg.walk 0 0 1 (strsToWire []),
    TMsg.create 0 1 (stringToWireBytes "a.txt") 438 OWRITE,
    TMsg.clunk 0 1
  ]

