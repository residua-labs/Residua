-- Laws about the executable Qfloor boundaries; stock Lean is an oracle.
namespace Lib.Rsd.QFloor
theorem sigma_idempotent (s : State) : id (id s) = id s := rfl
theorem q_sigma (r : Request) (s : State) : (fun value (_state : Lib.Rsd.QFloor.State) => value) r (id s) = (fun value (_state : Lib.Rsd.QFloor.State) => value) r s := rfl
theorem admit_iff (r : Request) (s : State) : admissible r s = true ↔ (runNF r s).residue = none := by
  simp [admissible, residue?, runNF, id, Option.isNone_iff_eq_none]

end Lib.Rsd.QFloor

