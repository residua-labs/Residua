-- Golden rows for lib/rsd/keys.rsd. Concatenate after keys.rsd.
-- The q compared here is hashOf (encodeRVal ...). closure_claim = 0.
namespace Lib.Rsd.KeysRun

open Lib.Rsd.Codec
open Lib.Rsd.Keys

def hexNib (n : Nat) : Char :=
  Char.ofNat (if n < 10 then 48 + n else 87 + n)

def hexByte (b : Int) : String :=
  let n := b.toNat
  String.mk [hexNib (n / 16), hexNib (n % 16)]

def toHex : List Int → String
  | [] => ""
  | b :: bs => hexByte b ++ toHex bs

def qb (h : String) : List Int :=
  Lib.Sha256.hex h

def sourceQ : List Int := qb "41cf6794ba4200b839c53531555f0f3998df4cbb01a4d5cb0b94e3ca5e23947d"
def generatorQ : List Int := qb "9123dcbb0b42652b0e105956c68d3ca2ff34584f324fa41a29aedd32b883e131"
def envFixtureQ : List Int := qb "dbbb133233759e94b9735f2d17a805babae153f7c908a8fec268917350917c03"
def declQ : List Int := qb "0284ed29714a1b7e6dce4060d6b5f44c30232b0b0a4108ecdcd3d29b8e223df4"

def qv (h : String) : Val := .bytes (qb h)

def envRv : RVal :=
  { ty := envTy, val := .record [
      ("recipe", .str "rsd.env/1"),
      ("toolchain", qv "a3206db65ed2118428865b922bf7b4c4b5365f51f302d2fb9165933724c17bb5"),
      ("target", .str "darwin-arm64"),
      ("argv", .list [
        .str "lean", .str "--tstack=65536", .str "--tstack=65536",
        .str "-o", .str "A.olean", .str "A.lean"]),
      ("cwd", .str "/logical/work"),
      ("module", .str "A"),
      ("search", .list [.record [
        ("logical", .str "workspace"),
        ("tree", qv "f59f68e4ae268fcea51db5aea005bc4f45f58b25385ba7d5427e0c7b50d801c0")]]),
      ("imports", .list [.record [
        ("module", .str "Init"), ("runtime", .bool false), ("facet", .str "olean"),
        ("object", qv "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d968")]]),
      ("environment", .list [.pair (.str "LANG") (.str "C"), .pair (.str "TZ") (.str "UTC")]),
      ("stdin", qv "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
      ("reads", .list [.record [
        ("operation", .str "file"), ("path", .str "/logical/work/data"),
        ("observation", qv "3a6eb0790f39ac87c94f3856b2dd2c5d110e6811602261a9a923d3bb23adc8b7")]]),
      ("limits", .record [
        ("memory_mib", .int 2048), ("tstack_kib", .int 65536), ("fuel", .int 100000),
        ("heartbeats", .int 200000), ("timeout_ms", .int 60000)]),
      ("profile", qv "1900eab6c028483d7126599ee6f50de0d27907b5c65fa90524580b4b0f9852b0"),
      ("axioms", .some (qv "6c30b34f8fa89e3d91a9d296f6015203ca2b0fa5338db443abd6e957bfacef38")),
      ("grammar", .some (qv "e05eb8a4a255743e051d77d5e43b75e5e38073b27539b0184fbce352405a3ee1")),
      ("catalog", qv "652f55016243bf1b9f1bbea46d5749ef892dbe394e46de9d66ab1aacf0b4af57"),
      ("devices", qv "ade15a1287dabe92c77ad32bbfada2ba4f6593433011b090530bd2fa0d86d8a0"),
      ("clock", .some (.int 0)),
      ("random", .some (qv "19b25856e1c150ca834cffc8b59b23adbd0ec0389e58eb22b3b64768098d002b"))] }

def artifactHex : String := ""
def envHex : String := ""

def eq (name expected got : String) : IO Bool := do
  if expected == got then
    IO.println s!"{name} ok"
    return true
  else
    IO.println s!"{name} fail"
    IO.println s!"expected {expected}"
    IO.println s!"got {got}"
    return false

def flag (name : String) (ok : Bool) : IO Bool := do
  IO.println s!"{name} {if ok then "ok" else "fail"}"
  return ok

def canonHex (rv : RVal) : String :=
  let o := Lib.Rsd.Codec.encodeRVal rv Lib.Rsd.Codec.defaultBounds
  if o.ok then toHex o.bytes else o.residue

def fixtureEnv (obj : List Int) (environment : List (String × String))
    (limits : Lib.Rsd.Keys.LimitsV) : Option RVal :=
  Lib.Rsd.Keys.nativeEnv
    (qb "a3206db65ed2118428865b922bf7b4c4b5365f51f302d2fb9165933724c17bb5")
    "darwin-arm64" "/logical/work" "A"
    ["lean", "--tstack=65536", "--tstack=65536", "-o", "A.olean", "A.lean"]
    [{ logical := "workspace"
     , tree := qb "f59f68e4ae268fcea51db5aea005bc4f45f58b25385ba7d5427e0c7b50d801c0" }]
    [{ module := "Init", runtime := false, facet := "olean", object := obj }]
    environment
    (qb "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    [{ operation := "file", path := "/logical/work/data"
     , observation := qb "3a6eb0790f39ac87c94f3856b2dd2c5d110e6811602261a9a923d3bb23adc8b7" }]
    limits
    (qb "1900eab6c028483d7126599ee6f50de0d27907b5c65fa90524580b4b0f9852b0")
    (qb "652f55016243bf1b9f1bbea46d5749ef892dbe394e46de9d66ab1aacf0b4af57")
    (qb "ade15a1287dabe92c77ad32bbfada2ba4f6593433011b090530bd2fa0d86d8a0")
    (some (qb "6c30b34f8fa89e3d91a9d296f6015203ca2b0fa5338db443abd6e957bfacef38"))
    (some (qb "e05eb8a4a255743e051d77d5e43b75e5e38073b27539b0184fbce352405a3ee1"))
    (some (qb "19b25856e1c150ca834cffc8b59b23adbd0ec0389e58eb22b3b64768098d002b"))
    (some 0)

def limitsFixture : Lib.Rsd.Keys.LimitsV :=
  { memory := 2048, tstack := 65536, fuel := 100000, heartbeats := 200000, timeout := 60000 }

def envFixturePairs : List (String × String) :=
  [("LANG", "C"), ("TZ", "UTC")]

def isNone : Option RVal → Bool
  | none => true
  | some _ => false

end Lib.Rsd.KeysRun

def main : IO UInt32 := do
  let mut bad := false
  let art := Lib.Rsd.Keys.artifactKey Lib.Rsd.KeysRun.sourceQ
    Lib.Rsd.KeysRun.generatorQ Lib.Rsd.KeysRun.envFixtureQ
  let ver := Lib.Rsd.Keys.verdictKey Lib.Rsd.KeysRun.sourceQ
    Lib.Rsd.KeysRun.generatorQ Lib.Rsd.KeysRun.envFixtureQ
  if !(← Lib.Rsd.KeysRun.flag "artifact-ok" art.ok) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "artifact-q" "338b0bea21cbec168fe7e458c233591f277215564cad1f7a3770fec578bb67cf"
      (Lib.Rsd.KeysRun.toHex art.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "verdict-q" "2de98c5ab97b056ab36a6ef6bea05a1cfeee6a603c63945350d026f339bc7761"
      (Lib.Rsd.KeysRun.toHex ver.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "domains-differ" (art.ok && ver.ok && art.bytes != ver.bytes)) then bad := true
  let canon := Lib.Rsd.Codec.encodeRVal
    (Lib.Rsd.Keys.artifactRVal Lib.Rsd.KeysRun.sourceQ Lib.Rsd.KeysRun.generatorQ Lib.Rsd.KeysRun.envFixtureQ)
    Lib.Rsd.Codec.defaultBounds
  if !(← Lib.Rsd.KeysRun.eq "artifact-bytes" Lib.Rsd.KeysRun.artifactHex
      (if canon.ok then Lib.Rsd.KeysRun.toHex canon.bytes else canon.residue)) then bad := true
  let env := Lib.Rsd.Keys.envQ Lib.Rsd.KeysRun.envRv
  if !(← Lib.Rsd.KeysRun.eq "env-q" "dbbb133233759e94b9735f2d17a805babae153f7c908a8fec268917350917c03"
      (Lib.Rsd.KeysRun.toHex env.bytes)) then bad := true
  let envCanon := Lib.Rsd.Codec.encodeRVal Lib.Rsd.KeysRun.envRv Lib.Rsd.Codec.defaultBounds
  if !(← Lib.Rsd.KeysRun.eq "env-bytes" Lib.Rsd.KeysRun.envHex
      (if envCanon.ok then Lib.Rsd.KeysRun.toHex envCanon.bytes else envCanon.residue)) then bad := true
  let decl := Lib.Rsd.Keys.nodeQ "declaration" Lib.Rsd.KeysRun.declQ
  let bind := Lib.Rsd.Keys.nodeQ "binding" Lib.Rsd.KeysRun.declQ
  if !(← Lib.Rsd.KeysRun.eq "node-declaration" "b768a65a992f06630908776ff10fa32dd2f7cafb73e6c1f752e6d88ce538bbab"
      (Lib.Rsd.KeysRun.toHex decl.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "node-binding" "1d6b737f98a30c212b1f9723f8a4bf333889a2c6a399e96a05fa51215ac57510"
      (Lib.Rsd.KeysRun.toHex bind.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "node-kinds-differ" (decl.ok && bind.ok && decl.bytes != bind.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "short-q" (
      !(Lib.Rsd.Keys.nodeQ "declaration" [0]).ok &&
      (Lib.Rsd.Keys.nodeQ "declaration" [0]).residue == "q_invalid")) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "verify" (
      canon.ok && (Lib.Rsd.Keys.verifyObject "rval" art.bytes canon.bytes).ok)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "verify-mismatch" (
      canon.ok && art.ok &&
      (Lib.Rsd.Keys.verifyObject "rval" art.bytes (canon.bytes ++ [0])).residue == "hash_mismatch")) then bad := true
  let wrong := { Lib.Rsd.KeysRun.envRv with ty := .i64 }
  if !(← Lib.Rsd.KeysRun.flag "env-type" (
      !(Lib.Rsd.Keys.envQ wrong).ok &&
      (Lib.Rsd.Keys.envQ wrong).residue == "input_invalid")) then bad := true
  match Lib.Rsd.KeysRun.fixtureEnv
      (Lib.Rsd.KeysRun.qb "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d968")
      Lib.Rsd.KeysRun.envFixturePairs Lib.Rsd.KeysRun.limitsFixture with
  | none =>
    bad := true
    IO.println "native-env fail none"
  | some rv =>
    if !(← Lib.Rsd.KeysRun.eq "native-env" Lib.Rsd.KeysRun.envHex
        (Lib.Rsd.KeysRun.canonHex rv)) then bad := true
    let e := Lib.Rsd.Keys.envQ rv
    let k := Lib.Rsd.Keys.artifactOfEnv Lib.Rsd.KeysRun.sourceQ
      Lib.Rsd.KeysRun.generatorQ rv
    if !(← Lib.Rsd.KeysRun.eq "native-q" "dbbb133233759e94b9735f2d17a805babae153f7c908a8fec268917350917c03"
        (Lib.Rsd.KeysRun.toHex e.bytes)) then bad := true
    if !(← Lib.Rsd.KeysRun.eq "native-artifact" "338b0bea21cbec168fe7e458c233591f277215564cad1f7a3770fec578bb67cf"
        (Lib.Rsd.KeysRun.toHex k.bytes)) then bad := true
    let path := Lib.Rsd.Keys.pathDigest "rcic/RcicLeanImportNative.lean"
    if !(← Lib.Rsd.KeysRun.eq "path-digest" "78f7868c63b6b4e65bf1cb9f3dc7373cc9fea6881344a96e99c933eff95357c3"
        (Lib.Rsd.KeysRun.toHex path.bytes)) then bad := true
    if !(← Lib.Rsd.KeysRun.flag "path-not-env" (path.ok && e.ok && path.bytes != e.bytes)) then bad := true
    match Lib.Rsd.KeysRun.fixtureEnv
        (Lib.Rsd.KeysRun.qb "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d969")
        Lib.Rsd.KeysRun.envFixturePairs Lib.Rsd.KeysRun.limitsFixture with
    | none =>
      bad := true
      IO.println "native-flip fail none"
    | some rv2 =>
      let e2 := Lib.Rsd.Keys.envQ rv2
      let k2 := Lib.Rsd.Keys.artifactOfEnv Lib.Rsd.KeysRun.sourceQ
        Lib.Rsd.KeysRun.generatorQ rv2
      if !(← Lib.Rsd.KeysRun.flag "olean-changes-env" (e.ok && e2.ok && e.bytes != e2.bytes)) then bad := true
      if !(← Lib.Rsd.KeysRun.flag "olean-changes-key" (k.ok && k2.ok && k.bytes != k2.bytes)) then bad := true
      if !(← Lib.Rsd.KeysRun.flag "olean-not-golden"
          (k2.ok && Lib.Rsd.KeysRun.toHex k2.bytes !=
            "338b0bea21cbec168fe7e458c233591f277215564cad1f7a3770fec578bb67cf")) then bad := true
    match Lib.Rsd.KeysRun.fixtureEnv
        (Lib.Rsd.KeysRun.qb "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d968")
        [("TZ", "UTC"), ("LANG", "C")] Lib.Rsd.KeysRun.limitsFixture with
    | none =>
      bad := true
      IO.println "native-sort fail none"
    | some rvS =>
      if !(← Lib.Rsd.KeysRun.flag "env-sorted"
          (Lib.Rsd.KeysRun.canonHex rvS == Lib.Rsd.KeysRun.canonHex rv)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "dup-env" (Lib.Rsd.KeysRun.isNone (
      Lib.Rsd.KeysRun.fixtureEnv
        (Lib.Rsd.KeysRun.qb "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d968")
        [("LANG", "C"), ("LANG", "C")] Lib.Rsd.KeysRun.limitsFixture))) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "neg-limit" (Lib.Rsd.KeysRun.isNone (
      Lib.Rsd.KeysRun.fixtureEnv
        (Lib.Rsd.KeysRun.qb "53c58344b22d9441f9c554e0d7bb0ac2366fc2914b47ed936ba4b2aa3690d968")
        Lib.Rsd.KeysRun.envFixturePairs
        { Lib.Rsd.KeysRun.limitsFixture with memory := -1 }))) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "short-object" (Lib.Rsd.KeysRun.isNone (
      Lib.Rsd.KeysRun.fixtureEnv [0] Lib.Rsd.KeysRun.envFixturePairs
        Lib.Rsd.KeysRun.limitsFixture))) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "profile-q" "2c6e1835e2fe367c92e561bfbaba81269f34440747d18f5f7cbea4bc436813fb"
      (Lib.Rsd.KeysRun.toHex Lib.Rsd.Keys.profileQ.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "catalog-q" "bdc0bae35a830d6cdbc471600ebbfe58ef056406933c696ade3a2b934d5d20cd"
      (Lib.Rsd.KeysRun.toHex Lib.Rsd.Keys.catalogQ.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "devices-q" "15d84d1b8f834a65af61d75d889a318890032f5b469fe59476ca486dbd920d3c"
      (Lib.Rsd.KeysRun.toHex Lib.Rsd.Keys.devicesQ.bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "inventory-rows" Lib.Rsd.Keys.inventoryFixtureOk) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "clock-entry" Lib.Rsd.Keys.clockEntryOk) then bad := true
  if !(← Lib.Rsd.KeysRun.eq "search-q" "686069c15e489f2b66d4b1b05f90f4c479a55881acf2b260409f9946780f7482"
      (Lib.Rsd.KeysRun.toHex (Lib.Rsd.Keys.searchQ [("A", "A.lean")]).bytes)) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "dep-key" Lib.Rsd.Keys.parseDepChanges) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "abs-cwd" Lib.Rsd.Keys.rejectsAbsolute) then bad := true
  if !(← Lib.Rsd.KeysRun.flag "dup-proto" Lib.Rsd.Keys.rejectsDupEnv) then bad := true
  if bad then return 1 else return 0
