namespace Lib.Rsd.EngineCollector

theorem sigma_idempotent (s : State) : sigma (sigma s) = sigma s := rfl
theorem q_sigma (r : Request) (s : State) : q r (sigma s) = q r s := rfl
-- check never observes replayNoise: remove it at the single entry boundary.
theorem residue_sigma (r : Request) (s : State) : residue? r (sigma s) = residue? r s := rfl
theorem admit_iff (r : Request) (s : State) : admissible r s = true <-> residue? r s = none := by
  simp only [admissible, residue_sigma, Option.isNone_iff_eq_none]
theorem soundness (r : Request) (s : State) (h : admissible r s = true) : residue? r s = none := (admit_iff r s).mp h
theorem completeness (r : Request) (s : State) (h : residue? r s = none) : admissible r s = true := (admit_iff r s).mpr h
theorem exactness (r : Request) (s : State) : (runNF r s).residue = none <-> admissible r s = true := by
  simp only [runNF, residue_sigma, admit_iff]
theorem refusal_exact (r : Request) (s : State) (e : Residue) : (runNF r s).residue = some e <-> residue? r s = some e := by
  simp only [runNF, residue_sigma]
theorem result_canonical (r : Request) (s : State) : sigma (runNF r s).state = (runNF r s).state := rfl
theorem residue_named (e : Residue) : residueName e != "" := by cases e <;> decide
end Lib.Rsd.EngineCollector
