-- LRC: a scalar field that only ever holds a small value is stored in one byte.
-- closure_claim = 0.
--
-- The wire's node record gives every scalar field of a constructor a word, whatever its source
-- type: a Bool, a constructor of an enumeration and an Int all take 8 bytes (rbtree's node:
-- colour, value and key, 48 bytes with the header and two children; Koka packs colour, value
-- and a 32-bit key into one word, 32 bytes). Lean's and Koka's compilers know the field's type
-- and lay it out by its size (IR/Basic.lean:174 CtorInfo `ssize`, the bytes of the scalar area;
-- the fields come from the type). The wire has lost the type of a node's field, so it is
-- recovered: a field is a byte when every value the program stores in it is one.
--
-- A value is a byte (0 .. 255) when it is
--   * a literal in that range;
--   * the result of a comparison or of `not` (0 or 1), or of `and`/`or` on bytes;
--   * `isShared`'s result;
--   * a parameter or a call's result that the wire types Bool (lib/lrc/FromWire.rsd `fwFn` gives
--     those the IR type uint8). The wire is typed: a Bool is 0 or 1. A host that passes another
--     word for a Bool breaks the entry's signature;
--   * read from a field that is a byte.
-- The last line makes it a fixpoint: every field starts as a byte; a store of a value that is
-- not one makes the field a word; repeated until nothing changes (each round only widens).
-- A join point's parameters count as words.
--
-- The pass knows an object's constructor where the code shows it: the variable was bound by
-- `ctor`, or it is the subject of the `case` alternative it is used in. Where a scalar field of
-- an object of unknown constructor is read or written, nothing is packed at all.
--
-- Only node constructors (tid 1) are laid out anew. A list cell and a box keep their layout:
-- the host reads them (docs/OBJECT-ABI.md). In the new scalar area the words come first, in
-- their order, then the bytes; `ssize` is its bytes, as in Lean. A byte is written with `sset`
-- at type uint8 and read by an `sproj` marked as one byte (field c of the node; Lean reads the
-- width off the bound variable's type, which here stays the wire's word).
--
-- It runs first, on the declarations as translated, so every later pass sees one layout.
import Lib.Lrc.FreeVars
import Lib.Lrc.Prim

namespace Lrc

def pkMem (x : Int) : List Int → Bool
  | [] => false
  | y :: ys => x == y || pkMem x ys

-- The objects whose constructor is known here: x, tid, cidx, ssize for each, the nearest first.
-- The constructor of x when it is a node's, -1 for another object, -2 when x is not known.
def pkCidx (x : Int) : List Int → Int
  | y :: tid :: c :: _ :: rest => if x == y then (if tid == 1 then c else -1) else pkCidx x rest
  | _ => -2

def pkSsize (x : Int) : List Int → Nat
  | y :: _ :: _ :: sz :: rest => if x == y then sz.toNat else pkSsize x rest
  | _ => 0

def pkBind (x : Int) (i : CtorInfo) (env : List Int) : List Int :=
  x :: (i.tid : Int) :: (i.cidx : Int) :: (i.ssize : Int) :: env

-- field `off` of constructor c
def pkKey (c : Int) (off : Nat) : Int := c * 4096 + (off : Int)

def pkAllBytes (bytes : VSet) : List Int → Bool
  | [] => true
  | y :: ys => y >= 0 && vsContains bytes y.toNat && pkAllBytes bytes ys

-- ok: no scalar field of an unknown object was met. wide: the fields that hold a word.
structure PkS where
  ok : Bool
  wide : List Int
  deriving Inhabited

def pkExprByte (env : List Int) (bytes : VSet) (wide : List Int) (e : N) : Bool :=
  if e.op == opLit then e.a >= 0 && e.a <= 255
  else if e.op == opPrim then
    let p := primOp e
    p == primLt || p == primGt || p == primEq || p == primNot || p == primStrEq
      || ((p == primAnd || p == primOr) && pkAllBytes bytes e.ys)
  else if e.op == opSProj then
    let c := pkCidx ((sprojVar e : Nat) : Int) env
    c >= 0 && !pkMem (pkKey c (sprojOff e)) wide
  else e.op == opIsShared

-- the binders of a call whose result the callee's signature types uint8
def pkCallBytes (bytes : VSet) : List Int → List Int → VSet
  | x :: _ :: binds, ty :: tys => pkCallBytes (if ty == tyU8 && x >= 0 then vsInsert bytes x.toNat else bytes) binds tys
  | _, _ => bytes

def pkRets (f : Nat) (ds : DeclTab) : List Int :=
  match dtFind ds f with
  | some d => d.rets
  | none => []

mutual
-- one body: `bytes` are the variables known to be bytes on this path
partial def pkGo (ds : DeclTab) (env : List Int) (bytes : VSet) (s : PkS) (n : N) : PkS :=
  if !s.ok then s
  else if n.op == opVDecl then
    let e := vdeclExpr n
    let env2 := if e.op == opCtor then pkBind n.a (infoOf e) env else env
    let s2 := if e.op == opSProj && pkCidx ((sprojVar e : Nat) : Int) env == -2 then { s with ok := false } else s
    let bytes2 :=
      if e.op == opFap then pkCallBytes bytes (vdeclBinds n) (pkRets (fapFn e) ds)
      else if n.ys.isEmpty && pkExprByte env bytes s.wide e then vsInsert bytes n.a.toNat
      else bytes
    pkGo ds env2 bytes2 s2 (bodyOf n)
  else if n.op == opSSet then
    let c := pkCidx n.a env
    let key := pkKey c (ssetOff n)
    if c == -2 then { s with ok := false }
    else if c >= 0 && !vsContains bytes (ssetArg n) && !pkMem key s.wide then
      pkGo ds env bytes { s with wide := key :: s.wide } (bodyOf n)
    else pkGo ds env bytes s (bodyOf n)
  else if n.op == opJDecl then pkGo ds env bytes (pkGo ds env bytes s (jdeclBody n)) (bodyOf n)
  else if n.op == opCase then pkAlts ds env bytes s n.a (caseAlts n)
  else if n.op == opRet || n.op == opJmp || n.op == opUnreachable then s
  else pkGo ds env bytes s (bodyOf n)
partial def pkAlts (ds : DeclTab) (env : List Int) (bytes : VSet) (s : PkS) (x : Int) : List N → PkS
  | [] => s
  | alt :: alts =>
    let env2 := if altIsDefault alt then env else pkBind x (infoOf alt) env
    pkAlts ds env bytes (pkGo ds env2 bytes s (altBody alt)) x alts
end

def pkParamBytes : List Param → VSet → VSet
  | [], s => s
  | p :: ps, s => pkParamBytes ps (if p.ty == tyU8 then vsInsert s p.x else s)

def pkDecls (all : DeclTab) : List Decl → PkS → PkS
  | [], s => s
  | d :: ds, s => pkDecls all ds (if d.ext then s else pkGo all [] (pkParamBytes d.xs vsEmpty) s d.body)

partial def pkFix (tab : DeclTab) (ds : List Decl) (s : PkS) : PkS :=
  let s2 := pkDecls tab ds s
  if !s2.ok || s2.wide.length == s.wide.length then s2 else pkFix tab ds s2

/-! ## The new layout of constructor c, whose scalar area had k words -/

-- how many of the fields 0 .. j-1 are words (w) or bytes (!w)
def pkCount (wide : List Int) (c : Int) (w : Bool) : Nat → Nat
  | 0 => 0
  | j + 1 => (if pkMem (pkKey c (8 * j)) wide == w then 1 else 0) + pkCount wide c w j

def pkIsWide (wide : List Int) (c : Int) (off : Nat) : Bool := pkMem (pkKey c off) wide

-- the offset of the field that was at `off`
def pkOff (wide : List Int) (c : Int) (k off : Nat) : Nat :=
  if pkIsWide wide c off then 8 * pkCount wide c true (off / 8)
  else 8 * pkCount wide c true k + pkCount wide c false (off / 8)

def pkSize (wide : List Int) (c : Int) (k : Nat) : Nat :=
  8 * pkCount wide c true k + pkCount wide c false k

def pkInfo (wide : List Int) (i : CtorInfo) : CtorInfo :=
  if i.tid == 1 then { i with ssize := pkSize wide ((i.cidx : Nat) : Int) (i.ssize / 8) } else i

mutual
-- the body with the new layout; the environment holds the constructors as they were
partial def pkRw (wide : List Int) (env : List Int) (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let env2 := if e.op == opCtor then pkBind n.a (infoOf e) env else env
    let c := if e.op == opSProj then pkCidx ((sprojVar e : Nat) : Int) env else -1
    let e2 :=
      if e.op == opCtor then withInfo e (pkInfo wide (infoOf e))
      else if c >= 0 then
        let k := pkSsize ((sprojVar e : Nat) : Int) env / 8
        { e with b := ((pkOff wide c k (sprojOff e) : Nat) : Int), c := (if pkIsWide wide c (sprojOff e) then 0 else 1) }
      else e
    { n with kids := [e2, pkRw wide env2 (bodyOf n)] }
  else if n.op == opSSet then
    let c := pkCidx n.a env
    if c >= 0 then
      let k := pkSsize n.a env / 8
      { n with c := ((pkOff wide c k (ssetOff n) : Nat) : Int), d := (if pkIsWide wide c (ssetOff n) then n.d else tyU8),
               kids := [pkRw wide env (bodyOf n)] }
    else setBody n (pkRw wide env (bodyOf n))
  else if n.op == opJDecl then { n with kids := [pkRw wide env (jdeclBody n), pkRw wide env (bodyOf n)] }
  else if n.op == opCase then { n with kids := pkRwAlts wide env n.a (caseAlts n) }
  else if n.op == opRet || n.op == opJmp || n.op == opUnreachable then n
  else setBody n (pkRw wide env (bodyOf n))
partial def pkRwAlts (wide : List Int) (env : List Int) (x : Int) : List N → List N
  | [] => []
  | alt :: alts =>
    let env2 := if altIsDefault alt then env else pkBind x (infoOf alt) env
    let alt2 := if altIsDefault alt then alt else withInfo alt (pkInfo wide (infoOf alt))
    altSetBody alt2 (pkRw wide env2 (altBody alt)) :: pkRwAlts wide env x alts
end

def pkRwDecls (wide : List Int) : List Decl → List Decl
  | [] => []
  | d :: ds => (if d.ext then d else { d with body := pkRw wide [] d.body }) :: pkRwDecls wide ds

def packScalars (decls : List Decl) : List Decl :=
  let s := pkFix (dtOfList decls) decls { ok := true, wide := [] }
  if s.ok then pkRwDecls s.wide decls else decls

end Lrc
