-- LRC: the wire form of an image's functions to the IR.
-- closure_claim = 0.
--
-- What it does (reports/backend-opt-fable/PLAN-LRC.md, part B):
-- * A-normal form. A wire expression is a tree; the IR binds every intermediate value to a variable
--   (Lean reaches the same form in its LCNF to IR step). An `if` whose value is used becomes a
--   `case` whose alternatives jump to a join point that receives the value (IR/Basic.lean:252).
-- * A flat record (a wire record, or the pair an allocation returns) is a run of words; each word
--   is one IR argument.
-- * rsdc's encoding of an inductive value (docs/OBJECT-ABI.md "Cib.Heap node"; rsc/rsc.rsd
--   `heapKindWithLayers` recognises the three reserved functions) becomes Lean's constructor
--   object (lean.h:152 `lean_ctor_object`):
--     call alloc {f0 := t, f1 := [c0, c1, ...], f2 .. f6, f7} arena   =>  ctor_t c0 c1 ..., then sset
--     let n := call read arena h                                       =>  no code; `n` is h seen as a record
--     n.f0                                                             =>  the tag of h
--     call kid (n.f1) i                                                =>  proj[i] h
--     n.f2 .. n.f6                                                     =>  sproj h
--     if n.f0 == t then A else B                                       =>  case h of ctor_t => A | ... => B
--   The arena is `irrelevant` (IR/Basic.lean:83): it has no word in the IR.
-- * Fuel is the depth of source calls. A reserved call that becomes inline code leaves a guard
--   (lib/lrc/Ir.rsd `mkGuard`) of the depth the call needed, after its arguments, where the call was.
-- * A function whose signature holds the node record (the front end writes the child of a record
--   once, as `f r i = call kid (r.f1) i`, and calls it at every use) has no translation of its own:
--   the record is no value here. A call of it is its body with the arguments as its variables, under
--   the guard its entry was, and the code of the body stands one call deeper (`Cx.inl`, `trCall`).
-- * Evaluation order is the wire's: arguments left to right, then the operation.
--
-- First stage: integers, booleans, `let`, `if`, checked arithmetic, comparison, flat records, calls
-- and the node forms above. An image with any other form is refused whole, with the cause of the
-- first form that refused (`Residue` below). Under the stage's word that is a failed compile
-- (rsc/rsc.rsd `lrcRefused`); the present lowering is asked for by its own word.
--
-- This module is the stage's admission of an image, and it is an NF instance (NF-0,
-- contracts/interfaces/NF-0.md): `Residue` and `residueName` here, `q` and `admit` at the end.
import RscBase
import AvlMap
import Lib.Lrc.FreeVars
import Lib.Lrc.Prim
import Lib.Lrc.Classes
import Lib.Lrc.NormIds

namespace Lrc

-- The stage's refusals of an image, one constructor for each cause. `fn` is the function the stage
-- stopped at. A raise site inside a function's translation does not know its function: it raises
-- the cause at function 0 (the `fw*` names below), and the place is set where the function is known
-- (`residueAt`, in `fwFns` and in `admit`).
inductive Residue where
  -- a refusal that reached the gate without its cause. No raise site leaves the cause out; the gate
  -- refuses all the same and says so (`admit`)
  | causeMissing (fn : Nat)
  -- a wire constructor (`tag`) that the stage does not translate yet
  | formNotTranslated (fn : Nat) (tag : Nat)
  -- a type the stage does not hold yet
  | typeNotHeld (fn : Nat)
  -- a node record used other than through a field of known layout
  | nodeRecordUsed (fn : Nat)
  -- an allocation whose record is not a literal with a literal tag and children
  | allocationNotLiteral (fn : Nat)
  -- a child read that no tag decides, or whose index is not a literal below the constructor's arity
  | childReadUndecided (fn : Nat)
  -- the wire does not parse
  | wireUnparsed (fn : Nat)
  -- argument words do not fit the callee's parameters
  | argumentWords (fn : Nat)
  -- a constructor tag outside 0..244 (lean.h LeanMaxCtorTag)
  | constructorTagRange (fn : Nat)
  -- a call of a function that is not translated
  | calleeNotTranslated (fn : Nat)
  -- the nine-field node
  | nodeNineFields (fn : Nat)
  -- a string literal longer than the emitter writes (lib/lrc/Ir.rsd `litMax`)
  | literalTooLong (fn : Nat)
  -- a node the emitter has no code for (lib/lrc/Emit.rsd `emitFns`). No pass leaves one; the
  -- emitter refuses rather than guess, and rsc raises this for it (rsc/rsc.rsd `lrcModule`)
  | nodeNotWritten (fn : Nat)

def residueName : Residue -> String
  | Residue.causeMissing _ => "lrc_cause_missing"
  | Residue.formNotTranslated _ _ => "lrc_form_not_translated"
  | Residue.typeNotHeld _ => "lrc_type_not_held"
  | Residue.nodeRecordUsed _ => "lrc_node_record_used"
  | Residue.allocationNotLiteral _ => "lrc_allocation_not_literal"
  | Residue.childReadUndecided _ => "lrc_child_read_undecided"
  | Residue.wireUnparsed _ => "lrc_wire_unparsed"
  | Residue.argumentWords _ => "lrc_argument_words"
  | Residue.constructorTagRange _ => "lrc_constructor_tag_range"
  | Residue.calleeNotTranslated _ => "lrc_callee_not_translated"
  | Residue.nodeNineFields _ => "lrc_node_nine_fields"
  | Residue.literalTooLong _ => "lrc_literal_too_long"
  | Residue.nodeNotWritten _ => "lrc_node_not_written"

-- The class of a refusal in the outcome's code (rsc/rsc.rsd `lrcRefused`). The numbers are the ones
-- the stage's refusals have had since it landed; 1000 + t is wire constructor t; 2005 was a cause
-- that is no longer raised.
def refusalClass : Residue -> Nat
  | Residue.causeMissing _ => 0
  | Residue.formNotTranslated _ tag => 1000 + tag
  | Residue.typeNotHeld _ => 2001
  | Residue.nodeRecordUsed _ => 2002
  | Residue.allocationNotLiteral _ => 2003
  | Residue.childReadUndecided _ => 2004
  | Residue.wireUnparsed _ => 2006
  | Residue.argumentWords _ => 2007
  | Residue.constructorTagRange _ => 2008
  | Residue.calleeNotTranslated _ => 2009
  | Residue.nodeNineFields _ => 2010
  | Residue.literalTooLong _ => 2011
  | Residue.nodeNotWritten _ => 3001

-- the function of a refusal
def refusalFn : Residue -> Nat
  | Residue.causeMissing fn => fn
  | Residue.formNotTranslated fn _ => fn
  | Residue.typeNotHeld fn => fn
  | Residue.nodeRecordUsed fn => fn
  | Residue.allocationNotLiteral fn => fn
  | Residue.childReadUndecided fn => fn
  | Residue.wireUnparsed fn => fn
  | Residue.argumentWords fn => fn
  | Residue.constructorTagRange fn => fn
  | Residue.calleeNotTranslated fn => fn
  | Residue.nodeNineFields fn => fn
  | Residue.literalTooLong fn => fn
  | Residue.nodeNotWritten fn => fn

-- the refusal at function `fn`
def residueAt (fn : Nat) : Residue -> Residue
  | Residue.causeMissing _ => Residue.causeMissing fn
  | Residue.formNotTranslated _ tag => Residue.formNotTranslated fn tag
  | Residue.typeNotHeld _ => Residue.typeNotHeld fn
  | Residue.nodeRecordUsed _ => Residue.nodeRecordUsed fn
  | Residue.allocationNotLiteral _ => Residue.allocationNotLiteral fn
  | Residue.childReadUndecided _ => Residue.childReadUndecided fn
  | Residue.wireUnparsed _ => Residue.wireUnparsed fn
  | Residue.argumentWords _ => Residue.argumentWords fn
  | Residue.constructorTagRange _ => Residue.constructorTagRange fn
  | Residue.calleeNotTranslated _ => Residue.calleeNotTranslated fn
  | Residue.nodeNineFields _ => Residue.nodeNineFields fn
  | Residue.literalTooLong _ => Residue.literalTooLong fn
  | Residue.nodeNotWritten _ => Residue.nodeNotWritten fn

-- the causes as the raise sites name them
def fwUnsup (tag : Int) : Residue := Residue.formNotTranslated 0 tag.toNat
def fwType : Residue := Residue.typeNotHeld 0
def fwNodeUse : Residue := Residue.nodeRecordUsed 0
def fwAllocShape : Residue := Residue.allocationNotLiteral 0
def fwKidShape : Residue := Residue.childReadUndecided 0
def fwWire : Residue := Residue.wireUnparsed 0
def fwCall : Residue := Residue.argumentWords 0
def fwTag : Residue := Residue.constructorTagRange 0
def fwCallee : Residue := Residue.calleeNotTranslated 0
def fwNodeV2 : Residue := Residue.nodeNineFields 0
def fwLit : Residue := Residue.literalTooLong 0

/-! ## Types as runs of words -/

-- the marker records of a natural number and of an integer, as the front end writes them ("Magnitudes")
def natRecTy : List Int := [7, 1, 1, 8, 0, 78, 97, 116, 77, 97, 103, 49, 4, 0]
def intRecTy : List Int :=
  [7, 2, 1, 8, 0, 73, 110, 116, 83, 103, 110, 49, 1, 1, 8, 0, 73, 110, 116, 77, 97, 103, 49, 4, 0]

structure FlatR where
  ok : Bool
  ts : List Int
  deriving Inhabited

def flatFail : FlatR := { ok := false, ts := [] }

-- the arena: a list of node records
def fwIsArena (g : Dg) (ty : List Int) : Bool :=
  match tyView g ty with
  | 4 :: elem => isHeapNode g elem
  | _ => false

mutual
-- The IR type of each word of a value of wire type `ty`. `abi`: the words the wire's hosts pass, in which an
-- integer is its sign and its magnitude; inside the stage it is one word ("An integer is one word").
partial def fwFlatW (abi : Bool) (g : Dg) (ty : List Int) : FlatR :=
  if isHeapHandle g ty then { ok := true, ts := [tyTObj] }
  else if !abi && tyView g ty == intRecTy then { ok := true, ts := [tyTObj] }
  else
    match tyView g ty with
    | [0] => { ok := true, ts := [tyI64] }
    | [1] => { ok := true, ts := [tyI64] }
    -- a string is an object (docs/OBJECT-ABI.md: tag 249, the bytes from +32)
    | [2] => { ok := true, ts := [tyObj] }
    -- a list is one object word (nil is a boxed scalar); the arena is no value at all
    | 4 :: elem => if isHeapNode g elem then { ok := true, ts := [tyIrr] } else { ok := (fwFlatW false g elem).ok, ts := [tyTObj] }
    -- an option is a flag word and the payload's words
    | 8 :: t =>
      let a := fwFlatW abi g t
      { ok := a.ok, ts := tyI64 :: a.ts }
    | 7 :: bs =>
      let n := readLeb bs
      if n.ok != profile.cOk || n.n < 0 then flatFail else fwFlatFields abi g n.n.toNat n.rest
    -- a sum is one object word ("Sums" below), when every summand is held
    | 6 :: bs =>
      let n := readLeb bs
      if n.ok != profile.cOk || n.n < 0 then flatFail else { ok := fwFlatArms g n.n.toNat n.rest, ts := [tyTObj] }
    | _ => flatFail
partial def fwFlatArms (g : Dg) : Nat → List Int → Bool
  | 0, _ => true
  | k + 1, rest =>
    let t := readTyD g rest
    t.ok == profile.cOk && (fwFlatW false g t.acc).ok && fwFlatArms g k t.rest
partial def fwFlatFields (abi : Bool) (g : Dg) : Nat → List Int → FlatR
  | 0, _ => { ok := true, ts := [] }
  | k + 1, rest =>
    let nm := skipName rest
    if nm.ok != profile.cOk then flatFail
    else
      let t := readTyD g nm.rest
      if t.ok != profile.cOk then flatFail
      else
        let a := fwFlatW abi g t.acc
        let b := fwFlatFields abi g k t.rest
        { ok := a.ok && b.ok, ts := a.ts ++ b.ts }
end

def fwFlat (g : Dg) (ty : List Int) : FlatR := fwFlatW false g ty
-- the words of the boundary
def fwFlatB (g : Dg) (ty : List Int) : FlatR := fwFlatW true g ty

structure SliceR where
  ok : Bool
  off : Nat
  width : Nat
  -- the field's wire type
  ty : List Int
  deriving Inhabited

def sliceFail : SliceR := { ok := false, off := 0, width := 0, ty := [] }

partial def fwSliceGo (g : Dg) (i off : Nat) : Nat → List Int → SliceR
  | 0, _ => sliceFail
  | k + 1, rest =>
    let nm := skipName rest
    if nm.ok != profile.cOk then sliceFail
    else
      let t := readTyD g nm.rest
      if t.ok != profile.cOk then sliceFail
      else
        let a := fwFlat g t.acc
        if !a.ok then sliceFail
        else if i == 0 then { ok := true, off := off, width := a.ts.length, ty := t.acc }
        else fwSliceGo g (i - 1) (off + a.ts.length) k t.rest

-- the words of field `i` of a flat record of type `recTy`
def fwSlice (g : Dg) (recTy : List Int) (i : Nat) : SliceR :=
  match tyView g recTy with
  | 7 :: bs =>
    let n := readLeb bs
    if n.ok != profile.cOk || n.n < 0 then sliceFail else fwSliceGo g i 0 n.n.toNat n.rest
  | _ => sliceFail

-- the types of a function's parameters, one run per parameter, and of its result
structure SigR where
  ok : Bool
  params : List (List Int)
  result : List Int
  -- the wire types: of each parameter, and of the result
  ptys : List (List Int)
  rty : List Int
  deriving Inhabited

def sigFail : SigR := { ok := false, params := [], result := [], ptys := [], rty := [] }

partial def fwSigParams (abi : Bool) (g : Dg) : Nat → List Int → SigR
  | 0, rest =>
    let t := readTyD g rest
    if t.ok != profile.cOk then sigFail
    else
      let r := fwFlatW abi g t.acc
      { ok := r.ok, params := [], result := r.ts, ptys := [], rty := t.acc }
  | k + 1, rest =>
    let t := readTyD g rest
    if t.ok != profile.cOk then sigFail
    else
      let a := fwFlatW abi g t.acc
      let b := fwSigParams abi g k t.rest
      { ok := a.ok && b.ok, params := a.ts :: b.params, result := b.result, ptys := t.acc :: b.ptys, rty := b.rty }

def fwSig (g : Dg) (sig : List Int) : SigR := fwSigParams false g (sigCount sig) (sigParams sig)
-- a signature in the words of the boundary
def fwSigB (g : Dg) (sig : List Int) : SigR := fwSigParams true g (sigCount sig) (sigParams sig)

/-! ## The node tags of the image

One pass over every allocation of the image collects the tags of its node constructors and checks
the record of each: a literal tag in lean.h's range, the children and the string in their places.
How the nodes of a tag are laid out is decided after the translation, for each class of objects
("Layout"). -/

structure CtorTab where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  -- the tags of the image's allocations, in the order met
  tags : List Int
  deriving Inhabited

def ctEmpty : CtorTab := { ok := true, err := none, tags := [] }

/-! ### Reading an allocation's record as written -/

-- the value of field i of a record literal (34 name value rest), or [] when it is not one
def fwFieldAt (g : Dg) : Nat → List Int → List Int
  | i, rest =>
    match drE g rest with
    | 34 :: bs =>
      let nm := skipName bs
      if nm.ok != profile.cOk then []
      else
        match i with
        | 0 => nm.rest
        | j + 1 =>
          let v := skipE g profile.v2Fuel nm.rest
          if v.ok != profile.cOk then [] else fwFieldAt g j v.rest
    | _ => []

-- the number of children a literal list holds (22, or 26 (23 e) rest), or -1
partial def fwKidCount (g : Dg) (rest : List Int) : Int :=
  match drE g rest with
  | 22 :: _ => 0
  | 26 :: bs =>
    match drE g bs with
    | 23 :: e =>
      let s := skipE g profile.v2Fuel e
      if s.ok != profile.cOk then -1
      else
        let n := fwKidCount g s.rest
        if n < 0 then -1 else n + 1
    | _ => -1
  | _ => -1

def fwIsIntLit (g : Dg) (rest : List Int) (v : Int) : Bool :=
  match drE g rest with
  | 0 :: bs =>
    let n := readLeafI64 bs
    n.ok == profile.cOk && n.n == v
  | _ => false

def fwIsFalse (g : Dg) (rest : List Int) : Bool :=
  match drE g rest with
  | 1 :: 0 :: _ => true
  | _ => false

def fwIsEmptyStr (g : Dg) (rest : List Int) : Bool :=
  match drE g rest with
  | 2 :: bs =>
    let s := readStr bs
    s.ok == profile.cOk && s.n == 0
  | _ => false

-- one allocation's record: its tag into the table
def ctSite (g : Dg) (tab : CtorTab) (rec : List Int) : CtorTab :=
  if !tab.ok then tab
  else
    match drE g (fwFieldAt g 0 rec) with
    | 0 :: bs =>
      let t := readLeafI64 bs
      if t.ok != profile.cOk || (fwFieldAt g 1 rec).isEmpty || (fwFieldAt g 7 rec).isEmpty then { tab with ok := false, err := some fwAllocShape }
      else if t.n < 0 || t.n > 244 then { tab with ok := false, err := some fwTag }
      else if tab.tags.contains t.n then tab
      else { tab with tags := tab.tags ++ [t.n] }
    | _ => { tab with ok := false, err := some fwAllocShape }

def intrKind (intr : List Int) (f : Nat) : Int := intAt f intr

structure ScanR where
  ok : Bool
  tab : CtorTab
  rest : List Int
  deriving Inhabited

mutual
-- every allocation in one expression, by the wire's grammar (lib/RscBase.rsd `skipEGo`)
partial def scanE (g : Dg) (intr : List Int) (tab : CtorTab) (rest0 : List Int) : ScanR :=
  match rest0 with
  | [] => { ok := false, tab := tab, rest := [] }
  | 53 :: _ =>
    -- a reference into the node table: scan the node, then continue after the reference
    let s := skipE g profile.v2Fuel rest0
    let inner := scanE g intr tab (drE g rest0)
    { ok := s.ok == profile.cOk && inner.ok, tab := inner.tab, rest := s.rest }
  | tag :: bs =>
    if tag == 0 || tag == 41 then scanSkip tab (skipBytes 9 bs)
    else if tag == 1 then scanSkip tab (skipBytes 1 bs)
    else if tag == 2 then scanSkip tab (skipName bs)
    else if tag == 3 then scanSkip tab (readLeb bs)
    else if tag == 22 || tag == 33 || tag == 37 then { ok := true, tab := tab, rest := bs }
    else if tag == 4 then scanTy g intr tab 2 bs
    else if tag == 5 || tag == 20 || tag == 48 then scanN g intr tab 3 bs
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16
        || tag == 19 || tag == 26 || tag == 27 || tag == 28 || tag == 47 then scanN g intr tab 2 bs
    else if tag == 9 || tag == 17 || tag == 18 || tag == 21 || tag == 23 || tag == 25 || tag == 36 || tag == 39 || tag == 40
        || tag == 44 || tag == 45 || tag == 46 || tag == 49 then scanN g intr tab 1 bs
    else if tag == 14 then scanTy g intr tab 2 bs
    else if tag == 24 || tag == 29 || tag == 30 || tag == 38 || tag == 42 || tag == 43 then scanTy g intr tab 1 bs
    else if tag == 31 then
      let r := readLeb bs
      if r.ok != profile.cOk then { ok := false, tab := tab, rest := bs } else scanN g intr tab 1 r.rest
    else if tag == 32 then
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, tab := tab, rest := bs }
      else
        let a := scanE g intr tab t.rest
        if !a.ok then a else scanArgs g intr a.tab a.rest
    else if tag == 34 then
      let nm := skipName bs
      if nm.ok != profile.cOk then { ok := false, tab := tab, rest := bs } else scanN g intr tab 2 nm.rest
    else if tag == 35 then
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, tab := tab, rest := bs }
      else
        let r := readLeb t.rest
        if r.ok != profile.cOk then { ok := false, tab := tab, rest := bs } else scanN g intr tab 1 r.rest
    else if tag == 50 then scanTy g intr tab 3 bs
    else if tag == 51 then scanTy g intr tab 4 bs
    else if tag == 52 then
      let r := readLeb bs
      if r.ok != profile.cOk || r.n < 0 then { ok := false, tab := tab, rest := bs }
      else
        let tab := if intrKind intr r.n.toNat == 3 then
            match r.rest with
            | 1 :: rec => ctSite g tab rec
            | _ => { tab with ok := false, err := some fwAllocShape }
          else tab
        scanArgs g intr tab r.rest
    else { ok := false, tab := tab, rest := bs }
partial def scanSkip (tab : CtorTab) (r : Rd) : ScanR :=
  { ok := r.ok == profile.cOk, tab := tab, rest := r.rest }
partial def scanTy (g : Dg) (intr : List Int) (tab : CtorTab) (n : Nat) (bs : List Int) : ScanR :=
  let t := skipTyD g bs
  if t.ok != profile.cOk then { ok := false, tab := tab, rest := bs } else scanN g intr tab n t.rest
partial def scanN (g : Dg) (intr : List Int) (tab : CtorTab) : Nat → List Int → ScanR
  | 0, rest => { ok := true, tab := tab, rest := rest }
  | k + 1, rest =>
    let a := scanE g intr tab rest
    if !a.ok then a else scanN g intr a.tab k a.rest
partial def scanArgs (g : Dg) (intr : List Int) (tab : CtorTab) : List Int → ScanR
  | 0 :: rest => { ok := true, tab := tab, rest := rest }
  | 1 :: rest =>
    let a := scanE g intr tab rest
    if !a.ok then a else scanArgs g intr a.tab a.rest
  | rest => { ok := false, tab := tab, rest := rest }
end

/-! ### The functions only the reserved forms call

A reserved form's body is a certificate of its meaning, and it may call helpers (the default
record that `read` returns out of range, for one). Once the forms are IR nothing calls those
helpers; they are the only functions that may stay without a translation. -/

mutual
-- the callees of one expression, by the wire's grammar (as `scanE`)
partial def calledE (g : Dg) (acc : List Nat) (rest0 : List Int) : List Nat :=
  match drE g rest0 with
  | [] => acc
  | tag :: bs =>
    if tag == 4 || tag == 14 then calledN g acc 2 (skipTyD g bs).rest
    else if tag == 5 || tag == 20 || tag == 48 then calledN g acc 3 bs
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16
        || tag == 19 || tag == 26 || tag == 27 || tag == 28 || tag == 47 then calledN g acc 2 bs
    else if tag == 9 || tag == 17 || tag == 18 || tag == 21 || tag == 23 || tag == 25 || tag == 36 || tag == 39 || tag == 40
        || tag == 44 || tag == 45 || tag == 46 || tag == 49 then calledN g acc 1 bs
    else if tag == 24 || tag == 29 || tag == 30 || tag == 38 || tag == 42 || tag == 43 then calledN g acc 1 (skipTyD g bs).rest
    else if tag == 31 then calledN g acc 1 (readLeb bs).rest
    else if tag == 32 then
      let t := skipTyD g bs
      calledArgs g (calledE g acc t.rest) (skipE g profile.v2Fuel t.rest).rest
    else if tag == 34 then calledN g acc 2 (skipName bs).rest
    else if tag == 35 then calledN g acc 1 (readLeb (skipTyD g bs).rest).rest
    else if tag == 50 then calledN g acc 3 (skipTyD g bs).rest
    else if tag == 51 then calledN g acc 4 (skipTyD g bs).rest
    else if tag == 52 then
      let r := readLeb bs
      calledArgs g (if r.ok == profile.cOk && r.n >= 0 then r.n.toNat :: acc else acc) r.rest
    else acc
partial def calledN (g : Dg) (acc : List Nat) : Nat → List Int → List Nat
  | 0, _ => acc
  | k + 1, rest => calledN g (calledE g acc rest) k (skipE g profile.v2Fuel rest).rest
partial def calledArgs (g : Dg) (acc : List Nat) : List Int → List Nat
  | 1 :: rest => calledArgs g (calledE g acc rest) (skipE g profile.v2Fuel rest).rest
  | _ => acc
end

-- body f of the stream (after its marker byte), or []
def bodyAt : Nat → Dg → List Int → List Int
  | 0, _, 1 :: body => body
  | k + 1, g, 1 :: body => bodyAt k g (skipE g profile.v2Fuel body).rest
  | _, _, _ => []

def addNew : List Nat → List Nat → List Nat
  | [], acc => acc
  | x :: xs, acc => addNew xs (if acc.contains x then acc else x :: acc)

-- the functions reachable from `work` by calls, added to `seen`
partial def calledClosure (g : Dg) (bodies : List Int) (work : List Nat) (seen : List Nat) : List Nat :=
  match work with
  | [] => seen
  | f :: rest =>
    let cs := (calledE g [] (bodyAt f g bodies)).filter (fun c => !seen.contains c)
    calledClosure g bodies (addNew cs rest) (addNew cs seen)

def reservedFns (intr : List Int) (f : Nat) : List Nat :=
  match intr with
  | [] => []
  | k :: ks => (if k != 0 then [f] else []) ++ reservedFns ks (f + 1)

/-! ## Translation -/

-- A translated value. kind 0: a run of words, `ws` the arguments and `ts` their types.
-- kind 1: the record `read` returns, seen through its handle `ws = [h]`; no word exists for it.
-- kind 2: the children list of such a record, `ws = [h]`.
structure Val where
  kind : Nat
  ws : List Int
  ts : List Int
  -- the wire type of a kind-0 value where it is known ([] where not): a list's element type and an
  -- option's payload type are read from it
  wt : List Int := []
  -- [n] when the value is the integer literal n, [] otherwise: the number of a child is a literal
  -- (`trKid`), in place or through a variable that holds one
  lit : List Int := []
  deriving Inhabited

def valWords (ws ts : List Int) : Val := { kind := 0, ws := ws, ts := ts }
def valLit (x : Int) (n : Int) : Val := { kind := 0, ws := [x], ts := [tyI64], lit := [n] }
def valNone : Val := valWords [] []
def valTyped (ws ts wt : List Int) : Val := { kind := 0, ws := ws, ts := ts, wt := wt }

-- the element type of a list type, the payload type of an option type; [] when `wt` is neither
def wtElem (g : Dg) (wt : List Int) : List Int :=
  match tyView g wt with
  | 4 :: elem => if isHeapNode g elem then [] else elem
  | _ => []
def wtPayload (g : Dg) (wt : List Int) : List Int :=
  match tyView g wt with
  | 8 :: t => t
  | _ => []

-- the type of a list of `elem`, of an option of `t`, written in line; [] where the part is not known
def wtListOf (elem : List Int) : List Int := if elem.isEmpty then [] else 4 :: elem
def wtOptionOf (t : List Int) : List Int := if t.isEmpty then [] else 8 :: t
def wtIsList (g : Dg) (wt : List Int) : Bool :=
  match tyView g wt with
  | 4 :: _ => true
  | _ => false

-- A record type's first field, and the record type of the fields after it (written in line: the
-- count, then the stream where the first field ended). `ok` is false where `wt` is no record
-- with a field.
structure RecHead where
  ok : Bool
  head : List Int
  tail : List Int
  deriving Inhabited

def wtRecHead (g : Dg) (wt : List Int) : RecHead :=
  match tyView g wt with
  | 7 :: bs =>
    let n := readLeb bs
    if n.ok != profile.cOk || n.n < 1 then { ok := false, head := [], tail := [] }
    else
      let nm := skipName n.rest
      let t := readTyD g nm.rest
      if nm.ok != profile.cOk || t.ok != profile.cOk then { ok := false, head := [], tail := [] }
      else { ok := true, head := t.acc, tail := 7 :: (lebU (n.n.toNat - 1) ++ t.rest) }
  | _ => { ok := false, head := [], tail := [] }

-- what is fixed while one function is translated
structure Cx where
  g : Dg
  intr : List Int
  sigs : List (List Int)
  tab : CtorTab
  -- the number of the image's functions: the stage's own list functions follow them
  n : Nat
  -- the wire type of the result of the function being translated: what an expression in tail
  -- position is expected to have
  rty : List Int := []
  -- the functions whose signature holds the node record (`fwInl`): for each, its number and then
  -- the stream at its body. A call of one is translated in place (`trCall`).
  inl : List (List Int) := []
  -- the functions of `inl` whose bodies are being translated in place, innermost first. Their
  -- number is how many calls the code written now stands below its place (`mkFapAt`, `mkGuard`).
  inlOn : List Int := []
  -- pairs (function, operation) for the functions that are the front end's integer operations ("Magnitudes", `magFind`)
  mag : List Int := []
  -- the image builds arrays ("Arrays"): a list may then be an array wherever one arrives
  arr : Bool := false
  -- `mag` names the functions that pack numbers into a node ("Numbers in nodes")
  num : Bool := false

structure TV where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  next : Nat
  items : List N
  val : Val
  rest : List Int
  deriving Inhabited

def tvFail (err : Residue) (rest : List Int) : TV :=
  { ok := false, err := some err, next := 0, items := [], val := valNone, rest := rest }

-- the refusal of a part, passed on as it is
def tvPass (err : Option Residue) (rest : List Int) : TV :=
  { ok := false, err := err, next := 0, items := [], val := valNone, rest := rest }

-- An `if` whose value is used: a join point over what follows. In the list of instructions it is
-- one item of this code, holding the join point's index and parameters and the case that jumps.
def opSplit : Nat := 90

def mkSplit (j : Nat) (ps : List Param) (c : N) : N :=
  { n0 opSplit with a := (j : Int), ys := paramsTo ps, kids := [c] }

mutual
-- every `jmp j ys` of the body becomes `tgt` with the arguments ys
partial def retarget (j : Int) (tgt : N) (n : N) : N :=
  if n.op == opJmp then (if n.a == j then { tgt with ys := n.ys } else n)
  else if n.op == opVDecl then { n with kids := [kidAt 0 n.kids, retarget j tgt (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [retarget j tgt (jdeclBody n), retarget j tgt (bodyOf n)] }
  else if n.op == opCase then { n with kids := retargetAlts j tgt (caseAlts n) }
  else if isTerminal n then n
  else setBody n (retarget j tgt (bodyOf n))
partial def retargetAlts (j : Int) (tgt : N) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (retarget j tgt (altBody alt)) :: retargetAlts j tgt alts
end

def paramArgs : List Param → List Int
  | [] => []
  | p :: ps => (p.x : Int) :: paramArgs ps

-- The body made of `items` in order, then `term`. A split item makes what follows it a join
-- point. When what follows only returns the join point's parameters, or only passes them to
-- another join point, there is nothing to join: each jump returns, or jumps on, itself. That
-- keeps a call whose value is the function's value a call in tail position (EmitUtil.lean:14
-- `isTailCallTo` asks for the `ret` right after the call).
def assemble : List N → N → N
  | [], term => term
  | i :: is, term =>
    if i.op == opSplit then
      let rest := assemble is term
      if (rest.op == opRet || rest.op == opJmp) && rest.ys == paramArgs (paramsOf i.ys) then retarget i.a rest (kidAt 0 i.kids)
      else { n0 opJDecl with a := i.a, ys := i.ys, kids := [rest, kidAt 0 i.kids] }
    else setBody i (assemble is term)

def envAt : Nat → List Val → Option Val
  | _, [] => none
  | 0, v :: _ => some v
  | i + 1, _ :: vs => envAt i vs

def litHeld (v : Val) : Int :=
  match v.lit with
  | [n] => if n >= 0 then n else -1
  | _ => -1

-- the integer literal an expression is, written in place or held by the variable it names; -1 when
-- it is neither, or is negative
def litOf (g : Dg) (env : List Val) (a : List Int) : Int :=
  match drE g a with
  | 0 :: lit =>
    let i := readLeafI64 lit
    if i.ok == profile.cOk && i.n >= 0 then i.n else -1
  | 3 :: bs =>
    let ix := readLeb bs
    if ix.ok != profile.cOk || ix.n < 0 then -1
    else
      match envAt ix.n.toNat env with
      | some v => litHeld v
      | none => -1
  | _ => -1

-- the stream at the body of function f among `Cx.inl`, [] when f is not one of them
def inlBody (f : Int) : List (List Int) → List Int
  | [] => []
  | (g :: body) :: rest => if g == f then body else inlBody f rest
  | [] :: rest => inlBody f rest

-- the arguments of a call that is translated in place: their instructions, their values in order,
-- and the stream of the callee's signature after its parameters
structure InArgs where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  next : Nat
  items : List N
  env : List Val
  sig : List Int
  deriving Inhabited

def inArgsFail (err : Residue) : InArgs := { ok := false, err := some err, next := 0, items := [], env := [], sig := [] }
def inArgsPass (err : Option Residue) : InArgs := { ok := false, err := err, next := 0, items := [], env := [], sig := [] }

-- the words that exist in the IR: every word but the irrelevant ones
def liveWords : List Int → List Int → List Int
  | w :: ws, t :: ts => if tyIsIrr t then liveWords ws ts else w :: liveWords ws ts
  | _, _ => []

def liveTys : List Int → List Int
  | [] => []
  | t :: ts => if tyIsIrr t then liveTys ts else t :: liveTys ts

-- a tag known for a handle: pairs h, t
def factOf (h : Int) : List Int → Int
  | x :: t :: rest => if x == h then t else factOf h rest
  | _ => -1

def takeI : Nat → List Int → List Int
  | 0, _ => []
  | _, [] => []
  | k + 1, x :: xs => x :: takeI k xs

structure FreshR where
  next : Nat
  vars : List Int
  deriving Inhabited

-- one fresh variable per type; an irrelevant word gets none
def freshFor : List Int → Nat → FreshR
  | [], next => { next := next, vars := [] }
  | t :: ts, next =>
    if tyIsIrr t then
      let r := freshFor ts next
      { next := r.next, vars := argIrr :: r.vars }
    else
      let r := freshFor ts (next + 1)
      { next := r.next, vars := (next : Int) :: r.vars }

-- binders x, ty, ... of the live words
def bindsOf : List Int → List Int → List Int
  | w :: ws, t :: ts => if tyIsIrr t then bindsOf ws ts else w :: t :: bindsOf ws ts
  | _, _ => []

def paramsOfWords : List Int → List Int → List Param
  | w :: ws, t :: ts => if tyIsIrr t then paramsOfWords ws ts else { x := w.toNat, borrow := false, ty := t } :: paramsOfWords ws ts
  | _, _ => []

-- a function whose value has no live word still returns one argument, an irrelevant one
def retArgsOf (v : Val) : List Int :=
  let ws := liveWords v.ws v.ts
  if ws.isEmpty then [argIrr] else ws

/-! ## Lists

A list is Lean's (lean.h `lean_ctor_object`; docs/OBJECT-ABI.md, "Step-0b current-RSCM boundary":
"List nil is 1", boxing "at heap boundaries, including ... linked-list heads"): nil is the boxed
scalar 0 and a cell is constructor 1. The head sits in the cell by the element's words. One scalar
word: in the cell's scalar area, the tail is object field 0. One object word: object field 0, the
tail is object field 1. Several words, or none: in a box of their own (constructor 0, the object
words first, then the scalar words, eight bytes each), which the cell holds as its object.
Every nil has one CtorInfo, whatever the list's type: `[]` carries no type on the wire, and
ElimDeadBranches compares a known constructor with an alternative by the whole info
(ElimDeadBranches.lean:213 `containsCtor`). -/

def lsScalar : Nat := 0
def lsObject : Nat := 1

def nilInfo : CtorInfo := { cidx := 0, size := 0, ssize := 0, tid := 2 }
def consInfo (shape : Nat) : CtorInfo :=
  if shape == lsScalar then { cidx := 1, size := 1, ssize := 8, tid := 2 } else { cidx := 1, size := 2, ssize := 0, tid := 3 }
-- the object field that holds the tail
def consTail (shape : Nat) : Nat := if shape == lsScalar then 0 else 1

def countObj : List Int → Nat
  | [] => 0
  | t :: ts => (if tyIsIrr t || tyIsScalar t then 0 else 1) + countObj ts
def countScal : List Int → Nat
  | [] => 0
  | t :: ts => (if tyIsIrr t then 0 else if tyIsScalar t then 1 else 0) + countScal ts

def boxInfo (ts : List Int) : CtorInfo :=
  { cidx := 0, size := countObj ts, ssize := 8 * countScal ts, tid := 16 + 64 * countObj ts + countScal ts }

-- how an element of flat types `ts` sits in a cell: 0 a scalar in the cell, 1 an object in the
-- cell, 2 a box
def elemKind (ts : List Int) : Nat :=
  match liveTys ts with
  | [t] => if tyIsScalar t then 0 else 1
  | _ => 2
def elemShape (ts : List Int) : Nat := if elemKind ts == 0 then lsScalar else lsObject

def objWords : List Int → List Int → List Int
  | w :: ws, t :: ts => if tyIsIrr t || tyIsScalar t then objWords ws ts else w :: objWords ws ts
  | _, _ => []

-- the writes of a box's scalar words, in order, eight bytes each
def boxSSets (bx n slot : Nat) : List Int → List Int → List N
  | w :: ws, t :: ts =>
    if tyIsIrr t || !tyIsScalar t then boxSSets bx n slot ws ts
    else mkSSet bx n (8 * slot) w.toNat tyI64 mkUnreachable :: boxSSets bx n (slot + 1) ws ts
  | _, _ => []

structure ItemsR where
  next : Nat
  items : List N
  ws : List Int
  deriving Inhabited

-- the cell of head (ws, ts) and tail `tl`; its variable is the one word of the result
def consItems (ws ts : List Int) (tl : Int) (next : Nat) : ItemsR :=
  let k := elemKind ts
  let live := liveWords ws ts
  if k == 0 then
    { next := next + 1, ws := [(next : Int)],
      items := [mkVDecl next tyTObj (mkCtor (consInfo lsScalar) [tl]) mkUnreachable, mkSSet next 1 0 (intAt 0 live).toNat tyI64 mkUnreachable] }
  else if k == 1 then
    { next := next + 1, ws := [(next : Int)], items := [mkVDecl next tyTObj (mkCtor (consInfo lsObject) [intAt 0 live, tl]) mkUnreachable] }
  else
    let info := boxInfo ts
    let x := next + 1
    { next := x + 1, ws := [(x : Int)],
      items := [mkVDecl next tyTObj (mkCtor info (objWords ws ts)) mkUnreachable] ++ boxSSets next info.size 0 ws ts
        ++ [mkVDecl x tyTObj (mkCtor (consInfo lsObject) [(next : Int), tl]) mkUnreachable] }

-- the words of a box `bx` of `n` object fields, read back in the order of `ts`
def boxReads (bx n : Nat) : Nat → Nat → Nat → List Int → ItemsR
  | _, _, next, [] => { next := next, items := [], ws := [] }
  | oi, si, next, t :: ts =>
    if tyIsIrr t then
      let r := boxReads bx n oi si next ts
      { next := r.next, items := r.items, ws := argIrr :: r.ws }
    else if tyIsScalar t then
      let r := boxReads bx n oi (si + 1) (next + 1) ts
      { next := r.next, items := mkVDecl next tyI64 (mkSProj n (8 * si) bx) mkUnreachable :: r.items, ws := (next : Int) :: r.ws }
    else
      let r := boxReads bx n (oi + 1) si (next + 1) ts
      { next := r.next, items := mkVDecl next t (mkProj oi bx) mkUnreachable :: r.items, ws := (next : Int) :: r.ws }

-- the one live word `v` put at its place among the words of `ts`
def placeLive (v : Int) : List Int → List Int
  | [] => []
  | t :: ts => (if tyIsIrr t then argIrr else v) :: placeLive v ts

def firstLive : List Int → Int
  | [] => tyI64
  | t :: ts => if tyIsIrr t then firstLive ts else t

-- the head of cell `x`, whose element has flat types `ts`
def headItems (ts : List Int) (x : Nat) (next : Nat) : ItemsR :=
  let k := elemKind ts
  if k == 0 then
    { next := next + 1, ws := placeLive (next : Int) ts, items := [mkVDecl next tyI64 (mkSProj 1 0 x) mkUnreachable] }
  else if k == 1 then
    { next := next + 1, ws := placeLive (next : Int) ts, items := [mkVDecl next (firstLive ts) (mkProj 0 x) mkUnreachable] }
  else
    let r := boxReads next (boxInfo ts).size 0 0 (next + 1) ts
    { next := r.next, ws := r.ws, items := mkVDecl next tyTObj (mkProj 0 x) mkUnreachable :: r.items }

-- A value that is never read, one variable per live word: the payload of an absent option. A
-- string word is the empty string (its type says "an object", and a count on it reads a header);
-- any other object word is the boxed scalar 0.
def dummyItems : Nat → List Int → ItemsR
  | next, [] => { next := next, items := [], ws := [] }
  | next, t :: ts =>
    if tyIsIrr t then
      let r := dummyItems next ts
      { next := r.next, items := r.items, ws := argIrr :: r.ws }
    else
      let r := dummyItems (next + 1) ts
      let e := if tyIsScalar t then mkLit 0 else if t == tyObj then mkLitStr "" else mkCtor nilInfo []
      { next := r.next, items := mkVDecl next t e mkUnreachable :: r.items, ws := (next : Int) :: r.ws }

-- The refusal of `unwrap` on an absent option (rsc/rsc.rsd, `refuseStuck stTypeMismatch`): one
-- refusing primitive per live word, so that the words exist where the code goes on. The
-- primitive takes an irrelevant argument for the reason `trCall` gives.
def failItems : Nat → List Int → ItemsR
  | next, [] => { next := next, items := [], ws := [] }
  | next, t :: ts =>
    if tyIsIrr t then
      let r := failItems next ts
      { next := r.next, items := r.items, ws := argIrr :: r.ws }
    else
      let r := failItems (next + 1) ts
      { next := r.next, items := mkVDecl next t (mkPrim primFail 0 0 [argIrr]) mkUnreachable :: r.items, ws := (next : Int) :: r.ws }

-- no live word at all: the refusal still has to run
def failAlways (next : Nat) : ItemsR :=
  { next := next + 1, items := [mkVDecl next tyI64 (mkPrim primFail 0 0 [argIrr]) mkUnreachable], ws := [] }

/-! ## Sums

A value of a sum type is a constructor object, as a value of a Lean inductive type is (lean.h
`lean_ctor_object`): summand k is constructor k; the words of its payload are the object's fields,
the object words in order as object fields and the scalar words eight bytes each in the scalar
area (the layout of a list element's box, `boxInfo`). A summand whose payload has no live word is
the boxed scalar k and allocates nothing. The present lowering keeps a sum as a tag word and the
words of its widest summand (rsc/rsc.rsd `sumArmWithLayers`); the value read at a match is the same.

The type id of the constructors is a number computed from the sum type's structure, so that the
constructor a value was built with and the alternative that matches it carry one CtorInfo
(ElimDeadBranches.lean:213 compares them whole). -/

-- the summand types of a sum type, in order; [] where `wt` is not one (or does not parse)
partial def wtArmsGo (g : Dg) : Nat → List Int → List (List Int)
  | 0, _ => []
  | k + 1, rest =>
    let t := readTyD g rest
    if t.ok != profile.cOk then [] else t.acc :: wtArmsGo g k t.rest

def wtArms (g : Dg) (wt : List Int) : List (List Int) :=
  match tyView g wt with
  | 6 :: bs =>
    let n := readLeb bs
    if n.ok != profile.cOk || n.n < 0 then []
    else
      let arms := wtArmsGo g n.n.toNat n.rest
      if arms.length == n.n.toNat then arms else []
  | _ => []

def wtIsSum (g : Dg) (wt : List Int) : Bool :=
  match tyView g wt with
  | 6 :: _ => true
  | _ => false

def armAt : Nat → List (List Int) → List Int
  | _, [] => []
  | 0, t :: _ => t
  | k + 1, _ :: ts => armAt k ts

def tyHashMod : Nat := 1000003

mutual
-- a number that structurally equal types share, whatever way the wire refers to them
partial def tyHash (g : Dg) (ty : List Int) : Nat :=
  if isHeapHandle g ty then 7
  else
    match tyView g ty with
    | [0] => 1
    | [1] => 2
    | [2] => 3
    | [3] => 4
    | 4 :: elem => (5 + 31 * tyHash g elem) % tyHashMod
    | 8 :: t => (6 + 37 * tyHash g t) % tyHashMod
    | 6 :: bs =>
      let n := readLeb bs
      if n.ok != profile.cOk || n.n < 0 then 0 else tyHashRun g false n.n.toNat 11 n.rest
    | 7 :: bs =>
      let n := readLeb bs
      if n.ok != profile.cOk || n.n < 0 then 0 else tyHashRun g true n.n.toNat 13 n.rest
    | _ => 0
-- a run of n types, each after a field name when `named`
partial def tyHashRun (g : Dg) (named : Bool) : Nat → Nat → List Int → Nat
  | 0, h, _ => h
  | k + 1, h, rest =>
    let r := if named then (skipName rest).rest else rest
    let t := readTyD g r
    if t.ok != profile.cOk then 0 else tyHashRun g named k ((h * 41 + tyHash g t.acc + 1) % tyHashMod) t.rest
end

def sumTid (g : Dg) (wt : List Int) : Nat := 4096 + tyHash g wt

mutual
-- Does a value of type `ty` hold a sum among its own words (not inside a list)? At the module's
-- boundary such a value has the present lowering's words, a tag and the widest summand's
-- (lib/RscBase.rsd `sumArmWithLayers`), and here it is one object: lib/lrc/Emit.rsd gives a
-- function with one in its signature a public entry that refuses, as it does for a reserved form.
partial def tyHasSumWord (g : Dg) (ty : List Int) : Bool :=
  if isHeapHandle g ty then false
  else
    match tyView g ty with
    | 6 :: _ => true
    | 8 :: t => tyHasSumWord g t
    | 7 :: bs =>
      let n := readLeb bs
      n.ok == profile.cOk && n.n >= 0 && tyHasSumRun g n.n.toNat n.rest
    | _ => false
partial def tyHasSumRun (g : Dg) : Nat → List Int → Bool
  | 0, _ => false
  | k + 1, rest =>
    let t := readTyD g (skipName rest).rest
    t.ok == profile.cOk && (tyHasSumWord g t.acc || tyHasSumRun g k t.rest)
end

-- the same for a signature: any parameter, or the result
partial def sigHasSumWord (g : Dg) : Nat → List Int → Bool
  | 0, rest => tyHasSumWord g (readTyD g rest).acc
  | k + 1, rest =>
    let t := readTyD g rest
    tyHasSumWord g t.acc || sigHasSumWord g k t.rest

def sumInfo (tid k : Nat) (ts : List Int) : CtorInfo :=
  { cidx := k, size := countObj ts, ssize := 8 * countScal ts, tid := tid }

-- constructor k of the sum over the payload's words; its variable is the one word of the result
def sumItems (tid k : Nat) (ws ts : List Int) (next : Nat) : ItemsR :=
  let info := sumInfo tid k ts
  { next := next + 1, ws := [(next : Int)],
    items := mkVDecl next tyTObj (mkCtor info (objWords ws ts)) mkUnreachable :: boxSSets next info.size 0 ws ts }

/-! ## Loops

The wire has two loops, `boundedFold` over a list and `boundedFix` up to a bound. The IR has none
but a function that calls itself in tail position (EmitC:551 emitTailCall), so each loop becomes
a function of its own after the image's functions and the stage's list functions: the loop's
state is its first parameters, and every variable of the enclosing function that the loop's body
reads is a further parameter (lambda lifting; Johnsson, "Lambda lifting: transforming programs to
recursive equations", FPCA 1985). The loop keeps the fuel of the function it stands in
(`evalSCMFold`, `evalSCMFix`): it is called by `mkFapSame`, and so is its call of itself.

While a function is translated, a lifted function sits in the list of instructions as the
expression of a binding (`opLiftE`), under a number that is unique in that function only
(`liftBase` + a fresh index). `liftsOut` takes them out of the finished body and `fwFns` gives
them their place in the image. -/

structure FvR where
  ok : Bool
  acc : List Nat
  rest : List Int
  deriving Inhabited

def fvAdd (i : Nat) (acc : List Nat) : List Nat := if acc.contains i then acc else i :: acc

mutual
-- The variables of the enclosing environment that the expression reads: `depth` binders are the
-- expression's own, a variable index at or above it is index - depth of the environment.
-- By the wire's grammar (lib/RscBase.rsd `skipEGo`, as `scanE`).
partial def fvE (g : Dg) (depth : Nat) (acc : List Nat) (rest0 : List Int) : FvR :=
  match rest0 with
  | [] => { ok := false, acc := acc, rest := [] }
  | 53 :: _ =>
    let s := skipE g profile.v2Fuel rest0
    let inner := fvE g depth acc (drE g rest0)
    { ok := s.ok == profile.cOk && inner.ok, acc := inner.acc, rest := s.rest }
  | tag :: bs =>
    if tag == 0 || tag == 41 then fvSkip acc (skipBytes 9 bs)
    else if tag == 1 then fvSkip acc (skipBytes 1 bs)
    else if tag == 2 then fvSkip acc (skipName bs)
    else if tag == 3 then
      let ix := readLeb bs
      if ix.ok != profile.cOk || ix.n < 0 then { ok := false, acc := acc, rest := bs }
      else { ok := true, acc := (if ix.n.toNat >= depth then fvAdd (ix.n.toNat - depth) acc else acc), rest := ix.rest }
    else if tag == 22 || tag == 33 || tag == 37 then { ok := true, acc := acc, rest := bs }
    else if tag == 4 then
      -- let: the value, then the body under one binder
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, acc := acc, rest := bs }
      else
        let v := fvE g depth acc t.rest
        if !v.ok then v else fvE g (depth + 1) v.acc v.rest
    else if tag == 5 || tag == 20 || tag == 48 then fvN g depth acc 3 bs
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16
        || tag == 19 || tag == 26 || tag == 27 || tag == 28 || tag == 47 then fvN g depth acc 2 bs
    else if tag == 9 || tag == 17 || tag == 18 || tag == 21 || tag == 23 || tag == 25 || tag == 36 || tag == 39 || tag == 40
        || tag == 44 || tag == 45 || tag == 46 || tag == 49 then fvN g depth acc 1 bs
    else if tag == 14 then fvTy g depth acc 2 bs
    else if tag == 24 || tag == 29 || tag == 30 || tag == 38 || tag == 42 || tag == 43 then fvTy g depth acc 1 bs
    else if tag == 31 then
      let r := readLeb bs
      if r.ok != profile.cOk then { ok := false, acc := acc, rest := bs } else fvN g depth acc 1 r.rest
    else if tag == 32 then
      -- match: the value, then each alternative under one binder
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, acc := acc, rest := bs }
      else
        let a := fvE g depth acc t.rest
        if !a.ok then a else fvArgs g (depth + 1) a.acc a.rest
    else if tag == 34 then
      let nm := skipName bs
      if nm.ok != profile.cOk then { ok := false, acc := acc, rest := bs } else fvN g depth acc 2 nm.rest
    else if tag == 35 then
      let t := skipTyD g bs
      let r := readLeb t.rest
      if t.ok != profile.cOk || r.ok != profile.cOk then { ok := false, acc := acc, rest := bs } else fvN g depth acc 1 r.rest
    else if tag == 50 then
      -- fold: the list and the start value, then the body under two binders
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, acc := acc, rest := bs }
      else
        let a := fvN g depth acc 2 t.rest
        if !a.ok then a else fvE g (depth + 2) a.acc a.rest
    else if tag == 51 then
      -- fixpoint: the test and the step under one binder, then the start state and the bound
      let t := skipTyD g bs
      if t.ok != profile.cOk then { ok := false, acc := acc, rest := bs }
      else
        let a := fvN g (depth + 1) acc 2 t.rest
        if !a.ok then a else fvN g depth a.acc 2 a.rest
    else if tag == 52 then
      let r := readLeb bs
      if r.ok != profile.cOk then { ok := false, acc := acc, rest := bs } else fvArgs g depth acc r.rest
    else { ok := false, acc := acc, rest := bs }
partial def fvSkip (acc : List Nat) (r : Rd) : FvR := { ok := r.ok == profile.cOk, acc := acc, rest := r.rest }
partial def fvTy (g : Dg) (depth : Nat) (acc : List Nat) (n : Nat) (bs : List Int) : FvR :=
  let t := skipTyD g bs
  if t.ok != profile.cOk then { ok := false, acc := acc, rest := bs } else fvN g depth acc n t.rest
partial def fvN (g : Dg) (depth : Nat) (acc : List Nat) : Nat → List Int → FvR
  | 0, rest => { ok := true, acc := acc, rest := rest }
  | k + 1, rest =>
    let a := fvE g depth acc rest
    if !a.ok then a else fvN g depth a.acc k a.rest
-- a list 1 e ... 0, every e under the same binders
partial def fvArgs (g : Dg) (depth : Nat) (acc : List Nat) : List Int → FvR
  | 0 :: rest => { ok := true, acc := acc, rest := rest }
  | 1 :: rest =>
    let a := fvE g depth acc rest
    if !a.ok then a else fvArgs g depth a.acc a.rest
  | rest => { ok := false, acc := acc, rest := rest }
end

def opLiftE : Nat := 91
def liftBase : Nat := 1000000

-- the lifted function `tmp` as one instruction: the binding of an unused variable to it
def liftItem (x tmp : Nat) (ps : List Param) (rets : List Int) (body : N) : N :=
  mkVDecl x tyIrr { n0 opLiftE with a := (tmp : Int), ys := paramsTo ps, kids := [body, { n0 opLit with ys := rets }] } mkUnreachable

-- pairs old, new
def varMapFind (v : Int) : List Int → Int
  | o :: w :: rest => if o == v then w else varMapFind v rest
  | _ => -1

structure LiftEnv where
  next : Nat
  -- pairs old variable, new variable: every live variable the body reads, once
  map : List Int
  -- the types of the mapped variables, in step with the pairs
  tys : List Int
  deriving Inhabited

-- the words of one value of the environment mapped to fresh variables of the lifted function
def liftWords : List Int → List Int → LiftEnv → LiftEnv
  | w :: ws, t :: ts, le =>
    if w < 0 || tyIsIrr t || varMapFind w le.map >= 0 then liftWords ws ts le
    else liftWords ws ts { next := le.next + 1, map := le.map ++ [w, (le.next : Int)], tys := le.tys ++ [t] }
  | _, _, le => le

def mapWords (m : List Int) : List Int → List Int
  | [] => []
  | w :: ws => (if w < 0 then w else varMapFind w m) :: mapWords m ws

-- the types of a value's words: a node seen through its handle (kinds 1 and 2) is that one object word
def valTys (v : Val) : List Int := if v.kind == 0 then v.ts else [tyTObj]

-- the values at the indices `fv` of the environment, their variables entered into the map
def liftCollect (env : List Val) : List Nat → LiftEnv → LiftEnv
  | [], le => le
  | i :: is, le =>
    match envAt i env with
    | some v => liftCollect env is (liftWords v.ws (valTys v) le)
    | none => liftCollect env is le

structure CallR where
  next : Nat
  item : N
  vars : List Int
  deriving Inhabited

-- a call bound to fresh variables of the result's types `ts` (as `trCall` binds one)
def callItem (ts : List Int) (call : N) (next : Nat) : CallR :=
  let rs := freshFor ts next
  match bindsOf rs.vars ts with
  | x :: ty :: extra => { next := rs.next, item := mkVDecls x.toNat ty extra call mkUnreachable, vars := rs.vars }
  | _ => { next := rs.next + 1, item := mkVDecl rs.next tyIrr call mkUnreachable, vars := rs.vars }

-- the arguments of a return of the words (ws, ts): the live ones, or one irrelevant argument
def retWords (ws ts : List Int) : List Int :=
  let live := liveWords ws ts
  if live.isEmpty then [argIrr] else live

def liftRets (ts : List Int) : List Int := if (liveTys ts).isEmpty then [tyIrr] else liveTys ts

-- A value no code may use: the place of a variable the lifted body does not read.
def valAbsent : Val := { kind := 7, ws := [], ts := [] }

-- the environment of the lifted function: a value the body reads has its words renamed, any other is absent
def liftEnvGo (m : List Int) (fv : List Nat) : Nat → List Val → List Val
  | _, [] => []
  | i, v :: vs => (if fv.contains i then { v with ws := mapWords m v.ws } else valAbsent) :: liftEnvGo m fv (i + 1) vs

-- the facts about variables that were renamed, under their new names
def liftFacts (m : List Int) : List Int → List Int
  | h :: t :: rest => (if varMapFind h m >= 0 then [varMapFind h m, t] else []) ++ liftFacts m rest
  | _ => []

def mapOlds : List Int → List Int
  | o :: _ :: rest => o :: mapOlds rest
  | _ => []
def mapNews : List Int → List Int
  | _ :: w :: rest => w :: mapNews rest
  | _ => []

def paramsOfTys : List Int → List Int → List Param
  | x :: xs, t :: ts => { x := x.toNat, borrow := false, ty := t } :: paramsOfTys xs ts
  | _, _ => []

structure LiftsR where
  node : N
  decls : List Decl
  deriving Inhabited

structure LiftsAlts where
  alts : List N
  decls : List Decl
  deriving Inhabited

mutual
-- the body without its lifted functions, and those as declarations (under their numbers of the moment)
partial def liftsOut (n : N) : LiftsR :=
  if n.op == opVDecl && (vdeclExpr n).op == opLiftE then
    let e := vdeclExpr n
    let b := liftsOut (kidAt 0 e.kids)
    let k := liftsOut (bodyOf n)
    { node := k.node,
      decls := { f := e.a.toNat, xs := paramsOf e.ys, rets := (kidAt 1 e.kids).ys, body := b.node, ext := false } :: (b.decls ++ k.decls) }
  else if n.op == opVDecl then
    let k := liftsOut (bodyOf n)
    { node := { n with kids := [vdeclExpr n, k.node] }, decls := k.decls }
  else if n.op == opJDecl then
    let v := liftsOut (jdeclBody n)
    let k := liftsOut (bodyOf n)
    { node := { n with kids := [v.node, k.node] }, decls := v.decls ++ k.decls }
  else if n.op == opCase then
    let r := liftsOutAlts (caseAlts n)
    { node := { n with kids := r.alts }, decls := r.decls }
  else if isTerminal n then { node := n, decls := [] }
  else
    let k := liftsOut (bodyOf n)
    { node := setBody n k.node, decls := k.decls }
partial def liftsOutAlts : List N → LiftsAlts
  | [] => { alts := [], decls := [] }
  | alt :: alts =>
    let b := liftsOut (altBody alt)
    let r := liftsOutAlts alts
    { alts := altSetBody alt b.node :: r.alts, decls := b.decls ++ r.decls }
end

mutual
-- every call of a lifted function under its number of the moment turned to its place in the image
partial def liftRenum (m : List Int) (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let e2 := if e.op == opFap && fapFn e >= liftBase && varMapFind e.a m >= 0 then { e with a := varMapFind e.a m } else e
    { n with kids := [e2, liftRenum m (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [liftRenum m (jdeclBody n), liftRenum m (bodyOf n)] }
  else if n.op == opCase then { n with kids := liftRenumAlts m (caseAlts n) }
  else if isTerminal n then n
  else setBody n (liftRenum m (bodyOf n))
partial def liftRenumAlts (m : List Int) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (liftRenum m (altBody alt)) :: liftRenumAlts m alts
end

-- pairs (number of the moment, place in the image) for the lifted functions, the first at `base`
def liftPlaces (base : Nat) : List Decl → List Int
  | [] => []
  | d :: ds => (d.f : Int) :: (base : Int) :: liftPlaces (base + 1) ds

def liftPlaced (m : List Int) : List Decl → List Decl
  | [] => []
  | d :: ds => { d with f := (varMapFind (d.f : Int) m).toNat, body := liftRenum m d.body } :: liftPlaced m ds

/-! ### The list functions the wire has as operators

`len`, `drop` and `append` on a list of either cell shape are functions of the stage, written in
the IR after the image's own (index n + ...), so that the passes count their references and reuse
their cells as they do for a source function. They are loops (a call of itself in tail position),
and they take no fuel: the wire's fuel is the depth of source calls. `append` is Lean's
`List.appendTR`: reverse the left list, then reverse it onto the right one. -/

def hLen (n shape : Nat) : Nat := n + shape
def hDrop (n shape : Nat) : Nat := n + 2 + shape
def hRev (n shape : Nat) : Nat := n + 4 + shape
def hApp (n shape : Nat) : Nat := n + 6 + shape
def hEq (n : Nat) : Nat := n + 8
-- the functions of a magnitude ("Magnitudes" below)
def hNatOf (n : Nat) : Nat := n + 9
def hNatOfGo (n : Nat) : Nat := n + 10
def hNatDigits (n : Nat) : Nat := n + 11
def hDigitsGo (n : Nat) : Nat := n + 12
def hMagEq (n : Nat) : Nat := n + 13
-- the functions of a list that may be an array ("Arrays")
def hLenA (n shape : Nat) : Nat := n + 14 + shape
-- the functions of an integer's word ("An integer is one word" below)
def hIntSign (n : Nat) : Nat := n + 16
def hIntMag (n : Nat) : Nat := n + 17
def hIntOf (n : Nat) : Nat := n + 18
def hIntEq (n : Nat) : Nat := n + 19
def helperCount : Nat := nHelpers

def pT (x : Nat) : Param := { x := x, borrow := false, ty := tyTObj }
def pI (x : Nat) : Param := { x := x, borrow := false, ty := tyI64 }

-- lenAux xs acc
def declLen (n shape : Nat) : Decl :=
  let self := hLen n shape
  let step := mkVDecl 3 tyTObj (mkProj (consTail shape) 1) (mkVDecl 4 tyI64 (mkLit 1) (mkVDecl 5 tyI64 (mkPrim primAdd 0 0 [2, 4])
    (mkVDecl 6 tyI64 (mkFap self [3, 5]) (mkRet [6]))))
  { f := self, xs := [pT 1, pI 2], rets := [tyI64], ext := false,
    body := mkCase 1 tyTObj [mkAltCtor nilInfo (mkRet [2]), mkAltCtor (consInfo shape) step] }

-- drop k xs: xs without its first k cells, all of xs when k is not positive
def declDrop (n shape : Nat) : Decl :=
  let self := hDrop n shape
  let step := mkVDecl 5 tyTObj (mkProj (consTail shape) 2) (mkVDecl 6 tyI64 (mkLit 1) (mkVDecl 7 tyI64 (mkPrim primSub 0 0 [1, 6])
    (mkVDecl 8 tyTObj (mkFap self [7, 5]) (mkRet [8]))))
  { f := self, xs := [pI 1, pT 2], rets := [tyTObj], ext := false,
    body := mkVDecl 3 tyI64 (mkLit 0) (mkVDecl 4 tyI64 (mkPrim primLt 0 0 [3, 1])
      (mkIfW 4 (mkCase 2 tyTObj [mkAltCtor nilInfo (mkRet [2]), mkAltCtor (consInfo shape) step]) (mkRet [2]))) }

-- revAux xs acc: the cells of xs, last first, in front of acc
def declRev (n shape : Nat) : Decl :=
  let self := hRev n shape
  let call := mkVDecl 6 tyTObj (mkFap self [4, 5]) (mkRet [6])
  let step := if shape == lsScalar then
      mkVDecl 3 tyI64 (mkSProj 1 0 1) (mkVDecl 4 tyTObj (mkProj 0 1) (mkVDecl 5 tyTObj (mkCtor (consInfo lsScalar) [2])
        (mkSSet 5 1 0 3 tyI64 call)))
    else
      mkVDecl 3 tyTObj (mkProj 0 1) (mkVDecl 4 tyTObj (mkProj 1 1) (mkVDecl 5 tyTObj (mkCtor (consInfo lsObject) [3, 2]) call))
  { f := self, xs := [pT 1, pT 2], rets := [tyTObj], ext := false,
    body := mkCase 1 tyTObj [mkAltCtor nilInfo (mkRet [2]), mkAltCtor (consInfo shape) step] }

-- append a b
def declApp (n shape : Nat) : Decl :=
  { f := hApp n shape, xs := [pT 1, pT 2], rets := [tyTObj], ext := false,
    body := mkVDecl 3 tyTObj (mkCtor nilInfo []) (mkVDecl 4 tyTObj (mkFap (hRev n shape) [1, 3])
      (mkVDecl 5 tyTObj (mkFap (hRev n shape) [4, 2]) (mkRet [5]))) }

-- eq xs ys: 1 when two lists of one-word scalar elements hold the same words in the same order
-- (the wire's `eqE` at a list type: lean/rsd-cert/Residua/Bootstrap/SCM.lean compares the values)
def eqNo (x : Nat) : N := mkVDecl x tyI64 (mkLit 0) (mkRet [(x : Int)])

def declEq (n : Nat) : Decl :=
  let self := hEq n
  let both := mkVDecl 3 tyI64 (mkSProj 1 0 1) (mkVDecl 4 tyI64 (mkSProj 1 0 2) (mkVDecl 5 tyI64 (mkPrim primEq 0 0 [3, 4])
    (mkIfW 5 (mkVDecl 6 tyTObj (mkProj 0 1) (mkVDecl 7 tyTObj (mkProj 0 2) (mkVDecl 8 tyI64 (mkFap self [6, 7]) (mkRet [8])))) (eqNo 9))))
  { f := self, xs := [pT 1, pT 2], rets := [tyI64], ext := false,
    body := mkCase 1 tyTObj
      [mkAltCtor nilInfo (mkCase 2 tyTObj [mkAltCtor nilInfo (mkVDecl 10 tyI64 (mkLit 1) (mkRet [10])), mkAltCtor (consInfo lsScalar) (eqNo 11)]),
       mkAltCtor (consInfo lsScalar) (mkCase 2 tyTObj [mkAltCtor nilInfo (eqNo 12), mkAltCtor (consInfo lsScalar) both])] }

/-! ### Magnitudes

The front end writes a natural number as the record of one field, `\0NatMag1 : List Int`, and an
integer as the record of a sign and `\0IntMag1 : List Int`: the magnitude is a list of limbs in base
256, the least first, and the image's own functions compute on those lists. Here the magnitude's
word is Lean's own form of a natural number (lean.h `lean_box`, `lean_is_scalar`): an odd word is
the small number w / 2, and an even word points to the limb list as before. Zero was the empty
list, whose word is 1, and still is. A magnitude below 256^7 is written small; a larger one stays a
list.

The word changes its meaning at two kinds of place and nowhere else: where a marker record is
built from a list (`natOf`, lib/lrc/FromWire.rsd `trVal` at a record field) and where the field is
read as a list (`natDigits`, at a projection). What the image does with the list in between is the
image's code, unchanged, so a function of the image that the stage does not know stays right: it
reads lists and builds lists. Either form is taken where a word comes in (a host may pass limb
lists as before); what the stage builds is small whenever it can be. -/

-- the limbs of the largest magnitude that is written as a small number: below 256^7 = 2^56
def magLimbs : Nat := 7

-- natOfGo orig rest acc mul k: `rest` is what is left of the list `orig`, `acc` the value of the k
-- limbs before it, and mul = 256^k. The small number, or `orig` itself when it has more limbs.
def declNatOfGo (n : Nat) : Decl :=
  let self := hNatOfGo n
  let call := mkVDecl 16 tyTObj (mkFap self [1, 9, 11, 13, 15]) (mkRet [16])
  let count := mkVDecl 14 tyI64 (mkLit 1) (mkVDecl 15 tyI64 (mkPrim primAddW 0 0 [5, 14]) call)
  let scale := mkVDecl 12 tyI64 (mkLit 256) (mkVDecl 13 tyI64 (mkPrim primMulW 0 0 [4, 12]) count)
  let sum := mkVDecl 10 tyI64 (mkPrim primMulW 0 0 [8, 4]) (mkVDecl 11 tyI64 (mkPrim primAddW 0 0 [3, 10]) scale)
  let more := mkVDecl 8 tyI64 (mkSProj 1 0 2) (mkVDecl 9 tyTObj (mkProj 0 2) sum)
  let cell := mkVDecl 6 tyI64 (mkLit (magLimbs : Int)) (mkVDecl 7 tyI64 (mkPrim primEq 0 0 [5, 6]) (mkIfW 7 (mkRet [1]) more))
  { f := self, xs := [pT 1, pT 2, pI 3, pI 4, pI 5], rets := [tyTObj], ext := false,
    body := mkCase 2 tyTObj
      [mkAltCtor nilInfo (mkVDecl 17 tyTObj (mkPrim primBox 0 0 [3]) (mkRet [17])), mkAltCtor (consInfo lsScalar) cell] }

-- natOf l: the magnitude's word of a limb list
def declNatOf (n : Nat) : Decl :=
  { f := hNatOf n, xs := [pT 1], rets := [tyTObj], ext := false,
    body := mkVDecl 2 tyI64 (mkLit 0) (mkVDecl 3 tyI64 (mkLit 1) (mkVDecl 4 tyTObj (mkFap (hNatOfGo n) [1, 1, 2, 3, 2]) (mkRet [4]))) }

-- digitsGo v: the limbs of the number v, the least first
def declDigitsGo (n : Nat) : Decl :=
  let self := hDigitsGo n
  let cell := mkVDecl 8 tyTObj (mkCtor (consInfo lsScalar) [6]) (mkSSet 8 1 0 7 tyI64 (mkRet [8]))
  let low := mkVDecl 7 tyI64 (mkPrim primMask 255 0 [1]) cell
  let more := mkVDecl 5 tyI64 (mkPrim primShrW 8 0 [1]) (mkVDecl 6 tyTObj (mkFap self [5]) low)
  { f := self, xs := [pI 1], rets := [tyTObj], ext := false,
    body := mkVDecl 2 tyI64 (mkLit 0) (mkVDecl 3 tyI64 (mkPrim primEq 0 0 [1, 2])
      (mkIfW 3 (mkVDecl 4 tyTObj (mkCtor nilInfo []) (mkRet [4])) more)) }

-- natDigits w: the limb list of a magnitude's word
def declNatDigits (n : Nat) : Decl :=
  { f := hNatDigits n, xs := [pT 1], rets := [tyTObj], ext := false,
    body := mkVDecl 2 tyI64 (mkPrim primIsScalar 0 0 [1])
      (mkIfW 2 (mkVDecl 3 tyI64 (mkPrim primUnbox 0 0 [1]) (mkVDecl 4 tyTObj (mkFap (hDigitsGo n) [3]) (mkRet [4]))) (mkRet [1])) }

-- magEq a b: 1 when two magnitudes are the same number, in whichever form each is
def declMagEq (n : Nat) : Decl :=
  let small := mkVDecl 6 tyI64 (mkPrim primUnbox 0 0 [1]) (mkVDecl 7 tyI64 (mkPrim primUnbox 0 0 [2])
    (mkVDecl 8 tyI64 (mkPrim primEq 0 0 [6, 7]) (mkRet [8])))
  let lists := mkVDecl 9 tyTObj (mkFap (hNatDigits n) [1]) (mkVDecl 10 tyTObj (mkFap (hNatDigits n) [2])
    (mkVDecl 11 tyI64 (mkFap (hEq n) [9, 10]) (mkRet [11])))
  { f := hMagEq n, xs := [pT 1, pT 2], rets := [tyI64], ext := false,
    body := mkVDecl 3 tyI64 (mkPrim primIsScalar 0 0 [1]) (mkVDecl 4 tyI64 (mkPrim primIsScalar 0 0 [2])
      (mkVDecl 5 tyI64 (mkPrim primAnd 0 0 [3, 4]) (mkIfW 5 small lists))) }

def natMagName : List Int := [1, 8, 0, 78, 97, 116, 77, 97, 103, 49]
def intMagName : List Int := [1, 8, 0, 73, 110, 116, 77, 97, 103, 49]
def intSgnName : List Int := [1, 8, 0, 73, 110, 116, 83, 103, 110, 49]

/-! ### An integer is one word

The front end's integer is the record of a sign and a magnitude. Here it is one word, lean.h's own form of an
Int: an odd word is the small integer w / 2 with its sign (`lean_box` of the number, `primBoxS`), for an integer
whose magnitude is a small number; an even word points to the object of the magnitude's word and eight bytes of
sign, which is what an Int in a list already was. The wire can also say `{sign := true, magnitude := []}`, which is
no small integer (its sign reads true where 0's reads false): it is the object too. So a list of integers holds one
word for each, an argument is one word, two small integers are equal when their words are, and a sum is one
addition and a test of its range.

The word changes its meaning where a magnitude's does ("Magnitudes"): where the record is built (`hIntOf`: the
word of a sign and a magnitude's word) and where a field is read (`hIntSign`, `hIntMag`). Between those the image's
code is the image's. A small integer in the object's form is right everywhere and only slower, because every
short form takes two odd words and gives everything else to the image's own function: a host may pass an Int
inside a list as the object it always was. At a public entry an integer is the wire's two words: the entry's twin
packs a parameter and unpacks a result ("The boundary"). -/

-- the object of an integer that is no small integer: the magnitude's word, and the sign in the scalar area
def intBoxInfo : CtorInfo := { cidx := 0, size := 1, ssize := 8, tid := 16 + 64 + 1 }

-- The sign of an integer's word: 1 below zero. The object's scalar is read under a `case` that names its
-- constructor: lib/lrc/Pack.rsd packs nothing in a program that reads a scalar of an object it does not know.
def declIntSign (n : Nat) : Decl :=
  let small := mkVDecl 3 tyI64 (mkPrim primUnboxS 0 0 [1]) (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyI64 (mkPrim primLt 0 0 [3, 4]) (mkRet [5])))
  let large := mkCase 1 tyTObj [mkAltCtor intBoxInfo (mkVDecl 6 tyI64 (mkSProj 1 0 1) (mkRet [6]))]
  { f := hIntSign n, xs := [pT 1], rets := [tyI64], ext := false,
    body := mkVDecl 2 tyI64 (mkPrim primIsScalar 0 0 [1]) (mkIfW 2 small large) }

-- the magnitude's word of an integer's word: |i| = i * (1 - 2 * (i < 0))
def declIntMag (n : Nat) : Decl :=
  let word := mkVDecl 10 tyI64 (mkPrim primMulW 0 0 [3, 9]) (mkVDecl 11 tyTObj (mkPrim primBox 0 0 [10]) (mkRet [11]))
  let turn := mkVDecl 8 tyI64 (mkLit 1) (mkVDecl 9 tyI64 (mkPrim primSubW 0 0 [8, 7]) word)
  let twice := mkVDecl 6 tyI64 (mkLit 2) (mkVDecl 7 tyI64 (mkPrim primMulW 0 0 [5, 6]) turn)
  let small := mkVDecl 3 tyI64 (mkPrim primUnboxS 0 0 [1]) (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyI64 (mkPrim primLt 0 0 [3, 4]) twice))
  let large := mkVDecl 12 tyTObj (mkProj 0 1) (mkRet [12])
  { f := hIntMag n, xs := [pT 1], rets := [tyTObj], ext := false,
    body := mkVDecl 2 tyI64 (mkPrim primIsScalar 0 0 [1]) (mkIfW 2 small large) }

-- The word of the integer of sign s (variable 1) and magnitude word m (variable 2): the small integer when m is
-- a small number and the integer is not the wire's zero below zero; the object otherwise.
def declIntOf (n : Nat) : Decl :=
  let obj := mkVDecl 20 tyTObj (mkCtor intBoxInfo [2]) (mkSSet 20 1 0 1 tyI64 (mkRet [20]))
  let boxed := mkVDecl 11 tyI64 (mkPrim primMulW 0 0 [3, 10]) (mkVDecl 12 tyTObj (mkPrim primBoxS 0 0 [11]) (mkRet [12]))
  let turn := mkVDecl 9 tyI64 (mkLit 1) (mkVDecl 10 tyI64 (mkPrim primSubW 0 0 [9, 8]) boxed)
  let word := mkVDecl 7 tyI64 (mkLit 2) (mkVDecl 8 tyI64 (mkPrim primMulW 0 0 [1, 7]) turn)
  let below := mkVDecl 6 tyI64 (mkPrim primAnd 0 0 [1, 5]) (mkIfW 6 (mkJmp 30 []) word)
  let small := mkVDecl 3 tyI64 (mkPrim primUnbox 0 0 [2]) (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyI64 (mkPrim primEq 0 0 [3, 4]) below))
  -- the sign is a Bool: its parameter has the IR type of one, as an image function's has (lib/lrc/Pack.rsd reads it)
  { f := hIntOf n, xs := [{ x := 1, borrow := false, ty := tyU8 }, pT 2], rets := [tyTObj], ext := false,
    body := mkJDecl 30 [] obj (mkVDecl 13 tyI64 (mkPrim primIsScalar 0 0 [2]) (mkIfW 13 small (mkJmp 30 []))) }

-- are two integers equal: two small integers by their words, any other two by their signs and their magnitudes
def declIntEq (n : Nat) : Decl :=
  let small := mkVDecl 6 tyI64 (mkPrim primUnbox 0 0 [1]) (mkVDecl 7 tyI64 (mkPrim primUnbox 0 0 [2]) (mkVDecl 8 tyI64 (mkPrim primEq 0 0 [6, 7]) (mkRet [8])))
  let both := mkVDecl 14 tyI64 (mkFap (hMagEq n) [12, 13]) (mkVDecl 15 tyI64 (mkPrim primAnd 0 0 [11, 14]) (mkRet [15]))
  let mags := mkVDecl 12 tyTObj (mkFap (hIntMag n) [1]) (mkVDecl 13 tyTObj (mkFap (hIntMag n) [2]) both)
  let parts := mkVDecl 9 tyI64 (mkFap (hIntSign n) [1]) (mkVDecl 10 tyI64 (mkFap (hIntSign n) [2]) (mkVDecl 11 tyI64 (mkPrim primEq 0 0 [9, 10]) mags))
  let test := mkVDecl 5 tyI64 (mkPrim primAnd 0 0 [3, 4]) (mkIfW 5 small parts)
  { f := hIntEq n, xs := [pT 1, pT 2], rets := [tyI64], ext := false,
    body := mkVDecl 3 tyI64 (mkPrim primIsScalar 0 0 [1]) (mkVDecl 4 tyI64 (mkPrim primIsScalar 0 0 [2]) test) }

-- does the stream begin with the field name `nm` (the whole name: its length is in it)
def magNameAt : List Int → List Int → Bool
  | [], _ => true
  | x :: xs, y :: ys => x == y && magNameAt xs ys
  | _ :: _, [] => false

-- the place of the magnitude among the fields of a marker record, -1 for any other type
def magField (g : Dg) (ty : List Int) : Int :=
  let v := tyView g ty
  if v == natRecTy then 0 else if v == intRecTy then 1 else -1

-- An integer's record written out, `bs` at its first field's name: a literal sign, then the magnitude as a literal
-- of at most `magLimbs` limbs, and not the zero below zero. `n` is the integer.
structure IntLit where
  ok : Bool
  n : Int
  deriving Inhabited

-- A magnitude written as a literal list of literal limbs: its value, or -1 when the expression is
-- anything else or has more limbs than the first argument (the limbs a small number may have).
def litLimb : List Int → Int
  | 0 :: 0 :: b :: 0 :: 0 :: 0 :: 0 :: 0 :: 0 :: 0 :: _ => if b >= 0 && b < 256 then b else -1
  | _ => -1

def litMag : Nat → List Int → Int
  | _, 22 :: _ => 0
  | _ + 1, 23 :: e => litLimb e
  | k + 1, 26 :: 23 :: e =>
    let rest := litMag k (e.drop 10)
    if litLimb e >= 0 && rest >= 0 then litLimb e + 256 * rest else -1
  | _, _ => -1

def intLit (g : Dg) (bs : List Int) : IntLit :=
  let nm := skipName bs
  if nm.ok != profile.cOk then { ok := false, n := 0 }
  else
    match drE g nm.rest with
    | 1 :: sign :: _ =>
      match drE g (skipE g profile.v2Fuel nm.rest).rest with
      | 34 :: bs2 =>
        let nm2 := skipName bs2
        let v := if nm2.ok == profile.cOk && magNameAt intMagName bs2 then litMag magLimbs (drE g nm2.rest) else -1
        if v < 0 || (sign != 0 && v == 0) then { ok := false, n := 0 } else { ok := true, n := if sign != 0 then 0 - v else v }
      | _ => { ok := false, n := 0 }
    | _ => { ok := false, n := 0 }

/-! ### Which functions of the image are the front end's integer operations

The front end writes each operation on integers once for an image, as a function after the
image's own (rsdc/Compile.rsd, "procedure abstraction"): addition of two natural numbers is a
function on two limb lists, and a source `a + b` is a call of it. The stage knows such a function
by what it is, not by where it stands: by a number computed from its signature and its body, in
which the index of every function it calls is replaced by that function's own number, round after
round (two functions with the same number after as many rounds as there are functions call the
same code all the way down; a function outside the ones looked at counts as unknown). The table
`magOps` holds the numbers of the operations the stage has a short form for; instruments/lrc-host/MagTable.rsd computes it from one small program for each
operation and fails when the table no longer fits the front end. A function that is not in the
table is compiled as any other function: slower, and right.

Only the last functions of the image are looked at (`magLast` of them: the front end puts its own
after the source's), and of those only the ones with the signature of an operation (`magSigs`), so
the walk is short whatever the image. An image whose types are a table (the second container
form) is not looked at. -/

structure MagH where
  a : Int
  b : Int
  deriving Inhabited

def magH0 : MagH := { a := 7, b := 11 }
-- two remainders by primes below 2^28, so that every product stays a small number
def magMix (h : MagH) (x : Int) : MagH :=
  { a := (h.a * 1000003 + x + 1) % 268435399, b := (h.b * 999983 + x + 1) % 134217689 }
def magNum (h : MagH) : Int := h.a * 134217728 + h.b

def magMixAll (h : MagH) (xs : List Int) : MagH := xs.foldl magMix h

mutual
-- the calls of a body: for each, how many bytes of the body are left at its function index, the
-- bytes of the index, and the function, the last call first
partial def magCallsE (g : Dg) (acc : List Int) (rest0 : List Int) : List Int :=
  match rest0 with
  | [] => acc
  | tag :: bs =>
    if tag == 4 || tag == 14 then magCallsN g acc 2 (skipTyD g bs).rest
    else if tag == 5 || tag == 20 || tag == 48 then magCallsN g acc 3 bs
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16
        || tag == 19 || tag == 26 || tag == 27 || tag == 28 || tag == 47 then magCallsN g acc 2 bs
    else if tag == 9 || tag == 17 || tag == 18 || tag == 21 || tag == 23 || tag == 25 || tag == 36 || tag == 39 || tag == 40
        || tag == 44 || tag == 45 || tag == 46 || tag == 49 then magCallsN g acc 1 bs
    else if tag == 24 || tag == 29 || tag == 30 || tag == 38 || tag == 42 || tag == 43 then magCallsN g acc 1 (skipTyD g bs).rest
    else if tag == 31 then magCallsN g acc 1 (readLeb bs).rest
    else if tag == 32 then
      let t := skipTyD g bs
      magCallsArgs g (magCallsE g acc t.rest) (skipE g profile.v2Fuel t.rest).rest
    else if tag == 34 then magCallsN g acc 2 (skipName bs).rest
    else if tag == 35 then magCallsN g acc 1 (readLeb (skipTyD g bs).rest).rest
    else if tag == 50 then magCallsN g acc 3 (skipTyD g bs).rest
    else if tag == 51 then magCallsN g acc 4 (skipTyD g bs).rest
    else if tag == 52 then
      let r := readLeb bs
      magCallsArgs g ((bs.length : Int) :: ((bs.length - r.rest.length : Nat) : Int) :: r.n :: acc) r.rest
    else acc
partial def magCallsN (g : Dg) (acc : List Int) : Nat → List Int → List Int
  | 0, _ => acc
  | k + 1, rest => magCallsN g (magCallsE g acc rest) k (skipE g profile.v2Fuel rest).rest
partial def magCallsArgs (g : Dg) (acc : List Int) : List Int → List Int
  | 1 :: rest => magCallsArgs g (magCallsE g acc rest) (skipE g profile.v2Fuel rest).rest
  | _ => acc
end

-- the calls in the order of the bytes
def magCallsRev : List Int → List Int → List Int
  | left :: len :: f :: rest, acc => magCallsRev rest (left :: len :: f :: acc)
  | _, acc => acc

-- a body's bytes into the number, the index of each call left out (`left` bytes of the body remain):
-- the bytes before a call's index, a mark for the index, and on after it
def magMixBody (h : MagH) (left : Int) (calls : List Int) (bs : List Int) : MagH :=
  match calls with
  | pos :: len :: _ :: more =>
    let k := (left - pos).toNat
    magMixBody (magMix (magMixAll h (bs.take k)) 257) (pos - len) more (bs.drop (k + len.toNat))
  | _ => magMixAll h bs

def magCallees : List Int → List Int
  | _ :: _ :: f :: rest => f :: magCallees rest
  | _ => []

-- what is known of one function at the end of the image: its index, its number, the functions it calls
structure MagFn where
  f : Nat
  num : Int
  calls : List Int
  deriving Inhabited

def magFirst (g : Dg) (sig body : List Int) (f : Nat) : MagFn :=
  let calls := magCallsRev (magCallsE g [] body) []
  let h := magMixBody (magMix (magMixAll magH0 sig) 256) (body.length : Int) calls body
  { f := f, num := magNum h, calls := magCallees calls }

def magNumOf (fs : List MagFn) (f : Int) : Int :=
  match fs with
  | [] => 1
  | x :: rest => if (x.f : Int) == f then x.num else magNumOf rest f

def magCallNums (fs : List MagFn) : List Int → List Int
  | [] => []
  | c :: cs => magNumOf fs c :: magCallNums fs cs

-- one round: every function's number with the numbers of the functions it calls
def magRound (all : List MagFn) : List MagFn → List MagFn
  | [] => []
  | x :: rest => { x with num := magNum (magMixAll (magMix magH0 x.num) (magCallNums all x.calls)) } :: magRound all rest

def magRounds : Nat → List MagFn → List MagFn
  | 0, fs => fs
  | k + 1, fs => magRounds k (magRound fs fs)

-- as many rounds as a chain of calls among the front end's functions is long, and some more
def magDepth : Nat := 12

-- the body of each function (after its marker byte, to the end of the stream), the last function first
partial def magStarts (g : Dg) (f n : Nat) (bodies : List Int) (acc : List (List Int)) : List (List Int) :=
  if f >= n then acc
  else
    match bodies with
    | 1 :: body => magStarts g (f + 1) n (skipE g profile.v2Fuel body).rest (body :: acc)
    | _ => acc

-- The numbers of the signatures of the front end's integer operations (`magSigs`), and the numbers
-- after `magDepth` rounds of the operations with a short form, each with its operation (`magOps`:
-- number, operation, ...; an operation numbered 100 higher takes its right operand first). Written by
-- instruments/lrc-host/MagTable.rsd; do not edit by hand.
-- magtable-begin
def magSigs : List Int := [16653371867709779, 20039666083147996, 6695582101792162, 17698583794151423, 16238725538431364, 8724960041384132, 17052765522750389, 571223232451439, 22659287131436090, 24662660865166174, 13044231192277955]
def magOps : List Int := [15029889947836257, 1, 24732105553336577, 102, 27959549479632847, 3, 6938968571668700, 104, 4824795909091049, 105, 13744372784662006, 6, 16605739944143521, 107, 14036309206300837, 8, 11551896954179423, 109, 10457269997295025, 110, 14324666619984329, 11, 7006643057402157, 14, 30116240045889345, 15, 31083175265114230, 12, 18681495742088284, 13, 32210618349905424, 18, 5259751752382450, 19, 25673145966689705, 16, 3245379237201078, 17, 9186855454886910, 30, 33102109228803659, 31, 25406391081444959, 20, 1890050084285049, 21, 20989236240861534, 22, 27312919375865918, 23]
-- magtable-end

-- how many functions at the end of the image are looked at
def magLast : Nat := 128

def magSigNum (sig : List Int) : Int := magNum (magMixAll magH0 sig)

-- of the last `left` functions (the last first; `after` bytes of the stream follow the body), those with an operation's signature
partial def magTail (g : Dg) (sigs : List (List Int)) (f : Nat) (after : Nat) (left : Nat) (starts : List (List Int)) : List MagFn :=
  match starts with
  | [] => []
  | body :: more =>
    if left == 0 then []
    else
      let len := body.length
      -- before the next body stands its marker byte
      let rest := magTail g sigs (f - 1) (len + 1) (left - 1) more
      if magSigs.contains (magSigNum (sigOf sigs f)) then magFirst g (sigOf sigs f) (body.take (len - after)) f :: rest else rest

-- pairs (function, operation) for the functions of the image the stage has a short form for
def magPairs : List MagFn → List Int
  | [] => []
  | x :: rest =>
    let op := factOf x.num magOps
    if op >= 0 then (x.f : Int) :: op :: magPairs rest else magPairs rest

-- The functions that keep numbers in a node ("Numbers in nodes"): the list of Nat and of Int packed
-- into words and unpacked, by their numbers in `magOps`; and two known by their one expression:
-- `first`, the first element of its list, and `hold`, the node whose f8 is its first parameter.
def numPackNat : Int := 20
def numPackInt : Int := 21
def numUnpackNat : Int := 22
def numUnpackInt : Int := 23
def numFirst : Int := 24
def numHold : Int := 26

def magVarIs (g : Dg) (e : List Int) (i : Int) : Bool :=
  match drE g e with
  | 3 :: vb =>
    let vi := readLeb vb
    vi.ok == profile.cOk && vi.n == i
  | _ => false

-- `unwrap (first v0)`
def numIsFirst (g : Dg) (body : List Int) : Bool :=
  match drE g body with
  | 39 :: b1 =>
    match drE g b1 with
    | 25 :: b2 => magVarIs g b2 0
    | _ => false
  | _ => false

-- `alloc {f0 := 0, f1 := [], f2 .. f6 at their defaults, f7 := "", f8 := v0} v1`
def numIsHold (g : Dg) (intr : List Int) (body : List Int) : Bool :=
  match drE g body with
  | 52 :: bs =>
    let f := readLeb bs
    if f.ok != profile.cOk || f.n < 0 || intrKind intr f.n.toNat != 3 then false
    else
      match f.rest with
      | 1 :: rec =>
        fwIsIntLit g (fwFieldAt g 0 rec) 0 && fwKidCount g (fwFieldAt g 1 rec) == 0
          && fwIsIntLit g (fwFieldAt g 2 rec) 0 && fwIsIntLit g (fwFieldAt g 3 rec) 0 && fwIsIntLit g (fwFieldAt g 4 rec) 0
          && fwIsFalse g (fwFieldAt g 5 rec) && fwIsFalse g (fwFieldAt g 6 rec) && fwIsEmptyStr g (fwFieldAt g 7 rec)
          && magVarIs g (fwFieldAt g 8 rec) 0
          && (match (skipE g profile.v2Fuel rec).rest with
              | 1 :: a => magVarIs g a 1 && (skipE g profile.v2Fuel a).rest.headD 1 == 0
              | _ => false)
      | _ => false
  | _ => false

-- of the last `left` functions (the last first), `first` and `hold`, each with its operation
partial def numShapes (g : Dg) (intr : List Int) (sigs : List (List Int)) (f : Nat) (left : Nat) (starts : List (List Int)) : List Int :=
  match starts with
  | [] => []
  | body :: more =>
    if left == 0 then []
    else
      let rest := numShapes g intr sigs (f - 1) (left - 1) more
      let k := sigCount (sigOf sigs f)
      if k == 1 && numIsFirst g body then (f : Int) :: numFirst :: rest
      else if k == 2 && numIsHold g intr body then (f : Int) :: numHold :: rest
      else rest

-- `intr`: the kinds of the image's functions, for `hold`; without them only the numbered functions are found
def magFind (g : Dg) (sigs : List (List Int)) (n : Nat) (bodies : List Int) (intr : List Int := []) : List Int :=
  if g.on || n == 0 then []
  else
    let starts := magStarts g 0 n bodies []
    -- the stream ends with one byte after the last body
    if starts.length != n then []
    else magPairs (magRounds magDepth (magTail g sigs (n - 1) 1 magLast starts)) ++ (if intr.isEmpty then [] else numShapes g intr sigs (n - 1) magLast starts)

/-! ### The short form of an integer operation

A function of the image that is one of the front end's integer operations (`magFind`) keeps its
index and gets a body of a few instructions: when the magnitudes are small numbers and the result
is one, the result by the machine's arithmetic; in every other case a call of the function as the
image wrote it, which stands after the image's functions as the lifted loops do and runs at the
caller's fuel. Signs are the words 0 and 1 (1: below zero). The short form takes no fuel of its
own, so a program may come to its value on a smaller budget than its limb lists would need; it
never refuses where they would not. -/

-- 2^56 and 2^28: the bound of a small number, and a bound on two factors whose product is one
def magLim : Int := 72057594037927936
def magHalf : Int := 268435456

def magI (x : Nat) (p : Nat) (ys : List Int) : N := mkVDecl x tyI64 (mkPrim p 0 0 ys) mkUnreachable
def magL (x : Nat) (v : Int) : N := mkVDecl x tyI64 (mkLit v) mkUnreachable
def magT (x : Nat) (ty : Int) (p : Nat) (ys : List Int) : N := mkVDecl x ty (mkPrim p 0 0 ys) mkUnreachable
def magBox (x y : Nat) : N := mkVDecl x tyTObj (mkPrim primBox 0 0 [(y : Int)]) mkUnreachable

def magArgs : List Param → List Int
  | [] => []
  | p :: ps => (p.x : Int) :: magArgs ps

def magTop : List Param → Nat
  | [] => 0
  | p :: ps => if p.x > magTop ps then p.x else magTop ps

-- the two magnitudes `a` and `b` as numbers in v + 3 and v + 4 when both are small, else the jump to the image's function
def magBoth (a b v j : Nat) (fast : N) : N :=
  let test := [magI v primIsScalar [(a : Int)], magI (v + 1) primIsScalar [(b : Int)], magI (v + 2) primAnd [(v : Int), ((v + 1 : Nat) : Int)]]
  let nums := [magI (v + 3) primUnbox [(a : Int)], magI (v + 4) primUnbox [(b : Int)]]
  assemble test (mkIfW (v + 2) (assemble nums fast) (mkJmp j []))

structure MagWrap where
  ok : Bool
  body : N
  deriving Inhabited

-- operations 1 to 5 and 12 to 15: two natural numbers
def magNat (op : Int) (a b v j : Nat) (rty : Int) : N :=
  let x : Int := ((v + 3 : Nat) : Int)
  let y : Int := ((v + 4 : Nat) : Int)
  if op == 1 then
    let sum := [magI (v + 5) primAddW [x, y], magL (v + 6) magLim, magI (v + 7) primLt [((v + 5 : Nat) : Int), ((v + 6 : Nat) : Int)]]
    magBoth a b v j (assemble sum (mkIfW (v + 7) (assemble [magBox (v + 8) (v + 5)] (mkRet [((v + 8 : Nat) : Int)])) (mkJmp j [])))
  else if op == 2 then
    let zero := assemble [magL (v + 6) 0, magBox (v + 7) (v + 6)] (mkRet [((v + 7 : Nat) : Int)])
    let diff := assemble [magI (v + 8) primSubW [x, y], magBox (v + 9) (v + 8)] (mkRet [((v + 9 : Nat) : Int)])
    magBoth a b v j (assemble [magI (v + 5) primLt [x, y]] (mkIfW (v + 5) zero diff))
  else if op == 3 then
    let small := [magL (v + 5) magHalf, magI (v + 6) primLt [x, ((v + 5 : Nat) : Int)], magI (v + 7) primLt [y, ((v + 5 : Nat) : Int)],
      magI (v + 8) primAnd [((v + 6 : Nat) : Int), ((v + 7 : Nat) : Int)]]
    let prod := assemble [magI (v + 9) primMulW [x, y], magBox (v + 10) (v + 9)] (mkRet [((v + 10 : Nat) : Int)])
    magBoth a b v j (assemble small (mkIfW (v + 8) prod (mkJmp j [])))
  else if op == 4 || op == 5 then
    let quot := assemble [magI (v + 7) (if op == 4 then primDivU else primRemU) [x, y], magBox (v + 8) (v + 7)] (mkRet [((v + 8 : Nat) : Int)])
    magBoth a b v j (assemble [magL (v + 5) 0, magI (v + 6) primEq [y, ((v + 5 : Nat) : Int)]] (mkIfW (v + 6) (mkJmp j []) quot))
  else if op == 12 then magBoth a b v j (assemble [magT (v + 5) rty primLt [x, y]] (mkRet [((v + 5 : Nat) : Int)]))
  else if op == 14 then magBoth a b v j (assemble [magT (v + 5) rty primGt [x, y]] (mkRet [((v + 5 : Nat) : Int)]))
  else if op == 13 then
    magBoth a b v j (assemble [magI (v + 5) primGt [x, y], magT (v + 6) rty primNot [((v + 5 : Nat) : Int)]] (mkRet [((v + 6 : Nat) : Int)]))
  else
    magBoth a b v j (assemble [magI (v + 5) primLt [x, y], magT (v + 6) rty primNot [((v + 5 : Nat) : Int)]] (mkRet [((v + 6 : Nat) : Int)]))

-- Two small integers ("An integer is one word"): their numbers, with their signs, in v + 3 and v + 4. Anything
-- else goes to the join point j, the function as the image wrote it.
def magBothS (a b v j : Nat) (fast : N) : N :=
  let test := [magI v primIsScalar [(a : Int)], magI (v + 1) primIsScalar [(b : Int)], magI (v + 2) primAnd [(v : Int), ((v + 1 : Nat) : Int)]]
  let nums := [magI (v + 3) primUnboxS [(a : Int)], magI (v + 4) primUnboxS [(b : Int)]]
  assemble test (mkIfW (v + 2) (assemble nums fast) (mkJmp j []))

-- the word of the number in r, returned when its magnitude is a small number's (below 2^56 either way)
def magOfS (r v j : Nat) : N :=
  let w := v + 14
  let parts := [magL w magLim, magI (w + 1) primLt [(r : Int), (w : Int)], magL (w + 2) (0 - magLim),
    magI (w + 3) primLt [((w + 2 : Nat) : Int), (r : Int)], magI (w + 4) primAnd [((w + 1 : Nat) : Int), ((w + 3 : Nat) : Int)]]
  assemble parts (mkIfW (w + 4) (assemble [mkVDecl (w + 5) tyTObj (mkPrim primBoxS 0 0 [(r : Int)]) mkUnreachable] (mkRet [((w + 5 : Nat) : Int)])) (mkJmp j []))

-- operations 6 to 10 and 16 to 19: two integers, each one word
def magInt (op : Int) (a b v j : Nat) (rty : Int) : N :=
  let x : Int := ((v + 3 : Nat) : Int)
  let y : Int := ((v + 4 : Nat) : Int)
  let r := v + 13
  if op == 6 then magBothS a b v j (assemble [magI r primAddW [x, y]] (magOfS r v j))
  else if op == 7 then magBothS a b v j (assemble [magI r primSubW [x, y]] (magOfS r v j))
  else if op == 8 then
    -- two factors below 2^28 either way: the product is a small integer
    let small := [magL (v + 30) magHalf, magL (v + 31) (0 - magHalf), magI (v + 32) primLt [x, ((v + 30 : Nat) : Int)],
      magI (v + 33) primLt [((v + 31 : Nat) : Int), x], magI (v + 34) primLt [y, ((v + 30 : Nat) : Int)], magI (v + 35) primLt [((v + 31 : Nat) : Int), y],
      magI (v + 36) primAnd [((v + 32 : Nat) : Int), ((v + 33 : Nat) : Int)], magI (v + 37) primAnd [((v + 34 : Nat) : Int), ((v + 35 : Nat) : Int)],
      magI (v + 38) primAnd [((v + 36 : Nat) : Int), ((v + 37 : Nat) : Int)]]
    magBothS a b v j (assemble small (mkIfW (v + 38) (assemble [magI r primMulW [x, y]] (magOfS r v j)) (mkJmp j [])))
  else if op == 9 || op == 10 then
    -- only for two numbers that are not below zero and a divisor that is not zero: every convention of a quotient agrees there
    let test := [magL (v + 5) 0, magI (v + 6) primLt [x, ((v + 5 : Nat) : Int)], magI (v + 7) primLt [y, ((v + 5 : Nat) : Int)],
      magI (v + 8) primEq [y, ((v + 5 : Nat) : Int)], magI (v + 9) primOr [((v + 6 : Nat) : Int), ((v + 7 : Nat) : Int)],
      magI (v + 10) primOr [((v + 9 : Nat) : Int), ((v + 8 : Nat) : Int)]]
    let quot := assemble [magI (v + 11) (if op == 9 then primDivU else primRemU) [x, y],
        mkVDecl (v + 12) tyTObj (mkPrim primBoxS 0 0 [((v + 11 : Nat) : Int)]) mkUnreachable]
      (mkRet [((v + 12 : Nat) : Int)])
    magBothS a b v j (assemble test (mkIfW (v + 10) (mkJmp j []) quot))
  else if op == 16 then magBothS a b v j (assemble [magT r rty primLt [x, y]] (mkRet [(r : Int)]))
  else if op == 18 then magBothS a b v j (assemble [magT r rty primGt [x, y]] (mkRet [(r : Int)]))
  else if op == 17 then
    magBothS a b v j (assemble [magI r primGt [x, y], magT (v + 14) rty primNot [(r : Int)]] (mkRet [((v + 14 : Nat) : Int)]))
  else
    magBothS a b v j (assemble [magI r primLt [x, y], magT (v + 14) rty primNot [(r : Int)]] (mkRet [((v + 14 : Nat) : Int)]))

-- operation 11, the integer of the other sign: a small integer's is 0 - i (zero stays zero)
def magNeg (a v j : Nat) : N :=
  let small := assemble [magI (v + 1) primUnboxS [(a : Int)], magL (v + 2) 0, magI (v + 3) primSubW [((v + 2 : Nat) : Int), ((v + 1 : Nat) : Int)],
      mkVDecl (v + 4) tyTObj (mkPrim primBoxS 0 0 [((v + 3 : Nat) : Int)]) mkUnreachable]
    (mkRet [((v + 4 : Nat) : Int)])
  assemble [magI v primIsScalar [(a : Int)]] (mkIfW v small (mkJmp j []))

-- operation 30: the word of a natural number (the front end's function gives the largest word for a number above it): a small number's own
def magToWord (m v j : Nat) : N :=
  assemble [magI v primIsScalar [(m : Int)]] (mkIfW v (assemble [magI (v + 1) primUnbox [(m : Int)]] (mkRet [((v + 1 : Nat) : Int)])) (mkJmp j []))

-- operation 31: the natural number of a word: a word from 0 to below 2^56 is a small number
def magOfWord (w v j : Nat) : N :=
  let test := [magL v 0, magI (v + 1) primLt [(w : Int), (v : Int)], magI (v + 2) primNot [((v + 1 : Nat) : Int)], magL (v + 3) magLim,
    magI (v + 4) primLt [(w : Int), ((v + 3 : Nat) : Int)], magI (v + 5) primAnd [((v + 2 : Nat) : Int), ((v + 4 : Nat) : Int)]]
  assemble test (mkIfW (v + 5) (assemble [magBox (v + 6) w] (mkRet [((v + 6 : Nat) : Int)])) (mkJmp j []))

-- The short form of operation `op0` for the declaration d, whose own body is the function `slow`;
-- not ok when d has not the operation's parameters and results (then d stays as it is). An
-- operation numbered 100 higher has its right operand as the function's first parameter, which is
-- how the front end writes a difference, a quotient and a remainder (`magOps` says which, from a run).
def magWrap (op0 : Int) (d : Decl) (slow : Nat) : MagWrap :=
  let rev := op0 >= 100
  let op := if rev then op0 - 100 else op0
  let v := magTop d.xs + 1
  let j := v + 60
  -- the image's function stays a call (lib/lrc/Inline.rsd `ilCallList`): this body is then small and is put
  -- where it is called, after the counting (`inlineDecls`)
  let call := callItem d.rets (mkFapSame slow (magArgs d.xs)) (v + 40)
  let slowly := assemble [call.item] (mkRet call.vars)
  let rty := intAt 0 d.rets
  let y0 := (intAt 0 (magArgs d.xs)).toNat
  let y1 := (intAt 1 (magArgs d.xs)).toNat
  -- the left operand first: a natural number is one word, and so is an integer ("An integer is one word")
  let x0 := if !rev then y0 else y1
  let x1 := if !rev then y1 else y0
  let noParam : Param := { x := 0, borrow := false, ty := tyIrr }
  let two := d.xs.length == 2 && d.rets.length == 1 && (d.xs.headD noParam).ty == tyTObj && ((d.xs.drop 1).headD noParam).ty == tyTObj
  let nat := two && ((op >= 1 && op <= 5) || (op >= 12 && op <= 15))
  let int2 := two && rty == tyTObj && op >= 6 && op <= 10
  let cmp := two && op >= 16 && op <= 19
  let one := d.xs.length == 1 && d.rets.length == 1
  let pty := (d.xs.headD { x := 0, borrow := false, ty := tyIrr }).ty
  let neg := one && pty == tyTObj && rty == tyTObj && op0 == 11
  if one && op0 == 30 && pty == tyTObj && rty == tyI64 then { ok := true, body := mkJDecl j [] slowly (magToWord y0 v j) }
  else if one && op0 == 31 && pty == tyI64 && rty == tyTObj then { ok := true, body := mkJDecl j [] slowly (magOfWord y0 v j) }
  else if nat then { ok := true, body := mkJDecl j [] slowly (magNat op x0 x1 v j rty) }
  else if int2 || cmp then { ok := true, body := mkJDecl j [] slowly (magInt op x0 x1 v j rty) }
  else if neg then { ok := true, body := mkJDecl j [] slowly (magNeg y0 v j) }
  else { ok := false, body := d.body }

/-! ### Arrays

Lean's `Array` (lean.h `lean_array_object`: the size, the capacity, the elements side by side;
`lean_array_push` and `lean_array_fset` write in place when nothing else holds the array). The wire
has one type of sequence, and the front end writes an `Array` as a list and its operations as list
forms: `a.push x` is `a ++ [x]`, `a.size` is the length, `List.toArray` is nothing. So the form is
chosen where a value is made, and a list is, at any moment, cells or one array object:

  - `xs ++ [x]` gives an array (the elements of xs and x; in place when xs is an array nothing
    else holds), and so does `xs ++ []`;
  - the length of an array is its size;
  - whatever takes a list apart cell by cell (a match, a loop over it, the functions above) first
    asks for cells: an array's elements are made into a list once (`primArrToList`), and a list
    of cells is passed on as it is;
  - the tail of a cell is never an array: `x :: xs` asks for xs as cells.

An image that has no such append never meets an array and is translated as before (`Cx.arr`).
The empty array is the empty list. A value that leaves through a public entry is cells ("The
boundary"). -/

-- lenA xs: the number of elements of a list in either form
def declLenA (n shape : Nat) : Decl :=
  let size := mkVDecl 3 tyI64 (mkPrim primArrSize 0 0 [1]) (mkRet [3])
  let walk := mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyI64 (mkFap (hLen n shape) [1, 4]) (mkRet [5]))
  { f := hLenA n shape, xs := [pT 1], rets := [tyI64], ext := false,
    body := mkVDecl 2 tyI64 (mkPrim primIsArr 0 0 [1]) (mkIfW 2 size walk) }

def helperDecls (n : Nat) : List Decl :=
  [declLen n lsScalar, declLen n lsObject, declDrop n lsScalar, declDrop n lsObject,
   declRev n lsScalar, declRev n lsObject, declApp n lsScalar, declApp n lsObject, declEq n,
   declNatOf n, declNatOfGo n, declNatDigits n, declDigitsGo n, declMagEq n,
   declLenA n lsScalar, declLenA n lsObject,
   declIntSign n, declIntMag n, declIntOf n, declIntEq n]

-- The list in word `w` as cells: a fresh word, which takes the place of `w` ("Arrays"). In an
-- image without arrays, and for the irrelevant word, `w` itself.
def forceItem (arr : Bool) (w : Int) (next : Nat) : ItemsR :=
  if !arr || w < 0 then { next := next, items := [], ws := [w] }
  else { next := next + 1, items := [mkVDecl next tyTObj (mkPrim primArrToList 0 0 [w]) mkUnreachable], ws := [(next : Int)] }

-- the variable an expression is, or -1 when it is anything else
def varOfExpr (g : Dg) (e : List Int) : Int :=
  match drE g e with
  | 3 :: vb =>
    let vi := readLeb vb
    if vi.ok == profile.cOk && vi.n >= 0 then vi.n else -1
  | _ => -1

-- the environment with the one word of variable i replaced by `w` (i below zero: as it is)
def envSetWord (i : Int) (w : Int) : List Val → List Val
  | [] => []
  | v :: vs =>
    if i < 0 then v :: vs
    else if i == 0 then (if v.kind == 0 && v.ts == [tyTObj] then { v with ws := [w] } :: vs else v :: vs)
    else v :: envSetWord (i - 1) w vs

-- the one word an element of flat types `ts` is as an array's element: its scalar, its object, or its box (`consItems`)
def elemWord (ws ts : List Int) (next : Nat) : ItemsR :=
  let live := liveWords ws ts
  if elemKind ts == 2 then
    let info := boxInfo ts
    { next := next + 1, ws := [(next : Int)], items := [mkVDecl next tyTObj (mkCtor info (objWords ws ts)) mkUnreachable] ++ boxSSets next info.size 0 ws ts }
  else { next := next, items := [], ws := [intAt 0 live] }

mutual
-- does an expression build an array: an append whose right operand is one element or the empty
-- list, and whose left operand is not one element (`[x] ++ xs` is a cell)
partial def arrE (g : Dg) (rest0 : List Int) : Bool :=
  match drE g rest0 with
  | [] => false
  | tag :: bs =>
    if tag == 26 then
      let second := (drE g (skipE g profile.v2Fuel bs).rest).headD 0
      ((drE g bs).headD 0 != 23 && (second == 23 || second == 22)) || arrN g 2 bs
    else if tag == 4 || tag == 14 then arrN g 2 (skipTyD g bs).rest
    else if tag == 5 || tag == 20 || tag == 48 then arrN g 3 bs
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16
        || tag == 19 || tag == 27 || tag == 28 || tag == 47 then arrN g 2 bs
    else if tag == 9 || tag == 17 || tag == 18 || tag == 21 || tag == 23 || tag == 25 || tag == 36 || tag == 39 || tag == 40
        || tag == 44 || tag == 45 || tag == 46 || tag == 49 then arrN g 1 bs
    else if tag == 24 || tag == 29 || tag == 30 || tag == 38 || tag == 42 || tag == 43 then arrN g 1 (skipTyD g bs).rest
    else if tag == 31 then arrN g 1 (readLeb bs).rest
    else if tag == 32 then
      let t := skipTyD g bs
      arrE g t.rest || arrArgs g (skipE g profile.v2Fuel t.rest).rest
    else if tag == 34 then arrN g 2 (skipName bs).rest
    else if tag == 35 then arrN g 1 (readLeb (skipTyD g bs).rest).rest
    else if tag == 50 then arrN g 3 (skipTyD g bs).rest
    else if tag == 51 then arrN g 4 (skipTyD g bs).rest
    else if tag == 52 then arrArgs g (readLeb bs).rest
    else false
partial def arrN (g : Dg) : Nat → List Int → Bool
  | 0, _ => false
  | k + 1, rest => arrE g rest || arrN g k (skipE g profile.v2Fuel rest).rest
partial def arrArgs (g : Dg) : List Int → Bool
  | 1 :: rest => arrE g rest || arrArgs g (skipE g profile.v2Fuel rest).rest
  | _ => false
end

/-! ### The front end's loops over an array

The front end has no form for a write at an index, for a prefix or for a read at an index, and
writes them with the forms it has (rsdc/Compile.rsd `basicArrayBody`, `listPrefixW`, `containerBody`):

  set xs K V   fold xs [] (fun x acc => acc ++ [if len acc == K then V else x])
  take S xs    fold xs [] (fun x acc => if len acc < S then acc ++ [x] else acc)
  extract      drop A (take B xs)
  get          first (drop K xs)

On a list of n elements the first two take n steps for one element, and the fourth K steps. Here
each is what it computes: a write at index K of the array of xs when K is an index of it (in place
when nothing else holds the array), a slice, a read at an index. K, S and V are evaluated as the
loop evaluates them: not at all on an empty list, V only when K is an index. A loop of another
shape is a loop. -/

structure FoldIdiom where
  -- 0 no such loop, 1 set, 2 take
  kind : Nat
  -- the stream at the list, at K (or S), and at V
  xs : List Int
  k : List Int
  v : List Int
  deriving Inhabited

def noIdiom : FoldIdiom := { kind := 0, xs := [], k := [], v := [] }

-- the stream after the bytes `p`, when the stream begins with them
def afterPrefix : List Int → List Int → Option (List Int)
  | [], rest => some rest
  | x :: xs, y :: ys => if x == y then afterPrefix xs ys else none
  | _ :: _, [] => none

-- an expression that reads neither of the two innermost variables (the loop's element and its accumulator)
def fvOuter (g : Dg) (e : List Int) : FvR :=
  let r := fvE g 0 [] e
  { ok := r.ok && !r.acc.contains 0 && !r.acc.contains 1, acc := r.acc, rest := r.rest }

def foldSet (g : Dg) (xs r1 : List Int) : FoldIdiom :=
  -- after `22 26 3 1 23 5 14`: the type of the test, `24 T 3 1`, K, V, `3 0`
  let et := readTyD g r1
  match et.rest with
  | 24 :: r2 =>
    match afterPrefix [3, 1] (skipTyD g r2).rest with
    | some rk =>
      let k := fvOuter g rk
      let v := fvOuter g k.rest
      let last := afterPrefix [3, 0] v.rest
      if et.ok == profile.cOk && tyView g et.acc == [0] && k.ok && v.ok && last.isSome then { kind := 1, xs := xs, k := rk, v := k.rest } else noIdiom
    | none => noIdiom
  | _ => noIdiom

def foldTake (g : Dg) (xs r1 : List Int) : FoldIdiom :=
  -- after `22 5 12 24`: `T 3 1`, S, `26 3 1 23 3 0 3 1`
  match afterPrefix [3, 1] (skipTyD g r1).rest with
  | some rk =>
    let k := fvOuter g rk
    let last := afterPrefix [26, 3, 1, 23, 3, 0, 3, 1] k.rest
    if k.ok && last.isSome then { kind := 2, xs := xs, k := rk, v := [] } else noIdiom
  | none => noIdiom

-- `bs` follows the tag of a loop over a list (50): its type, the list, the start value, the body
def foldIdiom (g : Dg) (bs : List Int) : FoldIdiom :=
  let t := skipTyD g bs
  let z := (skipE g profile.v2Fuel t.rest).rest
  if t.ok != profile.cOk then noIdiom
  else
    match z with
    | 22 :: 26 :: 3 :: 1 :: 23 :: 5 :: 14 :: r1 => foldSet g t.rest r1
    | 22 :: 5 :: 12 :: 24 :: r1 => foldTake g t.rest r1
    | _ => noIdiom

-- the words of an element of flat types `ts` from the one word `w` it is in an array (`elemWord`)
def elemReads (ts : List Int) (w : Nat) (next : Nat) : ItemsR :=
  if elemKind ts == 2 then boxReads w (boxInfo ts).size 0 0 next ts
  else { next := next, items := [], ws := placeLive (w : Int) ts }

-- Does a function of the image build an array. A reserved form is not asked: its body is a
-- certificate of its meaning that is never run (the arena's `alloc` is written `arena ++ [node]`).
partial def arrAny (g : Dg) (intr : List Int) (f n : Nat) (bodies : List Int) : Bool :=
  if f >= n then false
  else
    match bodies with
    | 1 :: body => (intrKind intr f == 0 && arrE g body) || arrAny g intr (f + 1) n (skipE g profile.v2Fuel body).rest
    | _ => false

/-! ## Equality

The wire's `eqE` compares two values of one type (lean/rsd-cert/Residua/Bootstrap/SCM.lean
compares the values): words by the operator, strings by their bytes, a record field by field, a
list element by element. A list of one-word scalar elements has the stage's list function
(`declEq`); any other list gets a loop of its own, lifted as the wire's loops are ("Loops") and
entered at the caller's fuel: nothing in an equality takes fuel. The frontend writes no equality
at an option, a sum or a node handle, and the stage has none for them (it refuses the image). -/

structure EqR where
  ok : Bool
  next : Nat
  items : List N
  -- the variable that holds 1 when the two values are equal and 0 otherwise
  r : Int
  deriving Inhabited

def eqFail : EqR := { ok := false, next := 0, items := [], r := 0 }

-- a word of the value 1 or 0
def eqConst (v : Int) (next : Nat) : EqR :=
  { ok := true, next := next + 1, items := [mkVDecl next tyI64 (mkLit v) mkUnreachable], r := (next : Int) }

-- `ty` is the wire type of both values, `wa` and `wb` their words
partial def eqItems (cx : Cx) (ty : List Int) (wa wb : List Int) (next : Nat) : EqR :=
  if isHeapHandle cx.g ty then eqFail
  else
    match tyView cx.g ty with
    | [0] => { ok := true, next := next + 1, items := [mkVDecl next tyI64 (mkPrim primEq 0 0 (wa ++ wb)) mkUnreachable], r := (next : Int) }
    | [1] => { ok := true, next := next + 1, items := [mkVDecl next tyI64 (mkPrim primEq 0 0 (wa ++ wb)) mkUnreachable], r := (next : Int) }
    | [2] => { ok := true, next := next + 1, items := [mkVDecl next tyI64 (mkPrim primStrEq 0 0 (wa ++ wb)) mkUnreachable], r := (next : Int) }
    | 4 :: elem =>
      let et := fwFlat cx.g elem
      -- both lists as cells ("Arrays")
      let fa := forceItem cx.arr (intAt 0 wa) next
      let fb := forceItem cx.arr (intAt 0 wb) fa.next
      let wa1 := fa.ws
      let wb1 := fb.ws
      let nx := fb.next
      if isHeapNode cx.g elem || !et.ok then eqFail
      else if elemKind et.ts == 0 then
        { ok := true, next := nx + 1, items := fa.items ++ fb.items ++ [mkVDecl nx tyI64 (mkFap (hEq cx.n) (wa1 ++ wb1)) mkUnreachable], r := (nx : Int) }
      else
        -- loop xs ys = both nil: 1; both cells: heads equal and loop of the tails; otherwise 0
        let tmp := liftBase + nx
        let pa := nx + 1
        let pb := nx + 2
        let ha := headItems et.ts pa (nx + 3)
        let hb := headItems et.ts pb ha.next
        let e := eqItems cx elem ha.ws hb.ws hb.next
        if !e.ok then eqFail
        else
          let ta := e.next
          let tb := ta + 1
          let again := callItem [tyI64] (mkFapSame tmp [(ta : Int), (tb : Int)]) (tb + 1)
          let z1 := again.next
          let z2 := z1 + 1
          let z3 := z2 + 1
          let one := z3 + 1
          let shape := elemShape et.ts
          let more := assemble [mkVDecl ta tyTObj (mkProj (consTail shape) pa) mkUnreachable,
                                mkVDecl tb tyTObj (mkProj (consTail shape) pb) mkUnreachable, again.item] (mkRet again.vars)
          let both := assemble (ha.items ++ hb.items ++ e.items) (mkIfW e.r.toNat more (eqNo z1))
          let loop := mkCase pa tyTObj
            [mkAltCtor nilInfo (mkCase pb tyTObj [mkAltCtor nilInfo (mkVDecl one tyI64 (mkLit 1) (mkRet [(one : Int)])), mkAltCtor (consInfo shape) (eqNo z2)]),
             mkAltCtor (consInfo shape) (mkCase pb tyTObj [mkAltCtor nilInfo (eqNo z3), mkAltCtor (consInfo shape) both])]
          let out := callItem [tyI64] (mkFapSame tmp (wa1 ++ wb1)) (one + 1)
          { ok := true, next := out.next, items := fa.items ++ fb.items ++ [liftItem nx tmp [pT pa, pT pb] [tyI64] loop, out.item], r := intAt 0 out.vars }
    | 7 :: _ =>
      -- a natural number: its magnitudes as numbers; an integer: its sign, and its magnitudes ("Magnitudes")
      if magField cx.g ty == 0 then
        { ok := true, next := next + 1, items := [mkVDecl next tyI64 (mkFap (hMagEq cx.n) (wa ++ wb)) mkUnreachable], r := (next : Int) }
      else if magField cx.g ty == 1 then
        -- two small integers by their words, here; any other two by `hIntEq` ("An integer is one word")
        let a := intAt 0 wa
        let b := intAt 0 wb
        let j := next + 3
        let r := next + 4
        let small := assemble [magI (next + 5) primUnbox [a], magI (next + 6) primUnbox [b], magI (next + 7) primEq [((next + 5 : Nat) : Int), ((next + 6 : Nat) : Int)]]
          (mkJmp j [((next + 7 : Nat) : Int)])
        let other := mkVDecl (next + 8) tyI64 (mkFap (hIntEq cx.n) [a, b]) (mkJmp j [((next + 8 : Nat) : Int)])
        { ok := wa.length == 1 && wb.length == 1, next := next + 9, r := (r : Int),
          items := [magI next primIsScalar [a], magI (next + 1) primIsScalar [b], magI (next + 2) primAnd [(next : Int), ((next + 1 : Nat) : Int)],
                    mkSplit j (paramsOfWords [(r : Int)] [tyI64]) (mkIfW (next + 2) small other)] }
      else
      -- the first field, and the record of the fields after it
      let rh := wtRecHead cx.g ty
      let ft := fwFlat cx.g rh.head
      let w := ft.ts.length
      let a := eqItems cx rh.head (takeI w wa) (takeI w wb) next
      let b := eqItems cx rh.tail (wa.drop w) (wb.drop w) a.next
      if !rh.ok then eqConst 1 next
      else if !ft.ok || !a.ok || !b.ok then eqFail
      else { ok := true, next := b.next + 1, r := (b.next : Int),
             items := a.items ++ b.items ++ [mkVDecl b.next tyI64 (mkPrim primAnd 0 0 [a.r, b.r]) mkUnreachable] }
    | _ => eqFail

-- the tag test `n.f0 == t` on a node seen through a handle: the handle and the tag, or h = -1
structure TagTest where
  h : Int
  t : Int
  ix : Int
  thenAt : List Int
  deriving Inhabited

def noTagTest : TagTest := { h := -1, t := 0, ix := -1, thenAt := [] }

-- `c` is the condition of an `if` (after its tag byte)
def fwTagTest (cx : Cx) (env : List Val) (c : List Int) : TagTest :=
  match drE cx.g c with
  | 14 :: bs =>
    let t := readTyD cx.g bs
    if t.ok != profile.cOk || tyView cx.g t.acc != [0] then noTagTest
    else
      match drE cx.g t.rest with
      | 35 :: fs =>
        let rt := readTyD cx.g fs
        let ix := readLeb rt.rest
        if rt.ok != profile.cOk || ix.ok != profile.cOk || ix.n != 0 then noTagTest
        else
          match drE cx.g ix.rest with
          | 3 :: vb =>
            let vi := readLeb vb
            if vi.ok != profile.cOk || vi.n < 0 then noTagTest
            else
              match envAt vi.n.toNat env with
              | some v =>
                if v.kind != 1 then noTagTest
                else
                  match drE cx.g vi.rest with
                  | 0 :: lit =>
                    let n := readLeafI64 lit
                    if n.ok != profile.cOk then noTagTest
                    else { h := intAt 0 v.ws, t := n.n, ix := vi.n, thenAt := n.rest }
                  | _ => noTagTest
              | none => noTagTest
          | _ => noTagTest
      | _ => noTagTest
  | _ => noTagTest

-- The test `len xs == 0` of a match on a list (rsdc writes `match xs with | [] => A | h :: t => B`
-- as `if len xs == 0 then A else B`, with h and t read by `unwrap (first xs)` and `drop 1 xs`):
-- the list's type, the stream at the list expression, and the stream at A.
structure LenTest where
  ok : Bool
  ty : List Int
  ex : List Int
  thenAt : List Int
  deriving Inhabited

def noLenTest : LenTest := { ok := false, ty := [], ex := [], thenAt := [] }

-- `c` is the condition of an `if` (after its tag byte)
def fwLenTest (cx : Cx) (c : List Int) : LenTest :=
  match drE cx.g c with
  | 14 :: bs =>
    let t := readTyD cx.g bs
    if t.ok != profile.cOk || tyView cx.g t.acc != [0] then noLenTest
    else
      match drE cx.g t.rest with
      | 24 :: ls =>
        let lt := readTyD cx.g ls
        if lt.ok != profile.cOk || (wtElem cx.g lt.acc).isEmpty then noLenTest
        else
          let after := (skipE cx.g profile.v2Fuel lt.rest).rest
          match drE cx.g after with
          | 0 :: lit =>
            let n := readLeafI64 lit
            if n.ok != profile.cOk || n.n != 0 then noLenTest
            else { ok := true, ty := lt.acc, ex := lt.rest, thenAt := n.rest }
          | _ => noLenTest
      | _ => noLenTest
  | _ => noLenTest

-- is the expression at `e` the integer literal 1
def fwIsOne (cx : Cx) (e : List Int) : Bool :=
  match drE cx.g e with
  | 0 :: lit =>
    let n := readLeafI64 lit
    n.ok == profile.cOk && n.n == 1
  | _ => false

structure LenR where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  next : Nat
  -- the instructions that compute the list, and its variable
  pre : List N
  x : Nat
  alts : List N
  ts : List Int
  rest : List Int
  deriving Inhabited

def lenFail (err : Residue) (rest : List Int) : LenR :=
  { ok := false, err := some err, next := 0, pre := [], x := 0, alts := [], ts := [], rest := rest }
def lenPass (err : Option Residue) (rest : List Int) : LenR :=
  { ok := false, err := err, next := 0, pre := [], x := 0, alts := [], ts := [], rest := rest }

-- the alternative of the node constructor of tag t: its fields are counted by the layout ("Layout")
def nodeAlt (t : Int) : CtorInfo := { cidx := t.toNat, size := 0, ssize := 0, tid := 1 }

-- the tags of the image that are not in `seen`
def tagsLeft (seen : List Int) : List Int → List Int
  | tag :: rest => if seen.contains tag then tagsLeft seen rest else tag :: tagsLeft seen rest
  | [] => []

-- The children of a node, seen through its handle and not yet taken apart (a value of kind 2),
-- as the list they are (`primNodeKids`): the wire's `kid` reads one child of such a value by its
-- number, every other place takes the list.
def asList (a : TV) : TV :=
  if !a.ok || a.val.kind != 2 then a
  else
    let x := a.next
    { a with next := x + 1, items := a.items ++ [mkVDecl x tyTObj (mkPrim primNodeKids 0 0 a.val.ws) mkUnreachable],
             val := valTyped [(x : Int)] [tyTObj] a.val.wt }

/-! ### Numbers in nodes

The front end keeps a field of type Nat, Int, List Nat or List Int of a recursive type in a child
node of its own (rsdc/Compile.rsd `arenaMagnitudeHoldW`, `arenaMagnitudeFromNodeW`). The child's
list of integers f8 holds the numbers packed as words (for each: its sign when an Int, the count
of its limbs, the limbs), written by one of the image's own functions and read back by another:

  hold (let T e (let [T] [v0] (pack v0))) arena          a number e
  hold (let [T] e (pack v0)) arena                       a list of numbers e
  first (let [W] n.f8 (unpack v0))                       the number
  let [W] n.f8 (unpack v0)                               the list

The stage knows `pack` and `unpack` as it knows the integer operations (`magFind`: operations 20 to
23, by the number of their code), and `first` and `hold` by their bodies, which are one expression
each (`numShapes`). It writes these four places as an allocation and a read of a node whose f8 is the number or the
list itself: `primNodeNew` and `primNodeInts` with the place's form in `d` (`numMark`); a natural
number and an integer are one word each ("An integer is one word"). "Layout" keeps the number in
the node where every allocation of the node's class and tag is of one form and every read of its
f8 is of that form. Everywhere else it writes the place as the image did, with the image's functions:
they are still there, and still called by any place that is not one of the four. The guards are
those of the calls as written, so a place refuses on the budgets it refused on. -/

-- the form of a place: 1 a Nat, 2 an Int, 3 a list of Nat, 4 a list of Int; 0 for a node instruction as the wire has it
def numForm (e : N) : Int := e.d % 8
-- how many calls below its place the instruction stands (`mkFapAt`)
def numDepth (e : N) : Nat := (e.d / 8).toNat
def numMark (form : Int) (depth : Nat) (e : N) : N := { e with d := form + 8 * (depth : Int) }

-- the function of the image that is operation `op` (pairs function, operation), or -1
def numFn (op : Int) : List Int → Int
  | f :: o :: rest => if o == op then f else numFn op rest
  | _ => -1

-- the function an expression calls with the innermost variable as its one argument, or -1
def numCallOfV0 (g : Dg) (e : List Int) : Int :=
  match drE g e with
  | 52 :: bs =>
    let f := readLeb bs
    if f.ok != profile.cOk || f.n < 0 then -1
    else
      match f.rest with
      | 1 :: a => if varOfExpr g a == 0 && (skipE g profile.v2Fuel a).rest.headD 1 == 0 then f.n else -1
      | _ => -1
  | _ => -1

structure NumSite where
  -- 0: the place is not one of the four
  form : Int
  -- the stream at the number's expression (an allocation), at the node's (a read)
  e : List Int
  -- the wire type written for it
  ty : List Int
  -- the image's function that packs or unpacks
  fn : Int
  deriving Inhabited

def numNone : NumSite := { form := 0, e := [], ty := [], fn := -1 }

-- the first argument of `hold`: the number or the list of numbers it packs
def numPackSite (g : Dg) (mag : List Int) (a : List Int) : NumSite :=
  match drE g a with
  | 4 :: bs =>
    let t := readTyD g bs
    if t.ok != profile.cOk then numNone
    else
      let body := (skipE g profile.v2Fuel t.rest).rest
      let f := numCallOfV0 g body
      let p := factOf f mag
      if p == numPackNat || p == numPackInt then { form := p - 17, e := t.rest, ty := t.acc, fn := f }
      else
        match drE g body with
        | 4 :: bs2 =>
          let t2 := readTyD g bs2
          let one := match drE g t2.rest with
            | 23 :: x => varOfExpr g x == 0
            | _ => false
          let f2 := if t2.ok == profile.cOk && one then numCallOfV0 g (skipE g profile.v2Fuel t2.rest).rest else -1
          let p2 := factOf f2 mag
          if p2 == numPackNat || p2 == numPackInt then { form := p2 - 19, e := t.rest, ty := t.acc, fn := f2 } else numNone
        | _ => numNone
  | _ => numNone

-- `let [W] n.f8 (unpack v0)`: the list of numbers a node holds; `e` is the stream at the node
def numUnpackSite (g : Dg) (mag : List Int) (a : List Int) : NumSite :=
  match drE g a with
  | 4 :: bs =>
    let t := readTyD g bs
    if t.ok != profile.cOk || t.acc != [4, 0] then numNone
    else
      match drE g t.rest with
      | 35 :: ps =>
        let rt := readTyD g ps
        let ix := readLeb rt.rest
        let f := if rt.ok == profile.cOk && ix.ok == profile.cOk && ix.n == 8 && isHeapNode g rt.acc then numCallOfV0 g (skipE g profile.v2Fuel t.rest).rest else -1
        let u := factOf f mag
        if u == numUnpackNat || u == numUnpackInt then { form := u - 19, e := ix.rest, ty := rt.acc, fn := f } else numNone
      | _ => numNone
  | _ => numNone

/-! ### A magnitude where no list is needed

Two places read a magnitude as its limb list and need no list ("Magnitudes" says where the word
changes its meaning: these two are a projection met by a marker record, and a projection met by
the empty list):

  {\0IntMag1 := n.\0NatMag1}, {\0NatMag1 := i.\0IntMag1}    a Nat as an Int, the magnitude of an Int as a Nat
  eq@[W] n.\0NatMag1 []                                       is the number zero

In the first the word is handed on as it is: `natOf (natDigits w)` is w for a small w, and a limb
list stays the list it was. In the second the word is compared: zero is the small number 0 and no
other word. The expression e of `e.Mag` is translated where it stood, so what it refuses on is
refused. -/

structure MagProj where
  ok : Bool
  -- the record's wire type, the field's index, and the stream at the record's expression
  ty : List Int
  ix : Nat
  e : List Int
  deriving Inhabited

def magProjNone : MagProj := { ok := false, ty := [], ix := 0, e := [] }

-- `35 T i e` where field i of T is the magnitude of a marker record
def magProjOf (g : Dg) (v : List Int) : MagProj :=
  match drE g v with
  | 35 :: bs =>
    let rt := readTyD g bs
    let ix := readLeb rt.rest
    if rt.ok == profile.cOk && ix.ok == profile.cOk && ix.n >= 0 && magField g rt.acc == ix.n then { ok := true, ty := rt.acc, ix := ix.n.toNat, e := ix.rest }
    else magProjNone
  | _ => magProjNone

-- The word of the magnitude that `pj` projects, from the words `ws` of the record's value: its instructions and the
-- one word, or no word when the value has not the record's words. A natural number's magnitude is its word; an
-- integer's is read from the integer's word ("An integer is one word").
def magWordOf (cx : Cx) (pj : MagProj) (ws : List Int) (next : Nat) : ItemsR :=
  if tyView cx.g pj.ty == intRecTy then
    (if ws.length != 1 then { next := next, items := [], ws := [] }
     else { next := next + 1, items := [mkVDecl next tyTObj (mkFap (hIntMag cx.n) ws) mkUnreachable], ws := [(next : Int)] })
  else
    let ps := fwSlice cx.g pj.ty pj.ix
    if !ps.ok || ps.width != 1 || ps.off >= ws.length then { next := next, items := [], ws := [] }
    else { next := next, items := [], ws := [intAt ps.off ws] }

-- the operands of `eq@[W] a b` (`bs` is the stream at the type): a magnitude's projection on one side, `[]` on the other
def magZeroTest (g : Dg) (bs : List Int) : MagProj :=
  let t := readTyD g bs
  if t.ok != profile.cOk || t.acc != [4, 0] then magProjNone
  else
    let a := t.rest
    let first := (drE g a).headD 0
    if first != 35 && first != 22 then magProjNone
    else
      let b := (skipE g profile.v2Fuel a).rest
      if first == 35 && (drE g b).headD 0 == 22 then magProjOf g a
      else if first == 22 then magProjOf g b
      else magProjNone

structure FwAlts where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  next : Nat
  alts : List N
  -- the types of the value the alternatives produce (value position), from the first alternative
  ts : List Int
  rest : List Int
  deriving Inhabited

mutual
-- An expression whose value is used: the instructions that compute it, in order, and the value.
-- `want` is the wire type the place expects, [] where it is not known: the wire writes `none`, `[]`
-- and a sum's constructor without their type, which the place gives (rsc/rsc.rsd `lower` takes the
-- same type down). The children of a node come as the list they are (`asList`); `trValV` is the
-- same for the two places that keep them as they stand: the binding of a `let`, and `kid`.
partial def trVal (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (rest0 : List Int) : TV :=
  asList (trValV cx want env facts next rest0)
partial def trValV (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (rest0 : List Int) : TV :=
  match drE cx.g rest0 with
  | [] => tvFail fwWire []
  | tag :: bs =>
    -- `after` is what follows this expression in the enclosing stream
    let after := (skipE cx.g profile.v2Fuel rest0).rest
    if tag == 0 then
      let n := readLeafI64 bs
      if n.ok != profile.cOk then tvFail fwWire bs
      else { ok := true, err := none, next := next + 1, items := [mkVDecl next tyI64 (mkLit n.n) mkUnreachable],
             val := valLit (next : Int) n.n, rest := after }
    else if tag == 1 then
      match bs with
      | b :: _ => { ok := true, err := none, next := next + 1, items := [mkVDecl next tyI64 (mkLit b) mkUnreachable],
                    val := valWords [(next : Int)] [tyI64], rest := after }
      | [] => tvFail fwWire bs
    else if tag == 2 then
      let s := readStr bs
      if s.ok != profile.cOk then tvFail fwWire bs
      else if s.bs.length > litMax then tvFail fwLit bs
      else
        { ok := true, err := none, next := next + 1, items := [mkVDecl next tyObj (if s.n == 0 then mkLitStr "" else mkLitBytes s.bs) mkUnreachable],
          val := valTyped [(next : Int)] [tyObj] [2], rest := after }
    else if tag == 3 then
      let ix := readLeb bs
      if ix.ok != profile.cOk || ix.n < 0 then tvFail fwWire bs
      else
        match envAt ix.n.toNat env with
        | some v => { ok := true, err := none, next := next, items := [], val := v, rest := after }
        | none => tvFail fwWire bs
    else if tag == 4 && cx.num && (numUnpackSite cx.g cx.mag rest0).form != 0 then
      trNumRead cx env facts next (numUnpackSite cx.g cx.mag rest0) (-1) after
    else if tag == 4 then
      let t := readTyD cx.g bs
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let v := trValV cx t.acc env facts next t.rest
        if !v.ok then v
        else
          -- the binding's annotation is the value's wire type
          let bound := if v.val.kind == 0 then { v.val with wt := t.acc } else v.val
          let b := trValV cx want (bound :: env) facts v.next v.rest
          if !b.ok then b else { b with items := v.items ++ b.items, rest := after }
    else if tag == 5 && (fwLenTest cx bs).ok then
      -- a match on a list: the alternatives jump to a join point with the value
      let j := next
      let r := trLenAlts cx want env facts (next + 1) false (fwLenTest cx bs) (j : Int)
      if !r.ok then tvPass r.err bs
      else
        let ps := freshFor r.ts r.next
        let split := mkSplit j (paramsOfWords ps.vars r.ts) (mkCase r.x tyTObj r.alts)
        { ok := true, err := none, next := ps.next, items := r.pre ++ [split], val := valWords ps.vars r.ts, rest := after }
    else if tag == 5 then
      let tt := fwTagTest cx env bs
      if tt.h >= 0 then
        -- a match on a node: the alternatives jump to a join point with the value
        let r := trAlts cx want env facts next false tt bs [] (next : Int)
        if !r.ok then tvPass r.err bs
        else
          let ps := freshFor r.ts r.next
          let split := mkSplit next (paramsOfWords ps.vars r.ts) (mkCase tt.h.toNat tyTObj r.alts)
          { ok := true, err := none, next := ps.next, items := [split], val := valWords ps.vars r.ts, rest := after }
      else
        let c := trVal cx [1] env facts (next + 1) bs
        if !c.ok then c
        else if c.val.kind != 0 || c.val.ws.length != 1 then tvFail fwType bs
        else
          let a := trVal cx want env facts c.next c.rest
          if !a.ok then a
          else
            let b := trVal cx want env facts a.next a.rest
            if !b.ok then b
            else if a.val.kind != 0 || b.val.kind != 0 || a.val.ts != b.val.ts then tvFail fwType bs
            else
              let ps := freshFor a.val.ts b.next
              let j := next
              let thenB := assemble a.items (mkJmp j (liveWords a.val.ws a.val.ts))
              let elseB := assemble b.items (mkJmp j (liveWords b.val.ws b.val.ts))
              let split := mkSplit j (paramsOfWords ps.vars a.val.ts) (mkIfW (intAt 0 c.val.ws).toNat thenB elseB)
              { ok := true, err := none, next := ps.next, items := c.items ++ [split], val := valWords ps.vars a.val.ts, rest := after }
    else if tag == 6 || tag == 7 || tag == 8 || tag == 10 || tag == 11 || tag == 12 || tag == 13 || tag == 15 || tag == 16 then
      let opTy : List Int := if tag == 15 || tag == 16 then [1] else [0]
      let a := trVal cx opTy env facts next bs
      if !a.ok then a
      else
        let b := trVal cx opTy env facts a.next a.rest
        if !b.ok then b
        else if a.val.kind != 0 || b.val.kind != 0 || a.val.ts != [tyI64] || b.val.ts != [tyI64] then tvFail fwType bs
        else
          let x := b.next
          { ok := true, err := none, next := x + 1,
            items := a.items ++ b.items ++ [mkVDecl x tyI64 (mkPrim tag.toNat 0 0 (a.val.ws ++ b.val.ws)) mkUnreachable],
            val := valWords [(x : Int)] [tyI64], rest := after }
    else if tag == 9 || tag == 17 then
      let a := trVal cx (if tag == 17 then [1] else [0]) env facts next bs
      if !a.ok then a
      else if a.val.kind != 0 || a.val.ts != [tyI64] then tvFail fwType bs
      else
        let x := a.next
        { ok := true, err := none, next := x + 1, items := a.items ++ [mkVDecl x tyI64 (mkPrim tag.toNat 0 0 a.val.ws) mkUnreachable],
          val := valWords [(x : Int)] [tyI64], rest := after }
    else if tag == 14 && (magZeroTest cx.g bs).ok then
      -- is a number zero ("A magnitude where no list is needed")
      let pz := magZeroTest cx.g bs
      let r := trVal cx pz.ty env facts next pz.e
      let mw := magWordOf cx pz r.val.ws r.next
      if !r.ok then r
      else if r.val.kind != 0 || mw.ws.isEmpty then tvFail fwType bs
      else
        -- a small number is zero when it is 0; a limb list is no zero
        let w := intAt 0 mw.ws
        let x := mw.next
        let j := x + 1
        let res := x + 2
        let small := assemble [magI (x + 3) primUnbox [w], magL (x + 4) 0, magI (x + 5) primEq [((x + 3 : Nat) : Int), ((x + 4 : Nat) : Int)]]
          (mkJmp j [((x + 5 : Nat) : Int)])
        let other := assemble [magL (x + 6) 0] (mkJmp j [((x + 6 : Nat) : Int)])
        { ok := true, err := none, next := x + 7,
          items := r.items ++ mw.items ++ [magI x primIsScalar [w], mkSplit j (paramsOfWords [(res : Int)] [tyI64]) (mkIfW x small other)],
          val := valWords [(res : Int)] [tyI64], rest := after }
    else if tag == 14 then
      -- equality at the written type ("Equality")
      let t := readTyD cx.g bs
      let ft := fwFlat cx.g t.acc
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let a := trVal cx t.acc env facts next t.rest
        if !a.ok then a
        else
          let b := trVal cx t.acc env facts a.next a.rest
          if !b.ok then b
          else if !ft.ok || a.val.kind != 0 || b.val.kind != 0 || a.val.ts != ft.ts || b.val.ts != ft.ts then tvFail fwType bs
          else
            let e := eqItems cx t.acc a.val.ws b.val.ws b.next
            if !e.ok then tvFail fwType bs
            else { ok := true, err := none, next := e.next, items := a.items ++ b.items ++ e.items, val := valWords [e.r] [tyI64], rest := after }
    else if tag == 33 then { ok := true, err := none, next := next, items := [], val := valNone, rest := after }
    else if tag == 34 && magNameAt intSgnName bs && (intLit cx.g bs).ok then
      -- an integer written out: its word ("An integer is one word")
      let i := (intLit cx.g bs).n
      { ok := true, err := none, next := next + 2,
        items := [mkVDecl next tyI64 (mkLit i) mkUnreachable, mkVDecl (next + 1) tyTObj (mkPrim primBoxS 0 0 [(next : Int)]) mkUnreachable],
        val := valWords [((next + 1 : Nat) : Int)] [tyTObj], rest := after }
    else if tag == 34 then
      let nm := skipName bs
      if nm.ok != profile.cOk then tvFail fwWire bs
      else
        -- the field's type and the type of the fields that follow, from the record type of the place
        let rh := wtRecHead cx.g want
        -- a magnitude: a literal of at most `magLimbs` limbs is its small number; any other list goes through `natOf`
        let isMag := magNameAt natMagName bs || magNameAt intMagName bs
        let lit := if isMag then litMag magLimbs (drE cx.g nm.rest) else -1
        -- the magnitude of another marker record: its word as it is ("A magnitude where no list is needed")
        let pj := if isMag && lit < 0 then magProjOf cx.g nm.rest else magProjNone
        let pr := if pj.ok then trVal cx pj.ty env facts next pj.e else tvFail fwWire bs
        let pw := magWordOf cx pj pr.val.ws pr.next
        let a0 := if lit >= 0 || pj.ok then tvFail fwWire bs else trVal cx rh.head env facts next nm.rest
        let small : List N := [mkVDecl next tyI64 (mkLit lit) mkUnreachable, mkVDecl (next + 1) tyTObj (mkPrim primBox 0 0 [(next : Int)]) mkUnreachable]
        let fo := forceItem cx.arr (intAt 0 a0.val.ws) a0.next
        let viaOf : List N := a0.items ++ fo.items ++ [mkVDecl fo.next tyTObj (mkFap (hNatOf cx.n) fo.ws) mkUnreachable]
        let a : TV :=
          if lit >= 0 then
            { ok := true, err := none, next := next + 2, rest := (skipE cx.g profile.v2Fuel nm.rest).rest, items := small,
              val := valTyped [((next + 1 : Nat) : Int)] [tyTObj] rh.head }
          else if pj.ok then
            (if !pr.ok then pr
             else if pr.val.kind != 0 || pw.ws.isEmpty then tvFail fwType bs
             else { pr with next := pw.next, items := pr.items ++ pw.items, val := valTyped [intAt 0 pw.ws] [tyTObj] rh.head,
                            rest := (skipE cx.g profile.v2Fuel nm.rest).rest })
          else if isMag && a0.ok && a0.val.kind == 0 && a0.val.ts == [tyTObj] then
            { a0 with next := fo.next + 1, items := viaOf, val := valTyped [(fo.next : Int)] [tyTObj] a0.val.wt }
          else a0
        if !a.ok then a
        else
          let b := trVal cx rh.tail env facts a.next a.rest
          if !b.ok then b
          else if a.val.kind != 0 || b.val.kind != 0 then tvFail fwNodeUse bs
          else if magNameAt intSgnName bs then
            -- the integer's record: the word of its sign and its magnitude's word ("An integer is one word")
            (if a.val.ts != [tyI64] || b.val.ts != [tyTObj] then tvFail fwType bs
             else { ok := true, err := none, next := b.next + 1,
                    items := a.items ++ b.items ++ [mkVDecl b.next tyTObj (mkFap (hIntOf cx.n) (a.val.ws ++ b.val.ws)) mkUnreachable],
                    val := valWords [(b.next : Int)] [tyTObj], rest := after })
          else { ok := true, err := none, next := b.next, items := a.items ++ b.items,
                 val := valWords (a.val.ws ++ b.val.ws) (a.val.ts ++ b.val.ts), rest := after }
    else if tag == 35 then
      let rt := readTyD cx.g bs
      let ix := readLeb rt.rest
      if rt.ok != profile.cOk || ix.ok != profile.cOk || ix.n < 0 then tvFail fwWire bs
      else
        let a := trVal cx rt.acc env facts next ix.rest
        if !a.ok then a
        else if a.val.kind == 1 then trNodeField cx facts a (intAt 0 a.val.ws) ix.n.toNat (4 :: heapHandleOf cx.g rt.acc) after
        else if a.val.kind != 0 then tvFail fwNodeUse bs
        else if tyView cx.g rt.acc == intRecTy then
          -- a field of an integer, read from its word: the sign, or the magnitude as its limb list ("An integer is one word")
          (if a.val.ws.length != 1 || ix.n > 1 then tvFail fwType bs
           else if ix.n == 0 then
             { a with next := a.next + 1, items := a.items ++ [mkVDecl a.next tyI64 (mkFap (hIntSign cx.n) a.val.ws) mkUnreachable],
                      val := valTyped [(a.next : Int)] [tyI64] [1], rest := after }
           else
             { a with next := a.next + 2,
                      items := a.items ++ [mkVDecl a.next tyTObj (mkFap (hIntMag cx.n) a.val.ws) mkUnreachable,
                                           mkVDecl (a.next + 1) tyTObj (mkFap (hNatDigits cx.n) [(a.next : Int)]) mkUnreachable],
                      val := valTyped [((a.next + 1 : Nat) : Int)] [tyTObj] [4, 0], rest := after })
        else
          let s := fwSlice cx.g rt.acc ix.n.toNat
          if !s.ok || s.off + s.width > a.val.ws.length then tvFail fwType bs
          else if magField cx.g rt.acc == ix.n && s.width == 1 then
            -- the magnitude of a marker record, read as its limb list ("Magnitudes")
            let read := mkVDecl a.next tyTObj (mkFap (hNatDigits cx.n) (takeI 1 (a.val.ws.drop s.off))) mkUnreachable
            { a with next := a.next + 1, items := a.items ++ [read], val := valTyped [(a.next : Int)] [tyTObj] s.ty, rest := after }
          else { a with val := valTyped (takeI s.width (a.val.ws.drop s.off)) (takeI s.width (a.val.ts.drop s.off)) s.ty, rest := after }
    else if tag == 22 then
      { ok := true, err := none, next := next + 1, items := [mkVDecl next tyTObj (mkCtor nilInfo []) mkUnreachable],
        val := valTyped [(next : Int)] [tyTObj] (if wtIsList cx.g want then want else []), rest := after }
    else if tag == 23 then
      -- [e]: the cell of e and nil
      let a := trVal cx (wtElem cx.g want) env facts next bs
      if !a.ok then a
      else if a.val.kind != 0 then tvFail fwNodeUse bs
      else
        let nl := a.next
        let c := consItems a.val.ws a.val.ts (nl : Int) (nl + 1)
        { ok := true, err := none, next := c.next, items := a.items ++ [mkVDecl nl tyTObj (mkCtor nilInfo []) mkUnreachable] ++ c.items,
          val := valTyped c.ws [tyTObj] (if wtIsList cx.g want then want else wtListOf a.val.wt), rest := after }
    else if tag == 26 then
      match drE cx.g bs with
      | 23 :: e =>
        -- e :: xs, which rsdc writes [e] ++ xs: one cell
        let a := trVal cx (wtElem cx.g want) env facts next e
        if !a.ok then a
        else if a.val.kind != 0 then tvFail fwNodeUse bs
        else
          let b := trVal cx (if wtIsList cx.g want then want else wtListOf a.val.wt) env facts a.next a.rest
          if !b.ok then b
          else if b.val.kind != 0 || b.val.ts != [tyTObj] then tvFail fwType bs
          else
            -- the tail of a cell is cells ("Arrays")
            let fb := forceItem cx.arr (intAt 0 b.val.ws) b.next
            let c := consItems a.val.ws a.val.ts (intAt 0 fb.ws) fb.next
            let wt := if wtIsList cx.g want then want else if !b.val.wt.isEmpty then b.val.wt else wtListOf a.val.wt
            { ok := true, err := none, next := c.next, items := a.items ++ b.items ++ fb.items ++ c.items, val := valTyped c.ws [tyTObj] wt, rest := after }
      | _ =>
        let lty : List Int := if wtIsList cx.g want then want else []
        let a := trVal cx lty env facts next bs
        let second : Int := if a.ok && cx.arr && a.val.kind == 0 && a.val.ts == [tyTObj] then (drE cx.g a.rest).headD 0 else 0
        let wt0 : List Int := if !lty.isEmpty then lty else a.val.wt
        if !a.ok then a
        else if second == 22 then
          -- xs ++ []: the array of xs ("Arrays")
          let et := fwFlat cx.g (wtElem cx.g wt0)
          let x := a.next
          let grow := mkPrim primArrOfList ((elemShape et.ts : Nat) : Int) 0 a.val.ws
          if (wtElem cx.g wt0).isEmpty || !et.ok then tvFail fwType bs
          else { ok := true, err := none, next := x + 1, items := a.items ++ [mkVDecl x tyTObj grow mkUnreachable], val := valTyped [(x : Int)] [tyTObj] wt0, rest := after }
        else if second == 23 then
          -- xs ++ [e]: the array of xs with e at its end ("Arrays")
          let v := trVal cx (wtElem cx.g wt0) env facts a.next ((drE cx.g a.rest).drop 1)
          let w := elemWord v.val.ws v.val.ts v.next
          let x := w.next
          let grow := mkPrim primArrPush ((elemShape v.val.ts : Nat) : Int) 0 (a.val.ws ++ w.ws)
          let wt := if !wt0.isEmpty then wt0 else wtListOf v.val.wt
          if !v.ok then v
          else if v.val.kind != 0 then tvFail fwNodeUse bs
          else if wt.isEmpty then tvFail fwType bs
          else { ok := true, err := none, next := x + 1, items := a.items ++ v.items ++ w.items ++ [mkVDecl x tyTObj grow mkUnreachable], val := valTyped [(x : Int)] [tyTObj] wt, rest := after }
        else
          let b := trVal cx (if lty.isEmpty then a.val.wt else lty) env facts a.next a.rest
          if !b.ok then b
          else if a.val.kind != 0 || b.val.kind != 0 || a.val.ts != [tyTObj] || b.val.ts != [tyTObj] then tvFail fwType bs
          else
            let wt := if !lty.isEmpty then lty else if a.val.wt.isEmpty then b.val.wt else a.val.wt
            let et := fwFlat cx.g (wtElem cx.g wt)
            if (wtElem cx.g wt).isEmpty || !et.ok then tvFail fwType bs
            else
              -- both operands as cells ("Arrays")
              let fa := forceItem cx.arr (intAt 0 a.val.ws) b.next
              let fb := forceItem cx.arr (intAt 0 b.val.ws) fa.next
              let x := fb.next
              { ok := true, err := none, next := x + 1,
                items := a.items ++ b.items ++ fa.items ++ fb.items ++ [mkVDecl x tyTObj (mkFap (hApp cx.n (elemShape et.ts)) (fa.ws ++ fb.ws)) mkUnreachable],
                val := valTyped [(x : Int)] [tyTObj] wt, rest := after }
    else if tag == 24 then
      -- the length as a number
      let t := readTyD cx.g bs
      let et := fwFlat cx.g (wtElem cx.g t.acc)
      if t.ok != profile.cOk || (wtElem cx.g t.acc).isEmpty || !et.ok then tvFail fwType bs
      else
        let a := trVal cx t.acc env facts next t.rest
        if !a.ok then a
        else if a.val.kind != 0 || a.val.ts != [tyTObj] then tvFail fwType bs
        else
          let z := a.next
          let x := z + 1
          -- of a list that may be an array: its size, or the count of its cells ("Arrays")
          let len := if cx.arr then mkFap (hLenA cx.n (elemShape et.ts)) a.val.ws else mkFap (hLen cx.n (elemShape et.ts)) (a.val.ws ++ [(z : Int)])
          { ok := true, err := none, next := x + 1,
            items := a.items ++ [mkVDecl z tyI64 (mkLit 0) mkUnreachable, mkVDecl x tyI64 len mkUnreachable],
            val := valTyped [(x : Int)] [tyI64] [0], rest := after }
    else if tag == 25 then trFirst cx (wtListOf (wtPayload cx.g want)) env facts next bs after false
    else if tag == 39 then
      match drE cx.g bs with
      | 25 :: e => trFirst cx (wtListOf want) env facts next e after true
      | _ =>
        let a := trVal cx (wtOptionOf want) env facts next bs
        if !a.ok then a
        else if a.val.kind != 0 || a.val.ts.headD tyIrr != tyI64 then tvFail fwType bs
        else
          let pts := a.val.ts.drop 1
          let pws := a.val.ws.drop 1
          let j := a.next
          let ps := freshFor pts (j + 1)
          let fl := if (liveTys pts).isEmpty then failAlways ps.next else failItems ps.next pts
          let split := mkSplit j (paramsOfWords ps.vars pts)
            (mkIfW (intAt 0 a.val.ws).toNat (mkJmp j (liveWords pws pts)) (assemble fl.items (mkJmp j (liveWords fl.ws pts))))
          { ok := true, err := none, next := fl.next, items := a.items ++ [split], val := valTyped ps.vars pts (wtPayload cx.g a.val.wt), rest := after }
    else if tag == 27 then
      -- drop k xs
      let k := trVal cx [0] env facts next bs
      let taken : List Int := if k.ok && cx.arr && k.val.kind == 0 && k.val.ts == [tyI64] then drE cx.g k.rest else []
      if !k.ok then k
      else if taken.headD 0 == 50 && (foldIdiom cx.g (taken.drop 1)).kind == 2 then
        -- drop A (take B xs): the elements from index A up to B ("The front end's loops over an array")
        trTakeIdiom cx env facts k.next k.items k.val.ws (foldIdiom cx.g (taken.drop 1)) (readTyD cx.g (taken.drop 1)).acc after
      else
        let l := trVal cx (if wtIsList cx.g want then want else []) env facts k.next k.rest
        if !l.ok then l
        else if k.val.kind != 0 || k.val.ts != [tyI64] || l.val.kind != 0 || l.val.ts != [tyTObj] then tvFail fwType bs
        else
          let et := fwFlat cx.g (wtElem cx.g l.val.wt)
          if (wtElem cx.g l.val.wt).isEmpty || !et.ok then tvFail fwType bs
          else
            let known := fwIsOne cx bs && factOf (intAt 0 l.val.ws) facts == 1
            -- a list that is not known to be a cell is taken as cells ("Arrays")
            let fl := forceItem (cx.arr && !known) (intAt 0 l.val.ws) l.next
            let x := fl.next
            let xs := (intAt 0 l.val.ws).toNat
            -- the tail of a cell known to be one is a read; anything else is the function
            let e := if known then mkProj (consTail (elemShape et.ts)) xs else mkFap (hDrop cx.n (elemShape et.ts)) (k.val.ws ++ fl.ws)
            { ok := true, err := none, next := x + 1, items := k.items ++ l.items ++ fl.items ++ [mkVDecl x tyTObj e mkUnreachable],
              val := valTyped [(x : Int)] [tyTObj] l.val.wt, rest := after }
    else if tag == 36 then
      -- some e: the flag, then e's words
      let a := trVal cx (wtPayload cx.g want) env facts next bs
      if !a.ok then a
      else if a.val.kind != 0 then tvFail fwNodeUse bs
      else
        let x := a.next
        { ok := true, err := none, next := x + 1, items := a.items ++ [mkVDecl x tyI64 (mkLit 1) mkUnreachable],
          val := valTyped ((x : Int) :: a.val.ws) (tyI64 :: a.val.ts) (if !(wtPayload cx.g want).isEmpty then want else wtOptionOf a.val.wt),
          rest := after }
    else if tag == 37 then
      -- none: the flag, then a word per word of the payload, which nothing reads. The payload's
      -- type is the place's: the wire writes none without it.
      let pt := wtPayload cx.g want
      let et := fwFlat cx.g pt
      if pt.isEmpty || !et.ok then tvFail (fwUnsup tag) bs
      else
        let d := dummyItems (next + 1) et.ts
        { ok := true, err := none, next := d.next, items := mkVDecl next tyI64 (mkLit 0) mkUnreachable :: d.items,
          val := valTyped ((next : Int) :: d.ws) (tyI64 :: et.ts) want, rest := after }
    else if tag == 38 then
      -- isSome: the flag
      let t := readTyD cx.g bs
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let a := trVal cx t.acc env facts next t.rest
        if !a.ok then a
        else if a.val.kind != 0 || a.val.ts.headD tyIrr != tyI64 then tvFail fwType bs
        else { a with val := valTyped (takeI 1 a.val.ws) [tyI64] [1], rest := after }
    else if tag == 31 then
      -- inj k e: constructor k of the place's sum type over e's words ("Sums")
      let ix := readLeb bs
      let arms := wtArms cx.g want
      if ix.ok != profile.cOk || ix.n < 0 then tvFail fwWire bs
      else if ix.n.toNat >= arms.length then tvFail (fwUnsup tag) bs
      else
        let aty := armAt ix.n.toNat arms
        let ft := fwFlat cx.g aty
        let a := trVal cx aty env facts next ix.rest
        if !a.ok then a
        else if a.val.kind != 0 then tvFail fwNodeUse bs
        else if !ft.ok || a.val.ts != ft.ts then tvFail fwType bs
        else
          let c := sumItems (sumTid cx.g want) ix.n.toNat a.val.ws a.val.ts a.next
          { ok := true, err := none, next := c.next, items := a.items ++ c.items, val := valTyped c.ws [tyTObj] want, rest := after }
    else if tag == 32 then
      -- match on a sum whose value is used: the alternatives jump to a join point with the value
      let t := readTyD cx.g bs
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let j := next
        let sv := trVal cx t.acc env facts (next + 1) t.rest
        if !sv.ok then sv
        else if sv.val.kind != 0 || sv.val.ts != [tyTObj] || !wtIsSum cx.g t.acc then tvFail fwType bs
        else
          let x := (intAt 0 sv.val.ws).toNat
          let r := trArms cx want env facts sv.next false (sumTid cx.g t.acc) x 0 (wtArms cx.g t.acc) sv.rest (j : Int)
          if !r.ok then tvPass r.err bs
          else if r.alts.isEmpty then tvFail fwType bs
          else
            let ps := freshFor r.ts r.next
            let split := mkSplit j (paramsOfWords ps.vars r.ts) (mkCase x tyTObj r.alts)
            { ok := true, err := none, next := ps.next, items := sv.items ++ [split], val := valTyped ps.vars r.ts want, rest := after }
    else if tag == 50 && cx.arr && (foldIdiom cx.g bs).kind == 1 then
      trSetIdiom cx env facts next (foldIdiom cx.g bs) (readTyD cx.g bs).acc after
    else if tag == 50 && cx.arr && (foldIdiom cx.g bs).kind == 2 then
      trTakeIdiom cx env facts next [] [] (foldIdiom cx.g bs) (readTyD cx.g bs).acc after
    else if tag == 50 then
      -- fold xs z body ("Loops"): the list, the start value, then the loop as a function of its own:
      --   loop xs acc = case xs of nil => acc | cons => loop (tail xs) (body (head xs) acc)
      let t := readTyD cx.g bs
      let elemTy := wtElem cx.g t.acc
      let et := fwFlat cx.g elemTy
      if t.ok != profile.cOk then tvFail fwWire bs
      else if elemTy.isEmpty || !et.ok then tvFail fwType bs
      else
        let xs := trVal cx t.acc env facts next t.rest
        if !xs.ok then xs
        else if xs.val.kind != 0 || xs.val.ts != [tyTObj] then tvFail fwType bs
        else
          let z := trVal cx want env facts xs.next xs.rest
          let fv := fvE cx.g 2 [] z.rest
          if !z.ok then z
          else if z.val.kind != 0 then tvFail fwNodeUse bs
          else if !fv.ok then tvFail fwWire bs
          else
            let accTs := z.val.ts
            let accTy := if want.isEmpty then z.val.wt else want
            let x0 := z.next
            let tmp := liftBase + x0
            let pl := x0 + 1
            let pa := freshFor accTs (pl + 1)
            let le := liftCollect env fv.acc { next := pa.next, map := [], tys := [] }
            let h := headItems et.ts pl le.next
            let tl := h.next
            -- the body: the element is variable 0, the accumulator variable 1
            let b := trVal cx accTy (valTyped h.ws et.ts elemTy :: valTyped pa.vars accTs accTy :: liftEnvGo le.map fv.acc 0 env)
              ((pl : Int) :: 1 :: liftFacts le.map facts) (tl + 1) z.rest
            if !b.ok then b
            else if b.val.kind != 0 || b.val.ts != accTs then tvFail fwType bs
            else
              let again := callItem accTs (mkFapSame tmp ((tl : Int) :: (liveWords b.val.ws accTs ++ mapNews le.map))) b.next
              let step := assemble (h.items ++ [mkVDecl tl tyTObj (mkProj (consTail (elemShape et.ts)) pl) mkUnreachable] ++ b.items ++ [again.item])
                (mkRet (retWords again.vars accTs))
              let loop := mkCase pl tyTObj [mkAltCtor nilInfo (mkRet (retWords pa.vars accTs)), mkAltCtor (consInfo (elemShape et.ts)) step]
              let ps := pT pl :: (paramsOfWords pa.vars accTs ++ paramsOfTys (mapNews le.map) le.tys)
              -- the loop takes cells ("Arrays")
              let fxs := forceItem cx.arr (intAt 0 xs.val.ws) again.next
              let out := callItem accTs (mkFapSame tmp (fxs.ws ++ liveWords z.val.ws accTs ++ mapOlds le.map)) fxs.next
              { ok := true, err := none, next := out.next, items := xs.items ++ z.items ++ fxs.items ++ [liftItem x0 tmp ps (liftRets accTs) loop, out.item],
                val := valTyped out.vars accTs accTy, rest := after }
    else if tag == 51 then
      -- fix stop step z bound ("Loops"): the start state and the bound are evaluated first; a
      -- negative bound refuses (lib/RscBase.rsd `stNegativeFixBound`); then
      --   loop s steps bound = if stop s then (true, s, steps) else if bound = 0 then (false, s, steps)
      --                        else loop (step s) (steps + 1) (bound - 1)
      let t := readTyD cx.g bs
      let st := fwFlat cx.g t.acc
      if t.ok != profile.cOk then tvFail fwWire bs
      else if !st.ok then tvFail fwType bs
      else
        let stopAt := t.rest
        let stepAt := (skipE cx.g profile.v2Fuel stopAt).rest
        let z := trVal cx t.acc env facts next (skipE cx.g profile.v2Fuel stepAt).rest
        if !z.ok then z
        else if z.val.kind != 0 || z.val.ts != st.ts then tvFail fwType bs
        else
          let bd := trVal cx [0] env facts z.next z.rest
          let fv1 := fvE cx.g 1 [] stopAt
          let fv := fvE cx.g 1 fv1.acc stepAt
          if !bd.ok then bd
          else if bd.val.kind != 0 || bd.val.ts != [tyI64] then tvFail fwType bs
          else if !fv1.ok || !fv.ok then tvFail fwWire bs
          else
            let rts := tyI64 :: (st.ts ++ [tyI64])
            let bound0 := intAt 0 bd.val.ws
            -- the test of the bound, before the loop
            let zero := bd.next
            let neg := zero + 1
            let j := neg + 1
            let fl := j + 1
            let chk := mkSplit j [] (mkIfW neg (assemble [mkVDecl fl tyI64 (mkPrim primFail stNegativeFixBound 0 [argIrr]) mkUnreachable] (mkJmp j [])) (mkJmp j []))
            -- the loop function: the state's words, the steps taken, the rounds left, the variables it reads
            let x0 := fl + 1
            let tmp := liftBase + x0
            let ps0 := freshFor st.ts (x0 + 1)
            let pSteps := ps0.next
            let pBound := pSteps + 1
            let le := liftCollect env fv.acc { next := pBound + 1, map := [], tys := [] }
            let envL := valTyped ps0.vars st.ts t.acc :: liftEnvGo le.map fv.acc 0 env
            let factsL := liftFacts le.map facts
            let c := trVal cx [1] envL factsL le.next stopAt
            if !c.ok then c
            else if c.val.kind != 0 || c.val.ts != [tyI64] then tvFail fwType bs
            else
              let s2 := trVal cx t.acc envL factsL c.next stepAt
              if !s2.ok then s2
              else if s2.val.kind != 0 || s2.val.ts != st.ts then tvFail fwType bs
              else
                let one := s2.next
                let st1 := one + 1
                let bd1 := st1 + 1
                let again := callItem rts (mkFapSame tmp (liveWords s2.val.ws st.ts ++ [(st1 : Int), (bd1 : Int)] ++ mapNews le.map)) (bd1 + 1)
                let more := assemble (s2.items ++ [mkVDecl one tyI64 (mkLit 1) mkUnreachable,
                    mkVDecl st1 tyI64 (mkPrim primAdd 0 0 [(pSteps : Int), (one : Int)]) mkUnreachable,
                    mkVDecl bd1 tyI64 (mkPrim primSub 0 0 [(pBound : Int), (one : Int)]) mkUnreachable, again.item])
                  (mkRet (liveWords again.vars rts))
                let z0 := again.next
                let isz := z0 + 1
                let f0 := isz + 1
                let t1 := f0 + 1
                let same := liveWords ps0.vars st.ts ++ [(pSteps : Int)]
                let stopped := mkVDecl t1 tyI64 (mkLit 1) (mkRet ((t1 : Int) :: same))
                let spent := mkVDecl f0 tyI64 (mkLit 0) (mkRet ((f0 : Int) :: same))
                let rest := mkVDecl z0 tyI64 (mkLit 0) (mkVDecl isz tyI64 (mkPrim primEq 0 0 [(pBound : Int), (z0 : Int)]) (mkIfW isz spent more))
                let loop := assemble c.items (mkIfW (intAt 0 c.val.ws).toNat stopped rest)
                let ps := paramsOfWords ps0.vars st.ts ++ [pI pSteps, pI pBound] ++ paramsOfTys (mapNews le.map) le.tys
                let s0 := t1 + 1
                let out := callItem rts (mkFapSame tmp (liveWords z.val.ws st.ts ++ [(s0 : Int), bound0] ++ mapOlds le.map)) (s0 + 1)
                { ok := true, err := none, next := out.next,
                  items := z.items ++ bd.items ++ [mkVDecl zero tyI64 (mkLit 0) mkUnreachable,
                      mkVDecl neg tyI64 (mkPrim primLt 0 0 [bound0, (zero : Int)]) mkUnreachable, chk,
                      liftItem x0 tmp ps (liftRets rts) loop, mkVDecl s0 tyI64 (mkLit 0) mkUnreachable, out.item],
                  val := valTyped out.vars rts want, rest := after }
    else if tag == 52 then
      let f := readLeb bs
      if f.ok != profile.cOk || f.n < 0 then tvFail fwWire bs
      else
        let k := intrKind cx.intr f.n.toNat
        -- a number in a node ("Numbers in nodes"): `hold` of a packed number, `first` of an unpacked list
        let op := if cx.num then factOf f.n cx.mag else -1
        let arg1 : List Int := match f.rest with
          | 1 :: a => a
          | _ => []
        let packed := if op == numHold then numPackSite cx.g cx.mag arg1 else numNone
        let unpacked := if op == numFirst then numUnpackSite cx.g cx.mag arg1 else numNone
        if k == 4 then trRead cx env facts next f.rest after
        else if k == 3 then trAlloc cx env facts next f.rest after
        else if k == 5 then trKid cx env facts next f.rest after
        else if packed.form != 0 then trNumHold cx env facts next packed (skipE cx.g profile.v2Fuel arg1).rest after
        else if unpacked.form != 0 && (skipE cx.g profile.v2Fuel arg1).rest.headD 1 == 0 then
          trNumRead cx env facts next unpacked f.n after
        else trCall cx env facts next f.n.toNat f.rest after
    else tvFail (fwUnsup tag) bs

-- A number or a list of numbers read from the node that holds it ("Numbers in nodes"). `first` is the
-- image's function that takes the first number of the list, -1 when the place takes the list.
partial def trNumRead (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (site : NumSite) (first : Int) (after : List Int) : TV :=
  let a := trVal cx site.ty env facts next site.e
  let rty := (fwSig cx.g (sigOf cx.sigs (if first >= 0 then first.toNat else site.fn.toNat))).rty
  if !a.ok then a
  else if a.val.kind != 1 then tvFail fwNodeUse site.e
  else
    let h := intAt 0 a.val.ws
    let x := a.next
    let form : Int := if first >= 0 then site.form - 2 else site.form
    let depth := cx.inlOn.length
    -- the guard the entry of `unpack` was, and of `first`
    let guard := mkGuard (depth + 1) mkUnreachable
    -- the function `first` of the place rides in the instruction, for "Layout" (one more than its number; 0: none)
    { ok := true, err := none, next := x + 1,
      items := a.items ++ [guard, mkVDecl x tyTObj (numMark form depth (mkPrim primNodeInts 0 (first + 1) [h])) mkUnreachable],
      val := valTyped [(x : Int)] [tyTObj] rty, rest := after }

-- `hold packed arena` with the number or the list `site` names: the node that holds it. The guard
-- is that of the allocation in `hold`, two calls down; the one `pack` had is weaker.
partial def trNumHold (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (site : NumSite) (arena : List Int) (after : List Int) : TV :=
  let v := trVal cx site.ty env facts next site.e
  if !v.ok then v
  else if v.val.kind != 0 || v.val.ts != [tyTObj] then tvFail fwType site.e
  else
    match arena with
    | 1 :: a1 =>
      let ar := trVal cx [] env facts v.next a1
      if !ar.ok then ar
      else if ar.rest.headD 1 != 0 then tvFail fwWire a1
      else
        let x := ar.next
        let node := numMark site.form cx.inlOn.length (mkPrim primNodeNew 0 0 [argIrr, argIrr, argIrr, argIrr, argIrr, argIrr, intAt 0 v.val.ws])
        { ok := true, err := none, next := x + 1,
          items := v.items ++ ar.items ++ [mkGuard (cx.inlOn.length + 2) mkUnreachable, mkVDecl x tyTObj node mkUnreachable],
          val := valWords [(x : Int), argIrr] [tyTObj, tyIrr], rest := after }
    | _ => tvFail fwWire arena

-- `first e`, an option of the head (`unwrapped` = false), or `unwrap (first e)`, the head itself,
-- which refuses on nil. A cell known to be one is read; a list known to be nil has no head;
-- otherwise a case on the list.
partial def trFirst (cx : Cx) (lty : List Int) (env : List Val) (facts : List Int) (next : Nat) (e : List Int) (after : List Int) (unwrapped : Bool) : TV :=
  let dropped : List Int := if cx.arr then drE cx.g e else []
  -- first (drop K xs) with K not the literal 1: a read at an index ("The front end's loops over an array")
  if dropped.headD 0 == 27 && !fwIsOne cx (dropped.drop 1) then trGetIdiom cx lty env facts next (dropped.drop 1) after unwrapped
  else
  let a := trVal cx lty env facts next e
  if !a.ok then a
  else if a.val.kind != 0 || a.val.ts != [tyTObj] then tvFail fwType e
  else
    let elem := wtElem cx.g a.val.wt
    let et := fwFlat cx.g elem
    if elem.isEmpty || !et.ok then tvFail fwType e
    else
      let x := (intAt 0 a.val.ws).toNat
      let fact := factOf (intAt 0 a.val.ws) facts
      let wt := if unwrapped then elem else 8 :: elem
      let ts := if unwrapped then et.ts else tyI64 :: et.ts
      if fact == 1 then
        let h := headItems et.ts x a.next
        if unwrapped then { ok := true, err := none, next := h.next, items := a.items ++ h.items, val := valTyped h.ws ts wt, rest := after }
        else
          { ok := true, err := none, next := h.next + 1, items := a.items ++ h.items ++ [mkVDecl h.next tyI64 (mkLit 1) mkUnreachable],
            val := valTyped ((h.next : Int) :: h.ws) ts wt, rest := after }
      else
        -- as cells ("Arrays")
        let fx := forceItem cx.arr (intAt 0 a.val.ws) a.next
        let x := (intAt 0 fx.ws).toNat
        let j := fx.next
        let ps := freshFor ts (j + 1)
        -- the alternative of a cell
        let h := headItems et.ts x ps.next
        let one := h.next
        let consB := if unwrapped then assemble h.items (mkJmp j (liveWords h.ws et.ts))
          else assemble (h.items ++ [mkVDecl one tyI64 (mkLit 1) mkUnreachable]) (mkJmp j ((one : Int) :: liveWords h.ws et.ts))
        -- the alternative of nil: the refusal, or the absent option
        let n0 := one + 1
        let fl := if unwrapped then (if (liveTys et.ts).isEmpty then failAlways n0 else failItems n0 et.ts) else dummyItems (n0 + 1) et.ts
        let nilB := if unwrapped then assemble fl.items (mkJmp j (liveWords fl.ws et.ts))
          else assemble (mkVDecl n0 tyI64 (mkLit 0) mkUnreachable :: fl.items) (mkJmp j ((n0 : Int) :: liveWords fl.ws et.ts))
        let cs := mkCase x tyTObj [mkAltCtor nilInfo nilB, mkAltCtor (consInfo (elemShape et.ts)) consB]
        { ok := true, err := none, next := fl.next, items := a.items ++ fx.items ++ [mkSplit j (paramsOfWords ps.vars ts) cs],
          val := valTyped ps.vars ts wt, rest := after }

-- first (drop K xs), `de` the stream at K. Of an array: a read at index K, when K is an index of it (K below zero reads
-- the first, as `drop` then drops nothing). Of cells: the first of what `drop` leaves, as before. Either way the
-- answer is a flag and the element's one word (`elemWord`), which a join point takes.
partial def trGetIdiom (cx : Cx) (lty : List Int) (env : List Val) (facts : List Int) (next : Nat) (de : List Int) (after : List Int) (unwrapped : Bool) : TV :=
  let k := trVal cx [0] env facts next de
  let l := trVal cx lty env facts k.next k.rest
  let elem := wtElem cx.g l.val.wt
  let et := fwFlat cx.g elem
  if !k.ok then k
  else if !l.ok then l
  else if k.val.kind != 0 || k.val.ts != [tyI64] || l.val.kind != 0 || l.val.ts != [tyTObj] then tvFail fwType de
  else if elem.isEmpty || !et.ok then tvFail fwType de
  else
    let shape := elemShape et.ts
    let ety : Int := if shape == lsScalar then tyI64 else tyTObj
    let kw := intAt 0 k.val.ws
    let lw := intAt 0 l.val.ws
    let isA := l.next
    let je := isA + 1
    let fl := isA + 2
    let ew := isA + 3
    -- the array: its size, the index (0 for K below zero), the test, the read
    let sz := isA + 4
    let z := isA + 5
    let neg := isA + 6
    let nn := isA + 7
    let ix := isA + 8
    let inr := isA + 9
    let e1 := isA + 10
    let one1 := isA + 11
    let zero1 := isA + 12
    let d1 := isA + 13
    let none1 := if shape == lsScalar then mkVDecl zero1 tyI64 (mkLit 0) (mkJmp je [(zero1 : Int), (zero1 : Int)])
      else mkVDecl zero1 tyI64 (mkLit 0) (mkVDecl d1 tyTObj (mkCtor nilInfo []) (mkJmp je [(zero1 : Int), (d1 : Int)]))
    let some1 := mkVDecl e1 ety (mkPrim primArrGet ((shape : Nat) : Int) 0 [lw, (ix : Int)]) (mkVDecl one1 tyI64 (mkLit 1) (mkJmp je [(one1 : Int), (e1 : Int)]))
    let t5 := mkVDecl inr tyI64 (mkPrim primLt 0 0 [(ix : Int), (sz : Int)]) (mkIfW inr some1 none1)
    let t4 := mkVDecl ix tyI64 (mkPrim primMulW 0 0 [kw, (nn : Int)]) t5
    let t3 := mkVDecl nn tyI64 (mkPrim primNot 0 0 [(neg : Int)]) t4
    let t2 := mkVDecl neg tyI64 (mkPrim primLt 0 0 [kw, (z : Int)]) t3
    let arrB := mkVDecl sz tyI64 (mkPrim primArrSize 0 0 [lw]) (mkVDecl z tyI64 (mkLit 0) t2)
    -- cells: what `drop` leaves
    let dr := isA + 14
    let h2 := isA + 15
    let one2 := isA + 16
    let zero2 := isA + 17
    let d2 := isA + 18
    let none2 := if shape == lsScalar then mkVDecl zero2 tyI64 (mkLit 0) (mkJmp je [(zero2 : Int), (zero2 : Int)])
      else mkVDecl zero2 tyI64 (mkLit 0) (mkVDecl d2 tyTObj (mkCtor nilInfo []) (mkJmp je [(zero2 : Int), (d2 : Int)]))
    let head2 := if shape == lsScalar then mkSProj 1 0 dr else mkProj 0 dr
    let some2 := mkVDecl h2 ety head2 (mkVDecl one2 tyI64 (mkLit 1) (mkJmp je [(one2 : Int), (h2 : Int)]))
    let cells := mkCase dr tyTObj [mkAltCtor nilInfo none2, mkAltCtor (consInfo shape) some2]
    let listB := mkVDecl dr tyTObj (mkFap (hDrop cx.n shape) [kw, lw]) cells
    let first := mkSplit je [{ x := fl, borrow := false, ty := tyI64 }, { x := ew, borrow := false, ty := ety }] (mkIfW isA arrB listB)
    -- the element's words from its one word, under the flag
    let j := isA + 19
    let wt := if unwrapped then elem else 8 :: elem
    let ts := if unwrapped then et.ts else tyI64 :: et.ts
    let ps := freshFor ts (j + 1)
    let h := elemReads et.ts ew ps.next
    let one := h.next
    let someB := if unwrapped then assemble h.items (mkJmp j (liveWords h.ws et.ts))
      else assemble (h.items ++ [mkVDecl one tyI64 (mkLit 1) mkUnreachable]) (mkJmp j ((one : Int) :: liveWords h.ws et.ts))
    let n0 := one + 1
    let fl0 := if unwrapped then (if (liveTys et.ts).isEmpty then failAlways n0 else failItems n0 et.ts) else dummyItems (n0 + 1) et.ts
    let noneB := if unwrapped then assemble fl0.items (mkJmp j (liveWords fl0.ws et.ts))
      else assemble (mkVDecl n0 tyI64 (mkLit 0) mkUnreachable :: fl0.items) (mkJmp j ((n0 : Int) :: liveWords fl0.ws et.ts))
    let test := mkVDecl isA tyI64 (mkPrim primIsArr 0 0 [lw]) mkUnreachable
    { ok := true, err := none, next := fl0.next, items := k.items ++ l.items ++ [test, first, mkSplit j (paramsOfWords ps.vars ts) (mkIfW fl someB noneB)],
      val := valTyped ps.vars ts wt, rest := after }

-- set xs K V (`fi`), `lty` the list's type: the array of xs, written at index K when K is an index of it
partial def trSetIdiom (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (fi : FoldIdiom) (lty : List Int) (after : List Int) : TV :=
  let elemTy := wtElem cx.g lty
  let et := fwFlat cx.g elemTy
  let xs := trVal cx lty env facts next fi.xs
  let a := xs.next
  let n := a + 1
  let z := a + 2
  let e := a + 3
  let j := a + 4
  let r := a + 5
  -- K and V stand under the loop's two variables and read neither
  let inner := valAbsent :: valAbsent :: env
  let kv := trVal cx [0] inner facts (a + 6) fi.k
  let k := intAt 0 kv.val.ws
  let lo := kv.next
  let hi := lo + 1
  let nlo := lo + 2
  let inr := lo + 3
  let vv := trVal cx elemTy inner facts (lo + 4) fi.v
  let w := elemWord vv.val.ws vv.val.ts vv.next
  let s := w.next
  let shape : Int := ((elemShape et.ts : Nat) : Int)
  if elemTy.isEmpty || !et.ok then tvFail fwType fi.xs
  else if !xs.ok then xs
  else if xs.val.kind != 0 || xs.val.ts != [tyTObj] then tvFail fwType fi.xs
  else if !kv.ok then kv
  else if kv.val.kind != 0 || kv.val.ts != [tyI64] then tvFail fwType fi.k
  else if !vv.ok then vv
  else if vv.val.kind != 0 then tvFail fwNodeUse fi.v
  else
    let write := assemble (vv.items ++ w.items ++ [mkVDecl s tyTObj (mkPrim primArrSet shape 0 ([(a : Int), k] ++ w.ws)) mkUnreachable]) (mkJmp j [(s : Int)])
    let t1 := mkVDecl lo tyI64 (mkPrim primLt 0 0 [k, (z : Int)]) mkUnreachable
    let t2 := mkVDecl hi tyI64 (mkPrim primLt 0 0 [k, (n : Int)]) mkUnreachable
    let t3 := mkVDecl nlo tyI64 (mkPrim primNot 0 0 [(lo : Int)]) mkUnreachable
    let t4 := mkVDecl inr tyI64 (mkPrim primAnd 0 0 [(nlo : Int), (hi : Int)]) mkUnreachable
    let some1 := assemble (kv.items ++ [t1, t2, t3, t4]) (mkIfW inr write (mkJmp j [(a : Int)]))
    let split := mkSplit j [pT r] (mkIfW e (mkJmp j [(a : Int)]) some1)
    let i1 := mkVDecl a tyTObj (mkPrim primArrOfList shape 0 xs.val.ws) mkUnreachable
    let i2 := mkVDecl n tyI64 (mkPrim primArrSize 0 0 [(a : Int)]) mkUnreachable
    let i3 := mkVDecl z tyI64 (mkLit 0) mkUnreachable
    let i4 := mkVDecl e tyI64 (mkPrim primEq 0 0 [(n : Int), (z : Int)]) mkUnreachable
    { ok := true, err := none, next := s + 1, items := xs.items ++ [i1, i2, i3, i4, split], val := valTyped [(r : Int)] [tyTObj] lty, rest := after }

-- take S xs (`fi`), or drop A of it when `lo` holds A's word (`pre` the instructions that compute A): a slice of the array of xs
partial def trTakeIdiom (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (pre : List N) (lo : List Int) (fi : FoldIdiom) (lty : List Int) (after : List Int) : TV :=
  let elemTy := wtElem cx.g lty
  let et := fwFlat cx.g elemTy
  let xs := trVal cx lty env facts next fi.xs
  let a := xs.next
  let n := a + 1
  let z := a + 2
  let e := a + 3
  let j := a + 4
  let r := a + 5
  let inner := valAbsent :: valAbsent :: env
  let sv := trVal cx [0] inner facts (a + 6) fi.k
  let s := sv.next
  let shape : Int := ((elemShape et.ts : Nat) : Int)
  let from1 : Int := if lo.isEmpty then (z : Int) else intAt 0 lo
  if elemTy.isEmpty || !et.ok then tvFail fwType fi.xs
  else if !xs.ok then xs
  else if xs.val.kind != 0 || xs.val.ts != [tyTObj] then tvFail fwType fi.xs
  else if !sv.ok then sv
  else if sv.val.kind != 0 || sv.val.ts != [tyI64] then tvFail fwType fi.k
  else
    let cut := assemble (sv.items ++ [mkVDecl s tyTObj (mkPrim primArrSlice shape 0 [(a : Int), from1, intAt 0 sv.val.ws]) mkUnreachable]) (mkJmp j [(s : Int)])
    let split := mkSplit j [pT r] (mkIfW e (mkJmp j [(a : Int)]) cut)
    let i1 := mkVDecl a tyTObj (mkPrim primArrOfList shape 0 xs.val.ws) mkUnreachable
    let i2 := mkVDecl n tyI64 (mkPrim primArrSize 0 0 [(a : Int)]) mkUnreachable
    let i3 := mkVDecl z tyI64 (mkLit 0) mkUnreachable
    let i4 := mkVDecl e tyI64 (mkPrim primEq 0 0 [(n : Int), (z : Int)]) mkUnreachable
    { ok := true, err := none, next := s + 1, items := pre ++ xs.items ++ [i1, i2, i3, i4, split], val := valTyped [(r : Int)] [tyTObj] lty, rest := after }

-- The two alternatives of a match on a list, `lt` its test: nil, then a cell. In each the list's
-- constructor is a known fact, as a node's tag is in `trAlts`.
partial def trLenAlts (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (tail : Bool) (lt : LenTest) (j : Int) : LenR :=
  let a := trVal cx lt.ty env facts next lt.ex
  let et := fwFlat cx.g (wtElem cx.g lt.ty)
  if !a.ok then lenPass a.err lt.ex
  else if a.val.kind != 0 || a.val.ts != [tyTObj] || !et.ok then lenFail fwType lt.ex
  else
    -- The list as cells ("Arrays"). When the list is a variable, the variable is those cells in both
    -- alternatives, so a read of its head or tail there finds the fact about them.
    let fx := forceItem cx.arr (intAt 0 a.val.ws) a.next
    let x := intAt 0 fx.ws
    let env := if cx.arr then envSetWord (varOfExpr cx.g lt.ex) x env else env
    let nilB := trBranch cx want env (x :: 0 :: facts) fx.next tail lt.thenAt j
    if !nilB.ok then lenPass nilB.err lt.ex
    else
      let consB := trBranch cx want env (x :: 1 :: facts) nilB.next tail nilB.rest j
      if !consB.ok then lenPass consB.err lt.ex
      else if !tail && nilB.ts != consB.ts then lenFail fwType lt.ex
      else
        { ok := true, err := none, next := consB.next, pre := a.items ++ fx.items, x := x.toNat, ts := nilB.ts, rest := consB.rest,
          alts := [mkAltCtor nilInfo (kidAt 0 nilB.alts), mkAltCtor (consInfo (elemShape et.ts)) (kidAt 0 consB.alts)] }

-- A field of a node seen through its handle h; `a` holds the instructions so far. Where the field
-- lies is the layout's to say ("Layout"): the read is written by its field. `kidsTy` is the wire
-- type of the list of the node's children.
partial def trNodeField (cx : Cx) (facts : List Int) (a : TV) (h : Int) (i : Nat) (kidsTy : List Int) (after : List Int) : TV :=
  let t := factOf h facts
  let x := a.next
  if i == 1 then { a with val := { kind := 2, ws := [h], ts := [], wt := kidsTy }, rest := after }
  else if i == 0 then
    let e := if t >= 0 then mkLit t else mkPrim primTagOf 0 0 [h]
    { a with next := x + 1, items := a.items ++ [mkVDecl x tyI64 e mkUnreachable], val := valWords [(x : Int)] [tyI64], rest := after }
  else if i >= 2 && i <= 6 then
    { a with next := x + 1, items := a.items ++ [mkVDecl x tyI64 (mkPrim primNodeScalar ((i - 2 : Nat) : Int) 0 [h]) mkUnreachable],
             val := valWords [(x : Int)] [tyI64], rest := after }
  else if i == 7 then
    { a with next := x + 1, items := a.items ++ [mkVDecl x tyObj (mkPrim primNodeStr 0 0 [h]) mkUnreachable],
             val := valWords [(x : Int)] [tyObj], rest := after }
  else if i == 8 then
    { a with next := x + 1, items := a.items ++ [mkVDecl x tyTObj (mkPrim primNodeInts 0 0 [h]) mkUnreachable],
             val := valTyped [(x : Int)] [tyTObj] [4, 0], rest := after }
  else tvFail fwNodeV2 after

-- `call read arena h`: both arguments are evaluated, the call leaves a guard of depth 1
partial def trRead (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (args : List Int) (after : List Int) : TV :=
  match args with
  | 1 :: a0 =>
    let ar := trVal cx [] env facts next a0
    if !ar.ok then ar
    else
      match ar.rest with
      | 1 :: a1 =>
        let h := trVal cx [] env facts ar.next a1
        if !h.ok then h
        else if h.val.kind != 0 || h.val.ts != [tyTObj] || h.rest.headD 1 != 0 then tvFail fwNodeUse a1
        else { ok := true, err := none, next := h.next, items := ar.items ++ h.items ++ [mkGuard (cx.inlOn.length + 1) mkUnreachable],
               val := { kind := 1, ws := h.val.ws, ts := [] }, rest := after }
      | _ => tvFail fwWire args
  | _ => tvFail fwWire args

-- `call kid (n.f1) i` with a literal i, in place or in a variable that holds one: the child, after a
-- guard of the depth the walk needed
partial def trKid (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (args : List Int) (after : List Int) : TV :=
  match args with
  | 1 :: a0 =>
    let xs := trValV cx [] env facts next a0
    if !xs.ok then xs
    else if xs.val.kind != 2 then tvFail fwKidShape a0
    else
      match xs.rest with
      | 1 :: a1 =>
        let i := litOf cx.g env a1
        let h := intAt 0 xs.val.ws
        if i < 0 || i >= (ocListKey : Int) then tvFail fwKidShape a1
        else
          let x := xs.next
          { ok := true, err := none, next := x + 1,
            items := xs.items ++ [mkGuard (i.toNat + 1 + cx.inlOn.length) mkUnreachable,
                                  mkVDecl x tyTObj (mkPrim primNodeKid i 0 [h]) mkUnreachable],
            val := valWords [(x : Int)] [tyTObj], rest := after }
      | _ => tvFail fwWire args
  | _ => tvFail fwWire args

-- the children of an allocation's record, each a handle: 22, or 26 (23 e) rest
partial def trKids (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (rest : List Int) : TV :=
  match drE cx.g rest with
  | 22 :: _ => { ok := true, err := none, next := next, items := [], val := valNone, rest := (skipE cx.g profile.v2Fuel rest).rest }
  | 26 :: bs =>
    match drE cx.g bs with
    | 23 :: e =>
      let a := trVal cx [] env facts next e
      if !a.ok then a
      else if a.val.kind != 0 || a.val.ts != [tyTObj] then tvFail fwAllocShape e
      else
        let b := trKids cx env facts a.next a.rest
        if !b.ok then b
        else { ok := true, err := none, next := b.next, items := a.items ++ b.items,
               val := valWords (a.val.ws ++ b.val.ws) (a.val.ts ++ b.val.ts), rest := (skipE cx.g profile.v2Fuel rest).rest }
    | _ => tvFail fwAllocShape bs
  | _ => tvFail fwAllocShape rest

-- the scalar fields f2 .. f6 of an allocation's record: the word of each, the irrelevant
-- argument for one written as its literal default (0, false)
partial def trScalars (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (j : Nat) (rest : List Int) : TV :=
  if j >= 5 then { ok := true, err := none, next := next, items := [], val := valNone, rest := rest }
  else
    match drE cx.g rest with
    | 34 :: bs =>
      let nm := skipName bs
      if nm.ok != profile.cOk then tvFail fwWire bs
      else
        let dflt := if j < 3 then fwIsIntLit cx.g nm.rest 0 else fwIsFalse cx.g nm.rest
        let a := if dflt then { ok := true, err := none, next := next, items := [], val := valWords [argIrr] [tyI64],
                                rest := (skipE cx.g profile.v2Fuel nm.rest).rest }
          else trVal cx [0] env facts next nm.rest
        if !a.ok then a
        else if a.val.kind != 0 || a.val.ts != [tyI64] then tvFail fwAllocShape bs
        else
          let b := trScalars cx env facts a.next (j + 1) a.rest
          if !b.ok then b
          else { ok := true, err := none, next := b.next, items := a.items ++ b.items,
                 val := valWords (a.val.ws ++ b.val.ws) (a.val.ts ++ b.val.ts), rest := b.rest }
    | _ => tvFail fwAllocShape rest

-- `call alloc {f0 := t, f1 := kids, f2 .. f6, f7, f8} arena`: the node, written by its fields
-- (`primNodeNew`; "Layout" says where each lies). The children are a literal list of handles or
-- any list of them.
partial def trAlloc (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (args : List Int) (after : List Int) : TV :=
  match args with
  | 1 :: rec =>
    match drE cx.g (fwFieldAt cx.g 0 rec) with
    | 0 :: lit =>
      let t := readLeafI64 lit
      let f1 := fwFieldAt cx.g 1 rec
      let k := fwKidCount cx.g f1
      if t.ok != profile.cOk || !cx.tab.tags.contains t.n || f1.isEmpty then tvFail fwAllocShape rec
      else
        let kids := if k >= 0 then trKids cx env facts next f1 else trVal cx [] env facts next f1
        if !kids.ok then kids
        else if k < 0 && (kids.val.kind != 0 || kids.val.ts != [tyTObj]) then tvFail fwAllocShape rec
        else
          -- `kids.rest` is the record's rest after f1's value: the fields f2 .. f6, then f7
          let sc := trScalars cx env facts kids.next 0 kids.rest
          if !sc.ok then sc
          else
            match drE cx.g sc.rest with
            | 34 :: f7 =>
              let nm := skipName f7
              let str := if fwIsEmptyStr cx.g nm.rest then
                  { ok := true, err := none, next := sc.next, items := [], val := valWords [argIrr] [tyObj], rest := (skipE cx.g profile.v2Fuel nm.rest).rest }
                else trVal cx [2] env facts sc.next nm.rest
              if nm.ok != profile.cOk || !str.ok then tvFail fwAllocShape f7
              else if str.val.kind != 0 || str.val.ts != [tyObj] then tvFail fwAllocShape f7
              else
                -- the ninth field, when the record has one: the list of integers
                let f8 := match drE cx.g str.rest with
                  | 34 :: f => (skipName f).rest
                  | _ => []
                let ints := if f8.isEmpty || (drE cx.g f8).headD 0 == 22 then
                    { ok := true, err := none, next := str.next, items := [], val := valWords [argIrr] [tyTObj], rest := [] }
                  else trVal cx [4, 0] env facts str.next f8
                -- the record ends (33), then the arena argument
                let recAfter := (skipE cx.g profile.v2Fuel rec).rest
                if !ints.ok then ints
                else if ints.val.kind != 0 || ints.val.ts != [tyTObj] then tvFail fwAllocShape f7
                else
                match recAfter with
                | 1 :: a1 =>
                  let ar := trVal cx [] env facts ints.next a1
                  if !ar.ok then ar
                  else if ar.rest.headD 1 != 0 then tvFail fwWire a1
                  else
                    -- children given as a list are kept as cells: the layout reads a child with `drop` ("Arrays")
                    let fk := if k < 0 then forceItem cx.arr (intAt 0 kids.val.ws) ar.next else { next := ar.next, items := [], ws := kids.val.ws }
                    let x := fk.next
                    let node := mkPrim primNodeNew t.n k (sc.val.ws ++ str.val.ws ++ ints.val.ws ++ fk.ws)
                    { ok := true, err := none, next := x + 1,
                      items := kids.items ++ sc.items ++ str.items ++ ints.items ++ ar.items ++ fk.items
                        ++ [mkGuard (cx.inlOn.length + 1) mkUnreachable, mkVDecl x tyTObj node mkUnreachable],
                      val := valWords [(x : Int), argIrr] [tyTObj, tyIrr], rest := after }
                | _ => tvFail fwWire rec
            | _ => tvFail fwAllocShape rec
    | _ => tvFail fwAllocShape rec
  | _ => tvFail fwWire args

-- the arguments of a call, each a run of words, checked against the callee's parameter runs
-- (`wts`: the parameters' wire types, in step with their runs)
partial def trArgs (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) : List (List Int) → List (List Int) → List Int → TV
  | [], _, rest =>
    match rest with
    | 0 :: _ => { ok := true, err := none, next := next, items := [], val := valNone, rest := rest }
    | _ => tvFail fwCall rest
  | p :: ps, wts, rest =>
    match rest with
    | 1 :: a0 =>
      let a := trVal cx (wts.headD []) env facts next a0
      if !a.ok then a
      else if a.val.kind != 0 || a.val.ts != p then tvFail fwCall a0
      else
        let b := trArgs cx env facts a.next ps (wts.drop 1) a.rest
        if !b.ok then b
        else { ok := true, err := none, next := b.next, items := a.items ++ b.items,
               val := valWords (a.val.ws ++ b.val.ws) (a.val.ts ++ b.val.ts), rest := b.rest }
    | _ => tvFail fwCall rest

-- the arguments of a call that is translated in place, each as the value it is (a node record and
-- its children stay what they are seen through): the callee's variables, parameter 0 first.
-- `sig`: the stream at the callee's parameter types.
partial def trInArgs (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) : Nat → List Int → List Int → InArgs
  | 0, sig, rest =>
    match rest with
    | 0 :: _ => { ok := true, err := none, next := next, items := [], env := [], sig := sig }
    | _ => inArgsFail fwCall
  | k + 1, sig, rest =>
    match rest with
    | 1 :: a0 =>
      let t := readTyD cx.g sig
      if t.ok != profile.cOk then inArgsFail fwType
      else
        let a := trValV cx t.acc env facts next a0
        if !a.ok then inArgsPass a.err
        else
          let b := trInArgs cx env facts a.next k t.rest a.rest
          if !b.ok then b else { b with items := a.items ++ b.items, env := a.val :: b.env }
    | _ => inArgsFail fwCall

-- A call of a function of the image. With the node record in the callee's signature it is: the
-- arguments in order, the guard the callee's entry was, then the callee's body with the arguments
-- as its variables, one call deeper. A callee that comes back to itself this way has no translation.
partial def trCall (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (f : Nat) (args : List Int) (after : List Int) : TV :=
  let body := inlBody (f : Int) cx.inl
  if body.isEmpty then trCallFn cx env facts next f args after
  else if cx.inlOn.contains (f : Int) then tvFail fwNodeUse args
  else
    let sig := sigOf cx.sigs f
    let a := trInArgs cx env facts next (sigCount sig) (sigParams sig) args
    let rt := readTyD cx.g a.sig
    if !a.ok then tvPass a.err args
    else if rt.ok != profile.cOk then tvFail fwType args
    else
      let r := trValV { cx with inlOn := (f : Int) :: cx.inlOn } rt.acc a.env facts a.next body
      if !r.ok then r
      else { r with items := a.items ++ (mkGuard (cx.inlOn.length + 1) mkUnreachable :: r.items), rest := after }

-- a call of a function that has a translation of its own
partial def trCallFn (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (f : Nat) (args : List Int) (after : List Int) : TV :=
  let sg := fwSig cx.g (sigOf cx.sigs f)
  if !sg.ok then tvFail fwType args
  else
    let a := trArgs cx env facts next sg.params sg.ptys args
    if !a.ok then a
    else
      let live := liveWords a.val.ws a.val.ts
      -- a call without a live argument passes an irrelevant one: for Lean's RC pass an
      -- application without arguments is a constant (RC.lean:152)
      let ys := if live.isEmpty then [argIrr] else live
      let rs := freshFor sg.result a.next
      let binds := bindsOf rs.vars sg.result
      let call := mkFapAt cx.inlOn.length f ys
      match binds with
      | x :: ty :: extra =>
        { ok := true, err := none, next := rs.next, items := a.items ++ [mkVDecls x.toNat ty extra call mkUnreachable],
          val := valTyped rs.vars sg.result sg.rty, rest := after }
      | _ =>
        -- no live result word: the call still runs; its one irrelevant result is bound and unused
        { ok := true, err := none, next := rs.next + 1, items := a.items ++ [mkVDecl rs.next tyIrr call mkUnreachable],
          val := valWords rs.vars sg.result, rest := after }

-- The alternatives of a match on the node of handle `tt.h`, from the chain
--   if n.f0 == t1 then A1 else if n.f0 == t2 then A2 else ... else B.
-- `tail`: the alternatives return; otherwise each jumps to join point `j` with its value.
-- `c` is the stream at the condition of the current `if`.
partial def trAlts (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (tail : Bool) (tt : TagTest) (c : List Int)
    (seen : List Int) (j : Int) : FwAlts :=
  let next := if tail || !seen.isEmpty then next else next + 1
  let found := cx.tab.tags.contains tt.t
  -- an alternative for a tag the image never allocates is unreachable
  let a := if found then trBranch cx want env (tt.h :: tt.t :: facts) next tail tt.thenAt j
    else { ok := true, err := none, next := next, alts := [mkUnreachable], ts := [], rest := (skipE cx.g profile.v2Fuel tt.thenAt).rest }
  if !a.ok then a
  else
    let alt := mkAltCtor (nodeAlt tt.t) (kidAt 0 a.alts)
    let seen := tt.t :: seen
    -- the else branch: the same test on the same node continues the chain
    let c2 := match drE cx.g a.rest with
      | 5 :: c => c
      | _ => []
    let t2 := if c2.isEmpty then noTagTest else fwTagTest cx env c2
    if t2.h >= 0 && t2.h == tt.h then
      let r := trAlts cx want env facts a.next tail t2 c2 seen j
      if !r.ok then r else { r with alts := alt :: r.alts, ts := if found then a.ts else r.ts }
    else
      let left := tagsLeft seen cx.tab.tags
      -- one tag left: the else branch is that constructor's alternative
      let lastFacts := match left with
        | [t] => tt.h :: t :: facts
        | _ => facts
      let b := trBranch cx want env lastFacts a.next tail a.rest j
      if !b.ok then b
      else
        let last := match left with
          | [t] => mkAltCtor (nodeAlt t) (kidAt 0 b.alts)
          | _ => mkAltDefault (kidAt 0 b.alts)
        { ok := true, err := none, next := b.next, alts := [alt, last], ts := if found then a.ts else b.ts, rest := b.rest }

-- one alternative's body; `alts` of the result holds that one body
partial def trBranch (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (tail : Bool) (rest : List Int) (j : Int) : FwAlts :=
  if tail then
    let b := trTail cx env facts next rest
    { ok := b.ok, err := b.err, next := b.next, alts := [kidAt 0 b.items], ts := [], rest := b.rest }
  else
    let v := trVal cx want env facts next rest
    if !v.ok then { ok := false, err := v.err, next := 0, alts := [], ts := [], rest := rest }
    else if v.val.kind != 0 then { ok := false, err := some fwNodeUse, next := 0, alts := [], ts := [], rest := rest }
    else { ok := true, err := none, next := v.next, alts := [assemble v.items (mkJmp j.toNat (liveWords v.val.ws v.val.ts))],
           ts := v.val.ts, rest := v.rest }

-- The alternatives of a match on the sum value x: one for each summand in order, with the
-- summand's payload read from the constructor and bound as variable 0 of the alternative.
-- `brs` is the wire's list of alternatives (1 e ... 0), one for each summand (docs/GRAMMAR.md:
-- no wildcard). `k` is the summand of the first of `arms`.
partial def trArms (cx : Cx) (want : List Int) (env : List Val) (facts : List Int) (next : Nat) (tail : Bool) (tid x k : Nat)
    (arms : List (List Int)) (brs : List Int) (j : Int) : FwAlts :=
  match arms, brs with
  | [], 0 :: rest => { ok := true, err := none, next := next, alts := [], ts := [], rest := rest }
  | aty :: more, 1 :: e =>
    let ft := fwFlat cx.g aty
    if !ft.ok then { ok := false, err := some fwType, next := 0, alts := [], ts := [], rest := brs }
    else
      let info := sumInfo tid k ft.ts
      let rd := boxReads x info.size 0 0 next ft.ts
      let b := trBranch cx want (valTyped rd.ws ft.ts aty :: env) facts rd.next tail e j
      if !b.ok then b
      else
        let r := trArms cx want env facts b.next tail tid x (k + 1) more b.rest j
        if !r.ok then r
        else if !tail && !r.alts.isEmpty && r.ts != b.ts then { ok := false, err := some fwType, next := 0, alts := [], ts := [], rest := brs }
        else { ok := true, err := none, next := r.next, alts := mkAltCtor info (assemble rd.items (kidAt 0 b.alts)) :: r.alts, ts := b.ts, rest := r.rest }
  | _, _ => { ok := false, err := some fwWire, next := 0, alts := [], ts := [], rest := brs }

-- An expression in tail position: the body that computes it and returns it. The result's one
-- item is that body.
partial def trTail (cx : Cx) (env : List Val) (facts : List Int) (next : Nat) (rest0 : List Int) : TV :=
  match drE cx.g rest0 with
  | [] => tvFail fwWire []
  | tag :: bs =>
    let after := (skipE cx.g profile.v2Fuel rest0).rest
    if tag == 4 then
      let t := readTyD cx.g bs
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let v := trValV cx t.acc env facts next t.rest
        if !v.ok then v
        else
          let bound := if v.val.kind == 0 then { v.val with wt := t.acc } else v.val
          let b := trTail cx (bound :: env) facts v.next v.rest
          if !b.ok then b else { b with items := [assemble v.items (kidAt 0 b.items)], rest := after }
    else if tag == 5 && (fwLenTest cx bs).ok then
      let r := trLenAlts cx cx.rty env facts next true (fwLenTest cx bs) 0
      if !r.ok then tvPass r.err bs
      else { ok := true, err := none, next := r.next, items := [assemble r.pre (mkCase r.x tyTObj r.alts)], val := valNone, rest := after }
    else if tag == 5 then
      let tt := fwTagTest cx env bs
      if tt.h >= 0 then
        let r := trAlts cx cx.rty env facts next true tt bs [] 0
        if !r.ok then tvPass r.err bs
        else { ok := true, err := none, next := r.next, items := [mkCase tt.h.toNat tyTObj r.alts], val := valNone, rest := after }
      else
        let c := trVal cx [1] env facts next bs
        if !c.ok then c
        else if c.val.kind != 0 || c.val.ws.length != 1 then tvFail fwType bs
        else
          let a := trTail cx env facts c.next c.rest
          if !a.ok then a
          else
            let b := trTail cx env facts a.next a.rest
            if !b.ok then b
            else { ok := true, err := none, next := b.next,
                   items := [assemble c.items (mkIfW (intAt 0 c.val.ws).toNat (kidAt 0 a.items) (kidAt 0 b.items))],
                   val := valNone, rest := after }
    else if tag == 32 then
      -- match on a sum: each alternative returns
      let t := readTyD cx.g bs
      if t.ok != profile.cOk then tvFail fwWire bs
      else
        let sv := trVal cx t.acc env facts next t.rest
        if !sv.ok then sv
        else if sv.val.kind != 0 || sv.val.ts != [tyTObj] || !wtIsSum cx.g t.acc then tvFail fwType bs
        else
          let x := (intAt 0 sv.val.ws).toNat
          let r := trArms cx cx.rty env facts sv.next true (sumTid cx.g t.acc) x 0 (wtArms cx.g t.acc) sv.rest 0
          if !r.ok then tvPass r.err bs
          else
            -- a match on the empty sum has no alternative: no value reaches it
            { ok := true, err := none, next := r.next, val := valNone, rest := after,
              items := [assemble sv.items (if r.alts.isEmpty then mkUnreachable else mkCase x tyTObj r.alts)] }
    else
      let v := trVal cx cx.rty env facts next rest0
      if !v.ok then v
      else if v.val.kind != 0 then tvFail fwNodeUse bs
      else { ok := true, err := none, next := v.next, items := [assemble v.items (mkRet (retArgsOf v.val))], val := valNone, rest := v.rest }
end

/-! ## A function, and the image -/

structure ParamsR where
  next : Nat
  env : List Val
  ps : List Param
  deriving Inhabited

-- the parameters in order: parameter i is variable index i of the body (the innermost `let` is 0
-- and shifts them up), so the environment lists them first to last
-- A parameter of the wire's type Bool gets the IR type uint8 in the declaration's parameter list
-- (the value's type inside the body stays the word): lib/lrc/Pack.rsd reads it there.
def fwParams (g : Dg) : List (List Int) → List (List Int) → Nat → ParamsR
  | ts :: rest, wt :: wts, next =>
    let f := freshFor ts next
    let r := fwParams g rest wts f.next
    { next := r.next, env := valTyped f.vars ts wt :: r.env,
      ps := paramsOfWords f.vars (if tyView g wt == [1] then [tyU8] else ts) ++ r.ps }
  | _, _, next => { next := next, env := [], ps := [] }

structure FnR where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  decl : Decl
  rest : List Int
  -- the loops lifted out of the body ("Loops"), under their numbers of the moment
  lifts : List Decl := []
  deriving Inhabited

def declNone (f : Nat) : Decl := { f := f, xs := [], rets := [], body := mkUnreachable, ext := true }

-- function f, its body at `body` (after the marker byte)
def fwFn (cx : Cx) (f : Nat) (body : List Int) : FnR :=
  let after := (skipE cx.g profile.v2Fuel body).rest
  let sg := fwSig cx.g (sigOf cx.sigs f)
  if !sg.ok then { ok := false, err := some fwType, decl := declNone f, rest := after }
  else
    let ps := fwParams cx.g sg.params sg.ptys 1
    -- a function without a live parameter takes one irrelevant parameter (see trCall)
    let xs := if ps.ps.isEmpty then [{ x := ps.next, borrow := false, ty := tyIrr }] else ps.ps
    let next := if ps.ps.isEmpty then ps.next + 1 else ps.next
    let b := trTail { cx with rty := sg.rty } ps.env [] next body
    let rets := if tyView cx.g sg.rty == [1] then [tyU8] else liveTys sg.result
    if !b.ok then { ok := false, err := b.err, decl := declNone f, rest := after }
    else
      let lo := liftsOut (kidAt 0 b.items)
      { ok := true, err := none, rest := after, lifts := lo.decls,
        decl := { f := f, xs := xs, rets := (if rets.isEmpty then [tyIrr] else rets), body := lo.node, ext := false } }

/-! ## The boundary

A value that leaves through a function's public entry has the forms the wire's hosts read
(docs/OBJECT-ABI.md revision 2): a magnitude is a limb list ("Magnitudes": inside, it may be a small
number). A function whose result holds such a word gets a second function, its boundary twin: the
twin calls the function at its own fuel and puts the result in the boundary's forms. The public
entry calls the twin (lib/lrc/Emit.rsd `emitFns`); a call inside the image calls the function, so
the forms are changed once, where a value leaves, and nowhere on the way. A word that comes in may
have either form. -/

-- does a value of wire type `ty` hold a word whose form inside is not the boundary's
partial def boundNeeds (g : Dg) (arr : Bool) (ty : List Int) : Bool :=
  if isHeapHandle g ty then false
  else
    match tyView g ty with
    -- a list of an image that builds arrays may be one ("Arrays")
    | 4 :: elem => !isHeapNode g elem && (arr || boundNeeds g arr elem)
    | 8 :: t => boundNeeds g arr t
    | 7 :: _ =>
      if magField g ty >= 0 then true
      else
        let rh := wtRecHead g ty
        rh.ok && (boundNeeds g arr rh.head || boundNeeds g arr rh.tail)
    | _ => false

-- a word of each type, for a place that holds no value (the payload of an absent option)
def absentItems : List Int → Nat → ItemsR
  | [], next => { next := next, items := [], ws := [] }
  | t :: ts, next =>
    if tyIsIrr t then
      let r := absentItems ts next
      { r with ws := argIrr :: r.ws }
    else
      let r := absentItems ts (next + 1)
      let e := if tyIsScalar t then mkLit 0 else if t == tyObj then mkLitStr "" else mkCtor nilInfo []
      { next := r.next, items := mkVDecl next t e mkUnreachable :: r.items, ws := (next : Int) :: r.ws }

structure BoundR where
  ok : Bool
  next : Nat
  items : List N
  ws : List Int
  deriving Inhabited

-- `ws` are the words of a value of wire type `ty`; the result's words are the value in the boundary's forms
partial def boundItems (cx : Cx) (ty : List Int) (ws : List Int) (next : Nat) : BoundR :=
  if !boundNeeds cx.g cx.arr ty then { ok := true, next := next, items := [], ws := ws }
  else
    match tyView cx.g ty with
    | 4 :: elem =>
      -- loop xs acc = nil: the cells of acc, last first; a cell: the loop of its tail, with the cell of its head's form before acc
      let et := fwFlat cx.g elem
      -- the list as cells ("Arrays"); its elements then, when they hold a word of another form
      let fw := forceItem cx.arr (intAt 0 ws) next
      let ws := fw.ws
      let next := fw.next
      if !boundNeeds cx.g cx.arr elem then { ok := et.ok, next := next, items := fw.items, ws := ws }
      else
      let tmp := liftBase + next
      let px := next + 1
      let pacc := next + 2
      let shape := elemShape et.ts
      -- the cell that goes out holds the boundary's words of the element (an integer: its box)
      let etB := fwFlatB cx.g elem
      let shapeB := elemShape etB.ts
      let h := headItems et.ts px (next + 3)
      let e := boundItems cx elem h.ws h.next
      let tl := e.next
      let c := consItems e.ws etB.ts (pacc : Int) (tl + 1)
      let again := callItem [tyTObj] (mkFapSame tmp ((tl : Int) :: c.ws)) c.next
      let nl := again.next
      let back := nl + 1
      let step := assemble (h.items ++ e.items ++ [mkVDecl tl tyTObj (mkProj (consTail shape) px) mkUnreachable] ++ c.items ++ [again.item]) (mkRet again.vars)
      let done := mkVDecl nl tyTObj (mkCtor nilInfo []) (mkVDecl back tyTObj (mkFap (hRev cx.n shapeB) [(pacc : Int), (nl : Int)]) (mkRet [(back : Int)]))
      let loop := mkCase px tyTObj [mkAltCtor nilInfo done, mkAltCtor (consInfo shape) step]
      let z := back + 1
      let out := callItem [tyTObj] (mkFapSame tmp (ws ++ [(z : Int)])) (z + 1)
      { ok := et.ok && etB.ok && e.ok, next := out.next, ws := out.vars,
        items := fw.items ++ [liftItem next tmp [pT px, pT pacc] [tyTObj] loop, mkVDecl z tyTObj (mkCtor nilInfo []) mkUnreachable, out.item] }
    | 8 :: t =>
      -- the flag, then the payload's words, which are no value when the flag is 0 (words of their types are given then)
      let pt := fwFlatB cx.g t
      let j := next
      let ps := freshFor pt.ts (next + 1)
      let e := boundItems cx t (ws.drop 1) ps.next
      let d := absentItems pt.ts e.next
      let split := mkSplit j (paramsOfWords ps.vars pt.ts)
        (mkIfW (intAt 0 ws).toNat (assemble e.items (mkJmp j (liveWords e.ws pt.ts))) (assemble d.items (mkJmp j (liveWords d.ws pt.ts))))
      { ok := pt.ok && e.ok, next := d.next, items := [split], ws := intAt 0 ws :: ps.vars }
    | 7 :: _ =>
      if magField cx.g ty == 0 then
        { ok := true, next := next + 1, ws := [(next : Int)], items := [mkVDecl next tyTObj (mkFap (hNatDigits cx.n) ws) mkUnreachable] }
      else if magField cx.g ty == 1 then
        -- an integer's word: its sign, and its magnitude's limb list ("An integer is one word")
        { ok := ws.length == 1, next := next + 3, ws := [(next : Int), ((next + 2 : Nat) : Int)],
          items := [mkVDecl next tyI64 (mkFap (hIntSign cx.n) ws) mkUnreachable, mkVDecl (next + 1) tyTObj (mkFap (hIntMag cx.n) ws) mkUnreachable,
                    mkVDecl (next + 2) tyTObj (mkFap (hNatDigits cx.n) [((next + 1 : Nat) : Int)]) mkUnreachable] }
      else
        -- the first field, and the record of the fields after it
        let rh := wtRecHead cx.g ty
        let ft := fwFlat cx.g rh.head
        let w := ft.ts.length
        let a := boundItems cx rh.head (takeI w ws) next
        let b := boundItems cx rh.tail (ws.drop w) a.next
        { ok := rh.ok && ft.ok && a.ok && b.ok, next := b.next, items := a.items ++ b.items, ws := a.ws ++ b.ws }
    | _ => { ok := false, next := next, items := [], ws := ws }

-- The way in. `ws` are the boundary's words of a value of wire type `ty`, as a host passes them: the result's words
-- are the stage's. The two differ in an integer outside a list, which the stage holds as one word ("An integer is
-- one word"); an integer inside a list is the object a host writes, and that is one of the stage's forms.
partial def unboundItems (cx : Cx) (ty : List Int) (ws : List Int) (next : Nat) : BoundR :=
  if (fwFlatB cx.g ty).ts == (fwFlat cx.g ty).ts then { ok := true, next := next, items := [], ws := ws }
  else
    match tyView cx.g ty with
    | 8 :: t =>
      let pt := fwFlat cx.g t
      let j := next
      let ps := freshFor pt.ts (next + 1)
      let e := unboundItems cx t (ws.drop 1) ps.next
      let d := absentItems pt.ts e.next
      let split := mkSplit j (paramsOfWords ps.vars pt.ts)
        (mkIfW (intAt 0 ws).toNat (assemble e.items (mkJmp j (liveWords e.ws pt.ts))) (assemble d.items (mkJmp j (liveWords d.ws pt.ts))))
      { ok := pt.ok && e.ok, next := d.next, items := [split], ws := intAt 0 ws :: ps.vars }
    | 7 :: _ =>
      if tyView cx.g ty == intRecTy then
        { ok := ws.length == 2, next := next + 1, items := [mkVDecl next tyTObj (mkFap (hIntOf cx.n) ws) mkUnreachable], ws := [(next : Int)] }
      else
        let rh := wtRecHead cx.g ty
        let w := (fwFlatB cx.g rh.head).ts.length
        let a := unboundItems cx rh.head (takeI w ws) next
        let b := unboundItems cx rh.tail (ws.drop w) a.next
        { ok := rh.ok && a.ok && b.ok, next := b.next, items := a.items ++ b.items, ws := a.ws ++ b.ws }
    | _ => { ok := false, next := next, items := [], ws := ws }

-- the types of every parameter's words, one after the other
def runsFlat : List (List Int) → List Int
  | [] => []
  | ts :: rest => ts ++ runsFlat rest

-- every parameter of a twin, from the boundary's words to the stage's
def unboundParams (cx : Cx) : List (List Int) → List Val → Nat → BoundR
  | wt :: wts, v :: vs, next =>
    let a := unboundItems cx wt v.ws next
    let b := unboundParams cx wts vs a.next
    { ok := a.ok && b.ok, next := b.next, items := a.items ++ b.items, ws := a.ws ++ b.ws }
  | _, _, next => { ok := true, next := next, items := [], ws := [] }

-- The boundary twin of function f under the number `tmp`, with the loops it lifts before it (the
-- twin is the last); [] when f's parameters and result have the boundary's forms as they are. Its
-- parameters and its result are the boundary's words. Its variables are numbered from `from1`,
-- past those of f's declaration, so that the numbers of the moment of its loops are not those of f's.
def pubTwin (cx : Cx) (f tmp from1 : Nat) : List Decl :=
  let sg := fwSig cx.g (sigOf cx.sigs f)
  let sgB := fwSigB cx.g (sigOf cx.sigs f)
  if !sg.ok || !sgB.ok || (!boundNeeds cx.g cx.arr sg.rty && sg.params == sgB.params) then []
  else
    let ps := fwParams cx.g sgB.params sgB.ptys from1
    let xs := if ps.ps.isEmpty then [{ x := ps.next, borrow := false, ty := tyIrr }] else ps.ps
    let next := if ps.ps.isEmpty then ps.next + 1 else ps.next
    let inw := unboundParams cx sgB.ptys ps.env next
    let args := liveWords inw.ws (runsFlat sg.params)
    let call := callItem sg.result (mkFapSame f (if args.isEmpty then [argIrr] else args)) inw.next
    let nr := boundItems cx sg.rty call.vars call.next
    if !inw.ok || !nr.ok then []
    else
      let lo := liftsOut (assemble (inw.items ++ call.item :: nr.items) (mkRet (liveWords nr.ws sgB.result)))
      lo.decls ++ [{ f := tmp, xs := xs, rets := liveTys sgB.result, body := lo.node, ext := false }]

structure ImageR where
  ok : Bool
  -- the cause, when not ok
  err : Option Residue
  -- the function that refused, when not ok
  fn : Nat
  decls : List Decl
  tab : CtorTab
  -- the number of the image's functions; the stage's own list functions follow them in `decls`
  n : Nat := 0
  -- pairs (function, its boundary twin's place in `decls`) ("The boundary")
  pubs : List Int := []
  deriving Inhabited

-- every allocation of the functions that are not reserved forms
partial def fwScan (g : Dg) (intr : List Int) (tab : CtorTab) (f n : Nat) (bodies : List Int) : CtorTab :=
  if f >= n || !tab.ok then tab
  else
    match bodies with
    | 1 :: body =>
      let after := (skipE g profile.v2Fuel body).rest
      if intrKind intr f != 0 then fwScan g intr tab (f + 1) n after
      else
        let s := scanE g intr tab body
        if !s.ok then { s.tab with ok := false, err := (if s.tab.ok then some fwWire else s.tab.err) }
        else fwScan g intr s.tab (f + 1) n after
    | _ => { tab with ok := false, err := some fwWire }

-- the functions a body calls (IR/Basic.lean:210 `fap`)
mutual
partial def calleesGo (n : N) (acc : List Nat) : List Nat :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    calleesGo (bodyOf n) (if e.op == opFap then fapFn e :: acc else acc)
  else if n.op == opJDecl then calleesGo (bodyOf n) (calleesGo (jdeclBody n) acc)
  else if n.op == opCase then calleesAlts (caseAlts n) acc
  else if isTerminal n then acc
  else calleesGo (bodyOf n) acc
partial def calleesAlts : List N → List Nat → List Nat
  | [], acc => acc
  | alt :: alts, acc => calleesAlts alts (calleesGo (altBody alt) acc)
end

def declIsBody (ds : DeclTab) (f : Nat) : Bool :=
  match dtFind ds f with
  | some d => !d.ext
  | none => false

def firstNoBody (ds : DeclTab) : List Nat → Int
  | [] => -1
  | f :: fs => if declIsBody ds f then firstNoBody ds fs else (f : Int)

-- the first declaration with a body that calls a function without one: caller, callee
def badCall (all : DeclTab) : List Decl → List Int
  | [] => []
  | d :: ds =>
    if d.ext then badCall all ds
    else
      let c := firstNoBody all (calleesGo d.body [])
      if c >= 0 then [(d.f : Int), c] else badCall all ds

-- does a parameter or the result of the signature have the node record's type
partial def sigHasNode (g : Dg) : Nat → List Int → Bool
  | 0, rest => isHeapNode g (readTyD g rest).acc
  | k + 1, rest =>
    let t := readTyD g rest
    isHeapNode g t.acc || sigHasNode g k t.rest

-- the functions whose signature holds the node record and that are no reserved form, each as its
-- number and then the stream at its body (`Cx.inl`)
partial def fwInl (g : Dg) (intr : List Int) (sigs : List (List Int)) (f n : Nat) (bodies : List Int) (acc : List (List Int)) : List (List Int) :=
  if f >= n then acc
  else
    match bodies with
    | 1 :: body =>
      let after := (skipE g profile.v2Fuel body).rest
      if intrKind intr f == 0 && sigHasNode g (sigCount (sigOf sigs f)) (sigParams (sigOf sigs f)) then
        fwInl g intr sigs (f + 1) n after (((f : Int) :: body) :: acc)
      else fwInl g intr sigs (f + 1) n after acc
    | _ => acc

-- the refusal kept for function f, when one is
def errsFind (f : Nat) : List Residue → Option Residue
  | [] => none
  | e :: es => if refusalFn e == f then some e else errsFind f es

def errsAdd (f : Nat) (err : Option Residue) (errs : List Residue) : List Residue :=
  match err with
  | some e => residueAt f e :: errs
  | none => residueAt f (Residue.causeMissing 0) :: errs

-- `helpers` are the functions the reserved forms call. A function whose signature holds the node
-- record itself is kept without a body (with nodes as objects no such value exists; rsdc's prelude
-- ships one, the default record; a call of one is translated in place, `trCall`), and so is one of
-- the helpers when it refuses; its refusal goes to `errs`, at its function. Any other function that refuses refuses the image, and so does a call
-- from a translated body to a function without a body.
-- `lifted`: the loops lifted so far, in their places after the list functions.
partial def fwFns (cx : Cx) (helpers : List Nat) (f n : Nat) (bodies : List Int) (acc : List Decl) (errs : List Residue) (lifted : List Decl)
    (pubs : List Int := []) : ImageR :=
  if f >= n then
    let decls := acc.reverse ++ helperDecls cx.n ++ lifted
    match badCall (dtOfList decls) decls with
    | [caller, callee] =>
      -- the callee's own refusal when it has one, at the callee; a call of a function without a body, at the caller
      match errsFind callee.toNat errs with
      | some e => { ok := false, err := some e, fn := callee.toNat, decls := [], tab := cx.tab }
      | none => { ok := false, err := some fwCallee, fn := caller.toNat, decls := [], tab := cx.tab }
    | _ => { ok := true, err := none, fn := 0, decls := decls, tab := cx.tab, n := cx.n, pubs := pubs }
  else
    match bodies with
    | 1 :: body =>
      if intrKind cx.intr f != 0 then fwFns cx helpers (f + 1) n (skipE cx.g profile.v2Fuel body).rest (declNone f :: acc) errs lifted pubs
      -- the node record itself in the signature: no such value exists here, translated or not
      else if sigHasNode cx.g (sigCount (sigOf cx.sigs f)) (sigParams (sigOf cx.sigs f)) then
        fwFns cx helpers (f + 1) n (skipE cx.g profile.v2Fuel body).rest (declNone f :: acc) (residueAt f fwNodeUse :: errs) lifted pubs
      else
        let r := fwFn cx f body
        if r.ok then
          -- one of the front end's integer operations gets its short form; the function as written follows the lifted loops
          let op := factOf (f : Int) cx.mag
          let tmp := liftBase + declMaxIndex r.decl + 1
          let w := if op >= 0 && (op % 100 < 20 || op == 30 || op == 31) then magWrap op r.decl tmp else { ok := false, body := r.decl.body }
          let lifts := if w.ok then r.lifts ++ [{ r.decl with f := tmp }] else r.lifts
          -- the boundary twin, when the result's forms inside are not the boundary's ("The boundary")
          let twin := pubTwin cx f (tmp + 1) (declMaxIndex r.decl + 3)
          let lifts := lifts ++ twin
          let m := liftPlaces (cx.n + helperCount + lifted.length) lifts
          let pubs := if twin.isEmpty then pubs else (f : Int) :: varMapFind ((tmp + 1 : Nat) : Int) m :: pubs
          fwFns cx helpers (f + 1) n r.rest ({ r.decl with body := liftRenum m w.body } :: acc) errs (lifted ++ liftPlaced m lifts) pubs
        else if helpers.contains f then
          fwFns cx helpers (f + 1) n r.rest (declNone f :: acc) (errsAdd f r.err errs) lifted pubs
        else { ok := false, err := r.err, fn := f, decls := [], tab := cx.tab }
    | _ => { ok := false, err := some fwWire, fn := f, decls := [], tab := cx.tab }

/-! ## Layout

A node of the image is an object of its constructor (lean.h `lean_ctor_object`). The translation
writes a node's allocation and every read of a node without saying where a field lies
(lib/lrc/Prim.rsd `primNodeNew`, `primNodeKid`, `primNodeKids`, `primNodeScalar`, `primNodeStr`,
`primNodeInts`): rsdc numbers the constructors inside each inductive type and the node record
carries only that number, so the nodes of one tag may be of several source types with different
fields. Here each class of objects (lib/lrc/Classes.rsd) gets, for each of its tags, the layout
its own allocations need:
  - the string f7, when some allocation of the class and tag gives one that is not the literal "";
  - the children: as many object fields as the longest literal list of children; or, when some
    allocation gives a list that is not a literal or some read takes the children as a list, one
    object field that holds the list (a literal list of children is then built as a list);
  - the list of integers f8, when some allocation gives one that is not the literal `[]`;
  - the scalar fields f2 .. f6 that some allocation sets to something other than the literal
    default, 8 bytes each in the scalar area.
A class and tag whose allocations store nothing is a constant constructor: its value is the boxed
tag (lean.h `lean_box`). A field the layout does not store reads as its default. An allocation
with fewer children than the layout has fills the rest with a word no child is (the boxed scalar
255: a tag is at most 244), and a read of a child that may be such a word, or of a child no
allocation has, refuses as the wire's `kid` does on a list that is too short (`unwrap` of an
absent first element).

A read's constructor is the tag known at the read, or the one tag its node's class leaves when
the tags tested before the read are taken away. A read whose class leaves no tag stands where no
object arrives. A read left with several tags refuses the image. When nothing may be concluded
from the classes (`Oc.bad`) the image is one class with all of the image's tags. -/

def rsExcluded (h : Int) : List Int → List Int
  | x :: t :: rest => if x == h then t :: rsExcluded h rest else rsExcluded h rest
  | _ => []

def rsMinus : List Int → List Int → List Int
  | [], _ => []
  | t :: ts, out => if out.contains t then rsMinus ts out else t :: rsMinus ts out

-- the node tags the constructor alternatives of a case test
def rsAltTags : List N → List Int
  | [] => []
  | alt :: alts => (if alt.op == opAltCtor && (infoOf alt).tid == 1 then [((infoOf alt).cidx : Int)] else []) ++ rsAltTags alts

def rsPairs (h : Int) : List Int → List Int
  | [] => []
  | t :: ts => h :: t :: rsPairs h ts

def isNodeNew (e : N) : Bool := e.op == opPrim && primOp e == primNodeNew
def isNodeRead (e : N) : Bool :=
  e.op == opPrim && (primOp e == primNodeKid || primOp e == primNodeKids || primOp e == primNodeScalar || primOp e == primNodeStr
    || primOp e == primNodeInts)

def relOfMask (m : Int) : List Int := [m % 2, (m / 2) % 2, (m / 4) % 2, (m / 8) % 2, (m / 16) % 2]

def relCount : List Int → Nat
  | [] => 0
  | r :: rs => (if r == 1 then 1 else 0) + relCount rs

-- the byte offset of scalar field j (0 for f2 .. 4 for f6) in the scalar area, or -1 when not stored
def relOffGo : Nat → Nat → List Int → Int
  | _, _, [] => -1
  | 0, off, r :: _ => if r == 1 then (off : Int) else -1
  | j + 1, off, r :: rs => relOffGo j (if r == 1 then off + 8 else off) rs

-- bit j is set when word j of the first n is a variable
def nnMask : Nat → List Int → Int
  | 0, _ => 0
  | _, [] => 0
  | n + 1, y :: ys => (if y >= 0 then 1 else 0) + 2 * nnMask n ys

-- the flag of a form of "Numbers in nodes"
def numBit (form : Int) : Int := if form == 1 then 1024 else if form == 2 then 2048 else if form == 3 then 4096 else 8192
def layRawNew : Int := 256
def layRawInts : Int := 512
-- the tag under which a class is marked: its nodes are told apart by their tag somewhere (a match on the tag,
-- a read of the tag)
def layMarkTag : Int := 255

-- what an allocation asks of its layout: 1 the string, 2 the list of integers, 4 a list of
-- children, 8 times the scalar fields it sets (bit j for f2 + j); 256 that it is an allocation as
-- the wire has it. An allocation of a number's node asks for the place of f8 and names its form.
def nnFlags (e : N) : Int :=
  if numForm e != 0 then 2 + numBit (numForm e)
  else layRawNew + (if intAt 5 e.ys >= 0 then 1 else 0) + (if intAt 6 e.ys >= 0 then 2 else 0) + (if e.c < 0 then 4 else 0) + 8 * nnMask 5 e.ys

-- what a read enters: 4 the children as a list; 512 f8 as the wire's list, or the form the place
-- reads f8 in; 16384 f2 as the wire's scalar. 0 for a read that enters nothing.
def nrFlags (e : N) : Int :=
  if e.op != opPrim then 0
  else if primOp e == primNodeKids then 4
  else if primOp e == primNodeInts then (if numForm e != 0 then numBit (numForm e) else layRawInts)
  else 0

def bitsOr : Nat → Int → Int → Int
  | 0, _, _ => 0
  | n + 1, a, b => (if a % 2 == 1 || b % 2 == 1 then 1 else 0) + 2 * bitsOr n (a / 2) (b / 2)

-- the layout of one class and tag
structure Lay where
  -- some allocation of the class has the tag
  found : Bool
  -- the longest and the shortest literal list of children
  kids : Nat
  minKids : Nat
  str : Bool
  ints : Bool
  -- the children are held as a list
  list : Bool
  -- for f2 .. f6: 1 when stored
  rel : List Int
  -- the form in which f8 holds a number or a list of numbers ("Numbers in nodes"): every
  -- allocation of the class and tag is of this form, and every read of f8 too. 0: f8 is the wire's list.
  num : Int := 0
  -- The node is the number's word itself, or the list itself, and no object: `num` is not 0, no read takes the
  -- node's children as a list, and its class is not marked (`layMarkTag`), so nothing asks one of its nodes for
  -- a tag. Lean has the rule for a structure with one
  -- constructor and one field that is no proof or type: the structure is its field
  -- (Lean/Compiler/LCNF/MonoTypes.lean:44 `hasTrivialStructure?`). An allocation is then its number, and a
  -- read of the number is the node.
  box : Bool := false
  deriving Inhabited

-- The layouts, in a map from class and tag: the entry's value is the longest literal list of
-- children, `sa` the flags (`nnFlags`, `nrFlags`), `sb` the shortest literal list, and its list holds the
-- number of allocations entered.
def layKey (root : Nat) (t : Int) : Int := (root : Int) * 256 + t

def layOf (m : Map) (root : Nat) (t : Int) : Lay :=
  let hit := mapNode m (layKey root t)
  if hit.tag == 0 || intAt 0 hit.extra == 0 then
    { found := false, kids := 0, minKids := 0, str := false, ints := false, list := false, rel := [0, 0, 0, 0, 0] }
  else
    let forms := hit.sa / 1024 % 16
    let one : Int := if forms == 1 then 1 else if forms == 2 then 2 else if forms == 4 then 3 else if forms == 8 then 4 else 0
    let num : Int := if hit.sa / layRawNew % 4 != 0 then 0 else one
    let marked := (mapNode m (layKey root layMarkTag)).tag != 0
    -- with `num` every allocation of the class and tag is a number's: no child, no string, no scalar is stored
    { found := true, kids := hit.val.toNat, minKids := hit.sb.toNat, str := hit.sa % 2 == 1, ints := hit.sa / 2 % 2 == 1,
      list := hit.sa / 4 % 2 == 1, rel := relOfMask (hit.sa / 8), num := num, box := num != 0 && hit.sa / 4 % 2 == 0 && !marked }

-- one allocation with k children (`site`; k = -1 for a list), or one read of the children as a list, entered
def layAdd (m : Map) (root : Nat) (t : Int) (site : Bool) (k : Int) (flags : Int) : Map :=
  let hit := mapNode m (layKey root t)
  let has := hit.tag != 0
  let kids0 : Int := if has then hit.val else 0
  let min0 : Int := if has then hit.sb else 1000000
  let count : Int := if has then intAt 0 hit.extra else 0
  mapPut m (layKey root t) (if k > kids0 then k else kids0) (bitsOr 15 (if has then hit.sa else 0) flags)
    (if site && k >= 0 && k < min0 then k else min0) [count + (if site then 1 else 0)]

-- the class of `root` marked (`layMarkTag`)
def layMark (m : Map) (root : Nat) : Map :=
  if (mapNode m (layKey root layMarkTag)).tag != 0 then m else mapPut m (layKey root layMarkTag) 0 0 0 [0]

-- the object fields of a layout in order: the string, the children, the list of integers, the list of children
def layChild (l : Lay) (i : Nat) : Nat := (if l.str then 1 else 0) + i
def layIntsIdx (l : Lay) : Nat := (if l.str then 1 else 0) + (if l.list then 0 else l.kids)
def layListIdx (l : Lay) : Nat := layIntsIdx l + (if l.ints then 1 else 0)
def layConst (l : Lay) : Bool := l.kids == 0 && !l.list && !l.str && !l.ints && relCount l.rel == 0

-- the constructor of tag t under layout l; tid 1 is "a node of this image"
def layInfo (l : Lay) (t : Int) : CtorInfo :=
  if !l.found || layConst l then nodeAlt t
  else { cidx := t.toNat, size := layListIdx l + (if l.list then 1 else 0), ssize := 8 * relCount l.rel, tid := 1 }

-- the word that fills the place of a child an allocation does not have
def padInfo : CtorInfo := { cidx := 255, size := 0, ssize := 0, tid := 1 }

structure LayCx where
  cl : Oc
  -- the image's tags
  tags : List Int
  m : Map
  nImg : Nat
  -- the image's functions that pack and unpack numbers (pairs function, operation: `magFind`)
  mag : List Int := []
  deriving Inhabited

def layRoot (lx : LayCx) (f : Nat) (x : Int) : Nat := if lx.cl.bad || x < 0 then 0 else ocFind lx.cl (ocVar f x.toNat)

-- The tag of node h at a read: known from an alternative, or the one candidate of its class. -1
-- when the class leaves several. -2 when it leaves none: no constructor of the image builds an
-- object that reaches this place with a tag not yet tested, so the place is never reached with one.
def layTagOf (lx : LayCx) (f : Nat) (known excl : List Int) (h : Int) : Int :=
  let k := factOf h known
  if k >= 0 then k
  else if h < 0 then -1
  else
    match rsMinus (if lx.cl.bad then lx.tags else ocTagsOf lx.cl f h.toNat) (rsExcluded h excl) with
    | [t] => t
    | [] => -2
    | _ => -1

mutual
-- every allocation and every read of the children as a list, entered into the layouts
partial def layScan (lx : LayCx) (f : Nat) (known excl : List Int) (m : Map) (n : N) : Map :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let h := intAt 0 e.ys
    let rd := nrFlags e
    let t := if rd != 0 then layTagOf lx f known excl h else -1
    let m1 := if isNodeNew e then layAdd m (layRoot lx f (vdeclVar n : Int)) e.b true e.c (nnFlags e)
      else if t >= 0 then layAdd m (layRoot lx f h) t false (-1) rd
      -- a read of the tag: the class is marked (a read of f8 that finds no single tag refuses the image, `layGo`)
      else if e.op == opPrim && primOp e == primTagOf then layMark m (layRoot lx f h)
      else m
    layScan lx f known excl m1 (bodyOf n)
  else if n.op == opJDecl then layScan lx f known excl (layScan lx f known excl m (jdeclBody n)) (bodyOf n)
  else if n.op == opCase then
    -- a match on a node's tag marks the node's class
    let tested := rsAltTags (caseAlts n)
    let m1 := if tested.isEmpty then m else layMark m (layRoot lx f (caseVar n : Int))
    layScanAlts lx f known excl (caseVar n : Int) tested (caseAlts n) m1
  else if isTerminal n then m
  else layScan lx f known excl m (bodyOf n)
-- `tested`: the node tags the case's constructor alternatives test
partial def layScanAlts (lx : LayCx) (f : Nat) (known excl : List Int) (h : Int) (tested : List Int) : List N → Map → Map
  | [], m => m
  | alt :: alts, m =>
    let left := layTagOf lx f [] (rsPairs h tested ++ excl) h
    let m1 := if alt.op == opAltCtor && (infoOf alt).tid == 1 then layScan lx f (h :: ((infoOf alt).cidx : Int) :: known) excl m (altBody alt)
      else if alt.op == opAltDefault && !tested.isEmpty && left >= 0 then layScan lx f (h :: left :: known) excl m (altBody alt)
      else if alt.op == opAltDefault && !tested.isEmpty then layScan lx f known (rsPairs h tested ++ excl) m (altBody alt)
      else layScan lx f known excl m (altBody alt)
    layScanAlts lx f known excl h tested alts m1
end

def layScanDecls (lx : LayCx) : List Decl → Map → Map
  | [], m => m
  | d :: ds, m => layScanDecls lx ds (if d.ext then m else layScan lx d.f [] [] m d.body)

-- the cells of a literal list of children, the last child first; `tl` is the list behind them
def layCells : List Int → Int → Nat → ItemsR
  | [], tl, next => { next := next, items := [], ws := [tl] }
  | y :: ys, tl, next =>
    let r := layCells ys (next : Int) (next + 1)
    { next := r.next, items := mkVDecl next tyTObj (mkCtor (consInfo lsObject) [y, tl]) mkUnreachable :: r.items, ws := r.ws }

def padWords : Nat → Int → List Int
  | 0, _ => []
  | n + 1, p => p :: padWords n p

-- the writes of the stored scalar fields of node x (`size` object fields): `ws` are the words of
-- the fields from f2 + j on; a field written as its default is written as 0
def laySSets (l : Lay) (x size : Nat) : Nat → List Int → Nat → ItemsR
  | _, [], next => { next := next, items := [], ws := [] }
  | j, w :: ws, next =>
    let off := relOffGo j 0 l.rel
    if off < 0 then laySSets l x size (j + 1) ws next
    else if w >= 0 then
      let r := laySSets l x size (j + 1) ws next
      { r with items := mkSSet x size off.toNat w.toNat tyI64 mkUnreachable :: r.items }
    else
      let r := laySSets l x size (j + 1) ws (next + 1)
      { r with items := mkVDecl next tyI64 (mkLit 0) mkUnreachable :: mkSSet x size off.toNat next tyI64 mkUnreachable :: r.items }

-- the allocation `e` of node x under layout l: its instructions, x's declaration among them
def layNew (l : Lay) (x : Nat) (e : N) (next : Nat) : ItemsR :=
  if layConst l then { next := next, items := [mkVDecl x tyTObj (mkCtor (nodeAlt e.b) []) mkUnreachable], ws := [] }
  else
    let kids := e.ys.drop 7
    let sv := intAt 5 e.ys
    let iv := intAt 6 e.ys
    -- the string and the list of integers the layout stores and this allocation leaves at their defaults
    let strI := if l.str && sv < 0 then [mkVDecl next tyObj (mkLitStr "") mkUnreachable] else []
    let strW : List Int := if !l.str then [] else if sv < 0 then [(next : Int)] else [sv]
    let n1 := next + strI.length
    let intsI := if l.ints && iv < 0 then [mkVDecl n1 tyTObj (mkCtor nilInfo []) mkUnreachable] else []
    let intsW : List Int := if !l.ints then [] else if iv < 0 then [(n1 : Int)] else [iv]
    let n2 := n1 + intsI.length
    -- the children: a list built of a literal one, or the fields with the places left over filled
    let built := l.list && e.c >= 0
    let short := !l.list && kids.length < l.kids
    let cells := if built then layCells kids.reverse (n2 : Int) (n2 + 1) else { next := n2, items := [], ws := [] }
    let kidI := if built then mkVDecl n2 tyTObj (mkCtor nilInfo []) mkUnreachable :: cells.items
      else if short then [mkVDecl n2 tyTObj (mkCtor padInfo []) mkUnreachable] else []
    let n3 := if built then cells.next else n2 + kidI.length
    let kidW : List Int := if built then cells.ws else if l.list then kids else kids ++ padWords (l.kids - kids.length) (n2 : Int)
    let info := layInfo l e.b
    let objs := strW ++ (if l.list then [] else kidW) ++ intsW ++ (if l.list then kidW else [])
    let ss := laySSets l x info.size 0 (takeI 5 e.ys) n3
    { next := ss.next, items := strI ++ intsI ++ kidI ++ [mkVDecl x tyTObj (mkCtor info objs) mkUnreachable] ++ ss.items, ws := [] }

structure NumNew where
  next : Nat
  items : List N
  e : N
  deriving Inhabited

-- The allocation `e` of a number's node as the image wrote it ("Numbers in nodes"): the list of the
-- one number, or the list of numbers, packed by the image's function; then the wire's allocation.
def layNumNew (mag : List Int) (e : N) (next : Nat) : NumNew :=
  let form := numForm e
  let v := intAt 6 e.ys
  let pack := numFn (if form == 1 || form == 3 then numPackNat else numPackInt) mag
  -- a natural number and an integer are one word each: the cell of the one, nil behind it
  let cell := if form <= 2 then consItems [v] [tyTObj] (next : Int) (next + 1) else { next := next, items := [], ws := [v] }
  let pre := if form <= 2 then mkVDecl next tyTObj (mkCtor nilInfo []) mkUnreachable :: cell.items else []
  let ws := cell.next
  { next := ws + 1, items := pre ++ [mkVDecl ws tyTObj (mkFapAt (numDepth e) pack.toNat cell.ws) mkUnreachable],
    e := { e with d := 0, ys := [argIrr, argIrr, argIrr, argIrr, argIrr, argIrr, (ws : Int)] } }

-- a word of the read's type for a place no object reaches
def layDummy (e : N) : N :=
  if primOp e == primNodeScalar then mkLit 0 else if primOp e == primNodeStr then mkLitStr "" else mkCtor nilInfo []

-- the read `e` of node h of tag t under layout l, where one expression says it
def layRead (l : Lay) (t : Int) (e : N) (h : Nat) : N :=
  let p := primOp e
  let i := e.b.toNat
  let off := relOffGo i 0 l.rel
  if p == primNodeKid then (if layConst l || i >= l.kids then mkPrim primFail 0 0 [argIrr] else mkProj (layChild l i) h)
  else if p == primNodeKids then (if l.list then mkProj (layListIdx l) h else mkCtor nilInfo [])
  else if p == primNodeScalar then (if layConst l || off < 0 then mkLit 0 else mkSProj (layInfo l t).size off.toNat h)
  else if p == primNodeInts then (if layConst l || !l.ints then mkCtor nilInfo [] else mkProj (layIntsIdx l) h)
  else (if layConst l || !l.str then mkLitStr "" else mkProj 0 h)

structure LyR where
  ok : Bool
  next : Nat
  node : N
  deriving Inhabited

structure LyAlts where
  ok : Bool
  next : Nat
  alts : List N
  deriving Inhabited

mutual
-- every node of a body laid out; `next` is the first variable not in use
partial def layGo (lx : LayCx) (f : Nat) (known excl : List Int) (next : Nat) (n : N) : LyR :=
  if n.op == opVDecl && isNodeNew (vdeclExpr n) then
    let e := vdeclExpr n
    let l := layOf lx.m (layRoot lx f (vdeclVar n : Int)) e.b
    if l.box && numForm e == l.num then
      -- the node is its number (`Lay.box`): no allocation
      let k := layGo lx f known excl next (bodyOf n)
      { ok := k.ok, next := k.next, node := replaceVar (vdeclVar n) (intAt 6 e.ys).toNat k.node }
    else
    -- a number's node in a class that does not keep the number: as the image wrote it
    let w := if numForm e != 0 && l.num != numForm e then layNumNew lx.mag e next else { next := next, items := [], e := { e with d := 0 } }
    let r := layNew l (vdeclVar n) w.e w.next
    let k := layGo lx f known excl r.next (bodyOf n)
    { ok := k.ok, next := k.next, node := assemble (w.items ++ r.items) k.node }
  else if n.op == opVDecl && isNodeRead (vdeclExpr n) && numForm (vdeclExpr n) != 0 then
    -- a number or a list of numbers read from its node ("Numbers in nodes")
    let e := vdeclExpr n
    let x := vdeclVar n
    let h := intAt 0 e.ys
    let t := layTagOf lx f known excl h
    let l := layOf lx.m (layRoot lx f h) t
    let form := numForm e
    let plain := { e with d := 0 }
    let depth := numDepth e
    if t == -1 then { ok := false, next := next, node := n }
    else if t == -2 || !l.found then
      let k := layGo lx f known excl next (bodyOf n)
      { ok := k.ok, next := k.next, node := { n with kids := [layDummy plain, k.node] } }
    else if l.num == form && l.box then
      -- the node is the number (`Lay.box`): no read
      let k := layGo lx f known excl next (bodyOf n)
      { ok := k.ok, next := k.next, node := replaceVar x h.toNat k.node }
    else if l.num == form then
      -- the class keeps the number or the list where f8 stands
      let k := layGo lx f known excl next (bodyOf n)
      { ok := k.ok, next := k.next, node := { n with kids := [layRead l t plain h.toNat, k.node] } }
    else
      -- as the image wrote it: f8 unpacked by the image's function, and the first number of it for the two forms of one number
      let words := layRead l t (mkPrim primNodeInts 0 0 [h]) h.toNat
      let unpack := numFn (if form == 1 || form == 3 then numUnpackNat else numUnpackInt) lx.mag
      let first := e.c - 1
      let ws := next
      let xs := next + 1
      let k := layGo lx f known excl (next + 2) (bodyOf n)
      (
        let last := if form <= 2 then mkVDecl xs tyTObj (mkFapAt depth unpack.toNat [(ws : Int)]) (mkVDecl x tyTObj (mkFapAt depth first.toNat [(xs : Int)]) k.node)
          else mkVDecl x tyTObj (mkFapAt depth unpack.toNat [(ws : Int)]) k.node
        { ok := k.ok, next := k.next, node := mkVDecl ws tyTObj words last })
  else if n.op == opVDecl && isNodeRead (vdeclExpr n) then
    let e := vdeclExpr n
    let x := vdeclVar n
    let h := intAt 0 e.ys
    let t := layTagOf lx f known excl h
    let l := layOf lx.m (layRoot lx f h) t
    let dead := t == -2 || !l.found
    let i := e.b.toNat
    let k := layGo lx f known excl (next + 6) (bodyOf n)
    if t == -1 then { ok := false, next := next, node := n }
    else if dead then { ok := k.ok, next := k.next, node := { n with kids := [layDummy e, k.node] } }
    else if primOp e == primNodeKid && l.list then
      -- child i of a list of children: the first of what `drop i` leaves, the refusal when it leaves nothing
      let cs := mkCase (next + 2) tyTObj
        [mkAltCtor nilInfo (mkVDecl (next + 4) tyTObj (mkPrim primFail 0 0 [argIrr]) (mkJmp (next + 3) [((next + 4 : Nat) : Int)])),
         mkAltCtor (consInfo lsObject) (mkVDecl (next + 5) tyTObj (mkProj 0 (next + 2)) (mkJmp (next + 3) [((next + 5 : Nat) : Int)]))]
      { ok := k.ok, next := k.next,
        node := mkVDecl next tyTObj (mkProj (layListIdx l) h.toNat) (mkVDecl (next + 1) tyI64 (mkLit e.b)
          (mkVDecl (next + 2) tyTObj (mkFap (hDrop lx.nImg lsObject) [((next + 1 : Nat) : Int), (next : Int)]) (mkJDecl (next + 3) [pT x] k.node cs))) }
    else if primOp e == primNodeKid && !layConst l && i < l.kids && i >= l.minKids then
      -- a child some allocation of the class does not have: the refusal on the word that fills its place
      let cs := mkCase x tyTObj [mkAltCtor padInfo (mkVDecl next tyI64 (mkPrim primFail 0 0 [argIrr]) mkUnreachable), mkAltDefault k.node]
      { ok := k.ok, next := k.next, node := { n with kids := [mkProj (layChild l i) h.toNat, cs] } }
    else { ok := k.ok, next := k.next, node := { n with kids := [layRead l t e h.toNat, k.node] } }
  else if n.op == opJDecl then
    let v := layGo lx f known excl next (jdeclBody n)
    let k := layGo lx f known excl v.next (bodyOf n)
    { ok := v.ok && k.ok, next := k.next, node := { n with kids := [v.node, k.node] } }
  else if n.op == opCase then
    let r := layAlts lx f known excl next (caseVar n : Int) (rsAltTags (caseAlts n)) (caseAlts n)
    { ok := r.ok, next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { ok := true, next := next, node := n }
  else
    let k := layGo lx f known excl next (bodyOf n)
    { ok := k.ok, next := k.next, node := setBody n k.node }
-- `tested`: the node tags the case's constructor alternatives test
partial def layAlts (lx : LayCx) (f : Nat) (known excl : List Int) (next : Nat) (h : Int) (tested : List Int) : List N → LyAlts
  | [] => { ok := true, next := next, alts := [] }
  | alt :: alts =>
    -- the alternative left over: the one tag of the class that was not tested, when there is one
    let left := layTagOf lx f [] (rsPairs h tested ++ excl) h
    let t : Int := if alt.op == opAltCtor && (infoOf alt).tid == 1 then ((infoOf alt).cidx : Int)
      else if alt.op == opAltDefault && !tested.isEmpty && left >= 0 then left else -1
    let b := if t >= 0 then layGo lx f (h :: t :: known) excl next (altBody alt)
      else if alt.op == opAltDefault && !tested.isEmpty then layGo lx f known (rsPairs h tested ++ excl) next (altBody alt)
      else layGo lx f known excl next (altBody alt)
    let rest := layAlts lx f known excl b.next h tested alts
    { ok := b.ok && rest.ok, next := rest.next,
      alts := (if t >= 0 then mkAltCtor (layInfo (layOf lx.m (layRoot lx f h) t) t) b.node else altSetBody alt b.node) :: rest.alts }
end

structure RsDecls where
  ok : Bool
  -- the first function with a read that no tag decides, when not ok
  fn : Nat
  decls : List Decl
  deriving Inhabited

def layDecls (lx : LayCx) : List Decl → RsDecls
  | [] => { ok := true, fn := 0, decls := [] }
  | d :: ds =>
    let b := if d.ext then { ok := true, next := 0, node := d.body } else layGo lx d.f [] [] (declMaxIndex d + 1) d.body
    if !b.ok then { ok := false, fn := d.f, decls := [] }
    else
      let r := layDecls lx ds
      { r with decls := { d with body := b.node } :: r.decls }

-- does any body hold a node
mutual
partial def layAny (n : N) : Bool :=
  if n.op == opVDecl then isNodeNew (vdeclExpr n) || isNodeRead (vdeclExpr n) || layAny (bodyOf n)
  else if n.op == opJDecl then layAny (jdeclBody n) || layAny (bodyOf n)
  else if n.op == opCase then layAnyAlts (caseAlts n)
  else if isTerminal n then false
  else layAny (bodyOf n)
partial def layAnyAlts : List N → Bool
  | [] => false
  | alt :: alts => layAny (altBody alt) || layAnyAlts alts
end

def layAnyDecl : List Decl → Bool
  | [] => false
  | d :: ds => (!d.ext && layAny d.body) || layAnyDecl ds

-- The image's functions as IR declarations, in order. A reserved form (alloc, read, kid) has no
-- body here (`ext`): nothing calls it once the forms are IR. `intr` gives each function's kind
-- (rsc/rsc.rsd `intrinsicKinds`: 3 alloc, 4 read, 5 kid, 0 otherwise), `bodies` the body stream.
-- `oneClass`: lay the image out as one class whatever the classes say (the host check runs every
-- image that way too: it is the layout of an image whose classes say nothing).
-- `plain`: the front end's integer operations as the image wrote them, with no short form ("Magnitudes"):
-- the host check compares the two.
def fromWireWith (oneClass plain : Bool) (g : Dg) (intr : List Int) (sigs : List (List Int)) (n : Nat) (bodies : List Int) (arrays : Bool := true) : ImageR :=
  let tab := fwScan g intr ctEmpty 0 n bodies
  if !tab.ok then { ok := false, err := tab.err, fn := 0, decls := [], tab := tab }
  else
    let reserved := reservedFns intr 0
    let helpers := (calledClosure g bodies reserved reserved).filter (fun f => !reserved.contains f)
    let cx : Cx := { g := g, intr := intr, sigs := sigs, tab := tab, n := n, inl := fwInl g intr sigs 0 n bodies [],
                     mag := if plain then [] else magFind g sigs n bodies intr, arr := arrays && arrAny g intr 0 n bodies }
    let cx := { cx with num := numFn numUnpackNat cx.mag >= 0 || numFn numUnpackInt cx.mag >= 0 || numFn numHold cx.mag >= 0 }
    let im := fwFns cx helpers 0 n bodies [] [] []
    -- an image without a node is as it was written; the classes are found only for one that has some
    if !im.ok || !layAnyDecl im.decls then im
    else
      let cl := classesOf n im.decls
      let lx : LayCx := { cl := { cl with bad := cl.bad || oneClass }, tags := tab.tags, m := map0 0, nImg := n, mag := cx.mag }
      let r := layDecls { lx with m := layScanDecls lx im.decls (map0 0) } im.decls
      if r.ok then { im with decls := r.decls }
      else { ok := false, err := some fwKidShape, fn := (if r.fn < n then r.fn else 0), decls := [], tab := tab }

def fromWire (g : Dg) (intr : List Int) (sigs : List (List Int)) (n : Nat) (bodies : List Int) : ImageR :=
  fromWireWith false false g intr sigs n bodies

/-! ## The gate (NF-0)

The stage's admission of an image is one function, `admit`, on the class of a request. A request is
what rsc hands the stage. Its class keeps what the stage reads: of the type context the nodes and
their index, and not the image's fact tables nor the census of node uses (lib/RscBase.rsd `Dg`:
`ranges`, `certs`, `nodeUse`). The present lowering reads those; the stage finds its own ranges
(lib/lrc/Range.rsd). Two requests that differ only there are one class, and the translation and the
emitter are given the class's context, so they cannot read what the class leaves out.
`oneClass` is the host check's second layout of an image (`fromWireWith`), and `plainInts` its
translation without the short forms of the integer operations; rsc asks with false for both. -/

structure Request where
  types : Dg
  -- each function's kind (rsc/rsc.rsd `intrinsicKinds`), the signatures, the number of functions, the body stream
  intr : List Int
  sigs : List (List Int)
  n : Nat
  bodies : List Int
  oneClass : Bool := false
  plainInts : Bool := false
  -- may a list be an array ("Arrays"): asked for where the module has the stage's own heap
  arrays : Bool := true

structure Class where
  types : Dg
  intr : List Int
  sigs : List (List Int)
  n : Nat
  bodies : List Int
  oneClass : Bool
  plainInts : Bool
  arrays : Bool

-- what is admitted: the image's functions as IR declarations, the stage's own list functions after
-- them; `n` is the number of the image's functions
structure Translated where
  decls : List Decl
  tab : CtorTab
  n : Nat
  -- pairs (function, its boundary twin's place in `decls`) ("The boundary")
  pubs : List Int := []

-- the function a public entry of f runs: f's boundary twin, or f
def pubEntry (pubs : List Int) (f : Nat) : Nat :=
  let t := factOf (f : Int) pubs
  if t >= 0 then t.toNat else f

def q (r : Request) : Class :=
  { types := { r.types with ranges := [], certs := [], nodeUse := [] }, intr := r.intr, sigs := r.sigs, n := r.n,
    bodies := r.bodies, oneClass := r.oneClass, plainInts := r.plainInts, arrays := r.arrays }

def admit (c : Class) : Except Residue Translated :=
  let im := fromWireWith c.oneClass c.plainInts c.types c.intr c.sigs c.n c.bodies c.arrays
  match im.err with
  | some e => Except.error (residueAt im.fn e)
  | none =>
    if im.ok then Except.ok { decls := im.decls, tab := im.tab, n := im.n, pubs := im.pubs }
    else Except.error (Residue.causeMissing im.fn)

end Lrc
