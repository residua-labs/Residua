-- LRC: inlining. A call of a small function that is not recursive is replaced by the function's body;
-- so is the only call of a function that the program calls once, whatever its size (`inlineOnce`).
-- closure_claim = 0.
--
-- The wire is first-order: every call names its function, so the call graph is exact and there is
-- no closure to analyse. The order is the usual one for such a graph: its strongly connected
-- components, callees before callers (lib/lrc/CallGraph.rsd `callScc`); a function of a cycle is never inlined, and
-- a body is measured after its own calls were replaced.
--
-- Fuel. The wire's fuel is the depth of calls: a callee runs at its caller's fuel less one and
-- refuses at zero (lib/RscBase.rsd `fuelPrologue`, `passFuel`). An inlined body keeps that outcome
-- at every budget: it starts with the guard the callee's entry was (lib/lrc/Ir.rsd `mkGuard`, as
-- lib/lrc/FromWire.rsd leaves one for a reserved form), and every call and guard inside it is one
-- call deeper than it was (`fapDepth`, the guard's depth). One of the stage's own list functions
-- takes no fuel (lib/lrc/FromWire.rsd `helperDecls`, lib/lrc/Ir.rsd `isOwnFn`): its body is copied
-- as it is. Every other function takes fuel, a clone that a pass added after them included.
import AvlMap
import Lib.Lrc.NormIds
import Lib.Lrc.CallGraph

namespace Lrc

-- a body of at most this many instructions is small
def ilLimit : Nat := 32

mutual
partial def ilSize (n : N) : Nat :=
  if n.op == opVDecl then 1 + ilSize (bodyOf n)
  else if n.op == opJDecl then 1 + ilSize (jdeclBody n) + ilSize (bodyOf n)
  else if n.op == opCase then 1 + ilSizeAlts (caseAlts n)
  else if isTerminal n then 1
  else 1 + ilSize (bodyOf n)
partial def ilSizeAlts : List N → Nat
  | [] => 0
  | alt :: alts => ilSize (altBody alt) + ilSizeAlts alts
end

mutual
-- every call of an image function and every guard of the body is k calls deeper
partial def ilDeepen (nImg k : Nat) (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let e2 := if e.op == opFap && !isOwnFn nImg (fapFn e) then { e with b := e.b + (k : Int) } else e
    { n with kids := [e2, ilDeepen nImg k (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [ilDeepen nImg k (jdeclBody n), ilDeepen nImg k (bodyOf n)] }
  else if n.op == opCase then { n with kids := ilDeepenAlts nImg k (caseAlts n) }
  else if isTerminal n then n
  else if n.op == opMData && n.a == 1 then { n with b := n.b + (k : Int), kids := [ilDeepen nImg k (bodyOf n)] }
  else setBody n (ilDeepen nImg k (bodyOf n))
partial def ilDeepenAlts (nImg k : Nat) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (ilDeepen nImg k (altBody alt)) :: ilDeepenAlts nImg k alts
end

mutual
-- every return of the body becomes a jump to join point j; `bare`: the join point has no parameter
partial def ilRetToJmp (j : Nat) (bare : Bool) (n : N) : N :=
  if n.op == opRet then mkJmp j (if bare then [] else n.ys)
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, ilRetToJmp j bare (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [ilRetToJmp j bare (jdeclBody n), ilRetToJmp j bare (bodyOf n)] }
  else if n.op == opCase then { n with kids := ilRetToJmpAlts j bare (caseAlts n) }
  else if isTerminal n then n
  else setBody n (ilRetToJmp j bare (bodyOf n))
partial def ilRetToJmpAlts (j : Nat) (bare : Bool) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (ilRetToJmp j bare (altBody alt)) :: ilRetToJmpAlts j bare alts
end

-- the callee's parameters as the call's arguments. A parameter that gets the irrelevant argument is
-- the irrelevant argument wherever the body passes it on (`irrIdx`): left unbound it would keep the
-- callee's number in the caller, where that number is another variable or none.
def ilBind : List Param → List Int → IMap → IMap
  | p :: ps, y :: ys, m => ilBind ps ys (imInsert m p.x (if y >= 0 then y.toNat else irrIdx))
  | _, _, m => m

-- the variables a binding list binds that exist: x, ty, x, ty, ...
def ilLiveVars : List Int → List Int
  | x :: ty :: rest => if tyIsIrr ty then ilLiveVars rest else x :: ilLiveVars rest
  | _ => []

def ilLiveParams : List Int → List Param
  | x :: ty :: rest => if tyIsIrr ty then ilLiveParams rest else { x := x.toNat, borrow := false, ty := ty } :: ilLiveParams rest
  | _ => []

-- is `ys` the return of exactly what the call binds: the call is in tail position
def ilIsTail (binds : List Int) (k : N) : Bool :=
  k.op == opRet && (k.ys == ilLiveVars binds || ((ilLiveVars binds).isEmpty && k.ys == [argIrr]))

structure IlR where
  next : Nat
  node : N
  deriving Inhabited

structure IlAlts where
  next : Nat
  alts : List N
  deriving Inhabited

mutual
-- the body with every call of a function of `cands` replaced; `ds` holds those functions as they
-- are after their own calls were replaced, `next` is the first unused index
partial def ilGo (cands : VSet) (ds : DeclTab) (nImg : Nat) (n : N) (next : Nat) : IlR :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let k := bodyOf n
    if e.op == opFap && vsContains cands (fapFn e) then
      match dtFind ds (fapFn e) with
      | some g =>
        let c := normGo g.body (ilBind g.xs e.ys imEmpty) next
        let depth := if isOwnFn nImg (fapFn e) || fapSame e then 0 else fapDepth e + 1
        let body := if depth == 0 then c.node else mkGuard depth (ilDeepen nImg depth c.node)
        if ilIsTail (vdeclBinds n) k then { next := c.next, node := body }
        else
          let j := c.next
          let r := ilGo cands ds nImg k (j + 1)
          let ps := ilLiveParams (vdeclBinds n)
          { next := r.next, node := { n0 opJDecl with a := (j : Int), ys := paramsTo ps, kids := [r.node, ilRetToJmp j ps.isEmpty body] } }
      | none =>
        let r := ilGo cands ds nImg k next
        { next := r.next, node := { n with kids := [e, r.node] } }
    else
      let r := ilGo cands ds nImg k next
      { next := r.next, node := { n with kids := [e, r.node] } }
  else if n.op == opJDecl then
    let v := ilGo cands ds nImg (jdeclBody n) next
    let b := ilGo cands ds nImg (bodyOf n) v.next
    { next := b.next, node := { n with kids := [v.node, b.node] } }
  else if n.op == opCase then
    let r := ilAlts cands ds nImg (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := ilGo cands ds nImg (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def ilAlts (cands : VSet) (ds : DeclTab) (nImg : Nat) : List N → Nat → IlAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let b := ilGo cands ds nImg (altBody alt) next
    let r := ilAlts cands ds nImg alts b.next
    { next := r.next, alts := altSetBody alt b.node :: r.alts }
end

mutual
-- Every call of a body, one entry for each: the function called. A call at the caller's own fuel
-- (lib/lrc/Ir.rsd `fapSame`) has two entries, so its callee is never a function "called once" (`inlineOnce`).
-- Such a call is the stage's own: of a loop it lifted, of a public function by its boundary twin, and of the
-- image's function behind the short form of an integer operation (lib/lrc/FromWire.rsd `magWrap`), which is
-- the path seldom taken. With the image's function in it the short form is large; without, it is small, and a
-- small function goes to every place that calls it (`inlineDecls`), as lean.h has its short forms inline and
-- the library's function a call. LLVM's inliner keeps a call it knows to be cold a call for the same reason
-- (llvm/lib/Analysis/InlineCost.cpp, `ColdCallSiteThreshold`).
partial def ilCallList (n : N) (acc : List Int) : List Int :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let f : Int := (fapFn e : Int)
    ilCallList (bodyOf n) (if e.op == opFap && fapSame e then f :: f :: acc else if e.op == opFap then f :: acc else acc)
  else if n.op == opJDecl then ilCallList (bodyOf n) (ilCallList (jdeclBody n) acc)
  else if n.op == opCase then ilCallListAlts (caseAlts n) acc
  else if isTerminal n then acc
  else ilCallList (bodyOf n) acc
partial def ilCallListAlts : List N → List Int → List Int
  | [], acc => acc
  | alt :: alts, acc => ilCallListAlts alts (ilCallList (altBody alt) acc)
end

-- every call of the program
def ilCallsOf : List Decl → List Int → List Int
  | [], acc => acc
  | d :: ds, acc => ilCallsOf ds (if d.ext then acc else ilCallList d.body acc)

-- for each function the number of its calls in a list of calls
def ilCounts : List Int → IMap → IMap
  | [], m => m
  | f :: fs, m => ilCounts fs (imInsert m f.toNat ((imFind m f.toNat).toNat + 1))

-- has the function only scalar parameters
def ilScalarParams : List Param → Bool
  | [] => true
  | p :: ps => tyIsScalar p.ty && ilScalarParams ps

-- the functions in `order`, each after its callees: its body with the candidates' calls replaced,
-- then itself a candidate when it is in no cycle and is small (at most `limit` instructions) or
-- is called once in the program (`calls` counts the program's calls as they were at the start);
-- with `scalar`, only when all its parameters are scalars
def ilRun (recs : VSet) (nImg : Nat) (limit : Nat) (calls : IMap) (scalar : Bool) : List Int → DeclTab → VSet → DeclTab
  | [], ds, _ => ds
  | f :: order, ds, cands =>
    match dtFind ds f.toNat with
    | some d =>
      if d.ext then ilRun recs nImg limit calls scalar order ds cands
      else
        let body := (ilGo cands ds nImg d.body (declMaxIndex d + 1)).node
        let d2 := { d with body := body }
        let cand := !vsContains recs f.toNat && (ilSize body <= limit || imFind calls f.toNat == 1) && (!scalar || ilScalarParams d.xs)
        ilRun recs nImg limit calls scalar order (dtSet ds d2) (if cand then vsInsert cands f.toNat else cands)
    | none => ilRun recs nImg limit calls scalar order ds cands

-- `decls` are the image's functions in order (declaration i is function i), the stage's own
-- list functions after the first nImg; any other list is returned as it is
def ilWith (nImg : Nat) (limit : Nat) (calls : IMap) (scalar : Bool) (decls : List Decl) : List Decl :=
  if !declsDense 0 decls then decls
  else
    let st := callScc decls
    dtToList (ilRun st.recs nImg limit calls scalar (cgOrder st.groups) (dtOfList decls) vsEmpty)

def inlineDecls (nImg : Nat) (decls : List Decl) : List Decl := ilWith nImg ilLimit imEmpty false decls

-- A small function whose parameters are all scalars is inlined before the passes: it owns nothing,
-- so what made inlining before the counting cost (a parameter the callee only borrowed) cannot
-- happen, and the facts about its arguments are then those of each call and not their join
-- (lib/lrc/Range.rsd: the frontend's helper for a fixed-width operation is such a function).
def inlineScalar (nImg : Nat) (decls : List Decl) : List Decl := ilWith nImg ilLimit imEmpty true decls

-- The only call of a function that the program calls once is replaced by its body, whatever the
-- body's size: the code does not grow by more than the call's own instructions, since the function
-- has no other caller (it stays in the program: it may be an entry). The usual rule for a function
-- with one caller; LLVM's inliner gives such a call its largest bonus (llvm/lib/Analysis/InlineCost.cpp,
-- `LastCallToStaticBonus`). It runs before the passes: the callee's constructors then stand in
-- the caller's body, where a cell the caller took apart is reused for them (lib/lrc/ResetReuse.rsd).
-- rbtree's `ins` calls `balance1` and `balance2` once each, with the fields of the node it has just
-- taken apart: as functions, each frees nothing of the caller's and allocates the cell again.
def inlineOnce (nImg : Nat) (decls : List Decl) : List Decl := ilWith nImg 0 (ilCounts (ilCallsOf decls []) imEmpty) false decls

/-! ## Splitting: in a function that calls itself, code that makes no such call is a function of its own

The inverse of the above, for one kind of function.

A function that calls itself other than as its last step, or through others (lib/lrc/CallGraph.rsd:
a second form or a clone that a pass made calls the function it was made from), holds one frame for
each call that has not returned, and a frame is as large as the function's worst path needs: a C compiler saves every
register that any path uses on entry and reserves the slots of every path, and a wasm engine
reserves a slot for every value that lives across some call (V8's baseline compiler: for every
local). cfold's function folds a chain of a million sums by calling itself on the rest of the
chain; what follows the call, the match on the two results with the integer operations written
out, is fourteen hundred instructions, and none of it runs while the calls below are open. Its
frame was 128 bytes where the two values that live across the call need 48.

So such a function is split (function splitting: GCC's ipa-split, LLVM's hot/cold splitting and its
CodeExtractor; lifting the code out with its free variables as parameters is lambda lifting,
Johnsson 1985): a part of the body that
  * makes no call of the function itself or of a function that calls it back,
  * jumps to no join point outside it (it ends by returning, as every part of a body does),
  * has at least `spLimit` instructions, and
  * makes a call or builds, counts down or frees an object (code without these keeps its values in
    registers that a call does not preserve, and adds nothing to the frame)
becomes a function whose parameters are the part's free variables; in its place stands the call
and the return of its results. The largest such part is taken: the body below a call of the
function itself, an alternative, or a join point's body, in a body that does call the function
elsewhere. What a frame then holds is what the calls of the function itself need, as a
continuation's closure holds its free variables and no more (Appel, Compiling with
Continuations, 1992, on space safety).

The cost is one call where the part runs. `spLimit` is the size above which the inliner leaves a
function a call (lib/lrc/Inline.rsd `ilLimit`): a part that would have been called, had the source
written it as a function, is called.

The new function is entered at the fuel of the function it was taken from (lib/lrc/Ir.rsd
`mkFapApart`, a call as `fapSame` has it), so every call and every guard inside it sees the fuel
it saw, and the function keeps its outcome at every budget. It is no loop, so the emitter does not
write it back at its one call (lib/lrc/Emit.rsd "A function with one caller"); and the module
names it in its table, so that a C compiler behind wasm2c does not write it back either
(lib/lrc/Emit.rsd `keptFns`). The counting instructions are in the code already and move with it.

Not split: a function whose only calls of itself are jumps to its start (it holds one frame), and
a function with a result that does not exist at run time (lib/lrc/Trmc.rsd, the plain form). -/

-- a part of at least this many instructions becomes a function
def spLimit : Nat := ilLimit + 1
-- when it has at most this many free variables
def spCap : Nat := 3

-- is the expression a call of a function of `own`
def spOwnCall (own : VSet) (e : N) : Bool := e.op == opFap && vsContains own (fapFn e)

mutual
-- Does the body of function f call a function of `own`, the functions that call each other with f (f itself
-- among them), so that frames pile up: any such call but a call of f itself as the body's last step (a call
-- whose results are returned at once is a jump to the function's start, lib/lrc/Emit.rsd `emBody`).
partial def spRecurses (f : Nat) (own : VSet) (n : N) : Bool :=
  if n.op == opVDecl then
    (spOwnCall own (vdeclExpr n) && !(fapFn (vdeclExpr n) == f && (bodyOf n).op == opRet)) || spRecurses f own (bodyOf n)
  else if n.op == opJDecl then spRecurses f own (jdeclBody n) || spRecurses f own (bodyOf n)
  else if n.op == opCase then spRecursesAlts f own (caseAlts n)
  else if isTerminal n then false
  else spRecurses f own (bodyOf n)
partial def spRecursesAlts (f : Nat) (own : VSet) : List N → Bool
  | [] => false
  | alt :: alts => spRecurses f own (altBody alt) || spRecursesAlts f own alts
end

/-! ## The types of a function's variables -/

def spBindTys : List Int → IMap → IMap
  | x :: ty :: rest, m => spBindTys rest (if x >= 0 && ty >= 0 then imInsert m x.toNat ty.toNat else m)
  | _, m => m

def spParamTys : List Param → IMap → IMap
  | [], m => m
  | p :: ps, m => spParamTys ps (if p.ty >= 0 then imInsert m p.x p.ty.toNat else m)

mutual
partial def spTys (n : N) (m : IMap) : IMap :=
  if n.op == opVDecl then spTys (bodyOf n) (spBindTys (vdeclBinds n) m)
  else if n.op == opJDecl then spTys (bodyOf n) (spTys (jdeclBody n) (spParamTys (jdeclParams n) m))
  else if n.op == opCase then spTysAlts (caseAlts n) m
  else if isTerminal n then m
  else spTys (bodyOf n) m
partial def spTysAlts : List N → IMap → IMap
  | [], m => m
  | alt :: alts, m => spTysAlts alts (spTys (altBody alt) m)
end

/-! ## Is a part fit to be a function -/

mutual
-- does the body jump to a join point that it does not declare (`js`: those declared so far)
partial def spJumpsOut (n : N) (js : VSet) : Bool :=
  if n.op == opVDecl then spJumpsOut (bodyOf n) js
  else if n.op == opJDecl then spJumpsOut (jdeclBody n) js || spJumpsOut (bodyOf n) (vsInsert js (jdeclId n))
  else if n.op == opCase then spJumpsOutAlts (caseAlts n) js
  else if n.op == opJmp then !vsContains js (jmpId n)
  else if isTerminal n then false
  else spJumpsOut (bodyOf n) js
partial def spJumpsOutAlts : List N → VSet → Bool
  | [], _ => false
  | alt :: alts, js => spJumpsOut (altBody alt) js || spJumpsOutAlts alts js
end

mutual
-- does the body make a call, or build, count down or free an object
partial def spWorks (n : N) : Bool :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    e.op == opFap || e.op == opCtor || e.op == opReuse || e.op == opReset || spWorks (bodyOf n)
  else if n.op == opJDecl then spWorks (jdeclBody n) || spWorks (bodyOf n)
  else if n.op == opCase then spWorksAlts (caseAlts n)
  else if isTerminal n then false
  else n.op == opDec || n.op == opDel || spWorks (bodyOf n)
partial def spWorksAlts : List N → Bool
  | [] => false
  | alt :: alts => spWorks (altBody alt) || spWorksAlts alts
end

structure SpPs where
  ok : Bool
  ps : List Param
  deriving Inhabited

-- the parameters of the new function: the part's free variables with their types
def spParams (tys : IMap) : List Nat → SpPs
  | [] => { ok := true, ps := [] }
  | x :: xs =>
    let r := spParams tys xs
    let t := imFind tys x
    { ok := r.ok && t >= 0, ps := { x := x, borrow := false, ty := t } :: r.ps }

def spArgs : List Nat → List Int
  | [] => []
  | x :: xs => (x : Int) :: spArgs xs

-- binders for the results of a call of a function with these result types, from index x on: x, ty, ...
def spBinds (x : Nat) : List Int → List Int
  | [] => []
  | ty :: tys => (x : Int) :: ty :: spBinds (x + 1) tys

def spAllLive : List Int → Bool
  | [] => true
  | ty :: tys => !tyIsIrr ty && spAllLive tys

/-! ## The split -/

-- own: the function and those that call each other with it; rets: its result types; tys: its variables' types;
-- lim: `spLimit`; cap: `spCap`
structure SpCx where
  own : VSet
  rets : List Int
  tys : IMap
  lim : Nat
  cap : Nat
  deriving Inhabited

-- next: the next function number; fresh: the next free index of the function that is split;
-- added: the new functions, the last one first
structure SpSt where
  next : Nat
  fresh : Nat
  added : List Decl
  deriving Inhabited

-- calls: does the node call a function of `own`
structure SpR where
  node : N
  calls : Bool
  st : SpSt
  deriving Inhabited

-- flags: for each alternative, does it call a function of `own`
structure SpAlts where
  alts : List N
  flags : List Bool
  calls : Bool
  st : SpSt
  deriving Inhabited

-- A part that makes no call of a function of `own`: a function of its own when it is fit, else as it was.
def spTake (cx : SpCx) (n : N) (st : SpSt) : SpR :=
  if ilSize n < cx.lim || !spWorks n || spJumpsOut n vsEmpty then { node := n, calls := false, st := st }
  else
    let fv := vsToList (freeIndices n)
    let ps := spParams cx.tys fv
    if !ps.ok || fv.length > cx.cap then { node := n, calls := false, st := st }
    else
      let g : Decl := declNormalizeIds { f := st.next, xs := ps.ps, rets := cx.rets, body := n, ext := false }
      let binds := spBinds st.fresh cx.rets
      let call := mkFapApart st.next (spArgs fv)
      { node := mkVDecls st.fresh (intAt 1 binds) (binds.drop 2) call (mkRet (spArgs (bindVars binds))),
        calls := false,
        st := { next := st.next + 1, fresh := st.fresh + cx.rets.length, added := g :: st.added } }

-- the same for a kid of a node that calls the function elsewhere
def spKid (cx : SpCx) (r : SpR) : SpR := if r.calls then r else spTake cx r.node r.st

-- the alternatives of a case that calls the function in one of them, each split already: one that does not
-- call it is taken
def spTakeAlts (cx : SpCx) : List N → List Bool → SpSt → SpAlts
  | alt :: alts, c :: cs, st =>
    let k := spKid cx { node := altBody alt, calls := c, st := st }
    let r := spTakeAlts cx alts cs k.st
    { alts := altSetBody alt k.node :: r.alts, flags := [], calls := true, st := r.st }
  | _, _, st => { alts := [], flags := [], calls := true, st := st }

mutual
-- One body. A part without a call of the function comes back unchanged with `calls` false, and the node
-- above it, which knows whether the function is called beside it, takes it or hands it on.
partial def spGo (cx : SpCx) (n : N) (st : SpSt) : SpR :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let r := spGo cx (bodyOf n) st
    if spOwnCall cx.own e then
      let k := spKid cx r
      { node := { n with kids := [e, k.node] }, calls := true, st := k.st }
    else { node := { n with kids := [e, r.node] }, calls := r.calls, st := r.st }
  else if n.op == opJDecl then
    let v := spGo cx (jdeclBody n) st
    let b := spGo cx (bodyOf n) v.st
    if v.calls || b.calls then
      let v2 := spKid cx { v with st := b.st }
      let b2 := spKid cx { b with st := v2.st }
      { node := { n with kids := [v2.node, b2.node] }, calls := true, st := b2.st }
    else { node := n, calls := false, st := st }
  else if n.op == opCase then
    let r := spAlts cx (caseAlts n) st
    if r.calls then
      let t := spTakeAlts cx r.alts r.flags r.st
      { node := { n with kids := t.alts }, calls := true, st := t.st }
    else { node := n, calls := false, st := st }
  else if isTerminal n then { node := n, calls := false, st := st }
  else
    let r := spGo cx (bodyOf n) st
    { node := setBody n r.node, calls := r.calls, st := r.st }
-- the alternatives, each split by itself; no alternative is taken yet
partial def spAlts (cx : SpCx) : List N → SpSt → SpAlts
  | [], st => { alts := [], flags := [], calls := false, st := st }
  | alt :: alts, st =>
    let b := spGo cx (altBody alt) st
    let r := spAlts cx alts b.st
    { alts := altSetBody alt b.node :: r.alts, flags := b.calls :: r.flags, calls := b.calls || r.calls, st := r.st }
end

structure SpDs where
  decls : List Decl
  st : SpSt
  deriving Inhabited

def spDecls (scc : CallScc) (lim cap : Nat) : List Decl → SpSt → SpDs
  | [], st => { decls := [], st := st }
  | d :: ds, st =>
    let own := vsInsertArgs vsEmpty (sccOf scc (d.f : Int))
    if d.ext || d.rets.isEmpty || !spAllLive d.rets || !vsContains scc.recs d.f || !spRecurses d.f own d.body then
      let r := spDecls scc lim cap ds st
      { decls := d :: r.decls, st := r.st }
    else
      let cx : SpCx := { own := own, rets := d.rets, tys := spTys d.body (spParamTys d.xs imEmpty), lim := lim, cap := cap }
      let b := spGo cx d.body { st with fresh := declMaxIndex d + 1 }
      let d2 := if b.st.next == st.next then d else declNormalizeIds { d with body := b.node }
      let r := spDecls scc lim cap ds b.st
      { decls := d2 :: r.decls, st := r.st }

-- The declarations are numbered 0, 1, ... in their order (lib/lrc/Trmc.rsd `trmc`; any other list is returned as
-- it is); the new functions follow them.
def splitWith (lim cap : Nat) (decls : List Decl) : List Decl :=
  if !declsDense 0 decls then decls
  else
    let r := spDecls (callScc decls) lim cap decls { next := decls.length, fresh := 0, added := [] }
    r.decls ++ r.st.added.reverse

def split (decls : List Decl) : List Decl := splitWith spLimit spCap decls

end Lrc
