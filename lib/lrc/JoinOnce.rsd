-- LRC: a join point that is jumped to once is put where the jump was.
-- closure_claim = 0.
--
-- Inlining a call leaves `jdecl j ps := v; b`: b is the callee's body with its returns turned into
-- jumps to j, v is what followed the call (lib/lrc/Inline.rsd `ilGo`). A callee with one return
-- gives one jump. The code is then straight, but written as two bodies, and what a pass knows at
-- the jump it does not know in v: a fuel guard that the callee's body already passed is tested
-- again (lib/lrc/GuardElim.rsd carries what is known into a join point from its declaration, not
-- from its jumps), and equal subexpressions on the two sides are not seen as equal.
-- Here such a join point is removed: the jump becomes v with the parameters replaced by the jump's
-- arguments. This is the rule of Lean's simplifier for a join point used once (LCNF/Simp/JpCases
-- and `inlineJp?` in LCNF/Simp/Main.lean) and of GHC's (Maurer, Downen, Ariola, Peyton Jones:
-- Compiling without Continuations, PLDI 2017, the `jinline` axiom).
-- Sound because a join point's declaration does nothing by itself, the indices of a function are
-- unique (v binds nothing that b binds), and every variable v reads free is bound outside the
-- declaration, so it is in scope at the jump too.
import Lib.Lrc.NormIds
import Lib.Lrc.Prim

namespace Lrc

mutual
-- how often the body jumps to j
partial def joCount (j : Nat) (n : N) : Nat :=
  if n.op == opJmp then (if jmpId n == j then 1 else 0)
  else if n.op == opVDecl then joCount j (bodyOf n)
  else if n.op == opJDecl then joCount j (jdeclBody n) + joCount j (bodyOf n)
  else if n.op == opCase then joCountAlts j (caseAlts n)
  else if isTerminal n then 0
  else joCount j (bodyOf n)
partial def joCountAlts (j : Nat) : List N → Nat
  | [] => 0
  | alt :: alts => joCount j (altBody alt) + joCountAlts j alts
end

-- the parameters as the arguments of the jump; a parameter that gets the irrelevant argument is the
-- irrelevant argument wherever the body passes it on (lib/lrc/Ir.rsd `irrIdx`)
def joBind : List Param → List Int → IMap → IMap
  | p :: ps, y :: ys, m => joBind ps ys (imInsert m p.x (if y >= 0 then y.toNat else irrIdx))
  | _, _, m => m

mutual
-- the body with its jump to j replaced by v under the jump's arguments
partial def joPut (j : Nat) (ps : List Param) (v : N) (n : N) : N :=
  if n.op == opJmp then (if jmpId n == j then mapVarsGo (joBind ps (jmpArgs n) imEmpty) v else n)
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, joPut j ps v (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [joPut j ps v (jdeclBody n), joPut j ps v (bodyOf n)] }
  else if n.op == opCase then { n with kids := joPutAlts j ps v (caseAlts n) }
  else if isTerminal n then n
  else setBody n (joPut j ps v (bodyOf n))
partial def joPutAlts (j : Nat) (ps : List Param) (v : N) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (joPut j ps v (altBody alt)) :: joPutAlts j ps v alts
end

mutual
partial def joGo (n : N) : N :=
  if n.op == opJDecl then
    let v := joGo (jdeclBody n)
    let b := joGo (bodyOf n)
    if joCount (jdeclId n) b == 1 then joPut (jdeclId n) (jdeclParams n) v b
    else { n with kids := [v, b] }
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, joGo (bodyOf n)] }
  else if n.op == opCase then { n with kids := joAlts (caseAlts n) }
  else if isTerminal n then n
  else setBody n (joGo (bodyOf n))
partial def joAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (joGo (altBody alt)) :: joAlts alts
end

def declJoinOnce (d : Decl) : Decl := if d.ext then d else { d with body := joGo d.body }

def joinOnce : List Decl → List Decl
  | [] => []
  | d :: ds => declJoinOnce d :: joinOnce ds

/-! ## A small join point at each of its jumps, and what a jump knows

After the short forms of the integer operations are put where they are called (lib/lrc/Inline.rsd
`inlineDecls`), the value of an operation reaches what follows through a join point with two jumps: the
machine's result, boxed, and the result of the image's function. What follows asks again whether the
value is a small number, takes its number out again and counts it down; on the first jump all three are
known. Two steps, both over the forms the IR has:

1. `joinSmall`: a join point whose body is small is put at each of its jumps that carries a literal or a
   box, with the parameters replaced by the jump's arguments and its own bindings renamed (lib/lrc/NormIds.rsd `normGo`, as
   lib/lrc/Inline.rsd `ilGo` copies a callee). Lean's simplifier does this for a small join point
   (LCNF/Simp/Main.lean `inlineJp?`); lib/lrc/JoinOnce.rsd is the case of one jump.
2. `foldKnown`: over each body, with what is known of a variable from its binding: a literal, or the box
   of a number (`primBox`, `primBoxS`). The test for a small number of a box is 1; the number taken out of
   a box with the same sign rule is the number that went in; `and` with 1 is the other operand and with 0
   is 0 (its operands are the wire's Bool); a test on a known literal is its alternative; counting a box
   up or down is nothing. This is constant propagation with the branches that a constant decides (Wegman
   and Zadeck, Constant Propagation with Conditional Branches, TOPLAS 1991), along the bindings of one
   body: a join point's parameters are not known.

Sound because the IR's variables are bound once and every rule replaces an expression by one of the same
value under lib/lrc/Prim.rsd's meaning of the primitives; a box is no heap object, so its count is
nothing (lean.h `lean_inc`, `lean_dec` test `lean_is_scalar`).
(This stands in this module and not in one of its own: the lists of the stage's modules are kept by hand in nine
places until the chain is built by modules.) -/

-- a join point's body of at most `jsLimit` instructions goes to its jumps that carry something known; one of
-- at most `jsTiny` goes to every jump (a test's value passed on: the copy costs less than the jump saves)
def jsLimit : Nat := 16
def jsTiny : Nat := 4

mutual
partial def jsSize (n : N) : Nat :=
  if n.op == opVDecl then 1 + jsSize (bodyOf n)
  else if n.op == opJDecl then 1 + jsSize (jdeclBody n) + jsSize (bodyOf n)
  else if n.op == opCase then 1 + jsSizeAlts (caseAlts n)
  else if isTerminal n then 1
  else 1 + jsSize (bodyOf n)
partial def jsSizeAlts : List N → Nat
  | [] => 0
  | alt :: alts => jsSize (altBody alt) + jsSizeAlts alts
end

structure JsAlts where
  next : Nat
  alts : List N
  deriving Inhabited

-- is one of the arguments a variable bound to a literal or to a box on the way to the jump
def jsAnyKnown (known : List Int) : List Int → Bool
  | [] => false
  | y :: ys => (y >= 0 && known.contains y) || jsAnyKnown known ys

mutual
-- Every jump to j that carries something known (a variable bound to a literal or to a box on the way to it:
-- `known`), or every jump with `all`, is replaced by a copy of v under the jump's arguments, its bindings
-- renamed from `next` on. Without `all` a jump that knows nothing of its arguments stays a jump: its copy
-- would fold to what the join point already is.
partial def jsPut (all : Bool) (j : Nat) (ps : List Param) (v : N) (known : List Int) (n : N) (next : Nat) : NormR :=
  if n.op == opJmp then
    if jmpId n == j && (all || jsAnyKnown known (jmpArgs n)) then normGo v (joBind ps (jmpArgs n) imEmpty) next else { next := next, node := n }
  else if n.op == opVDecl then
    let e := vdeclExpr n
    let box := e.op == opPrim && (primOp e == primBox || primOp e == primBoxS)
    let r := jsPut all j ps v (if e.op == opLit || box then (vdeclVar n : Int) :: known else known) (bodyOf n) next
    { next := r.next, node := { n with kids := [e, r.node] } }
  else if n.op == opJDecl then
    let a := jsPut all j ps v known (jdeclBody n) next
    let b := jsPut all j ps v known (bodyOf n) a.next
    { next := b.next, node := { n with kids := [a.node, b.node] } }
  else if n.op == opCase then
    let r := jsPutAlts all j ps v known (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := jsPut all j ps v known (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def jsPutAlts (all : Bool) (j : Nat) (ps : List Param) (v : N) (known : List Int) : List N → Nat → JsAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := jsPut all j ps v known (altBody alt) next
    let r := jsPutAlts all j ps v known alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

mutual
partial def jsGo (n : N) (next : Nat) : NormR :=
  if n.op == opJDecl then
    let v := jsGo (jdeclBody n) next
    let b := jsGo (bodyOf n) v.next
    if joCount (jdeclId n) b.node >= 2 && jsSize v.node <= jsLimit then
      -- the join point stays for the jumps that know nothing; with no jump left it is gone
      let r := jsPut (jsSize v.node <= jsTiny) (jdeclId n) (jdeclParams n) v.node [] b.node b.next
      if joCount (jdeclId n) r.node == 0 then r else { next := r.next, node := { n with kids := [v.node, r.node] } }
    else { next := b.next, node := { n with kids := [v.node, b.node] } }
  else if n.op == opVDecl then
    let r := jsGo (bodyOf n) next
    { next := r.next, node := { n with kids := [vdeclExpr n, r.node] } }
  else if n.op == opCase then
    let r := jsAlts (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := jsGo (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def jsAlts : List N → Nat → JsAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := jsGo (altBody alt) next
    let r := jsAlts alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

def declJoinSmall (d : Decl) : Decl := if d.ext then d else { d with body := (jsGo d.body (declMaxIndex d + 1)).node }

def joinSmall : List Decl → List Decl
  | [] => []
  | d :: ds => declJoinSmall d :: joinSmall ds

/-! ## What is known of a variable -/

-- what a binding says: x, kind, payload, ...; kind 1 a literal (the payload its value), 2 the box of the
-- number in variable `payload` (`primBox`), 3 the box with its sign (`primBoxS`)
def knKind (x : Int) : List Int → Int
  | y :: k :: _ :: rest => if x == y then k else knKind x rest
  | _ => 0

def knPay (x : Int) : List Int → Int
  | y :: _ :: p :: rest => if x == y then p else knPay x rest
  | _ => 0

def knIsBox (x : Int) (env : List Int) : Bool := knKind x env == 2 || knKind x env == 3
def knIsLit (x : Int) (v : Int) (env : List Int) : Bool := knKind x env == 1 && knPay x env == v

-- the alternative of a test on the literal v, when the test has one for it
def knAlt (v : Int) : List N → Option N
  | [] => none
  | alt :: alts => if alt.op == opAltCtor && ((infoOf alt).cidx : Int) == v && (infoOf alt).tid == 0 then some (altBody alt) else knAlt v alts

mutual
partial def knGo (env : List Int) (n : N) : N :=
  if n.op == opVDecl && n.ys.isEmpty then
    let e := vdeclExpr n
    let x : Int := (vdeclVar n : Int)
    let rest := bodyOf n
    let a := intAt 0 e.ys
    let b := intAt 1 e.ys
    if e.op == opLit then { n with kids := [e, knGo (x :: 1 :: e.a :: env) rest] }
    else if e.op != opPrim then { n with kids := [e, knGo env rest] }
    else if primOp e == primBox && a >= 0 then { n with kids := [e, knGo (x :: 2 :: a :: env) rest] }
    else if primOp e == primBoxS && a >= 0 then { n with kids := [e, knGo (x :: 3 :: a :: env) rest] }
    else if primOp e == primIsScalar && knIsBox a env then { n with kids := [mkLit 1, knGo (x :: 1 :: 1 :: env) rest] }
    else if primOp e == primUnboxS && knKind a env == 3 then knGo env (replaceVar x.toNat (knPay a env).toNat rest)
    else if primOp e == primUnbox && knKind a env == 2 then knGo env (replaceVar x.toNat (knPay a env).toNat rest)
    else if primOp e == primAnd && (knIsLit a 0 env || knIsLit b 0 env) then { n with kids := [mkLit 0, knGo (x :: 1 :: 0 :: env) rest] }
    else if primOp e == primAnd && knIsLit a 1 env && b >= 0 then knGo env (replaceVar x.toNat b.toNat rest)
    else if primOp e == primAnd && knIsLit b 1 env && a >= 0 then knGo env (replaceVar x.toNat a.toNat rest)
    else { n with kids := [e, knGo env rest] }
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, knGo env (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [knGo env (jdeclBody n), knGo env (bodyOf n)] }
  else if n.op == opCase then
    if knKind (caseVar n : Int) env == 1 then
      match knAlt (knPay (caseVar n : Int) env) (caseAlts n) with
      | some body => knGo env body
      | none => { n with kids := knAlts env (caseAlts n) }
    else { n with kids := knAlts env (caseAlts n) }
  else if isTerminal n then n
  else if (n.op == opInc || n.op == opDec) && knIsBox (rcVar n : Int) env then knGo env (bodyOf n)
  else setBody n (knGo env (bodyOf n))
partial def knAlts (env : List Int) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (knGo env (altBody alt)) :: knAlts env alts
end

def declFoldKnown (d : Decl) : Decl := if d.ext then d else { d with body := knGo [] d.body }

def foldKnown : List Decl → List Decl
  | [] => []
  | d :: ds => declFoldKnown d :: foldKnown ds

/-! ## A test goes down to the case that reads it

EmitC writes `x = a == b; if (x == 0)` and leaves it to the C compiler, which makes it one compare and one
branch. The wasm this stage writes is run as it is by a wasm engine, and there the word of the comparison is
made, widened and tested again (V8 on nqueens' inner loop: three such words for each list element; the same
module is at twice its native time). So the test and its branch are written as one by the emitter
(lib/lrc/Emit.rsd `emTest`), and for that the binding has to stand directly before its case. Here it is
brought there:

  * a binding of a test whose one reader is a case further down, with only declarations of join points
    between, moves down to that case (a `&&` of the source leaves the test above the join point that takes
    its value);
  * a case on the negation of a word is the case on the word, its alternatives exchanged.

Only operators on words move (`lt`, `gt`, `eq`, `not`, the test of a small number): they read no memory, so
nothing between can change them. Instruction selection of this kind is every code generator's (Aho, Sethi,
Ullman, Compilers, 9.2: a relational operator followed by a conditional jump is one instruction); the
exchange of the alternatives is `not` pushed into the branch. -/

def cdIsTest (e : N) : Bool :=
  e.op == opPrim &&
    (primOp e == primLt || primOp e == primGt || primOp e == primEq || primOp e == primNot || primOp e == primIsScalar)

def cdCountArgs (x : Int) : List Int → Nat
  | [] => 0
  | y :: ys => (if y == x then 1 else 0) + cdCountArgs x ys

mutual
-- how many times x is read in a body
partial def cdCount (x : Int) (n : N) : Nat :=
  if n.op == opVDecl then cdCountArgs x (exprArgs (vdeclExpr n)) + cdCount x (bodyOf n)
  else if n.op == opJDecl then cdCount x (jdeclBody n) + cdCount x (bodyOf n)
  else if n.op == opCase then (if n.a == x then 1 else 0) + cdCountAlts x (caseAlts n)
  else if n.op == opJmp then cdCountArgs x (jmpArgs n)
  else if n.op == opRet then cdCountArgs x (retArgs n)
  else if n.op == opUnreachable then 0
  else cdCountArgs x (insUses n) + cdCount x (bodyOf n)
partial def cdCountAlts (x : Int) : List N → Nat
  | [] => 0
  | alt :: alts => cdCount x (altBody alt) + cdCountAlts x alts
end

-- is a case on the word x what stands below, past the join points declared on the way
partial def cdCaseBelow (x : Int) (n : N) : Bool :=
  if n.op == opJDecl then cdCaseBelow x (bodyOf n)
  else n.op == opCase && n.a == x && tyIsScalar (caseTy n)

-- the body with the binding v directly before what stands below the join points declared on the way
partial def cdPut (v : N) (n : N) : N :=
  if n.op == opJDecl then { n with kids := [jdeclBody n, cdPut v (bodyOf n)] }
  else { v with kids := [vdeclExpr v, n] }

-- the two bodies of a case on a truth value: for 0 and for 1
structure CdTwo where
  ok : Bool
  zero : N
  one : N
  deriving Inhabited

def cdTwo (alts : List N) : CdTwo :=
  match alts with
  | [a, b] =>
    if !altIsDefault a && !altIsDefault b then
      (if a.a == 0 && b.a == 1 then { ok := true, zero := altBody a, one := altBody b }
       else if a.a == 1 && b.a == 0 then { ok := true, zero := altBody b, one := altBody a }
       else { ok := false, zero := a, one := b })
    else if !altIsDefault a && altIsDefault b then
      (if a.a == 0 then { ok := true, zero := altBody a, one := altBody b }
       else if a.a == 1 then { ok := true, zero := altBody b, one := altBody a }
       else { ok := false, zero := a, one := b })
    else if altIsDefault a && !altIsDefault b then
      (if b.a == 0 then { ok := true, zero := altBody b, one := altBody a }
       else if b.a == 1 then { ok := true, zero := altBody a, one := altBody b }
       else { ok := false, zero := a, one := b })
    else { ok := false, zero := a, one := b }
  | _ => { ok := false, zero := n0 opUnreachable, one := n0 opUnreachable }

mutual
partial def cdGo (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let k := bodyOf n
    if n.ys.isEmpty && cdIsTest e && k.op == opJDecl && cdCaseBelow n.a k && cdCount n.a k == 1 then
      cdGo (cdPut n k)
    else if n.ys.isEmpty && e.op == opPrim && primOp e == primNot && intAt 0 e.ys >= 0 && k.op == opCase && k.a == n.a
        && tyIsScalar (caseTy k) && cdCount n.a k == 1 && (cdTwo (caseAlts k)).ok then
      -- `not z` is 1 for z = 0 and 0 for every other word
      let two := cdTwo (caseAlts k)
      cdGo (mkCase (intAt 0 e.ys).toNat (caseTy k) [mkAltCtor (boolInfo 0) two.one, mkAltDefault two.zero])
    else { n with kids := [e, cdGo k] }
  else if n.op == opJDecl then { n with kids := [cdGo (jdeclBody n), cdGo (bodyOf n)] }
  else if n.op == opCase then { n with kids := cdAlts (caseAlts n) }
  else if isTerminal n then n
  else setBody n (cdGo (bodyOf n))
partial def cdAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (cdGo (altBody alt)) :: cdAlts alts
end

-- three rounds: the exchange leaves a case on a word whose own binding is above the join point
def condDown : List Decl → List Decl
  | [] => []
  | d :: ds => (if d.ext then d else { d with body := cdGo (cdGo (cdGo d.body)) }) :: condDown ds

end Lrc
