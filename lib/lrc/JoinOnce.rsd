-- LRC: a join point that is jumped to once is put where the jump was.
-- closure_claim = 0.
--
-- Inlining a call leaves `jdecl j ps := v; b`: b is the callee's body with its returns turned into
-- jumps to j, v is what followed the call (lib/lrc/Inline.rsd `ilGo`). A callee with one return
-- gives one jump. The code is then straight, but written as two bodies, and what a pass knows at
-- the jump it does not know in v: a fuel guard that the callee's body already passed is tested
-- again (lib/lrc/GuardElim.rsd carries what is known into a join point from its declaration, not
-- from its jumps), and equal subexpressions on the two sides are not seen as equal.
-- Here such a join point is removed: the jump becomes v with the parameters replaced by the jump's
-- arguments. This is the rule of Lean's simplifier for a join point used once (LCNF/Simp/JpCases
-- and `inlineJp?` in LCNF/Simp/Main.lean) and of GHC's (Maurer, Downen, Ariola, Peyton Jones:
-- Compiling without Continuations, PLDI 2017, the `jinline` axiom).
-- Sound because a join point's declaration does nothing by itself, the indices of a function are
-- unique (v binds nothing that b binds), and every variable v reads free is bound outside the
-- declaration, so it is in scope at the jump too.
import Lib.Lrc.NormIds
import Lib.Lrc.Prim

namespace Lrc

mutual
-- how often the body jumps to j
partial def joCount (j : Nat) (n : N) : Nat :=
  if n.op == opJmp then (if jmpId n == j then 1 else 0)
  else if n.op == opVDecl then joCount j (bodyOf n)
  else if n.op == opJDecl then joCount j (jdeclBody n) + joCount j (bodyOf n)
  else if n.op == opCase then joCountAlts j (caseAlts n)
  else if isTerminal n then 0
  else joCount j (bodyOf n)
partial def joCountAlts (j : Nat) : List N → Nat
  | [] => 0
  | alt :: alts => joCount j (altBody alt) + joCountAlts j alts
end

-- the parameters as the arguments of the jump; a parameter that gets the irrelevant argument is the
-- irrelevant argument wherever the body passes it on (lib/lrc/Ir.rsd `irrIdx`)
def joBind : List Param → List Int → IMap → IMap
  | p :: ps, y :: ys, m => joBind ps ys (imInsert m p.x (if y >= 0 then y.toNat else irrIdx))
  | _, _, m => m

mutual
-- the body with its jump to j replaced by v under the jump's arguments
partial def joPut (j : Nat) (ps : List Param) (v : N) (n : N) : N :=
  if n.op == opJmp then (if jmpId n == j then mapVarsGo (joBind ps (jmpArgs n) imEmpty) v else n)
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, joPut j ps v (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [joPut j ps v (jdeclBody n), joPut j ps v (bodyOf n)] }
  else if n.op == opCase then { n with kids := joPutAlts j ps v (caseAlts n) }
  else if isTerminal n then n
  else setBody n (joPut j ps v (bodyOf n))
partial def joPutAlts (j : Nat) (ps : List Param) (v : N) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (joPut j ps v (altBody alt)) :: joPutAlts j ps v alts
end

mutual
partial def joGo (n : N) : N :=
  if n.op == opJDecl then
    let v := joGo (jdeclBody n)
    let b := joGo (bodyOf n)
    if joCount (jdeclId n) b == 1 then joPut (jdeclId n) (jdeclParams n) v b
    else { n with kids := [v, b] }
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, joGo (bodyOf n)] }
  else if n.op == opCase then { n with kids := joAlts (caseAlts n) }
  else if isTerminal n then n
  else setBody n (joGo (bodyOf n))
partial def joAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (joGo (altBody alt)) :: joAlts alts
end

def declJoinOnce (d : Decl) : Decl := if d.ext || declIsClosed d then d else { d with body := joGo d.body }

def joinOnce : List Decl → List Decl
  | [] => []
  | d :: ds => declJoinOnce d :: joinOnce ds

/-! ## A small join point at each of its jumps, and what a jump knows

After the short forms of the integer operations are put where they are called (lib/lrc/Inline.rsd
`inlineDecls`), the value of an operation reaches what follows through a join point with two jumps: the
machine's result, boxed, and the result of the image's function. What follows asks again whether the
value is a small number, takes its number out again and counts it down; on the first jump all three are
known. Two steps, both over the forms the IR has:

1. `joinSmall`: a join point whose body is small is put at each of its jumps that carries a literal or a
   box, with the parameters replaced by the jump's arguments and its own bindings renamed (lib/lrc/NormIds.rsd `normGo`, as
   lib/lrc/Inline.rsd `ilGo` copies a callee). Lean's simplifier does this for a small join point
   (LCNF/Simp/Main.lean `inlineJp?`); lib/lrc/JoinOnce.rsd is the case of one jump.
2. `foldKnown`: over each body, with what is known of a variable from its binding: a literal, or the box
   of a number (`primBox`, `primBoxS`). The test for a small number of a box is 1; the number taken out of
   a box with the same sign rule is the number that went in; `and` with 1 is the other operand and with 0
   is 0 (its operands are the wire's Bool); a test on a known literal is its alternative; counting a box
   up or down is nothing. This is constant propagation with the branches that a constant decides (Wegman
   and Zadeck, Constant Propagation with Conditional Branches, TOPLAS 1991), along the bindings of one
   body: a join point's parameters are not known.

Sound because the IR's variables are bound once and every rule replaces an expression by one of the same
value under lib/lrc/Prim.rsd's meaning of the primitives; a box is no heap object, so its count is
nothing (lean.h `lean_inc`, `lean_dec` test `lean_is_scalar`).
(This stands in this module and not in one of its own: the lists of the stage's modules are kept by hand in nine
places until the chain is built by modules.) -/

-- a join point's body of at most `jsLimit` instructions goes to its jumps that carry something known; one of
-- at most `jsTiny` goes to every jump (a test's value passed on: the copy costs less than the jump saves)
def jsLimit : Nat := 16
def jsTiny : Nat := 4

-- `jsSizeCap n cap` is `jsSize` stopped at `cap`: it counts like the size would, but a subtree whose
-- count has already filled the cap is not walked further. The join-size tests only compare the count
-- against limits below the cap, so they decide identically.
mutual
partial def jsSizeCap (n : N) (cap : Nat) : Nat :=
  if cap == 0 then 0
  else if n.op == opVDecl then 1 + jsSizeCap (bodyOf n) (cap - 1)
  else if n.op == opJDecl then
    let a := jsSizeCap (jdeclBody n) (cap - 1)
    1 + a + jsSizeCap (bodyOf n) (cap - 1 - a)
  else if n.op == opCase then 1 + jsSizeAltsCap (caseAlts n) (cap - 1)
  else if isTerminal n then 1
  else 1 + jsSizeCap (bodyOf n) (cap - 1)
partial def jsSizeAltsCap : List N → Nat → Nat
  | [], _ => 0
  | alt :: alts, cap =>
    if cap == 0 then 0
    else
      let a := jsSizeCap (altBody alt) cap
      a + jsSizeAltsCap alts (cap - a)
end

structure JsAlts where
  next : Nat
  alts : List N
  deriving Inhabited

-- is one of the arguments a variable bound to a literal or to a box on the way to the jump
def jsAnyKnown (known : VSet) : List Int → Bool
  | [] => false
  | y :: ys => (y >= 0 && vsContainsI known y) || jsAnyKnown known ys

mutual
-- Every jump to j that carries something known (a variable bound to a literal or to a box on the way to it:
-- `known`), or every jump with `all`, is replaced by a copy of v under the jump's arguments, its bindings
-- renamed from `next` on. Without `all` a jump that knows nothing of its arguments stays a jump: its copy
-- would fold to what the join point already is.
partial def jsPut (all : Bool) (j : Nat) (ps : List Param) (v : N) (known : VSet) (n : N) (next : Nat) : NormR :=
  if n.op == opJmp then
    if jmpId n == j && (all || jsAnyKnown known (jmpArgs n)) then normGo v (joBind ps (jmpArgs n) imEmpty) next else { next := next, node := n }
  else if n.op == opVDecl then
    let e := vdeclExpr n
    let box := e.op == opPrim && (primOp e == primBox || primOp e == primBoxS)
    let r := jsPut all j ps v (if e.op == opLit || box then vsInsertI known (vdeclVar n : Int) else known) (bodyOf n) next
    { next := r.next, node := { n with kids := [e, r.node] } }
  else if n.op == opJDecl then
    let a := jsPut all j ps v known (jdeclBody n) next
    let b := jsPut all j ps v known (bodyOf n) a.next
    { next := b.next, node := { n with kids := [a.node, b.node] } }
  else if n.op == opCase then
    let r := jsPutAlts all j ps v known (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := jsPut all j ps v known (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def jsPutAlts (all : Bool) (j : Nat) (ps : List Param) (v : N) (known : VSet) : List N → Nat → JsAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := jsPut all j ps v known (altBody alt) next
    let r := jsPutAlts all j ps v known alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

mutual
partial def jsGo (n : N) (next : Nat) : NormR :=
  if n.op == opJDecl then
    let v := jsGo (jdeclBody n) next
    let b := jsGo (bodyOf n) v.next
    let sz := jsSizeCap v.node (jsLimit + 1)
    if joCount (jdeclId n) b.node >= 2 && sz <= jsLimit then
      -- the join point stays for the jumps that know nothing; with no jump left it is gone
      let r := jsPut (sz <= jsTiny) (jdeclId n) (jdeclParams n) v.node vsEmpty b.node b.next
      if joCount (jdeclId n) r.node == 0 then r else { next := r.next, node := { n with kids := [v.node, r.node] } }
    else { next := b.next, node := { n with kids := [v.node, b.node] } }
  else if n.op == opVDecl then
    let r := jsGo (bodyOf n) next
    { next := r.next, node := { n with kids := [vdeclExpr n, r.node] } }
  else if n.op == opCase then
    let r := jsAlts (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := jsGo (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def jsAlts : List N → Nat → JsAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := jsGo (altBody alt) next
    let r := jsAlts alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

def declJoinSmall (d : Decl) : Decl := if d.ext || declIsClosed d then d else { d with body := (jsGo d.body (declMaxIndex d + 1)).node }

def joinSmall : List Decl → List Decl
  | [] => []
  | d :: ds => declJoinSmall d :: joinSmall ds

/-! ## What is known of a variable -/

-- what a binding says: x, kind, payload, ...; kind 1 a literal (the payload its value), 2 the box of the
-- number in variable `payload` (`primBox`), 3 the box with its sign (`primBoxS`)
def knKind (x : Int) : List Int → Int
  | y :: k :: _ :: rest => if x == y then k else knKind x rest
  | _ => 0

def knPay (x : Int) : List Int → Int
  | y :: _ :: p :: rest => if x == y then p else knPay x rest
  | _ => 0

def knIsBox (x : Int) (env : List Int) : Bool := knKind x env == 2 || knKind x env == 3
def knIsLit (x : Int) (v : Int) (env : List Int) : Bool := knKind x env == 1 && knPay x env == v

-- the comparisons of two words, and their value on two literals far inside the machine's range
def knCmp (p : Nat) : Bool := p == primLt || p == primGt || p == primEq
def knSmall (v : Int) : Bool := v > -4611686018427387904 && v < 4611686018427387904
def knCmpVal (p : Nat) (a b : Int) : Bool := if p == primLt then a < b else if p == primGt then a > b else a == b

-- the alternative of a test on the literal v, when the test has one for it
def knAlt (v : Int) : List N → Option N
  | [] => none
  | alt :: alts => if alt.op == opAltCtor && ((infoOf alt).cidx : Int) == v && (infoOf alt).tid == 0 then some (altBody alt) else knAlt v alts

mutual
partial def knGo (env : List Int) (n : N) : N :=
  if n.op == opVDecl && n.ys.isEmpty then
    let e := vdeclExpr n
    let x : Int := (vdeclVar n : Int)
    let rest := bodyOf n
    let a := intAt 0 e.ys
    let b := intAt 1 e.ys
    if e.op == opLit then { n with kids := [e, knGo (x :: 1 :: e.a :: env) rest] }
    else if e.op != opPrim then { n with kids := [e, knGo env rest] }
    else if primOp e == primBox && a >= 0 then { n with kids := [e, knGo (x :: 2 :: a :: env) rest] }
    else if primOp e == primBoxS && a >= 0 then { n with kids := [e, knGo (x :: 3 :: a :: env) rest] }
    else if primOp e == primIsScalar && knIsBox a env then { n with kids := [mkLit 1, knGo (x :: 1 :: 1 :: env) rest] }
    else if primOp e == primUnboxS && knKind a env == 3 then knGo env (replaceVar x.toNat (knPay a env).toNat rest)
    else if primOp e == primUnbox && knKind a env == 2 then knGo env (replaceVar x.toNat (knPay a env).toNat rest)
    else if primOp e == primAnd && (knIsLit a 0 env || knIsLit b 0 env) then { n with kids := [mkLit 0, knGo (x :: 1 :: 0 :: env) rest] }
    else if primOp e == primAnd && knIsLit a 1 env && b >= 0 then knGo env (replaceVar x.toNat b.toNat rest)
    else if primOp e == primAnd && knIsLit b 1 env && a >= 0 then knGo env (replaceVar x.toNat a.toNat rest)
    else if knCmp (primOp e) && knKind a env == 1 && knKind b env == 1 && knSmall (knPay a env) && knSmall (knPay b env) then
      -- a comparison of two literals is its value (the machine's signed comparison, lib/lrc/Emit.rsd `emPrim`)
      let r : Int := if knCmpVal (primOp e) (knPay a env) (knPay b env) then 1 else 0
      { n with kids := [mkLit r, knGo (x :: 1 :: r :: env) rest] }
    else { n with kids := [e, knGo env rest] }
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, knGo env (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [knGo env (jdeclBody n), knGo env (bodyOf n)] }
  else if n.op == opCase then
    if knKind (caseVar n : Int) env == 1 then
      match knAlt (knPay (caseVar n : Int) env) (caseAlts n) with
      | some body => knGo env body
      | none => { n with kids := knAlts env (caseAlts n) }
    else { n with kids := knAlts env (caseAlts n) }
  else if isTerminal n then n
  else if (n.op == opInc || n.op == opDec) && knIsBox (rcVar n : Int) env then knGo env (bodyOf n)
  else setBody n (knGo env (bodyOf n))
partial def knAlts (env : List Int) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (knGo env (altBody alt)) :: knAlts env alts
end

def declFoldKnown (d : Decl) : Decl := if d.ext || declIsClosed d then d else { d with body := knGo [] d.body }

def foldKnown : List Decl → List Decl
  | [] => []
  | d :: ds => declFoldKnown d :: foldKnown ds

/-! ## A test goes down to the case that reads it

EmitC writes `x = a == b; if (x == 0)` and leaves it to the C compiler, which makes it one compare and one
branch. The wasm this stage writes is run as it is by a wasm engine, and there the word of the comparison is
made, widened and tested again (V8 on nqueens' inner loop: three such words for each list element; the same
module is at twice its native time). So the test and its branch are written as one by the emitter
(lib/lrc/Emit.rsd `emTest`), and for that the binding has to stand directly before its case. Here it is
brought there:

  * a binding of a test whose one reader is a case further down, with only declarations of join points
    between, moves down to that case (a `&&` of the source leaves the test above the join point that takes
    its value);
  * a case on the negation of a word is the case on the word, its alternatives exchanged.

Only operators on words move (`lt`, `gt`, `eq`, `not`, the test of a small number): they read no memory, so
nothing between can change them. Instruction selection of this kind is every code generator's (Aho, Sethi,
Ullman, Compilers, 9.2: a relational operator followed by a conditional jump is one instruction); the
exchange of the alternatives is `not` pushed into the branch. -/

def cdIsTest (e : N) : Bool :=
  e.op == opPrim &&
    (primOp e == primLt || primOp e == primGt || primOp e == primEq || primOp e == primNot || primOp e == primIsScalar)

def cdCountArgs (x : Int) : List Int → Nat
  | [] => 0
  | y :: ys => (if y == x then 1 else 0) + cdCountArgs x ys

mutual
-- how many times x is read in a body
partial def cdCount (x : Int) (n : N) : Nat :=
  if n.op == opVDecl then cdCountArgs x (exprArgs (vdeclExpr n)) + cdCount x (bodyOf n)
  else if n.op == opJDecl then cdCount x (jdeclBody n) + cdCount x (bodyOf n)
  else if n.op == opCase then (if n.a == x then 1 else 0) + cdCountAlts x (caseAlts n)
  else if n.op == opJmp then cdCountArgs x (jmpArgs n)
  else if n.op == opRet then cdCountArgs x (retArgs n)
  else if n.op == opUnreachable then 0
  else cdCountArgs x (insUses n) + cdCount x (bodyOf n)
partial def cdCountAlts (x : Int) : List N → Nat
  | [] => 0
  | alt :: alts => cdCount x (altBody alt) + cdCountAlts x alts
end

-- is a case on the word x what stands below, past the join points declared on the way
partial def cdCaseBelow (x : Int) (n : N) : Bool :=
  if n.op == opJDecl then cdCaseBelow x (bodyOf n)
  else n.op == opCase && n.a == x && tyIsScalar (caseTy n)

-- the body with the binding v directly before what stands below the join points declared on the way
partial def cdPut (v : N) (n : N) : N :=
  if n.op == opJDecl then { n with kids := [jdeclBody n, cdPut v (bodyOf n)] }
  else { v with kids := [vdeclExpr v, n] }

-- the two bodies of a case on a truth value: for 0 and for 1
structure CdTwo where
  ok : Bool
  zero : N
  one : N
  deriving Inhabited

def cdTwo (alts : List N) : CdTwo :=
  match alts with
  | [a, b] =>
    if !altIsDefault a && !altIsDefault b then
      (if a.a == 0 && b.a == 1 then { ok := true, zero := altBody a, one := altBody b }
       else if a.a == 1 && b.a == 0 then { ok := true, zero := altBody b, one := altBody a }
       else { ok := false, zero := a, one := b })
    else if !altIsDefault a && altIsDefault b then
      (if a.a == 0 then { ok := true, zero := altBody a, one := altBody b }
       else if a.a == 1 then { ok := true, zero := altBody b, one := altBody a }
       else { ok := false, zero := a, one := b })
    else if altIsDefault a && !altIsDefault b then
      (if b.a == 0 then { ok := true, zero := altBody b, one := altBody a }
       else if b.a == 1 then { ok := true, zero := altBody a, one := altBody b }
       else { ok := false, zero := a, one := b })
    else { ok := false, zero := a, one := b }
  | _ => { ok := false, zero := n0 opUnreachable, one := n0 opUnreachable }

mutual
partial def cdGo (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let k := bodyOf n
    if n.ys.isEmpty && cdIsTest e && k.op == opJDecl && cdCaseBelow n.a k && cdCount n.a k == 1 then
      cdGo (cdPut n k)
    else if n.ys.isEmpty && e.op == opPrim && primOp e == primNot && intAt 0 e.ys >= 0 && k.op == opCase && k.a == n.a
        && tyIsScalar (caseTy k) && cdCount n.a k == 1 && (cdTwo (caseAlts k)).ok then
      -- `not z` is 1 for z = 0 and 0 for every other word
      let two := cdTwo (caseAlts k)
      cdGo (mkCase (intAt 0 e.ys).toNat (caseTy k) [mkAltCtor (boolInfo 0) two.one, mkAltDefault two.zero])
    else { n with kids := [e, cdGo k] }
  else if n.op == opJDecl then { n with kids := [cdGo (jdeclBody n), cdGo (bodyOf n)] }
  else if n.op == opCase then { n with kids := cdAlts (caseAlts n) }
  else if isTerminal n then n
  else setBody n (cdGo (bodyOf n))
partial def cdAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (cdGo (altBody alt)) :: cdAlts alts
end

-- three rounds: the exchange leaves a case on a word whose own binding is above the join point
def condDown : List Decl → List Decl
  | [] => []
  | d :: ds => (if d.ext || declIsClosed d then d else { d with body := cdGo (cdGo (cdGo d.body)) }) :: condDown ds

/-! ## A counter that is a small number

Recursion on a natural number reaches the stage as a function whose parameter is a number of any size: an
object word, which is the box of a small number or a cell of limbs. Each round then asks which of the two it
has, more than once (the test for zero, the subtraction and the conversion to a word each ask, and each ends
in a join point that has forgotten the answer), although a small number that is counted down stays small.
nqueens-kk's `appendSafe` runs some forty instructions for its counter in every round where Koka's runs ten on
an int32, and those stand right behind the one branch of the round that cannot be predicted.

Such a function gets a second form that takes the number itself. This is the worker of the worker/wrapper
transformation (Peyton Jones and Launchbury, Unboxed values as first class citizens in a non-strict functional
language, FPCA 1991), made for the call pattern "the argument is a box" (Peyton Jones, Call-pattern
specialisation for Haskell programs, ICFP 2007):

  * the second form's body is the function's body under `p := box n` for each such parameter p, folded
    (`foldKnown`): the tests of p and the paths for a number of limbs are gone;
  * a join point that every jump enters with a box takes the number instead (`ubJoin`), so that what the
    short form of a subtraction hands on is known to be a box where it is read next;
  * a call of the function whose arguments at those places are boxes is a call of the second form with the
    numbers (`ubCall`); inside the second form that is its own recursion;
  * the function itself tests its arguments once, on entry: small numbers go to the second form, anything
    else to the body it had.

A function gets a second form only when that form then calls itself; otherwise nothing changes. The parameters
taken as numbers are all those the body tests for a small number. A function that also keeps a sum in such a
parameter gets none: a sum may leave the small numbers, so the call does not hand on a box there. (Taking the
counter alone was tried and is not done: cfold's `mkExpr` then has a second form that lib/lrc/Trmc.rsd rewrites,
which the function it was is not, and the whole program runs 4 percent longer under node;
reports/backend-opt-fable/LAND-COUNT.md.)

Fuel. The second form takes fuel as the function does (lib/lrc/Ir.rsd `isOwnFn`: a function after the stage's
own). The call on entry counts nothing (`mkFapSame`): the function was entered at that fuel. The second form's
call of itself stands where the function's call of itself stood, at the same depth, and counts the same.
Counting. A box is no heap object, so nothing is counted for the number; the other parameters keep their
ownership, in the second form and at each call of it.
Any word. The number taken on entry is the word without its low bit (`primUnbox`), and the second form makes the
word from it again (`primBox`): for every word that is a box the two are the same word, whatever the box stands
for. An integer below zero is such a word too (the upper half of the numbers, lib/lrc/Prim.rsd `primBoxS`); what
the body does with it, it does to the same word as before.

The body the function had stays for a number of limbs, and its calls are marked cold (`fapCold`): a function
that the emitter writes at its one call (lib/lrc/Emit.rsd "A function with one caller") is still written at
the call in the second form, where the rounds run, and is called from the old body. The entry's call of the
second form is marked too, so the second form is a function of the module and what it calls once is written
into it. This runs after the short forms are in their callers (lib/lrc/Inline.rsd `inlineDecls`). -/

-- a function f with its second form g, and the places of the parameters that g takes as numbers
structure UbW where
  f : Nat
  g : Nat
  ps : List Nat
  deriving Inhabited

def ubFind (f : Nat) : List UbW → Option UbW
  | [] => none
  | w :: ws => if w.f == f then some w else ubFind f ws

def ubHas (i : Nat) : List Nat → Bool
  | [] => false
  | p :: ps => p == i || ubHas i ps

-- the number in the box x, from the boxes bound on the way (x, n, x, n, ...); -1 when x is none of them
def ubRaw (x : Int) : List Int → Int
  | y :: r :: rest => if x == y then r else ubRaw x rest
  | _ => -1

-- the boxes bound on the way, with the binding n when it binds a box
def ubBind (n : N) (env : List Int) : List Int :=
  let e := vdeclExpr n
  if n.ys.isEmpty && e.op == opPrim && primOp e == primBox && intAt 0 e.ys >= 0 then n.a :: intAt 0 e.ys :: env else env

def ubArgAt : Nat → List Int → Int
  | _, [] => -1
  | 0, y :: _ => y
  | i + 1, _ :: ys => ubArgAt i ys

def ubSetAt (v : Int) : Nat → List Int → List Int
  | _, [] => []
  | 0, _ :: ys => v :: ys
  | i + 1, y :: ys => y :: ubSetAt v i ys

-- the arguments with the numbers at the places `ps`; `ok` when each argument at such a place is a box here
structure UbArgs where
  ok : Bool
  ys : List Int
  deriving Inhabited

def ubArgs (env : List Int) (ps : List Nat) : Nat → List Int → UbArgs
  | _, [] => { ok := true, ys := [] }
  | i, y :: ys =>
    let r := ubArgs env ps (i + 1) ys
    if ubHas i ps then { ok := r.ok && y >= 0 && ubRaw y env >= 0, ys := ubRaw y env :: r.ys }
    else { ok := r.ok, ys := y :: r.ys }

-- a call of a function that has a second form, with boxes at its places: the call of that form with the numbers
def ubCall (wk : List UbW) (env : List Int) (e : N) : N :=
  if e.op != opFap then e
  else
    match ubFind (fapFn e) wk with
    | none => e
    | some w =>
      let a := ubArgs env w.ps 0 e.ys
      if a.ok && e.ys.length > 0 then { e with a := (w.g : Int), ys := a.ys } else e

-- what the jumps to j carry at place i: 0 there is no jump, 1 each carries a box, 2 one does not
def ubBoth (a b : Nat) : Nat := if a == 2 || b == 2 then 2 else if a == 1 || b == 1 then 1 else 0

mutual
partial def ubJumps (j i : Nat) (env : List Int) (n : N) : Nat :=
  if n.op == opJmp then
    (if jmpId n != j then 0 else if ubRaw (ubArgAt i (jmpArgs n)) env >= 0 then 1 else 2)
  else if n.op == opVDecl then ubJumps j i (ubBind n env) (bodyOf n)
  else if n.op == opJDecl then ubBoth (ubJumps j i env (jdeclBody n)) (ubJumps j i env (bodyOf n))
  else if n.op == opCase then ubJumpsAlts j i env (caseAlts n)
  else if isTerminal n then 0
  else ubJumps j i env (bodyOf n)
partial def ubJumpsAlts (j i : Nat) (env : List Int) : List N → Nat
  | [] => 0
  | alt :: alts => ubBoth (ubJumps j i env (altBody alt)) (ubJumpsAlts j i env alts)
end

mutual
-- every jump to j with the number in place of the box at place i
partial def ubPut (j i : Nat) (env : List Int) (n : N) : N :=
  if n.op == opJmp then
    (if jmpId n != j then n else { n with ys := ubSetAt (ubRaw (ubArgAt i (jmpArgs n)) env) i (jmpArgs n) })
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, ubPut j i (ubBind n env) (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [ubPut j i env (jdeclBody n), ubPut j i env (bodyOf n)] }
  else if n.op == opCase then { n with kids := ubPutAlts j i env (caseAlts n) }
  else if isTerminal n then n
  else setBody n (ubPut j i env (bodyOf n))
partial def ubPutAlts (j i : Nat) (env : List Int) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (ubPut j i env (altBody alt)) :: ubPutAlts j i env alts
end

-- The join point j from its parameter at place i on: a parameter that every jump enters with a box takes the
-- number (a new variable, a word), and the box is bound again at the head of the join point's body.
-- `b` is the body with the jumps, `v` the join point's body.
structure UbJoin where
  next : Nat
  xs : List Param
  b : N
  v : N
  deriving Inhabited

def ubJoin (j : Nat) (env : List Int) : Nat → List Param → N → N → Nat → UbJoin
  | _, [], v, b, next => { next := next, xs := [], b := b, v := v }
  | i, p :: ps, v, b, next =>
    if tyIsObj p.ty && ubJumps j i env b == 1 then
      let v2 := mkVDecl p.x p.ty (mkPrim primBox 0 0 [(next : Int)]) v
      let r := ubJoin j env (i + 1) ps v2 (ubPut j i env b) (next + 1)
      { r with xs := { x := next, borrow := false, ty := tyI64 } :: r.xs }
    else
      let r := ubJoin j env (i + 1) ps v b next
      { r with xs := p :: r.xs }

structure UbAlts where
  next : Nat
  alts : List N
  deriving Inhabited

mutual
-- `wk`: the functions that have a second form; `env`: the boxes bound on the way; `next`: a fresh index
partial def ubGo (wk : List UbW) (env : List Int) (n : N) (next : Nat) : NormR :=
  if n.op == opVDecl then
    let r := ubGo wk (ubBind n env) (bodyOf n) next
    { next := r.next, node := { n with kids := [ubCall wk env (vdeclExpr n), r.node] } }
  else if n.op == opJDecl then
    -- the jumps first: what they carry decides the parameters
    let b := ubGo wk env (bodyOf n) next
    let jn := ubJoin (jdeclId n) env 0 (jdeclParams n) (jdeclBody n) b.node b.next
    let v := ubGo wk env jn.v jn.next
    { next := v.next, node := mkJDecl (jdeclId n) jn.xs v.node jn.b }
  else if n.op == opCase then
    let r := ubAlts wk env (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := ubGo wk env (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def ubAlts (wk : List UbW) (env : List Int) : List N → Nat → UbAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := ubGo wk env (altBody alt) next
    let r := ubAlts wk env alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

mutual
-- is the word x tested for a small number in the body
partial def ubTests (x : Int) (n : N) : Bool :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    (e.op == opPrim && primOp e == primIsScalar && intAt 0 e.ys == x) || ubTests x (bodyOf n)
  else if n.op == opJDecl then ubTests x (jdeclBody n) || ubTests x (bodyOf n)
  else if n.op == opCase then ubTestsAlts x (caseAlts n)
  else if isTerminal n then false
  else ubTests x (bodyOf n)
partial def ubTestsAlts (x : Int) : List N → Bool
  | [] => false
  | alt :: alts => ubTests x (altBody alt) || ubTestsAlts x alts
end

mutual
-- does the body call f
partial def ubCalls (f : Nat) (n : N) : Bool :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    (e.op == opFap && fapFn e == f) || ubCalls f (bodyOf n)
  else if n.op == opJDecl then ubCalls f (jdeclBody n) || ubCalls f (bodyOf n)
  else if n.op == opCase then ubCallsAlts f (caseAlts n)
  else if isTerminal n then false
  else ubCalls f (bodyOf n)
partial def ubCallsAlts (f : Nat) : List N → Bool
  | [] => false
  | alt :: alts => ubCalls f (altBody alt) || ubCallsAlts f alts
end

mutual
-- every ordinary call of the body marked cold (a closed constant keeps `fapClosed`, `d = 3`)
partial def ubCold (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    { n with kids := [(if e.op == opFap && e.d == 0 then { e with d := 1 } else e), ubCold (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [ubCold (jdeclBody n), ubCold (bodyOf n)] }
  else if n.op == opCase then { n with kids := ubColdAlts (caseAlts n) }
  else if isTerminal n then n
  else setBody n (ubCold (bodyOf n))
partial def ubColdAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (ubCold (altBody alt)) :: ubColdAlts alts
end

-- the places of the object parameters that the body tests for a small number
def ubPlaces (body : N) : Nat → List Param → List Nat
  | _, [] => []
  | i, p :: ps =>
    if tyIsObj p.ty && ubTests (p.x : Int) body then i :: ubPlaces body (i + 1) ps else ubPlaces body (i + 1) ps

-- the second form's parameters and body: at a place of `ps` the number, and its box bound under the parameter's name
structure UbForm where
  xs : List Param
  body : N
  deriving Inhabited

def ubForm (ps : List Nat) : Nat → List Param → N → Nat → UbForm
  | _, [], body, _ => { xs := [], body := body }
  | i, p :: rest, body, next =>
    if ubHas i ps then
      let r := ubForm ps (i + 1) rest (mkVDecl p.x p.ty (mkPrim primBox 0 0 [(next : Int)]) body) (next + 1)
      { xs := { x := next, borrow := false, ty := tyI64 } :: r.xs, body := r.body }
    else
      let r := ubForm ps (i + 1) rest body next
      { xs := p :: r.xs, body := r.body }

-- one round: what the boxes decide is folded, a join point with one jump left goes to it, and the join points
-- entered with boxes and the calls with boxes take numbers
def ubRound (wk : List UbW) (d : Decl) : Decl :=
  let d1 := declJoinOnce (declFoldKnown d)
  { d1 with body := (ubGo wk [] d1.body (declMaxIndex d1 + 1)).node }

-- three rounds: a short form inside a short form's join point (the conversion of a difference) needs the second,
-- the call that takes the difference the third
def ubSimp (wk : List UbW) (d : Decl) : Decl :=
  declJoinOnce (declFoldKnown (ubRound wk (ubRound wk (ubRound wk d))))

-- The function's body on entry, over the parameters from place i: a place of `w.ps` is tested and its number
-- taken; with small numbers at all of them the second form is called at this function's fuel, anything else
-- jumps to j, the body the function had. `args`: the call's arguments so far, the last first.
def ubEntry (w : UbW) (j : Nat) (rty : Int) : Nat → List Param → List Int → Nat → N
  | _, [], args, next => mkVDecl next rty { mkFapSame w.g args.reverse with d := 1 } (mkRet [(next : Int)])
  | i, p :: ps, args, next =>
    if ubHas i w.ps then
      let rest := ubEntry w j rty (i + 1) ps (((next + 1 : Nat) : Int) :: args) (next + 2)
      let small := mkVDecl (next + 1) tyI64 (mkPrim primUnbox 0 0 [(p.x : Int)]) rest
      mkVDecl next tyI64 (mkPrim primIsScalar 0 0 [(p.x : Int)]) (mkIfW next small (mkJmp j []))
    else ubEntry w j rty (i + 1) ps ((p.x : Int) :: args) next

/-! The second form's calls of the function. A call that hands on a word of unknown form at one of the places (a
sum, which may leave the small numbers) stays a call of the function, and the function's entry sends a small number
on to the second form again. As the last step of a round that is a round through two functions: under wasm each
keeps its frame while the other runs, where the loop that the function was held one frame (binarytrees-kk's `checkv`
ran out of 900 MB of stack under node; a C compiler makes a jump of each call and hides it). So the entry's test
stands at such a call: with small numbers at all the places it is the second form's call of itself, which is a jump,
and a number of limbs goes to the function as before. This is the wrapper of the worker/wrapper transformation put
where it is called (Peyton Jones and Launchbury 1991: the wrapper is inlined at every call, the worker's own
included). -/

-- The call e of w.f, in tail position, from argument i on: a place of `w.ps` whose argument is a box bound on the
-- way gives its number, any other word there is tested and its number taken; with numbers at all the places the
-- second form is called (at the same depth: the same fuel), and where a test fails `orig` stands, the call as it
-- was. `args`: the second form's arguments so far, the last first. Each test takes two fresh indices from `next`.
def ubWrapCall (w : UbW) (env : List Int) (e : N) (ty : Int) (orig : N) : Nat → List Int → List Int → Nat → N
  | _, [], args, next => mkVDecl next ty { e with a := (w.g : Int), ys := args.reverse } (mkRet [(next : Int)])
  | i, y :: ys, args, next =>
    if !ubHas i w.ps then ubWrapCall w env e ty orig (i + 1) ys (y :: args) next
    else if y >= 0 && ubRaw y env >= 0 then ubWrapCall w env e ty orig (i + 1) ys (ubRaw y env :: args) next
    else if y < 0 then orig
    else
      let small := mkVDecl (next + 1) tyI64 (mkPrim primUnbox 0 0 [y])
        (ubWrapCall w env e ty orig (i + 1) ys (((next + 1 : Nat) : Int) :: args) (next + 2))
      mkVDecl next tyI64 (mkPrim primIsScalar 0 0 [y]) (mkIfW next small orig)

mutual
-- every call of w.f that is the body's last step and hands on a word of unknown form: the test, then the call
partial def ubWrapGo (w : UbW) (np : Nat) (env : List Int) (n : N) (next : Nat) : NormR :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    let k := bodyOf n
    if e.op == opFap && fapFn e == w.f && n.ys.isEmpty && e.ys.length == np && k.op == opRet && retArgs k == [n.a] then
      { next := next + 2 * np + 1, node := ubWrapCall w env e (vdeclTy n) n 0 e.ys [] next }
    else
      let r := ubWrapGo w np (ubBind n env) k next
      { next := r.next, node := { n with kids := [e, r.node] } }
  else if n.op == opJDecl then
    let v := ubWrapGo w np env (jdeclBody n) next
    let b := ubWrapGo w np env (bodyOf n) v.next
    { next := b.next, node := { n with kids := [v.node, b.node] } }
  else if n.op == opCase then
    let r := ubWrapAlts w np env (caseAlts n) next
    { next := r.next, node := { n with kids := r.alts } }
  else if isTerminal n then { next := next, node := n }
  else
    let r := ubWrapGo w np env (bodyOf n) next
    { next := r.next, node := setBody n r.node }
partial def ubWrapAlts (w : UbW) (np : Nat) (env : List Int) : List N → Nat → UbAlts
  | [], next => { next := next, alts := [] }
  | alt :: alts, next =>
    let a := ubWrapGo w np env (altBody alt) next
    let r := ubWrapAlts w np env alts a.next
    { next := r.next, alts := altSetBody alt a.node :: r.alts }
end

def ubWrap (w : UbW) (np : Nat) (d : Decl) : Decl :=
  { d with body := (ubWrapGo w np [] d.body (declMaxIndex d + 1)).node }

-- a function that takes fuel, has one result that is a word or an object, and calls itself
def ubApplies (nImg : Nat) (d : Decl) : Bool :=
  !d.ext && !declIsClosed d && !isOwnFn nImg d.f && d.rets.length == 1 && !tyIsIrr (intAt 0 d.rets) && ubCalls d.f d.body

-- the second form of d as function g, folded
def ubSecond (d : Decl) (g : Nat) (ps : List Nat) : Decl :=
  let fm := ubForm ps 0 d.xs d.body (declMaxIndex d + 1)
  let w : UbW := { f := d.f, g := g, ps := ps }
  ubWrap w d.xs.length (ubSimp [w] { f := g, xs := fm.xs, rets := d.rets, body := fm.body, ext := false })

structure UbR where
  decls : List Decl
  added : List Decl
  deriving Inhabited

def ubDecls (nImg : Nat) : Nat → List Decl → UbR
  | _, [] => { decls := [], added := [] }
  | next, d :: ds =>
    let ps := if ubApplies nImg d then ubPlaces d.body 0 d.xs else []
    let g := if ps.isEmpty then d else ubSecond d next ps
    if !ps.isEmpty && ubCalls next g.body then
      let r := ubDecls nImg (next + 1) ds
      let m := declMaxIndex d
      let entry := ubEntry { f := d.f, g := next, ps := ps } (m + 1) (intAt 0 d.rets) 0 d.xs [] (m + 2)
      { decls := declNormalizeIds { d with body := mkJDecl (m + 1) [] (ubCold d.body) entry } :: r.decls,
        added := declNormalizeIds g :: r.added }
    else
      let r := ubDecls nImg next ds
      { decls := d :: r.decls, added := r.added }

-- The declarations are numbered 0, 1, ... in their order (lib/lrc/Trmc.rsd `trmc` relies on it too); the second
-- forms follow them.
def unboxCounters (nImg : Nat) (decls : List Decl) : List Decl :=
  let r := ubDecls nImg decls.length decls
  r.decls ++ r.added

/-! ## A call that names a literal

A function of a natural number is often written with an equation for 0 and one that hands on, and called with
the literal: the library's map (lib/AvlMap.rsd) has `size 0 m`, `kid 0 xs`, `box 0 m`, `delta 0`, `map0 0`,
where the number only makes the definition total. Such a function tests on every call what its caller wrote
down, and no call of it goes where it is called, because the other equation calls the function again
(lib/lrc/Inline.rsd: a function of a cycle is never inlined). A C compiler reads the same program with the
test decided and the body in place.

So a call that names a literal gets a form of the function for it. This is call-pattern specialisation for the
pattern "the argument is this literal" (Peyton Jones, Call-pattern specialisation for Haskell programs, ICFP
2007; the cloning of interprocedural constant propagation, Callahan, Cooper, Kennedy and Torczon, SIGPLAN 1986):

  * the form of f for the literal c at place i is f's body under `p := c` (or the box of c), folded
    (`foldKnown`: the test of a box, the number taken out of it, a comparison of two literals, the case a
    literal decides);
  * it is kept only when it no longer calls f: the literal chose an equation that does not hand on. A function
    that counts down from the literal keeps its call, and its test;
  * every call of f with that literal at that place is a call of the form. It takes the function's arguments,
    the literal among them, and is entered as the function is.

A small form then goes where it is called (lib/lrc/Pipeline.rsd: `inlineDecls` once more, before the second
forms for counters are made). A larger one stays a function: what the literal leaves of f, without the test
and without a call of itself, so that it is no loop and a compiler behind the module may write it into its
callers (the map's `mk` and `bal` are of this kind).

Only a function that calls itself gets one (another is small and inlined, or large and stays a call), and only
one of at most `lcWide` times `limit` instructions (`limit`: the inliner's bound for a small function): the work
is a folding of the function for each literal it is called with, and a form that is not small is a second copy
of most of its function (GHC bounds the function its pass specialises in the same way,
`-fspec-constr-threshold`). The form is for the first place of a call that holds a literal, and a function has
at most `lcPerFn` of them.

Fuel. A form is a function after the stage's own and takes fuel as the function does; the call of it stands
where the call of f stood, at the same depth; its guards and calls are f's. Folding removes only what a literal
decides, so the form has f's outcome at every budget for the calls that are rewritten.
Counting. A box is no heap object: where the parameter was counted, nothing is (`foldKnown`). The other
parameters keep their ownership. -/

-- what a call's argument is: 1 a literal, 2 the box of one, 3 the box with the sign rule of one; 0 anything else
def lcKind (env : List Int) (y : Int) : Int :=
  if y < 0 then 0
  else if knKind y env == 1 then 1
  else if (knKind y env == 2 || knKind y env == 3) && knKind (knPay y env) env == 1 then knKind y env
  else 0

def lcVal (env : List Int) (y : Int) : Int :=
  if knKind y env == 1 then knPay y env else knPay (knPay y env) env

-- the first place of a call's arguments that holds a literal: place, kind, value; no place: kind 0
structure LcAt where
  i : Nat
  kind : Int
  c : Int
  deriving Inhabited

def lcFirst (env : List Int) : Nat → List Int → LcAt
  | _, [] => { i := 0, kind := 0, c := 0 }
  | i, y :: ys => if lcKind env y != 0 then { i := i, kind := lcKind env y, c := lcVal env y } else lcFirst env (i + 1) ys

-- what a binding says, as `knGo` enters it
def lcBind (n : N) (env : List Int) : List Int :=
  let e := vdeclExpr n
  let x : Int := (vdeclVar n : Int)
  if !n.ys.isEmpty then env
  else if e.op == opLit then x :: 1 :: e.a :: env
  else if e.op == opPrim && primOp e == primBox && intAt 0 e.ys >= 0 then x :: 2 :: intAt 0 e.ys :: env
  else if e.op == opPrim && primOp e == primBoxS && intAt 0 e.ys >= 0 then x :: 3 :: intAt 0 e.ys :: env
  else env

-- the key of a call with a literal: function, place, kind, value; a form's entry has its function after them
def lcKeyOf (w : List Int) : List Int := [intAt 0 w, intAt 1 w, intAt 2 w, intAt 3 w]

def lcHas (key : List Int) : List (List Int) → Bool
  | [] => false
  | k :: ks => k == key || lcHas key ks

-- a function of more than this many times the bound of a small one gets no form (the map's `bal` has 327
-- instructions where it is read)
def lcWide : Nat := 16

-- The functions that may get a form: not the stage's own (they take no fuel), calling itself, of at most
-- `lcWide` times `limit` instructions.
def lcCands (nImg limit : Nat) : List Decl → VSet → VSet
  | [], s => s
  | d :: ds, s =>
    lcCands nImg limit ds (if !d.ext && !declIsClosed d && !isOwnFn nImg d.f && jsSizeCap d.body (lcWide * limit + 1) <= lcWide * limit && ubCalls d.f d.body then vsInsert s d.f else s)

structure LcSitesAcc where
  seen : LTree
  list : List (List Int)
  deriving Inhabited

def lcSiteHash (f i kind c : Int) : Int :=
  f * 65537 + i * 257 + kind * 17 + (c % 65521)

def lcBucketHas (f i kind c : Int) : List Int → Bool
  | a :: b :: k :: v :: rest => (a == f && b == i && k == kind && v == c) || lcBucketHas f i kind c rest
  | _ => false

mutual
-- the calls of such functions with a literal: for each, the function, the place, the kind and the value
partial def lcSitesGo (cands : VSet) (env : List Int) (n : N) (a : LcSitesAcc) : LcSitesAcc :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    if e.op == opFap && vsContains cands (fapFn e) then
      let la := lcFirst env 0 e.ys
      if la.kind == 0 then lcSitesGo cands env (bodyOf n) a
      else
        let f : Int := (fapFn e : Int)
        let i : Int := (la.i : Int)
        let h := lcSiteHash f i la.kind la.c
        let b := ltFind a.seen h
        if lcBucketHas f i la.kind la.c b then lcSitesGo cands env (bodyOf n) a
        else lcSitesGo cands env (bodyOf n) { seen := ltPut a.seen h (f :: i :: la.kind :: la.c :: b), list := [f, i, la.kind, la.c] :: a.list }
    else lcSitesGo cands (lcBind n env) (bodyOf n) a
  else if n.op == opJDecl then lcSitesGo cands env (bodyOf n) (lcSitesGo cands env (jdeclBody n) a)
  else if n.op == opCase then lcSitesAltsGo cands env (caseAlts n) a
  else if isTerminal n then a
  else lcSitesGo cands env (bodyOf n) a
partial def lcSitesAltsGo (cands : VSet) (env : List Int) : List N → LcSitesAcc → LcSitesAcc
  | [], a => a
  | alt :: alts, a => lcSitesAltsGo cands env alts (lcSitesGo cands env (altBody alt) a)
end

def lcSitesDeclsGo (cands : VSet) : List Decl → LcSitesAcc → LcSitesAcc
  | [], a => a
  | d :: ds, a => lcSitesDeclsGo cands ds (if d.ext || declIsClosed d then a else lcSitesGo cands [] d.body a)

def lcParam : Nat → List Param → Option Param
  | _, [] => none
  | 0, p :: _ => some p
  | i + 1, _ :: ps => lcParam i ps

-- at most this many forms of one function
def lcPerFn : Nat := 2

-- The form of d as function g for the literal c at place i: d's body with the parameter bound to the literal (or
-- its box), folded. None when the parameter is not of the literal's kind (a literal stands for a scalar of a
-- word or of a field's width, a box for an object that may be one), or the form still calls d.
def lcForm (d : Decl) (g i : Nat) (kind c : Int) : Option Decl :=
  match lcParam i d.xs with
  | none => none
  | some p =>
    if kind == 1 && p.ty != tyI64 && (p.ty < 10 || p.ty > 12) then none
    else if kind != 1 && p.ty != tyTObj then none
    else
      let m := declMaxIndex d
      let y := if kind == 1 then m + 1 else m + 2
      let body := replaceVar p.x y d.body
      let boxed := mkVDecl (m + 2) tyTObj (mkPrim (if kind == 2 then primBox else primBoxS) 0 0 [((m + 1 : Nat) : Int)]) body
      let d1 : Decl := { d with f := g, body := mkVDecl (m + 1) (if kind == 1 then p.ty else tyI64) (mkLit c) (if kind == 1 then body else boxed) }
      let d2 := declJoinOnce (declFoldKnown (declJoinOnce (declFoldKnown d1)))
      if ubCalls d.f d2.body then none else some (declNormalizeIds d2)

structure LcR where
  ws : List (List Int)
  -- for each function `f`: flat entries `i :: kind :: c :: g :: ...` (at most `lcPerFn` forms)
  byFn : LTree := lt0
  -- the functions that have one
  has : VSet
  added : List Decl
  deriving Inhabited

def lcFnCount : List Int → Nat
  | _ :: _ :: _ :: _ :: rest => 1 + lcFnCount rest
  | _ => 0

def lcFnFind (i kind c : Int) : List Int → Int
  | i0 :: k0 :: c0 :: g :: rest => if i0 == i && k0 == kind && c0 == c then g else lcFnFind i kind c rest
  | _ => -1

-- the forms of the sites, numbered from `next` on
def lcForms (ds : DeclTab) : Nat → List (List Int) → LcR → LcR
  | _, [], r => r
  | next, key :: keys, r =>
    let fi := intAt 0 key
    let f := fi.toNat
    match dtFind ds f with
    | some d =>
      let cur := ltFind r.byFn fi
      if lcFnCount cur >= lcPerFn then lcForms ds next keys r
      else
        let i := intAt 1 key
        let kind := intAt 2 key
        let c := intAt 3 key
        match lcForm d next i.toNat kind c with
        | some g =>
          lcForms ds (next + 1) keys
            { ws := [],
              byFn := ltPut r.byFn fi (i :: kind :: c :: (next : Int) :: cur),
              has := vsInsert r.has f,
              added := g :: r.added }
        | none => lcForms ds next keys r
    | none => lcForms ds next keys r

-- the form for a call's key, or -1
def lcFind : List Int → LTree → Int
  | [f, i, kind, c], ws => lcFnFind i kind c (ltFind ws f)
  | _, _ => -1

mutual
-- every call with a literal that has a form calls the form
partial def lcPut (has : VSet) (ws : LTree) (env : List Int) (n : N) : N :=
  if n.op == opVDecl then
    let e := vdeclExpr n
    if e.op == opFap && vsContains has (fapFn e) then
      let la := lcFirst env 0 e.ys
      let g := if la.kind != 0 then lcFind [(fapFn e : Int), (la.i : Int), la.kind, la.c] ws else -1
      { n with kids := [(if g >= 0 then { e with a := g } else e), lcPut has ws env (bodyOf n)] }
    else { n with kids := [e, lcPut has ws (lcBind n env) (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [lcPut has ws env (jdeclBody n), lcPut has ws env (bodyOf n)] }
  else if n.op == opCase then { n with kids := lcPutAlts has ws env (caseAlts n) }
  else if isTerminal n then n
  else setBody n (lcPut has ws env (bodyOf n))
partial def lcPutAlts (has : VSet) (ws : LTree) (env : List Int) : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (lcPut has ws env (altBody alt)) :: lcPutAlts has ws env alts
end

def lcPutDecls (has : VSet) (ws : LTree) : List Decl → List Decl
  | [] => []
  | d :: ds => (if d.ext || declIsClosed d then d else { d with body := lcPut has ws [] d.body }) :: lcPutDecls has ws ds

-- The declarations are numbered 0, 1, ... in their order; the forms follow them. `limit`: the inliner's bound for
-- a small function. The list is returned as it is when no call gets a form.
def literalCalls (nImg limit : Nat) (decls : List Decl) : List Decl :=
  if !declsDense 0 decls then decls
  else
    let keys := (lcSitesDeclsGo (lcCands nImg limit decls vsEmpty) decls { seen := lt0, list := [] }).list
    let r := lcForms (dtOfList decls) decls.length keys.reverse { ws := [], has := vsEmpty, added := [] }
    if r.added.isEmpty then decls else lcPutDecls r.has r.byFn (decls ++ r.added.reverse)

end Lrc
