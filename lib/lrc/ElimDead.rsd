-- LRC: remove bindings and join points that nothing uses.
-- A port of Lean 4.14.0 src/lean/Lean/Compiler/IR/ElimDeadVars.lean, cited as ElimDeadVars:LINE.
-- closure_claim = 0.
--
-- One difference, behind `keepRefusing`. Lean's IR is total, so Lean drops any binding whose
-- variable is dead (ElimDeadVars:26). A wire computation may refuse (fuel, a stuck match, checked arithmetic),
-- and the refusal is the program's outcome. With `keepRefusing` a dead binding stays when its
-- expression is a call or a primitive that is not total (lib/lrc/Prim.rsd `primTotal`). The stage
-- runs with it on; the comparison with Lean's pass runs with it off.
import Lib.Lrc.AlphaEqv
import Lib.Lrc.Prim

namespace Lrc

def edRefuses (e : N) : Bool :=
  (e.op == opFap && !fapClosed e) || (e.op == opPrim && !primTotal (primOp e))

def edAnyUsed (used : VSet) : List Nat → Bool
  | [] => false
  | x :: xs => vsContains used x || edAnyUsed used xs

structure EdR where
  node : N
  used : VSet
  deriving Inhabited

structure EdAlts where
  alts : List N
  used : VSet
  deriving Inhabited

def edRev : List N → List N → List N
  | [], acc => acc
  | x :: xs, acc => edRev xs (x :: acc)

def edEraseBinds (used : VSet) (curr : N) : VSet :=
  let u0 := if curr.a >= 0 then vsErase used curr.a.toNat else used
  if curr.ys.isEmpty then u0 else vsEraseAll u0 (bindVars curr.ys)

mutual
-- ElimDeadVars:12 reshapeWithoutDead. `bsRev` holds the instructions before the terminal, the
-- last one first; `b` is the body built so far; `used` the free indices of `b`.
partial def edReshape (keepRefusing : Bool) (bsRev : List N) (b : N) (used : VSet) : EdR :=
  match bsRev with
  | [] => { node := b, used := used }
  | curr :: rest =>
    let keep :=
      if curr.op == opVDecl then
        edAnyUsed used (bindVars (vdeclBinds curr)) || (keepRefusing && edRefuses (vdeclExpr curr))
      else if curr.op == opJDecl then vsContains used (jdeclId curr)
      else true
    if !keep then edReshape keepRefusing rest b used
    else if curr.op == opJDecl then
      let rj := edWalk keepRefusing (jdeclBody curr)
      let jFree := if curr.ys.isEmpty then rj.used else vsEraseAll rj.used (paramVars (jdeclParams curr))
      edReshape keepRefusing rest (setBody (jdeclSetBody curr rj.node) b) (vsUnion (vsErase used (jdeclId curr)) jFree)
    else
      let used := if curr.op == opVDecl then edEraseBinds used curr else used
      edReshape keepRefusing rest (setBody curr b) (collectFreeIndices curr used)

-- ElimDeadVars:32 FnBody.elimDead
partial def edWalk (keepRefusing : Bool) (b : N) : EdR :=
  let f := flatten b
  if f.term.op == opCase then
    let ra := edAlts keepRefusing (caseAlts f.term) [] (freeIdx f.term.a vsEmpty vsEmpty)
    edReshape keepRefusing (edRev f.bs []) { f.term with kids := ra.alts } ra.used
  else
    edReshape keepRefusing (edRev f.bs []) f.term (freeIndices f.term)

partial def edAlts (keepRefusing : Bool) : List N → List N → VSet → EdAlts
  | [], acc, used => { alts := edRev acc [], used := used }
  | alt :: alts, acc, used =>
    let r := edWalk keepRefusing (altBody alt)
    edAlts keepRefusing alts (altSetBody alt r.node :: acc) (vsUnion used r.used)
end

def elimDeadBody (keepRefusing : Bool) (b : N) : N :=
  (edWalk keepRefusing b).node

-- ElimDeadVars:43 Decl.elimDead, as Lean has it
def declElimDead (d : Decl) : Decl :=
  if d.ext then d else { d with body := elimDeadBody false d.body }

-- the form the stage runs
def declElimDeadKeep (d : Decl) : Decl :=
  if d.ext then d else { d with body := elimDeadBody true d.body }

end Lrc
