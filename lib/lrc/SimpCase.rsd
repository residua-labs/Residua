-- LRC: simplify `case`: drop unreachable alternatives, drop a case with one alternative, merge
-- the most common alternative into a default.
-- A port of Lean 4.14.0 src/lean/Lean/Compiler/IR/SimpCase.lean, cited as SimpCase:LINE.
-- closure_claim = 0.
-- absent: ensureHasDefault
--   (`ensureHasDefault` is not used by Lean's simpCase (ExpandResetReuse and EmitC call it); it is ported with its first user)
import Lib.Lrc.AlphaEqv

namespace Lrc

def scAnyDefault : List N → Bool
  | [] => false
  | alt :: alts => altIsDefault alt || scAnyDefault alts

-- SimpCase:20 getOccsOf: the alternatives from this one on whose body equals this one's
def scOccs (body : N) : List N → Nat
  | [] => 0
  | alt :: alts => (if bodyEq (altBody alt) body then 1 else 0) + scOccs body alts

structure ScMax where
  alt : N
  n : Nat
  deriving Inhabited

-- SimpCase:28 maxOccs: the first alternative with the largest count
def scMaxGo : List N → ScMax → ScMax
  | [], m => m
  | alt :: alts, m =>
    let curr := scOccs (altBody alt) (alt :: alts)
    scMaxGo alts (if curr > m.n then { alt := alt, n := curr } else m)

def scFilterNe (body : N) : List N → List N
  | [] => []
  | alt :: alts => if bodyEq (altBody alt) body then scFilterNe body alts else alt :: scFilterNe body alts

-- SimpCase:38 addDefault
def scAddDefault (alts : List N) : List N :=
  match alts with
  | [] => alts
  | [_] => alts
  | first :: rest =>
    if scAnyDefault alts then alts
    else
      let m := scMaxGo rest { alt := first, n := scOccs (altBody first) alts }
      if m.n == 1 then alts
      else scFilterNe (altBody m.alt) alts ++ [mkAltDefault (altBody m.alt)]

-- SimpCase:47 filterUnreachable
def scFilterUnreachable : List N → List N
  | [] => []
  | alt :: alts =>
    if (altBody alt).op == opUnreachable then scFilterUnreachable alts else alt :: scFilterUnreachable alts

-- SimpCase:50 mkSimpCase
def scMkCase (term : N) (alts : List N) : N :=
  let alts := scAddDefault (scFilterUnreachable alts)
  match alts with
  | [] => mkUnreachable
  | [alt] => altBody alt
  | _ => { term with kids := alts }

mutual
-- SimpCase:60 FnBody.simpCase
partial def simpCaseBody (b : N) : N :=
  let f := flatten b
  let bs := scJPs f.bs
  if f.term.op == opCase then reshape bs (scMkCase f.term (scAlts (caseAlts f.term)))
  else reshape bs f.term
partial def scJPs : List N → List N
  | [] => []
  | b :: bs => (if b.op == opJDecl then jdeclSetBody b (simpCaseBody (jdeclBody b)) else b) :: scJPs bs
partial def scAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (simpCaseBody (altBody alt)) :: scAlts alts
end

-- SimpCase:73 Decl.simpCase
def declSimpCase (d : Decl) : Decl :=
  if d.ext then d else { d with body := simpCaseBody d.body }

/-! ## A case in the default alternative of a case on the same variable

The front end writes a match on a type of several constructors as a chain: the test for one constructor, and in
its default alternative the test for the next. Lean's IR has one `case` with an alternative for each
constructor, and its passes are written for that form. ResetReuse gives a variable its `reset` in one `case`
only (lib/lrc/ResetReuse.rsd `alreadyFound`, ResetReuse.lean:170): in a chain that is the first link, so
the cell of any constructor but the first is never reused, and the function that matches is left to borrow its
argument and to build every result new (cfold on the Koka suite's expression type: no reset in the whole
function). The emitter also reads the tag once for a `case` (lib/lrc/Emit.rsd `emAlts`), so once for each link.

Here the chain becomes the one `case`: where the default alternative of a `case` on an object holds nothing but
a `case` on the same variable, that inner `case`'s alternatives take its place. GHC's simplifier does the same
under the name of case merging (GHC.Core.Opt.Simplify.Utils `mkCase`, Note [Merge Nested Cases]).
Sound because both tests read one variable, which nothing between them can change; an alternative of the inner
`case` for a constructor that the outer one has is never taken, and is left out. -/

-- is there an alternative for constructor c
def mcHas (c : Nat) : List N → Bool
  | [] => false
  | alt :: alts => (!altIsDefault alt && (infoOf alt).cidx == c) || mcHas c alts

-- the inner alternatives that the outer ones leave open
def mcNew (outer : List N) : List N → List N
  | [] => []
  | alt :: alts =>
    if !altIsDefault alt && mcHas (infoOf alt).cidx outer then mcNew outer alts else alt :: mcNew outer alts

def mcNoDefault : List N → List N
  | [] => []
  | alt :: alts => if altIsDefault alt then mcNoDefault alts else alt :: mcNoDefault alts

-- the alternatives of a case on x of type ty with the chain's next link merged in; none when there is no such link
def mcMerge (x ty : Int) : List N → List N → List N
  | _, [] => []
  | all, alt :: alts =>
    let b := altBody alt
    if altIsDefault alt && b.op == opCase && b.a == x && b.b == ty then
      let own := mcNoDefault all
      own ++ mcNew own (caseAlts b)
    else mcMerge x ty all alts

mutual
partial def mcGo (n : N) : N :=
  if n.op == opCase then
    -- the inner links first: a chain of three is merged from its end
    let alts := mcAlts (caseAlts n)
    let m := if tyIsObj (caseTy n) then mcMerge n.a n.b alts alts else []
    { n with kids := (if m.isEmpty then alts else m) }
  else if n.op == opVDecl then { n with kids := [vdeclExpr n, mcGo (bodyOf n)] }
  else if n.op == opJDecl then { n with kids := [mcGo (jdeclBody n), mcGo (bodyOf n)] }
  else if isTerminal n then n
  else setBody n (mcGo (bodyOf n))
partial def mcAlts : List N → List N
  | [] => []
  | alt :: alts => altSetBody alt (mcGo (altBody alt)) :: mcAlts alts
end

def mergeCases : List Decl → List Decl
  | [] => []
  | d :: ds => (if d.ext then d else { d with body := mcGo d.body }) :: mergeCases ds

end Lrc
