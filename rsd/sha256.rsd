-- rsd/sha256.rsd — in-process sha256 over ByteArray, extracted verbatim
-- from lib/olean/Olean.rsd (same definitions, same Lib.Olean namespace) so
-- both the dispatcher and the compiler hash without a shasum subprocess.
-- The hasher is a transport, the digest is the identity.
-- closure_claim = 0.

namespace Lib.Olean

def rotr (x : UInt32) (n : Nat) : UInt32 :=
  (x >>> UInt32.ofNat n) ||| (x <<< UInt32.ofNat (32 - n))

def shr (x : UInt32) (n : Nat) : UInt32 :=
  x >>> UInt32.ofNat n

def sig0 (x : UInt32) : UInt32 := rotr x 7 ^^^ rotr x 18 ^^^ shr x 3
def sig1 (x : UInt32) : UInt32 := rotr x 17 ^^^ rotr x 19 ^^^ shr x 10
def big0 (x : UInt32) : UInt32 := rotr x 2 ^^^ rotr x 13 ^^^ rotr x 22
def big1 (x : UInt32) : UInt32 := rotr x 6 ^^^ rotr x 11 ^^^ rotr x 25
def ch (e f g : UInt32) : UInt32 := (e &&& f) ^^^ ((~~~ e) &&& g)
def maj (a b c : UInt32) : UInt32 := (a &&& b) ^^^ (a &&& c) ^^^ (b &&& c)

def k256 : Array UInt32 := #[
  UInt32.ofNat 0x428a2f98, UInt32.ofNat 0x71374491, UInt32.ofNat 0xb5c0fbcf, UInt32.ofNat 0xe9b5dba5,
  UInt32.ofNat 0x3956c25b, UInt32.ofNat 0x59f111f1, UInt32.ofNat 0x923f82a4, UInt32.ofNat 0xab1c5ed5,
  UInt32.ofNat 0xd807aa98, UInt32.ofNat 0x12835b01, UInt32.ofNat 0x243185be, UInt32.ofNat 0x550c7dc3,
  UInt32.ofNat 0x72be5d74, UInt32.ofNat 0x80deb1fe, UInt32.ofNat 0x9bdc06a7, UInt32.ofNat 0xc19bf174,
  UInt32.ofNat 0xe49b69c1, UInt32.ofNat 0xefbe4786, UInt32.ofNat 0x0fc19dc6, UInt32.ofNat 0x240ca1cc,
  UInt32.ofNat 0x2de92c6f, UInt32.ofNat 0x4a7484aa, UInt32.ofNat 0x5cb0a9dc, UInt32.ofNat 0x76f988da,
  UInt32.ofNat 0x983e5152, UInt32.ofNat 0xa831c66d, UInt32.ofNat 0xb00327c8, UInt32.ofNat 0xbf597fc7,
  UInt32.ofNat 0xc6e00bf3, UInt32.ofNat 0xd5a79147, UInt32.ofNat 0x06ca6351, UInt32.ofNat 0x14292967,
  UInt32.ofNat 0x27b70a85, UInt32.ofNat 0x2e1b2138, UInt32.ofNat 0x4d2c6dfc, UInt32.ofNat 0x53380d13,
  UInt32.ofNat 0x650a7354, UInt32.ofNat 0x766a0abb, UInt32.ofNat 0x81c2c92e, UInt32.ofNat 0x92722c85,
  UInt32.ofNat 0xa2bfe8a1, UInt32.ofNat 0xa81a664b, UInt32.ofNat 0xc24b8b70, UInt32.ofNat 0xc76c51a3,
  UInt32.ofNat 0xd192e819, UInt32.ofNat 0xd6990624, UInt32.ofNat 0xf40e3585, UInt32.ofNat 0x106aa070,
  UInt32.ofNat 0x19a4c116, UInt32.ofNat 0x1e376c08, UInt32.ofNat 0x2748774c, UInt32.ofNat 0x34b0bcb5,
  UInt32.ofNat 0x391c0cb3, UInt32.ofNat 0x4ed8aa4a, UInt32.ofNat 0x5b9cca4f, UInt32.ofNat 0x682e6ff3,
  UInt32.ofNat 0x748f82ee, UInt32.ofNat 0x78a5636f, UInt32.ofNat 0x84c87814, UInt32.ofNat 0x8cc70208,
  UInt32.ofNat 0x90befffa, UInt32.ofNat 0xa4506ceb, UInt32.ofNat 0xbef9a3f7, UInt32.ofNat 0xc67178f2]

def u32be (b : ByteArray) (i : Nat) : UInt32 :=
  let w (k : Nat) := UInt32.ofNat (b.get! (i + k)).toNat
  (w 0 <<< 24) ||| (w 1 <<< 16) ||| (w 2 <<< 8) ||| w 3

def compress (h : Array UInt32) (blk : ByteArray) : Array UInt32 := Id.run do
  let mut w : Array UInt32 := Array.mkEmpty 64
  for i in [0:16] do
    w := w.push (u32be blk (i * 4))
  for i in [16:64] do
    w := w.push (w[i - 16]! + sig0 w[i - 15]! + w[i - 7]! + sig1 w[i - 2]!)
  let mut a := h[0]!
  let mut b := h[1]!
  let mut c := h[2]!
  let mut d := h[3]!
  let mut e := h[4]!
  let mut f := h[5]!
  let mut g := h[6]!
  let mut hh := h[7]!
  for i in [0:64] do
    let t1 := hh + big1 e + ch e f g + k256[i]! + w[i]!
    let t2 := big0 a + maj a b c
    hh := g
    g := f
    f := e
    e := d + t1
    d := c
    c := b
    b := a
    a := t1 + t2
  #[h[0]! + a, h[1]! + b, h[2]! + c, h[3]! + d, h[4]! + e, h[5]! + f, h[6]! + g, h[7]! + hh]

partial def loadW (src : ByteArray) (base i : Nat) (w : Array UInt32) : Array UInt32 :=
  if i >= 16 then w
  else loadW src base (i + 1) (w.set! i (u32be src (base + i * 4)))

partial def extendW (i : Nat) (w : Array UInt32) : Array UInt32 :=
  if i >= 64 then w
  else
    let v := w[i - 16]! + sig0 w[i - 15]! + w[i - 7]! + sig1 w[i - 2]!
    extendW (i + 1) (w.set! i v)

partial def compressRounds (w : Array UInt32) (i : Nat)
    (a b c d e f g hh : UInt32) (h0 h1 h2 h3 h4 h5 h6 h7 : UInt32)
    (msg tail : ByteArray) (fullBlocks totalBlocks blk : Nat) : ByteArray :=
  if i < 64 then
    let t1 := hh + big1 e + ch e f g + k256[i]! + w[i]!
    let t2 := big0 a + maj a b c
    compressRounds w (i + 1) (t1 + t2) a b c (d + t1) e f g h0 h1 h2 h3 h4 h5 h6 h7 msg tail fullBlocks totalBlocks blk
  else
    let h0' := h0 + a
    let h1' := h1 + b
    let h2' := h2 + c
    let h3' := h3 + d
    let h4' := h4 + e
    let h5' := h5 + f
    let h6' := h6 + g
    let h7' := h7 + hh
    let blk' := blk + 1
    if blk' < totalBlocks then
      let src := if blk' < fullBlocks then msg else tail
      let base := if blk' < fullBlocks then blk' * 64 else (blk' - fullBlocks) * 64
      let w1 := extendW 16 (loadW src base 0 w)
      compressRounds w1 0 h0' h1' h2' h3' h4' h5' h6' h7' h0' h1' h2' h3' h4' h5' h6' h7' msg tail fullBlocks totalBlocks blk'
    else
      Id.run do
        let mut out := ByteArray.mkEmpty 32
        for word in #[h0', h1', h2', h3', h4', h5', h6', h7'] do
          out := out.push (UInt8.ofNat (word >>> UInt32.ofNat 24).toNat)
          out := out.push (UInt8.ofNat ((word >>> UInt32.ofNat 16).toNat % 256))
          out := out.push (UInt8.ofNat ((word >>> UInt32.ofNat 8).toNat % 256))
          out := out.push (UInt8.ofNat (word.toNat % 256))
        return out

def sha256 (msg : ByteArray) : ByteArray :=
  let len := msg.size
  let fullBlocks := len / 64
  let rem := len % 64
  let tailLen := if rem < 56 then 64 else 128
  let tail := Id.run do
    let mut t := ByteArray.mkEmpty tailLen
    for i in [0:rem] do
      t := t.push (msg.get! (fullBlocks * 64 + i))
    t := t.push 0x80
    while t.size < tailLen - 8 do
      t := t.push 0
    let bitLen : UInt64 := len.toUInt64 * 8
    for i in [0:8] do
      let shift : UInt64 := ((7 - i) * 8).toUInt64
      t := t.push ((bitLen >>> shift) &&& 0xff).toUInt8
    return t
  let totalBlocks := fullBlocks + tailLen / 64
  let src0 := if 0 < fullBlocks then msg else tail
  let w0 := extendW 16 (loadW src0 0 0 (Array.mkArray 64 0))
  compressRounds w0 0
    0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19
    0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19
    msg tail fullBlocks totalBlocks 0

def hexByte (n : Nat) : UInt8 :=
  let d := n % 16
  UInt8.ofNat (if d < 10 then 48 + d else 87 + d)

def hexOf (b : ByteArray) : String := Id.run do
  let mut o := ByteArray.mkEmpty (2 * b.size)
  for byte in b do
    let v := byte.toNat
    o := o.push (hexByte (v / 16))
    o := o.push (hexByte (v % 16))
  (String.fromUTF8? o).getD ""

def sha256Hex (b : ByteArray) : String := hexOf (sha256 b)

def sha256SelfTest : Bool :=
  sha256Hex ("".toUTF8) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    && sha256Hex ("abc".toUTF8) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

end Lib.Olean
