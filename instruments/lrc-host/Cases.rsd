-- LRC host oracle: written IR cases (stock Lean only). closure_claim = 0.
-- Parameters are numbered from 1 in order, as Lean's IR producer numbers them. Type 1 is a binary
-- tree (constructor 0 a leaf without fields, constructor 1 a node with two children and 16 bytes of
-- scalars), type 2 a list (constructor 0 nil, constructor 1 a cell with head and tail).
namespace Lrc.Host

def leafI : Lrc.CtorInfo := { cidx := 0, size := 0, ssize := 0, tid := 1 }
def nodeI : Lrc.CtorInfo := { cidx := 1, size := 2, ssize := 16, tid := 1 }
def nilI : Lrc.CtorInfo := { cidx := 0, size := 0, ssize := 0, tid := 2 }
def consI : Lrc.CtorInfo := { cidx := 1, size := 2, ssize := 0, tid := 2 }

def pO (x : Nat) : Lrc.Param := { x := x, borrow := false, ty := Lrc.tyTObj }
def pS (x : Nat) : Lrc.Param := { x := x, borrow := false, ty := Lrc.tyI64 }
def fn (f : Nat) (xs : List Lrc.Param) (ret : Int) (body : Lrc.N) : Lrc.Decl :=
  { f := f, xs := xs, rets := [ret], body := body, ext := false }
def ext (f : Nat) (xs : List Lrc.Param) (ret : Int) : Lrc.Decl :=
  { f := f, xs := xs, rets := [ret], body := Lrc.mkUnreachable, ext := true }

open Lrc in
-- f0 isRed t: projections bound before the case that only one branch uses
def cIsRed : Lrc.Decl :=
  fn 0 [pO 1] tyI64
    (mkCase 1 tyTObj
      [mkAltCtor leafI (mkVDecl 2 tyI64 (mkLit 0) (mkRet [2])),
       mkAltCtor nodeI
         (mkVDecl 3 tyI64 (mkSProj 2 0 1)
         (mkVDecl 4 tyTObj (mkProj 0 1)
         (mkVDecl 5 tyI64 (mkSProj 2 8 1)
         (mkVDecl 6 tyTObj (mkProj 1 1)
         (mkVDecl 7 tyI64 (mkLit 0)
         (mkVDecl 8 tyI64 (mkPrim 14 0 0 [3, 7])
         (mkIfW 8 (mkVDecl 9 tyI64 (mkLit 1) (mkRet [9])) (mkVDecl 10 tyI64 (mkLit 0) (mkRet [10])))))))))])

open Lrc in
-- f1 ins t k: rebuilds the node it matched on both paths
def cIns : Lrc.Decl :=
  fn 1 [pO 1, pS 2] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor leafI
         (mkVDecl 3 tyTObj (mkCtor leafI [])
         (mkVDecl 4 tyTObj (mkCtor leafI [])
         (mkVDecl 5 tyTObj (mkCtor nodeI [3, 4])
         (mkVDecl 6 tyI64 (mkLit 0)
         (mkSSet 5 2 0 6 tyI64
         (mkSSet 5 2 8 2 tyI64 (mkRet [5]))))))),
       mkAltCtor nodeI
         (mkVDecl 7 tyI64 (mkSProj 2 0 1)
         (mkVDecl 8 tyTObj (mkProj 0 1)
         (mkVDecl 9 tyI64 (mkSProj 2 8 1)
         (mkVDecl 10 tyTObj (mkProj 1 1)
         (mkVDecl 11 tyI64 (mkPrim 12 0 0 [2, 9])
         (mkIfW 11
           (mkVDecl 12 tyTObj (mkFap 1 [8, 2])
           (mkVDecl 13 tyTObj (mkCtor nodeI [12, 10])
           (mkSSet 13 2 0 7 tyI64 (mkSSet 13 2 8 9 tyI64 (mkRet [13])))))
           (mkVDecl 14 tyTObj (mkFap 1 [10, 2])
           (mkVDecl 15 tyTObj (mkCtor nodeI [8, 14])
           (mkSSet 15 2 0 7 tyI64 (mkSSet 15 2 8 9 tyI64 (mkRet [15])))))))))))])

open Lrc in
-- f2 swap t: a default alternative that returns the scrutinee
def cSwap : Lrc.Decl :=
  fn 2 [pO 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor nodeI
         (mkVDecl 2 tyTObj (mkProj 0 1)
         (mkVDecl 3 tyTObj (mkProj 1 1)
         (mkVDecl 4 tyTObj (mkCtor nodeI [3, 2]) (mkRet [4])))),
       mkAltDefault (mkRet [1])])

open Lrc in
-- f3 join t u: a join point whose body reads a variable of the enclosing body
def cJoin : Lrc.Decl :=
  fn 3 [pO 1, pO 2] tyTObj
    (mkJDecl 10 [pO 11]
      (mkVDecl 12 tyTObj (mkCtor nodeI [11, 2]) (mkRet [12]))
      (mkCase 1 tyTObj
        [mkAltCtor leafI (mkVDecl 3 tyTObj (mkCtor leafI []) (mkJmp 10 [3])),
         mkAltCtor nodeI (mkVDecl 4 tyTObj (mkProj 0 1) (mkJmp 10 [4]))]))

open Lrc in
-- f4 len xs acc: a tail call with a scalar accumulator
def cLen : Lrc.Decl :=
  fn 4 [pO 1, pS 2] tyI64
    (mkCase 1 tyTObj
      [mkAltCtor nilI (mkRet [2]),
       mkAltCtor consI
         (mkVDecl 3 tyTObj (mkProj 0 1)
         (mkVDecl 4 tyTObj (mkProj 1 1)
         (mkVDecl 5 tyI64 (mkLit 1)
         (mkVDecl 6 tyI64 (mkPrim 6 0 0 [2, 5])
         (mkVDecl 7 tyI64 (mkFap 4 [4, 6]) (mkRet [7]))))))])

open Lrc in
-- f5 map xs: one cell built for each cell matched
def cMap : Lrc.Decl :=
  fn 5 [pO 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor nilI (mkVDecl 2 tyTObj (mkCtor nilI []) (mkRet [2])),
       mkAltCtor consI
         (mkVDecl 3 tyTObj (mkProj 0 1)
         (mkVDecl 4 tyTObj (mkProj 1 1)
         (mkVDecl 5 tyTObj (mkFap 6 [3])
         (mkVDecl 6 tyTObj (mkFap 5 [4])
         (mkVDecl 7 tyTObj (mkCtor consI [5, 6]) (mkRet [7]))))))])

open Lrc in
-- f6 id x
def cId : Lrc.Decl := fn 6 [pO 1] tyTObj (mkRet [1])

open Lrc in
-- f7 dead x y: bindings nothing reads, an irrelevant argument, an unreachable alternative
def cDead : Lrc.Decl :=
  fn 7 [pO 1, pO 2] tyTObj
    (mkVDecl 3 tyTObj (mkProj 0 1)
    (mkVDecl 4 tyTObj (mkCtor consI [2, argIrr])
    (mkVDecl 5 tyI64 (mkLit 7)
    (mkCase 2 tyTObj
      [mkAltCtor nilI mkUnreachable,
       mkAltDefault (mkVDecl 6 tyTObj (mkFap 6 [2]) (mkRet [6]))]))))

open Lrc in
-- f8 head2 xs: a nested match, the inner one on a projection of the outer
def cNested : Lrc.Decl :=
  fn 8 [pO 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor nilI (mkVDecl 2 tyTObj (mkCtor nilI []) (mkRet [2])),
       mkAltCtor consI
         (mkVDecl 3 tyTObj (mkProj 0 1)
         (mkVDecl 4 tyTObj (mkProj 1 1)
         (mkCase 4 tyTObj
           [mkAltCtor nilI (mkRet [3]),
            mkAltCtor consI
              (mkVDecl 5 tyTObj (mkProj 0 4)
              (mkVDecl 6 tyTObj (mkProj 1 4)
              (mkVDecl 7 tyTObj (mkCtor consI [5, 6])
              (mkVDecl 8 tyTObj (mkCtor consI [3, 7]) (mkRet [8])))))])))])

-- Type 3 has three constructors: 0 and 1 hold one object field, 2 holds none.
def t3a : Lrc.CtorInfo := { cidx := 0, size := 1, ssize := 0, tid := 3 }
def t3b : Lrc.CtorInfo := { cidx := 1, size := 1, ssize := 0, tid := 3 }
def t3c : Lrc.CtorInfo := { cidx := 2, size := 0, ssize := 0, tid := 3 }

open Lrc in
-- f9 deadJoin x: a join point nothing jumps to
def cDeadJoin : Lrc.Decl :=
  fn 9 [pO 1] tyTObj
    (mkJDecl 10 [pO 11] (mkRet [11])
      (mkVDecl 2 tyTObj (mkFap 6 [1]) (mkRet [2])))

open Lrc in
-- f10 twoJoins x y: two alternatives jump to one join point and a third to another, with the
-- same argument; only the first two have equal bodies
def cTwoJoins : Lrc.Decl :=
  fn 10 [pO 1, pO 2] tyTObj
    (mkJDecl 20 [pO 21] (mkVDecl 22 tyTObj (mkFap 6 [21]) (mkRet [22]))
    (mkJDecl 30 [pO 31] (mkVDecl 32 tyTObj (mkCtor consI [31, 31]) (mkRet [32]))
      (mkCase 1 tyTObj
        [mkAltCtor t3a (mkJmp 20 [2]),
         mkAltCtor t3b (mkJmp 30 [2]),
         mkAltCtor t3c (mkJmp 20 [2])])))

open Lrc in
-- f11 alphaAlts x: two alternatives that differ only in the name of a bound variable
def cAlphaAlts : Lrc.Decl :=
  fn 11 [pO 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor t3a (mkVDecl 2 tyTObj (mkProj 0 1) (mkVDecl 3 tyTObj (mkFap 6 [2]) (mkRet [3]))),
       mkAltCtor t3b (mkVDecl 4 tyTObj (mkProj 0 1) (mkVDecl 5 tyTObj (mkFap 6 [4]) (mkRet [5]))),
       mkAltCtor t3c (mkRet [1])])

open Lrc in
-- f12 constLeaf x: every path returns the same constant constructor
def cConstLeaf : Lrc.Decl :=
  fn 12 [pO 1] tyTObj (mkVDecl 2 tyTObj (mkCtor leafI []) (mkRet [2]))

open Lrc in
-- f13 caseOnCall x: a case on the result of f12; the node alternative cannot be reached
def cCaseOnCall : Lrc.Decl :=
  fn 13 [pO 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 12 [1])
    (mkCase 2 tyTObj
      [mkAltCtor leafI (mkRet [1]),
       mkAltCtor nodeI (mkVDecl 3 tyTObj (mkProj 0 2) (mkRet [3]))]))

open Lrc in
-- f14 localKnown x: a case on a constructor built two lines above, and one on its projection
def cLocalKnown : Lrc.Decl :=
  fn 14 [pO 1] tyTObj
    (mkVDecl 2 tyTObj (mkCtor leafI [])
    (mkVDecl 3 tyTObj (mkCtor nodeI [2, 1])
    (mkCase 3 tyTObj
      [mkAltCtor leafI (mkRet [1]),
       mkAltCtor nodeI
         (mkVDecl 4 tyTObj (mkProj 0 3)
         (mkCase 4 tyTObj
           [mkAltCtor leafI (mkRet [3]),
            mkAltCtor nodeI (mkVDecl 5 tyTObj (mkFap 6 [4]) (mkRet [5]))]))])))

open Lrc in
-- f15 knownThroughJoin x: a join point that receives the same constructor from both jumps
def cKnownThroughJoin : Lrc.Decl :=
  fn 15 [pO 1, pS 2] tyTObj
    (mkJDecl 10 [pO 11]
      (mkCase 11 tyTObj
        [mkAltCtor leafI (mkRet [1]),
         mkAltCtor nodeI (mkVDecl 12 tyTObj (mkProj 1 11) (mkRet [12]))])
      (mkIfW 2
        (mkVDecl 3 tyTObj (mkCtor leafI []) (mkJmp 10 [3]))
        (mkVDecl 4 tyTObj (mkCtor leafI []) (mkJmp 10 [4]))))

open Lrc in
-- f16 callExt x y: one call of the declaration without a body f21, whose first parameter is
-- borrowed and whose second is owned
def cCallExt : Lrc.Decl :=
  fn 16 [pO 1, pO 2] tyTObj (mkVDecl 3 tyTObj (mkFap 21 [1, 2]) (mkRet [3]))

open Lrc in
-- f17 callExtTwice x y: y goes to the owned parameter of f21 and is read again by a second call,
-- at the borrowed one; the first result goes to the owned one
def cCallExtTwice : Lrc.Decl :=
  fn 17 [pO 1, pO 2] tyTObj
    (mkVDecl 3 tyTObj (mkFap 21 [1, 2])
    (mkVDecl 4 tyTObj (mkFap 21 [2, 3]) (mkRet [4])))

open Lrc in
-- f18 projOwned x c d: x is owned (it goes to the owned parameter of f21), so its projections are
-- owned (Borrow.lean:247, the `proj` case of collectExpr), and through the jumps so is the join point's parameter, which the
-- join point itself only reads
def cProjOwned : Lrc.Decl :=
  fn 18 [pO 1, pS 2, pS 3] tyTObj
    (mkJDecl 10 [pO 11] (mkVDecl 12 tyTObj (mkProj 0 11) (mkRet [12]))
      (mkVDecl 4 tyTObj (mkProj 0 1)
      (mkVDecl 5 tyTObj (mkProj 1 1)
      (mkVDecl 6 tyTObj (mkFap 21 [4, 1])
      (mkIfW 2 (mkJmp 10 [4]) (mkIfW 3 (mkJmp 10 [5]) (mkRet [6])))))))

def cases : List Prog :=
  [{ name := "written", decls := [cIsRed, cIns, cSwap, cJoin, cLen, cMap, cId, cDead, cNested, cDeadJoin, cTwoJoins,
      cAlphaAlts, cConstLeaf, cCaseOnCall, cLocalKnown, cKnownThroughJoin, cCallExt, cCallExtTwice, cProjOwned,
      ext 20 [{ x := 1, borrow := true, ty := Lrc.tyI64 }, { x := 2, borrow := true, ty := Lrc.tyI64 }] Lrc.tyI64,
      ext 21 [{ x := 1, borrow := true, ty := Lrc.tyTObj }, { x := 2, borrow := false, ty := Lrc.tyTObj }] Lrc.tyTObj] }]

end Lrc.Host
