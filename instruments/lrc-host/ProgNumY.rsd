-- The program of the row numxnum of Images.tsv, whose image is not the front end's: as instruments/lrc-host/ProgNumX.rsd
-- without any read of the String. In the row's image `rawNum` reads the String's node, so that node is written by the
-- image with the wire's own list and read only as a packed number.
structure S where
  n : Nat
  s : String
  kids : List S

def mkS (n : Nat) : S :=
  { n := n, s := " abcdefghijklmnopqrstuvwxyzABCDEF", kids := [] : S }

def rawNum (x : S) : Nat := x.n

def xNum : Nat := rawNum (mkS 300)
