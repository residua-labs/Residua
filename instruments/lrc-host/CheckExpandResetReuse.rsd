-- LRC host oracle: the check of lib/lrc/ExpandResetReuse.rsd against Lean's IR/ExpandResetReuse.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:55, after explicitRC.
def check_ExpandResetReuse (staged : List Staged) (_lean : List Prog) : IO Nat :=
  checkDeclPass "expandResetReuse" (·.rc) (·.err) Lrc.declExpandResetReuse staged

end Lrc.Host
