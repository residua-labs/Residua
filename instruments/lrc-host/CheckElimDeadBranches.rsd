-- LRC host oracle: the check of lib/lrc/ElimDeadBranches.rsd against Lean's IR/ElimDeadBranches.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:36, the first pass, on the whole program.
def check_ElimDeadBranches (staged : List Staged) (_lean : List Prog) : IO Nat :=
  checkProgPass "elimDeadBranches" (·.init) (·.edb) Lrc.elimDeadBranches staged

-- the pass alone on the program whose variable and join point share an index
-- (instruments/lrc-host/CasesEdb.rsd `caseEdbSharedIndex`)
def checkEdbSharedIndex (env : Lean.Environment) : IO Nat := do
  match stage env caseEdbSharedIndex with
  | .error e =>
    IO.println s!"MISMATCH pass=elimDeadBranches program=written_edb_shared_index not staged: {e}"
    return 1
  | .ok st => checkProgPass "elimDeadBranches (an index shared by a variable and a join point)" (·.init) (·.edb) Lrc.elimDeadBranches [st]

end Lrc.Host
