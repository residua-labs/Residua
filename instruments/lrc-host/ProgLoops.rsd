-- LRC host program (instruments/lrc-host/Images.tsv): the loops of the wire.
-- closure_claim = 0.
--
-- The frontend writes `List.take` as a bounded fixpoint and `List.reverse`, `List.getLast?` as
-- bounded folds (instruments/rsdc-ml/rsdc.ml `listTakeW`, `splitReverseW`, `containerBody`).
-- lib/lrc/FromWire.rsd turns each into a function of its own that is called at the caller's
-- fuel ("Loops"). The rows of Images.tsv give what stock Lean 4.14 evaluates each entry to.
def build : Nat → Int → List Int
  | 0, _ => []
  | k + 1, x => x :: build k (x + 3)

def sumGo : List Int → Int → Int
  | [], acc => acc
  | x :: xs, acc => sumGo xs (acc * 31 + x)

def takeSum (n k : Int) : Int := sumGo ((build n.toNat 1).take k.toNat) 7

def revSum (n : Int) : Int := sumGo (build n.toNat 1).reverse 7

def dropTake (n a b : Int) : Int := sumGo (((build n.toNat 5).drop a.toNat).take b.toNat) 1

def lastOr (n : Int) : Int :=
  match (build n.toNat 2).getLast? with
  | some v => v
  | none => -1

def sq (x : Int) : Int := x * x + 1

-- a fold whose body calls a function and reads a variable of the function around it
def sqSum (n : Int) : Int := (build n.toNat 1).foldl (fun acc e => acc * 3 + sq e + n) 0

-- the same one call deeper: `sqSum` has this one caller, and the stage puts its body here
def sqPlus (n : Int) : Int := sqSum n + 1

-- `map` is a fold too, and its body reads `n`
def mapSum (n : Int) : Int := sumGo ((build n.toNat 1).map (fun (e : Int) => sq e + n)) 7

def down : Nat → Int
  | 0 => 0
  | k + 1 => 1 + down k

-- a fold whose body needs ten more calls of depth than anything before the fold
def deepSum (n : Int) : Int := (build n.toNat 1).foldl (fun acc e => acc + down (e.toNat + 9)) 0

-- with `deepSum` put here by the stage, the fold runs one call deeper than this function:
-- at fuel 12 the innermost `down` has none left, at 13 it has
def deepPlus (n : Int) : Int := deepSum n + 1
