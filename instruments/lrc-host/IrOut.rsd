-- LRC host oracle: an image's IR after Lean's own pipeline, written as integers (stock Lean only).
-- closure_claim = 0. The form, for reading beside the stage's own IR: a node is op a b c d, the count and
-- items of ys, the count of kids and the kids; a declaration is f, ext, the count and triples of the
-- parameters, the count and items of the result types, the body; the file starts with the count
-- of declarations, one per function of the image in order.
namespace Lrc.Host

partial def irNodeInts (n : Lrc.N) : List Int :=
  [(n.op : Int), n.a, n.b, n.c, n.d, (n.ys.length : Int)] ++ n.ys ++ [(n.kids.length : Int)] ++ (n.kids.map irNodeInts).flatten

def irDeclInts (d : Lrc.Decl) : List Int :=
  [(d.f : Int), (if d.ext then 1 else 0), (d.xs.length : Int)] ++ Lrc.paramsTo d.xs ++ [(d.rets.length : Int)] ++ d.rets
    ++ irNodeInts d.body

-- the declarations Lean's pipeline produced, back in the image's order; a function without a body
-- keeps its place
def irText (all : List Lrc.Decl) (final : List Lrc.Decl) : String :=
  let ordered := all.map fun d => match final.find? (·.f == d.f) with
    | some x => x
    | none => d
  " ".intercalate ((((ordered.length : Int) :: (ordered.map irDeclInts).flatten)).map toString)

-- every image row whose program Lean's pipeline takes: its final IR to out/lrc/img/NAME.ir
def writeIrs (env : Lean.Environment) (rows : List ImageRow) : IO Unit := do
  for r in rows do
    let bytes := (← IO.FS.readBinFile r.path).toList.map (fun b => (b.toNat : Int))
    match imageAdmit bytes r.kinds with
    | .ok (.ok im) =>
      match (stage env { name := r.name, decls := im.decls }).bind (fun st => canonDecls st.pp2) with
      | .ok final =>
        let out := s!"out/lrc/img/{r.name}.ir"
        IO.FS.writeFile out (irText im.decls final)
        IO.println s!"ir image={r.name} file={out} declarations={im.decls.length} with_body={final.length}"
      | .error e => IO.println s!"ir image={r.name} no Lean form: {e}"
    | .ok (.error e) => IO.println s!"ir image={r.name} not admitted: {refusalText e}"
    | .error e => IO.println s!"ir image={r.name} load refused: {e}"

end Lrc.Host
