-- micro program for the short forms of the integer operations (lib/lrc/FromWire.rsd "Magnitudes"):
-- every operation on small numbers, on numbers around 2^56 (where a magnitude stops being a small
-- number) and around 2^28 (where a product of two stops being one), on zero, and on both signs.
def b56 : Nat := 72057594037927936

def b28 : Nat := 268435456

def c56 : Int := 72057594037927936

def c28 : Int := 268435456

def natOps (a b : Nat) : List Nat :=
  [a + b, a - b, b - a, a * b, a / b, a % b, b / a, b % a,
   (if a < b then 1 else 0), (if a <= b then 1 else 0), (if a > b then 1 else 0), (if a >= b then 1 else 0),
   (if a == b then 1 else 0)]

def intOps (a b : Int) : List Int :=
  [a + b, a - b, b - a, a * b, a / b, a % b, b / a, b % a, -a, -b,
   (if a < b then 1 else 0), (if a <= b then 1 else 0), (if a > b then 1 else 0), (if a >= b then 1 else 0),
   (if a == b then 1 else 0)]

def magNat : List Nat :=
  natOps 0 0 ++ natOps 0 1 ++ natOps 1 0 ++ natOps 7 3 ++ natOps 255 256 ++ natOps 65535 65536
    ++ natOps (b56 - 1) 1 ++ natOps (b56 - 1) (b56 - 1) ++ natOps b56 1 ++ natOps b56 b56
    ++ natOps (b56 + 5) (b56 - 3) ++ natOps b28 b28 ++ natOps (b28 - 1) (b28 + 1) ++ natOps (b28 * b28) 3
    ++ natOps 12345678901234567890 987654321

def magInt : List Int :=
  intOps 0 0 ++ intOps 0 1 ++ intOps 1 0 ++ intOps 7 3 ++ intOps (0 - 7) 3 ++ intOps 7 (0 - 3)
    ++ intOps (0 - 7) (0 - 3) ++ intOps 0 (0 - 5) ++ intOps (c56 - 1) 1 ++ intOps (1 - c56) 1
    ++ intOps (c56 - 1) (1 - c56) ++ intOps c56 (0 - c56) ++ intOps (c56 + 5) (3 - c56) ++ intOps c28 c28
    ++ intOps (0 - c28) c28 ++ intOps (c28 - 1) (0 - (c28 + 1)) ++ intOps 12345678901234567890 (0 - 987654321)

-- a loop on small numbers: the sum of k * k % 7 for k below n
def magLoop : Nat → Nat → Nat
  | 0, acc => acc
  | k + 1, acc => magLoop k (acc + k * k % 7)

def magSum : Nat := magLoop 300 0
