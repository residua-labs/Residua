-- micro program for arrays in the stage (lib/lrc/FromWire.rsd "Arrays"): an array built by pushes, read at
-- an index, written at an index, cut, made into a list and back, held by two values at once, and nested.
def pushTo : Nat → Array Nat → Array Nat
  | 0, a => a
  | k + 1, a => pushTo k (a.push (k * k + 1))

def sumIdx : Nat → Array Nat → Nat → Nat
  | 0, _, acc => acc
  | k + 1, a, acc => sumIdx k a (acc + a.getD k 0 * (k + 1))

def bump : Nat → Array Nat → Array Nat
  | 0, a => a
  | k + 1, a => bump k (a.setD k (a.getD k 0 + k))

def arrList : List Nat := (pushTo 20 (Array.mkEmpty 4)).toList

def arrSum : Nat := sumIdx 50 (pushTo 50 (Array.mkEmpty 4)) 0

def arrSet : List Nat := (bump 12 (pushTo 12 (Array.mkEmpty 0))).toList

def arrCut : List Nat :=
  ((pushTo 30 (Array.mkEmpty 0)).extract 5 11).toList ++ ((pushTo 9 (Array.mkEmpty 0)).extract 7 40).toList

-- an array that two values hold: a write through one leaves the other as it was
def arrShare : List Nat :=
  let a : Array Nat := pushTo 6 (Array.mkEmpty 0);
  let b : Array Nat := a.setD 2 1000;
  let c : Array Nat := a.push 77;
  a.toList ++ b.toList ++ c.toList

-- reads and writes outside the array, the empty array, a list made an array and grown
def arrEdge : List Nat :=
  let a : Array Nat := pushTo 5 (Array.mkEmpty 0);
  let e : Array Nat := Array.mkEmpty 0;
  [a.getD 100 7, (a.setD 100 5).size, e.size, a.size, e.getD 0 9, (a.toList.toArray.push 5).size, (e.setD 0 1).size]

-- arrays of arrays: rows of different lengths, one row replaced, one read
def rowsTo : Nat → Array (Array Nat) → Array (Array Nat)
  | 0, r => r
  | k + 1, r => rowsTo k (r.push (pushTo (k % 4) (Array.mkEmpty 0)))

def rowSizes : Nat → Array (Array Nat) → List Nat → List Nat
  | 0, _, acc => acc
  | k + 1, r, acc => rowSizes k r ((r.getD k (Array.mkEmpty 0)).size :: acc)

def arrNest : List Nat :=
  let r : Array (Array Nat) := rowsTo 9 (Array.mkEmpty 0);
  let s : Array (Array Nat) := r.setD 3 ((r.getD 3 (Array.mkEmpty 0)).push 42);
  rowSizes 9 r [] ++ rowSizes 9 s [] ++ (s.getD 3 (Array.mkEmpty 0)).toList

-- integers with a sign as elements, and a list taken apart after it was an array
def intsTo : Nat → Array Int → Array Int
  | 0, a => a
  | k + 1, a => intsTo k (a.push (Int.ofNat k - 3))

def sumList : List Int → Int → Int
  | [], acc => acc
  | x :: xs, acc => sumList xs (acc + x * x)

def arrInts : List Int :=
  let a : Array Int := intsTo 8 (Array.mkEmpty 0);
  [sumList a.toList 0, a.getD 0 0, a.getD 7 0, sumList ((a.setD 1 (0 - 50)).toList) 0] ++ (a.extract 2 5).toList

-- objects of an inductive type as elements: the stage's classes follow them through an array
inductive Tr where
  | leaf : Tr
  | node : Tr → Nat → Tr → Tr

def trSum : Tr → Nat
  | Tr.leaf => 0
  | Tr.node l v r => trSum l + v + trSum r

def trees : Nat → Array Tr → Array Tr
  | 0, a => a
  | k + 1, a => trees k (a.push (Tr.node (a.getD 0 Tr.leaf) (k + 1) Tr.leaf))

def trSumList : List Tr → Nat → Nat
  | [], acc => acc
  | t :: ts, acc => trSumList ts (acc + trSum t)

def arrTrees : List Nat :=
  let a : Array Tr := trees 6 (Array.mkEmpty 0);
  let b : Array Tr := a.setD 2 Tr.leaf;
  [trSum (a.getD 5 Tr.leaf), trSum (a.getD 0 Tr.leaf), a.size, trSum (b.getD 2 (Tr.node Tr.leaf 9 Tr.leaf)), trSum (b.getD 3 Tr.leaf),
   trSumList b.toList 0, trSumList (Tr.node Tr.leaf 100 Tr.leaf :: a.toList) 0]

-- the ends: an index equal to the size, the last index, cuts at and past the ends, the last element read and taken off
def arrEnds : List Nat :=
  let a : Array Nat := pushTo 5 (Array.mkEmpty 0);
  [a.getD 5 77, a.getD 4 77, (a.setD 5 9).size, (a.setD 4 9).getD 4 0, (a.extract 0 5).size, (a.extract 5 9).size,
   (a.extract 4 9).size, (a.extract 3 3).size, a.pop.size, a.pop.getD 3 0, a.back!]

-- cells of more than 4096 bytes: 3000 elements, read, written and cut, and a second large array beside the first
def bigTo : Nat → Array Nat → Array Nat
  | 0, a => a
  | k + 1, a => bigTo k (a.push (k % 251))

def arrBig : List Nat :=
  let a : Array Nat := bigTo 3000 (Array.mkEmpty 0);
  let s1 : Nat := sumIdx 3000 a 0;
  let b : Array Nat := (bigTo 2000 (Array.mkEmpty 0)).setD 1999 5;
  [a.size, s1 % 1000003, (a.extract 1000 2800).size, b.getD 1999 0, b.size, (b.push 1).size,
   sumIdx 2000 (a.extract 500 2500) 0 % 1000003]

-- an array where a list is taken apart: a cell before it, its tail, two of them appended, compared, summed by a loop;
-- and a list of cells read at an index, there and past its end
def sumNat : List Nat → Nat → Nat
  | [], acc => acc
  | x :: xs, acc => sumNat xs (acc + x)

def arrMix : List Nat :=
  let a : Array Nat := pushTo 4 (Array.mkEmpty 0);
  let b : Array Nat := a.push 9;
  let l : List Nat := 7 :: a.toList;
  [sumNat l 0, l.length, (a.toList.drop 2).length, (if a.toList == b.toList then 1 else 0), (if a.toList == a.toList then 1 else 0),
   (a.toList ++ b.toList).length, ([1, 2, 3] ++ a.toList).length, sumNat (b.toList.drop 1) 0, [1, 2, 3].length,
   a.toList.headD 50, b.toList.headD 50, (Array.mkEmpty 0 : Array Nat).toList.headD 50,
   l.getD 1 33, l.getD 9 33, (3 :: l).getD 0 33]

-- a copy that is dropped leaves the first array's elements: its rows are read after new rows took the freed cells
def arrKeep : List Nat :=
  let r : Array (Array Nat) := rowsTo 6 (Array.mkEmpty 0);
  let n1 : Nat := (r.setD 1 (Array.mkEmpty 0)).size;
  let t : Array (Array Nat) := rowsTo 6 (Array.mkEmpty 0);
  rowSizes 6 r [] ++ [n1, t.size] ++ (r.getD 2 (Array.mkEmpty 0)).toList ++ rowSizes 6 t []

-- cells made an array: a list that is an array by its type alone is read, written, cut and grown, and `++ []` makes one
def arrOf : List Nat :=
  let c : Array Nat := [5, 6, 7].toArray;
  let d : Array Nat := ([8, 9] ++ []).toArray;
  [c.size, c.getD 1 0, c.getD 3 44, (c.setD 0 9).getD 0 0, (c.extract 1 3).size, (c.push 8).size, (c.push 8).getD 3 0,
   d.size, (d.push 1).getD 2 0, d.getD 1 0] ++ c.toList

-- a write to the empty array does not ask for its index: nothing here calls a function
def arrEmptySet : List Nat := ((Array.mkEmpty 0 : Array Nat).setD 3 7).toList

-- elements that are flags: a list whose elements have the boundary's form already still leaves as cells
def flagsTo : Nat → Array Bool → Array Bool
  | 0, a => a
  | k + 1, a => flagsTo k (a.push (k % 3 == 0))

def arrFlags : List Bool := (flagsTo 7 (Array.mkEmpty 0)).toList

-- Two more inductive types whose constructors have the numbers of `Tr`'s and other fields. Their objects reach
-- their reads only through an array: those of `Bx` by a read at an index, those of `Cy` by the array's list.
inductive Bx where
  | one : Nat → Bx
  | two : Nat → Bx → Bx

def bxVal : Bx → Nat
  | Bx.one a => a
  | Bx.two a b => a * 10 + bxVal b

def boxesTo : Nat → Array Bx → Array Bx
  | 0, a => a
  | k + 1, a => boxesTo k (a.push (if k % 2 == 0 then Bx.one k else Bx.two k (Bx.one (k + 1))))

def bxSumIdx : Nat → Array Bx → Nat → Nat
  | 0, _, acc => acc
  | k + 1, a, acc => bxSumIdx k a (acc + bxVal (a.getD k (Bx.one 0)))

inductive Cy where
  | lo : Nat → Cy
  | hi : Cy → Nat → Nat → Cy

def cyVal : Cy → Nat
  | Cy.lo a => a + 1
  | Cy.hi c a b => cyVal c + a * b

def cysTo : Nat → Array Cy → Array Cy
  | 0, a => a
  | k + 1, a => cysTo k (a.push (if k % 2 == 0 then Cy.lo k else Cy.hi (Cy.lo k) k 3))

def cySumList : List Cy → Nat → Nat
  | [], acc => acc
  | c :: cs, acc => cySumList cs (acc + cyVal c)

def arrBoxes : List Nat :=
  let a : Array Bx := boxesTo 6 (Array.mkEmpty 0);
  let c : Array Cy := cysTo 6 (Array.mkEmpty 0);
  [bxSumIdx 6 a 0, a.size, cySumList c.toList 0, c.size, bxSumIdx 6 (a.setD 0 (Bx.two 7 (Bx.one 7))) 0]
