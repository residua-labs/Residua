-- The program of the row numxlen of Images.tsv, whose image is not the front end's: a Nat and a String in one node.
-- In the row's image `rawLen` reads the Nat's node, so that node is read in another form than it was written in, and
-- the stage must leave both forms as the image wrote them (lib/lrc/FromWire.rsd "Numbers in nodes"). The String is
-- a blank and 32 letters, as in instruments/lrc-host/ProgNumY.rsd (the row numxnum).
structure S where
  n : Nat
  s : String
  kids : List S

def mkS (n : Nat) : S :=
  { n := n, s := " abcdefghijklmnopqrstuvwxyzABCDEF", kids := [] : S }

-- the two functions the rows' images change: each reads one field
def rawLen (x : S) : Nat := x.s.length

def rawNum (x : S) : Nat := x.n

def xLen : Nat := rawLen (mkS 300) + rawLen (mkS 0)

def xNum : Nat := rawNum (mkS 300)
