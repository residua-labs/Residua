-- LRC host oracle: the audit cases of lane glm-lrc-audit (stock Lean only). closure_claim = 0.
-- Each declaration names the port definition and the Lean line of the pass it aims at; the shared
-- helpers (pO, pS, fn, ext, the constructor infos) come from instruments/lrc-host/Cases.rsd.
namespace Lrc.Host

open Lrc in
-- object parameter as it is before inferBorrow: borrowed
def agB (x : Nat) : Lrc.Param := { x := x, borrow := true, ty := Lrc.tyTObj }

open Lrc in
-- f40 agPackMix x y: both params packed into a constructor whose result goes to f21's borrowed
-- parameter while y goes to its owned one (bwCollectExpr's ctor case, Borrow:246; bwOwnArgsIfParam,
-- Borrow:236; xrAddDecAfterFullApp, RC:130; xrAddIncBeforeConsumeAll, RC:143)
def agPackMix : Lrc.Decl :=
  fn 40 [agB 1, agB 2] tyTObj
    (mkVDecl 3 tyTObj (mkCtor t3a [1])
    (mkVDecl 4 tyTObj (mkFap 21 [3, 2])
    (mkRet [4])))

open Lrc in
-- f41 agBorrowLive x y k: x at f21's borrowed parameter only, y at its owned one; the scalar
-- parameter k keeps borrow = false (bwOwnArgsUsingParams, Borrow:207; bwInitBorrow, Borrow:68;
-- xrAddIncBeforeAux's numIncs, RC:108; visitFnBody's sset case, RC:222)
def agBorrowLive : Lrc.Decl :=
  fn 41 [agB 1, agB 2, pS 3] tyTObj
    (mkVDecl 4 tyTObj (mkFap 21 [1, 2])
    (mkVDecl 5 tyTObj (mkCtor nodeI [4, 4])
    (mkSSet 5 2 0 3 tyI64
    (mkRet [5]))))

open Lrc in
-- f42 agProjChain x: x at f21's owned parameter, then a projection of the call and a projection of
-- that projection, each owned through the other (bwCollectExpr's proj case, Borrow:248-250;
-- xrProcessVDecl's proj case, RC:186-188; xrConsumeExpr, RC:157; xrAddDecAfterFullApp, RC:130)
def agProjChain : Lrc.Decl :=
  fn 42 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 21 [1, 1])
    (mkVDecl 3 tyTObj (mkProj 0 2)
    (mkVDecl 4 tyTObj (mkProj 0 3)
    (mkRet [4]))))

open Lrc in
-- f43 agJpMixed a b: a join point that packs its two parameters into a cell, reached from three
-- alternatives; the second packs a itself, so a flips and with it, on the next round of the
-- fixpoint, the join point's first parameter (bwCollectFnBody's jmp case, Borrow:280-281;
-- bwOwnParamsUsingArgs, Borrow:218; bwWhileModifing, Borrow:293; xrAddIncBefore at a jmp, RC:126;
-- xrAddDecForDeadParams of a join point, RC:216)
def agJpMixed : Lrc.Decl :=
  fn 43 [agB 1, agB 2] tyTObj
    (mkJDecl 10 [agB 11, agB 12]
      (mkVDecl 13 tyTObj (mkCtor consI [11, 12]) (mkRet [13]))
      (mkCase 1 tyTObj
        [mkAltCtor t3a (mkJmp 10 [1, 2]),
         mkAltCtor t3b (mkVDecl 3 tyTObj (mkCtor t3a [1]) (mkJmp 10 [3, 2])),
         mkAltCtor t3c (mkRet [1])]))

open Lrc in
-- f44 agTailPreserve x y: a self tail call whose first argument is a call result, so the first
-- parameter flips only through the tail call itself, the second through f21's owned parameter
-- (bwPreserveTailCall, Borrow:257; bwOwnParamsUsingArgs, Borrow:218; xrAddDecAfterFullApp, RC:130;
-- xrAddIncBefore, RC:126)
def agTailPreserve : Lrc.Decl :=
  fn 44 [agB 1, agB 2] tyTObj
    (mkVDecl 3 tyTObj (mkFap 21 [1, 2])
    (mkVDecl 4 tyTObj (mkFap 44 [3, 2])
    (mkRet [4])))

open Lrc in
-- f47 agFixTop x: calls f46, which is declared after it and calls f45 in turn; the three
-- parameters flip only over three rounds of the fixpoint (bwWhileModifing, Borrow:293;
-- bwUpdateParamMap, Borrow:179; bwGetParamInfo, Borrow:193)
def agFixTop : Lrc.Decl :=
  fn 47 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 46 [1])
    (mkVDecl 3 tyTObj (mkCtor consI [2, 1])
    (mkRet [3])))

open Lrc in
-- f46 agFixMid x: its parameter flips only once f45's has, one round later (Borrow:293, :179)
def agFixMid : Lrc.Decl :=
  fn 46 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 45 [1])
    (mkRet [2]))

open Lrc in
-- f45 agFixBot x: packs its parameter, the seed of the fixpoint chain (bwCollectExpr's ctor case,
-- Borrow:246; bwOwnArgsIfParam, Borrow:236)
def agFixBot : Lrc.Decl :=
  fn 45 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkCtor t3a [1])
    (mkRet [2]))

open Lrc in
-- f48 agJpDead a b: the join point's first parameter is owned through the arguments that reach it
-- and then dead in its own body, which ends in its second parameter (bwOwnParamsUsingArgs at the
-- jmp, Borrow:218; bwCollectFnBody's jmp case, Borrow:280; xrAddDecForDeadParams, RC:148 and its
-- join point use, RC:216; xrAddDecForAlt, RC:75)
def agJpDead : Lrc.Decl :=
  fn 48 [agB 1, agB 2] tyTObj
    (mkJDecl 10 [agB 11, agB 12]
      (mkRet [12])
      (mkVDecl 3 tyTObj (mkCtor t3a [1])
      (mkVDecl 4 tyTObj (mkCtor t3a [2])
      (mkCase 1 tyTObj
        [mkAltCtor t3a (mkJmp 10 [3, 2]),
         mkAltCtor t3b (mkJmp 10 [4, 2]),
         mkAltCtor t3c (mkJmp 10 [1, 2])]))))

open Lrc in
-- f49 agScalarAlt x: a case on a call result whose first alternative is the fieldless constructor
-- t3c, so the scrutinee stops being a reference inside it and needs no dec there (bwOwnArgsUsingParams,
-- Borrow:207; xrUpdateRefUsingCtorInfo, RC:65; xrAddDecForAlt, RC:75)
def agScalarAlt : Lrc.Decl :=
  fn 49 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 21 [1, 1])
    (mkCase 2 tyTObj
      [mkAltCtor t3c (mkRet [1]),
       mkAltCtor t3a (mkVDecl 3 tyTObj (mkCtor consI [2, 1]) (mkRet [3])),
       mkAltCtor t3b (mkRet [2])]))

open Lrc in
-- f50 agScalarBox x: a fieldless constructor at an object type, whose reference bit is off, next to
-- x passed to both of f21's parameters (xrIsScalarBoxedInTaggedPtr, RC:165; xrIsBorrowParamAux,
-- RC:86; xrAddDecAfterFullApp, RC:130; bwOwnArgsUsingParams, Borrow:207)
def agScalarBox : Lrc.Decl :=
  fn 50 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkCtor t3c [])
    (mkVDecl 3 tyTObj (mkFap 21 [1, 1])
    (mkVDecl 4 tyTObj (mkCtor consI [3, 2])
    (mkRet [4]))))

open Lrc in
-- f51 agCrossLive x y: two calls of f21 that exchange the parameters, so each is consumed by one
-- call and borrowed by the other, and the one borrowed first is still live at the second
-- (xrIsFirstOcc, RC:80; xrGetNumConsumptions, RC:101; xrIsBorrowParam, RC:93; xrAddIncBeforeAux's
-- liveVarsAfter, RC:108; bwOwnArgsUsingParams, Borrow:207)
def agCrossLive : Lrc.Decl :=
  fn 51 [agB 1, agB 2] tyTObj
    (mkVDecl 3 tyTObj (mkFap 21 [1, 2])
    (mkVDecl 4 tyTObj (mkFap 21 [2, 1])
    (mkVDecl 5 tyTObj (mkCtor consI [3, 4])
    (mkRet [5]))))

open Lrc in
-- f52 agPersistentUse x: a zero-argument call whose result is packed twice into one cell, so the
-- inc that keeps it alive carries the persistent bit, and the cell then goes to f21's owned
-- parameter (xrIsPersistent, RC:152; xrAddIncBeforeConsumeAll, RC:143; xrConsumeExpr, RC:157)
def agPersistentUse : Lrc.Decl :=
  fn 52 [agB 1] tyTObj
    (mkVDecl 2 tyTObj (mkFap 34 [])
    (mkVDecl 3 tyTObj (mkCtor consI [2, 2])
    (mkVDecl 4 tyTObj (mkFap 21 [1, 3])
    (mkRet [4]))))

open Lrc in
-- f53 agResetReuse x: the t3a alternative resets the scrutinee and reuses the cell for a t3b that
-- packs x itself, which x then enters at f21's borrowed parameter and leaves dead (bwCollectExpr's
-- reset and reuse cases, Borrow:244-245; bwOwnArgsIfParam, Borrow:236; xrAddDecAfterFullApp, RC:130)
def agResetReuse : Lrc.Decl :=
  fn 53 [agB 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor t3a
        (mkVDecl 2 tyTObj (mkReset 1 1)
        (mkVDecl 3 tyTObj (mkReuse 2 t3b true [1])
        (mkVDecl 4 tyTObj (mkFap 21 [1, 3])
        (mkRet [4])))),
       mkAltDefault (mkRet [1])])

def casesAuditGlm : List Prog :=
  [{ name := "auditGlm", decls := [agFixTop, agFixMid, agFixBot, agPackMix, agBorrowLive, agProjChain,
      agJpMixed, agTailPreserve, agJpDead, agScalarAlt, agScalarBox, agCrossLive, agPersistentUse,
      agResetReuse,
      ext 21 [{ x := 1, borrow := true, ty := Lrc.tyTObj }, { x := 2, borrow := false, ty := Lrc.tyTObj }] Lrc.tyTObj,
      ext 34 [] Lrc.tyTObj] }]

end Lrc.Host
