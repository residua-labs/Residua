-- LRC host oracle: an image file to IR declarations (stock Lean only). closure_claim = 0.
-- The header and signatures are read as rsc/rsc.rsd `compileWithLayers` and `compileFrom` read them;
-- the kinds of the reserved functions are given (rsc/rsc.rsd `intrinsicKinds` computes them in rsc).
namespace Lrc.Host

structure Image where
  g : Dg
  n : Nat
  sigs : List (List Int)
  -- the signatures' declared widths (lib/RscBase.rsd `readSigWs`), as rsc hands them to the stage
  ws : List (List Int) := []
  bodies : List Int

def loadImage (bytes : List Int) : Except String Image := do
  -- The v1 form only: the node table of the v2 form is read by rsc/rsc.rsd `dgRead`, which the
  -- oracle does not load. The frontend's bench images are v1.
  let (g, rest) ← match bytes with
    | 82 :: 83 :: 67 :: 77 :: 1 :: rest => pure (dgNone, rest)
    | _ => throw "image: not an RSCM 1 header"
  let c := readLeb rest
  if c.ok != profile.cOk || c.n < 1 then throw "image: function count"
  let ss := readSigs g c.n.toNat [] c.rest
  if ss.ok != profile.cOk then throw "image: signatures"
  return { g := g, n := c.n.toNat, sigs := ss.ss, ws := readSigWs g c.n.toNat c.rest, bodies := ss.rest }

-- kinds as "f:k,f:k": function f is reserved form k (3 alloc, 4 read, 5 kid)
def kindsOf (n : Nat) (text : String) : List Int :=
  let pairs := (text.splitOn ",").filterMap fun p =>
    match p.splitOn ":" with
    | [f, k] => match f.toNat?, k.toNat? with
      | some f, some k => some (f, k)
      | _, _ => none
    | _ => none
  (List.range n).map fun i => match pairs.find? (·.1 == i) with
    | some (_, k) => (k : Int)
    | none => 0

-- An image through the stage's gate (lib/lrc/FromWire.rsd `q`, `admit`), as rsc asks it; with
-- `oneClass` the image is laid out as one class (lib/lrc/FromWire.rsd "Layout"), with `plainInts` its integer
-- operations are compiled as the image wrote them (lib/lrc/FromWire.rsd "Magnitudes"), with `narrow` a small
-- number has the bounds of a module with object fields of four bytes (lib/lrc/FromWire.rsd `magLimsOf`). The
-- outer result is the host's reading of the file, the inner one the gate's.
def imageAdmit (bytes : List Int) (kinds : String) (oneClass : Bool := false) (plainInts : Bool := false) (narrow : Bool := false) :
    Except String (Except Lrc.Residue Lrc.Translated) := do
  let im ← loadImage bytes
  return Lrc.admit (Lrc.q { types := im.g, intr := kindsOf im.n kinds, sigs := im.sigs, n := im.n, bodies := im.bodies,
                            oneClass := oneClass, plainInts := plainInts, narrow := narrow, widths := im.ws })

-- a refusal of the gate as a report line gives it, and as a row of the image table names one
-- (VALUE `!NAME class=N function=F`; the compiler prints the last two, rsc/RscHost.lean `reason`)
def refusalText (e : Lrc.Residue) : String :=
  s!"{Lrc.residueName e} class={Lrc.refusalClass e} function={Lrc.refusalFn e}"

end Lrc.Host
