-- LRC host oracle: the check of lib/lrc/Borrow.rsd against Lean's IR/Borrow.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:48, after normalizeIds, on the whole program.
def check_Borrow (staged : List Staged) (_lean : List Prog) : IO Nat :=
  checkProgPass "inferBorrow" (·.ni) (·.bw) Lrc.inferBorrow staged

end Lrc.Host
