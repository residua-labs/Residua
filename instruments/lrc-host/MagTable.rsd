/-! LRC host tool: the table of the front end's integer operations (stock Lean only). closure_claim = 0.

lib/lrc/FromWire.rsd knows a function of the image as one of the front end's integer operations by a
number computed from the function's code (`magFind`). The numbers are a property of the front end:
this tool computes them from one small program for each operation, emitted by the front end's twin.
The function is the one that the program's function calls. Which operation it is, is found by
running it (the stage's translation without short forms, the host check's interpreter) on three
pairs of numbers: a front end may write `a <= b` as a call of its `>=` with the operands the other
way round, and the table must say what the function computes of its own parameters.

  lean --run instruments/lrc-host/Diff.rsd mag          the table in lib/lrc/FromWire.rsd is the one the twin gives now
  lean --run instruments/lrc-host/Diff.rsd mag write    write it there

Run through Diff.rsd, which puts this file after the stage's modules, the oracle, the image loader and the
interpreter of instruments/lrc-host. -/
namespace Lrc.Host.MagTable

-- a program that calls one of the front end's functions; `op` and `name` say which operation the program's
-- text is, for the report only
structure Probe where
  op : Nat
  name : String
  source : String

-- the operations lib/lrc/FromWire.rsd has a short form for (`magWrap`), by number
-- (100 more: the function's first parameter is the operation's right operand)
def opName (op : Nat) : String :=
  (["?", "natAdd", "natSub", "natMul", "natDiv", "natMod", "intAdd", "intSub", "intMul", "intDiv", "intMod", "intNeg",
    "natLt", "natLe", "natGt", "natGe", "intLt", "intLe", "intGt", "intGe", "?", "?", "?", "?", "?", "?", "?", "?", "?", "?",
    "natToWord", "wordToNat"].getD (op % 100) "?")
    ++ (if op >= 100 then " of (second parameter, first parameter)" else "")

def probes : List Probe :=
  [{ op := 1, name := "natAdd", source := "def p (a b : Nat) : Nat := a + b" },
   { op := 2, name := "natSub", source := "def p (a b : Nat) : Nat := a - b" },
   { op := 3, name := "natMul", source := "def p (a b : Nat) : Nat := a * b" },
   { op := 4, name := "natDiv", source := "def p (a b : Nat) : Nat := a / b" },
   { op := 5, name := "natMod", source := "def p (a b : Nat) : Nat := a % b" },
   { op := 6, name := "intAdd", source := "def p (a b : Int) : Int := a + b" },
   { op := 7, name := "intSub", source := "def p (a b : Int) : Int := a - b" },
   { op := 8, name := "intMul", source := "def p (a b : Int) : Int := a * b" },
   { op := 9, name := "intDiv", source := "def p (a b : Int) : Int := a / b" },
   { op := 10, name := "intMod", source := "def p (a b : Int) : Int := a % b" },
   { op := 11, name := "intNeg", source := "def p (a : Int) : Int := -a" },
   { op := 12, name := "natLt", source := "def p (a b : Nat) : Bool := a < b" },
   { op := 13, name := "natLe", source := "def p (a b : Nat) : Bool := a <= b" },
   { op := 14, name := "natGt", source := "def p (a b : Nat) : Bool := a > b" },
   { op := 15, name := "natGe", source := "def p (a b : Nat) : Bool := a >= b" },
   { op := 16, name := "intLt", source := "def p (a b : Int) : Bool := a < b" },
   { op := 17, name := "intLe", source := "def p (a b : Int) : Bool := a <= b" },
   { op := 18, name := "intGt", source := "def p (a b : Int) : Bool := a > b" },
   { op := 19, name := "intGe", source := "def p (a b : Int) : Bool := a >= b" },
   -- the index of an array's element, and an array's size: the word of a natural number, the natural number of a word
   { op := 30, name := "natToWord", source := "def p (a : Array Nat) (i : Nat) : Nat := a.getD i 0" },
   { op := 31, name := "wordToNat", source := "def p (a : Array Nat) : Nat := a.size" }]

structure Found where
  probe : Probe
  functions : Nat
  -- the function the program's function calls, its number after the rounds, and the operation it computes
  callee : Int
  num : Int
  op : Nat
  -- the number of the function's signature
  sig : Int

-- The function f of the translated image on small numbers: a driver that makes each number's word and calls it.
-- `ints`: the numbers are integers, one word each as the stage holds them (lib/lrc/FromWire.rsd "An integer is one
-- word"); otherwise natural numbers. The result as a number, -999 when the run gives no value of that form.
def apply (decls : List Lrc.Decl) (nImg : Nat) (f : Nat) (ints : Bool) (xs : List Int) (raw : Bool := false) : Int :=
  match Lrc.declAt f decls with
  | none => -999
  | some d =>
    -- variables: for the k-th number its magnitude 10k + 2 and that magnitude's word 10k + 3, the number itself
    -- 10k + 4 and the integer's word 10k + 5
    let bind (k : Nat) (x : Int) (rest : Lrc.N) : Lrc.N :=
      Lrc.mkVDecl (10 * k + 2) Lrc.tyI64 (Lrc.mkLit x.natAbs)
        (Lrc.mkVDecl (10 * k + 3) Lrc.tyTObj (Lrc.mkPrim Lrc.primBox 0 0 [((10 * k + 2 : Nat) : Int)])
          (Lrc.mkVDecl (10 * k + 4) Lrc.tyI64 (Lrc.mkLit x)
            (Lrc.mkVDecl (10 * k + 5) Lrc.tyTObj (Lrc.mkPrim Lrc.primBoxS 0 0 [((10 * k + 4 : Nat) : Int)]) rest)))
    let args : List Int := (List.range xs.length).map fun k =>
      if raw then ((10 * k + 2 : Nat) : Int) else if ints then ((10 * k + 5 : Nat) : Int) else ((10 * k + 3 : Nat) : Int)
    let call := Lrc.callItem d.rets (Lrc.mkFap f args) 900
    let body := (List.range xs.length).zip xs |>.foldr (fun (k, x) rest => bind k x rest) (Lrc.assemble [call.item] (Lrc.mkRet call.vars))
    let driver : Lrc.Decl := { f := 900000, xs := [{ x := 999, borrow := false, ty := Lrc.tyIrr }], rets := d.rets, ext := false, body := body }
    let o := runEntry (decls ++ [driver]) 900000 [] 1000000 false nImg
    match o.values with
    | [.int w] => w
    -- a box holds 63 bits: an integer below zero is the upper half of them
    | [.box m] => if ints && m >= 4611686018427387904 then (m : Int) - 9223372036854775808 else m
    | _ => -999

-- the operation of f by what it computes, 0 when it is none the stage has a short form for; `ints`: its first
-- parameter is an integer by the image's signature (an integer and a natural number are one word each)
def classify (decls : List Lrc.Decl) (nImg : Nat) (f : Nat) (ints : Bool) : Nat :=
  match Lrc.declAt f decls with
  | none => 0
  | some d =>
    let pty := (d.xs.headD { x := 0, borrow := false, ty := Lrc.tyIrr }).ty
    if ints && d.xs.length == 1 && d.rets == [Lrc.tyTObj] then
      (if apply decls nImg f true [7] == -7 && apply decls nImg f true [-7] == 7 && apply decls nImg f true [0] == 0 then 11 else 0)
    else if !ints && d.xs.length == 1 && d.rets == [Lrc.tyI64] && pty == Lrc.tyTObj then
      (if apply decls nImg f false [7] == 7 && apply decls nImg f false [300] == 300 && apply decls nImg f false [0] == 0 then 30 else 0)
    else if d.xs.length == 1 && d.rets == [Lrc.tyTObj] && pty == Lrc.tyI64 then
      (if apply decls nImg f false [7] true == 7 && apply decls nImg f false [300] true == 300 && apply decls nImg f false [0] true == 0 then 31 else 0)
    else if d.xs.length != 2 then 0
    else
      let r := [apply decls nImg f ints [7, 3], apply decls nImg f ints [3, 7], apply decls nImg f ints [4, 4]]
      let base := if ints then 5 else 0
      if d.rets.length == 1 && r == [10, 10, 8] then base + 1
      else if !ints && r == [4, 0, 0] then 2
      else if ints && r == [4, -4, 0] then 7
      -- the same three with the parameters the other way round
      else if !ints && d.rets.length == 1 && r == [0, 4, 0] then 102
      else if ints && d.rets.length == 1 && r == [-4, 4, 0] then 107
      else if d.rets.length == 1 && r == [0, 2, 1] then base + 104
      else if d.rets.length == 1 && r == [3, 1, 0] then base + 105
      else if d.rets.length == 1 && r == [21, 21, 16] then base + 3
      else if d.rets.length == 1 && r == [2, 0, 1] then base + 4
      else if d.rets.length == 1 && r == [1, 3, 0] then base + 5
      else if d.rets.length == 1 && r == [0, 1, 0] then (if ints then 16 else 12)
      else if d.rets.length == 1 && r == [0, 1, 1] then (if ints then 17 else 13)
      else if d.rets.length == 1 && r == [1, 0, 0] then (if ints then 18 else 14)
      else if d.rets.length == 1 && r == [1, 0, 1] then (if ints then 19 else 15)
      else 0

def dedup : List Int → List Int
  | [] => []
  | x :: xs => if xs.contains x then dedup xs else x :: dedup xs

def measure (twin : String) (p : Probe) : IO Found := do
  IO.FS.createDirAll "out/lrc/mag"
  let src := s!"out/lrc/mag/{p.name}.rsd"
  IO.FS.writeFile src (p.source ++ "\n")
  let r ← IO.Process.spawn { cmd := twin, args := #["bytes", src], stdout := .piped, stderr := .null }
  let bytes ← r.stdout.readBinToEnd
  unless (← r.wait) == 0 do throw (IO.userError s!"lrc_mag_probe: the twin refuses {p.name}")
  let im ← match loadImage (bytes.toList.map (fun b => (b.toNat : Int))) with
    | .ok im => pure im
    | .error e => throw (IO.userError s!"lrc_mag_probe: {p.name}: {e}")
  let starts := Lrc.magStarts im.g 0 im.n im.bodies []
  unless starts.length == im.n && im.n >= 2 do throw (IO.userError s!"lrc_mag_probe: {p.name}: {im.n} functions, {starts.length} bodies")
  -- the program's function is the first; what follows is the front end's
  let own := (starts.reverse.headD [])
  let next := (starts.reverse.drop 1).headD []
  let body0 := own.take (own.length - (next.length + 1))
  let callees := dedup (Lrc.magCallees (Lrc.magCallsRev (Lrc.magCallsE im.g [] body0) []))
  let [callee] := callees | throw (IO.userError s!"lrc_mag_probe: {p.name}: its function calls {callees}")
  -- every function after the first, the last first (as lib/lrc/FromWire.rsd `magTail` meets them), with no test of the first numbers
  let mut after := 1
  let mut f := im.n - 1
  let mut fns : List Lrc.MagFn := []
  for body in starts.take (im.n - 1) do
    fns := fns ++ [Lrc.magFirst im.g (sigOf im.sigs f) (body.take (body.length - after)) f]
    after := body.length + 1
    f := f - 1
  let final := Lrc.magRounds Lrc.magDepth fns
  -- the numbers must have settled: one round more names the same classes
  let again := Lrc.magRound final final
  let classes (xs : List Lrc.MagFn) : List (List Nat) := xs.map fun x => (xs.filter (·.num == x.num)).map (·.f)
  unless classes final == classes again do throw (IO.userError s!"lrc_mag_probe: {p.name}: the numbers have not settled after {Lrc.magDepth} rounds")
  -- what the function computes: the image translated with no short form, run by the interpreter
  let plain ← match Lrc.admit (Lrc.q { types := im.g, intr := kindsOf im.n "-", sigs := im.sigs, n := im.n, bodies := im.bodies, plainInts := true }) with
    | .ok t => pure t
    | .error e => throw (IO.userError s!"lrc_mag_probe: {p.name}: not admitted: {Lrc.residueName e}")
  let op := classify plain.decls plain.n callee.toNat (Lrc.magField im.g ((Lrc.fwSig im.g (sigOf im.sigs callee.toNat)).ptys.headD []) == 1)
  return { probe := p, functions := im.n, callee := callee, num := Lrc.magNumOf final callee, op := op,
           sig := Lrc.magSigNum (sigOf im.sigs callee.toNat) }

/-! "Numbers in nodes" of lib/lrc/FromWire.rsd: the image's functions that pack a list of Nat or of Int into the
words of a node, and unpack them (operations 20 to 23). One program has the four. Each is known by its signature
and by what it computes: a list of three numbers packed is the words the format says, and those words unpacked
and packed again are the same words. -/

def numProbe : String :=
  "structure T where\n  n : Nat\n  i : Int\n  ns : List Nat\n  js : List Int\n  kids : List T\n\n" ++
  "def p (t : T) : T :=\n  { n := t.n, i := t.i, ns := t.ns, js := t.js, kids := t.kids : T }\n"

-- the reserved functions of the probe's image (rsc/rsc.rsd `intrinsicKinds`: alloc, read, kid)
def numKinds : String := "0:3,3:4,2:5"

def numName (op : Int) : String :=
  if op == Lrc.numPackNat then "packNat" else if op == Lrc.numPackInt then "packInt" else if op == Lrc.numUnpackNat then "unpackNat" else "unpackInt"

-- the cells of a list written out: of words (kind 0), of Nat (1), of Int (2)
def numCells (kind : Nat) : List Int → Nat → Lrc.ItemsR
  | [], next => { next := next + 1, items := [Lrc.mkVDecl next Lrc.tyTObj (Lrc.mkCtor Lrc.nilInfo []) Lrc.mkUnreachable], ws := [(next : Int)] }
  | v :: vs, next =>
    let tl := numCells kind vs next
    let a := tl.next
    let sg := tl.next + 1
    let b := tl.next + 2
    -- a word, a natural number's word (the box of the magnitude), an integer's word (the box of the number with its sign)
    let lits := [Lrc.mkVDecl a Lrc.tyI64 (Lrc.mkLit (v.natAbs : Int)) Lrc.mkUnreachable,
                 Lrc.mkVDecl sg Lrc.tyI64 (Lrc.mkLit v) Lrc.mkUnreachable,
                 Lrc.mkVDecl b Lrc.tyTObj (Lrc.mkPrim (if kind == 2 then Lrc.primBoxS else Lrc.primBox) 0 0 [((if kind == 2 then sg else a : Nat) : Int)]) Lrc.mkUnreachable]
    let c := if kind == 0 then Lrc.consItems [(a : Int)] [Lrc.tyI64] (Lrc.intAt 0 tl.ws) (tl.next + 3)
      else Lrc.consItems [(b : Int)] [Lrc.tyTObj] (Lrc.intAt 0 tl.ws) (tl.next + 3)
    { next := c.next, items := tl.items ++ lits ++ c.items, ws := c.ws }

-- the functions `fs` applied one after the other to the list `vals` of `kind`: the result as the interpreter shows it
def numRun (decls : List Lrc.Decl) (nImg : Nat) (fs : List Nat) (kind : Nat) (vals : List Int) : String :=
  let l := numCells kind vals 10
  let step (acc : Nat × Int × List Lrc.N) (f : Nat) : Nat × Int × List Lrc.N :=
    (acc.1 + 1, (acc.1 : Int), acc.2.2 ++ [Lrc.mkVDecl acc.1 Lrc.tyTObj (Lrc.mkFap f [acc.2.1]) Lrc.mkUnreachable])
  let r := fs.foldl step (l.next, Lrc.intAt 0 l.ws, l.items)
  let driver : Lrc.Decl := { f := 900000, xs := [{ x := 9, borrow := false, ty := Lrc.tyIrr }], rets := [Lrc.tyTObj], ext := false,
                             body := Lrc.assemble r.2.2 (Lrc.mkRet [r.2.1]) }
  let o := runEntry (decls ++ [driver]) 900000 [] 1000000 false nImg
  if o.status == "value" then o.text else "!" ++ o.status

structure NumFound where
  op : Int
  f : Nat
  num : Int
  sig : Int

def measureNum (twin : String) : IO (List NumFound) := do
  IO.FS.createDirAll "out/lrc/mag"
  let src := "out/lrc/mag/numbers.rsd"
  IO.FS.writeFile src numProbe
  let r ← IO.Process.spawn { cmd := twin, args := #["bytes", src], stdout := .piped, stderr := .null }
  let bytes ← r.stdout.readBinToEnd
  unless (← r.wait) == 0 do throw (IO.userError "lrc_mag_probe: the twin refuses the program of the numbers in nodes")
  let im ← match loadImage (bytes.toList.map (fun b => (b.toNat : Int))) with
    | .ok im => pure im
    | .error e => throw (IO.userError s!"lrc_mag_probe: numbers: {e}")
  let starts := Lrc.magStarts im.g 0 im.n im.bodies []
  unless starts.length == im.n && im.n >= 2 do throw (IO.userError s!"lrc_mag_probe: numbers: {im.n} functions, {starts.length} bodies")
  let mut after := 1
  let mut f := im.n - 1
  let mut fns : List Lrc.MagFn := []
  for body in starts.take (im.n - 1) do
    fns := fns ++ [Lrc.magFirst im.g (sigOf im.sigs f) (body.take (body.length - after)) f]
    after := body.length + 1
    f := f - 1
  let final := Lrc.magRounds Lrc.magDepth fns
  let plain ← match Lrc.admit (Lrc.q { types := im.g, intr := kindsOf im.n numKinds, sigs := im.sigs, n := im.n, bodies := im.bodies, plainInts := true }) with
    | .ok t => pure t
    | .error e => throw (IO.userError s!"lrc_mag_probe: numbers: not admitted: {Lrc.residueName e}")
  -- a function from one list to one list, by the wire types of its signature: 1 a list of Nat, 2 a list of Int, 0 words
  let listKind (ty : List Int) : Int :=
    if ty == [4, 0] then 0 else if Lrc.wtElem im.g ty == [] then -1
    else if Lrc.magField im.g (Lrc.wtElem im.g ty) == 0 then 1 else if Lrc.magField im.g (Lrc.wtElem im.g ty) == 1 then 2 else -1
  let nats : List Int := [5, 300, 0]
  let ints : List Int := [5, -3, 0]
  let natWords : List Int := [1, 5, 2, 44, 1, 0]
  let intWords : List Int := [0, 1, 5, 1, 1, 3, 0, 0]
  let listText (ws : List Int) : String := "[" ++ " ".intercalate (ws.map toString) ++ "]"
  let mut packs : List NumFound := []
  for g in List.range im.n do
    let sg := Lrc.fwSig im.g (sigOf im.sigs g)
    if sg.ok && sg.ptys.length == 1 && sg.result == [Lrc.tyTObj] then
      let from1 := listKind (sg.ptys.headD [])
      let to := listKind sg.rty
      let op : Int := if from1 == 1 && to == 0 && numRun plain.decls plain.n [g] 1 nats == listText natWords then Lrc.numPackNat
        else if from1 == 2 && to == 0 && numRun plain.decls plain.n [g] 2 ints == listText intWords then Lrc.numPackInt else -1
      if op >= 0 then packs := packs ++ [{ op := op, f := g, num := Lrc.magNumOf final g, sig := Lrc.magSigNum (sigOf im.sigs g) }]
  let mut found := packs
  for g in List.range im.n do
    let sg := Lrc.fwSig im.g (sigOf im.sigs g)
    if sg.ok && sg.ptys.length == 1 && sg.result == [Lrc.tyTObj] && listKind (sg.ptys.headD []) == 0 then
      let to := listKind sg.rty
      let back := packs.filter (fun x => x.op == (if to == 1 then Lrc.numPackNat else Lrc.numPackInt))
      let ws := if to == 1 then natWords else intWords
      if (to == 1 || to == 2) && back.any (fun x => numRun plain.decls plain.n [g, x.f] 0 ws == listText ws) then
        found := found ++ [{ op := if to == 1 then Lrc.numUnpackNat else Lrc.numUnpackInt, f := g, num := Lrc.magNumOf final g, sig := Lrc.magSigNum (sigOf im.sigs g) }]
  for op in [Lrc.numPackNat, Lrc.numPackInt, Lrc.numUnpackNat, Lrc.numUnpackInt] do
    match found.filter (·.op == op) with
    | [x] => IO.println s!"mag {numName op} functions={im.n} function=f{x.f} number={x.num}"
    | xs => throw (IO.userError s!"lrc_mag_probe: numbers: {xs.length} functions are {numName op}")
  return found

def numPairs : List NumFound → List Int
  | [] => []
  | x :: xs => x.num :: x.op :: numPairs xs

-- one pair for each function
def pairs : List Found → List Int → List Int
  | [], acc => acc
  | x :: xs, acc => pairs xs (if (Lrc.factOf x.num acc) >= 0 then acc else acc ++ [x.num, (x.op : Int)])

def block (found : List Found) (nums : List NumFound) : String :=
  s!"def magSigs : List Int := {dedup (found.map (·.sig) ++ nums.map (·.sig))}\ndef magOps : List Int := {pairs found [] ++ numPairs nums}\n"

def run (twin : String) (write : Bool) : IO UInt32 := do
  let mut found := []
  for p in probes do
    let x ← measure twin p
    IO.println s!"mag {p.name} functions={x.functions} callee=f{x.callee} number={x.num} computes={opName x.op}{if x.op == p.op then "" else " (the program's text is " ++ p.name ++ ")"}"
    found := found ++ [x]
  -- a function that computes none of the operations has no row; one function has one operation
  if found.any (·.op == 0) then
    IO.println s!"mag: a function computes none of the operations with a short form"
    return 1
  if found.any (fun x => found.any (fun y => x.num == y.num && x.op != y.op)) then
    IO.println s!"mag: one function is read as two operations"
    return 1
  let path := "lib/lrc/FromWire.rsd"
  let text ← IO.FS.readFile path
  let [head, rest] := text.splitOn "-- magtable-begin\n" | throw (IO.userError "lrc_mag_table: no begin line")
  let [old, tail] := rest.splitOn "-- magtable-end\n" | throw (IO.userError "lrc_mag_table: no end line")
  let nums ← measureNum twin
  let new := block found nums
  if write then
    IO.FS.writeFile path (head ++ "-- magtable-begin\n" ++ new ++ "-- magtable-end\n" ++ tail)
    IO.println s!"mag table written: {(pairs found []).length / 2 + nums.length} functions, {(dedup (found.map (·.sig) ++ nums.map (·.sig))).length} signatures"
    return 0
  IO.println s!"mag table {if old == new then "is the twin's" else "DIFFERS from the twin's"}: {found.length + nums.length} operations"
  return (if old == new then 0 else 1)

end Lrc.Host.MagTable
