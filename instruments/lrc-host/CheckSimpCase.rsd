-- LRC host oracle: the check of lib/lrc/SimpCase.rsd against Lean's IR/SimpCase.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:45, after elimDead; and on Lean's own compiled declarations.
def check_SimpCase (staged : List Staged) (lean : List Prog) : IO Nat := do
  let a ← checkDeclPass "simpCase" (·.ed) (·.sc) Lrc.declSimpCase staged
  let b ← checkPure "simpCase.lean" IR.Decl.simpCase Lrc.declSimpCase lean
  return a + b

end Lrc.Host
