-- LRC host oracle: the check of lib/lrc/ResetReuse.rsd against Lean's IR/ResetReuse.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:41, after the first pushProj.
def check_ResetReuse (staged : List Staged) (_lean : List Prog) : IO Nat :=
  checkDeclPass "insertResetReuse" (·.pp1) (·.rr) Lrc.declInsertResetReuse staged

end Lrc.Host
