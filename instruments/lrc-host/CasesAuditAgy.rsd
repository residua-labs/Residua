/-! ## Cases for lib/lrc/ElimDeadBranches.rsd -/

open Lrc in
-- f116 aaEdbBeqChoice: lib/lrc/ElimDeadBranches.rsd edbBeq (ElimDeadBranches.lean:40)
def aaEdbBeqChoice : Lrc.Decl :=
  fn 116 [pO 1, pS 2] tyTObj
    (mkIfW 2
      (mkRet [1])
      (mkVDecl 3 tyTObj (mkFap 117 [1, 2])
      (mkCase 3 tyTObj
        [mkAltCtor t3a (mkRet [3]),
         mkAltCtor t3b (mkRet [3]),
         mkAltCtor t3c (mkRet [3]),
         mkAltCtor leafI (mkRet [1])])))

open Lrc in
