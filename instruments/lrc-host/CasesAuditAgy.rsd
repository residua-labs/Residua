      (mkCase 3 tyTObj
        [mkAltCtor t3a (mkRet [3]),
         mkAltCtor t3c (mkRet [1])]))
      (mkCase 1 tyTObj
        [mkAltCtor leafI (mkVDecl 4 tyTObj (mkCtor t3b [1]) (mkRet [4])),
         mkAltDefault (mkVDecl 5 tyTObj (mkFap 118 [1]) (mkRet [5]))]))

