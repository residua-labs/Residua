-- LRC host oracle: audit cases for ResetReuse, ExpandResetReuse, and ElimDeadBranches (stock Lean only). closure_claim = 0.
namespace Lrc.Host

def aaU4a : Lrc.CtorInfo := { cidx := 0, size := 1, ssize := 0, tid := 4 }
def aaPair4 : Lrc.CtorInfo := { cidx := 1, size := 2, ssize := 0, tid := 4 }

/-! ## Cases for lib/lrc/ResetReuse.rsd -/

open Lrc in
-- f100 aaRrMayReuseStrict: lib/lrc/ResetReuse.rsd rrMayReuse (ResetReuse.lean:32)
def aaRrMayReuseStrict : Lrc.Decl :=
  fn 100 [pO 1] tyTObj
    (mkCase 1 tyTObj
      [mkAltCtor nilI (mkRet [1]),
       mkAltCtor consI
         (mkVDecl 2 tyTObj (mkProj 0 1)
         (mkVDecl 3 tyTObj (mkProj 1 1)
         (mkVDecl 4 tyTObj (mkCtor consI [3, 2]) (mkRet [4]))))])

