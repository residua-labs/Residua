open Lrc in
-- f124 aaEdbResetNestedCase: lib/lrc/ElimDeadBranches.rsd edbInterp, join points nested under a case (ElimDeadBranches.lean:240)
def aaEdbResetNestedCase : Lrc.Decl :=
  fn 124 [pO 1, pS 2] tyTObj
    (mkVDecl 3 tyTObj (mkCtor leafI [])
    (mkJDecl 10 [pO 11]
      (mkIfW 2
        (mkJDecl 20 [pO 21]
          (mkCase 11 tyTObj
            [mkAltCtor t3a (mkRet [21]),
             mkAltCtor t3b
               (mkVDecl 22 tyTObj (mkProj 0 11)
               (mkCase 22 tyTObj
                 [mkAltCtor leafI (mkRet [22]),
                  mkAltCtor nodeI (mkRet [1])])),
             mkAltCtor t3c (mkRet [1])])
          (mkJmp 20 [3]))
        (mkRet [11]))
      (mkCase 1 tyTObj
        [mkAltCtor t3a (mkVDecl 4 tyTObj (mkCtor t3a [3]) (mkJmp 10 [4])),
         mkAltCtor t3b (mkVDecl 5 tyTObj (mkCtor t3b [3]) (mkJmp 10 [5])),
         mkAltCtor t3c (mkRet [1])])))

def casesAuditAgy : List Prog :=
  [{ name := "audit_agy", decls := [
      aaRrMayReuseStrict, aaRrMayReuseRelaxed, aaRrSUpdtTag, aaRrSJoinStop,
      aaRrDFinalizeDead, aaRrIsCtorUsing, aaRrDMainCaseLiveJP, aaRrCollectResetsOnce,
      aaErCollectProj, aaErConsumedBranchDec, aaErEraseSkipSProj, aaErReuseToCtorDec,
      aaErSlowPathIncs, aaErReleaseUnread, aaErSelfSSetOffset, aaErFastChain,
      aaEdbBeqChoice, aaEdbCalleeMid, aaEdbCalleeLeaf, aaEdbAddChoiceMerge,
      aaEdbTruncDepth, aaEdbTruncCaller, aaEdbFindArgIrr, aaEdbHasCtorChoice, aaEdbResetNestedCase] }]

end Lrc.Host
