         mkAltCtor nilI (mkRet [12]),
         mkAltCtor consI (mkRet [1]),
         mkAltDefault (mkRet [11])]))
      (mkCase 1 tyTObj
        [mkAltCtor t3a
           (mkVDecl 2 tyTObj (mkCtor leafI [])
           (mkVDecl 3 tyTObj (mkCtor nodeI [2, 2]) (mkJmp 10 [3]))),
         mkAltCtor t3b
           (mkVDecl 4 tyTObj (mkCtor leafI []) (mkJmp 10 [4])),
         mkAltCtor t3c
           (mkVDecl 5 tyTObj (mkCtor nilI [])
           (mkVDecl 6 tyTObj (mkCtor leafI [])
