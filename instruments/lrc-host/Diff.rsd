import Lean

/- LRC differential runner (external stock-Lean recipe only; no part of the chain). closure_claim = 0.

   It writes one Lean file from the LRC modules that exist, the host oracle and its cases, and the
   check of every pass whose module exists, then runs it. Each check compares a ported pass with the
   Lean 4.14 pass it was ported from (instruments/lrc-host/Oracle.rsd).

   Run from the repository root:
     lean --run instruments/lrc-host/Diff.rsd                 every check; exit 0 when no mismatch
     lean --run instruments/lrc-host/Diff.rsd quick           the same with the image check in its short form (the
                                                      default pipeline, six fuel budgets), as the replay runs it
     lean --run instruments/lrc-host/Diff.rsd mutants         every row of every instruments/lrc-host/Mutants*.tsv: the
                                                      row's text is replaced in its file and the run must
                                                      then report a mismatch; exit 0 when all are caught.
                                                      The sources as they are run first and must pass; a
                                                      row that runs past three times that run's time is
                                                      caught by the limit
     lean --run instruments/lrc-host/Diff.rsd mutants TAG     the same for the rows of instruments/lrc-host/MutantsTAG.tsv alone
   Images: every row of instruments/lrc-host/Images.tsv is emitted by the twin into out/lrc/img and checked as
   instruments/lrc-host/CheckImage.rsd says; its program joins the corpus.
   Cases: instruments/lrc-host/Cases.rsd defines `cases`; a further file instruments/lrc-host/Cases<Tag>.rsd defines
   `cases<Tag> : List Prog` in namespace Lrc.Host and is added to the corpus when it exists.
     lean --run instruments/lrc-host/Diff.rsd ir              writes out/lrc/img/NAME.ir for every image row: its IR after
                                                      Lean's own pipeline (instruments/lrc-host/IrOut.rsd)
     lean --run instruments/lrc-host/Diff.rsd cite            the Lean line citations of the ported modules: each name
                                                      on its line, every definition of the Lean file cited or
                                                      listed as absent; exit 0 when both hold
     lean --run instruments/lrc-host/Diff.rsd mag [write]     the table of the front end's integer operations in
                                                      lib/lrc/FromWire.rsd is the one the twin gives now
                                                      (instruments/lrc-host/MagTable.rsd); `write` writes it
     lean --run instruments/lrc-host/Diff.rsd rsdc            the chain frontend's twin (instruments/rsdc-ml/rsdc.ml,
                                                      built with ocamlopt into out/lrc) checks the LRC modules
                                                      that exist, as one source; exit 0 when it accepts them
     lean --run instruments/lrc-host/Diff.rsd plants          every row of every Mutants*.tsv and of SidesMutants.tsv
                                                      plants: its FROM occurs exactly once in its FILE. A row that
                                                      does not is named by its table and its number; exit 1 then.
                                                      Seconds. A landing that changes a line of lib/lrc runs it
                                                      before any replay: a replay assembles a table's rows in
                                                      order and ends at the first that does not plant
   A row of Mutants.tsv: FILE<TAB>FROM<TAB>TO, FROM occurring exactly once in FILE.

   Verdicts are NF instances. The verdict of one run of the checks is
   instruments/lrc-host/Verdict.rsd, inside the file that is run; the verdict of a row of the image table is in
   instruments/lrc-host/CheckImage.rsd; what a mode of this driver exits with is `Lrc.DiffVerdict` below. -/

/- The driver's verdict of a mode. The driver hands over what it read: how each run ended, the twin's
   line, the counts of the citations. `q` keeps the counts the verdict depends on, and `admit` decides.
   A mode exits 0 exactly when `admit` gives no residue. -/
namespace Lrc.DiffVerdict

inductive Residue where
  -- the checks ran to their total line and report a mismatch
  | runMismatch
  -- a run did not reach its total line: it does not build, or it stopped before its end
  | runNoTotal
  -- the wall limit ended the run of the sources as they are
  | runLimit
  -- a replay without a row: nothing was planted
  | tableEmpty
  -- a planted row's run reports no mismatch
  | mutantSurvived
  -- a planted row's run does not reach its total line: an elaboration error is not a caught mutant
  | mutantNoTotal
  -- the front end's twin does not accept the modules as one source
  | twinRefuses
  -- no module with citations was read
  | nothingCited
  -- a cited name is not on its line of the Lean file
  | citationOff
  -- a definition of the Lean file is neither cited nor listed as absent
  | definitionUncited

def residueName : Residue -> String
  | Residue.runMismatch => "lrc_diff_run_mismatch"
  | Residue.runNoTotal => "lrc_diff_run_no_total"
  | Residue.runLimit => "lrc_diff_run_limit"
  | Residue.tableEmpty => "lrc_diff_table_empty"
  | Residue.mutantSurvived => "lrc_diff_mutant_survived"
  | Residue.mutantNoTotal => "lrc_diff_mutant_no_total"
  | Residue.twinRefuses => "lrc_diff_twin_refuses"
  | Residue.nothingCited => "lrc_diff_nothing_cited"
  | Residue.citationOff => "lrc_diff_citation_off"
  | Residue.definitionUncited => "lrc_diff_definition_uncited"

-- How a run ended, as `runOnce` codes it: 0 no mismatch, 1 a mismatch, 2 no total line, 124 the wall limit.
structure Request where
  -- 0 one run of the checks, 1 the replay of planted rows, 2 the twin on the modules, 3 the citations
  mode : Nat
  -- the run of the sources as they are (modes 0 and 1)
  baseline : Nat := 0
  -- the run of each planted row (mode 1)
  rows : List Nat := []
  -- the twin's first line (mode 2)
  twin : String := ""
  -- the modules read, the names off their line, the definitions uncited (mode 3)
  modules : Nat := 0
  off : Nat := 0
  uncited : Nat := 0

structure Class where
  mode : Nat
  baseline : Nat
  planted : Nat
  survived : Nat
  noTotal : Nat
  twinOk : Bool
  modules : Nat
  off : Nat
  uncited : Nat

def q (r : Request) : Class :=
  { mode := r.mode, baseline := r.baseline, planted := r.rows.length,
    survived := (r.rows.filter (· == 0)).length,
    noTotal := (r.rows.filter fun c => c != 0 && c != 1 && c != 124).length,
    twinOk := r.twin == "ok", modules := r.modules, off := r.off, uncited := r.uncited }

structure Agreed where
  -- what stands behind the verdict: 1 for a run or the twin, the rows caught for a replay, the modules for the citations
  count : Nat

def admit (c : Class) : Except Residue Agreed :=
  if c.mode == 2 then (if c.twinOk then Except.ok { count := 1 } else Except.error Residue.twinRefuses)
  else if c.mode == 3 then
    (if c.modules == 0 then Except.error Residue.nothingCited
     else if c.off != 0 then Except.error Residue.citationOff
     else if c.uncited != 0 then Except.error Residue.definitionUncited
     else Except.ok { count := c.modules })
  else if c.baseline == 1 then Except.error Residue.runMismatch
  else if c.baseline == 124 then Except.error Residue.runLimit
  else if c.baseline != 0 then Except.error Residue.runNoTotal
  else if c.mode == 0 then Except.ok { count := 1 }
  else if c.planted == 0 then Except.error Residue.tableEmpty
  else if c.survived != 0 then Except.error Residue.mutantSurvived
  else if c.noTotal != 0 then Except.error Residue.mutantNoTotal
  else Except.ok { count := c.planted }

end Lrc.DiffVerdict

namespace Lrc.Diff
open Lean System

-- a mode's verdict printed, and the mode's exit code: 0 exactly when the verdict has no residue, else `code`
def conclude (r : Lrc.DiffVerdict.Request) (code : UInt32) : IO UInt32 := do
  match Lrc.DiffVerdict.admit (Lrc.DiffVerdict.q r) with
  | .ok a =>
    IO.println s!"verdict=agreed count={a.count}"
    return 0
  | .error e =>
    IO.println s!"verdict={Lrc.DiffVerdict.residueName e}"
    return (if code == 0 then 1 else code)

-- lib/RscBase.rsd and what it needs come first, in the order of rsc/NativeSplit.lean `sources`:
-- FromWire reads the wire with RscBase's readers
def base : List String :=
  ["lib/AvlMap.rsd", "lib/Tarjan.rsd", "lib/ownership/Borrow.rsd", "lib/ObjectLayout.rsd", "lib/Fuel.rsd", "lib/RscBase.rsd",
   "lib/lrc/Ir.rsd", "lib/lrc/Set.rsd", "lib/lrc/CallGraph.rsd", "lib/lrc/FreeVars.rsd", "lib/lrc/LiveVars.rsd",
   "lib/lrc/NormIds.rsd", "lib/lrc/AlphaEqv.rsd", "lib/lrc/Prim.rsd", "lib/lrc/Classes.rsd", "lib/lrc/FromWire.rsd", "lib/lrc/Emit.rsd"]

-- the passes in dependency order: a pass module may use the modules before it
def passes : List String :=
  ["PushProj", "ElimDead", "SimpCase", "ElimDeadBranches", "ResetReuse", "Borrow", "RC", "ExpandResetReuse"]

-- what stands on the passes: the stage's pipeline (it names the passes that are ported)
def post : List String :=
  ["lib/lrc/Inline.rsd", "lib/lrc/Cse.rsd", "lib/lrc/GuardElim.rsd", "lib/lrc/DropSpec.rsd", "lib/lrc/Trmc.rsd", "lib/lrc/Pack.rsd", "lib/lrc/SinkProj.rsd", "lib/lrc/SinkInc.rsd", "lib/lrc/Closed.rsd", "lib/lrc/Range.rsd", "lib/lrc/JoinOnce.rsd", "lib/lrc/Closures.rsd", "lib/lrc/Pipeline.rsd"]

def host : List String :=
  ["instruments/lrc-host/Oracle.rsd", "instruments/lrc-host/Image.rsd", "instruments/lrc-host/Interp.rsd", "instruments/lrc-host/Cases.rsd",
   "instruments/lrc-host/Verdict.rsd", "instruments/lrc-host/CheckBase.rsd", "instruments/lrc-host/CheckImage.rsd", "instruments/lrc-host/Multi.rsd", "instruments/lrc-host/IrOut.rsd"]

-- the files instruments/lrc-host/<pre><Tag><suffix> with a non-empty Tag, by name: their tags
def tagged (pre suffix : String) : IO (List String) := do
  let entries ← (FilePath.mk "instruments/lrc-host").readDir
  let names := entries.toList.map (·.fileName)
  let tags := names.filterMap fun n =>
    if n.startsWith pre && n.endsWith suffix && n.length > pre.length + suffix.length then
      some ((n.drop pre.length).dropRight suffix.length)
    else none
  return (tags.toArray.qsort (· < ·)).toList

def strip (text : String) : String :=
  "\n".intercalate ((text.splitOn "\n").filter (fun l => !l.startsWith "import "))

structure Mutant where
  file : String
  frm : String
  to : String

def readSource (m : Option Mutant) (path : String) : IO String := do
  let text ← IO.FS.readFile path
  match m with
  | some mu =>
    if mu.file == path then
      let parts := text.splitOn mu.frm
      unless parts.length == 2 do
        throw (IO.userError s!"lrc_diff_mutant: {parts.length - 1} occurrences in {path} of: {mu.frm}")
      return strip (mu.to.intercalate parts)
    else return strip text
  | none => return strip text

def assemble (m : Option Mutant) : IO String := do
  let mut src := "import Lean\n"
  let mut present : List String := []
  for f in base do src := src ++ (← readSource m f) ++ "\n"
  for p in passes do
    let f := s!"lib/lrc/{p}.rsd"
    if ← (FilePath.mk f).pathExists then
      src := src ++ (← readSource m f) ++ "\n"
      present := present ++ [p]
  for f in post do
    if ← (FilePath.mk f).pathExists then src := src ++ (← readSource m f) ++ "\n"
  for f in host do src := src ++ (← readSource m f) ++ "\n"
  let caseTags ← tagged "Cases" ".rsd"
  for t in caseTags do src := src ++ (← readSource m s!"instruments/lrc-host/Cases{t}.rsd") ++ "\n"
  let allCases := " ++ ".intercalate ("Lrc.Host.cases" :: caseTags.map (fun t => s!"Lrc.Host.cases{t}"))
  for p in present do src := src ++ (← readSource m s!"instruments/lrc-host/Check{p}.rsd") ++ "\n"
  let calls := "\n".intercalate (present.map fun p =>
    "  tallies := tallies ++ [{ name := \"" ++ p ++ "\", cause := .passDiffers, compared := staged.length + lean.length, differ := (← Lrc.Host.check_" ++ p ++ " staged lean) }]")
  src := src ++ "
def main (args : List String) : IO UInt32 := do
  Lean.initSearchPath (← Lean.findSysroot)
  let env ← Lean.importModules #[{ module := `Init }] {}
  if args == [\"ir\"] then
    Lrc.Host.writeIrs env (← Lrc.Host.readImageRows \"out/lrc/img/list.tsv\")
    IO.println \"total mismatch=0\"
    return 0
  let imageRows ← Lrc.Host.readImageRows \"out/lrc/img/list.tsv\"
  let (imageBad, imageProgs) ← Lrc.Host.checkImages env imageRows (args.contains \"quick\")
  let written : List Lrc.Host.Prog := (" ++ allCases ++ ") ++ imageProgs
  let (staged, refused) ← Lrc.Host.stageAll env written
  let lean := Lrc.Host.leanCorpus env 6000
  IO.println s!\"corpus programs={written.length} of_images={imageProgs.length} staged={staged.length} stage_refused={refused} lean_groups={lean.length}\"
  IO.println s!\"corpus {Lrc.Host.stageChanges staged}\"
  -- One tally for each check (instruments/lrc-host/Verdict.rsd). A program that Lean's pipeline cannot
  -- take is an error of the corpus, not a skip.
  let mut tallies : List Lrc.Host.Verdict.Tally := [
    { name := \"images\", cause := .imageRowFails, compared := imageRows.length, differ := imageBad },
    { name := \"corpus\", cause := .corpusNotTaken, compared := written.length, differ := refused }]
  tallies := tallies ++ [{ name := \"multi\", cause := .writtenProgramDiffers, compared := Lrc.Host.multiCases.length, differ := (← Lrc.Host.checkMulti) }]
  tallies := tallies ++ [{ name := \"base\", cause := .foundationDiffers, compared := (written ++ lean).length, differ := (← Lrc.Host.checkBase (written ++ lean)) }]
" ++ calls ++ (if present.contains "ElimDeadBranches" then "\n  tallies := tallies ++ [{ name := \"ElimDeadBranches, a shared index\", cause := .passDiffers, compared := 1, differ := (← Lrc.Host.checkEdbSharedIndex env) }]" else "") ++ "
  IO.println s!\"total mismatch={tallies.foldl (· + ·.differ) 0}\"
  match Lrc.Host.Verdict.admit (Lrc.Host.Verdict.q { tallies := tallies }) with
  | .ok a =>
    IO.println s!\"verdict=agreed compared={a.compared}\"
    return 0
  | .error e =>
    IO.println s!\"verdict={Lrc.Host.Verdict.residueName e}\"
    return 1
"
  return src

-- the frontend's twin, built into out/lrc (the chain's own build command for it) and built again
-- when the tree's source of it is no longer the one the kept binary was built from
def twin : IO String := do
  IO.FS.createDirAll "out/lrc"
  let path := "out/lrc/twin"
  let src ← IO.FS.readFile "instruments/rsdc-ml/rsdc.ml"
  let kept ← if ← (FilePath.mk "out/lrc/rsdc.ml").pathExists then IO.FS.readFile "out/lrc/rsdc.ml" else pure ""
  unless (← (FilePath.mk path).pathExists) && kept == src do
    IO.FS.writeFile "out/lrc/rsdc.ml" src
    let flags := #["-w", "-a", "-I", "+unix", "unix.cmxa", "-o", "twin", "rsdc.ml"]
    let b ← IO.Process.output { cmd := "ocamlopt", args := flags, cwd := some "out/lrc" }
    unless b.exitCode == 0 do throw (IO.userError s!"lrc_diff_twin: {b.stderr}")
  return path

-- the images of instruments/lrc-host/Images.tsv and their list for the run
def images : IO Unit := do
  let rows := ((← IO.FS.readFile "instruments/lrc-host/Images.tsv").splitOn "\n").filter (fun l => l != "" && !l.startsWith "#")
  IO.FS.createDirAll "out/lrc/img"
  let mut list := ""
  for row in rows do
    match row.splitOn "\t" with
    | name :: source :: kinds :: entry :: args :: value :: extra =>
      unless extra.length ≤ 1 do throw (IO.userError s!"lrc_diff_image_row: {row}")
      let out := s!"out/lrc/img/{name}.rscm"
      -- SOURCE `file:PATH` is an image file of this tree, `git:REV:PATH` one of another commit; anything else a
      -- source for the twin. A pinned file is copied every time, a made image is kept.
      if source.startsWith "file:" then IO.FS.writeBinFile out (← IO.FS.readBinFile (source.drop 5))
      else unless ← (FilePath.mk out).pathExists do
        let r ← if source.startsWith "git:" then IO.Process.spawn { cmd := "git", args := #["show", source.drop 4], stdout := .piped }
          else do
            let t ← twin
            IO.Process.spawn { cmd := t, args := #["bytes", source], stdout := .piped }
        let bytes ← r.stdout.readBinToEnd
        unless (← r.wait) == 0 do throw (IO.userError s!"lrc_diff_image: no image from {source}")
        IO.FS.writeBinFile out bytes
      list := list ++ s!"{name}\t{out}\t{kinds}\t{entry}\t{args}\t{value}\n"
    | _ => throw (IO.userError s!"lrc_diff_image_row: {row}")
  IO.FS.writeFile "out/lrc/img/list.tsv" list

structure Ran where
  exitCode : UInt32
  stdout : String
  stderr : String

-- A command with a wall limit in seconds (0: none). Exit code 124 when the limit ended it.
def runLimited (cmd : String) (args : Array String) (limit : Nat) : IO Ran := do
  let child ← IO.Process.spawn { cmd := cmd, args := args, stdout := .piped, stderr := .piped }
  let out ← IO.asTask child.stdout.readToEnd Task.Priority.dedicated
  let err ← IO.asTask child.stderr.readToEnd Task.Priority.dedicated
  let start ← IO.monoMsNow
  let mut code : Option UInt32 := none
  while code.isNone do
    match ← child.tryWait with
    | some c => code := some c
    | none =>
      if limit != 0 && (← IO.monoMsNow) - start > limit * 1000 then
        child.kill
        let _ ← child.wait
        code := some 124
      else IO.sleep 200
  return { exitCode := code.getD 1, stdout := ← IO.ofExcept out.get, stderr := ← IO.ofExcept err.get }

-- One run of every check on the sources, a mutant's text replaced when one is given.
-- 0: no mismatch. 1: a mismatch. 2: the run did not reach its total line (it does not build).
-- 124: the wall limit ended it.
def runOnce (m : Option Mutant) (quiet : Bool) (args : Array String := #[]) (limit : Nat := 0) : IO UInt32 := do
  IO.FS.createDirAll "out/lrc"
  images
  let path := "out/lrc/DiffAll.lean"
  IO.FS.writeFile path (← assemble m)
  let r ← runLimited "lean" (#["-DmaxRecDepth=100000", "--run", path] ++ args) limit
  unless quiet do
    IO.print r.stdout
    IO.eprint r.stderr
  if r.exitCode == 124 then return 124
  -- an elaboration error is not a caught mutant: the run must reach its total line
  if !(r.stdout.splitOn "total mismatch=").length == 2 then
    unless !quiet do IO.eprint r.stderr
    return 2
  return r.exitCode

-- one run of the checks on the sources as they are, and its verdict; the exit code is the run's own
def run (args : Array String) : IO UInt32 := do
  let rc ← runOnce none false args
  conclude { mode := 0, baseline := rc.toNat } rc

def mutants (only : Option String := none) : IO UInt32 := do
  let mut rows : List String := []
  let tags ← match only with
    | some t => pure [t]
    | none => pure ("" :: (← tagged "Mutants" ".tsv"))
  for t in tags do
    let text ← IO.FS.readFile s!"instruments/lrc-host/Mutants{t}.tsv"
    rows := rows ++ (text.splitOn "\n").filter (fun l => l != "" && !l.startsWith "#")
  -- The sources as they are must pass: on a tree with a mismatch of its own every row would read
  -- caught. The time of that run sets the limit of a row: a mutant that makes a pass or the
  -- interpreter run on without end is caught by the limit.
  let stdout ← IO.getStdout
  let start ← IO.monoMsNow
  let base ← runOnce none true #["quick"]
  let took := ((← IO.monoMsNow) - start) / 1000
  if base != 0 then
    IO.println s!"mutants baseline_exit={base}: the sources as they are do not pass; nothing replayed"
    return (← conclude { mode := 1, baseline := base.toNat } 2)
  let limit := 3 * took + 120
  IO.println s!"mutants baseline_exit=0 baseline_seconds={took} row_limit_seconds={limit}"
  stdout.flush
  let mut caught := 0
  let mut total := 0
  let mut ends : List Nat := []
  for row in rows do
    match row.splitOn "\t" with
    | [file, frm, to] =>
      total := total + 1
      let rc ← runOnce (some { file, frm, to }) true #["quick"] limit
      ends := ends ++ [rc.toNat]
      let verdict := if rc == 1 then "caught" else if rc == 124 then "caught_by_limit" else if rc == 0 then "SURVIVED" else "DOES_NOT_BUILD"
      if rc == 1 || rc == 124 then caught := caught + 1
      IO.println s!"mutant {verdict} file={file} from={frm} to={to}"
      stdout.flush
    | _ => throw (IO.userError s!"lrc_diff_mutant_row: {row}")
  IO.println s!"mutants caught={caught}/{total}"
  conclude { mode := 1, rows := ends } 1

-- The rows of one table as files, for a replay that compiles each check (interpreted, a row takes
-- the minutes the images' rows take): DIR/0.lean is the sources as they are, DIR/k.lean has row k
-- planted, DIR/rows.tsv lists k, file, from, to. A row is caught when its compiled check, run as
-- `quick`, reaches its total line and exits 1, as in `mutants`.
def emit (tag dir : String) : IO UInt32 := do
  images
  IO.FS.createDirAll dir
  let text ← IO.FS.readFile s!"instruments/lrc-host/Mutants{tag}.tsv"
  let rows := (text.splitOn "\n").filter (fun l => l != "" && !l.startsWith "#")
  IO.FS.writeFile s!"{dir}/0.lean" (← assemble none)
  let mut k := 0
  let mut list := ""
  for row in rows do
    match row.splitOn "\t" with
    | [file, frm, to] =>
      k := k + 1
      -- a row that does not plant ends the assembly: said with the table and the row's number, not only the line
      let src ← try assemble (some { file, frm, to }) catch e =>
        throw (IO.userError s!"lrc_diff_emit: row {k} of instruments/lrc-host/Mutants{tag}.tsv does not plant ({e}); rows {k} and after are not written")
      IO.FS.writeFile s!"{dir}/{k}.lean" src
      list := list ++ s!"{k}\t{file}\t{frm}\t{to}\n"
    | _ => throw (IO.userError s!"lrc_diff_mutant_row: {row}")
  IO.FS.writeFile s!"{dir}/rows.tsv" list
  IO.println s!"emit tag={tag} rows={k} dir={dir}"
  return 0

-- Does every row of every planted-row table plant: FROM exactly once in FILE (`readSource`). The tables are
-- instruments/lrc-host/Mutants.tsv, every Mutants<TAG>.tsv, and SidesMutants.tsv (which a replay of Sides.rsd
-- reads, not this driver). A row that does not is printed with its table and its number among the table's rows.
def plants : IO UInt32 := do
  let tags ← tagged "Mutants" ".tsv"
  let tables := ["instruments/lrc-host/Mutants.tsv"] ++ tags.map (fun t => s!"instruments/lrc-host/Mutants{t}.tsv")
    ++ ["instruments/lrc-host/SidesMutants.tsv"]
  let mut bad := 0
  let mut total := 0
  for table in tables do
    unless ← (FilePath.mk table).pathExists do continue
    let rows := ((← IO.FS.readFile table).splitOn "\n").filter (fun l => l != "" && !l.startsWith "#")
    let mut k := 0
    for row in rows do
      k := k + 1
      total := total + 1
      match row.splitOn "\t" with
      | [file, frm, _] =>
        let mut n := 0
        if ← (FilePath.mk file).pathExists then
          n := ((← IO.FS.readFile file).splitOn frm).length - 1
        if n != 1 then
          bad := bad + 1
          IO.println s!"plant table={table} row={k} occurrences={n} file={file} from={frm}"
      | _ =>
        bad := bad + 1
        IO.println s!"plant table={table} row={k}: not FILE, FROM, TO"
  IO.println s!"plants rows={total} not_planting={bad}"
  return (if bad == 0 then 0 else 1)

-- The modules as rsdc must accept them: one source, in dependency order, with an entry.
def rsdc : IO UInt32 := do
  let twin ← twin
  let mut src := ""
  let mut present : List String := []
  for f in base do src := src ++ (← readSource none f) ++ "\n"
  for p in passes do
    let f := s!"lib/lrc/{p}.rsd"
    if ← (FilePath.mk f).pathExists then
      src := src ++ (← readSource none f) ++ "\n"
      present := present ++ [p]
  for f in post do
    if ← (FilePath.mk f).pathExists then
      src := src ++ (← readSource none f) ++ "\n"
      present := present ++ [f]
  src := src ++ "\ndef main (k : Nat) : Nat := k\n"
  IO.FS.writeFile "out/lrc/All.rsd" src
  let r ← IO.Process.output { cmd := twin, args := #["check", "out/lrc/All.rsd"] }
  let first := (r.stdout.splitOn "\n").headD ""
  IO.println s!"rsdc modules={base.length + present.length} passes={present} bytes={src.length} verdict={first}"
  unless first == "ok" do
    IO.print r.stdout
    IO.eprint r.stderr
  conclude { mode := 2, twin := first } 1

-- The table of the front end's integer operations (instruments/lrc-host/MagTable.rsd): the stage's modules that
-- hold it, the image loader and the tool as one file, run with the twin.
def mag (write : Bool) : IO UInt32 := do
  let twin ← twin
  let mut src := "import Lean\n"
  for f in base do src := src ++ (← readSource none f) ++ "\n"
  for f in ["instruments/lrc-host/Oracle.rsd", "instruments/lrc-host/Image.rsd", "instruments/lrc-host/Interp.rsd", "instruments/lrc-host/MagTable.rsd"] do
    src := src ++ (← readSource none f) ++ "\n"
  src := src ++ "\ndef main (args : List String) : IO UInt32 := Lrc.Host.MagTable.run (args.headD \"\") (args.contains \"write\")\n"
  IO.FS.createDirAll "out/lrc"
  IO.FS.writeFile "out/lrc/MagAll.lean" src
  let r ← IO.Process.output { cmd := "lean", args := #["-DmaxRecDepth=100000", "--run", "out/lrc/MagAll.lean", twin] ++ (if write then #["write"] else #[]) }
  IO.print r.stdout
  IO.eprint r.stderr
  return r.exitCode

/-! ## cite: the line citations of the ported modules, checked against the pinned Lean sources

A ported module cites what it ports as `File:LINE name` (lib/lrc/PushProj.rsd). Checked for every
module of `cited`: the name stands on that line of the Lean file; and every definition of the Lean
file is cited somewhere in the module, or listed on a header line that starts with `-- absent:`. -/

-- a ported module, the tag its citations use, and the Lean file under the toolchain's Lean/Compiler
def cited : List (String × String × String) :=
  [("FreeVars", "FreeVars", "IR/FreeVars.lean"), ("LiveVars", "LiveVars", "IR/LiveVars.lean"),
   ("NormIds", "NormIds", "IR/NormIds.lean"), ("PushProj", "PushProj", "IR/PushProj.lean"),
   ("ElimDead", "ElimDeadVars", "IR/ElimDeadVars.lean"), ("SimpCase", "SimpCase", "IR/SimpCase.lean"),
   ("ElimDeadBranches", "ElimDeadBranches", "IR/ElimDeadBranches.lean"), ("ResetReuse", "ResetReuse", "IR/ResetReuse.lean"),
   ("ExpandResetReuse", "ExpandResetReuse", "IR/ExpandResetReuse.lean"), ("Borrow", "Borrow", "IR/Borrow.lean"),
   ("RC", "RC", "IR/RC.lean")]

def isNameChar (c : Char) : Bool := c.isAlphanum || c == '_' || c == '.' || c == '\''

-- the citations `tag:LINE name` of a text: line number and name (the name may be absent)
def citations (tag : String) (text : String) : List (Nat × String) := Id.run do
  let mut out := []
  for part in (text.splitOn (tag ++ ":")).drop 1 do
    let digits := part.takeWhile Char.isDigit
    if digits.isEmpty then continue
    let rest := ((part.drop digits.length).dropWhile (fun c => c == ' ' || c == '`'))
    let name := (rest.takeWhile isNameChar).dropRightWhile (· == '.')
    out := (digits.toNat!, name) :: out
  return out.reverse

-- the names a Lean file defines: the word after def, abbrev, structure, inductive, instance or class
def definedNames (text : String) : List String := Id.run do
  let mut out := []
  for line in text.splitOn "\n" do
    let ws := (line.splitOn " ").filter (· != "")
    let ws := ws.dropWhile (fun w => w == "private" || w == "protected" || w == "partial" || w == "unsafe" || w.startsWith "@[")
    match ws with
    | kw :: name :: _ =>
      if kw == "def" || kw == "abbrev" || kw == "structure" || kw == "inductive" || kw == "class" then
        let n := (name.takeWhile isNameChar)
        if n != "" && !out.contains n then out := n :: out
    | _ => pure ()
  return out.reverse

def lastPart (name : String) : String := ((name.splitOn ".").getLast?).getD name

def cite : IO UInt32 := do
  let root := (← IO.Process.output { cmd := "lean", args := #["--print-prefix"] }).stdout.trim ++ "/src/lean/Lean/Compiler/"
  let mut bad := 0
  let mut modules := 0
  let mut offAll := 0
  let mut uncited := 0
  for (module, tag, file) in cited do
    let path := s!"lib/lrc/{module}.rsd"
    unless ← (FilePath.mk path).pathExists do continue
    modules := modules + 1
    let text ← IO.FS.readFile path
    let lean := (← IO.FS.readFile (root ++ file)).splitOn "\n"
    let cs := citations tag text
    let mut off := 0
    for (line, name) in cs do
      let found := (lean.getD (line - 1) "").trim
      if name != "" && (found.splitOn (lastPart name)).length < 2 then
        off := off + 1
        IO.println s!"cite {module}: {tag}:{line} {name} is not on that line: {found.take 60}"
    let absent := ((text.splitOn "\n").filter (·.startsWith "-- absent:")).foldl (· ++ " " ++ ·) ""
    let mut missing := 0
    for d in definedNames ("\n".intercalate lean) do
      let short := lastPart d
      if !(cs.any (fun c => lastPart c.2 == short)) && (absent.splitOn short).length < 2 then
        missing := missing + 1
        IO.println s!"cite {module}: {file} defines {d}, which the module neither cites nor lists as absent"
    IO.println s!"cite module={module} citations={cs.length} off={off} definitions_uncited={missing}"
    bad := bad + off + missing
    offAll := offAll + off
    uncited := uncited + missing
  IO.println s!"cite total={bad}"
  conclude { mode := 3, modules := modules, off := offAll, uncited := uncited } 1

end Lrc.Diff

def main (args : List String) : IO UInt32 := do
  match args with
  | [] => Lrc.Diff.run #[]
  | ["mutants"] => Lrc.Diff.mutants
  | ["mutants", tag] => Lrc.Diff.mutants (some tag)
  | ["emit", tag, dir] => Lrc.Diff.emit tag dir
  | ["plants"] => Lrc.Diff.plants
  | ["rsdc"] => Lrc.Diff.rsdc
  | ["mag"] => Lrc.Diff.mag false
  | ["mag", "write"] => Lrc.Diff.mag true
  | ["ir"] => Lrc.Diff.run #["ir"]
  | ["quick"] => Lrc.Diff.run #["quick"]
  | ["cite"] => Lrc.Diff.cite
  | _ => throw (IO.userError "lean --run instruments/lrc-host/Diff.rsd [quick | mutants [TAG] | emit TAG DIR | plants | rsdc | mag [write] | ir | cite]")
