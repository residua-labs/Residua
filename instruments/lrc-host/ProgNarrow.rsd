-- micro program for a module whose object fields are four bytes (rsc's layer `narrow`; lib/lrc/FromWire.rsd
-- `magLimsOf`). A small number then ends at 2^31 and a small integer at 2^30 either way, two factors below 2^15
-- have a small product, and a list of four limbs is a small number or is not. Here: every operation of
-- instruments/lrc-host/ProgMag.rsd at those edges, the conversions of instruments/lrc-host/ProgConv.rsd there, a word of
-- 32 bits to a natural number and back at 2^31 and at its top, sums that cross an edge while they run, a list of
-- integers on both sides of the edge (each element is one word: a small integer or an object), and a tree that
-- holds such numbers. Under the layers without `narrow` every number here is far below the bound of a small one.
def b31 : Nat := 2147483648

def b30 : Nat := 1073741824

def b15 : Nat := 32768

def b24 : Nat := 16777216

def b32 : Nat := 4294967296

def c31 : Int := 2147483648

def c30 : Int := 1073741824

def c15 : Int := 32768

def natOps (a b : Nat) : List Nat :=
  [a + b, a - b, b - a, a * b, a / b, a % b, b / a, b % a,
   (if a < b then 1 else 0), (if a <= b then 1 else 0), (if a > b then 1 else 0), (if a >= b then 1 else 0),
   (if a == b then 1 else 0)]

def intOps (a b : Int) : List Int :=
  [a + b, a - b, b - a, a * b, a / b, a % b, b / a, b % a, -a, -b,
   (if a < b then 1 else 0), (if a <= b then 1 else 0), (if a > b then 1 else 0), (if a >= b then 1 else 0),
   (if a == b then 1 else 0)]

def narrowNat : List Nat :=
  natOps (b31 - 1) 1 ++ natOps (b31 - 1) (b31 - 1) ++ natOps b31 1 ++ natOps b31 b31 ++ natOps (b31 + 5) (b31 - 3)
    ++ natOps (b30 - 1) 1 ++ natOps b30 b30 ++ natOps (b30 - 1) b30
    ++ natOps b15 b15 ++ natOps (b15 - 1) (b15 + 1) ++ natOps (b15 - 1) (b15 - 1) ++ natOps (b15 * 2) (b15 - 1)
    ++ natOps 46340 46341 ++ natOps 46341 46341
    ++ natOps (b24 - 1) 1 ++ natOps b24 255 ++ natOps (b32 - 1) 1 ++ natOps b32 (b32 - 1) ++ natOps (b31 * b31) 3

def narrowInt : List Int :=
  intOps (c30 - 1) 1 ++ intOps (1 - c30) 1 ++ intOps (1 - c30) (0 - 1) ++ intOps (c30 - 1) (1 - c30) ++ intOps c30 (0 - c30)
    ++ intOps (c30 + 5) (3 - c30) ++ intOps (c31 - 1) 1 ++ intOps (1 - c31) (0 - 1) ++ intOps c31 (0 - c31)
    ++ intOps c15 c15 ++ intOps (0 - c15) c15 ++ intOps (c15 - 1) (0 - (c15 + 1)) ++ intOps (c15 - 1) (c15 - 1)
    ++ intOps (0 - (c15 - 1)) (c15 - 1) ++ intOps (c30 - 1) (c30 - 1) ++ intOps (1 - c30) (1 - c30)

-- a sum that crosses 2^31 while it runs
def climb : Nat → Nat → Nat
  | 0, acc => acc
  | k + 1, acc => climb k (acc + 300000000)

-- a difference that goes from above 2^30 to below its negative
def fall : Nat → Int → Int
  | 0, acc => acc
  | k + 1, acc => fall k (acc - 250000000)

def pred : Nat → Nat
  | 0 => 0
  | k + 1 => k

def sign : Nat → Int
  | 0 => 0
  | _ + 1 => 1

def add32 (a b : UInt32) : UInt32 := a + b

def mul32 (a b : UInt32) : UInt32 := a * b

def narrowConv : List Nat :=
  [Int.toNat (c30 - 1), Int.toNat c30, Int.toNat (c31 - 1), Int.toNat c31, Int.toNat (0 - c30), Int.toNat (1 - c30),
   pred b30, pred (b30 + 1), pred b31, pred (b31 + 1), pred b32,
   (UInt32.ofNat (b31 - 1)).toNat, (UInt32.ofNat b31).toNat, (UInt32.ofNat (b32 - 1)).toNat, (UInt32.ofNat b32).toNat,
   (UInt32.ofNat (b32 + b31 + 7)).toNat,
   (add32 2147483647 1).toNat, (add32 4294967295 4294967295).toNat, (mul32 65536 32768).toNat, (mul32 65535 65537).toNat,
   climb 6 0, climb 7 0, climb 8 0, climb 10 5]

def ints : List Int :=
  [c30 - 1, c30, 1 - c30, 0 - c30, c31, 0 - c31, 0, 0 - 1, 1, c31 - 1, 1 - c31]

def sumL : List Int → Int
  | [] => 0
  | x :: xs => x + sumL xs

def negAll : List Int → List Int
  | [] => []
  | x :: xs => (0 - x) :: negAll xs

def same : List Int → List Int → Int
  | x :: xs, y :: ys => (if x == y then 1 else 0) + same xs ys
  | _, _ => 0

def bumpAll : Int → List Int → List Int
  | _, [] => []
  | d, x :: xs => (x + d) :: bumpAll d xs

inductive T where
  | leaf (n : Nat) (i : Int) : T
  | node (a b : T) : T

def build : Nat → Nat → Int → T
  | 0, n, i => T.leaf n i
  | k + 1, n, i => T.node (build k (n + n) (i + i)) (build k (n + 1) (0 - i))

def sumN : T → Nat
  | T.leaf n _ => n
  | T.node a b => sumN a + sumN b

def sumI : T → Int
  | T.leaf _ i => i
  | T.node a b => sumI a - sumI b

def narrowMix : List Int :=
  [Int.ofNat (b30 - 1), Int.ofNat b30, Int.ofNat (b31 - 1), Int.ofNat b31, Int.ofNat b32, 0 - Int.ofNat b30,
   0 - Int.ofNat (b30 - 1), 0 - Int.ofNat b31, sign b30, sign b31, Int.ofNat (Int.toNat (c30 + 1)) - c30,
   fall 4 1000000000, fall 5 1000000000, fall 9 1100000000, fall 10 1100000000,
   sumL ints, sumL (negAll ints), same ints ints, same ints (negAll ints), same ints (negAll (negAll ints)),
   sumL (bumpAll 1 ints), sumL (bumpAll (0 - 1) ints), sumL (bumpAll c30 ints),
   Int.ofNat (sumN (build 4 (b30 - 3) 5)), Int.ofNat (sumN (build 3 b31 5)), Int.ofNat (sumN (build 2 (b24 - 1) 5)),
   sumI (build 4 7 (c30 - 2)), sumI (build 5 7 (1 - c30)), sumI (build 3 7 c31)]
     ++ bumpAll 0 ints ++ negAll ints
