-- micro program for the numbers a node holds (lib/lrc/FromWire.rsd "Numbers in nodes"): fields of type Nat, Int,
-- List Nat and List Int of recursive types, read, summed, rebuilt and updated; zero, both signs, numbers around
-- 2^56 (where a magnitude stops being a small number) and far above it; empty lists; and a structure that holds a
-- String beside a Nat (the String's node is one the image writes with the wire's own list). The inductive type of
-- instruments/lrc-host/ProgNumInd.rsd is a program of its own: the front end refuses the two in one program
-- (`rsdc_arena_field`).
structure T where
  n : Nat
  i : Int
  ns : List Nat
  js : List Int
  kids : List T

def b56 : Nat := 72057594037927936

def c56 : Int := 72057594037927936

def big : Nat := 1208925819614629174706181

def bigI : Int := 1208925819614629174706181

def leaf (n : Nat) (i : Int) : T :=
  { n := n, i := i, ns := [n, n + 1], js := [i, 0 - i], kids := [] : T }

def node (a b : T) : T :=
  { n := a.n + b.n, i := a.i - b.i, ns := a.ns ++ b.ns, js := b.js ++ a.js, kids := [a, b] : T }

def build : Nat → Nat → Int → T
  | 0, k, i => leaf k (i * 3 - 7)
  | d + 1, k, i => node (build d (2 * k) (i + 1)) (build d (2 * k + 1) (0 - i))

def sumN : Nat → T → Nat
  | 0, t => t.n
  | d + 1, t =>
    match t.kids with
    | [] => t.n
    | a :: rest =>
      match rest with
      | [] => t.n + sumN d a
      | b :: _ => t.n + sumN d a + sumN d b

def sumI : Nat → T → Int
  | 0, t => t.i
  | d + 1, t =>
    match t.kids with
    | [] => t.i
    | a :: rest =>
      match rest with
      | [] => t.i + sumI d a
      | b :: _ => t.i + sumI d a - sumI d b * 2

def lenAll : Nat → T → Nat
  | 0, t => t.ns.length + t.js.length
  | d + 1, t =>
    match t.kids with
    | [] => t.ns.length + t.js.length
    | a :: rest =>
      match rest with
      | [] => t.ns.length + lenAll d a
      | b :: _ => t.ns.length + t.js.length + lenAll d a + lenAll d b

-- every node rebuilt with each number changed
def bump : Nat → T → T
  | 0, t => { n := t.n + 1, i := 0 - t.i, ns := t.n :: t.ns, js := t.js ++ [t.i], kids := t.kids : T }
  | d + 1, t =>
    match t.kids with
    | [] => { n := t.n + 1, i := 0 - t.i, ns := t.n :: t.ns, js := t.js ++ [t.i], kids := [] : T }
    | a :: rest =>
      match rest with
      | [] => { n := t.n + 1, i := 0 - t.i, ns := t.n :: t.ns, js := t.js ++ [t.i], kids := [bump d a] : T }
      | b :: _ => { n := t.n + 1, i := 0 - t.i, ns := t.n :: t.ns, js := t.js ++ [t.i], kids := [bump d b, bump d a] : T }

def numNats (d : Nat) : List Nat :=
  let t : T := build d 1 2
  let u : T := bump d t
  [t.n, sumN d t, lenAll d t, u.n, sumN d u, lenAll d u] ++ t.ns ++ u.ns

def numInts (d : Nat) : List Int :=
  let t : T := build d 1 2
  let u : T := bump d t
  [t.i, sumI d t, u.i, sumI d u] ++ t.js ++ u.js

-- zero, a number that is no small number, the bounds of one, in every field; the lists empty and not
def edge (n : Nat) (i : Int) : T :=
  { n := n, i := i, ns := [], js := [], kids := [] : T }

def numEdgeN : List Nat :=
  let a : T := edge 0 0
  let b : T := edge big bigI
  let c : T := edge (b56 - 1) (1 - c56)
  let d : T := edge b56 (0 - c56)
  let e : T := node (node a b) (node c d)
  let f : T := { n := e.n * 2, i := e.i, ns := [0, big, b56 - 1, b56], js := e.js, kids := e.kids : T }
  [a.n, b.n, c.n, d.n, e.n, sumN 2 e, f.n, a.ns.length, e.ns.length, lenAll 2 f] ++ f.ns ++ (bump 2 f).ns

def numEdgeI : List Int :=
  let a : T := edge 0 0
  let b : T := edge big (0 - bigI)
  let c : T := edge (b56 - 1) (1 - c56)
  let d : T := edge b56 c56
  let e : T := node (node a b) (node c d)
  let f : T := { n := e.n, i := e.i * 2, ns := e.ns, js := [0, bigI, 0 - bigI, c56 - 1, 1 - c56, c56, 0 - c56], kids := e.kids : T }
  [a.i, b.i, c.i, d.i, e.i, sumI 2 e, f.i] ++ f.js ++ (bump 2 f).js

-- a String beside a Nat: the String's node holds the wire's list, the Nat's node the number
structure S where
  n : Nat
  s : String
  kids : List S

def names : Nat → Nat → S
  | 0, k => { n := k, s := "end", kids := [] : S }
  | m + 1, k => { n := k * 300, s := (if m % 2 == 0 then "even" else "odd"), kids := [names m (k + 1)] : S }

def lens : Nat → S → Nat
  | 0, x => x.n + x.s.length
  | m + 1, x =>
    match x.kids with
    | [] => x.n + x.s.length
    | y :: _ => x.n + x.s.length + lens m y

def numNames (m : Nat) : List Nat :=
  let x : S := names m 1
  [lens m x, x.n, x.s.length]

-- the entries of the rows: no argument (a row's host passes words, and these take a Nat)
def natsAt3 : List Nat := numNats 3

def intsAt3 : List Int := numInts 3

def namesAt5 : List Nat := numNames 5
