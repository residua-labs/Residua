-- micro program for the one layout of a merged class (lib/lrc/FromWire.rsd `layUnion`). In both types the
-- constructor with children has the lower tag, and the image's first function (`pair`) allocates one, so the
-- image's tags are found with the childless tag last: a union that took the children of the last tag alone
-- would take none. Laid out as one class (the host check's second run of every image), the read of the number
-- that `U.more` holds finds no single tag, and the class is merged.
inductive T where
  | node (l : T) (r : T) : T
  | leaf : T

inductive U where
  | more (n : Nat) (u : U) : U
  | stop : U

def pair (t : T) (n : Nat) (u : U) : U := U.more (n + (match t with | T.node _ _ => 1 | T.leaf => 0)) u

def wrap (t : T) : T := T.node t t

def tip : T := T.leaf

def depth : T → Nat
  | T.leaf => 0
  | T.node l _ => depth l + 1

def chainU : Nat → U
  | 0 => U.stop
  | k + 1 => pair (wrap tip) (k * 3) (chainU k)

def sumU : U → Nat
  | U.stop => 0
  | U.more n u => n + sumU u

def orderMain : Nat := depth (wrap (wrap tip)) * 100 + sumU (chainU 4)
