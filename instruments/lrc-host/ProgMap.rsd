-- Persistent AVL map, OCaml's Map (Stephen Adams, 1993).
-- Referenced by q via the declaration-closure cache (import AvlMap).
-- closure_claim = 0.

-- avl begin
structure Map where
  tag : Int
  key : Int
  val : Int
  h : Int
  sa : Int
  sb : Int
  extra : List Int
  left : List Map
  right : List Map
  deriving Inhabited

structure MR where
  m : Map
  v : Int
  steps : Int
  xs : List Int
  hit : Map
  deriving Inhabited

def map0 : Nat -> Map
  | 0 => { tag := 0, key := 0, val := 0, h := 0, sa := 0, sb := 0, extra := [], left := [], right := [] : Map }
  | n + 1 => map0 n

def mr0 : Nat -> Map -> Int -> MR
  | 0, m, v => { m := m, v := v, steps := 0, xs := [], hit := map0 0 : MR }
  | n + 1, m, v => mr0 n m v

def kid : Nat -> List Map -> Map
  | 0, [] => map0 0
  | 0, m :: _ => m
  | _ + 1, xs => kid 0 xs

def box : Nat -> Map -> List Map
  | 0, m => if m.tag == 0 then [] else [m]
  | n + 1, m => box n m

def imax : Nat -> Int -> Int -> Int
  | 0, a, b => if a > b then a else b
  | n + 1, a, b => imax 0 a b

def mapH : Nat -> Map -> Int
  | 0, m => if m.tag == 0 then 0 else m.h
  | n + 1, m => mapH 0 m

def mk : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    { tag := 1, key := k, val := v, h := imax 0 (mapH 0 l) (mapH 0 r) + 1, sa := sa, sb := sb, extra := xs, left := box 0 l, right := box 0 r : Map }
  | n + 1, l, k, v, sa, sb, xs, r => mk n l k v sa sb xs r

def bal : Nat -> Map -> Int -> Int -> Int -> Int -> List Int -> Map -> Map
  | 0, l, k, v, sa, sb, xs, r =>
    let hl : Int := mapH 0 l;
    let hr : Int := mapH 0 r;
    if hl > hr + 2 then
      let ll : Map := kid 0 (l.left);
      let lr : Map := kid 0 (l.right);
      if mapH 0 ll >= mapH 0 lr then mk 0 ll l.key l.val l.sa l.sb l.extra (mk 0 lr k v sa sb xs r)
      else
        let lrl : Map := kid 0 (lr.left);
        let lrr : Map := kid 0 (lr.right);
        mk 0 (mk 0 ll l.key l.val l.sa l.sb l.extra lrl) lr.key lr.val lr.sa lr.sb lr.extra (mk 0 lrr k v sa sb xs r)
    else if hr > hl + 2 then
      let rl : Map := kid 0 (r.left);
      let rr : Map := kid 0 (r.right);
      if mapH 0 rr >= mapH 0 rl then mk 0 (mk 0 l k v sa sb xs rl) r.key r.val r.sa r.sb r.extra rr
      else
        let rll : Map := kid 0 (rl.left);
        let rlr : Map := kid 0 (rl.right);
        mk 0 (mk 0 l k v sa sb xs rll) rl.key rl.val rl.sa rl.sb rl.extra (mk 0 rlr r.key r.val r.sa r.sb r.extra rr)
    else mk 0 l k v sa sb xs r
  | n + 1, l, k, v, sa, sb, xs, r => bal 0 l k v sa sb xs r

def get : Map -> Int -> MR

  | { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right }, k =>
    let m : Map := { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right };
    if m.tag == 0 then { m := m, v := -1, steps := 1, xs := [], hit := map0 0 : MR }
    else if k == m.key then { m := m, v := m.val, steps := 1, xs := m.extra, hit := m : MR }
    else if k < m.key then
      match left with
      | [] => { m := m, v := -1, steps := 2, xs := [], hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := get child k;
        { m := m, v := a.v, steps := a.steps + 1, xs := a.xs, hit := a.hit : MR }
    else
      match right with
      | [] => { m := m, v := -1, steps := 2, xs := [], hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := get child k;
        { m := m, v := a.v, steps := a.steps + 1, xs := a.xs, hit := a.hit : MR }

def ins : Map -> Int -> Int -> Int -> Int -> List Int -> MR

  | { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right }, k, v, sa, sb, xs =>
    let m : Map := { tag := tag, key := key, val := oldVal, h := h, sa := oldSa, sb := oldSb, extra := extra, left := left, right := right };
    if m.tag == 0 then { m := mk 0 (map0 0) k v sa sb xs (map0 0), v := v, steps := 1, xs := xs, hit := map0 0 : MR }
    else if k == m.key then { m := mk 0 (kid 0 (m.left)) k v sa sb xs (kid 0 (m.right)), v := v, steps := 1, xs := xs, hit := m : MR }
    else if k < m.key then
      match left with
      | [] =>
        let child : Map := mk 0 (map0 0) k v sa sb xs (map0 0);
        { m := bal 0 child m.key m.val m.sa m.sb m.extra (kid 0 (m.right)), v := v, steps := 2, xs := xs, hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := ins child k v sa sb xs;
        { m := bal 0 a.m m.key m.val m.sa m.sb m.extra (kid 0 (m.right)), v := v, steps := a.steps + 1, xs := xs, hit := map0 0 : MR }
    else
      match right with
      | [] =>
        let child : Map := mk 0 (map0 0) k v sa sb xs (map0 0);
        { m := bal 0 (kid 0 (m.left)) m.key m.val m.sa m.sb m.extra child, v := v, steps := 2, xs := xs, hit := map0 0 : MR }
      | child :: _ =>
        let a : MR := ins child k v sa sb xs;
        { m := bal 0 (kid 0 (m.left)) m.key m.val m.sa m.sb m.extra a.m, v := v, steps := a.steps + 1, xs := xs, hit := map0 0 : MR }
-- avl end

-- micro program for nodes whose children are a list: the map above, filled and read back
def fillGo : Nat → Int → Map → Map
  | 0, _, m => m
  | k + 1, i, m => fillGo k (i + 1) (ins m ((i * 7) % 13) (i * i + 1) i 0 [i, i + 1]).m

def readGo : Nat → Int → Map → Int → Int
  | 0, _, _, acc => acc
  | k + 1, i, m, acc =>
    let r : MR := get m i;
    readGo k (i + 1) m (acc * 3 + r.v + r.steps + (match r.xs with | [] => 0 | x :: _ => x))

def heightOf (m : Map) : Int := mapH 0 m

-- a node whose list of children is written as a literal list
def single (k : Int) (c : Map) : Map :=
  { tag := 1, key := k, val := k + 1, h := 2, sa := 0, sb := 0, extra := [], left := [c], right := [] : Map }

def singleSum (k : Int) : Int :=
  let m : Map := single k (mk 0 (map0 0) (k + 5) (k * 3) 0 0 [] (map0 0));
  (kid 0 (m.left)).key + (kid 0 (m.left)).val + (get m k).v + mapH 0 (kid 0 (m.right))

-- A second type with a list of itself. Its children are met by nothing but the node that holds
-- them: written as a literal list (`nodeT`) or as a list made elsewhere (`nodeL`), and read back
-- by a function that no leaf is passed to. The two kinds of node have a reader each (`firstVal`,
-- `firstValL`), so that nothing but its own way of holding the children says what a child is.
structure Tw where
  val : Int
  kids : List Tw
  deriving Inhabited

def leafT (v : Int) : Tw := { val := v, kids := [] }

def nodeT (v : Int) (a : Tw) (b : Tw) : Tw := { val := v, kids := [a, b] }

def twoLeaves (a b : Int) : List Tw := [leafT a, leafT b]

def nodeL (v : Int) (xs : List Tw) : Tw := { val := v, kids := xs }

def firstVal (t : Tw) : Int :=
  match t.kids with
  | [] => 0 - 1
  | c :: _ => t.val * 100 + c.val

def firstValL (t : Tw) : Int :=
  match t.kids with
  | [] => 0 - 1
  | c :: _ => t.val * 100 + c.val

-- a function whose result has both constructors only through its own recursion
inductive Par where
  | ev
  | od

def flipP : Nat → Par
  | 0 => Par.ev
  | n + 1 => match flipP n with
    | Par.ev => Par.od
    | Par.od => Par.ev

def parNum (n : Nat) : Int :=
  match flipP n with
  | Par.ev => 10
  | Par.od => 20

def lbMain (n : Int) : Int :=
  let m : Map := fillGo n.toNat 0 (map0 0);
  readGo 14 0 m (heightOf m) + singleSum n + firstVal (nodeT n (leafT (n + 3)) (leafT 1)) + firstValL (nodeL n (twoLeaves (n + 7) 2))
    + parNum n.toNat + parNum 4

def lbAt0 : Int := lbMain 0
def lbAt1 : Int := lbMain 1
def lbAt9 : Int := lbMain 9
def lbAt30 : Int := lbMain 30

-- A node with eight nodes for fields, and the read of the last: child 7, read where it stands, and
-- nothing else under `wideAt` stands as deep, so the fuel that read needs is the fuel `wideAt` needs.
structure Wide where
  a : Tw
  b : Tw
  c : Tw
  d : Tw
  e : Tw
  f : Tw
  g : Tw
  h : Tw
  more : List Wide
  deriving Inhabited

def lastOf (w : Wide) : Tw := w.h

def wideAt : Int :=
  (lastOf { a := leafT 1, b := leafT 2, c := leafT 3, d := leafT 4, e := leafT 5, f := leafT 6, g := leafT 7, h := leafT 8, more := [] }).val

-- A node with eight integers for fields, and the read of the last. Main's front end reads an
-- integer field through its node helper, a function that takes the record (the field is child 7),
-- so the read stands one call deeper than `wideAt`'s; again the fuel it needs is the fuel `recAt` needs.
structure Rec8 where
  a : Int
  b : Int
  c : Int
  d : Int
  e : Int
  f : Int
  g : Int
  h : Int
  more : List Rec8
  deriving Inhabited

def lastInt (r : Rec8) : Int := r.h

def recAt : Int :=
  lastInt { a := 1, b := 2, c := 3, d := 4, e := 5, f := 6, g := 7, h := 8, more := [] }
