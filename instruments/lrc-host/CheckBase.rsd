-- LRC host oracle: the foundation modules against Lean's (stock Lean only). closure_claim = 0.
-- FreeVars.rsd (max index, free indices, occurrence), LiveVars.rsd (live set, liveness of one
-- variable), NormIds.rsd (uniqueness, renumbering).
open Lean IR

namespace Lrc.Host

def idxList (s : IndexSet) : List Nat := s.toList
def varList (s : VarIdSet) : List Nat := s.toList.map (·.idx)

def checkBase (corpus : List Prog) (verbose : Nat := 3) : IO Nat := do
  let mut n := 0
  let mut bad := 0
  let mut skipped := 0
  for p in corpus do
    for d in p.decls do
      if d.ext then continue
      match toDecl d with
      | .ok (.fdecl f xs t body info) =>
        n := n + 1
        let D := IR.Decl.fdecl f xs t body info
        let mut why : List String := []
        if D.maxIndex != Lrc.declMaxIndex d then why := "declMaxIndex" :: why
        if body.maxIndex != Lrc.maxIndex d.body then why := "maxIndex" :: why
        let fv := idxList body.freeIndices
        if fv != Lrc.vsToList (Lrc.freeIndices d.body) then why := "freeIndices" :: why
        if varList (Lean.IR.collectLiveVars body {}) != Lrc.vsToList (Lrc.collectLiveVars d.body [] Lrc.vsEmpty) then
          why := "collectLiveVars" :: why
        -- one variable at a time: every free index, and one index above all
        for x in (body.maxIndex + 1) :: fv do
          if body.hasLiveVar {} { idx := x } != Lrc.hasLiveVar d.body [] x then why := s!"hasLiveVar {x}" :: why
          if body.hasFreeVar { idx := x } != Lrc.hasFreeVar d.body x then why := s!"hasFreeVar {x}" :: why
        if D.uniqueIds != Lrc.declUniqueIds d then why := "uniqueIds" :: why
        -- renumbering is compared as text: the numbers are its result
        match toDecl (Lrc.declNormalizeIds d) with
        | .ok got => if showDecl D.normalizeIds != showDecl got then why := "normalizeIds" :: why
        | .error e => why := s!"normalizeIds: {e}" :: why
        if !why.isEmpty then
          bad := bad + 1
          if bad <= verbose then
            IO.println s!"MISMATCH pass=base program={p.name} f={d.f} in {why}\n{showDecl D}"
      | _ => skipped := skipped + 1
  IO.println s!"check pass=base decls={n} skipped={skipped} mismatch={bad}"
  return bad

end Lrc.Host
