-- LRC host oracle: the check of lib/lrc/PushProj.rsd against Lean's IR/PushProj.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:38 and IR.lean:57: after elimDeadBranches, and again after expandResetReuse; and on
-- Lean's own compiled declarations.
def check_PushProj (staged : List Staged) (lean : List Prog) : IO Nat := do
  let a ← checkDeclPass "pushProj.first" (·.edb) (·.pp1) Lrc.declPushProj staged
  let b ← checkDeclPass "pushProj.second" (·.err) (·.pp2) Lrc.declPushProj staged
  let c ← checkPure "pushProj.lean" IR.Decl.pushProj Lrc.declPushProj lean
  return a + b + c

end Lrc.Host
