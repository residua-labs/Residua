-- LRC host oracle: the check of lib/lrc/RC.rsd against Lean's IR/RC.lean (stock Lean only). closure_claim = 0.
open Lean IR

namespace Lrc.Host

-- IR.lean:52, after inferBorrow, on the whole program.
def check_RC (staged : List Staged) (_lean : List Prog) : IO Nat :=
  checkProgPass "explicitRC" (·.bw) (·.rc) Lrc.explicitRC staged

end Lrc.Host
