-- micro program for a test and the case that reads it (lib/lrc/JoinOnce.rsd `condDown`, lib/lrc/Emit.rsd `emTest`).
-- `twice` reads one test in two places: the case that chooses `r`, and the join point that takes `r`. The test
-- may not move to the first, and its word has to be made. `chain` is `a && b && c`: three tests in a row, each
-- read by its case alone. `markOne` stores the word of its test in the alternative the test selects, and only
-- there: the word has to be made although the case stands directly below. The numbers come out of a list at
-- run time, so that no fact folds a test.
def twice (a b : UInt32) : UInt32 :=
  let r := if a < b then a + 1 else b + 2
  if a < b then r * 10 + r else r * 100 + r

def chain (a b c : UInt32) : UInt32 :=
  if a != b && a != b + c && a != b - c then 1 else 0

def nth : List UInt32 -> Nat -> UInt32
  | [], _ => 0
  | x :: _, 0 => x
  | _ :: xs, k + 1 => nth xs k

def markOne (a b : UInt32) : List (Bool × UInt32) :=
  let t : Bool := a < b
  if t then [(t, a)] else [(false, b), (false, a)]

def marks : List UInt32 -> List (List (Bool × UInt32))
  | a :: b :: rest => markOne a b :: marks (b :: rest)
  | _ => []

def sumOne : List (Bool × UInt32) -> Nat
  | [] => 0
  | (t, x) :: rest => (if t then 100 else 200) + x.toNat + sumOne rest

def sumMarks : List (List (Bool × UInt32)) -> Nat
  | [] => 0
  | m :: rest => sumOne m + sumMarks rest

def testMain : List Nat :=
  let v : List UInt32 := [3, 5, 7, 1, 2, 4]
  [(twice (nth v 0) (nth v 1)).toNat, (twice (nth v 1) (nth v 0)).toNat, (twice (nth v 2) (nth v 2)).toNat,
   (chain (nth v 3) (nth v 4) (nth v 0)).toNat, (chain (nth v 1) (nth v 4) (nth v 0)).toNat,
   (chain (nth v 4) (nth v 4) (nth v 0)).toNat, (chain (nth v 5) (nth v 1) (nth v 3)).toNat,
   sumMarks (marks v)]
