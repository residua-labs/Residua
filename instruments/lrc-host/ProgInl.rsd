-- micro program for a function with one caller written at its call (lib/lrc/Emit.rsd "A function with one caller").
-- `below` is a loop with one caller, `tally`, which is a loop that calls it in every round: a loop inside a loop,
-- the shape of nqueens. Both have numbers of 32 bits and lists of them and nothing else, so that neither has a
-- boundary twin and the range pass makes a clone of each: the inner clone's one caller is the outer clone, and
-- the outer clone's one caller is `inlMain`. `skip` on the empty list ends before its first round: entered
-- without fuel it has to refuse as the call it stands for would (`inlEmpty`, the row inlempty). `firstOver` has
-- two callers and stays a call; so does `total`, whose second caller is its boundary twin.
-- instruments/lrc-host/Sides.rsd enters each row at 41 budgets: what shows a wrong count of fuel is a status
-- that differs at one of them.
def below (b : UInt32) (d : UInt32) : List UInt32 → UInt32 → UInt32
  | [], acc => acc
  | x :: xs, acc => below b (d + 1) xs (if x + d < b then acc + 1 else acc)

def tally (xs : List UInt32) : List UInt32 → UInt32 → UInt32
  | [], acc => acc
  | k :: ks, acc => tally xs ks (acc * 31 + below k 1 xs 0)

def total : List Nat → Nat → Nat
  | [], acc => acc
  | x :: xs, acc => total xs (acc + x)

-- the first element above a bound, or the number of elements when there is none
def firstOver (b : UInt32) : List UInt32 → UInt32 → UInt32
  | [], n => n
  | x :: xs, n => if x > b then x else firstOver b xs (n + 1)

def skip : List UInt32 → UInt32 → UInt32
  | [], n => n
  | _ :: xs, n => skip xs (n + 1)

def inlEmpty : UInt32 := skip [] 7

def inlMain : List Nat :=
  let xs : List UInt32 := [3, 1, 4, 1, 5, 9, 2, 6, 4294967295, 7]
  let t := tally xs [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33] 0
  let fs := [(firstOver 8 xs 0).toNat, (firstOver 4294967295 xs 0).toNat]
  [t.toNat, total fs 0] ++ fs
