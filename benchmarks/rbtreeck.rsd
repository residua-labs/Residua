-- rbtree-ck: the Koka/Perceus suite program test/bench/koka/rbtree-ck.kk (koka-lang/koka, master, fetched
-- 2026-11-04), itself adapted from the Lean 4 IFL19 benchmark tests/bench/rbmap-checkpoint.lean. Same
-- algorithm as rbtree.rsd (see that file): persistent red-black insert with the Okasaki-style balancing,
-- fold counting the keys whose value is true. The checkpoint variant keeps every `freq`-th intermediate
-- tree alive in a list while inserting (Koka: `make-tree-aux` conses `t'` whenever `n % freq == 0`), so
-- the kept trees share subtrees; the result folds the head of that list (the fully built tree, consed at
-- n = 0). Koka's int32 key is Int; Koka's counter loop is structural recursion on a Nat. `rbtreeCk freq n`
-- returns the count of the finished tree; the host prints it.
-- Source pin (the source table, 2026-11-06): koka-lang/koka commit facb7932ce6871fdb063f762a304bd8238f35fba
-- (master), test/bench/koka/rbtree-ck.kk, sha256
-- ca82d1468cf10fdc71249f492c1ac086273a495b8473b06cbf3c09d15e70336c
-- (byte-identical to the 2026-11-04 the benchmark kit fetch). Rechecked against it: no drift except this
-- named departure -- rbtree-ck.kk (like lean4 IFL19 rbmap-checkpoint.lean) blackens the root only
-- when it was red; this port always blackens after insert, exactly as rbtree.kk / rbtree.rsd do.
-- The two colour the roots of some intermediate trees differently, but every insert, key, value and
-- the folded output (count of true values over the inserted key set) are identical at every input,
-- so the checkpoint semantics (keep every freq-th tree; fold the head) are unchanged.

-- Official OCaml reference (suite provenance, fetched 2026-11-06): koka-lang/koka commit facb7932ce6871fdb063f762a304bd8238f35fba
-- (master), test/bench/ocaml/rbtree-ck.ml, sha256
-- 35e028ec81a9428d12157a34bfacd7f4310257b9184224376b31ca33202281fb
-- (raw.githubusercontent.com/koka-lang/koka/facb7932ce6871fdb063f762a304bd8238f35fba/test/bench/ocaml/rbtree-ck.ml). Note the twins
-- differ at the root: the .ml blackens only when red, the .kk (and this port) always blackens; every
-- insert, key, value and the fold result are identical either way. Rechecked line by line: no other
-- drift. Its main runs freq 5, n = 4200000.
inductive Color where
  | red : Color
  | black : Color

inductive Tree where
  | leaf : Tree
  | node : Color -> Tree -> Int -> Bool -> Tree -> Tree

def isRed : Tree -> Bool
  | Tree.node Color.red _ _ _ _ => true
  | _ => false

def balanceLeft (l : Tree) (k : Int) (v : Bool) (r : Tree) : Tree :=
  match l with
  | Tree.node _ (Tree.node Color.red lx kx vx rx) ky vy ry =>
    Tree.node Color.red (Tree.node Color.black lx kx vx rx) ky vy (Tree.node Color.black ry k v r)
  | Tree.node _ ly ky vy (Tree.node Color.red lx kx vx rx) =>
    Tree.node Color.red (Tree.node Color.black ly ky vy lx) kx vx (Tree.node Color.black rx k v r)
  | Tree.node _ lx kx vx rx => Tree.node Color.black (Tree.node Color.red lx kx vx rx) k v r
  | Tree.leaf => Tree.leaf

def balanceRight (l : Tree) (k : Int) (v : Bool) (r : Tree) : Tree :=
  match r with
  | Tree.node _ (Tree.node Color.red lx kx vx rx) ky vy ry =>
    Tree.node Color.red (Tree.node Color.black l k v lx) kx vx (Tree.node Color.black rx ky vy ry)
  | Tree.node _ lx kx vx (Tree.node Color.red ly ky vy ry) =>
    Tree.node Color.red (Tree.node Color.black l k v lx) kx vx (Tree.node Color.black ly ky vy ry)
  | Tree.node _ lx kx vx rx => Tree.node Color.black l k v (Tree.node Color.red lx kx vx rx)
  | Tree.leaf => Tree.leaf

def ins : Tree -> Int -> Bool -> Tree
  | Tree.node Color.red l kx vx r, k, v =>
    if k < kx then Tree.node Color.red (ins l k v) kx vx r
    else if k > kx then Tree.node Color.red l kx vx (ins r k v)
    else Tree.node Color.red l k v r
  | Tree.node Color.black l kx vx r, k, v =>
    if k < kx then (if isRed l then balanceLeft (ins l k v) kx vx r else Tree.node Color.black (ins l k v) kx vx r)
    else if k > kx then (if isRed r then balanceRight l kx vx (ins r k v) else Tree.node Color.black l kx vx (ins r k v))
    else Tree.node Color.black l k v r
  | Tree.leaf, k, v => Tree.node Color.red Tree.leaf k v Tree.leaf

def setBlack : Tree -> Tree
  | Tree.node _ l k v r => Tree.node Color.black l k v r
  | t => t

def insert (t : Tree) (k : Int) (v : Bool) : Tree := setBlack (ins t k v)

-- Koka: t.fold(0) fn(k, v, r) { if v then r + 1 else r }
def foldCount : Tree -> Int -> Int
  | Tree.node _ l _ v r, b => foldCount r (if v then foldCount l b + 1 else foldCount l b)
  | Tree.leaf, b => b

-- Koka make-tree-aux: insert keys n, n-1, ..., 1 (value = multiple of 10), keeping every freq-th tree.
-- The kept list is returned (Cons at n = 0 conses the finished tree), as in rbmap-checkpoint.lean.
def makeTreeAux : Nat -> Nat -> Tree -> List Tree -> List Tree
  | 0, _, t, acc => t :: acc
  | n + 1, freq, t, acc =>
    let t' := insert t (Int.ofNat (n + 1)) ((n + 1) % 10 == 0)
    makeTreeAux n freq t' (if (n + 1) % freq == 0 then t' :: acc else acc)

def headTree : List Tree -> Tree
  | t :: _ => t
  | [] => Tree.leaf

def rbtreeCk (freq : Nat) (n : Nat) : Int :=
  foldCount (headTree (makeTreeAux n freq Tree.leaf [])) 0
