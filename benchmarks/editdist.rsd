-- editdist: the Bend bench/runtime editdist program (HigherOrderCO/Bend,
-- bench/runtime/editdist/main.bend), ported to P1' Lean 4.14. Same algorithm: 2^K independent pairs
-- fork as a balanced batch tree; pair p hashes its index into an xorshift seed and draws two
-- sequences of 256 symbols over a 4-letter alphabet, and the Levenshtein DP walks the 256 x 256 cell
-- grid with two rolling rows (prev, cur): row i writes cur[0] = i+1, then each column j writes
-- cur[j+1] = min(prev[j+1]+1, cur[j]+1, prev[j]+cost); when the row ends the rows swap. The distance
-- is prev[256] after the last row, mixed with the pair index; pair checksums sum up the fork tree.
-- Departures (named): u32-exact — the source's U32 words are modeled exactly in checked Int
-- arithmetic (wrap mod 2^32, xor bit-decomposed; values stay in [0, 2^32)); array-record — the
-- source's four flat Array<U32> ride as List Int here with drop-based read and take/drop write (the
-- frozen language has no array primitive); the Dp record keeps the four rows together as in the
-- source.
-- The source's small size K = 2 expects 2065873279 (verified against the C twin there); its main()
-- runs K = 15, out of reach here.
-- Source pin (the source table, 2026-11-06): HigherOrderCO/Bend commit be236f324ed0338fe907fe50474468e4d3b94157
-- (main), bench/runtime/editdist/main.bend, sha256
-- 466891a27b87119b5593209eb98aa0d687ff88b6ff28cc2ca339e248907a3959
-- (raw.githubusercontent.com/HigherOrderCO/Bend/be236f324ed0338fe907fe50474468e4d3b94157/bench/runtime/editdist/main.bend).

def W : Int := 4294967296

def w32 (x : Int) : Int := x % W

def bitXorLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitXorLoop k (a / 2) (b / 2) (acc + ((a % 2 + b % 2) % 2) * sc) (sc * 2)

def xor32 (a b : Int) : Int := bitXorLoop 32 a b 0 1

def bitAndLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitAndLoop k (a / 2) (b / 2) (acc + (a % 2 * b % 2) * sc) (sc * 2)

def and32 (a b : Int) : Int := bitAndLoop 32 a b 0 1

def wAdd (a b : Int) : Int := w32 (a + b)
-- wMul is split at 16 bits so the intermediates stay under the checked-i64
-- bound (a_lo * b, a_hi * b < 2^48); a*b mod 2^32 is unchanged
-- (checkedArithmeticStuck at ~2^63 on the flat form, probe-verified)
def wMul (a b : Int) : Int :=
  w32 (w32 (w32 (a % 65536) * b) + w32 (w32 (w32 (a / 65536) * b) % 65536) * 65536)
def wInc (a : Int) : Int := w32 (a + 1)

def pw2 : Nat → Int
  | 0 => 1
  | k + 1 => 2 * pw2 k

def b2u (b : Bool) : Int := if b then 1 else 0

def umin (x y : Int) : Int := if x < y then x else y

-- xorshift: x ^= x<<13; x ^= x>>17; x ^= x<<5
def prng (x : Int) : Int :=
  let b := xor32 x (w32 (x * 8192))
  let d := xor32 b (b / 131072)
  xor32 d (w32 (d * 32))

-- word-array read (drop-based, Arena.read's shape) and write (take/drop splice)
def getAt : List Int → Int → Int
  | [], _ => 0
  | a, b => match (a.drop b.toNat).head? with
    | some v => v
    | none => 0

def setAt (b : Int) (v : Int) : List Int → List Int
  | [] => []
  | a => (a.take b.toNat) ++ [v] ++ (a.drop (b.toNat + 1))

/-- The source's Dp: the four rolling arrays as one record (array-record). -/
structure Dp where
  a : List Int
  b : List Int
  prev : List Int
  cur : List Int

-- draw one sequence: step the stream, write its low two bits at slot k
def gen : Nat → Int → Int → List Int → List Int
  | 0, _, _, x => x
  | q + 1, k, s, x =>
    let s2 := prng s
    gen q (wInc k) s2 (setAt k (and32 s2 3) x)

-- prev[k] = k: the row of the empty prefix
def init : Nat → Int → List Int → List Int
  | 0, _, x => x
  | q + 1, k, x => init q (wInc k) (setAt k k x)

-- one DP cell at column j: 4 reads + 1 write
def cell (j ai : Int) (st : Dp) : Dp :=
  let bj := getAt st.b j
  let cost := b2u (ai != bj)
  let diag := getAt st.prev j
  let up := getAt st.prev (wInc j)
  let left := getAt st.cur j
  let v := umin (umin (wInc up) (wInc left)) (wAdd diag cost)
  { st with cur := setAt (wInc j) v st.cur }

-- one DP row: 256 cells in ascending column order; when the row ends
-- the rows swap roles
def row : Nat → Int → Int → Dp → Dp
  | 0, _, _, st => { a := st.a, b := st.b, prev := st.cur, cur := st.prev }
  | q + 1, j, ai, st => row q (wInc j) ai (cell j ai st)

-- row i's prologue: read a[i], write cur[0] = i + 1, then run the row
def dpRow (i : Int) (st : Dp) : Dp :=
  let ai := getAt st.a i
  row 256 0 ai { st with cur := setAt 0 (wInc i) st.cur }

-- the DP: 256 rows
def dp : Nat → Int → Dp → Dp
  | 0, _, st => st
  | q + 1, i, st => dp q (wInc i) (dpRow i st)

-- the distance: prev[256] after the last row
def dist (st : Dp) : Int := getAt st.prev 256

-- one pair: seed from the hashed pair index, draw a and b, run the DP,
-- mix the distance with the index
def pair (p : Int) : Int :=
  let s := wMul (wInc p) 2654435761
  let a := gen 256 0 s (List.replicate 256 0)
  let b := gen 256 0 (wMul s 340573321) (List.replicate 256 0)
  let prev := init 257 0 (List.replicate 512 0)
  let d := dist (dp 256 0 { a := a, b := b, prev := prev, cur := List.replicate 512 0 })
  xor32 (wMul d 2654435761) (wInc p)

-- batch tree over the pair index space
def batch : Nat → Int → Int
  | 0, p => pair p
  | q + 1, p => wAdd (batch q p) (batch q (wAdd p (pw2 q)))

/-- Root: `editdist k` is batch(k, 0); the source's documented small
size K = 2 expects 2065873279, its main() runs K = 15. -/
def editdist (k : Int) : Int := batch k.toNat 0
