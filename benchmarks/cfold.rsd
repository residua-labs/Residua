-- cfold: the Koka/Perceus suite program test/bench/koka/cfold.kk (koka-lang/koka, master, fetched
-- 2026-11-04), itself adapted from the Lean 4 IFL19 benchmark tests/bench/const_fold.hs. Same
-- algorithm: `mk_expr` builds a full Add/Mul tree of depth n over Var 1 and small Vals, `reassoc`
-- re-associates every Add/Mul chain to the right (`append_add` / `append_mul`), and `cfold` folds
-- the constant subterms bottom-up, matching Val(a) against Val(b), Add(f, Val b) and Add(Val b, f)
-- (and the Mul forms) exactly as the source does. `cfoldMain n` returns the pair
-- (eval of the built tree, eval of reassoc + cfold of it); Koka's main prints the two numbers, one
-- per line, for mk_expr(20, 1) (the host renders the pair in that format). Departures, stated:
-- the suite README notes cfold needs a deep stack (Koka `ulimit -s unlimited`); the values stay
-- far inside the i64 range (every leaf is at most 2*n + 1 = 21 at n = 20, and the tree has 2^21
-- leaves, so both evaluations are below 2^26 in absolute value); everything is structural
-- recursion on the expression or a Nat count, as elsewhere in this corpus.
-- Source pin (the source table, 2026-11-06): koka-lang/koka commit facb7932ce6871fdb063f762a304bd8238f35fba
-- (master), test/bench/koka/cfold.kk, sha256
-- baa37a54afa6fabd93e87b5d609c525f036620fcda1dff390ac2bbe1227ca6e2
-- (byte-identical to the 2026-11-04 the benchmark kit fetch). Rechecked arm by arm (mk_expr, append_add/mul,
-- reassoc, cfold's match arms and their order, eval, the mk_expr(20,1) main): no drift.

-- Official OCaml reference (suite provenance, fetched 2026-11-06): koka-lang/koka commit facb7932ce6871fdb063f762a304bd8238f35fba
-- (master), test/bench/ocaml/cfold.ml, sha256
-- 10c6e1fac837a258c5cae0195395165f34266c3852c91d67a35770d647d003dc
-- (raw.githubusercontent.com/koka-lang/koka/facb7932ce6871fdb063f762a304bd8238f35fba/test/bench/ocaml/cfold.ml). Same algorithm as the
-- Koka twin (mk_expr 20 1, reassoc, const_folding, eeval printing both values); rechecked line by
-- line against the OCaml: no drift.
inductive Expr where
  | var : Int -> Expr
  | val : Int -> Expr
  | add : Expr -> Expr -> Expr
  | mul : Expr -> Expr -> Expr

def mkExpr : Nat -> Int -> Expr
  | 0, v => if v == 0 then Expr.var 1 else Expr.val v
  | n + 1, v => Expr.add (mkExpr n (v + 1)) (mkExpr n (max (v - 1) 0))

def appendAdd : Expr -> Expr -> Expr
  | Expr.add e1 e2, e3 => Expr.add e1 (appendAdd e2 e3)
  | e0, e3 => Expr.add e0 e3

def appendMul : Expr -> Expr -> Expr
  | Expr.mul e1 e2, e3 => Expr.mul e1 (appendMul e2 e3)
  | e0, e3 => Expr.mul e0 e3

def reassoc : Expr -> Expr
  | Expr.add e1 e2 => appendAdd (reassoc e1) (reassoc e2)
  | Expr.mul e1 e2 => appendMul (reassoc e1) (reassoc e2)
  | e => e

def cfold : Expr -> Expr
  | Expr.add e1 e2 =>
    match cfold e1, cfold e2 with
    | Expr.val a, Expr.val b => Expr.val (a + b)
    | Expr.val a, Expr.add f (Expr.val b) => Expr.add (Expr.val (a + b)) f
    | Expr.val a, Expr.add (Expr.val b) f => Expr.add (Expr.val (a + b)) f
    | e1', e2' => Expr.add e1' e2'
  | Expr.mul e1 e2 =>
    match cfold e1, cfold e2 with
    | Expr.val a, Expr.val b => Expr.val (a * b)
    | Expr.val a, Expr.mul f (Expr.val b) => Expr.mul (Expr.val (a * b)) f
    | Expr.val a, Expr.mul (Expr.val b) f => Expr.mul (Expr.val (a * b)) f
    | e1', e2' => Expr.mul e1' e2'
  | e => e

def evalE : Expr -> Int
  | Expr.var _ => 0
  | Expr.val v => v
  | Expr.add l r => evalE l + evalE r
  | Expr.mul l r => evalE l * evalE r

-- Koka main: mk_expr(20, 1); v1 = eval(e); v2 = eval(reassoc(e).cfold); print v1; print v2.
def cfoldMain (n : Nat) : Int × Int :=
  let e := mkExpr n 1
  (evalE e, evalE (cfold (reassoc e)))
