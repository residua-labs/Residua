-- binary-trees as Koka's benchmark suite runs it: the row of this program in a table against Koka.
-- Source: koka-lang/koka commit facb7932ce6871fdb063f762a304bd8238f35fba, test/bench/koka/binarytrees.kk,
-- sha256 17510f418ff7f45be1838a26dc025af42369d21d3c22a89791850cf39a82e637 (fetched and compared 2026-11-16).
-- This file is that program, definition by definition: `make-rec` (plain recursion; a tree of depth 0 is
-- `Node(Tip, Tip)`), `checkv` (a tail-recursive walk that keeps its own stack in a `visit` value), `sum-count`
-- (`fold(count+1, 0)`: count + 1 trees), `psum-count` (eight parts of count / 8 and the rest, each by
-- `sum-count`: count + 9 trees for a line that prints `count`) and `main`'s order (the stretch tree is checked
-- before the long-lived tree is made). So `lines n` holds the numbers Koka's program prints for n. Koka 3.2.9
-- prints for 7 the checks 511, 4247, 5207, 255, and for 21 the checks 8388607, 65011991, 66585719, 66982391,
-- 67094519, 67174391, 67401719, 68287991, 71827319, 85983191, 4194303.
-- What is not ported: the tasks themselves. Koka runs the parts as tasks; a table row runs on one core, and
-- here the parts run one after the other. A depth is a Nat for Koka's `int`: the same two operations, a test
-- against zero and a decrement.
-- benchmarks/binarytrees.rsd, the port after the Benchmarks Game's OCaml and Rust entries, checks by plain
-- recursion and makes `count` trees for a line: a different program in the part that is timed.
-- Until 2026-11-18 this file had only the check from Koka. Its trees were built by the other port's `bottomUp`
-- (a call for each empty child: 2n + 1 calls for the n nodes that `make-rec` builds in n calls), it made `count`
-- trees for a line where Koka's program makes count + 9, and it made the long-lived tree before the stretch
-- tree was checked.
-- `checkv` is `partial`: it does not recurse on a part of one argument (the frame's tree comes back from the
-- visit value).
--
-- `lines n` returns the output lines as records, as benchmarks/binarytrees.rsd does: kind 0 = "stretch tree of
-- depth {depth}\t check: {check}", kind 1 = "{iterations}\t trees of depth {depth}\t check: {check}",
-- kind 2 = "long lived tree of depth {depth}\t check: {check}".
inductive Tree where
  | nil : Tree
  | node : Tree -> Tree -> Tree

structure Line where
  kind : Int
  iterations : Int
  depth : Int
  check : Int

-- Koka's `make-rec`: `if depth > 0 then Node(make-rec(depth - 1), make-rec(depth - 1)) else Node(Tip, Tip)`
def makeRec : Nat -> Tree
  | 0 => Tree.node Tree.nil Tree.nil
  | k + 1 => Tree.node (makeRec k) (makeRec k)

-- Koka's `visit` and `checkv`: the checksum runs as a tail call, and the node just read becomes
-- the frame that remembers its right child (same size, so its cell is reused in place).
inductive Visit where
  | done : Visit
  | nodeR : Tree -> Visit -> Visit

partial def checkv : Tree -> Visit -> Int -> Int
  | Tree.node l r, v, acc => checkv l (Visit.nodeR r v) (acc + 1)
  | Tree.nil, Visit.nodeR r v, acc => checkv r v acc
  | Tree.nil, Visit.done, acc => acc

def itemCheck (t : Tree) : Int := checkv t Visit.done 0

def pow2 : Nat -> Int
  | 0 => 1
  | k + 1 => 2 * pow2 k

-- Koka's `sum-count(count, depth)` is `sumCount (count + 1) depth 0`: `fold(count+1, 0)` makes count + 1 trees
def sumCount : Nat -> Nat -> Int -> Int
  | 0, _, csum => csum
  | i + 1, d, csum => sumCount i d (csum + itemCheck (makeRec d))

-- Koka's `psum-count`: eight parts of count / 8, and the rest
def parts : Nat -> Nat -> Nat -> Int -> Int
  | 0, _, _, acc => acc
  | k + 1, partc, d, acc => parts k partc d (acc + sumCount (partc + 1) d 0)

def psumCount (count : Nat) (d : Nat) : Int :=
  sumCount (count % 8 + 1) d 0 + parts 8 (count / 8) d 0

def levels (maxDepth : Nat) : Nat -> Nat -> List Line
  | 0, _ => []
  | c + 1, d =>
    let iterations := pow2 (maxDepth - d + 4)
    { kind := 1, iterations := iterations, depth := Int.ofNat d,
      check := psumCount iterations.toNat d } :: levels maxDepth c (d + 2)

def lines (n : Nat) : List Line :=
  let maxDepth := if 6 > n then 6 else n
  let stretchCheck := itemCheck (makeRec (maxDepth + 1))
  let longLived := makeRec maxDepth
  { kind := 0, iterations := 0, depth := Int.ofNat (maxDepth + 1), check := stretchCheck } ::
    (levels maxDepth ((maxDepth - 4) / 2 + 1) 4 ++
      [{ kind := 2, iterations := 0, depth := Int.ofNat maxDepth, check := itemCheck longLived }])
