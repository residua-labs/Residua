-- tree-bitonic: the Bend bench/runtime tree-bitonic program (HigherOrderCO/Bend, bench/runtime/
-- tree-bitonic/main.bend), ported to P1' Lean 4.14. Same algorithm: `key` hashes each leaf index
-- into a pseudo-random word (xorshift of a Knuth-mixed index), `bsort` builds the 2^d-leaf tree and
-- bitonically sorts it in one fused pass (`flow` finishes a merge whose root warp the caller did),
-- `scan` folds the sorted tree into lo/hi/ok/mix with an order-sensitive join, `statOut` mixes the
-- four fields into the checksum. Bend's direction flag rides as a Bool here exactly as in the source.
-- Departure (named, u32-exact): the source's U32 words are modeled exactly in checked Int
-- arithmetic — every op wraps mod 2^32, xor/and decompose bit by bit, shl/shr scale by 2^k; values
-- stay in [0, 2^32), so every modeled op equals the U32 op it replaces (verified by the value check).
-- `bsort (d) false 0` at d = 8 gives 971629740 (the source's documented small size, verified against
-- Bend3 C runs there); its main() runs d = 23, out of reach here (2^23 leaves).
-- Source pin (the source table, 2026-11-06): HigherOrderCO/Bend commit be236f324ed0338fe907fe50474468e4d3b94157
-- (main), bench/runtime/tree-bitonic/main.bend, sha256
-- 1d79c448bae41dff127ff05b6c6a13d010a9a0ebc5c4dcf19da7d6d4641a7d2c
-- (raw.githubusercontent.com/HigherOrderCO/Bend/be236f324ed0338fe907fe50474468e4d3b94157/bench/runtime/tree-bitonic/main.bend).

/-- Word arithmetic: wrap mod 2^32. -/
def W : Int := 4294967296

def w32 (x : Int) : Int := x % W

/-- Bit-decomposed xor on 32-bit words: bit i of the result is (a_i + b_i) % 2. -/
def bitXorLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitXorLoop k (a / 2) (b / 2) (acc + ((a % 2 + b % 2) % 2) * sc) (sc * 2)

def xor32 (a b : Int) : Int := bitXorLoop 32 a b 0 1

/-- Bit-decomposed and on 32-bit words: bit i of the result is a_i * b_i. -/
def bitAndLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitAndLoop k (a / 2) (b / 2) (acc + (a % 2 * b % 2) * sc) (sc * 2)

def and32 (a b : Int) : Int := bitAndLoop 32 a b 0 1

def wAdd (a b : Int) : Int := w32 (a + b)
-- wMul is split at 16 bits so the intermediates stay under the checked-i64
-- bound (a_lo * b, a_hi * b < 2^48); a*b mod 2^32 is unchanged
-- (checkedArithmeticStuck at ~2^63 on the flat form, probe-verified)
def wMul (a b : Int) : Int :=
  w32 (w32 (w32 (a % 65536) * b) + w32 (w32 (w32 (a / 65536) * b) % 65536) * 65536)
def wInc (a : Int) : Int := w32 (a + 1)

def pw2 : Nat → Int
  | 0 => 1
  | k + 1 => 2 * pw2 k

def wShlN (a : Int) (k : Nat) : Int := w32 (a * pw2 k)
def wShrN (a : Int) (k : Nat) : Int := a / pw2 k

def xorB (a b : Bool) : Bool := if a == b then false else true

/-- The source's Tree: Leaf{v} / Node{l, r}. -/
inductive Tb where
  | leaf (v : Int)
  | node (l : Tb) (r : Tb)

/-- The source's Stat: St{lo, hi, ok, mx}. -/
structure St where
  lo : Int
  hi : Int
  ok : Int
  mx : Int

-- xorshift: x ^= x<<13; x ^= x>>17; x ^= x<<5
def prng (x : Int) : Int :=
  let b := xor32 x (wShlN x 13)
  let d := xor32 b (wShrN b 17)
  xor32 d (wShlN d 5)

-- leaf key: hash of the leaf index
def key (i : Int) : Int := prng (wMul (wInc i) 2654435761)

def warpLeafGo (x y : Int) : Bool → Tb
  | false => Tb.node (Tb.leaf x) (Tb.leaf y)
  | true => Tb.node (Tb.leaf y) (Tb.leaf x)

-- compare-and-swap of two leaves; s flips the order (swap(s ^ (x > y), x, y))
def warpLeaf (x y : Int) (s : Bool) : Tb := warpLeafGo x y (xorB s (x > y))

def warpZip : Tb → Tb → Tb
  | Tb.node a0 a1, Tb.node b0 b1 => Tb.node (Tb.node a0 b0) (Tb.node a1 b1)
  | _, _ => Tb.leaf 0

def warp : Tb → Tb → Bool → Tb
  | Tb.leaf av, Tb.leaf bv, s => warpLeaf av bv s
  | Tb.leaf _, _, _ => Tb.leaf 0
  | _, Tb.leaf _, _ => Tb.leaf 0
  | Tb.node aa ab, Tb.node ba bb, s => warpZip (warp aa ba s) (warp ab bb s)

-- warp of a whole subtree: compare-and-swap its root pair
def warpNode : Tb → Bool → Tb
  | Tb.leaf v, _ => Tb.leaf v
  | Tb.node a b, s => warp a b s

-- bitonic merge, root pair already warped: flow(d, s, w) finishes a merge of
-- depth 1+d whose root warp the caller did
def flow : Nat → Bool → Tb → Tb
  | 0, _, Tb.leaf v => Tb.leaf v
  | 0, _, Tb.node wa wb => Tb.node wa wb
  | p + 1, _, Tb.leaf v => Tb.leaf v
  | p + 1, s, Tb.node wa wb =>
    Tb.node (flow p s (warpNode wa s)) (flow p s (warpNode wb s))

-- fused build-and-sort: 2^d leaves keyed by index, halves sorted in opposite
-- directions, then merged by flow
def bsort : Nat → Bool → Int → Tb
  | 0, _, x => Tb.leaf (key x)
  | p + 1, s, x =>
    let a := bsort p false (wInc (wShlN x 1))
    let b := bsort p true (wShlN x 1)
    flow p s (warp a b s)

-- verification join: bounds ride outward, ok demands left.hi <= right.lo, the
-- mix is order-sensitive
def statJoinGo (alo bhi aok bok amx bmx : Int) : Bool → St
  | false => { lo := alo, hi := bhi, ok := 0, mx := wAdd (wMul amx 2654435761) bmx }
  | true => { lo := alo, hi := bhi, ok := and32 aok bok, mx := wAdd (wMul amx 2654435761) bmx }

def statJoin (a b : St) : St := statJoinGo a.lo b.hi a.ok b.ok a.mx b.mx (a.hi <= b.lo)

-- rank-summary scan over the sorted tree
def scan : Tb → St
  | Tb.leaf v => { lo := v, hi := v, ok := 1, mx := v }
  | Tb.node a b => statJoin (scan a) (scan b)

def statOut (s : St) : Int :=
  wAdd (xor32 (wMul s.mx 2654435761) (wAdd s.hi (wMul s.lo 340573321))) (wMul s.ok 2246822519)

/-- Root: `treeBitonic d` is stat_out(scan(bsort(d, false, 0))); the source's
documented small size d = 8 expects 971629740, its main() runs d = 23. -/
def treeBitonic (d : Int) : Int := statOut (scan (bsort d.toNat false 0))
