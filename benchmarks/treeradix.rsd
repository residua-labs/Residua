-- tree-radix: the Bend bench/runtime tree-radix program (HigherOrderCO/Bend,
-- bench/runtime/tree-radix/main.bend), ported to P1' Lean 4.14. Same algorithm: `gen` hashes the 2^d
-- indices into 24-bit keys (masked xorshift of a Knuth-mixed index) laid out as a concat tree,
-- `toMap` inserts every element into a 24-bit trie (radix spells the path bit by bit, LSB deepest),
-- `merge` unions the tries (duplicates collapse into one Busy), `toArr` reads the sorted sequence
-- back off, and `chk` folds it into lo/hi/strict-sorted/count/sum which `chkOut` mixes into the
-- checksum. The Arr Empty ctor is Emp here (Lean owns the name Empty).
-- Departure (named, SRC-BEND-U32): the source's U32 words are modeled exactly in checked Int
-- arithmetic — every op wraps mod 2^32, xor/and decompose bit by bit, shl scales by 2^k; values stay
-- in [0, 2^32), so every modeled op equals the U32 op it replaces (verified by the value check).
-- The source's small size d = 8 expects 366571299 (verified against a Bend3 C run there); its
-- main() runs d = 22, out of reach here.
-- Source pin (BENCH-SRC-0, 2026-11-06): HigherOrderCO/Bend commit be236f324ed0338fe907fe50474468e4d3b94157
-- (main), bench/runtime/tree-radix/main.bend, sha256
-- 2f9784e5035e75bde271ad919075565156de20720be6186f86f0191e0ac9e802
-- (raw.githubusercontent.com/HigherOrderCO/Bend/be236f324ed0338fe907fe50474468e4d3b94157/bench/runtime/tree-radix/main.bend).

def W : Int := 4294967296

def w32 (x : Int) : Int := x % W

def bitXorLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitXorLoop k (a / 2) (b / 2) (acc + ((a % 2 + b % 2) % 2) * sc) (sc * 2)

def xor32 (a b : Int) : Int := bitXorLoop 32 a b 0 1

def bitAndLoop : Nat → Int → Int → Int → Int → Int
  | 0, _, _, acc, _ => acc
  | k + 1, a, b, acc, sc => bitAndLoop k (a / 2) (b / 2) (acc + (a % 2 * b % 2) * sc) (sc * 2)

def and32 (a b : Int) : Int := bitAndLoop 32 a b 0 1

def wAdd (a b : Int) : Int := w32 (a + b)
-- wMul is split at 16 bits so the intermediates stay under the checked-i64
-- bound (a_lo * b, a_hi * b < 2^48); a*b mod 2^32 is unchanged
-- (checkedArithmeticStuck at ~2^63 on the flat form, probe-verified)
def wMul (a b : Int) : Int :=
  w32 (w32 (w32 (a % 65536) * b) + w32 (w32 (w32 (a / 65536) * b) % 65536) * 65536)
def wInc (a : Int) : Int := w32 (a + 1)

def pw2 : Nat → Int
  | 0 => 1
  | k + 1 => 2 * pw2 k

def wShl1 (a : Int) : Int := w32 (a * 2)
def wShlN (a : Int) (k : Nat) : Int := w32 (a * pw2 k)
def wShrN (a : Int) (k : Nat) : Int := a / pw2 k

def b2u (b : Bool) : Int := if b then 1 else 0

/-- The source's Arr: Emp / Single{v} / Concat{l, r}. -/
inductive Arr where
  | emp
  | single (v : Int)
  | concat (l : Arr) (r : Arr)

/-- The source's Trie: Free / Busy / Mnode{l, r}. -/
inductive Trie where
  | free
  | busy
  | mnode (l : Trie) (r : Trie)

/-- The source's Chk: Cnil / Cval{lo, hi, ok, cnt, sum}. -/
inductive Chk where
  | cnil
  | cval (lo : Int) (hi : Int) (ok : Int) (cnt : Int) (sum : Int)

-- xorshift: x ^= x<<13; x ^= x>>17; x ^= x<<5
def prng (x : Int) : Int :=
  let b := xor32 x (wShlN x 13)
  let d := xor32 b (wShrN b 17)
  xor32 d (wShlN d 5)

-- 24-bit key: masked hash of the global index
def key (i : Int) : Int := and32 (prng (wMul (wInc i) 2654435761)) 16777215

def merge : Trie → Trie → Trie
  | Trie.free, Trie.free => Trie.free
  | Trie.free, Trie.busy => Trie.busy
  | Trie.free, Trie.mnode b0 b1 => Trie.mnode b0 b1
  | Trie.busy, Trie.free => Trie.busy
  | Trie.busy, Trie.busy => Trie.busy
  | Trie.busy, Trie.mnode _ _ => Trie.busy
  | Trie.mnode a0 a1, Trie.free => Trie.mnode a0 a1
  | Trie.mnode _ _, Trie.busy => Trie.busy
  | Trie.mnode a0 a1, Trie.mnode b0 b1 => Trie.mnode (merge a0 b0) (merge a1 b1)

def gen : Nat → Int → Arr
  | 0, x => Arr.single (key x)
  | p + 1, x =>
    let l := gen p (wShl1 x)
    let r := gen p (wInc (wShl1 x))
    Arr.concat l r

def swapBitsGo (x0 x1 : Trie) : Bool → Trie
  | true => Trie.mnode x0 x1
  | false => Trie.mnode x1 x0

def swapBits (n : Int) (x0 x1 : Trie) : Trie := swapBitsGo x0 x1 (n == 0)

def radix : Nat → Int → Int → Trie → Trie
  | 0, _, _, r => r
  | p + 1, n, k, r => radix p n (wShl1 k) (swapBits (and32 n k) r Trie.free)

def toMap : Arr → Trie
  | Arr.emp => Trie.free
  | Arr.single x => radix 24 x 1 Trie.busy
  | Arr.concat a b => merge (toMap a) (toMap b)

def toArr : Trie → Int → Arr
  | Trie.free, _ => Arr.emp
  | Trie.busy, k => Arr.single k
  | Trie.mnode l r, k =>
    let la := toArr l (wShl1 k)
    let ra := toArr r (wInc (wShl1 k))
    Arr.concat la ra

-- verification join: bounds ride outward, ok demands strict order
-- (duplicates collapsed, so a sorted trie read-off is strictly increasing)
def chkJoin : Chk → Chk → Chk
  | Chk.cnil, Chk.cnil => Chk.cnil
  | Chk.cnil, Chk.cval lo hi ok cnt sum => Chk.cval lo hi ok cnt sum
  | Chk.cval lo hi ok cnt sum, Chk.cnil => Chk.cval lo hi ok cnt sum
  | Chk.cval alo ahi aok acnt asum, Chk.cval blo bhi bok bcnt bsum =>
    Chk.cval alo bhi (and32 (and32 aok bok) (b2u (ahi < blo))) (wAdd acnt bcnt) (wAdd asum bsum)

-- rank-summary scan over the sorted output
def chk : Arr → Chk
  | Arr.emp => Chk.cnil
  | Arr.single x => Chk.cval x x 1 1 x
  | Arr.concat a b => chkJoin (chk a) (chk b)

def chkOut : Chk → Int
  | Chk.cnil => 0
  | Chk.cval lo hi ok cnt sum =>
    wAdd (xor32 (wAdd sum (wMul cnt 2654435761)) (wAdd hi (wMul lo 340573321))) (wMul ok 2246822519)

def sortArr (a : Arr) : Arr := toArr (toMap a) 0

/-- Root: `treeRadix d` is chk_out(chk(sort(gen(d, 0)))); the source's
documented small size d = 8 expects 366571299, its main() runs d = 22. -/
def treeRadix (d : Int) : Int := chkOut (chk (sortArr (gen d.toNat 0)))
