examples
  example "Inductive type and recursion" "inductive U where\n  | wrap : U -> U\n  | leaf : U\ndef build : Nat -> U\n  | 0 => U.leaf\n  | n + 1 => U.wrap (build n)\n"
  example "Structure and instance" "structure Pair where\n  a : Int\n  b : Int\ndef total : Int := let p : Pair := { a := 4, b := 5 }; p.a + p.b\n"
  example "Theorem with term proof (oracle gap)" "theorem identity (p : Prop) (h : p) : p := h\n"

probes
  pair "mixed-brackets" "def f (x : Int) : Int := x + 1\n" "#lang rsd\n[define (f [x : Int]) : Int [+ x 1]]\n"
  pair "round-binder" "def f (x : Int) : Int := x + 1\n" "#lang rsd\n(define [f (x : Int)] : Int (+ x 1))\n"
  pair "fresh-word-bridge" "def increment (x : UInt32) : UInt32 := x + 1\n" "#lang rsd\n(define (increment [x : UInt32]) : UInt32 (+ x 1))\n"
  pair "derived-structure" "structure Box where\n  value : Int\n  deriving Inhabited\ndef run : Int := 23\n" "#lang rsd\n(struct Box #:deriving [value : Int])\n(define run : Int 23)\n"
  pair "derived-inductive" "inductive Flag where\n  | off : Flag\n  | on : Flag\n  deriving Inhabited\ndef run : Int := 23\n" "#lang rsd\n(inductive Flag #:deriving [off #:result Flag] [on #:result Flag])\n(define run : Int 23)\n"
  treepair "tuple-lambda-untyped-tree" "def tupleFirst (xs : List (Prod Nat Nat)) : List Nat := xs.map (fun (x, y) => x)\n" "#lang rsd\n(define (tupleFirst [xs : (List (paren (Prod Nat Nat)))]) : (List Nat) (xs.map (paren (fun ((#:pattern (tuple x y))) x))))\n"
  treepair "tuple-lambda-typed-tree" "def tupleTyped (xs : List (Prod Nat Nat)) : List Nat := xs.map (fun ((x, y) : Prod Nat Nat) => x)\n" "#lang rsd\n(define (tupleTyped [xs : (List (paren (Prod Nat Nat)))]) : (List Nat) (xs.map (paren (fun ((#:pattern (tuple x y) : (Prod Nat Nat))) x))))\n"
  treepair "tuple-lambda-nested-tree" "def tupleNested (xs : List (Prod Nat (Prod Nat Nat))) : List Nat := xs.map (fun (x, (y, z)) => z)\n" "#lang rsd\n(define (tupleNested [xs : (List (paren (Prod Nat (paren (Prod Nat Nat)))))]) : (List Nat) (xs.map (paren (fun ((#:pattern (tuple x (tuple y z)))) z))))\n"
  treepair "tuple-lambda-mixed-tree" "def tupleMixed (xs : List (Prod Nat Nat)) : Nat := xs.foldl (fun z (x, y) => z + x) 0\n" "#lang rsd\n(define (tupleMixed [xs : (List (paren (Prod Nat Nat)))]) : Nat (xs.foldl (paren (fun (z (#:pattern (tuple x y))) (+ z x))) 0))\n"
  refuse "header" "(define f : Int 1)" "60" "0"
  refuse "unclosed" "#lang rsd\n(define f : Int 1" "61" "27"
