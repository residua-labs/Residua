  pair "fresh-word-bridge" "def f (x : UInt32) : UInt32 := x + 1\n" "val f = (x: UInt32): UInt32 => x + 1;\n"
  pair "authored-prec" "def g (x : Int) (y : Int) : Int := x + y * 2\n" "val g = (x: Int, y: Int): Int => x + y * 2;\n"
  treepair "arrow-return-type" "def apply (f : Int -> Int) (x : Int) : Int -> Int := f\n" "val apply = (f: Int -> Int, x: Int): Int -> Int => f;\n"
