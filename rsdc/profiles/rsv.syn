  Expr := Expr '/ Expr @tree=(6,4,$0,$2) @template=$0\s/\s$2 @prio=70 @assoc=left
  Expr := Expr '== Expr @tree=(6,5,$0,$2) @template=$0\s==\s$2 @prio=50 @assoc=non
  Expr := Expr '= Expr @tree=(6,24,$0,$2) @template=$0\s=\s$2 @prio=50 @assoc=non
  Expr := Expr '<=> Expr @tree=(6,25,$0,$2) @template=$0\s<=>\s$2 @prio=20 @assoc=non
  Expr := Expr '!= Expr @tree=(6,6,$0,$2) @template=$0\s!=\s$2 @prio=50 @assoc=non
  Expr := Expr less Expr @tree=(6,7,$0,$2) @template=$0\s<\s$2 @prio=50 @assoc=non
  Expr := Expr '> Expr @tree=(6,8,$0,$2) @template=$0\s>\s$2 @prio=50 @assoc=non
  Expr := Expr '<= Expr @tree=(6,9,$0,$2) @template=$0\s<=\s$2 @prio=50 @assoc=non
  Expr := Expr '>= Expr @tree=(6,10,$0,$2) @template=$0\s>=\s$2 @prio=50 @assoc=non
  Expr := Expr '&& Expr @tree=(6,11,$0,$2) @template=$0\s&&\s$2 @prio=35 @assoc=left
  Expr := Expr '|| Expr @tree=(6,12,$0,$2) @template=$0\s||\s$2 @prio=30 @assoc=left
  Expr := Expr ':: Expr @tree=(6,13,$0,$2) @template=$0\s::\s$2 @prio=67 @assoc=right
  Expr := Expr '++ Expr @tree=(6,14,$0,$2) @template=$0\s++\s$2 @prio=65 @assoc=left
  Expr := Expr '% Expr @tree=(6,15,$0,$2) @template=$0\s%\s$2 @prio=70 @assoc=left
  Expr := Expr '≠ Expr @tree=(6,16,$0,$2) @template=$0\s≠\s$2 @prio=50 @assoc=non
  Expr := Expr '≤ Expr @tree=(6,17,$0,$2) @template=$0\s≤\s$2 @prio=50 @assoc=non
  Expr := Expr '≥ Expr @tree=(6,18,$0,$2) @template=$0\s≥\s$2 @prio=50 @assoc=non
  Expr := Expr '&&& Expr @tree=(6,19,$0,$2) @template=$0\s&&&\s$2 @prio=60 @assoc=left
  Expr := Expr '||| Expr @tree=(6,20,$0,$2) @template=$0\s|||\s$2 @prio=55 @assoc=left
  Expr := Expr '^^^ Expr @tree=(6,21,$0,$2) @template=$0\s^^^\s$2 @prio=58 @assoc=left
  Expr := Expr '<<< Expr @tree=(6,22,$0,$2) @template=$0\s<<<\s$2 @prio=75 @assoc=left
  Expr := Expr '>>> Expr @tree=(6,23,$0,$2) @template=$0\s>>>\s$2 @prio=75 @assoc=left
  Expr := '- Expr @tree=(7,1,$1,0) @template=-$1 @prio=75
  Expr := '! Expr @tree=(7,2,$1,0) @template=!$1 @prio=40
  Expr := '~~~ Expr @tree=(7,3,$1,0) @template=~~~$1 @prio=100
  # Finite canonical tree spelling for the pinned grammar port. Private
  # children keep their actual tag/slot roles; old inverses remain first.
  Expr := CLExpr @tree=$0 @template=$0
  Expr := CExpr @tree=$0 @template=$0
  Decl := CLDecl @tree=$0 @template=$0
  Decl := CDecl @tree=$0 @template=$0
  GenDoStep := CDo @tree=$0 @template=$0
  CTree := 'tree_none @tree=-1 @template=tree_none
  CTree := CLExpr @tree=$0 @template=$0
  CTree := CLDecl @tree=$0 @template=$0
  CTree := CLHelper @tree=$0 @template=$0
  CTree := CExpr @tree=$0 @template=$0
  CTree := CDecl @tree=$0 @template=$0
  CTree := CDo @tree=$0 @template=$0
  CTree := CHelper @tree=$0 @template=$0
  C1 := CTree @tree=(12,$0,-1,0) @template=$0
  C2 := CTree ', C1 @tree=(12,$0,$2,0) @template=$0,\s$2
  C3 := CTree ', C2 @tree=(12,$0,$2,0) @template=$0,\s$2
  C4 := CTree ', C3 @tree=(12,$0,$2,0) @template=$0,\s$2
  C5 := CTree ', C4 @tree=(12,$0,$2,0) @template=$0,\s$2
  C6 := CTree ', C5 @tree=(12,$0,$2,0) @template=$0,\s$2
  C7 := CTree ', C6 @tree=(12,$0,$2,0) @template=$0,\s$2
  C8 := CTree ', C7 @tree=(12,$0,$2,0) @template=$0,\s$2
  C9 := CTree ', C8 @tree=(12,$0,$2,0) @template=$0,\s$2
  CChildren := CTree CChildrenTail @tree=(12,$0,$1,0) @template=$0$1
  CChildrenTail := ', CChildren @tree=$1 @template=,\s$1
  CChildrenTail := eps @tree=-1 @template=
  # Distinguish ordinary numeric spans from the character scalar sentinel.
  CLExpr := 'tree_name '( rawname ') @tree=(1,s2,e2,0) @template=tree_name($2)
  CLExpr := 'tree_global '( rawname ') @tree=(1,s2,e2,-9) @template=tree_global($2)
  CLExpr := 'tree_derived '( rawname ') @tree=(1,s2,e2,-10) @template=tree_derived($2)
  CLExpr := 'tree_num '( number ') @tree=(2,s2,e2,d2) @template=tree_num($2)
  CLExpr := 'tree_char '( number ') @tree=(2,-1,-1,d2) @template=tree_char($2)
  CLExpr := 'tree_str '( quoted ') @tree=(3,s2,e2,0) @template=tree_str($2)
  CLExpr := 'tree_4 '( ') @tree=(4,0,0,0) @template=tree_4()
  CLExpr := 'tree_5 '( CTree ', CTree ') @tree=(5,$2,$4,0) @template=tree_5($2,\s$4)
  CLExpr := 'binary_1 '( CTree ', CTree ') @tree=(6,1,$2,$4) @template=binary_1($2,\s$4)
  CLExpr := 'binary_2 '( CTree ', CTree ') @tree=(6,2,$2,$4) @template=binary_2($2,\s$4)
  CLExpr := 'binary_3 '( CTree ', CTree ') @tree=(6,3,$2,$4) @template=binary_3($2,\s$4)
  CLExpr := 'binary_4 '( CTree ', CTree ') @tree=(6,4,$2,$4) @template=binary_4($2,\s$4)
