examples
  example "Inductive type and recursion" "inductive U where\n  | wrap : U -> U\n  | leaf : U\ndef build : Nat -> U\n  | 0 => U.leaf\n  | n + 1 => U.wrap (build n)\n"
  example "Structure and instance" "structure Pair where\n  a : Int\n  b : Int\ndef total : Int := let p : Pair := { a := 4, b := 5 }; p.a + p.b\n"
  example "Theorem with term proof (oracle gap)" "theorem identity (p : Prop) (h : p) : p := h\n"

