# Reason-style spelling for the common pre-elaboration tree.
# Theorem/proposition adapters use stock Lean 4.14.0@410fab7284703f41660ca2454218dcca9b2ec896:
# src/Lean/Parser/Command.lean (theorem/declSig/declValSimple),
# src/Init/Notation.lean (=, nonassociative 50; And/Or/Not), src/Init/Core.lean (Iff, nonassociative 20).
# Signature kind 2 is theorem; logical Eq/Iff are operators 24/25.
# Logical And/Or are operators 26/27; logical Not is unary operator 4.
# Header order follows stock Lean 4.14.0@410fab7284703f41660ca2454218dcca9b2ec896,
# src/Lean/Parser/Module.lean:14-22: optional prelude, imports, then commands.
# Header nodes 56/57 are list19 entries; module leaf58 preserves unresolved spelling.
surface rsv
lexical
  ws " \t\n\r"
  comment "//"
  block-open "/*"
  block-close "*/"
  open "(" "[" "{"
  close ")" "]" "}"
  token ident [A-Za-z_\x80-\xff][A-Za-z_0-9.?!'\x80-\xff]* @keywords
  token rawname [A-Za-z_\x80-\xff][A-Za-z_0-9.?!'\x80-\xff]*
  # Measured stock-header exclusions only; dots and longer names retain the keyword bytes.
  token moduleident [A-Za-z_\x80-\xff][A-Za-z_0-9?!'\x80-\xff]*([.][A-Za-z_\x80-\xff][A-Za-z_0-9?!'\x80-\xff]*)* @reject-prefix=(Type|_|runtime|import|prelude)[^A-Za-z_0-9.?!'\x80-\xff]
  token number [0-9]+
  # Adjacent <- is bind; comparison to a negative operand prints < -... .
  token less < @reject-prefix=<[-]
  token quoted " @string-literal @incomplete=61
  token interpClosed " @interpolation=closed @incomplete=61
  token interpOpen " @interpolation=open @incomplete=61
  token interpMiddle } @interpolation=middle @incomplete=61
  token interpEnd } @interpolation=end @incomplete=61
  token scalar [\x21-\x7e]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf]
grammar
  File := FileHeader @tree=(18,$0,B,0) @template=$0
  FileHeader := Prelude Imports @tree=(19,$0,$1,0) @template=$0\n$1
  FileHeader := Imports @tree=$0 @template=$0
  Prelude := 'prelude '; @tree=(57,0,0,0) @template=prelude;
  Imports := Import Imports @tree=(19,$0,$1,0) @template=$0\n$1
  Imports := Commands @tree=$0 @template=$0
  Import := 'import ModuleName '; @tree=(56,$1,0,0) @template=import\s$1;
  Import := 'import 'runtime ModuleName '; @tree=(56,$2,1,0) @template=import\sruntime\s$2;
  ModuleName := moduleident @tree=(58,s0,e0,0) @template=$0
  Commands := Decl Commands @tree=(19,$0,$1,0) @template=$0\n$1
  Commands := eps @tree=-1 @template=
  Decl := 'val Partial Name '= '( Groups ') ': Type '=> Body '; @tree=(20,$2,(21,$5,$8,$1),$10) @template=val\s$1$2\s=\s($5):\s$8\s=>\s$10;
  Decl := 'val Partial Name ': Type '= Body '; @tree=(20,$2,(21,-1,$4,$1),$6) @template=val\s$1$2:\s$4\s=\s$6;
  Decl := 'lemma Name '= '( TheoremGroups ') ': Expr '=> Body '; @tree=(20,$1,(21,$4,$7,2),$9) @template=lemma\s$1\s=\s($4):\s$7\s=>\s$9;
  Decl := 'lemma Name ': Expr '=> Body '; @tree=(20,$1,(21,-1,$3,2),$5) @template=lemma\s$1:\s$3\s=>\s$5;
  Partial := 'partial @tree=1 @template=partial\s
  Partial := eps @tree=0 @template=
  Body := Expr TermOpt @tree=(25,$0,a1($1),0) @template=$0$1
  Body := 'function '{ Clauses '} TermOpt @tree=(23,$2,a1($4),0) @template=function\s{\n${2:2}}$4
  TermOpt := 'termination_by '( Names ') Expr @tree=(45,$2,$4,0) @template=\stermination_by\s($2)\s$4
  TermOpt := 'termination_by Expr @tree=(45,-1,$1,0) @template=\stermination_by\s$1
  TermOpt := 'termination_by 'structural '( Names ') Expr @tree=(45,$3,$5,1) @template=\stermination_by\sstructural\s($3)\s$5
  TermOpt := 'termination_by 'structural Expr @tree=(45,-1,$2,1) @template=\stermination_by\sstructural\s$2
  TermOpt := eps @tree=-1 @template=
  Groups := Name ': Type MoreGroups @tree=(22,(12,$0,-1,0),$2,$3) @template=$0:\s$2$3
  Groups := '[ Names '] ': Type MoreGroups @tree=(22,$1,$4,$5) @template=[$1]:\s$4$5
  Groups := eps @tree=-1 @template=
  MoreGroups := ', Groups @tree=$1 @template=,\s$1
  MoreGroups := eps @tree=-1 @template=
  TheoremGroups := Name ': Expr TheoremMoreGroups @tree=(22,(12,$0,-1,0),$2,$3) @template=$0:\s$2$3
  TheoremGroups := '[ Names '] ': Expr TheoremMoreGroups @tree=(22,$1,$4,$5) @template=[$1]:\s$4$5
  TheoremGroups := eps @tree=-1 @template=
  TheoremMoreGroups := ', TheoremGroups @tree=$1 @template=,\s$1
  TheoremMoreGroups := eps @tree=-1 @template=
  Names := Name NamesTail @tree=(12,$0,$1,0) @template=$0$1
  NamesTail := ', Names @tree=$1 @template=,\s$1
  NamesTail := eps @tree=-1 @template=
  Name := ident @tree=(1,s0,e0,0) @template=$0
  Name := 'name '( rawname ') @tree=(1,s2,e2,0) @template=name($2)
  Name := 'global '( rawname ') @tree=(1,s2,e2,-9) @template=global($2)
  # Match RSL's existing data-name ABI: -10 records deriving's presence.
  DataName := Name @tree=$0 @template=$0
  DataName := rawname 'deriving @tree=(1,s0,e0,-10) @template=$0\s$1
  Type := TyProd '-> Type @tree=(16,$0,$2,0) @template=$0\s->\s$2
  Type := TyProd @tree=$0 @template=$0
  # Explicit identity fallback; ordinary type inverses remain first.
  # The reserved introducer and closing delimiter keep Expr out of TyApp.
  Type := 'expr_type '( Expr ') @tree=$2 @template=expr_type($2) @forbid-clear
  TyProd := TyApp '* TyProd @tree=(41,$0,$2,0) @template=$0\s*\s$2
  TyProd := TyApp @tree=$0 @template=$0
  TyApp := TyApp '( Type ') @tree=(5,$0,(12,$2,-1,0),0) @template=$0($2)
  TyApp := Name @tree=$0 @template=$0
  TyApp := '( Type ') @tree=(13,$1,0,0) @template=($1)
  Decl := 'type DataName Params '= '{ Fields '} '; @tree=(26,$1,$5,a1($2)) @template=type\s$1$2\s=\s{\n${5:2}};
  Decl := 'type DataName Params '= Ctors '; @tree=(38,$1,$4,a1($2)) @template=type\s$1$2\s=\n${4:2};
  Params := '( ParamNames ') @tree=$1 @template=($1)
  Params := eps @tree=-1 @template=
  ParamNames := Name ParamTail @tree=(12,$0,$1,0) @template=$0$1
  ParamNames := 'implicit Name ParamTail @tree=(12,$1,$2,0) @template=implicit\s$1$2
  ParamTail := ', ParamNames @tree=$1 @template=,\s$1
  ParamTail := eps @tree=-1 @template=
  Fields := Name ': Type '= Expr '; Fields @tree=(27,$0,(40,$2,$4,0),$6) @template=$0:\s$2\s=\s$4;\n$6
  Fields := Name ': Type '; Fields @tree=(27,$0,$2,$4) @template=$0:\s$2;\n$4
  Fields := eps @tree=-1 @template=
  Ctors := '| Name CtorArgs CtorResult Ctors @tree=(12,(39,$1,$2,a1($3)),$4,0) @template=|\s$1$2$3\n$4
  Ctors := eps @tree=-1 @template=
  CtorArgs := '( Types ') @tree=$1 @template=($1)
  CtorArgs := eps @tree=-1 @template=
  Types := Type MoreTypes @tree=(12,$0,$1,0) @template=$0$1
  MoreTypes := ', Types @tree=$1 @template=,\s$1
  MoreTypes := eps @tree=-1 @template=
  CtorResult := ': Type @tree=$1 @template=:\s$1
  CtorResult := eps @tree=-1 @template=
  Decl := 'rec '{ Commands '} @tree=(28,$2,0,0) @template=rec\s{\n${2:2}}
  Decl := 'module Name '= '{ Commands '} '; @tree=(34,$1,$4,0) @template=module\s$1\s=\s{\n${4:2}};
  Decl := 'scope '{ Commands '} @tree=(36,-1,$2,-1) @template=scope\s{\n${2:2}}
  Decl := 'open Names Hidden '; @tree=(35,$1,$2,0) @template=open\s$1$2;
  Decl := 'open Names Hidden 'in '{ Commands '} @tree=(36,$1,$5,$2) @template=open\s$1$2\sin\s{\n${5:2}}
  Hidden := 'hiding '( Names ') @tree=$2 @template=\shiding\s($2)
  Hidden := eps @tree=-1 @template=
  Decl := 'alias Name '= Type '; @tree=(37,$1,$3,0) @template=alias\s$1\s=\s$3;
  Expr := Call @tree=$0 @template=$0
  Call := Call '( Expr ') @tree=(5,$0,(12,$2,-1,0),0) @template=$0($2) @forbid-clear
  Call := Atom @tree=$0 @template=$0
  Atom := Name @tree=$0 @template=$0
  Atom := number @tree=(2,s0,e0,d0) @template=$0
  Atom := quoted @tree=(3,s0,e0,0) @template=$0
  Atom := '_ @tree=(4,0,0,0) @template=_
  Atom := 'char '( number ') @tree=(2,-1,-1,d2) @template=char($2)
  Atom := 'if '( Expr ') '{ Expr '} 'else '{ Expr '} @tree=(8,$2,$5,$9) @template=if\s($2)\s{\s$5\s}\selse\s{\s$9\s}
  Atom := '{ 'let Name Annotation '= Expr '; Expr '} @tree=(9,$2,$3,(10,$5,$7,0)) @template={\slet\s$2$3\s=\s$5;\s$7\s} @forbid-clear
  Annotation := ': Type @tree=$1 @template=:\s$1
  Annotation := eps @tree=-1 @template=
  Atom := 'fun '( LambdaGroups ') '=> '{ Expr '} @tree=(32,$2,$6,0) @template=fun\s($2)\s=>\s{\s$6\s} @forbid-clear
  LambdaGroups := Name LambdaTail @tree=(22,(12,$0,-1,0),-1,$1) @template=$0$1
  LambdaGroups := Name ': Type LambdaTail @tree=(22,(12,$0,-1,0),$2,$3) @template=$0:\s$2$3
  LambdaGroups := '[ Names '] ': Type LambdaTail @tree=(22,$1,$4,$5) @template=[$1]:\s$4$5
  # Tag55 is the existing RSL/Tree lambda-pattern role, not a name spine.
  # Put a typed pattern's colon outside its delimiter to keep it distinct
  # from an untyped pattern whose Expr already contains an annotation.
  LambdaGroups := 'pattern '( Expr ') LambdaTail @tree=(22,(55,$2,0,0),-1,$4) @template=pattern($2)$4
  LambdaGroups := 'pattern '( Expr ') ': Type LambdaTail @tree=(22,(55,$2,1,0),$5,$6) @template=pattern($2):\s$5$6
  LambdaGroups := eps @tree=-1 @template=
  LambdaTail := ', LambdaGroups @tree=$1 @template=,\s$1
  LambdaTail := eps @tree=-1 @template=
  Atom := 'switch '( Elems ') '{ Clauses '} @tree=(31,$2,$5,0) @template=switch\s($2)\s{\n${5:2}} @forbid-clear
  Clauses := '| Elems '=> Expr '; ClauseTail @tree=(24,$1,$3,$5) @template=|\s$1\s=>\s$3;\n$5
  ClauseTail := Clauses @tree=$0 @template=$0
  ClauseTail := eps @tree=-1 @template=
  Atom := '[ ElemOpt '] @tree=(11,$1,0,0) @template=[$1] @forbid-clear
  # The flag-1 array tree remains distinct from the flag-0 list tree.
  Atom := '# '[ ElemOpt '] @tree=(11,$2,1,0) @template=#[$2] @layout=1:adjacent @forbid-clear
  ElemOpt := Elems @tree=$0 @template=$0
  ElemOpt := eps @tree=-1 @template=
  Elems := Expr ElemTail @tree=(12,$0,$1,0) @template=$0$1
  ElemTail := ', Elems @tree=$1 @template=,\s$1
  ElemTail := eps @tree=-1 @template=
  Atom := '( Expr ') @tree=(13,$1,0,0) @template=($1) @forbid-clear
  Atom := '( Expr ': Type ') @tree=(30,$1,$3,0) @template=($1:\s$3) @forbid-clear
  Atom := '( Expr ', Expr ') @tree=(42,$1,$3,0) @template=($1,\s$3) @forbid-clear
  Atom := 'arrow '( Expr ', Expr ') @tree=(16,$2,$4,0) @template=arrow($2,\s$4)
  Atom := 'product '( Expr ', Expr ') @tree=(41,$2,$4,0) @template=product($2,\s$4)
  Atom := 'prop_and '( Expr ', Expr ') @tree=(6,26,$2,$4) @template=prop_and($2,\s$4)
  Atom := 'prop_or '( Expr ', Expr ') @tree=(6,27,$2,$4) @template=prop_or($2,\s$4)
  Atom := 'prop_not '( Expr ') @tree=(7,4,$2,0) @template=prop_not($2)
  Atom := 'constructor '( ElemOpt ') @tree=(47,$2,0,0) @template=constructor($2) @forbid-clear
  Call := Call '[ Expr ']? @tree=(33,$0,$2,0) @template=$0[$2]? @forbid-clear
  Call := Call '. rawname @tree=(29,$0,s2,e2) @template=$0\s.\s$2
  Call := Call '. number @tree=(17,$0,d2,0) @template=$0\s.\s$2
  Atom := 'method '( Expr ', rawname ') @tree=(44,$2,s4,e4) @template=method($2,\s$4)
  Atom := '. rawname @tree=(43,s1,e1,0) @template=.$1
  Atom := '{ RecFields '} @tree=(14,-1,$1,0) @template={\s$1\s} @forbid-clear
  # A trailing : Type overlaps the distinct parenthesized ascription tree30:
  # ({fields}: Type) was both 30(14(-1,fields,0),Type,0) and
  # 13(14(Type,fields,0),0,0). Keep short records unannotated; the existing
  # tree_14 inverse below retains typed records and copies with their slots.
  Atom := '{ '... Expr ', RecFields '} @tree=(14,-1,$4,a1($2)) @template={\s...$2,\s$4\s}
  Atom := '{ '... ', RecFields '} @tree=(14,-1,$3,-1) @template={\s...,\s$3\s}
  RecFields := Name ': Expr RecTail @tree=(15,$0,$2,$3) @template=$0:\s$2$3
  RecFields := eps @tree=-1 @template=
  RecTail := ', RecFields @tree=$1 @template=,\s$1
  RecTail := eps @tree=-1 @template=
  Atom := 'do '{ DoSteps '} @tree=(46,$2,0,0) @template=do\s{\n${2:2}} @forbid-clear
  # Generic stock do syntax is kind1; legacy do remains kind0. Source:
  # Lean 4.14.0@410fab7284703f41660ca2454218dcca9b2ec896,
  # Parser/Do.lean:23-35,57-58,73-90,188-191. Explicit semicolons retain
  # every statement and the optional return operand in the syntax tree.
  Atom := 'do: '{ GenDoSteps '} @tree=(46,$2,1,0) @template=do:\s{\n${2:2}} @forbid-clear
  DoSteps := Name '<- Expr '; DoSteps @tree=(12,(43,$0,$2,0),$4,0) @template=$0\s<-\s$2;\n$4
  DoSteps := 'let Name Annotation '= Expr '; DoSteps @tree=(12,(45,$1,$2,$4),$6,0) @template=let\s$1$2\s=\s$4;\n$6
  DoSteps := Expr '; DoSteps @tree=(12,(44,$0,0,0),$2,0) @template=$0;\n$2
  DoSteps := eps @tree=-1 @template=
  GenDoSteps := GenDoStep GenDoStepsTail @tree=(12,$0,$1,0) @template=$0\n$1
  GenDoStepsTail := GenDoSteps @tree=$0 @template=$0
  GenDoStepsTail := eps @tree=-1 @template=
  # Source: Lean 4.14.0@410fab7284703f41660ca2454218dcca9b2ec896,
  # src/Lean/Parser/Do.lean:57-88 (withForbidden "=" on do-let pattern).
  GenDoPat := Expr @tree=$0 @template=$0 @forbid=%3D
  # Pattern trees include typed tag30; fallback is a nonempty kind1 do.
  # Keep these inverse patterns before the ordinary RHS-link patterns.
  GenDoStep := Expr '<- Expr '| '{ GenDoSteps '} '; @tree=(43,$0,(59,$2,(46,$5,1,0),0),0) @template=$0\s<-\s$2\s|\s{\n${5:2}};
  GenDoStep := 'let GenDoPat '= Expr '| '{ GenDoSteps '} '; @tree=(45,$1,-1,(59,$3,(46,$6,1,0),0)) @template=let\s$1\s=\s$3\s|\s{\n${6:2}};
  GenDoStep := Expr '<- Expr '; @tree=(43,$0,$2,0) @template=$0\s<-\s$2;
  GenDoStep := 'let GenDoPat Annotation '= Expr '; @tree=(45,$1,$2,$4) @template=let\s$1$2\s=\s$4;
  GenDoStep := 'return Expr '; @tree=(44,$1,1,0) @template=return\s$1;
  GenDoStep := 'return '; @tree=(44,-1,1,0) @template=return;
  GenDoStep := Expr '; @tree=(44,$0,0,0) @template=$0;
  Expr := Expr '+ Expr @tree=(6,1,$0,$2) @template=$0\s+\s$2 @prio=65 @assoc=left
  Expr := Expr '- Expr @tree=(6,2,$0,$2) @template=$0\s-\s$2 @prio=65 @assoc=left
