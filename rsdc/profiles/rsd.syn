# Development grammar; not part of the first profile PR.
surface rsd
lexical
  ws " \t\n\r"
  comment "--"
  block-open "/-"
  block-close "-/"
  open "(" "[" "{"
  close ")" "]" "}"
  # Lean 4.14.0 Basic.lean:882-893,936-970 (410fab7284703f41660ca2454218dcca9b2ec896).
  # Each escaped component ends at its first U+00BB; preserve raw name spans.
  token ident (([A-Za-z_]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))([A-Za-z_0-9'?!]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe]|\xb5[\xa2-\xaa])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f]|\x82[\x80-\x89\x90-\x9c])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))*|\xc2\xab([\x00-\x7f]|\xc2[\x80-\xba\xbc-\xbf]|[\xc3-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*\xc2\xbb)(\.(([A-Za-z_]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))([A-Za-z_0-9'?!]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe]|\xb5[\xa2-\xaa])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f]|\x82[\x80-\x89\x90-\x9c])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))*|\xc2\xab([\x00-\x7f]|\xc2[\x80-\xba\xbc-\xbf]|[\xc3-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*\xc2\xbb))* @keywords @reject-prefix=r#*"
  # Lean/Parser/Command.lean:173-175 uses rawIdent for constructor names.
  # Retain identifier bytes and qualified segments, without keyword refusal.
  token ctorname (([A-Za-z_]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))([A-Za-z_0-9'?!]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe]|\xb5[\xa2-\xaa])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f]|\x82[\x80-\x89\x90-\x9c])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))*|\xc2\xab([\x00-\x7f]|\xc2[\x80-\xba\xbc-\xbf]|[\xc3-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*\xc2\xbb)(\.(([A-Za-z_]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))([A-Za-z_0-9'?!]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe]|\xb5[\xa2-\xaa])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f]|\x82[\x80-\x89\x90-\x9c])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))*|\xc2\xab([\x00-\x7f]|\xc2[\x80-\xba\xbc-\xbf]|[\xc3-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*\xc2\xbb))* @reject-prefix=r#*"
  token field (([A-Za-z_]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))([A-Za-z_0-9'?!]|(\xce[\x91-\x9f\xa1-\xa2\xa4-\xa9\xb1-\xba\xbc-\xbf]|\xcf[\x80-\xbb]|\xe1([\xbc-\xbe][\x80-\xbf]|\xbf[\x80-\xbe]|\xb5[\xa2-\xaa])|\xe2(\x84[\x80-\xbf]|\x85[\x80-\x8f]|\x82[\x80-\x89\x90-\x9c])|\xf0\x9d(\x92[\x9c-\xbf]|[\x93-\x95][\x80-\xbf]|\x96[\x80-\x9f])))*|\xc2\xab([\x00-\x7f]|\xc2[\x80-\xba\xbc-\xbf]|[\xc3-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*\xc2\xbb) @reject-prefix=r#*"
  token number [0-9]+ @reject-prefix=0[xXbBoO]|[0-9]+[.eE]
  token fieldindex [1-9][0-9]*
  token tmellipsis [.][.] @reject-prefix=[.][.][.]
  token bindigits [01]+
  token octdigits [0-7]+
  token sciwhole [0-9]+
  token scidigit [0-9]
  token sciexp [eE]
  # Basic.lean:1759-1770 uses nonReservedSymbol for category annotations.
  # Dedicated tokens avoid reserving ident/str/num in ordinary source.
  token quoteIdentKind ident @reject-prefix=ident[A-Za-z_0-9.?!'\x80-\xff]
  token quoteStrKind str @reject-prefix=str[A-Za-z_0-9.?!'\x80-\xff]
  token quoteNumKind num @reject-prefix=num[A-Za-z_0-9.?!'\x80-\xff]
  token levelMax max @reject-prefix=max[A-Za-z_0-9.?!'\x80-\xff]
  token levelImax imax @reject-prefix=imax[A-Za-z_0-9.?!'\x80-\xff]
  token quoteTacticKind tactic @reject-prefix=tactic[A-Za-z_0-9.?!'\x80-\xff]
  token tacIntros intros @reject-prefix=intros[A-Za-z_0-9.?!'\x80-\xff]
  token tacConv conv @reject-prefix=conv[A-Za-z_0-9.?!'\x80-\xff]
  token convLhs lhs @reject-prefix=lhs[A-Za-z_0-9.?!'\x80-\xff]
  token tactic [^()\[\]{}\x20\t\n\r\x22\x27]+
  token hex [0-9a-fA-F]+
  token quoted " @string-literal @incomplete=61
  # Lean/Parser/StrInterpolation.lean:13-56. These four modes scan one
  # exact lexical chunk, including its opening and closing delimiters.
  # Embedded terms remain grammar children, never string payloads.
  token interpClosed " @interpolation=closed @incomplete=61
  token interpOpen " @interpolation=open @incomplete=61
  token interpMiddle } @interpolation=middle @incomplete=61
  token interpEnd } @interpolation=end @incomplete=61
  token character \x27(\x5c[\x5c\x22\x27rnt]|\x5cx[0-9a-fA-F][0-9a-fA-F]|\x5cu[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]|[\x00-\x26\x28-\x5b\x5d-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee-\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])\x27
grammar
  # Stock Lean 4.14.0, commit 410fab7284703f41660ca2454218dcca9b2ec896,
  # Parser/Module.lean:14-22: optional prelude, ordered imports, commands.
  # Header entries retain order/duplicates in the ordinary list19 spine;
  # an empty header is the existing Commands tree, with no new wrapper.
  File := FileHeader @tree=(18,$0,B,0) @template=$0
  FileHeader := 'prelude Imports @tree=(19,(57,0,0,0),$1,0) @template=prelude\n$1
  FileHeader := Imports @tree=$0 @template=$0
  Imports := ImportDecl Imports @tree=(19,$0,$1,0) @template=$0\n$1
  Imports := TopCommands @tree=$0 @template=$0
  ImportDecl := 'import ImportRuntime ModuleName @tree=(56,$2,$1,0) @template=import\s$1$2
  ImportRuntime := 'runtime @tree=1 @template=runtime\s
  ImportRuntime := eps @tree=0 @template=
  # A module name is a source span, not an expression identifier: imports
  # must not activate the existing Except/word expression-helper passes.
  ModuleName := ident @tree=(58,s0,e0,0) @template=$0
  # Unclosed section/namespace blocks remain valid only along the EOF root spine.
  TopCommands := Decl TopCommands @tree=(19,$0,$1,0) @template=$0\n$1
  TopCommands := eps @tree=-1 @template=
  TopCommands := 'deriving 'instance CmdCommaIdents 'for CmdCommaIdents TopCommands @tree=$5 @template=$2\n$5
  TopCommands := 'namespace CmdIdent TopCommands @tree=(19,(362,(12,$1,(12,$2,-1,0),0),0,0),-1,0) @template=namespace\s$1\n$2 @boundary=1:col-gt
  TopCommands := 'section CmdSectionName TopCommands @tree=(19,(363,(12,$1,(12,$2,-1,0),0),0,0),-1,0) @template=section$1\n$2
  TopCommands := 'noncomputable 'section CmdSectionName TopCommands @tree=(19,(329,(12,$2,-1,0),0,0),$3,0) @template=noncomputable\ssection$2\n$3
  Commands := Decl Commands @tree=(19,$0,$1,0) @template=$0\n$1
  Commands := eps @tree=-1 @template=
  # Pinned parseSrc Compile.rsd:2778 discards standalone deriving commands.
  # Project at Commands so the erased command leaves no empty list19 node.
  # Keep the ordinary list/eps inverse alternatives first.
  Commands := 'deriving 'instance CmdCommaIdents 'for CmdCommaIdents Commands @tree=$5 @template=$2\n$5
  DefDecl := Partial 'def CmdDeclId Groups ': Type Body @tree=(20,$2,(21,$3,$5,$0),$6) @template=$0def\s$2\s$3:\s$5$6
  Decl := DefDecl @tree=$0 @template=$0
  Decl := TheoremDecl @tree=$0 @template=$0
  Decl := OtherDecl @tree=$0 @template=$0
  OneDecl := OneDef @tree=$0 @template=$0
  OneDecl := TheoremDecl @tree=$0 @template=$0
  OneDecl := OtherDecl @tree=$0 @template=$0
  # Stock Lean 4.14.0, commit 410fab7284703f41660ca2454218dcca9b2ec896,
  # Parser/Command.lean:90-95,133-160: theorem has a required signature
  # and declaration value. Signature kind 2 retains theorem versus def.
  TheoremDecl := 'theorem CmdDeclId TheoremGroups ': Expr Body @tree=(20,$1,(21,$2,$4,2),$5) @template=theorem\s$1\s$2:\s$4$5
  TheoremGroups := '( Names ': Expr ') TheoremGroups @tree=(22,$1,$3,$5) @template=($1\s:\s$3)\s$5 @refuse=1:65
  TheoremGroups := eps @tree=-1 @template=
  OneDef := OnePartial 'def CmdDeclId Groups ': Type Body @tree=(20,$2,(21,$3,$5,0),$6) @template=def\s$2\s$3:\s$5$6
  OnePartial := 'partial @tree=0 @template=
  OnePartial := eps @tree=0 @template=
  Partial := 'partial @tree=1 @template=partial\s
  Partial := eps @tree=0 @template=
  # Lean/Parser/Command.lean:100-125,133-134: a declaration body
  # beginning with the whole token `by` is read at leadPrec, so an
  # outer lower-precedence operator cannot take remnants of the block.
  # Other bodies keep the full term category and the old tree ABI.
  Body := ':= DeclBody TermOpt @tree=(25,$1,a1($2),0) @template=\s:=\n${1:2}$2
  DeclBody := Expr @tree=$0 @template=$0 @not-followed=0:by
  DeclBody := ByTacticLead @tree=$0 @template=$0
  Body := Clauses TermOpt @tree=(23,$0,a1($1),0) @template=\n${0:2}$1
  TermMeta := 'termination_by Expr @tree=(45,-1,$1,0) @template=\ntermination_by\s$1 @layout-root @not-followed=1:structural
  TermMeta := 'termination_by TermByNames '=> Expr @tree=(45,$1,$3,0) @template=\ntermination_by\s$1\s=>\s$3 @layout-root @not-followed=1:structural
  TermOpt := 'termination_by 'structural TermByNames '=> Expr @tree=(45,$2,$4,1) @template=\ntermination_by\sstructural\s$2\s=>\s$4 @layout-root
  TermOpt := 'termination_by 'structural Expr @tree=(45,-1,$2,1) @template=\ntermination_by\sstructural\s$2 @layout-root
  TermByNames := Name TermByNamesTail @tree=(12,$0,$1,0) @template=$0$1 @boundary=0:col-gt
  TermByNamesTail := Name TermByNamesTail @tree=(12,$0,$1,0) @template=\s$0$1 @boundary=0:col-gt
  TermByNamesTail := eps @tree=-1 @template=
  TermMeta := eps @tree=-1 @template=
  Groups := '( Names ': Type ') Groups @tree=(22,$1,$3,$5) @template=($1\s:\s$3)\s$5 @refuse=1:65
  Groups := '( Names ': Type ':= Expr ') Groups @tree=(22,$1,(40,$3,$5,0),$7) @template=($1\s:\s$3\s:=\s$5)\s$7 @refuse=1:65
  Groups := eps @tree=-1 @template=
  # Command.lean:94-99: bare binderIdents and every bracketed binder.
  # The old explicit typed/default22 chain is retained above; these heads
  # require a previously absent binder shape and cannot overlap it.
  Groups := CmdNewLegacyBinder Groups @tree=(374,(12,$0,(12,$1,-1,0),0),0,0) @template=$0\s$1
  Groups := CmdBinderIdent Groups @tree=(375,(12,$0,(12,$1,-1,0),0),0,0) @template=$0\s$1
  TheoremGroups := CmdNewTheoremBinder TheoremGroups @tree=(374,(12,$0,(12,$1,-1,0),0),0,0) @template=$0\s$1
  TheoremGroups := CmdBinderIdent TheoremGroups @tree=(375,(12,$0,(12,$1,-1,0),0),0,0) @template=$0\s$1
  Names := Name NamesTail @tree=(12,$0,$1,0) @template=$0$1
  NamesTail := Name NamesTail @tree=(12,$0,$1,0) @template=\s$0$1
  NamesTail := eps @tree=-1 @template=
  Name := ident @tree=(1,s0,e0,0) @template=$0
  Name := 'Type @tree=(1,s0,e0,0) @template=$0
  Name := '_ @tree=(1,s0,e0,0) @template=$0
  # Header-only keywords remain identifiers in stock command syntax.
  Name := 'runtime @tree=(1,s0,e0,0) @template=$0
  Name := 'prelude @tree=(1,s0,e0,0) @template=$0
  Name := CmdSoftName @tree=$0 @template=$0
  # Same published Pratt precedences as Init/Notation.lean and the Term
  # port below. A separate context is necessary: parseSrc's old Type
  # role uses product41 and underscore-name1, unlike term product6/hole4.
  Type := TyC0 @tree=$0 @template=$0 @choice-group=4 @choice-rank=0
  Type := TyO0 @tree=$0 @template=$0 @choice-group=4 @choice-rank=1
  TyO0 := DoLowTerm @tree=$0 @template=$0
  TyProd := TyC35 @tree=$0 @template=$0
  TyApp := TyApp TyArg @tree=(5,$0,(12,$1,-1,0),0) @template=$0\s$1 @scoped-layout=1:argument @boundary=1:ws
  TyApp := TyProj @tree=$0 @template=$0
  TyProj := TyAtom @tree=$0 @template=$0
  TyProj := TyProj '. fieldindex @tree=(17,$0,d2,0) @template=$0.$2 @boundary=1:no-ws,2:no-ws
  TyProj := TyProj '. field @tree=(29,$0,s2,e2) @template=$0.$2 @boundary=1:no-ws,2:no-ws
  TyProj := TyProj '[ Expr ']? @tree=(33,$0,$2,0) @template=$0[$2]? @boundary=1:no-ws
  TyProj := '. field @tree=(43,s1,e1,0) @template=.$1 @boundary=1:no-ws
  TyArg := TyAtom @tree=$0 @template=$0
  TyArg := '. field @tree=(43,s1,e1,0) @template=.$1 @boundary=1:no-ws
  TyArg := TyArg '. fieldindex @tree=(17,$0,d2,0) @template=$0.$2 @boundary=1:no-ws,2:no-ws
  TyArg := TyArg '. field @tree=(29,$0,s2,e2) @template=$0.$2 @boundary=1:no-ws,2:no-ws
  TyArg := TyArg '[ Expr ']? @tree=(33,$0,$2,0) @template=$0[$2]? @boundary=1:no-ws
  TyAtom := Atom @tree=$0 @template=$0 @not-followed=0:_|%28
  TyAtom := '_ @tree=(1,s0,e0,0) @template=_
  TyAtom := '( Type ') @tree=(13,$1,0,0) @template=($1)
  TyAtom := '( ') @tree=(100,-1,0,0) @template=() @layout-clear @forbid-clear
  TyAtom := '( Expr ': Type ') @tree=(30,$1,$3,0) @template=($1\s:\s$3) @layout-clear @forbid-clear
  TyAtom := '( Expr ': ') @tree=(103,(12,$1,-1,0),0,0) @template=($1\s:) @layout-clear @forbid-clear
  TyAtom := '( Expr ', TupleTail ') @tree=(42,$1,$3,0) @template=($1,\s$3) @layout-clear @forbid-clear
  TyC0 := TyC1 @tree=$0 @template=$0
  TyO0 := TyO1 @tree=$0 @template=$0 @choice-group=11 @choice-rank=1
  TyC0 := TyC1 '<| TyC0 @tree=(6,33,$0,$2) @template=$0\s<|\s$2
  TyO0 := TyC1 '<| TyO0 @tree=(6,33,$0,$2) @template=$0\s<|\s$2 @choice-group=11 @choice-rank=0
  TyC1 := TyC10 @tree=$0 @template=$0
  TyO1 := TyO10 @tree=$0 @template=$0 @choice-group=6 @choice-rank=1
  TyC1 := TyC1 '|> TyC10 @tree=(6,34,$0,$2) @template=$0\s|>\s$2
  TyO1 := TyC1 '|> TyO10 @tree=(6,34,$0,$2) @template=$0\s|>\s$2 @choice-group=6 @choice-rank=0
  TyC10 := TyC20 @tree=$0 @template=$0
  TyO10 := TyO20 @tree=$0 @template=$0
  TyC10 := TyC10 '|>. field TmPipeArgs @tree=(112,(12,$0,(12,(1,s2,e2,0),(12,$3,-1,0),0),0),0,0) @template=$0\s|>.$2$3 @boundary=2:no-ws
  TyC10 := TyC10 '|>. fieldindex TmPipeArgs @tree=(113,(12,$0,(12,(2,s2,e2,d2),(12,$3,-1,0),0),0),0,0) @template=$0\s|>.$2$3 @boundary=2:no-ws
  TyC20 := TyC22 @tree=$0 @template=$0
  TyO20 := TyO22 @tree=$0 @template=$0 @choice-group=7 @choice-rank=1
  TyC20 := TyC25 '↔ TyC25 @tree=(6,25,$0,$2) @template=$0\s↔\s$2
  TyO20 := TyC25 '↔ TyO25 @tree=(6,25,$0,$2) @template=$0\s↔\s$2 @choice-group=7 @choice-rank=0
  TyC20 := TyC25 '<-> TyC25 @tree=(6,25,$0,$2) @template=$0\s↔\s$2
  TyO20 := TyC25 '<-> TyO25 @tree=(6,25,$0,$2) @template=$0\s↔\s$2 @choice-group=7 @choice-rank=0
  TyC22 := TyC25 @tree=$0 @template=$0
  TyO22 := TyO25 @tree=$0 @template=$0
  TyC22 := TyC25 '<|> TyC22 @tree=(6,37,$0,$2) @template=$0\s<|>\s$2
  TyO22 := TyC25 '<|> TyO22 @tree=(6,37,$0,$2) @template=$0\s<|>\s$2
  TyC25 := TyC30 @tree=$0 @template=$0
  TyO25 := TyO30 @tree=$0 @template=$0
  TyC25 := TyC30 '-> TyC25 @tree=(16,$0,$2,0) @template=$0\s->\s$2
  TyO25 := TyC30 '-> TyO25 @tree=(16,$0,$2,0) @template=$0\s->\s$2 @choice-group=3 @choice-rank=0
  TyC25 := TyC30 '→ TyC25 @tree=(16,$0,$2,0) @template=$0\s->\s$2
  TyO25 := TyC30 '→ TyO25 @tree=(16,$0,$2,0) @template=$0\s->\s$2 @choice-group=3 @choice-rank=0
  TyO25 := TermBinderRequired '-> Expr @tree=(116,(12,$0,(12,$2,-1,0),0),0,0) @template=$0\s->\s$2 @choice-group=3 @choice-rank=1
  TyO25 := TermBinderRequired '→ Expr @tree=(116,(12,$0,(12,$2,-1,0),0),0,0) @template=$0\s->\s$2 @choice-group=3 @choice-rank=1
  TyC30 := TyB30 @tree=$0 @template=$0
