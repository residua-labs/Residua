      if w.err != 0 then rfErr 0 w.err
      else
        let ctx1 : List Int := -1 :: -1 :: w.ty :: shiftTrailer w.ctx 1;
        let r : RecFlds := lowHeapArgs st hd fs ctx1 args ci (j + 1);
        if r.err != 0 then r
        else
          let value : List Int := if ty == 11 then wordResidueW 11 w.bs else w.bs;
