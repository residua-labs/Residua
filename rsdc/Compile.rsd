    let ac : Nat := Int.toNat (nthF 0 icts (Int.toNat ci * 5 + 3));
    let fa : Nat := Int.toNat (nthF 0 icts (Int.toNat ci * 5 + 4));
    let rows : Bag := indRows st hd mx 0 col ci ac (acc0 0);
    let branch : Mx := { pats := rows.pats, alts := rows.alts, scrs := mx.scrs, tys := mx.tys, als := rows.als, ncol := mx.ncol + ac : Mx };
    let ret : Int := code;
