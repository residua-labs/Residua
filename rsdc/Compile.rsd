def arenaMagnitudeDecodeNatBoundW : List Int := [39,25] ++ varB 0

def arenaMagnitudeDecodeIntBoundW : List Int := [39,25] ++ varB 0

def arenaMagnitudeChildBoundW (pk : List Int) : List Int :=
  let kids : List Int := [35] ++ nodeTyW pk ++ [1] ++ varB 0;
  [52,2,1] ++ kids ++ [1] ++ varB 1 ++ [0]

def arenaMagnitudePackBound (kind : Int) : List Int :=
  if kind == 10 then [4,4] ++ natMagnitudeTyW ++ [23] ++ varB 0 ++ [-600034]
  else if kind == 11 then [4,4] ++ intMagnitudeTyW ++ [23] ++ varB 0 ++ [-600035]
  else if kind == 12 then [-600034] else [-600035]

def arenaMagnitudeDecodeW (hd : List Int) (kind : Int) (holder : List Int) : List Int :=
  let payload : List Int := [35] ++ nodeTyW hd ++ [8] ++ holder;
  let decoded : List Int := [4,4,0] ++ payload ++
    (if kind == 10 || kind == 12 then [-600036] else [-600037]);
  if kind == 10 then [-600038,1] ++ decoded ++ [0]
  else if kind == 11 then [-600039,1] ++ decoded ++ [0] else decoded

def arenaMagnitudeFromNodeW (hd arB node : List Int) (slot : Int) : List Int :=
  let readIx : Int := if nPreOf hd == 3 then 2 else 3;
  let kid : List Int := [-600040,1] ++ node ++ [1] ++ litI (arenaMagnitudeSlotIndex slot) ++ [0];
  let holder : List Int := [52] ++ leb readIx ++ [1] ++ arB ++ [1] ++ kid ++ [0];
  arenaMagnitudeDecodeW hd (arenaMagnitudeSlotKind slot) holder

def arenaFieldRead : List Int -> List Int -> List Int -> Int -> List Int

  | hd, arB, baseB, ks =>
    let nPre : Int := nPreOf hd;
      let readIx : Int := if nPre == 3 then 2 else 3;
      let kidAtIx : Int := 2;
      let nTy : List Int := nodeTyW hd;
      let readNode : List Int := [52] ++ leb readIx ++ [1] ++ arB ++ ([1] ++ baseB ++ [0]);
      let kind : Int := arenaMagnitudeSlotKind ks;
      let slot : Int := arenaMagnitudeSlotIndex ks;
      if kind >= 10 && kind <= 13 then arenaMagnitudeFromNodeW hd arB readNode ks
      else if kind == 1 then [35] ++ nTy ++ leb (2 + slot) ++ readNode
      else if kind == 2 then [35] ++ nTy ++ leb (5 + slot) ++ readNode
      else if kind == 3 then [35] ++ nTy ++ [7] ++ readNode
      else if kind == 5 then [35] ++ nTy ++ [1] ++ readNode
      else if kind == 9 then [35] ++ nTy ++ [8] ++ readNode
      else if kind == 8 then
        [39, 25, 27] ++ litI slot ++ [35] ++ nTy ++ [8] ++ readNode
      else
        let kids : List Int := [35] ++ nTy ++ [1] ++ readNode;
        let kidH : List Int := [52] ++ leb kidAtIx ++ [1] ++ kids ++ ([1] ++ litI slot ++ [0]);
        if kind == 4 then kidH
        else
          let holderNode : List Int := [52] ++ leb readIx ++ [1] ++ arB ++ ([1] ++ kidH ++ [0]);
          [35] ++ nTy ++ [if kind == 7 then 8 else 1] ++ holderNode

def mkNodeRec : List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int

  | tagB, kidsB, i0B, i1B, i2B, b0B, b1B, s0B, dataB =>
    [34] ++ fiName 0 ++ tagB ++
      ([34] ++ fiName 1 ++ kidsB ++
      ([34] ++ fiName 2 ++ i0B ++
      ([34] ++ fiName 3 ++ i1B ++
      ([34] ++ fiName 4 ++ i2B ++
      ([34] ++ fiName 5 ++ b0B ++
      ([34] ++ fiName 6 ++ b1B ++
      ([34] ++ fiName 7 ++ s0B ++
      ([34] ++ fiName 8 ++ dataB ++ [33]))))))))

def mkNodeW : List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int -> List Int

  | pk, tagB, kidsB, i0B, i1B, i2B, b0B, b1B, s0B, dataB =>
    if dataNode pk then mkNodeRec tagB kidsB i0B i1B i2B b0B b1B s0B dataB
    else [34] ++ fiName 0 ++ tagB ++ [34] ++ fiName 1 ++ kidsB ++
      [34] ++ fiName 2 ++ i0B ++ [34] ++ fiName 3 ++ i1B ++
      [34] ++ fiName 4 ++ i2B ++ [34] ++ fiName 5 ++ b0B ++
      [34] ++ fiName 6 ++ b1B ++ [34] ++ fiName 7 ++ s0B ++ [33]

def listLitBs : List (List Int) -> List Int

  | [] => [22]
  | x :: xs => [26, 23] ++ x ++ listLitBs xs

def findSlotBs : List Int -> List (List Int) -> Int -> List Int -> List Int

  | [], _, _, defB => defB
  | _, [], _, defB => defB
  | k :: ks, b :: bs, target, defB =>
    if k == target then b else findSlotBs ks bs target defB

partial def collectKidsBs : List Int -> List (List Int) -> Int -> Nat -> List (List Int)
  | _, _, _, 0 => []
  | ks, bs, nk, rem + 1 =>
    let b4 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 4 nk) [];
    let b6 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 6 nk) [];
    let b7 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 7 nk) [];
    let b10 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 10 nk) [];
    let b11 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 11 nk) [];
    let b12 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 12 nk) [];
    let b13 : List Int := findSlotBs ks bs (arenaMagnitudeSlot 13 nk) [];
    let chosen : List Int := if lenI b4 > 0 then b4 else if lenI b6 > 0 then b6
      else if lenI b7 > 0 then b7 else if lenI b10 > 0 then b10 else if lenI b11 > 0 then b11
      else if lenI b12 > 0 then b12 else b13;
    if lenI chosen == 0 then [] else chosen :: collectKidsBs ks bs (nk + 1) rem

-- Overflow integers are values in a separate scalar list, never handles.
partial def collectScalarBs : List Int -> List (List Int) -> Int -> List (List Int)

  | ks, bs, slot =>
    let b : List Int := findSlotBs ks bs (800 + slot) [];
    if lenI b == 0 then [] else b :: collectScalarBs ks bs (slot + 1)

-- Prelude modules from lib/Arena.rsd:
-- nPre == 1: [alloc]
-- nPre == 3: [alloc, badNode, read]
-- nPre == 4: [alloc, badNode, kidAt, read]
def preSigsW : List Int -> Int -> List Int

  | pk, nPre =>
    if nPre <= 0 then []
    else
      let nTy : List Int := nodeTyW pk;
      let lTy : List Int := arenaTyW pk;
      let rTy : List Int := wrapResTy pk 8;
      let allocSig : List Int := [2] ++ nTy ++ lTy ++ rTy;
      if nPre == 1 then allocSig
      else
        let badSig : List Int := [1, 0] ++ nTy;
        let kidSig : List Int := [2, 4] ++ handleTyW pk ++ [0] ++ handleTyW pk;
        let readSig : List Int := [2] ++ lTy ++ handleTyW pk ++ nTy;
        if nPre == 3 then allocSig ++ badSig ++ readSig
        else allocSig ++ badSig ++ kidSig ++ readSig

def preBodsW : List Int -> Int -> List Int -> List Int

  | pk, nPre, tail =>
    if nPre <= 0 then tail
    else
      let nTy : List Int := nodeTyW pk;
      let lTy : List Int := arenaTyW pk;
      let z : List Int := litI 0;
      let one : List Int := litI 1;
      let neg1 : List Int := [0, 0, 255, 255, 255, 255, 255, 255, 255, 255];
      let allocBod : List Int :=
        [34] ++ fiName 0 ++ [34] ++ heapKeyW pk ++ [24] ++ lTy ++
          [3, 1, 33, 34] ++ fiName 1 ++ [26, 3, 1, 23, 3, 0, 33];
      if nPre == 1 then [1] ++ allocBod ++ tail
      else
        let badBod : List Int :=
          mkNodeW pk neg1 [22] z z z [1, 0] [1, 0] [2, 1, 0] [22];
        let kidBod : List Int :=
          [5, 14, 0, 3, 1] ++ z ++ [39, 25, 3, 0, 52, 2, 1, 27] ++ one ++
            [3, 0, 1, 7, 3, 1] ++ one ++ [0];
        let readIx : Int := if nPre == 3 then 2 else 3;
        let h : List Int := [35] ++ handleTyW pk ++ [0, 3, 1];
        let readBod : List Int :=
          [5, 14, 0] ++ h ++ z ++ [39, 25, 3, 0, 52] ++ leb readIx ++
            [1, 27] ++ one ++ [3, 0, 1, 34] ++ heapKeyW pk ++ [7] ++ h ++ one ++ [33, 0];
        if nPre == 3 then
          [1] ++ allocBod ++ ([1] ++ badBod ++ ([1] ++ readBod ++ tail))
        else
          [1] ++ allocBod ++ ([1] ++ badBod ++ ([1] ++ kidBod ++ ([1] ++ readBod ++ tail)))

structure RecFlds where
  err : Int
  pre : List Int
  ctx : List Int
  moved : Int
  ks : List Int
  bs : List (List Int)
  deriving Inhabited

def rfErr : Nat -> Int -> RecFlds
  | 0, e => { err := e, pre := [], ctx := [], moved := 0, ks := [], bs := [] : RecFlds }
  | n + 1, e => rfErr n e

def shiftScruts : List Int -> Int -> List Int

  | [], _ => []
  | x :: xs, k => (x + k) :: shiftScruts xs k


-- Argument indices include arena temporaries introduced while lowering later
-- operands; each source operand is bound once, in source order.
-- stop is already shifted across the fold's accumulator and element slots.
def listPrefixW (tw xs stop : List Int) : List Int :=
  [50] ++ tw ++ xs ++ [22, 5, 12, 24] ++ tw ++ varB 1 ++ stop ++
    [26] ++ varB 1 ++ [23] ++ varB 0 ++ varB 1

-- Segments are accumulated with the current segment first. Reverse only the
-- outer list at the boundary; each String keeps its source code-point order.
def splitReverseW (tw xs : List Int) : List Int :=
  [50] ++ tw ++ xs ++ [22, 26, 23] ++ varB 0 ++ varB 1

-- Lean 4.14 List.flatten/flatMap: fold the reversed segments, prepending
-- each whole segment once. Cost is O(segments + output), preserving order.
def listConcatRevW (tw xs : List Int) : List Int :=
  [50] ++ tw ++ xs ++ [22, 26] ++ varB 0 ++ varB 1

-- Full source Nat counts; only individual byte digits use scalar arithmetic.
partial def countMagnitudeSplice (tw : List Int) (countSlot valueSlot : Int) : List Int -> List Int
  | [] => []
  | -500001 :: rest => tw ++ countMagnitudeSplice tw countSlot valueSlot rest
  | -500002 :: depth :: rest => varB (countSlot + depth) ++ countMagnitudeSplice tw countSlot valueSlot rest
  | -500003 :: depth :: rest => varB (valueSlot + depth) ++ countMagnitudeSplice tw countSlot valueSlot rest
  | -500004 :: rest => magnitudeNatBinaryBound 1 ++ countMagnitudeSplice tw countSlot valueSlot rest
  | b :: rest => b :: countMagnitudeSplice tw countSlot valueSlot rest

-- Lean 4.14 src/lean/Init/Data/List/Basic.lean:482-484,511-515 (List.append/append_nil): keep signed limb arithmetic; materialize the right operand of each self-append.
def countMagnitudeReplicateBoundW (tw : List Int) (countSlot valueSlot : Int) : List Int :=
