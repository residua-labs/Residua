partial def lowArgs : St -> List Int -> List Fn -> List Int -> List Int -> List Int -> Int -> Int -> Bw

  | st, hd, fs, ctx, [], [], usesA, ex =>
    let kix : Int := lookK ctx;
      let kE : List Int := if ex == -1 then [7] ++ varB kix ++ litI 1 else litI ex;
      -- -2 omits the slot, -1 decrements it, and every nonnegative value
      -- supplies the caller's budget. Zero is an execution bound too.
