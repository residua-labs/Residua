def primWordMethod : St -> Int -> Int -> Int -> Sig
  | st, ty, a, b =>
    let ret : Int :=
      if ty == 4 && spanEq 0 st a b "toUInt8" then 9
      else if ty == 4 && spanEq 0 st a b "toUInt32" then 11
      else if isWordTy ty && spanEq 0 st a b "toNat" then 4
      else if ty == 11 && spanEq 0 st a b "val" then 4
      else if (ty == 10 || ty == 11) && spanEq 0 st a b "toUInt8" then 9
      else if (ty == 9 || ty == 11) && spanEq 0 st a b "toUInt16" then 10
      else if (ty == 9 || ty == 10) && spanEq 0 st a b "toUInt32" then 11
      else 0;
    { a := a, b := b, ret := ret, ps := [] : Sig }

def primWord : St -> Int -> Int -> Sig
  | st, a, b =>
    if spanEq 0 st a b "UInt8.ofNat" then { a := a, b := b, ret := 9, ps := [4] : Sig }
    else if spanEq 0 st a b "UInt32.ofNat" then { a := a, b := b, ret := 11, ps := [4] : Sig }
    else
      let ty : Int :=
        if b > a + 4 && spanEq 0 st a (a + 4) "Nat." then 4
        else if b > a + 6 && spanEq 0 st a (a + 6) "UInt8." then 9
        else if b > a + 7 && spanEq 0 st a (a + 7) "UInt16." then 10
        else if b > a + 7 && spanEq 0 st a (a + 7) "UInt32." then 11
        else 0;
      let p : Int := a + (if ty == 4 then 4 else if ty == 9 then 6 else 7);
      let sg : Sig := primWordMethod st ty p b;
      if sg.ret == 0 then miss 0 else { a := a, b := b, ret := sg.ret, ps := [ty] : Sig }

-- Lean 4.14 Init/Prelude maxOfLe and Init/Data/Nat/Basic Max Nat.
-- The bounded Nat signature is O(1); ordinary ckArgs checks both operands.
def prim : Nat -> St -> Int -> Int -> Sig
  | 0, st, a, b =>
    if spanEq 0 st a b "toString" || spanEq 0 st a b "ToString.toString" then { a := a, b := b, ret := 3, ps := [0] : Sig }
    else if spanEq 0 st a b "Nat.zero" then { a := a, b := b, ret := 4, ps := [] : Sig }
    else if spanEq 0 st a b "Nat.succ" then { a := a, b := b, ret := 4, ps := [4] : Sig }
    else if spanEq 0 st a b "max" || spanEq 0 st a b "min" then { a := a, b := b, ret := 4, ps := [4, 4] : Sig }
    else if spanEq 0 st a b "Int.fmod" then { a := a, b := b, ret := 1, ps := [1, 1] : Sig }
    else if spanEq 0 st a b "decide" then { a := a, b := b, ret := 2, ps := [2] : Sig }
    else if spanEq 0 st a b "List.replicate" then { a := a, b := b, ret := -3, ps := [4, 0] : Sig }
    else if spanEq 0 st a b "List.range" then { a := a, b := b, ret := listTy 0 4, ps := [4] : Sig }
    else if spanEq 0 st a b "String.length" then { a := a, b := b, ret := 4, ps := [3] : Sig }
    else if spanEq 0 st a b "String.drop" then { a := a, b := b, ret := 3, ps := [3, 4] : Sig }
    else if spanEq 0 st a b "String.startsWith" then { a := a, b := b, ret := 2, ps := [3, 3] : Sig }
    else if spanEq 0 st a b "String.extract" then { a := a, b := b, ret := 3, ps := [3, 5, 5] : Sig }
    else if spanEq 0 st a b "String.Pos.mk" then { a := a, b := b, ret := 5, ps := [4] : Sig }
    else if spanEq 0 st a b "String.toList" then { a := a, b := b, ret := 100018, ps := [3] : Sig }
    else if spanEq 0 st a b "String.toNat?" then { a := a, b := b, ret := 100013, ps := [3] : Sig }
    else if spanEq 0 st a b "List.toArray" then { a := a, b := b, ret := 7, ps := [100018] : Sig }
    else if spanEq 0 st a b "Array.toList" then { a := a, b := b, ret := 100018, ps := [7] : Sig }
    else if spanEq 0 st a b "List.drop" then { a := a, b := b, ret := 100018, ps := [4, 100018] : Sig }
    else if spanEq 0 st a b "List.take" then { a := a, b := b, ret := 100018, ps := [4, 100018] : Sig }
    -- Lean 4.14 String.Basic singleton_eq: String.mk [c], O(1) constructor.
    else if spanEq 0 st a b "String.singleton" then { a := a, b := b, ret := 3, ps := [6] : Sig }
    else if spanEq 0 st a b "String.mk" then { a := a, b := b, ret := 3, ps := [100018] : Sig }
    else if spanEq 0 st a b "Int.ofNat" then { a := a, b := b, ret := 1, ps := [4] : Sig }
    else if spanEq 0 st a b "Int.toNat" then { a := a, b := b, ret := 4, ps := [1] : Sig }
    else if spanEq 0 st a b "Char.ofNat" then { a := a, b := b, ret := 6, ps := [4] : Sig }
    else if spanEq 0 st a b "Char.toNat" then { a := a, b := b, ret := 4, ps := [6] : Sig }
    else if spanEq 0 st a b "Char.isDigit" then { a := a, b := b, ret := 2, ps := [6] : Sig }
    else primWord st a b
  | n + 1, st, a, b => prim n st a b

-- String receiver methods: `st.f` where st : String means `String.f st`. Scoped to
-- the prims the emitter knows how to lower; anything else stays unbound.
def primStr : Nat -> St -> Int -> Int -> Sig
  | 0, st, a, b =>
    if spanEq 0 st a b "length" then { a := a, b := b, ret := 4, ps := [] : Sig }
    else if spanEq 0 st a b "drop" then { a := a, b := b, ret := 3, ps := [4] : Sig }
    else if spanEq 0 st a b "startsWith" then { a := a, b := b, ret := 2, ps := [3] : Sig }
    else if spanEq 0 st a b "toList" then { a := a, b := b, ret := 100018, ps := [] : Sig }
    else if spanEq 0 st a b "toNat?" then { a := a, b := b, ret := 100013, ps := [] : Sig }
    else miss 0
  | n + 1, st, a, b => primStr n st a b

-- Int receiver methods: `x.f` where x : Int means `Int.f x`. Only the prims the
-- emitter can lower; anything else stays unbound.
def primInt : Nat -> St -> Int -> Int -> Sig
  | 0, st, a, b =>
    if spanEq 0 st a b "toNat" then { a := a, b := b, ret := 4, ps := [] : Sig }
    else miss 0
  | n + 1, st, a, b => primInt n st a b

def primCh : Nat -> St -> Int -> Int -> Sig
  | 0, st, a, b =>
    if spanEq 0 st a b "toNat" then { a := a, b := b, ret := 4, ps := [] : Sig }
    else if spanEq 0 st a b "isDigit" then { a := a, b := b, ret := 2, ps := [] : Sig }
    else miss 0
  | n + 1, st, a, b => primCh n st a b

-- First-order container operations. Method operands are bound once, in
-- source order, before the primitive body; a fallback never re-evaluates them.
def containerOp : Nat -> St -> Int -> Int -> Int -> Int
  | 0, st, ty, a, b =>
    if isOptionTy 0 ty then
      if spanEq 0 st a b "getD" then 1
      else if spanEq 0 st a b "isSome" then 2
      else if spanEq 0 st a b "isNone" then 3 else 0
    else if ty == 3 && spanEq 0 st a b "split" then 30
    else if isListTy 0 ty then
      if spanEq 0 st a b "length" then 4
      else if spanEq 0 st a b "head?" then 5
      else if spanEq 0 st a b "tail" then 6
      else if spanEq 0 st a b "isEmpty" then 7
      else if spanEq 0 st a b "headD" then 8
      else if spanEq 0 st a b "get?" then 9
      else if spanEq 0 st a b "getD" then 10
      else if spanEq 0 st a b "drop" then 11
      else if spanEq 0 st a b "all" then 20
      else if spanEq 0 st a b "any" then 21
      else if spanEq 0 st a b "map" then 22
      else if spanEq 0 st a b "filter" then 23
      else if spanEq 0 st a b "foldl" then 24
      else if spanEq 0 st a b "reverse" then 25
      else if spanEq 0 st a b "contains" then 26
      else if spanEq 0 st a b "take" then 27
      else if spanEq 0 st a b "getLast?" then 32
      else if spanEq 0 st a b "flatten" then 33
      else if spanEq 0 st a b "flatMap" then 34
      else if spanEq 0 st a b "zip" then 35 else 0
    else 0
  | n + 1, st, ty, a, b => containerOp n st ty a b

def containerSig : Nat -> Int -> Int -> Sig
  | 0, op, ty =>
    let e : Int := elemTy 0 ty;
    if op == 1 || op == 8 then { a := -1, b := -1, ret := e, ps := [e] : Sig }
    else if op == 2 || op == 3 || op == 7 then { a := -1, b := -1, ret := 2, ps := [] : Sig }
    else if op == 4 then { a := -1, b := -1, ret := 4, ps := [] : Sig }
    else if op == 5 || op == 32 then { a := -1, b := -1, ret := optionTy 0 e, ps := [] : Sig }
    else if op == 33 && isListTy 0 e then { a := -1, b := -1, ret := e, ps := [] : Sig }
    else if op == 6 || op == 25 then { a := -1, b := -1, ret := ty, ps := [] : Sig }
    else if op == 9 then { a := -1, b := -1, ret := optionTy 0 e, ps := [4] : Sig }
    else if op == 10 then { a := -1, b := -1, ret := e, ps := [4, e] : Sig }
    else if op == 11 || op == 27 then { a := -1, b := -1, ret := ty, ps := [4] : Sig }
    else if op == 26 then { a := -1, b := -1, ret := 2, ps := [e] : Sig }
    else miss 0
  | n + 1, op, ty => containerSig n op ty

def optionName : Nat -> St -> Int -> Int -> Int
  | 0, st, a, b =>
    if spanEq 0 st a b "some" || spanEq 0 st a b "Option.some" then 1
    else if spanEq 0 st a b "none" || spanEq 0 st a b "Option.none" then 2 else 0
  | n + 1, st, a, b => optionName n st a b

def findLocal : St -> List Int -> Int -> Int -> Int

  | _, [], _, _ => -1
  | st, a :: b :: ty :: rest, na, nb =>
    if spanSame 0 st na nb a b then ty else findLocal st rest na nb
  | _, _, _, _ => -1

def findSig : St -> List Sig -> Int -> Int -> Sig

  | _, [], _, _ => miss 0
  | st, sg :: rest, na, nb =>
    if spanSame 0 st na nb sg.a sg.b then sg else findSig st rest na nb

partial def findStruct : St -> List Int -> Nat -> Int -> Int -> Int

  | st, heads, i, na, nb =>
    if i >= lenI heads / 4 then -1
    else if nthF 0 heads (i * 4 + 2) >= 0 && spanSame 0 st na nb (nthF 0 heads (i * 4)) (nthF 0 heads (i * 4 + 1)) then 100 + Int.ofNat i
    else findStruct st heads (i + 1) na nb

-- inductive heads share `heads` with structures; a negative field count
-- marks them and codes 30000+i name them in type codes.
partial def findInd : St -> List Int -> Nat -> Int -> Int -> Int

  | st, heads, i, na, nb =>
    if i >= lenI heads / 4 then -1
    else if nthF 0 heads (i * 4 + 2) < 0 && spanSame 0 st na nb (nthF 0 heads (i * 4)) (nthF 0 heads (i * 4 + 1)) then 30000 + Int.ofNat i
    else findInd st heads (i + 1) na nb

partial def findFld : St -> List Int -> Nat -> Nat -> Int -> Int -> Int

  | _, _, _, 0, _, _ => -1
  | st, fields, f0, left, na, nb =>
    if spanSame 0 st na nb (nthF 0 fields (f0 * 3)) (nthF 0 fields (f0 * 3 + 1)) then nthF 0 fields (f0 * 3 + 2)
    else findFld st fields (f0 + 1) (left - 1) na nb

def fieldTy : Nat -> St -> Env -> Int -> Int -> Int -> Int
  | 0, st, env, code, na, nb =>
    if code < 100 || code >= 1000 then -1
    else
      let i : Nat := Int.toNat (code - 100);
      let count : Nat := Int.toNat (nthF 0 env.heads (i * 4 + 2));
      findFld st env.fields (Int.toNat (nthF 0 env.heads (i * 4 + 3))) count na nb
  | n + 1, st, env, code, na, nb => fieldTy n st env code na nb

def lastDotBytes : List Int -> Int -> Int -> Int -> Int

  | [], _, _, acc => acc
  | x :: xs, i, b, acc =>
    if i >= b then acc
    else if x == 46 then lastDotBytes xs (i + 1) b i
    else lastDotBytes xs (i + 1) b acc

-- Mutant of lastDotBytes: keeps the earliest dot. dotGate is 0 only when both disagree on "a.b.c".
def firstDotBytes : List Int -> Int -> Int -> Int -> Int

  | [], _, _, acc => acc
  | x :: xs, i, b, acc =>
    if i >= b then acc
    else if acc >= 0 then firstDotBytes xs (i + 1) b acc
    else if x == 46 then firstDotBytes xs (i + 1) b i
    else firstDotBytes xs (i + 1) b acc

def lastDot : St -> Int -> Int -> Int

  | st, i, b => lastDotBytes (spanBytes 0 st i b) i b (-1)

-- A receiver rooted in a local binder wins before whole-name resolution.
-- The byte list, rather than a search budget, bounds this traversal.
def localReceiverBytes : St -> List Int -> List Int -> Int -> Int -> Int -> Bool
  | _, _, [], _, _, _ => false
  | st, locs, x :: xs, a, i, b =>
    if i >= b then false
    else if x == 46 && findLocal st locs a i >= 0 then true
    else localReceiverBytes st locs xs a (i + 1) b

def localReceiver (st : St) (locs : List Int) (a b : Int) : Bool :=
  localReceiverBytes st locs (spanBytes 0 st a b) a a b

partial def getFn : St -> Int -> Int

  | st, id =>
    if id < 0 then id
    else
      let t : Int := fd 0 st id 0;
      if t == 5 || t == 13 then getFn st (fd 0 st id 1) else id

partial def getArgs : St -> Int -> List Int

  | st, id =>
    if id < 0 then []
    else if fd 0 st id 0 == 13 then getArgs st (fd 0 st id 1)
    else if fd 0 st id 0 != 5 then []
    else getArgs st (fd 0 st id 1) ++ [fd 0 st (fd 0 st id 2) 1]

partial def decTy : St -> List Int -> Int -> Int -> Int -> Int -> Int

  | st, heads, sa, sb, sc, id =>
    if id < 0 then -2
    else
      let t : Int := fd 0 st id 0;
      if t == 56 then (if fd 0 st id 1 > 0 then fd 0 st id 1 else -2)
      else if t == 13 || t == 40 then decTy st heads sa sb sc (fd 0 st id 1)
      else if t == 1 then
        let a : Int := fd 0 st id 1;
        let b : Int := fd 0 st id 2;
        if spanEq 0 st a b "Int" then 1
        else if spanEq 0 st a b "Bool" then 2
        else if spanEq 0 st a b "String" then 3
        else if spanEq 0 st a b "Nat" then 4
        else if spanEq 0 st a b "String.Pos" then 5
        else if spanEq 0 st a b "Char" then 6
        else if spanEq 0 st a b "UInt8" then 9
        else if spanEq 0 st a b "UInt16" then 10
        else if spanEq 0 st a b "UInt32" then 11
        else if spanEq 0 st a b "ByteArray" then basicTy 0 2 []
        else if spanEq 0 st a b "Substring" then basicTy 0 3 []
        else if sa >= 0 && spanSame 0 st a b sa sb then sc
        else
          let c : Int := findStruct st heads 0 a b;
          if c >= 0 then c else findInd st heads 0 a b
      else if t == 41 then
        let l : Int := decTy st heads sa sb sc (fd 0 st id 1);
        let r : Int := decTy st heads sa sb sc (fd 0 st id 2);
        productTy 0 l r
      else if t == 5 then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        if fd 0 st fn 0 != 1 then -2
        else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Prod" then
          if lenI args != 2 then -2
          else productTy 0 (decTy st heads sa sb sc (nthF 0 args 0)) (decTy st heads sa sb sc (nthF 0 args 1))
        else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Proc" then
          if lenI args != 1 then -2
          else
            let e : Int := decTy st heads sa sb sc (nthF 0 args 0);
            if e < 0 then e
            else
              let c : Int := findStruct st heads 0 (fd 0 st fn 1) (fd 0 st fn 2);
              if c < 0 then -1 else c
        else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Array" then
          if lenI args != 1 then -2 else arrayTy 0 (decTy st heads sa sb sc (nthF 0 args 0))
        else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Lean.HashMap" then
          if lenI args != 2 then -2
          else
            let k : Int := decTy st heads sa sb sc (nthF 0 args 0);
            let v : Int := decTy st heads sa sb sc (nthF 0 args 1);
            if !(dataKey k) then -2 else hashMapTy 0 k v
        else if !(spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "List" || spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Option") then -2
        else if lenI args != 1 then -2
        else
          let e : Int := decTy st heads sa sb sc (nthF 0 args 0);
          if e < 0 then e
          else if e > 1000000000000000000 then -2
          else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Option" then optionTy 0 e
          else listTy 0 e
      else -2

partial def bindNames : St -> Int -> Int -> List Int

  | st, li, ty =>
    if li < 0 then []
    else
      let idn : Int := fd 0 st li 1;
      bindNames st (fd 0 st li 2) ty ++ [fd 0 st idn 1, fd 0 st idn 2, ty]

-- Lambda declarations are in source order; checked locals are in reverse
-- binder order, matching the definition and de Bruijn conventions.
partial def lambdaNames : St -> Int -> Int -> List Int

  | st, li, ty =>
    if li < 0 then []
    else
      let name : Int := fd 0 st li 1;
      [fd 0 st name 1, fd 0 st name 2, ty] ++ lambdaNames st (fd 0 st li 2) ty

partial def lambdaDecls : St -> List Int -> Int -> List Int

  | st, heads, grp =>
    if grp < 0 then []
    else
      let ann : Int := fd 0 st grp 2;
      let ty : Int := if ann >= 0 then decTy st heads (-1) (-1) (-1) ann else if ann <= -2 then -ann - 2 else 0;
      lambdaNames st (fd 0 st grp 1) ty ++ lambdaDecls st heads (fd 0 st grp 3)

def lambdaLocs : List Int -> List Int -> Got

  | [], [] => { err := 0, xs := [], ret := 0 : Got }
  | a :: b :: ty :: rest, p :: ps =>
    if ty < 0 || (ty > 0 && ty != p) then { err := 6, xs := [], ret := 0 : Got }
    else
      let r : Got := lambdaLocs rest ps;
      { err := r.err, xs := r.xs ++ [a, b, p], ret := 0 : Got }
  | _, _ => { err := 7, xs := [], ret := 0 : Got }

partial def bindLocs : St -> List Int -> Int -> Got

  | st, heads, grp =>
    if grp < 0 then { err := 0, xs := [], ret := 0 : Got }
    else if fd 0 st grp 0 != 22 then { err := 6, xs := [], ret := 0 : Got }
    else
      let ty : Int := decTy st heads (-1) (-1) (-1) (fd 0 st grp 2);
      if ty < 0 then { err := if ty == -1 then 5 else 6, xs := [], ret := 0 : Got }
      else
        let rest : Got := bindLocs st heads (fd 0 st grp 3);
        if rest.err != 0 then rest
        else
          let here : List Int := bindNames st (fd 0 st grp 1) ty;
          { err := 0, xs := rest.xs ++ here, ret := 0 : Got }

partial def takeArrows : St -> List Int -> List Int -> Int -> Got

  | st, heads, ps, id =>
    if id < 0 then { err := 6, xs := ps, ret := 0 : Got }
    else if fd 0 st id 0 == 13 then takeArrows st heads ps (fd 0 st id 1)
    else if fd 0 st id 0 == 16 then
      let d : Int := decTy st heads (-1) (-1) (-1) (fd 0 st id 1);
      if d < 0 then { err := if d == -1 then 5 else 6, xs := ps, ret := 0 : Got }
      else takeArrows st heads (ps ++ [d]) (fd 0 st id 2)
    else
      let d : Int := decTy st heads (-1) (-1) (-1) id;
      if d < 0 then { err := if d == -1 then 5 else 6, xs := ps, ret := 0 : Got }
      else { err := 0, xs := ps, ret := d : Got }

partial def addFields : St -> List Int -> Int -> Int -> Int -> List Int -> Int -> Got

  | st, heads, sa, sb, sc, fs, fdcl =>
    if fdcl < 0 then { err := 0, xs := fs, ret := Int.ofNat (lenI fs) : Got }
    else if fd 0 st fdcl 0 != 27 then { err := 6, xs := fs, ret := 0 : Got }
    else
      let nm : Int := fd 0 st fdcl 1;
      let ty : Int := decTy st heads sa sb sc (fd 0 st fdcl 2);
      if ty < 0 then { err := if ty == -1 then 5 else 6, xs := fs, ret := 0 : Got }
      else addFields st heads sa sb sc (fs ++ [fd 0 st nm 1, fd 0 st nm 2, ty]) (fd 0 st fdcl 3)

def emptyEnv : Nat -> Env
  | 0 => { err := 0, sigs := [], heads := [], fields := [], abs := [], icts := [], iargs := [], indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }
  | n + 1 => emptyEnv n

def setE : Nat -> Env -> Int -> Env
  | 0, e, c =>
    if e.err != 0 then e
    else { err := c, sigs := e.sigs, heads := e.heads, fields := e.fields, abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }
  | n + 1, e, c => setE n e c

-- Byte-list join with a dot: "A" ++ "b" = "A.b"; empty prefix passes through.
def joinDot : Nat -> List Int -> List Int -> List Int
  | 0, p, r => if lenI p == 0 then r else p ++ [46] ++ r
  | n + 1, p, r => joinDot n p r

def litEq : Nat -> List Int -> String -> Bool
  | 0, xs, lit => Int.ofNat (lenI xs) == Int.ofNat (String.length lit) && isPreGo xs 0 (Int.ofNat (String.length lit)) lit
  | n + 1, xs, lit => litEq n xs lit

-- Array wire admission, NF-0. The full receiver type and exact operation
-- bytes are the request identity. No hash, prefix match, cache or retry.
-- The representation builder below checks element types separately.

-- qualified span of a decl name node: ident slot c holds the synth span's a
-- (a >= fileLen); falls back to the real (a, b) for unqualified names.
def qsp : Nat -> St -> Int -> List Int
  | 0, st, nm =>
    let c : Int := fd 0 st nm 3;
    if c <= 0 then [fd 0 st nm 1, fd 0 st nm 2]
    else
      let g : MR := get st.pool (0 - c - 1);
      [c, c + g.v]
  | n + 1, st, nm => qsp n st nm

-- Instance declaration names may be synthesized. Diagnostics retain the
-- original class-head position stored on their body node, never a name span.
partial def instancePositionGo (st : St) (pos : Int) (id : Nat) : Int :=
  if id >= st.nxt then pos
  else
    let d : Int := Int.ofNat id;
    let body : Int := fd 0 st d 3;
    let origin : Int := if fd 0 st d 0 == 20 then fd 0 st body 3 else 0;
    let name : Int := fd 0 st d 1;
    if origin > 0 && (pos == fd 0 st name 1 || pos == nthI (qsp 0 st name) 0) then origin - 1
    else instancePositionGo st pos (id + 1)

def instancePosition (st : St) (pos : Int) : Int :=
  if pos < fileLenI 0 st then pos else instancePositionGo st pos 0

-- rewrite slots a,b of node id (use-site ident resolved to a qualified name).
def setAB : Nat -> St -> Int -> Int -> Int -> St
  | 0, st, id, a, b => setNodeSlot (setNodeSlot st id 1 a) id 2 b
  | n + 1, st, id, a, b => setAB n st id a b

-- write slot c of node id (recv-pin flag -9 on use-site idents).
def setC : Nat -> St -> Int -> Int -> St
  | 0, st, id, v => setNodeSlot st id 3 v
  | n + 1, st, id, v => setC n st id v

-- synth a qualified name span on a decl name node under namespace bytes ns.
def qname : Nat -> St -> List Int -> Int -> St
  | 0, st, ns, nm =>
    if lenI ns == 0 then st
    else
      let na : Int := fd 0 st nm 1;
      let nb : Int := fd 0 st nm 2;
      let qbs : List Int := joinDot 0 ns (spanBytes 0 st na nb);
      let qa : Int := fileLenI 0 st + nm;
      let st1 : St := setPool 0 st (putSpan 0 st.pool qa qbs);
      setC 0 st1 nm qa
  | n + 1, st, ns, nm => qname n st ns nm

-- byte-list lookups: resolution candidates are built as byte lists, so the
-- env tables get byte-equality variants of findSig / findStruct / fields.
def findSigB : St -> List Sig -> List Int -> Sig

  | _, [], _ => miss 0
  | st, sg :: rest, bs =>
    if eqListI (spanBytes 0 st sg.a sg.b) bs then sg else findSigB st rest bs

partial def findStructB : St -> List Int -> Nat -> List Int -> List Int

  | st, heads, i, bs =>
    if i >= lenI heads / 4 then []
    else if eqListI (spanBytes 0 st (nthF 0 heads (i * 4)) (nthF 0 heads (i * 4 + 1))) bs then [nthF 0 heads (i * 4), nthF 0 heads (i * 4 + 1)]
    else findStructB st heads (i + 1) bs

def findAliasB : St -> List Int -> List Int -> List Int

  | _, [], _ => []
  | st, a :: b :: ty :: rest, bs =>
    if eqListI (spanBytes 0 st a b) bs then [a, b, ty] else findAliasB st rest bs
  | _, _, _ => []

-- NAME-INDEX begin. Keep the exact integer sequence used by eqListI.
-- Synthetic spans and refusal paths are not restricted to byte-valued lists.
def nameKey (bs : List Int) : List Int := bs

def sigNameFind : List SigNameEntry -> List Int -> Option Sig
  | [], _ => none
  | entry :: rest, key =>
    if eqListI entry.key key then some entry.value else sigNameFind rest key

def sigNameContains : List SigNameEntry -> List Int -> Bool
  | [], _ => false
  | entry :: rest, key =>
    if eqListI entry.key key then true else sigNameContains rest key

def intsNameFindD : List IntsNameEntry -> List Int -> List Int -> List Int
  | [], _, fallback => fallback
  | entry :: rest, key, fallback =>
    if eqListI entry.key key then entry.value else intsNameFindD rest key fallback

def intsNameContains : List IntsNameEntry -> List Int -> Bool
  | [], _ => false
  | entry :: rest, key =>
    if eqListI entry.key key then true else intsNameContains rest key

def SigNameIndex.find? : SigNameIndex -> List Int -> Option Sig
  | m, key => sigNameFind m.entries key

def SigNameIndex.contains : SigNameIndex -> List Int -> Bool
  | m, key => sigNameContains m.entries key

def SigNameIndex.insert : SigNameIndex -> List Int -> Sig -> SigNameIndex
  | m, key, value =>
    { entries := { key := key, value := value : SigNameEntry } :: m.entries : SigNameIndex }

def IntsNameIndex.findD : IntsNameIndex -> List Int -> List Int -> List Int
  | m, key, fallback => intsNameFindD m.entries key fallback

def IntsNameIndex.contains : IntsNameIndex -> List Int -> Bool
  | m, key => intsNameContains m.entries key

def IntsNameIndex.insert : IntsNameIndex -> List Int -> List Int -> IntsNameIndex
  | m, key, value =>
    { entries := { key := key, value := value : IntsNameEntry } :: m.entries : IntsNameIndex }

def indexSigs : St -> List Sig -> SigNameIndex -> SigNameIndex
  | _, [], acc => acc
  | st, sg :: rest, acc =>
    let key := nameKey (spanBytes 0 st sg.a sg.b)
    let next := if SigNameIndex.contains acc key then acc else SigNameIndex.insert acc key sg
    indexSigs st rest next

def indexHeads : St -> List Int -> IntsNameIndex -> IntsNameIndex
  | st, a :: b :: _ :: _ :: rest, acc =>
    let key := nameKey (spanBytes 0 st a b)
    let next := if IntsNameIndex.contains acc key then acc else IntsNameIndex.insert acc key [a, b]
    indexHeads st rest next
  | _, _, acc => acc

def indexAliases : St -> List Int -> IntsNameIndex -> IntsNameIndex
  | st, a :: b :: ty :: rest, acc =>
    let key := nameKey (spanBytes 0 st a b)
    let next := if IntsNameIndex.contains acc key then acc else IntsNameIndex.insert acc key [a, b, ty]
    indexAliases st rest next
  | _, _, acc => acc

def indexEnv (st : St) (e : Env) : Env :=
  { err := e.err, sigs := e.sigs, heads := e.heads, fields := e.fields,
    abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := true,
    sigNames := indexSigs st e.sigs emptySigNameIndex,
    headNames := indexHeads st e.heads emptyIntsNameIndex,
    aliasNames := indexAliases st e.abs emptyIntsNameIndex : Env }

def findSigBE (st : St) (e : Env) (bs : List Int) : Sig :=
  if e.indexed then
    let found : Option Sig := SigNameIndex.find? e.sigNames (nameKey bs);
    found.getD (miss 0)
  else findSigB st e.sigs bs

def findSigE (st : St) (e : Env) (a b : Int) : Sig :=
  if e.indexed then findSigBE st e (spanBytes 0 st a b)
  else findSig st e.sigs a b

-- Lean 4.14 Meta.etaExpand (Meta/Basic.lean:1943-1953) introduces a
-- function's typed telescope and applies the original function to it.
-- Reuse liftCallback's existing construction for these two unary primitives.
-- Each fixed-name comparison is O(1) for source spans, O(log P) for a
-- synthetic span in the existing balanced pool of P entries; other names
-- retain findSigE's lookup cost. Primitive precedence agrees with ckCall.
def callbackSig (st : St) (e : Env) (a b : Int) : Sig :=
  if spanEq 0 st a b "Int.toNat" || spanEq 0 st a b "Int.ofNat" then prim 0 st a b
  else findSigE st e a b

def findHeadBE (st : St) (e : Env) (bs : List Int) : List Int :=
  if e.indexed then IntsNameIndex.findD e.headNames (nameKey bs) []
  else findStructB st e.heads 0 bs

def findAliasBE (st : St) (e : Env) (bs : List Int) : List Int :=
  if e.indexed then IntsNameIndex.findD e.aliasNames (nameKey bs) []
  else findAliasB st e.abs bs
-- NAME-INDEX end.

-- prim names on a byte list (mirrors `prim`'s literal table).
def dataKnownBytes : List Int -> List String -> Bool
  | _, [] => false
  | bs, name :: rest => litEq 0 bs name || dataKnownBytes bs rest

def primL : Nat -> List Int -> Bool
  | 0, bs =>
    litEq 0 bs "Int.fmod" || litEq 0 bs "decide" || litEq 0 bs "min" ||
    litEq 0 bs "Nat.zero" || litEq 0 bs "Nat.succ" || litEq 0 bs "max" || litEq 0 bs "List.range" || litEq 0 bs "List.getLast?" || litEq 0 bs "List.flatten" || litEq 0 bs "List.flatMap" || litEq 0 bs "List.zip" ||
    litEq 0 bs "List.replicate" || litEq 0 bs "String.split" || litEq 0 bs "toString" || litEq 0 bs "ToString.toString" ||
    litEq 0 bs "String.length" || litEq 0 bs "String.drop" || litEq 0 bs "String.startsWith" || litEq 0 bs "String.extract" ||
    litEq 0 bs "String.Pos.mk" || litEq 0 bs "String.toList" || litEq 0 bs "String.toNat?" || litEq 0 bs "List.toArray" || litEq 0 bs "Array.toList" ||
    litEq 0 bs "List.drop" || litEq 0 bs "List.take" || litEq 0 bs "String.mk" || litEq 0 bs "String.singleton" || litEq 0 bs "Int.ofNat" ||
    litEq 0 bs "Int.toNat" || litEq 0 bs "Char.ofNat" || litEq 0 bs "Char.toNat" || litEq 0 bs "Char.isDigit" ||
    dataKnownBytes bs (dataNames 0) ||
    litEq 0 bs "Nat.toUInt8" || litEq 0 bs "Nat.toUInt32" || litEq 0 bs "UInt8.ofNat" || litEq 0 bs "UInt32.ofNat" ||
    litEq 0 bs "UInt8.toNat" || litEq 0 bs "UInt16.toNat" || litEq 0 bs "UInt32.toNat" || litEq 0 bs "UInt32.val" ||
    litEq 0 bs "UInt32.toUInt8" || litEq 0 bs "UInt32.toUInt16" || litEq 0 bs "UInt16.toUInt8" ||
    litEq 0 bs "UInt8.toUInt16" || litEq 0 bs "UInt8.toUInt32" || litEq 0 bs "UInt16.toUInt32"
  | n + 1, bs => primL n bs

def addStructHead : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      { err := 0, sigs := e.sigs, heads := e.heads ++ [nthI qs 0, nthI qs 1, 0, 0], fields := e.fields, abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

def setHeadAt : List Int -> Nat -> Int -> Int -> List Int

  | [], _, _, _ => []
  | na :: nb :: _ :: _ :: rest, 0, cnt, first => na :: nb :: cnt :: first :: rest
  | na :: nb :: c :: f :: rest, i + 1, cnt, first => na :: nb :: c :: f :: setHeadAt rest i cnt first
  | hs, _, _, _ => hs

def addStruct : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      let na : Int := nthI qs 0;
      let nb : Int := nthI qs 1;
      let code : Int := findStruct st e.heads 0 na nb;
      if code < 100 then setE 0 e 5
      else
        let i : Nat := Int.toNat (code - 100);
        let before : Nat := lenI e.fields;
        let got : Got := addFields st e.heads na nb code e.fields (fd 0 st id 2);
        if got.err != 0 then setE 0 e got.err
        else
          let nf : Nat := lenI got.xs - before;
          let hs2 : List Int := setHeadAt e.heads i (Int.ofNat (nf / 3)) (Int.ofNat (before / 3));
          { err := 0, sigs := e.sigs, heads := hs2, fields := got.xs, abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

def addDef : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      let na : Int := nthI qs 0;
      let nb : Int := nthI qs 1;
      let old : Sig := findSigE st e na nb;
      if old.ret != 0 then setE 0 e 6
      else
        let sig : Int := fd 0 st id 2;
        let locs : Got := bindLocs st e.heads (fd 0 st sig 1);
        if locs.err != 0 then setE 0 e locs.err
        else
          let ps0 : List Int := tysOf locs.xs;
          let ar : Got := takeArrows st e.heads ps0 (fd 0 st sig 2);
          if ar.err != 0 then setE 0 e ar.err
          else
            let sg : Sig := { a := na, b := nb, ret := ar.ret, ps := ar.xs : Sig };
            { err := 0, sigs := sg :: e.sigs, heads := e.heads, fields := e.fields, abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

-- abbrev T := ty: registered as a flat [qa qb tyNode] triple in abs; the
-- type node is name-resolved at qualify time, decoded on demand by decTy.
def addAlias : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      let old : List Int := findAliasBE st e (spanBytes 0 st (nthI qs 0) (nthI qs 1));
      if lenI old > 0 then setE 0 e 6
      else { err := 0, sigs := e.sigs, heads := e.heads, fields := e.fields, abs := e.abs ++ [nthI qs 0, nthI qs 1, fd 0 st id 2], icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

-- inductive heads land in `heads` with a placeholder negative count; the
-- count is completed in mode 1 when the ctor table is known.
def addIndHead : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      { err := 0, sigs := e.sigs, heads := e.heads ++ [nthI qs 0, nthI qs 1, -1, 0], fields := e.fields, abs := e.abs, icts := e.icts, iargs := e.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

-- ctor table, stride 5: qualified span a b, head index, arg count, first
-- arg index into iargs. Both env.icts and the packed tail share it.
partial def findCtorB : St -> List Int -> Nat -> List Int -> Int

  | st, icts, j, bs =>
    if j >= lenI icts / 5 then -1
    else if eqListI (spanBytes 0 st (nthF 0 icts (j * 5)) (nthF 0 icts (j * 5 + 1))) bs then Int.ofNat j
    else findCtorB st icts (j + 1) bs

-- Concrete datatype instances keep the source constructor spelling. The
-- internal family key includes the template id and cannot be written by
-- the source lexer, so unrelated declarations never acquire overloads.
def dataKeyDigits : List Int -> List Int
  | [] => []
  | 36 :: _ => []
  | x :: xs => x :: dataKeyDigits xs

def dataFamilyKey : List Int -> List Int
  | [] => []
  | 36 :: 112 :: xs => [36, 112] ++ dataKeyDigits xs
  | x :: xs =>
    let rest : List Int := dataFamilyKey xs;
    if lenI rest == 0 then [] else x :: rest

def sameDataFamily (st : St) (heads : List Int) (a : Int) (b : Int) : Bool :=
  let ka : List Int := dataFamilyKey (spanBytes 0 st (nthF 0 heads (Int.toNat a * 4)) (nthF 0 heads (Int.toNat a * 4 + 1)));
  let kb : List Int := dataFamilyKey (spanBytes 0 st (nthF 0 heads (Int.toNat b * 4)) (nthF 0 heads (Int.toNat b * 4 + 1)));
  a != b && lenI ka > 0 && eqListI ka kb

partial def findCtorTy : St -> List Int -> Nat -> List Int -> Int -> Int -> Int
  | st, icts, j, bs, exp, hit =>
    if j >= lenI icts / 5 then hit
    else if eqListI (spanBytes 0 st (nthF 0 icts (j * 5)) (nthF 0 icts (j * 5 + 1))) bs && (exp == 0 || exp == 30000 + nthF 0 icts (j * 5 + 2)) then
      if hit >= 0 then -2 else findCtorTy st icts (j + 1) bs exp (Int.ofNat j)
    else findCtorTy st icts (j + 1) bs exp hit

-- A checked constructor reference carries its selected table index. Check
-- the spelling and result type again before using the annotation.
def ctorNode (st : St) (icts : List Int) (id : Int) (exp : Int) : Int :=
  let bs : List Int := spanBytes 0 st (fd 0 st id 1) (fd 0 st id 2);
  let mark : Int := fd 0 st id 3;
  if mark > -1000 then findCtorTy st icts 0 bs exp (-1)
  else
    let i : Nat := Int.toNat (-mark - 1000);
    if i < lenI icts / 5 && eqListI bs (spanBytes 0 st (nthF 0 icts (i * 5)) (nthF 0 icts (i * 5 + 1))) && (exp == 0 || exp == 30000 + nthF 0 icts (i * 5 + 2)) then Int.ofNat i
    else -2

def ctorSig (icts : List Int) (iargs : List Int) (ci : Int) : Sig :=
  if ci < 0 then miss 0
  else
    let i : Nat := Int.toNat ci;
    let count : Nat := Int.toNat (nthF 0 icts (i * 5 + 3));
    let first : Nat := Int.toNat (nthF 0 icts (i * 5 + 4));
    { a := nthF 0 icts (i * 5), b := nthF 0 icts (i * 5 + 1), ret := 30000 + nthF 0 icts (i * 5 + 2), ps := takeI (dropI iargs first) count : Sig }

-- Anonymous dot constructors use the expected family's constructor table.
-- Walking its actual rows introduces no search fuel or candidate-count cap.
def anonymousCtorCandidates (st : St) (exp a b : Int) : List Int -> Nat -> Int -> Int
  | ca :: cb :: hi :: _ :: _ :: rest, j, hit =>
    let dot : Int := lastDot st ca cb;
    let start : Int := if dot < ca then ca else dot + 1;
    let short : List Int := dropI (spanBytes 0 st ca cb) (Int.toNat (start - ca));
    if exp == 30000 + hi && eqListI short (spanBytes 0 st a b) then
      if hit != -1 then -2 else anonymousCtorCandidates st exp a b rest (j + 1) (Int.ofNat j)
    else anonymousCtorCandidates st exp a b rest (j + 1) hit
  | _, _, hit => hit

def anonymousCtorIndex (st : St) (icts : List Int) (fn exp : Int) : Int :=
  anonymousCtorCandidates st exp (fd 0 st fn 1) (fd 0 st fn 2) icts 0 (-1)

-- Parenthesizing an application is transparent. Parenthesizing its anonymous
-- head prevents Lean from sending the application's expected type to that head.
partial def anonymousCtorHeadSeparated (st : St) (id : Int) : Bool :=
  if id < 0 then false
  else if fd 0 st id 0 == 5 then anonymousCtorHeadSeparated st (fd 0 st id 1)
  else fd 0 st id 0 == 13

-- decode one ctor's arg-type list into codes (the sig's ps and the iargs tail).
partial def decArgLis : St -> List Int -> Int -> List Int -> Got

  | st, heads, li, acc =>
    if li < 0 then { err := 0, xs := acc, ret := 0 : Got }
    else if fd 0 st li 0 != 12 then { err := 6, xs := acc, ret := 0 : Got }
    else
      let ty : Int := decTy st heads (-1) (-1) (-1) (fd 0 st li 1);
      if ty < 0 then { err := if ty == -1 then 5 else 6, xs := acc, ret := 0 : Got }
      else decArgLis st heads (fd 0 st li 2) (acc ++ [ty])

partial def addCtor : St -> Env -> Int -> Int -> Env

  | st, e, i, ct =>
    if e.err != 0 then e
    else if ct < 0 then e
    else if fd 0 st ct 0 != 12 then setE 0 e 6
    else
      let c : Int := fd 0 st ct 1;
      if fd 0 st c 0 != 39 then setE 0 e 6
      else
        let cnm : Int := fd 0 st c 1;
        let qs : List Int := qsp 0 st cnm;
        let ca : Int := nthI qs 0;
        let cb : Int := nthI qs 1;
        let old : Int := findCtorB st e.icts 0 (spanBytes 0 st ca cb);
        if old >= 0 && !(sameDataFamily st e.heads i (nthF 0 e.icts (Int.toNat old * 5 + 2))) then setE 0 e 6
        else
          let got : Got := decArgLis st e.heads (fd 0 st c 2) [];
          if got.err != 0 then setE 0 e got.err
          else
            let fa : Int := Int.ofNat (lenI e.iargs);
            let acnt : Int := Int.ofNat (lenI got.xs);
            let sg : Sig := { a := ca, b := cb, ret := 30000 + i, ps := got.xs : Sig };
            let e2 : Env :=
              { err := 0, sigs := sg :: e.sigs, heads := e.heads, fields := e.fields, abs := e.abs,
                icts := e.icts ++ [ca, cb, i, acnt, fa], iargs := e.iargs ++ got.xs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env };
            addCtor st e2 i (fd 0 st ct 2)

def addInd : St -> Env -> Int -> Env

  | st, e, id =>
    if e.err != 0 then e
    else
      let nm : Int := fd 0 st id 1;
      let qs : List Int := qsp 0 st nm;
      let code : Int := findInd st e.heads 0 (nthI qs 0) (nthI qs 1);
      if code < 0 then setE 0 e 5
      else
        let i : Int := code - 30000;
        let first : Int := Int.ofNat ((lenI e.icts) / 5);
        let e2 : Env := addCtor st e i (fd 0 st id 2);
        if e2.err != 0 then e2
        else
          let ccnt : Int := Int.ofNat ((lenI e2.icts - lenI e.icts) / 5);
          { err := 0, sigs := e2.sigs, heads := setHeadAt e2.heads (Int.toNat i) (0 - 1 - ccnt) first,
            fields := e2.fields, abs := e2.abs, icts := e2.icts, iargs := e2.iargs, indexed := false, sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env }

partial def walk : St -> Int -> Int -> Env -> Env

  | st, mode, id, e =>
    if e.err != 0 then e
    else if id < 0 then e
    else if fd 0 st id 0 != 19 then setE 0 e 6
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let e2 : Env :=
        if t == 28 then walk st mode (fd 0 st d 1) e
        else if t == 34 || t == 36 then walk st mode (fd 0 st d 2) e
        else if mode == 0 && t == 26 then addStructHead st e d
        else if mode == 0 && t == 38 then addIndHead st e d
        else if mode == 1 && t == 26 then addStruct st e d
        else if mode == 1 && t == 38 then addInd st e d
        else if mode == 2 && t == 20 then addDef st e d
        else if mode == 0 && t == 37 then addAlias st e d
        else if t == 26 || t == 20 || t == 28 || t == 35 || t == 37 || t == 38 then e
        else setE 0 e 6;
      if e2.err != 0 then e2 else walk st mode (fd 0 st id 2) e2

def seen : St -> List Int -> Int -> Int -> Bool

  | _, [], _, _ => false
  | st, a :: b :: rest, na, nb =>
    if spanSame 0 st na nb a b then true else seen st rest na nb
  | _, _, _, _ => false

-- Namespace prefix list of a dotted path: "A.B" -> ["A.B", "A"]; "" -> [""].
partial def pfxB : List Int -> List (List Int)

  | bs =>
    let d : Int := lastDotBytes bs 0 (Int.ofNat (lenI bs)) (-1);
      if d < 0 then [bs]
      else bs :: pfxB (takeI bs (Int.toNat d))

def inBss : List (List Int) -> List Int -> Bool

  | [], _ => false
  | x :: rest, bs => eqListI x bs || inBss rest bs

structure OpenScope where
  ns : List Int
  excepts : List (List Int)
  deriving Inhabited

def plainOpens : List (List Int) -> List OpenScope

  | [] => []
  | p :: rest => { ns := p, excepts := [] : OpenScope } :: plainOpens rest

-- Search surrounding namespaces first. Atomic root names compete with opens.
def prefsOf : Nat -> List Int -> List OpenScope -> List OpenScope
  | 0, ns, ops => plainOpens (pfxB ns ++ [[]]) ++ ops
  | n + 1, ns, ops => prefsOf n ns ops

-- resolve one `open` target against the namespace table: longest ns prefix
-- that yields a declared namespace, else the literal bytes.
def resOpenGo : List (List Int) -> List (List Int) -> List Int -> List Int

  | [], _, bs => bs
  | p :: rest, nss, bs =>
    let cand : List Int := joinDot 0 p bs;
    if inBss nss cand then cand else resOpenGo rest nss bs

def openScopeNs : List (List Int) -> List (List Int) -> List Int -> List Int

  | [], _, _ => []
  | p :: rest, nss, bs =>
    let cand : List Int := joinDot 0 p bs;
    if inBss nss cand then cand else openScopeNs rest nss bs

-- A hiding clause requires one namespace, including namespaces visible via
-- other opens. Lean requires exactly one result, including repeated paths.
def openUniqueNs : List OpenScope -> List (List Int) -> List Int -> List Int -> List Int

  | [], _, _, acc => if lenI acc == 0 then [-1] else acc
  | p :: rest, nss, bs, acc =>
    let cand : List Int := joinDot 0 p.ns bs;
    if inBss p.excepts bs || !(inBss nss cand) then openUniqueNs rest nss bs acc
    else if lenI acc == 0 then openUniqueNs rest nss bs cand
    else [-1]

partial def openHiddenNames : St -> Int -> List (List Int)

  | st, li =>
    if li < 0 then []
    else
      let nm : Int := fd 0 st li 1;
      spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2) :: openHiddenNames st (fd 0 st li 2)

-- Resolved targets of an open-name spine; each exclusion belongs to this
-- open alone. A negative prefix is the unique-namespace refusal marker.
partial def openTgtLis : St -> List (List Int) -> List Int -> List OpenScope -> Int -> Int -> List OpenScope

  | st, nss, ns, ops, li, hidden =>
    if li < 0 then []
    else
      let nm : Int := fd 0 st li 1;
      let bs : List Int := spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2);
      let target : List Int :=
        if hidden < 0 then resOpenGo (pfxB ns ++ [[]]) nss bs
        else openUniqueNs ops nss bs (openScopeNs (pfxB ns ++ [[]]) nss bs);
      { ns := target, excepts := openHiddenNames st hidden : OpenScope } ::
        openTgtLis st nss ns ops (fd 0 st li 2) hidden

def openNameBefore : St -> Int -> List Int -> Int -> Bool

  | st, nm, bs, before =>
    let qs : List Int := qsp 0 st nm;
    fd 0 st nm 1 < before && eqListI (spanBytes 0 st (nthI qs 0) (nthI qs 1)) bs

partial def openCtorBefore : St -> Int -> List Int -> Int -> Bool

  | st, li, bs, before =>
    if li < 0 then false
    else openNameBefore st (fd 0 st (fd 0 st li 1) 1) bs before ||
      openCtorBefore st (fd 0 st li 2) bs before

-- Validation observes source order, rather than the completed signature
-- table (which also contains definitions after this open command).
partial def openDeclBefore : St -> Int -> List Int -> Int -> Bool

  | st, id, bs, before =>
    if id < 0 || fd 0 st id 0 != 19 then false
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let here : Bool :=
        if t == 20 || t == 26 || t == 37 || t == 38 then
          openNameBefore st (fd 0 st d 1) bs before ||
            (t == 38 && openCtorBefore st (fd 0 st d 2) bs before)
        else if t == 34 || t == 36 then openDeclBefore st (fd 0 st d 2) bs before
        else if t == 28 then
          let meta : Int := fd 0 st d 2 - 1;
          let mt : Int := fd 0 st meta 0;
          (meta >= 0 && (mt == 26 || mt == 38) &&
            (openNameBefore st (fd 0 st meta 1) bs before ||
              (mt == 38 && openCtorBefore st (fd 0 st meta 2) bs before))) ||
            openDeclBefore st (fd 0 st d 1) bs before
        else false;
      here || openDeclBefore st (fd 0 st id 2) bs before

def openHiddenValid : St -> List Int -> Int -> List (List Int) -> Bool

  | _, _, _, [] => true
  | st, ns, before, bs :: rest =>
    let cand : List Int := joinDot 0 ns bs;
    openDeclBefore st (fd 0 st st.root 1) cand before && openHiddenValid st ns before rest

def openScopesValid : St -> Int -> List OpenScope -> Bool

  | _, _, [] => true
  | st, hidden, p :: rest =>
    let before : Int := fd 0 st (fd 0 st hidden 1) 1;
    !(eqListI p.ns [-1]) && openHiddenValid st p.ns before p.excepts && openScopesValid st hidden rest

-- Distinct declarations from opens are ambiguous. Reopening the same
-- namespace still denotes one declaration. [-1] is a named refusal marker.
-- Three cells identify a structure constructor. Two cells name a value.
def resValue (st : St) (e : Env) (bs : List Int) : List Int :=
  let sg : Sig := findSigBE st e bs;
  if sg.ret != 0 then [sg.a, sg.b]
  else
    let n : Nat := lenI bs;
    if n < 4 || !(litEq 0 (dropI bs (n - 3)) ".mk") then []
    else
      let head : List Int := findHeadBE st e (takeI bs (n - 3));
      if lenI head == 0 then []
      else
        let a : Int := nthI head 0;
        let b : Int := nthI head 1;
        let ty : Int := findStruct st e.heads 0 a b;
        if ty >= 100 && ty < 1000 then [a, b, ty] else []

def resValOpen : St -> Env -> List OpenScope -> List Int -> List Int -> List Int

  | _, _, [], _, acc => acc
  | st, e, p :: rest, bs, acc =>
    let found : List Int := resValue st e (joinDot 0 p.ns bs);
    if inBss p.excepts bs || lenI found == 0 then resValOpen st e rest bs acc
    else if lenI acc == 0 || eqListI acc found then resValOpen st e rest bs found
    else [-1]

def resTyOpen : St -> Env -> List OpenScope -> List Int -> List Int -> List Int

  | _, _, [], _, acc => acc
  | st, e, p :: rest, bs, acc =>
    let cand : List Int := joinDot 0 p.ns bs;
    let s : List Int := findHeadBE st e cand;
    let found : List Int := if lenI s > 0 then s else findAliasBE st e cand;
    if inBss p.excepts bs then resTyOpen st e rest bs acc
    else if lenI found == 0 then resTyOpen st e rest bs acc
    else if lenI acc == 0 || eqListI acc found then resTyOpen st e rest bs found
    else [-1]

-- Surrounding namespace and exact qualified declarations precede opens. A prim
-- name stops the search but stays real (the prim tables match real spans).
def resValGo : St -> Env -> List OpenScope -> List Int -> List Int

  | st, e, [], _ => []
  | st, e, p :: rest, bs =>
    if lenI p.ns == 0 && lastDotBytes bs 0 (Int.ofNat (lenI bs)) (-1) < 0 then
      resValOpen st e (p :: rest) bs []
    else
      let cand : List Int := joinDot 0 p.ns bs;
      let found : List Int := resValue st e cand;
      if lenI found != 0 then found
      else if primL 0 cand then []
      else if lenI p.ns == 0 then resValOpen st e rest bs []
      else resValGo st e rest bs

-- type-position resolution: first pref producing a struct head or abbrev.
def resTyGo : St -> Env -> List OpenScope -> List Int -> List Int

  | st, e, [], _ => []
  | st, e, p :: rest, bs =>
    if lenI p.ns == 0 && lastDotBytes bs 0 (Int.ofNat (lenI bs)) (-1) < 0 then
      resTyOpen st e (p :: rest) bs []
    else
      let cand : List Int := joinDot 0 p.ns bs;
      let s : List Int := findHeadBE st e cand;
      if lenI s > 0 then s
      else
        let al : List Int := findAliasBE st e cand;
        if lenI al > 0 then al
        else if lenI p.ns == 0 then resTyOpen st e rest bs []
        else resTyGo st e rest bs

-- pass 1: write the qualified span on every decl name node (ident slot c).
-- ctor names qualify under the inductive's own namespace: `Expr.add`.
partial def qualIndCtors : St -> Int -> List Int -> St

  | st, ct, ns =>
    if ct < 0 then st
    else if fd 0 st ct 0 != 12 then st
    else
      let st1 : St := qname 0 st ns (fd 0 st (fd 0 st ct 1) 1);
      qualIndCtors st1 (fd 0 st ct 2) ns

partial def qualDecls : St -> Int -> List Int -> St

  | st, id, ns =>
    if id < 0 then st
    else if fd 0 st id 0 != 19 then st
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let st1 : St :=
        if t == 20 || t == 26 || t == 37 then qname 0 st ns (fd 0 st d 1)
        else if t == 38 then
          let nm : Int := fd 0 st d 1;
          let nsI : List Int := joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2));
          qualIndCtors (qname 0 st ns nm) (fd 0 st d 2) nsI
        else if t == 28 then qualDecls st (fd 0 st d 1) ns
        else if t == 34 then
          let nm : Int := fd 0 st d 1;
          qualDecls st (fd 0 st d 2) (joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)))
        else if t == 36 then qualDecls st (fd 0 st d 2) ns
        else st;
      qualDecls st1 (fd 0 st id 2) ns

-- Metadata on a specialized command preserves its original namespace.
def dataOriginalNs (st : St) (d : Int) (ns : List Int) : List (List Int) :=
  let meta : Int := fd 0 st d 2 - 1;
  if meta >= 0 && (fd 0 st meta 0 == 26 || fd 0 st meta 0 == 38) then
    let nm : Int := fd 0 st meta 1;
    pfxB (joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)))
  else []

-- Namespace declarations survive the scope that introduced them. The open
-- set does not. Export nested namespace names when leaving a scoped block.
partial def declaredNamespaces : St -> Int -> List Int -> List (List Int)

  | st, id, ns =>
    if id < 0 then []
    else if fd 0 st id 0 != 19 then []
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let here : List (List Int) :=
        if t == 26 || t == 38 then
          let nm : Int := fd 0 st d 1;
          pfxB (joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)))
        else if t == 34 then
          let nm : Int := fd 0 st d 1;
          let ns2 : List Int := joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2));
          pfxB ns2 ++ declaredNamespaces st (fd 0 st d 2) ns2
        else if t == 36 then declaredNamespaces st (fd 0 st d 2) ns
        else if t == 28 then
          dataOriginalNs st d ns ++ declaredNamespaces st (fd 0 st d 1) ns
        else [];
      here ++ declaredNamespaces st (fd 0 st id 2) ns

-- graft an ident node into a paren around an abbrev's resolved type subtree:
-- the node id is stable, so callers still find the same child.
def graftTy : Nat -> St -> Int -> Int -> St
  | 0, st, id, ty => setNodeSlot (setNodeSlot st id 0 13) id 1 ty
  | n + 1, st, id, ty => graftTy n st id ty

partial def dataParamHas : St -> Int -> Int -> Bool
  | st, params, id =>
    if params < 0 then false
    else
      let p : Int := fd 0 st params 1;
      spanSame 0 st (fd 0 st p 1) (fd 0 st p 2) (fd 0 st id 1) (fd 0 st id 2) ||
        dataParamHas st (fd 0 st params 2) id

-- A lexical type parameter wins over a same-spelled global alias or head.
-- Only type positions are marked; runtime defaults keep their value scope.
partial def markDataType : St -> Int -> Int -> St
  | st, id, params =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then if dataParamHas st params id then setC 0 st id (-55) else st
      else if t == 13 || t == 40 then markDataType st (fd 0 st id 1) params
      else if t == 5 || t == 12 || t == 16 || t == 41 then
        let a : St := markDataType st (fd 0 st id 1) params;
        markDataType a (fd 0 a id 2) params
      else st

partial def markDataFields : St -> Int -> Int -> St
  | st, id, params =>
    if id < 0 then st
    else
      let a : St := markDataType st (fd 0 st id 2) params;
      markDataFields a (fd 0 a id 3) params

partial def markDataCtors : St -> Int -> Int -> St
  | st, li, params =>
    if li < 0 then st
    else
      let ctor : Int := fd 0 st li 1;
      let a : St := markDataType st (fd 0 st ctor 2) params;
      let b : St := if fd 0 a ctor 3 > 0 then markDataType a (fd 0 a ctor 3 - 1) params else a;
      markDataCtors b (fd 0 b li 2) params

mutual
-- pass 2a: resolve identifiers in type positions (struct head or abbrev).
partial def qTy : St -> Env -> Int -> List Int -> List OpenScope -> List (List Int) -> St

  | st, e, id, ns, ops, nss =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 13 || t == 40 then qTy st e (fd 0 st id 1) ns ops nss
      else if t == 1 && fd 0 st id 3 == -55 then st
      else if t == 1 then
        let na : Int := fd 0 st id 1;
        let nb : Int := fd 0 st id 2;
        let r : List Int := resTyGo st e (prefsOf 0 ns ops) (spanBytes 0 st na nb);
        if lenI r == 1 then setErr 0 st 5
        else if lenI r == 3 then graftTy 0 st id (nthI r 2)
        else if lenI r == 2 then setAB 0 st id (nthI r 0) (nthI r 1)
        else st
      else if t == 16 || t == 41 then
        let st1 : St := qTy st e (fd 0 st id 1) ns ops nss;
        qTy st1 e (fd 0 st id 2) ns ops nss
      else if t == 5 then
        let st1 : St := qTy st e (fd 0 st id 1) ns ops nss;
        qTyLis st1 e (fd 0 st1 id 2) ns ops nss
      else st

partial def qTyLis : St -> Env -> Int -> List Int -> List OpenScope -> List (List Int) -> St

  | st, e, li, ns, ops, nss =>
    if li < 0 then st
    else
      let st1 : St := qTy st e (fd 0 st li 1) ns ops nss;
      qTyLis st1 e (fd 0 st li 2) ns ops nss
end

-- every ctor's arg-type list is a type position.
partial def qIndTys : St -> Env -> Int -> Int -> List Int -> List OpenScope -> List (List Int) -> St

  | st, e, ct, family, ns, ops, nss =>
    if ct < 0 then st
    else if fd 0 st ct 0 != 12 then st
    else
      let ctor : Int := fd 0 st ct 1;
      let st1 : St := qTyLis st e (fd 0 st ctor 2) ns ops nss;
      let result : Int := fd 0 st1 ctor 3 - 1;
      let st2 : St := if result >= 0 then qTy st1 e result ns ops nss else st1;
      let head : Int := dataTypeHead st2 (retTyOf st2 result);
      let qs : List Int := qsp 0 st2 family;
      if result >= 0 && (fd 0 st2 head 0 != 1 || fd 0 st2 head 3 == -55 ||
        !(spanSame 0 st2 (fd 0 st2 head 1) (fd 0 st2 head 2) (nthI qs 0) (nthI qs 1))) then setErr 0 st2 6
      else qIndTys st2 e (fd 0 st2 ct 2) family ns ops nss

-- PatternVar.processId resolves a name before deciding constructor versus
-- binder. These two markers record builtin Option constructor identity;
-- a source declaration with the same name remains a binder or source ctor.
-- Qualified Nat constructors reuse the existing zero/succ pattern matrix.
def natConstructorPatCode (st : St) (id : Int) : Int :=
  let fn : Int := getFn st id;
  let args : List Int := getArgs st id;
  if fd 0 st fn 0 != 1 || fd 0 st fn 3 == -9 then 0
  else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Nat.zero" && lenI args == 0 then 1
  else if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Nat.succ" && lenI args == 1 then 2
  else 0

def optionPatCode : St -> Int -> Int
  | st, id =>
    if id < 0 then 0
    else
      let fn : Int := getFn st id;
      if fd 0 st fn 0 != 1 then 0
      else if fd 0 st fn 3 == -57 then 1
      else if fd 0 st fn 3 == -58 then 2
      else 0

-- Init.Prelude exports Option.some/none at root. Lean.ResolveName adds these
-- aliases to root/open candidates, after nearby namespaces and outer locals.
-- Source declarations at that stage therefore make a pattern ambiguous.
def patternAliasConflict : St -> Env -> List OpenScope -> List Int -> Bool
  | _, _, [], _ => false
  | st, e, p :: rest, bs =>
    if lenI p.ns == 0 then lenI (resValOpen st e (p :: rest) bs []) != 0
    else
      let cand : List Int := joinDot 0 p.ns bs;
      let sg : Sig := findSigBE st e cand;
      if sg.ret != 0 || primL 0 cand then false
      else patternAliasConflict st e rest bs

-- Lean 4.14 Init/Data/List/Notation expands [a,b] to a :: b :: [].
-- Expand pattern literals before collecting binders, checking or lowering;
-- all three then consume the existing cons/nil pattern representation.
partial def listPatternSpine : St -> Int -> St
  | st, li =>
    if li < 0 then alloc 0 st 11 (-1) 0 0
    else
      let tail : St := listPatternSpine st (fd 0 st li 2);
      alloc 0 tail 6 13 (fd 0 st li 1) tail.ret

-- Constructor heads in patterns resolve under the same namespace/open scope
-- as values. A field binder is left alone unless its name denotes a ctor.
partial def qCtorPat : St -> Env -> Int -> List Int -> List OpenScope -> List Int -> St

  | st, e, id, ns, ops, locs =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        if findLocal st locs (fd 0 st id 1) (fd 0 st id 2) >= 0 then st
        else
          let bs : List Int := spanBytes 0 st (fd 0 st id 1) (fd 0 st id 2);
          let op : Int := optionName 0 st (fd 0 st id 1) (fd 0 st id 2);
          let prefs : List OpenScope := prefsOf 0 ns ops;
          let r : List Int := resValGo st e prefs bs;
          if lenI r == 1 || (op != 0 && lastDotBytes bs 0 (Int.ofNat (lenI bs)) (-1) < 0 &&
            patternAliasConflict st e prefs bs) then setErr 0 st 5
          else if lenI r != 2 then
            if op == 1 then setC 0 st id (-57)
            else if op == 2 then setC 0 st id (-58)
            else st
          else if findCtorB st e.icts 0 (spanBytes 0 st (nthI r 0) (nthI r 1)) < 0 then st
          else setAB 0 st id (nthI r 0) (nthI r 1)
      else if t == 5 && fd 0 st (getFn st id) 3 == -59 then
        -- List.toArray is Array.mk with one List field and @[match_pattern].
        -- Keep Array identity for checking; its field uses existing list patterns.
        let args : List Int := getArgs st id;
        if lenI args != 1 || fd 0 st (nthF 0 args 0) 0 != 11 then setErr 0 st 6
        else
          let field : Int := nthF 0 args 0;
          let ready : St := qCtorPat st e field ns ops locs;
          setNodeSlot (setNodeSlot (setNodeSlot (setNodeSlot ready id 0 57) id 1 field) id 2 0) id 3 0
      else if t == 11 && fd 0 st id 1 >= 0 then
        let request : Rsdc.ListPatternNF.Request := { elements := liCount st (fd 0 st id 1) };
        if !(Rsdc.ListPatternNF.admit request 0) then setErr 0 st 6
        else
          let built : St := listPatternSpine st (fd 0 st id 1);
          let root : Int := built.ret;
          let ready : St := setNodeSlot (setNodeSlot (setNodeSlot (setNodeSlot built id 0 6) id 1 13) id 2 (fd 0 built root 2)) id 3 (fd 0 built root 3);
          qCtorPat ready e id ns ops locs
      else if t == 5 || t == 12 || t == 42 then
        let st1 : St := qCtorPat st e (fd 0 st id 1) ns ops locs;
        qCtorPat st1 e (fd 0 st id 2) ns ops locs
      else if t == 13 || t == 47 || t == 57 then qCtorPat st e (fd 0 st id 1) ns ops locs
      else if t == 6 then
        let st1 : St := qCtorPat st e (fd 0 st id 2) ns ops locs;
        qCtorPat st1 e (fd 0 st id 3) ns ops locs
      else if t == 14 then qCtorPat st e (fd 0 st id 2) ns ops locs
      else if t == 15 then
        let st1 : St := qCtorPat st e (fd 0 st id 2) ns ops locs;
        qCtorPat st1 e (fd 0 st id 3) ns ops locs
      else st

-- pass 2b: descend the whole tree; only type positions get qTy.
partial def qExB : St -> Env -> Int -> List Int -> List OpenScope -> List (List Int) -> St

  | st, e, id, ns, ops, nss =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 19 then
        let d : Int := fd 0 st id 1;
        let dt : Int := fd 0 st d 0;
        if dt == 35 then
          let ops2 : List OpenScope := openTgtLis st nss ns ops (fd 0 st d 1) (fd 0 st d 2) ++ ops;
          qExB st e (fd 0 st id 2) ns ops2 nss
        else if dt == 34 then
          let nm : Int := fd 0 st d 1;
          let nb2 : List Int := joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2));
          let nss2 : List (List Int) := nss ++ pfxB nb2;
          let st1 : St := qExB st e (fd 0 st d 2) nb2 ops nss2;
          qExB st1 e (fd 0 st id 2) ns ops (nss2 ++ declaredNamespaces st (fd 0 st d 2) nb2)
        else if dt == 36 then
          let ops2 : List OpenScope := openTgtLis st nss ns ops (fd 0 st d 1) (fd 0 st d 3) ++ ops;
          let st1 : St := qExB st e (fd 0 st d 2) ns ops2 nss;
          qExB st1 e (fd 0 st id 2) ns ops (nss ++ declaredNamespaces st (fd 0 st d 2) ns)
        else
          let st1 : St := qExB st e d ns ops nss;
          let nss2 : List (List Int) :=
            if dt == 26 || dt == 38 then
              let nm : Int := fd 0 st d 1;
              nss ++ pfxB (joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)))
            else nss;
          qExB st1 e (fd 0 st id 2) ns ops nss2
      else if t == 21 then
        let st1 : St := qExB st e (fd 0 st id 1) ns ops nss;
        qTy st1 e (fd 0 st id 2) ns ops nss
      else if t == 22 || t == 27 then
        let tyId : Int := fd 0 st id 2;
        let st1 : St := qTy st e tyId ns ops nss;
        let st2 : St := if fd 0 st1 tyId 0 == 40 then qExB st1 e (fd 0 st1 tyId 2) ns ops nss else st1;
        qExB st2 e (fd 0 st2 id 3) ns ops nss
      else if t == 37 then qTy st e (fd 0 st id 2) ns ops nss
      else if t == 9 then
        let st1 : St := qTy st e (fd 0 st id 2) ns ops nss;
        qExB st1 e (fd 0 st id 3) ns ops nss
      else if t == 14 then
        let st1 : St := qTy st e (fd 0 st id 1) ns ops nss;
        let st2 : St := if fd 0 st1 id 3 > 0 then qExB st1 e (fd 0 st1 id 3 - 1) ns ops nss else st1;
        qExB st2 e (fd 0 st2 id 2) ns ops nss
      else if t == 30 then
        let st1 : St := qExB st e (fd 0 st id 1) ns ops nss;
        qTy st1 e (fd 0 st id 2) ns ops nss
      else if t == 20 then
        let st1 : St := qExB st e (fd 0 st id 2) ns ops nss;
        qExB st1 e (fd 0 st id 3) ns ops nss
      else if t == 32 || t == 5 || t == 10 || t == 12 || t == 31 || t == 33 || t == 42 then
        let st1 : St := qExB st e (fd 0 st id 1) ns ops nss;
        qExB st1 e (fd 0 st id 2) ns ops nss
      else if t == 15 then
        let st1 : St := qExB st e (fd 0 st id 2) ns ops nss;
        qExB st1 e (fd 0 st id 3) ns ops nss
      else if t == 6 then
        let st1 : St := qExB st e (fd 0 st id 2) ns ops nss;
        qExB st1 e (fd 0 st id 3) ns ops nss
      else if t == 24 then
        -- Pattern identifiers require the outer local context. Resolve them
        -- in qExC, after type specialization and local-binder collection.
        let b : St := qExB st e (fd 0 st id 2) ns ops nss;
        qExB b e (fd 0 st id 3) ns ops nss
      else if t == 8 then
        let st1 : St := qExB st e (fd 0 st id 1) ns ops nss;
        let st2 : St := qExB st1 e (fd 0 st id 2) ns ops nss;
        qExB st2 e (fd 0 st id 3) ns ops nss
      else if t == 7 then qExB st e (fd 0 st id 2) ns ops nss
      else if t == 23 || t == 25 then
        let st1 : St := qExB st e (fd 0 st id 1) ns ops nss;
        if fd 0 st1 id 2 > 0 then qExB st1 e (fd 0 st1 (fd 0 st1 id 2 - 1) 2) ns ops nss else st1
      else if t == 11 || t == 13 || t == 17 || t == 18 || t == 23 || t == 25 || t == 28 || t == 29 || t == 44 || t == 47 then
        qExB st e (fd 0 st id 1) ns ops nss
      else if t == 26 then
        let marked : St := if fd 0 st id 3 > 0 then markDataFields st (fd 0 st id 2) (fd 0 st id 3 - 1) else st;
        qExB marked e (fd 0 marked id 2) ns ops nss
      else if t == 34 || t == 36 then qExB st e (fd 0 st id 2) ns ops nss
      else if t == 38 then
        let marked : St := if fd 0 st id 3 > 0 then markDataCtors st (fd 0 st id 2) (fd 0 st id 3 - 1) else st;
        qIndTys marked e (fd 0 marked id 2) (fd 0 marked id 1) ns ops nss
      else st

-- binder names of a sig's grp chain as locs triples [a b 0]*.
partial def grpLocs : St -> Int -> List Int

  | st, grp =>
    if grp < 0 then []
    else bindNames st (fd 0 st grp 1) 0 ++ grpLocs st (fd 0 st grp 3)

-- binder spans inside one pattern node (mirrors ckPat's accepted shapes).
partial def patsLocs : St -> Int -> List Int -> List Int

  | st, id, acc =>
    if id < 0 then acc
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        if natConstructorPatCode st id != 0 || optionPatCode st id != 0 || spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "true" || spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "false" then acc
        else acc ++ [fd 0 st id 1, fd 0 st id 2, 0]
      else if t == 13 || t == 47 || t == 57 then patsLocs st (fd 0 st id 1) acc
      else if t == 5 then patsLocs st (fd 0 st id 2) acc
      else if t == 12 || t == 42 then patsLocs st (fd 0 st id 2) (patsLocs st (fd 0 st id 1) acc)
      else if t == 6 && fd 0 st id 1 == 13 then patsLocs st (fd 0 st id 3) (patsLocs st (fd 0 st id 2) acc)
      else if t == 6 && fd 0 st id 1 == 1 then patsLocs st (fd 0 st id 2) acc
      else if t == 14 then patsLocs st (fd 0 st id 2) acc
      else if t == 15 then patsLocs st (fd 0 st id 3) (patsLocs st (fd 0 st id 2) acc)
      else acc

-- all pattern-binder triples of an alt's pattern spine (tag-12 li chain).
partial def patsOfLis : St -> Int -> List Int -> List Int

  | st, li, acc =>
    if li < 0 then acc
    else patsOfLis st (fd 0 st li 2) (patsLocs st (fd 0 st li 1) acc)

-- getFunBinderIds? accepts only identifiers/holes, or an application of
-- those terms. In particular it does not unwrap additional parentheses.
def lambdaBinderAtoms : St -> List Int -> Bool
  | _, [] => true
  | st, id :: rest =>
    (fd 0 st id 0 == 1 || fd 0 st id 0 == 4) && lambdaBinderAtoms st rest

def lambdaBinderIds : St -> Int -> List Int
  | st, id =>
    let t : Int := fd 0 st id 0;
    if t == 1 || t == 4 then [id]
    else if t == 5 then
      let ids : List Int := getFn st id :: getArgs st id;
      if lambdaBinderAtoms st ids then ids else [-1]
    else [-1]

-- The global environment is deliberately consulted without the local context,
-- as in Lean's Macro.resolveGlobalName. Existing type/value scope resolution
-- supplies the same namespace/open precedence used elsewhere in this front end.
def lambdaGlobalsAbsent : St -> Env -> List Int -> List OpenScope -> List Int -> Bool
  | _, _, _, _, [] => true
  | st, e, ns, ops, id :: rest =>
    let bs : List Int := spanBytes 0 st (fd 0 st id 1) (fd 0 st id 2);
    let prefs : List OpenScope := prefsOf 0 ns ops;
    let known : Bool := fd 0 st id 0 == 1 &&
      (lenI (resValGo st e prefs bs) != 0 || lenI (resTyGo st e prefs bs) != 0 ||
       primL 0 bs || dataKnownBytes bs ["Int", "Nat", "Bool", "String", "Char", "Unit",
         "UInt8", "UInt16", "UInt32", "UInt64", "USize", "List", "Array", "Option", "Prod",
         "true", "false", "some", "none", "List.nil", "List.cons", "Nat.zero", "Nat.succ"]);
    !known && lambdaGlobalsAbsent st e ns ops rest

partial def lambdaOrdinaryNames : St -> List Int -> List Int -> St
  | st, [], acc => spine1 (setRet 0 st (-1)) 12 acc
  | st, id :: rest, acc =>
    if fd 0 st id 0 == 4 then
      let fresh : St := synthIdent 0 st ([36, 119] ++ natBytes st.nxt);
      lambdaOrdinaryNames fresh rest (fresh.ret :: acc)
    else lambdaOrdinaryNames st rest (id :: acc)

-- Accumulate every ordinary parameter first, then wrap matches on unwind.
-- This is the ordering of Lean.Elab.expandFunBinders, including shadowing
-- between pattern binders and later ordinary parameters.
partial def expandLambdaGroups : St -> Env -> Int -> Int -> List Int -> List OpenScope -> St
  | st, e, grp, body, ns, ops =>
    if grp < 0 then setRet 0 st body
    else
      let raw : Int := fd 0 st grp 1;
      if fd 0 st raw 0 != 55 then expandLambdaGroups st e (fd 0 st grp 3) body ns ops
      else
        let pat : Int := fd 0 st raw 1;
        let annotated : Bool := fd 0 st raw 2 == 1;
        let term : Int := if !annotated && fd 0 st pat 0 == 13 then fd 0 st pat 1 else pat;
        let ids : List Int := lambdaBinderIds st term;
        if nthI ids 0 >= 0 && (annotated || lambdaGlobalsAbsent st e ns ops ids) then
          let names : St := lambdaOrdinaryNames st ids [];
          let named : St := setNodeSlot names grp 1 names.ret;
          expandLambdaGroups named e (fd 0 named grp 3) body ns ops
        else
          let fresh : St := synthIdent 0 st ([36, 112] ++ natBytes st.nxt);
          let major : Int := fresh.ret;
          let names : St := alloc 0 fresh 12 major (-1) 0;
          let named : St := setNodeSlot names grp 1 names.ret;
          let rest : St := expandLambdaGroups named e (fd 0 named grp 3) body ns ops;
          let pats : St := alloc 0 rest 12 pat (-1) 0;
          let alt : St := alloc 0 pats 24 pats.ret rest.ret (-1);
          let scruts : St := alloc 0 alt 12 major (-1) 0;
          alloc 0 scruts 31 scruts.ret alt.ret 0

-- pass 3: resolve value-position identifiers; locals win, dotted receivers
-- with a local head get pinned (slot c = -9), decl refs get the qualified span.
partial def qExC : St -> Env -> Int -> List Int -> List OpenScope -> List (List Int) -> List Int -> St

  | st, e, id, ns, ops, nss, locs =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        let na : Int := fd 0 st id 1;
        let nb : Int := fd 0 st id 2;
        if fd 0 st id 3 == -59 then st
        else if spanEq 0 st na nb "true" || spanEq 0 st na nb "false" then st
        else if findLocal st locs na nb >= 0 then st
        else if localReceiver st locs na nb then setC 0 st id (-9)
        else
          let r : List Int := resValGo st e (prefsOf 0 ns ops) (spanBytes 0 st na nb);
          if lenI r == 1 then setErr 0 st 5
          else if lenI r == 3 then setC 0 st id (-10000 - nthI r 2)
          else if lenI r == 0 then
            let dot : Int := lastDot st na nb;
            if dot >= 0 && findLocal st locs na dot >= 0 then setC 0 st id (-9)
            else if dot >= 0 then
              let r2 : List Int := resValGo st e (prefsOf 0 ns ops) (spanBytes 0 st na dot);
              if lenI r2 == 1 then setErr 0 st 5
              else if lenI r2 != 2 then st
              else
                let qbs : List Int := joinDot 0 (spanBytes 0 st (nthI r2 0) (nthI r2 1)) (spanBytes 0 st (dot + 1) nb);
                -- Reuse the existing fresh-name allocator and reserve its node.
                -- Keep the reference identity and qExC's incoming ret value.
                let fresh : St := synthIdent 0 st qbs;
                let named : St := setAB 0 fresh id (fd 0 fresh fresh.ret 1) (fd 0 fresh fresh.ret 2);
                setRet 0 named st.ret
            else st
          else setAB 0 st id (nthI r 0) (nthI r 1)
      else if t == 19 then
        let d : Int := fd 0 st id 1;
        let dt : Int := fd 0 st d 0;
        if dt == 35 then
          let opened : List OpenScope := openTgtLis st nss ns ops (fd 0 st d 1) (fd 0 st d 2);
          if !(openScopesValid st (fd 0 st d 2) opened) then setErr 0 st 5
          else qExC st e (fd 0 st id 2) ns (opened ++ ops) nss locs
        else if dt == 34 then
          let nm : Int := fd 0 st d 1;
          let nb2 : List Int := joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2));
          let nss2 : List (List Int) := nss ++ pfxB nb2;
          let st1 : St := qExC st e (fd 0 st d 2) nb2 ops nss2 locs;
          qExC st1 e (fd 0 st id 2) ns ops (nss2 ++ declaredNamespaces st (fd 0 st d 2) nb2) locs
        else if dt == 36 then
          let opened : List OpenScope := openTgtLis st nss ns ops (fd 0 st d 1) (fd 0 st d 3);
          if !(openScopesValid st (fd 0 st d 3) opened) then setErr 0 st 5
          else
            let st1 : St := qExC st e (fd 0 st d 2) ns (opened ++ ops) nss locs;
            qExC st1 e (fd 0 st id 2) ns ops (nss ++ declaredNamespaces st (fd 0 st d 2) ns) locs
        else
          let st1 : St := qExC st e d ns ops nss locs;
          let nss2 : List (List Int) :=
            if dt == 26 || dt == 38 then
              let nm : Int := fd 0 st d 1;
              nss ++ pfxB (joinDot 0 ns (spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)))
            else if dt == 28 then nss ++ dataOriginalNs st d ns ++ declaredNamespaces st (fd 0 st d 1) ns
            else nss;
          qExC st1 e (fd 0 st id 2) ns ops nss2 locs
      else if t == 20 then
        let sg : Int := fd 0 st id 2;
        let ls : List Int := grpLocs st (fd 0 st sg 1);
        let body : Int := fd 0 st id 3;
        let st1 : St := qExC st e body ns ops nss (ls ++ locs);
        if fd 0 st1 body 2 <= 0 then st1
        else
          let meta : Int := fd 0 st1 body 2 - 1;
          let hints : List Int := bindNames st1 (fd 0 st1 meta 1) 0;
          qExC st1 e (fd 0 st1 meta 2) ns ops nss (hints ++ ls ++ locs)
      else if t == 32 then
        let expanded : St := expandLambdaGroups st e (fd 0 st id 1) (fd 0 st id 2) ns ops;
        let ready : St := setNodeSlot expanded id 2 expanded.ret;
        qExC ready e (fd 0 ready id 2) ns ops nss (grpLocs ready (fd 0 ready id 1) ++ locs)
      else if t == 24 then
        let stp : St := qCtorPat st e (fd 0 st id 1) ns ops locs;
        let ls : List Int := patsOfLis stp (fd 0 st id 1) [];
        let st1 : St := qExC stp e (fd 0 st id 2) ns ops nss (ls ++ locs);
        qExC st1 e (fd 0 st id 3) ns ops nss locs
      else if t == 9 then
        let r2 : Int := fd 0 st id 3;
        let nm : Int := fd 0 st id 1;
        let st1 : St := qExC st e (fd 0 st r2 1) ns ops nss locs;
        qExC st1 e (fd 0 st r2 2) ns ops nss ([fd 0 st nm 1, fd 0 st nm 2, 0] ++ locs)
      else if t == 15 then
        let st1 : St := qExC st e (fd 0 st id 2) ns ops nss locs;
        qExC st1 e (fd 0 st id 3) ns ops nss locs
      else if t == 14 then
        let st1 : St := if fd 0 st id 3 > 0 then qExC st e (fd 0 st id 3 - 1) ns ops nss locs else st;
        qExC st1 e (fd 0 st1 id 2) ns ops nss locs
      else if t == 26 then qExC st e (fd 0 st id 2) ns ops nss locs
      else if t == 27 then
        let tyId : Int := fd 0 st id 2;
        let st1 : St := if fd 0 st tyId 0 == 40 then qExC st e (fd 0 st tyId 2) ns ops nss locs else st;
        qExC st1 e (fd 0 st1 id 3) ns ops nss locs
      else if t == 5 || t == 10 || t == 12 || t == 31 || t == 33 || t == 42 then
        let st1 : St := qExC st e (fd 0 st id 1) ns ops nss locs;
        qExC st1 e (fd 0 st id 2) ns ops nss locs
      else if t == 6 then
        let st1 : St := qExC st e (fd 0 st id 2) ns ops nss locs;
        qExC st1 e (fd 0 st id 3) ns ops nss locs
      else if t == 8 then
        let st1 : St := qExC st e (fd 0 st id 1) ns ops nss locs;
        let st2 : St := qExC st1 e (fd 0 st id 2) ns ops nss locs;
        qExC st2 e (fd 0 st id 3) ns ops nss locs
      else if t == 7 then qExC st e (fd 0 st id 2) ns ops nss locs
      else if t == 11 || t == 13 || t == 17 || t == 18 || t == 23 || t == 25 || t == 28 || t == 29 || t == 44 || t == 47 || t == 30 then
        qExC st e (fd 0 st id 1) ns ops nss locs
      else if t == 34 || t == 36 then qExC st e (fd 0 st id 2) ns ops nss locs
      else st

def ckName : Nat -> St -> Env -> List Int -> Int -> Ans
  | 0, st, env, locs, id =>
    let na : Int := fd 0 st id 1;
    let nb : Int := fd 0 st id 2;
    if spanEq 0 st na nb "true" || spanEq 0 st na nb "false" then good 0 2
    else
      let loc : Int := findLocal st locs na nb;
      if loc >= 0 then good 0 loc
      else if fd 0 st id 3 != -9 && spanEq 0 st na nb "Nat.zero" && (findSigE st env na nb).ret == 0 then good 0 4
      else
        let pin : Bool := fd 0 st id 3 == -9;
        let p : Sig := if pin || ((spanEq 0 st na nb "max" || spanEq 0 st na nb "min" || spanEq 0 st na nb "Int.fmod" || spanEq 0 st na nb "decide" || spanEq 0 st na nb "String.singleton" || spanEq 0 st na nb "Nat.zero" || spanEq 0 st na nb "Nat.succ") && (findSigE st env na nb).ret != 0) then miss 0 else prim 0 st na nb;
        if p.ret != 0 then bad 0 7
        else
          let sg : Sig := if pin then miss 0 else findSigE st env na nb;
          if sg.ret != 0 then
            if lenI sg.ps == 0 then good 0 sg.ret
            else bad 0 5
          else
            let dot : Int := lastDot st na nb;
            if dot < 0 then bad 0 5
            else
              let locP : Int := findLocal st locs na dot;
              let sg2 : Sig := if locP >= 0 || pin then miss 0 else findSigE st env na dot;
              let pty : Int :=
                if locP >= 0 then locP
                else if sg2.ret >= 100 && sg2.ret < 1000 && lenI sg2.ps == 0 then sg2.ret
                else -1;
              if pty == 3 then
                let p2 : Sig := primStr 0 st (dot + 1) nb;
                if p2.ret == 0 then bad 0 5
                else if lenI p2.ps == 0 then good 0 p2.ret else bad 0 7
              else if pty == 1 then
                let p2 : Sig := primInt 0 st (dot + 1) nb;
                if p2.ret == 0 then bad 0 5
                else if lenI p2.ps == 0 then good 0 p2.ret else bad 0 7
              else if pty == 6 then
                let p2 : Sig := primCh 0 st (dot + 1) nb;
                if p2.ret == 0 then bad 0 5
                else if lenI p2.ps == 0 then good 0 p2.ret else bad 0 7
              else if pty == 4 || isWordTy pty then
                let p2 : Sig := primWordMethod st pty (dot + 1) nb;
                if p2.ret == 0 then bad 0 5 else good 0 p2.ret
              else if pty < 100 || pty >= 1000 then bad 0 5
              else
                let ft : Int := fieldTy 0 st env pty (dot + 1) nb;
                if ft < 0 then bad 0 5 else good 0 ft
  | n + 1, st, env, locs, id => ckName n st env locs id

def encUtf8 : Nat -> Int -> List Int
  | 0, cp =>
    if cp < 0 then []
    else if cp < 128 then [cp]
    else if cp < 2048 then
      let q0 : Int := cp / 64;
      [192 + q0, 128 + (cp - q0 * 64)]
    else if cp < 65536 then
      let q0 : Int := cp / 4096;
      let rem0 : Int := cp - q0 * 4096;
      let q1 : Int := rem0 / 64;
      [224 + q0, 128 + q1, 128 + (rem0 - q1 * 64)]
    else
      let q0 : Int := cp / 262144;
      let rem0 : Int := cp - q0 * 262144;
      let q1 : Int := rem0 / 4096;
      let rem1 : Int := rem0 - q1 * 4096;
      let q2 : Int := rem1 / 64;
      [240 + q0, 128 + q1, 128 + q2, 128 + (rem1 - q2 * 64)]
  | n + 1, cp => encUtf8 n cp

def escByte : Nat -> Int -> Int
  | 0, b =>
    if b == 110 then 10
    else if b == 116 then 9
    else if b == 114 then 13
    else if b == 92 then 92
    else if b == 34 then 34
    else -1
  | n + 1, b => escByte n b

partial def decSBytes : List Int -> List Int

  | [] => []
  | b0 :: rest =>
    if b0 == 92 then
      escByte 0 (hdB 0 rest) :: decSBytes (drop1 0 rest)
    else
      let cp : Int := utf8Cp 0 (b0 :: rest);
      let k : Nat := utf8Len 0 b0;
      encUtf8 0 cp ++ decSBytes (dropI (b0 :: rest) k)

partial def badSBytes : List Int -> Bool

  | [] => false
  | b0 :: rest =>
    if b0 == 92 then
      escByte 0 (hdB 0 rest) < 0 || badSBytes (drop1 0 rest)
    else
      let cp : Int := utf8Cp 0 (b0 :: rest);
      let k : Nat := utf8Len 0 b0;
      cp < 0 || k == 0 || badSBytes (dropI (b0 :: rest) k)

def decS : St -> Int -> Int -> List Int

  | st, i, e => decSBytes (spanBytes 0 st i e)

def badS : St -> Int -> Int -> Bool

  | st, i, e => badSBytes (spanBytes 0 st i e)

def callNamed : St -> Int -> String -> Bool

  | st, id, nm =>
    let f : Int := getFn st id;
      if fd 0 st f 0 != 1 then false
      else spanEq 0 st (fd 0 st f 1) (fd 0 st f 2) nm

partial def unwrapP : St -> Int -> Int

  | st, id =>
    if id < 0 then id
    else if fd 0 st id 0 == 13 || fd 0 st id 0 == 57 then unwrapP st (fd 0 st id 1) else id

def argAt : St -> Int -> Nat -> Int

  | st, id, i =>
    nthI (getArgs st id) i

-- String.mk (List.take k (List.drop start (Array.toList (List.toArray (String.toList s)))))
def mkSlice : St -> Int -> List Int

  | st, app =>
    if !(callNamed st app "String.mk") then [0]
    else
      let take : Int := unwrapP st (argAt st app 0);
      if !(callNamed st take "List.take") then [0]
      else
        let k : Int := unwrapP st (argAt st take 0);
        let drop : Int := unwrapP st (argAt st take 1);
        if !(callNamed st drop "List.drop") then [0]
        else
          let start : Int := unwrapP st (argAt st drop 0);
          let atl : Int := unwrapP st (argAt st drop 1);
          if !(callNamed st atl "Array.toList") then [0]
          else
            let lta : Int := unwrapP st (argAt st atl 0);
            if !(callNamed st lta "List.toArray") then [0]
            else
              let stl : Int := unwrapP st (argAt st lta 0);
              if !(callNamed st stl "String.toList") then [0]
              else [1, k, start, unwrapP st (argAt st stl 0)]

-- This slice admits only closed literal defaults. References, calls and
-- dependent defaults are refused even when every call supplies the argument.
-- No default can capture a binder at the call site or be evaluated twice.
partial def literalDefault : St -> Int -> Int

  | st, id =>
    if id < 0 then 0
    else
      let t : Int := fd 0 st id 0;
      if t == 2 || t == 3 then 0
      else if t == 1 then if spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "true" || spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "false" then 0 else 6
      else if t == 13 || t == 30 || t == 11 then literalDefault st (fd 0 st id 1)
      else if t == 7 then if fd 0 st id 1 == 1 then literalDefault st (fd 0 st id 2) else 6
      else if t == 12 || t == 42 then
        let err : Int := literalDefault st (fd 0 st id 1);
        if err != 0 then err else literalDefault st (fd 0 st id 2)
      else 6

mutual
partial def ckPat : St -> Env -> List Int -> Int -> Int -> Got

  | st, env, locs, id, exp =>
    if id < 0 || exp == 0 then { err := 6, xs := locs, ret := 0 : Got }
    else
      let t : Int := fd 0 st id 0;
      let fn : Int := getFn st (unwrapP st id);
      let ci : Int := if fd 0 st fn 0 == 1 then ctorNode st env.icts fn exp else -1;
      if t == 57 then
        if basicKind 0 exp != 4 then { err := 6, xs := locs, ret := 0 : Got }
        else ckPat st env locs (fd 0 st id 1) (listTy 0 (basicFirst 0 exp))
      else if ci >= 0 then
        let i : Nat := Int.toNat ci;
        let hi : Int := nthF 0 env.icts (i * 5 + 2);
        let ac : Nat := Int.toNat (nthF 0 env.icts (i * 5 + 3));
        let fa : Nat := Int.toNat (nthF 0 env.icts (i * 5 + 4));
        if exp != 30000 + hi then { err := 6, xs := locs, ret := 0 : Got }
        else ckCtorPats st env locs (getArgs st (unwrapP st id)) (takeI (dropI env.iargs fa) ac)
      else if findCtorB st env.icts 0 (spanBytes 0 st (fd 0 st fn 1) (fd 0 st fn 2)) >= 0 then { err := 6, xs := locs, ret := 0 : Got }
      else if natConstructorPatCode st id != 0 then
        if exp != 4 then { err := 6, xs := locs, ret := 0 : Got }
        else if natConstructorPatCode st id == 1 then { err := 0, xs := locs, ret := 0 : Got }
        else ckPat st env locs (nthF 0 (getArgs st id) 0) 4
      else if optionPatCode st id != 0 then
        if !(isOptionTy 0 exp) then { err := 6, xs := locs, ret := 0 : Got }
        else ckCtorPats st env locs (getArgs st (unwrapP st id))
          (if optionPatCode st id == 1 then [elemTy 0 exp] else [])
      else if t == 1 then
        if spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "true" || spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "false" then { err := if exp == 2 then 0 else 6, xs := locs, ret := 0 : Got }
        else if lastDot st (fd 0 st id 1) (fd 0 st id 2) >= 0 then { err := 6, xs := locs, ret := 0 : Got }
        else { err := 0, xs := fd 0 st id 1 :: fd 0 st id 2 :: exp :: locs, ret := 0 : Got }
      else if t == 4 then { err := 0, xs := locs, ret := 0 : Got }
      else if t == 2 then
        -- Lean 4.14 PatternVar.collect retains Char literals; parseChr stores
        -- their codepoint with a = b = -1. Reuse the existing literal test.
        if ((exp == 1 || exp == 4) && fd 0 st id 1 >= 0) ||
          (exp == 6 && fd 0 st id 1 == -1 && fd 0 st id 2 == -1) then
          { err := 0, xs := locs, ret := 0 : Got } else { err := 6, xs := locs, ret := 0 : Got }
      else if t == 7 && fd 0 st id 1 == 1 && fd 0 st (fd 0 st id 2) 0 == 2 && fd 0 st (fd 0 st id 2) 1 >= 0 then
        { err := if exp == 1 then 0 else 6, xs := locs, ret := 0 : Got }
      else if t == 13 then ckPat st env locs (fd 0 st id 1) exp
      else if t == 42 then
        if !(isProductTy 0 exp) then { err := 6, xs := locs, ret := 0 : Got }
        else
          let left : Got := ckPat st env locs (fd 0 st id 1) (productLeft 0 exp);
          if left.err != 0 then left else ckPat st env left.xs (fd 0 st id 2) (productRight 0 exp)
      else if t == 11 then
        if fd 0 st id 1 < 0 && isListTy 0 exp then { err := 0, xs := locs, ret := 0 : Got }
        else { err := 6, xs := locs, ret := 0 : Got }
      else if t == 6 && fd 0 st id 1 == 13 && isListTy 0 exp then
        let l : Got := ckPat st env locs (fd 0 st id 2) (elemTy 0 exp);
        if l.err != 0 then l else ckPat st env l.xs (fd 0 st id 3) exp
      else if t == 6 && fd 0 st id 1 == 1 && exp == 4 && fd 0 st (fd 0 st id 3) 0 == 2 && fd 0 st (fd 0 st id 3) 3 == 1 then
        ckPat st env locs (fd 0 st id 2) 4
      else if t == 14 && exp >= 100 && exp < 1000 && fd 0 st id 3 <= 0 then
        let ann : Int := fd 0 st id 1;
        if ann >= 0 && decTy st env.heads (-1) (-1) (-1) ann != exp then { err := 6, xs := locs, ret := 0 : Got }
        else
          let r : Got := ckPatFlds st env locs (fd 0 st id 2) exp [];
          let cnt : Int := nthF 0 env.heads (Int.toNat (exp - 100) * 4 + 2);
          if r.err != 0 then r
          else if fd 0 st id 3 == 0 && r.ret != cnt then { err := 6, xs := locs, ret := 0 : Got }
          else r
      else { err := 6, xs := locs, ret := 0 : Got }

partial def ckCtorPats : St -> Env -> List Int -> List Int -> List Int -> Got

  | _, _, locs, [], [] => { err := 0, xs := locs, ret := 0 : Got }
  | st, env, locs, p :: ps, t :: ts =>
    let one : Got := ckPat st env locs p t;
    if one.err != 0 then one else ckCtorPats st env one.xs ps ts
  | _, _, locs, _, _ => { err := 7, xs := locs, ret := 0 : Got }

partial def ckPatFlds : St -> Env -> List Int -> Int -> Int -> List Int -> Got

  | st, env, locs, fld, code, used =>
    if fld < 0 then { err := 0, xs := locs, ret := 0 : Got }
    else if fd 0 st fld 0 != 15 then { err := 6, xs := locs, ret := 0 : Got }
    else
      let nm : Int := fd 0 st fld 1;
      let na : Int := fd 0 st nm 1;
      let nb : Int := fd 0 st nm 2;
      if seen st used na nb then { err := 6, xs := locs, ret := 0 : Got }
      else
        let ty : Int := fieldTy 0 st env code na nb;
        if ty < 0 then { err := 5, xs := locs, ret := 0 : Got }
        else
          let one : Got := ckPat st env locs (fd 0 st fld 2) ty;
          if one.err != 0 then one
          else
            let rest : Got := ckPatFlds st env one.xs (fd 0 st fld 3) code (na :: nb :: used);
            { err := rest.err, xs := rest.xs, ret := rest.ret + 1 : Got }
end

def ckPats : St -> Env -> List Int -> Int -> List Int -> Got

  | st, env, locs, li, [] =>
    if li < 0 then { err := 0, xs := locs, ret := 0 : Got }
    else { err := 7, xs := locs, ret := 0 : Got }
  | st, env, locs, li, p :: ps =>
    if li < 0 then { err := 7, xs := locs, ret := 0 : Got }
    else
      let one : Got := ckPat st env locs (fd 0 st li 1) p;
      if one.err != 0 then one else ckPats st env one.xs (fd 0 st li 2) ps

def setNode : Nat -> St -> Int -> Int -> Int -> Int -> Int -> St
  | 0, st, id, t, a, b, c =>
    setNodeSlot (setNodeSlot (setNodeSlot (setNodeSlot st id 0 t) id 1 a) id 2 b) id 3 c
  | n + 1, st, id, t, a, b, c => setNode n st id t a b c

-- Anonymous patterns use the expected type's unique constructor. They become
-- the existing record / inductive patterns before checking and OBJECT-ABI
-- lowering. A type with multiple constructors has no anonymous choice.
def anonymousShape : List Int -> Int -> Int
  | heads, exp =>
    if exp >= 100 && exp < 1000 then
      let i : Nat := Int.toNat (exp - 100);
      if i < lenI heads / 4 && nthF 0 heads (i * 4 + 2) >= 0 then 1 else 0
    else if exp >= 30000 && exp < 31000 then
      let i : Nat := Int.toNat (exp - 30000);
      if i < lenI heads / 4 && nthF 0 heads (i * 4 + 2) == -2 then 2 else 0
    else 0

-- Field metadata is a structural list of triples, in declaration order.
-- The pattern spine must have exactly that many entries.
def anonymousFields : St -> Int -> List Int -> St
  | st, li, [] => if li < 0 then setRet 0 st (-1) else setErr 0 st 7
  | st, li, a :: b :: _ :: fields =>
    if st.err != 0 then st
    else if li < 0 || fd 0 st li 0 != 12 then setErr 0 st 7
    else
      let tail : St := anonymousFields st (fd 0 st li 2) fields;
      if tail.err != 0 then tail
      else
        let rest : Int := tail.ret;
        let name : St := alloc 0 tail 1 a b 0;
        alloc 0 name 15 name.ret (fd 0 st li 1) rest
  | st, _, _ => setErr 0 st 6

-- The type list is the constructor's semantic arity, not traversal fuel.
def anonymousCtorArgs : St -> Int -> List Int -> Int -> St
  | st, li, [], fn => if li < 0 then setRet 0 st fn else setErr 0 st 7
  | st, li, _ :: types, fn =>
    if st.err != 0 then st
    else if li < 0 || fd 0 st li 0 != 12 then setErr 0 st 7
    else
      let arg : St := alloc 0 st 12 (fd 0 st li 1) (-1) 0;
      let app : St := alloc 0 arg 5 fn arg.ret 0;
      anonymousCtorArgs app (fd 0 st li 2) types app.ret

-- Lean 4.14 elabAnonymousCtor: the expected type selects its only
-- constructor. Excess arguments nest into the last explicit field.
partial def anonymousExprElements : St -> Int -> List Int
  | st, li =>
    if li < 0 then []
    else fd 0 st li 1 :: anonymousExprElements st (fd 0 st li 2)

def anonymousExprFieldTypes : List Int -> List Int
  | _ :: _ :: ty :: rest => ty :: anonymousExprFieldTypes rest
  | _ => []

def anonymousExprTypes (e : Env) (exp : Int) : List Int :=
  let shape : Int := anonymousShape e.heads exp;
  if isProductTy 0 exp then [productLeft 0 exp, productRight 0 exp]
  else if shape == 1 then
    let i : Nat := Int.toNat (exp - 100);
    let cnt : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 2));
    let first : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 3));
    anonymousExprFieldTypes (takeI (dropI e.fields (first * 3)) (cnt * 3))
  else if shape == 2 then
    let hi : Nat := Int.toNat (exp - 30000);
    let ci : Int := nthF 0 e.heads (hi * 4 + 3);
    (ctorSig e.icts e.iargs ci).ps
  else []

def anonymousExprRepeated : Int -> List Int -> Bool
  | _, [] => false
  | ty, x :: xs => ty == x || anonymousExprRepeated ty xs

def anonymousExprRequest (e : Env) (exp : Int) (args seen : List Int) : Rsdc.AnonymousExprNF.Request :=
  let shape : Int := anonymousShape e.heads exp;
  let prod : Bool := isProductTy 0 exp;
  let i : Nat := Int.toNat (exp - 30000);
  let ind : Bool := exp >= 30000 && exp < 31000 && i < lenI e.heads / 4;
  let count : Int := if ind then nthF 0 e.heads (i * 4 + 2) else -1;
  { expectedKnown := exp > 0, inductiveType := prod || shape == 1 || (ind && count < 0),
    constructors := if prod || shape == 1 then 1 else Int.toNat (0 - 1 - count),
    explicitFields := lenI (anonymousExprTypes e exp), arguments := lenI args,
    repeated := anonymousExprRepeated exp seen : Rsdc.AnonymousExprNF.Request }

partial def anonymousExprLower (st : St) (e : Env) (id exp : Int) (seen : List Int) : St :=
  let args : List Int := anonymousExprElements st (fd 0 st id 1);
  let request : Rsdc.AnonymousExprNF.Request := anonymousExprRequest e exp args seen;
  if !(Rsdc.AnonymousExprNF.admit request 0) then setErr 0 st 6
  else
    let prepared : St :=
      if lenI args > request.explicitFields then
        let last : Nat := request.explicitFields - 1;
        let suffix : St := spine1 (setRet 0 st (-1)) 12 ((dropI args last).reverse);
        let nested : St := alloc 0 suffix 47 suffix.ret 0 0;
        let nestedId : Int := nested.ret;
        -- Only unary expansion retains the same argument sequence. A repeated
        -- expected type then repeats the identical elaboration problem.
        let lowered : St := anonymousExprLower nested e nestedId (nthF 0 (anonymousExprTypes e exp) last)
          (if request.explicitFields == 1 then exp :: seen else []);
        if lowered.err != 0 then lowered
        else spine1 (setRet 0 lowered (-1)) 12 ((takeI args last ++ [nestedId]).reverse)
      else setRet 0 st (fd 0 st id 1);
    if prepared.err != 0 then prepared
    else
      let li : Int := prepared.ret;
      if isProductTy 0 exp then
        let left : Int := fd 0 prepared li 1;
        let right : Int := fd 0 prepared (fd 0 prepared li 2) 1;
        setNode 0 prepared id 42 left right 0
      else if anonymousShape e.heads exp == 1 then
        let i : Nat := Int.toNat (exp - 100);
        let cnt : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 2));
        let first : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 3));
        let fields : List Int := takeI (dropI e.fields (first * 3)) (cnt * 3);
        let built : St := anonymousFields prepared li fields;
        if built.err != 0 then built else setNode 0 built id 14 (-1) built.ret 0
      else
        let hi : Nat := Int.toNat (exp - 30000);
        let ci : Int := nthF 0 e.heads (hi * 4 + 3);
        let sg : Sig := ctorSig e.icts e.iargs ci;
        let name : St := alloc 0 prepared 1 sg.a sg.b (-1000 - ci);
        let built : St := anonymousCtorArgs name li sg.ps name.ret;
        if built.err != 0 then built
        else
          let root : Int := built.ret;
          setNode 0 built id (fd 0 built root 0) (fd 0 built root 1) (fd 0 built root 2) (fd 0 built root 3)

mutual
partial def anonymousPattern : St -> Env -> Int -> Int -> Bool -> St
  | st, e, id, exp, origin =>
    if st.err != 0 || id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if origin && exp == 2 && t == 1 && (spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "true" || spanEq 0 st (fd 0 st id 1) (fd 0 st id 2) "false") then
        setNode 0 st id t (fd 0 st id 1) (fd 0 st id 2) (-47)
      else if t == 43 || (t == 5 && fd 0 st (getFn st id) 0 == 43) then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        let ci : Int := anonymousCtorIndex st e.icts fn exp;
        let sg : Sig := ctorSig e.icts e.iargs ci;
        let request : Rsdc.AnonymousCtorNF.Request :=
          { expectedType := exp, selected := ci, parameterCount := lenI sg.ps, argumentCount := lenI args,
            headTypeUnavailable := anonymousCtorHeadSeparated st id };
        if !(Rsdc.AnonymousCtorNF.admit request 0) then setErr 0 st 6
        else anonymousPattern (setNode 0 st fn 1 sg.a sg.b (-1000 - ci)) e id exp origin
      else if t == 47 then
        let shape : Int := anonymousShape e.heads exp;
        if shape == 1 then
          let i : Nat := Int.toNat (exp - 100);
          let cnt : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 2));
          let first : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 3));
          let fields : List Int := takeI (dropI e.fields (first * 3)) (cnt * 3);
          let built : St := anonymousFields st (fd 0 st id 1) fields;
          if built.err != 0 then built
          -- The otherwise unused record-pattern c slot records its origin.
          -- It enables typed cases' major binding without changing older
          -- named-record pattern images.
          else anonymousPattern (setNode 0 built id 14 (-1) built.ret (-47)) e id exp true
        else if shape == 2 then
          let hi : Nat := Int.toNat (exp - 30000);
          let ci : Nat := Int.toNat (nthF 0 e.heads (hi * 4 + 3));
          let ac : Nat := Int.toNat (nthF 0 e.icts (ci * 5 + 3));
          let first : Nat := Int.toNat (nthF 0 e.icts (ci * 5 + 4));
          let types : List Int := takeI (dropI e.iargs first) ac;
          let name : St := alloc 0 st 1 (nthF 0 e.icts (ci * 5)) (nthF 0 e.icts (ci * 5 + 1)) 0;
          let built : St := anonymousCtorArgs name (fd 0 st id 1) types name.ret;
          if built.err != 0 then built
          else
            let root : Int := built.ret;
            let rewritten : St := setNode 0 built id (fd 0 built root 0) (fd 0 built root 1) (fd 0 built root 2) (fd 0 built root 3);
            anonymousPattern rewritten e id exp true
        else setErr 0 st 6
      else if t == 42 && isProductTy 0 exp then
        let left : St := anonymousPattern st e (fd 0 st id 1) (productLeft 0 exp) origin;
        anonymousPattern left e (fd 0 st id 2) (productRight 0 exp) origin
      else if t == 13 then anonymousPattern st e (fd 0 st id 1) exp origin
      else if t == 14 && exp >= 100 && exp < 1000 then anonymousPatternFields st e (fd 0 st id 2) exp origin
      else if t == 6 && fd 0 st id 1 == 13 && isListTy 0 exp then
        let first : St := anonymousPattern st e (fd 0 st id 2) (elemTy 0 exp) origin;
        anonymousPattern first e (fd 0 st id 3) exp origin
      else if t == 6 && fd 0 st id 1 == 1 && exp == 4 then anonymousPattern st e (fd 0 st id 2) exp origin
      -- Builtin Option is not a source inductive in e.icts. Its some
      -- payload still supplies the expected family for nested dot/tuple patterns.
      else if optionPatCode st id == 1 && isOptionTy 0 exp then
        anonymousPatternApp st e id [elemTy 0 exp] origin
      else
        let fn : Int := getFn st id;
        let ci : Int := if fd 0 st fn 0 == 1 then ctorNode st e.icts fn exp else -1;
        if ci < 0 then st
        else
          let i : Nat := Int.toNat ci;
          let ac : Nat := Int.toNat (nthF 0 e.icts (i * 5 + 3));
          let first : Nat := Int.toNat (nthF 0 e.icts (i * 5 + 4));
          if exp != 30000 + nthF 0 e.icts (i * 5 + 2) || lenI (getArgs st id) != ac then st
          else anonymousPatternApp (setC 0 st fn (-1000 - ci)) e id (takeI (dropI e.iargs first) ac) origin

-- These cursors follow AST identifiers in the pool, so the mutually recursive
-- walk is partial and receives EMIT-FUEL's named refusal in emitted images.
partial def anonymousPatternFields : St -> Env -> Int -> Int -> Bool -> St
  | st, e, fld, exp, origin =>
    if st.err != 0 || fld < 0 || fd 0 st fld 0 != 15 then st
    else
      let nm : Int := fd 0 st fld 1;
      let ty : Int := fieldTy 0 st e exp (fd 0 st nm 1) (fd 0 st nm 2);
      let first : St := if ty > 0 then anonymousPattern st e (fd 0 st fld 2) ty origin else st;
      anonymousPatternFields first e (fd 0 st fld 3) exp origin

partial def anonymousPatternApp : St -> Env -> Int -> List Int -> Bool -> St
  | st, e, id, types, origin =>
    if st.err != 0 || id < 0 then st
    else if fd 0 st id 0 == 13 then anonymousPatternApp st e (fd 0 st id 1) types origin
    else if fd 0 st id 0 != 5 || lenI types == 0 then st
    else
      let n : Nat := lenI types - 1;
      let first : St := anonymousPatternApp st e (fd 0 st id 1) (takeI types n) origin;
      anonymousPattern first e (fd 0 st (fd 0 st id 2) 1) (nthF 0 types n) origin
end

def anonymousPats : St -> Env -> Int -> List Int -> St
  | st, _, _, [] => st
  | st, e, li, ty :: types =>
    if st.err != 0 || li < 0 then st
    else
      let first : St := anonymousPattern st e (fd 0 st li 1) ty false;
      anonymousPats first e (fd 0 st li 2) types

def hasName : St -> List Int -> Nat -> Int -> Int -> Bool

  | _, [], _, _, _ => false
  | st, a :: b :: c :: rest, k, na, nb =>
    if k == 0 then false
    else if a >= 0 && spanSame 0 st na nb a b then true
    else hasName st rest (k - 1) na nb
  | _, _, _, _, _ => false

def dupNames : St -> List Int -> Nat -> Bool

  | _, [], _ => false
  | st, a :: b :: c :: rest, k =>
    if k <= 1 then false
    else if a >= 0 && hasName st rest (k - 1) a b then true
    else dupNames st rest (k - 1)
  | _, _, _ => false

-- Type bound by a let: the declared type when annotated, else the value'st
-- own inferred type. tyN < 0 marks the unannotated `let x := e` form.
def pickTy : Nat -> Int -> Int -> Int -> Int
  | 0, tyN, vTy, ty => if tyN < 0 then vTy else ty
  | n + 1, tyN, vTy, ty => pickTy n tyN vTy ty

namespace StringAppendNF

structure Request where
  operand : Int

inductive Residue where
  | operandNotStringOrList

def residueName : Residue -> String
  | Residue.operandNotStringOrList => "nf_string_append_operand_not_string_or_list"

structure State where
  residue : Option Residue

def q (r : Request) : Request := r

def sigma (r : Request) : Request := r

def residue? (r : Request) : Option Residue :=
  if r.operand == 3 || isListTy 0 r.operand then none
  else some Residue.operandNotStringOrList

def admit (r : Request) : Bool := (residue? r).isNone

def step (r : Request) (_state : State) : State :=
  { residue := residue? (sigma r) : State }

end StringAppendNF

namespace ToStringNF

structure Request where
  operand : Int

inductive Residue where
  | operandNotNatOrInt

def residueName : Residue -> String
  | Residue.operandNotNatOrInt => "nf_to_string_operand_not_nat_or_int"

structure State where
  residue : Option Residue

def q (r : Request) : Request := r
def sigma (r : Request) : Request := r

def residue? (r : Request) : Option Residue :=
  if r.operand == 1 || r.operand == 4 then none
  else some Residue.operandNotNatOrInt

def admit (r : Request) : Bool := (residue? r).isNone
def step (r : Request) (_state : State) : State :=
  { residue := residue? (sigma r) : State }

end ToStringNF

-- Lean 4.14 String.split takes one Char -> Bool predicate and keeps empty
-- pieces, including the single empty piece of the empty input.
namespace StringSplitNF

structure Request where
  receiver : Int
  arguments : Nat
  predicateResult : Int

inductive Residue where
  | receiverNotString
  | argumentCount
  | predicateNotBool

def residueName : Residue -> String
  | Residue.receiverNotString => "nf_string_split_receiver_not_string"
  | Residue.argumentCount => "nf_string_split_argument_count"
  | Residue.predicateNotBool => "nf_string_split_predicate_not_bool"

structure State where
  residue : Option Residue

def q (r : Request) : Request := r
def sigma (r : Request) : Request := r

def residue? (r : Request) : Option Residue :=
  if r.receiver != 3 then some Residue.receiverNotString
  else if r.arguments != 1 then some Residue.argumentCount
  else if r.predicateResult != 2 then some Residue.predicateNotBool
  else none

def admit (r : Request) : Bool := (residue? r).isNone
def step (r : Request) (_state : State) : State :=
  { residue := residue? (sigma r) : State }

end StringSplitNF

-- Lean 4.14 List.replicate takes a Nat count and one element. The result
-- retains the element's contextual type, including typed empty lists.
namespace ListReplicateNF

structure Request where
  arguments : Nat
  countType : Int
  element : Int

inductive Residue where
  | argumentCount
  | countNotNat
  | elementUnavailable

def residueName : Residue -> String
  | Residue.argumentCount => "nf_list_replicate_argument_count"
  | Residue.countNotNat => "nf_list_replicate_count_not_nat"
  | Residue.elementUnavailable => "nf_list_replicate_element_unavailable"

structure State where
  residue : Option Residue

def q (r : Request) : Request := r
def sigma (r : Request) : Request := r

def residue? (r : Request) : Option Residue :=
  if r.arguments != 2 then some Residue.argumentCount
  else if r.countType != 4 then some Residue.countNotNat
  else if r.element <= 0 || r.element > 1000000000000000000 then some Residue.elementUnavailable
  else none

def admit (r : Request) : Bool := (residue? r).isNone
def step (r : Request) (_state : State) : State :=
  { residue := residue? (sigma r) : State }

end ListReplicateNF

-- Lean's ordinary let elaboration keeps overloaded numerals unsolved while
-- elaborating the body. Rigid values never enter this default-selection NF.
namespace LetContextNF

inductive Residue where
  | defaultUnavailable
  | contextShapeMismatch
  | constraintsDisagreed

def residueName : Residue -> String
  | Residue.defaultUnavailable => "nf_let_default_unavailable"
  | Residue.contextShapeMismatch => "nf_let_context_shape_mismatch"
  | Residue.constraintsDisagreed => "nf_let_constraints_disagreed"

structure Request where
  inferred : Int
  constraints : List Int

structure State where
  selected : Int
  residue : Option Residue

def q (r : Request) (_state : State) : Request := r
def sigma (_state : State) : State := { selected := 0, residue := none }

def sameShape : Nat -> Int -> Int -> Bool
  | 0, _, _ => false
  | n + 1, defaulted, wanted =>
    if defaulted == 4 then wanted == 1 || wanted == 4 || isWordTy wanted
    else if isListTy 0 defaulted && isListTy 0 wanted then
      sameShape n (elemTy 0 defaulted) (elemTy 0 wanted)
    else false

def selected (r : Request) : Int :=
  match r.constraints with
  | [] => r.inferred
  | wanted :: _ => wanted

def fitsUses (ty : Int) : List Int -> Bool
  | [] => true
  | wanted :: rest =>
    (wanted == ty || (ty == 4 && wanted == 1)) && fitsUses ty rest

def residue? (r : Request) (_state : State) : Option Residue :=
  if r.inferred <= 0 then some Residue.defaultUnavailable
  else if !(sameShape 64 r.inferred (selected r)) then some Residue.contextShapeMismatch
  else if !(fitsUses (selected r) r.constraints) then some Residue.constraintsDisagreed
  else none

def admit (r : Request) (state : State) : Bool := (residue? r (sigma state)).isNone

def step (r : Request) (state : State) : State :=
  { selected := selected (q r state), residue := residue? (q r state) (sigma state) }

end LetContextNF

-- Lean 4.14 List.beq compares matching spines and each pair of elements.
-- Admit only the element types whose existing typed equality is structural.
namespace ListEqualityNF

structure Request where
  operator : Int
  left : Int
  right : Int

inductive Residue where
  | operatorUnsupported
  | operandNotList
  | operandTypesDisagreed
  | elementUnavailable

def residueName : Residue -> String
  | Residue.operatorUnsupported => "nf_list_equality_operator_unsupported"
  | Residue.operandNotList => "nf_list_equality_operand_not_list"
  | Residue.operandTypesDisagreed => "nf_list_equality_operand_types_disagreed"
  | Residue.elementUnavailable => "nf_list_equality_element_unavailable"

structure State where
  residue : Option Residue

def q (r : Request) : Request := r
def sigma (r : Request) : Request := r

def listCode (ty : Int) : Bool :=
  ty >= 100000 && (ty - 100000) % 3 == 0

def elementAvailable : Nat -> Int -> Bool
  | 0, _ => false
  | n + 1, ty =>
    if ty == 1 || ty == 2 || ty == 3 || ty == 4 || ty == 6 || (ty >= 9 && ty <= 11) then true
    else if listCode ty then elementAvailable n ((ty - 100000) / 3)
    else false

def residue? (r : Request) : Option Residue :=
  if r.operator != 5 && r.operator != 6 then some Residue.operatorUnsupported
  else if !(listCode r.left) || !(listCode r.right) then some Residue.operandNotList
  else if r.left != r.right then some Residue.operandTypesDisagreed
  else if !(elementAvailable 64 ((r.left - 100000) / 3)) then some Residue.elementUnavailable
  else none

def admit (r : Request) : Bool := (residue? r).isNone

def step (r : Request) (_state : State) : State :=
  { residue := residue? (sigma (q r)) : State }

end ListEqualityNF

mutual
partial def ck : St -> Env -> List Int -> Int -> Int -> Ans

  | st, env, locs, id, exp =>
    if id < 0 then bad 0 6
    else
      let t : Int := fd 0 st id 0;
      let a : Int := fd 0 st id 1;
      let b : Int := fd 0 st id 2;
      if t == 33 then
        let r : Ans := ck st env locs a 0;
        if r.err != 0 then r
        else if !(isListTy 0 r.ty) && basicKind 0 r.ty != 4 then bad 0 6
        else
          let i : Ans := ck st env locs b 4;
          let elem : Int := if isListTy 0 r.ty then elemTy 0 r.ty else basicFirst 0 r.ty;
          if i.err != 0 then i else fit exp (good 0 (optionTy 0 elem))
      else if t == 29 then ckMethod st env locs id [] exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 29 then
        ckMethod st env locs (getFn st id) (getArgs st id) exp
      else if t == 1 && fd 0 st id 3 != -9 && findLocal st locs a b < 0 && findCtorB st env.icts 0 (spanBytes 0 st a b) >= 0 then
        ckCtorCall st env locs id [] exp
      else if t == 1 && fd 0 st id 3 != -9 && dataKnown 0 st a b && findLocal st locs a b < 0 && (findSigE st env a b).ret == 0 then
        ckDataCall st env locs a b [] exp
      else if t == 1 && optionName 0 st a b == 2 && findLocal st locs a b < 0 then
        let sg : Sig := findSigE st env a b;
        if sg.ret != 0 then ckBase st env locs id exp
        else if isOptionTy 0 exp then good 0 exp else bad 0 6
      else if t == 5 then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        let fa : Int := fd 0 st fn 1;
        let fb : Int := fd 0 st fn 2;
        let sg : Sig := findSigE st env fa fb;
        if fd 0 st fn 0 == 1 && fd 0 st fn 3 != -9 && findLocal st locs fa fb < 0 && findCtorB st env.icts 0 (spanBytes 0 st fa fb) >= 0 then
          ckCtorCall st env locs fn args exp
        else if fd 0 st fn 0 == 1 && fd 0 st fn 3 != -9 && dataKnown 0 st fa fb && findLocal st locs fa fb < 0 && sg.ret == 0 then
          ckDataCall st env locs fa fb args exp
        else if fd 0 st fn 0 == 1 && optionName 0 st fa fb == 1 && findLocal st locs fa fb < 0 && sg.ret == 0 then
          if lenI args != 1 then bad 0 7
          else
            let r : Ans := ck st env locs (nthF 0 args 0) (if isOptionTy 0 exp then elemTy 0 exp else 0);
            if r.err != 0 then r else fit exp (good 0 (optionTy 0 r.ty))
        else ckBase st env locs id exp
      else ckBase st env locs id exp

partial def ckCtorCandidates : St -> Env -> List Int -> Int -> List Int -> Nat -> Int -> Int
  | st, env, locs, fn, args, j, hit =>
    if j >= lenI env.icts / 5 then hit
    else
      let sg : Sig := ctorSig env.icts env.iargs (Int.ofNat j);
      if spanSame 0 st (fd 0 st fn 1) (fd 0 st fn 2) sg.a sg.b && (ckArgs st env locs args sg.ps).err == 0 then
        if hit >= 0 then -2 else ckCtorCandidates st env locs fn args (j + 1) (Int.ofNat j)
      else ckCtorCandidates st env locs fn args (j + 1) hit

partial def ckCtorIndex : St -> Env -> List Int -> Int -> List Int -> Int -> Int
  | st, env, locs, fn, args, exp =>
    let ci : Int := ctorNode st env.icts fn exp;
    if ci != -2 || exp != 0 || fd 0 st fn 3 <= -1000 then ci
    else ckCtorCandidates st env locs fn args 0 (-1)

partial def ckCtorCall : St -> Env -> List Int -> Int -> List Int -> Int -> Ans
  | st, env, locs, fn, args, exp =>
    let ci : Int := ckCtorIndex st env locs fn args exp;
    if ci < 0 then bad 0 6
    else
      let sg : Sig := ctorSig env.icts env.iargs ci;
      let r : Ans := ckArgs st env locs args sg.ps;
      if r.err != 0 then r else fit exp (good 0 sg.ret)

partial def ckDataCall : St -> Env -> List Int -> Int -> Int -> List Int -> Int -> Ans
  | st, env, locs, a, b, args, exp =>
    let first : Ans := if lenI args == 0 then good 0 0 else ck st env locs (nthF 0 args 0) 0;
    let sg : Sig := dataSig 0 st a b (if first.err == 0 then first.ty else 0) exp (lenI args);
    if sg.ret <= 0 then bad 0 6
    else
      let r : Ans := ckArgs st env locs args sg.ps;
      if r.err != 0 then r else fit exp (good 0 sg.ret)

partial def ckMethod : St -> Env -> List Int -> Int -> List Int -> Int -> Ans

  | st, env, locs, id, args, exp =>
    let r : Ans := ck st env locs (fd 0 st id 1) 0;
    if r.err != 0 then r
    else
      let a : Int := fd 0 st id 2;
      let b : Int := fd 0 st id 3;
      let ds : Sig := dataMethod 0 st r.ty a b;
      let op : Int := containerOp 0 st r.ty a b;
      if ds.ret != 0 then
        let v : Ans := ckArgs st env locs args ds.ps;
        if v.err != 0 then v else fit exp (good 0 ds.ret)
      else if op == 35 then
        if lenI args != 1 then bad 0 7
        else
          let otherExp : Int := if isListTy 0 exp && isProductTy 0 (elemTy 0 exp) then listTy 0 (productRight 0 (elemTy 0 exp)) else 0;
          let other : Ans := ck st env locs (nthF 0 args 0) otherExp;
          if other.err != 0 then other
          else if !(isListTy 0 other.ty) then bad 0 6
          else
            let pair : Int := productTy 0 (elemTy 0 r.ty) (elemTy 0 other.ty);
            if pair <= 0 then bad 0 6 else fit exp (good 0 (listTy 0 pair))
      else if (op >= 20 && op <= 24) || op == 30 || op == 34 then ckHof st env locs r.ty op args exp
      else
        let sg : Sig :=
          if op != 0 then containerSig 0 op r.ty
          else if r.ty == 3 then primStr 0 st a b
          else if r.ty == 1 then primInt 0 st a b
          else if r.ty == 6 then primCh 0 st a b
          else if r.ty == 4 || isWordTy r.ty then primWordMethod st r.ty a b
          else
            let ft : Int := fieldTy 0 st env r.ty a b;
            if ft > 0 then { a := a, b := b, ret := ft, ps := [] : Sig } else miss 0;
        if sg.ret == 0 then bad 0 5
        -- Match the existing equality subset. Arena handles are not structural BEq.
        else if op == 26 && !((elemTy 0 r.ty >= 1 && elemTy 0 r.ty <= 4) || elemTy 0 r.ty == 6) then bad 0 6
        else if op == 0 && r.ty == 3 && lenI args != 0 then bad 0 6
        else
          let v : Ans := ckArgs st env locs args sg.ps;
          if v.err != 0 then v else fit exp (good 0 sg.ret)

partial def ckHof : St -> Env -> List Int -> Int -> Int -> List Int -> Int -> Ans

  | st, env, locs, ty, op, args, exp =>
    if lenI args != (if op == 24 then 2 else 1) then bad 0 7
    else
      let e : Int := if op == 30 then 6 else elemTy 0 ty;
      let init : Ans := if op == 24 then ck st env locs (nthF 0 args 1) exp else good 0 0;
      if init.err != 0 then init
      else
        let ret : Int := if op == 22 then (if isListTy 0 exp then elemTy 0 exp else 0) else if op == 34 then (if isListTy 0 exp then exp else 0) else if op == 24 then init.ty else 2;
        let cb : Ans := ckCallback st env locs (nthF 0 args 0) (if op == 24 then [init.ty, e] else [e]) ret;
        if cb.err != 0 then cb
        else if op == 34 && !(isListTy 0 cb.ty) then bad 0 6
        else if op == 30 then
          let gate : StringSplitNF.State := StringSplitNF.step { receiver := ty, arguments := lenI args, predicateResult := cb.ty } { residue := none };
          if gate.residue.isSome then bad 0 6 else fit exp (good 0 (listTy 0 3))
        else fit exp (good 0 (if op == 22 then listTy 0 cb.ty else if op == 23 then ty else cb.ty))

partial def ckCallback : St -> Env -> List Int -> Int -> List Int -> Int -> Ans

  | st, env, locs, raw, ps, ret =>
    let id : Int := unwrapP st raw;
    if fd 0 st id 0 == 32 then
      let binds : Got := lambdaLocs (lambdaDecls st env.heads (fd 0 st id 1)) ps;
      if binds.err != 0 then bad 0 binds.err
      else ck st env (binds.xs ++ locs) (fd 0 st id 2) ret
    else if fd 0 st id 0 == 1 && findLocal st locs (fd 0 st id 1) (fd 0 st id 2) < 0 then
      let sg : Sig := callbackSig st env (fd 0 st id 1) (fd 0 st id 2);
      if sg.ret == 0 then bad 0 5
      else if !(eqListI sg.ps ps) then bad 0 6
      else fit ret (good 0 sg.ret)
    else bad 0 6

partial def ckArgs : St -> Env -> List Int -> List Int -> List Int -> Ans

  | st, env, locs, [], [] =>
    good 0 0
  | st, env, locs, [], _ :: _ =>
    bad 0 7
  | st, env, locs, _ :: _, [] =>
    bad 0 7
  | st, env, locs, arg :: rest, p :: ps =>
    let aA : Ans := ck st env locs arg p;
      if aA.err != 0 then aA else ckArgs st env locs rest ps

partial def ckBase : St -> Env -> List Int -> Int -> Int -> Ans

  | st, env, locs, id, exp =>
    if id < 0 then bad 0 6
    else
      let t : Int := fd 0 st id 0;
      let a : Int := fd 0 st id 1;
      let b : Int := fd 0 st id 2;
      let c : Int := fd 0 st id 3;
      if t == 13 then ck st env locs a exp
      else if t == 42 then
        if exp != 0 && !(isProductTy 0 exp) then bad 0 6
        else
          let l : Ans := ck st env locs a (if exp == 0 then 0 else productLeft 0 exp);
          if l.err != 0 then l
          else
            let r : Ans := ck st env locs b (if exp == 0 then 0 else productRight 0 exp);
            if r.err != 0 then r
            else
              let ty : Int := productTy 0 l.ty r.ty;
              if ty < 0 then bad 0 6 else fit exp (good 0 ty)
      else if t == 17 then
        let r : Ans := ck st env locs a 0;
        if r.err != 0 then r
        else if !(isProductTy 0 r.ty) || (b != 1 && b != 2) then bad 0 6
        else fit exp (good 0 (if b == 1 then productLeft 0 r.ty else productRight 0 r.ty))
      else if t == 1 then fit exp (ckName 0 st env locs id)
      else if t == 2 then
        -- Lean 4.14 Init/Prelude: Char literals have a < 0; no OfNat Char.
        if a < 0 then
          if exp == 0 || exp == 6 then good 0 6 else bad 0 6
        else if exp == 0 || exp == 4 then good 0 4
        else if exp == 1 then good 0 1
        else if isWordTy exp then good 0 exp
        -- Lean 4.14 Init/Data/String/Basic.lean:17-18: only OfNat Pos 0.
        else if exp == 5 && lenI (numeralMagnitude st id) == 0 then good 0 5
        else bad 0 6
      else if t == 3 then
        if badS st (a + 1) (b - 1) then bad 0 6
        else if exp == 0 || exp == 3 then good 0 3 else bad 0 6
      else if t == 31 then ckTermMatch st env locs a b exp
      else if t == 8 then ckIf st env locs a b c exp
      else if t == 9 then ckLet st env locs a b c exp
      else if t == 5 then ckCall st env locs id exp
      else if t == 6 then ckBin st env locs a b c exp
      else if t == 7 then ckUna st env locs a b exp
      else if t == 11 then ckList st env locs a exp
      else if t == 14 then if c < 0 then bad 0 6 else ckInst st env locs a b exp
      else if t == 29 then
        let rA : Ans := ck st env locs a 0;
        if rA.err != 0 then rA
        else
          let m : Sig := if rA.ty == 3 then primStr 0 st b c else if rA.ty == 1 then primInt 0 st b c else if rA.ty == 6 then primCh 0 st b c else primWordMethod st rA.ty b c;
          if m.ret == 0 then bad 0 5 else fit exp (good 0 m.ret)
      else if t == 30 then
        let ty : Int := decTy st env.heads (-1) (-1) (-1) b;
        if ty < 0 then bad 0 (if ty == -1 then 5 else 6)
        else
          let rA : Ans := ck st env locs a ty;
          if rA.err != 0 then rA
          else if rA.ty == ty then fit exp (good 0 ty)
          else if rA.ty == 4 && ty == 1 then fit exp (good 0 1)
          else bad 0 6
      else bad 0 6

-- A later branch can determine an otherwise unavailable nondependent result
-- type. Each candidate comes from that branch's pattern scope; all alternatives
-- must then check at the candidate type, including unreachable branch bodies.
partial def ckTermResultCandidates : St -> Env -> List Int -> Int -> Int -> List Int -> Ans

  | st, env, locs, all, alt, pts =>
    if alt < 0 || fd 0 st alt 0 != 24 then bad 0 6
    else
      let got : Got := ckPats st env locs (fd 0 st alt 1) pts;
      if got.err != 0 then bad 0 got.err
      else
        let added : Nat := (lenI got.xs - lenI locs) / 3;
        if dupNames st got.xs added then bad 0 10
        else
          let candidate : Ans := ck st env got.xs (fd 0 st alt 2) 0;
          let checked : Ans :=
            if candidate.err == 0 && candidate.ty > 0 then
              ckTermAlts st env locs all pts candidate.ty
            else bad 0 6;
          let request : Rsdc.MatchResultNF.Request :=
            { candidateError := candidate.err, candidateType := candidate.ty,
              validationError := checked.err, validationType := checked.ty };
          if Rsdc.MatchResultNF.admit request 0 then checked
          else ckTermResultCandidates st env locs all (fd 0 st alt 3) pts

partial def ckTermMatch : St -> Env -> List Int -> Int -> Int -> Int -> Ans

  | st, env, locs, scruts, alts, exp =>
    let pts : Got := ckScruts st env locs scruts;
    if pts.err != 0 then bad 0 pts.err
    else if alts < 0 || lenI pts.xs == 0 then bad 0 6
    else
      let first : Ans := ckTermAlts st env locs alts pts.xs exp;
      if first.err == 6 && exp == 0 then
        let intAlt : Ans := ckTermAlts st env locs alts pts.xs 1;
        if intAlt.err == 0 then intAlt
        else
          let inferred : Ans := ckTermResultCandidates st env locs alts alts pts.xs;
          if inferred.err == 0 then inferred else first
      else first

partial def ckScruts : St -> Env -> List Int -> Int -> Got

  | st, env, locs, li =>
    if li < 0 then { err := 0, xs := [], ret := 0 : Got }
    else
      let one : Ans := ck st env locs (fd 0 st li 1) 0;
      if one.err != 0 then { err := one.err, xs := [], ret := 0 : Got }
      else
        let rest : Got := ckScruts st env locs (fd 0 st li 2);
        { err := rest.err, xs := one.ty :: rest.xs, ret := 0 : Got }

partial def ckTermAlts : St -> Env -> List Int -> Int -> List Int -> Int -> Ans

  | st, env, locs, alt, pts, ret =>
    if alt < 0 then if ret > 0 then good 0 ret else bad 0 6
    else if fd 0 st alt 0 != 24 then bad 0 6
    else
      let got : Got := ckPats st env locs (fd 0 st alt 1) pts;
      if got.err != 0 then bad 0 got.err
      else
        let added : Nat := (lenI got.xs - lenI locs) / 3;
        if dupNames st got.xs added then bad 0 10
        else
          let body : Ans := ck st env got.xs (fd 0 st alt 2) ret;
          if body.err != 0 then body
          else ckTermAlts st env locs (fd 0 st alt 3) pts body.ty

-- Lean 4.14 Extra.lean analyze/applyCoe/toExpr (255-472) and
-- BuiltinTerm.lean elabNumLit (177-203): retain shared numeric context
-- before defaulting. This no-coercion Nat/Int-list specialization retries
-- ordinary checking; rigid locals/ascriptions cannot change their type.
-- Each retry adds O(L+R) AST work; nested prefixes may total O(S^2).
partial def ckIf : St -> Env -> List Int -> Int -> Int -> Int -> Int -> Ans

  | st, env, locs, cnd, th, el, exp =>
    let cA : Ans := ck st env locs cnd 2;
      if cA.err != 0 then cA
      else
        let tA : Ans := ck st env locs th exp;
        if tA.err != 0 then
          -- Lean's ite has one shared result type. An unconstrained first
          -- branch (for example []) may need the other branch to supply it.
          -- Recheck the complete conditional at that type, including a dead
          -- branch; an explicit expected type never enters this fallback.
          if tA.err == 6 && exp == 0 then
            let candidate : Ans := ck st env locs el 0;
            let checked : Ans :=
              if candidate.err == 0 && candidate.ty > 0 then
                ckIf st env locs cnd th el candidate.ty
              else bad 0 6;
            let request : Rsdc.MatchResultNF.Request :=
              { candidateError := candidate.err, candidateType := candidate.ty,
                validationError := checked.err, validationType := checked.ty };
            if Rsdc.MatchResultNF.admit request 0 then checked else tA
          else tA
        else
          let use : Int := if exp == 0 then tA.ty else exp;
          let eA : Ans := ck st env locs el use;
          if eA.err == 0 then
            if tA.ty != eA.ty then bad 0 6 else fit exp tA
          else if exp == 0 && (tA.ty == 4 || tA.ty == listTy 0 4) then
            let eB : Ans := ck st env locs el 0;
            if eB.err != 0 || (tA.ty == listTy 0 4 && eB.ty != listTy 0 1) then eA
            else
              let tB : Ans := ck st env locs th eB.ty;
              if tB.err != 0 then eA
              else if tB.ty != eB.ty then bad 0 6
              else fit exp tB
          else eA

partial def ckLet : St -> Env -> List Int -> Int -> Int -> Int -> Int -> Ans

  | st, env, locs, name, tyN, rest, exp =>
    let ty : Int := if tyN < 0 then 0 else decTy st env.heads (-1) (-1) (-1) tyN;
      if ty < 0 then bad 0 (if ty == -1 then 5 else 6)
      else
        let vA : Ans := ck st env locs (fd 0 st rest 1) ty;
        if vA.err != 0 then vA
        else
          let tyR : Int := pickTy 0 tyN vA.ty ty;
          let locs2 : List Int := fd 0 st name 1 :: fd 0 st name 2 :: tyR :: locs;
          ck st env locs2 (fd 0 st rest 2) exp

-- With no expected result, keep the concrete Int context of either operand.
-- ckArgs still checks both operands at the selected type.
partial def numericChoiceTy (st : St) (e : Env) (locs args : List Int) (exp : Int) : Int :=
  if exp == 1 || exp == 4 then exp
  else
    let left : Ans := ck st e locs (nthF 0 args 0) 0;
    if left.err == 0 && left.ty == 1 then 1
    else
      let right : Ans := ck st e locs (nthF 0 args 1) 0;
      if right.err == 0 && right.ty == 1 then 1 else 4

partial def ckCall : St -> Env -> List Int -> Int -> Int -> Ans

  | st, env, locs, id, exp =>
    let fn : Int := getFn st id;
      let args : List Int := getArgs st id;
      if fd 0 st fn 0 != 1 then bad 0 6
      else
        let na : Int := fd 0 st fn 1;
        let nb : Int := fd 0 st fn 2;
        if spanEq 0 st na nb "true" || spanEq 0 st na nb "false" then bad 0 6
        else if findLocal st locs na nb >= 0 then bad 0 6
        else
          let pin : Bool := fd 0 st fn 3 == -9;
          let p : Sig := if pin || ((spanEq 0 st na nb "max" || spanEq 0 st na nb "min" || spanEq 0 st na nb "Int.fmod" || spanEq 0 st na nb "decide" || spanEq 0 st na nb "String.singleton" || spanEq 0 st na nb "Nat.zero" || spanEq 0 st na nb "Nat.succ") && (findSigE st env na nb).ret != 0) then miss 0 else prim 0 st na nb;
          let sg : Sig := if pin then miss 0 else if p.ret != 0 then p else findSigE st env na nb;
          let p2 : Sig :=
            if sg.ret != 0 then miss 0
            else
              let dot : Int := lastDot st na nb;
              let pty : Int := if dot < 0 then -1 else findLocal st locs na dot;
              if pty == 3 then primStr 0 st (dot + 1) nb
              else if pty == 1 then primInt 0 st (dot + 1) nb
              else if pty == 6 then primCh 0 st (dot + 1) nb
              else primWordMethod st pty (dot + 1) nb;
          let recv : Bool := sg.ret == 0 && p2.ret != 0;
          let fin : Sig := if recv then p2 else sg;
          if fin.ret == 0 then bad 0 5
          else if p.ret != 0 && (spanEq 0 st na nb "max" || spanEq 0 st na nb "min") then
            if lenI args != 2 then bad 0 7
            else
              let use : Int := numericChoiceTy st env locs args exp;
              let checked : Ans := ckArgs st env locs args [use, use];
              if checked.err != 0 then checked else fit exp (good 0 use)
          else if !recv && spanEq 0 st na nb "List.replicate" then
            if lenI args != 2 then bad 0 7
            else
              let use : Int := if isListTy 0 exp then exp else fd 0 st id 3;
              let count : Ans := ck st env locs (nthI args 0) 4;
              if count.err != 0 then count
              else
                let value : Ans := ck st env locs (nthI args 1) (if isListTy 0 use then elemTy 0 use else 0);
                if value.err != 0 then value
                else
                  let gate : ListReplicateNF.State := ListReplicateNF.step { arguments := lenI args, countType := count.ty, element := value.ty } { residue := none };
                  if gate.residue.isSome then bad 0 6 else fit exp (good 0 (listTy 0 value.ty))
          else if !recv && (spanEq 0 st na nb "toString" || spanEq 0 st na nb "ToString.toString") then
            if lenI args != 1 then bad 0 7
            else
              let aA : Ans := ck st env locs (nthI args 0) 0;
              if aA.err != 0 then aA
              else
                let gate : ToStringNF.State := ToStringNF.step { operand := aA.ty } { residue := none };
                if gate.residue.isSome then bad 0 6 else fit exp (good 0 3)
          else if !recv && spanEq 0 st na nb "String.mk" then
            let trip : List Int := mkSlice st id;
            if nthI trip 0 != 1 then
              let aA : Ans := ckArgs st env locs args [100018];
              if aA.err != 0 then aA else fit exp (good 0 3)
            else
              let kA : Ans := ck st env locs (nthI trip 1) 4;
              if kA.err != 0 then kA
              else
                let aA : Ans := ck st env locs (nthI trip 2) 4;
                if aA.err != 0 then aA
                else
                  let sA : Ans := ck st env locs (nthI trip 3) 3;
                  if sA.err != 0 then sA else fit exp (good 0 3)
          else if !recv && (spanEq 0 st na nb "List.toArray" || spanEq 0 st na nb "Array.toList" || spanEq 0 st na nb "List.take" || spanEq 0 st na nb "List.drop") then bad 0 5
          else
            let ps : List Int := fin.ps;
            let r : Ans := ckArgs st env locs args ps;
            if r.err != 0 then r else fit exp (good 0 fin.ret)

partial def ckBin : St -> Env -> List Int -> Int -> Int -> Int -> Int -> Ans

  | st, env, locs, op0, l, r, exp =>
    let op : Int := op0 % 100;
    let hint : Int := op0 / 100;
    if op == 11 || op == 12 then
      let lA : Ans := ck st env locs l 2;
      if lA.err != 0 then lA
      else
        let rA : Ans := ck st env locs r 2;
        if rA.err != 0 then rA else fit exp (good 0 2)
    else if (op >= 5 && op <= 10) || (op >= 16 && op <= 18) then
      let o2 : Int := if op == 16 then 6 else if op == 17 then 9 else if op == 18 then 10 else op;
      let lA : Ans := ck st env locs l (if isWordTy hint then hint else 0);
      if lA.err != 0 then lA
      else
        let rA : Ans := ck st env locs r lA.ty;
        if rA.err == 0 then
          if lA.ty != rA.ty then bad 0 6
          else if o2 <= 6 && ((lA.ty >= 1 && lA.ty <= 6) || isWordTy lA.ty) then fit exp (good 0 2)
          else if o2 <= 6 && ListEqualityNF.admit { operator := o2, left := lA.ty, right := rA.ty } then fit exp (good 0 2)
          else if o2 >= 7 && (lA.ty == 1 || lA.ty == 4 || lA.ty == 5 || lA.ty == 6 || isWordTy lA.ty) then fit exp (good 0 2)
          else bad 0 6
        else if lA.ty == 4 then
          let rB : Ans := ck st env locs r 0;
          if rB.err != 0 then rA
          else
            let lB : Ans := ck st env locs l rB.ty;
            if lB.err != 0 then lB
            else if o2 <= 6 && ((lB.ty >= 1 && lB.ty <= 6) || isWordTy lB.ty) then fit exp (good 0 2)
            else if o2 >= 7 && (lB.ty == 1 || lB.ty == 4 || lB.ty == 5 || lB.ty == 6 || isWordTy lB.ty) then fit exp (good 0 2)
            else bad 0 6
        else rA
    else if (op >= 1 && op <= 4) || op == 15 || (op >= 19 && op <= 23) then
      let want : Int := if isWordTy hint then hint else if isWordTy exp then exp else if exp == 5 then 5 else if exp == 4 then 4 else if exp == 1 then 1 else 0;
      let lA : Ans := ck st env locs l want;
      if lA.err != 0 then lA
      else if lA.ty == 5 then
        if op != 1 && op != 2 then bad 0 6
        else
          let rA : Ans := ck st env locs r 5;
          if rA.err == 0 then fit exp (good 0 5)
          else if op == 1 then
            let rB : Ans := ck st env locs r 0;
            if rB.err != 0 then rB
            else if rB.ty == 3 || rB.ty == 6 then fit exp (good 0 5) else bad 0 6
          else rA
      else if isWordTy lA.ty && !(wordBinAllowed lA.ty op) then bad 0 15
      else if !(isWordTy lA.ty) && lA.ty != 4 && op >= 19 then bad 0 15
      else if lA.ty != 1 && lA.ty != 4 && !(isWordTy lA.ty) then bad 0 6
      else
        let rA : Ans := ck st env locs r lA.ty;
        if rA.err == 0 then
          if op >= 19 && !(isWordTy lA.ty) then bad 0 15 else fit exp (good 0 lA.ty)
        else if want == 0 && lA.ty == 4 then
          let rB : Ans := ck st env locs r 0;
          if rB.err != 0 then rA
          else
            let lB : Ans := ck st env locs l rB.ty;
            if lB.err != 0 then lB
            else if isWordTy lB.ty && !(wordBinAllowed lB.ty op) then bad 0 15
            -- Pos zero may inherit the right Pos type only for add/sub.
            else if lB.ty == 1 || lB.ty == 4 || isWordTy lB.ty || (lB.ty == 5 && (op == 1 || op == 2)) then fit exp (good 0 lB.ty)
            else bad 0 6
        else rA
    else if op == 13 then
      if isListTy 0 exp then
        let lA : Ans := ck st env locs l (elemTy 0 exp);
        if lA.err != 0 then lA
        else
          let rA : Ans := ck st env locs r exp;
          if rA.err != 0 then rA else fit exp (good 0 exp)
      else if exp == 0 then
        let rA : Ans := ck st env locs r 0;
        if rA.err != 0 then rA
        else if !(isListTy 0 rA.ty) then bad 0 6
        else
          let lA : Ans := ck st env locs l (elemTy 0 rA.ty);
          if lA.err != 0 then lA else good 0 rA.ty
      else bad 0 6
    else if op == 14 then
      let want : Int := if exp == 3 || isListTy 0 exp then exp else 0;
      let lA : Ans := ck st env locs l want;
      if lA.err != 0 then lA
      else
        let request : StringAppendNF.Request := { operand := lA.ty : StringAppendNF.Request };
        let gate : StringAppendNF.State := StringAppendNF.step request { residue := none : StringAppendNF.State };
        if gate.residue.isSome then bad 0 6
        else
          let rA : Ans := ck st env locs r lA.ty;
          if rA.err == 0 then fit exp (good 0 lA.ty)
          else if exp == 0 && lA.ty == listTy 0 4 then
            let rB : Ans := ck st env locs r 0;
            if rB.err != 0 || rB.ty != listTy 0 1 then rA
            else
              let lB : Ans := ck st env locs l rB.ty;
              if lB.err != 0 then rA else fit exp (good 0 rB.ty)
          else rA
    else bad 0 6

partial def ckUna : St -> Env -> List Int -> Int -> Int -> Int -> Ans

  | st, env, locs, op0, e, exp =>
    let op : Int := op0 % 100;
    if op == 3 then
      let want : Int := if isWordTy (op0 / 100) then op0 / 100 else if isWordTy exp then exp else 0;
      let aA : Ans := ck st env locs e want;
      if aA.err != 0 then aA
      else if isWordTy aA.ty then fit exp (good 0 aA.ty) else bad 0 15
    else if op == 2 then
      let aA : Ans := ck st env locs e 2;
      if aA.err != 0 then aA else fit exp (good 0 2)
    else if op == 1 then
      let aA : Ans := ck st env locs e 1;
      if aA.err != 0 then aA
      else if aA.ty != 1 then bad 0 6
      else fit exp (good 0 1)
    else bad 0 6

partial def ckList : St -> Env -> List Int -> Int -> Int -> Ans

  | st, env, locs, li, exp =>
    if li < 0 then
      if isListTy 0 exp then good 0 exp else bad 0 6
    else if isListTy 0 exp then
      let r : Ans := ckElems st env locs li (elemTy 0 exp);
      if r.err != 0 then r else good 0 exp
    else if exp == 0 then
      let aA : Ans := ck st env locs (fd 0 st li 1) 0;
      if aA.err != 0 then aA
      else
        let r : Ans := ckElems st env locs (fd 0 st li 2) aA.ty;
        if r.err != 0 then r else good 0 (listTy 0 aA.ty)
    else bad 0 6

partial def ckElems : St -> Env -> List Int -> Int -> Int -> Ans

  | st, env, locs, li, elem =>
    if li < 0 then good 0 0
    else
      let aA : Ans := ck st env locs (fd 0 st li 1) elem;
      if aA.err != 0 then aA else ckElems st env locs (fd 0 st li 2) elem

partial def ckInst : St -> Env -> List Int -> Int -> Int -> Int -> Ans

  | st, env, locs, tyN, fld, exp =>
    let ty : Int := if tyN < 0 then exp else decTy st env.heads (-1) (-1) (-1) tyN;
      if ty < 0 then bad 0 (if ty == -1 then 5 else 6)
      else if ty < 100 || ty >= 1000 then bad 0 6
      else
        let r : Ans := ckFlds st env locs fld ty [];
        if r.err != 0 then r
        else
          let i : Nat := Int.toNat (ty - 100);
          let nf : Int := nthF 0 env.heads (i * 4 + 2);
          if r.ty != nf then bad 0 6 else fit exp (good 0 ty)

partial def ckFlds : St -> Env -> List Int -> Int -> Int -> List Int -> Ans

  | st, env, locs, fld, code, used =>
    if fld < 0 then good 0 0
    else if fd 0 st fld 0 != 15 then bad 0 6
    else
      let nm : Int := fd 0 st fld 1;
      let na : Int := fd 0 st nm 1;
      let nb : Int := fd 0 st nm 2;
      let count : Nat := Int.toNat (nthF 0 env.heads (Int.toNat (code - 100) * 4 + 2));
      if seen st used na nb then bad 0 6
      else
        let ft : Int := fieldTy 0 st env code na nb;
        if ft < 0 then bad 0 5
        else
          let aA : Ans := ck st env locs (fd 0 st fld 2) ft;
          if aA.err != 0 then aA
          else
            let r : Ans := ckFlds st env locs (fd 0 st fld 3) code (na :: nb :: used);
            if r.err != 0 then r else good 0 (r.ty + 1)
end

partial def ckAlts : St -> Env -> List Int -> Int -> List Int -> Int -> Int

  | st, env, locs, alt, pts, ret =>
    if alt < 0 then 0
    else if fd 0 st alt 0 != 24 then 6
    else
      let got : Got := ckPats st env locs (fd 0 st alt 1) pts;
      if got.err != 0 then got.err
      else
        let added : Nat := (lenI got.xs - lenI locs) / 3;
        if dupNames st got.xs added then 10
        else
          let body : Ans := ck st env got.xs (fd 0 st alt 2) ret;
          if body.err != 0 then body.err else ckAlts st env locs (fd 0 st alt 3) pts ret

partial def ckDefDefaults : St -> Env -> Int -> Int

  | st, env, grp =>
    if grp < 0 then 0
    else
      let tyN : Int := fd 0 st grp 2;
      let literal : Int := if fd 0 st tyN 0 == 40 then literalDefault st (fd 0 st tyN 2) else 0;
      let err : Int :=
        if fd 0 st tyN 0 != 40 then 0
        else if literal != 0 then literal
        else
          let ty : Int := decTy st env.heads (-1) (-1) (-1) tyN;
          if ty < 0 then 6 else (ck st env [] (fd 0 st tyN 2) ty).err;
      if err != 0 then err else ckDefDefaults st env (fd 0 st grp 3)

-- Hint binders name a prefix of the arguments following the explicit header,
-- as in Lean's TerminationBy.checkVars. Holes consume a parameter but do not
-- introduce a local. Recursion is structural on the declaration list.
def terminationLocs : St -> List Int -> List Int -> Got
  | _, [], _ => { err := 0, xs := [], ret := 0 : Got }
  | st, a :: b :: _ :: rest, p :: ps =>
    let r : Got := terminationLocs st rest ps;
    { err := r.err, xs := if spanEq 0 st a b "_" then r.xs else r.xs ++ [a, b, p], ret := 0 : Got }
  | _, _, _ => { err := 7, xs := [], ret := 0 : Got }

-- Metadata is not a runtime expression. Its identifiers must still resolve;
-- stock Lean's exact-file receipt supplies typing and well-foundedness. sizeOf
-- is Lean's compile-time measure primitive, not a new runtime builtin.
partial def terminationResolved : St -> Env -> List Int -> Int -> Int
  | st, env, locs, id =>
    if id < 0 then 0
    else
      let t : Int := fd 0 st id 0;
      let a : Int := fd 0 st id 1;
      let b : Int := fd 0 st id 2;
      let c : Int := fd 0 st id 3;
      if t == 1 then
        if findLocal st locs a b >= 0 || (prim 0 st a b).ret != 0 || (findSigE st env a b).ret != 0 || spanEq 0 st a b "sizeOf" then 0
        else (ckName 0 st env locs id).err
      else if t == 2 || t == 3 || t == 4 then 0
      else if t == 5 || t == 12 || t == 42 then
        let err : Int := terminationResolved st env locs a;
        if err != 0 then err else terminationResolved st env locs b
      else if t == 6 then
        let err : Int := terminationResolved st env locs b;
        if err != 0 then err else terminationResolved st env locs c
      else if t == 8 then
        let err : Int := terminationResolved st env locs a;
        let err2 : Int := if err != 0 then err else terminationResolved st env locs b;
        if err2 != 0 then err2 else terminationResolved st env locs c
      else if t == 7 then terminationResolved st env locs b
      else if t == 11 || t == 13 || t == 17 || t == 29 then terminationResolved st env locs a
      else if t == 30 then
        let ty : Int := decTy st env.heads (-1) (-1) (-1) b;
        if ty < 0 then 5 else terminationResolved st env locs a
      else 6

def ckTermination : St -> Env -> List Int -> List Int -> Int -> Int
  | st, env, locs, extras, body =>
    if fd 0 st body 2 <= 0 then 0
    else
      let meta : Int := fd 0 st body 2 - 1;
      let hints : Got := terminationLocs st (lambdaNames st (fd 0 st meta 1) 0) extras;
      if hints.err != 0 then hints.err
      else if dupNames st hints.xs (lenI hints.xs / 3) then 10
      else terminationResolved st env (hints.xs ++ locs) (fd 0 st meta 2)

def ckOne : St -> Env -> Int -> Int

  | st, env, id =>
    let sig : Int := fd 0 st id 2;
      let locsA : Got := bindLocs st env.heads (fd 0 st sig 1);
      let defaults : Int := ckDefDefaults st env (fd 0 st sig 1);
      if defaults != 0 then defaults
      else if locsA.err != 0 then locsA.err
      else
        let bt : List Int := tysOf locsA.xs;
        let ar : Got := takeArrows st env.heads bt (fd 0 st sig 2);
        if ar.err != 0 then ar.err
        else
          let body : Int := fd 0 st id 3;
          let btN : Nat := lenI bt;
          let hintErr : Int := ckTermination st env locsA.xs (dropI ar.xs btN) body;
          if hintErr != 0 then hintErr
          else if fd 0 st body 0 == 25 then
            if lenI ar.xs != btN then 7
            else
              let ans : Ans := ck st env locsA.xs (fd 0 st body 1) ar.ret;
              ans.err
          else if fd 0 st body 0 == 23 then
            ckAlts st env locsA.xs (fd 0 st body 1) (dropI ar.xs btN) ar.ret
          else 6

-- Pair the existing first-error check with its diagnostic position so a
-- refusal does not require replaying the checker through nested groups.
-- Meijer, Fokkinga and Paterson, FPCA 1991, section 4: tupling/fusion.
partial def ckFileResult : St -> Env -> Int -> Ans

  | st, env, id =>
    if id < 0 then { err := 0, ty := -1 : Ans }
    else if fd 0 st id 0 != 19 then { err := 6, ty := -1 : Ans }
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let result : Ans :=
        if t == 20 then
          let e : Int := ckOne st env d;
          { err := e, ty := if e == 0 then -1 else instancePosition st (fd 0 st (fd 0 st d 1) 1) : Ans }
        else if t == 28 then ckFileResult st env (fd 0 st d 1)
        else if t == 34 || t == 36 then ckFileResult st env (fd 0 st d 2)
        else if t == 26 || t == 35 || t == 37 || t == 38 then { err := 0, ty := -1 : Ans }
        else { err := 6, ty := instancePosition st (fd 0 st (fd 0 st d 1) 1) : Ans };
      if result.err != 0 then result else ckFileResult st env (fd 0 st id 2)

partial def ckFile : St -> Env -> Int -> Int
  | st, env, id => (ckFileResult st env id).err

structure DataSpec where
  template : Int
  args : List Int
  name : Int
  node : Int
  deriving Inhabited

structure DataMono where
  st : St
  templates : List Int
  specs : List DataSpec
  deriving Inhabited

def dataSpecCount : List DataSpec -> Nat
  | [] => 0
  | _ :: rest => 1 + dataSpecCount rest

def dataMonoSt (m : DataMono) (st : St) : DataMono :=
  { st := st, templates := m.templates, specs := m.specs : DataMono }

partial def dataTemplates : St -> Int -> List Int
  | st, top =>
    if top < 0 then []
    else
      let d : Int := fd 0 st top 1;
      let t : Int := fd 0 st d 0;
      let here : List Int :=
        if (t == 26 || t == 38) && fd 0 st d 3 > 0 then [d]
        else if t == 28 then dataTemplates st (fd 0 st d 1)
        else if t == 34 || t == 36 then dataTemplates st (fd 0 st d 2)
        else [];
      here ++ dataTemplates st (fd 0 st top 2)

def dataTemplate : St -> List Int -> Int -> Int
  | _, [], _ => -1
  | st, d :: ds, name =>
    let qs : List Int := qsp 0 st (fd 0 st d 1);
    if spanSame 0 st (nthI qs 0) (nthI qs 1) (fd 0 st name 1) (fd 0 st name 2) then d
    else dataTemplate st ds name

def dataSourceName (st : St) (name : Int) : List Int :=
  let qs : List Int := qsp 0 st name;
  spanBytes 0 st (nthI qs 0) (nthI qs 1)

partial def dataSourceCtors : St -> Int -> List (List Int)
  | st, li =>
    if li < 0 then []
    else dataSourceName st (fd 0 st (fd 0 st li 1) 1) :: dataSourceCtors st (fd 0 st li 2)

partial def dataSourceFields : St -> Int -> List Int -> List (List Int)
  | st, li, family =>
    if li < 0 then []
    else joinDot 0 family (dataSourceName st (fd 0 st li 1)) :: dataSourceFields st (fd 0 st li 3) family

-- Reserve source names before unused templates disappear and instance keys
-- replace family names. Constructors and record projections also occupy the
-- declaration namespace, even when no concrete instance is requested.
partial def dataSourceNames : St -> Int -> List (List Int)
  | st, top =>
    if top < 0 then []
    else
      let d : Int := fd 0 st top 1;
      let t : Int := fd 0 st d 0;
      let here : List (List Int) :=
        if t == 20 || t == 26 || t == 37 || t == 38 then
          let family : List Int := dataSourceName st (fd 0 st d 1);
          family :: (if t == 38 then dataSourceCtors st (fd 0 st d 2)
            else if t == 26 then joinDot 0 family [109, 107] :: dataSourceFields st (fd 0 st d 2) family
            else [])
        else if t == 28 then dataSourceNames st (fd 0 st d 1)
        else if t == 34 || t == 36 then dataSourceNames st (fd 0 st d 2)
        else [];
      here ++ dataSourceNames st (fd 0 st top 2)

def dataSourceNamesUnique : List (List Int) -> Bool
  | [] => true
  | name :: rest => !(inBss rest name) && dataSourceNamesUnique rest

mutual
-- Validate recursive occurrences while distinct source parameters still
-- exist. A single concrete probe cannot distinguish a parameter permutation.
partial def dataUniformType : St -> Int -> Int -> Bool
  | st, d, id =>
    if id < 0 then true
    else
      let t : Int := fd 0 st id 0;
      if t == 1 || t == 5 then
        let head : Int := dataTypeHead st id;
        let args : List Int := dataTypeArgs st id;
        let own : Bool := fd 0 st head 3 != -55 && dataTemplate st [d] head >= 0;
        (!own || dataSameParams st args (fd 0 st d 3 - 1)) &&
          dataUniformTypes st d args
      else if t == 13 || t == 40 then dataUniformType st d (fd 0 st id 1)
      else if t == 12 || t == 16 || t == 41 then
        dataUniformType st d (fd 0 st id 1) && dataUniformType st d (fd 0 st id 2)
      else if t == 39 then dataUniformType st d (fd 0 st id 2)
      else if t == 27 then dataUniformType st d (fd 0 st id 2) && dataUniformType st d (fd 0 st id 3)
      else true

partial def dataUniformTypes : St -> Int -> List Int -> Bool
  | _, _, [] => true
  | st, d, id :: rest => dataUniformType st d id && dataUniformTypes st d rest
end

def dataUniformTemplates : St -> List Int -> Bool
  | _, [] => true
  | st, d :: rest => dataUniformType st d (fd 0 st d 2) && dataUniformTemplates st rest

partial def dataTypeUnwrap : St -> Int -> Int
  | st, id =>
    if id >= 0 && (fd 0 st id 0 == 13 || fd 0 st id 0 == 40) then dataTypeUnwrap st (fd 0 st id 1)
    else id

def dataProductArgs (st : St) (id : Int) : List Int :=
  if fd 0 st id 0 == 41 then [fd 0 st id 1, fd 0 st id 2]
  else if fd 0 st id 0 != 5 then []
  else
    let fn : Int := getFn st id;
    let args : List Int := getArgs st id;
    if fd 0 st fn 0 == 1 && spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "Prod" && lenI args == 2 then args
    else []

mutual
partial def dataSameType : St -> Int -> Int -> Bool
  | st, left, right =>
    let l : Int := dataTypeUnwrap st left;
    let r : Int := dataTypeUnwrap st right;
    let lp : List Int := dataProductArgs st l;
    let rp : List Int := dataProductArgs st r;
    if l == r then true
    else if lenI lp > 0 || lenI rp > 0 then dataSameTypes st lp rp
    else if fd 0 st l 0 != fd 0 st r 0 then false
    else if fd 0 st l 0 == 1 then spanSame 0 st (fd 0 st l 1) (fd 0 st l 2) (fd 0 st r 1) (fd 0 st r 2)
    else if fd 0 st l 0 == 5 then
      dataSameType st (getFn st l) (getFn st r) && dataSameTypes st (getArgs st l) (getArgs st r)
    else if fd 0 st l 0 == 16 then dataSameType st (fd 0 st l 1) (fd 0 st r 1) && dataSameType st (fd 0 st l 2) (fd 0 st r 2)
    else false

partial def dataSameTypes : St -> List Int -> List Int -> Bool
  | _, [], [] => true
  | st, a :: rest, b :: tail => dataSameType st a b && dataSameTypes st rest tail
  | _, _, _ => false
end

def dataFindSpec : St -> List DataSpec -> Int -> List Int -> Int
  | _, [], _, _ => -1
  | st, s :: rest, d, args =>
    if s.template == d && dataSameTypes st s.args args then s.name
    else dataFindSpec st rest d args

def dataGrowing : List DataSpec -> Int -> Bool
  | [], _ => false
  | s :: rest, d => (s.template == d && s.node < 0) || dataGrowing rest d

def dataFinishSpec : List DataSpec -> Int -> Int -> List DataSpec
  | [], _, _ => []
  | s :: rest, name, node =>
    if s.name == name then { template := s.template, args := s.args, name := s.name, node := node : DataSpec } :: rest
    else s :: dataFinishSpec rest name node

def dataParamArg : St -> Int -> List Int -> Int -> Int
  | _, _, [], _ => -1
  | st, li, a :: args, id =>
    if li < 0 then -1
    else
      let p : Int := fd 0 st li 1;
      if spanSame 0 st (fd 0 st p 1) (fd 0 st p 2) (fd 0 st id 1) (fd 0 st id 2) then a
      else dataParamArg st (fd 0 st li 2) args id

-- Clone type trees before substituting; two specializations must never mutate
-- one another's argument nodes. A default term needs a separate value pass.
partial def dataCopyType : St -> Int -> Int -> List Int -> St
  | st, id, params, args =>
    if st.err != 0 || id < 0 then setRet 0 st id
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        let arg : Int := if fd 0 st id 3 == -55 then dataParamArg st params args id else -1;
        if arg >= 0 then dataCopyType st arg (-1) []
        else if fd 0 st id 3 == -55 then setErr 0 st 6
        else alloc 0 st 1 (fd 0 st id 1) (fd 0 st id 2) 0
      else if t == 40 then setErr 0 st 6
      else if t == 13 then
        let a : St := dataCopyType st (fd 0 st id 1) params args;
        alloc 0 a 13 a.ret 0 0
      else if t == 5 || t == 12 || t == 16 || t == 41 then
        let a : St := dataCopyType st (fd 0 st id 1) params args;
        let left : Int := a.ret;
        let b : St := dataCopyType a (fd 0 st id 2) params args;
        alloc 0 b t left b.ret 0
      else setErr 0 st 6

mutual
-- Instance discovery follows arena links and may revisit recursive heads.
-- Memoization closes regular recursive datatypes. A growing specialization
-- cycle is an unsupported type, not a truncated worklist or a second ABI.
partial def dataMonoType : DataMono -> Int -> DataMono
  | m, id =>
    let st : St := m.st;
    if st.err != 0 || id < 0 then m
    else
      let t : Int := fd 0 st id 0;
      if t == 13 || t == 40 then dataMonoType m (fd 0 st id 1)
      else if t == 16 || t == 41 then
        let a : DataMono := dataMonoType m (fd 0 st id 1);
        dataMonoType a (fd 0 a.st id 2)
      else if t == 1 then
        if dataTemplate st m.templates id >= 0 then dataMonoSt m (setErr 0 st 6) else m
      else if t != 5 then m
      else
        let args : List Int := getArgs st id;
        let a : DataMono := dataMonoTypes m args;
        let d : Int := dataTemplate a.st a.templates (getFn a.st id);
        if (a.st).err != 0 || d < 0 then a
        else if lenI args != liCount a.st (fd 0 a.st d 3 - 1) then dataMonoSt a (setErr 0 a.st 7)
        else
          let old : Int := dataFindSpec a.st a.specs d args;
          let b : DataMono := if old >= 0 then dataMonoSt a (setRet 0 a.st old) else dataMonoInstance a d args;
          let name : Int := (b.st).ret;
          if (b.st).err != 0 then b
          else dataMonoSt b (setNode 0 b.st id 1 (fd 0 b.st name 1) (fd 0 b.st name 2) 0)

partial def dataMonoTypes : DataMono -> List Int -> DataMono
  | m, [] => m
  | m, id :: rest => dataMonoTypes (dataMonoType m id) rest

partial def dataMonoInstance : DataMono -> Int -> List Int -> DataMono
  | m, d, args =>
    if dataGrowing m.specs d then dataMonoSt m (setErr 0 m.st 6)
    else
      let qs : List Int := qsp 0 m.st (fd 0 m.st d 1);
      let fresh : St := synthIdent 0 m.st (spanBytes 0 m.st (nthI qs 0) (nthI qs 1) ++ [36, 112] ++ natBytes (Int.toNat d) ++ [36] ++ natBytes (dataSpecCount m.specs));
      let name : Int := fresh.ret;
      let pending : DataSpec := { template := d, args := args, name := name, node := -1 : DataSpec };
      let a : DataMono := { st := fresh, templates := m.templates, specs := m.specs ++ [pending] : DataMono };
      let params : Int := fd 0 fresh d 3 - 1;
      let body : DataMono :=
        if fd 0 fresh d 0 == 26 then dataMonoFields a (fd 0 fresh d 2) params args
        else dataMonoCtors a (fd 0 fresh d 2) params args;
      if (body.st).err != 0 then body
      else
        let built : St := alloc 0 body.st (fd 0 fresh d 0) name (body.st).ret 0;
        { st := setRet 0 built name, templates := body.templates, specs := dataFinishSpec body.specs name built.ret : DataMono }

partial def dataMonoFields : DataMono -> Int -> Int -> List Int -> DataMono
  | m, fld, params, args =>
    if (m.st).err != 0 || fld < 0 then dataMonoSt m (setRet 0 m.st (-1))
    else
      let copied : St := dataCopyType m.st (fd 0 m.st fld 2) params args;
      let ty : Int := copied.ret;
      let a : DataMono := dataMonoType (dataMonoSt m copied) ty;
      let tail : DataMono := dataMonoFields a (fd 0 m.st fld 3) params args;
      dataMonoSt tail (alloc 0 tail.st 27 (fd 0 m.st fld 1) ty (tail.st).ret)

partial def dataMonoArgLis : DataMono -> Int -> Int -> List Int -> DataMono
  | m, li, params, args =>
    if (m.st).err != 0 || li < 0 then dataMonoSt m (setRet 0 m.st (-1))
    else
      let copied : St := dataCopyType m.st (fd 0 m.st li 1) params args;
      let ty : Int := copied.ret;
      let a : DataMono := dataMonoType (dataMonoSt m copied) ty;
      let tail : DataMono := dataMonoArgLis a (fd 0 m.st li 2) params args;
      dataMonoSt tail (alloc 0 tail.st 12 ty (tail.st).ret 0)

partial def dataMonoCtors : DataMono -> Int -> Int -> List Int -> DataMono
  | m, li, params, args =>
    if (m.st).err != 0 || li < 0 then dataMonoSt m (setRet 0 m.st (-1))
    else
      let ctor : Int := fd 0 m.st li 1;
      let a : DataMono := dataMonoArgLis m (fd 0 m.st ctor 2) params args;
      let built : St := alloc 0 a.st 39 (fd 0 m.st ctor 1) (a.st).ret 0;
      let node : Int := built.ret;
      let tail : DataMono := dataMonoCtors (dataMonoSt a built) (fd 0 m.st li 2) params args;
      dataMonoSt tail (alloc 0 tail.st 12 node (tail.st).ret 0)

-- Visit every runtime type annotation; generic declaration bodies are copied
-- only when a concrete application requests them.
partial def dataMonoWalk : DataMono -> Int -> DataMono
  | m, id =>
    let st : St := m.st;
    if st.err != 0 || id < 0 then m
    else
      let t : Int := fd 0 st id 0;
      if (t == 26 || t == 38) && fd 0 st id 3 > 0 then m
      else if t == 21 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 1);
        dataMonoType a (fd 0 st id 2)
      else if t == 22 || t == 27 then
        let a : DataMono := dataMonoType m (fd 0 st id 2);
        let b : DataMono := if fd 0 st (fd 0 st id 2) 0 == 40 then dataMonoWalk a (fd 0 st (fd 0 st id 2) 2) else a;
        dataMonoWalk b (fd 0 st id 3)
      else if t == 37 then dataMonoType m (fd 0 st id 2)
      else if t == 9 then
        let a : DataMono := dataMonoType m (fd 0 st id 2);
        dataMonoWalk a (fd 0 st id 3)
      else if t == 14 then
        let a : DataMono := dataMonoType m (fd 0 st id 1);
        let b : DataMono := if fd 0 st id 3 > 0 then dataMonoWalk a (fd 0 st id 3 - 1) else a;
        dataMonoWalk b (fd 0 st id 2)
      else if t == 30 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 1);
        dataMonoType a (fd 0 st id 2)
      else if t == 19 || t == 20 || t == 32 || t == 5 || t == 10 || t == 12 || t == 31 || t == 33 || t == 42 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 1);
        let b : DataMono := dataMonoWalk a (fd 0 st id 2);
        if t == 20 then dataMonoWalk b (fd 0 st id 3) else b
      else if t == 15 || t == 6 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 2);
        dataMonoWalk a (fd 0 st id 3)
      else if t == 8 || t == 24 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 1);
        let b : DataMono := dataMonoWalk a (fd 0 st id 2);
        dataMonoWalk b (fd 0 st id 3)
      else if t == 7 then dataMonoWalk m (fd 0 st id 2)
      else if t == 23 || t == 25 then
        let a : DataMono := dataMonoWalk m (fd 0 st id 1);
        if fd 0 st id 2 > 0 then dataMonoWalk a (fd 0 st (fd 0 st id 2 - 1) 2) else a
      else if t == 11 || t == 13 || t == 17 || t == 18 || t == 28 || t == 29 || t == 44 || t == 47 then dataMonoWalk m (fd 0 st id 1)
      else if t == 26 || t == 34 || t == 36 then dataMonoWalk m (fd 0 st id 2)
      else if t == 38 then dataMonoCtorTypes m (fd 0 st id 2)
      else m

partial def dataMonoCtorTypes : DataMono -> Int -> DataMono
  | m, li =>
    if (m.st).err != 0 || li < 0 then m
    else
      let a : DataMono := dataMonoTypeLis m (fd 0 m.st (fd 0 m.st li 1) 2);
      dataMonoCtorTypes a (fd 0 m.st li 2)

partial def dataMonoTypeLis : DataMono -> Int -> DataMono
  | m, li =>
    if (m.st).err != 0 || li < 0 then m
    else
      let a : DataMono := dataMonoType m (fd 0 m.st li 1);
      dataMonoTypeLis a (fd 0 m.st li 2)
end

partial def dataProbeArgs : St -> Int -> Int -> List Int
  | st, li, arg =>
    if li < 0 then [] else arg :: dataProbeArgs st (fd 0 st li 2) arg

def dataProbeTemplates : DataMono -> List Int -> Int -> DataMono
  | m, [], _ => m
  | m, d :: rest, arg =>
    if (m.st).err != 0 then m
    else
      let args : List Int := dataProbeArgs m.st (fd 0 m.st d 3 - 1) arg;
      let old : Int := dataFindSpec m.st m.specs d args;
      let one : DataMono := if old >= 0 then m else dataMonoInstance m d args;
      dataProbeTemplates one rest arg

def dataSpecCommands : St -> List DataSpec -> Int -> St
  | st, [], _ => setRet 0 st (-1)
  | st, s :: rest, d =>
    let tail : St := dataSpecCommands st rest d;
    if s.template == d then alloc 0 tail 19 s.node tail.ret 0 else tail

partial def dataInstall : St -> Int -> List DataSpec -> St
  | st, top, specs =>
    if st.err != 0 || top < 0 then st
    else
      let d : Int := fd 0 st top 1;
      let t : Int := fd 0 st d 0;
      let a : St :=
        if (t == 26 || t == 38) && fd 0 st d 3 > 0 then
          let body : St := dataSpecCommands st specs d;
          let meta : St := alloc 0 body t (fd 0 st d 1) (fd 0 st d 2) (fd 0 st d 3);
          setNode 0 meta d 28 body.ret (meta.ret + 1) 0
        else if t == 28 then dataInstall st (fd 0 st d 1) specs
        else if t == 34 || t == 36 then dataInstall st (fd 0 st d 2) specs
        else st;
      dataInstall a (fd 0 st top 2) specs

def specializeData (st : St) (top : Int) : St :=
  let templates : List Int := dataTemplates st top;
  if lenI templates == 0 then st
  else if !(dataSourceNamesUnique (dataSourceNames st top)) || !(dataUniformTemplates st templates) then setErr 0 st 6
  else
    let m : DataMono := dataMonoWalk { st := st, templates := templates, specs := [] : DataMono } top;
    if (m.st).err != 0 then m.st
    else
      -- Check every template, including unused ones. These temporary Int
      -- instances never enter the emitted declaration spine.
      let arg : St := synthIdent 0 m.st [73, 110, 116];
      let probes : DataMono := dataProbeTemplates (dataMonoSt m arg) templates arg.ret;
      let checked : St := dataInstall probes.st top probes.specs;
      let heads : Env := walk checked 0 top (emptyEnv 0);
      let fields : Env := walk checked 1 top heads;
      if checked.err != 0 then setErr 0 m.st checked.err
      else if fields.err != 0 then setErr 0 m.st (Int.toNat fields.err)
      else dataInstall m.st top m.specs

partial def findStructFlds : St -> Int -> Int -> Int -> Int

  | st, id, sa, sb =>
    if id < 0 then -1
    else if fd 0 st id 0 != 19 then -1
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      if t == 26 then
        let qs : List Int := qsp 0 st (fd 0 st d 1);
        if spanSame 0 st (nthI qs 0) (nthI qs 1) sa sb then fd 0 st d 2
        else findStructFlds st (fd 0 st id 2) sa sb
      else if t == 28 then
        let r : Int := findStructFlds st (fd 0 st d 1) sa sb;
        if r >= 0 then r else findStructFlds st (fd 0 st id 2) sa sb
      else if t == 34 || t == 36 then
        let r : Int := findStructFlds st (fd 0 st d 2) sa sb;
        if r >= 0 then r else findStructFlds st (fd 0 st id 2) sa sb
      else findStructFlds st (fd 0 st id 2) sa sb

partial def validInstFlds : St -> Env -> Int -> Int -> Bool

  | st, e, code, chain =>
    if chain < 0 then true
    else if fd 0 st chain 0 != 15 then false
    else
      let nm : Int := fd 0 st chain 1;
      if fieldTy 0 st e code (fd 0 st nm 1) (fd 0 st nm 2) < 0 then false
      else validInstFlds st e code (fd 0 st chain 3)

partial def inferStructByFlds : St -> Env -> Nat -> Int -> Int -> Int

  | st, e, si, chain, hit =>
    if si >= lenI e.heads / 4 then hit
    else
      let cnt : Int := nthF 0 e.heads (si * 4 + 2);
      if cnt > 0 && validInstFlds st e (100 + Int.ofNat si) chain then
        if hit >= 0 then -2 else inferStructByFlds st e (si + 1) chain (100 + Int.ofNat si)
      else inferStructByFlds st e (si + 1) chain hit

partial def findLit : St -> Int -> Int -> Int -> Int

  | st, chain, na, nb =>
    if chain < 0 then -1
    else if fd 0 st chain 0 != 15 then -1
    else
      let nm : Int := fd 0 st chain 1;
      if spanSame 0 st na nb (fd 0 st nm 1) (fd 0 st nm 2) then fd 0 st chain 2
      else findLit st (fd 0 st chain 3) na nb

partial def fillDefaultFlds : St -> Int -> Int -> St

  | st, fdecl, chain =>
    if fdecl < 0 then setRet 0 st chain
    else if fd 0 st fdecl 0 != 27 then setRet 0 st chain
    else
      let nm : Int := fd 0 st fdecl 1;
      let na : Int := fd 0 st nm 1;
      let nb : Int := fd 0 st nm 2;
      let tyId : Int := fd 0 st fdecl 2;
      let st1 : St := fillDefaultFlds st (fd 0 st fdecl 3) chain;
      let curChain : Int := st1.ret;
      if findLit st1 curChain na nb >= 0 then st1
      else if fd 0 st1 tyId 0 == 40 then
        alloc 0 st1 15 nm (fd 0 st1 tyId 2) curChain
      else st1

partial def fillWithFlds : St -> Int -> Int -> List Int -> St

  | st, fdecl, chain, baseBs =>
    if fdecl < 0 then setRet 0 st chain
    else if fd 0 st fdecl 0 != 27 then setRet 0 st chain
    else
      let nm : Int := fd 0 st fdecl 1;
      let na : Int := fd 0 st nm 1;
      let nb : Int := fd 0 st nm 2;
      let st1 : St := fillWithFlds st (fd 0 st fdecl 3) chain baseBs;
      let curChain : Int := st1.ret;
      if findLit st1 curChain na nb >= 0 then st1
      else
        let projBs : List Int := joinDot 0 baseBs (spanBytes 0 st1 na nb);
        let st2 : St := synthIdent 0 st1 projBs;
        let st3 : St := setC 0 st2 st2.ret (-9);
        alloc 0 st3 15 nm st3.ret curChain

-- Inferred binder types are negative payloads, disjoint from AST ids.
partial def annotateLambda : St -> Int -> List Int -> St

  | st, grp, ps =>
    if grp < 0 then st
    else
      let count : Nat := lenI (lambdaNames st (fd 0 st grp 1) 0) / 3;
      let ann : Int := fd 0 st grp 2;
      let st1 : St := if ann == -1 then setNode 0 st grp 22 (fd 0 st grp 1) (-nthF 0 ps 0 - 2) (fd 0 st grp 3) else st;
      annotateLambda st1 (fd 0 st1 grp 3) (dropI ps count)

partial def hofNameDigits : Int -> List Int

  | i =>
    if i < 10 then [48 + i]
    else hofNameDigits (i / 10) ++ [48 + i % 10]

-- Bare named callbacks become fully applied first-order calls in a lambda.
-- Dollar-prefixed internal names cannot collide with a source identifier.
def liftCallback : St -> Int -> List Int -> List Int -> List Int -> Int -> St

  | st, body, [], ns, tys, ret =>
    let st1 : St := spine2 (setRet 0 st (-1)) 22 ns tys;
    alloc 0 st1 32 st1.ret body ret
  | st, body, p :: ps, ns, tys, ret =>
    let st1 : St := synthIdent 0 st ([36, 104] ++ hofNameDigits (Int.ofNat st.nxt));
    let name : Int := st1.ret;
    let st2 : St := alloc 0 st1 12 name (-1) 0;
    let li : Int := st2.ret;
    let st3 : St := alloc 0 st2 5 body li 0;
    liftCallback st3 st3.ret ps (li :: ns) ((-p - 2) :: tys) ret

-- A partial application captures its supplied arguments once, including
-- for an empty receiver. The fresh lets enclose the entire HOF call;
-- only their aliases occur in the generated callback body.
def capturePartialCallback (st : St) (whole cb fn : Int) (suffix : List Int) (ret : Int) : List Int -> List Int -> St
  | [], _ =>
    let lifted : St := liftCallback st fn suffix [] [] ret;
    let ready : St := setNode 0 lifted cb 32 (fd 0 lifted lifted.ret 1) (fd 0 lifted lifted.ret 2) ret;
    alloc 0 ready (fd 0 ready whole 0) (fd 0 ready whole 1) (fd 0 ready whole 2) (fd 0 ready whole 3)
  | arg :: args, p :: ps =>
    let fresh : St := synthIdent 0 st ([36, 112] ++ natBytes st.nxt);
    let alias : Int := fresh.ret;
    let app : St := mkApp fresh fn alias;
    let cont : St := capturePartialCallback app whole cb app.ret suffix ret args ps;
    let tail : Int := cont.ret;
    let ann : St := alloc 0 cont 56 p 0 0;
    let ty : Int := ann.ret;
    let pair : St := alloc 0 ann 10 arg tail 0;
    alloc 0 pair 9 alias ty pair.ret
  | _ :: _, [] => setErr 0 st 7

-- Lookup only after ordinary name resolution and only for a missing suffix.
partial def findDefaultDef : St -> Int -> Int -> Int -> Int

  | st, id, a, b =>
    if id < 0 || fd 0 st id 0 != 19 then -1
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let found : Int :=
        if t == 20 then
          let qs : List Int := qsp 0 st (fd 0 st d 1);
          if spanSame 0 st a b (nthI qs 0) (nthI qs 1) then d else -1
        else if t == 28 then findDefaultDef st (fd 0 st d 1) a b
        else if t == 34 || t == 36 then findDefaultDef st (fd 0 st d 2) a b
        else -1;
      if found != -1 then found else findDefaultDef st (fd 0 st id 2) a b

def repeatDefault : Int -> Nat -> Got
  | _, 0 => { err := 0, xs := [], ret := 0 : Got }
  | id, k + 1 =>
    let r : Got := repeatDefault id k;
    { err := r.err, xs := id :: r.xs, ret := 0 : Got }

partial def defDefaults : St -> Int -> Got

  | st, grp =>
    if grp < 0 then { err := 0, xs := [], ret := 0 : Got }
    else
      let ty : Int := fd 0 st grp 2;
      let val : Int := if fd 0 st ty 0 == 40 then fd 0 st ty 2 else -1;
      let r : Got := repeatDefault val (liCount st (fd 0 st grp 1));
      if r.err != 0 then r
      else
        let tail : Got := defDefaults st (fd 0 st grp 3);
        { err := tail.err, xs := r.xs ++ tail.xs, ret := 0 : Got }

def allDefaults : List Int -> Int

  | [] => 0
  | x :: xs => if x < 0 then 7 else allDefaults xs

def applyDefaultArgs : St -> Int -> List Int -> St

  | st, fn, [] => setRet 0 st fn
  | st, fn, a :: args =>
    let li : St := alloc 0 st 12 a (-1) 0;
    let app : St := alloc 0 li 5 fn li.ret 0;
    applyDefaultArgs app app.ret args

def expandDefDefaults : St -> Env -> Int -> Int -> Int -> List Int -> List Int -> St

  | st, e, top, id, fn, args, locs =>
    if fd 0 st fn 0 != 1 || fd 0 st fn 3 == -9 then st
    else
      let a : Int := fd 0 st fn 1;
      let b : Int := fd 0 st fn 2;
      if findLocal st locs a b >= 0 || ((prim 0 st a b).ret != 0 &&
        !(spanEq 0 st a b "String.singleton" && (findSigE st e a b).ret != 0)) then st
      else
        let sg : Sig := findSigE st e a b;
        let count : Nat := lenI args;
        let arity : Nat := lenI sg.ps;
        if sg.ret == 0 || count >= arity then st
        else
          let d : Int := findDefaultDef st top a b;
          if d == -2 then setErr 0 st 3
          else if d < 0 then st
          else
            let defaults : Got := defDefaults st (fd 0 st (fd 0 st d 2) 1);
            let missing : List Int := dropI defaults.xs count;
            let suffix : Int := allDefaults missing;
            if defaults.err != 0 || suffix == 3 then setErr 0 st 3
            else if lenI defaults.xs != arity || suffix != 0 then st
            else
              let head : St := alloc 0 st 1 a b (fd 0 st fn 3);
              let app : St := applyDefaultArgs head head.ret (args ++ missing);
              if app.err != 0 then app else setNode 0 app id 5 (fd 0 app app.ret 1) (fd 0 app app.ret 2) 0

-- Substitutions are [name-start, name-end, expression] triples. Binding
-- masks apply to bodies only; neither let values nor call actuals are masked.
def localDrop (st : St) : List Int -> Int -> Int -> List Int
  | a :: b :: v :: rest, x, y =>
    if spanSame 0 st a b x y then localDrop st rest x y
    else [a, b, v] ++ localDrop st rest x y
  | _, _, _ => []

def localLookup (st : St) : List Int -> Int -> Int -> Int
  | a :: b :: v :: rest, x, y =>
    if spanSame 0 st a b x y then v else localLookup st rest x y
  | _, _, _ => -1

def localTypes : List Int -> List Int
  | _ :: _ :: ty :: rest => ty :: localTypes rest
  | _ => []

-- Source-order annotation nodes, for typed argument lets (including []).
partial def localBinderAsts (st : St) (grp : Int) : List Int :=
  if grp < 0 then []
  else lambdaNames st (fd 0 st grp 1) (fd 0 st grp 2)
    ++ localBinderAsts st (fd 0 st grp 3)

-- Bare constructor patterns are declarations, never alpha-renamed binders.
def localPatternNames (st : St) (e : Env) : List Int -> List Int
  | a :: b :: ty :: rest =>
    let tail : List Int := localPatternNames st e rest;
    if findCtorB st e.icts 0 (spanBytes 0 st a b) >= 0 then tail
    else [a, b, ty] ++ tail
  | _ => []

-- Retain binding identity as well as spelling: a later binder with the
-- same spelling shadows an earlier one even when both types are unsolved.
def localInferScope : List Int -> List Int
  | a :: b :: ty :: rest => localInferScope rest ++ [a, b, ty]
  | _ => []

def localInferVisible (st : St) (a b : Int) : List Int -> Bool
  | x :: y :: _ :: rest =>
    if spanSame 0 st a b x y then a == x && b == y
    else localInferVisible st a b rest
  | _ => false

def localInferNeeded : List Int -> Bool
  | _ :: _ :: ty :: rest => ty == 0 || localInferNeeded rest
  | _ => false

-- Only rigid contexts supply constraints. Overloaded literals, unresolved
-- receivers, aliases and later call sites do not choose a binder type.
mutual
partial def localInferUses (st : St) (e : Env) (scope : List Int) (id a b exp : Int) : List Int :=
  if id < 0 then []
  else
    let t : Int := fd 0 st id 0;
    let x : Int := fd 0 st id 1;
    let y : Int := fd 0 st id 2;
    let z : Int := fd 0 st id 3;
    if t == 1 then
      if exp > 0 && spanSame 0 st x y a b && localInferVisible st a b scope then [exp] else []
    else if t == 5 then
      let fn : Int := getFn st id;
      let args : List Int := getArgs st id;
      let named : Bool := fd 0 st fn 0 == 1 && fd 0 st fn 3 != -9
        && findLocal st scope (fd 0 st fn 1) (fd 0 st fn 2) < 0
        && !(localReceiver st scope (fd 0 st fn 1) (fd 0 st fn 2));
      let ci : Int := if named then ctorNode st e.icts fn exp else -1;
      let sg : Sig :=
        if ci >= 0 then ctorSig e.icts e.iargs ci
        else if named then
          let p : Sig := if spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "String.singleton" &&
            (findSigE st e (fd 0 st fn 1) (fd 0 st fn 2)).ret != 0 then miss 0
            else prim 0 st (fd 0 st fn 1) (fd 0 st fn 2);
          if p.ret != 0 then p else findSigE st e (fd 0 st fn 1) (fd 0 st fn 2)
        else miss 0;
      localInferArgs st e scope args sg.ps a b
    else if t == 9 then
      let ann : Int := if y >= 0 then decTy st e.heads (-1) (-1) (-1) y else 0;
      let value : Int := fd 0 st z 1;
      let checked : Ans := ck st e scope value ann;
      let ty : Int := if ann > 0 then ann else if checked.err == 0 then checked.ty else 0;
      localInferUses st e scope value a b ann ++
        localInferUses st e ([fd 0 st x 1, fd 0 st x 2, ty] ++ scope) (fd 0 st z 2) a b exp
    else if t == 32 then
      localInferUses st e (localInferScope (lambdaDecls st e.heads x) ++ scope) y a b 0
    else if t == 24 then
      localInferUses st e (localPatternNames st e (patsOfLis st x []) ++ scope) y a b exp ++
        localInferUses st e scope z a b exp
    else if t == 30 then
      localInferUses st e scope x a b (decTy st e.heads (-1) (-1) (-1) y)
    else if t == 8 then
      localInferUses st e scope x a b 2 ++ localInferUses st e scope y a b exp ++ localInferUses st e scope z a b exp
    else if t == 6 then
      let op : Int := x % 100;
      let numeric : Bool := (op >= 1 && op <= 4) || op == 15 || (op >= 19 && op <= 23);
      let want : Int := if op == 11 || op == 12 then 2
        else if numeric && (exp == 1 || exp == 4 || isWordTy exp) then exp
        else if (op == 13 || op == 14) && isListTy 0 exp then exp else 0;
      localInferUses st e scope y a b (if op == 13 && want > 0 then elemTy 0 want else want) ++
        localInferUses st e scope z a b want
    else if t == 7 then localInferUses st e scope y a b (if x % 100 == 2 then 2 else 0)
    else if t == 42 then
      localInferUses st e scope x a b (if isProductTy 0 exp then productLeft 0 exp else 0) ++
        localInferUses st e scope y a b (if isProductTy 0 exp then productRight 0 exp else 0)
    else if t == 11 then localInferList st e scope x a b (if isListTy 0 exp then elemTy 0 exp else 0)
    else if t == 13 then localInferUses st e scope x a b exp
    else if t == 31 then localInferList st e scope x a b 0 ++ localInferUses st e scope y a b exp
    else if t == 14 then localInferUses st e scope y a b 0 ++ (if z > 0 then localInferUses st e scope (z - 1) a b 0 else [])
    else if t == 15 then localInferUses st e scope y a b 0 ++ localInferUses st e scope z a b 0
    else if t == 10 || t == 12 || t == 33 then localInferUses st e scope x a b 0 ++ localInferUses st e scope y a b 0
    else if t == 17 || t == 29 || t == 44 || t == 47 then localInferUses st e scope x a b 0
    else []

partial def localInferArgs (st : St) (e : Env) (scope : List Int) (args ps : List Int) (a b : Int) : List Int :=
  match args with
  | [] => []
  | arg :: rest =>
    localInferUses st e scope arg a b (nthF 0 ps 0) ++ localInferArgs st e scope rest (dropI ps 1) a b

partial def localInferList (st : St) (e : Env) (scope : List Int) (li a b exp : Int) : List Int :=
  if li < 0 then []
  else localInferUses st e scope (fd 0 st li 1) a b exp ++ localInferList st e scope (fd 0 st li 2) a b exp
end

-- This slice has one overloaded numeric type, possibly under List. Any
-- ascription, local, global call or unsupported form is a rigid anchor.
-- In replicate, the Nat count does not constrain the element's type.
mutual
partial def localLetFlexible (st : St) (e : Env) (locs : List Int) (id : Int) : Bool :=
  if id < 0 then false
  else
    let t : Int := fd 0 st id 0;
    let a : Int := fd 0 st id 1;
    let b : Int := fd 0 st id 2;
    let c : Int := fd 0 st id 3;
    if t == 2 then a >= 0
    else if t == 13 then localLetFlexible st e locs a
    else if t == 11 then localLetFlexibleList st e locs a
    else if t == 8 then localLetFlexible st e locs b && localLetFlexible st e locs c
    else if t == 6 then
      let op : Int := a % 100;
      (op == 1 || op == 2 || op == 3 || op == 4 || op == 13 || op == 14 || op == 15)
        && a / 100 == 0 && localLetFlexible st e locs b && localLetFlexible st e locs c
    else if t == 5 then
      let fn : Int := getFn st id;
      let args : List Int := getArgs st id;
      fd 0 st fn 0 == 1 && fd 0 st fn 3 != -9
        && spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "List.replicate"
        && findLocal st locs (fd 0 st fn 1) (fd 0 st fn 2) < 0
        && (findSigE st e (fd 0 st fn 1) (fd 0 st fn 2)).ret == 0
        && lenI args == 2 && localLetFlexible st e locs (nthF 0 args 1)
    else false

partial def localLetFlexibleList (st : St) (e : Env) (locs : List Int) (li : Int) : Bool :=
  if li < 0 then true
  else localLetFlexible st e locs (fd 0 st li 1)
    && localLetFlexibleList st e locs (fd 0 st li 2)
end

-- Return zero when the existing default suffices. A positive type is
-- installed as private metadata before both checking and lowering.
def localLetRetarget (st : St) (e : Env) (locs : List Int) (name value body exp : Int) : Int :=
  if !(localLetFlexible st e locs value) then 0
  else
    let initial : Ans := ck st e locs value 0;
    if initial.err != 0 then 0
    else
      let a : Int := fd 0 st name 1;
      let b : Int := fd 0 st name 2;
      let uses : List Int := localInferUses st e ([a, b, initial.ty] ++ locs) body a b exp;
      if lenI uses == 0 then 0
      else
        let request : LetContextNF.Request := { inferred := initial.ty, constraints := uses };
        let result : LetContextNF.State := LetContextNF.step request { selected := 0, residue := none };
        if result.residue.isSome then -1
        else if result.selected == initial.ty then 0
        else
          let checked : Ans := ck st e locs value result.selected;
          if checked.err == 0 then result.selected else -1

def localInferDecls (st : St) (e : Env) (scope : List Int) (body : Int) : List Int -> Got
  | a :: b :: ty :: rest =>
    let request : Rsdc.LocalLambdaNF.Request :=
      { declared := ty, constraints := if ty == 0 then localInferUses st e scope body a b 0 else [] };
    if !(Rsdc.LocalLambdaNF.admit request 0) then { err := 6, xs := [], ret := a : Got }
    else
      let tail : Got := localInferDecls st e scope body rest;
      { err := tail.err, xs := [a, b, Rsdc.LocalLambdaNF.resolved request] ++ tail.xs, ret := tail.ret : Got }
  | [] => { err := 0, xs := [], ret := 0 : Got }
  | _ => { err := 6, xs := [], ret := 0 : Got }

-- Fresh single-name groups preserve independent metavariables in a source
-- group. Tag 56 is private type metadata, made only after the NF admits.
def localInferGroups (st : St) : List Int -> St
  | a :: b :: ty :: rest =>
    let tail : St := localInferGroups st rest;
    let next : Int := tail.ret;
    let name : St := alloc 0 tail 1 a b 0;
    let li : St := alloc 0 name 12 name.ret (-1) 0;
    let names : Int := li.ret;
    let ann : St := alloc 0 li 56 ty 0 0;
    alloc 0 ann 22 names ann.ret next
  | _ => setRet 0 st (-1)

def localInferLambda (st : St) (e : Env) (fn : Int) (locs : List Int) : St :=
  let decls : List Int := lambdaDecls st e.heads (fd 0 st fn 1);
  if !(localInferNeeded decls) then st
  else
    let got : Got := localInferDecls st e (localInferScope decls ++ locs) (fd 0 st fn 2) decls;
    if got.err != 0 then setErr 0 (setPos 0 st (Int.toNat got.ret)) (Int.toNat got.err)
    else
      let ready : St := localInferGroups st got.xs;
      setNode 0 ready fn 32 ready.ret (fd 0 ready fn 2) (fd 0 ready fn 3)

partial def localFree (st : St) (e : Env) (id a b : Int) : Bool :=
  if id < 0 then false
  else
    let t : Int := fd 0 st id 0;
    let x : Int := fd 0 st id 1;
    let y : Int := fd 0 st id 2;
    let z : Int := fd 0 st id 3;
    if t == 1 then
      spanSame 0 st x y a b ||
        (z == -9 && spanSame 0 st x (lastDot st x y) a b)
    else if t == 9 then
      localFree st e (fd 0 st z 1) a b ||
        (!(spanSame 0 st (fd 0 st x 1) (fd 0 st x 2) a b) && localFree st e (fd 0 st z 2) a b)
    else if t == 32 then
      findLocal st (grpLocs st x) a b < 0 && localFree st e y a b
    else if t == 24 then
      (findLocal st (localPatternNames st e (patsOfLis st x [])) a b < 0 && localFree st e y a b)
        || localFree st e z a b
    else if t == 14 then localFree st e y a b || (z > 0 && localFree st e (z - 1) a b)
    else if t == 15 || t == 6 then localFree st e y a b || localFree st e z a b
    else if t == 8 then localFree st e x a b || localFree st e y a b || localFree st e z a b
    else if t == 5 || t == 10 || t == 12 || t == 31 || t == 33 || t == 42 then
      localFree st e x a b || localFree st e y a b
    else if t == 7 then localFree st e y a b
    else if t == 11 || t == 13 || t == 17 || t == 18 || t == 29 || t == 44 || t == 47 || t == 30 then localFree st e x a b
    else false

-- Clone value nodes before rewriting them. Type and pattern metadata are
-- immutable here; lambda group nodes are copied before callback annotation.
-- Freshen destination binders too: copied free globals must stay free.
mutual
partial def localCopy (st : St) (e : Env) (id : Int) (subs : List Int) : St :=
  if st.err != 0 then st
  else if id < 0 then setRet 0 st id
  else
    let t : Int := fd 0 st id 0;
    let x : Int := fd 0 st id 1;
    let y : Int := fd 0 st id 2;
    let z : Int := fd 0 st id 3;
    let repl : Int := if t == 1 then localLookup st subs x y else -1;
    if repl >= 0 then localCopy st e repl []
    else if t == 1 && z == -9 then
      let dot : Int := lastDot st x y;
      let recv : Int := localLookup st subs x dot;
      if recv < 0 then alloc 0 st t x y z
      else
        let copied : St := localCopy st e recv [];
        alloc 0 copied 29 copied.ret (dot + 1) y
    else if t == 9 then
      let v : St := localCopy st e (fd 0 st z 1) subs;
      let val : Int := v.ret;
      let fresh : St := synthIdent 0 v ([36, 98] ++ natBytes v.nxt);
      let alias : Int := fresh.ret;
      let body : St := localCopy fresh e (fd 0 st z 2)
        ([fd 0 st x 1, fd 0 st x 2, alias] ++ localDrop st subs (fd 0 st x 1) (fd 0 st x 2));
      let pair : St := alloc 0 body 10 val body.ret 0;
      alloc 0 pair 9 alias y pair.ret
    else if t == 32 then
      let pair : St := localAlpha st e (grpLocs st x) x y [] subs;
      alloc 0 pair 32 (fd 0 pair pair.ret 1) (fd 0 pair pair.ret 2) z
    else if t == 22 then
      let names : St := localCopy st e x subs;
      let ns : Int := names.ret;
      let tail : St := localCopy names e z subs;
      alloc 0 tail 22 ns y tail.ret
    else if t == 24 then
      let pair : St := localAlpha st e (localPatternNames st e (patsOfLis st x [])) x y [] subs;
      let pats : Int := fd 0 pair pair.ret 1;
      let rhs : Int := fd 0 pair pair.ret 2;
      let tail : St := localCopy pair e z subs;
      alloc 0 tail 24 pats rhs tail.ret
    else if t == 14 then
      let base : St := if z > 0 then localCopy st e (z - 1) subs else setRet 0 st (-1);
      let withB : Int := if z > 0 then base.ret + 1 else z;
      let fields : St := localCopy base e y subs;
      alloc 0 fields 14 x fields.ret withB
    else if t == 15 || t == 6 then
      let first : St := localCopy st e y subs;
      let l : Int := first.ret;
      let second : St := localCopy first e z subs;
      alloc 0 second t x l second.ret
    else if t == 8 then
      let cnd : St := localCopy st e x subs;
      let c : Int := cnd.ret;
      let th : St := localCopy cnd e y subs;
      let l : Int := th.ret;
      let el : St := localCopy th e z subs;
      alloc 0 el 8 c l el.ret
    else if t == 5 || t == 10 || t == 12 || t == 31 || t == 33 || t == 42 then
      let first : St := localCopy st e x subs;
      let l : Int := first.ret;
      let second : St := localCopy first e y subs;
      alloc 0 second t l second.ret z
    else if t == 7 then
      let body : St := localCopy st e y subs;
      alloc 0 body t x body.ret z
    else if t == 11 || t == 13 || t == 17 || t == 18 || t == 29 || t == 44 || t == 47 || t == 30 then
      let body : St := localCopy st e x subs;
      alloc 0 body t body.ret y z
    else alloc 0 st t x y z

partial def localAlpha (st : St) (e : Env) (names : List Int) (binders body : Int)
    (binderSubs bodySubs : List Int) : St :=
  match names with
  | a :: b :: _ :: rest =>
    let fresh : St := synthIdent 0 st ([36, 98] ++ natBytes st.nxt);
    let alias : Int := fresh.ret;
    localAlpha fresh e rest binders body ([a, b, alias] ++ binderSubs)
      ([a, b, alias] ++ localDrop st bodySubs a b)
  | _ =>
    let bs : St := localCopy st e binders binderSubs;
    let lhs : Int := bs.ret;
    let rhs : St := localCopy bs e body bodySubs;
    alloc 0 rhs 10 lhs rhs.ret 0
end

-- Capture only the visible free locals, at the definition point. The
-- internal $c names cannot be written by the source lexer.
partial def localCapture (st : St) (e : Env) (locs : List Int) (fn body name : Int) : St :=
  match locs with
  | a :: b :: _ :: rest =>
    let visible : List Int := localDrop st rest a b;
    if !(localFree st e fn a b) then localCapture st e visible fn body name
    else
      let fresh : St := synthIdent 0 st ([36, 99] ++ natBytes st.nxt);
      let alias : Int := fresh.ret;
      let renamed : St := localCopy fresh e fn [a, b, alias];
      let cont : St := localCapture renamed e visible renamed.ret body name;
      let tail : Int := cont.ret;
      let orig : St := alloc 0 cont 1 a b 0;
      let pair : St := alloc 0 orig 10 orig.ret tail 0;
      alloc 0 pair 9 alias (-1) pair.ret
  | _ => localCopy st e body [fd 0 st name 1, fd 0 st name 2, fn]

-- Build substitutions before wrapping actuals. Later duplicates are at
-- the front of subs; the enclosing lets still evaluate left to right.
def localApply (st : St) (e : Env) (body : Int) (subs : List Int) : List Int -> List Int -> St
  | a :: b :: ty :: rest, arg :: args =>
    let fresh : St := synthIdent 0 st ([36, 112] ++ natBytes st.nxt);
    let alias : Int := fresh.ret;
    let cont : St := localApply fresh e body ([a, b, alias] ++ subs) rest args;
    let pair : St := alloc 0 cont 10 arg cont.ret 0;
    alloc 0 pair 9 alias ty pair.ret
  | [], [] => localCopy st e body subs
  | _, _ => setErr 0 st 7

-- Lean resolves anonymous-dot names from the expected result namespace.
-- Admit a known List context and same-type operand with receiver-last
-- operations. Other contexts and orders remain a named subset boundary.
def pipeMethodLast (st : St) (ty exp a b : Int) (args : List Int) : Bool :=
  if !(isListTy 0 exp) || ty != exp then false
  else
    match args with
    | [] => true
    | _ =>
      let op : Int := containerOp 0 st ty a b;
      op == 11 || op == 22 || op == 23 || op == 24 || op == 27

-- Infer the operand width before visiting nested contextual literals.
-- Only a literal may be checked again at the opposite operand's width;
-- ck still requires a typed Nat variable or a different word width to fit.
def wordBinTy (st : St) (e : Env) (locs : List Int) (op : Int) (l : Int) (r : Int) (exp : Int) : Int :=
  if isWordTy (op / 100) then op / 100
  else if wordBinAllowed exp (op % 100) then exp
  else
    let a : Ans := ck st e locs l 0;
    if a.err == 0 && isWordTy a.ty then a.ty
    else if a.err == 0 && a.ty == 4 then
      let b : Ans := ck st e locs r 0;
      if b.err == 0 && isWordTy b.ty then b.ty else 0
    else 0

-- Lean 4.14 Lean/Elab/App.lean, findMethod?/resolveLValAux/addLValArg:
-- fields precede methods; insert the receiver at the first parameter whose
-- type has its structure head. This is the prepared monomorphic, explicit
-- binder subset. Reuse indexed signature lookup and ordinary call lowering.
-- The parameter scan and argument insertion cost O(P + A).
def structMethodSig (st : St) (e : Env) (ty a b : Int) : Sig :=
  if ty < 100 || ty >= 1000 || fieldTy 0 st e ty a b > 0 then miss 0
  else
    let i : Nat := Int.toNat (ty - 100);
    if i * 4 + 3 >= lenI e.heads then miss 0
    else findSigBE st e (joinDot 0 (spanBytes 0 st (nthF 0 e.heads (i * 4)) (nthF 0 e.heads (i * 4 + 1))) (spanBytes 0 st a b))

def structReceiverIndex : List Int -> Int -> Int
  | [], _ => -1
  | p :: ps, ty =>
    if p == ty then 0
    else
      let i : Int := structReceiverIndex ps ty;
      if i < 0 then -1 else i + 1

-- Lean 4.14 Init/Data/Int/DivMod.lean Int.fmod (floor remainder), written
-- over the existing Int remainder (Int.emod, `%`): with r = a % b, which is
-- in [0, |b|), the floor remainder is r, except that r + b when r != 0 and
-- b < 0. For b = 0 it is a. Operands are bound once, in source order.
def intTypeNode (st : St) (ty : Int) : St := alloc 0 st 56 ty 0 0

def lowerFmod (st : St) (a b : Int) : St :=
  let sa : St := synthIdent 0 st ([36, 102, 97] ++ natBytes st.nxt);
  let sb : St := synthIdent 0 sa ([36, 102, 98] ++ natBytes sa.nxt);
  let sr : St := synthIdent 0 sb ([36, 102, 114] ++ natBytes sb.nxt);
  let fa : Int := sa.ret;
  let fb : Int := sb.ret;
  let fr : Int := sr.ret;
  let rem : St := mkBin sr 15 fa fb;
  let z1 : St := mkNum rem 0;
  let ne : St := mkBin z1 6 fr z1.ret;
  let z2 : St := mkNum ne 0;
  let lt : St := mkBin z2 7 fb z2.ret;
  let both : St := mkBin lt 11 ne.ret lt.ret;
  let sum : St := mkBin both 1 fr fb;
  let pick : St := mkIf sum both.ret sum.ret fr;
  let t3 : St := intTypeNode pick 1;
  let l3 : St := mkLet t3 fr t3.ret rem.ret pick.ret;
  let t2 : St := intTypeNode l3 1;
  let l2 : St := mkLet t2 fb t2.ret b l3.ret;
  let t1 : St := intTypeNode l2 1;
  mkLet t1 fa t1.ret a l2.ret

-- Lean 4.14 Init/Prelude.lean:1140 max x y = if x <= y then y else x, and
-- :1153 min x y = if x <= y then x else y (maxOfLe/minOfLe; Int.Basic:332,334).
-- Operands are bound once at the chosen numeric type ty.
def lowerMinMax (st : St) (isMax : Bool) (ty a b : Int) : St :=
  let sa : St := synthIdent 0 st ([36, 109, 97] ++ natBytes st.nxt);
  let sb : St := synthIdent 0 sa ([36, 109, 98] ++ natBytes sa.nxt);
  let fa : Int := sa.ret;
  let fb : Int := sb.ret;
  let test : St := mkBin sb 9 fa fb;
  let pick : St := mkIf test test.ret (if isMax then fb else fa) (if isMax then fa else fb);
  let t2 : St := intTypeNode pick ty;
  let l2 : St := mkLet t2 fb t2.ret b pick.ret;
  let t1 : St := intTypeNode l2 ty;
  mkLet t1 fa t1.ret a l2.ret

-- Saturated conditional applications use ordinary statically named calls.
partial def conditionalCallSig (st : St) (e : Env) (locs : List Int) (id : Int) : Sig :=
  let a : Int := fd 0 st id 1;
  let b : Int := fd 0 st id 2;
  if fd 0 st id 0 != 1 || fd 0 st id 3 != 0 || findLocal st locs a b >= 0 then miss 0
  else findSigE st e a b

mutual
partial def desugar : St -> Env -> Int -> Int -> List Int -> Int -> St

  | st, e, top, id, locs, exp =>
    if id < 0 then st
    else
      let t : Int := fd 0 st id 0;
      if t == 47 then
        let lowered : St := anonymousExprLower st e id exp [];
        if lowered.err != 0 then lowered else desugar lowered e top id locs exp
      else if (t == 1 || t == 5) && fd 0 st (getFn st id) 3 <= -10100 && fd 0 st (getFn st id) 3 > -11000 then
        let ty : Int := -10000 - fd 0 st (getFn st id) 3;
        let i : Nat := Int.toNat (ty - 100);
        let cnt : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 2));
        let first : Nat := Int.toNat (nthF 0 e.heads (i * 4 + 3));
        let fields : List Int := takeI (dropI e.fields (first * 3)) (cnt * 3);
        let spine : St := spine1 (setRet 0 st (-1)) 12 (revI [] (getArgs st id));
        let built : St := anonymousFields spine spine.ret fields;
        if built.err != 0 then built
        else
          let body : St := alloc 0 built 14 (-1) built.ret 0;
          let ann : St := alloc 0 body 56 ty 0 0;
          desugar (setNode 0 ann id 30 body.ret ann.ret 0) e top id locs exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 8 then
        let head : Int := getFn st id;
        let th : Int := unwrapP st (fd 0 st head 2);
        let el : Int := unwrapP st (fd 0 st head 3);
        let left : Sig := conditionalCallSig st e locs th;
        let right : Sig := conditionalCallSig st e locs el;
        let args : List Int := getArgs st id;
        if left.ret == 0 || left.ret != right.ret || !(eqListI left.ps right.ps) then setErr 0 st 6
        else if lenI args != lenI left.ps then setErr 0 st 7
        else
          let test : Int := fd 0 st head 1;
          let prepared : St := desugar st e top test locs 2;
          let ready : St := desugarArgs prepared e top args left.ps locs;
          let yes : St := applyDefaultArgs ready th args;
          let no : St := applyDefaultArgs yes el args;
          let body : St := alloc 0 no 8 test yes.ret no.ret;
          let ann : St := alloc 0 body 56 left.ret 0 0;
          setNode 0 ann id 30 body.ret ann.ret 0
      else if t == 43 || (t == 5 && fd 0 st (getFn st id) 0 == 43) then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        let ci : Int := anonymousCtorIndex st e.icts fn exp;
        let sg : Sig := ctorSig e.icts e.iargs ci;
        let request : Rsdc.AnonymousCtorNF.Request :=
          { expectedType := exp, selected := ci, parameterCount := lenI sg.ps, argumentCount := lenI args,
            headTypeUnavailable := anonymousCtorHeadSeparated st id };
        if !(Rsdc.AnonymousCtorNF.admit request 0) then setErr 0 st 6
        else
          let named : St := setNode 0 st fn 1 sg.a sg.b (-1000 - ci);
          desugar named e top id locs exp
      else if t == 1 then
        let a : Int := fd 0 st id 1;
        let b : Int := fd 0 st id 2;
        if fd 0 st id 3 != -9 && findLocal st locs a b < 0 && findCtorB st e.icts 0 (spanBytes 0 st a b) >= 0 then
          let ci : Int := ckCtorIndex st e locs id [] exp;
          if ci < 0 then setErr 0 st 6 else setC 0 st id (-1000 - ci)
        else
          let st1 : St := expandDefDefaults st e top id id [] locs;
          if fd 0 st1 id 0 == 5 then desugar st1 e top id locs exp
          else
            let st2 : St := desugarRef st1 e top id locs;
            if fd 0 st2 id 0 == 29 then desugarMethod st2 e top id id [] locs exp else st2
      else if t == 44 || (t == 5 && fd 0 st (getFn st id) 0 == 44) then
        if !(isListTy 0 exp) then setErr 0 st 6
        else
          let fn : Int := if fd 0 st id 0 == 44 then id else getFn st id;
          let args : List Int := if fn == id then [] else getArgs st id;
          let recv : Int := fd 0 st fn 1;
          let prepared : St := desugar st e top recv locs exp;
          let checked : Ans := ck prepared e locs recv exp;
          if prepared.err != 0 then prepared
          else if checked.err != 0 then setErr 0 prepared (Int.toNat checked.err)
          else if !(pipeMethodLast prepared checked.ty exp (fd 0 prepared fn 2) (fd 0 prepared fn 3) args) then setErr 0 prepared 6
          else
            let ordinary : St := setNode 0 prepared fn 29 recv (fd 0 prepared fn 2) (fd 0 prepared fn 3);
            desugar ordinary e top id locs exp
      else if t == 33 then
        let st1 : St := desugar st e top (fd 0 st id 1) locs 0;
        desugar st1 e top (fd 0 st1 id 2) locs 4
      else if t == 19 then
        let st1 : St := desugar st e top (fd 0 st id 1) locs 0;
        desugar st1 e top (fd 0 st1 id 2) locs 0
      else if t == 28 then desugar st e top (fd 0 st id 1) locs 0
      else if t == 34 || t == 36 then desugar st e top (fd 0 st id 2) locs 0
      else if t == 26 then desugar st e top (fd 0 st id 2) [] 0
      else if t == 27 then
        let tyId : Int := fd 0 st id 2;
        let st1 : St :=
          if fd 0 st tyId 0 == 40 then
            let fty : Int := decTy st e.heads (-1) (-1) (-1) (fd 0 st tyId 1);
            desugar st e top (fd 0 st tyId 2) [] (if fty > 0 then fty else 0)
          else st;
        desugar st1 e top (fd 0 st1 id 3) [] 0
      else if t == 20 then
        let sig : Int := fd 0 st id 2;
        let locsA : Got := bindLocs st e.heads (fd 0 st sig 1);
        let bt : List Int := tysOf locsA.xs;
        let ar : Got := takeArrows st e.heads bt (fd 0 st sig 2);
        if locsA.err != 0 || ar.err != 0 then st
        else
          let body : Int := fd 0 st id 3;
          let btN : Nat := lenI bt;
          if fd 0 st body 0 == 25 then desugar st e top (fd 0 st body 1) locsA.xs ar.ret
          else if fd 0 st body 0 == 23 then desugarAlts st e top (fd 0 st body 1) locsA.xs (dropI ar.xs btN) ar.ret
          else st
      else if t == 9 && fd 0 st (unwrapP st (fd 0 st (fd 0 st id 3) 1)) 0 == 32 then
        desugarLocal st e top id locs exp
      else if t == 9 then
        let r2 : Int := fd 0 st id 3;
        let nm : Int := fd 0 st id 1;
        let tyN : Int := fd 0 st id 2;
        let contextual : Int := if tyN < 0 then
          localLetRetarget st e locs nm (fd 0 st r2 1) (fd 0 st r2 2) exp else 0;
        if contextual < 0 then setErr 0 (setPos 0 st (Int.toNat (fd 0 st nm 1))) 6
        else
          let ready : St := if contextual > 0 then
            let ann : St := alloc 0 st 56 contextual 0 0;
            setNode 0 ann id 9 nm ann.ret r2 else st;
          let ty0 : Int := if contextual > 0 then contextual
            else if tyN < 0 then 0 else decTy ready e.heads (-1) (-1) (-1) tyN;
          let st1 : St := desugar ready e top (fd 0 ready r2 1) locs ty0;
          let ty : Int :=
            if ty0 > 0 then ty0
            else
              let aV : Ans := ck st1 e locs (fd 0 st1 r2 1) 0;
              if aV.err == 0 then aV.ty else 0;
          desugar st1 e top (fd 0 st1 r2 2) ([fd 0 st1 nm 1, fd 0 st1 nm 2, ty] ++ locs) exp
      else if t == 42 then
        let st1 : St := desugar st e top (fd 0 st id 1) locs (if isProductTy 0 exp then productLeft 0 exp else 0);
        let st2 : St := desugar st1 e top (fd 0 st1 id 2) locs (if isProductTy 0 exp then productRight 0 exp else 0);
        let r : Ans := ck st2 e locs id exp;
        if r.err == 0 then setC 0 st2 id r.ty else st2
      else if t == 31 then
        let st1 : St := desugarLi st e top (fd 0 st id 1) locs 0;
        let pts : Got := ckScruts st1 e locs (fd 0 st1 id 1);
        let st2 : St := desugarAlts st1 e top (fd 0 st1 id 2) locs pts.xs exp;
        let result : Ans := ckTermMatch st2 e locs (fd 0 st2 id 1) (fd 0 st2 id 2) exp;
        if result.err == 0 then setC 0 st2 id result.ty else st2
      else if t == 8 then
        let st1 : St := desugar st e top (fd 0 st id 1) locs 2;
        let result : Ans := if exp == 0 then ckIf st1 e locs (fd 0 st1 id 1) (fd 0 st1 id 2) (fd 0 st1 id 3) 0 else bad 0 6;
        let use : Int := if result.err == 0 then result.ty else exp;
        -- Lean 4.14 App.processExplicitArg/propagateExpectedType and
        -- StructInst.getStructName/elabStructInstAux defer structure defaults
        -- until the shared expected type is available (src/Lean/Elab in
        -- https://github.com/leanprover/lean4/tree/v4.14.0).
        -- An unannotated conditional may expose that type only after its
        -- informative branch's defaults are expanded. Recover record types
        -- only, then check the complete conditional before retaining the type.
        -- This adds at most two branch checks and one branch desugaring;
        -- each keeps the existing traversal/default-field cost.
        let st2 : St := desugar st1 e top (fd 0 st1 id 2) locs use;
        let thenTy : Ans := if use == 0 then ck st2 e locs (fd 0 st2 id 2) 0 else bad 0 6;
        let shared : Int := if thenTy.err == 0 && thenTy.ty >= 100 && thenTy.ty < 1000 then thenTy.ty else use;
        let st3 : St := desugar st2 e top (fd 0 st2 id 3) locs shared;
        let elseTy : Ans := if shared == 0 then ck st3 e locs (fd 0 st3 id 3) 0 else bad 0 6;
        let recovered : Int := if elseTy.err == 0 && elseTy.ty >= 100 && elseTy.ty < 1000 then elseTy.ty else shared;
        let st4 : St := if shared == 0 && recovered > 0 then desugar st3 e top (fd 0 st3 id 2) locs recovered else st3;
        let complete : Ans := if result.err == 0 then result
          else if exp == 0 && recovered >= 100 && recovered < 1000 then
            ckIf st4 e locs (fd 0 st4 id 1) (fd 0 st4 id 2) (fd 0 st4 id 3) recovered
          else result;
        if complete.err != 0 then st4
        else
          -- Retain the shared type for lowering. Otherwise an empty branch
          -- can be lowered without the type that made checking succeed.
          let ty : St := alloc 0 st4 56 complete.ty 0 0;
          let body : St := alloc 0 ty 8 (fd 0 ty id 1) (fd 0 ty id 2) (fd 0 ty id 3);
          setNode 0 body id 30 body.ret ty.ret 0
      else if t == 5 && fd 0 st (getFn st id) 0 == 1 && fd 0 st (getFn st id) 3 != -9 &&
        (spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "List.getLast?" ||
         spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "List.flatten" ||
         spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "List.flatMap" ||
         spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "List.zip") &&
        findLocal st locs (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) < 0 &&
        (findSigE st e (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2)).ret == 0 then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        let unary : Bool := spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "List.getLast?" || spanEq 0 st (fd 0 st fn 1) (fd 0 st fn 2) "List.flatten";
        if lenI args != (if unary then 1 else 2) then setErr 0 st 7
        else
          let method : St := alloc 0 st 29 (nthF 0 args 0) (fd 0 st fn 1 + 5) (fd 0 st fn 2);
          let app : St := if unary then method else mkApp method method.ret (nthF 0 args 1);
          let copied : St := setNode 0 app id (fd 0 app app.ret 0) (fd 0 app app.ret 1) (fd 0 app app.ret 2) (fd 0 app app.ret 3);
          desugar copied e top id locs exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 1 && fd 0 st (getFn st id) 3 != -9 && spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "String.split" && findLocal st locs (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) < 0 && (findSigE st e (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2)).ret == 0 then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        if lenI args != 2 then setErr 0 st 7
        else
          let method : St := alloc 0 st 29 (nthF 0 args 0) (fd 0 st fn 1 + 7) (fd 0 st fn 2);
          let app : St := mkApp method method.ret (nthF 0 args 1);
          let copied : St := setNode 0 app id 5 (fd 0 app app.ret 1) (fd 0 app app.ret 2) 0;
          desugar copied e top id locs exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 1 && fd 0 st (getFn st id) 3 != -9 && spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "List.replicate" && findLocal st locs (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) < 0 then
        let args : List Int := getArgs st id;
        let st1 : St := desugarArgs st e top args [4, if isListTy 0 exp then elemTy 0 exp else 0] locs;
        let result : Ans := ck st1 e locs id exp;
        if result.err == 0 then setC 0 st1 id result.ty else st1
      else if t == 5 && fd 0 st (getFn st id) 0 == 1 && fd 0 st (getFn st id) 3 != -9 &&
        (spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "max" ||
         spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "min") &&
        findLocal st locs (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) < 0 &&
        (findSigE st e (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2)).ret == 0 then
        let args : List Int := getArgs st id;
        if lenI args != 2 then setErr 0 st 7
        else
          let use : Int := numericChoiceTy st e locs args exp;
          let isMax : Bool := spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "max";
          if isMax && use != 1 then
            let ready : St := desugarArgs st e top args [use, use] locs;
            let result : Ans := ck ready e locs id exp;
            if result.err == 0 then setC 0 ready id result.ty else ready
          else
            let built : St := lowerMinMax st isMax use (nthI args 0) (nthI args 1);
            let r : Int := built.ret;
            let rewritten : St := setNode 0 built id 9 (fd 0 built r 1) (fd 0 built r 2) (fd 0 built r 3);
            desugar rewritten e top id locs exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 1 && fd 0 st (getFn st id) 3 != -9 &&
        spanEq 0 st (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) "Int.fmod" &&
        findLocal st locs (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2) < 0 &&
        (findSigE st e (fd 0 st (getFn st id) 1) (fd 0 st (getFn st id) 2)).ret == 0 then
        let args : List Int := getArgs st id;
        if lenI args != 2 then setErr 0 st 7
        else
          let built : St := lowerFmod st (nthI args 0) (nthI args 1);
          let r : Int := built.ret;
          let rewritten : St := setNode 0 built id 9 (fd 0 built r 1) (fd 0 built r 2) (fd 0 built r 3);
          desugar rewritten e top id locs exp
      else if t == 5 && fd 0 st (getFn st id) 0 == 32 then desugarLocalApp st e top id locs exp
      else if t == 5 then
        let st0 : St := expandDefDefaults st e top id (getFn st id) (getArgs st id) locs;
        let fn : Int := getFn st0 id;
        let args : List Int := getArgs st0 id;
        let ci : Int :=
          if fd 0 st0 fn 0 == 1 && fd 0 st0 fn 3 != -9 && findLocal st0 locs (fd 0 st0 fn 1) (fd 0 st0 fn 2) < 0 && findCtorB st0 e.icts 0 (spanBytes 0 st0 (fd 0 st0 fn 1) (fd 0 st0 fn 2)) >= 0 then ckCtorIndex st0 e locs fn args exp
          else -1;
        let sg : Sig :=
          if ci >= 0 then ctorSig e.icts e.iargs ci
          else if fd 0 st0 fn 0 != 1 || fd 0 st0 fn 3 == -9 || fd 0 st0 fn 3 == -59 then miss 0
          else
            let p : Sig := if spanEq 0 st0 (fd 0 st0 fn 1) (fd 0 st0 fn 2) "String.singleton" &&
              (findSigE st0 e (fd 0 st0 fn 1) (fd 0 st0 fn 2)).ret != 0 then miss 0
              else prim 0 st0 (fd 0 st0 fn 1) (fd 0 st0 fn 2);
            if p.ret != 0 then p else findSigE st0 e (fd 0 st0 fn 1) (fd 0 st0 fn 2);
        let st1 : St := if ci >= 0 then setC 0 st0 fn (-1000 - ci) else if fd 0 st0 fn 0 == 1 then desugarRef st0 e top fn locs else if fd 0 st0 fn 0 == 29 then desugar st0 e top (fd 0 st0 fn 1) locs 0 else desugar st0 e top fn locs 0;
        let recv : Ans := if fd 0 st1 fn 0 == 29 then ck st1 e locs (fd 0 st1 fn 1) 0 else bad 0 6;
        let op : Int := if recv.err == 0 then containerOp 0 st1 recv.ty (fd 0 st1 fn 2) (fd 0 st1 fn 3) else 0;
        if recv.err == 0 && (structMethodSig st1 e recv.ty (fd 0 st1 fn 2) (fd 0 st1 fn 3)).ret != 0 then desugarMethod st1 e top id fn args locs exp
        else if (op >= 20 && op <= 24) || op == 30 || op == 34 then desugarHof st1 e top id recv.ty op args locs exp
        else if op == 35 then
          let otherExp : Int := if isListTy 0 exp && isProductTy 0 (elemTy 0 exp) then listTy 0 (productRight 0 (elemTy 0 exp)) else 0;
          let ready : St := desugarArgs st1 e top args [otherExp] locs;
          let result : Ans := ck ready e locs id exp;
          if result.err == 0 then setC 0 ready id result.ty else ready
        else
          let ps : List Int :=
            if fd 0 st1 fn 0 == 1 && optionName 0 st1 (fd 0 st1 fn 1) (fd 0 st1 fn 2) == 1 && sg.ret == 0 && isOptionTy 0 exp then [elemTy 0 exp]
            else if fd 0 st1 fn 0 == 29 then
              let r : Ans := ck st1 e locs (fd 0 st1 fn 1) 0;
              let ds : Sig := dataMethod 0 st1 r.ty (fd 0 st1 fn 2) (fd 0 st1 fn 3);
              let cs : Sig := containerSig 0 (containerOp 0 st1 r.ty (fd 0 st1 fn 2) (fd 0 st1 fn 3)) r.ty;
              if ds.ret != 0 then ds.ps else cs.ps
            else if fd 0 st1 fn 0 == 1 && fd 0 st1 fn 3 != -9 && sg.ret == 0 && dataKnown 0 st1 (fd 0 st1 fn 1) (fd 0 st1 fn 2) then
              let first : Ans := if lenI args == 0 then good 0 0 else ck st1 e locs (nthF 0 args 0) 0;
              (dataSig 0 st1 (fd 0 st1 fn 1) (fd 0 st1 fn 2) first.ty exp (lenI args)).ps
            else sg.ps;
          let ready : St := desugarArgs st1 e top args ps locs;
          if fd 0 ready fn 3 != -59 then ready
          else
            -- Carry the checked Array type through an unannotated receiver.
            let result : Ans := ck ready e locs id exp;
            if result.err != 0 then ready
            else
              let ann : St := alloc 0 ready 56 result.ty 0 0;
              let value : St := alloc 0 ann 5 (fd 0 ready id 1) (fd 0 ready id 2) (fd 0 ready id 3);
              setNode 0 value id 30 value.ret ann.ret 0
      else if t == 6 then
        let op : Int := fd 0 st id 1 % 100;
        let wt : Int := wordBinTy st e locs (fd 0 st id 1) (fd 0 st id 2) (fd 0 st id 3) exp;
        let left : Ans := if op == 5 || op == 6 || op == 16 then ck st e locs (fd 0 st id 2) 0 else bad 0 6;
        let listEq : Int := if left.err == 0 && ListEqualityNF.admit { operator := if op == 16 then 6 else op, left := left.ty, right := left.ty } then left.ty else 0;
        let appendResult : Ans := if (op == 13 || op == 14) && exp == 0 then ck st e locs id 0 else bad 0 6;
        let listAppend : Int := if appendResult.err == 0 && isListTy 0 appendResult.ty then appendResult.ty else 0;
        let lExp : Int := if listAppend > 0 then (if op == 13 then elemTy 0 listAppend else listAppend) else if listEq > 0 then listEq else if isWordTy wt then wt else if op == 13 && isListTy 0 exp then elemTy 0 exp else if op == 14 && isListTy 0 exp then exp else 0;
        let rExp : Int := if listAppend > 0 then listAppend else if listEq > 0 then listEq else if isWordTy wt then wt else if (op == 13 || op == 14) && isListTy 0 exp then exp else 0;
        let st1 : St := desugar st e top (fd 0 st id 2) locs lExp;
        let st2 : St := desugar st1 e top (fd 0 st1 id 3) locs rExp;
        let checked : St :=
          if listAppend > 0 then
            -- Carry ckBin's selected List type into lowering; cons head gets its element.
            let ann : St := alloc 0 st2 56 listAppend 0 0;
            let value : St := alloc 0 ann 6 op (fd 0 st2 id 2) (fd 0 st2 id 3);
            setNode 0 value id 30 value.ret ann.ret 0
          else if isWordTy wt then setAB 0 st2 id (wt * 100 + op) (fd 0 st2 id 2)
          else if listEq > 0 then
            -- Carry the checked operand type into lowering, including a
            -- list literal whose expected type would otherwise be absent.
            let ann : St := alloc 0 st2 56 listEq 0 0;
            let value : St := alloc 0 ann 30 (fd 0 st2 id 2) ann.ret 0;
            setAB 0 value id op value.ret
          else st2;
        if (ck checked e locs id exp).err == 0 then checked else st2
      else if t == 7 then
        let op : Int := fd 0 st id 1 % 100;
        let a : Ans := ck st e locs (fd 0 st id 2) (if isWordTy exp then exp else 0);
        let wt : Int := if a.err == 0 && isWordTy a.ty then a.ty else 0;
        let st1 : St := desugar st e top (fd 0 st id 2) locs (if op == 3 then wt else 0);
        if op == 3 && isWordTy wt then setAB 0 st1 id (wt * 100 + op) (fd 0 st1 id 2) else st1
      else if t == 11 then
        let elem : Int := if isListTy 0 exp then elemTy 0 exp else 0;
        desugarLi st e top (fd 0 st id 1) locs elem
      else if t == 13 then desugar st e top (fd 0 st id 1) locs exp
      else if t == 17 then desugar st e top (fd 0 st id 1) locs 0
      else if t == 29 then
        let st1 : St := desugar st e top (fd 0 st id 1) locs 0;
        desugarMethod st1 e top id id [] locs exp
      else if t == 30 then
        let ty : Int := decTy st e.heads (-1) (-1) (-1) (fd 0 st id 2);
        desugar st e top (fd 0 st id 1) locs (if ty > 0 then ty else exp)
      else if t == 14 then if fd 0 st id 3 < 0 then st else desugarInst st e top id locs exp
      else st

-- Explicit local function annotations use the existing takeArrows/lambdaLocs
-- signature check. Private single-name groups retain independent parameter
-- types before the existing capture and first-order inlining path.
partial def desugarLocal : St -> Env -> Int -> Int -> List Int -> Int -> St
  | st, e, top, id, locs, exp =>
    let pair : Int := fd 0 st id 3;
    let fn : Int := unwrapP st (fd 0 st pair 1);
    let annotation : Int := fd 0 st id 2;
    let declared : Got := if annotation >= 0 then takeArrows st e.heads [] annotation
      else { err := 0, xs := [], ret := 0 : Got };
    let st : St :=
      if annotation < 0 then localInferLambda st e fn locs
      else if declared.err != 0 then setErr 0 st (Int.toNat declared.err)
      else
        let typed : Got := lambdaLocs (lambdaDecls st e.heads (fd 0 st fn 1)) declared.xs;
        if typed.err != 0 then setErr 0 st (Int.toNat typed.err)
        else
          let groups : St := localInferGroups st (localInferScope typed.xs);
          setNode 0 groups fn 32 groups.ret (fd 0 st fn 2) (fd 0 st fn 3);
    let binds : Got := bindLocs st e.heads (fd 0 st fn 1);
    if st.err != 0 then st
    else if binds.err != 0 then setErr 0 st (Int.toNat binds.err)
    else
      let ret : Int := if annotation >= 0 then declared.ret else 0;
      let checked : St := desugar st e top (fd 0 st fn 2) (binds.xs ++ locs) ret;
      let result : Ans := ck checked e (binds.xs ++ locs) (fd 0 st fn 2) ret;
      if checked.err != 0 then checked
      else if result.err != 0 then setErr 0 checked (Int.toNat result.err)
      else
        let typed : St := setC 0 checked fn result.ty;
        let captured : St := localCapture typed e locs fn (fd 0 st pair 2) (fd 0 st id 1);
        let copy : Int := captured.ret;
        let rewritten : St := setNode 0 captured id (fd 0 captured copy 0) (fd 0 captured copy 1) (fd 0 captured copy 2) (fd 0 captured copy 3);
        desugar rewritten e top id locs exp

partial def desugarLocalApp : St -> Env -> Int -> Int -> List Int -> Int -> St
  | st, e, top, id, locs, exp =>
    let fn : Int := getFn st id;
    let args : List Int := getArgs st id;
    let st : St := localInferLambda st e fn locs;
    let binds : Got := bindLocs st e.heads (fd 0 st fn 1);
    let ps : List Int := localTypes (lambdaDecls st e.heads (fd 0 st fn 1));
    if binds.err != 0 then setErr 0 st (Int.toNat binds.err)
    else
      let ready : St := desugarArgs st e top args ps locs;
      let actuals : Ans := ckArgs ready e locs args ps;
      if ready.err != 0 then ready
      else if actuals.err != 0 then setErr 0 ready (Int.toNat actuals.err)
      else
        let expanded : St := localApply ready e (fd 0 ready fn 2) [] (localBinderAsts ready (fd 0 ready fn 1)) args;
        let copy : Int := expanded.ret;
        let rewritten : St := setNode 0 expanded id (fd 0 expanded copy 0) (fd 0 expanded copy 1) (fd 0 expanded copy 2) (fd 0 expanded copy 3);
        desugar rewritten e top id locs exp

-- Application heads resolve projections without applying their defaults early.
partial def desugarAlts : St -> Env -> Int -> Int -> List Int -> List Int -> Int -> St

  | st, e, top, alt, locs, pts, ret =>
    if st.err != 0 || alt < 0 then st
    else
      let ready : St := anonymousPats st e (fd 0 st alt 1) pts;
      let got : Got := ckPats ready e locs (fd 0 ready alt 1) pts;
      let locs2 : List Int := if got.err == 0 then got.xs else locs;
      let st1 : St := desugar ready e top (fd 0 ready alt 2) locs2 ret;
      desugarAlts st1 e top (fd 0 st1 alt 3) locs pts ret

partial def desugarLi : St -> Env -> Int -> Int -> List Int -> Int -> St

  | st, e, top, li, locs, elem =>
    if li < 0 then st
    else
      let st1 : St := desugar st e top (fd 0 st li 1) locs elem;
      desugarLi st1 e top (fd 0 st1 li 2) locs elem

-- Convert the complete method application before ordinary desugaring. In
-- particular, do not lower a bare application head before seeing its args.
partial def desugarMethod (st : St) (e : Env) (top id fn : Int) (args locs : List Int) (exp : Int) : St :=
  let recv : Int := fd 0 st fn 1;
  let r : Ans := ck st e locs recv 0;
  let sg : Sig := structMethodSig st e r.ty (fd 0 st fn 2) (fd 0 st fn 3);
  let i : Int := structReceiverIndex sg.ps r.ty;
  if r.err != 0 || sg.ret == 0 || i < 0 || Int.toNat i > lenI args then st
  else
    let named : St := alloc 0 st 1 sg.a sg.b 0;
    let app : St := applyDefaultArgs named named.ret (takeI args (Int.toNat i) ++ [recv] ++ dropI args (Int.toNat i));
    let copy : Int := app.ret;
    let rewritten : St := setNode 0 app id (fd 0 app copy 0) (fd 0 app copy 1) (fd 0 app copy 2) (fd 0 app copy 3);
    desugar rewritten e top id locs exp

partial def desugarRef : St -> Env -> Int -> Int -> List Int -> St

  | st, e, top, id, locs =>
    let a : Int := fd 0 st id 1;
    let b : Int := fd 0 st id 2;
    let dot : Int := lastDot st a b;
    let ps : Sig := prim 0 st a b;
    let fs : Sig := findSigE st e a b;
    let pinned : Bool := fd 0 st id 3 == -9;
    if dot < 0 || findLocal st locs a b >= 0 || (!pinned && (ps.ret != 0 || fs.ret != 0 || dataKnown 0 st a b)) then st
    else
      let st1 : St := alloc 0 st 1 a dot (if fd 0 st id 3 == -9 then -9 else 0);
      let base : Int := st1.ret;
      let st2 : St := desugar st1 e top base locs 0;
      let r : Ans := ck st2 e locs base 0;
      -- Keep a named record's existing projection lowering. Compound
      -- receivers and primitive methods still need checked desugaring.
      let namedReceiver : Bool := !pinned && (findSigE st2 e a dot).ret != 0;
      let compoundReceiver : Bool := fd 0 st2 base 0 == 5 || (lastDot st2 a dot >= 0 && !namedReceiver);
      let defaultMethod : Bool :=
        ((r.ty == 4 || isWordTy r.ty) && (primWordMethod st2 r.ty (dot + 1) b).ret != 0) || (compoundReceiver || namedReceiver) &&
        (if r.ty == 3 then (primStr 0 st2 (dot + 1) b).ret != 0
         else if r.ty == 1 then (primInt 0 st2 (dot + 1) b).ret != 0
         else if r.ty == 6 then (primCh 0 st2 (dot + 1) b).ret != 0
         else if r.ty == 4 || isWordTy r.ty then (primWordMethod st2 r.ty (dot + 1) b).ret != 0
         else compoundReceiver && fieldTy 0 st2 e r.ty (dot + 1) b > 0);
      if r.err != 0 then st
      else if (structMethodSig st2 e r.ty (dot + 1) b).ret != 0 || (dataMethod 0 st2 r.ty (dot + 1) b).ret != 0 || defaultMethod || containerOp 0 st2 r.ty (dot + 1) b != 0 || (fd 0 st2 base 0 == 29 && fieldTy 0 st2 e r.ty (dot + 1) b > 0) then
        setNode 0 st2 id 29 base (dot + 1) b
      else st

partial def desugarHof : St -> Env -> Int -> Int -> Int -> Int -> List Int -> List Int -> Int -> St

  | st, e, top, id, ty, op, args, locs, exp =>
    if lenI args != (if op == 24 then 2 else 1) then st
    else
      let st1 : St := if op == 24 then desugar st e top (nthF 0 args 1) locs exp else st;
      let init : Ans := if op == 24 then ck st1 e locs (nthF 0 args 1) exp else good 0 0;
      let ps : List Int := if op == 24 then [init.ty, elemTy 0 ty] else [if op == 30 then 6 else elemTy 0 ty];
      let ret : Int := if op == 22 then (if isListTy 0 exp then elemTy 0 exp else 0) else if op == 34 then (if isListTy 0 exp then exp else 0) else if op == 24 then init.ty else 2;
      let cb : Int := unwrapP st1 (nthF 0 args 0);
      let st0 : St := if fd 0 st1 cb 0 == 1 then expandDefDefaults st1 e top cb cb [] locs else st1;
      let fn : Int := getFn st0 cb;
      let sg : Sig := if fd 0 st0 cb 0 == 5 && fd 0 st0 fn 0 == 1 then findSigE st0 e (fd 0 st0 fn 1) (fd 0 st0 fn 2) else miss 0;
      let request : Rsdc.PartialCallbackNF.Request :=
        { parameters := sg.ps, supplied := lenI (getArgs st0 cb), expected := ps };
      if sg.ret != 0 && findLocal st0 locs (fd 0 st0 fn 1) (fd 0 st0 fn 2) < 0 && Rsdc.PartialCallbackNF.admit request 0 then
        let captured : St := capturePartialCallback st0 id cb fn ps sg.ret (getArgs st0 cb) sg.ps;
        let copy : Int := captured.ret;
        let rewritten : St := setNode 0 captured id (fd 0 captured copy 0) (fd 0 captured copy 1) (fd 0 captured copy 2) (fd 0 captured copy 3);
        desugar rewritten e top id locs exp
      else
        let st2 : St :=
          if fd 0 st0 cb 0 == 1 then
            let sg : Sig := callbackSig st0 e (fd 0 st0 cb 1) (fd 0 st0 cb 2);
            if sg.ret == 0 || !(eqListI sg.ps ps) || findLocal st0 locs (fd 0 st0 cb 1) (fd 0 st0 cb 2) >= 0 then st0
            else
              let copy : St := alloc 0 st0 1 (fd 0 st0 cb 1) (fd 0 st0 cb 2) 0;
              let lifted : St := liftCallback copy copy.ret ps [] [] sg.ret;
              setNode 0 lifted cb 32 (fd 0 lifted lifted.ret 1) (fd 0 lifted lifted.ret 2) sg.ret
          else st0;
        if fd 0 st2 cb 0 != 32 then st2
        else
          let binds : Got := lambdaLocs (lambdaDecls st2 e.heads (fd 0 st2 cb 1)) ps;
          if binds.err != 0 || init.err != 0 then st2
          else
            let st3 : St := annotateLambda st2 (fd 0 st2 cb 1) ps;
            let st4 : St := desugar st3 e top (fd 0 st3 cb 2) (binds.xs ++ locs) ret;
            let result : Ans := ck st4 e (binds.xs ++ locs) (fd 0 st4 cb 2) ret;
            if result.err != 0 then st4 else setC 0 st4 cb result.ty

partial def desugarArgs : St -> Env -> Int -> List Int -> List Int -> List Int -> St

  | st, _, _, [], _, _ => st
  | st, e, top, a :: as, ps, locs =>
    let p : Int := if lenI ps == 0 then 0 else nthF 0 ps 0;
    let ps2 : List Int := if lenI ps == 0 then [] else drop1 0 ps;
    let st1 : St := desugar st e top a locs p;
    desugarArgs st1 e top as ps2 locs

partial def desugarInst : St -> Env -> Int -> Int -> List Int -> Int -> St

  | st, e, top, id, locs, exp =>
    let tyN : Int := fd 0 st id 1;
    let withB : Int := fd 0 st id 3;
    let ann : Int := if tyN >= 0 then decTy st e.heads (-1) (-1) (-1) tyN else 0;
    let bExp : Int := if ann >= 100 && ann < 1000 then ann else if exp >= 100 && exp < 1000 then exp else 0;
    let st1 : St := if withB > 0 then desugar st e top (withB - 1) locs bExp else st;
    let chain0 : Int := fd 0 st1 id 2;
    let code0 : Int :=
      if ann >= 100 && ann < 1000 then ann
      else if exp >= 100 && exp < 1000 then exp
      else if withB > 0 then
        let bAns : Ans := ck st1 e locs (withB - 1) 0;
        if bAns.err == 0 && bAns.ty >= 100 && bAns.ty < 1000 then bAns.ty
        else -1
      else -1;
    -- Lean 4.14 StructInst.getStructName/elabStructInstAux: fields do not
    -- infer a structure; defer the whole instance until its type is known.
    let st2 : St :=
      if code0 >= 100 && code0 < 1000 then desugarFlds st1 e top chain0 locs code0
      else st1;
    let chain : Int := fd 0 st2 id 2;
    if code0 < 100 || code0 >= 1000 then st2
    else
      let si : Nat := Int.toNat (code0 - 100);
      let sa : Int := nthF 0 e.heads (si * 4);
      let sb : Int := nthF 0 e.heads (si * 4 + 1);
      let cnt : Nat := Int.toNat (nthF 0 e.heads (si * 4 + 2));
      if !(validInstFlds st2 e code0 chain) then st2
      else
        let stTy : St := if tyN >= 0 then st2 else alloc 0 st2 1 sa sb 0;
        let tyNode : Int := if tyN >= 0 then tyN else stTy.ret;
        let fdecl : Int := findStructFlds stTy top sa sb;
        if withB <= 0 then
          let st3 : St := fillDefaultFlds stTy fdecl chain;
          setNode 0 st3 id 14 tyNode st3.ret 0
        else
          let base : Int := withB - 1;
          let isLoc : Bool := fd 0 stTy base 0 == 1 && findLocal stTy locs (fd 0 stTy base 1) (fd 0 stTy base 2) >= 0;
          if isLoc then
            let bbs : List Int := spanBytes 0 stTy (fd 0 stTy base 1) (fd 0 stTy base 2);
            let st3 : St := fillWithFlds stTy fdecl chain bbs;
            setNode 0 st3 id 14 tyNode st3.ret 0
          else
            let ubs : List Int := [95, 95, 117] ++ natBytes (Int.toNat id);
            let st3 : St := synthIdent 0 stTy ubs;
            let nm : Int := st3.ret;
            let st4 : St := fillWithFlds st3 fdecl chain ubs;
            let st5 : St := alloc 0 st4 14 tyNode st4.ret 0;
            let instNode : Int := st5.ret;
            let st6 : St := alloc 0 st5 10 base instNode 0;
            setNode 0 st6 id 9 nm tyNode st6.ret

partial def desugarFlds : St -> Env -> Int -> Int -> List Int -> Int -> St

  | st, e, top, chain, locs, code =>
    if chain < 0 then st
    else
      let nm : Int := fd 0 st chain 1;
      let fty : Int := if code >= 100 && code < 1000 then fieldTy 0 st e code (fd 0 st nm 1) (fd 0 st nm 2) else 0;
      let st1 : St := desugar st e top (fd 0 st chain 2) locs (if fty > 0 then fty else 0);
      desugarFlds st1 e top (fd 0 st1 chain 3) locs code
end

-- Constructor names outlive unused templates in source name resolution. This
-- environment is used only before specialization, never by checking or emit.
partial def dataCtorScopeLis : St -> Int -> Env -> Env
  | st, li, e =>
    if li < 0 then e
    else
      let qs : List Int := qsp 0 st (fd 0 st (fd 0 st li 1) 1);
      let a : Int := nthI qs 0;
      let b : Int := nthI qs 1;
      let next : Env :=
        if findCtorB st e.icts 0 (spanBytes 0 st a b) >= 0 then e
        else
          { err := e.err, sigs := { a := a, b := b, ret := 1, ps := [] : Sig } :: e.sigs,
            heads := e.heads, fields := e.fields, abs := e.abs,
            icts := e.icts ++ [a, b, -1, 0, 0], iargs := e.iargs, indexed := false,
            sigNames := emptySigNameIndex, headNames := emptyIntsNameIndex, aliasNames := emptyIntsNameIndex : Env };
      dataCtorScopeLis st (fd 0 st li 2) next

partial def dataCtorScope : St -> Int -> Env -> Env
  | st, top, e =>
    if top < 0 then e
    else
      let d : Int := fd 0 st top 1;
      let t : Int := fd 0 st d 0;
      let next : Env :=
        if t == 38 && fd 0 st d 3 > 0 then dataCtorScopeLis st (fd 0 st d 2) e
        else if t == 28 then dataCtorScope st (fd 0 st d 1) e
        else if t == 34 || t == 36 then dataCtorScope st (fd 0 st d 2) e
        else e;
      dataCtorScope st (fd 0 st top 2) next

-- parse-tree prep: qualify decl names, resolve all type and value idents, desugar struct literals.
def prepSt : Nat -> St -> Int -> St
  | 0, st, top =>
    let st1 : St := qualDecls st top [];
    let e0 : Env := indexEnv st1 (walk st1 0 top (emptyEnv 0));
    if e0.err != 0 then st1
    else
      let scope : Env := indexEnv st1 (dataCtorScope st1 top e0);
      let typed : St := qExB st1 scope top [] [] [];
      let st2 : St := specializeData typed top;
      let heads : Env := indexEnv st2 (walk st2 0 top (emptyEnv 0));
      let e1 : Env := walk st2 1 top heads;
      if e1.err != 0 then st2
      else
        let e2 : Env := indexEnv st2 (walk st2 2 top e1);
        if e2.err != 0 then st2
        else
          let st3 : St := qExC st2 e2 top [] [] [] [];
          desugar st3 e2 top top [] 0
  | n + 1, st, top => prepSt n st top

structure Bw where
  err : Int
  pre : List Int
  ctx : List Int
  moved : Int
  bs : List Int
  ty : Int
  used : List Int
  deriving Inhabited

structure Fn where
  na : Int
  nb : Int
  ps : List Int
  ret : Int
  node : Int
  cals : List Int
  usesA : Int
  resA : Int
  part : Int
  bud : Int
  deriving Inhabited


def bwErr : Nat -> Int -> Bw
  | 0, e => { err := e, pre := [], ctx := [], moved := 0, bs := [], ty := 0, used := [] : Bw }
  | n + 1, e => bwErr n e

def bwOk : Nat -> List Int -> List Int -> Int -> List Int -> Int -> Bw
  | 0, pre, ctx, moved, bs, ty => { err := 0, pre := pre, ctx := ctx, moved := moved, bs := bs, ty := ty, used := [] : Bw }
  | n + 1, pre, ctx, moved, bs, ty => bwOk n pre ctx moved bs ty

-- The selected leaf belongs to this matrix, independent of matches in its body.
def bwUse (w : Bw) (used : List Int) : Bw :=
  { err := w.err, pre := w.pre, ctx := w.ctx, moved := w.moved,
    bs := w.bs, ty := w.ty, used := used : Bw }

def bwUsedRows : List Bw -> List Int
  | [] => []
  | b :: rest => b.used ++ bwUsedRows rest

def bwUsedOk (used : List Int) (n : Nat) (pre : List Int) (ctx : List Int)
    (moved : Int) (bs : List Int) (ty : Int) : Bw :=
  bwUse (bwOk n pre ctx moved bs ty) used

-- Heads and fields travel as one list: count, field triples (plus [-10, nPre] ++ recs),
-- count, head stride-4, count, ctor stride-5, count, ctor arg codes.
def packEF : List Int -> List Int -> List Int -> List Int -> List Int

  | fs, hs, ic, ia =>
    Int.ofNat (lenI fs) :: (fs ++ (Int.ofNat (lenI hs) ::
        (hs ++ (Int.ofNat (lenI ic) :: (ic ++ (Int.ofNat (lenI ia) :: ia))))))

def takeBeforeMark : List Int -> List Int

  | [] => []
  | x :: xs =>
    if x == -10 then [] else x :: takeBeforeMark xs

def afterMark : List Int -> List Int

  | [] => []
  | x :: xs =>
    if x == -10 then xs else afterMark xs

def fldsOf : List Int -> List Int

  | [] => []
  | k :: xs => takeBeforeMark (takeI xs (Int.toNat k))

def nPreOf : List Int -> Int

  | [] => 0
  | k :: xs =>
    let rest : List Int := afterMark (takeI xs (Int.toNat k));
    nthF 0 rest 0

def recsOf : List Int -> List Int

  | [] => []
  | k :: xs =>
    let rest : List Int := afterMark (takeI xs (Int.toNat k));
    dropI rest 1

def headsOf : List Int -> List Int

  | [] => []
  | k :: xs =>
    let rest : List Int := dropI xs (Int.toNat k);
    takeI (dropI rest 1) (Int.toNat (nthF 0 rest 0))

-- the packed tail after heads: [lenIC] ctor table, [lenIA] ctor arg codes.
-- packs written before the tail decode to empty tables.
def indsOf : List Int -> List Int

  | [] => []
  | k :: xs =>
    let rest : List Int := dropI xs (Int.toNat k);
    let l2 : List Int := dropI rest (1 + Int.toNat (nthF 0 rest 0));
    takeI (dropI l2 1) (Int.toNat (nthF 0 l2 0))

def iargsOf : List Int -> List Int

  | [] => []
  | k :: xs =>
    let rest : List Int := dropI xs (Int.toNat k);
    let l2 : List Int := dropI rest (1 + Int.toNat (nthF 0 rest 0));
    let l3 : List Int := dropI l2 (1 + Int.toNat (nthF 0 l2 0));
    takeI (dropI l3 1) (Int.toNat (nthF 0 l3 0))

partial def codesFrom : List Int -> Nat -> Nat -> Nat -> List Int

  | fs, first, j, cnt =>
    if j >= cnt then []
    else nthF 0 fs ((first + j) * 3 + 2) :: codesFrom fs first (j + 1) cnt

partial def fieldIx : St -> List Int -> Nat -> Nat -> Nat -> Int -> Int -> Int

  | st, fs, first, j, lim, na, nb =>
    if j >= lim then -1
    else if spanSame 0 st na nb (nthF 0 fs (j * 3)) (nthF 0 fs (j * 3 + 1)) then Int.ofNat (j - first)
    else fieldIx st fs first (j + 1) lim na nb

partial def flen : St -> Int -> Nat

  | st, chain => if chain < 0 then 0 else flen st (fd 0 st chain 3) + 1

-- Record keys on the wire are f0, f1, ... in field order. No Nat division.
def fiName : Nat -> List Int

  | i =>
    if i < 10 then [1, 2, 102, Int.ofNat (48 + i)]
    else if i < 20 then [1, 3, 102, 49, Int.ofNat (48 + i - 10)]
    else if i < 30 then [1, 3, 102, 50, Int.ofNat (48 + i - 20)]
    else if i < 40 then [1, 3, 102, 51, Int.ofNat (48 + i - 30)]
    else if i < 100 then [1, 3, 102, Int.ofNat (48 + i / 10), Int.ofNat (48 + i % 10)]
    else [1, 4, 102, Int.ofNat (48 + i / 100), Int.ofNat (48 + (i / 10) % 10), Int.ofNat (48 + i % 10)]

-- an SCC entry is an inductive head when its field-count slot is negative.
def hasIndRec : List Int -> List Int -> Bool

  | _, [] => false
  | hs, r :: rest =>
    if nthF 0 hs (Int.toNat r * 4 + 2) < 0 then true
    else hasIndRec hs rest

-- Opaque node handle, distinct from source Int. Code 8 is private to
-- the recursive-record prelude; source recursive codes map to the same type.
def heapHandleW : List Int
  := [7, 1, 1, 16, 99, 105, 98, 95, 104, 101, 97, 112, 95, 110, 111, 100, 101, 95, 118, 50, 0]

def heapMarkerW : List Int
  := [1, 16, 99, 105, 98, 95, 104, 101, 97, 112, 95, 110, 111, 100, 101, 95, 118, 50]

-- Universal Arena Node BootTy:
-- { f0 : i64, f1 : list handle(v2), f2..f4 : i64, f5..f6 : bool,
--   f7 : legacy str padding, f8 : list i64 }. Source strings use f8, never f7.
def arenaNodeTy : List Int
  := [7, 9] ++
      fiName 0 ++ [0] ++
      fiName 1 ++ [4] ++ heapHandleW ++
      fiName 2 ++ [0] ++
      fiName 3 ++ [0] ++
      fiName 4 ++ [0] ++
      fiName 5 ++ [1] ++
      fiName 6 ++ [1] ++
      fiName 7 ++ [2] ++
      fiName 8 ++ [4, 0]

def arenaListTy : List Int
  := [4] ++ arenaNodeTy

def hasI : Int -> List Int -> Bool

  | _, [] => false
  | c, x :: xs => x == c || hasI c xs

def hasTyErr : Nat -> List Int -> Bool
  | 0, [] => false
  | 0, x :: xs => x == -99 || hasTyErr 0 xs
  | n + 1, xs => hasTyErr n xs

-- New recursive inductives use precisely the typed emitter's Cib.Heap v1
-- node and nominal handle. ObjectStorage lowers these through ObjectLayout
-- and lib/rt; this is a wire selection, not a second physical heap layout.
-- Keep the previously accepted recursive-record wire bytes unchanged.
def indHeap : List Int -> Bool

  | pk => hasIndRec (headsOf pk) (recsOf pk)

def stringFields : List Int -> Nat -> Nat -> Bool
  | _, _, 0 => false
  | fs, first, n + 1 =>
    nthF 0 fs (first * 3 + 2) == 3 || stringFields fs (first + 1) n

def stringArgs : List Int -> Nat -> Nat -> Bool
  | _, _, 0 => false
  | args, first, n + 1 =>
    nthF 0 args first == 3 || stringArgs args (first + 1) n

def stringCtors : List Int -> List Int -> Nat -> Nat -> Bool
  | _, _, _, 0 => false
  | ctors, args, first, n + 1 =>
    stringArgs args (Int.toNat (nthF 0 ctors (first * 5 + 4)))
      (Int.toNat (nthF 0 ctors (first * 5 + 3))) || stringCtors ctors args (first + 1) n

def stringRecs : List Int -> List Int -> Bool
  | _, [] => false
  | pk, idx :: rest =>
    let hs : List Int := headsOf pk;
    let offset : Nat := Int.toNat idx * 4;
    let count : Int := nthF 0 hs (offset + 2);
    let first : Nat := Int.toNat (nthF 0 hs (offset + 3));
    (if count >= 0 then stringFields (fldsOf pk) first (Int.toNat count)
     else stringCtors (indsOf pk) (iargsOf pk) first (Int.toNat (-1 - count))) ||
      stringRecs pk rest

-- Reuse the existing v2 scalar-list channel for code-point strings. The
-- private legacy str slot stays empty, keeping the committed seed's ABI.
-- Programs without recursive String payloads retain their v1 wire bytes.
def arenaMagnitudeSlotRank (kind : Int) : Int :=
  if kind == 4 then 0 else if kind == 6 then 1 else if kind == 7 then 2 else kind - 7

def arenaMagnitudeSlot (kind index : Int) : Int :=
  if kind >= 10 || index >= 100 then -2 - (7 * index + arenaMagnitudeSlotRank kind)
  else kind * 100 + index

def arenaMagnitudeSlotKind (slot : Int) : Int :=
  if slot <= -2 then
    let rank : Int := (-2 - slot) % 7;
    if rank == 0 then 4 else if rank == 1 then 6 else if rank == 2 then 7 else rank + 7
  else slot / 100

def arenaMagnitudeSlotIndex (slot : Int) : Int :=
  if slot <= -2 then (-2 - slot) / 7 else slot % 100

def arenaMagnitudeCode (tc : Int) : Int :=
  if tc == 4 then 10 else if tc == 1 then 11
  else if isListTy 0 tc && elemTy 0 tc == 4 then 12
  else if isListTy 0 tc && elemTy 0 tc == 1 then 13 else 0

partial def arenaMagnitudeScan : List Int -> Nat -> Nat -> Nat -> Nat -> Bool
  | _, _, 0, _, _ => false
  | xs, first, left + 1, stride, offset =>
    arenaMagnitudeCode (nthF 0 xs (first * stride + offset)) != 0 ||
      arenaMagnitudeScan xs (first + 1) left stride offset

partial def arenaMagnitudeCtors : List Int -> List Int -> Nat -> Nat -> Bool
  | _, _, _, 0 => false
  | ctors, args, first, left + 1 =>
    arenaMagnitudeScan args (Int.toNat (nthF 0 ctors (first * 5 + 4)))
      (Int.toNat (nthF 0 ctors (first * 5 + 3))) 1 0 ||
      arenaMagnitudeCtors ctors args (first + 1) left

partial def arenaMagnitudeRecs : List Int -> List Int -> Bool
  | _, [] => false
  | pk, idx :: rest =>
    let hs : List Int := headsOf pk;
    let count : Int := nthF 0 hs (Int.toNat idx * 4 + 2);
    let first : Nat := Int.toNat (nthF 0 hs (Int.toNat idx * 4 + 3));
    (if count >= 0 then arenaMagnitudeScan (fldsOf pk) first (Int.toNat count) 3 2
     else arenaMagnitudeCtors (indsOf pk) (iargsOf pk) first (Int.toNat (-1 - count))) ||
      arenaMagnitudeRecs pk rest

def dataNode : List Int -> Bool
  | pk => !(indHeap pk) || stringRecs pk (recsOf pk) || arenaMagnitudeRecs pk (recsOf pk)

def handleTyW : List Int -> List Int

  | pk =>
    if dataNode pk then heapHandleW
    else [7, 1, 1, 16, 99, 105, 98, 95, 104, 101, 97, 112, 95, 110, 111, 100, 101, 95, 118, 49, 0]

def heapKeyW : List Int -> List Int

  | pk => takeI (dropI (handleTyW pk) 2) 18

def nodeTyW : List Int -> List Int

  | pk =>
    if dataNode pk then arenaNodeTy
    else [7, 8] ++ fiName 0 ++ [0] ++ fiName 1 ++ [4] ++ handleTyW pk ++
      fiName 2 ++ [0] ++ fiName 3 ++ [0] ++ fiName 4 ++ [0] ++
      fiName 5 ++ [1] ++ fiName 6 ++ [1] ++ fiName 7 ++ [2]

def arenaTyW : List Int -> List Int

  | pk => [4] ++ nodeTyW pk

def flatEnumCtors : List Int -> Nat -> Nat -> Bool

  | _, _, 0 => true
  | icts, first, left + 1 =>
    nthF 0 icts (first * 5 + 3) == 0 && flatEnumCtors icts (first + 1) left

def flatEnum : List Int -> Int -> Bool

  | pk, ty =>
    if ty < 30000 || ty >= 31000 then false
    else
      let i : Nat := Int.toNat (ty - 30000);
      let hs : List Int := headsOf pk;
      let cnt : Int := 0 - 1 - nthF 0 hs (i * 4 + 2);
      cnt > 0 && !(hasI (ty - 30000) (recsOf pk)) &&
        flatEnumCtors (indsOf pk) (Int.toNat (nthF 0 hs (i * 4 + 3))) (Int.toNat cnt)

-- Semantic node slots match TypedScmCore.layoutAccessors: enum and integer
-- share the three scalar slots; children keep source order. The physical
-- byte offsets are determined only by the shared ObjectLayout function.
partial def ctorSlotGo : List Int -> Nat -> Nat -> Nat -> Int -> Int -> Int -> Int -> Int
  | pk, first, j, target, ni, nb, ns, nk =>
    let tc : Int := nthF 0 (iargsOf pk) (first + j);
    let numeric : Int := arenaMagnitudeCode tc;
    let k : Int :=
      if numeric != 0 then arenaMagnitudeSlot numeric nk
      else if tc == 5 || tc == 6 || isWordTy tc || flatEnum pk tc then (if ni < 3 then 100 + ni else -1)
      else if tc == 2 then (if nb < 2 then 200 + nb else -1)
      else if tc == 3 then (if ns < 1 then 900 else -1)
      else if tc >= 30000 && tc < 31000 && hasI (tc - 30000) (recsOf pk) then arenaMagnitudeSlot 4 nk
      else if tc >= 100 && tc < 1000 && hasI (tc - 100) (recsOf pk) then arenaMagnitudeSlot 4 nk
      else -1;
    let kind : Int := arenaMagnitudeSlotKind k;
    if k == -1 || j == target then k
    else ctorSlotGo pk first (j + 1) target (ni + (if kind == 1 then 1 else 0))
      (nb + (if kind == 2 then 1 else 0)) (ns + (if tc == 3 then 1 else 0))
      (nk + (if kind == 4 || numeric != 0 then 1 else 0))

def ctorSlot : List Int -> Int -> Nat -> Int

  | pk, ci, j =>
    ctorSlotGo pk (Int.toNat (nthF 0 (indsOf pk) (Int.toNat ci * 5 + 4))) 0 j 0 0 0 0

partial def checkIndFields : List Int -> Nat -> Nat -> Int

  | pk, ci, j =>
    let icts : List Int := indsOf pk;
    if ci * 5 >= lenI icts then 0
    else if !(hasI (nthF 0 icts (ci * 5 + 2)) (recsOf pk)) then checkIndFields pk (ci + 1) 0
    else if j >= Int.toNat (nthF 0 icts (ci * 5 + 3)) then checkIndFields pk (ci + 1) 0
    else if ctorSlot pk (Int.ofNat ci) j == -1 then 8
    else checkIndFields pk ci (j + 1)

-- Private structural ABI: source-generated field names are f0,f1,... .
-- Existing SCM record/list kinds remain unchanged. Digits are canonical LE
-- base256; zero=[]; Int zero has a false sign. Certificates must establish it.
def natMagnitudeMarker : List Int := [1,8,0,78,97,116,77,97,103,49]
def intMagnitudeSignMarker : List Int := [1,8,0,73,110,116,83,103,110,49]
def intMagnitudeMarker : List Int := [1,8,0,73,110,116,77,97,103,49]
def natMagnitudeTyW : List Int := [7,1] ++ natMagnitudeMarker ++ [4,0]
def intMagnitudeTyW : List Int := [7,2] ++ intMagnitudeSignMarker ++ [1] ++ intMagnitudeMarker ++ [4,0]

-- WIRE-SEQ-0: element width in bits of a sequence of source element type c: 8, 16, 32 for
-- UInt8, UInt16, UInt32 elements; 0 for every other element (a full word, a magnitude or an object).
def seqWidth (c : Int) : Int := if isWordTy c then wordWidth c else 0

mutual
partial def tyW : List Int -> Int -> List Int

  | pk, c =>
    if c == 1 then intMagnitudeTyW
    else if c == 4 then natMagnitudeTyW
    -- WIRE-SEQ-0 rev 2: a fixed-width scalar says its width (tag 11, bits); it still means a word.
    else if isWordTy c then [11, wordWidth c]
    else if c == 6 then [0]
    else if c == 2 then [1]
    else if c == 3 then [4, 0]
    else if c == 8 then handleTyW pk
    else if c == 2000 then arenaTyW pk
    else if c >= 30000 && c < 31000 then
      let idx : Int := c - 30000;
      let recs : List Int := recsOf pk;
      if hasI idx recs then handleTyW pk
      else if indHeap pk && flatEnum pk c then [0]
      else
        let i : Nat := Int.toNat idx;
        let hs : List Int := headsOf pk;
        let ccnt : Int := 0 - 1 - nthF 0 hs (i * 4 + 2);
        let first : Int := nthF 0 hs (i * 4 + 3);
        let icts : List Int := indsOf pk;
        let iargs : List Int := iargsOf pk;
        if ccnt == 1 then
          let cix : Nat := Int.toNat first;
          let ac : Int := nthF 0 icts (cix * 5 + 3);
          let fa : Nat := Int.toNat (nthF 0 icts (cix * 5 + 4));
          if ac == 0 then [7, 0]
          else [7, ac] ++ fiName 0 ++ tyW pk (nthF 0 iargs fa) ++ indSumW pk icts iargs first 0 1 1
        else [6, ccnt] ++ indSumW pk icts iargs first 0 0 ccnt
    else if isListTy 0 c then [4] ++ tyW pk (elemTy 0 c)
    else if isOptionTy 0 c then [8] ++ tyW pk (elemTy 0 c)
    else if isProductTy 0 c then [7, 2] ++ fiName 0 ++ tyW pk (productLeft 0 c) ++ fiName 1 ++ tyW pk (productRight 0 c)
    else if basicKind 0 c == 4 then
      -- The typed emitter still gives Array Char a special text lowering.
      -- Preserve that subset boundary rather than emit incompatible bytes.
      -- WIRE-SEQ-0: tag 10 = sequence with its source kind (4 Array) and element width.
      if basicFirst 0 c == 6 then [-99] else [10, 4, seqWidth (basicFirst 0 c)] ++ tyW pk (basicFirst 0 c)
    else if basicKind 0 c == 5 then
      -- Bounded extensional adapter, from HashMapCompositions.lean. No
      -- bucket/traversal-order claim; scalar keys and payloads only.
      if !(dataKey (basicFirst 0 c)) || !(dataKey (basicSecond 0 c)) then [-99]
      else [7,1] ++ fiName 0 ++ [4,7,2] ++ fiName 0 ++ tyW pk (basicFirst 0 c) ++ fiName 1 ++ tyW pk (basicSecond 0 c)
    -- Lean 4.14: String.Pos is a Nat wrapper; ByteArray wraps Array UInt8;
    -- Substring stores str/startPos/stopPos. Erase wrappers to existing forms.
    else if c == 5 then natMagnitudeTyW
    else if basicKind 0 c == 2 then [10, 2, 8, 0]
    else if basicKind 0 c == 3 then [7,3] ++ fiName 0 ++ [4,0] ++ fiName 1 ++ natMagnitudeTyW ++ fiName 2 ++ natMagnitudeTyW
    else if isBasicTy 0 c then [-99]
    else if c >= 100 then
      let idx : Int := c - 100;
      let recs : List Int := recsOf pk;
      if hasI idx recs then handleTyW pk
      else
        let i : Nat := Int.toNat idx;
        let hs : List Int := headsOf pk;
        let first : Int := nthF 0 hs (i * 4 + 3);
        let cnt : Int := nthF 0 hs (i * 4 + 2);
        [7, cnt] ++ recFs pk first 0 cnt
    else [0]

-- sum summands: a one-arg payload is unboxed; zero and many-arg payloads
-- are records, matching the typed emitter.
partial def indSumW : List Int -> List Int -> List Int -> Int -> Int -> Int -> Int -> List Int

  | pk, icts, iargs, first, j, k, cnt =>
    if j >= cnt then []
    else
      let cix : Nat := Int.toNat (first + j);
      let ac : Int := nthF 0 icts (cix * 5 + 3);
      let fa : Nat := Int.toNat (nthF 0 icts (cix * 5 + 4));
      if k > 0 then
        if k < ac then
          fiName (Int.toNat k) ++ tyW pk (nthF 0 iargs (fa + Int.toNat k)) ++ indSumW pk icts iargs first j (k + 1) cnt
        else indSumW pk icts iargs first (j + 1) 0 cnt
      else if ac == 1 then
        tyW pk (nthF 0 iargs fa) ++ indSumW pk icts iargs first (j + 1) 0 cnt
      else if ac == 0 then
        [7, 0] ++ indSumW pk icts iargs first (j + 1) 0 cnt
      else
        [7, ac] ++ fiName 0 ++ tyW pk (nthF 0 iargs fa) ++ indSumW pk icts iargs first j 1 cnt

partial def recFs : List Int -> Int -> Int -> Int -> List Int

  | pk, first, j, cnt =>
    if j >= cnt then []
    else
      let fs : List Int := fldsOf pk;
      let tc : Int := nthF 0 fs (Int.toNat (first + j) * 3 + 2);
      fiName (Int.toNat j) ++ tyW pk tc ++ recFs pk first (j + 1) cnt
end

def tyNest : List Int -> List Int -> List Int

  | pk, [] =>
    let _pk : List Int := pk;
    []
  | pk, t :: ts =>
    if lenI ts == 0 then tyW pk t
    else [5] ++ tyW pk t ++ tyNest pk ts

def wrapResTy : List Int -> Int -> List Int

  | pk, c =>
    [7, 2] ++ fiName 0 ++ tyW pk c ++ fiName 1 ++ arenaTyW pk

def wrapResVal : List Int -> List Int -> List Int -> List Int

  | _pk, vBs, arBs =>
    [34] ++ fiName 0 ++ vBs ++ ([34] ++ fiName 1 ++ arBs ++ [33])

def projF0 : List Int -> Int -> List Int -> List Int

  | pk, c, eBs =>
    [35] ++ wrapResTy pk c ++ [0] ++ eBs

def projF1 : List Int -> Int -> List Int -> List Int

  | pk, c, eBs =>
    [35] ++ wrapResTy pk c ++ [1] ++ eBs

-- Tarjan strongly connected components on the structure type dependency graph.
partial def tyStructDeps : Int -> List Int

  | c =>
    if c >= 30000 && c < 31000 then [c - 30000]
    else if isProductTy 0 c then tyStructDeps (productLeft 0 c) ++ tyStructDeps (productRight 0 c)
    else if isListTy 0 c || isOptionTy 0 c then tyStructDeps (elemTy 0 c)
    else if basicKind 0 c == 4 then tyStructDeps (basicFirst 0 c)
    else if c >= 100 && c < 1000 then [c - 100]
    else []

partial def structDepsGo : List Int -> Nat -> Nat -> Nat -> List Int

  | fs, first, j, cnt =>
    if j >= cnt then []
    else
      let tc : Int := nthF 0 fs ((first + j) * 3 + 2);
      let ds : List Int := tyStructDeps tc;
      let rest : List Int := structDepsGo fs first (j + 1) cnt;
      ds ++ rest

-- j is an absolute offset in iargs; ac is the remaining slice length.
-- Later constructors can start past ac, so ac is not an end offset.
partial def iArgDeps : List Int -> Nat -> Nat -> List Int

  | iargs, j, ac =>
    if ac == 0 then []
    else
      let ds : List Int := tyStructDeps (nthF 0 iargs j);
      let rest : List Int := iArgDeps iargs (j + 1) (ac - 1);
      ds ++ rest

-- all ctor args of inductive head i.
partial def indDepsGo : List Int -> List Int -> Nat -> Nat -> Nat -> List Int

  | icts, iargs, first, j, ccnt =>
    if j >= ccnt then []
    else
      let ac : Nat := Int.toNat (nthF 0 icts ((first + j) * 5 + 3));
      let fa : Nat := Int.toNat (nthF 0 icts ((first + j) * 5 + 4));
      iArgDeps iargs fa ac ++ indDepsGo icts iargs first (j + 1) ccnt

def structDeps : List Int -> List Int -> List Int -> List Int -> Int -> List Int

  | hs, fs, icts, iargs, idx =>
    let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let raw : Int := nthF 0 hs (i * 4 + 2);
      if raw < 0 then indDepsGo icts iargs first 0 (Int.toNat (0 - 1 - raw))
      else structDepsGo fs first 0 (Int.toNat raw)

-- Build adjacency once; the SCC walk is lib/Tarjan.rsd's implementation.
-- EMIT-FUEL handles the general adjacency construction on the emitted route.
partial def recStructsGo : List Int -> List Int -> List Int -> List Int -> Nat -> Nat -> List (List Int) -> TjState

  | hs, fs, icts, iargs, i, count, graph =>
    if i >= count then tarjan graph
    else recStructsGo hs fs icts iargs (i + 1) count (graph ++ [structDeps hs fs icts iargs (Int.ofNat i)])

def recStructsOf : List Int -> List Int -> List Int -> List Int -> TjState

  | hs, fs, icts, iargs =>
    recStructsGo hs fs icts iargs 0 (Int.toNat (tjLen hs) / 4) []

def delI : Int -> List Int -> List Int

  | _, [] => []
  | c, x :: xs => if x == c then xs else x :: delI c xs

-- Check if a recursive structure's fields fit in Node (err = 8 rsdc_arena_field).
partial def countArenaFlds : List Int -> List Int -> Nat -> Nat -> Nat -> Int -> Int -> Int -> Int -> Int -> List Int
  | fs, recs, first, j, cnt, ni, nb, ns, nl, nk =>
    if j >= cnt then [ni, nb, ns, nl, nk, 0]
    else
      let tc : Int := nthF 0 fs ((first + j) * 3 + 2);
      if arenaMagnitudeCode tc != 0 then countArenaFlds fs recs first (j + 1) cnt ni nb ns nl (nk + 1)
      else if tc == 5 || tc == 6 || isWordTy tc then countArenaFlds fs recs first (j + 1) cnt (ni + 1) nb ns nl nk
      else if tc == 2 then countArenaFlds fs recs first (j + 1) cnt ni (nb + 1) ns nl nk
      else if tc == 3 then countArenaFlds fs recs first (j + 1) cnt ni nb (ns + 1) nl nk
      else if tc >= 100 && tc < 1000 && hasI (tc - 100) recs then countArenaFlds fs recs first (j + 1) cnt ni nb ns nl (nk + 1)
      else if tc >= 30000 && tc < 31000 then
        if hasI (tc - 30000) recs then countArenaFlds fs recs first (j + 1) cnt ni nb ns nl (nk + 1)
        else [ni, nb, ns, nl, nk, 1]
      else if isListTy 0 tc then
        let elem : Int := elemTy 0 tc;
        if isWordTy elem || (elem >= 100 && elem < 1000 && hasI (elem - 100) recs) then
          countArenaFlds fs recs first (j + 1) cnt ni nb ns (nl + 1) nk
        else [ni, nb, ns, nl, nk, 1]
      else [ni, nb, ns, nl, nk, 1]

def checkArenaStructsGo : List Int -> List Int -> List Int -> List Int -> Int

  | _, _, _, [] => 0
  | hs, fs, recs, idx :: rest =>
    let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
      let cs : List Int := countArenaFlds fs recs first 0 cnt 0 0 0 0 0;
      let nb : Int := nthF 0 cs 1;
      let ns : Int := nthF 0 cs 2;
      let bad : Int := nthF 0 cs 5;
      if bad > 0 || nb > 2 || ns > 1 then 8
      else checkArenaStructsGo hs fs recs rest

def checkArenaStructs : List Int -> List Int -> List Int -> Int

  | hs, fs, recs =>
    checkArenaStructsGo hs fs recs recs

def checkV1Records : List Int -> List Int -> List Int -> List Int -> Int

  | _, _, _, [] => 0
  | hs, fs, recs, i :: rest =>
    let cnt : Int := nthF 0 hs (Int.toNat i * 4 + 2);
    if cnt < 0 then checkV1Records hs fs recs rest
    else
      let first : Nat := Int.toNat (nthF 0 hs (Int.toNat i * 4 + 3));
      let cs : List Int := countArenaFlds fs recs first 0 (Int.toNat cnt) 0 0 0 0 0;
      if nthF 0 cs 0 > 3 || nthF 0 cs 3 > 0 then 8
      else checkV1Records hs fs recs rest

def checkHeapTypes : Env -> List Int -> Int

  | e, recs =>
    let old : Int := checkArenaStructs e.heads e.fields recs;
    if old != 0 then old
    else if !(hasIndRec e.heads recs) then 0
    else
      let pk : List Int := packEF (e.fields ++ [-10, 4] ++ recs) e.heads e.icts e.iargs;
      let v : Int := checkV1Records e.heads e.fields recs recs;
      if v != 0 then v else checkIndFields pk 0 0

def foldTy : List Int -> List Int -> List Int

  | _, [] => []
  | pk, t :: ts => tyW pk t ++ foldTy pk ts

def lenLL : List (List Int) -> Nat

  | [] => 0
  | _ :: xs => lenLL xs + 1

def nestBs : List (List Int) -> List Int

  | [] =>
    []
  | b :: bs =>
    if lenLL bs == 0 then b
    else [28] ++ b ++ nestBs bs

def projBytes : List Int -> List Int -> Nat -> List Int -> List Int

  | pk, [], _, e =>
    let _pk : List Int := pk;
    e
  | pk, t :: ts, k, e =>
    if lenI ts == 0 then e
    else if k == 0 then [29] ++ tyNest pk (t :: ts) ++ e
    else projBytes pk ts (k - 1) ([30] ++ tyNest pk (t :: ts) ++ e)

def le8 : Nat -> Int -> List Int
  | 0, _ => []
  | n + 1, x =>
    let q : Int := x / 256;
    let r : Int := x - q * 256;
    r :: le8 n q

def litI : Int -> List Int

  | x =>
    [0, 0] ++ le8 8 x

partial def magnitudeLiteralWire : List Int -> List Int
  | [] => [22]
  | d :: ds => [26,23] ++ litI d ++ magnitudeLiteralWire ds

def natMagnitudeLiteralWire (ds : List Int) : List Int :=
  [34] ++ natMagnitudeMarker ++ magnitudeLiteralWire ds ++ [33]

def intMagnitudeLiteralWire (negative : Bool) (ds : List Int) : List Int :=
  [34] ++ intMagnitudeSignMarker ++ [1,if negative && lenI ds != 0 then 1 else 0] ++
    [34] ++ intMagnitudeMarker ++ magnitudeLiteralWire ds ++ [33]

def natToIntMagnitudeW (input : List Int) : List Int :=
  [-600023,1] ++ input ++ [0]

partial def leb : Int -> List Int

  | x =>
    if x < 128 then [x]
    else
      let q : Int := x / 128;
      let r : Int := x - q * 128;
      (r + 128) :: leb q

def varB : Int -> List Int

  | i =>
    [3] ++ leb i

def natToIntMagnitudeBoundW : List Int :=
  [34] ++ intMagnitudeSignMarker ++ [1,0] ++ [34] ++ intMagnitudeMarker ++
    [35] ++ natMagnitudeTyW ++ [0] ++ varB 0 ++ [33]


-- Canonical LE base256 comparison, mechanically reused from CompareWire.rsd.
-- Knuth TAOCP 4.3.1: the highest differing digit decides. No magnitude is
-- reconstructed in a scalar. Existing listFold opcode 50 visits each digit.
def magnitudeCompareBoundW : List Int :=
  let stateTy : List Int := [7,2] ++ fiName 0 ++ [4,0] ++ fiName 1 ++ [0];
  let rest : List Int := [35] ++ stateTy ++ [0] ++ varB 1;
  let old : List Int := [35] ++ stateTy ++ [1] ++ varB 1;
  let empty : List Int := [14,4,0] ++ rest ++ [22];
  let current : List Int := [5,12] ++ varB 0 ++ [39,25] ++ rest ++ litI (-1) ++
    [5,12,39,25] ++ rest ++ varB 0 ++ litI 1 ++ old;
  let step : List Int := [34] ++ fiName 0 ++ [27] ++ litI 1 ++ rest ++
    [34] ++ fiName 1 ++ [5] ++ empty ++ litI 1 ++ current ++ [33];
  let initial : List Int := [34] ++ fiName 0 ++ varB 0 ++ [34] ++ fiName 1 ++ litI 0 ++ [33];
  let folded : List Int := [50,4,0] ++ varB 1 ++ initial ++ step;
  let done : List Int := [5,14,4,0,35] ++ stateTy ++ [0] ++ varB 0 ++ [22,35] ++ stateTy ++ [1] ++ varB 0 ++ litI (-1);
  [4,4,0,35] ++ natMagnitudeTyW ++ [0] ++ varB 1 ++
    [4,4,0,35] ++ natMagnitudeTyW ++ [0] ++ varB 1 ++ [4] ++ stateTy ++ folded ++ done

-- Evaluate both ordinary operands once in their existing context, then bind
-- them at slots 1/0 for a fixed inline body. Pair construction evaluates fields
-- left to right; no variable shifting or helper-function index is required.
def magnitudeApply2W (tw body left right : List Int) : List Int :=
  let pairTy : List Int := [7,2] ++ fiName 0 ++ tw ++ fiName 1 ++ tw;
  [4] ++ pairTy ++ [34] ++ fiName 0 ++ left ++ [34] ++ fiName 1 ++ right ++ [33] ++
  [4] ++ tw ++ [35] ++ pairTy ++ [0] ++ varB 0 ++
