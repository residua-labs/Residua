        let next : Mx := { pats := mx.pats, alts := mx.alts, scrs := shiftScruts mx.scrs 1, tys := mx.tys, als := shiftSeg mx.als 1, ncol := mx.ncol : Mx };
        let body : Bw := lowProductFields st hd fs next ctx2 (major + 1) code (j + 1) (shiftScruts scrs 1 ++ [0]) (tys ++ [fty]) ret;
        if body.err != 0 then body
        else if body.moved == 0 then bwUsedOk body.used 0 [] ctx 0 ([4] ++ tw ++ value ++ body.bs) body.ty
        else bwUsedOk body.used 0 ([4] ++ tw ++ value ++ body.pre) body.ctx (body.moved + 1) body.bs body.ty

-- Bind each projection once; nested field patterns use the ordinary matrix.
partial def lowRecordFields : St -> List Int -> List Fn -> Mx -> List Int -> Int -> Int -> Nat -> Nat -> Nat -> List Int -> List Int -> Int -> Bw

  | st, hd, fs, mx, ctx, major, code, first, j, cnt, scrs, tys, ret =>
    if j >= cnt then
      lowMx st hd fs { pats := mx.pats, alts := mx.alts, scrs := scrs ++ mx.scrs, tys := tys ++ mx.tys, als := mx.als, ncol := mx.ncol : Mx } ctx ret
    else
      let fty : Int := nthF 0 (fldsOf hd) ((first + j) * 3 + 2);
      let tw : List Int := tyW hd fty;
      let recursive : Bool := hasI (code - 100) (recsOf hd);
      let slot : Int := fldKindSlot hd (code - 100) j;
      let arena : List Int := if recursive then arenaBs hd ctx else [];
      if hasTyErr 400 tw then bwErr 0 9
      else if recursive && (slot == -1 || lenI arena == 0) then bwErr 0 8
      else
        let value : List Int := if recursive then arenaFieldRead hd arena (varB major) slot else [35] ++ tyW hd code ++ leb (Int.ofNat j) ++ varB major;
        let ctx2 : List Int := -1 :: -1 :: fty :: shiftTrailer ctx 1;
