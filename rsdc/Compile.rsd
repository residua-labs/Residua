            let b : Bw := low st hd fs a.ctx r a.ty;
            if b.err != 0 then b
            else if b.ty != a.ty then bwErr 0 6
            else if a.moved != 0 && b.moved != 0 then
              -- Keep the computed left value before the right computation
              -- changes the context; a computation may return an arena wrapper.
              let kept : List Int := -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1;
              let next : Bw := low st hd fs kept r a.ty;
              if next.err != 0 then next
              else if next.ty != a.ty then bwErr 0 6
              else
                let eq : List Int := [14] ++ tw ++ varB next.moved ++ next.bs;
                let resBs : List Int := if op == 5 then eq else [17] ++ eq;
                bwOk 0 (a.pre ++ [4] ++ tw ++ a.bs ++ next.pre) next.ctx (a.moved + 1 + next.moved) resBs 2
            else
              let aBs : List Int := if b.moved == 0 then a.bs else (low st hd fs b.ctx l a.ty).bs;
              let eq : List Int := [14] ++ tw ++ aBs ++ b.bs;
              let resBs : List Int := if op == 5 then eq else [17] ++ eq;
              bwOk 0 (a.pre ++ b.pre) b.ctx (a.moved + b.moved) resBs 2
      else
        let keep : Bool := a.moved != 0;
        let nextCtx : List Int := if keep then -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1 else a.ctx;
        let b : Bw := low st hd fs nextCtx r a.ty;
        if b.err != 0 then b
        else if b.ty != a.ty then bwErr 0 6
        else
          let tw : List Int := tyW hd a.ty;
          if hasTyErr 400 tw then bwErr 0 9
          else
            let aBs : List Int :=
              if keep then varB b.moved
              else if b.moved == 0 then a.bs
              else (low st hd fs b.ctx l a.ty).bs;
            let saved : List Int := if keep then [4] ++ tw ++ a.bs else [];
            let eq : List Int := [14] ++ tw ++ aBs ++ b.bs;
            let resBs : List Int := if op == 5 then eq else [17] ++ eq;
            bwOk 0 (a.pre ++ saved ++ b.pre) b.ctx (a.moved + (if keep then 1 else 0) + b.moved) resBs 2
    else if op == 13 then
      let elem : Int := if isListTy 0 exp then elemTy 0 exp else 0;
      let a : Bw := low st hd fs ctx l elem;
      if a.err != 0 then a
      else if a.ty == 5 || hasBasicTy a.ty then bwErr 0 16
      else
        let keep : Bool := a.moved != 0;
        let nextCtx : List Int := if keep then -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1 else a.ctx;
        let b : Bw := low st hd fs nextCtx r (if isListTy 0 exp then exp else 0);
        if b.err != 0 then b
        else
          let aBs : List Int :=
            if keep then varB b.moved
            else if b.moved == 0 then a.bs
            else (low st hd fs b.ctx l elem).bs;
          let saved : List Int := if keep then [4] ++ tyW hd a.ty ++ a.bs else [];
          bwOk 0 (a.pre ++ saved ++ b.pre) b.ctx (a.moved + (if keep then 1 else 0) + b.moved) ([26, 23] ++ aBs ++ b.bs) (if isListTy 0 exp then exp else b.ty)
    else if op == 14 then
      let a : Bw := low st hd fs ctx l exp;
      if a.err != 0 then a
      else if a.ty == 5 || hasBasicTy a.ty then bwErr 0 16
      else
        let b : Bw := low st hd fs a.ctx r exp;
        if b.err != 0 then b
        else if a.moved != 0 && b.moved != 0 then
          -- Retain the computed left list, whose arena wrapper can hold a
          -- different type, before the right list introduces more bindings.
          let kept : List Int := -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1;
          let next : Bw := low st hd fs kept r exp;
          if next.err != 0 then next
          else bwOk 0 (a.pre ++ [4] ++ tyW hd a.ty ++ a.bs ++ next.pre) next.ctx
            (a.moved + 1 + next.moved) ([26] ++ varB next.moved ++ next.bs)
            (if isListTy 0 a.ty then a.ty else next.ty)
        else
          let aBs : List Int := if b.moved == 0 then a.bs else (low st hd fs b.ctx l exp).bs;
          bwOk 0 (a.pre ++ b.pre) b.ctx (a.moved + b.moved) ([26] ++ aBs ++ b.bs) (if isListTy 0 a.ty then a.ty else b.ty)
    else if op == 7 || op == 8 || op == 9 || op == 10 then
      let first : Bw := low st hd fs ctx l hint;
      -- ckBin resolves an inferred Nat literal from the right's concrete type.
      -- Re-lower both operands under that type/context; annotations still fit.
      let other : Bw := if first.err == 0 && first.ty == 4 then low st hd fs first.ctx r 0 else first;
      let a : Bw :=
        if first.err == 0 && first.ty == 4 && other.err == 0 && other.ty != 4 && other.ty != 0 then
          low st hd fs ctx l other.ty
        else first;
      if a.err != 0 then a
      else if first.err == 0 && first.ty == 4 && other.err == 0 && other.ty != 4 && other.ty != 0 && a.ty != other.ty then bwErr 0 6
      else if a.ty != 5 && hasBasicTy a.ty then bwErr 0 16
      else
        let keep : Bool := a.moved != 0;
        let nextCtx : List Int := if keep then -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1 else a.ctx;
        let b : Bw := low st hd fs nextCtx r a.ty;
        if b.err != 0 then b
        else if b.ty != a.ty then bwErr 0 6
        else
          let aBs : List Int :=
            if keep then varB b.moved
            else if b.moved == 0 then a.bs
            else (low st hd fs b.ctx l a.ty).bs;
          let saved : List Int := if keep then [4] ++ tyW hd a.ty ++ a.bs else [];
          let resBs : List Int :=
            if a.ty == 4 || a.ty == 5 then magnitudeNatOrderW op aBs b.bs
            else if a.ty == 1 then magnitudeIntOrderW op aBs b.bs
            else if op == 7 then [12] ++ aBs ++ b.bs
            else if op == 8 then [12] ++ b.bs ++ aBs
            else if op == 9 then [17, 12] ++ b.bs ++ aBs
            else [17, 12] ++ aBs ++ b.bs;
          bwOk 0 (a.pre ++ saved ++ b.pre) b.ctx (a.moved + (if keep then 1 else 0) + b.moved) resBs 2
    else if (op >= 1 && op <= 4) || op == 15 then
      let a : Bw := low st hd fs ctx l exp;
      if a.err != 0 then a
      else if a.ty == 5 && (op == 1 || op == 2) then
        -- Lean 4.14 Init/Prelude.lean:2487-2497. Infer before the Char/String split.
        let b : Bw := low st hd fs a.ctx r 0;
        if b.err != 0 then b
        else if b.ty == 5 then lowArith st hd fs ctx op l r exp a b
        else if op == 1 && (b.ty == 6 || b.ty == 3) then
          let ps : List Int := [5,b.ty];
          lowBasicArgs st hd fs ctx [l,r] ps ps (if b.ty == 6 then 110 else 111) 5 5 []
        else if b.ty == 4 then
          let pos : Bw := low st hd fs a.ctx r 5;
          if pos.err != 0 then pos
          else if pos.ty != 5 then bwErr 0 16
          else lowArith st hd fs ctx op l r exp a pos
        else bwErr 0 16
      else if a.ty == 5 || hasBasicTy a.ty then bwErr 0 16
      else
        let hinted : Bw := low st hd fs a.ctx r a.ty;
        -- A left operand of type Nat under no expected type may be a numeral, and a numeral
        -- takes the type of the other leaves (Lean 4.14 Elab/Extra.lean, the `binop%`
        -- elaborator: one type for the leaves of the tree). When the right operand is then not
        -- a Nat, what was lowered under the left's Nat is not it: an operation inside it kept
        -- its own numeral a Nat beside an Int (`16 + 8 * k == 256`, k an Int). It is lowered
        -- again under no expected type, as the comparisons above lower their right operand.
        let b : Bw :=
          if hinted.err == 0 && exp == 0 && a.ty == 4 && hinted.ty != 4 && hinted.ty != 0 then low st hd fs a.ctx r 0
          else hinted;
        if b.err != 0 then b
        else if exp == 0 && a.ty == 4 && b.ty != 4 && b.ty != 0 then
          let a2 : Bw := low st hd fs ctx l b.ty;
          if a2.err != 0 then bwErr 0 6
          else if b.ty == 5 && (a2.ty != 5 || (op != 1 && op != 2)) then bwErr 0 6
          else lowArith st hd fs ctx op l r exp a2 b
        else lowArith st hd fs ctx op l r exp a b
    else bwErr 0 6

partial def lowWordBin : St -> List Int -> List Fn -> List Int -> Int -> Int -> Int -> Int -> Bw
  | st, hd, fs, ctx, ty, op, l, r =>
    let h : Int := wordHelper ty op;
    let scalar : Bool := wordScalarOp ty op;
    let ix : Int := if scalar then -1 else wordHelperIx st fs h;
    if !scalar && (h == 0 || ix < 0) then bwErr 0 15
    else
      let a : Bw := low st hd fs ctx l ty;
      if a.err != 0 then a
      else
        let keep : Bool := a.moved != 0 || op == 15;
        let nextCtx : List Int := if keep then -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1 else a.ctx;
        let b : Bw := low st hd fs nextCtx r ty;
        if b.err != 0 then b
        else
          let aBs : List Int :=
            if keep then varB b.moved
            else if b.moved == 0 then a.bs
            else (low st hd fs b.ctx l ty).bs;
          let saved : List Int :=
            if keep then [4] ++ tyW hd a.ty ++ (if op == 15 then wordResidueW ty a.bs else a.bs)
            else [];
          let bs : List Int :=
            if op == 15 then
              -- BitVec.umod_zero returns the dividend. Bind each operand once.
              let dividend : List Int := varB (b.moved + 1);
              [4,0] ++ wordResidueW ty b.bs ++
                [5,14,0] ++ varB 0 ++ litI 0 ++ dividend ++ [11] ++ dividend ++ varB 0
            else if scalar then wordArithW ty op aBs b.bs
            else
              let m : List Int := litI (wordModulus ty);
              let w : List Int := litI (wordWidth ty);
              let args : List (List Int) :=
                if h == 7 then [w, aBs, b.bs]
                else if h == 9 then [m, w, aBs, b.bs]
                else [aBs, b.bs];
              [4] ++ natMagnitudeTyW ++ [52] ++ leb (ix + nPreOf hd) ++
                wordArgsW args ++ magnitudeNatWordBound (wordWidth ty);
          bwOk 0 (a.pre ++ saved ++ b.pre) b.ctx (a.moved + (if keep then 1 else 0) + b.moved) bs ty

partial def lowArith : St -> List Int -> List Fn -> List Int -> Int -> Int -> Int -> Int -> Bw -> Bw -> Bw
  | st, hd, fs, ctx, op, l, r, exp, a, b =>
    if isWordTy a.ty || isWordTy b.ty then bwErr 0 15
    else
      -- Lean 4.14 Init/Prelude.lean:2487-2491: Pos is Nat add/saturating sub.
      let ty : Int := if a.ty == 4 && b.ty == 4 then 4 else if a.ty == 5 && b.ty == 5 then 5 else 1;
      let body : List Int := if ty == 4 || ty == 5 then magnitudeNatBinaryBound op else magnitudeIntBinaryBound op;
      if a.moved != 0 && b.moved != 0 then
        let kept : List Int := -1 :: -1 :: a.ty :: shiftTrailer a.ctx 1;
        let next : Bw := low st hd fs kept r a.ty;
        if next.err != 0 then next
        else bwOk 0 (a.pre ++ [4] ++ tyW hd a.ty ++ a.bs ++ next.pre) next.ctx
          (a.moved + 1 + next.moved)
          (magnitudeApply2W (tyW hd ty) body (varB next.moved) next.bs) ty
      else
        let aBs : List Int := if b.moved == 0 then a.bs else (low st hd fs b.ctx l a.ty).bs;
        bwOk 0 (a.pre ++ b.pre) b.ctx (a.moved + b.moved)
          (magnitudeApply2W (tyW hd ty) body aBs b.bs) ty

partial def lowList : St -> List Int -> List Fn -> List Int -> Int -> Int -> Bw

  | st, hd, fs, ctx, li, elem =>
    if li < 0 then bwOk 0 [] ctx 0 [22] (if elem < 0 then 0 else elem)
    else
      let expected : Int := if elem < 0 then 0 else elem;
      let x : Bw := low st hd fs ctx (fd 0 st li 1) expected;
      if x.err != 0 then x
      else
        -- Match ckList: select the first actual type only when no element
        -- expectation exists; every later item uses that selected type.
        let selected : Int := if elem < 0 then x.ty else elem;
        if x.moved != 0 then
          -- Keep a computed item before lowering its tail. Each tail is lowered
          -- once; speculative tail lowering doubled work at every arena item.
          let kept : List Int := -1 :: -1 :: x.ty :: shiftTrailer x.ctx 1;
          let next : Bw := lowList st hd fs kept (fd 0 st li 2) selected;
          if next.err != 0 then next
          else bwOk 0 (x.pre ++ [4] ++ tyW hd x.ty ++ x.bs ++ next.pre) next.ctx
            (x.moved + 1 + next.moved) ([26, 23] ++ varB next.moved ++ next.bs) selected
        else
          let r : Bw := lowList st hd fs x.ctx (fd 0 st li 2) selected;
          if r.err != 0 then r
          else
            let xBs : List Int :=
              if r.moved == 0 then x.bs
              else
                let x2 : Bw := low st hd fs r.ctx (fd 0 st li 1) selected;
                x2.bs;
            bwOk 0 (x.pre ++ r.pre) r.ctx (x.moved + r.moved) ([26, 23] ++ xBs ++ r.bs) selected

partial def lowRecArena : St -> List Int -> List Fn -> List Int -> Int -> Nat -> Int -> Bw

  | st, hd, fs, ctx, chain, cnt, code =>
    let flds : RecFlds := lowRecArenaFlds st hd fs ctx chain 0 cnt code;
      if flds.err != 0 then bwErr 0 flds.err
      else
        let arB : List Int := arenaBs hd flds.ctx;
        if lenI arB == 0 then bwErr 0 8
        else
          let z : List Int := litI 0;
          let i0B : List Int := findSlotBs flds.ks flds.bs 100 z;
          let i1B : List Int := findSlotBs flds.ks flds.bs 101 z;
          let i2B : List Int := findSlotBs flds.ks flds.bs 102 z;
          let b0B : List Int := findSlotBs flds.ks flds.bs 200 [1, 0];
          let b1B : List Int := findSlotBs flds.ks flds.bs 201 [1, 0];
          let s0B : List Int := [2, 1, 0];
          let l500 : List Int := findSlotBs flds.ks flds.bs 500 [];
          let kidsB : List Int :=
            if lenI l500 > 0 then l500
            else listLitBs (collectKidsBs flds.ks flds.bs 0 cnt);
          let l900 : List Int := findSlotBs flds.ks flds.bs 900 [];
          let dataB : List Int :=
            if lenI l900 > 0 then l900
            else listLitBs (collectScalarBs flds.ks flds.bs 0);
          let nodeBs : List Int := mkNodeW hd z kidsB i0B i1B i2B b0B b1B s0B dataB;
          let callAlloc : List Int := [52, 0, 1] ++ nodeBs ++ ([1] ++ arB ++ [0]);
          let pre1 : List Int := flds.pre ++ [4] ++ wrapResTy hd 8 ++ callAlloc;
          let ctx1 : List Int := -3 :: -3 :: 8 :: shiftTrailer flds.ctx 1;
          bwOk 0 pre1 ctx1 (flds.moved + 1) (projF0 hd 8 (varB 0)) code

partial def lowRecArenaFlds : St -> List Int -> List Fn -> List Int -> Int -> Nat -> Nat -> Int -> RecFlds

  | st, hd, fs, ctx, chain, j, cnt, code =>
    if j >= cnt then { err := 0, pre := [], ctx := ctx, moved := 0, ks := [], bs := [] : RecFlds }
    else
      let hs : List Int := headsOf hd;
      let fsl : List Int := fldsOf hd;
      let idx : Int := code - 100;
      let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let na : Int := nthF 0 fsl ((first + j) * 3);
      let nb : Int := nthF 0 fsl ((first + j) * 3 + 1);
      let fty : Int := nthF 0 fsl ((first + j) * 3 + 2);
      let eid : Int := findLit st chain na nb;
      let ks : Int := fldKindSlot hd idx j;
      if eid < 0 then rfErr 0 6
      else if ks == -1 then rfErr 0 8
      else
        let w : Bw := low st hd fs ctx eid fty;
        if w.err != 0 then rfErr 0 w.err
        else
          let kind : Int := arenaMagnitudeSlotKind ks;
          let w1 : Bw :=
            if kind >= 10 && kind <= 13 then arenaMagnitudeHoldW hd kind w
            else if kind == 6 || kind == 7 then
              let arB : List Int := arenaBs hd w.ctx;
              if lenI arB == 0 then bwErr 0 8
              else
                let z : List Int := litI 0;
                let holderNode : List Int :=
                  mkNodeW hd z (if kind == 6 then w.bs else [22]) z z z
                    [1, 0] [1, 0] [2, 1, 0] (if kind == 7 then w.bs else [22]);
                let callAlloc : List Int := [52, 0, 1] ++ holderNode ++ ([1] ++ arB ++ [0]);
                let pre1 : List Int := w.pre ++ [4] ++ wrapResTy hd 8 ++ callAlloc;
                let ctx1 : List Int := -3 :: -3 :: 8 :: shiftTrailer w.ctx 1;
                bwOk 0 pre1 ctx1 (w.moved + 1) (projF0 hd 8 (varB 0)) 8
            else w;
          if w1.err != 0 then rfErr 0 w1.err
          else
            let keep : Bool := w1.moved != 0;
            let nextCtx : List Int := if keep then -1 :: -1 :: w1.ty :: shiftTrailer w1.ctx 1 else w1.ctx;
            let r : RecFlds := lowRecArenaFlds st hd fs nextCtx chain (j + 1) cnt code;
            if r.err != 0 then r
            else
              let wBs : List Int :=
                if keep then varB r.moved
                else if r.moved == 0 then w1.bs
                else (low st hd fs r.ctx eid fty).bs;
              let saved : List Int := if keep then [4] ++ tyW hd w1.ty ++ w1.bs else [];
              let value : List Int := if fty == 11 then wordResidueW 11 wBs else wBs;
              { err := 0, pre := w1.pre ++ saved ++ r.pre, ctx := r.ctx, moved := w1.moved + (if keep then 1 else 0) + r.moved, ks := ks :: r.ks, bs := value :: r.bs : RecFlds }

partial def lowRec : St -> List Int -> List Fn -> List Int -> Int -> Nat -> Nat -> Int -> Bw

  | st, hd, fs, ctx, chain, j, cnt, code =>
    if j >= cnt then bwOk 0 [] ctx 0 [33] code
    else
      let hs : List Int := headsOf hd;
      let fsl : List Int := fldsOf hd;
      let i : Nat := Int.toNat (code - 100);
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let na : Int := nthF 0 fsl ((first + j) * 3);
      let nb : Int := nthF 0 fsl ((first + j) * 3 + 1);
      let fty : Int := nthF 0 fsl ((first + j) * 3 + 2);
      let eid : Int := findLit st chain na nb;
      if eid < 0 then bwErr 0 6
      else
        let w : Bw := low st hd fs ctx eid fty;
        if w.err != 0 then w
        else
          let keep : Bool := w.moved != 0;
          let nextCtx : List Int := if keep then -1 :: -1 :: w.ty :: shiftTrailer w.ctx 1 else w.ctx;
          let r : Bw := lowRec st hd fs nextCtx chain (j + 1) cnt code;
          if r.err != 0 then r
          else
            let wBs : List Int :=
              if keep then varB r.moved
              else if r.moved == 0 then w.bs
              else (low st hd fs r.ctx eid fty).bs;
            let saved : List Int := if keep then [4] ++ tyW hd w.ty ++ w.bs else [];
            bwOk 0 (w.pre ++ saved ++ r.pre) r.ctx (w.moved + (if keep then 1 else 0) + r.moved) ([34] ++ fiName j ++ wBs ++ r.bs) code
end

def lowMatch : St -> List Int -> List Fn -> List Int -> Int -> List Int -> Nat -> Int -> Bw

  | st, hd, fs, ctx, eqns, ps, expN, ret =>
    let as : List Int := altIds st (fd 0 st eqns 1);
      let pc : Nat := plen st (fd 0 st (nthI as 0) 1);
      if lenI as == 0 || pc == 0 then bwErr 0 6
      else
        let mx : Mx := { pats := flatAlts st as pc, alts := as, scrs := ixRange expN (expN + pc), tys := takeI (dropI ps expN) pc, als := sepsN (lenI as), ncol := pc : Mx };
        lowMxEntry st hd fs mx ctx ret

def finishDefBw : List Int -> Fn -> Bw -> Bw

  | hd, f, b =>
    if b.err != 0 then b
    else if f.resA == 0 then
      bwOk 0 [] b.ctx 0 (b.pre ++ b.bs) f.ret
    else
      let arB : List Int := arenaBs hd b.ctx;
      if lenI arB == 0 then bwErr 0 6
      else bwOk 0 [] b.ctx 0 (b.pre ++ wrapResVal hd b.bs arB) f.ret

def lowDef : St -> List Int -> List Fn -> Fn -> Bw

  | st, hd, fs, f =>
    let sig : Int := fd 0 st f.node 2;
      let names : List Int := grpSpans st (fd 0 st sig 1);
      let expN : Nat := lenI names / 2;
      let ctx0 : List Int := rightmostParams st (zipCtx names f.ps);
      let ctxK : List Int := if f.part > 0 then ctx0 ++ [-5, f.part, 0] else ctx0;
      let ctx : List Int := if f.usesA == 1 then ctxK ++ [-2, -2, 2000] else ctxK;
      let body : Int := fd 0 st f.node 3;
      if fd 0 st body 0 == 25 then fuelWrap st hd fs f (finishDefBw hd f (low st hd fs ctx (fd 0 st body 1) f.ret))
      else if fd 0 st body 0 == 23 then fuelWrap st hd fs f (finishDefBw hd f (lowMatch st hd fs ctx body f.ps expN f.ret))
      else bwErr 0 6

-- The wire is a tree: a struct whose fields reach back to it (directly or
-- through List/pair/sum) unrolls without end, so tyW'st fuel always empties
-- mid-type. That used to emit truncated bytes the reader refused as
-- [rscm_bad_body]; now it is the named refusal rsdc_type_depth.
partial def checkTypeDepthGo : List Int -> Nat -> Nat -> Int

  | pk, i, nHeads =>
    if i >= nHeads then 0
    else
      let hs : List Int := headsOf pk;
      let code : Int := if nthF 0 hs (i * 4 + 2) < 0 then 30000 + Int.ofNat i else 100 + Int.ofNat i;
      if hasTyErr 4000 (tyW pk code) then 9
      else checkTypeDepthGo pk (i + 1) nHeads

-- Scan declared fields even when their recursive head is represented by a handle.
-- Recursive lists carry opaque handles on the wire, including fields and
-- public signatures. Only an exhausted finite type encoding is refused.
partial def checkFldsGo : List Int -> Nat -> Int

  | pk, j =>
    let fs : List Int := fldsOf pk;
      if j * 3 + 2 >= lenI fs then 0
      else if hasTyErr 4000 (tyW pk (nthF 0 fs (j * 3 + 2))) then 9
      else checkFldsGo pk (j + 1)

def checkSigDepthGo : List Int -> List Sig -> Int

  | _, [] => 0
  | pk, sg :: rest =>
    if hasTyErr 4000 (tyW pk sg.ret) || hasTyErr 4000 (foldTy pk sg.ps) then 9
    else checkSigDepthGo pk rest

def checkTypeDepth : List Int -> List Int -> List Sig -> Int

  | pk, hs, sigs =>
    let e1 : Int := checkTypeDepthGo pk 0 (lenI hs / 4);
      if e1 != 0 then e1
      else
        let ef : Int := checkFldsGo pk 0;
        if ef != 0 then ef else checkSigDepthGo pk sigs

-- Byte positions of refusals. walkPos replays walk; ckErrPos projects the
-- shared ckFileResult. They return the first failing declaration's offset;
-- the depth and arena variants return the name span of the failing head,
-- field or signature. -1 means "no error located" (call only after a
-- nonzero error code from the matching pass).
partial def walkPos : St -> Int -> Int -> Env -> Int

  | st, mode, id, e =>
    if e.err != 0 then -1
    else if id < 0 then -1
    else if fd 0 st id 0 != 19 then -1
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let e2 : Env :=
        if t == 28 then walk st mode (fd 0 st d 1) e
        else if t == 34 || t == 36 then walk st mode (fd 0 st d 2) e
        else if mode == 0 && t == 26 then addStructHead st e d
        else if mode == 0 && t == 38 then addIndHead st e d
        else if mode == 1 && t == 26 then addStruct st e d
        else if mode == 1 && t == 38 then addInd st e d
        else if mode == 2 && t == 20 then addDef st e d
        else if mode == 0 && t == 37 then addAlias st e d
        else if t == 26 || t == 20 || t == 28 || t == 35 || t == 37 || t == 38 then e
        else setE 0 e 6;
      if e2.err == 0 then walkPos st mode (fd 0 st id 2) e2
      else if t == 28 || t == 34 || t == 36 then walkPos st mode (if t == 28 then fd 0 st d 1 else fd 0 st d 2) e
      else instancePosition st (fd 0 st (fd 0 st d 1) 1)

partial def ckErrPos : St -> Env -> Int -> Int
  | st, env, id => (ckFileResult st env id).ty

def arenaErrPosGo : List Int -> List Int -> List Int -> List Int -> Int

  | _, _, _, [] => -1
  | hs, fs, recs, idx :: rest =>
    let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
      let cs : List Int := countArenaFlds fs recs first 0 cnt 0 0 0 0 0;
      if nthF 0 cs 5 > 0 || nthF 0 cs 1 > 2 || nthF 0 cs 2 > 1 then nthF 0 hs (i * 4)
      else arenaErrPosGo hs fs recs rest

def arenaErrPos : List Int -> List Int -> List Int -> Int

  | hs, fs, recs =>
    arenaErrPosGo hs fs recs recs

partial def depthHeadPos : List Int -> Nat -> Nat -> List Int -> Int

  | pk, i, nHeads, hs =>
    if i >= nHeads then -1
    else if hasTyErr 4000 (tyW pk (100 + Int.ofNat i)) then nthF 0 hs (i * 4)
    else depthHeadPos pk (i + 1) nHeads hs

partial def depthFldPos : List Int -> Nat -> Int

  | pk, j =>
    let fs : List Int := fldsOf pk;
      if j * 3 + 2 >= lenI fs then -1
      else if hasTyErr 4000 (tyW pk (nthF 0 fs (j * 3 + 2))) then nthF 0 fs (j * 3)
      else depthFldPos pk (j + 1)

def depthSigPos : List Int -> List Sig -> Int

  | _, [] => -1
  | pk, sg :: rest =>
    if hasTyErr 4000 (tyW pk sg.ret) || hasTyErr 4000 (foldTy pk sg.ps) then sg.a
    else depthSigPos pk rest

def depthErrPos : List Int -> List Int -> List Sig -> Int

  | pk, hs, sigs =>
    let hp : Int := depthHeadPos pk 0 (lenI hs / 4) hs;
      if hp >= 0 then hp
      else
        let fp : Int := depthFldPos pk 0;
        if fp >= 0 then fp else depthSigPos pk sigs

-- An accepted body must lower. This also keeps native-only basic-data
-- operations behind a named refusal until their wire representation exists.
def indBodyErrGo : St -> List Int -> List Fn -> List Int -> Ans

  | _, _, _, [] => good 0 (-1)
  | st, pk, fs, i :: rest =>
    let f : Fn := nthFn fs (Int.toNat i);
    let b : Bw := lowDef st pk fs f;
    if b.err != 0 then { err := b.err, ty := instancePosition st f.na : Ans }
    else indBodyErrGo st pk fs rest

def indBodyErrWith : St -> Env -> List Int -> List Fn -> FnScc -> Ans
  | st, e, recs, fs0, summary =>
    let pk : List Int := packEF (e.fields ++ [-10, 4] ++ recs) e.heads e.icts e.iargs;
    let fixed : List Fn := fixUsesA (directUsesA st pk fs0);
    let fs : List Fn := setPartWith summary fixed fixed 0 (fuelBudget 0);
    indBodyErrGo st pk fs (rangeI (lenFn fs) 0)

def indBodyErr : St -> Env -> List Int -> Int -> Ans
  | st, e, recs, top =>
    let raw : List Fn := gather st e top;
    let fs0 : List Fn := fillC st raw raw;
    indBodyErrWith st e recs fs0 (fnSccSummary fs0)

def checkPosParsed : Nat -> St -> Int
  | 0, st =>
    if st.err != 0 then Int.ofNat st.pos
    else if st.root < 0 then Int.ofNat st.pos
    else
      let top : Int := fd 0 st st.root 1;
      let stq : St := prepSt 0 st top;
      if stq.err != 0 then Int.ofNat stq.pos
      else
        let e0 : Env := walk stq 0 top (emptyEnv 0);
        if e0.err != 0 then walkPos stq 0 top (emptyEnv 0)
        else
          let e1 : Env := walk stq 1 top e0;
          if e1.err != 0 then walkPos stq 1 top e0
          else
            let e2 : Env := walk stq 2 top e1;
            if e2.err != 0 then walkPos stq 2 top e1
            else
              let scc : TjState := recStructsOf e2.heads e2.fields e2.icts e2.iargs;
              let recs : List Int := scc.recs;
              let ae : Int := if scc.err != 0 then scc.err else checkHeapTypes e2 recs;
              if ae != 0 then
                if scc.err != 0 then nthF 0 e2.heads 0
                else arenaErrPos e2.heads e2.fields recs
              else
                let pk : List Int := packEF (e2.fields ++ [-10, 0] ++ recs) e2.heads e2.icts e2.iargs;
                let de : Int := checkTypeDepth pk e2.heads e2.sigs;
                if de != 0 then depthErrPos pk e2.heads e2.sigs
                else
                  let cp : Int := ckErrPos stq e2 top;
                  if cp >= 0 then cp
                  else (indBodyErr stq e2 recs top).ty
  | n + 1, st => checkPosParsed n st

def checkSrcPos : Nat -> List Int -> Int
  | 0, bs =>
    let st : St := parseSrc 0 bs;
    specPos st (checkPosParsed 0 st)
  | n + 1, bs => checkSrcPos n bs

-- Body-stage refusal position: the first def whose body fails to lower
-- reports its own name offset.
def bodyErrPos : St -> List Int -> List Fn -> List Int -> Int

  | _, _, _, [] => -1
  | st, hd, fs, i :: is =>
    let f : Fn := nthFn fs (Int.toNat i);
      let b : Bw := lowDef st hd fs f;
      if b.err != 0 then instancePosition st f.na
      else bodyErrPos st hd fs is

-- Byte position to [line, col], both 1-based.
def lcOfGo : List Int -> Int -> Int -> Int -> Int -> List Int

  | [], _, pos, ln, ls => [ln + 1, pos - ls + 1]
  | b :: rest, i, pos, ln, ls =>
    if i >= pos then [ln + 1, pos - ls + 1]
    else if b == 10 then lcOfGo rest (i + 1) pos (ln + 1) (i + 1)
    else lcOfGo rest (i + 1) pos ln ls

def lcOf : Nat -> List Int -> Int -> List Int
  | 0, bs, pos =>
    if pos < 0 then [1, 1] else lcOfGo bs 0 pos 0 0
  | n + 1, bs, pos => lcOf n bs pos

def checkParsed : Nat -> St -> Nat
  | 0, st =>
    if st.err != 0 then st.err
    else if st.root < 0 then 1
    else
      let top : Int := fd 0 st st.root 1;
      let stq : St := prepSt 0 st top;
      if stq.err != 0 then stq.err
      else
        let e0 : Env := walk stq 0 top (emptyEnv 0);
        let e1 : Env := if e0.err != 0 then e0 else walk stq 1 top e0;
        let e2 : Env := if e1.err != 0 then e1 else walk stq 2 top e1;
        if e2.err != 0 then Int.toNat e2.err
        else
          let scc : TjState := recStructsOf e2.heads e2.fields e2.icts e2.iargs;
          let recs : List Int := scc.recs;
          let ae : Int := if scc.err != 0 then scc.err else checkHeapTypes e2 recs;
          if ae != 0 then Int.toNat ae
          else
            let pk : List Int := packEF (e2.fields ++ [-10, 0] ++ recs) e2.heads e2.icts e2.iargs;
            let de : Int := checkTypeDepth pk e2.heads e2.sigs;
            if de != 0 then Int.toNat de
            else
              let ck : Int := ckFile stq e2 top;
              if ck != 0 then Int.toNat ck
              else
                let raw : List Fn := gather stq e2 top;
                let fs0 : List Fn := fillC stq raw raw;
                let summary : FnScc := fnSccSummary fs0;
                let mix : Int := ckMixedWith summary fs0;
                if mix != 0 then Int.toNat mix
                else Int.toNat (indBodyErrWith stq e2 recs fs0 summary).err
  | n + 1, st => checkParsed n st

def checkSrc : Nat -> List Int -> Nat
  | 0, bs => checkParsed 0 (parseSrc 0 bs)
  | n + 1, bs => checkSrc n bs

-- The native front end checks Lean types before the separate wire-layout gate.
-- Stock Lean 4.14 executes basic data; no provisional wire representation is
-- inferred from its type code. The wasm path above retains all layout checks.
def checkNativeParsed : Nat -> St -> Nat
  | 0, st =>
    if st.err != 0 then st.err
    else if st.root < 0 then 1
    else
      let top : Int := fd 0 st st.root 1;
      let ready : St := prepSt 0 st top;
      if ready.err != 0 then ready.err
      else
        let e0 : Env := walk ready 0 top (emptyEnv 0);
        let e1 : Env := if e0.err != 0 then e0 else walk ready 1 top e0;
        let e2 : Env := if e1.err != 0 then e1 else walk ready 2 top e1;
        if e2.err != 0 then Int.toNat e2.err
        else
          let ck : Int := ckFile ready e2 top;
          if ck != 0 then Int.toNat ck
          else
            let raw : List Fn := gather ready e2 top;
            Int.toNat (ckMixed 2 (fillC ready raw raw))
  | n + 1, st => checkNativeParsed n st

def checkNativeSrc : Nat -> List Int -> Nat
  | 0, bs => checkNativeParsed 0 (parseSrc 0 bs)
  | n + 1, bs => checkNativeSrc n bs

-- A negative step-index budget is refused at compile time (rsdc_budget, 11).
def checkSrcB : Nat -> Int -> List Int -> Nat
  | 0, bud, bs => if bud < 0 then 11 else checkParsed 0 (parseSrc 0 bs)
  | n + 1, bud, bs => checkSrcB n bud bs

def refusal : Nat -> Nat -> String
  | 0, e =>
    if e == 0 then "ok"
    else if e == 1 then "rsdc_syntax"
    else if e == 2 then "rsdc_unclosed"
    else if e == 3 then "rsdc_fuel"
    else if e == 4 then "rsdc_nonassoc"
    else if e == 5 then "rsdc_unbound"
    else if e == 6 then "rsdc_type"
    else if e == 7 then "rsdc_arity"
    else if e == 8 then "rsdc_arena_field"
    else if e == 9 then "rsdc_type_depth"
    else if e == 10 then "rsdc_dup_binder"
    else if e == 11 then "rsdc_budget"
    else if e == 12 then "rsdc_mixed_partial"
    else if e == 13 then "rsdc_rec_ind"
    else if e == 14 then "rsdc_runtime_primitive_scope"
    else if e == 15 then "rsdc_word_op"
    else if e == 16 then "rsdc_basic_data_lowering"
    else if e == 17 then "rsdc_do"
    else if e == 18 then "rsdc_array_receiver"
    else if e == 19 then "rsdc_array_operation"
    else "rsdc_unknown"
  | n + 1, e => refusal n e

def sigOf : List Int -> Fn -> List Int

  | pk, f =>
    let psK : List Int := if f.part > 0 then f.ps ++ [0] else f.ps;
      let ps2 : List Int := if f.usesA == 1 then psK ++ [2000] else psK;
      let retW : List Int := if f.resA == 1 then wrapResTy pk f.ret else tyW pk f.ret;
      leb (Int.ofNat (lenI ps2)) ++ foldTy pk ps2 ++ retW

def sigAll : List Int -> List Fn -> List Int -> List Int

  | _, _, [] => []
  | pk, fs, i :: is => sigOf pk (nthFn fs (Int.toNat i)) ++ sigAll pk fs is

def bodyAll : St -> List Int -> List Fn -> List Int -> Bw

  | _, _, _, [] =>
    bwOk 0 [] [] 0 [0] 0
  | st, hd, fs, i :: is =>
    let b : Bw := lowDef st hd fs (nthFn fs (Int.toNat i));
      if b.err != 0 then b
      else
        let r : Bw := bodyAll st hd fs is;
        if r.err != 0 then r
        else bwOk 0 [] [] 0 ([1] ++ b.bs ++ r.bs) 0

-- The emission result is the single source of host status and diagnostics.
-- Legacy byte-list callers project bytes; executable hosts must inspect err.
-- A refusal has no bytes. Positions are offsets in the original source;
-- whole-request failures (for example a negative budget) point at offset 0.
structure EmitResult where
  err : Nat
  pos : Int
  stage : Nat
  bytes : List Int

-- One body per used arithmetic/comparison/conversion/node-packing operation, after the source table.
-- Existing pair/let binding evaluates operands once. The template environment
-- is right=slot0, left=slot1 for binary operations; conversions use slot0.
def arithmeticTemplate (pk : List Int) (id : Int) : List Int :=
  if id == 0 then magnitude_nat_binary_0 else if id == 1 then magnitude_nat_binary_1
  else if id == 2 then magnitude_nat_binary_2 else if id == 3 then magnitude_nat_binary_3
  else if id == 4 then magnitude_nat_binary_4 else if id == 5 then magnitude_int_binary_0
  else if id == 6 then magnitude_int_binary_1 else if id == 7 then magnitude_int_binary_2
  else if id == 8 then magnitude_int_binary_3 else if id == 9 then magnitude_int_binary_4
  else if id == 10 then magnitude_int_binary_5 else if id == 11 then magnitude_int_binary_6
  else if id == 12 then magnitude_int_neg_bound
  else if id >= 13 && id <= 16 then magnitudeNatOrderBoundW (id - 6)
  else if id >= 17 && id <= 20 then magnitudeIntOrderBoundW (id - 10)
  else if id == 21 then magnitudeNatMaxBoundW
  else if id == 22 then magnitudeNatZeroBoundW
  else if id == 23 then natToIntMagnitudeBoundW
  else if id == 24 then intToNatBoundW
  else if id == 25 then magnitudeNatIndexBound
  else if id == 26 then magnitudeMetadataNatBound
  else if id == 27 then magnitudeNatWord8Bound
  else if id == 28 then magnitudeNatWord16Bound
  else if id == 29 then magnitudeNatWord32Bound
  else if id == 30 then magnitudeNatCharBoundW
  else if id == 31 then magnitudeStringNatOptionBound
  else if id == 32 then magnitudeNatToStringBound
  else if id == 33 then magnitudeIntToStringBound
  else if id == 34 then arenaMagnitudePackNatListBound
  else if id == 35 then arenaMagnitudePackIntListBound
  else if id == 36 then arenaMagnitudeUnpackNatListBound
  else if id == 37 then arenaMagnitudeUnpackIntListBound
  else if id == 38 then arenaMagnitudeDecodeNatBoundW
  else if id == 39 then arenaMagnitudeDecodeIntBoundW
  else if id == 40 then arenaMagnitudeChildBoundW pk
  else if id == 41 then arenaMagnitudeAllocBoundW pk
  else magnitude_int_neg_bound

-- Keys are [id] for fixed helpers, and 42::tw for a complete concrete list type.
-- This is an image-local extension of the existing first-use registry.
structure ArithmeticUse where
  err : Int
  keys : List (List Int)
  deriving Inhabited

def arithmeticReverse : List (List Int) -> List (List Int) -> List (List Int)
  | acc, [] => acc
  | acc, key :: keys => arithmeticReverse (key :: acc) keys

def arithmeticTypeCells : List Int -> Bool
  | [] => true
  | b :: bs => b >= 0 && b <= 255 && arithmeticTypeCells bs

def arithmeticPayload (tw : List Int) (n : Int) : Bool :=
  n >= 2 && Int.ofNat (lenI tw) == n && nthF 0 tw 0 == 4 && arithmeticTypeCells tw

partial def arithmeticUsed : List Int -> List (List Int) -> ArithmeticUse
  | [], keys => { err := 0, keys := arithmeticReverse [] keys : ArithmeticUse }
  | -600044 :: n :: bs, keys =>
    let payload : List Int := takeI bs (Int.toNat n);
    if n < 3 || Int.ofNat (lenI payload) != n || !payload.all (fun x => x >= 0) then
      { err := 6, keys := [] : ArithmeticUse }
    else
      let key : List Int := 44 :: payload;
      arithmeticUsed (dropI bs (Int.toNat n)) (if inBss keys key then keys else key :: keys)
  | -600042 :: n :: bs, keys =>
    let tw : List Int := takeI bs (Int.toNat n);
    if !(arithmeticPayload tw n) then { err := 6, keys := [] : ArithmeticUse }
    else
      let key : List Int := 42 :: tw;
      arithmeticUsed (dropI bs (Int.toNat n)) (if inBss keys key then keys else key :: keys)
  | b :: bs, keys =>
    if b <= -600000 && b >= -600043 && b != -600042 then
      let key : List Int := [-600000 - b];
      arithmeticUsed bs (if inBss keys key then keys else key :: keys)
    else if b < 0 then { err := 6, keys := [] : ArithmeticUse }
    else arithmeticUsed bs keys

-- Only Range has helper dependencies: its Bool skeleton and existing Nat-add0.
def arithmeticClose (keys : List (List Int)) : List (List Int) :=
  if !(inBss keys [43]) then keys
  else
    let withBool : List (List Int) := if inBss keys [42,4,1] then keys else keys ++ [[42,4,1]];
    if inBss withBool [0] then withBool else withBool ++ [[0]]

def arithmeticIndex : List Int -> List (List Int) -> Int -> Int
  | _, [], _ => -1
  | key, x :: xs, i => if eqListI key x then i else arithmeticIndex key xs (i + 1)

def arithmeticSig (pk : List Int) (id : Int) : List Int :=
    let tw : List Int := if id < 5 || (id >= 13 && id <= 16) || id == 21 || id == 22 then natMagnitudeTyW else intMagnitudeTyW;
    let result : List Int := if (id >= 13 && id <= 20) || id == 22 then [1] else tw;
    let sig : List Int :=
      if id == 23 then [1] ++ natMagnitudeTyW ++ intMagnitudeTyW
      else if id == 24 then [1] ++ intMagnitudeTyW ++ natMagnitudeTyW
      else if id == 25 then [1] ++ natMagnitudeTyW ++ [0]
      else if id == 26 then [1,0] ++ natMagnitudeTyW
      else if id == 27 || id == 28 || id == 29 then [1] ++ natMagnitudeTyW ++ [0]
      else if id == 30 then [1,0,0]
      else if id == 31 then [1,4,0,8] ++ natMagnitudeTyW
      else if id == 32 then [1] ++ natMagnitudeTyW ++ [4,0]
      else if id == 33 then [1] ++ intMagnitudeTyW ++ [4,0]
      else if id == 34 then [1,4] ++ natMagnitudeTyW ++ [4,0]
      else if id == 35 then [1,4] ++ intMagnitudeTyW ++ [4,0]
      else if id == 36 then [1,4,0,4] ++ natMagnitudeTyW
      else if id == 37 then [1,4,0,4] ++ intMagnitudeTyW
      else if id == 38 then [1,4] ++ natMagnitudeTyW ++ natMagnitudeTyW
      else if id == 39 then [1,4] ++ intMagnitudeTyW ++ intMagnitudeTyW
      else if id == 40 then [2] ++ nodeTyW pk ++ [0] ++ handleTyW pk
      else if id == 41 then [2,4,0] ++ arenaTyW pk ++ wrapResTy pk 8
      else if id == 12 || id == 22 then [1] ++ tw ++ result else [2] ++ tw ++ tw ++ result;
    sig

def arithmeticSigs : List Int -> List (List Int) -> List Int
  | _, [] => []
  | pk, key :: keys =>
    let id : Int := nthF 0 key 0;
    let sig : List Int :=
      if id == 44 then
        let ps : List Int := dropI key 4;
        [Int.ofNat (lenI ps)] ++ (ps.flatMap (fun p => tyW pk p)) ++ tyW pk (nthF 0 key 3)
      else if id == 42 then [2] ++ natMagnitudeTyW ++ dropI key 2 ++ dropI key 1
      else if id == 43 then [1,4,1,4] ++ natMagnitudeTyW
      else arithmeticSig pk id;
    sig ++ arithmeticSigs pk keys

def arithmeticKeyTemplate : List Int -> List Int -> List Int
  | pk, 44 :: op :: ty :: ret :: ps => basicDataTemplate pk op ty ret ps
  | _, 42 :: tw => countMagnitudeReplicateBoundW tw 0 1
  | _, [43] => countMagnitudeRangeBoundW
  | pk, id :: _ => arithmeticTemplate pk id
  | _, [] => []

-- Close discovered helper dependencies before assigning final module indices.
-- The queue and key set are monotone; each concrete key is expanded once.
partial def arithmeticDiscover (pk : List Int) : List (List Int) -> List (List Int) -> List (List Int)
  | [], keys => keys
  | key :: pending, keys =>
    let uses : ArithmeticUse := arithmeticUsed (arithmeticKeyTemplate pk key) [];
    let fresh : List (List Int) := uses.keys.filter (fun k => !(inBss keys k));
    arithmeticDiscover pk (pending ++ fresh) (keys ++ fresh)

-- Relocate only this fragment: preserve every ordinary0 and append nothing.
partial def arithmeticFragment : List Int -> List (List Int) -> Int -> List Int -> Bw
  | [], _, _, acc => bwOk 0 [] [] 0 (revI [] acc) 0
  | -600044 :: n :: bs, keys, base, acc =>
    let payload : List Int := takeI bs (Int.toNat n);
    let index : Int := arithmeticIndex (44 :: payload) keys 0;
    if n < 3 || Int.ofNat (lenI payload) != n || index < 0 then bwErr 0 6
    else
      let call : List Int := [52] ++ leb (base + index);
      arithmeticFragment (dropI bs (Int.toNat n)) keys base (revI acc call)
  | -600042 :: n :: bs, keys, base, acc =>
    let tw : List Int := takeI bs (Int.toNat n);
    if !(arithmeticPayload tw n) then bwErr 0 6
    else
      let index : Int := arithmeticIndex (42 :: tw) keys 0;
      if index < 0 then bwErr 0 6
      else
        let call : List Int := [52] ++ leb (base + index);
        arithmeticFragment (dropI bs (Int.toNat n)) keys base (revI acc call)
  | b :: bs, keys, base, acc =>
    if b <= -600000 && b >= -600043 && b != -600042 then
      let id : Int := -600000 - b;
      let index : Int := arithmeticIndex [id] keys 0;
      if index < 0 then bwErr 0 6
      else
        let args : List Int := if id == 22 || id == 23 || (id >= 38 && id <= 41) || id == 43 then [] else if id == 12 || (id >= 24 && id <= 37) then [1,3,0,0] else [1,3,0,1,3,1,0];
        let call : List Int := [52] ++ leb (base + index) ++ args;
        arithmeticFragment bs keys base (revI acc call)
    else if b < 0 then bwErr 0 6
    else arithmeticFragment bs keys base (b :: acc)

def arithmeticBodies : List Int -> List (List Int) -> List (List Int) -> Int -> Bw
  | _, [], _, _ => bwOk 0 [] [] 0 [0] 0
  | pk, key :: keys, full, base =>
    let b : Bw := arithmeticFragment (arithmeticKeyTemplate pk key) full base [];
    if b.err != 0 then b
    else
      let r : Bw := arithmeticBodies pk keys full base;
      if r.err != 0 then r
      else bwOk 0 [] [] 0 ([1] ++ b.bs ++ r.bs) 0

def arithmeticLink (pk bs : List Int) (keys : List (List Int)) (base : Int) : Bw :=
  let source : Bw := arithmeticFragment bs keys base [];
  if source.err != 0 then source
  else
    let helpers : Bw := arithmeticBodies pk keys keys base;
    if helpers.err != 0 then helpers
    else
      match revI [] source.bs with
      | 0 :: bodyPrefix => bwOk 0 [] [] 0 (revI helpers.bs bodyPrefix) 0
      | _ => bwErr 0 6

def emitStageName : Nat -> String
  | 0 => "ok"
  | 1 => "parse"
  | 2 => "prepare"
  | 3 => "heads"
  | 4 => "fields"
  | 5 => "signatures"
  | 6 => "check"
  | 7 => "recursive-types"
  | 8 => "heap-layout"
  | 9 => "type-depth"
  | 10 => "mixed-partial"
  | 11 => "wire-signatures"
  | 12 => "bodies"
  | 13 => "budget"
  | _ => "unknown"

def emitRefused (st : St) (err stage : Nat) (pos : Int) : EmitResult :=
  let limit : Int := fileLenI 0 st;
  let offset : Int := if pos < 0 then 0 else if pos > limit then limit else pos;
  { err := err, pos := offset, stage := stage, bytes := [] : EmitResult }

def mixedErrPosWith : FnScc -> List Fn -> List Fn -> Int -> Int
  | _, _, [], _ => -1
  | summary, full, f :: rest, i =>
    if f.part == 0 && mixedAtWith summary full i then f.na
    else mixedErrPosWith summary full rest (i + 1)

def mixedErrPos : List Fn -> List Fn -> Int -> Int
  | full, rest, i => mixedErrPosWith (fnSccSummary full) full rest i

-- This is the former emitParsedB path, retaining each actual failing pass.
-- Successful byte construction and function ordering are unchanged.
def emitResultParsedB : Nat -> Int -> St -> EmitResult
  | 0, bud, st =>
    if bud < 0 then emitRefused st 11 13 0
    else if st.err != 0 then emitRefused st st.err 1 (Int.ofNat st.pos)
    else if st.root < 0 then emitRefused st 1 1 (Int.ofNat st.pos)
    else
      let top : Int := fd 0 st st.root 1;
      let stq : St := prepSt 0 st top;
      if stq.err != 0 then emitRefused st stq.err 2 (Int.ofNat stq.pos)
      else
        let e0 : Env := walk stq 0 top (emptyEnv 0);
        if e0.err != 0 then emitRefused st (Int.toNat e0.err) 3 (walkPos stq 0 top (emptyEnv 0))
        else
          let e1 : Env := walk stq 1 top e0;
          if e1.err != 0 then emitRefused st (Int.toNat e1.err) 4 (walkPos stq 1 top e0)
          else
            let e2 : Env := walk stq 2 top e1;
            if e2.err != 0 then emitRefused st (Int.toNat e2.err) 5 (walkPos stq 2 top e1)
            else
              let ckResult : Ans := ckFileResult stq e2 top;
              if ckResult.err != 0 then emitRefused st (Int.toNat ckResult.err) 6 ckResult.ty
              else
                let scc : TjState := recStructsOf e2.heads e2.fields e2.icts e2.iargs;
                let recs : List Int := scc.recs;
                if scc.err != 0 then emitRefused st (Int.toNat scc.err) 7 (nthF 0 e2.heads 0)
                else
                  let heap : Int := checkHeapTypes e2 recs;
                  if heap != 0 then emitRefused st (Int.toNat heap) 8 (arenaErrPos e2.heads e2.fields recs)
                  else
                    let hasProj : Bool := hasIndRec e2.heads recs || lenI recs > 0 && hasRecProj stq e2.heads e2.fields recs top;
                    let singleL : Bool := !(hasIndRec e2.heads recs) && allSingleListRecs e2.heads e2.fields recs recs;
                    let nPre : Int :=
                      if lenI recs == 0 then 0
                      else if !hasProj then 1
                      else if singleL then 3
                      else 4;
                    let pk : List Int := packEF (e2.fields ++ [-10, nPre] ++ recs) e2.heads e2.icts e2.iargs;
                    let raw : List Fn := gather stq e2 top;
                    let fs0 : List Fn := fillC stq raw raw;
                    let depth : Int := checkTypeDepth pk e2.heads e2.sigs;
                    if depth != 0 then emitRefused st (Int.toNat depth) 9 (depthErrPos pk e2.heads e2.sigs)
                    else
                      let summary : FnScc := fnSccSummary fs0;
                      let mixed : Int := ckMixedWith summary fs0;
                      if mixed != 0 then emitRefused st (Int.toNat mixed) 10 (mixedErrPosWith summary fs0 fs0 0)
                      else
                        let fs1 : List Fn := directUsesA stq pk fs0;
                        let fixed : List Fn := fixUsesA fs1;
                        let fs : List Fn := setPartWith summary fixed fixed 0 bud;
                        let reachable : List Int :=
                          if fd 0 stq stq.root 2 <= 0 then rangeI (lenFn fs) 0
                          else wordReach fs (wordRoots stq fs 0) [];
                        let ord : List Int := orderI stq fs reachable [];
                        let n : Nat := lenI ord;
                        let placed : List Fn := pickFn ord fs;
                        let sigBytes : List Int := preSigsW pk nPre ++ sigAll pk fs ord;
                        if hasTyErr 80000 sigBytes then emitRefused st 9 11 (depthSigPos pk e2.sigs)
                        else
                          let bod : Bw := bodyAll stq pk placed (rangeI n 0);
                          if bod.err != 0 then emitRefused st (Int.toNat bod.err) 12 (bodyErrPos stq pk placed (rangeI n 0))
                          else
                            let sourceMods : Int := nPre + Int.ofNat n;
                            let used : ArithmeticUse := arithmeticUsed bod.bs [];
                            if used.err != 0 then emitRefused st 6 12 0
                            else
                              let legacy : List (List Int) := arithmeticClose used.keys;
                              let arithmetic : List (List Int) :=
                                if legacy.any (fun key => nthF 0 key 0 == 44) then arithmeticDiscover pk legacy legacy else legacy;
                              let totalMods : Int := sourceMods + Int.ofNat (lenLL arithmetic);
                              let linked : Bw := if lenLL arithmetic == 0 then bod else arithmeticLink pk bod.bs arithmetic sourceMods;
                              if linked.err != 0 then emitRefused st 6 12 0
                              else
                                { err := 0, pos := -1, stage := 0,
                                  bytes := [82, 83, 67, 77, 1] ++ leb totalMods ++ sigBytes ++ arithmeticSigs pk arithmetic ++ preBodsW pk nPre linked.bs : EmitResult }
  | n + 1, bud, st => emitResultParsedB n bud st

def emitResultSrcB : Nat -> Int -> List Int -> EmitResult
  | 0, bud, bs => emitResultParsedB 0 bud (parseSrc 0 bs)
  | n + 1, bud, bs => emitResultSrcB n bud bs

def emitResultSrc : Nat -> List Int -> EmitResult
  | 0, bs => emitResultSrcB 0 (fuelBudget 0) bs
  | n + 1, bs => emitResultSrc n bs

def emitParsedB : Nat -> Int -> St -> List Int
  | 0, bud, st => (emitResultParsedB 0 bud st).bytes
  | n + 1, bud, st => emitParsedB n bud st

def emitParsed : Nat -> St -> List Int
  | 0, st => emitParsedB 0 (fuelBudget 0) st
  | n + 1, st => emitParsed n st

-- Index walk is one step per byte. The mutant charges the copied tail, as String.drop did.
partial def ixWalk : Int -> Int -> Int -> Int

  | i, lim, acc =>
    if i >= lim then acc else ixWalk (i + 1) lim (acc + 1)

partial def dropWalk : Int -> Int -> Int -> Int

  | i, lim, acc =>
    if i >= lim then acc else dropWalk (i + 1) lim (acc + (lim - i))

def lexGate : Nat -> Int
  | 0 =>
    let n : Int := 64;
    let a : Int := ixWalk 0 n 0;
    let b : Int := ixWalk 0 (8 * n) 0;
    let c : Int := dropWalk 0 n 0;
    let d : Int := dropWalk 0 (8 * n) 0;
    let ir : Int := if a == 0 then 999 else b / a;
    let dr : Int := if c == 0 then 999 else d / c;
    if ir <= 24 && dr > 24 then 0 else 1
  | n + 1 => lexGate n

def dotGate : Nat -> Int
  | 0 =>
    let bs : List Int := [97, 46, 98, 46, 99];
    let st : St := setPool 0 (initSt 0 bs) (putSpan 0 (map0 0) 0 bs);
    let a : Int := lastDot st 0 5;
    let m : Int := firstDotBytes bs 0 5 (-1);
    if a == 3 && m == 1 then 0 else 1
  | n + 1 => dotGate n

-- Mutant for the spine fold: unwinds in the opposite order, so the
-- cons chain comes out reversed; the gate checks the two disagree.
def spine1M : St -> Int -> List Int -> St

  | st, _, [] => st
  | st, tag, x :: rest => let st2 : St := spine1M st tag rest; alloc 0 st2 tag x st2.ret 0

def spineGate : Nat -> Int
  | 0 =>
    let a : St := spine1 (setRet 0 (initSt 0 []) (-1)) 12 [11, 22];
    let b : St := spine1M (setRet 0 (initSt 0 []) (-1)) 12 [11, 22];
    if fd 0 a a.ret 1 == 22 && fd 0 b b.ret 1 == 11 then 0 else 1
  | n + 1 => spineGate n

-- Mutant of primStr: matches on a name prefix instead of the exact span, so
-- "lengthX" would wrongly resolve to String.length. recvGate checks that
-- the two disagree and that receiver-kind dispatch keeps toNat off String.
def primStrM : Nat -> St -> Int -> Int -> Sig
  | 0, st, a, b =>
    if isPre 0 (spanBytes 0 st a b) "length" then { a := a, b := b, ret := 4, ps := [] : Sig }
    else miss 0
  | n + 1, st, a, b => primStrM n st a b

def recvGate : Nat -> Int
  | 0 =>
    let m1 : Map := putSpan 0 (map0 0) 2 [108, 101, 110, 103, 116, 104, 88];
    let m2 : Map := putSpan 0 m1 12 [116, 111, 78, 97, 116];
    let st : St := setPool 0 (initSt 0 []) m2;
    let st2 : St := setPool 0 (initSt 0 []) (putSpan 0 (map0 0) 2 [108, 101, 110, 103, 116, 104]);
    let hit : Sig := primStr 0 st 2 9;
    let mhit : Sig := primStrM 0 st 2 9;
    let ti : Sig := primInt 0 st 12 17;
    let ts : Sig := primStr 0 st 12 17;
    let ex : Sig := primStr 0 st2 2 8;
    if hit.a < 0 && mhit.a >= 0 && ti.a >= 0 && ts.a < 0 && ex.a >= 0 then 0 else 1
  | n + 1 => recvGate n

-- Mutant of pickTy: always binds the declared slot, which is 0 for the
-- unannotated `let x := e` form. letGate checks they disagree there and
-- agree on an annotated binding.
def pickTyM : Nat -> Int -> Int -> Int -> Int
  | 0, _, _, ty => ty
  | n + 1, tyN, vTy, ty => pickTyM n tyN vTy ty

def letGate : Nat -> Int
  | 0 =>
    if pickTy 0 (-1) 3 0 == 3 && pickTyM 0 (-1) 3 0 == 0 && pickTy 0 7 3 5 == 5 then 0 else 1
  | n + 1 => letGate n

-- Mutant of step1/advance: resets column only on the first newline, so a column
-- under a second newline is measured from the wrong line.
def step1M : Nat -> St -> St
  | 0, st =>
    let b : Int := hdB 0 st.cur;
    let nl : Bool := b == 10;
    let rst : Bool := nl && st.line == 0;
    let ln : Nat := if nl then st.line + 1 else st.line;
    let cl : Nat := if rst then 0 else st.col + 1;
    let ind : Nat := if nl then 0 else if st.col == st.indent && (b == 32 || b == 9) then cl else st.indent;
    { pool := st.pool, nodes := st.nodes, input := st.input, cur := drop1 0 st.cur, nxt := st.nxt, pos := st.pos + 1, line := ln, col := cl, indent := ind, err := st.err, ret := st.ret, root := st.root : St }
  | n + 1, st => step1M n st

def advanceGoM : St -> Nat -> St

  | st, 0 => st
  | st, k + 1 => advanceGoM (step1M 0 st) k

def appGate : Nat -> Int
  | 0 =>
    let bs : List Int := [97, 98, 10, 99, 100, 10, 101, 102];
    let stA : St := advance 0 (initSt 0 bs) 7;
    let stM : St := advanceGoM (initSt 0 bs) 7;
    if stA.col == 1 && stM.col == 4 then 0 else 1
  | n + 1 => appGate n

def emitSrc : Nat -> List Int -> List Int
  | 0, bs => emitParsed 0 (parseSrc 0 bs)
  | n + 1, bs => emitSrc n bs

-- The step-index budget is a named setting: emitSrcB passes it, emitSrc takes fuelBudget.
def emitSrcB : Nat -> Int -> List Int -> List Int
  | 0, bud, bs => emitParsedB 0 bud (parseSrc 0 bs)
  | n + 1, bud, bs => emitSrcB n bud bs
