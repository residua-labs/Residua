        let ann : Int := decTy st (headsOf hd) (-1) (-1) (-1) (fd 0 st id 1);
        let code : Int := if ann >= 100 && ann < 1000 then ann else exp;
        if code < 100 || code >= 1000 then bwErr 0 6
        else
          let hs : List Int := headsOf hd;
          let recs : List Int := recsOf hd;
          let idx : Int := code - 100;
          let i : Nat := Int.toNat idx;
          let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
          if hasI idx recs then
            lowRecArena st hd fs ctx (fd 0 st id 2) cnt code
          else
            lowRec st hd fs ctx (fd 0 st id 2) 0 cnt code
      else if t == 29 then
        if r.err != 0 then r
        else if (primWordMethod st r.ty (fd 0 st id 2) (fd 0 st id 3)).ret != 0 then
          wordConvert r (primWordMethod st r.ty (fd 0 st id 2) (fd 0 st id 3)).ret
        else if r.ty >= 100 && r.ty < 1000 then
          lowRecordProj st hd r id
        else if r.ty == 3 && spanEq 0 st (fd 0 st id 2) (fd 0 st id 3) "length" then
          bwOk 0 r.pre r.ctx r.moved (magnitudeMetadataNatW ([24,4,0] ++ r.bs)) 4
        else if spanEq 0 st (fd 0 st id 2) (fd 0 st id 3) "toNat" then
          let r0 : Bw := low st hd fs ctx (fd 0 st id 1) 0;
          if r0.err != 0 then r0
          else if r0.ty == 6 then bwOk 0 r0.pre r0.ctx r0.moved (magnitudeMetadataNatW r0.bs) 4
          else if r0.ty == 1 then
            bwOk 0 r0.pre r0.ctx r0.moved (intToNatW r0.bs) 4
          else bwErr 0 5
        else if spanEq 0 st (fd 0 st id 2) (fd 0 st id 3) "isDigit" then
          let r0 : Bw := low st hd fs ctx (fd 0 st id 1) 6;
          if r0.err != 0 then r0
          else bwOk 0 r0.pre r0.ctx r0.moved ([4, 0] ++ r0.bs ++ ([5, 17, 12, 3, 0] ++ litI 48 ++ ([17, 12] ++ litI 57 ++ [3, 0] ++ [1, 0]))) 2
        else bwErr 0 5
      else if t == 30 then
        let ty : Int := decTy st (headsOf hd) (-1) (-1) (-1) (fd 0 st id 2);
        if ty < 0 then bwErr 0 6
        else
          let r0 : Bw := low st hd fs ctx (fd 0 st id 1) ty;
          if r0.err != 0 then r0
          else bwOk 0 r0.pre r0.ctx r0.moved r0.bs ty
      else bwErr 0 6

-- Constructor argument lowering: the lowArgs recursion shape (pre/moved
-- fixups for arena binds) but each arg's bytes are framed as record field
-- f{j} — or kept bare when the ctor takes exactly one argument.
partial def lowCtorArgs : St -> List Int -> List Fn -> List Int -> List Int -> List Int -> Nat -> Nat -> Bw

  | st, hd, fs, ctx, [], [], j, cnt =>
    bwOk 0 [] ctx 0 [] 0
  | st, hd, fs, ctx, a :: as, p :: ps, j, cnt =>
    let x : Bw := low st hd fs ctx a p;
      if x.err != 0 then x
      else
        let keep : Bool := x.moved != 0;
        let nextCtx : List Int := if keep then -1 :: -1 :: x.ty :: shiftTrailer x.ctx 1 else x.ctx;
        let r : Bw := lowCtorArgs st hd fs nextCtx as ps (j + 1) cnt;
        if r.err != 0 then r
        else
          let xBs : List Int :=
            if keep then varB r.moved
            else if r.moved == 0 then x.bs
            else (low st hd fs r.ctx a p).bs;
          let saved : List Int := if keep then [4] ++ tyW hd x.ty ++ x.bs else [];
          let frag : List Int := if cnt == 1 then xBs else [34] ++ fiName j ++ xBs;
          bwOk 0 (x.pre ++ saved ++ r.pre) r.ctx (x.moved + (if keep then 1 else 0) + r.moved) (frag ++ r.bs) 0
  | _, _, _, _, _ :: _, [], _, _ => bwErr 0 7
  | _, _, _, _, [], _ :: _, _, _ => bwErr 0 7

partial def lowContainerArgs : St -> List Int -> List Fn -> List Int -> List Int -> List Int -> Int -> Int -> Int -> Int -> List Int -> Bw

  | st, hd, fs, ctx, [], [], op, ty, ret, cb, scrs =>
    if op < 20 || op == 28 || op == 29 || op == 31 || op == 32 || op == 33 || op == 35 || op == 36 || op == 37 || (op >= 40 && op <= 42) then bwOk 0 [] ctx 0 (containerBody 0 hd op ty ret scrs) ret
    else
      let callCtx : List Int := hofCallCtx 0 st hd ctx op ty ret cb;
      let arena : Bool := lenI (arenaBs hd ctx) != 0;
      let value : List Int := hofValue 0 hd op ty (shiftScruts scrs (if arena then 4 else 2)) (varB (if arena then 0 else 1)) (varB (if arena then 2 else 0));
      let w : Bw := if cb >= 0 then low st hd fs callCtx (fd 0 st cb 2) (fd 0 st cb 3) else bwOk 0 [] callCtx 0 value ret;
      hofFinish 0 hd ctx op ty ret scrs callCtx w
  | st, hd, fs, ctx, a :: as, p :: ps, op, ty, ret, cb, scrs =>
    let w : Bw := low st hd fs ctx a p;
    if w.err != 0 then w
    else
      let tw : List Int := tyW hd p;
      if hasTyErr 400 tw then bwErr 0 9
      else
        let ctx2 : List Int := -1 :: -1 :: p :: shiftTrailer w.ctx 1;
        let scrs2 : List Int := shiftScruts scrs (w.moved + 1) ++ [0];
        let b : Bw := lowContainerArgs st hd fs ctx2 as ps op ty ret cb scrs2;
        if b.err != 0 then b
        else if b.moved == 0 then bwOk 0 w.pre w.ctx w.moved ([4] ++ tw ++ w.bs ++ b.bs) ret
        else bwOk 0 (w.pre ++ [4] ++ tw ++ w.bs ++ b.pre) b.ctx (w.moved + b.moved + 1) b.bs ret
  | _, _, _, _, _, _, _, _, _, _, _ => bwErr 0 7

-- Bind source arguments once before calling a concrete used-only composition.
-- Retain the complete parameter list for its signature, even at the leaf.
partial def lowBasicArgs : St -> List Int -> List Fn -> List Int -> List Int -> List Int -> List Int -> Int -> Int -> Int -> List Int -> Bw
  | st, hd, fs, ctx, [], [], allPs, op, ty, ret, scrs =>
    bwOk 0 [] ctx 0 (basicDataCallW op ty ret allPs scrs) ret
  | st, hd, fs, ctx, a :: as, p :: ps, allPs, op, ty, ret, scrs =>
    let w : Bw := low st hd fs ctx a p;
    if w.err != 0 then w
    else
      let tw : List Int := tyW hd p;
      if hasTyErr 400 tw then bwErr 0 9
      else
        let ctx2 : List Int := -1 :: -1 :: p :: shiftTrailer w.ctx 1;
        let scrs2 : List Int := shiftScruts scrs (w.moved + 1) ++ [0];
        let b : Bw := lowBasicArgs st hd fs ctx2 as ps allPs op ty ret scrs2;
        if b.err != 0 then b
        else if b.moved == 0 then bwOk 0 w.pre w.ctx w.moved ([4] ++ tw ++ w.bs ++ b.bs) ret
        else bwOk 0 (w.pre ++ [4] ++ tw ++ w.bs ++ b.pre) b.ctx (w.moved + b.moved + 1) b.bs ret
  | _, _, _, _, _, _, _, _, _, _, _ => bwErr 0 7

-- Let-bind each scrutinee once. Existing matrix specialization handles the
-- arms; shifts include arena temporaries introduced by later scrutinees.

partial def lowTermScruts : St -> List Int -> List Fn -> List Int -> Int -> Int -> List Int -> List Int -> Int -> Bw

  | st, hd, fs, ctx, li, alts, scrs, tys, ret =>
    if ret <= 0 then bwErr 0 6
    else if li < 0 then
      let as : List Int := altIds st alts;
      let pc : Nat := lenI tys;
      let mx : Mx := { pats := flatAlts st as pc, alts := as, scrs := scrs, tys := tys, als := sepsN (lenI as), ncol := pc : Mx };
      lowMxEntry st hd fs mx ctx ret
    else
      let vA : Bw := low st hd fs ctx (fd 0 st li 1) 0;
      if vA.err != 0 then vA
      else
        let tw : List Int := tyW hd vA.ty;
        if hasTyErr 400 tw then bwErr 0 9
        else
          -- -11 marks a cases major already bound here. Nested projections
          -- keep ordinary anonymous slots and receive their own cases bind.
          let ctx2 : List Int := -11 :: -11 :: vA.ty :: shiftTrailer vA.ctx 1;
          let scrs2 : List Int := shiftScruts scrs (vA.moved + 1) ++ [0];
          let bA : Bw := lowTermScruts st hd fs ctx2 (fd 0 st li 2) alts scrs2 (tys ++ [vA.ty]) ret;
          if bA.err != 0 then bA
          else if bA.moved == 0 then
            bwOk 0 vA.pre vA.ctx vA.moved ([4] ++ tw ++ vA.bs ++ bA.bs) bA.ty
          else
            bwOk 0 (vA.pre ++ [4] ++ tw ++ vA.bs ++ bA.pre) bA.ctx (vA.moved + 1 + bA.moved) bA.bs bA.ty

-- Lean 4.14 Meta.Match.mkMatcher reports alternatives never selected by a leaf.
-- Check the complete source matrix once; one branch may use only a subset.
partial def lowMxEntry : St -> List Int -> List Fn -> Mx -> List Int -> Int -> Bw
  | st, hd, fs, mx, ctx, ret =>
    let w : Bw := lowMx st hd fs mx ctx ret;
    if w.err != 0 then w
    else
      let request : Rsdc.AlternativeUseNF.Request :=
        { alternatives := mx.alts : Rsdc.AlternativeUseNF.Request };
      let state : Rsdc.AlternativeUseNF.State :=
        { used := w.used : Rsdc.AlternativeUseNF.State };
      if Rsdc.AlternativeUseNF.admit request state then bwUse w []
      else bwErr 0 6

partial def lowMx : St -> List Int -> List Fn -> Mx -> List Int -> Int -> Bw

  | st, hd, fs, mx, ctx, ret =>
    if lenI mx.alts == 0 then bwErr 0 6
    else if lenI mx.pats != lenI mx.alts * mx.ncol then bwErr 0 6
    else if colIs st mx.pats 1 0 0 (-1) then bwErr 0 6
    else
      let nrow : Nat := lenI mx.alts;
      let oldC : Nat := findC st mx.pats mx.ncol nrow 0;
      let indC : Nat := indCol st hd mx 0 0;
      let baseC : Nat := if indC < oldC then indC else oldC;
      let optC : Nat := optionCol st mx 0 0;
      let c : Nat := if optC < baseC then optC else baseC;
      if c >= mx.ncol then
        let alt : Int := nthI mx.alts 0;
        let rowP : List Int := takeI mx.pats mx.ncol;
        let ctx2 : List Int := bindPats st rowP mx.scrs ctx;
        let seg : List Int := takeSeg mx.als;
        let ctx3 : List Int := if lenI seg == 0 then ctx2 else prependRx (maskRx st seg ctx2) seg;
        bwUse (low st hd fs ctx3 (fd 0 st alt 2) ret) [alt]
      else
        let ty : Int := nthI mx.tys c;
        let sk : Int := sniff st mx.pats mx.ncol c 0;
        let natB : Bool := ty == 4;
        let listB : Bool := isListTy 0 ty || sk == 2;
        let si : Int := nthI mx.scrs c;
        let major : List Int := varB si;
        let boundMajor : Bool := nthF 0 ctx (Int.toNat si * 3) == -11 && nthF 0 ctx (Int.toNat si * 3 + 1) == -11;
        let uniqueMajor : Bool :=
          ty >= 30000 && ty < 31000 &&
          nthF 0 (headsOf hd) (Int.toNat (ty - 30000) * 4 + 2) == -2 &&
          !(hasI (ty - 30000) (recsOf hd)) && !(flatEnum hd ty && indHeap hd);
        let anonymousMajor : Bool := sk == 4 && ty >= 100 && ty < 1000 && anonymousColumn st mx.pats mx.ncol c;
        if !boundMajor && (uniqueMajor || anonymousMajor) then
          let tw : List Int := tyW hd ty;
          if hasTyErr 400 tw then bwErr 0 9
          else
            let ctx1 : List Int := -11 :: -11 :: ty :: shiftTrailer ctx 1;
            let shifted : Mx := shiftMx mx 1;
            let mx1 : Mx := { pats := shifted.pats, alts := shifted.alts, scrs := placeAt shifted.scrs 0 c [0], tys := shifted.tys, als := shifted.als, ncol := shifted.ncol : Mx };
            let b : Bw := lowMx st hd fs mx1 ctx1 ret;
            if b.err != 0 then b
            else if b.moved == 0 then bwUsedOk b.used 0 [] ctx 0 ([4] ++ tw ++ major ++ b.bs) ret
            else bwUsedOk b.used 0 ([4] ++ tw ++ major ++ b.pre) b.ctx (b.moved + 1) b.bs ret
        else if isOptionTy 0 ty then
          let elem : Int := elemTy 0 ty;
          let tw : List Int := tyW hd ty;
          let ew : List Int := tyW hd elem;
          if hasTyErr 400 tw || hasTyErr 400 ew then bwErr 0 9
          else
            let yr : Bag := optionRows st mx 0 c 1 1 (acc0 0);
            let zr : Bag := optionRows st mx 0 c 2 0 (acc0 0);
            let ym : Mx := { pats := yr.pats, alts := yr.alts, scrs := 0 :: shiftScruts mx.scrs 1, tys := elem :: mx.tys, als := shiftSeg yr.als 1, ncol := mx.ncol + 1 : Mx };
            let zm : Mx := { pats := zr.pats, alts := zr.alts, scrs := mx.scrs, tys := mx.tys, als := zr.als, ncol := mx.ncol : Mx };
            let y : Bw := lowMx st hd fs ym (-1 :: -1 :: elem :: shiftTrailer ctx 1) ret;
            if y.err != 0 then y
            else
              let z : Bw := lowMx st hd fs zm ctx ret;
              if z.err != 0 then z
              else
                let test : List Int := [38] ++ tw ++ major;
                let bind : List Int := [4] ++ ew ++ [39] ++ major;
                if y.moved == 0 && z.moved == 0 then
                  bwUsedOk (y.used ++ z.used) 0 [] ctx 0 ([5] ++ test ++ bind ++ y.bs ++ z.bs) ret
                else
                  let yR : List Int := bind ++ y.pre ++ wrapResVal hd y.bs (arenaBs hd y.ctx);
                  let zR : List Int := z.pre ++ wrapResVal hd z.bs (arenaBs hd z.ctx);
                  let pre : List Int := [4] ++ wrapResTy hd ret ++ [5] ++ test ++ yR ++ zR;
                  let out : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
                  bwUsedOk (y.used ++ z.used) 0 pre out 1 (projF0 hd ret (varB 0)) ret
        else if ty >= 30000 && ty < 31000 then
          let col : Nat := c;
          let ty : Int := nthI mx.tys col;
          let si : Int := nthI mx.scrs col;
          let i : Nat := Int.toNat (ty - 30000);
          let hs : List Int := headsOf hd;
          let first : Int := nthF 0 hs (i * 4 + 3);
          let cnt : Int := 0 - 1 - nthF 0 hs (i * 4 + 2);
          if flatEnum hd ty && indHeap hd then lowIndBranches st hd fs mx ctx si ret col first first cnt
          else if cnt == 1 && !(hasI (ty - 30000) (recsOf hd)) then lowIndBranches st hd fs mx ctx si ret col first first cnt
          else if cnt <= 0 then bwErr 0 6
          else if !(hasI (ty - 30000) (recsOf hd)) then
            let arms : List Bw := lowSumBranches st hd fs mx ctx ret col first first cnt;
            let err : Int := sumArmsErr arms;
            if err != 0 then bwErr 0 err
            else
              let joined : Bool := sumArmsMove arms;
              let body : List Int := [32] ++ tyW hd ty ++ major ++ sumArmsW hd joined arms;
              if !joined then bwUsedOk (bwUsedRows arms) 0 [] ctx 0 body ret
              else
                let pre : List Int := [4] ++ wrapResTy hd ret ++ body;
                let out : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
                bwUsedOk (bwUsedRows arms) 0 pre out 1 (projF0 hd ret (varB 0)) ret
          else
            let ar : List Int := arenaBs hd ctx;
            if lenI ar == 0 then bwErr 0 8
            else
              let read : List Int := [52, 3, 1] ++ ar ++ [1] ++ varB si ++ [0];
              let ctx1 : List Int := -1 :: -1 :: 1 :: shiftTrailer ctx 1;
              let b : Bw := lowIndBranches st hd fs (shiftMx mx 1) ctx1 0 ret col first first cnt;
              if b.err != 0 then b
              else if b.moved == 0 then bwUsedOk b.used 0 [] ctx 0 ([4] ++ nodeTyW hd ++ read ++ b.bs) ret
              else bwUsedOk b.used 0 ([4] ++ nodeTyW hd ++ read ++ b.pre) b.ctx (b.moved + 1) b.bs ret
        else if sk == 5 && isProductTy 0 ty then
          let rows : Bag := productRows st mx 0 c (acc0 0);
          let next : Mx := { pats := rows.pats, alts := rows.alts, scrs := mx.scrs, tys := mx.tys, als := rows.als, ncol := mx.ncol + 2 : Mx };
          lowProductFields st hd fs next ctx si ty 0 [] [] ret
        else if sk == 4 && ty >= 100 && ty < 1000 then
          let i : Nat := Int.toNat (ty - 100);
          let hs : List Int := headsOf hd;
          let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
          let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
          let rows : Bag := recordRows st (fldsOf hd) mx 0 c first cnt (acc0 0);
          let mx2 : Mx := { pats := rows.pats, alts := rows.alts, scrs := mx.scrs, tys := mx.tys, als := rows.als, ncol := mx.ncol + cnt : Mx };
          lowRecordFields st hd fs mx2 ctx si ty first 0 cnt [] [] ret
        else if ty == 2 && fd 0 st (firstLiteral st mx c 0) 3 == -47 then
          -- Lean's Bool.casesOn binds its major and branches directly on it.
          -- Keep older literal matrices byte-canonical; only anonymous fields
          -- carry this pattern-origin marker.
          let ctx1 : List Int := -1 :: -1 :: 2 :: shiftTrailer ctx 1;
          let yesMx : Mx := shiftMx (literalSpec st mx c [0,1] true true) 1;
          let noMx : Mx := shiftMx (literalSpec st mx c [0] true true) 1;
          let y : Bw := lowMx st hd fs yesMx ctx1 ret;
          if y.err != 0 then y
          else
            let z : Bw := lowMx st hd fs noMx ctx1 ret;
            if z.err != 0 then z
            else if y.moved == 0 && z.moved == 0 then
              bwUsedOk (y.used ++ z.used) 0 [] ctx 0 ([4, 1] ++ major ++ [5, 3, 0] ++ y.bs ++ z.bs) ret
            else
              let yR : List Int := y.pre ++ wrapResVal hd y.bs (arenaBs hd y.ctx);
              let zR : List Int := z.pre ++ wrapResVal hd z.bs (arenaBs hd z.ctx);
              let pre : List Int := [4] ++ wrapResTy hd ret ++ [4, 1] ++ major ++ [5, 3, 0] ++ yR ++ zR;
              let out : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
              bwUsedOk (y.used ++ z.used) 0 pre out 1 (projF0 hd ret (varB 0)) ret
        else if ty == 4 && colIs st mx.pats mx.ncol 0 c 5 && colIs st mx.pats mx.ncol 0 c 2 then
          let expanded : ExpandedNatPats := expandNatValues st mx.pats mx.ncol c;
          let next : Mx := { pats := expanded.pats, alts := mx.alts, scrs := mx.scrs, tys := mx.tys, als := mx.als, ncol := mx.ncol : Mx };
          lowMx expanded.state hd fs next ctx ret
        else if colIs st mx.pats mx.ncol 0 c 5 || colIs st mx.pats mx.ncol 0 c 6 || (ty != 4 && colIs st mx.pats mx.ncol 0 c 1) then
          if colIs st mx.pats mx.ncol 0 c 2 then bwErr 0 6
          else
            let p : Int := firstLiteral st mx c 0;
            let value : List Int := literalValue st p;
            let yesMx : Mx := literalSpec st mx c value true true;
            let noMx : Mx := if ty == 2 then literalSpec st mx c (if value == [0] then [0,1] else [0]) true true else literalSpec st mx c value false false;
            let y : Bw := lowMx st hd fs yesMx ctx ret;
            if y.err != 0 then y
            else
              let z : Bw := lowMx st hd fs noMx ctx ret;
              if z.err != 0 then z
              else
                let valBs : List Int := if ty == 2 then [1, if value == [0] then 0 else 1]
                  else if ty == 4 then natMagnitudeLiteralWire (dropI value 1)
                  else if ty == 1 then intMagnitudeLiteralWire (hdB 0 value != 0) (dropI value 1)
                  else litI (fd 0 st (unwrapP st p) 3);
                let test : List Int := [14] ++ tyW hd ty ++ major ++ valBs;
                if y.moved == 0 && z.moved == 0 then bwUsedOk (y.used ++ z.used) 0 [] ctx 0 ([5] ++ test ++ y.bs ++ z.bs) ret
                else
                  let yR : List Int := y.pre ++ wrapResVal hd y.bs (arenaBs hd y.ctx);
                  let zR : List Int := z.pre ++ wrapResVal hd z.bs (arenaBs hd z.ctx);
                  let pre : List Int := [4] ++ wrapResTy hd ret ++ [5] ++ test ++ yR ++ zR;
                  let ctx1 : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
                  bwUsedOk (y.used ++ z.used) 0 pre ctx1 1 (projF0 hd ret (varB 0)) ret
        else if natB then
          if !(colIs st mx.pats mx.ncol 0 c 2) then
            let zmx : Mx := spec st mx c 5 ty;
            let emx : Mx := spec st mx c 6 ty;
            if lenI zmx.alts == 0 || lenI emx.alts == 0 then bwErr 0 6
            else
              let z : Bw := lowMx st hd fs zmx ctx ret;
              if z.err != 0 then z
              else
                let e : Bw := lowMx st hd fs emx ctx ret;
                if e.err != 0 then e
                else if z.moved == 0 && e.moved == 0 then
                  bwUsedOk (z.used ++ e.used) 0 [] ctx 0 ([5] ++ magnitudeNatZeroW (varB si) ++ z.bs ++ e.bs) ret
                else
                  let zR : List Int := z.pre ++ wrapResVal hd z.bs (arenaBs hd z.ctx);
                  let eR : List Int := e.pre ++ wrapResVal hd e.bs (arenaBs hd e.ctx);
                  let ifBs : List Int := [5] ++ magnitudeNatZeroW (varB si) ++ zR ++ eR;
                  let pre1 : List Int := [4] ++ wrapResTy hd ret ++ ifBs;
                  let ctx1 : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
                  bwUsedOk (z.used ++ e.used) 0 pre1 ctx1 1 (projF0 hd ret (varB 0)) ret
          else
            let zmx : Mx := spec st mx c 1 ty;
            let smx : Mx := spec st mx c 2 ty;
            if lenI zmx.alts == 0 || lenI smx.alts == 0 then bwErr 0 6
            else
              let tw : List Int := tyW hd ty;
              if hasTyErr 400 tw then bwErr 0 9
              else
                let z : Bw := lowMx st hd fs zmx (-1 :: -1 :: ty :: ctx) ret;
                if z.err != 0 then z
                else
                  let sb : Bw := lowMx st hd fs smx (-1 :: -1 :: 4 :: (-1 :: -1 :: ty :: ctx)) ret;
                  if sb.err != 0 then sb
                  else
                    let tst : List Int := magnitudeNatZeroW (varB 0);
                    if z.moved == 0 && sb.moved == 0 then
                      let arm : List Int := [4] ++ natMagnitudeTyW ++ natPred ++ sb.bs;
                      bwUsedOk (z.used ++ sb.used) 0 [] ctx 0 ([4] ++ tw ++ major ++ ([5] ++ tst ++ z.bs ++ arm)) ret
                    else
                      let zR : List Int := z.pre ++ wrapResVal hd z.bs (arenaBs hd z.ctx);
                      let sbR : List Int := sb.pre ++ wrapResVal hd sb.bs (arenaBs hd sb.ctx);
                      let arm : List Int := [4] ++ natMagnitudeTyW ++ natPred ++ sbR;
                      let mBs : List Int := [4] ++ tw ++ major ++ ([5] ++ tst ++ zR ++ arm);
                      let pre1 : List Int := [4] ++ wrapResTy hd ret ++ mBs;
                      let ctx1 : List Int := -3 :: -3 :: ret :: shiftTrailer ctx 1;
                      bwUsedOk (z.used ++ sb.used) 0 pre1 ctx1 1 (projF0 hd ret (varB 0)) ret
        else if listB then
          let nmx : Mx := spec st mx c 3 ty;
          let cmx : Mx := spec st mx c 4 ty;
          if lenI nmx.alts == 0 || lenI cmx.alts == 0 then bwErr 0 6
          else
            let elem : Int := if isListTy 0 ty then elemTy 0 ty else if basicKind 0 ty == 4 then basicFirst 0 ty else 0;
            let tw : List Int := tyW hd ty;
            let ew : List Int := tyW hd elem;
            if hasTyErr 400 tw || hasTyErr 400 ew then bwErr 0 9
            else
              let nb : Bw := lowMx st hd fs nmx (-1 :: -1 :: ty :: ctx) ret;
              if nb.err != 0 then nb
              else
                let cb : Bw := lowMx st hd fs cmx (-1 :: -1 :: ty :: (-1 :: -1 :: elem :: (-1 :: -1 :: ty :: ctx))) ret;
                if cb.err != 0 then cb
                else
                  let tst : List Int := [14, 0] ++ ([24] ++ tw ++ [3, 0]) ++ litI 0;
