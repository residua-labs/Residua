def magnitudeNatCharBoundW : List Int :=
  [5,16,12] ++ varB 0 ++ litI 55296 ++
    [15,12] ++ litI 57343 ++ varB 0 ++ [12] ++ varB 0 ++ litI 1114112 ++
    varB 0 ++ litI 0

def magnitudeNatCharW (input : List Int) : List Int :=
  [4,0] ++ magnitudeNatIndexW input ++ [-600030]

def magnitudeMetadataNatW (input : List Int) : List Int :=
  [4,0] ++ input ++ [-600026]

def stringToNatW (input : List Int) : List Int :=
  [4,4,0] ++ input ++ [-600031]

def decimalStringW (ty : Int) (input : List Int) : List Int :=
  [4] ++ (if ty == 4 then natMagnitudeTyW else intMagnitudeTyW) ++ input ++
    (if ty == 4 then [-600032] else [-600033])

def litS : St -> Int -> Int -> List Int

  | st, a, b =>
    litStringChars (spanBytes 0 st (a + 1) (b - 1))

def alphRank : Nat -> Int -> Int
  | 0, b =>
    if b >= 48 && b <= 57 then b - 48
    else if b >= 65 && b <= 90 then 10 + (b - 65)
    else if b == 95 then 36
    else if b >= 97 && b <= 122 then 37 + (b - 97)
    else 999
  | n + 1, b => alphRank n b

def cmpBytes : List Int -> List Int -> Int

  | [], [] => 0
  | [], _ :: _ => -1
  | _ :: _, [] => 1
  | x :: xs, y :: ys =>
    if x == y then cmpBytes xs ys
    else if alphRank 0 x < alphRank 0 y then -1
    else 1

def cmpAt : St -> Int -> Int -> Int -> Int -> Int

  | st, i, e1, j, e2 =>
    cmpBytes (spanBytes 0 st i e1) (spanBytes 0 st j e2)
partial def liSpans : St -> Int -> List Int

  | st, li =>
    if li < 0 then []
    else
      let idn : Int := fd 0 st li 1;
      [fd 0 st idn 1, fd 0 st idn 2] ++ liSpans st (fd 0 st li 2)

partial def grpSpans : St -> Int -> List Int

  | st, g =>
    if g < 0 then []
    else liSpans st (fd 0 st g 1) ++ grpSpans st (fd 0 st g 3)

def zipCtx : List Int -> List Int -> List Int

  | na :: nb :: ns, t :: ts => na :: nb :: t :: zipCtx ns ts
  | [], t :: ts => -1 :: -1 :: t :: zipCtx [] ts
  | _, _ => []

def setSlot : List Int -> Nat -> Int -> Int -> List Int

  | na :: nb :: ty :: rest, 0, a, b =>
    a :: b :: ty :: rest
  | na :: nb :: ty :: rest, i + 1, a, b =>
    na :: nb :: ty :: setSlot rest i a b
  | ctx, _, _, _ =>
    ctx

def look : St -> List Int -> Int -> Int -> Int

  | _, [], _, _ => -1
  | st, a :: b :: _ :: rest, na, nb =>
    if a == -9 then -1
    else if a >= 0 && spanSame 0 st na nb a b then 0
    else
      let r : Int := look st rest na nb;
      if r < 0 then -1 else r + 1
  | st, _, _, _ =>
    -1

-- Parameter slots stay in call order. A later binder shadows the name of
-- an earlier slot, without moving either slot or changing local-let lookup.
def rightmostParams : St -> List Int -> List Int

  | st, a :: b :: ty :: rest =>
    let tail : List Int := rightmostParams st rest;
    if a >= 0 && look st rest a b >= 0 then -1 :: -1 :: ty :: tail
    else a :: b :: ty :: tail
  | _, _ => []

-- A trailer after -9 is a refinement: na, nb, ty, template, -7.
-- Templates: 1 idx var, 2 nil, 3 head tail cons, 4 lit.
partial def shiftT : List Int -> Int -> Cut

  | [], _ => { bs := [], rest := [] : Cut }
  | x :: xs, k =>
    if x == 1 then { bs := [1, nthI xs 0 + k], rest := dropI xs 1 : Cut }
    else if x == 2 then { bs := [2], rest := xs : Cut }
    else if x == 4 then { bs := [4, nthI xs 0], rest := dropI xs 1 : Cut }
    else if x == 3 then
      let h : Cut := shiftT xs k;
      let t : Cut := shiftT h.rest k;
      { bs := [3] ++ h.bs ++ t.bs, rest := t.rest : Cut }
    else { bs := [], rest := x :: xs : Cut }

partial def shiftSeg : List Int -> Int -> List Int

  | [], _ => []
  | x :: xs, k =>
    if x == -8 then -8 :: shiftSeg xs k
    else
      let nb : Int := nthI xs 0;
      let ty : Int := nthI xs 1;
      let c : Cut := shiftT (dropI xs 2) k;
      let after : List Int := if nthI c.rest 0 == -7 then dropI c.rest 1 else c.rest;
      x :: nb :: ty :: c.bs ++ (-7) :: shiftSeg after k

def shiftTrailer : List Int -> Int -> List Int

  | [], _ => []
  | x :: xs, k =>
    if x == -9 then -9 :: shiftSeg xs k
    else x :: shiftTrailer xs k

partial def substT : List Int -> Int -> List Int -> Cut

  | [], _, _ => { bs := [], rest := [] : Cut }
  | x :: xs, target, repl =>
    if x == 1 then
      if nthI xs 0 == target then { bs := repl, rest := dropI xs 1 : Cut }
      else { bs := [1, nthI xs 0], rest := dropI xs 1 : Cut }
    else if x == 2 then { bs := [2], rest := xs : Cut }
    else if x == 4 then { bs := [4, nthI xs 0], rest := dropI xs 1 : Cut }
    else if x == 3 then
      let h : Cut := substT xs target repl;
      let t : Cut := substT h.rest target repl;
      { bs := [3] ++ h.bs ++ t.bs, rest := t.rest : Cut }
    else { bs := [], rest := x :: xs : Cut }

partial def substSeg : List Int -> Int -> List Int -> List Int

  | [], _, _ => []
  | x :: xs, target, repl =>
    if x == -8 then -8 :: substSeg xs target repl
    else
      let nb : Int := nthI xs 0;
      let ty : Int := nthI xs 1;
      let c : Cut := substT (dropI xs 2) target repl;
      let after : List Int := if nthI c.rest 0 == -7 then dropI c.rest 1 else c.rest;
      x :: nb :: ty :: c.bs ++ (-7) :: substSeg after target repl

-- Refined binders retain their type through zero/list specialization.
partial def emitT : List Int -> Int -> Cut

  | [], _ => { bs := [], rest := [] : Cut }
  | x :: xs, ty =>
    if x == 1 then { bs := varB (nthI xs 0), rest := dropI xs 1 : Cut }
    else if x == 2 then { bs := [22], rest := xs : Cut }
    else if x == 4 then
      let value : Int := nthI xs 0;
      let bs : List Int := if ty == 4 then natMagnitudeLiteralWire (numeralSmall value)
        else if ty == 1 then intMagnitudeLiteralWire (value < 0) (numeralSmall (if value < 0 then -value else value))
        else litI value;
      { bs := bs, rest := dropI xs 1 : Cut }
    else if x == 3 then
      let h : Cut := emitT xs (elemTy 0 ty);
      let t : Cut := emitT h.rest ty;
      { bs := [26, 23] ++ h.bs ++ t.bs, rest := t.rest : Cut }
    else { bs := [], rest := x :: xs : Cut }

def skipMark : List Int -> List Int

  | [] => []
  | x :: xs =>
    if x == -9 then xs
    else skipMark xs

partial def findRx : St -> List Int -> Int -> Int -> List Int

  | _, [], _, _ => []
  | st, x :: xs, a, b =>
    if x == -8 then findRx st xs a b
    else
      let nb : Int := nthI xs 0;
      let ty : Int := nthI xs 1;
      let c : Cut := shiftT (dropI xs 2) 0;
      let after : List Int := if nthI c.rest 0 == -7 then dropI c.rest 1 else c.rest;
      if spanSame 0 st a b x nb then ty :: c.bs else findRx st after a b

def tyAt : List Int -> Nat -> Int

  | [], _ => 0
  | _ :: _ :: t :: _, 0 => t
  | _ :: _ :: _ :: rest, i + 1 => tyAt rest i
  | _, _ => 0

-- One dummy binder per step. look skips a negative name, so indices shift and names do not capture.
-- This Nat is the number of dummy binders to insert, not a resource bound.
def bump : Nat -> List Int -> List Int
  | 0, ctx => ctx
  | k + 1, ctx => -1 :: -1 :: 1 :: bump k (shiftTrailer ctx 1)

def dummyFn : Nat -> Fn
  | 0 => { na := -1, nb := -1, ps := [], ret := 0, node := -1, cals := [], usesA := 0, resA := 0, part := 0, bud := 0 : Fn }
  | n + 1 => dummyFn n

def nthFn : List Fn -> Nat -> Fn

  | [], _ => dummyFn 0
  | f :: _, 0 => f
  | _ :: fs, k + 1 => nthFn fs k

def pickFn : List Int -> List Fn -> List Fn

  | [], _ => []
  | i :: is, fs => nthFn fs (Int.toNat i) :: pickFn is fs

def fnIx : St -> List Fn -> Int -> Int -> Int

  | _, [], _, _ => -1
  | st, f :: fs, na, nb =>
    if spanSame 0 st na nb f.na f.nb then 0
    else
      let r : Int := fnIx st fs na nb;
      if r < 0 then -1 else r + 1

def lenFn : List Fn -> Nat

  | [] => 0
  | _ :: fs => lenFn fs + 1

def wordHelperIx : St -> List Fn -> Int -> Int
  | _, [], _ => -1
  | st, f :: fs, h =>
    if h > 0 && spanEq 0 st f.na f.nb (wordHelperName h) then 0
    else
      let i : Int := wordHelperIx st fs h;
      if i < 0 then -1 else i + 1

-- Original declaration spans distinguish user roots from injected bridge
-- declarations. Qualification retains those source spans.
def wordRoots : St -> List Fn -> Int -> List Int
  | _, [], _ => []
  | st, f :: fs, i =>
    let cutoff : Int := fd 0 st st.root 2;
    let roots : List Int := wordRoots st fs (i + 1);
    if cutoff <= 0 || fd 0 st (fd 0 st f.node 1) 1 < cutoff then i :: roots else roots

-- General graph recursion: emitted execution receives EMIT-FUEL, whose
-- exhaustion is a named resource refusal. No hand-written traversal fuel.
partial def wordReach : List Fn -> List Int -> List Int -> List Int
  | _, [], seen => seen
  | fs, i :: todo, seen =>
    if hasI i seen then wordReach fs todo seen
    else wordReach fs ((nthFn fs (Int.toNat i)).cals ++ todo) (i :: seen)

def allIn : List Int -> List Int -> Bool

  | [], _ => true
  | c :: cs, p => hasI c p && allIn cs p

def rangeI : Nat -> Nat -> List Int
  | 0, _ => []
  | n + 1, i => Int.ofNat i :: rangeI n (i + 1)

def cmpIx : St -> List Fn -> Int -> Int -> Int

  | st, fs, i, j =>
    let a : Fn := nthFn fs (Int.toNat i);
      let b : Fn := nthFn fs (Int.toNat j);
      cmpAt st a.na a.nb b.na b.nb

def bestI : St -> List Fn -> List Int -> Int

  | _, _, [] => 0
  | _, _, i :: [] => i
  | st, fs, i :: rest =>
    let j : Int := bestI st fs rest;
    if cmpIx st fs i j < 0 then i else j

def readyI : List Fn -> List Int -> List Int -> List Int

  | _, _, [] => []
  | fs, placed, i :: rest =>
    let f : Fn := nthFn fs (Int.toNat i);
    if allIn f.cals placed then i :: readyI fs placed rest else readyI fs placed rest

-- Kahn, CACM 5(11), 1962, doi:10.1145/368996.369025.
-- Persistent AVL indices/queues use the Adams/OCaml balancing above.
-- Fast path: O((V+E) log V) indexed operations plus name-byte comparison;
-- prefix-trie validation adds O(M log(M+1)) work for M total name bytes.
-- Space is O(V+E+M); V includes indexed functions/input memberships.
-- A prefix/rank collision or incompatible ordinal inputs use the exact legacy
-- recursion. Queue ties use decreasing remainder position: bestI selected the
-- last equal name. Empty-ready fallback keeps the old cycle-breaking order.
structure OrderWork where
  meta : Map
  links : Map
  ready : Map
  pending : Map
  deriving Inhabited

def orderFnTable : List Fn -> Int -> Map -> Map
  | [], _, table => table
  | f :: fs, i, table =>
    orderFnTable fs (i + 1) (ins table i 0 f.na f.nb f.cals).m

def orderPlaced : List Int -> Map -> Map
  | [], table => table
  | i :: rest, table => orderPlaced rest (ins table i 1 0 0 []).m

-- Knuth, TAOCP volume 3, section 6.3: digital/radix search.
-- Engineering validation only: at an exact prefix, distinct bytes must have
-- distinct alphRank values. Thus cmpBytes is total over this set of names.
structure OrderNames where
  edges : Map
  next : Int
  ok : Bool
  deriving Inhabited

def orderName : List Int -> Int -> OrderNames -> OrderNames
  | [], _, names => names
  | b :: rest, node, names =>
    if !names.ok then names
    else
      let key : Int := node * 1000 + alphRank 0 b;
      let edge : MR := get names.edges key;
      if edge.hit.tag == 0 then
        let child : Int := names.next;
        let added : OrderNames :=
          { names with
            edges := (ins names.edges key child b 0 []).m,
            next := child + 1 };
        orderName rest child added
      else if edge.hit.sa != b then { names with ok := false }
      else orderName rest edge.v names

def orderCompatible : St -> Map -> Map -> Map -> OrderNames -> List Int -> Bool
  | _, _, _, _, names, [] => names.ok
  | st, table, placed, seen, names, i :: rest =>
    let f : MR := get table i;
    if f.hit.tag == 0 || (get placed i).hit.tag != 0 || (get seen i).hit.tag != 0 then false
    else
      let nextNames : OrderNames := orderName (spanBytes 0 st f.hit.sa f.hit.sb) 0 names;
      if !nextNames.ok then false
      else orderCompatible st table placed (ins seen i 1 0 0 []).m nextNames rest

def orderMissing : Map -> List Int -> Int
  | _, [] => 0
  | placed, i :: rest =>
    (if (get placed i).v < 0 then 1 else 0) + orderMissing placed rest

def orderLink : Int -> List Int -> Map -> Map
  | _, [], links => links
  | i, c :: rest, links =>
    let old : MR := get links c;
    orderLink i rest (ins links c 0 0 0 (i :: old.xs)).m

partial def orderQueue : St -> Int -> Int -> Int -> Int -> Map -> Map
  | st, i, rank, na, nb, tree =>
    if tree.tag == 0 then mk 0 (map0 0) i rank na nb [] (map0 0)
    else
      let c : Int := cmpAt st na nb tree.sa tree.sb;
      if c < 0 || (c == 0 && rank > tree.val) then
        bal 0 (orderQueue st i rank na nb (kid 0 tree.left))
          tree.key tree.val tree.sa tree.sb [] (kid 0 tree.right)
      else
        bal 0 (kid 0 tree.left) tree.key tree.val tree.sa tree.sb []
          (orderQueue st i rank na nb (kid 0 tree.right))

partial def orderPop : Map -> MR
  | tree =>
    if tree.tag == 0 then mr0 0 tree (-1)
    else if (kid 0 tree.left).tag == 0 then
      { m := kid 0 tree.right, v := tree.key, steps := 0, xs := [], hit := tree : MR }
    else
      let r : MR := orderPop (kid 0 tree.left);
      { r with m := bal 0 r.m tree.key tree.val tree.sa tree.sb [] (kid 0 tree.right) }

partial def orderLive : Map -> Map -> MR
  | meta, queue =>
    let r : MR := orderPop queue;
    if r.hit.tag == 0 || (get meta r.v).hit.sb == 1 then r
    else orderLive meta r.m

def orderInit : St -> Map -> Map -> List Int -> Int -> OrderWork -> OrderWork
  | _, _, _, [], _, work => work
  | st, table, placed, i :: rest, rank, work =>
    let f : MR := get table i;
    let degree : Int := orderMissing placed f.xs;
    let na : Int := if f.hit.tag == 0 then -1 else f.hit.sa;
    let nb : Int := if f.hit.tag == 0 then -1 else f.hit.sb;
    let next : OrderWork :=
      { meta := (ins work.meta i degree rank 1 []).m,
        links := orderLink i f.xs work.links,
        ready := if degree == 0 then orderQueue st i rank na nb work.ready else work.ready,
        pending := orderQueue st i rank na nb work.pending : OrderWork };
    orderInit st table placed rest (rank + 1) next

def orderRelease : St -> Map -> List Int -> OrderWork -> OrderWork
  | _, _, [], work => work
  | st, table, i :: rest, work =>
    let old : MR := get work.meta i;
    if old.hit.sb != 1 || old.v <= 0 then orderRelease st table rest work
    else
      let degree : Int := old.v - 1;
      let f : MR := get table i;
      let next : OrderWork :=
        { work with
          meta := (ins work.meta i degree old.hit.sa 1 []).m,
          ready := if degree == 0 then
            orderQueue st i old.hit.sa f.hit.sa f.hit.sb work.ready else work.ready };
      orderRelease st table rest next

def orderRun : Nat -> St -> Map -> OrderWork -> List Int -> List Int
  | 0, _, _, _, rev => revI [] rev
  | n + 1, st, table, work, rev =>
    let ready : MR := orderLive work.meta work.ready;
    let pending : MR := if ready.hit.tag == 0 then orderLive work.meta work.pending else mr0 0 work.pending (-1);
    let pick : Int := if ready.hit.tag == 0 then pending.v else ready.v;
    let old : MR := get work.meta pick;
    let next : OrderWork :=
      { work with
        meta := (ins work.meta pick old.v old.hit.sa 0 []).m,
        ready := ready.m,
        pending := if ready.hit.tag == 0 then pending.m else work.pending };
    let released : OrderWork := orderRelease st table (get work.links pick).xs next;
    orderRun n st table released (pick :: rev)

partial def orderLegacyI : St -> List Fn -> List Int -> List Int -> List Int
  | _, _, [], placed => placed
  | st, fs, rem, placed =>
    let rd : List Int := readyI fs placed rem;
      let pool : List Int := if lenI rd == 0 then rem else rd;
      let pick : Int := bestI st fs pool;
      orderLegacyI st fs (delI pick rem) (placed ++ [pick])

def orderI : St -> List Fn -> List Int -> List Int -> List Int
  | _, _, [], placed => placed
  | st, fs, rem, placed =>
    let table : Map := orderFnTable fs 0 (map0 0);
    let placedMap : Map := orderPlaced placed (map0 0);
    let names : OrderNames := { edges := map0 0, next := 1, ok := true : OrderNames };
    if !(orderCompatible st table placedMap (map0 0) names rem) then orderLegacyI st fs rem placed
    else
      let initial : OrderWork :=
        { meta := map0 0, links := map0 0, ready := map0 0, pending := map0 0 : OrderWork };
      let work : OrderWork := orderInit st table placedMap rem 0 initial;
      placed ++ orderRun (lenI rem) st table work []

def patAt : St -> Int -> Nat -> Int

  | st, li, 0 => fd 0 st li 1
  | st, li, k + 1 => patAt st (fd 0 st li 2) k

partial def plen : St -> Int -> Nat

  | st, li => if li < 0 then 0 else plen st (fd 0 st li 2) + 1

def binderP : St -> Int -> Bool

  | st, id =>
    let p : Int := unwrapP st id;
      let t : Int := fd 0 st p 0;
      if natConstructorPatCode st p != 0 || optionPatCode st p != 0 then false
      else if t == 1 then !(spanEq 0 st (fd 0 st p 1) (fd 0 st p 2) "true" || spanEq 0 st (fd 0 st p 1) (fd 0 st p 2) "false")
      else t == 4

def kindP : St -> Int -> Int

  | st, id =>
    let p : Int := unwrapP st id;
      let t : Int := fd 0 st p 0;
      if natConstructorPatCode st p != 0 then natConstructorPatCode st p
      else if optionPatCode st p != 0 then 8
      else if t == 2 && fd 0 st p 1 != -1 && lenI (numeralMagnitude st p) == 0 then 1
      else if t == 2 || (t == 7 && fd 0 st p 1 == 1 && fd 0 st (fd 0 st p 2) 0 == 2) then 5
      else if t == 1 && (spanEq 0 st (fd 0 st p 1) (fd 0 st p 2) "true" || spanEq 0 st (fd 0 st p 1) (fd 0 st p 2) "false") then 6
      else if t == 11 && fd 0 st p 1 < 0 then 3
      else if t == 6 && fd 0 st p 1 == 13 then 4
      else if t == 6 && fd 0 st p 1 == 1 && fd 0 st (fd 0 st p 3) 0 == 2 && numeralMagnitude st (fd 0 st p 3) == [1] then 2
      else if t == 42 then 9
      else if t == 14 then 7
      else if t == 5 then 8
      else if binderP st p then 0
      else -1

partial def altIds : St -> Int -> List Int

  | st, id => if id < 0 then [] else id :: altIds st (fd 0 st id 3)

def anyCon : St -> List Int -> Nat -> Bool

  | _, [], _ => false
  | st, a :: as, i =>
    !(binderP st (patAt st (fd 0 st a 1) i)) || anyCon st as i

partial def findScrut : St -> List Int -> Nat -> Nat -> Nat

  | st, as, lim, i =>
    if i >= lim then i
    else if anyCon st as i then i
    else findScrut st as lim (i + 1)

def findKind : St -> List Int -> Nat -> Int -> Int

  | _, [], _, _ => -1
  | st, a :: as, i, k =>
    if kindP st (patAt st (fd 0 st a 1) i) == k then a
    else findKind st as i k

partial def paint : St -> Int -> Nat -> Nat -> Nat -> List Int -> List Int

  | st, li, i, scrut, base, ctx =>
    if li < 0 then ctx
    else
      let ctx2 : List Int :=
        if i == scrut then ctx
        else
          let p : Int := unwrapP st (fd 0 st li 1);
          if fd 0 st p 0 == 1 then setSlot ctx (base + i) (fd 0 st p 1) (fd 0 st p 2) else ctx;
      paint st (fd 0 st li 2) (i + 1) scrut base ctx2

-- Saturate the canonical magnitude at the existing inlining bound.
-- Each intermediate is below 256 * bound, independent of host payload wrap.
partial def numeralBounded (digits : List Int) (bound : Int) : Int :=
  match digits with
  | [] => 0
  | d :: ds =>
    let rest : Int := numeralBounded ds bound;
    if rest >= bound then bound
    else
      let value : Int := d + 256 * rest;
      if value >= bound then bound else value

def defConstInt : St -> Fn -> Int

  | st, f =>
    if lenI f.ps != 0 || f.ret == 1 || f.ret == 4 then -1
    else
      let body : Int := fd 0 st f.node 3;
      if fd 0 st body 0 != 25 then -1
      else
        let inner : Int := unwrapP st (fd 0 st body 1);
        if fd 0 st inner 0 != 2 || fd 0 st inner 1 < 0 then -1
        else
          let v : Int := numeralBounded (numeralMagnitude st inner) 1000000000000;
          if v < 1000000000000 then
            if isWordTy f.ret then v % wordModulus f.ret else v
          else -1

def defLitFld : St -> Fn -> Int -> Int -> Int

  | st, f, fa, fb =>
    if lenI f.ps != 0 || f.part != 0 || f.ret < 100 || f.ret >= 1000 then -1
    else
      let body : Int := fd 0 st f.node 3;
      if fd 0 st body 0 != 25 then -1
      else
        let inner : Int := unwrapP st (fd 0 st body 1);
        if fd 0 st inner 0 != 14 then -1
        else findLit st (fd 0 st inner 2) fa fb

mutual
partial def calsOf : St -> List Fn -> Int -> List Int

  | st, fs, id =>
    if id < 0 then []
    else
      let t : Int := fd 0 st id 0;
      if t == 25 then calsOf st fs (fd 0 st id 1)
      else if t == 23 then calsAlts st fs (fd 0 st id 1)
      else if t == 31 then calsLi st fs (fd 0 st id 1) ++ calsAlts st fs (fd 0 st id 2)
      else if t == 24 || t == 32 then calsOf st fs (fd 0 st id 2)
      else if t == 1 then
        if fd 0 st id 3 == -9 then []
        else
          let na : Int := fd 0 st id 1;
          let nb : Int := fd 0 st id 2;
          let hit : Int := fnIx st fs na nb;
          if hit >= 0 then
            let f : Fn := nthFn fs (Int.toNat hit);
            if lenI f.ps == 0 && defConstInt st f < 0 then [hit] else []
          else
            let dot : Int := lastDot st na nb;
            if dot < 0 then []
            else
              let hit2 : Int := fnIx st fs na dot;
              if hit2 < 0 then []
              else
                let f : Fn := nthFn fs (Int.toNat hit2);
                if lenI f.ps == 0 && f.ret >= 100 && f.ret < 1000 then
                  let eid : Int := defLitFld st f (dot + 1) nb;
                  if eid >= 0 then calsOf st fs eid else [hit2]
                else []
      else if t == 5 then
        let fn : Int := getFn st id;
        let args : List Int := getArgs st id;
        let hit : Int := if fd 0 st fn 0 == 1 && fd 0 st fn 3 != -9 then fnIx st fs (fd 0 st fn 1) (fd 0 st fn 2) else -1;
        let rest : List Int := (if fd 0 st fn 0 == 29 then calsOf st fs (fd 0 st fn 1) else []) ++ calsArgs st fs args;
        if hit >= 0 then hit :: rest else rest
      else if t == 6 then
        let op : Int := fd 0 st id 1;
        let h : Int := wordHelperIx st fs (wordHelper (op / 100) (op % 100));
        (if h >= 0 then [h] else []) ++ calsOf st fs (fd 0 st id 2) ++ calsOf st fs (fd 0 st id 3)
      else if t == 7 then
        let op : Int := fd 0 st id 1;
        let h : Int := if op % 100 == 3 && isWordTy (op / 100) then wordHelperIx st fs 10 else -1;
        (if h >= 0 then [h] else []) ++ calsOf st fs (fd 0 st id 2)
      else if t == 13 then calsOf st fs (fd 0 st id 1)
      else if t == 8 then calsOf st fs (fd 0 st id 1) ++ calsOf st fs (fd 0 st id 2) ++ calsOf st fs (fd 0 st id 3)
      else if t == 9 then
        let r2 : Int := fd 0 st id 3;
        calsOf st fs (fd 0 st r2 1) ++ calsOf st fs (fd 0 st r2 2)
      else if t == 10 || t == 33 || t == 42 then calsOf st fs (fd 0 st id 1) ++ calsOf st fs (fd 0 st id 2)
      else if t == 11 then calsLi st fs (fd 0 st id 1)
      else if t == 14 then calsOf st fs (fd 0 st id 2)
      else if t == 15 then calsOf st fs (fd 0 st id 2) ++ calsOf st fs (fd 0 st id 3)
      else if t == 17 then calsOf st fs (fd 0 st id 1)
      else if t == 29 then calsOf st fs (fd 0 st id 1)
      else if t == 30 then calsOf st fs (fd 0 st id 1)
      else if t == 20 then calsOf st fs (fd 0 st id 3)
      else []

partial def calsAlts : St -> List Fn -> Int -> List Int

  | st, fs, id =>
    if id < 0 then []
    else calsOf st fs (fd 0 st id 2) ++ calsAlts st fs (fd 0 st id 3)

partial def calsLi : St -> List Fn -> Int -> List Int

  | st, fs, li =>
    if li < 0 then []
    else calsOf st fs (fd 0 st li 1) ++ calsLi st fs (fd 0 st li 2)

partial def calsArgs : St -> List Fn -> List Int -> List Int

  | _, _, [] => []
  | st, fs, a :: as => calsOf st fs a ++ calsArgs st fs as
end

def oneFn : Env -> St -> Int -> Fn

  | env, st, d =>
    let nm : Int := fd 0 st d 1;
      let qs : List Int := qsp 0 st nm;
      let na : Int := nthI qs 0;
      let nb : Int := nthI qs 1;
      let sg : Sig := findSigE st env na nb;
      { na := na, nb := nb, ps := sg.ps, ret := sg.ret, node := d, cals := [], usesA := 0, resA := 0, part := fd 0 st (fd 0 st d 2) 3, bud := 0 : Fn }

partial def gather : St -> Env -> Int -> List Fn

  | st, env, id =>
    if id < 0 then []
    else if fd 0 st id 0 != 19 then []
    else
      let d : Int := fd 0 st id 1;
      let t : Int := fd 0 st d 0;
      let rest : List Fn := gather st env (fd 0 st id 2);
      if t == 20 then oneFn env st d :: rest
      else if t == 28 then gather st env (fd 0 st d 1) ++ rest
      else if t == 34 || t == 36 then gather st env (fd 0 st d 2) ++ rest
      else rest

def fillC : St -> List Fn -> List Fn -> List Fn

  | _, _, [] => []
  | st, full, f :: fs =>
    let cs : List Int := calsOf st full f.node;
    { na := f.na, nb := f.nb, ps := f.ps, ret := f.ret, node := f.node, cals := cs, usesA := f.usesA, resA := f.resA, part := f.part, bud := f.bud : Fn } :: fillC st full fs

mutual
partial def touchTy : List Int -> Int -> Bool

  | pk, c =>
    if c >= 30000 && c < 31000 then
      let recs : List Int := recsOf pk;
      if hasI (c - 30000) recs then true
      else
        let icts : List Int := indsOf pk;
        let iargs : List Int := iargsOf pk;
        let hs : List Int := headsOf pk;
        let i : Nat := Int.toNat (c - 30000);
        let first : Int := nthF 0 hs (i * 4 + 3);
        let ccnt : Int := 0 - 1 - nthF 0 hs (i * 4 + 2);
        touchInd pk icts iargs first 0 0 ccnt
    else if isProductTy 0 c then touchTy pk (productLeft 0 c) || touchTy pk (productRight 0 c)
    else if isListTy 0 c || isOptionTy 0 c then touchTy pk (elemTy 0 c)
    else if c >= 100 then
      let idx : Int := c - 100;
      let recs : List Int := recsOf pk;
      if hasI idx recs then true
      else
        let hs : List Int := headsOf pk;
        let fs : List Int := fldsOf pk;
        let i : Nat := Int.toNat idx;
        let first : Int := nthF 0 hs (i * 4 + 3);
        let cnt : Int := nthF 0 hs (i * 4 + 2);
        touchFlds pk fs first 0 cnt
    else false

partial def touchInd : List Int -> List Int -> List Int -> Int -> Int -> Int -> Int -> Bool

  | pk, icts, iargs, first, j, k, ccnt =>
    if j >= ccnt then false
    else
      let cix : Nat := Int.toNat (first + j);
      let ac : Int := nthF 0 icts (cix * 5 + 3);
      let fa : Nat := Int.toNat (nthF 0 icts (cix * 5 + 4));
      if k >= ac then touchInd pk icts iargs first (j + 1) 0 ccnt
      else touchTy pk (nthF 0 iargs (fa + Int.toNat k)) || touchInd pk icts iargs first j (k + 1) ccnt

partial def touchFlds : List Int -> List Int -> Int -> Int -> Int -> Bool

  | pk, fs, first, j, cnt =>
    if j >= cnt then false
    else touchTy pk (nthF 0 fs (Int.toNat (first + j) * 3 + 2)) || touchFlds pk fs first (j + 1) cnt
end

def touchList : List Int -> List Int -> Bool

  | _, [] => false
  | pk, t :: ts => touchTy pk t || touchList pk ts

mutual
partial def nodeTouchesA : St -> List Int -> Int -> Bool

  | st, pk, id =>
    if id < 0 then false
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        let ci : Int := ctorNode st (indsOf pk) id 0;
        ci >= 0 && hasI (nthF 0 (indsOf pk) (Int.toNat ci * 5 + 2)) (recsOf pk)
      else if t == 25 then nodeTouchesA st pk (fd 0 st id 1)
      else if t == 23 then altsTouchA st pk (fd 0 st id 1)
      else if t == 31 then liTouchesA st pk (fd 0 st id 1) || altsTouchA st pk (fd 0 st id 2)
      else if t == 24 then nodeTouchesA st pk (fd 0 st id 2)
      else if t == 5 then nodeTouchesA st pk (fd 0 st id 1) || liTouchesA st pk (fd 0 st id 2)
      else if t == 6 then nodeTouchesA st pk (fd 0 st id 2) || nodeTouchesA st pk (fd 0 st id 3)
      else if t == 7 then nodeTouchesA st pk (fd 0 st id 2)
      else if t == 32 then touchTy pk (fd 0 st id 3) || nodeTouchesA st pk (fd 0 st id 2)
      else if t == 13 || t == 17 || t == 29 || t == 30 then nodeTouchesA st pk (fd 0 st id 1)
      else if t == 8 then nodeTouchesA st pk (fd 0 st id 1) || nodeTouchesA st pk (fd 0 st id 2) || nodeTouchesA st pk (fd 0 st id 3)
      else if t == 9 then
        let tyN : Int := fd 0 st id 2;
        let ty : Int := if tyN < 0 then 0 else decTy st (headsOf pk) (-1) (-1) (-1) tyN;
        let r2 : Int := fd 0 st id 3;
        touchTy pk ty || nodeTouchesA st pk (fd 0 st r2 1) || nodeTouchesA st pk (fd 0 st r2 2)
      else if t == 42 then touchTy pk (fd 0 st id 3) || nodeTouchesA st pk (fd 0 st id 1) || nodeTouchesA st pk (fd 0 st id 2)
      else if t == 10 || t == 33 then nodeTouchesA st pk (fd 0 st id 1) || nodeTouchesA st pk (fd 0 st id 2)
      else if t == 11 then liTouchesA st pk (fd 0 st id 1)
      else if t == 14 then
        let ann : Int := decTy st (headsOf pk) (-1) (-1) (-1) (fd 0 st id 1);
        touchTy pk ann || fldsTouchA st pk (fd 0 st id 2)
      else if t == 15 then nodeTouchesA st pk (fd 0 st id 2) || fldsTouchA st pk (fd 0 st id 3)
      else if t == 20 then nodeTouchesA st pk (fd 0 st id 3)
      else false

partial def altsTouchA : St -> List Int -> Int -> Bool

  | st, pk, id =>
    if id < 0 then false
    else nodeTouchesA st pk (fd 0 st id 2) || altsTouchA st pk (fd 0 st id 3)

partial def liTouchesA : St -> List Int -> Int -> Bool

  | st, pk, li =>
    if li < 0 then false
    else nodeTouchesA st pk (fd 0 st li 1) || liTouchesA st pk (fd 0 st li 2)

partial def fldsTouchA : St -> List Int -> Int -> Bool

  | st, pk, chain =>
    if chain < 0 then false
    else nodeTouchesA st pk (fd 0 st chain 2) || fldsTouchA st pk (fd 0 st chain 3)
end

def directUsesA : St -> List Int -> List Fn -> List Fn

  | _, _, [] => []
  | st, pk, f :: fs =>
    if lenI (recsOf pk) == 0 then f :: directUsesA st pk fs
    else
      let res : Bool := touchTy pk f.ret;
      let u0 : Bool := res || touchList pk f.ps || nodeTouchesA st pk f.node;
      let uI : Int := if u0 then 1 else 0;
      let rI : Int := if res then 1 else 0;
      { na := f.na, nb := f.nb, ps := f.ps, ret := f.ret, node := f.node, cals := f.cals, usesA := uI, resA := rI, part := f.part, bud := f.bud : Fn } :: directUsesA st pk fs

def calleeUsesA : List Fn -> List Int -> Bool

  | _, [] => false
  | full, c :: cs =>
    let g : Fn := nthFn full (Int.toNat c);
    g.usesA == 1 || calleeUsesA full cs

def stepUsesA : List Fn -> List Fn -> List Fn

  | _, [] => []
  | full, f :: fs =>
    let u2 : Int := if f.usesA == 1 || calleeUsesA full f.cals then 1 else 0;
    { na := f.na, nb := f.nb, ps := f.ps, ret := f.ret, node := f.node, cals := f.cals, usesA := u2, resA := f.resA, part := f.part, bud := f.bud : Fn } :: stepUsesA full fs

def countUsesA : List Fn -> Nat

  | [] => 0
  | f :: fs => (if f.usesA == 1 then 1 else 0) + countUsesA fs

-- Kildall, POPL 1973, A Unified Approach to Global Program Optimization:
-- monotone Boolean worklist over reverse call edges. Indexed storage reuses
-- the Adams/OCaml persistent AVL above. O((V+E) log(V+1)) time, O(V+E) live space.
-- Keys are original Fn positions; val is 0/1 and extra lists reverse callers.
-- Keep the compatibility equations above; only the closure uses this index.
def usesASeed : List Fn -> Int -> Map -> List Int -> MR
  | [], _, table, todo =>
    { m := table, v := 0, steps := 0, xs := todo, hit := map0 0 : MR }
  | f :: fs, i, table, todo =>
    let u : Int := if f.usesA == 1 then 1 else 0;
    let next : Map := (ins table i u 0 0 []).m;
    usesASeed fs (i + 1) next (if u == 1 then i :: todo else todo)

def usesALinkCallees : Int -> List Int -> Map -> Map
  | _, [], table => table
  | i, c :: cs, table =>
    -- nthFn full (Int.toNat c) aliases negative callees to index zero.
    let j : Int := if c < 0 then 0 else c;
    let old : MR := get table j;
    if old.hit.tag == 0 then usesALinkCallees i cs table
    else usesALinkCallees i cs (ins table j old.v 0 0 (i :: old.xs)).m

def usesAReverse : List Fn -> Int -> Map -> Map
  | [], _, table => table
  | f :: fs, i, table =>
    usesAReverse fs (i + 1) (usesALinkCallees i f.cals table)

def usesAMarkCallers : List Int -> Map -> List Int -> MR
  | [], table, todo =>
    { m := table, v := 0, steps := 0, xs := todo, hit := map0 0 : MR }
  | i :: rest, table, todo =>
    let old : MR := get table i;
    if old.hit.tag == 0 || old.v == 1 then usesAMarkCallers rest table todo
    else
      let next : Map := (ins table i 1 0 0 old.xs).m;
      usesAMarkCallers rest next (i :: todo)

partial def usesARun : Map -> List Int -> Map
  | table, [] => table
  | table, i :: rest =>
    let next : MR := usesAMarkCallers (get table i).xs table rest;
    usesARun next.m next.xs

def usesAResult : List Fn -> Int -> Map -> List Fn
  | [], _, _ => []
  | f :: fs, i, table =>
    let u : Int := if (get table i).v == 1 then 1 else 0;
    { na := f.na, nb := f.nb, ps := f.ps, ret := f.ret, node := f.node, cals := f.cals, usesA := u, resA := f.resA, part := f.part, bud := f.bud : Fn } :: usesAResult fs (i + 1) table

partial def fixUsesA : List Fn -> List Fn
  | fs =>
    let seed : MR := usesASeed fs 0 (map0 0) [];
    let table : Map := usesAReverse fs 0 seed.m;
    usesAResult fs 0 (usesARun table seed.xs)

-- EMIT-FUEL-0 (the step index is the compiler's, never the source's). A `partial`-marked def is the
-- marker of general recursion: its image takes one more Int parameter, the step index, threaded
-- through every call inside its strongly connected component, decremented per call; at zero the
-- image re-enters itself unchanged, an unbounded loop the host budget refuses as [fuel], never a
-- truncated value. A plain `def` is the programmer's claim that Lean's own termination check
-- accepts it (structural or well-founded): it gets no step index and its bytes are unchanged.
-- A call from outside the component passes the budget (the named setting fuelBudget).
def fuelBudget : Nat -> Int
  | 0 => 2305843009213693952
  | n + 1 => fuelBudget n

partial def reachGo : List Fn -> List Int -> List Int -> List Int

  | _, [], seen => seen
  | fs, i :: rest, seen =>
    if hasI i seen then reachGo fs rest seen
    else
      let g : Fn := nthFn fs (Int.toNat i);
      reachGo fs (g.cals ++ rest) (i :: seen)

def sccMin : List Fn -> Int -> List Int -> Int -> Int

  | _, _, [], best => best
  | fs, i, j :: js, best =>
    let rj : List Int := reachGo fs [j] [];
    if hasI i rj && j < best then sccMin fs i js j else sccMin fs i js best

-- ASSIGN-1 step 2: Tarjan, SIAM J. Computing 1(2), 1972,
-- doi:10.1137/0201010. Indexed transcription of lib/Tarjan.rsd's
-- DFS/low-link algorithm, using the existing Adams/OCaml AVL for
-- adjacency and membership.
-- O((V+E) log V) time and O(V+E) space. Component ids are min(member)+1,
-- not discovery/pop order. Structure-type groups/recs remain untouched.
structure FnSccWork where
  disc : Map
  low : Map
  active : Map
  stack : List Int
  next : Int
  ids : Map
  deriving Inhabited

structure FnSccCut where
  members : List Int
  rest : List Int
  best : Int

structure FnScc where
  valid : Bool
  ids : Map
  marked : Map
  deriving Inhabited

def fnSccTable : List Fn -> Int -> Map -> Map
  | [], _, table => table
  | f :: rest, i, table =>
    fnSccTable rest (i + 1) (ins table i f.part f.na f.nb f.cals).m

def fnSccEdgesValid : List Int -> Int -> Bool
  | [], _ => true
  | i :: rest, size => i >= 0 && i < size && fnSccEdgesValid rest size

def fnSccValid : List Fn -> Int -> Bool
  | [], _ => true
  | f :: rest, size => fnSccEdgesValid f.cals size && fnSccValid rest size

def fnSccPop : Int -> List Int -> FnSccCut
  | v, [] => { members := [], rest := [], best := v : FnSccCut }
  | v, x :: xs =>
    if x == v then { members := [x], rest := xs, best := x : FnSccCut }
    else
      let cut : FnSccCut := fnSccPop v xs;
      { members := x :: cut.members, rest := cut.rest,
        best := if x < cut.best then x else cut.best : FnSccCut }

def fnSccAssign : List Int -> Int -> FnSccWork -> FnSccWork
  | [], _, work => work
  | i :: rest, component, work =>
    let nextWork : FnSccWork :=
      { work with
        ids := (ins work.ids i component 0 0 []).m,
        active := (ins work.active i 0 0 0 []).m };
    fnSccAssign rest component nextWork

mutual
partial def fnSccStrong : Map -> Int -> FnSccWork -> FnSccWork
  | table, v, work =>
    let clock : Int := work.next;
    let entered : FnSccWork :=
      { work with
        disc := (ins work.disc v clock 0 0 []).m,
        low := (ins work.low v clock 0 0 []).m,
        active := (ins work.active v 1 0 0 []).m,
        stack := v :: work.stack, next := clock + 1 };
    let walked : FnSccWork := fnSccEdges table v (get table v).xs entered;
    if (get walked.low v).v != (get walked.disc v).v then walked
    else
      let cut : FnSccCut := fnSccPop v walked.stack;
      let popped : FnSccWork :=
        { walked with
          stack := cut.rest };
      fnSccAssign cut.members (cut.best + 1) popped

partial def fnSccEdges : Map -> Int -> List Int -> FnSccWork -> FnSccWork
  | _, _, [], work => work
  | table, v, w :: rest, work =>
    let discovered : Int := (get work.disc w).v;
    let nextWork : FnSccWork :=
      if discovered < 0 then
        let child : FnSccWork := fnSccStrong table w work;
        let lv : Int := (get child.low v).v;
        let lw : Int := (get child.low w).v;
        { child with
          low := (ins child.low v (if lv < lw then lv else lw) 0 0 []).m }
      else if (get work.active w).v == 1 then
        let lv : Int := (get work.low v).v;
        { work with
          low := (ins work.low v (if lv < discovered then lv else discovered) 0 0 []).m }
      else work;
    fnSccEdges table v rest nextWork
end

def fnSccLoop : List Fn -> Int -> Map -> FnSccWork -> FnSccWork
  | [], _, _, work => work
  | _ :: rest, i, table, work =>
    let nextWork : FnSccWork :=
      if (get work.disc i).v < 0 then fnSccStrong table i work else work;
    fnSccLoop rest (i + 1) table nextWork

def fnSccMarks : List Fn -> Int -> Map -> Map -> Map
  | [], _, _, marked => marked
  | f :: rest, i, ids, marked =>
    let component : Int := (get ids i).v;
    let nextMarked : Map :=
      if f.part > 0 then (ins marked component 1 0 0 []).m else marked;
    fnSccMarks rest (i + 1) ids nextMarked

def fnSccSummary (fs : List Fn) : FnScc :=
  if !(fnSccValid fs (Int.ofNat (lenFn fs))) then
    { valid := false, ids := map0 0, marked := map0 0 : FnScc }
  else
    let table : Map := fnSccTable fs 0 (map0 0);
    let initial : FnSccWork :=
      { disc := map0 0, low := map0 0, active := map0 0,
        stack := [], next := 0, ids := map0 0 : FnSccWork };
    let work : FnSccWork := fnSccLoop fs 0 table initial;
    { valid := true, ids := work.ids,
      marked := fnSccMarks fs 0 work.ids (map0 0) : FnScc }

-- The legacy route retains Int.toNat/nthFn behavior on malformed graphs.
def partIdLegacy : List Fn -> Int -> Int
  | fs, i =>
    let ri : List Int := reachGo fs [i] [];
    sccMin fs i ri i + 1

def partIdWith (summary : FnScc) (fs : List Fn) (i : Int) : Int :=
  let found : MR := get summary.ids i;
  if summary.valid && found.hit.tag != 0 then found.v else partIdLegacy fs i

def partId : List Fn -> Int -> Int
  | fs, i => partIdWith (fnSccSummary fs) fs i

def setPartWith : FnScc -> List Fn -> List Fn -> Int -> Int -> List Fn
  | _, _, [], _, _ => []
  | summary, full, f :: rest, i, bud =>
    let g : Fn :=
      if f.part == 0 then f
      else { na := f.na, nb := f.nb, ps := f.ps, ret := f.ret, node := f.node, cals := f.cals, usesA := f.usesA, resA := f.resA, part := partIdWith summary full i, bud := bud : Fn };
    g :: setPartWith summary full rest (i + 1) bud

def setPartGo : List Fn -> List Fn -> Int -> Int -> List Fn
  | full, rest, i, bud => setPartWith (fnSccSummary full) full rest i bud

def setPart : Nat -> List Fn -> Int -> List Fn
  | 0, fs, bud => setPartGo fs fs 0 bud
  | n + 1, fs, bud => setPart n fs bud

-- EMIT-FUEL-0 r2 (F5): a cycle through a plain def and a partial-marked def is general recursion the
-- plain def's claim ("Lean accepts me") cannot cover; stock Lean refuses the mixed group
-- ("cannot mix partial and non-partial definitions"), so rsdc refuses it by name (rsdc_mixed_partial, 11).
def anyPart : List Fn -> Bool

  | [] => false
  | f :: rest => if f.part > 0 then true else anyPart rest

def mixedFrom : List Fn -> Int -> List Int -> Bool

  | _, _, [] => false
  | fs, i, j :: js =>
    let g : Fn := nthFn fs (Int.toNat j);
    if g.part > 0 && hasI i (reachGo fs [j] []) then true
    else mixedFrom fs i js

def mixedGo : List Fn -> List Fn -> Int -> Bool

  | _, [], _ => false
  | full, f :: rest, i =>
    if f.part == 0 && mixedFrom full i (reachGo full [i] []) then true
    else mixedGo full rest (i + 1)

def mixedAtWith (summary : FnScc) (full : List Fn) (i : Int) : Bool :=
  let found : MR := get summary.ids i;
  if summary.valid && found.hit.tag != 0 then (get summary.marked found.v).v == 1
  else mixedFrom full i (reachGo full [i] [])

def mixedGoWith : FnScc -> List Fn -> List Fn -> Int -> Bool
  | _, _, [], _ => false
  | summary, full, f :: rest, i =>
    if f.part == 0 && mixedAtWith summary full i then true
    else mixedGoWith summary full rest (i + 1)

def ckMixedWith (summary : FnScc) (fs : List Fn) : Int :=
  if anyPart fs && mixedGoWith summary fs fs 0 then 12 else 0

def ckMixed : Nat -> List Fn -> Int
  | 0, fs => ckMixedWith (fnSccSummary fs) fs
  | n + 1, fs => ckMixed n fs

-- The step-index slot in a context is the triple (-5, component id, Int).
def lookK : List Int -> Int

  | [] => -1
  | a :: b :: _ :: rest =>
    if a == -9 then -1
    else if a == -5 then 0
    else
      let r : Int := lookK rest;
      if r < 0 then -1 else r + 1
  | _ => -1

def kSccOf : List Int -> Int

  | [] => 0
  | a :: b :: _ :: rest =>
    if a == -9 then 0
    else if a == -5 then b
    else kSccOf rest
  | _ => 0

-- Arguments of a self call from the zero branch: every parameter, the step index, the arena.
partial def selfSpine : Int -> Int -> Int -> List Int

  | i, np, ua =>
    if i > np then
      (if ua == 1 then [1] ++ varB (np + 1) ++ [0] else [0])
    else [1] ++ varB i ++ selfSpine (i + 1) np ua

def fuelWrap : St -> List Int -> List Fn -> Fn -> Bw -> Bw

  | st, hd, fs, f, b =>
    if f.part == 0 || b.err != 0 then b
    else
      let np : Int := Int.ofNat (lenI f.ps);
      let ix : Int := fnIx st fs f.na f.nb;
      let cond : List Int := [17, 12] ++ litI 0 ++ varB np;
      let selfC : List Int := [52] ++ leb (ix + nPreOf hd) ++ selfSpine 0 np f.usesA;
      bwOk 0 [] b.ctx 0 ([5] ++ cond ++ selfC ++ b.bs) b.ty

-- Detect whether any identifier in the file projects a field of a recursive structure.
def isRecFldName : St -> List Int -> List Int -> List Int -> Int -> Int -> Bool

  | _, _, _, [], _, _ => false
  | st, hs, fs, idx :: rest, a, b =>
    let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
      if fieldIx st fs first first (first + cnt) a b >= 0 then true
      else isRecFldName st hs fs rest a b

-- Structure patterns project fields even when the arm body has no projection.
-- Keep the arena reader prefix for these matches as for explicit projections.
partial def patsHaveRecord : St -> Int -> Bool

  | st, id =>
    if id < 0 then false
    else
      let t : Int := fd 0 st id 0;
      if t == 14 then true
      else if t == 12 then patsHaveRecord st (fd 0 st id 1) || patsHaveRecord st (fd 0 st id 2)
      else if t == 6 then patsHaveRecord st (fd 0 st id 2) || patsHaveRecord st (fd 0 st id 3)
      else if t == 13 then patsHaveRecord st (fd 0 st id 1)
      else false

mutual
partial def hasRecProj : St -> List Int -> List Int -> List Int -> Int -> Bool

  | st, hs, fs, recs, id =>
    if id < 0 then false
    else
      let t : Int := fd 0 st id 0;
      if t == 1 then
        let na : Int := fd 0 st id 1;
        let nb : Int := fd 0 st id 2;
        if na >= fileLenI 0 st && fd 0 st id 3 != -9 then false
        else
          let dot : Int := lastDot st na nb;
          if dot < 0 then false
          else isRecFldName st hs fs recs (dot + 1) nb
      else if t == 19 then hasRecProj st hs fs recs (fd 0 st id 1) || hasRecProj st hs fs recs (fd 0 st id 2)
      else if t == 20 then hasRecProj st hs fs recs (fd 0 st id 3)
      else if t == 34 || t == 36 then hasRecProj st hs fs recs (fd 0 st id 2)
      else if t == 29 then isRecFldName st hs fs recs (fd 0 st id 2) (fd 0 st id 3) || hasRecProj st hs fs recs (fd 0 st id 1)
      else if t == 28 || t == 25 || t == 13 || t == 17 || t == 30 then hasRecProj st hs fs recs (fd 0 st id 1)
      else if t == 7 then hasRecProj st hs fs recs (fd 0 st id 2)
      else if t == 23 then hasRecProjAlts st hs fs recs (fd 0 st id 1)
      else if t == 31 then hasRecProjLi st hs fs recs (fd 0 st id 1) || hasRecProjAlts st hs fs recs (fd 0 st id 2)
      else if t == 24 || t == 14 || t == 32 then hasRecProj st hs fs recs (fd 0 st id 2)
      else if t == 5 then hasRecProj st hs fs recs (fd 0 st id 1) || hasRecProjLi st hs fs recs (fd 0 st id 2)
      else if t == 6 || t == 15 then hasRecProj st hs fs recs (fd 0 st id 2) || hasRecProj st hs fs recs (fd 0 st id 3)
      else if t == 8 then hasRecProj st hs fs recs (fd 0 st id 1) || hasRecProj st hs fs recs (fd 0 st id 2) || hasRecProj st hs fs recs (fd 0 st id 3)
      else if t == 9 then
        let r2 : Int := fd 0 st id 3;
        hasRecProj st hs fs recs (fd 0 st r2 1) || hasRecProj st hs fs recs (fd 0 st r2 2)
      else if t == 10 || t == 33 || t == 42 then hasRecProj st hs fs recs (fd 0 st id 1) || hasRecProj st hs fs recs (fd 0 st id 2)
      else if t == 11 then hasRecProjLi st hs fs recs (fd 0 st id 1)
      else false

partial def hasRecProjAlts : St -> List Int -> List Int -> List Int -> Int -> Bool

  | st, hs, fs, recs, id =>
    if id < 0 then false
    else patsHaveRecord st (fd 0 st id 1) || hasRecProj st hs fs recs (fd 0 st id 2) || hasRecProjAlts st hs fs recs (fd 0 st id 3)

partial def hasRecProjLi : St -> List Int -> List Int -> List Int -> Int -> Bool

  | st, hs, fs, recs, li =>
    if li < 0 then false
    else hasRecProj st hs fs recs (fd 0 st li 1) || hasRecProjLi st hs fs recs (fd 0 st li 2)
end

-- Arena binder lookup in ctx:
-- -2 :: -2 :: 2000 is the initial ar : List Node parameter
-- -3 :: -3 :: ret_ty is a let-bound ra : wrapResTy ret_ty
def findArInfo : List Int -> List Int

  | [] => [-1, 0, 0]
  | a :: _ :: t :: rest =>
    if a == -9 then [-1, 0, 0]
    else if a == -2 || a == -3 then [0, a, t]
    else
      let r : List Int := findArInfo rest;
      let ix : Int := nthI r 0;
      if ix < 0 then [-1, 0, 0] else [ix + 1, nthI r 1, nthI r 2]
  | _ =>
    [-1, 0, 0]

def arenaBs : List Int -> List Int -> List Int

  | hd, ctx =>
    let info : List Int := findArInfo ctx;
      let ix : Int := nthI info 0;
      let kind : Int := nthI info 1;
      let ty : Int := nthI info 2;
      if ix < 0 then []
      else if kind == -2 then varB ix
      else projF1 hd ty (varB ix)

-- Sum arms share the surrounding arena; a moving arm makes every result
-- carry it through the existing result wrapper.
def sumArmsErr : List Bw -> Int
  | [] => 0
  | b :: bs => if b.err != 0 then b.err else sumArmsErr bs

def sumArmsMove : List Bw -> Bool
  | [] => false
  | b :: bs => b.moved != 0 || sumArmsMove bs

def sumArmsW : List Int -> Bool -> List Bw -> List Int
  | _, _, [] => [0]
  | hd, joined, b :: bs =>
    [1] ++ (if joined then b.pre ++ wrapResVal hd b.bs (arenaBs hd b.ctx) else b.bs) ++ sumArmsW hd joined bs

-- Field layout classification for a recursive structure:
-- returns kind * 100 + slot:
-- 100 + slot (0..2): i64 in Node.f2, f3, f4
-- 200 + slot (0..1): Bool in Node.f5, f6
-- 300 + 0: String in Node.f7
-- 400 + nk: kid handle in Node.f1[nk]
-- 500 + 0: single List field stored directly in Node.f1
-- 600 + nk: handle-list holder in Node.f1[nk]
-- 700 + nk: scalar-list holder in Node.f1[nk], data in holder.f8
-- 800 + slot: overflow scalar in Node.f8[slot]
-- 900 + 0: single scalar List field stored directly in Node.f8
def isSingleListStruct : List Int -> List Int -> List Int -> Int -> Bool

  | hs, fs, recs, idx =>
    let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let cnt : Nat := Int.toNat (nthF 0 hs (i * 4 + 2));
      let cs : List Int := countArenaFlds fs recs first 0 cnt 0 0 0 0 0;
      let ni : Int := nthF 0 cs 0;
      let nl : Int := nthF 0 cs 3;
      let nk : Int := nthF 0 cs 4;
      nl == 1 && nk == 0 && ni <= 3

def allSingleListRecs : List Int -> List Int -> List Int -> List Int -> Bool

  | _, _, _, [] => true
  | hs, fs, recs, idx :: rest =>
    isSingleListStruct hs fs recs idx && allSingleListRecs hs fs recs rest

partial def fldKindSlotGo : List Int -> List Int -> Bool -> Nat -> Nat -> Nat -> Int -> Int -> Int -> Int -> Int
  | fs, recs, singleL, first, j, target, ni, nb, ns, nk =>
    let tc : Int := nthF 0 fs ((first + j) * 3 + 2);
    let numeric : Int := arenaMagnitudeCode tc;
    let k : Int := if numeric != 0 then arenaMagnitudeSlot numeric nk
      else if tc == 5 || tc == 6 || isWordTy tc then (if ni < 3 then 100 + ni else 800 + ni - 3)
      else if tc == 2 then 200 + nb
      else if tc == 3 then arenaMagnitudeSlot 7 nk
      else if tc >= 100 && tc < 1000 && hasI (tc - 100) recs then arenaMagnitudeSlot 4 nk
      else if isListTy 0 tc then
        if isWordTy (elemTy 0 tc) then (if singleL then 900 else arenaMagnitudeSlot 7 nk)
        else if singleL then 500 else arenaMagnitudeSlot 6 nk
      else -1;
    let kind : Int := arenaMagnitudeSlotKind k;
    if j == target || k == -1 then k
    else fldKindSlotGo fs recs singleL first (j + 1) target
      (ni + (if kind == 1 || kind == 8 then 1 else 0))
      (nb + (if kind == 2 then 1 else 0)) (ns + (if tc == 3 then 1 else 0))
      (nk + (if kind == 4 || kind == 6 || kind == 7 || numeric != 0 then 1 else 0))

def fldKindSlot : List Int -> Int -> Nat -> Int

  | hd, idx, k =>
    let hs : List Int := headsOf hd;
      let fs : List Int := fldsOf hd;
      let recs : List Int := recsOf hd;
      let i : Nat := Int.toNat idx;
      let first : Nat := Int.toNat (nthF 0 hs (i * 4 + 3));
      let singleL : Bool := isSingleListStruct hs fs recs idx;
      fldKindSlotGo fs recs singleL first 0 k 0 0 0 0

