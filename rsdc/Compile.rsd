  97, 44, 32, 98, 32, 61, 62, 32, 40, 40, 97, 32, 37, 32, 50, 32, 43, 32, 98, 32, 37, 32, 50, 41, 32, 37, 32, 50, 41, 32, 43, 32,
  50, 32, 42, 32, 120, 111, 114, 65, 117, 120, 32, 102, 32, 40, 97, 32, 47, 32, 50, 41, 32, 40, 98, 32, 47, 32, 50, 41, 10, 100, 101, 102,
  32, 97, 110, 100, 87, 32, 40, 97, 32, 98, 32, 58, 32, 78, 97, 116, 41, 32, 58, 32, 78, 97, 116, 32, 58, 61, 32, 97, 110, 100, 65, 117,
  120, 32, 51, 50, 32, 97, 32, 98, 10, 100, 101, 102, 32, 111, 114, 87, 32, 40, 97, 32, 98, 32, 58, 32, 78, 97, 116, 41, 32, 58, 32, 78,
  97, 116, 32, 58, 61, 32, 111, 114, 65, 117, 120, 32, 51, 50, 32, 97, 32, 98, 10, 100, 101, 102, 32, 120, 111, 114, 87, 32, 40, 97, 32, 98,
  32, 58, 32, 78, 97, 116, 41, 32, 58, 32, 78, 97, 116, 32, 58, 61, 32, 120, 111, 114, 65, 117, 120, 32, 51, 50, 32, 97, 32, 98, 10, 10,
  101, 110, 100, 32, 82, 101, 115, 105, 100, 117, 97, 46, 82, 67, 67, 46, 84, 121, 112, 101, 100, 83, 99, 109, 46, 66, 114, 105, 100, 103, 101, 10]
-- END C1 WORD BRIDGE DATA

-- The count is exactly the parser's allocated node count, not a search limit.
-- String/comment contents are not identifier nodes and do not activate helpers.
def wordSyntaxNodes : St -> Nat -> Bool
  | _, 0 => false
  | st, nodeCount + 1 =>
    let id : Int := Int.ofNat nodeCount;
    let a : Int := fd 0 st id 1;
    let b : Int := fd 0 st id 2;
    let word : Bool := fd 0 st id 0 == 1 &&
      ((b >= a + 5 && spanEq 0 st a (a + 5) "UInt8") ||
       (b >= a + 6 && (spanEq 0 st a (a + 6) "UInt16" || spanEq 0 st a (a + 6) "UInt32")) ||
       spanEq 0 st a b "Nat.toUInt8" || spanEq 0 st a b "Nat.toUInt32");
    word || wordSyntaxNodes st nodeCount

-- specFun (LRC-REV2-IMPL-0 r2, whole-program defunctionalisation by specialisation: Reynolds 1972; MLton).
-- A top-level definition with a function-typed parameter has no type code in the checker, so it was refused.
-- Here the set of such definitions that the rest of the program reaches is decided on the parse tree
-- after desugarSt and before check; the ones nothing reaches are unlinked from the command chain (dead code,
-- as MLton drops them), and every reached one is left as it is, so the refusal stays where it was.
-- Only a file whose commands are all def, structure, abbrev, inductive or open is looked at; a file with
-- a namespace, a mutual block or any other command is left as it is.
-- Tree reads follow the node layout above: tag a b c at fd slots 0 1 2 3, chains end at -1.
-- a name the pass makes has a span no source line holds: the position of what it replaces is kept beside it
-- (pool key of qa + 1) and an error reported at the name is reported there (specPos, in checkSrcPos)
def specNote (st : St) (qa : Int) (orig : Int) : St :=
  setPool 0 st (putSpan 0 st.pool (qa + 1) [orig])

def specHead1 : List Int -> Int -> Int
  | [], d => d
  | o :: _, _ => o

def specPos (st : St) (pos : Int) : Int :=
  if pos < fileLenI 0 st then pos
  else
    let g : MR := get st.pool (0 - (pos + 1) - 1);
    specHead1 g.xs pos

def specA (t : Int) : Bool :=
  t == 5 || t == 8 || t == 10 || t == 11 || t == 12 || t == 13 || t == 17 || t == 23 || t == 25 || t == 29
    || t == 30 || t == 31 || t == 47

def specB (t : Int) : Bool :=
  t == 5 || t == 6 || t == 7 || t == 8 || t == 10 || t == 12 || t == 14 || t == 15 || t == 24 || t == 31 || t == 32

def specC (t : Int) : Bool := t == 6 || t == 8 || t == 9 || t == 15 || t == 24

def specKnown (t : Int) : Bool :=
  specA t || specB t || specC t || t == 1 || t == 2 || t == 3 || t == 4 || t == 16 || t == 22 || t == 41

def specDotSuffix : List Int -> List Int -> Bool
  | [], _ => false
  | b :: rest, name => (b == 46 && eqListI rest name) || specDotSuffix rest name

-- does the subtree n hold an identifier that names `name` (or ends in .name); a tag not listed counts as a mention
partial def specRefers (st : St) (name : List Int) (n : Int) : Bool :=
  if n < 0 then false
  else
    let t : Int := fd 0 st n 0;
    if t == 1 then
      let bs : List Int := spanBytes 0 st (fd 0 st n 1) (fd 0 st n 2);
      eqListI bs name || specDotSuffix bs name
    else if !(specKnown t) then true
    else (specA t && specRefers st name (fd 0 st n 1)) || (specB t && specRefers st name (fd 0 st n 2))
      || (specC t && specRefers st name (fd 0 st n 3))

partial def specArrow (st : St) (t : Int) : Bool :=
  if t < 0 then false
  else if fd 0 st t 0 == 16 then true
  else if fd 0 st t 0 == 13 then specArrow st (fd 0 st t 1)
  else false

-- the domains of a return-type arrow chain
partial def specDoms (st : St) (t : Int) : Bool :=
  if t >= 0 && fd 0 st t 0 == 16 then specArrow st (fd 0 st t 1) || specDoms st (fd 0 st t 2)
  else false

partial def specGrps (st : St) (g : Int) : Bool :=
  if g < 0 then false else specArrow st (fd 0 st g 2) || specGrps st (fd 0 st g 3)

def specIsHO (st : St) (d : Int) : Bool :=
  let sig : Int := fd 0 st d 2;
  specGrps st (fd 0 st sig 1) || specDoms st (fd 0 st sig 2)

def specName (st : St) (d : Int) : List Int :=
  let nm : Int := fd 0 st d 1;
  spanBytes 0 st (fd 0 st nm 1) (fd 0 st nm 2)

-- every command is one the pass can read
partial def specSimple (st : St) (c : Int) : Bool :=
  if c < 0 then true
  else
    let d : Int := fd 0 st c 1;
    let t : Int := fd 0 st d 0;
    (t == 20 || t == 26 || t == 35 || t == 37 || t == 38 || (t == 36 && specSimple st (fd 0 st d 2)))
      && specSimple st (fd 0 st c 2)

partial def specDefs (st : St) (c : Int) : List Int :=
  if c < 0 then []
  else
    let d : Int := fd 0 st c 1;
    (if fd 0 st d 0 == 20 then [d] else if fd 0 st d 0 == 36 then specDefs st (fd 0 st d 2) else []) ++ specDefs st (fd 0 st c 2)

partial def specHOs (st : St) : List Int -> List Int
  | [] => []
  | d :: rest => if specIsHO st d then d :: specHOs st rest else specHOs st rest

def specMem (x : Int) : List Int -> Bool
  | [] => false
  | y :: ys => x == y || specMem x ys

def specNotIn : List Int -> List Int -> List Int
  | [], _ => []
  | x :: xs, ys => if specMem x ys then specNotIn xs ys else x :: specNotIn xs ys

-- does a definition of srcs other than h mention h
partial def specMentioned (st : St) (name : List Int) (h : Int) : List Int -> Bool
  | [] => false
  | s :: rest => (s != h && specRefers st name (fd 0 st s 3)) || specMentioned st name h rest

-- a structure field's default is an expression that can call a definition
partial def specStructRef (st : St) (name : List Int) (fl : Int) : Bool :=
  if fl < 0 then false
  else
    let ty : Int := fd 0 st fl 2;
    (fd 0 st ty 0 == 40 && specRefers st name (fd 0 st ty 2)) || specStructRef st name (fd 0 st fl 3)

partial def specStructs (st : St) (c : Int) : List Int :=
  if c < 0 then []
  else
    let d : Int := fd 0 st c 1;
    (if fd 0 st d 0 == 26 then [d] else if fd 0 st d 0 == 36 then specStructs st (fd 0 st d 2) else []) ++ specStructs st (fd 0 st c 2)

partial def specStructMention (st : St) (name : List Int) : List Int -> Bool
  | [] => false
  | s :: rest => specStructRef st name (fd 0 st s 2) || specStructMention st name rest

partial def specNew (st : St) (srcs : List Int) (live : List Int) (structs : List Int) : List Int -> List Int
  | [] => []
  | h :: rest =>
    if specMem h live then specNew st srcs live structs rest
    else if specMentioned st (specName st h) h srcs || specStructMention st (specName st h) structs then h :: specNew st srcs live structs rest
    else specNew st srcs live structs rest

partial def specFix (st : St) (hs : List Int) (others : List Int) (structs : List Int) (live : List Int) : List Int :=
  let add : List Int := specNew st (others ++ live) live structs hs;
  if isEmptyI add then live else specFix st hs others structs (live ++ add)

partial def specDrop (st : St) (holder : Int) (slot : Nat) (c : Int) (dead : List Int) : St :=
  if c < 0 then st
  else
    let d : Int := fd 0 st c 1;
    let nx : Int := fd 0 st c 2;
    if fd 0 st d 0 == 36 then specDrop (specDrop st d 2 (fd 0 st d 2) dead) c 2 nx dead
    else if specMem d dead then specDrop (setNodeSlot st holder slot nx) holder slot nx dead
    else specDrop st c 2 nx dead

-- ---- the live case: a definition D with one function-typed parameter, called with a global function g
-- as that argument, is copied as D_spec_g with the parameter removed and its uses replaced by g (MLton's
-- defunctionalisation by specialisation, no captured variables); the call is rewritten to D_spec_g without
-- that argument. A definition or call shape not listed here is left as it is and the refusal stays.
structure SpR where
  st : St
  id : Int
  deriving Inhabited

def spR (s : St) (i : Int) : SpR := { st := s, id := i : SpR }

def specCpA (t : Int) : Bool :=
  t == 5 || t == 8 || t == 9 || t == 10 || t == 11 || t == 12 || t == 13 || t == 14 || t == 15 || t == 16 || t == 17
    || t == 22 || t == 23 || t == 24 || t == 25 || t == 29 || t == 30 || t == 31 || t == 41 || t == 47

def specCpB (t : Int) : Bool :=
  t == 5 || t == 6 || t == 7 || t == 8 || t == 9 || t == 10 || t == 12 || t == 14 || t == 15 || t == 16 || t == 17
    || t == 22 || t == 24 || t == 30 || t == 31 || t == 41

def specCpC (t : Int) : Bool := t == 6 || t == 8 || t == 9 || t == 15 || t == 22 || t == 24

def specCpLeaf (t : Int) : Bool := t == 1 || t == 2 || t == 3 || t == 4

partial def specCopyable (st : St) (n : Int) : Bool :=
  if n < 0 then true
  else
    let t : Int := fd 0 st n 0;
    if specCpLeaf t then true
    else if !(specCpA t || specCpB t || specCpC t) then false
    else (!(specCpA t) || specCopyable st (fd 0 st n 1)) && (!(specCpB t) || specCopyable st (fd 0 st n 2))
      && (!(specCpC t) || specCopyable st (fd 0 st n 3))

-- a copy of the subtree n; an identifier spelling `sub` becomes the identifier node g
partial def specCopy (st : St) (sub : List Int) (g : Int) (n : Int) : SpR :=
  if n < 0 then spR st n
  else
    let t : Int := fd 0 st n 0;
    if specCpLeaf t then
      let bs : List Int := spanBytes 0 st (fd 0 st n 1) (fd 0 st n 2);
      let src : Int := if t == 1 && !(isEmptyI sub) && eqListI bs sub then g else n;
      let s : St := alloc 0 st t (fd 0 st src 1) (fd 0 st src 2) (fd 0 st src 3);
      spR s s.ret
    else
      let ra : SpR := if specCpA t then specCopy st sub g (fd 0 st n 1) else spR st (fd 0 st n 1);
      let rb : SpR := if specCpB t then specCopy ra.st sub g (fd 0 st n 2) else spR ra.st (fd 0 st n 2);
      let rc : SpR := if specCpC t then specCopy rb.st sub g (fd 0 st n 3) else spR rb.st (fd 0 st n 3);
      let s : St := alloc 0 rc.st t ra.id rb.id rc.id;
      spR s s.ret

partial def specNth (st : St) (li : Int) (k : Int) : Int :=
  if li < 0 then -1
  else if k == 0 then li
  else specNth st (fd 0 st li 2) (k - 1)

partial def specLen (st : St) (li : Int) : Int :=
  if li < 0 then 0 else 1 + specLen st (fd 0 st li 2)

-- a li chain without its element k
partial def specCopyLiSkip (st : St) (sub : List Int) (g : Int) (li : Int) (k : Int) : SpR :=
  if li < 0 then spR st li
  else if k == 0 then specCopyLiSkip st sub g (fd 0 st li 2) (k - 1)
  else
    let rest : SpR := specCopyLiSkip st sub g (fd 0 st li 2) (k - 1);
    let e : SpR := specCopy rest.st sub g (fd 0 st li 1);
    let s : St := alloc 0 e.st 12 e.id rest.id 0;
    spR s s.ret

-- the spelling of the k-th pattern of an alternative when it is a plain name
def specPatName (st : St) (pats : Int) (k : Int) : List Int :=
  let li : Int := specNth st pats k;
  let e : Int := fd 0 st li 1;
  if li < 0 || fd 0 st e 0 != 1 then []
  else
    let bs : List Int := spanBytes 0 st (fd 0 st e 1) (fd 0 st e 2);
    if eqListI bs [95] then [] else bs

partial def specCopyAlts (st : St) (g : Int) (k : Int) (sub0 : List Int) (a : Int) : SpR :=
  if a < 0 then spR st a
  else
    let pats : Int := fd 0 st a 1;
    let sub : List Int := if k < 0 then sub0 else specPatName st pats k;
    let rest : SpR := specCopyAlts st g k sub0 (fd 0 st a 3);
    let ps : SpR := specCopyLiSkip rest.st sub g pats k;
    let body : SpR := specCopy ps.st sub g (fd 0 st a 2);
    let s : St := alloc 0 body.st 24 ps.id body.id rest.id;
    spR s s.ret

-- an arrow chain without its domain k
partial def specCopyArrow (st : St) (t : Int) (k : Int) : SpR :=
  if fd 0 st t 0 == 16 then
    if k == 0 then specCopy st [] 0 (fd 0 st t 2)
    else
      let rest : SpR := specCopyArrow st (fd 0 st t 2) (k - 1);
      let dom : SpR := specCopy rest.st [] 0 (fd 0 st t 1);
      let s : St := alloc 0 dom.st 16 dom.id rest.id 0;
      spR s s.ret
  else specCopy st [] 0 t

-- binder groups without the group hg
partial def specCopyGrps (st : St) (gr : Int) (hg : Int) : SpR :=
  if gr < 0 then spR st gr
  else
    let rest : SpR := specCopyGrps st (fd 0 st gr 3) hg;
    if gr == hg then rest
    else
      let nm : SpR := specCopy rest.st [] 0 (fd 0 st gr 1);
      let ty : SpR := specCopy nm.st [] 0 (fd 0 st gr 2);
      let s : St := alloc 0 ty.st 22 nm.id ty.id rest.id;
      spR s s.ret

-- binder form: the group of the function-typed parameter, when it is the only one and holds one name
partial def specHoGrp (st : St) (gr : Int) : Int :=
  if gr < 0 then -1
  else if specArrow st (fd 0 st gr 2) then
    if specLen st (fd 0 st gr 1) == 1 && !(specGrps st (fd 0 st gr 3)) then gr else -1
  else specHoGrp st (fd 0 st gr 3)

partial def specGrpPos (st : St) (gr : Int) (hg : Int) : Int :=
  if gr < 0 || gr == hg then 0 else specLen st (fd 0 st gr 1) + specGrpPos st (fd 0 st gr 3) hg

-- equation form: the position of the only function-typed domain
partial def specDomPos (st : St) (t : Int) (acc : Int) : Int :=
  if fd 0 st t 0 != 16 then -1
  else if specArrow st (fd 0 st t 1) then (if specDoms st (fd 0 st t 2) then -1 else acc)
  else specDomPos st (fd 0 st t 2) (acc + 1)

-- does the subtree hold an identifier spelled `sub`; a tag not listed counts as a hit
partial def specIdIn (st : St) (sub : List Int) (n : Int) : Bool :=
  if n < 0 then false
  else
    let t : Int := fd 0 st n 0;
    if t == 1 then eqListI (spanBytes 0 st (fd 0 st n 1) (fd 0 st n 2)) sub
    else if !(specKnown t) then true
    else (specA t && specIdIn st sub (fd 0 st n 1)) || (specB t && specIdIn st sub (fd 0 st n 2))
      || (specC t && specIdIn st sub (fd 0 st n 3))

-- does a let or a match alternative under n bind a name spelled `sub` (the copy would rename its uses)
partial def specBinds (st : St) (sub : List Int) (n : Int) : Bool :=
  if n < 0 then false
  else
    let t : Int := fd 0 st n 0;
    if t == 1 then false
    else if !(specKnown t) then true
    else
      let own : Bool := (t == 9 || t == 24) && specIdIn st sub (fd 0 st n 1);
      own || (specA t && specBinds st sub (fd 0 st n 1)) || (specB t && specBinds st sub (fd 0 st n 2))
        || (specC t && specBinds st sub (fd 0 st n 3))

partial def specPatsOther (st : St) (sub : List Int) (li : Int) (k : Int) (i : Int) : Bool :=
  if li < 0 then false
  else (i != k && specIdIn st sub (fd 0 st li 1)) || specPatsOther st sub (fd 0 st li 2) k (i + 1)

partial def specAltsBind (st : St) (k : Int) (a : Int) : Bool :=
  if a < 0 then false
  else
    let pats : Int := fd 0 st a 1;
    let sub : List Int := specPatName st pats k;
    (!(isEmptyI sub) && (specPatsOther st sub pats k 0 || specBinds st sub (fd 0 st a 2)))
      || specAltsBind st k (fd 0 st a 3)

partial def specAltsBindName (st : St) (sub : List Int) (a : Int) : Bool :=
  if a < 0 then false
  else (specPatsOther st sub (fd 0 st a 1) (-1) 0 || specBinds st sub (fd 0 st a 2)) || specAltsBindName st sub (fd 0 st a 3)

def specHoName (st : St) (hg : Int) : List Int :=
  let e : Int := fd 0 st (fd 0 st hg 1) 1;
  spanBytes 0 st (fd 0 st e 1) (fd 0 st e 2)

-- the position of the function-typed parameter of a definition the pass can copy, else -1
def specInfo (st : St) (d : Int) : Int :=
  let sig : Int := fd 0 st d 2;
  let val : Int := fd 0 st d 3;
  let grps : Int := fd 0 st sig 1;
  let ty : Int := fd 0 st sig 2;
  if fd 0 st val 2 != 0 || fd 0 st val 3 != 0 then -1
  else if !(specCopyable st val) || !(specCopyable st ty) || !(specCopyable st grps) then -1
  else if fd 0 st val 0 == 25 then
    let hg : Int := specHoGrp st grps;
    if hg < 0 || fd 0 st ty 0 == 16 then -1
    else if specBinds st (specHoName st hg) (fd 0 st val 1) then -1
    else specGrpPos st grps hg
  else if fd 0 st val 0 == 23 && grps < 0 then
    let k : Int := specDomPos st ty 0;
    if k < 0 || specAltsBind st k (fd 0 st val 1) then -1 else k
  else if fd 0 st val 0 == 23 then
    -- the mixed form: the function-typed parameter is a binder, the equations match the arrows of the type
    let hg : Int := specHoGrp st grps;
    if hg < 0 || specDoms st ty || fd 0 st ty 0 != 16 then -1
    else if specAltsBindName st (specHoName st hg) (fd 0 st val 1) then -1
    else specGrpPos st grps hg
  else -1

partial def specDefByName (st : St) (name : List Int) : List Int -> Int
  | [] => -1
  | d :: rest => if eqListI (specName st d) name then d else specDefByName st name rest

def specCloneName (st : St) (d : Int) (g : Int) : List Int :=
  specName st d ++ [64, 115, 112, 101, 99, 64] ++ spanBytes 0 st (fd 0 st g 1) (fd 0 st g 2)

partial def specHasDot : List Int -> Bool
  | [] => false
  | b :: rest => b == 46 || specHasDot rest

partial def specCmdOf (st : St) (c : Int) (d : Int) : Int :=
  if c < 0 then -1
  else if fd 0 st c 1 == d then c
  else
    let dd : Int := fd 0 st c 1;
    let inner : Int := if fd 0 st dd 0 == 36 then specCmdOf st (fd 0 st dd 2) d else -1;
    if inner >= 0 then inner else specCmdOf st (fd 0 st c 2) d

-- the clone of D for the global named by the identifier node g, inserted after D
def specMakeClone (st : St) (d : Int) (k : Int) (g : Int) : St :=
  let sig : Int := fd 0 st d 2;
  let val : Int := fd 0 st d 3;
  let grps : Int := fd 0 st sig 1;
  let ty : Int := fd 0 st sig 2;
  let synSt : St := synthIdent 0 st (specCloneName st d g);
  let nameSt : St := specNote synSt (fd 0 synSt synSt.ret 1) (fd 0 synSt (fd 0 synSt d 1) 1);
  let nameId : Int := nameSt.ret;
  let dd : St :=
    if fd 0 nameSt val 0 == 25 then
      let hg : Int := specHoGrp nameSt grps;
      let sub : List Int := spanBytes 0 nameSt (fd 0 nameSt (fd 0 nameSt (fd 0 nameSt hg 1) 1) 1) (fd 0 nameSt (fd 0 nameSt (fd 0 nameSt hg 1) 1) 2);
      let g2 : SpR := specCopyGrps nameSt grps hg;
      let ty2 : SpR := specCopy g2.st [] 0 ty;
      let sg : St := alloc 0 ty2.st 21 g2.id ty2.id (fd 0 nameSt sig 3);
      let e : SpR := specCopy sg sub g (fd 0 nameSt val 1);
      let v : St := alloc 0 e.st 25 e.id 0 0;
      alloc 0 v 20 nameId sg.ret v.ret
    else if grps >= 0 then
      let hg : Int := specHoGrp nameSt grps;
      let sub : List Int := specHoName nameSt hg;
      let g2 : SpR := specCopyGrps nameSt grps hg;
      let ty2 : SpR := specCopy g2.st [] 0 ty;
      let alts : SpR := specCopyAlts ty2.st g (-1) sub (fd 0 nameSt val 1);
      let sg : St := alloc 0 alts.st 21 g2.id ty2.id (fd 0 nameSt sig 3);
      let v : St := alloc 0 sg 23 alts.id 0 0;
      alloc 0 v 20 nameId sg.ret v.ret
    else
      let alts : SpR := specCopyAlts nameSt g k [] (fd 0 nameSt val 1);
      let ty2 : SpR := specCopyArrow alts.st ty k;
      let sg : St := alloc 0 ty2.st 21 (-1) ty2.id (fd 0 nameSt sig 3);
      let v : St := alloc 0 sg 23 alts.id 0 0;
      alloc 0 v 20 nameId sg.ret v.ret;
  let cmd : Int := specCmdOf dd (fd 0 dd dd.root 1) d;
  let ins : St := alloc 0 dd 19 dd.ret (fd 0 dd cmd 2) 0;
  setNodeSlot ins cmd 2 ins.ret

partial def specCandByName (st : St) (name : List Int) : List Int -> Int
  | [] => -1
  | d :: rest => if eqListI (specName st d) name && specInfo st d >= 0 then d else specCandByName st name rest

-- the first call under n of a copyable definition with a global function as its function-typed argument
partial def specFindCall (st : St) (hs : List Int) (globals : List Int) (n : Int) : Int :=
  if n < 0 then -1
  else
    let t : Int := fd 0 st n 0;
    if !(specKnown t) then -1
    else
      let own : Int :=
        if t != 5 then -1
        else
          let fnode : Int := fd 0 st n 1;
          if fd 0 st fnode 0 != 1 then -1
          else
            let d : Int := specCandByName st (spanBytes 0 st (fd 0 st fnode 1) (fd 0 st fnode 2)) hs;
            if d < 0 then -1
            else
              let k : Int := specInfo st d;
              let li : Int := specNth st (fd 0 st n 2) k;
              let arg : Int := fd 0 st li 1;
              let gname : List Int := spanBytes 0 st (fd 0 st arg 1) (fd 0 st arg 2);
              if li < 0 || fd 0 st arg 0 != 1 || specHasDot gname || specLen st (fd 0 st n 2) < 2 then -1
              else if specDefByName st gname globals >= 0 then n else -1;
      if own >= 0 then own
      else
        let ra : Int := if specA t then specFindCall st hs globals (fd 0 st n 1) else -1;
        if ra >= 0 then ra
        else
          let rb : Int := if specB t then specFindCall st hs globals (fd 0 st n 2) else -1;
          if rb >= 0 then rb
          else if specC t then specFindCall st hs globals (fd 0 st n 3) else -1

partial def specFirstCall (st : St) (hs : List Int) (globals : List Int) : List Int -> Int
  | [] => -1
  | s :: rest =>
    let r : Int := specFindCall st hs globals (fd 0 st s 3);
    if r >= 0 then r else specFirstCall st hs globals rest

def specRewrite (st : St) (hs : List Int) (appN : Int) : St :=
  let fnode : Int := fd 0 st appN 1;
  let d : Int := specCandByName st (spanBytes 0 st (fd 0 st fnode 1) (fd 0 st fnode 2)) hs;
  let k : Int := specInfo st d;
  let arg : Int := fd 0 st (specNth st (fd 0 st appN 2) k) 1;
  let cname : List Int := specCloneName st d arg;
  let defs0 : List Int := specDefs st (fd 0 st st.root 1);
  let st1 : St := if specDefByName st cname defs0 >= 0 then st else specMakeClone st d k arg;
  let cl : Int := specDefByName st1 cname (specDefs st1 (fd 0 st1 st1.root 1));
  let cnm : Int := fd 0 st1 cl 1;
  let syn : St := synthIdent 0 st1 cname;
  let sa : Int := fd 0 syn syn.ret 1;
  let sb : Int := fd 0 syn syn.ret 2;
  let noted : St := specNote syn sa (fd 0 syn fnode 1);
  let st2 : St := setNodeSlot (setNodeSlot (setNodeSlot noted fnode 1 sa) fnode 2 sb) fnode 3 0;
  if k == 0 then setNodeSlot st2 appN 2 (fd 0 st2 (fd 0 st2 appN 2) 2)
  else
    let prev : Int := specNth st2 (fd 0 st2 appN 2) (k - 1);
    setNodeSlot st2 prev 2 (fd 0 st2 (fd 0 st2 prev 2) 2)

-- `f a b` parses as an application of an application; a call of a higher-order definition is made one application
partial def specLast (st : St) (li : Int) : Int :=
  if fd 0 st li 2 < 0 then li else specLast st (fd 0 st li 2)

partial def specHead (st : St) (n : Int) : Int :=
  if fd 0 st n 0 == 5 then specHead st (fd 0 st n 1) else n

def specIsHOName (st : St) (hs : List Int) (bs : List Int) : Bool :=
  specMem (specDefByName st bs hs) hs

partial def specMerge (st : St) (n : Int) : St :=
  let f : Int := fd 0 st n 1;
  if fd 0 st f 0 != 5 then st
  else
    let s1 : St := specMerge st f;
    let il : Int := fd 0 s1 f 2;
    let ol : Int := fd 0 s1 n 2;
    if il < 0 then s1
    else
      let s2 : St := setNodeSlot s1 (specLast s1 il) 2 ol;
      setNodeSlot (setNodeSlot s2 n 1 (fd 0 s2 f 1)) n 2 il

partial def specFlat (st : St) (hs : List Int) (n : Int) : St :=
  if n < 0 then st
  else
    let t : Int := fd 0 st n 0;
    if !(specKnown t) then st
    else
      let h : Int := specHead st n;
      let s0 : St :=
        if t == 5 && fd 0 st h 0 == 1 && fd 0 st (fd 0 st n 1) 0 == 5
            && specIsHOName st hs (spanBytes 0 st (fd 0 st h 1) (fd 0 st h 2))
        then specMerge st n else st;
      let s1 : St := if specA t then specFlat s0 hs (fd 0 s0 n 1) else s0;
      let s2 : St := if specB t then specFlat s1 hs (fd 0 s1 n 2) else s1;
      if specC t then specFlat s2 hs (fd 0 s2 n 3) else s2

partial def specFlatAll (st : St) (hs : List Int) : List Int -> St
  | [] => st
  | d :: rest => specFlatAll (specFlat st hs (fd 0 st d 3)) hs rest

partial def specLoop (st : St) : Nat -> St
  | 0 => st
  | k + 1 =>
    if st.err != 0 then st
    else
      let defs : List Int := specDefs st (fd 0 st st.root 1);
      let hs : List Int := specHOs st defs;
      let globals : List Int := specNotIn defs hs;
      let st : St := specFlatAll st hs globals;
      let call : Int := specFirstCall st hs globals globals;
      if call < 0 then st else specLoop (specRewrite st hs call) k

-- the checker reads `f a b` as an application of an application, one argument each: the flattened calls go back
partial def specCurryApp (st : St) (n : Int) : St :=
  let li : Int := fd 0 st n 2;
  if li < 0 || fd 0 st li 2 < 0 then st
  else
    let prev : Int := specNth st li (specLen st li - 2);
    let lastLi : Int := fd 0 st prev 2;
    let st1 : St := setNodeSlot st prev 2 (-1);
    let st2 : St := alloc 0 st1 5 (fd 0 st1 n 1) li 0;
    let inner : Int := st2.ret;
    specCurryApp (setNodeSlot (setNodeSlot st2 n 1 inner) n 2 lastLi) inner

partial def specCurry (st : St) (n : Int) : St :=
  if n < 0 then st
  else
    let t : Int := fd 0 st n 0;
    if !(specKnown t) then st
    else
      let s0 : St := if t == 5 then specCurryApp st n else st;
      let s1 : St := if specA t then specCurry s0 (fd 0 s0 n 1) else s0;
      let s2 : St := if specB t then specCurry s1 (fd 0 s1 n 2) else s1;
      if specC t then specCurry s2 (fd 0 s2 n 3) else s2

partial def specCurryAll (st : St) : List Int -> St
  | [] => st
  | d :: rest => specCurryAll (specCurry st (fd 0 st d 3)) rest

def specFun (st : St) : St :=
  if st.err != 0 || st.root < 0 then st
  else if !(specSimple st (fd 0 st st.root 1)) then st
  else
    let defs0 : List Int := specDefs st (fd 0 st st.root 1);
    if isEmptyI (specHOs st defs0) then st
    else
      let st : St := specLoop st 2000;
      let defs : List Int := specDefs st (fd 0 st st.root 1);
      let hs : List Int := specHOs st defs;
      let others : List Int := specNotIn defs hs;
      let live : List Int := specFix st hs others (specStructs st (fd 0 st st.root 1)) [];
      let dead : List Int := specNotIn hs live;
      let st : St := if isEmptyI dead then st else specDrop st st.root 1 (fd 0 st st.root 1) dead;
      specCurryAll st (specNotIn (specDefs st (fd 0 st st.root 1)) (specHOs st (specDefs st (fd 0 st st.root 1))))

def parseSrc : Nat -> List Int -> St
  | 0, bs =>
    let size := lenAcc bs 0
    let scope := runtimeScope (initSt 0 bs)
    if scope.err != 0 then scope
    else
      let raw := parseFile (initSt 0 bs)
      if raw.err != 0 then raw
      else if wordSyntaxNodes raw raw.nxt then
        let bridged := parseFile (initSt 0 (bs ++ wordBridgeBytes))
        let cut : St := if bridged.err != 0 then bridged else specFun (desugarSt (setNodeSlot bridged bridged.root 2 (Int.ofNat size)));
        if cut.err != 0 && cut.pos > size then setPos 0 cut size else cut
      else specFun (desugarSt raw)
  | n + 1, bs => parseSrc n bs

-- Codes: 1 Int, 2 Bool, 3 String, 4 Nat, 5 String.Pos, 6 Char, 7 Array Char,
-- 9 UInt8, 10 UInt16, 11 UInt32. Word operators carry type*100 + operator
-- after preparation; parser operators are below 100.
-- 100+i is structure i; 30000+i is inductive i. Container codes use
-- a tagged recursive pairing, so List (Option a) differs from Option (List a).
-- 0 asks to infer; 2000 remains the private arena type.
-- Heads, stride 4: name start, name end, field count, first field.
-- Fields, stride 3: name start, name end, type code.

structure Ans where
  err : Int
  ty : Int
  deriving Inhabited

structure Sig where
  a : Int
  b : Int
  ret : Int
  ps : List Int

-- Persistent compiler name indexes, defined over source lists.
structure SigNameEntry where
  key : List Int
  value : Sig

structure IntsNameEntry where
  key : List Int
  value : List Int

structure SigNameIndex where
  entries : List SigNameEntry
  deriving Inhabited

structure IntsNameIndex where
  entries : List IntsNameEntry
  deriving Inhabited

def emptySigNameIndex : SigNameIndex := { entries := [] : SigNameIndex }
def emptyIntsNameIndex : IntsNameIndex := { entries := [] : IntsNameIndex }

structure Env where
  err : Int
  sigs : List Sig
  heads : List Int
  fields : List Int
  abs : List Int
  icts : List Int
  iargs : List Int
  indexed : Bool
  sigNames : SigNameIndex
  headNames : IntsNameIndex
  aliasNames : IntsNameIndex
  deriving Inhabited

structure Got where
  err : Int
  xs : List Int
  ret : Int
  deriving Inhabited

structure Mx where
  pats : List Int
  alts : List Int
  scrs : List Int
  tys : List Int
  als : List Int
  ncol : Nat
  deriving Inhabited


structure Bag where
  pats : List Int
  alts : List Int
  als : List Int
  deriving Inhabited

structure Cut where
  bs : List Int
  rest : List Int
  deriving Inhabited


def bad : Nat -> Int -> Ans
  | 0, e => { err := e, ty := 0 : Ans }
  | n + 1, e => bad n e

def good : Nat -> Int -> Ans
  | 0, t => { err := 0, ty := t : Ans }
  | n + 1, t => good n t

-- Lean inserts Int.ofNat when a Nat expression is used at expected type Int.
-- Nat and Int share the integer wire value; lowering still tracks the type.
def fit : Int -> Ans -> Ans
  | exp, a =>
    if a.err != 0 then a
    else if exp == 0 || exp == a.ty then a
    else if exp == 1 && a.ty == 4 then good 0 1
    else bad 0 6


def tysOf : List Int -> List Int

  | [] => []
  | _ :: _ :: t :: rest => tysOf rest ++ [t]
  | _ => []

def miss : Nat -> Sig
  | 0 => { a := -1, b := -1, ret := 0, ps := [] : Sig }
  | n + 1 => miss n

def listTy : Nat -> Int -> Int
  | 0, e => if e >= 0 && e <= 1000000000000000000 then 100000 + 3 * e else -2
  | n + 1, e => listTy n e

def optionTy : Nat -> Int -> Int
  | 0, e => if e >= 0 && e <= 1000000000000000000 then 100001 + 3 * e else -2
  | n + 1, e => optionTy n e

def isListTy : Nat -> Int -> Bool
  | _, c => ArrayWireNF.isListTy 0 c

def isOptionTy : Nat -> Int -> Bool
  | 0, c => c >= 100001 && (c - 100000) % 3 == 1
  | n + 1, c => isOptionTy n c

def elemTy : Nat -> Int -> Int
  | _, c => ArrayWireNF.elemTy 0 c

-- Native data has a zero-leading packed payload. No legacy product can
-- start with zero (its first component is a nonempty prefix type tree).
def isBasicTy : Nat -> Int -> Bool
  | _, c => ArrayWireNF.isBasicTy 0 c

def basicKind : Nat -> Int -> Int
  | _, c => ArrayWireNF.basicKind 0 c

def isProductTy : Nat -> Int -> Bool
  | 0, c => c >= 100002 && (c - 100000) % 3 == 2 && !(isBasicTy 0 c)
  | n + 1, c => isProductTy n c

-- Product components use a prefix type tree, packed in base 16 with a
-- leading sentinel. Fourteen digits keep every code below OCaml's signed
-- 63-bit bound, including an enclosing List/Option. This is a finite
-- representability boundary, independent of the emitted structural type.
def packTyBits : List Int -> Int

  | [] => 1
  | b :: bs =>
    let r : Int := packTyBits bs;
    if b < 0 || b >= 16 || r < 0 then -2 else b + 16 * r

partial def unpackTyBits : Int -> List Int

  | c => if c <= 1 then [] else c % 16 :: unpackTyBits (c / 16)

-- Kinds: 1 reserved, 2 ByteArray, 3 Substring, 4 Array, 5 Lean.HashMap.
-- Fixed-width words retain main's canonical codes 9 through 11.
-- These are front-end types. Their wasm representation is a separate ABI
-- slice; tyW deliberately refuses them until that slice is available.
def basicTy : Nat -> Int -> List Int -> Int
  | 0, k, bs =>
    if k < 1 || k > 5 || lenI bs > 12 then -2
    else 100002 + 3 * packTyBits (0 :: k :: bs)
  | n + 1, k, bs => basicTy n k bs

def isWordTy : Int -> Bool
  | c => c >= 9 && c <= 11

def wordWidth : Int -> Int
  | c => if c == 9 then 8 else if c == 10 then 16 else 32

def wordModulus : Int -> Int
  | c => if c == 9 then 256 else if c == 10 then 65536 else 4294967296

-- Bitwise operations still use the bridge's closed helper list.
def wordHelper : Int -> Int -> Int
  | ty, op =>
    if !(isWordTy ty) then 0
    else if op == 19 then 4
    else if op == 20 then 5
    else if op == 21 then 6
    else if op == 23 then 7
    else if op == 22 then (if ty == 11 then 8 else 9)
    else 0

def wordScalarOp (ty op : Int) : Bool :=
  isWordTy ty && ((op >= 1 && op <= 3) || op == 15)

def wordBinAllowed (ty op : Int) : Bool :=
  wordScalarOp ty op || wordHelper ty op > 0

def wordHelperName : Int -> String
  | h =>
    if h == 1 then "Residua.RCC.TypedScm.Bridge.addM"
    else if h == 2 then "Residua.RCC.TypedScm.Bridge.mulM"
    else if h == 3 then "Residua.RCC.TypedScm.Bridge.mul32"
    else if h == 4 then "Residua.RCC.TypedScm.Bridge.andW"
    else if h == 5 then "Residua.RCC.TypedScm.Bridge.orW"
    else if h == 6 then "Residua.RCC.TypedScm.Bridge.xorW"
    else if h == 7 then "Residua.RCC.TypedScm.Bridge.shrW"
    else if h == 8 then "Residua.RCC.TypedScm.Bridge.shl32"
    else if h == 9 then "Residua.RCC.TypedScm.Bridge.shlW"
    else if h == 10 then "Residua.RCC.TypedScm.Bridge.notM"
    else ""

partial def typeBits : Int -> List Int

  | c =>
    if c >= 1 && c <= 8 then [c]
    else if isWordTy c then [15, c - 9]
    else if c >= 100 && c < 1000 then
      let i : Int := c - 100;
      [9, i % 16, (i / 16) % 16, i / 256]
    else if c >= 30000 && c < 31000 then
      let i : Int := c - 30000;
      [10, i % 16, (i / 16) % 16, i / 256]
    else if c == 2000 then [11]
    else if isBasicTy 0 c then 15 :: 3 :: dropI (unpackTyBits (elemTy 0 c)) 1
    else if isProductTy 0 c then 14 :: unpackTyBits (elemTy 0 c)
    else if isListTy 0 c || isOptionTy 0 c then
      let bs : List Int := typeBits (elemTy 0 c);
      if lenI bs == 0 then [] else (if isListTy 0 c then 12 else 13) :: bs
    else []

def productTy : Nat -> Int -> Int -> Int
  | 0, l, r =>
    let ls : List Int := typeBits l;
    let rs : List Int := typeBits r;
    let bs : List Int := ls ++ rs;
    if lenI ls == 0 || lenI rs == 0 || lenI bs > 14 then -2
    else 100002 + 3 * packTyBits bs
  | n + 1, l, r => productTy n l r

def arrayTy : Nat -> Int -> Int
  | 0, e =>
    let bs : List Int := typeBits e;
    if lenI bs == 0 then -2 else basicTy 0 4 bs
  | n + 1, e => arrayTy n e

def hashMapTy : Nat -> Int -> Int -> Int
  | 0, k, v =>
    let ks : List Int := typeBits k;
    let vs : List Int := typeBits v;
    if lenI ks == 0 || lenI vs == 0 then -2 else basicTy 0 5 (ks ++ vs)
  | n + 1, k, v => hashMapTy n k v

structure TypeRead where
  ty : Int
  rest : List Int
  bits : List Int
  deriving Inhabited


partial def readTypeBits : List Int -> TypeRead

  | [] => { ty := -2, rest := [], bits := [] : TypeRead }
  | b :: bs =>
    if b >= 1 && b <= 8 then { ty := b, rest := bs, bits := [b] : TypeRead }
    else if b == 9 || b == 10 then
      let i : Int := nthF 0 bs 0 + 16 * nthF 0 bs 1 + 256 * nthF 0 bs 2;
      if lenI bs < 3 || i < 0 || i >= (if b == 9 then 900 else 1000) then
        { ty := -2, rest := [], bits := [] : TypeRead }
      else { ty := (if b == 9 then 100 else 30000) + i, rest := dropI bs 3, bits := b :: takeI bs 3 : TypeRead }
    else if b == 11 then { ty := 2000, rest := bs, bits := [11] : TypeRead }
    else if b == 12 || b == 13 then
      let r : TypeRead := readTypeBits bs;
      { ty := if b == 12 then listTy 0 r.ty else optionTy 0 r.ty, rest := r.rest, bits := b :: r.bits : TypeRead }
    else if b == 14 then
      let l : TypeRead := readTypeBits bs;
      let r : TypeRead := readTypeBits l.rest;
      let body : List Int := l.bits ++ r.bits;
      if l.ty < 0 || r.ty < 0 || lenI body > 14 then { ty := -2, rest := [], bits := [] : TypeRead }
      else { ty := 100002 + 3 * packTyBits body, rest := r.rest, bits := 14 :: body : TypeRead }
    else if b == 15 then
      let w : Int := nthF 0 bs 0;
      if lenI bs == 0 then { ty := -2, rest := [], bits := [] : TypeRead }
      else if w >= 0 && w <= 2 then
        { ty := w + 9, rest := dropI bs 1, bits := [15, w] : TypeRead }
      else if w != 3 then { ty := -2, rest := [], bits := [] : TypeRead }
      else
      let k : Int := nthF 0 bs 1;
      let body : List Int := dropI bs 2;
      if k >= 1 && k <= 3 then
        { ty := basicTy 0 k [], rest := body, bits := [15, 3, k] : TypeRead }
      else if k == 4 then
        let e : TypeRead := readTypeBits body;
        { ty := if e.ty < 0 then -2 else basicTy 0 k e.bits, rest := e.rest, bits := 15 :: 3 :: k :: e.bits : TypeRead }
      else if k == 5 then
        let key : TypeRead := readTypeBits body;
        let val : TypeRead := readTypeBits key.rest;
        { ty := if key.ty < 0 || val.ty < 0 then -2 else basicTy 0 k (key.bits ++ val.bits), rest := val.rest, bits := 15 :: 3 :: k :: (key.bits ++ val.bits) : TypeRead }
      else { ty := -2, rest := [], bits := [] : TypeRead }
    else { ty := -2, rest := [], bits := [] : TypeRead }

def basicFirst : Nat -> Int -> Int
  | 0, c => (readTypeBits (dropI (unpackTyBits (elemTy 0 c)) 2)).ty
  | n + 1, c => basicFirst n c

def basicSecond : Nat -> Int -> Int
  | 0, c =>
    let key : TypeRead := readTypeBits (dropI (unpackTyBits (elemTy 0 c)) 2);
    (readTypeBits key.rest).ty
  | n + 1, c => basicSecond n c

def productLeft : Nat -> Int -> Int
  | 0, c => (readTypeBits (unpackTyBits (elemTy 0 c))).ty
  | n + 1, c => productLeft n c

def productRight : Nat -> Int -> Int
  | 0, c =>
    let l : TypeRead := readTypeBits (unpackTyBits (elemTy 0 c));
    (readTypeBits l.rest).ty
  | n + 1, c => productRight n c

partial def hasBasicTy : Int -> Bool
  | c =>
    if c == 5 || isBasicTy 0 c then true
    else if isProductTy 0 c then hasBasicTy (productLeft 0 c) || hasBasicTy (productRight 0 c)
    else if isListTy 0 c || isOptionTy 0 c then hasBasicTy (elemTy 0 c)
    else false

-- BASIC-DATA table begin: generated by rsc/BasicDataTables.cjs
def dataNames : Nat -> List String
  | 0 => ["ByteArray.empty", "ByteArray.mkEmpty", "ByteArray.mk", "Substring.mk", "Array.empty", "Array.mkEmpty", "Array.mk", "List.toArray", "Lean.HashMap.empty", "Lean.mkHashMap", "String.utf8ByteSize", "String.get", "String.get?", "String.next", "String.prev", "String.atEnd", "String.endPos", "String.toSubstring", "String.extract", "String.toUTF8", "String.isEmpty", "String.Pos.byteIdx", "ByteArray.size", "ByteArray.isEmpty", "ByteArray.get!", "ByteArray.push", "ByteArray.set!", "ByteArray.extract", "ByteArray.toList", "ByteArray.data", "Substring.str", "Substring.startPos", "Substring.stopPos", "Substring.bsize", "Substring.isEmpty", "Substring.get", "Substring.next", "Substring.prev", "Substring.atEnd", "Substring.toString", "Substring.extract", "Substring.front", "Substring.drop", "Substring.take", "Array.size", "Array.isEmpty", "Array.push", "Array.set!", "Array.setD", "Array.get!", "Array.get?", "Array.getD", "Array.pop", "Array.back!", "Array.toList", "Array.extract", "Lean.HashMap.size", "Lean.HashMap.isEmpty", "Lean.HashMap.insert", "Lean.HashMap.erase", "Lean.HashMap.find?", "Lean.HashMap.findD", "Lean.HashMap.find!", "Lean.HashMap.contains", "Lean.HashMap.toList", "Lean.HashMap.toArray"]
  | n + 1 => dataNames n
def dataKnownGo : St -> Int -> Int -> List String -> Bool
  | _, _, _, [] => false
  | st, a, b, x :: xs => spanEq 0 st a b x || dataKnownGo st a b xs
def dataKnown : Nat -> St -> Int -> Int -> Bool
  | 0, st, a, b => dataKnownGo st a b (dataNames 0)
  | n + 1, st, a, b => dataKnown n st a b
partial def dataDefault : Int -> Bool
  | ty => (ty >= 1 && ty <= 6) || isWordTy ty || isListTy 0 ty || isOptionTy 0 ty || isBasicTy 0 ty ||
      (isProductTy 0 ty && dataDefault (productLeft 0 ty) && dataDefault (productRight 0 ty))
def dataKey : Int -> Bool
  | ty => (ty >= 1 && ty <= 4) || ty == 6 || isWordTy ty
def dataMethod : Nat -> St -> Int -> Int -> Int -> Sig
  | 0, st, ty, a, b =>
    let e : Int := basicFirst 0 ty;
    let v : Int := basicSecond 0 ty;
    if isListTy 0 ty && spanEq 0 st a b "toArray" then
      { a := a, b := b, ret := (arrayTy 0 (elemTy 0 ty)), ps := [] : Sig }
    else if ty == 3 then
      if spanEq 0 st a b "utf8ByteSize" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else if spanEq 0 st a b "get" then { a := a, b := b, ret := 6, ps := [5] : Sig }
      else if spanEq 0 st a b "get?" then { a := a, b := b, ret := (optionTy 0 6), ps := [5] : Sig }
      else if spanEq 0 st a b "next" then { a := a, b := b, ret := 5, ps := [5] : Sig }
      else if spanEq 0 st a b "prev" then { a := a, b := b, ret := 5, ps := [5] : Sig }
      else if spanEq 0 st a b "atEnd" then { a := a, b := b, ret := 2, ps := [5] : Sig }
      else if spanEq 0 st a b "endPos" then { a := a, b := b, ret := 5, ps := [] : Sig }
      else if spanEq 0 st a b "toSubstring" then { a := a, b := b, ret := (basicTy 0 3 []), ps := [] : Sig }
      else if spanEq 0 st a b "extract" then { a := a, b := b, ret := 3, ps := [5, 5] : Sig }
      else if spanEq 0 st a b "toUTF8" then { a := a, b := b, ret := (basicTy 0 2 []), ps := [] : Sig }
      else if spanEq 0 st a b "isEmpty" then { a := a, b := b, ret := 2, ps := [] : Sig }
      else miss 0
    else if ty == 5 then
      if spanEq 0 st a b "byteIdx" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else miss 0
    else if basicKind 0 ty == 2 then
      if spanEq 0 st a b "size" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else if spanEq 0 st a b "isEmpty" then { a := a, b := b, ret := 2, ps := [] : Sig }
      else if spanEq 0 st a b "get!" then if dataDefault 9 then { a := a, b := b, ret := 9, ps := [4] : Sig } else miss 0
      else if spanEq 0 st a b "push" then { a := a, b := b, ret := ty, ps := [9] : Sig }
      else if spanEq 0 st a b "set!" then { a := a, b := b, ret := ty, ps := [4, 9] : Sig }
      else if spanEq 0 st a b "extract" then { a := a, b := b, ret := ty, ps := [4, 4] : Sig }
      else if spanEq 0 st a b "toList" then { a := a, b := b, ret := (listTy 0 9), ps := [] : Sig }
      else if spanEq 0 st a b "data" then { a := a, b := b, ret := (arrayTy 0 9), ps := [] : Sig }
      else miss 0
    else if basicKind 0 ty == 3 then
      if spanEq 0 st a b "str" then { a := a, b := b, ret := 3, ps := [] : Sig }
      else if spanEq 0 st a b "startPos" then { a := a, b := b, ret := 5, ps := [] : Sig }
      else if spanEq 0 st a b "stopPos" then { a := a, b := b, ret := 5, ps := [] : Sig }
      else if spanEq 0 st a b "bsize" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else if spanEq 0 st a b "isEmpty" then { a := a, b := b, ret := 2, ps := [] : Sig }
      else if spanEq 0 st a b "get" then { a := a, b := b, ret := 6, ps := [5] : Sig }
      else if spanEq 0 st a b "next" then { a := a, b := b, ret := 5, ps := [5] : Sig }
      else if spanEq 0 st a b "prev" then { a := a, b := b, ret := 5, ps := [5] : Sig }
      else if spanEq 0 st a b "atEnd" then { a := a, b := b, ret := 2, ps := [5] : Sig }
      else if spanEq 0 st a b "toString" then { a := a, b := b, ret := 3, ps := [] : Sig }
      else if spanEq 0 st a b "extract" then { a := a, b := b, ret := ty, ps := [5, 5] : Sig }
      else if spanEq 0 st a b "front" then { a := a, b := b, ret := 6, ps := [] : Sig }
      else if spanEq 0 st a b "drop" then { a := a, b := b, ret := ty, ps := [4] : Sig }
      else if spanEq 0 st a b "take" then { a := a, b := b, ret := ty, ps := [4] : Sig }
      else miss 0
    else if basicKind 0 ty == 4 then
      if spanEq 0 st a b "size" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else if spanEq 0 st a b "isEmpty" then { a := a, b := b, ret := 2, ps := [] : Sig }
      else if spanEq 0 st a b "push" then { a := a, b := b, ret := ty, ps := [e] : Sig }
      else if spanEq 0 st a b "set!" then { a := a, b := b, ret := ty, ps := [4, e] : Sig }
      else if spanEq 0 st a b "setD" then { a := a, b := b, ret := ty, ps := [4, e] : Sig }
      else if spanEq 0 st a b "get!" then if dataDefault e then { a := a, b := b, ret := e, ps := [4] : Sig } else miss 0
      else if spanEq 0 st a b "get?" then { a := a, b := b, ret := (optionTy 0 e), ps := [4] : Sig }
      else if spanEq 0 st a b "getD" then { a := a, b := b, ret := e, ps := [4, e] : Sig }
      else if spanEq 0 st a b "pop" then { a := a, b := b, ret := ty, ps := [] : Sig }
      else if spanEq 0 st a b "back!" then if dataDefault e then { a := a, b := b, ret := e, ps := [] : Sig } else miss 0
      else if spanEq 0 st a b "toList" then { a := a, b := b, ret := (listTy 0 e), ps := [] : Sig }
      else if spanEq 0 st a b "extract" then { a := a, b := b, ret := ty, ps := [4, 4] : Sig }
      else miss 0
    else if basicKind 0 ty == 5 then
      if spanEq 0 st a b "size" then { a := a, b := b, ret := 4, ps := [] : Sig }
      else if spanEq 0 st a b "isEmpty" then { a := a, b := b, ret := 2, ps := [] : Sig }
      else if spanEq 0 st a b "insert" then { a := a, b := b, ret := ty, ps := [e, v] : Sig }
      else if spanEq 0 st a b "erase" then { a := a, b := b, ret := ty, ps := [e] : Sig }
      else if spanEq 0 st a b "find?" then { a := a, b := b, ret := (optionTy 0 v), ps := [e] : Sig }
      else if spanEq 0 st a b "findD" then { a := a, b := b, ret := v, ps := [e, v] : Sig }
      else if spanEq 0 st a b "find!" then if dataDefault v then { a := a, b := b, ret := v, ps := [e] : Sig } else miss 0
      else if spanEq 0 st a b "contains" then { a := a, b := b, ret := 2, ps := [e] : Sig }
      else if spanEq 0 st a b "toList" then { a := a, b := b, ret := (listTy 0 (productTy 0 e v)), ps := [] : Sig }
      else if spanEq 0 st a b "toArray" then { a := a, b := b, ret := (arrayTy 0 (productTy 0 e v)), ps := [] : Sig }
      else miss 0
    else miss 0
  | n + 1, st, ty, a, b => dataMethod n st ty a b
