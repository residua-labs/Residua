        let b : Bw := lowRecordFields st hd fs mx2 ctx2 (major + 1) code first (j + 1) cnt (shiftScruts scrs 1 ++ [0]) (tys ++ [fty]) ret;
        if b.err != 0 then b
        else if b.moved == 0 then bwUsedOk b.used 0 [] ctx 0 ([4] ++ tw ++ value ++ b.bs) b.ty
        else bwUsedOk b.used 0 ([4] ++ tw ++ value ++ b.pre) b.ctx (b.moved + 1) b.bs b.ty

partial def lowCtor : St -> List Int -> List Fn -> List Int -> List Int -> Int -> Bw

  | st, hd, fs, ctx, args, cix =>
    let icts : List Int := indsOf hd;
      let iargs : List Int := iargsOf hd;
      let i : Nat := Int.toNat cix;
      let hi : Nat := Int.toNat (nthF 0 icts (i * 5 + 2));
      let ac : Nat := Int.toNat (nthF 0 icts (i * 5 + 3));
      let fa : Nat := Int.toNat (nthF 0 icts (i * 5 + 4));
