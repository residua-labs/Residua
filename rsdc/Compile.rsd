partial def lowIndFields : St -> List Int -> List Fn -> Mx -> List Int -> Int -> Int -> Nat -> Nat -> Nat -> List Int -> List Int -> Int -> Bw

  | st, hd, fs, mx, ctx, node, ci, first, j, cnt, scrs, tys, ret =>
    if j >= cnt then
      lowMx st hd fs { pats := mx.pats, alts := mx.alts, scrs := scrs ++ mx.scrs, tys := tys ++ mx.tys, als := mx.als, ncol := mx.ncol : Mx } ctx ret
    else
      let ty : Int := nthF 0 (iargsOf hd) (first + j);
      let hi : Int := nthF 0 (indsOf hd) (Int.toNat ci * 5 + 2);
      let recursive : Bool := hasI hi (recsOf hd);
      let slot : Int := ctorSlot hd ci j;
      let kind : Int := arenaMagnitudeSlotKind slot;
      let k : Int := arenaMagnitudeSlotIndex slot;
      let field : Int := if kind == 1 then 2 + k else if kind == 2 then 5 + k else if kind == 9 then 8 else 1;
      let raw : List Int := [35] ++ nodeTyW hd ++ leb field ++ varB node;
      let value : List Int :=
        if !recursive then
          let ccnt : Int := -1 - nthF 0 (headsOf hd) (Int.toNat hi * 4 + 2);
          if ccnt > 1 && cnt == 1 then varB node
          else
