-- The unique Bool-replicate operand is cells43..318 of the original array.
-- Its surrounding state/fold/result cells and local Nat-add splice stay exact.
def countMagnitudeRangeBoundW : List Int :=
  countMagnitudeSplice [4,1] 0 0
    (takeI countMagnitudeRangeCells 43 ++ varB 0 ++ dropI countMagnitudeRangeCells 319)

-- Private42 carries the entire concrete list type, not a finite type tag.
-- Caller operands keep their original count-then-value evaluation order.
def countMagnitudeReplicateW (tw : List Int) (countSlot valueSlot : Int) : List Int :=
  [-600042, Int.ofNat (lenI tw)] ++ tw ++ [1] ++ varB countSlot ++ [1] ++ varB valueSlot ++ [0]

def countMagnitudeRangeW (countSlot : Int) : List Int :=
  [-600043] ++ [1] ++
    ([-600042,2,4,1] ++ [1] ++ varB countSlot ++ [1,1,0,0]) ++ [0]

-- Source: lean/rsd-cert/Residua/Rsdc/HashMapCompositions.lean, mapFind /
-- mapInsert. Stock Lean 4.14 is the oracle. Association-list composition is
-- extensional only: no toList/toArray or bucket-order surface is admitted.
def sourceMapOp (st : St) (a b : Int) : Int :=
  if spanEq 0 st a b "Lean.HashMap.empty" || spanEq 0 st a b "Lean.mkHashMap" then 40
  else if spanEq 0 st a b "insert" || spanEq 0 st a b "Lean.HashMap.insert" then 41
  else if spanEq 0 st a b "findD" || spanEq 0 st a b "Lean.HashMap.findD" then 42
  else 0

def sourceMapBody (hd : List Int) (op ty : Int) (scrs : List Int) : List Int :=
  let kt : List Int := tyW hd (basicFirst 0 ty);
  let vt : List Int := tyW hd (basicSecond 0 ty);
  let pairTy : List Int := [7,2] ++ fiName 0 ++ kt ++ fiName 1 ++ vt;
  let entriesTy : List Int := [4] ++ pairTy;
  let ow : List Int := [8] ++ vt;
  let entries : List Int := [35] ++ tyW hd ty ++ [0] ++ varB (nthF 0 scrs 0);
  let same : List Int := [14] ++ kt ++ [35] ++ pairTy ++ [0] ++ varB 0 ++ varB (nthF 0 scrs 1 + 2);
  if op == 40 then [34] ++ fiName 0 ++ [22,33]
  else if op == 41 then
    let pair : List Int := [34] ++ fiName 0 ++ varB (nthF 0 scrs 1) ++ [34] ++ fiName 1 ++ varB (nthF 0 scrs 2) ++ [33];
    let step : List Int := [5] ++ same ++ varB 1 ++ [26,23] ++ varB 0 ++ varB 1;
    [34] ++ fiName 0 ++ [26,23] ++ pair ++ [50] ++ entriesTy ++ entries ++ [22] ++ step ++ [33]
  else if op == 42 then
    let step : List Int := [5,38] ++ ow ++ varB 1 ++ varB 1 ++ [5] ++ same ++ [36,35] ++ pairTy ++ [1] ++ varB 0 ++ varB 1;
    [4] ++ ow ++ [50] ++ entriesTy ++ entries ++ [37] ++ step ++
      [5,38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ varB (nthF 0 scrs 2 + 1)
  else []

-- Private composition key44 carries the operation and complete source types.
-- Ordinary prefix-call argument framing remains unchanged. Parameters are in
-- source order; helpers are appended after source functions and only if used.
def basicDataArgsW : List Int -> List Int
  | [] => [0]
  | slot :: rest => [1] ++ varB slot ++ basicDataArgsW rest

def basicDataCallW (op ty ret : Int) (ps scrs : List Int) : List Int :=
  let payload : List Int := op :: ty :: ret :: ps;
  [-600044, Int.ofNat (lenI payload)] ++ payload ++ basicDataArgsW scrs

-- Lean 4.14 Init/Data/ByteArray/Basic.lean:13,21-24,33-37,49,63,90,99:
-- the logical model is Array UInt8.
-- These list equations preserve persistent updates, wrapping occurs at the
-- UInt8 argument conversion, and mkEmpty's capacity has no logical contents.
def basicByteBody (op : Int) : List Int :=
  let xs : List Int := varB 0;
  if op == 70 || op == 71 then [22]
  else if op == 72 || op == 79 then xs
  else if op == 73 then magnitudeMetadataNatW ([24,4,0] ++ xs)
  else if op == 74 then [14,0,24,4,0] ++ xs ++ litI 0
  else if op == 75 then
    [4,8,0,25,27] ++ magnitudeNatIndexW (varB 1) ++ xs ++
      [5,38,8,0] ++ varB 0 ++ [39] ++ varB 0 ++ litI 0
  else if op == 76 then [26] ++ xs ++ [23] ++ varB 1
  else if op == 77 then
    [50,4,0] ++ xs ++ [22,26] ++ varB 1 ++ [23,5,14,0,24,4,0] ++ varB 1 ++
      magnitudeNatIndexW (varB 3) ++ varB 4 ++ varB 0
  else if op == 78 then
    [27] ++ magnitudeNatIndexW (varB 1) ++
      listPrefixW [4,0] xs (magnitudeNatIndexW (varB 4))
  else []

def basicByteOp (st : St) (a b : Int) : Int :=
  if spanEq 0 st a b "ByteArray.empty" then 70
  else if spanEq 0 st a b "ByteArray.mkEmpty" then 71
  else if spanEq 0 st a b "ByteArray.mk" then 72
  else if spanEq 0 st a b "size" || spanEq 0 st a b "ByteArray.size" then 73
  else if spanEq 0 st a b "isEmpty" || spanEq 0 st a b "ByteArray.isEmpty" then 74
  else if spanEq 0 st a b "get!" || spanEq 0 st a b "ByteArray.get!" then 75
  else if spanEq 0 st a b "push" || spanEq 0 st a b "ByteArray.push" then 76
  else if spanEq 0 st a b "set!" || spanEq 0 st a b "ByteArray.set!" then 77
  else if spanEq 0 st a b "extract" || spanEq 0 st a b "ByteArray.extract" then 78
  else if spanEq 0 st a b "toList" || spanEq 0 st a b "ByteArray.toList" || spanEq 0 st a b "data" || spanEq 0 st a b "ByteArray.data" then 79
  else 0

-- Insert after basicDataCallW and before basicDataTemplate. Registry opcodes
-- 60..67 are source compositions, not new SCM/runtime operations.
-- Lean 4.14 Lean/Data/HashMap.lean:205-255; Lean/Data/AssocList.lean:64-84.
-- Extensional map wire only: f0 is a unique-key list of f0-key/f1-value pairs.
-- toList/toArray expose that wire order, not Lean.HashMap's bucket order.
def sourceMapBasicOp (st : St) (a b : Int) : Int :=
  if spanEq 0 st a b "empty" || spanEq 0 st a b "Lean.HashMap.empty" then 40
  else if spanEq 0 st a b "insert" || spanEq 0 st a b "Lean.HashMap.insert" then 41
  else if spanEq 0 st a b "findD" || spanEq 0 st a b "Lean.HashMap.findD" then 42
  else if spanEq 0 st a b "size" || spanEq 0 st a b "Lean.HashMap.size" then 60
  else if spanEq 0 st a b "isEmpty" || spanEq 0 st a b "Lean.HashMap.isEmpty" then 61
  else if spanEq 0 st a b "erase" || spanEq 0 st a b "Lean.HashMap.erase" then 62
  else if spanEq 0 st a b "find?" || spanEq 0 st a b "Lean.HashMap.find?" then 63
  else if spanEq 0 st a b "find!" || spanEq 0 st a b "Lean.HashMap.find!" then 64
  else if spanEq 0 st a b "contains" || spanEq 0 st a b "Lean.HashMap.contains" then 65
  else if spanEq 0 st a b "toList" || spanEq 0 st a b "Lean.HashMap.toList" then 66
  else if spanEq 0 st a b "toArray" || spanEq 0 st a b "Lean.HashMap.toArray" then 67
  else 0

-- Pure panic! unfolds to Inhabited.default (Init/Prelude.lean:2565,2579-2580;
-- Init/Util.lean:36-37). Standard scalar instances only, matching dataKey.
-- Char's instance is 'A', not NUL (Init/Data/Char/Basic.lean:64-65).
def sourceMapBasicDefaultW (ty : Int) : List Int :=
  if ty == 1 then intMagnitudeLiteralWire false []
  else if ty == 4 then natMagnitudeLiteralWire []
  else if ty == 2 then [1,0]
  else if ty == 3 then [22]
  else if ty == 6 then litI 65
  else if isWordTy ty then litI 0
  else []

-- Parameters were already evaluated/bound once by the key44 call. Slots are
-- 0=map,1=key,2=fallback/value in source order. ret/ps are signature metadata
-- authenticated by basicDataTemplate; they do not contain operand bodies.
def sourceMapBasicBody (hd : List Int) (op ty ret : Int) (ps : List Int) : List Int :=
  let key : Int := basicFirst 0 ty;
  let value : Int := basicSecond 0 ty;
  let kt : List Int := tyW hd key;
  let vt : List Int := tyW hd value;
  let pairTy : List Int := [7,2] ++ fiName 0 ++ kt ++ fiName 1 ++ vt;
  let entriesTy : List Int := [4] ++ pairTy;
  let ow : List Int := [8] ++ vt;
  let entries : List Int := [35] ++ tyW hd ty ++ [0] ++ varB 0;
  -- A fold adds item0/acc1, shifting the original key parameter1 to slot3.
  let same : List Int := [14] ++ kt ++ [35] ++ pairTy ++ [0] ++ varB 0 ++ varB 3;
  if op == 40 then sourceMapBody hd op ty []
  else if op == 41 || op == 42 then sourceMapBody hd op ty [0,1,2]
  -- HashMap.size counts unique keys. Return a full Nat magnitude, never a
  -- source-visible scalar (HashMap.lean:244-249).
  else if op == 60 then magnitudeMetadataNatW ([24] ++ entriesTy ++ entries)
  else if op == 61 then [14,0,24] ++ entriesTy ++ entries ++ litI 0
  -- Insert establishes unique keys, so filtering all equal keys implements
  -- AssocList.erase's first-match equation extensionally. Reverse the filter
  -- accumulator once to retain the preexisting association-list wire order.
  else if op == 62 then
    let step : List Int := [5] ++ same ++ varB 1 ++ [26,23] ++ varB 0 ++ varB 1;
    [34] ++ fiName 0 ++ splitReverseW entriesTy ([50] ++ entriesTy ++ entries ++ [22] ++ step) ++ [33]
  else if op == 63 then
    let step : List Int := [5,38] ++ ow ++ varB 1 ++ varB 1 ++ [5] ++ same ++ [36,35] ++ pairTy ++ [1] ++ varB 0 ++ varB 1;
    [50] ++ entriesTy ++ entries ++ [37] ++ step
  -- Lookup itself is another used-only helper, discovered recursively from
  -- key44. No lookup body or arbitrary operand expression is copied here.
  else if op == 64 then
    [4] ++ ow ++ basicDataCallW 63 ty (optionTy 0 value) [ty,key] [0,1] ++
      [5,38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ sourceMapBasicDefaultW value
  else if op == 65 then
    [38] ++ ow ++ basicDataCallW 63 ty (optionTy 0 value) [ty,key] [0,1]
  -- Both existing source List and Array ABIs are a list of these same pair
  -- records. This supports size/extensional contents, not bucket-order claims.
  else if op == 66 || op == 67 then entries
  else []


-- ASSIGN4 String/Pos/Substring composition draft. No new RSC opcode/runtime.
-- Insert after basicDataCallW and before basicDataTemplate's dispatcher.
-- Template parameters are bound once in source order at slots 0..arity-1.
-- Fold slots: element=0, accumulator=1, outer parameters shifted by two.
-- Source semantics: installed stock Lean 4.14 reference definitions, not externs.
-- Basic.lean = Init/Data/String/Basic.lean; Extra.lean = Init/Data/String/Extra.lean;
-- Prelude.lean = Init/Prelude.lean (all Lean 4.14.0).

def stringSubstringTyW : List Int :=
  [7,3] ++ fiName 0 ++ [4,0] ++ fiName 1 ++ natMagnitudeTyW ++ fiName 2 ++ natMagnitudeTyW

def stringRecord2W (a b : List Int) : List Int :=
  [34] ++ fiName 0 ++ a ++ [34] ++ fiName 1 ++ b ++ [33]

def stringRecord3W (a b c : List Int) : List Int :=
  [34] ++ fiName 0 ++ a ++ [34] ++ fiName 1 ++ b ++ [34] ++ fiName 2 ++ c ++ [33]

def stringProjW (tw : List Int) (i : Int) (x : List Int) : List Int :=
  [35] ++ tw ++ [i] ++ x

def stringNatZeroW : List Int := natMagnitudeLiteralWire []
def stringNatSmallW (x : Int) : List Int := natMagnitudeLiteralWire [x]
def stringNatAddW (a b : List Int) : List Int :=
  magnitudeApply2W natMagnitudeTyW (magnitudeNatBinaryBound 1) a b
def stringNatSubW (a b : List Int) : List Int :=
  magnitudeApply2W natMagnitudeTyW (magnitudeNatBinaryBound 2) a b
def stringNatEqW (a b : List Int) : List Int := [14] ++ natMagnitudeTyW ++ a ++ b

def stringCallW (op ret : Int) (ps slots : List Int) : List Int :=
  basicDataCallW op (nthF 0 ps 0) ret ps slots

-- Prelude.lean 2240-2244, Char.utf8Size. All four outputs are NatMagnitude.
def stringCharWidthBoundW : List Int :=
  [5,12] ++ varB 0 ++ litI 128 ++ stringNatSmallW 1 ++
  [5,12] ++ varB 0 ++ litI 2048 ++ stringNatSmallW 2 ++
  [5,12] ++ varB 0 ++ litI 65536 ++ stringNatSmallW 3 ++ stringNatSmallW 4

-- Prelude.lean 2479-2485. Never reconstruct accumulated byte positions in i64.
def stringByteSizeBoundW : List Int :=
  [50,4,0] ++ varB 0 ++ stringNatZeroW ++
    stringNatAddW (varB 1) (stringCallW 107 4 [6] [0])

-- Basic.lean 115-131. Walk exact boundaries; middle-of-codepoint and end => none.
def stringGetOptionBoundW : List Int :=
  let st : List Int := [7,2] ++ fiName 0 ++ natMagnitudeTyW ++ fiName 1 ++ [8,0];
  let pos : List Int := stringProjW st 0 (varB 1);
  let old : List Int := stringProjW st 1 (varB 1);
  let initial : List Int := stringRecord2W stringNatZeroW [37];
  let step : List Int := stringRecord2W
    (stringNatAddW pos (stringCallW 107 4 [6] [0]))
    ([5] ++ stringNatEqW pos (varB 3) ++ [36] ++ varB 0 ++ old);
  [4] ++ st ++ [50,4,0] ++ varB 0 ++ initial ++ step ++ stringProjW st 1 (varB 0)

-- Basic.lean 94-113; default Char is 'A' (65), not NUL.
def stringGetBoundW : List Int :=
  [4,8,0] ++ stringCallW 81 (optionTy 0 6) [3,5] [0,1] ++
    [5,38,8,0] ++ varB 0 ++ [39] ++ varB 0 ++ litI 65

-- Basic.lean 198-200: the logical definition applies even to invalid positions.
def stringNextBoundW : List Int :=
  [4,0] ++ stringCallW 82 6 [3,5] [0,1] ++
  stringNatAddW (varB 2) (stringCallW 107 4 [6] [0])

-- Basic.lean 202-220. A missed boundary yields zero, including p=0.
def stringPrevBoundW : List Int :=
  let st : List Int := [7,2] ++ fiName 0 ++ natMagnitudeTyW ++ fiName 1 ++ natMagnitudeTyW;
  let oldPos : List Int := stringProjW st 0 (varB 1);
  let nextPos : List Int := stringNatAddW oldPos (stringCallW 107 4 [6] [0]);
  let step : List Int := [4] ++ natMagnitudeTyW ++ nextPos ++
    stringRecord2W (varB 0)
      ([5] ++ stringNatEqW (varB 0) (varB 4) ++ stringProjW st 0 (varB 2) ++ stringProjW st 1 (varB 2));
  [4] ++ st ++ [50,4,0] ++ varB 0 ++ stringRecord2W stringNatZeroW stringNatZeroW ++ step ++
    stringProjW st 1 (varB 0)

-- Basic.lean 255-256: >= byte length (Substring.atEnd instead uses equality).
def stringAtEndBoundW : List Int :=
  [4] ++ natMagnitudeTyW ++ stringCallW 80 4 [3] [0] ++
    magnitudeNatOrderW 10 (varB 2) (varB 0)

-- Basic.lean 423-433: b must match a boundary; unmatched e copies through end.
-- Accumulation is reversed, followed by one reversal (linear output construction).
def stringExtractBoundW : List Int :=
  let st : List Int := [7,3] ++ fiName 0 ++ natMagnitudeTyW ++ fiName 1 ++ [1] ++ fiName 2 ++ [4,0];
  let pos : List Int := stringProjW st 0 (varB 1);
  let active : List Int := [15,16] ++ stringProjW st 1 (varB 1) ++
    stringNatEqW pos (varB 3) ++ [17] ++ stringNatEqW pos (varB 4);
  let step : List Int := [4,1] ++ active ++ stringRecord3W
    (stringNatAddW (stringProjW st 0 (varB 2)) (stringCallW 107 4 [6] [1]))
    (varB 0)
    ([5] ++ varB 0 ++ [26,23] ++ varB 1 ++ stringProjW st 2 (varB 2) ++ stringProjW st 2 (varB 2));
  let initial : List Int := stringRecord3W stringNatZeroW [1,0] [22];
  [5] ++ magnitudeNatOrderW 10 (varB 1) (varB 2) ++ [22] ++
    [4] ++ st ++ [50,4,0] ++ varB 0 ++ initial ++ step ++
      splitReverseW [4,0] (stringProjW st 2 (varB 0))

-- RSC division opcode 10 is EXACT division. Remove the remainder first.
-- Here values are valid Char scalars <=0x10ffff, so all scalar operations fit.
def stringWordFloorDivW (x : List Int) (d : Int) : List Int :=
  [10,7] ++ x ++ [11] ++ x ++ litI d ++ litI d

def stringUtf8ChunkW (shift lead mask : Int) : List Int :=
  [6] ++ litI lead ++ [11] ++ stringWordFloorDivW (varB 0) shift ++ litI mask

def stringWordListW : List (List Int) -> List Int
  | [] => [22]
  | x :: xs => [26,23] ++ x ++ stringWordListW xs

-- Extra.lean 104-123, utf8EncodeChar, UInt8 result represented by scalar words.
def stringEncodeCharBoundW : List Int :=
  [5,12] ++ varB 0 ++ litI 128 ++ stringWordListW [varB 0] ++
  [5,12] ++ varB 0 ++ litI 2048 ++
    stringWordListW [stringUtf8ChunkW 64 192 32, stringUtf8ChunkW 1 128 64] ++
  [5,12] ++ varB 0 ++ litI 65536 ++
    stringWordListW [stringUtf8ChunkW 4096 224 16, stringUtf8ChunkW 64 128 64, stringUtf8ChunkW 1 128 64] ++
    stringWordListW [stringUtf8ChunkW 262144 240 8, stringUtf8ChunkW 4096 128 64, stringUtf8ChunkW 64 128 64, stringUtf8ChunkW 1 128 64]

-- Extra.lean 127-128, flatMap utf8EncodeChar. Segment reversal avoids O(n^2).
def stringToUtf8BoundW : List Int :=
  let segments : List Int := [50,4,0] ++ varB 0 ++ [22,26,23] ++
    stringCallW 108 (basicTy 0 2 []) [6] [0] ++ varB 1;
  listConcatRevW [4,4,0] segments

def stringSubstringMkBoundW : List Int := stringRecord3W (varB 0) (varB 1) (varB 2)

def stringToSubstringBoundW : List Int :=
  stringRecord3W (varB 0) stringNatZeroW (stringCallW 80 4 [3] [0])

-- Bound ss at slot0 and relative position at slot1; bind underlying string and
-- absolute position once before calling another retained composition.
def stringSubstringGetBoundW : List Int :=
  [4,4,0] ++ stringProjW stringSubstringTyW 0 (varB 0) ++
  [4] ++ natMagnitudeTyW ++ stringNatAddW (stringProjW stringSubstringTyW 1 (varB 1)) (varB 2) ++
    stringCallW 82 6 [3,5] [1,0]

-- Basic.lean 857-860. Preserve full p at the exact end, including malformed ss.
def stringSubstringNextBoundW : List Int :=
  [4,4,0] ++ stringProjW stringSubstringTyW 0 (varB 0) ++
  [4] ++ natMagnitudeTyW ++ stringNatAddW (stringProjW stringSubstringTyW 1 (varB 1)) (varB 2) ++
    [5] ++ stringNatEqW (varB 0) (stringProjW stringSubstringTyW 2 (varB 2)) ++ varB 3 ++
    stringNatSubW (stringCallW 83 5 [3,5] [1,0]) (stringProjW stringSubstringTyW 1 (varB 2))

-- Basic.lean 873-876. At relative0 preserve p; other results use Nat.sub.
def stringSubstringPrevBoundW : List Int :=
  [4,4,0] ++ stringProjW stringSubstringTyW 0 (varB 0) ++
  [4] ++ natMagnitudeTyW ++ stringNatAddW (stringProjW stringSubstringTyW 1 (varB 1)) (varB 2) ++
    [5] ++ stringNatEqW (varB 0) (stringProjW stringSubstringTyW 1 (varB 2)) ++ varB 3 ++
    stringNatSubW (stringCallW 84 5 [3,5] [1,0]) (stringProjW stringSubstringTyW 1 (varB 2))

def stringSubstringAtEndBoundW : List Int :=
  stringNatEqW (stringNatAddW (stringProjW stringSubstringTyW 1 (varB 0)) (varB 1))
    (stringProjW stringSubstringTyW 2 (varB 0))

def stringSubstringToStringBoundW : List Int :=
  [4,4,0] ++ stringProjW stringSubstringTyW 0 (varB 0) ++
  [4] ++ natMagnitudeTyW ++ stringProjW stringSubstringTyW 1 (varB 1) ++
  [4] ++ natMagnitudeTyW ++ stringProjW stringSubstringTyW 2 (varB 2) ++
    stringCallW 86 3 [3,5,5] [2,1,0]

-- Basic.lean 910-911: compare relative b',e' first; clamp each absolute end.
def stringNatMinW (a b : List Int) : List Int :=
  [5] ++ magnitudeNatOrderW 9 a b ++ a ++ b

def stringSubstringExtractBoundW : List Int :=
  [5] ++ magnitudeNatOrderW 10 (varB 1) (varB 2) ++
    stringRecord3W [22] stringNatZeroW stringNatZeroW ++
    stringRecord3W (stringProjW stringSubstringTyW 0 (varB 0))
      (stringNatMinW (stringProjW stringSubstringTyW 2 (varB 0))
        (stringNatAddW (stringProjW stringSubstringTyW 1 (varB 0)) (varB 1)))
      (stringNatMinW (stringProjW stringSubstringTyW 2 (varB 0))
        (stringNatAddW (stringProjW stringSubstringTyW 1 (varB 0)) (varB 2)))

-- Basic.lean 878-880. Exact arbitrary n, not min(n,String.length): malformed
-- ss can keep advancing beyond its actual text. Existing helper42 supplies n
-- Bool loop cells; this retains the reference nextn's O(n) iteration count.
def stringSubstringNextnBoundW : List Int :=
  let repeatFalse : List Int := [-600042,2,4,1,1] ++ varB 1 ++ [1,1,0,0];
  [50,4,1] ++ repeatFalse ++ varB 2 ++
    stringCallW 98 5 [basicTy 0 3 [],5] [2,1]

def stringSubstringDropTakeBoundW (take : Bool) : List Int :=
  [4] ++ natMagnitudeTyW ++ stringNatZeroW ++
  [4] ++ natMagnitudeTyW ++ stringCallW 109 5 [basicTy 0 3 [],4,5] [1,2,0] ++
    stringRecord3W (stringProjW stringSubstringTyW 0 (varB 2))
      (if take then stringProjW stringSubstringTyW 1 (varB 2)
       else stringNatAddW (stringProjW stringSubstringTyW 1 (varB 2)) (varB 0))
      (if take then stringNatAddW (stringProjW stringSubstringTyW 1 (varB 2)) (varB 0)
       else stringProjW stringSubstringTyW 2 (varB 2))

-- Insert one branch in the parent template dispatcher for 80..111.
def basicStringBody (_hd : List Int) (op _ty _ret : Int) (_ps : List Int) : List Int :=
  if op == 80 || op == 89 then stringByteSizeBoundW
  else if op == 81 then stringGetOptionBoundW
  else if op == 82 then stringGetBoundW
  else if op == 83 then stringNextBoundW
  else if op == 84 then stringPrevBoundW
  else if op == 85 then stringAtEndBoundW
  else if op == 86 then stringExtractBoundW
  else if op == 87 then stringToUtf8BoundW
  else if op == 88 then stringToSubstringBoundW
  else if op == 90 then varB 0
  else if op == 91 then [14,4,0] ++ varB 0 ++ [22]
  else if op == 92 then stringSubstringMkBoundW
  else if op >= 93 && op <= 95 then stringProjW stringSubstringTyW (op - 93) (varB 0)
  else if op == 96 then stringNatSubW (stringProjW stringSubstringTyW 2 (varB 0)) (stringProjW stringSubstringTyW 1 (varB 0))
  else if op == 97 then stringSubstringGetBoundW
  else if op == 98 then stringSubstringNextBoundW
  else if op == 99 then stringSubstringPrevBoundW
  else if op == 100 then stringSubstringAtEndBoundW
  else if op == 101 then stringSubstringToStringBoundW
  else if op == 102 then stringSubstringExtractBoundW
  else if op == 103 then stringSubstringDropTakeBoundW false
  else if op == 104 then stringSubstringDropTakeBoundW true
  else if op == 105 then
    [4] ++ natMagnitudeTyW ++ stringNatZeroW ++ stringCallW 97 6 [basicTy 0 3 [],5] [1,0]
  else if op == 106 then
    stringNatEqW (stringNatSubW (stringProjW stringSubstringTyW 2 (varB 0)) (stringProjW stringSubstringTyW 1 (varB 0))) stringNatZeroW
  else if op == 107 then stringCharWidthBoundW
  else if op == 108 then stringEncodeCharBoundW
  else if op == 109 then stringSubstringNextnBoundW
  else if op == 110 then
    [4] ++ natMagnitudeTyW ++ stringCallW 107 4 [6] [1] ++ stringNatAddW (varB 1) (varB 0)
  else if op == 111 then
    [4] ++ natMagnitudeTyW ++ stringCallW 80 4 [3] [1] ++ stringNatAddW (varB 1) (varB 0)
  else []

-- Method and fully qualified calls share the same operation. Constructors have
-- no receiver and are recognized first. Pos arithmetic is dispatched by parent.
def basicStringOp (st : St) (ty a b : Int) : Int :=
  if spanEq 0 st a b "Substring.mk" then 92
  else if spanEq 0 st a b "String.Pos.mk" then 90
  else if ty == 3 then
    if spanEq 0 st a b "utf8ByteSize" || spanEq 0 st a b "String.utf8ByteSize" then 80
    else if spanEq 0 st a b "get?" || spanEq 0 st a b "String.get?" then 81
    else if spanEq 0 st a b "get" || spanEq 0 st a b "String.get" then 82
    else if spanEq 0 st a b "next" || spanEq 0 st a b "String.next" then 83
    else if spanEq 0 st a b "prev" || spanEq 0 st a b "String.prev" then 84
    else if spanEq 0 st a b "atEnd" || spanEq 0 st a b "String.atEnd" then 85
    else if spanEq 0 st a b "extract" || spanEq 0 st a b "String.extract" then 86
    else if spanEq 0 st a b "toUTF8" || spanEq 0 st a b "String.toUTF8" then 87
    else if spanEq 0 st a b "toSubstring" || spanEq 0 st a b "String.toSubstring" then 88
    else if spanEq 0 st a b "endPos" || spanEq 0 st a b "String.endPos" then 89
    else if spanEq 0 st a b "isEmpty" || spanEq 0 st a b "String.isEmpty" then 91
    else 0
  else if ty == 5 then
    if spanEq 0 st a b "byteIdx" || spanEq 0 st a b "String.Pos.byteIdx" then 90 else 0
  else if basicKind 0 ty == 3 then
    if spanEq 0 st a b "str" || spanEq 0 st a b "Substring.str" then 93
    else if spanEq 0 st a b "startPos" || spanEq 0 st a b "Substring.startPos" then 94
    else if spanEq 0 st a b "stopPos" || spanEq 0 st a b "Substring.stopPos" then 95
    else if spanEq 0 st a b "bsize" || spanEq 0 st a b "Substring.bsize" then 96
    else if spanEq 0 st a b "get" || spanEq 0 st a b "Substring.get" then 97
    else if spanEq 0 st a b "next" || spanEq 0 st a b "Substring.next" then 98
    else if spanEq 0 st a b "prev" || spanEq 0 st a b "Substring.prev" then 99
    else if spanEq 0 st a b "atEnd" || spanEq 0 st a b "Substring.atEnd" then 100
    else if spanEq 0 st a b "toString" || spanEq 0 st a b "Substring.toString" then 101
    else if spanEq 0 st a b "extract" || spanEq 0 st a b "Substring.extract" then 102
    else if spanEq 0 st a b "drop" || spanEq 0 st a b "Substring.drop" then 103
    else if spanEq 0 st a b "take" || spanEq 0 st a b "Substring.take" then 104
    else if spanEq 0 st a b "front" || spanEq 0 st a b "Substring.front" then 105
    else if spanEq 0 st a b "isEmpty" || spanEq 0 st a b "Substring.isEmpty" then 106
    else 0
  else 0


-- Dispatch source operations by their checked receiver type. Constructor names
-- are qualified; no new core opcode or runtime convention is introduced here.
def basicArrayOp (st : St) (a b : Int) : Int :=
  if spanEq 0 st a b "get!" || spanEq 0 st a b "Array.get!" then 120
  else if spanEq 0 st a b "get?" || spanEq 0 st a b "Array.get?" then 121
  else if spanEq 0 st a b "set!" || spanEq 0 st a b "Array.set!" then 122
  else if spanEq 0 st a b "pop" || spanEq 0 st a b "Array.pop" then 123
  else if spanEq 0 st a b "back!" || spanEq 0 st a b "Array.back!" then 124
  else 0

-- Stock Lean4.14 Init/Prelude.lean:2597-2612,2639-2645,2707-2718;
-- Init/Data/Array/Basic.lean:147-148,238-244. Array is a List wrapper;
-- get! selects getD/default; set! is setD; pop is dropLast; get? is
-- bounds-checked get; back! is get! at size-1, hence latest-or-default.
-- Source-order slots are receiver0/index1/value2, bound once by lowBasicArgs.
-- Complete ret/ps remain in the existing composition key and signature.
-- Nat/Int elements retain tyW's full magnitude wires. Only an index uses
-- the existing magnitudeNatIndexW bridge. Missing default shapes refuse.
def basicArrayBody (hd : List Int) (op ty ret : Int) (ps : List Int) : List Int :=
  let tw : List Int := tyW hd ty;
  let element : Int := basicFirst 0 ty;
  let ew : List Int := tyW hd element;
  let ow : List Int := [8] ++ ew;
  let xs : List Int := varB 0;
  let fallback : List Int := sourceMapBasicDefaultW element;
  if basicKind 0 ty != 4 then [-99]
  else if op == 120 then
    if lenI fallback == 0 then [-99]
    else
      [4] ++ ow ++ [25,27] ++ magnitudeNatIndexW (varB 1) ++ xs ++
        [5,38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ fallback
  else if op == 121 then
    [25,27] ++ magnitudeNatIndexW (varB 1) ++ xs
  else if op == 122 then
    -- Fold adds element0/accumulator1: index1 becomes3, value2 becomes4.
    -- Same persistent update equation as existing containerBody op18.
    [50] ++ tw ++ xs ++ [22,26] ++ varB 1 ++ [23,5,14,0,24] ++ tw ++ varB 1 ++
      magnitudeNatIndexW (varB 3) ++ varB 4 ++ varB 0
  else if op == 123 then
    -- listPrefixW evaluates stop under element0/accumulator1. The source
    -- receiver is therefore slot2, never the growing prefix in slot1.
    -- Empty input has no fold step; nonempty length-1 is nonnegative.
    listPrefixW tw xs ([7,24] ++ tw ++ varB 2 ++ litI 1)
  else if op == 124 then
    if lenI fallback == 0 then [-99]
    else
      -- Existing List.getLast? fold: retain only some(current element).
      [4] ++ ow ++ [50] ++ tw ++ xs ++ [37,36] ++ varB 0 ++
        [5,38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ fallback
  else [-99]


def basicDataOp (st : St) (ty a b : Int) : Int :=
  if spanEq 0 st a b "ByteArray.empty" || spanEq 0 st a b "ByteArray.mkEmpty" || spanEq 0 st a b "ByteArray.mk" then basicByteOp st a b
  else if spanEq 0 st a b "Substring.mk" then 92
  else if basicKind 0 ty == 5 then sourceMapBasicOp st a b
  else if basicKind 0 ty == 2 then basicByteOp st a b
  else if basicKind 0 ty == 4 then basicArrayOp st a b
  else basicStringOp st ty a b

-- The complete concrete signature is part of the composition key. Every body
-- receives source-order parameters, bound once by lowBasicArgs.
def basicDataTemplate (hd : List Int) (op ty ret : Int) (ps : List Int) : List Int :=
  if (op >= 40 && op <= 42) || (op >= 60 && op <= 67) then sourceMapBasicBody hd op ty ret ps
  else if op >= 70 && op <= 79 then basicByteBody op
  else if op >= 80 && op <= 111 then basicStringBody hd op ty ret ps
  else if op >= 120 && op <= 134 then basicArrayBody hd op ty ret ps
  else []

def containerBody : Nat -> List Int -> Int -> Int -> Int -> List Int -> List Int
  | 0, hd, op, ty, ret, scrs =>
    let tw : List Int := tyW hd ty;
    let element : Int := if basicKind 0 ty == 4 then basicFirst 0 ty else elemTy 0 ty;
    let ow : List Int := tyW hd (optionTy 0 element);
    let a : List Int := varB (nthF 0 scrs 0);
    let b0 : List Int := varB (nthF 0 scrs 1);
    let b : List Int := if op == 9 || op == 10 || op == 11 || op == 19 || op == 27 || op == 29 then magnitudeNatIndexW b0 else b0;
    -- maxOfLe: arguments were bound once by lowContainerArgs. Internal
    -- dispatch 37 emits existing if/<=/var wire forms, O(1) extra bytes.
    if op >= 40 && op <= 42 then sourceMapBody hd op ty scrs
    else if op == 37 then magnitudeNatMaxW a b
    else if op == 1 then [5, 38] ++ tw ++ a ++ [39] ++ a ++ b
    else if op == 2 then [38] ++ tw ++ a
    else if op == 3 then [17, 38] ++ tw ++ a
    else if op == 4 then magnitudeMetadataNatW ([24] ++ tw ++ a)
    else if op == 5 then [25] ++ a
    else if op == 6 then [27] ++ litI 1 ++ a
    else if op == 7 then [14, 0, 24] ++ tw ++ a ++ litI 0
    else if op == 8 then
      [4] ++ ow ++ [25] ++ a ++ [5, 38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ varB (nthF 0 scrs 1 + 1)
    else if op == 9 then [25, 27] ++ b ++ a
    else if op == 10 then
      [4] ++ ow ++ [25, 27] ++ b ++ a ++ [5, 38] ++ ow ++ varB 0 ++ [39] ++ varB 0 ++ varB (nthF 0 scrs 2 + 1)
    else if op == 11 then [27] ++ b ++ a
    else if op == 12 then [36] ++ a
    else if op == 13 || op == 14 then [22]
    -- Array construction materializes the List wrapper via existing append/nil.
    else if op == 15 then [26] ++ a ++ [22]
    else if op == 17 then a
    else if op == 16 then [26] ++ a ++ [23] ++ b
    else if op == 18 then
      [50] ++ tw ++ a ++ [22, 26] ++ varB 1 ++ [23, 5, 14, 0, 24] ++ tw ++ varB 1 ++
      magnitudeNatIndexW (varB (nthF 0 scrs 1 + 2)) ++ varB (nthF 0 scrs 2 + 2) ++ varB 0
    else if op == 19 then
      [27] ++ b ++ listPrefixW tw a (magnitudeNatIndexW (varB (nthF 0 scrs 2 + 2)))
    else if op == 28 then
      [14] ++ tw ++ b ++ listPrefixW tw a ([24] ++ tw ++ varB (nthF 0 scrs 1 + 2))
    else if op == 29 then
      listPrefixW tw ([27] ++ b ++ varB (nthF 0 scrs 2)) (magnitudeNatIndexW (varB (nthF 0 scrs 0 + 2)))
    else if op == 31 then
      countMagnitudeReplicateW tw (nthF 0 scrs 0) (nthF 0 scrs 1)
    else if op == 32 then
      -- List.getLast? carries only the latest element; empty stays none.
      [50] ++ tw ++ a ++ [37, 36] ++ varB 0
    else if op == 33 then listConcatRevW tw (splitReverseW tw a)
    else if op == 35 then
      -- Stock zip's simultaneous head/tail equations, with an inert fold
      -- after either end. Existing fold costs O(left + min(left,right)).
      let other : Int := listTy 0 (productRight 0 (elemTy 0 ret));
      let stateTy : List Int := [7,2] ++ fiName 0 ++ tyW hd other ++ fiName 1 ++ tyW hd ret;
      let rest : List Int := [35] ++ stateTy ++ [0] ++ varB 1;
      let acc : List Int := [35] ++ stateTy ++ [1] ++ varB 1;
      let pair : List Int := [34] ++ fiName 0 ++ varB 0 ++ [34] ++ fiName 1 ++ [39,25] ++ rest ++ [33];
      let step : List Int := [5,14,0,24] ++ tyW hd other ++ rest ++ litI 0 ++ varB 1 ++
        [34] ++ fiName 0 ++ [27] ++ litI 1 ++ rest ++ [34] ++ fiName 1 ++ [26,23] ++ pair ++ acc ++ [33];
      let init : List Int := [34] ++ fiName 0 ++ b ++ [34] ++ fiName 1 ++ [22,33];
      splitReverseW (tyW hd ret) ([35] ++ stateTy ++ [1,50] ++ tw ++ a ++ init ++ step)
    else if op == 36 then countMagnitudeRangeW (nthF 0 scrs 0)
    else []
  | n + 1, hd, op, ty, ret, scrs => containerBody n hd op ty ret scrs

-- Put callback binders on the fold's element/accumulator slots.
def hofBind : St -> List Int -> List Int -> List Int -> List Int

  | st, ctx, a :: b :: _ :: rest, i :: is =>
    let next : List Int := if findLocal st rest a b >= 0 then ctx else setSlot ctx (Int.toNat i) a b;
    hofBind st next rest is
  | _, ctx, _, _ => ctx

def hofResult : Nat -> Int -> List Int -> List Int -> List Int -> List Int
  | 0, op, acc, elem, value =>
    if op == 22 then [26] ++ acc ++ [23] ++ value
    else if op == 23 || op == 27 then [5] ++ value ++ [26] ++ acc ++ [23] ++ elem ++ acc
    else if op == 25 then [26, 23] ++ elem ++ acc
    else if op == 34 then [26, 23] ++ value ++ acc
    else if op == 30 then
      [5] ++ value ++ [26, 23, 22] ++ acc ++
        [26, 23, 26, 39, 25] ++ acc ++ [23] ++ elem ++ [27] ++ litI 1 ++ acc
    else value
  | n + 1, op, acc, elem, value => hofResult n op acc elem value

def hofGuard : Nat -> Int -> List Int -> List Int -> List Int -> List Int
  | 0, op, acc, active, idle =>
    if op == 20 then [5] ++ acc ++ active ++ idle
    else if op == 21 || op == 26 then [5] ++ acc ++ idle ++ active
    else active
  | n + 1, op, acc, active, idle => hofGuard n op acc active idle

def hofInitial : Nat -> Int -> List Int -> List Int
  | 0, op, scrs =>
    if op == 20 then [1, 1]
    else if op == 21 || op == 26 then [1, 0]
    else if op == 30 then [23, 22]
    else if op == 24 then varB (nthF 0 scrs 1)
    else [22]
  | n + 1, op, scrs => hofInitial n op scrs

def hofValue : Nat -> List Int -> Int -> Int -> List Int -> List Int -> List Int -> List Int
  | 0, hd, op, ty, scrs, acc, elem =>
    if op == 26 then [14] ++ tyW hd (elemTy 0 ty) ++ elem ++ varB (nthF 0 scrs 1)
    else if op == 27 then [12, 24] ++ tyW hd ty ++ acc ++ magnitudeNatIndexW (varB (nthF 0 scrs 1))
    else []
  | n + 1, hd, op, ty, scrs, acc, elem => hofValue n hd op ty scrs acc elem

-- Context preparation and wire assembly do not call the recursive lowerer.
-- Keep them outside its mutual group to bound termination elaboration.
def hofCallCtx : Nat -> St -> List Int -> List Int -> Int -> Int -> Int -> Int -> List Int
  | 0, st, hd, ctx, op, ty, ret, cb =>
    let accTy : Int := if op == 34 then listTy 0 ret else ret;
    let ar : List Int := arenaBs hd ctx;
    let arena : Bool := lenI ar != 0;
    let base : List Int := [-1, -1, if op == 30 then 6 else elemTy 0 ty, -1, -1, if arena then 0 else accTy] ++ shiftTrailer ctx 2;
    let bodyCtx : List Int := if arena then [-1, -1, accTy, -2, -2, 2000] ++ shiftTrailer base 2 else base;
    let accIx : Int := if arena then 0 else 1;
    let elemIx : Int := if arena then 2 else 0;
    let slots : List Int := if op == 24 then [accIx, elemIx] else [elemIx];
    let names : List Int := if cb >= 0 then lambdaDecls st (headsOf hd) (fd 0 st cb 1) else [];
    hofBind st bodyCtx names slots

  | n + 1, st, hd, ctx, op, ty, ret, cb => hofCallCtx n st hd ctx op ty ret cb

def hofFinish : Nat -> List Int -> List Int -> Int -> Int -> Int -> List Int -> List Int -> Bw -> Bw
  | 0, hd, ctx, op, ty, ret, scrs, callCtx, w =>
    let accTy : Int := if op == 34 then listTy 0 ret else ret;
    let ar : List Int := arenaBs hd ctx;
    let arena : Bool := lenI ar != 0;
    let accIx : Int := if arena then 0 else 1;
    let elemIx : Int := if arena then 2 else 0;
    if w.err != 0 then w
    else if !arena && w.moved != 0 then bwErr 0 8
    else
      let step : List Int := hofResult 0 op (varB (accIx + w.moved)) (varB (elemIx + w.moved)) w.bs;
      let active : List Int := w.pre ++ (if arena then wrapResVal hd step (arenaBs hd w.ctx) else step);
      let idle : List Int := if arena then wrapResVal hd (varB accIx) (arenaBs hd callCtx) else varB accIx;
      let body : List Int := hofGuard 0 op (varB accIx) active idle;
      let init : List Int := hofInitial 0 op scrs;
      let unpack : List Int := [4] ++ arenaListTy ++ projF1 hd accTy (varB 1) ++ [4] ++ tyW hd accTy ++ projF0 hd accTy (varB 2);
      let fold : List Int := [50] ++ tyW hd ty ++ varB (nthF 0 scrs 0) ++ (if arena then wrapResVal hd init ar ++ unpack else init) ++ body;
      let result : List Int := if arena then projF0 hd accTy (varB 0) else fold;
      let finished : List Int := if op == 30 then splitReverseW (tyW hd ret) result else if op == 34 then listConcatRevW (tyW hd accTy) result else result;
      if arena then bwOk 0 ([4] ++ wrapResTy hd accTy ++ fold) (-3 :: -3 :: accTy :: shiftTrailer ctx 1) 1 finished ret
      else bwOk 0 [] ctx 0 finished ret

  | n + 1, hd, ctx, op, ty, ret, scrs, callCtx, w => hofFinish n hd ctx op ty ret scrs callCtx w

-- Projection lowering consumes an already lowered receiver. Keeping this
-- outside the recursive lowering group bounds its termination elaboration.
def lowProductProj : Nat -> List Int -> Bw -> Int -> Bw
  | 0, hd, r, k =>
    if r.err != 0 then r
    else if !(isProductTy 0 r.ty) || (k != 1 && k != 2) then bwErr 0 6
    else
      let tw : List Int := tyW hd r.ty;
      let ty : Int := if k == 1 then productLeft 0 r.ty else productRight 0 r.ty;
      if hasTyErr 400 tw then bwErr 0 9
      else bwOk 0 r.pre r.ctx r.moved ([35] ++ tw ++ leb (k - 1) ++ r.bs) ty
  | n + 1, hd, r, k => lowProductProj n hd r k

def lowRecordProj : St -> List Int -> Bw -> Int -> Bw

  | st, hd, r, id =>
      let hs : List Int := headsOf hd;
      let fsl : List Int := fldsOf hd;
      let idx : Int := r.ty - 100;
      let first : Nat := Int.toNat (nthF 0 hs (Int.toNat idx * 4 + 3));
      let cnt : Nat := Int.toNat (nthF 0 hs (Int.toNat idx * 4 + 2));
      let k : Int := fieldIx st fsl first first (first + cnt) (fd 0 st id 2) (fd 0 st id 3);
      if k < 0 then bwErr 0 5
      else
        let fty : Int := nthF 0 fsl ((first + Int.toNat k) * 3 + 2);
        if hasI idx (recsOf hd) then
          let arB : List Int := arenaBs hd r.ctx;
          let ks : Int := fldKindSlot hd idx (Int.toNat k);
          if lenI arB == 0 || ks == -1 then bwErr 0 8
          else if hasTyErr 400 (tyW hd fty) then bwErr 0 9
          else bwOk 0 r.pre r.ctx r.moved (arenaFieldRead hd arB r.bs ks) fty
        else
          let rt : List Int := tyW hd r.ty;
          if hasTyErr 400 rt then bwErr 0 9
          else bwOk 0 r.pre r.ctx r.moved ([35] ++ rt ++ leb k ++ r.bs) fty

-- Pattern matrix. One constructor column at a time; nested patterns and the other
-- columns become the branch. A binder that overlaps a constructor is a refinement
-- (na, nb, ty, template, -7): nil, cons of the new fields, or literal 0.
def patKind : St -> Int -> Int

  | st, id =>
    if id < 0 then 0
    else kindP st id

def bareP : St -> Int -> Int

  | st, id =>
    if id < 0 then id
    else unwrapP st id

def irrefP : St -> Int -> Bool

  | st, id =>
    if id < 0 then true
    else binderP st id

-- remaining is the number of indices to produce.
def ixRangeCount : Nat -> Nat -> List Int
  | _, 0 => []
  | i, remaining + 1 => Int.ofNat i :: ixRangeCount (i + 1) remaining

def ixRange (i lim : Nat) : List Int := ixRangeCount i (lim - i)

def sepsN : Nat -> List Int

  | 0 =>
    []
  | k + 1 =>
    -8 :: sepsN k

partial def patsOf : St -> Int -> Nat -> Nat -> List Int

  | st, li, i, pc =>
    if i >= pc then []
    else patAt st li i :: patsOf st li (i + 1) pc

def flatAlts : St -> List Int -> Nat -> List Int

  | _, [], _ => []
  | st, a :: as, pc =>
    patsOf st (fd 0 st a 1) 0 pc ++ flatAlts st as pc

def takeSeg : List Int -> List Int

  | [] => []
  | x :: xs =>
    if x == -8 then []
    else x :: takeSeg xs

def dropSegs : List Int -> Nat -> List Int

  | [], _ => []
  | xs, 0 => xs
  | x :: xs, k + 1 =>
    if x == -8 then dropSegs xs k
    else dropSegs xs (k + 1)

def shiftAls : List Int -> Int -> Nat -> List Int

  | [], _, _ => []
  | x :: xs, k, ph =>
    if x == -8 then -8 :: shiftAls xs k 0
    else if ph == 2 then (x + k) :: shiftAls xs k 0
    else x :: shiftAls xs k (ph + 1)

def mapCol : List Int -> Nat -> Nat -> Int -> List Int -> List Int

  | [], _, _, _, _ => []
  | x :: xs, i, col, sh, news =>
    if i == col then news ++ mapCol xs (i + 1) col sh news
    else (x + sh) :: mapCol xs (i + 1) col sh news

def mapTy : List Int -> Nat -> Nat -> List Int -> List Int

  | [], _, _, _ => []
  | x :: xs, i, col, news =>
    if i == col then news ++ mapTy xs (i + 1) col news
    else x :: mapTy xs (i + 1) col news

def placeAt : List Int -> Nat -> Nat -> List Int -> List Int

  | [], _, _, _ => []
  | x :: xs, i, col, neu =>
    if i == col then neu ++ placeAt xs (i + 1) col neu
    else x :: placeAt xs (i + 1) col neu

def acc0 : Nat -> Bag
  | 0 => { pats := [], alts := [], als := [] : Bag }
  | n + 1 => acc0 n

partial def specRows : St -> Mx -> Nat -> Nat -> Nat -> Bag -> Bag

  | st, mx, row, col, mode, acc =>
    if row >= lenI mx.alts then acc
    else
      let start : Nat := row * mx.ncol;
      let rowP : List Int := takeI (dropI mx.pats start) mx.ncol;
      let p : Int := nthI rowP col;
      let k : Int := patKind st p;
      let openR : Bool := irrefP st p;
      let keep : Bool := (mode == 1 && (k == 1 || openR)) || (mode == 2 && (k == 2 || openR)) || (mode == 3 && (k == 3 || openR)) || (mode == 4 && (k == 4 || openR)) || (mode == 5 && (k == 1 || openR)) || (mode == 6 && openR);
      let acc2 : Bag :=
        if !keep then acc
        else
          let b : Int := bareP st p;
          let sh : Int := if mode == 2 then 2 else if mode == 4 then 3 else if mode == 5 || mode == 6 then 0 else 1;
          let si : Int := nthI mx.scrs col;
          let idx : Int := if mode == 2 then 1 else si + sh;
          let pty : Int := nthI mx.tys col;
          let inner : Int := if k == 2 then bareP st (if natConstructorPatCode st b == 2 then nthF 0 (getArgs st b) 0 else fd 0 st b 2) else -1;
          let hdP : Int := if k == 4 then bareP st (fd 0 st b 2) else -1;
          let tlP : Int := if k == 4 then bareP st (fd 0 st b 3) else -1;
          let neu : List Int := if mode == 2 then [inner] else if mode == 4 then [hdP, tlP] else [];
          let seg : List Int := takeSeg (dropSegs mx.als row);
          let seg1 : List Int := shiftSeg seg sh;
          let named : Bool := p >= 0 && fd 0 st b 0 == 1 && natConstructorPatCode st b == 0;
          let seg2 : List Int := if named then fd 0 st b 1 :: fd 0 st b 2 :: pty :: [1, idx, -7] ++ seg1 else seg1;
          { pats := acc.pats ++ placeAt rowP 0 col neu, alts := acc.alts ++ [nthI mx.alts row], als := acc.als ++ seg2 ++ [-8] : Bag };
      specRows st mx (row + 1) col mode acc2

def spec : St -> Mx -> Nat -> Nat -> Int -> Mx

  | st, mx, col, mode, ty =>
    let sh : Int := if mode == 2 then 2 else if mode == 4 then 3 else if mode == 5 || mode == 6 then 0 else 1;
      let news : List Int := if mode == 2 then [0] else if mode == 4 then [1, 0] else [];
      let elem : Int := if isListTy 0 ty then elemTy 0 ty else if basicKind 0 ty == 4 then basicFirst 0 ty else 0;
      let newt : List Int := if mode == 2 then [4] else if mode == 4 then [elem, ty] else [];
      let acc : Bag := specRows st mx 0 col mode (acc0 0);
      let si : Int := nthI mx.scrs col;
      let target : Int := si + sh;
      let repl : List Int := if mode == 4 then [3, 1, 1, 1, 0] else if mode == 3 then [2] else [4, 0];
      let doSub : Bool := mode == 1 || mode == 3 || mode == 4 || mode == 5;
      let als1 : List Int := if doSub then substSeg acc.als target repl else acc.als;
      let ncol2 : Nat := if mode == 2 then mx.ncol else if mode == 4 then mx.ncol + 1 else mx.ncol - 1;
      { pats := acc.pats, alts := acc.alts, scrs := mapCol mx.scrs 0 col sh news, tys := mapTy mx.tys 0 col newt, als := als1, ncol := ncol2 : Mx }

-- A literal test removes the selected column only in the equality branch.
-- The unequal branch retains it, including all overlapping binders, in source
-- order. Bool has exactly two inhabitants, so both branches remove the column.
-- Exact literal identity: sign then canonical LE base256 magnitude.
-- Source bytes and predecessor certificates are the existing numeral source.
def literalValue : St -> Int -> List Int
  | st, id =>
    let p : Int := unwrapP st id;
    let t : Int := fd 0 st p 0;
    if t == 1 then if spanEq 0 st (fd 0 st p 1) (fd 0 st p 2) "true" then [0,1] else [0]
    else
      let digits : List Int := numeralMagnitude st (if t == 7 then fd 0 st p 2 else p);
      (if t == 7 && lenI digits != 0 then 1 else 0) :: digits

partial def firstLiteral : St -> Mx -> Nat -> Nat -> Int

  | st, mx, col, row =>
    if row >= lenI mx.alts then -1
    else
      let p : Int := nthI mx.pats (row * mx.ncol + col);
      let k : Int := patKind st p;
      if k == 1 || k == 5 || k == 6 then p
      else firstLiteral st mx col (row + 1)

partial def literalRows : St -> Mx -> Nat -> Nat -> List Int -> Bool -> Bool -> Bag -> Bag

  | st, mx, row, col, value, positive, remove, acc =>
    if row >= lenI mx.alts then acc
    else
      let rowP : List Int := takeI (dropI mx.pats (row * mx.ncol)) mx.ncol;
      let p : Int := nthI rowP col;
      let openR : Bool := irrefP st p;
      let equal : Bool := literalValue st p == value;
      let keep : Bool := openR || equal == positive;
      let next : Bag :=
        if !keep then acc
        else
          let b : Int := bareP st p;
          let seg : List Int := takeSeg (dropSegs mx.als row);
          let named : Bool := openR && p >= 0 && fd 0 st b 0 == 1 && remove;
          let seg2 : List Int := if named then fd 0 st b 1 :: fd 0 st b 2 :: nthI mx.tys col :: [1, nthI mx.scrs col, -7] ++ seg else seg;
          { pats := acc.pats ++ (if remove then placeAt rowP 0 col [] else rowP), alts := acc.alts ++ [nthI mx.alts row], als := acc.als ++ seg2 ++ [-8] : Bag };
      literalRows st mx (row + 1) col value positive remove next

def literalSpec : St -> Mx -> Nat -> List Int -> Bool -> Bool -> Mx

  | st, mx, col, value, positive, remove =>
    let acc : Bag := literalRows st mx 0 col value positive remove (acc0 0);
    { pats := acc.pats, alts := acc.alts, scrs := if remove then mapCol mx.scrs 0 col 0 [] else mx.scrs, tys := if remove then mapTy mx.tys 0 col [] else mx.tys, als := acc.als, ncol := if remove then mx.ncol - 1 else mx.ncol : Mx }

def bindAls : List Int -> List Int -> List Int

  | [], ctx => ctx
  | na :: nb :: ix :: rest, ctx =>
    bindAls rest (setSlot ctx (Int.toNat ix) na nb)
  | _, ctx => ctx

def maskB : St -> List Int -> Int -> Int -> List Int

  | st, a :: b :: ty :: rest, na, nb =>
    if a == -9 then a :: b :: ty :: rest
    else
      let a2 : Int := if a >= 0 && spanSame 0 st na nb a b then -1 else a;
      a2 :: b :: ty :: maskB st rest na nb
  | _, ctx, _, _ => ctx

-- Removed pattern columns carry refinements rather than ordinary slots. Their
-- binders still shadow outer locals; retain the slots for de Bruijn indices.
partial def maskRx : St -> List Int -> List Int -> List Int

  | _, [], ctx => ctx
  | st, a :: b :: ty :: rest, ctx =>
    let c : Cut := shiftT rest 0;
    let after : List Int := if nthI c.rest 0 == -7 then dropI c.rest 1 else c.rest;
    maskRx st after (maskB st ctx a b)
  | _, _, ctx => ctx

-- A nested match has one trailer. Its refinements precede outer refinements,
-- while ordinary slots added later by let/lambda remain the first lookup.
def prependRx : List Int -> List Int -> List Int

  | [], seg => -9 :: seg
  | x :: xs, seg =>
    if x == -9 then -9 :: (seg ++ xs)
    else x :: prependRx xs seg

def bindPats : St -> List Int -> List Int -> List Int -> List Int

  | _, [], _, ctx => ctx
  | st, p :: ps, s :: ss, ctx =>
    let b : Int := bareP st p;
      let ctx2 : List Int := if p >= 0 && fd 0 st b 0 == 1 then setSlot (maskB st ctx (fd 0 st b 1) (fd 0 st b 2)) (Int.toNat s) (fd 0 st b 1) (fd 0 st b 2) else ctx;
      bindPats st ps ss ctx2
  | _, _, _, ctx => ctx

partial def sniff : St -> List Int -> Nat -> Nat -> Nat -> Int

  | st, pats, ncol, col, row =>
    if row * ncol >= lenI pats then 0
    else
      let k : Int := patKind st (nthI pats (row * ncol + col));
      if k == 1 || k == 2 then 1
      else if k == 3 || k == 4 then 2
      else if k == 5 || k == 6 then 3
      else if k == 7 then 4
      else if k == 9 then 5
      else sniff st pats ncol col (row + 1)

partial def findC : St -> List Int -> Nat -> Nat -> Nat -> Nat

  | st, pats, ncol, nrow, c =>
    if c >= ncol then c
    else if sniff st pats ncol c 0 != 0 then c
    else findC st pats ncol nrow (c + 1)

partial def colIs : St -> List Int -> Nat -> Nat -> Nat -> Int -> Bool

  | st, pats, ncol, row, col, kind =>
    if row * ncol >= lenI pats then false
    else if patKind st (nthI pats (row * ncol + col)) == kind then true
    else colIs st pats ncol (row + 1) col kind

-- Lean 4.14 Meta.Match.expandNatValuePattern exposes one constructor
-- layer when Nat values meet constructor patterns. This is tree building:
-- positive values become successor(value - 1), with source rows unchanged.
-- The next matrix step specializes that constructor and retains its binding.
structure ExpandedNatPats where
  state : St
  pats : List Int
  deriving Inhabited

def expandNatValues : St -> List Int -> Nat -> Nat -> ExpandedNatPats
  | st, [], _, _ => { state := st, pats := [] : ExpandedNatPats }
  | st, p :: ps, width, col =>
    let b : Int := bareP st p;
    let expand : Bool := col == 0 && b >= 0 && fd 0 st b 0 == 2 && lenI (numeralMagnitude st b) != 0;
    let next : St :=
      if expand then
        let inner : St := alloc 0 st 2 (-2) b 1;
        let one : St := alloc 0 inner 2 (-1) (-1) 1;
        alloc 0 one 6 1 inner.ret one.ret
      else st;
    let rest : ExpandedNatPats := expandNatValues next ps width (if col == 0 then width - 1 else col - 1);
    { state := rest.state, pats := (if expand then next.ret else p) :: rest.pats : ExpandedNatPats }

-- Scan a matrix column structurally through the pattern list. Width and
-- position describe the matrix, rather than bounding the traversal.
def anonymousColumn : St -> List Int -> Nat -> Nat -> Bool
  | _, [], _, _ => false
  | st, p :: ps, width, col =>
    if col == 0 then
      let b : Int := bareP st p;
      (b >= 0 && fd 0 st b 0 == 14 && fd 0 st b 3 == -47) ||
        anonymousColumn st ps width (width - 1)
    else anonymousColumn st ps width (col - 1)

-- A structure has one constructor: specialize to its fields, retaining every
-- row and its original column for whole-value binders. Field order comes
-- from the type, not syntax; the record pattern itself becomes a wildcard.
partial def recordPats : St -> List Int -> Int -> Nat -> Nat -> List Int

  | st, fields, pat, first, left =>
    if left == 0 then []
    else
      let p : Int := if pat < 0 || fd 0 st pat 0 != 14 then -1 else findLit st (fd 0 st pat 2) (nthF 0 fields (first * 3)) (nthF 0 fields (first * 3 + 1));
      p :: recordPats st fields pat (first + 1) (left - 1)

partial def recordRows : St -> List Int -> Mx -> Nat -> Nat -> Nat -> Nat -> Bag -> Bag

  | st, fields, mx, row, col, first, cnt, acc =>
    if row >= lenI mx.alts then acc
    else
      let rowP : List Int := takeI (dropI mx.pats (row * mx.ncol)) mx.ncol;
      let p : Int := bareP st (nthI rowP col);
      let seg : List Int := takeSeg (dropSegs mx.als row);
      let rest : List Int := if p >= 0 && fd 0 st p 0 == 14 then placeAt rowP 0 col [-1] else rowP;
      let next : Bag := { pats := acc.pats ++ recordPats st fields p first cnt ++ rest, alts := acc.alts ++ [nthI mx.alts row], als := acc.als ++ seg ++ [-8] : Bag };
      recordRows st fields mx (row + 1) col first cnt next


-- Prod has one constructor. Preserve source row order and the original
-- column for whole-value binders while exposing its two ordered fields.
partial def productRows : St -> Mx -> Nat -> Nat -> Bag -> Bag
  | st, mx, row, col, acc =>
    if row >= lenI mx.alts then acc
    else
      let rowP : List Int := takeI (dropI mx.pats (row * mx.ncol)) mx.ncol;
      let p : Int := bareP st (nthI rowP col);
      let pair : Bool := p >= 0 && fd 0 st p 0 == 42;
      let fields : List Int := if pair then [fd 0 st p 1, fd 0 st p 2] else [-1, -1];
      let rest : List Int := if pair then placeAt rowP 0 col [-1] else rowP;
      let seg : List Int := takeSeg (dropSegs mx.als row);
      let next : Bag := { pats := acc.pats ++ fields ++ rest, alts := acc.alts ++ [nthI mx.alts row], als := acc.als ++ seg ++ [-8] : Bag };
      productRows st mx (row + 1) col next

def ctorPat : St -> List Int -> Int -> Int

  | st, hd, id =>
    let p : Int := if id < 0 then -1 else bareP st id;
    let f : Int := getFn st p;
    if fd 0 st f 0 != 1 then -1
    else ctorNode st (indsOf hd) f 0

partial def indCol : St -> List Int -> Mx -> Nat -> Nat -> Nat

  | st, hd, mx, col, row =>
    if col >= mx.ncol then col
    else if row >= lenI mx.alts then indCol st hd mx (col + 1) 0
    else if ctorPat st hd (nthI mx.pats (row * mx.ncol + col)) >= 0 then col
    else indCol st hd mx col (row + 1)

def wildPats : Nat -> List Int

  | 0 => []
  | k + 1 => -1 :: wildPats k

-- Specialize a constructor, keeping the original column for whole-value
-- catch-all binders. This preserves source row priority for nested patterns.
partial def indRows : St -> List Int -> Mx -> Nat -> Nat -> Int -> Nat -> Bag -> Bag

  | st, hd, mx, row, col, ci, cnt, acc =>
    if row >= lenI mx.alts then acc
    else
      let rowP : List Int := takeI (dropI mx.pats (row * mx.ncol)) mx.ncol;
      let p : Int := bareP st (nthI rowP col);
      let pc : Int := ctorPat st hd p;
      let keep : Bool := pc == ci || pc < 0 && irrefP st p;
      let next : Bag :=
        if !keep then acc
        else
          let args : List Int := if pc == ci then getArgs st p else wildPats cnt;
          let rest : List Int := if pc == ci then placeAt rowP 0 col [-1] else rowP;
          { pats := acc.pats ++ args ++ rest, alts := acc.alts ++ [nthI mx.alts row],
            als := acc.als ++ takeSeg (dropSegs mx.als row) ++ [-8] : Bag };
      indRows st hd mx (row + 1) col ci cnt next

-- Builtin Option uses the same ordered matrix specialization as source
-- constructors. Keep original columns so a catch-all can bind the whole value.
partial def optionCol : St -> Mx -> Nat -> Nat -> Nat
  | st, mx, col, row =>
    if col >= mx.ncol then col
    else if row >= lenI mx.alts then optionCol st mx (col + 1) 0
    else if optionPatCode st (nthI mx.pats (row * mx.ncol + col)) != 0 then col
    else optionCol st mx col (row + 1)

partial def optionRows : St -> Mx -> Nat -> Nat -> Int -> Nat -> Bag -> Bag
  | st, mx, row, col, op, cnt, acc =>
    if row >= lenI mx.alts then acc
    else
      let rowP : List Int := takeI (dropI mx.pats (row * mx.ncol)) mx.ncol;
      let p : Int := bareP st (nthI rowP col);
      let pc : Int := optionPatCode st p;
      let keep : Bool := pc == op || pc == 0 && irrefP st p;
      let next : Bag :=
        if !keep then acc
        else
          let args : List Int := if pc == op then getArgs st p else wildPats cnt;
          let rest : List Int := if pc == op then placeAt rowP 0 col [-1] else rowP;
          { pats := acc.pats ++ args ++ rest, alts := acc.alts ++ [nthI mx.alts row],
            als := acc.als ++ takeSeg (dropSegs mx.als row) ++ [-8] : Bag };
      optionRows st mx (row + 1) col op cnt next

def shiftMx : Mx -> Int -> Mx

  | mx, k => { pats := mx.pats, alts := mx.alts, scrs := shiftScruts mx.scrs k, tys := mx.tys, als := shiftSeg mx.als k, ncol := mx.ncol : Mx }

-- Bare (nullary) constructor value: inj k of record [], or just record []
-- when the inductive has a single constructor (the typed emitter unboxes it).
-- Recursive inductives use lowHeapCtor below.
def lowCtorNil : List Int -> Int -> Bw

  | hd, cix =>
    let icts : List Int := indsOf hd;
      let i : Nat := Int.toNat cix;
      let hi : Nat := Int.toNat (nthF 0 icts (i * 5 + 2));
      let ac : Int := nthF 0 icts (i * 5 + 3);
      if ac != 0 then bwErr 0 5
      else if hasI (Int.ofNat hi) (recsOf hd) then bwErr 0 13
      else
        let hs : List Int := headsOf hd;
        let ccnt : Int := 0 - 1 - nthF 0 hs (hi * 4 + 2);
        let k : Int := cix - nthF 0 hs (hi * 4 + 3);
        if ccnt == 1 then bwOk 0 [] [] 0 [33] (30000 + Int.ofNat hi)
        else bwOk 0 [] [] 0 ([31] ++ leb k ++ [33]) (30000 + Int.ofNat hi)


-- Packing has no recursive lowering calls; keep it outside the mutual group.
def lowHeapCtor : List Int -> Nat -> Int -> RecFlds -> Bw

  | hd, argc, ci, flds =>
    if flds.err != 0 then bwErr 0 flds.err
    else
      let ar : List Int := arenaBs hd flds.ctx;
      if lenI ar == 0 then bwErr 0 8
      else
        let hi : Int := nthF 0 (indsOf hd) (Int.toNat ci * 5 + 2);
        let tag : Int := ci - nthF 0 (headsOf hd) (Int.toNat hi * 4 + 3);
        let z : List Int := litI 0;
        let node : List Int := mkNodeW hd (litI tag)
          (listLitBs (collectKidsBs flds.ks flds.bs 0 argc))
          (findSlotBs flds.ks flds.bs 100 z) (findSlotBs flds.ks flds.bs 101 z)
          (findSlotBs flds.ks flds.bs 102 z) (findSlotBs flds.ks flds.bs 200 [1, 0])
          (findSlotBs flds.ks flds.bs 201 [1, 0]) [2, 1, 0] (findSlotBs flds.ks flds.bs 900 [22]);
        let pre : List Int := flds.pre ++ [4] ++ wrapResTy hd 8 ++ [52, 0, 1] ++ node ++ [1] ++ ar ++ [0];
        let ctx1 : List Int := -3 :: -3 :: 8 :: shiftTrailer flds.ctx 1;
        bwOk 0 pre ctx1 (flds.moved + 1) (projF0 hd 8 (varB 0)) (30000 + hi)


def arenaMagnitudeAllocBoundW (pk : List Int) : List Int :=
  let z : List Int := litI 0;
  let holder : List Int := mkNodeW pk z [22] z z z [1,0] [1,0] [2,1,0] (varB 0);
  [52,0,1] ++ holder ++ [1] ++ varB 1 ++ [0]

def arenaMagnitudeHoldW (hd : List Int) (kind : Int) (w : Bw) : Bw :=
  if w.err != 0 then w
  else
    let arB : List Int := arenaBs hd w.ctx;
    if lenI arB == 0 then bwErr 0 8
    else
      let z : List Int := litI 0;
      let data : List Int := [4] ++ tyW hd w.ty ++ w.bs ++ arenaMagnitudePackBound kind;
      let holder : List Int := mkNodeW hd z [22] z z z [1,0] [1,0] [2,1,0] data;
      let call : List Int := if dataNode hd then [-600041,1] ++ data ++ [1] ++ arB ++ [0]
        else [52,0,1] ++ holder ++ [1] ++ arB ++ [0];
      let ctx1 : List Int := -3 :: -3 :: 8 :: shiftTrailer w.ctx 1;
      bwOk 0 (w.pre ++ [4] ++ wrapResTy hd 8 ++ call) ctx1 (w.moved + 1) (projF0 hd 8 (varB 0)) 8

def wordConvert : Bw -> Int -> Bw
  | a, ret =>
    let bs : List Int :=
      if a.ty == 4 && isWordTy ret then [4] ++ natMagnitudeTyW ++ a.bs ++ magnitudeNatWordBound (wordWidth ret)
      else if ret == 4 then magnitudeMetadataNatW a.bs
      else if isWordTy ret && wordWidth a.ty > wordWidth ret then [11] ++ a.bs ++ litI (wordModulus ret)
      else a.bs;
    bwOk 0 a.pre a.ctx a.moved bs ret

def wordArgsW : List (List Int) -> List Int
  | [] => [0]
  | a :: rest => [1] ++ magnitudeMetadataNatW a ++ wordArgsW rest

def wordResidueW (ty : Int) (value : List Int) : List Int :=
  [11] ++ value ++ litI (wordModulus ty)

-- Lean's UInt32.mul is modulo 2^32. Signed representatives of both
-- operands are congruent and their product fits in the wire's signed i64.
def wordSigned32W (value : List Int) : List Int :=
  let half : List Int := litI 2147483648;
  [7] ++ wordResidueW 11 ([6] ++ wordResidueW 11 value ++ half) ++ half

def wordArithW (ty op : Int) (a b : List Int) : List Int :=
  let prim : Int := if op == 1 then 6 else if op == 2 then 7 else 8;
  if ty == 11 && op == 3 then
    wordResidueW ty ([prim] ++ wordSigned32W a ++ wordSigned32W b)
  else wordResidueW ty ([prim] ++ wordResidueW ty a ++ wordResidueW ty b)


-- Lean 4.14 pure Char.ofNat Unicode equation (SEM-ALIGN §6); no general inliner.
partial def closedCharTransparent (st : St) (hd : List Int) (ty id : Int) : Int :=
  let id : Int := unwrapP st id;
  if fd 0 st id 0 == 30 && decTy st (headsOf hd) (-1) (-1) (-1) (fd 0 st id 2) == ty then
    closedCharTransparent st hd ty (fd 0 st id 1)
  else id

def closedCharLiteral (st : St) (hd : List Int) (id : Int) : Int :=
  let id : Int := closedCharTransparent st hd 4 id;
  if fd 0 st id 0 != 2 || fd 0 st id 1 < 0 || fd 0 st id 2 <= fd 0 st id 1 then -1
  else
    let ds : List Int := numeralMagnitude st id;
    let n : Int := nthI ds 0 + 256 * nthI ds 1 + 65536 * nthI ds 2 + 16777216 * nthI ds 3;
    if lenI ds <= 3 && (n < 55296 || (57343 < n && n < 1114112)) then n else 0

def closedCharBuiltin (st : St) (hd : List Int) (fs : List Fn) (ctx : List Int) (id : Int) : Int :=
  let h : Int := getFn st id;
  if fd 0 st h 0 != 1 || fd 0 st h 3 == -9 || lenI (getArgs st id) != 1 then -1
  else
    let a : Int := fd 0 st h 1;
    let b : Int := fd 0 st h 2;
    if look st ctx a b >= 0 || fnIx st fs a b >= 0 then -1
    else closedCharLiteral st hd (nthI (getArgs st id) 0)

-- A mechanically checked unary Nat -> Char identity wrapper, never a general inliner.
def closedCharWrapper (st : St) (hd : List Int) (fs : List Fn) (f : Fn) : Bool :=
  if f.ps != [4] || f.ret != 6 || f.part != 0 || f.usesA != 0 || f.resA != 0 || fd 0 st f.node 0 != 20 then false
  else
    let sig : Int := fd 0 st f.node 2;
    let names : List Int := grpSpans st (fd 0 st sig 1);
    let body : Int := fd 0 st f.node 3;
    if lenI names != 2 || fd 0 st body 0 != 25 then false
    else
      let app : Int := closedCharTransparent st hd 6 (fd 0 st body 1);
      let h : Int := getFn st app;
      let args : List Int := getArgs st app;
      let binderCtx : List Int := rightmostParams st (zipCtx names f.ps);
      if fd 0 st app 0 != 5 || lenI args != 1 || fd 0 st h 0 != 1 || fd 0 st h 3 == -9 then false
      else
        let a : Int := fd 0 st h 1;
        let b : Int := fd 0 st h 2;
        let actual : Int := closedCharTransparent st hd 4 (nthI args 0);
        spanEq 0 st a b "Char.ofNat" && look st binderCtx a b < 0 && fnIx st fs a b < 0 &&
          fd 0 st actual 0 == 1 && look st binderCtx (fd 0 st actual 1) (fd 0 st actual 2) == 0

mutual
partial def low : St -> List Int -> List Fn -> List Int -> Int -> Int -> Bw

  | st, hd, fs, ctx, id, exp =>
    let w : Bw := lowBase st hd fs ctx id exp;
    if w.err == 0 && w.ty == 4 && exp == 1 then bwOk 0 w.pre w.ctx w.moved (natToIntMagnitudeW w.bs) 1 else w

partial def lowBase : St -> List Int -> List Fn -> List Int -> Int -> Int -> Bw

  | st, hd, fs, ctx, id, exp =>
    if id < 0 then bwErr 0 6
    else
      let t : Int := fd 0 st id 0;
