      if recursive && slot == -1 then bwErr 0 8
      else
        let ctx1 : List Int := -1 :: -1 :: ty :: shiftTrailer ctx 1;
        let b : Bw := lowIndFields st hd fs (shiftMx mx 1) ctx1 (node + 1) ci first (j + 1) cnt
          (shiftScruts scrs 1 ++ [0]) (tys ++ [ty]) ret;
        if b.err != 0 then b
        else if b.moved == 0 then bwUsedOk b.used 0 [] ctx 0 ([4] ++ tyW hd ty ++ value ++ b.bs) ret
        else bwUsedOk b.used 0 ([4] ++ tyW hd ty ++ value ++ b.pre) b.ctx (b.moved + 1) b.bs ret

-- Each product projection is evaluated once; the matrix retains its source
-- alternative identity for AlternativeUseNF's coverage/redundancy decision.
partial def lowProductFields : St -> List Int -> List Fn -> Mx -> List Int -> Int -> Int -> Nat -> List Int -> List Int -> Int -> Bw
  | st, hd, fs, mx, ctx, major, code, j, scrs, tys, ret =>
    if j >= 2 then
      lowMx st hd fs { pats := mx.pats, alts := mx.alts, scrs := scrs ++ mx.scrs, tys := tys ++ mx.tys, als := mx.als, ncol := mx.ncol : Mx } ctx ret
