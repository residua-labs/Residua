partial def lowHeapArgs : St -> List Int -> List Fn -> List Int -> List Int -> Int -> Nat -> RecFlds
  | _, _, _, ctx, [], _, _ => { err := 0, pre := [], ctx := ctx, moved := 0, ks := [], bs := [] : RecFlds }
  | st, hd, fs, ctx, a :: args, ci, j =>
    let fa : Nat := Int.toNat (nthF 0 (indsOf hd) (Int.toNat ci * 5 + 4));
