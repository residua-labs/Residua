def allowedAxioms : List Name := [``propext, ``Quot.sound]

open Elab Command in
run_cmd do
  let env ← getEnv
  for t in sealedTheorems do
    unless env.contains t do
      throwError "[rcic_f3_ktw_seal] {t} is not declared"
    let (_, s) := ((CollectAxioms.collect t).run env).run {}
    for ax in s.axioms do
      unless allowedAxioms.contains ax do
        throwError "[rcic_f3_ktw_seal] {t} depends on non-allowlisted axiom {ax}"
  logInfo m!"[rcic_f3_ktw_seal] {sealedTheorems.length} theorems sealed; axioms ⊆ {allowedAxioms}"

end Rcic.F3KTWSeal

