open Lean Elab Command in
run_cmd do
  let allowed := #[``propext, ``Quot.sound]
  for root in famAppTwinSealedRoots do
    let axioms ← collectAxioms root
    let forbidden := axioms.filter (fun ax => !allowed.contains ax)
    if !forbidden.isEmpty then
      throwError "FamAppTwin: {root} has forbidden axioms {forbidden}"
  logInfo m!"[fam_app_twin_seal] {famAppTwinSealedRoots.size} names sealed; axioms ⊆ [propext, Quot.sound]"
