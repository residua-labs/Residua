def allowedAxioms : List Name := [``propext, ``Quot.sound]
run_cmd do
  let env ← getEnv
  for t in sealedTheorems do
    unless env.contains t do
      throwError "[penda_model_seal] {t} is not declared"
    let (_, s) := ((CollectAxioms.collect t).run env).run {}
    for ax in s.axioms do
      unless allowedAxioms.contains ax do
        throwError "[penda_model_seal] {t} depends on {ax}"
  logInfo m!"[penda_model_seal] {sealedTheorems.length} declarations sealed"
end Rcic.F3.PendAModelSeal
