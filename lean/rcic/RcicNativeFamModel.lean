/-- `ConvT.tyConv` case for `LRTermFamIN`, discharged directly by our proved `lrTermFamIN_transport`
    (with no unproved `LRTermIndexTransport` or `LRTermSTransportLam` premise). -/
theorem fundConvFamIN_tyConv {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M M' A A' : Expr Nat} {w : Level}
    (hA : HasTyT E n Γ A (.sort w)) (hc : TyConvT E n Γ A A')
    (h : ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A' u :=
  fun u hu => lrTermFamIN_transport hW hdet zsc hcore hF hS u hΓ hA hc (h u hu)

/-- `ConvT.symm` case for `LRTermFamIN`, discharged by our proved `lrTermFamIN_symm` and compact
    transfer `hsound`. -/
theorem fundConvFamIN_symm_of_sound {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M M' A : Expr Nat}
    (hsound : ∀ u, ApproxI (ctxEnvI Γ) M' u → ApproxI (ctxEnvI Γ) M u)
    (h : ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIN E n Γ M' M A u :=
  fun u hu => lrTermFamIN_symm hW hdet zsc hcore hF hS u hΓ (h u (hsound u hu))

/-- `ConvT.trans` case for `LRTermFamIN`, discharged directly by our proved `lrTermFamIN_trans`
    (with no unproved `LRTermTrans` premise) and compact transfer `hsound`. -/
theorem fundConvFamIN_trans_of_sound {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M N P A : Expr Nat}
    (hsound : ∀ u, ApproxI (ctxEnvI Γ) M u → ApproxI (ctxEnvI Γ) N u)
    (h₁ : ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M N A u)
    (h₂ : ∀ u, ApproxI (ctxEnvI Γ) N u → LRTermFamIN E n Γ N P A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M P A u :=
  fun u hu => lrTermFamIN_trans hW hdet zsc hcore hF hS u hΓ (h₁ u hu) (h₂ u (hsound u hu))

/-- `ConvT.irr` case for `LRTermFamIN` at any `IsNonSortPropCtx` proposition `P`. -/
