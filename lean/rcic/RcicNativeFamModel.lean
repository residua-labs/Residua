/-! ### §15 — Wall `W-K-AND` in Admitted `andEnvU`, Wall `W-K-NONUNIQUE` Refuting `WhDetRecK` / `WhDiamondRecK` / `WhConfluentRecK` / `WhNormalUniqueRecK`, Head-Component Conversion Coherence (`WhPiCohRecK` & `WhFamCohRecK`), and Flat Probe Assembly (`FamProbeCpt` & `FundamentalLRFamINProbeRK`) Without `NormalUnique` -/

/-! #### Part A — General `ApproxDI` Recursor-Major Collapse (`approxDI_recursor_major_noSpine_eq_bot`), Fieldful Wall `W-K-AND` (`mixAndRedex`) in Admitted `andEnvU`, and Positive Resolution in §14's `WhRedRecK` / `ApproxDIK` / `LRTypeFamINRK` / `LRTermFamINDRK` -/

/-- `curryStep` distributes over list concatenation `uss₁ ++ uss₂`. -/
theorem curryStep_append (uss₁ uss₂ : List (List CptI)) (c₀ : CptI) :
    PiModelDeltaIotaAudit.curryStep (uss₁ ++ uss₂) c₀ =
      PiModelDeltaIotaAudit.curryStep uss₁ (PiModelDeltaIotaAudit.curryStep uss₂ c₀) := by
  induction uss₁ with
  | nil => rfl
  | cons us uss₁ ih =>
      rw [List.cons_append, PiModelDeltaIotaAudit.curryStep, PiModelDeltaIotaAudit.curryStep, ih]

/-- **General `ApproxDI` Recursor-Major Collapse (`approxDI_recursor_major_noSpine_eq_bot`):**
    For any `.recursorM` declaration `r` (`E.members r = some m`, `m.mclass = .recursorM`) applied
    to a pre-major spine `pre` of full pre-major length (`pre.length + 1 = piCount m.mtype`) and a
    major argument `x` that has **no** `.spine c' args'` compact in `ApproxDI E ρ`, the recursor
    application `.app (foldApps (.const r ls) pre) x` has **only** `.bot` in `ApproxDI E ρ`
    (`c = .bot`), because `ApproxDI.recursor` places `ctorDemand w.ctorRef w.nparams us_fields`
    (headed by `.spine w.ctorRef …`) on the major position. -/
theorem approxDI_recursor_major_noSpine_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    {ls : List Level} {pre : List (Expr Nat)} (hlen : pre.length + 1 = piCount m.mtype)
    {x : Expr Nat} (hno : ∀ c' args', ¬ PiModelDeltaIotaAudit.ApproxDI E ρ x (.spine c' args'))
    {c : CptI} (h : PiModelDeltaIotaAudit.ApproxDI E ρ (.app (foldApps (.const r ls) pre) x) c) :
    c = .bot := by
  rcases PiModelDeltaIotaAudit.approxDI_app_inv h with
    rfl | ⟨g, s, rfl, hf, hs, hx⟩ | ⟨r', args', u', rfl, hf, _⟩
  · rfl
  · obtain ⟨d, hd, hfold⟩ :=
      (PiModelDeltaIotaAudit.approxDI_foldApps_iff E ρ (.const r ls) pre (.lam g)).mp hf
    rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv hm hrec hd with
      rfl | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, rfl⟩
    · exact CptI.noConfusion (PiModelDeltaIotaAudit.foldAppCpt_bot_inv hfold)
    · have hm_eq : w.recMember = m := by
        have hrecW := w.hrec
        rw [hr, hm] at hrecW
        exact Option.some.inj hrecW.symm
      have hpre_len : us_pre.length = pre.length := by
        have hnmin := w.hnmin
        rw [hm_eq] at hnmin
        have hpreW := w.hpre
        omega
      rw [curryStep_append] at hfold
      rcases (PiModelDeltaIotaAudit.foldAppCpt_curryStep_iff hpre_len).mp hfold with
        hbot | ⟨_, heq⟩
      · exact CptI.noConfusion hbot
      · simp only [PiModelDeltaIotaAudit.curryStep] at heq
        injection heq with hg
        subst hg
        rcases List.mem_singleton.mp hs with rfl
        exact (hno w.ctorRef
          (List.replicate w.nparams .bot ++ List.replicate us_fields.length .bot)
          (hx _ (List.mem_cons_self _ _))).elim
  · obtain ⟨d, hd, hfold⟩ :=
      (PiModelDeltaIotaAudit.approxDI_foldApps_iff E ρ (.const r ls) pre (.spine r' args')).mp hf
    rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv hm hrec hd with
      rfl | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, rfl⟩
    · exact CptI.noConfusion (PiModelDeltaIotaAudit.foldAppCpt_bot_inv hfold)
    · have hm_eq : w.recMember = m := by
        have hrecW := w.hrec
        rw [hr, hm] at hrecW
        exact Option.some.inj hrecW.symm
      have hpre_len : us_pre.length = pre.length := by
        have hnmin := w.hnmin
        rw [hm_eq] at hnmin
        have hpreW := w.hpre
        omega
      rw [curryStep_append] at hfold
      rcases (PiModelDeltaIotaAudit.foldAppCpt_curryStep_iff hpre_len).mp hfold with
        hbot | ⟨_, heq⟩
      · exact CptI.noConfusion hbot
      · simp only [PiModelDeltaIotaAudit.curryStep] at heq
        exact CptI.noConfusion heq

/-- Specialization of `approxDI_recursor_major_noSpine_eq_bot` to an assumption variable major
    `.bvar i` (`lookupValue Γ i = none`) in `ctxEnvDI E Γ`. -/
theorem approxDI_recursor_bvar_major_eq_bot {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    {ls : List Level} {pre : List (Expr Nat)} (hlen : pre.length + 1 = piCount m.mtype)
    {i : Nat} (hnone : lookupValue Γ i = none) {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
      (.app (foldApps (.const r ls) pre) (.bvar i)) c) :
    c = .bot :=
  approxDI_recursor_major_noSpine_eq_bot hm hrec hlen
    (fun _ _ hsp => nomatch approxDI_ctxEnvDI_bvar_of_lookupValue_none hnone hsp) h

/-- Under `EnvWfT E`, any recursor application `.app (foldApps (.const r ls) pre) (.bvar i)` at full
    pre-major length `pre.length + 1 = piCount m.mtype` with an assumption variable major
    `lookupValue Γ i = none` takes **no** `WhStepRecCtx E Γ` step. -/
theorem whStepRecCtx_recursor_bvar_major_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (ls : List Level) (pre : List (Expr Nat)) (hlen : pre.length + 1 = piCount m.mtype)
    {i : Nat} (hnone : lookupValue Γ i = none) {e : Expr Nat}
    (hs : WhStepRecCtx E Γ (.app (foldApps (.const r ls) pre) (.bvar i)) e) : False := by
  generalize ha : Expr.app (foldApps (.const r ls) pre) (.bvar i) = a₀ at hs
  cases hs with
  | beta =>
      injection ha with hlam _
      exact F8EtaK.foldApps_const_ne_lam_any hlam
  | zeta => nomatch ha
  | zetaLocal => nomatch ha
  | delta => nomatch ha
  | iota hI =>
      rw [← ha] at hI
      obtain ⟨c, lsC, hhead⟩ := derivedIotaU_major_headOf_const hI
      exact Expr.noConfusion hhead
  | lit => nomatch ha
  | appHead hf =>
      injection ha with hfEq _
      subst hfEq
      exact whStepRecCtx_recursor_prefix_false hW hm hrec ls pre (Nat.le_of_eq hlen) hf
  | recMajor _ _ _ hmaj =>
      injection ha with _ hmajEq
      rw [← hmajEq] at hmaj
      exact whStepRecCtx_bvar_of_lookupValue_none_false hnone hmaj

theorem whNormalRecCtx_recursor_bvar_major {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (ls : List Level) (pre : List (Expr Nat)) (hlen : pre.length + 1 = piCount m.mtype)
    {i : Nat} (hnone : lookupValue Γ i = none) :
    WhNormalRecCtx E Γ (.app (foldApps (.const r ls) pre) (.bvar i)) :=
  fun _ hs => whStepRecCtx_recursor_bvar_major_false hW hm hrec ls pre hlen hnone hs

theorem whRedRecCtx_recursor_bvar_major_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    {ls : List Level} {pre : List (Expr Nat)} (hlen : pre.length + 1 = piCount m.mtype)
    {i : Nat} (hnone : lookupValue Γ i = none) {X : Expr Nat}
    (h : WhRedRecCtx E Γ (.app (foldApps (.const r ls) pre) (.bvar i)) X) :
    X = .app (foldApps (.const r ls) pre) (.bvar i) := by
  cases h with
  | refl => rfl
  | step hs _ =>
      exact (whStepRecCtx_recursor_bvar_major_false hW hm hrec ls pre hlen hnone hs).elim

/-- **Wall `W-K-AND` in Admitted `andEnvU` (`whStepRecCtx_mixAndRedex_false`, `approxDI_mixAndRedex_eq_bot`):**
    In `andEnvU` at `mixAndCtx = [h : And a b, y : b, x : a, b : Prop, a : Prop]`, the fieldful
    recursor application `mixAndRedex = And.rec a b (λ _, Sort 1) (λ x y, Sort 0 → Sort 0) h` is
    convertible (`mixAnd_conv`) to `mixPi = Sort 0 → Sort 0`, yet:
    1. `mixAndRedex` is `WhNormalRecCtx` (`whStepRecCtx_mixAndRedex_false`) — and unlike `trueVar*`,
       `HeadStepT` also refuses `mixAndRedex` (`mixAnd_headStepT_none`) because `And.intro` has 2
       fields!
    2. `ApproxDI andEnvU (ctxEnvDI andEnvU mixAndCtx) mixAndRedex c` holds only for `c = .bot`
       (`approxDI_mixAndRedex_eq_bot`), refuting `SemEqDI`, `LRTypeFamINR`, `LRTypeFamINBiR`,
       `LRTermFamINDR`, `FundamentalLRFamINBotR`, and `FundamentalTermFamINDBotR` in `andEnvU`. -/
theorem whStepRecCtx_mixAndRedex_false {e : Expr Nat}
    (hs : WhStepRecCtx andEnvU mixAndCtx mixAndRedex e) : False :=
  whStepRecCtx_recursor_bvar_major_false (Γ := mixAndCtx) andEnvUWfT (r := 2) (m := andRecMemberU)
    rfl rfl [.succ (.succ .zero)] mixAndSpine rfl (i := 0) rfl hs

theorem whNormalRecCtx_mixAndRedex : WhNormalRecCtx andEnvU mixAndCtx mixAndRedex :=
  fun _ hs => whStepRecCtx_mixAndRedex_false hs

theorem whRedRecCtx_mixAndRedex_eq {X : Expr Nat}
    (h : WhRedRecCtx andEnvU mixAndCtx mixAndRedex X) : X = mixAndRedex :=
  whRedRecCtx_recursor_bvar_major_eq (Γ := mixAndCtx) andEnvUWfT (r := 2) (m := andRecMemberU)
    (ls := [.succ (.succ .zero)]) (pre := mixAndSpine) rfl rfl rfl (i := 0) rfl h

theorem approxDI_mixAndRedex_eq_bot {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI andEnvU (ctxEnvDI andEnvU mixAndCtx) mixAndRedex c) :
    c = .bot :=
  approxDI_recursor_bvar_major_eq_bot (E := andEnvU) (Γ := mixAndCtx) (r := 2) (m := andRecMemberU)
    (ls := [.succ (.succ .zero)]) (pre := mixAndSpine) rfl rfl rfl (i := 0) rfl h

theorem not_approxDI_mixAndRedex_pi :
    ¬ PiModelDeltaIotaAudit.ApproxDI andEnvU (ctxEnvDI andEnvU mixAndCtx) mixAndRedex (.pi .bot []) :=
  fun h => nomatch approxDI_mixAndRedex_eq_bot h

theorem not_semEqDI_mixAnd :
    ¬ PiModelDeltaIotaAudit.SemEqDI andEnvU (ctxEnvDI andEnvU mixAndCtx) mixPi mixAndRedex :=
  fun h => not_approxDI_mixAndRedex_pi
    ((h (.pi .bot [])).mp (PiModelDeltaIotaAudit.approxDI_pi_bot_nil andEnvU _ (.sort .zero) (.sort .zero)))

theorem not_lrTypeFamINR_mixAnd_right (n : Nat) (A : Expr Nat) :
    ¬ LRTypeFamINR andEnvU n mixAndCtx A mixAndRedex (.pi .bot []) := by
  intro h
  cases h with
  | pi _ hred' _ _ _ _ _ => exact nomatch whRedRecCtx_mixAndRedex_eq hred'

theorem not_lrTypeFamINR_mixAnd_left (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeFamINR andEnvU n mixAndCtx mixAndRedex A' (.pi .bot []) := by
  intro h
  cases h with
  | pi hred _ _ _ _ _ _ => exact nomatch whRedRecCtx_mixAndRedex_eq hred

theorem not_lrTypeFamINBiR_mixAnd (n : Nat) :
    ¬ LRTypeFamINBiR andEnvU n mixAndCtx mixPi mixAndRedex :=
  fun H => not_lrTypeFamINR_mixAnd_right n mixPi
    (H (.pi .bot []) (botFamCpt_pi_bot_nil andEnvU)
      (Or.inl (PiModelDeltaIotaAudit.approxDI_pi_bot_nil andEnvU (ctxEnvDI andEnvU mixAndCtx)
        (.sort .zero) (.sort .zero))))

theorem not_lrTermFamINDR_mixAnd (n : Nat) (u : Level) :
    ¬ LRTermFamINDR andEnvU n mixAndCtx mixPi mixAndRedex (.sort u) (.pi .bot []) :=
  fun h => not_lrTypeFamINR_mixAnd_right n mixPi
    (lrTypeFamINR_of_lrTermFamINDR_sort (.pi .bot []) h)

/-- **Refutation of §13's `FundamentalLRFamINBotR` and `FundamentalTermFamINDBotR` in Admitted `andEnvU` (`W-K-AND`):** -/
theorem not_fundamentalLRFamINBotR_andEnvU :
    ¬ FundamentalLRFamINBotR andEnvU 0 := by
  intro F
  rcases mixAnd_conv with ⟨hc⟩
  have hPi : HasTyT andEnvU 0 mixAndCtx mixPi (.sort (.imax (.succ .zero) (.succ .zero))) :=
    .pi _ _ _ _ _ (.sort _ .zero) (.sort _ .zero)
  exact not_lrTypeFamINR_mixAnd_right 0 mixPi
    (F Rcic.Domain.Model.PiInversion.mixAndCtx_wf hPi (.of _ _ _ _ (.symm _ _ _ _ hc))
      (.pi .bot []) (botFamCpt_pi_bot_nil andEnvU)
      (PiModelDeltaIotaAudit.approxDI_pi_bot_nil andEnvU (ctxEnvDI andEnvU mixAndCtx)
        (.sort .zero) (.sort .zero)))

theorem not_fundamentalTermFamINDBotR_andEnvU :
    ¬ FundamentalTermFamINDBotR andEnvU 0 :=
  fun F => not_fundamentalLRFamINBotR_andEnvU
    (fundamentalLRFamINBotR_of_fundamentalTermFamINDBotR andEnvUWfT F)

/-- **Positive Resolution of `W-K-AND` in §14's `WhRedRecK`, `ApproxDIK`, `LRTypeFamINRK`, and `LRTermFamINDRK`:**
    Because `WhStepRecK.pmajor` allows **any** well-typed canonical constructor major `w.ctorMajor`
    (with arbitrary fields `w.fields`), `mixAndRedex` reduces in 3 `WhStepRecK` steps to `mixPi`
    (`whRedRecK_mixAndRedex`):
    1. `pmajor` at `mixAndW` (with `mixAndMkApp = And.intro a b x y`) steps `mixAndRedex` to
       `mixAndRhs = (λ x y, Sort 0 → Sort 0) x y`;
    2. `appHead (recCtx (beta …))` steps `mixAndRhs` to `(λ y, Sort 0 → Sort 0) y`;
    3. `recCtx (beta …)` steps `(λ y, Sort 0 → Sort 0) y` to `mixPi = Sort 0 → Sort 0`. -/
theorem whRedRecK_mixAndRedex :
    WhRedRecK andEnvU 0 mixAndCtx mixAndRedex mixPi := by
  have hs1 : WhStepRecK andEnvU 0 mixAndCtx mixAndRedex mixAndRhs :=
    .pmajor (.ofU mixAndW) ⟨mixAndFamTy⟩ ⟨mixAndMkTy⟩ ⟨mixTyH⟩
  have hs2 : WhStepRecK andEnvU 0 mixAndCtx mixAndRhs (.app (.lam (.bvar 3) mixPi) (.bvar 1)) :=
    .appHead (.recCtx (.beta (.bvar 4) (.lam (.bvar 4) mixPi) (.bvar 2)))
  have hs3 : WhStepRecK andEnvU 0 mixAndCtx (.app (.lam (.bvar 3) mixPi) (.bvar 1)) mixPi :=
    .recCtx (.beta (.bvar 3) mixPi (.bvar 1))
  exact .step hs1 (.step hs2 (.step hs3 (.refl mixPi)))

theorem approxDIK_mixAndRedex :
    ApproxDIK andEnvU 0 mixAndCtx mixAndRedex (.pi .bot []) :=
  approxDIK_of_whRedRecK whRedRecK_mixAndRedex
    (approxDIK_pi_bot_nil andEnvU 0 mixAndCtx (.sort .zero) (.sort .zero))

/-- Diagonal `LRTypeFamINBiDI` for `mixPi = Π (_ : Sort 0), Sort 0` in any well-formed context `Γ`. -/
theorem lrTypeFamINBiDI_mixPi_ctx (E : ResolvedEnv) (n : Nat) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    LRTypeFamINBiDI E n Γ mixPi mixPi :=
