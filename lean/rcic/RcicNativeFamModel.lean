theorem approxDIKCanon_pmajorCanon_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) (w : IotaWitness E) (i : Nat) (margs : List (Expr Nat))
    (hprop : piBody w.famMember.mtype = .sort .zero)
    (hidx : w.ctorIdx = 0)
    (hflds : w.fields = List.replicate w.fields.length famBotClosedExpr)
    (hnone : lookupValue Γ i = none) (c : CptI) :
    ApproxDIKCanon E Γ
      (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) c ↔
      ApproxDIKCanon E Γ (iotaRhsOf w) c :=
  whStepRecKCanon_approxDIKCanon_iff_of_envWfT hW
    (.pmajorCanon w i margs hprop hidx hflds hnone) c

/-- **Forward `WhRedRecKCanon` Reduction for `LRTypeFamINRKCanon` Across All Compacts `c : CptI`
    (`lrTypeFamINRKCanon_reduce`):**
    Holds under `EnvWfT E` **alone** (because every constructor of `LRTypeFamINRKCanon` targets a
    `WhNormalRecKCanon` normal form)! -/
theorem lrTypeFamINRKCanon_reduce {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat} {c : CptI}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B')
    (h : LRTypeFamINRKCanon E n Γ A A' c) : LRTypeFamINRKCanon E n Γ B B' c := by
  cases h with
  | bot => exact .bot Γ B B'
  | sort h₁ h₂ =>
      exact .sort
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB h₁ (whNormalRecKCanon_sort _))
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB' h₂ (whNormalRecKCanon_sort _))
  | pi h₁ h₂ hΓ₁ hdom hcod ra rf =>
      exact .pi
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB h₁ (whNormalRecKCanon_pi _ _))
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB' h₂ (whNormalRecKCanon_pi _ _))
        hΓ₁ hdom hcod ra rf
  | famSpine hm hind h₁ h₂ hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB h₁ (whNormalRecKCanon_famApp hW hm hind _ _))
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB' h₂ (whNormalRecKCanon_famApp hW hm hind _ _))
        hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h₁ h₂ hn hn' hc =>
      exact .otherSpine hnot
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB h₁ hn)
        (whRedRecKCanon_of_whRedRecKCanon_normal hW hB' h₂ hn')
        hn hn' hc

/-- **Exact Two-Way `WhRedRecKCanon` Invariance (`↔`) for `LRTypeFamINRKCanon` Across All Compacts
    `c : CptI` (`lrTypeFamINRKCanon_whRedRecKCanon_iff`):**
    Holds under `EnvWfT E` **alone**! -/
theorem lrTypeFamINRKCanon_whRedRecKCanon_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B') (c : CptI) :
    LRTypeFamINRKCanon E n Γ A A' c ↔ LRTypeFamINRKCanon E n Γ B B' c :=
  ⟨lrTypeFamINRKCanon_reduce hW hB hB',
   lrTypeFamINRKCanon_expand hB hB'⟩

theorem lrTypeFamINBiRKCanon_reduce {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B')
    (h : LRTypeFamINBiRKCanon E n Γ A A') : LRTypeFamINBiRKCanon E n Γ B B' := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hB c).mpr hL)
    · exact Or.inr ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hB' c).mpr hR)
  exact lrTypeFamINRKCanon_reduce hW hB hB' (h c hc happrox')

theorem lrTypeFamINBiRKCanon_whRedRecKCanon_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B') :
    LRTypeFamINBiRKCanon E n Γ A A' ↔ LRTypeFamINBiRKCanon E n Γ B B' :=
  ⟨lrTypeFamINBiRKCanon_reduce hW hB hB',
   lrTypeFamINBiRKCanon_expand hW hB hB'⟩

theorem lrTypeFamINBiProbeRKCanon_reduce {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B')
    (h : LRTypeFamINBiProbeRKCanon E n Γ A A') : LRTypeFamINBiProbeRKCanon E n Γ B B' := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hB c).mpr hL)
    · exact Or.inr ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hB' c).mpr hR)
  exact lrTypeFamINRKCanon_reduce hW hB hB' (h c hc happrox')

theorem lrTypeFamINBiProbeRKCanon_whRedRecKCanon_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B A' B' : Expr Nat}
    (hB : WhRedRecKCanon E Γ A B) (hB' : WhRedRecKCanon E Γ A' B') :
    LRTypeFamINBiProbeRKCanon E n Γ A A' ↔ LRTypeFamINBiProbeRKCanon E n Γ B B' :=
  ⟨lrTypeFamINBiProbeRKCanon_reduce hW hB hB',
   lrTypeFamINBiProbeRKCanon_expand hW hB hB'⟩

/-- Forward `WhRedRecKCanon` reduction on `M, M'` for `LRTermFamINDRKCanon` at any non-`.lam`
    compact `u` (`∀ g, u ≠ .lam g`) under `EnvWfT E` alone. -/
theorem lrTermFamINDRKCanon_reduce_of_ne_lam {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {M N M' N' A : Expr Nat}
    (hN : WhRedRecKCanon E Γ M N) (hN' : WhRedRecKCanon E Γ M' N') :
    ∀ (u : CptI), (∀ g, u ≠ .lam g) →
      LRTermFamINDRKCanon E n Γ M M' A u → LRTermFamINDRKCanon E n Γ N N' A u
  | .bot, _, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, _, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamINRKCanon_reduce hW hN hN' h2⟩
  | .pi a f, _, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamINRKCanon_reduce hW hN hN' h2⟩
  | .spine r args, _, h => by
      rw [lrTermFamINDRKCanon_spine_iff] at h ⊢
      rcases h with ⟨h1, h2⟩ | hprop | ⟨h1, Y, Y', hY, hY', hn, hn', hc⟩
      · exact Or.inl ⟨h1, lrTypeFamINRKCanon_reduce hW hN hN' h2⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨h1, Y, Y',
          whRedRecKCanon_of_whRedRecKCanon_normal hW hN hY hn,
          whRedRecKCanon_of_whRedRecKCanon_normal hW hN' hY' hn',
          hn, hn', hc⟩)
  | .lam g, hne, _ => (hne g rfl).elim

theorem lrTermFamINDRKCanon_reduce_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {M N M' N' A : Expr Nat}
    (hN : WhRedRecKCanon E Γ M N) (hN' : WhRedRecKCanon E Γ M' N')
    {u : CptI} (hu : BotFamCpt E u)
    (h : LRTermFamINDRKCanon E n Γ M M' A u) :
    LRTermFamINDRKCanon E n Γ N N' A u :=
  lrTermFamINDRKCanon_reduce_of_ne_lam hW hN hN' u
    (fun g hEq => by subst hEq; exact not_botFamCpt_lam E g hu) h

theorem lrTermFamINDRKCanon_whRedRecKCanon_botFamCpt_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {M N M' N' A : Expr Nat}
    (hN : WhRedRecKCanon E Γ M N) (hN' : WhRedRecKCanon E Γ M' N')
    {u : CptI} (hu : BotFamCpt E u) :
    LRTermFamINDRKCanon E n Γ M M' A u ↔ LRTermFamINDRKCanon E n Γ N N' A u :=
  ⟨lrTermFamINDRKCanon_reduce_botFamCpt hW hN hN' hu,
   lrTermFamINDRKCanon_expand hN hN' u⟩


/-! #### Part B — Telescope Instantiation (`instTelescope`, `instDomsPrefix`), `ConvArgsT` Spine Congruence (`convT_foldApps_of_convArgsT`, `convT_famApp_of_convArgsT`), and Step-by-Step `ConvT.app` Family-Spine Transitions -/

/-- Step-by-step telescope instantiation of `T` along an argument list `xs : List (Expr Nat)`. -/
def instTelescope (T : Expr Nat) : List (Expr Nat) → Expr Nat
  | [] => T
  | x :: xs =>
      match T with
      | .pi _ B => instTelescope (instantiate0 x B) xs
      | _ => T

theorem instTelescope_nil (T : Expr Nat) : instTelescope T [] = T := rfl

theorem instTelescope_cons_pi (A B x : Expr Nat) (xs : List (Expr Nat)) :
    instTelescope (.pi A B) (x :: xs) = instTelescope (instantiate0 x B) xs := rfl

theorem instTelescope_of_not_pi {T : Expr Nat} (h : ∀ A B, T ≠ .pi A B) :
    ∀ (xs : List (Expr Nat)), instTelescope T xs = T
  | [] => rfl
  | _ :: _ => by
      cases T with
      | pi A B => exact (h A B rfl).elim
      | _ => rfl

theorem instTelescope_append (T : Expr Nat) :
    ∀ (xs ys : List (Expr Nat)),
      instTelescope T (xs ++ ys) = instTelescope (instTelescope T xs) ys
  | [], _ => rfl
  | x :: xs, ys => by
      cases T with
      | pi A B =>
          exact instTelescope_append (instantiate0 x B) xs ys
      | bvar _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | sort _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | const _ _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | app _ _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | lam _ _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | letE _ _ _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm
      | lit _ => exact (instTelescope_of_not_pi (fun _ _ h => by cases h) ys).symm

theorem instTelescope_snoc (T : Expr Nat) (xs : List (Expr Nat)) (x : Expr Nat) :
    instTelescope T (xs ++ [x]) = instTelescope (instTelescope T xs) [x] :=
  instTelescope_append T xs [x]

theorem instTelescope_snoc_of_pi {T A B : Expr Nat} {xs : List (Expr Nat)}
    (h : instTelescope T xs = .pi A B) (x : Expr Nat) :
    instTelescope T (xs ++ [x]) = instantiate0 x B := by
  rw [instTelescope_snoc, h, instTelescope_cons_pi, instTelescope_nil]

/-- Remaining domain list after instantiating a domain telescope `doms` along a prefix `xs`. -/
def instDomsPrefix : List (Expr Nat) → List (Expr Nat) → List (Expr Nat)
  | [], doms => doms
  | x :: xs, doms =>
      match doms with
      | [] => []
      | _ :: ds => instDomsPrefix xs (instDomsT 0 x ds)

theorem length_instDomsPrefix :
    ∀ (xs doms : List (Expr Nat)),
      (instDomsPrefix xs doms).length = doms.length - xs.length
  | [], doms => (Nat.sub_zero doms.length).symm
  | _ :: _, [] => by simp [instDomsPrefix]
  | x :: xs, _ :: doms => by
      simp only [instDomsPrefix, length_instDomsPrefix xs (instDomsT 0 x doms),
        length_instDomsT, List.length_cons, Nat.succ_sub_succ_eq_sub]

theorem instTelescope_policyPi_sort (u : Level) :
    ∀ (xs doms : List (Expr Nat)),
      xs.length ≤ doms.length →
      instTelescope (policyPi doms (.sort u)) xs =
        policyPi (instDomsPrefix xs doms) (.sort u)
  | [], _, _ => rfl
  | _ :: _, [], h => nomatch h
  | x :: xs, d :: doms, h => by
      have hle : xs.length ≤ (instDomsT 0 x doms).length := by
        rw [length_instDomsT]
        exact Nat.le_of_succ_le_succ h
      simp only [policyPi, instTelescope_cons_pi, instantiate0,
        instantiate_policyPi, instantiate, instDomsPrefix]
      exact instTelescope_policyPi_sort u xs (instDomsT 0 x doms) hle

theorem instTelescope_policyPi_sort_eq_of_length_eq (u : Level)
    {xs doms : List (Expr Nat)} (hlen : xs.length = doms.length) :
    instTelescope (policyPi doms (.sort u)) xs = .sort u := by
  rw [instTelescope_policyPi_sort u xs doms (Nat.le_of_eq hlen)]
  have hnil : instDomsPrefix xs doms = [] :=
    List.eq_nil_of_length_eq_zero (by rw [length_instDomsPrefix, hlen, Nat.sub_self])
  rw [hnil, policyPi]

theorem instTelescope_policyPi_sort_eq_pi_of_lt (u : Level)
    {xs doms : List (Expr Nat)} (hlt : xs.length < doms.length) :
    ∃ D B, instTelescope (policyPi doms (.sort u)) xs = .pi D B := by
  rw [instTelescope_policyPi_sort u xs doms (Nat.le_of_lt hlt)]
  have hpos : 0 < (instDomsPrefix xs doms).length := by
    rw [length_instDomsPrefix]; omega
  cases h : instDomsPrefix xs doms with
  | nil => rw [h] at hpos; exact (Nat.lt_irrefl 0 hpos).elim
  | cons D ds => exact ⟨D, policyPi ds (.sort u), rfl⟩

theorem instTelescope_instMtype_eq_sort {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) {xs : List (Expr Nat)}
    (hlen : xs.length = (piDomsOf m.mtype).length) :
    instTelescope (instantiateLevels ls m.mtype) xs =
      .sort (instLevel ls (inductiveSortLevel hW hm hind)) := by
  rw [instMtype_policyPi_of_inductiveM hW hm hind ls]
  exact instTelescope_policyPi_sort_eq_of_length_eq _ (by rw [List.length_map, hlen])

theorem instTelescope_instMtype_eq_pi_of_lt {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) {xs : List (Expr Nat)}
    (hlt : xs.length < (piDomsOf m.mtype).length) :
    ∃ D B, instTelescope (instantiateLevels ls m.mtype) xs = .pi D B := by
  rw [instMtype_policyPi_of_inductiveM hW hm hind ls]
  exact instTelescope_policyPi_sort_eq_pi_of_lt _ (by rw [List.length_map]; exact hlt)

theorem convArgsT_length_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') : xs.length = xs'.length :=
  NativeFamilyProjection.convArgs_length h

/-- Append a single converted argument pair `(a, a')` to the end of a `ConvArgsT` spine. -/
theorem convArgsT_snoc {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') :
    ∀ {A B a a' : Expr Nat},
      instTelescope T xs = .pi A B →
      ConvT E n Γ a a' A →
      ConvArgsT E n Γ T (xs ++ [a]) (xs' ++ [a']) := by
  induction h with
  | nil T =>
      intro A B a a' hpi ha
      rw [instTelescope_nil] at hpi
      subst hpi
      exact .cons A B a a' [] [] ⟨ha⟩ (.nil (instantiate0 a B))
  | cons A₀ B₀ x x' xs xs' hx _ ih =>
      intro A B a a' hpi ha
      exact .cons A₀ B₀ x x' (xs ++ [a]) (xs' ++ [a']) hx (ih hpi ha)

/-- Construct `Nonempty (ConvT E n Γ (foldApps f xs) (foldApps f' xs') (instTelescope T xs))` from
    `ConvArgsT E n Γ T xs xs'` and `ConvT E n Γ f f' T` by iterating `ConvT.app`. -/
theorem convT_foldApps_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') :
    ∀ {f f' : Expr Nat}, ConvT E n Γ f f' T →
      Nonempty (ConvT E n Γ (foldApps f xs) (foldApps f' xs') (instTelescope T xs)) := by
  induction h with
  | nil _ =>
      intro f f' hf
      exact ⟨hf⟩
  | cons A B x x' _ _ hx _ ih =>
      intro f f' hf
      obtain ⟨hx⟩ := hx
      exact ih (.app Γ f f' x x' A B hf hx)

/-- Construct `Nonempty (HasTyT E n Γ (foldApps f xs) (instTelescope T xs))` from
    `ConvArgsT E n Γ T xs xs'` and `HasTyT E n Γ f T`. -/
theorem hasTyT_foldApps_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (hargs : ConvArgsT E n Γ T xs xs')
    {f : Expr Nat} (hf : HasTyT E n Γ f T) :
    Nonempty (HasTyT E n Γ (foldApps f xs) (instTelescope T xs)) := by
  obtain ⟨hc⟩ := convT_foldApps_of_convArgsT hargs (.refl Γ f T hf)
  exact ⟨(convEnds hW hΓ hc).1⟩

/-- Construct `Nonempty (ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.sort ...))`
    for any saturated admitted `.inductiveM` family spine from `eqNList ls ls'` and `ConvArgsT`. -/
theorem convT_famApp_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level}
    (hlen : ls.length = m.arity) (hwf : levelsBounded n ls = true)
    (hwf' : levelsBounded n ls' = true) (heqN : eqNList ls ls')
    {xs xs' : List (Expr Nat)} (hxs : xs.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    Nonempty (ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')
      (.sort (instLevel ls (inductiveSortLevel hW hm hind)))) := by
  obtain ⟨hc⟩ := convT_foldApps_of_convArgsT hargs
    (.consts Γ r ls ls' m hm hlen hwf hwf' heqN)
  rw [instTelescope_instMtype_eq_sort hW hm hind ls hxs] at hc
  exact ⟨hc⟩

/-- Construct `Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))`
    for any saturated admitted `.inductiveM` family spine from `eqNList ls ls'` and `ConvArgsT`. -/
theorem tyConvT_famApp_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level}
    (hlen : ls.length = m.arity) (hwf : levelsBounded n ls = true)
    (hwf' : levelsBounded n ls' = true) (heqN : eqNList ls ls')
    {xs xs' : List (Expr Nat)} (hxs : xs.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) := by
  obtain ⟨hc⟩ := convT_famApp_of_convArgsT hW hm hind hlen hwf hwf' heqN hxs hargs
  exact ⟨.of Γ _ _ _ hc⟩

/-- Bidirectional `LRTypeFamINBiProbeRKCanon` characterization on syntactic Π-types `.pi A₁ B₁` and
    `.pi A₂ B₂`. -/
theorem lrTypeFamINBiProbeRKCanon_pi_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (A₁ B₁ A₂ B₂ : Expr Nat) :
    LRTypeFamINBiProbeRKCanon E n Γ (.pi A₁ B₁) (.pi A₂ B₂) ↔
      Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
      Nonempty (TyConvT E n Γ A₁ A₂) ∧
      Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  constructor
  · intro h
    have hLR := h (.pi .bot []) .pi_bot_nil (Or.inl (approxDIKCanon_pi_bot_nil E Γ A₁ B₁))
    cases hLR with
    | pi h₁ h₂ hΓ₁ hdom hcod _ _ =>
        have e₁ := whRedRecKCanon_pi_eq h₁
        have e₂ := whRedRecKCanon_pi_eq h₂
        injection e₁ with eA₁ eB₁
        injection e₂ with eA₂ eB₂
        subst eA₁; subst eB₁; subst eA₂; subst eB₂
        exact ⟨⟨hΓ₁⟩, ⟨hdom⟩, ⟨hcod⟩⟩
  · rintro ⟨⟨hΓ₁⟩, ⟨hdom⟩, ⟨hcod⟩⟩ c hcpt happrox
    cases hcpt with
    | bot => exact .bot _ _ _
    | sort =>
        rcases happrox with hL | hR
        · rcases PiModelDeltaIotaAudit.approxDI_pi_inv
            ((approxDIKCanon_pi_iff E Γ A₁ B₁ .sort).mp hL) with hbot | ⟨_, _, heq, _, _⟩
          · exact CptI.noConfusion hbot
          · exact CptI.noConfusion heq
        · rcases PiModelDeltaIotaAudit.approxDI_pi_inv
            ((approxDIKCanon_pi_iff E Γ A₂ B₂ .sort).mp hR) with hbot | ⟨_, _, heq, _, _⟩
          · exact CptI.noConfusion hbot
          · exact CptI.noConfusion heq
    | pi_bot_nil =>
        exact .pi (.refl _) (.refl _) hΓ₁ hdom hcod (.bot _ _ _)
          (fun _ hs => (List.not_mem_nil _ hs).elim)
    | famSpine _ _ _ _ =>
        rcases happrox with hL | hR
        · rcases PiModelDeltaIotaAudit.approxDI_pi_inv
            ((approxDIKCanon_pi_iff E Γ A₁ B₁ _).mp hL) with hbot | ⟨_, _, heq, _, _⟩
          · exact CptI.noConfusion hbot
          · exact CptI.noConfusion heq
        · rcases PiModelDeltaIotaAudit.approxDI_pi_inv
            ((approxDIKCanon_pi_iff E Γ A₂ B₂ _).mp hR) with hbot | ⟨_, _, heq, _, _⟩
          · exact CptI.noConfusion hbot
          · exact CptI.noConfusion heq

/-- Bidirectional `LRTypeFamINBiProbeRKCanon` characterization on saturated admitted `.inductiveM`
    family spines `foldApps (.const r ls) xs` and `foldApps (.const r ls') xs'`. -/
theorem lrTypeFamINBiProbeRKCanon_famApp_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length) :
    LRTypeFamINBiProbeRKCanon E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') ↔
      eqNList ls ls' ∧ ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  constructor
  · intro h
    have hcA := approxDIKCanon_famApp_botVecI_of_inductiveM hW Γ hm hind ls xs
    have hLR := h (.spine r (botVecI xs)) (famProbeCpt_famSpine_botVecI hm hind hlen) (Or.inl hcA)
    have hcomp := lrTypeFamINRKCanon_famApp_components hW hm hind hLR
    exact ⟨hcomp.1, hcomp.2.2⟩
  · rintro ⟨heqN, hargs⟩ c _ happrox
    rcases happrox with hL | hR
    · have hDI : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const r ls) xs) c :=
        (approxDIKCanon_famApp_iff hW Γ hm hind ls xs c).mp hL
      rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls
        (rigidConst_of_inductiveM hW hm hind) xs c).mp hDI with rfl | ⟨cs, _, rfl⟩
      · exact .bot _ _ _
      · exact .famSpine hm hind (.refl _) (.refl _) hty hty' hc heqN hlen hlen' hargs
    · have hDI : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const r ls') xs') c :=
        (approxDIKCanon_famApp_iff hW Γ hm hind ls' xs' c).mp hR
      rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls'
        (rigidConst_of_inductiveM hW hm hind) xs' c).mp hDI with rfl | ⟨cs, _, rfl⟩
      · exact .bot _ _ _
      · exact .famSpine hm hind (.refl _) (.refl _) hty hty' hc heqN hlen hlen' hargs

/-- **Step-by-Step `ConvT.app` Family-Spine Transition at a Remaining Π-Type (`fundConvFamINDRKCanon_famSpine_step_app_partial`):**
    Extending partial family spines `foldApps (.const r₁ ls₁) xs₁` and `foldApps (.const r₂ ls₂) xs₂`
    by one argument `a₁, a₂` when `instantiate0 a₁ B = .pi A' B'` preserves `LRTermFamINDRKCanon`
    over `ApproxDIKCanon E Γ`. -/
theorem fundConvFamINDRKCanon_famSpine_step_app_partial {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r₁ r₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members r₁ = some m₁) (hind₁ : m₁.mclass = .inductiveM)
    (hm₂ : E.members r₂ = some m₂) (hind₂ : m₂.mclass = .inductiveM)
    {ls₁ ls₂ : List Level} {xs₁ xs₂ : List (Expr Nat)}
    {A B A' B' a₁ a₂ : Expr Nat}
    (hf : ConvT E n Γ (foldApps (.const r₁ ls₁) xs₁) (foldApps (.const r₂ ls₂) xs₂) (.pi A B))
    (ha : ConvT E n Γ a₁ a₂ A)
    (hcod : instantiate0 a₁ B = .pi A' B') :
    ∀ u, ApproxDIKCanon E Γ (.app (foldApps (.const r₁ ls₁) xs₁) a₁) u →
      LRTermFamINDRKCanon E n Γ
        (.app (foldApps (.const r₁ ls₁) xs₁) a₁)
        (.app (foldApps (.const r₂ ls₂) xs₂) a₂)
        (instantiate0 a₁ B) u := by
  have hc : ConvT E n Γ (foldApps (.const r₁ ls₁) (xs₁ ++ [a₁]))
      (foldApps (.const r₂ ls₂) (xs₂ ++ [a₂])) (.pi A' B') := by
    rw [foldApps_snoc, foldApps_snoc, ← hcod]
    exact .app Γ _ _ a₁ a₂ A B hf ha
  rw [hcod]
  simpa only [foldApps_snoc] using
    fundConvFamINDRKCanon_famSpine_partial_at_pi hW hm₁ hind₁ hm₂ hind₂ hc

/-- **Step-by-Step `ConvT.app` Family-Spine Transition Reaching Saturation (`fundConvFamINDRKCanon_famSpine_step_app_saturated`):**
    Extending partial family spines `foldApps (.const r ls) xs` and `foldApps (.const r ls') xs'`
    of length `xs.length + 1 = (piDomsOf m.mtype).length` by `a, a'` with `ConvT E n Γ a a' A`
    yields `LRTermFamINDRKCanon` at `.sort w` over `ApproxDIKCanon E Γ`! -/
theorem fundConvFamINDRKCanon_famSpine_step_app_saturated {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    {A B a a' : Expr Nat} {w w' : Level}
    (heqN : eqNList ls ls')
    (hpre : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs')
    (hpi : instTelescope (instantiateLevels ls m.mtype) xs = .pi A B)
    (ha : ConvT E n Γ a a' A)
    (hlen : (xs ++ [a]).length = (piDomsOf m.mtype).length)
    (hty : HasTyT E n Γ (.app (foldApps (.const r ls) xs) a) (.sort w))
    (hty' : HasTyT E n Γ (.app (foldApps (.const r ls') xs') a') (.sort w'))
    (hc : TyConvT E n Γ (.app (foldApps (.const r ls) xs) a) (.app (foldApps (.const r ls') xs') a')) :
    ∀ u, ApproxDIKCanon E Γ (.app (foldApps (.const r ls) xs) a) u →
      LRTermFamINDRKCanon E n Γ
        (.app (foldApps (.const r ls) xs) a)
        (.app (foldApps (.const r ls') xs') a')
        (.sort w) u := by
  have hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) (xs ++ [a]) (xs' ++ [a']) :=
    convArgsT_snoc hpre hpi ha
  have hlen' : (xs' ++ [a']).length = (piDomsOf m.mtype).length :=
    (convArgsT_length_eq hargs).symm.trans hlen
  have hty₁ : HasTyT E n Γ (foldApps (.const r ls) (xs ++ [a])) (.sort w) := by
    rwa [foldApps_snoc]
  have hty₂ : HasTyT E n Γ (foldApps (.const r ls') (xs' ++ [a'])) (.sort w') := by
    rwa [foldApps_snoc]
  have hc₁ : TyConvT E n Γ (foldApps (.const r ls) (xs ++ [a])) (foldApps (.const r ls') (xs' ++ [a'])) := by
    rwa [foldApps_snoc, foldApps_snoc]
  simpa only [foldApps_snoc] using
    fundConvFamINDRKCanon_famSpine_of_convArgsT hW hm hind hty₁ hty₂ hc₁ heqN hlen hlen' hargs

/-- Bidirectional `LRTypeFamINBiProbeRKCanon` for the final `ConvT.app` step saturating an admitted
    `.inductiveM` family spine. -/
theorem lrTypeFamINBiProbeRKCanon_famSpine_step_app {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    {A B a a' : Expr Nat} {w w' : Level}
    (heqN : eqNList ls ls')
    (hpre : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs')
    (hpi : instTelescope (instantiateLevels ls m.mtype) xs = .pi A B)
    (ha : ConvT E n Γ a a' A)
    (hlen : (xs ++ [a]).length = (piDomsOf m.mtype).length)
    (hty : HasTyT E n Γ (.app (foldApps (.const r ls) xs) a) (.sort w))
    (hty' : HasTyT E n Γ (.app (foldApps (.const r ls') xs') a') (.sort w'))
    (hc : TyConvT E n Γ (.app (foldApps (.const r ls) xs) a) (.app (foldApps (.const r ls') xs') a')) :
    LRTypeFamINBiProbeRKCanon E n Γ
      (.app (foldApps (.const r ls) xs) a)
      (.app (foldApps (.const r ls') xs') a') := by
  have hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) (xs ++ [a]) (xs' ++ [a']) :=
    convArgsT_snoc hpre hpi ha
  have hlen' : (xs' ++ [a']).length = (piDomsOf m.mtype).length :=
    (convArgsT_length_eq hargs).symm.trans hlen
  have hty₁ : HasTyT E n Γ (foldApps (.const r ls) (xs ++ [a])) (.sort w) := by
    rwa [foldApps_snoc]
  have hty₂ : HasTyT E n Γ (foldApps (.const r ls') (xs' ++ [a'])) (.sort w') := by
    rwa [foldApps_snoc]
  have hc₁ : TyConvT E n Γ (foldApps (.const r ls) (xs ++ [a])) (foldApps (.const r ls') (xs' ++ [a'])) := by
    rwa [foldApps_snoc, foldApps_snoc]
  simpa only [foldApps_snoc] using
    (lrTypeFamINBiProbeRKCanon_famApp_iff hW hm hind hty₁ hty₂ hc₁ hlen hlen').mpr ⟨heqN, hargs⟩


/-! #### Part C — Two-Way `.letBinding` `ApproxDIKCanon` / `LRTypeFamINRKCanon` Equivalences and Unconditional `.letBinding` `ConvT.beta` Reduction -/

/-- Exact two-way equivalence between `ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) (.bvar 0) c`
    and `ApproxDI E (ctxEnvDI E Γ) w0 c`. -/
theorem approxDI_ctxEnvDI_bvar0_letBinding_iff (E : ResolvedEnv) (Γ : LCtx)
    (t w0 : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) (.bvar 0) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) w0 c := by
  simpa only [instantiate0, instantiate, if_pos (rfl : (0 : Nat) = 0)] using
    (approxDI_substLet0_ctxEnvDI_iff E Γ t w0 (.bvar 0) c).symm

/-- Exact two-way equivalence between `ApproxDIKCanon E (.letBinding t w0 :: Γ) (.bvar 0) c` and
    `ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 w0) c` under `EnvWfT E`. -/
theorem approxDIKCanon_bvar0_letBinding_iff {E : ResolvedEnv} (hW : EnvWfT E)
    (Γ : LCtx) (t w0 : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (.letBinding t w0 :: Γ) (.bvar 0) c ↔
      ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 w0) c :=
  approxDIKCanon_zetaLocal_iff hW
    (rfl : lookupValue (.letBinding t w0 :: Γ) 0 = some (lift 0 1 w0)) c

/-- **Exact Two-Way Weakening Equivalence for `ApproxDIKCanon` Across `.letBinding t w0 :: Γ`
    (`approxDIKCanon_lift0_one_letBinding_iff`):**
    Holds for **every** `w0 : Expr Nat` under `EnvClosed E` alone (combining `approxDIKCanon_lift0_one`
    with `approxDIKCanon_substLet0_of_envClosed` and `instantiate_lift_cancel`)! -/
theorem approxDIKCanon_lift0_one_letBinding_iff {E : ResolvedEnv} (hcl : EnvClosed E)
    (Γ : LCtx) (t w0 e : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 e) c ↔
      ApproxDIKCanon E Γ e c := by
  constructor
  · intro h
    have h0 := approxDIKCanon_substLet0_of_envClosed hcl h
    rwa [instantiate0, instantiate_lift_cancel 1 0 0 w0 (by omega) (by omega),
         Nat.sub_self, lift_zero] at h0
  · exact approxDIKCanon_lift0_one hcl (.letBinding t w0)

/-- Exact two-way equivalence between `ApproxDIKCanon E (.letBinding t w0 :: Γ) (.bvar 0) c` and
    `ApproxDIKCanon E Γ w0 c` under `EnvWfT E` alone! -/
theorem approxDIKCanon_bvar0_letBinding_iff_base {E : ResolvedEnv} (hW : EnvWfT E)
    (Γ : LCtx) (t w0 : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (.letBinding t w0 :: Γ) (.bvar 0) c ↔
      ApproxDIKCanon E Γ w0 c :=
  (approxDIKCanon_bvar0_letBinding_iff hW Γ t w0 c).trans
    (approxDIKCanon_lift0_one_letBinding_iff (envClosed_of_envWfT hW) Γ t w0 w0 c)

/-- **Exact Two-Way Weakening Equivalence for `LRTypeFamINRKCanon` Across `.letBinding t w0 :: Γ` on
    `BotFamCpt E` (`lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff`):**
    Holds for **every** `w0 : Expr Nat` under `EnvWfT E` alone! -/
theorem lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {t w0 : Expr Nat} {u : Level}
    (ht : HasTyT E n Γ t (.sort u)) (hw0 : HasTyT E n Γ w0 t)
    (A A' : Expr Nat) {c : CptI} (hc : BotFamCpt E c) :
    LRTypeFamINRKCanon E n (.letBinding t w0 :: Γ) (lift 0 1 A) (lift 0 1 A') c ↔
      LRTypeFamINRKCanon E n Γ A A' c := by
  constructor
  · intro h
    have h0 := lrTypeFamINRKCanon_substLet0_botFamCpt hW hΓ hw0 hc h
    rwa [instantiate0, instantiate_lift_cancel 1 0 0 w0 (by omega) (by omega),
         Nat.sub_self, lift_zero,
         instantiate0, instantiate_lift_cancel 1 0 0 w0 (by omega) (by omega),
         Nat.sub_self, lift_zero] at h0
  · exact lrTypeFamINRKCanon_weaken0_botFamCpt (envClosed_of_envWfT hW)
      (.letBinding Γ t u w0 hΓ ht hw0) hc

theorem lrTypeFamINBiRKCanon_weaken0_letBinding_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {t w0 : Expr Nat} {u : Level}
    (ht : HasTyT E n Γ t (.sort u)) (hw0 : HasTyT E n Γ w0 t)
    (A A' : Expr Nat) :
    LRTypeFamINBiRKCanon E n (.letBinding t w0 :: Γ) (lift 0 1 A) (lift 0 1 A') ↔
      LRTypeFamINBiRKCanon E n Γ A A' := by
  have hcl := envClosed_of_envWfT hW
  constructor
  · intro h c hc happrox
    have happrox' : ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 A) c ∨
        ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 A') c := by
      rcases happrox with hL | hR
      · exact Or.inl ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A c).mpr hL)
      · exact Or.inr ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A' c).mpr hR)
    exact (lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff hW hΓ ht hw0 A A' hc).mp
      (h c hc happrox')
  · intro h c hc happrox
    have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
      rcases happrox with hL | hR
      · exact Or.inl ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A c).mp hL)
      · exact Or.inr ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A' c).mp hR)
    exact (lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff hW hΓ ht hw0 A A' hc).mpr
      (h c hc happrox')

theorem lrTypeFamINBiProbeRKCanon_weaken0_letBinding_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {t w0 : Expr Nat} {u : Level}
    (ht : HasTyT E n Γ t (.sort u)) (hw0 : HasTyT E n Γ w0 t)
    (A A' : Expr Nat) :
    LRTypeFamINBiProbeRKCanon E n (.letBinding t w0 :: Γ) (lift 0 1 A) (lift 0 1 A') ↔
      LRTypeFamINBiProbeRKCanon E n Γ A A' := by
  have hcl := envClosed_of_envWfT hW
  constructor
  · intro h c hc happrox
    have happrox' : ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 A) c ∨
        ApproxDIKCanon E (.letBinding t w0 :: Γ) (lift 0 1 A') c := by
      rcases happrox with hL | hR
      · exact Or.inl ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A c).mpr hL)
      · exact Or.inr ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A' c).mpr hR)
    exact (lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff hW hΓ ht hw0 A A'
      (botFamCpt_of_famProbeCpt hc)).mp (h c hc happrox')
  · intro h c hc happrox
    have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
      rcases happrox with hL | hR
      · exact Or.inl ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A c).mp hL)
      · exact Or.inr ((approxDIKCanon_lift0_one_letBinding_iff hcl Γ t w0 A' c).mp hR)
    exact (lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff hW hΓ ht hw0 A A'
      (botFamCpt_of_famProbeCpt hc)).mpr (h c hc happrox')

/-- Exact two-way equivalence between `LRTypeFamINRKCanon E n (.letBinding t w0 :: Γ) (.bvar 0) (lift 0 1 w0') c`
    and `LRTypeFamINRKCanon E n Γ w0 w0' c` on `BotFamCpt E c` under `EnvWfT E` alone! -/
theorem lrTypeFamINRKCanon_bvar0_letBinding_botFamCpt_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {t w0 w0' : Expr Nat} {u : Level}
    (ht : HasTyT E n Γ t (.sort u)) (hw0 : HasTyT E n Γ w0 t)
    {c : CptI} (hc : BotFamCpt E c) :
    LRTypeFamINRKCanon E n (.letBinding t w0 :: Γ) (.bvar 0) (lift 0 1 w0') c ↔
      LRTypeFamINRKCanon E n Γ w0 w0' c :=
  (lrTypeFamINRKCanon_whRedRecKCanon_iff hW
    (.step (.zetaLocal (rfl : lookupValue (.letBinding t w0 :: Γ) 0 = some (lift 0 1 w0))) (.refl _))
    (.refl _) c).trans
    (lrTypeFamINRKCanon_weaken0_letBinding_botFamCpt_iff hW hΓ ht hw0 w0 w0' hc)

theorem lrTypeFamINBiProbeRKCanon_bvar0_letBinding_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {t w0 w0' : Expr Nat} {u : Level}
    (ht : HasTyT E n Γ t (.sort u)) (hw0 : HasTyT E n Γ w0 t) :
    LRTypeFamINBiProbeRKCanon E n (.letBinding t w0 :: Γ) (.bvar 0) (lift 0 1 w0') ↔
      LRTypeFamINBiProbeRKCanon E n Γ w0 w0' :=
  (lrTypeFamINBiProbeRKCanon_whRedRecKCanon_iff hW
    (.step (.zetaLocal (rfl : lookupValue (.letBinding t w0 :: Γ) 0 = some (lift 0 1 w0))) (.refl _))
    (.refl _)).trans
    (lrTypeFamINBiProbeRKCanon_weaken0_letBinding_iff hW hΓ ht hw0 w0 w0')

/-- **Unconditional `.letBinding` `ConvT.beta` Reduction for `LRTypeFamINRKCanon` on `BotFamCpt E`
    (`lrTypeFamINRKCanon_beta_of_letBinding_botFamCpt`):**
    Given `LRTypeFamINRKCanon E n (.letBinding A a :: Γ) b b' c` for any `a : Expr Nat` with
    `HasTyT E n Γ a A`, `lrTypeFamINRKCanon_substLet0_botFamCpt` + `WhStepRecKCanon.beta` produces
    `LRTypeFamINRKCanon E n Γ (.app (.lam A b) a) (instantiate0 a b') c`! -/
theorem lrTypeFamINRKCanon_beta_of_letBinding_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A a b b' : Expr Nat} (ha : HasTyT E n Γ a A)
    {c : CptI} (hc : BotFamCpt E c)
    (hb : LRTypeFamINRKCanon E n (.letBinding A a :: Γ) b b' c) :
    LRTypeFamINRKCanon E n Γ (.app (.lam A b) a) (instantiate0 a b') c :=
  lrTypeFamINRKCanon_expand (.step (.beta A b a) (.refl _)) (.refl _)
    (lrTypeFamINRKCanon_substLet0_botFamCpt hW hΓ ha hc hb)

/-- Unconditional `.letBinding` `ConvT.beta` reduction for `LRTypeFamINBiRKCanon` when `b` is related
    in `.letBinding A a :: Γ` across all `BotFamCpt E` compacts. -/
theorem lrTypeFamINBiRKCanon_beta_of_letBinding {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A a b b' : Expr Nat} (ha : HasTyT E n Γ a A)
    (hb : ∀ c, BotFamCpt E c →
      (ApproxDIKCanon E Γ (instantiate0 a b) c ∨ ApproxDIKCanon E Γ (instantiate0 a b') c) →
      LRTypeFamINRKCanon E n (.letBinding A a :: Γ) b b' c) :
    LRTypeFamINBiRKCanon E n Γ (.app (.lam A b) a) (instantiate0 a b') := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ (instantiate0 a b) c ∨ ApproxDIKCanon E Γ (instantiate0 a b') c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDIKCanon_beta_iff hW A b a c).mp hL)
    · exact Or.inr hR
  exact lrTypeFamINRKCanon_beta_of_letBinding_botFamCpt hW hΓ ha hc (hb c hc happrox')

theorem lrTypeFamINBiProbeRKCanon_beta_of_letBinding {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A a b b' : Expr Nat} (ha : HasTyT E n Γ a A)
    (hb : ∀ c, FamProbeCpt E c →
      (ApproxDIKCanon E Γ (instantiate0 a b) c ∨ ApproxDIKCanon E Γ (instantiate0 a b') c) →
      LRTypeFamINRKCanon E n (.letBinding A a :: Γ) b b' c) :
    LRTypeFamINBiProbeRKCanon E n Γ (.app (.lam A b) a) (instantiate0 a b') := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ (instantiate0 a b) c ∨ ApproxDIKCanon E Γ (instantiate0 a b') c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDIKCanon_beta_iff hW A b a c).mp hL)
    · exact Or.inr hR
  exact lrTypeFamINRKCanon_beta_of_letBinding_botFamCpt hW hΓ ha
    (botFamCpt_of_famProbeCpt hc) (hb c hc happrox')

theorem lrTermFamINDRKCanon_beta_of_letBinding_botFamCpt_sort {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A a b b' T : Expr Nat} {l : Level}
    (ha : HasTyT E n Γ a A)
    (hT : WhRedRecKCanon E (.letBinding A a :: Γ) T (.sort l))
    {c : CptI} (hc : BotFamCpt E c)
    (hb : LRTermFamINDRKCanon E n (.letBinding A a :: Γ) b b' T c) :
    LRTermFamINDRKCanon E n Γ (.app (.lam A b) a) (instantiate0 a b') (instantiate0 a T) c := by
  have hget0 : (LocalDecl.letBinding A a :: Γ)[0]? = some (.letBinding A a) := by simp
  have hsub := lrTermFamINDRKCanon_substLet_botFamCpt_sort (envClosed_of_envWfT hW)
    (envMembersSubstStable_of_envWfT hW) A a hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using ha)
    (by simpa only [substRemove_zero_cons] using hΓ) hT hc hb
  simp only [substRemove_zero_cons, lift_zero] at hsub
  exact lrTermFamINDRKCanon_expand (.step (.beta A b a) (.refl _)) (.refl _) c hsub


/-! #### Part D — `ApproxDIKCanon` Disjointness on `BotFamCpt E`, Unconditional `BotFamCpt E` PER for `LRTermFamINDRKCanon` Under `EnvWfT E` Alone, Bidirectional `LRTermFamINDBiProbeRKCanon`, and Local `HasTyT.conv` / `ConvT.tyConv` Index Transport -/

/-- Any `.lam A b` has only `c = .bot` in `ApproxDIKCanon E Γ (.lam A b) c` among `BotFamCpt E c`. -/
theorem approxDIKCanon_lam_botFamCpt_eq_bot {E : ResolvedEnv} {Γ : LCtx}
    (A b : Expr Nat) {c : CptI} (hc : BotFamCpt E c)
    (h : ApproxDIKCanon E Γ (.lam A b) c) : c = .bot := by
  have hDI : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.lam A b) c :=
    (approxDIKCanon_lam_iff E Γ A b c).mp h
  rcases PiModelDeltaIotaAudit.approxDI_lam_inv hDI with rfl | ⟨g, rfl, _⟩
  · rfl
  · exact (not_botFamCpt_lam E g hc).elim

/-- Any non-saturated admitted `.inductiveM` family spine (`xs.length ≠ (piDomsOf m.mtype).length`)
    has only `c = .bot` in `ApproxDIKCanon E Γ` among `BotFamCpt E c`. -/
theorem approxDIKCanon_famApp_botFamCpt_of_length_ne {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)}
    (hne : xs.length ≠ (piDomsOf m.mtype).length)
    {c : CptI} (hc : BotFamCpt E c)
    (h : ApproxDIKCanon E Γ (foldApps (.const r ls) xs) c) : c = .bot :=
  approxDI_famApp_botFamCpt_of_length_ne hW hm hind hne hc
    ((approxDIKCanon_famApp_iff hW Γ hm hind ls xs c).mp h)

/-- Any rigid non-`.inductiveM` spine (`m.mclass ≠ .inductiveM`) that is normal in `WhRedRecKCanon`
    has only `c = .bot` in `ApproxDI E (ctxEnvDI E Γ)` among `BotFamCpt E c`. -/
theorem approxDIKCanon_ctorApp_botFamCpt_eq_bot {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat))
    {c : CptI} (hc : BotFamCpt E c)
    (h : ApproxDIKCanon E Γ (foldApps (.const r ls) xs) c) : c = .bot := by
  have hnind : ∀ m', E.members r = some m' → m'.mclass ≠ .inductiveM := by
    intro m' hm' hEq
    have : m' = m := Option.some.inj (hm'.symm.trans hm)
    subst this
    exact MemberClass.noConfusion (hctor.symm.trans hEq)
  exact approxDI_nonFam_rigid_botFamCpt_eq_bot (rigidConst_of_ctorM hW hm hctor) hnind hc
    ((approxDIKCanon_ctorApp_iff hW Γ hm hctor ls xs c).mp h)

/-- For any `.lam A b`, `LRTermFamINDRKCanon E n Γ (.lam A b) M' T c` holds for every `BotFamCpt E c`
    with `ApproxDIKCanon E Γ (.lam A b) c` (since `c = .bot`)! -/
theorem lrTermFamINDRKCanon_botFamCpt_lam_left {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (A b M' T : Expr Nat) {c : CptI} (hc : BotFamCpt E c)
    (h : ApproxDIKCanon E Γ (.lam A b) c) :
    LRTermFamINDRKCanon E n Γ (.lam A b) M' T c := by
  rw [approxDIKCanon_lam_botFamCpt_eq_bot A b hc h]
  exact lrTermFamINDRKCanon_bot _ _ _ _

/-- **Unconditional Symmetry of `LRTermFamINDRKCanon` Across All Non-`.lam` Compacts (`∀ g, c ≠ .lam g`)
    Under `EnvWfT E` and `CtxWfT E n Γ` Alone (`lrTermFamINDRKCanon_symm_of_ne_lam`):**
    Requires **zero** `ZeroSortCoherence E n` and **zero** `FundamentalLRFamINProbeRKCanon E n`! -/
theorem lrTermFamINDRKCanon_symm_of_ne_lam {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M M' A : Expr Nat} :
    ∀ (c : CptI), (∀ g, c ≠ .lam g) →
      LRTermFamINDRKCanon E n Γ M M' A c → LRTermFamINDRKCanon E n Γ M' M A c
  | .bot, _, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, _, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamINRKCanon_symm_of_envWfT hW hΓ hLR⟩
  | .pi a f, _, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamINRKCanon_symm_of_envWfT hW hΓ hLR⟩
  | .spine r args, _, h => by
      rw [lrTermFamINDRKCanon_spine_iff] at h ⊢
      rcases h with ⟨hl, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · exact Or.inl ⟨hl, lrTypeFamINRKCanon_symm_of_envWfT hW hΓ hLR⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨hns, Y', Y, hY', hY, hn', hn, ⟨.symm _ _ _ _ hc⟩⟩)
  | .lam g, hne, _ => (hne g rfl).elim

/-- **Unconditional Symmetry of `LRTermFamINDRKCanon` Across All `BotFamCpt E` Compacts Under
    `EnvWfT E` and `CtxWfT E n Γ` Alone (`lrTermFamINDRKCanon_symm_botFamCpt`):** -/
theorem lrTermFamINDRKCanon_symm_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M M' A : Expr Nat} {c : CptI} (hc : BotFamCpt E c)
    (h : LRTermFamINDRKCanon E n Γ M M' A c) :
    LRTermFamINDRKCanon E n Γ M' M A c :=
  lrTermFamINDRKCanon_symm_of_ne_lam hW hΓ c
    (fun g hEq => by subst hEq; exact not_botFamCpt_lam E g hc) h

/-- **Unconditional Transitivity of `LRTermFamINDRKCanon` Across All Non-`.lam` Compacts (`∀ g, c ≠ .lam g`)
    Under `EnvWfT E` and `CtxWfT E n Γ` Alone (`lrTermFamINDRKCanon_trans_of_ne_lam`):**
    Requires **zero** `ZeroSortCoherence E n` and **zero** `FundamentalLRFamINProbeRKCanon E n`! -/
theorem lrTermFamINDRKCanon_trans_of_ne_lam {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M N P A : Expr Nat} :
    ∀ (c : CptI), (∀ g, c ≠ .lam g) →
      LRTermFamINDRKCanon E n Γ M N A c →
      LRTermFamINDRKCanon E n Γ N P A c →
      LRTermFamINDRKCanon E n Γ M P A c
  | .bot, _, _, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, _, h₁, h₂ => by
      rw [lrTermFamINDRKCanon_sort_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl, lrTypeFamINRKCanon_trans_of_envWfT hW hΓ hLR₁ hLR₂⟩
  | .pi a f, _, h₁, h₂ => by
      rw [lrTermFamINDRKCanon_pi_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl, lrTypeFamINRKCanon_trans_of_envWfT hW hΓ hLR₁ hLR₂⟩
  | .spine r args, _, h₁, h₂ => by
      rw [lrTermFamINDRKCanon_spine_iff] at h₁ h₂ ⊢
      rcases h₁ with ⟨⟨l, hl⟩, hLR₁⟩ | hprop | ⟨hns, Y₁, Y₂, hM, hN₁, hn₁, hn₂, ⟨hc₁⟩⟩
      · rcases h₂ with ⟨_, hLR₂⟩ | hprop | ⟨hns, _⟩
        · exact Or.inl ⟨⟨l, hl⟩, lrTypeFamINRKCanon_trans_of_envWfT hW hΓ hLR₁ hLR₂⟩
        · exact Or.inr (Or.inl hprop)
        · exact (hns l hl).elim
      · exact Or.inr (Or.inl hprop)
      · rcases h₂ with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨_, Y₂', Y₃, hN₂, hP, hn₂', hn₃, ⟨hc₂⟩⟩
        · exact (hns l hl).elim
        · exact Or.inr (Or.inl hprop)
        · have e := whRedRecKCanon_normal_unique_of_envWfT hW hN₁ hn₂ hN₂ hn₂'
          subst e
          exact Or.inr (Or.inr ⟨hns, Y₁, Y₃, hM, hP, hn₁, hn₃,
            ⟨.trans _ _ _ _ _ hc₁ hc₂⟩⟩)
  | .lam g, hne, _, _ => (hne g rfl).elim

/-- **Unconditional Transitivity of `LRTermFamINDRKCanon` Across All `BotFamCpt E` Compacts Under
    `EnvWfT E` and `CtxWfT E n Γ` Alone (`lrTermFamINDRKCanon_trans_botFamCpt`):** -/
