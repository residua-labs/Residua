        · exact (hns l hA).elim
  have hLR' := lrTypeFamIN_substLet_botFamCpt hcl hinst t w0 hc hget hvty hΓ' hLR
  cases hc with
  | bot => exact lrTermFamIND_bot _ _ _ _
  | sort => exact (lrTermFamIND_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamIND_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamIND_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)

/-- When the first `j` declarations of `Γ` are `.assumption`s (`∀ i < j, lookupValue Γ i = none`;
    in particular automatically at `j = 0` for every context `Γ`!), `substRemove r j Γ` and
    `substRemove r' j Γ` have the exact same local let-values (`CtxSameValues`). -/
theorem ctxSameValues_substRemove_of_assump_prefix (r r' : Expr Nat) :
    ∀ (j : Nat) (Γ : LCtx),
      (∀ i < j, lookupValue Γ i = none) →
      CtxSameValues (substRemove r j Γ) (substRemove r' j Γ)
  | 0, [] => fun _ => ctxSameValues_refl []
  | 0, _ :: Γ => fun _ => ctxSameValues_refl Γ
  | _ + 1, [] => fun _ => ctxSameValues_refl []
  | j + 1, .assumption _ :: Γ => fun h =>
      ctxSameValues_assumption _ _
        (ctxSameValues_substRemove_of_assump_prefix r r' j Γ (fun i hi => by
          have h0 := h (i + 1) (Nat.succ_lt_succ hi)
          rw [lookupValue_cons_succ] at h0
          cases hlk : lookupValue Γ i with
          | none => rfl
          | some w => rw [hlk] at h0; exact nomatch h0))
  | _ + 1, .letBinding _ _ :: _ => fun h =>
      nomatch h 0 (Nat.zero_lt_succ _)

/-- **Related-Substitution Stability of `LRTermFamIND` at `.bot`, `.sort` (Both `IsRigidPropCtx`
    and Sort-Code Branches), and `.bvar j` Over `ApproxI` (`fundamentalTermFamINDS_I`):**
    Context-aware family-model extension of `PiModelIdealAudit.FundamentalTermIS`
    (`RcicNativePiModelLRTermSubst` #7660) with **zero** `hι` side hypotheses! -/
theorem fundamentalTermFamINDS_I {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {ρ : EnvI} {j : Nat} {r r' t T : Expr Nat} {Γ : LCtx}
    (hget : Γ[j]? = some (.assumption t))
    (hpre : ∀ i < j, lookupValue Γ i = none)
    (hvty : HasTyT E n (substRemove r j Γ) (lift 0 j r) (lift 0 j t))
    (hrel : ∀ c, ApproxI (EnvI.drop ρ j) r c →
      LRTermFamIND E n (substRemove r j Γ) (lift 0 j r) (lift 0 j r') T c) :
    (∀ {M M' A : Expr Nat},
        LRTermFamIND E n (substRemove r j Γ)
          (instantiate j (lift 0 j r) M)
          (instantiate j (lift 0 j r') M')
          (instantiate j (lift 0 j r) A) .bot) ∧
    (∀ {M M' A : Expr Nat},
        (IsRigidPropCtx E n Γ A ∨
          (∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' .sort) →
        LRTermFamIND E n (substRemove r j Γ)
          (instantiate j (lift 0 j r) M)
          (instantiate j (lift 0 j r') M')
          (instantiate j (lift 0 j r) A) .sort) ∧
    (∀ c, ApproxI ρ (instantiate j (lift 0 j r) (.bvar j)) c →
        LRTermFamIND E n (substRemove r j Γ)
          (instantiate j (lift 0 j r) (.bvar j))
          (instantiate j (lift 0 j r') (.bvar j)) T c) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  refine ⟨?bot, ?sort, ?var⟩
  case bot =>
    intro _ _ _
    exact lrTermFamIND_bot _ _ _ _
  case sort =>
    intro M M' A h
    rcases h with hrig | ⟨⟨l, hA⟩, hLR⟩
    · exact lrTermFamIND_of_isRigidPropCtx hW
        (isRigidPropCtx_subst hcl hinst r t hget hvty hrig) .sort
    · rw [lrTermFamIND_sort_iff]
      cases hLR with
      | sort hM hM' =>
          have hA₁ := whRedCtx_instantiate_of_envClosed hcl hget hA r
          have hM₁ := whRedCtx_instantiate_of_envClosed hcl hget hM r
          have hM₂ : WhRedCtx E (substRemove r j Γ) (instantiate j (lift 0 j r') M') (.sort _) :=
            whRedCtx_of_sameValues
              (ctxSameValues_symm (ctxSameValues_substRemove_of_assump_prefix r r' j Γ hpre))
              (whRedCtx_instantiate_of_envClosed hcl hget hM' r')
          exact Or.inr ⟨⟨l, hA₁⟩, .sort hM₁ hM₂⟩
  case var =>
    intro c hmem
    have hlook : ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) r)) (.bvar j) c :=
      (PiModelIdealAudit.approxSubst ρ j r (.bvar j) c).mp hmem
    have hL : instantiate j (lift 0 j r) (.bvar j) = lift 0 j r := by
      rw [instantiate, if_pos (rfl : j = j)]
    have hR : instantiate j (lift 0 j r') (.bvar j) = lift 0 j r' := by
      rw [instantiate, if_pos (rfl : j = j)]
    rw [hL, hR]
    rcases approxI_bvar_inv hlook with hbot | hmem
    · subst hbot
      exact lrTermFamIND_bot _ _ _ _
    · rw [EnvI.insert_self] at hmem
      exact hrel c hmem

