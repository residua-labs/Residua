/-- **Refutation of §13's `FundamentalLRFamINBotR` and `FundamentalTermFamINDBotR` in Admitted `trueEnvU` (`W-K-OPEN`):** -/
theorem not_fundamentalLRFamINBotR_trueEnvU (n : Nat) :
    ¬ FundamentalLRFamINBotR trueEnvU n := by
  intro F
  exact not_lrTypeFamINR_trueVarFam_right n (.const 0 [])
    (F (trueVarCtx_wf n) (trueConstTyT rfl) (.of _ _ _ _ (convT_trueVarFam_symm n))
      (.spine 0 []) botFamCpt_trueFam
      (.const (ctxEnvDI trueEnvU trueVarCtx) 0 []
        (rigidConst_of_inductiveM trueEnvUWfT (m := trueFamMember) rfl rfl)))

