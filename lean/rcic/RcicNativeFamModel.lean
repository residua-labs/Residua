/-! ### §14 — Wall `W-K-OPEN` (`trueVarCtx` Open Proof-Variable Major Refutation of §13's `WhStepRecCtx`, `ApproxDI` Two-Sided Invariance, `LRTypeFamINR`, `LRTypeFamINBiR`, `LRTermFamINDR`, `FundamentalLRFamINBotR`, and `FundamentalTermFamINDBotR` in `trueEnvU`), Native `ConvT` Soundness of Proposition-Major Recursor Steps (`convT_of_recMajor`, `convT_of_pmajor_conv`, `convT_of_pmajor_derivedIota`), K-Closed Concrete $\delta$/$\iota$ Family Model (`WhStepRecK` / `WhRedRecK` / `ApproxDIK` / `SemEqDIK`), and Repaired `LRTypeFamINRK` / `LRTypeFamINBiRK` / `LRTermFamINDRK` / `FundamentalLRFamINBotRK` / `FundamentalTermFamINDBotRK` -/

/-! #### Part A — Wall `W-K-OPEN`: Open Proof-Variable Major (`trueVarCtx = [.assumption (.const 0 [])]`) Refutation of §13's `WhStepRecCtx`, `ApproxDI` Two-Sided Invariance, `LRTypeFamINR`, `LRTypeFamINBiR`, `LRTermFamINDR`, `FundamentalLRFamINBotR`, and `FundamentalTermFamINDBotR` in Admitted `trueEnvU` -/

/-- One-assumption context `[h : True]` (`lookupValue trueVarCtx 0 = none`) in `trueEnvU`. -/
def trueVarCtx : LCtx :=
  [.assumption (.const 0 [])]

/-- `trueVarCtx` is well-formed in `trueEnvU` for every `n : Nat`. -/
noncomputable def trueVarCtx_wf (n : Nat) : CtxWfT trueEnvU n trueVarCtx :=
  .assumption [] (.const 0 []) .zero .nil (trueConstTyT rfl)

/-- `.bvar 0 : True` in `trueVarCtx`. -/
noncomputable def hasTyT_trueVar0 {n : Nat} :
    HasTyT trueEnvU n trueVarCtx (.bvar 0) (.const 0 []) :=
  .bvar trueVarCtx 0 (.const 0 []) rfl

/-- `.bvar 0 ≡ True.intro : True` via `ConvT.irr` in `trueVarCtx`. -/
noncomputable def convT_trueVar0_intro {n : Nat} :
    ConvT trueEnvU n trueVarCtx (.bvar 0) (.const 1 []) (.const 0 []) :=
  .irr trueVarCtx (.const 0 []) (.bvar 0) (.const 1 [])
    (trueConstTyT rfl) hasTyT_trueVar0 hasTyT_trueIntro

/-- `True.intro ≡ .bvar 0 : True` via `ConvT.symm` + `ConvT.irr` in `trueVarCtx`. -/
noncomputable def convT_trueIntro_var0 {n : Nat} :
    ConvT trueEnvU n trueVarCtx (.const 1 []) (.bvar 0) (.const 0 []) :=
  .symm _ _ _ _ convT_trueVar0_intro

/-- Recursor application `True.rec.{u} motive minor (.bvar 0)` with open proof-variable major in `trueVarCtx`. -/
def trueRecVar (u : Level) (motive minor : Expr Nat) : Expr Nat :=
  .app (.app (.app (.const 2 [u]) motive) minor) (.bvar 0)

/-- **Key Normal-Form Theorem (`whStepRecCtx_trueRecVar_false`):**
    Whereas §13's `WhStepRecCtx` reduces the closed β-redex major `trueMajorBeta = (λ x, x) tt`,
    in `trueVarCtx = [h : True]` the open assumption variable `.bvar 0` has `lookupValue trueVarCtx 0 = none`
    and is already `WhNormalRecCtx`, so `trueRecVar u motive minor` takes **no** `WhStepRecCtx` step:
    - root `iota` is blocked because `(appsSpine (.bvar 0)).1 = .bvar 0 ≠ .const …`
      (`derivedIotaU_major_headOf_const`);
    - `appHead` is blocked by `whStepRecCtx_recursor_prefix_false`;
    - `recMajor` is blocked by `whStepRecCtx_bvar_of_lookupValue_none_false`. -/
theorem whStepRecCtx_trueRecVar_false (u : Level) (motive minor : Expr Nat) {e : Expr Nat}
    (hs : WhStepRecCtx trueEnvU trueVarCtx (trueRecVar u motive minor) e) : False := by
  generalize ha : trueRecVar u motive minor = a₀ at hs
  cases hs with
  | beta => nomatch ha
  | zeta => nomatch ha
  | zetaLocal => nomatch ha
  | delta => nomatch ha
  | iota hI =>
      rw [← ha] at hI
      obtain ⟨c, lsC, hhead⟩ := derivedIotaU_major_headOf_const hI
      exact Expr.noConfusion hhead
  | lit => nomatch ha
  | appHead hf =>
      injection ha with hfEq _
      subst hfEq
      exact whStepRecCtx_recursor_prefix_false trueEnvUWfT (r := 2) (m := trueRecMemberU)
        rfl rfl [u] [motive, minor] (by simp [trueRecMemberU, trueRecTypeU, policyPi, piCount]) hf
  | recMajor _ _ _ hmaj =>
      injection ha with _ hmajEq
      rw [← hmajEq] at hmaj
      exact whStepRecCtx_bvar_of_lookupValue_none_false (Γ := trueVarCtx) (i := 0) rfl hmaj

/-- `trueRecVar u motive minor` is weak-head normal in `WhStepRecCtx trueEnvU trueVarCtx`. -/
theorem whNormalRecCtx_trueRecVar (u : Level) (motive minor : Expr Nat) :
    WhNormalRecCtx trueEnvU trueVarCtx (trueRecVar u motive minor) :=
  fun _ hs => whStepRecCtx_trueRecVar_false u motive minor hs

/-- Any `WhRedRecCtx trueEnvU trueVarCtx (trueRecVar u motive minor) X` forces `X = trueRecVar u motive minor`. -/
theorem whRedRecCtx_trueRecVar_eq {u : Level} {motive minor X : Expr Nat}
    (h : WhRedRecCtx trueEnvU trueVarCtx (trueRecVar u motive minor) X) :
    X = trueRecVar u motive minor := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_trueRecVar_false u motive minor hs).elim

/-- `(trueSortMotive u) (.bvar 0) ≡ Sort u : Sort (u + 1)` in `trueVarCtx` via `ConvT.app` +
    `convT_trueVar0_intro` + `convT_trueSortMotive_beta`. -/
noncomputable def convT_trueSortMotive_var0 (u : Level) {n : Nat} :
    ConvT trueEnvU n trueVarCtx (.app (trueSortMotive u) (.bvar 0)) (.sort u) (.sort (.succ u)) :=
  .trans trueVarCtx _ (.app (trueSortMotive u) (.const 1 [])) (.sort u) (.sort (.succ u))
    (.app trueVarCtx (trueSortMotive u) (trueSortMotive u) (.bvar 0) (.const 1 [])
      (.const 0 []) (.sort (.succ u))
      (.refl trueVarCtx (trueSortMotive u) _ (hasTyT_trueSortMotive u))
      convT_trueVar0_intro)
    (convT_trueSortMotive_beta u)

/-- For any `minor : Sort u` and `hb : levelsBounded n [.succ u] = true`,
    `trueRecVar (.succ u) (trueSortMotive u) minor` has type `.sort u` in `trueVarCtx`. -/
noncomputable def hasTyT_trueRecVar (u : Level) {n : Nat} {minor : Expr Nat}
    (hb : levelsBounded n [.succ u] = true)
    (hminor : HasTyT trueEnvU n trueVarCtx minor (.sort u)) :
    HasTyT trueEnvU n trueVarCtx (trueRecVar (.succ u) (trueSortMotive u) minor) (.sort u) := by
  have hminorK : HasTyT trueEnvU n trueVarCtx minor (.app (trueSortMotive u) (.const 1 [])) :=
    .conv trueVarCtx minor (.sort u) (.app (trueSortMotive u) (.const 1 [])) (.succ u)
      hminor (.symm _ _ _ _ (convT_trueSortMotive_beta u))
  have hprefix : HasTyT trueEnvU n trueVarCtx
      (.app (.app (.const 2 [.succ u]) (trueSortMotive u)) minor)
      (.pi (.const 0 []) (.app (trueSortMotive u) (.bvar 0))) :=
    .app trueVarCtx _ _ _ _
      (.app trueVarCtx _ _ _ _
        (.const trueVarCtx 2 [.succ u] trueRecMemberU rfl rfl hb)
        (hasTyT_trueSortMotive u))
      hminorK
  have happ : HasTyT trueEnvU n trueVarCtx (trueRecVar (.succ u) (trueSortMotive u) minor)
      (.app (trueSortMotive u) (.bvar 0)) :=
    .app trueVarCtx _ _ _ _ hprefix hasTyT_trueVar0
  exact .conv trueVarCtx _ _ (.sort u) (.succ u) happ (convT_trueSortMotive_var0 u)

/-- For any `minor : Sort u` and `hb : levelsBounded n [.succ u] = true`,
    `trueRecVar (.succ u) (trueSortMotive u) minor ≡ minor : Sort u` in `trueVarCtx` via
    `ConvT.irr` + `ConvT.app` + `ConvT.iota`. -/
noncomputable def convT_trueRecVar (u : Level) {n : Nat} {minor : Expr Nat}
    (hb : levelsBounded n [.succ u] = true)
    (hminor : HasTyT trueEnvU n trueVarCtx minor (.sort u)) :
    ConvT trueEnvU n trueVarCtx (trueRecVar (.succ u) (trueSortMotive u) minor) minor (.sort u) := by
  have hminorK : HasTyT trueEnvU n trueVarCtx minor (.app (trueSortMotive u) (.const 1 [])) :=
    .conv trueVarCtx minor (.sort u) (.app (trueSortMotive u) (.const 1 [])) (.succ u)
      hminor (.symm _ _ _ _ (convT_trueSortMotive_beta u))
  have hprefix : HasTyT trueEnvU n trueVarCtx
      (.app (.app (.const 2 [.succ u]) (trueSortMotive u)) minor)
      (.pi (.const 0 []) (.app (trueSortMotive u) (.bvar 0))) :=
    .app trueVarCtx _ _ _ _
      (.app trueVarCtx _ _ _ _
        (.const trueVarCtx 2 [.succ u] trueRecMemberU rfl rfl hb)
        (hasTyT_trueSortMotive u))
      hminorK
  have hLhsTy : HasTyT trueEnvU n trueVarCtx
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor)) (.sort u) :=
    .conv trueVarCtx _ _ (.sort u) (.succ u)
      (.app trueVarCtx _ _ _ _ hprefix hasTyT_trueIntro)
      (convT_trueSortMotive_beta u)
  have hstep1 : ConvT trueEnvU n trueVarCtx
      (trueRecVar (.succ u) (trueSortMotive u) minor)
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor))
      (.sort u) :=
    .tyConv trueVarCtx _ _ (.app (trueSortMotive u) (.bvar 0)) (.sort u) (.succ u)
      (.app trueVarCtx _ _ (.bvar 0) (.const 1 []) (.const 0 []) (.app (trueSortMotive u) (.bvar 0))
        (.refl trueVarCtx _ _ hprefix) convT_trueVar0_intro)
      (convT_trueSortMotive_var0 u)
  have hstep2 : ConvT trueEnvU n trueVarCtx
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor))
      minor (.sort u) :=
    .iota trueVarCtx _ minor (.sort u) (.of (trueRecWitness (.succ u) (trueSortMotive u) minor))
      hLhsTy hminor
  exact .trans trueVarCtx _ _ minor (.sort u) hstep1 hstep2

/-- `minor ≡ trueRecVar (.succ u) (trueSortMotive u) minor : Sort u` in `trueVarCtx`. -/
noncomputable def convT_trueRecVar_symm (u : Level) {n : Nat} {minor : Expr Nat}
    (hb : levelsBounded n [.succ u] = true)
    (hminor : HasTyT trueEnvU n trueVarCtx minor (.sort u)) :
    ConvT trueEnvU n trueVarCtx minor (trueRecVar (.succ u) (trueSortMotive u) minor) (.sort u) :=
  .symm _ _ _ _ (convT_trueRecVar u hb hminor)

/-- The three concrete `W-K-OPEN` instances in `trueEnvU` at `trueVarCtx = [h : True]`:
    - `trueVarSort`: `True.rec.{2} (λ _, Sort 1) (Sort 0) (.bvar 0)` (convertible to `Sort 0`, compact `.sort`)
    - `trueVarPi`: `True.rec.{1} (λ _, Sort 0) idPiProp (.bvar 0)` (convertible to `idPiProp`, compact `.pi .bot []`)
