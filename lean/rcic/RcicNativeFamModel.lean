/-! #### Part A — Deterministic Normal-Target `WhRedRecKCanon` Inversion, Head-Spine Reduction, Two-Way `ApproxDIKCanon` Step Equivalences, and Two-Way `WhRedRecKCanon` Invariance (`↔`) -/

/-- If `M` steps to `M'` in `WhStepRecKCanon E Γ` and reduces to a `WhNormalRecKCanon E Γ` normal
    form `V`, then `M'` also reduces to `V` under `EnvWfT E`. -/
theorem whRedRecKCanon_of_whStepRecKCanon_normal {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' V : Expr Nat}
    (hstep : WhStepRecKCanon E Γ M M')
    (hred : WhRedRecKCanon E Γ M V)
    (hnorm : WhNormalRecKCanon E Γ V) :
    WhRedRecKCanon E Γ M' V := by
  cases hred with
  | refl =>
      exact (hnorm M' hstep).elim
  | step hs hrest =>
      have heq := whDetRecKCanon_of_envWfT hW Γ hstep hs
      subst heq
      exact hrest

/-- If `M` reduces to `M'` in `WhRedRecKCanon E Γ` and reduces to a `WhNormalRecKCanon E Γ` normal
    form `V`, then `M'` also reduces to `V` under `EnvWfT E`. -/
theorem whRedRecKCanon_of_whRedRecKCanon_normal {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' V : Expr Nat}
    (hred₁ : WhRedRecKCanon E Γ M M')
    (hred₂ : WhRedRecKCanon E Γ M V)
    (hnorm : WhNormalRecKCanon E Γ V) :
    WhRedRecKCanon E Γ M' V := by
  induction hred₁ with
  | refl => exact hred₂
  | step hs _ ih =>
      exact ih (whRedRecKCanon_of_whStepRecKCanon_normal hW hs hred₂ hnorm)

/-- Two-way equivalence (`↔`) of `WhRedRecKCanon E Γ _ V` across any reduction `WhRedRecKCanon E Γ M M'`
    for any normal target `WhNormalRecKCanon E Γ V` under `EnvWfT E`. -/
theorem whRedRecKCanon_iff_of_whRedRecKCanon_normal {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' V : Expr Nat}
    (hred : WhRedRecKCanon E Γ M M')
    (hnorm : WhNormalRecKCanon E Γ V) :
    WhRedRecKCanon E Γ M V ↔ WhRedRecKCanon E Γ M' V :=
  ⟨fun h => whRedRecKCanon_of_whRedRecKCanon_normal hW hred h hnorm,
   fun h => whRedRecKCanon_trans hred h⟩

theorem whRedRecKCanon_sort_iff_of_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' : Expr Nat} (hred : WhRedRecKCanon E Γ M M') (u : Level) :
    WhRedRecKCanon E Γ M (.sort u) ↔ WhRedRecKCanon E Γ M' (.sort u) :=
  whRedRecKCanon_iff_of_whRedRecKCanon_normal hW hred (whNormalRecKCanon_sort u)

theorem whRedRecKCanon_pi_iff_of_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' : Expr Nat} (hred : WhRedRecKCanon E Γ M M') (A B : Expr Nat) :
    WhRedRecKCanon E Γ M (.pi A B) ↔ WhRedRecKCanon E Γ M' (.pi A B) :=
  whRedRecKCanon_iff_of_whRedRecKCanon_normal hW hred (whNormalRecKCanon_pi A B)

theorem whRedRecKCanon_lam_iff_of_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' : Expr Nat} (hred : WhRedRecKCanon E Γ M M') (A b : Expr Nat) :
