theorem lrTypeFamINRK_pi_probe {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat} (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
    (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
    {c : CptI} (hc : FamProbeCpt E c) (_h : ApproxDIK E n Γ (.pi A₁ B₁) c) :
    LRTypeFamINRK E n Γ (.pi A₁ B₁) (.pi A₂ B₂) c := by
  cases hc with
  | bot => exact .bot _ _ _
  | sort =>
      rcases PiModelDeltaIotaAudit.approxDI_pi_inv
        ((approxDIK_pi_iff E n Γ A₁ B₁ .sort).mp _h) with hbot | ⟨_, _, heq, _, _⟩
      · exact CptI.noConfusion hbot
      · exact CptI.noConfusion heq
  | pi_bot_nil =>
      exact .pi (.refl _) (.refl _) hΓ₁ hdom hcod (.bot _ _ _)
        (fun _ hs => (List.not_mem_nil _ hs).elim)
  | famSpine _ _ _ _ =>
      rcases PiModelDeltaIotaAudit.approxDI_pi_inv
        ((approxDIK_pi_iff E n Γ A₁ B₁ _).mp _h) with hbot | ⟨_, _, heq, _, _⟩
      · exact CptI.noConfusion hbot
      · exact CptI.noConfusion heq

