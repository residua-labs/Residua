/-- Non-sort proposition predicate over `WhRedRecK E n Γ`. -/
def IsNonSortPropRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (P : Expr Nat) : Prop :=
  (∀ l, ¬ WhRedRecK E n Γ P (.sort l)) ∧ Nonempty (HasTyT E n Γ P (.sort .zero))

theorem not_isNonSortPropRecK_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (u : Level) :
    ¬ IsNonSortPropRecK E n Γ (.sort u) :=
  fun ⟨hno, _⟩ => hno u (.refl _)

/-- **Repaired K + Recursor-Major Term Logical Relation (`LRTermFamINDRK`):**
    Extends `LRTermFamINDR` (§13) by replacing `WhRedRecCtx` / `LRTypeFamINR` with
    `WhRedRecK` / `LRTypeFamINRK`. -/
def LRTermFamINDRK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort =>
      IsNonSortPropRecK E n Γ A ∨
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' .sort)
  | .pi a f =>
      IsNonSortPropRecK E n Γ A ∨
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' (.pi a f))
  | .spine r args =>
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecK E n Γ A ∨
      ((∀ l, ¬ WhRedRecK E n Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecK E n Γ M Y ∧ WhRedRecK E n Γ M' Y' ∧ Nonempty (ConvT E n Γ Y Y' A))
  | .lam g =>
      IsNonSortPropRecK E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecK E n Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDRK E n Γ N N' A₁ u) →
          LRTermFamINDRK E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show u ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

theorem lrTermFamINDRK_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDRK E n Γ M M' A .bot := by
  rw [LRTermFamINDRK]; trivial

theorem lrTermFamINDRK_sort_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDRK E n Γ M M' A .sort ↔
      IsNonSortPropRecK E n Γ A ∨
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' .sort) := by
  rw [LRTermFamINDRK]

theorem lrTermFamINDRK_pi_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (a : CptI) (f : List (List CptI × CptI)) :
    LRTermFamINDRK E n Γ M M' A (.pi a f) ↔
      IsNonSortPropRecK E n Γ A ∨
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' (.pi a f)) := by
  rw [LRTermFamINDRK]

theorem lrTermFamINDRK_spine_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (r : Nat) (args : List CptI) :
    LRTermFamINDRK E n Γ M M' A (.spine r args) ↔
      ((∃ l, WhRedRecK E n Γ A (.sort l)) ∧ LRTypeFamINRK E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecK E n Γ A ∨
      ((∀ l, ¬ WhRedRecK E n Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecK E n Γ M Y ∧ WhRedRecK E n Γ M' Y' ∧ Nonempty (ConvT E n Γ Y Y' A)) := by
  rw [LRTermFamINDRK]

theorem lrTermFamINDRK_lam_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (g : List (List CptI × CptI)) :
    LRTermFamINDRK E n Γ M M' A (.lam g) ↔
      IsNonSortPropRecK E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecK E n Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDRK E n Γ N N' A₁ u) →
          LRTermFamINDRK E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2) := by
  rw [LRTermFamINDRK]

theorem lrTermFamINDRK_lam_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {g : List (List CptI × CptI)}
    (h : LRTermFamINDRK E n Γ M M' (.sort u) (.lam g)) : False := by
  rw [lrTermFamINDRK_lam_iff] at h
  rcases h with hprop | ⟨_, _, _, hA, _, _, _⟩
  · exact not_isNonSortPropRecK_sort u hprop
  · exact nomatch whRedRecK_sort_eq hA

theorem lrTermFamINDRK_spine_at_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {r : Nat} {args : List CptI}
    (h : LRTermFamINDRK E n Γ M M' (.sort u) (.spine r args)) :
    LRTypeFamINRK E n Γ M M' (.spine r args) := by
  rw [lrTermFamINDRK_spine_iff] at h
  rcases h with ⟨_, h2⟩ | hprop | ⟨hns, _⟩
  · exact h2
  · exact (not_isNonSortPropRecK_sort u hprop).elim
  · exact (hns u (.refl _)).elim

theorem lrTypeFamINRK_of_lrTermFamINDRK_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} :
    (c : CptI) → LRTermFamINDRK E n Γ M M' (.sort u) c → LRTypeFamINRK E n Γ M M' c
  | .bot, _ => .bot _ _ _
  | .sort, h => by
      rw [lrTermFamINDRK_sort_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecK_sort u hprop).elim
      · exact h2
  | .pi _ _, h => by
      rw [lrTermFamINDRK_pi_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecK_sort u hprop).elim
      · exact h2
  | .spine _ _, h => lrTermFamINDRK_spine_at_sort h
  | .lam _, h => (lrTermFamINDRK_lam_at_sort_false h).elim

theorem lrTermFamINDRK_of_lrTypeFamINRK_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) :
    (c : CptI) → LRTypeFamINRK E n Γ M M' c → LRTermFamINDRK E n Γ M M' (.sort u) c
  | .bot, _ => lrTermFamINDRK_bot _ _ _ _
  | .sort, h => (lrTermFamINDRK_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .pi _ _, h => (lrTermFamINDRK_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .spine _ _, h => (lrTermFamINDRK_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨u, .refl _⟩, h⟩)
  | .lam _, h => nomatch h

theorem lrTermFamINDRK_sort_iff_lrTypeFamINRK {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) (c : CptI) :
    LRTermFamINDRK E n Γ M M' (.sort u) c ↔ LRTypeFamINRK E n Γ M M' c :=
  ⟨lrTypeFamINRK_of_lrTermFamINDRK_sort c, lrTermFamINDRK_of_lrTypeFamINRK_sort u c⟩

/-- **Positive Resolution of `W-K-OPEN` in `LRTermFamINDRK` (`lrTermFamINDRK_trueVarSort`, `lrTermFamINDRK_trueVarPi`, `lrTermFamINDRK_trueVarFam`):**
    Whereas §13's `LRTermFamINDR` was refuted on `trueVarSort`, `trueVarPi`, and `trueVarFam` in
    `trueVarCtx`, `LRTermFamINDRK` holds in **both** directions across all `BotFamCpt trueEnvU` compacts! -/
theorem lrTermFamINDRK_trueVarSort (n : Nat) {c : CptI} (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx (.sort .zero) c) :
    LRTermFamINDRK trueEnvU n trueVarCtx (.sort .zero) trueVarSort (.sort (.succ .zero)) c ∧
      LRTermFamINDRK trueEnvU n trueVarCtx trueVarSort (.sort .zero) (.sort (.succ .zero)) c :=
  ⟨lrTermFamINDRK_of_lrTypeFamINRK_sort (.succ .zero) c
    (lrTypeFamINBiRK_trueVarSort n c hc h).1,
   lrTermFamINDRK_of_lrTypeFamINRK_sort (.succ .zero) c
    (lrTypeFamINBiRK_trueVarSort n c hc h).2⟩

theorem lrTermFamINDRK_trueVarPi (n : Nat) {c : CptI} (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx PiModelDeltaIotaAudit.idPiProp c) :
    LRTermFamINDRK trueEnvU n trueVarCtx PiModelDeltaIotaAudit.idPiProp trueVarPi (.sort .zero) c ∧
      LRTermFamINDRK trueEnvU n trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp (.sort .zero) c :=
  ⟨lrTermFamINDRK_of_lrTypeFamINRK_sort .zero c (lrTypeFamINRK_trueVarPi_left n c hc h).1,
   lrTermFamINDRK_of_lrTypeFamINRK_sort .zero c (lrTypeFamINRK_trueVarPi_left n c hc h).2⟩

theorem lrTermFamINDRK_trueVarFam (n : Nat) {c : CptI} (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx (.const 0 []) c) :
    LRTermFamINDRK trueEnvU n trueVarCtx (.const 0 []) trueVarFam (.sort .zero) c ∧
      LRTermFamINDRK trueEnvU n trueVarCtx trueVarFam (.const 0 []) (.sort .zero) c :=
  ⟨lrTermFamINDRK_of_lrTypeFamINRK_sort .zero c (lrTypeFamINRK_trueVarFam_left n c hc h).1,
   lrTermFamINDRK_of_lrTypeFamINRK_sort .zero c (lrTypeFamINRK_trueVarFam_left n c hc h).2⟩

