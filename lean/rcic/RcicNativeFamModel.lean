/-- Unconditional `LRTermFamIND` for two saturated admitted `.inductiveM` family spines at
    `.sort w` from `eqNList ls ls'` and `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'`. -/
theorem fundConvFamIND_famSpine_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) u →
      LRTermFamIND E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.sort w) u := by
  intro u hu
  rcases approxI_foldApps_const_inv hu with rfl | ⟨cs, rfl, _⟩
  · exact lrTermFamIND_bot _ _ _ _
  · exact lrTermFamIND_of_lrTypeFamIN_sort w (.spine r cs)
      (lrTypeFamIN_famSpine_congr cs hm hind hty hty' hc heqN hlen hlen' hargs)

/-- Unconditional `ConvT.consts` case for a 0-argument admitted `.inductiveM` family constant
    `.const r ls` (`piDomsOf m.mtype = []`) at `.sort w` in `LRTermFamIND`. -/
theorem fundConvFamIND_consts_inductiveM_zeroArity {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hdoms : piDomsOf m.mtype = [])
    {ls ls' : List Level} {w w' : Level}
    (hty : HasTyT E n Γ (.const r ls) (.sort w))
    (hty' : HasTyT E n Γ (.const r ls') (.sort w'))
    (hc : ConvT E n Γ (.const r ls) (.const r ls') (.sort w))
    (heqN : eqNList ls ls') :
    ∀ u, ApproxI (ctxEnvI Γ) (.const r ls) u →
      LRTermFamIND E n Γ (.const r ls) (.const r ls') (.sort w) u :=
  fundConvFamIND_famSpine_of_convArgsT (xs := []) (xs' := []) hm hind hty hty'
    (.of _ _ _ _ hc) heqN (congrArg List.length hdoms).symm (congrArg List.length hdoms).symm
    (.nil _)

/-- **Unconditional Partial Family-Spine Conversion Case at Any `.pi A B` Type
    (`fundConvFamIND_famSpine_partial_at_pi`):**
    Any two convertible partially applied `.inductiveM` family spines `foldApps (.const r₁ ls₁) xs₁`
    and `foldApps (.const r₂ ls₂) xs₂` typed at `.pi A B` satisfy `LRTermFamIND` at every compact
    `u` in `ApproxI (ctxEnvI Γ) (foldApps (.const r₁ ls₁) xs₁) u`. -/
theorem fundConvFamIND_famSpine_partial_at_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r₁ r₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members r₁ = some m₁) (hind₁ : m₁.mclass = .inductiveM)
    (hm₂ : E.members r₂ = some m₂) (hind₂ : m₂.mclass = .inductiveM)
    {ls₁ ls₂ : List Level} {xs₁ xs₂ : List (Expr Nat)} {A B : Expr Nat}
    (hc : ConvT E n Γ (foldApps (.const r₁ ls₁) xs₁) (foldApps (.const r₂ ls₂) xs₂) (.pi A B)) :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const r₁ ls₁) xs₁) u →
      LRTermFamIND E n Γ (foldApps (.const r₁ ls₁) xs₁) (foldApps (.const r₂ ls₂) xs₂)
        (.pi A B) u := by
  intro u hu
  rcases approxI_foldApps_const_inv hu with rfl | ⟨cs, rfl, _⟩
  · exact lrTermFamIND_bot _ _ _ _
  · exact lrTermFamIND_normal_of_not_sort (not_whRedCtx_sort_pi A B)
      (.refl _) (.refl _)
      (whNormalCtx_famApp hW hm₁ hind₁ ls₁ xs₁)
      (whNormalCtx_famApp hW hm₂ hind₂ ls₂ xs₂)
      hc r₁ cs

/-- **Unconditional Partial Family-Spine Diagonal Case at Any `.pi A B` Type
    (`fundTermFamIND_famSpine_partial_at_pi`):** -/
theorem fundTermFamIND_famSpine_partial_at_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A B : Expr Nat}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.pi A B)) :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) u →
      LRTermFamIND E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls) xs) (.pi A B) u :=
  fundConvFamIND_famSpine_partial_at_pi hW hm hind hm hind (.refl _ _ _ hty)

/-- **All-Arity `ConvT.consts` Case for Admitted `.inductiveM` Constants (`fundConvFamIND_consts_inductiveM`):**
    Under `EnvWfT E`, for **any** admitted `.inductiveM` family constant `.const r ls` of **any**
    parameter/index arity (`piDomsOf m.mtype = []` at `.sort ...` **or** `piDomsOf m.mtype = d :: ds`
    at `.pi ...`), `ConvT.consts` satisfies `LRTermFamIND` at every compact `u` in
    `ApproxI (ctxEnvI Γ) (.const r ls) u`. -/
theorem fundConvFamIND_consts_inductiveM {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level}
    (hlen : ls.length = m.arity) (hwf : levelsBounded n ls = true)
    (hwf' : levelsBounded n ls' = true) (heqN : eqNList ls ls') :
    ∀ u, ApproxI (ctxEnvI Γ) (.const r ls) u →
      LRTermFamIND E n Γ (.const r ls) (.const r ls') (instantiateLevels ls m.mtype) u := by
  have hlen' : ls'.length = m.arity := (eqNList_length ls ls' heqN).symm.trans hlen
  have hty : HasTyT E n Γ (.const r ls) (instantiateLevels ls m.mtype) :=
    .const Γ r ls m hm hlen hwf
  have hty' : HasTyT E n Γ (.const r ls') (instantiateLevels ls' m.mtype) :=
    .const Γ r ls' m hm hlen' hwf'
  have hc : ConvT E n Γ (.const r ls) (.const r ls') (instantiateLevels ls m.mtype) :=
    .consts Γ r ls ls' m hm hlen hwf hwf' heqN
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM hW hm hind ls'
  cases hdoms : piDomsOf m.mtype with
  | nil =>
      rw [hdoms, List.map_nil, policyPi] at htelL htelR
      rw [htelL] at hty hc ⊢
      rw [htelR] at hty'
      exact fundConvFamIND_consts_inductiveM_zeroArity hm hind hdoms hty hty' hc heqN
  | cons d ds =>
      rw [hdoms, List.map_cons, policyPi] at htelL
      rw [htelL] at hc ⊢
      exact fundConvFamIND_famSpine_partial_at_pi (xs₁ := []) (xs₂ := []) hW hm hind hm hind hc

/-- **All-Arity `HasTyT.const` Diagonal Case for Admitted `.inductiveM` Constants
    (`fundTermFamIND_const_inductiveM`):**
    Under `EnvWfT E`, for **any** admitted `.inductiveM` family constant `.const r ls` of **any**
    parameter/index arity (`0` or `> 0`), `HasTyT.const` satisfies the diagonal `LRTermFamIND` at
    every compact `u` in `ApproxI (ctxEnvI Γ) (.const r ls) u`. -/
theorem fundTermFamIND_const_inductiveM {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} (hlen : ls.length = m.arity) (hwf : levelsBounded n ls = true) :
    ∀ u, ApproxI (ctxEnvI Γ) (.const r ls) u →
      LRTermFamIND E n Γ (.const r ls) (.const r ls) (instantiateLevels ls m.mtype) u :=
  fundConvFamIND_consts_inductiveM hW hm hind hlen hwf hwf (eqNList_refl ls)

/-- **Unconditional Constructor-Spine Conversion Case at Any Non-Sort Type
    (`fundConvFamIND_ctorSpines_of_not_sort`):**
    Under `EnvWfT E`, any two convertible constructor spines `foldApps (.const c₁ ls₁) ys₁` and
    `foldApps (.const c₂ ls₂) ys₂` (`m₁.mclass = .constructorM`, `m₂.mclass = .constructorM`) at
    any type `A` with `∀ l, ¬ WhRedCtx E Γ A (.sort l)` satisfy `LRTermFamIND` at every compact `u`
    in `ApproxI (ctxEnvI Γ) (foldApps (.const c₁ ls₁) ys₁) u`. -/
theorem fundConvFamIND_ctorSpines_of_not_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {c₁ c₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members c₁ = some m₁) (hctor₁ : m₁.mclass = .constructorM)
    (hm₂ : E.members c₂ = some m₂) (hctor₂ : m₂.mclass = .constructorM)
    {ls₁ ls₂ : List Level} {ys₁ ys₂ : List (Expr Nat)} {A : Expr Nat}
    (hns : ∀ l, ¬ WhRedCtx E Γ A (.sort l))
    (hc : ConvT E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) A) :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const c₁ ls₁) ys₁) u →
      LRTermFamIND E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) A u := by
  intro u hu
  rcases approxI_foldApps_const_inv hu with rfl | ⟨cs, rfl, _⟩
  · exact lrTermFamIND_bot _ _ _ _
  · exact lrTermFamIND_normal_of_not_sort hns (.refl _) (.refl _)
      (whNormalCtx_ctorApp hW hm₁ hctor₁ ls₁ ys₁)
      (whNormalCtx_ctorApp hW hm₂ hctor₂ ls₂ ys₂)
      hc c₁ cs

