/-- Unconditional `LRTermFamIN` for two saturated admitted `.inductiveM` family spines at `.sort w`
    from `eqNList ls ls'` and `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'`. -/
theorem fundConvFamIN_famSpine_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) u →
      LRTermFamIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.sort w) u := by
  intro u hu
  rcases approxI_foldApps_const_inv hu with rfl | ⟨cs, rfl, _⟩
  · exact lrTermFamIN_bot _ _ _ _
  · exact lrTermFamIN_of_lrTypeFamIN_sort w (.spine r cs)
      (lrTypeFamIN_famSpine_congr cs hm hind hty hty' hc heqN hlen hlen' hargs)

/-- Unconditional `ConvT.consts` case for a 0-argument admitted `.inductiveM` family constant
    `.const r ls` (`piDomsOf m.mtype = []`) at `.sort w`. -/
theorem fundConvFamIN_consts_inductiveM_zeroArity {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hdoms : piDomsOf m.mtype = [])
    {ls ls' : List Level} {w w' : Level}
    (hty : HasTyT E n Γ (.const r ls) (.sort w))
    (hty' : HasTyT E n Γ (.const r ls') (.sort w'))
    (hc : ConvT E n Γ (.const r ls) (.const r ls') (.sort w))
    (heqN : eqNList ls ls') :
    ∀ u, ApproxI (ctxEnvI Γ) (.const r ls) u →
      LRTermFamIN E n Γ (.const r ls) (.const r ls') (.sort w) u :=
  fundConvFamIN_famSpine_of_convArgsT (xs := []) (xs' := []) hm hind hty hty'
    (.of _ _ _ _ hc) heqN (congrArg List.length hdoms).symm (congrArg List.length hdoms).symm
    (.nil _)

/-- At any family spine type `foldApps (.const r ls) xs`, two convertible constructor spines
    `foldApps (.const c₁ ls₁) ys₁` and `foldApps (.const c₂ ls₂) ys₂` (`m₁.mclass = .constructorM`,
    `m₂.mclass = .constructorM`) satisfy `LRTermFamIN` at every `.spine c₀ args` compact. -/
theorem lrTermFamIN_ctorSpine_at_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {c₁ c₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members c₁ = some m₁) (hctor₁ : m₁.mclass = .constructorM)
    (hm₂ : E.members c₂ = some m₂) (hctor₂ : m₂.mclass = .constructorM)
    {ls₁ ls₂ : List Level} {ys₁ ys₂ : List (Expr Nat)}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hc : ConvT E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)
      (foldApps (.const r ls) xs))
    (c₀ : Nat) (args : List CptI) :
    LRTermFamIN E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)
      (foldApps (.const r ls) xs) (.spine c₀ args) := by
  rw [lrTermFamIN_spine_iff]
  refine Or.inr (Or.inr ⟨⟨r, botVecI xs, fun _ hu => mem_botVecI_eq_bot xs hu,
    approxI_famApp_botVecI (ctxEnvI Γ) r ls xs⟩,
    foldApps (.const c₁ ls₁) ys₁, foldApps (.const c₂ ls₂) ys₂,
    .refl _, .refl _,
    whNormalCtx_ctorApp hW hm₁ hctor₁ ls₁ ys₁,
    whNormalCtx_ctorApp hW hm₂ hctor₂ ls₂ ys₂,
    ⟨hc⟩⟩)

/-- **Unconditional Constructor-Spine Conversion Case at Any Family Spine Type
    (`fundConvFamIN_ctorSpines_at_famApp`):**
    Directly resolves `RcicNativePiModelTermIrr`'s constructor-spine obstruction (#7640/#7648):
    any two convertible constructor spines `foldApps (.const c₁ ls₁) ys₁` and
    `foldApps (.const c₂ ls₂) ys₂` (`m₁.mclass = .constructorM`, `m₂.mclass = .constructorM`) typed at a family
    spine `foldApps (.const r ls) xs` satisfy `LRTermFamIN` at every compact `u` in
    `ApproxI (ctxEnvI Γ) (foldApps (.const c₁ ls₁) ys₁) u`. -/
theorem fundConvFamIN_ctorSpines_at_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {c₁ c₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members c₁ = some m₁) (hctor₁ : m₁.mclass = .constructorM)
    (hm₂ : E.members c₂ = some m₂) (hctor₂ : m₂.mclass = .constructorM)
    {ls₁ ls₂ : List Level} {ys₁ ys₂ : List (Expr Nat)}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hc : ConvT E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)
      (foldApps (.const r ls) xs)) :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const c₁ ls₁) ys₁) u →
      LRTermFamIN E n Γ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)
        (foldApps (.const r ls) xs) u := by
  intro u hu
  rcases approxI_foldApps_const_inv hu with rfl | ⟨cs, rfl, _⟩
  · exact lrTermFamIN_bot _ _ _ _
  · exact lrTermFamIN_ctorSpine_at_famApp hW hm₁ hctor₁ hm₂ hctor₂ hc c₁ cs

/-- **Unconditional Diagonal Constructor-Spine Case at Any Family Spine Type
    (`fundTermFamIN_ctorSpine_at_famApp`):**
    Any well-typed constructor spine `foldApps (.const c ls₁) ys` (`m.mclass = .constructorM`) at a family
    spine `foldApps (.const r ls) xs` satisfies the diagonal `LRTermFamIN` at every compact `u`. -/
theorem fundTermFamIN_ctorSpine_at_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls₁ : List Level} {ys : List (Expr Nat)}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hty : HasTyT E n Γ (foldApps (.const c ls₁) ys) (foldApps (.const r ls) xs)) :
    ∀ u, ApproxI (ctxEnvI Γ) (foldApps (.const c ls₁) ys) u →
      LRTermFamIN E n Γ (foldApps (.const c ls₁) ys) (foldApps (.const c ls₁) ys)
        (foldApps (.const r ls) xs) u :=
  fundConvFamIN_ctorSpines_at_famApp hW hm hctor hm hctor (.refl _ _ _ hty)

/-- Related-substitution stability of `LRTermFamIN` at the substituted variable `.bvar j`
    (via `approxI_subst_iff`). -/
theorem fundSubstFamIN_bvar_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {ρ : EnvI} {j : Nat} {sub sub' T : Expr Nat}
    (hrel : ∀ c, ApproxI (EnvI.drop ρ j) sub c →
      LRTermFamIN E n Γ (lift 0 j sub) (lift 0 j sub') T c) :
    ∀ c, ApproxI ρ (instantiate j (lift 0 j sub) (.bvar j)) c →
      LRTermFamIN E n Γ (instantiate j (lift 0 j sub) (.bvar j))
        (instantiate j (lift 0 j sub') (.bvar j)) T c := by
  intro c hmem
  have hlook : ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) (.bvar j) c :=
    (approxI_subst_iff ρ j sub (.bvar j) c).mp hmem
  have hL : instantiate j (lift 0 j sub) (.bvar j) = lift 0 j sub := by
    rw [instantiate, if_pos (rfl : j = j)]
  have hR : instantiate j (lift 0 j sub') (.bvar j) = lift 0 j sub' := by
    rw [instantiate, if_pos (rfl : j = j)]
  rw [hL, hR]
  rcases approxI_bvar_inv hlook with rfl | hmem'
  · exact lrTermFamIN_bot _ _ _ _
  · rw [EnvI.insert_self] at hmem'
    exact hrel c hmem'

/-- **The Context-Aware, Split-Spine, Family-Injective Fundamental Lemma for Terms
    (`FundamentalTermFamIN E n`):**
    States the diagonal (`HasTyT`) and conversion (`ConvT`) clauses of `LRTermFamIN` at
    `ctxEnvI Γ`. -/
def FundamentalTermFamIN (E : ResolvedEnv) (n : Nat) : Prop :=
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M A : Expr Nat}, HasTyT E n Γ M A →
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M A u) ∧
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M M' A : Expr Nat}, ConvT E n Γ M M' A →
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A u)

/-- For any single `ConvT E n Γ A B (.sort u)` link, `FundamentalTermFamIN E n` directly yields
    `LRTypeFamIN E n Γ A B c` for every `c` in `ApproxI (ctxEnvI Γ) A c` (requiring **neither**
    `ShallowTypeSoundnessCtxI` nor `WhDet`). -/
theorem lrTypeFamIN_of_fundamentalTermFamIN_convT {E : ResolvedEnv} {n : Nat}
    (F : FundamentalTermFamIN E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A B : Expr Nat} {u : Level} (hc : ConvT E n Γ A B (.sort u))
    (c : CptI) (hcA : ApproxI (ctxEnvI Γ) A c) :
    LRTypeFamIN E n Γ A B c :=
  lrTypeFamIN_of_lrTermFamIN_sort c (F.2 hΓ hc c hcA)

/-- Transitivity of `LRTypeFamIN` at the shallow compact `.pi .bot []` (requiring **no**
    `PiRowField E n` premise, since `.pi .bot []` has `a = .bot` and `f = []`). -/
theorem lrTypeFamIN_trans_pi_bot_nil {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) {Γ : LCtx}
    {A B C : Expr Nat}
    (h₁ : LRTypeFamIN E n Γ A B (.pi .bot []))
    (h₂ : LRTypeFamIN E n Γ B C (.pi .bot [])) :
    LRTypeFamIN E n Γ A C (.pi .bot []) := by
  cases h₁ with
  | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ hA hB hΓ₁ hdom₁ hcod₁ _ _ =>
      cases h₂ with
      | pi hB' hC _ hdom₂ hcod₂ _ _ =>
          have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
            hB (whNormalCtx_pi A₂ B₂) hB' (whNormalCtx_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi hA hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom₁ hdom₂)
                (.trans _ _ _ _ hcod₁ (tyConvT_assump_dom hW hΓ₀ hdom₁ hcod₂))
                (.bot _ _ _)
                (fun _ hs => nomatch hs)

/-- From `FundamentalTermFamIN E n`, `ShallowTypeSoundnessCtxI E n`, and `WhDet E` (with **no**
    `PiRowField` or `TypeSoundnessI` premise), any `TyConvT E n Γ A A'` chain preserves
    `LRTypeFamIN` at the shallow Π-probe `.pi .bot []`. -/
theorem lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → ApproxI (ctxEnvI Γ) A (.pi .bot []) →
    LRTypeFamIN E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.pi .bot []) (F.1 hΓ hA (.pi .bot []) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.pi .bot []) (F.2 hΓ hc (.pi .bot []) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hcM : ApproxI (ctxEnvI Γ) _ (.pi .bot []) :=
        (shallowTypeSemEqI_of_tyConvT hS hΓ c₁ (.pi .bot []) trivial).mp hcA
      exact lrTypeFamIN_trans_pi_bot_nil hW hdet
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN hW hdet hS F hΓ hA c₁ hcA)
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN hW hdet hS F hΓ hM c₂ hcM)

/-- **Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalTermFamIN E n` +
    `ShallowTypeSoundnessCtxI E n` + `WhDet E` (without `TypeSoundnessI`):**
    Because `piRowField` only probes at the shallow compact `.pi .bot []`, `ShallowTypeSoundnessCtxI`
    suffices to transport the probe across `TyConvT.trans`. -/
theorem piRowField_of_fundamentalTermFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN hW hdet hS F hΓ hPi hc
        (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- From `FundamentalTermFamIN E n`, `ShallowTypeSoundnessCtxI E n`, and `WhDet E`, any `TyConvT`
    chain preserves `LRTypeFamIN` at **every** shallow type compact `c` (`IsShallowTypeCpt c`),
    using `piRowField_of_fundamentalTermFamIN` inside `lrTypeFamIN_trans`. -/
theorem lrTypeFamIN_shallow_of_fundamentalTermFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {c : CptI} (hcpt : IsShallowTypeCpt c) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → ApproxI (ctxEnvI Γ) A c →
    LRTypeFamIN E n Γ A A' c
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort c (F.1 hΓ hA c hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort c (F.2 hΓ hc c hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hcM : ApproxI (ctxEnvI Γ) _ c :=
        (shallowTypeSemEqI_of_tyConvT hS hΓ c₁ c hcpt).mp hcA
      exact lrTypeFamIN_trans hW hdet
        (piRowField_of_fundamentalTermFamIN hW hdet hS F) hΓ
        (lrTypeFamIN_shallow_of_fundamentalTermFamIN hW hdet hS F hΓ hcpt hA c₁ hcA)
        (lrTypeFamIN_shallow_of_fundamentalTermFamIN hW hdet hS F hΓ hcpt hM c₂ hcM)

/-- **Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from `FundamentalTermFamIN E n` +
    `ShallowTypeSoundnessCtxI E n` + `WhDet E` (without `TypeSoundnessI` or `PiRowField`):**
    Probes `lrTypeFamIN_shallow_of_fundamentalTermFamIN` at the shallow spine compact
    `c = .spine r (botVecI xs)` (`isShallowTypeCpt_spine_botVecI`). -/
theorem famAppRow_of_fundamentalTermFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n) :
    FamAppRowLink E n :=
  fun {_} hΓ {r _ ls _ xs _ _} hm hind hty hc =>
    lrTypeFamIN_famApp_components hW hm hind
      (lrTypeFamIN_shallow_of_fundamentalTermFamIN hW hdet hS F hΓ
        (isShallowTypeCpt_spine_botVecI r xs) hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- **Derive `KernelRowsAssembly.FamRelevantSlotConv E n` (`W-F8-FAMAPP-ARG-COMPARISON`) from
    `FundamentalTermFamIN E n` + `ShallowTypeSoundnessCtxI E n` + `WhDet E`:**
    Probes `lrTypeFamIN_shallow_of_fundamentalTermFamIN` at `c = .spine r (botVecI xs)`. -/
theorem famRelevantSlotConv_of_fundamentalTermFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n) :
    FamRelevantSlotConv E n :=
  fun {_} hΓ {r _ ls _ xs _ _} hm hind hty hc =>
    lrTypeFamIN_famApp_relevantSlotConv hW hm hind
      (lrTypeFamIN_shallow_of_fundamentalTermFamIN hW hdet hS F hΓ
        (isShallowTypeCpt_spine_botVecI r xs) hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- **Assemble `TypedRowsWf E n` from `AllBelowScoped` + `WhDet` + `ShallowTypeSoundnessCtxI` +
    `FundamentalTermFamIN` (with zero `TypeSoundnessI`, `PiConvValleyData`, or `FamRelevantSlotConv`
    premises):**
    Supplies `sortRow` from `AllBelowScoped` and both `piRow` and `famAppRow` from
    `FundamentalTermFamIN` + `ShallowTypeSoundnessCtxI` + `WhDet`. -/
theorem typedRowsWf_of_allBelowScoped_fundamentalTermFamIN {E : ResolvedEnv}
    (hW : EnvWfT E) {Aw : Nat → Nat} (hBel : AllBelowScoped E Aw (tableOf hW))
    (hdet : WhDet E) {n : Nat}
    (hS : ShallowTypeSoundnessCtxI E n) (F : FundamentalTermFamIN E n) :
    TypedRowsWf E n where
  sortRow := sortRow_of_allBelowScoped_build hW hBel
  piRow := piRowField_of_fundamentalTermFamIN hW hdet hS F
  famAppRow := famAppRow_of_fundamentalTermFamIN hW hdet hS F


/-! ### §10. Soundness-Free `FundamentalTermFamIN` Bridge, Non-Propositional Π-Spine Boundary (`not_lrTermFamIN_spine_at_nonProp_pi`), and the Non-Sort-Spine Repaired Term Logical Relation (`LRTermFamIND` / `FundamentalTermFamIND`)

This section delivers four advances:
- **Part A (Soundness-Free Shallow Probe Extraction & Derivation of `PiRowField` / `FamAppRowLink` / `FamRelevantSlotConv` / `AdequacyFamICtx` / `TypedRowsWf` Without `ShallowTypeSoundnessCtxI`):**
  Proves `lrTypeFamIN_spine_change_args`, `approxI_ctxEnvI_sort_right_of_lrTypeFamIN`,
  `approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN`, and
  `approxI_ctxEnvI_famSpine_right_of_lrTypeFamIN`: at the shallow type probes `.sort`,
  `.pi .bot []`, and `.spine r args` (for an admitted `.inductiveM` family head `r`),
  `LRTypeFamIN E n Γ A B c` + `WhApproxInvCore E` directly implies `ApproxI (ctxEnvI Γ) B ...`
  without `TypeSoundnessI` or `ShallowTypeSoundnessCtxI`. Consequently,
  `piRowField_of_fundamentalTermFamIN_core`, `famAppRow_of_fundamentalTermFamIN_core`,
  `famRelevantSlotConv_of_fundamentalTermFamIN_core`, `adequacyFamICtx_of_fundamentalTermFamIN_core`,
  and `typedRowsWf_of_allBelowScoped_fundamentalTermFamIN_core` (+ `DT-010`, `DT-011`, `DT-012`,
  `DT-019`, `IA-024`) follow from `EnvWfT E` + `WhDet E` + `WhApproxInvCore E` +
  `FundamentalTermFamIN E n` alone.
- **Part B (Boundary of `LRTermFamIN` at Non-Propositional Π-Types & The Non-Sort-Spine Repaired Term Relation `LRTermFamIND`):**
  Proves `not_lrTermFamIN_spine_at_nonProp_pi` (showing why `LRTermFamIN`'s shallow-spine guard on
  `A` rejects `.spine r args` when `A = .pi A₁ B₁` is not sorted in `Prop`) and defines
  `LRTermFamIND`, replacing the shallow-spine guard on `A` with `∀ l, ¬ WhRedCtx E Γ A (.sort l)`
  (and introducing no unconstrained existential `Ts`).
- **Part C (Soundness-Free Index Transport `lrTermFamIND_transport`, Symmetry `lrTermFamIND_symm`, and Transitivity `lrTermFamIND_trans` Across All Compacts Including `.lam g`):**
  Proves `not_whRedCtx_sort_transport` and derives full index transport `lrTermFamIND_transport`
  (and `lrTermFamIND_transport_lam`), full symmetry `lrTermFamIND_symm`, and full transitivity
  `lrTermFamIND_trans` across all compacts `c : CptI` with **zero** `ShallowTypeSoundnessCtxI`
  or `TypeSoundnessI` premise.
- **Part D (Opaque Constants at Π-Types `lrTermFamIND_const_pi_diag`, All-Arity `.inductiveM` / `.constructorM` Constant & Spine Cases, Variable Substitutions, and Soundness-Free `TypedRowsWf` Bridge):**
  Proves `whNormalCtx_const_of_opaque`, `lrTermFamIND_const_pi_diag` (resolving `#7640` / `#7652`
  at all Π-types), **all-arity** `.inductiveM` and `.constructorM` constant and partial/saturated
  spine cases (`fundConvFamIND_consts_inductiveM`, `fundTermFamIND_const_inductiveM`,
  `fundConvFamIND_famSpine_partial_at_pi`, `fundConvFamIND_ctorSpines_at_pi`,
  `fundConvFamIND_ctorSpines_at_famApp`, `fundConvFamIND_consts_ctor_at_pi`), all variable
  substitution cases (`fundSubstFamIND_bvar_eq`, `fundSubstFamIND_bvar_lt`,
  `fundSubstFamIND_bvar_gt`), and the soundness-free derivations from `FundamentalTermFamIND`. -/


/-! #### Part A — Soundness-Free Shallow Probe Extraction (`lrTypeFamIN_spine_change_args`, `approxI_ctxEnvI_sort_right_of_lrTypeFamIN`, `approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN`, `approxI_ctxEnvI_famSpine_right_of_lrTypeFamIN`) & Derivation of `PiRowField` / `FamAppRowLink` / `FamRelevantSlotConv` / `AdequacyFamICtx` / `TypedRowsWf` Without `ShallowTypeSoundnessCtxI` -/

/-- In `LRTypeFamIN`, the compact argument list `args : List CptI` at `.spine r args` is
    unconstrained in both `famSpine` and `otherSpine`, so `LRTypeFamIN` at `.spine r args`
    transfers to `.spine r args'` for any `args' : List CptI`. -/
theorem lrTypeFamIN_spine_change_args {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {r : Nat} {args : List CptI} (args' : List CptI)
    (h : LRTypeFamIN E n Γ A B (.spine r args)) :
    LRTypeFamIN E n Γ A B (.spine r args') := by
  cases h with
  | famSpine hm hind hA hB htyA htyB hc heqN hlenA hlenB hargs =>
      exact .famSpine hm hind hA hB htyA htyB hc heqN hlenA hlenB hargs
  | otherSpine hnot hA hB hnA hnB hc =>
      exact .otherSpine hnot hA hB hnA hnB hc

/-- Under `WhApproxInvCore E`, `LRTypeFamIN E n Γ A B .sort` implies `ApproxI (ctxEnvI Γ) B .sort`,
    requiring **neither** `TypeSoundnessI` **nor** `ShallowTypeSoundnessCtxI`. -/
theorem approxI_ctxEnvI_sort_right_of_lrTypeFamIN {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {A B : Expr Nat}
    (h : LRTypeFamIN E n Γ A B .sort) :
    ApproxI (ctxEnvI Γ) B .sort := by
  cases h with
  | sort _ hB => exact approxI_ctxEnvI_sort_of_whRedCtx hcore hB

/-- Under `WhApproxInvCore E`, `LRTypeFamIN E n Γ A B (.pi .bot [])` implies
    `ApproxI (ctxEnvI Γ) B (.pi .bot [])`, requiring **neither** `TypeSoundnessI` **nor**
    `ShallowTypeSoundnessCtxI`. -/
theorem approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {A B : Expr Nat}
    (h : LRTypeFamIN E n Γ A B (.pi .bot [])) :
    ApproxI (ctxEnvI Γ) B (.pi .bot []) := by
  cases h with
  | pi _ hB _ _ _ _ _ => exact approxI_ctxEnvI_pi_of_whRedCtx hcore hB

/-- Under `WhApproxInvCore E`, for any admitted `.inductiveM` family head `r`,
    `LRTypeFamIN E n Γ A B (.spine r args)` implies
    `ApproxI (ctxEnvI Γ) B (.spine r (botVecI (piDomsOf m.mtype)))`, requiring **neither**
    `TypeSoundnessI` **nor** `ShallowTypeSoundnessCtxI`. -/
theorem approxI_ctxEnvI_famSpine_right_of_lrTypeFamIN {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {A B : Expr Nat}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {args : List CptI} (h : LRTypeFamIN E n Γ A B (.spine r args)) :
    ApproxI (ctxEnvI Γ) B (.spine r (botVecI (piDomsOf m.mtype))) := by
  cases h with
  | famSpine hm' _ _ hB _ _ _ _ _ hlenB _ =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      exact (approxI_ctxEnvI_whRedCtx hcore hB _).mpr
        (approxI_famApp_botVecI_of_length_eq (ctxEnvI Γ) r _ hlenB.symm)
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- From `FundamentalTermFamIN E n`, `WhApproxInvCore E`, and `WhDet E` alone (with **zero**
    `TypeSoundnessI` or `ShallowTypeSoundnessCtxI` premises), any `TyConvT E n Γ A A'` chain
    preserves `LRTypeFamIN` at the shallow Π-probe `.pi .bot []`. -/
theorem lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → ApproxI (ctxEnvI Γ) A (.pi .bot []) →
    LRTypeFamIN E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.pi .bot []) (F.1 hΓ hA (.pi .bot []) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.pi .bot []) (F.2 hΓ hc (.pi .bot []) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ := lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN_core hW hdet hcore F hΓ hA c₁ hcA
      have hcM : ApproxI (ctxEnvI Γ) _ (.pi .bot []) :=
        approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN hcore hLR₁
      exact lrTypeFamIN_trans_pi_bot_nil hW hdet hLR₁
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN_core hW hdet hcore F hΓ hM c₂ hcM)

/-- **Soundness-Free Derivation of `PiRowField E n` (`TypedRowsWf.piRow`) from
    `FundamentalTermFamIN E n` + `WhApproxInvCore E` + `WhDet E`:**
    Requires neither `TypeSoundnessI` nor `ShallowTypeSoundnessCtxI`. -/
theorem piRowField_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIN_core hW hdet hcore F hΓ hPi hc
        (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- From `FundamentalTermFamIN E n`, `WhApproxInvCore E`, and `WhDet E` alone (with **zero**
    `TypeSoundnessI` or `ShallowTypeSoundnessCtxI` premises), any `TyConvT E n Γ A A'` chain
    preserves `LRTypeFamIN` at `.spine r args` for every admitted `.inductiveM` family head `r`
    and any `args : List CptI`. -/
theorem lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → {args : List CptI} → ApproxI (ctxEnvI Γ) A (.spine r args) →
    LRTypeFamIN E n Γ A A' (.spine r args)
  | _, _, _, hA, .refl _ _, _, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.spine r _) (F.1 hΓ hA (.spine r _) hcA)
  | _, _, _, _, .of _ _ _ _ hc, _, hcA =>
      lrTypeFamIN_of_lrTermFamIN_sort (.spine r _) (F.2 hΓ hc (.spine r _) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, args, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ :=
        lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core hW hdet hcore F hm hind hΓ hA c₁ hcA
      have hcM : ApproxI (ctxEnvI Γ) _ (.spine r (botVecI (piDomsOf m.mtype))) :=
        approxI_ctxEnvI_famSpine_right_of_lrTypeFamIN hcore hm hind hLR₁
      have hLR₂_bot :=
        lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core hW hdet hcore F hm hind hΓ hM c₂ hcM
      have hLR₂ := lrTypeFamIN_spine_change_args args hLR₂_bot
      exact lrTypeFamIN_trans hW hdet
        (piRowField_of_fundamentalTermFamIN_core hW hdet hcore F) hΓ hLR₁ hLR₂

/-- **Soundness-Free Derivation of `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from
    `FundamentalTermFamIN E n` + `WhApproxInvCore E` + `WhDet E`:**
    Requires neither `TypeSoundnessI` nor `ShallowTypeSoundnessCtxI` nor `PiRowField`. -/
theorem famAppRow_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
