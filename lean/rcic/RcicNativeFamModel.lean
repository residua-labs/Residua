theorem whRedRecK_trueVarFam (n : Nat) :
    WhRedRecK trueEnvU n trueVarCtx trueVarFam (.const 0 []) :=
  whRedRecK_trueRecVar n (.succ .zero) (trueSortMotive .zero) (.const 0 [])

theorem whRedRecK_trueRecMajorBeta (n : Nat) (u : Level) (motive minor : Expr Nat) (Γ : LCtx) :
    WhRedRecK trueEnvU n Γ (trueRecMajorBeta u motive minor) minor :=
