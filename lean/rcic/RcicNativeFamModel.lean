/-! #### Part D — The Demand-Guarded Type Logical Relation (`LRTypeFamINB`) Across All Compacts `c : CptI` -/

/-- **Demand-Guarded Family-Injective Type Logical Relation (`LRTypeFamINB`):**
    Modifies `LRTypeFamIN` (§8) by guarding the `.pi` codomain recursion with
    `PiModelDeltaIotaAudit.BotDemand s.1` (`∀ s ∈ f, BotDemand s.1 → LRTypeFamINB E n (.assumption A₁ :: Γ) B₁ B₂ s.2`).
    - Coincides with `LRTypeFamIN` on `BotFamCpt E c` (`lrTypeFamINB_iff_lrTypeFamIN_of_botFamCpt`).
    - Satisfies `idPiPropSortStep` (`lrTypeFamINB_idPiProp_sortStep`) and `closedIrrPiCpt`
      (`lrTypeFamINB_closedIrrPi_cpt`) unconditionally across all compacts `c : CptI`. -/
inductive LRTypeFamINB (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeFamINB E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedCtx E Γ A (.sort u)) (h' : WhRedCtx E Γ A' (.sort u')) :
      LRTypeFamINB E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedCtx E Γ A (.pi A₁ B₁)) (h' : WhRedCtx E Γ A' (.pi A₂ B₂))
      (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeFamINB E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, PiModelDeltaIotaAudit.BotDemand s.1 →
        LRTypeFamINB E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeFamINB E n Γ A A' (.pi a f)
  | famSpine {Γ : LCtx} {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (h : WhRedCtx E Γ A (foldApps (.const r ls) xs))
      (h' : WhRedCtx E Γ A' (foldApps (.const r ls') xs'))
      (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
      (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
      (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = (piDomsOf m.mtype).length)
      (hlen' : xs'.length = (piDomsOf m.mtype).length)
      (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
      LRTypeFamINB E n Γ A A' (.spine r args)
  | otherSpine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
      (h : WhRedCtx E Γ A X) (h' : WhRedCtx E Γ A' X')
      (hX : WhNormalCtx E Γ X) (hX' : WhNormalCtx E Γ X')
      (hc : TyConvT E n Γ X X') :
      LRTypeFamINB E n Γ A A' (.spine r args)

/-- Every `LRTypeFamIN` derivation lifts to `LRTypeFamINB` at the same compact `c`. -/
theorem lrTypeFamINB_of_lrTypeFamIN {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamINB E n Γ A A' c := by
  induction h with
  | bot Γ A A' => exact .bot Γ A A'
  | sort h h' => exact .sort h h'
  | pi h h' hΓ₁ hdom hcod _ _ iha ihf =>
      exact .pi h h' hΓ₁ hdom hcod iha (fun s hs _ => ihf s hs)
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h h' hX hX' hc =>
      exact .otherSpine hnot h h' hX hX' hc

/-- On `BotFamCpt E c`, `LRTypeFamINB E n Γ A A' c` implies `LRTypeFamIN E n Γ A A' c`. -/
theorem lrTypeFamIN_of_lrTypeFamINB_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) (h : LRTypeFamINB E n Γ A A' c) :
    LRTypeFamIN E n Γ A A' c := by
  induction h with
  | bot Γ A A' => exact .bot Γ A A'
  | sort h h' => exact .sort h h'
  | pi h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hc with
      | pi ha hbd hf =>
          exact .pi h h' hΓ₁ hdom hcod (iha ha) (fun s hs => ihf s hs (hbd s hs) (hf s hs))
  | famSpine hm hind h h' hty hty' hc' heqN hlen hlen' hargs =>
      exact .famSpine hm hind h h' hty hty' hc' heqN hlen hlen' hargs
  | otherSpine hnot h h' hX hX' hc' =>
      exact .otherSpine hnot h h' hX hX' hc'

/-- On `BotFamCpt E c`, `LRTypeFamINB` and `LRTypeFamIN` are logically equivalent (`↔`). -/
theorem lrTypeFamINB_iff_lrTypeFamIN_of_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) :
    LRTypeFamINB E n Γ A A' c ↔ LRTypeFamIN E n Γ A A' c :=
  ⟨lrTypeFamIN_of_lrTypeFamINB_botFamCpt hc, lrTypeFamINB_of_lrTypeFamIN⟩

/-- **Positive Resolution of `idPiPropSortStep` in `LRTypeFamINB` (`lrTypeFamINB_idPiProp_sortStep`):**
    Unlike `LRTypeFamIN` (`not_lrTypeFamIN_idPiProp_sortStep`), `LRTypeFamINB` holds on
    `idPiProp` at `idPiPropSortStep = .pi .bot [([.sort], .sort)]` because `¬ BotDemand [.sort]`. -/
theorem lrTypeFamINB_idPiProp_sortStep (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINB E n [] PiModelDeltaIotaAudit.idPiProp
      PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiPropSortStep := by
  refine .pi (.refl _) (.refl _)
    (.assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero))
    (.refl [] (.sort .zero))
    (.refl [.assumption (.sort .zero)] (.bvar 0))
    (.bot [] _ _)
    (fun s hs hbd => ?_)
  rcases List.mem_singleton.mp hs with rfl
  have := hbd .sort (List.mem_singleton.mpr rfl)
  exact CptI.noConfusion this

/-- **Positive Resolution of `closedIrrPiCpt` in `LRTypeFamINB` (`lrTypeFamINB_closedIrrPi_cpt`):**
    Unlike `LRTypeFamIN` (`not_lrTypeFamIN_closedIrrPi`), `LRTypeFamINB` holds on
    `closedIrrPiL` / `closedIrrPiR` at `closedIrrPiCpt` because the step for `F` has non-`⊥`
    demand `[.lam [([.sort], .sort)]]`. -/
theorem lrTypeFamINB_closedIrrPi_cpt (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINB E n [] PiModelDeltaIotaAudit.closedIrrPiL
      PiModelDeltaIotaAudit.closedIrrPiR PiModelDeltaIotaAudit.closedIrrPiCpt := by
  let Γ₁ : LCtx := [.assumption (.sort .zero)]
  let Γ₂ : LCtx := .assumption (.pi (.bvar 0) (.sort .zero)) :: Γ₁
  let Γ₃ : LCtx := .assumption (.bvar 1) :: Γ₂
  let Γ₄ : LCtx := .assumption (.bvar 2) :: Γ₃
  have hΓ₁ : CtxWfT E n Γ₁ := .assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero)
  have hA₁ : HasTyT E n Γ₁ (.pi (.bvar 0) (.sort .zero)) (.sort (.imax .zero (.succ .zero))) :=
    .pi Γ₁ (.bvar 0) .zero (.sort .zero) (.succ .zero)
      (.bvar Γ₁ 0 (.sort .zero) rfl) (.sort _ .zero)
  have hΓ₂ : CtxWfT E n Γ₂ := .assumption Γ₁ _ _ hΓ₁ hA₁
  have hP : HasTyT E n Γ₄ (.bvar 3) (.sort .zero) := .bvar Γ₄ 3 (.sort .zero) rfl
  have hF : HasTyT E n Γ₄ (.bvar 2) (.pi (.bvar 3) (.sort .zero)) :=
    .bvar Γ₄ 2 (.pi (.bvar 3) (.sort .zero)) rfl
  have hp : HasTyT E n Γ₄ (.bvar 1) (.bvar 3) := .bvar Γ₄ 1 (.bvar 3) rfl
  have hq : HasTyT E n Γ₄ (.bvar 0) (.bvar 3) := .bvar Γ₄ 0 (.bvar 3) rfl
  have hbodyConv : ConvT E n Γ₄ (.app (.bvar 2) (.bvar 1)) (.app (.bvar 2) (.bvar 0)) (.sort .zero) :=
    .app Γ₄ (.bvar 2) (.bvar 2) (.bvar 1) (.bvar 0) (.bvar 3) (.sort .zero)
      (.refl Γ₄ (.bvar 2) _ hF) (.irr Γ₄ (.bvar 3) (.bvar 1) (.bvar 0) hP hp hq)
  have hcod₃ : ConvT E n Γ₃ (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))
      (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))) (.sort (.imax .zero .zero)) :=
    .pi Γ₃ _ _ _ _ .zero .zero (.refl Γ₃ _ _ (.bvar Γ₃ 2 (.sort .zero) rfl)) hbodyConv
  have hcod₂ : ConvT E n Γ₂ (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1))))
      (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))))
      (.sort (.imax .zero (.imax .zero .zero))) :=
    .pi Γ₂ _ _ _ _ .zero _ (.refl Γ₂ _ _ (.bvar Γ₂ 1 (.sort .zero) rfl)) hcod₃
  have hcod₁ : ConvT E n Γ₁
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))))
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0)))))
      (.sort (.imax (.imax .zero (.succ .zero)) (.imax .zero (.imax .zero .zero)))) :=
    .pi Γ₁ _ _ _ _ _ _ (.refl Γ₁ _ _ hA₁) hcod₂
  refine .pi (.refl _) (.refl _) hΓ₁ (.refl [] _) (.of Γ₁ _ _ _ hcod₁) (.bot [] _ _)
    (fun s₁ hs₁ _ => ?_)
  rcases List.mem_singleton.mp hs₁ with rfl
  refine .pi (.refl _) (.refl _) hΓ₂ (.refl Γ₁ _) (.of Γ₂ _ _ _ hcod₂) (.bot Γ₁ _ _)
    (fun s₂ hs₂ hbd₂ => ?_)
  rcases List.mem_singleton.mp hs₂ with rfl
  have := hbd₂ (.lam [([.sort], .sort)]) (List.mem_singleton.mpr rfl)
  exact CptI.noConfusion this

/-- Reading `LRTypeFamINB` at `.pi .bot []` for two syntactic Π-types yields component conversions. -/
theorem lrTypeFamINB_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeFamINB E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) :=
  lrTypeFamIN_pi_components (lrTypeFamIN_of_lrTypeFamINB_botFamCpt (botFamCpt_pi_bot_nil E) h)

/-- Reading `LRTypeFamINB` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    yields `eqNList ls ls'`, `xs.length = xs'.length`, and `ConvArgsT`. -/
theorem lrTypeFamINB_famApp_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINB E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  cases h with
  | famSpine hm' _ hred hred' _ _ _ heqN hlen hlen' hargs =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have e₁ := whRedCtx_famApp_eq hW hm hind hred
      have e₂ := whRedCtx_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs₁⟩ := foldApps_const_inj e₁.symm
      obtain ⟨hconst₂, hxs₂⟩ := foldApps_const_inj e₂.symm
      injection hconst₁ with _ hls₁
      injection hconst₂ with _ hls₂
      subst hls₁; subst hxs₁; subst hls₂; subst hxs₂
      exact ⟨heqN, hlen.trans hlen'.symm, hargs⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- Reading `LRTypeFamINB` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    also yields `RelevantSlotConv` (#7525). -/
theorem lrTypeFamINB_famApp_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINB E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' :=
  relevantSlotConv_of_convArgsT hW hm hind
    (lrTypeFamINB_famApp_components hW hm hind h).2.2


/-! ### §12 — Bidirectional `BotFamCpt E` Family Type Logical Relation Over `ApproxDI E (ctxEnvDI E Γ)` (`LRTypeFamINBiDI`), Weakening/Substitution Stability of `WhStepCtx`/`WhRedCtx`/`ConvArgsT`/`LRTypeFamIN`/`LRTypeFamINBiDI`, Related-Substitution Stability of `LRTermFamIND` (#7660), and `PEqDI` Family-Head Slot Calculus (#7656) -/

/-! #### Part A — Bidirectional `BotFamCpt E`-Restricted Family Type Logical Relation (`LRTypeFamINBiDI`) Over `ApproxDI E (ctxEnvDI E Γ)` & Discharged Cases -/

/-- Any bound variable `.bvar i` whose local context entry has `lookupValue Γ i = none`
    (i.e. `.assumption`-bound or out of bounds) has only `.bot` in `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDI_ctxEnvDI_bvar_of_lookupValue_none {E : ResolvedEnv} :
    ∀ {Γ : LCtx} {i : Nat} {c : CptI},
      lookupValue Γ i = none →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.bvar i) c → c = .bot
  | [], _, _, _, hb => by
      rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
      · rfl
      · exact h0
  | .assumption _ :: _, 0, _, _, hb => by
      rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
      · rfl
      · exact h0
  | .assumption _ :: Γ, j + 1, _, hlk, hb => by
      rw [lookupValue_cons_succ] at hlk
      have hlk' : lookupValue Γ j = none := by
        cases h : lookupValue Γ j with
        | none => rfl
        | some v => rw [h] at hlk; exact nomatch hlk
      rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
      · rfl
      · exact approxDI_ctxEnvDI_bvar_of_lookupValue_none hlk' (.bvar h0)
  | .letBinding _ _ :: _, 0, _, hlk, _ => nomatch hlk
  | .letBinding _ _ :: Γ, j + 1, _, hlk, hb => by
      rw [lookupValue_cons_succ] at hlk
      have hlk' : lookupValue Γ j = none := by
        cases h : lookupValue Γ j with
        | none => rfl
        | some v => rw [h] at hlk; exact nomatch hlk
      rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
      · rfl
      · exact approxDI_ctxEnvDI_bvar_of_lookupValue_none hlk' (.bvar h0)

/-- Any application spine `foldApps (.bvar i) xs` headed by an `.assumption`-bound variable
    (`lookupValue Γ i = none`) has only `.bot` in `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none {E : ResolvedEnv}
    {Γ : LCtx} {i : Nat} (hlk : lookupValue Γ i = none)
    (xs : List (Expr Nat)) {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.bvar i) xs) c) :
    c = .bot := by
  obtain ⟨d, hd, hfold⟩ :=
    (PiModelDeltaIotaAudit.approxDI_foldApps_iff E (ctxEnvDI E Γ) (.bvar i) xs c).mp h
  have hd_bot := approxDI_ctxEnvDI_bvar_of_lookupValue_none hlk hd
  subst hd_bot
  exact PiModelDeltaIotaAudit.foldAppCpt_bot_inv hfold

/-- Under `EnvWfT E`, any partially applied (or over-applied) admitted `.inductiveM` family spine
    `foldApps (.const r ls) xs` with `xs.length ≠ (piDomsOf m.mtype).length` has only `.bot` in
    `BotFamCpt E`. -/
theorem approxDI_famApp_botFamCpt_of_length_ne {E : ResolvedEnv} (hW : EnvWfT E)
    {ρ : EnvI} {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hne : xs.length ≠ (piDomsOf m.mtype).length)
    {c : CptI} (hc : BotFamCpt E c)
    (h : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) c) :
    c = .bot := by
  have hrig := rigidConst_of_inductiveM hW hm hind
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrig xs c).mp h with
    rfl | ⟨us, hus, rfl⟩
  · rfl
  · cases hc with
    | famSpine hm' _ hlenArgs _ =>
        rw [hm] at hm'
        injection hm' with hm_eq
        subst hm_eq
        exact (hne (hus.length_eq.symm.trans hlenArgs)).elim

/-- Any spine `foldApps (.const r ls) xs` headed by a `RigidConst E r` that is not an admitted
    `.inductiveM` family head (`∀ m, E.members r = some m → m.mclass ≠ .inductiveM`) has only
    `.bot` in `BotFamCpt E`. -/
theorem approxDI_nonFam_rigid_botFamCpt_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
    {c : CptI} (hc : BotFamCpt E c)
    (h : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) c) :
    c = .bot := by
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrig xs c).mp h with
    rfl | ⟨us, _, rfl⟩
  · rfl
  · cases hc with
    | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- **Bidirectional `BotFamCpt E`-Restricted Family Type Logical Relation Over `ApproxDI E`
    (`LRTypeFamINBiDI E n Γ A B`):**
    Extends `PiModelDeltaIotaAudit.LRTypeINBiDI` (#7656) to context-aware `ctxEnvDI E Γ` and
    family-aware `BotFamCpt E`: for every `BotFamCpt E c` approximating either `A` or `B` in
    `ApproxDI E (ctxEnvDI E Γ)`, `LRTypeFamIN E n Γ A B c` holds. -/
def LRTypeFamINBiDI (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A B : Expr Nat) : Prop :=
  ∀ c, BotFamCpt E c →
    (PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c ∨
     PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) B c) →
    LRTypeFamIN E n Γ A B c

/-- Any two `.bvar`s with `lookupValue Γ i = none` and `lookupValue Γ j = none` satisfy
    `LRTypeFamINBiDI E n Γ (.bvar i) (.bvar j)`. -/
theorem lrTypeFamINBiDI_bvar_of_lookupValue_none {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i j : Nat} (hi : lookupValue Γ i = none) (hj : lookupValue Γ j = none) :
    LRTypeFamINBiDI E n Γ (.bvar i) (.bvar j) := by
  intro c _ h
  rcases h with h | h
  · rw [approxDI_ctxEnvDI_bvar_of_lookupValue_none hi h]
    exact .bot _ _ _
  · rw [approxDI_ctxEnvDI_bvar_of_lookupValue_none hj h]
    exact .bot _ _ _

/-- Diagonal `.bvar i` case of `LRTypeFamINBiDI` for any `lookupValue Γ i = none`. -/
theorem lrTypeFamINBiDI_bvar_diag_of_lookupValue_none {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i : Nat} (hi : lookupValue Γ i = none) :
    LRTypeFamINBiDI E n Γ (.bvar i) (.bvar i) :=
  lrTypeFamINBiDI_bvar_of_lookupValue_none hi hi

/-- Any two `.bvar`-headed spines with `lookupValue Γ i = none` and `lookupValue Γ j = none`
    satisfy `LRTypeFamINBiDI E n Γ (foldApps (.bvar i) xs) (foldApps (.bvar j) ys)`. -/
theorem lrTypeFamINBiDI_foldApps_bvar {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i j : Nat} (hi : lookupValue Γ i = none) (hj : lookupValue Γ j = none)
    (xs ys : List (Expr Nat)) :
    LRTypeFamINBiDI E n Γ (foldApps (.bvar i) xs) (foldApps (.bvar j) ys) := by
  intro c _ h
  rcases h with h | h
  · rw [approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hi xs h]
    exact .bot _ _ _
  · rw [approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hj ys h]
    exact .bot _ _ _

/-- Conversion and diagonal `.sort` case of `LRTypeFamINBiDI` in arbitrary `Γ`. -/
theorem lrTypeFamINBiDI_sorts (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (l₁ l₂ : Level) :
    LRTypeFamINBiDI E n Γ (.sort l₁) (.sort l₂) := by
  intro c _ h
  rcases h with h | h
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv h with rfl | rfl
    · exact .bot _ _ _
    · exact lrTypeFamIN_sort_congr Γ l₁ l₂
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv h with rfl | rfl
    · exact .bot _ _ _
    · exact lrTypeFamIN_sort_congr Γ l₁ l₂

/-- Diagonal `.sort` case of `LRTypeFamINBiDI`. -/
theorem lrTypeFamINBiDI_sort_diag (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (l : Level) :
    LRTypeFamINBiDI E n Γ (.sort l) (.sort l) :=
  lrTypeFamINBiDI_sorts E n Γ l l

/-- Non-family `RigidConst` spines satisfy `LRTypeFamINBiDI` unconditionally (their only
    `BotFamCpt E` compact is `.bot`). -/
theorem lrTypeFamINBiDI_nonFam_rigid_spine {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (hrig' : PiModelDeltaIotaAudit.RigidConst E r')
    (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
    (hnot' : ∀ m, E.members r' = some m → m.mclass ≠ .inductiveM) :
    LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') := by
  intro c hc h
  rcases h with h | h
  · rw [approxDI_nonFam_rigid_botFamCpt_eq_bot hrig hnot hc h]
    exact .bot _ _ _
  · rw [approxDI_nonFam_rigid_botFamCpt_eq_bot hrig' hnot' hc h]
    exact .bot _ _ _

/-- Non-family `RigidConst` constants satisfy `LRTypeFamINBiDI` unconditionally. -/
theorem lrTypeFamINBiDI_nonFam_rigid_const {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} (ls ls' : List Level)
    (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (hrig' : PiModelDeltaIotaAudit.RigidConst E r')
    (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
    (hnot' : ∀ m, E.members r' = some m → m.mclass ≠ .inductiveM) :
    LRTypeFamINBiDI E n Γ (.const r ls) (.const r' ls') :=
  lrTypeFamINBiDI_nonFam_rigid_spine (xs := []) (xs' := []) hrig hrig' hnot hnot'

/-- Under `EnvWfT E`, any two partially applied `.inductiveM` family spines
    (`xs.length ≠ (piDomsOf m.mtype).length` and `xs'.length ≠ (piDomsOf m'.mtype).length`)
    satisfy `LRTypeFamINBiDI` unconditionally (their only `BotFamCpt E` compact is `.bot`). -/
theorem lrTypeFamINBiDI_famSpine_partial {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r r' : Nat} {m m' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (hne : xs.length ≠ (piDomsOf m.mtype).length)
    (hne' : xs'.length ≠ (piDomsOf m'.mtype).length) :
    LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') := by
  intro c hc h
  rcases h with h | h
  · rw [approxDI_famApp_botFamCpt_of_length_ne hW hm hind hne hc h]
    exact .bot _ _ _
  · rw [approxDI_famApp_botFamCpt_of_length_ne hW hm' hind' hne' hc h]
    exact .bot _ _ _

/-- **Saturated `.inductiveM` Family Spine Case of `LRTypeFamINBiDI` from `ConvArgsT`
    (`lrTypeFamINBiDI_famSpine_of_convArgsT`):**
    Under `EnvWfT E`, if `foldApps (.const r ls) xs` and `foldApps (.const r ls') xs'` are
    sort-typed and convertible with `eqNList ls ls'`, `xs.length = (piDomsOf m.mtype).length`,
    `xs'.length = (piDomsOf m.mtype).length`, and `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'`,
    then `LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')` holds. -/
theorem lrTypeFamINBiDI_famSpine_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)} {w w' : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') := by
  have hrig := rigidConst_of_inductiveM hW hm hind
  intro c _ h
  rcases h with h | h
  · rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrig xs c).mp h with
      rfl | ⟨us, _, rfl⟩
    · exact .bot _ _ _
    · exact lrTypeFamIN_famSpine_congr us hm hind hty hty' hc heqN hlen hlen' hargs
  · rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls' hrig xs' c).mp h with
      rfl | ⟨us, _, rfl⟩
    · exact .bot _ _ _
    · exact lrTypeFamIN_famSpine_congr us hm hind hty hty' hc heqN hlen hlen' hargs

/-- **Saturated `.inductiveM` Family Spine Case of `LRTypeFamINBiDI` from `RelevantSlotConv`
    (`lrTypeFamINBiDI_famSpine_of_relevantSlotConv`):** -/
theorem lrTypeFamINBiDI_famSpine_of_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ) (hpi : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hslot : RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs') :
    LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') := by
  obtain ⟨w', hty'⟩ := tyConvT_endTyped hW hΓ hc hty
  have hargs := (convArgsT_iff_relevantSlotConv hW hΓ hpi hm hind heqN hlen hlen' hty hc).mpr hslot
  exact lrTypeFamINBiDI_famSpine_of_convArgsT hW hm hind hty hty' hc heqN hlen hlen' hargs

/-- Diagonal saturated `.inductiveM` family spine case of `LRTypeFamINBiDI`. -/
theorem lrTypeFamINBiDI_famSpine_diag {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ) (hpi : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    {xs : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hlen : xs.length = (piDomsOf m.mtype).length) :
    LRTypeFamINBiDI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls) xs) := by
  have heqN : eqNList ls ls := eqNList_refl ls
  have hpiInst := instMtype_policyPi_of_inductiveM hW hm hind ls
  have hlenD : ((piDomsOf m.mtype).map (instantiateLevels ls)).length = xs.length := by
    rw [List.length_map, hlen]
  obtain ⟨⟨_, _, hargsTy, _⟩⟩ := hasTyT_spineInv_rows hW hpi hΓ hm hpiInst xs hlenD hty
  have hslot : RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs := by
    intro i x x' d _ hx hx' hd _ _
    have hxx' : x = x' := Option.some.inj (hx.symm.trans hx')
    subst hxx'
    exact ⟨.refl Γ x (instPrefix ([] ++ xs.take i) d) (hargsTy i x d hx hd)⟩
  exact lrTypeFamINBiDI_famSpine_of_relevantSlotConv hW hΓ hpi hm hind hty
    (.refl Γ _) heqN hlen hlen hslot

/-- **The `.pi` Congruence Case of `LRTypeFamINBiDI` in Arbitrary Contexts `Γ` (`lrTypeFamINBiDI_pi`):**
    Because `BotFamCpt E (.pi a f)` forces `BotDemand s.1` for every step `s ∈ f`,
    `approxDI_cons_botDemand_ctxEnvDI_iff` reduces `EnvI.cons (demand s.1) (ctxEnvDI E Γ)`
    directly to `ctxEnvDI E (.assumption A₁ :: Γ)` (and `ctxEnvDI E (.assumption A₂ :: Γ)`, which
     equals `EnvI.cons botSetI (ctxEnvDI E Γ) = ctxEnvDI E (.assumption A₁ :: Γ)`!). Thus `.pi`
    closes from `ihA` and `ihB` in arbitrary `Γ` (including contexts with `letBinding`s!) without
    related substitutions. -/
theorem lrTypeFamINBiDI_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat}
    (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
    (hdom : TyConvT E n Γ A₁ A₂)
    (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
    (ihA : LRTypeFamINBiDI E n Γ A₁ A₂)
    (ihB : LRTypeFamINBiDI E n (.assumption A₁ :: Γ) B₁ B₂) :
    LRTypeFamINBiDI E n Γ (.pi A₁ B₁) (.pi A₂ B₂) := by
  intro c hc h
  rcases h with h₁ | h₂
  · rcases PiModelDeltaIotaAudit.approxDI_pi_inv h₁ with rfl | ⟨a, f, rfl, ha, hf⟩
    · exact .bot _ _ _
    · cases hc with
      | pi hca hbd hcf =>
          refine lrTypeFamIN_pi_congr hΓ₁ hdom hcod (ihA a hca (Or.inl ha)) (fun s hs => ?_)
          have hb := (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₁ s.2).mp (hf s hs)
          exact ihB s.2 (hcf s hs) (Or.inl hb)
  · rcases PiModelDeltaIotaAudit.approxDI_pi_inv h₂ with rfl | ⟨a, f, rfl, ha, hf⟩
    · exact .bot _ _ _
    · cases hc with
      | pi hca hbd hcf =>
          refine lrTypeFamIN_pi_congr hΓ₁ hdom hcod (ihA a hca (Or.inr ha)) (fun s hs => ?_)
          have hb := (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₂ s.2).mp (hf s hs)
          exact ihB s.2 (hcf s hs) (Or.inr hb)

/-- Diagonal `.pi A B` case of `LRTypeFamINBiDI`. -/
theorem lrTypeFamINBiDI_pi_diag {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (hΓ₁ : CtxWfT E n (.assumption A :: Γ))
    (ihA : LRTypeFamINBiDI E n Γ A A)
    (ihB : LRTypeFamINBiDI E n (.assumption A :: Γ) B B) :
    LRTypeFamINBiDI E n Γ (.pi A B) (.pi A B) :=
  lrTypeFamINBiDI_pi hΓ₁ (.refl Γ A) (.refl (.assumption A :: Γ) B) ihA ihB

/-- Weak-head step conversion in `LRTypeFamINBiDI` from the diagonal on the contractum under
    `EnvWfT E` alone (including `beta`, `zeta`, `zetaLocal`, `delta`, `iota`, `lit`, `appHead`). -/
theorem lrTypeFamINBiDI_of_whStepCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hs : WhStepCtx E Γ M M')
    (hdiag : LRTypeFamINBiDI E n Γ M' M') :
    LRTypeFamINBiDI E n Γ M M' := by
  intro c hc h
  have hM' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M' c :=
    h.elim (fun hM => (approxDI_ctxEnvDI_whStepCtx_of_envWfT hW hs c).mp hM) id
  exact lrTypeFamIN_expand (.step hs (.refl _)) (.refl _) (hdiag c hc (Or.inl hM'))

/-- Diagonal weak-head step reduction in `LRTypeFamINBiDI` under `EnvWfT E` alone. -/
theorem lrTypeFamINBiDI_diag_of_whStepCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hs : WhStepCtx E Γ M M')
    (hdiag : LRTypeFamINBiDI E n Γ M' M') :
    LRTypeFamINBiDI E n Γ M M := by
  intro c hc h
  have hM : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M c := h.elim id id
  have hM' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M' c :=
    (approxDI_ctxEnvDI_whStepCtx_of_envWfT hW hs c).mp hM
  exact lrTypeFamIN_expand (.step hs (.refl _)) (.step hs (.refl _)) (hdiag c hc (Or.inl hM'))

