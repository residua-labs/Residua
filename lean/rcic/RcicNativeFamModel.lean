  | refl => rfl
  | step hs _ => exact (whStepRecKCanon_famApp_false hW hm hind hs).elim

theorem whStepRecKCanon_ctorApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
