/-- **Coherence-Free and `PiRowField`-Free Chain-from-Links Assembly of
    `FundamentalLRFamINProbeRKCanon E n` (`fundamentalLRFamINProbeRKCanon_of_links`):**
    Under `EnvWfT E` **alone** (with **zero** `WhDet`, `WhNormalUnique`, `WhPiCoh`, `WhFamCoh`, or
    `PiRowField` hypotheses!), reduces `FundamentalLRFamINProbeRKCanon E n` along arbitrary
    `TyConvT` chains (`refl`, `of`, `trans`) to its diagonal (`hdiag`) and single-link `ConvT`
    (`hlink`) cases! -/
theorem fundamentalLRFamINProbeRKCanon_of_links {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hdiag : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      ∀ c, FamProbeCpt E c → ApproxDIKCanon E Γ A c →
        LRTypeFamINRKCanon E n Γ A A c)
    (hlink : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A B : Expr Nat} {u : Level},
      ConvT E n Γ A B (.sort u) →
      ∀ c, FamProbeCpt E c → ApproxDIKCanon E Γ A c →
        LRTypeFamINRKCanon E n Γ A B c) :
    FundamentalLRFamINProbeRKCanon E n := by
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A => intro u hA c hcpt hcA; exact hdiag hΓ hA c hcpt hcA
  | of A B v hc => intro _ _ c hcpt hcA; exact hlink hΓ hc c hcpt hcA
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxDIKCanon_right_of_lrTypeFamINRKCanon_famProbeCpt hW hcpt r₁
      exact lrTypeFamINRKCanon_trans_of_envWfT hW hΓ r₁ (ih₂ hM c hcpt hcM)

