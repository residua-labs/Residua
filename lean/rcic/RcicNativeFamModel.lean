/-- **`PiRowField`-Free Transitivity of `LRTypeFamINRK` at `.spine r args ∈ BotFamCpt E`
    Under `WhFamCohRecK` (`lrTypeFamINRK_trans_famSpine_of_coh_envWfT`):** -/
theorem lrTypeFamINRK_trans_famSpine_of_coh_envWfT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcoh : WhFamCohRecK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat} {r : Nat} {args : List CptI}
    (hcpt : BotFamCpt E (.spine r args))
    (h₁ : LRTypeFamINRK E n Γ A B (.spine r args))
    (h₂ : LRTypeFamINRK E n Γ B C (.spine r args)) :
    LRTypeFamINRK E n Γ A C (.spine r args) := by
  cases h₁ with
  | @famSpine _ _ _ _ m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ _ hm₁ hind₁ hA hB₁ hty₁ hty₂ hc₁ heqN₁ hlen₁ hlen₂ hargs₁ =>
      cases h₂ with
      | @famSpine _ _ _ _ m₂ ls₂' ls₃ xs₂' xs₃ w₂' w₃ _ hm₂ _ hB₂ hC hty₂' hty₃ hc₂ heqN₂ hlen₂' hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          obtain ⟨⟨hcM⟩, heqNM, hargsM⟩ := hcoh hΓ hm₁ hind₁ hB₁ hB₂ hty₂ hty₂' hlen₂ hlen₂'
          have heqN₁' : eqNList ls₁ ls₂' := eqNList_trans heqN₁ heqNM
          have hargs₁' : ConvArgsT E n Γ (instantiateLevels ls₁ m₁.mtype) xs₁ xs₂' :=
            convArgs_trans_instMtype_of_envWfT hW hΓ hm₁ hind₁ hty₁ hty₂ heqN₁ hargs₁ hargsM
          exact .famSpine hm₁ hind₁ hA hC hty₁ hty₃
            (.trans _ _ _ _ (.trans _ _ _ _ hc₁ hcM) hc₂)
            (eqNList_trans heqN₁' heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype_of_envWfT hW hΓ hm₁ hind₁ hty₁ hty₂' heqN₁' hargs₁' hargs₂)
      | otherSpine hnot _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | otherSpine hnot _ _ _ =>
      cases hcpt with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- **`PiRowField`-Free Transitivity of `LRTypeFamINRK` Across `FamProbeCpt E`
    Under `WhPiCohRecK` & `WhFamCohRecK` (`lrTypeFamINRK_trans_famProbeCpt_of_coh_envWfT`):** -/
theorem lrTypeFamINRK_trans_famProbeCpt_of_coh_envWfT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpiCoh : WhPiCohRecK E n) (hfamCoh : WhFamCohRecK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c)
    (h₁ : LRTypeFamINRK E n Γ A B c) (h₂ : LRTypeFamINRK E n Γ B C c) :
    LRTypeFamINRK E n Γ A C c := by
  cases hc with
  | bot => exact .bot Γ A C
  | sort => exact lrTypeFamINRK_trans_sort h₁ h₂
  | pi_bot_nil => exact lrTypeFamINRK_trans_pi_bot_nil_of_coh hW hpiCoh hΓ h₁ h₂
  | famSpine hm hind hlen hbd =>
      exact lrTypeFamINRK_trans_famSpine_of_coh_envWfT hW hfamCoh hΓ
        (.famSpine hm hind hlen hbd) h₁ h₂


/-! #### Part B — Canonical Deterministic Fieldful + Field-Free K-Readback (`WhStepRecKCanon`, `WhRedRecKCanon`, `ApproxDIKCanon`, `LRTypeFamINRKCanon`, `FundamentalLRFamINProbeRKCanon`) -/

/-- Closed neutral expression `(λ (_ : Sort 0), bvar 0) (Sort 0)` whose `ApproxDI` compact set is
    `{.bot}` (`approxDI_famBotClosedExpr_iff`) and which serves as the canonical field placeholder in
    `WhStepRecKCanon.pmajorCanon`. -/
def famBotClosedExpr : Expr Nat :=
  .app (.lam (.sort .zero) (.bvar 0)) (.sort .zero)

theorem exprClosedAt_famBotClosedExpr (d : Nat) :
    exprClosedAt d famBotClosedExpr = true := by
  simp [famBotClosedExpr, exprClosedAt]

/-- Canonical `IotaWitness andEnvU` for `And.rec.{u} a b mot min (And.intro a b famBotClosedExpr famBotClosedExpr)`
    with `ctorIdx = 0` and `fields = [famBotClosedExpr, famBotClosedExpr]`. -/
noncomputable def andCanonIotaWitness (u : Level) (mot min : Expr Nat) : IotaWitness andEnvU :=
  andIotaWitness u mot min famBotClosedExpr famBotClosedExpr

/-- **Uniqueness of `iotaRhsOf w` Under Canonical `pmajorCanon` Parameters (`pmajorCanon_iotaRhsOf_unique`):**
    Any two `IotaWitness E` witnesses `w₁, w₂` sharing `(recRef, ls, preMajor)` with `ctorIdx = 0`
    and `fields = List.replicate fields.length famBotClosedExpr` have **identical** right-hand sides
    `iotaRhsOf w₁ = iotaRhsOf w₂` (with **zero** environment hypotheses!). -/
theorem pmajorCanon_iotaRhsOf_unique {E : ResolvedEnv} (w₁ w₂ : IotaWitness E)
    (hrec : w₁.recRef = w₂.recRef) (hls : w₁.ls = w₂.ls) (hpre : w₁.preMajor = w₂.preMajor)
    (hidx₁ : w₁.ctorIdx = 0) (hidx₂ : w₂.ctorIdx = 0)
    (hflds₁ : w₁.fields = List.replicate w₁.fields.length famBotClosedExpr)
    (hflds₂ : w₂.fields = List.replicate w₂.fields.length famBotClosedExpr) :
    iotaRhsOf w₁ = iotaRhsOf w₂ := by
  have hmemr : w₁.recMember = w₂.recMember := by
    have a := w₁.hrec
    have b := w₂.hrec
    rw [← hrec] at b
    exact Option.some.inj (a.symm.trans b)
  have hrecBodyEq : w₁.recBody = w₂.recBody := by
    have a := w₁.hpeelRec
    have b := w₂.hpeelRec
    rw [w₁.hnmin] at a
    rw [w₂.hnmin, ← hmemr] at b
    exact congrArg Prod.snd (Option.some.inj (a.symm.trans b))
  have hspine :
      (Expr.bvar (w₁.nMinors + w₁.nindices + 1) : Expr Nat) =
        Expr.bvar (w₂.nMinors + w₂.nindices + 1) ∧
      ((List.range w₁.nindices).reverse.map (fun i => Expr.bvar (i + 1)) ++ [Expr.bvar 0] : List (Expr Nat)) =
        (List.range w₂.nindices).reverse.map (fun i => Expr.bvar (i + 1)) ++ [Expr.bvar 0] := by
    have eq := w₁.hrecBody.symm.trans (hrecBodyEq.trans w₂.hrecBody)
    have s₁ := appsSpine_foldApps
      (.bvar (w₁.nMinors + w₁.nindices + 1) : Expr Nat)
      ((List.range w₁.nindices).reverse.map (fun i => Expr.bvar (i + 1)) ++ [Expr.bvar 0])
    have s₂ := appsSpine_foldApps
      (.bvar (w₂.nMinors + w₂.nindices + 1) : Expr Nat)
      ((List.range w₂.nindices).reverse.map (fun i => Expr.bvar (i + 1)) ++ [Expr.bvar 0])
    simp only [appsSpine_bvar, List.nil_append] at s₁ s₂
    have hs := congrArg appsSpine eq
    rw [s₁, s₂] at hs
    injection hs with hhead hargs
    exact ⟨hhead, hargs⟩
  have hnidx : w₁.nindices = w₂.nindices := by
    have hlen := congrArg List.length hspine.2
    simp only [List.length_append, List.length_map, List.length_reverse,
      List.length_range, List.length_singleton] at hlen
    omega
  have hnmin : w₁.nMinors = w₂.nMinors := by
    injection hspine.1 with hsum
    omega
  have hfam : w₁.familyRef = w₂.familyRef := by
    have a := w₁.hrecIdx
    have b := w₂.hrecIdx
    rw [← hrec, ← hnmin] at b
    omega
  have hmemf : w₁.famMember = w₂.famMember := by
    have a := w₁.hfam
    have b := w₂.hfam
    rw [← hfam] at b
    exact Option.some.inj (a.symm.trans b)
  have hnpar : w₁.nparams = w₂.nparams := by
    have a := w₁.hnidx
    have b := w₂.hnidx
    rw [hmemf] at a
    omega
  have hidx : w₁.ctorIdx = w₂.ctorIdx := hidx₁.trans hidx₂.symm
  have hctor : w₁.ctorRef = w₂.ctorRef := by
    have a := w₁.hctorIdx
    have b := w₂.hctorIdx
    rw [← hfam, ← hidx] at b
    omega
  have hmemc : w₁.ctorMember = w₂.ctorMember := by
    have a := w₁.hctor
    have b := w₂.hctor
    rw [← hctor] at b
    exact Option.some.inj (a.symm.trans b)
  have hfldsLen : w₁.fields.length = w₂.fields.length := by
    have a := w₁.hnpar
    have b := w₂.hnpar
    rw [hmemc] at a
    omega
  have hfields : w₁.fields = w₂.fields := by
    rw [hflds₁, hflds₂, hfldsLen]
  have hpeelEq : w₁.ctorDoms = w₂.ctorDoms ∧ w₁.ctorResult = w₂.ctorResult := by
    have a := w₁.hpeel
    have b := w₂.hpeel
    rw [w₁.hnpar] at a
    rw [w₂.hnpar, ← hmemc] at b
    have eq := Option.some.inj (a.symm.trans b)
    exact ⟨congrArg Prod.fst eq, congrArg Prod.snd eq⟩
  have hkinds : w₁.kinds = w₂.kinds := by
    have a := w₁.hkinds
    have b := w₂.hkinds
    rw [← hfam, ← hnpar, ← hpeelEq.1] at b
    exact Option.some.inj (a.symm.trans b)
  have hctorAfter : w₁.ctorAfterParams = w₂.ctorAfterParams := by
    have a := w₁.hctorAfter
    have b := w₂.hctorAfter
    rw [← hpre, ← hnpar, ← hls, ← hmemc] at b
    exact Option.some.inj (a.symm.trans b)
  have hminor : w₁.minor = w₂.minor := by
    have a := w₁.hminor
    have b := w₂.hminor
    rw [← hpre, ← hnpar, ← hidx] at b
    exact Option.some.inj (a.symm.trans b)
  unfold iotaRhsOf
  rw [hminor, hrec, hls, hpre, hnpar, hnmin, hfields, hkinds, hctorAfter]

/-- **Canonical Deterministic K + Recursor-Major Weak-Head Step (`WhStepRecKCanon E Γ`):**
    Extends `WhStepRecCtx E Γ` by `pmajorCanon`, which fires on a proposition-family recursor
    (`piBody w.famMember.mtype = .sort .zero`) applied to an assumption-headed major spine
    `foldApps (.bvar i) margs` (`lookupValue Γ i = none`) using the unique canonical constructor
    choice `w.ctorIdx = 0` and canonical field vector
    `w.fields = List.replicate w.fields.length famBotClosedExpr`. -/
inductive WhStepRecKCanon (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | beta (A body arg : Expr Nat) :
      WhStepRecKCanon E Γ (.app (.lam A body) arg) (instantiate0 arg body)
  | zeta (A v body : Expr Nat) :
      WhStepRecKCanon E Γ (.letE A v body) (instantiate0 v body)
  | zetaLocal {i : Nat} {v : Expr Nat} (h : lookupValue Γ i = some v) :
      WhStepRecKCanon E Γ (.bvar i) v
  | delta {c : Nat} {ls : List Level} {m : CheckedMember} {body : Expr Nat}
      (hres : E.members c = some m) (hbody : m.body = some body) :
      WhStepRecKCanon E Γ (.const c ls) (instantiateLevels ls body)
  | iota {lhs rhs : Expr Nat} (hI : DerivedIotaU E lhs rhs) :
      WhStepRecKCanon E Γ lhs rhs
  | lit (t : Nat) :
      WhStepRecKCanon E Γ (.lit t) (natExpand t)
  | pmajorCanon (w : IotaWitness E) (i : Nat) (margs : List (Expr Nat))
      (hprop : piBody w.famMember.mtype = .sort .zero)
      (hidx : w.ctorIdx = 0)
      (hflds : w.fields = List.replicate w.fields.length famBotClosedExpr)
      (hnone : lookupValue Γ i = none) :
      WhStepRecKCanon E Γ
        (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs))
        (iotaRhsOf w)
  | appHead {f f' a : Expr Nat} (hf : WhStepRecKCanon E Γ f f') :
      WhStepRecKCanon E Γ (.app f a) (.app f' a)
  | recMajor {r : Nat} {m : CheckedMember} {ls : List Level}
      {pre : List (Expr Nat)} {major major' : Expr Nat}
      (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
      (hlen : pre.length + 1 = piCount m.mtype)
      (hmaj : WhStepRecKCanon E Γ major major') :
      WhStepRecKCanon E Γ (.app (foldApps (.const r ls) pre) major)
        (.app (foldApps (.const r ls) pre) major')

/-- Reflexive-transitive closure of `WhStepRecKCanon E Γ`. -/
inductive WhRedRecKCanon (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | refl (e : Expr Nat) : WhRedRecKCanon E Γ e e
  | step {a b c : Expr Nat} :
      WhStepRecKCanon E Γ a b → WhRedRecKCanon E Γ b c → WhRedRecKCanon E Γ a c

/-- Normal-form predicate for `WhStepRecKCanon E Γ`. -/
def WhNormalRecKCanon (E : ResolvedEnv) (Γ : LCtx) (e : Expr Nat) : Prop :=
  ∀ e', ¬ WhStepRecKCanon E Γ e e'

theorem whRedRecKCanon_trans {E : ResolvedEnv} {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedRecKCanon E Γ a b) (h₂ : WhRedRecKCanon E Γ b c) :
    WhRedRecKCanon E Γ a c := by
  induction h₁ with
  | refl => exact h₂
  | step hs _ ih => exact .step hs (ih h₂)

/-- Every `WhStepRecCtx E Γ` step lifts directly to `WhStepRecKCanon E Γ`. -/
theorem whStepRecCtx_to_whStepRecKCanon {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepRecCtx E Γ a b) : WhStepRecKCanon E Γ a b := by
  induction h with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | zetaLocal hv => exact .zetaLocal hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih
  | recMajor hm hrec hlen _ ih => exact .recMajor hm hrec hlen ih

theorem whRedRecCtx_to_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedRecCtx E Γ a b) : WhRedRecKCanon E Γ a b := by
  induction h with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepRecCtx_to_whStepRecKCanon hs) ih

theorem whRedCtx_to_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) : WhRedRecKCanon E Γ a b :=
  whRedRecCtx_to_whRedRecKCanon (whRedCtx_to_whRedRecCtx h)

/-- Normal-form preservation for `.sort`, `.pi`, `.lam`, assumption-headed spines, `.inductiveM`
    family spines, and `.constructorM` constructor spines under `WhStepRecKCanon`. -/
theorem whStepRecKCanon_sort_false {E : ResolvedEnv} {Γ : LCtx} {u : Level} {e : Expr Nat}
    (h : WhStepRecKCanon E Γ (.sort u) e) : False := by
  cases h with
  | iota hI =>
      obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
      simp [recCall, foldApps_snoc] at hl

theorem whNormalRecKCanon_sort {E : ResolvedEnv} {Γ : LCtx} (u : Level) :
    WhNormalRecKCanon E Γ (.sort u) :=
  fun _ hs => whStepRecKCanon_sort_false hs

theorem whRedRecKCanon_sort_eq {E : ResolvedEnv} {Γ : LCtx} {u : Level} {X : Expr Nat}
    (h : WhRedRecKCanon E Γ (.sort u) X) : X = .sort u := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecKCanon_sort_false hs).elim

theorem whStepRecKCanon_pi_false {E : ResolvedEnv} {Γ : LCtx} {A B e : Expr Nat}
