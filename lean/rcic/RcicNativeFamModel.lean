theorem whNormalRecKCanon_ctorApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalRecKCanon E Γ (foldApps (.const c ls) xs) :=
  fun _ hs => whStepRecKCanon_ctorApp_false hW hm hctor hs

theorem whRedRecKCanon_ctorApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {X : Expr Nat}
    (h : WhRedRecKCanon E Γ (foldApps (.const c ls) xs) X) :
    X = foldApps (.const c ls) xs := by
