  · have r₂ := h₂ c hc (Or.inr hC)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt hW hc r₂).1
    exact lrTypeFamINR_trans_envWfT hW hΓ (h₁ c hc (Or.inr hB)) r₂

/-- **`PiRowField`-Free Symmetry of `LRTypeFamINRK` (`lrTypeFamINRK_symm_of_envWfT`):** -/
theorem lrTypeFamINRK_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINRK E n Γ A A' c) :
    LRTypeFamINRK E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
