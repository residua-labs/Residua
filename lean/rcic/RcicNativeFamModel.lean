    {ρ : EnvI} {i j : Nat} (hji : j < i) {sub sub' T : Expr Nat}
    (hdiag : ∀ c, PiModelDeltaIotaAudit.ApproxDI E
      (EnvI.insert ρ j (PiModelDeltaIotaAudit.denDI E (EnvI.drop ρ j) sub)) (.bvar i) c →
      LRTermFamINDRKCanon E n Γ (.bvar (i - 1)) (.bvar (i - 1)) T c) :
    ∀ c, PiModelDeltaIotaAudit.ApproxDI E ρ (instantiate j (lift 0 j sub) (.bvar i)) c →
      LRTermFamINDRKCanon E n Γ (instantiate j (lift 0 j sub) (.bvar i))
        (instantiate j (lift 0 j sub') (.bvar i)) T c := by
  intro c hmem
  have hlook : PiModelDeltaIotaAudit.ApproxDI E
      (EnvI.insert ρ j (PiModelDeltaIotaAudit.denDI E (EnvI.drop ρ j) sub)) (.bvar i) c :=
    (PiModelDeltaIotaAudit.approxDI_subst_iff E ρ j sub (.bvar i) c).mp hmem
  have hne : i ≠ j := Nat.ne_of_gt hji
  have hL : instantiate j (lift 0 j sub) (.bvar i) = .bvar (i - 1) := by
    simp only [instantiate, hne, hji, if_false, if_true]
  have hR : instantiate j (lift 0 j sub') (.bvar i) = .bvar (i - 1) := by
    simp only [instantiate, hne, hji, if_false, if_true]
  rw [hL, hR]
  exact hdiag c hlook


