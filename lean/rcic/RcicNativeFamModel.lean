/-! ### §9 — Constructor-Spine Normal Forms (`CtorNoBody`, `whNormalCtx_ctorApp`), Context-Aware Split-Spine & Prop-Collapsed Term Logical Relation (`LRTermFamIN`) Over `LRTypeFamIN`, Full Index Transport (`lrTermFamIN_transport`, Including `.lam g`), Symmetry (`lrTermFamIN_symm`), Transitivity (`lrTermFamIN_trans`), and Discharged `FundamentalTermFamIN` Cases (#7634/#7640/#7641/#7648)

In `RcicNativePiModelFundCases` (#7641), `RcicNativePiModelTermIrr` (#7640), and `RcicNativePiModelK`
(#7634), all landed on `main` in batch 179 (#7648/#7651), three findings blocked `FundamentalTermI`:
1. `LRTermI`'s `spine` clause forced `A ↝* Sort u`, refuting the diagonal at any constructor or
   Π-typed constant (`not_fundamentalTermI_of_pi_member`) and refuting `IrrCaseT` at any proof
   constant of a Π-proposition (`not_irrCaseT_of_pi_member`).
2. `LRTermIndexTransport` (and specifically its `.lam g` function clause, where the codomain `B₂`
   must be typed in the moved context `.assumption A₂ :: Γ` along a `TyConvT` chain) and
   `LRTermTrans` remained open definitions.
3. Context-free `EnvI.bot` and `WhRed E` refuted `FundamentalTermI` on `ConvT.zetaLocal`
   (`not_fundamentalTermI`), and `LRTypeIN` lacked `ConvArgsT` on admitted family spines.

Here we resolve all three in `LRTermFamIN E n Γ M M' A u`:
- **Part A:** Proves that admitted constructor spines `foldApps (.const c ls) ys` (`m.mclass = .ctor`)
  have `m.body = none` (`CtorNoBody`, `ctorNoBody_of_envWfT`) and are weak-head normal in both
  `WhNormalCtx E Γ` and `WhNormal E` (`whNormalCtx_ctorApp`, `whRedCtx_ctorApp_eq`,
  `whNormal_ctorApp`, `whRed_ctorApp_eq`), plus substitution commutation on family spines
  (`instantiate_foldApps`, `instantiate_famApp`, `approxI_subst_iff`, `approxIArgs_subst_iff`).
- **Part B:** Defines `IsNonSortPropCtx E n Γ A` (unconditionally false at `.sort u`,
  unconditionally true at any `.sort .zero`-typed `.pi A B` or `.inductiveM` family spine, and
  transported across `TyConvT` by `ZeroSortCoherence` + `FundamentalLRFamINT`) and defines
  `LRTermFamIN` by well-founded recursion on `CptI` over `LRTypeFamIN` and `WhRedCtx E Γ`,
  proving `lrTermFamIN_sort_iff_lrTypeFamIN` and `zetaSortCtx` satisfaction.
- **Part C:** Discharges the `.lam g` codomain-typing obstruction via `hasTyT_assump_dom`, proving
  full index transport `lrTermFamIN_transport` (and `lrTermFamIN_transport_lam`), full symmetry
  `lrTermFamIN_symm` (via `convT_inst0_sortCongr`), and full transitivity `lrTermFamIN_trans`.
- **Part D:** Discharges the `sorts`, `beta`, `zeta`, `zetaLocal`, `lit`, `refl`, `tyConv`, `symm`,
  `trans`, `irr` (`fundConvFamIN_irr_pi`, `fundConvFamIN_irr_famApp`), `K` (`fundConvFamIN_K_famApp`),
  `η-K` (`fundConvFamIN_etaK_pi`), family-spine, constructor-spine (`fundConvFamIN_ctorSpines_at_famApp`,
  `fundTermFamIN_ctorSpine_at_famApp`), and substituted-variable (`fundSubstFamIN_bvar_eq`) cases,
  and derives `PiRowField`, `FamAppRowLink`, `FamRelevantSlotConv`, and `TypedRowsWf` from
  `FundamentalTermFamIN` using only `ShallowTypeSoundnessCtxI` (never the refuted `TypeSoundnessI`). -/


/-! #### Part A — Constructor-Spine Normal Forms (`CtorNoBody`, `whStepCtx_ctorApp_false`, `whNormalCtx_ctorApp`, `whRedCtx_ctorApp_eq`) & Family-Spine Substitution Algebra -/

/-- Admitted `.constructorM` members in `EnvWfT` have `m.body = none` (no δ-unfolding body). -/
def CtorNoBody (E : ResolvedEnv) : Prop :=
  ∀ c m, E.members c = some m → m.mclass = .constructorM → m.body = none

theorem ctorNoBody_extend_nonctor {E : ResolvedEnv} (hE : CtorNoBody E)
    (r : Nat) (m : CheckedMember) (hn : m.mclass ≠ .constructorM) :
    CtorNoBody (extendEnv E r m) := by
  intro r' m' hres hcls
  by_cases heq : r' = r
  · subst r'
    simp only [extendEnv, if_pos rfl] at hres
    cases hres
    exact False.elim (hn hcls)
  · simp only [extendEnv, if_neg heq] at hres
    exact hE r' m' hres hcls

theorem ctorNoBody_group {S E E' : ResolvedEnv}
    {ms : List (Nat × CheckedMember)} (g : GroupMembersT S E ms E') :
    CtorNoBody E → CtorNoBody E' := by
  induction g with
  | nil => exact fun h => h
  | cons E r m rest E' _ hnobody _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      intro hE
      apply ih
      intro r' m' hres hcls
      by_cases heq : r' = r
      · subst r'
        simp only [extendEnv, if_pos rfl] at hres
        cases hres
        exact hnobody
      · simp only [extendEnv, if_neg heq] at hres
        exact hE r' m' hres hcls

theorem ctorNoBody_of_envWfT : {E : ResolvedEnv} → EnvWfT E → CtorNoBody E
  | _, .empty => by
      intro r m h
      cases h
  | _, .axiom (arity := arity) E r A _ hE .. =>
      ctorNoBody_extend_nonctor (ctorNoBody_of_envWfT hE)
        r ⟨.axiomM, arity, A, none⟩ (by intro h; cases h)
  | _, .definition E r A v _ hE .. =>
      ctorNoBody_extend_nonctor (ctorNoBody_of_envWfT hE)
        r ⟨.definitionM, 0, A, some v⟩ (by intro h; cases h)
  | _, .thm E r A p hE .. =>
      ctorNoBody_extend_nonctor (ctorNoBody_of_envWfT hE)
        r ⟨.theoremM, 0, A, some p⟩ (by intro h; cases h)
  | _, .opaque E r A v _ hE .. =>
      ctorNoBody_extend_nonctor (ctorNoBody_of_envWfT hE)
        r ⟨.opaqueM, 0, A, some v⟩ (by intro h; cases h)
  | _, .group _ _ _ _ _ _ _ hE _ _ _ hmem =>
      ctorNoBody_group hmem (ctorNoBody_of_envWfT hE)

/-- A `.constructorM`-headed spine `foldApps (.const c ls) xs` can never be a `DerivedIotaU` source
    (since `.constructorM ≠ .recursorM`). -/
theorem derivedIotaU_ctorApp_false {E : ResolvedEnv}
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {rhs : Expr Nat}
    (hI : DerivedIotaU E (foldApps (.const c ls) xs) rhs) : False := by
  rcases derivedIotaU_recHead hI with ⟨r', ls', pre, major, m', hlhs, hrec, hrecK⟩
  obtain ⟨hconst, _⟩ := foldApps_const_inj hlhs
  injection hconst with hr _
  subst hr
  rw [hm] at hrec
  injection hrec with hm'
  subst hm'
  exact MemberClass.noConfusion (hctor.symm.trans hrecK)

/-- Auxiliary induction on `WhStepCtx`: no spine `foldApps (.const c ls) xs` of an admitted
    constructor head `c` (`m.mclass = .constructorM`) can take a weak-head step (including `zetaLocal`). -/
theorem whStepCtx_ctorApp_false_aux {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {a e : Expr Nat} (h : WhStepCtx E Γ a e) :
    ∀ (xs : List (Expr Nat)), a = foldApps (.const c ls) xs → False := by
  induction h with
  | beta A b arg =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hf _
        exact F8EtaK.foldApps_const_ne_lam_any hf.symm
  | zeta A v b =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | zetaLocal _ =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | delta hres hbody =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · injection heq with hr _
        subst hr
        rw [hm] at hres
        injection hres with hm'
        subst hm'
        have hnone := ctorNoBody_of_envWfT hW _ m hm hctor
        rw [hnone] at hbody
        exact Option.noConfusion hbody
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | iota hI =>
      intro xs heq
      subst heq
      exact derivedIotaU_ctorApp_false hm hctor hI
  | lit t =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | appHead _ ih =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hf _
        exact ih pre hf

/-- Under `EnvWfT E`, an admitted constructor spine `foldApps (.const c ls) xs`
    (`m.mclass = .constructorM`) takes no weak-head steps in `WhStepCtx E Γ`. -/
theorem whStepCtx_ctorApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} (xs : List (Expr Nat)) {e : Expr Nat}
    (h : WhStepCtx E Γ (foldApps (.const c ls) xs) e) : False :=
  whStepCtx_ctorApp_false_aux hW hm hctor h xs rfl

/-- Under `EnvWfT E`, every admitted constructor spine `foldApps (.const c ls) xs`
    (`m.mclass = .constructorM`) is weak-head normal in `WhNormalCtx E Γ`. -/
theorem whNormalCtx_ctorApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalCtx E Γ (foldApps (.const c ls) xs) :=
  fun _ h => whStepCtx_ctorApp_false hW hm hctor xs h

/-- Multi-step weak-head reduction `WhRedCtx E Γ` from an admitted constructor spine
    `foldApps (.const c ls) xs` forces equality `Y = foldApps (.const c ls) xs`. -/
theorem whRedCtx_ctorApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {Y : Expr Nat}
    (h : WhRedCtx E Γ (foldApps (.const c ls) xs) Y) :
    Y = foldApps (.const c ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact False.elim (whStepCtx_ctorApp_false hW hm hctor xs hs)

/-- Auxiliary induction on `WhStep`: no constructor spine `foldApps (.const c ls) xs` can take a
    context-free weak-head step. -/
theorem whStep_ctorApp_false_aux {E : ResolvedEnv} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {a e : Expr Nat} (h : WhStep E a e) :
    ∀ (xs : List (Expr Nat)), a = foldApps (.const c ls) xs → False :=
  fun xs heq =>
    whStepCtx_ctorApp_false_aux (Γ := []) hW hm hctor (whStep_to_whStepCtx (Γ := []) h) xs heq

/-- Under `EnvWfT E`, an admitted constructor spine `foldApps (.const c ls) xs` takes no
    context-free weak-head steps in `WhStep E`. -/
theorem whStep_ctorApp_false {E : ResolvedEnv} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} (xs : List (Expr Nat)) {e : Expr Nat}
    (h : WhStep E (foldApps (.const c ls) xs) e) : False :=
  whStep_ctorApp_false_aux hW hm hctor h xs rfl

/-- Under `EnvWfT E`, every admitted constructor spine `foldApps (.const c ls) xs` is weak-head
    normal in `WhNormal E`. -/
theorem whNormal_ctorApp {E : ResolvedEnv} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormal E (foldApps (.const c ls) xs) :=
  fun _ h => whStep_ctorApp_false hW hm hctor xs h

/-- Multi-step weak-head reduction `WhRed E` from an admitted constructor spine
    `foldApps (.const c ls) xs` forces equality `Y = foldApps (.const c ls) xs`. -/
theorem whRed_ctorApp_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {Y : Expr Nat}
    (h : WhRed E (foldApps (.const c ls) xs) Y) :
    Y = foldApps (.const c ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact False.elim (whStep_ctorApp_false hW hm hctor xs hs)

/-- Every element of `botVecI xs` is `CptI.bot`. -/
theorem mem_botVecI_eq_bot : ∀ (xs : List (Expr Nat)) {u : CptI}, u ∈ botVecI xs → u = .bot
  | [], _, h => nomatch h
  | _ :: xs, _, h => by
      cases List.mem_cons.mp h with
      | inl heq => exact heq
      | inr hmem => exact mem_botVecI_eq_bot xs hmem

/-- `instantiate j s` commutes with `foldApps`. -/
theorem instantiate_foldApps (j : Nat) (s : Expr Nat) :
    ∀ (f : Expr Nat) (xs : List (Expr Nat)),
      instantiate j s (foldApps f xs) = foldApps (instantiate j s f) (xs.map (instantiate j s))
  | _, [] => rfl
  | f, x :: xs => instantiate_foldApps j s (.app f x) xs

/-- `instantiate j s` on a constant-headed spine `foldApps (.const r ls) xs` instantiates each
    argument in `xs`. -/
theorem instantiate_famApp (j : Nat) (s : Expr Nat) (r : Nat) (ls : List Level)
    (xs : List (Expr Nat)) :
    instantiate j s (foldApps (.const r ls) xs) =
      foldApps (.const r ls) (xs.map (instantiate j s)) :=
  instantiate_foldApps j s (.const r ls) xs

/-- Exact substitution equivalence for `ApproxI` at index `j`
    (combining `approxI_subst_elim` and `approxI_subst_intro` from `RcicNativePiModelIdeal`). -/
theorem approxI_subst_iff (ρ : EnvI) (j : Nat) (sub e : Expr Nat) (c : CptI) :
    ApproxI ρ (instantiate j (lift 0 j sub) e) c ↔
      ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) e c :=
  ⟨fun h => approxI_subst_elim e h, fun h => approxI_subst_intro h ρ j sub rfl⟩

/-- Exact substitution equivalence for argument lists `ApproxIArgs` at index `j`. -/
theorem approxIArgs_subst_iff (ρ : EnvI) (j : Nat) (sub : Expr Nat) :
    ∀ (xs : List (Expr Nat)) (cs : List CptI),
      ApproxIArgs ρ (xs.map (instantiate j (lift 0 j sub))) cs ↔
        ApproxIArgs (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) xs cs
  | [], [] => Iff.intro (fun _ => .nil) (fun _ => .nil)
  | [], _ :: _ => Iff.intro (fun h => by cases h) (fun h => by cases h)
  | _ :: _, [] => Iff.intro (fun h => by cases h) (fun h => by cases h)
  | x :: xs, c :: cs => by
      constructor
      · intro h
        cases h with
        | cons hx hxs =>
            exact .cons ((approxI_subst_iff ρ j sub x c).mp hx)
              ((approxIArgs_subst_iff ρ j sub xs cs).mp hxs)
      · intro h
        cases h with
        | cons hx hxs =>
            exact .cons ((approxI_subst_iff ρ j sub x c).mpr hx)
              ((approxIArgs_subst_iff ρ j sub xs cs).mpr hxs)


/-! #### Part B — Non-Sort Proposition Collapse (`IsNonSortPropCtx`) & Context-Aware Split-Spine Term Logical Relation (`LRTermFamIN`) Over `LRTypeFamIN` -/

/-- A context-aware non-universe proposition (`IsNonSortPropCtx E n Γ A`): `A` is sorted in `Prop`
    (`HasTyT E n Γ A (.sort .zero)`) and never weak-head reduces in `WhRedCtx E Γ` to a universe
    `.sort l`. -/
def IsNonSortPropCtx (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A : Expr Nat) : Prop :=
  (∀ l, ¬ WhRedCtx E Γ A (.sort l)) ∧ Nonempty (HasTyT E n Γ A (.sort .zero))

/-- A universe `.sort u` is never a `IsNonSortPropCtx` (unconditionally, by `WhRedCtx.refl`). -/
theorem not_isNonSortPropCtx_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (u : Level) :
    ¬ IsNonSortPropCtx E n Γ (.sort u) :=
  fun ⟨hno, _⟩ => hno u (.refl _)

/-- Every `.sort .zero`-typed Π-type `.pi A B` is unconditionally a `IsNonSortPropCtx`
    (since `whRedCtx_pi_eq` prevents `.pi A B` from weak-head reducing to `.sort l`). -/
theorem isNonSortPropCtx_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (hP : HasTyT E n Γ (.pi A B) (.sort .zero)) :
    IsNonSortPropCtx E n Γ (.pi A B) :=
  And.intro (fun _ hred => by cases whRedCtx_pi_eq hred) ⟨hP⟩

/-- Every `.sort .zero`-typed admitted `.inductiveM` family spine `foldApps (.const r ls) xs` is
    unconditionally a `IsNonSortPropCtx` (since `whRedCtx_famApp_eq` and `foldApps_const_ne_sort`
    prevent it from weak-head reducing to `.sort l`). -/
theorem isNonSortPropCtx_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)}
    (hP : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsNonSortPropCtx E n Γ (foldApps (.const r ls) xs) :=
  ⟨fun l hred => foldApps_const_ne_sort r ls xs l (whRedCtx_famApp_eq hW hm hind hred).symm, ⟨hP⟩⟩

/-- If `A` weak-head reduces in `WhRedCtx E Γ` to `.sort l`, then `ApproxI (ctxEnvI Γ) A .sort`
    holds under `WhApproxInvCore E`. -/
theorem approxI_ctxEnvI_sort_of_whRedCtx {E : ResolvedEnv} {Γ : LCtx}
    (hcore : WhApproxInvCore E) {A : Expr Nat} {l : Level}
    (h : WhRedCtx E Γ A (.sort l)) :
    ApproxI (ctxEnvI Γ) A .sort :=
  (approxI_ctxEnvI_whRedCtx hcore h .sort).mpr (.sort (ctxEnvI Γ) l)

/-- If `A` weak-head reduces in `WhRedCtx E Γ` to `.pi A₁ B₁`, then
    `ApproxI (ctxEnvI Γ) A (.pi .bot [])` holds under `WhApproxInvCore E`. -/
theorem approxI_ctxEnvI_pi_of_whRedCtx {E : ResolvedEnv} {Γ : LCtx}
    (hcore : WhApproxInvCore E) {A A₁ B₁ : Expr Nat}
    (h : WhRedCtx E Γ A (.pi A₁ B₁)) :
    ApproxI (ctxEnvI Γ) A (.pi .bot []) :=
  (approxI_ctxEnvI_whRedCtx hcore h (.pi .bot [])).mpr (approxI_pi_bot_nil (ctxEnvI Γ) A₁ B₁)

/-- `IsNonSortPropCtx` transports along any `TyConvT E n Γ A A'` chain under `ZeroSortCoherence`,
    `WhApproxInvCore`, and `FundamentalLRFamINT`. -/
theorem isNonSortPropCtx_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsNonSortPropCtx E n Γ A) :
    IsNonSortPropCtx E n Γ A' := by
  obtain ⟨hno, ⟨hA0⟩⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨fun l hred' => ?_, ⟨hA'0⟩⟩
  have hcA' : ApproxI (ctxEnvI Γ) A' .sort := approxI_ctxEnvI_sort_of_whRedCtx hcore hred'
  have hLR : LRTypeFamIN E n Γ A' A .sort := hF hΓ hA'0 hAA'.symmT .sort hcA'
  cases hLR with
  | sort _ hredA => exact hno _ hredA

/-- Under `WhApproxInvCore E`, `A` cannot simultaneously weak-head reduce to `.sort l` in
    `WhRedCtx E Γ` and have `ApproxI (ctxEnvI Γ) A (.spine r bs)`. -/
theorem not_whRedCtx_sort_and_approxI_spine {E : ResolvedEnv} {Γ : LCtx}
    (hcore : WhApproxInvCore E) {A : Expr Nat} {l : Level} {r : Nat} {bs : List CptI}
    (hred : WhRedCtx E Γ A (.sort l)) (hsp : ApproxI (ctxEnvI Γ) A (.spine r bs)) :
    False := by
  have hsort : ApproxI (ctxEnvI Γ) (.sort l) (.spine r bs) :=
    (approxI_ctxEnvI_whRedCtx hcore hred (.spine r bs)).mp hsp
  rcases approxI_sort_inv hsort with h0 | h0 <;> exact CptI.noConfusion h0

/-- Head congruence for `WhRedCtx E Γ`. -/
theorem whRedCtx_appHead {E : ResolvedEnv} {Γ : LCtx} {f f' a : Expr Nat}
    (h : WhRedCtx E Γ f f') : WhRedCtx E Γ (.app f a) (.app f' a) := by
  induction h with
  | refl => exact .refl _
  | step h _ ih => exact .step (.appHead h) ih

/-- **Context-Aware Split-Spine & Prop-Collapsed Term Logical Relation (`LRTermFamIN`) Over `LRTypeFamIN`:**
    Relates `M, M'` of type `A` in context `Γ` at compact `u : CptI`:
    - At `.bot`: trivially `True`.
    - At `.sort` and `.pi a f`: either `A` is a non-sort proposition (`IsNonSortPropCtx`, §3.6
      proof-irrelevance collapse) or `A ↝*_[Γ] .sort l` and `LRTypeFamIN E n Γ M M' u` holds.
    - At `.spine r args`: split into (1) the type-code reading (`A ↝*_[Γ] .sort l` and
      `LRTypeFamIN E n Γ M M' (.spine r args)`), (2) the `IsNonSortPropCtx` proposition collapse,
      and (3) the data/constructor spine reading (`A` has a shallow spine approximation
      `.spine r' bs` in `ctxEnvI Γ` and `M, M'` weak-head reduce in `WhRedCtx E Γ` to
      `WhNormalCtx` terms convertible at `A`).
    - At `.lam g`: either `IsNonSortPropCtx E n Γ A` or `A ↝*_[Γ] .pi A₁ B₁` with the typing
      presuppositions and application stability across convertible, related arguments. -/
def LRTermFamIN (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort =>
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' .sort)
  | .pi a f =>
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.pi a f))
  | .spine r args =>
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.spine r args)) ∨
      IsNonSortPropCtx E n Γ A ∨
      ((∃ r' bs, (∀ u ∈ bs, u = CptI.bot) ∧ ApproxI (ctxEnvI Γ) A (.spine r' bs)) ∧
        ∃ Y Y', WhRedCtx E Γ M Y ∧ WhRedCtx E Γ M' Y' ∧
          WhNormalCtx E Γ Y ∧ WhNormalCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A))
  | .lam g =>
      IsNonSortPropCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamIN E n Γ N N' A₁ u) →
          LRTermFamIN E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show u ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

theorem lrTermFamIN_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamIN E n Γ M M' A .bot := by
  rw [LRTermFamIN]; trivial

theorem lrTermFamIN_sort_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamIN E n Γ M M' A .sort ↔
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' .sort) := by
  rw [LRTermFamIN]

theorem lrTermFamIN_pi_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (a : CptI) (f : List (List CptI × CptI)) :
    LRTermFamIN E n Γ M M' A (.pi a f) ↔
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.pi a f)) := by
  rw [LRTermFamIN]

theorem lrTermFamIN_spine_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (r : Nat) (args : List CptI) :
    LRTermFamIN E n Γ M M' A (.spine r args) ↔
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.spine r args)) ∨
      IsNonSortPropCtx E n Γ A ∨
      ((∃ r' bs, (∀ u ∈ bs, u = CptI.bot) ∧ ApproxI (ctxEnvI Γ) A (.spine r' bs)) ∧
        ∃ Y Y', WhRedCtx E Γ M Y ∧ WhRedCtx E Γ M' Y' ∧
          WhNormalCtx E Γ Y ∧ WhNormalCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A)) := by
  rw [LRTermFamIN]

theorem lrTermFamIN_lam_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (g : List (List CptI × CptI)) :
    LRTermFamIN E n Γ M M' A (.lam g) ↔
      IsNonSortPropCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamIN E n Γ N N' A₁ u) →
          LRTermFamIN E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2) := by
  rw [LRTermFamIN]

/-- At any non-sort proposition `IsNonSortPropCtx E n Γ A`, `LRTermFamIN E n Γ M M' A u` holds
    for **every** compact `u : CptI` and all terms `M, M'`. -/
theorem lrTermFamIN_of_nonSortPropCtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A : Expr Nat}
    (hprop : IsNonSortPropCtx E n Γ A) (M M' : Expr Nat) :
    (u : CptI) → LRTermFamIN E n Γ M M' A u
  | .bot => lrTermFamIN_bot _ _ _ _
  | .sort => (lrTermFamIN_sort_iff _ _ _ _).mpr (Or.inl hprop)
  | .pi _ _ => (lrTermFamIN_pi_iff _ _ _ _ _ _).mpr (Or.inl hprop)
  | .spine _ _ => (lrTermFamIN_spine_iff _ _ _ _ _ _).mpr (Or.inr (Or.inl hprop))
  | .lam _ => (lrTermFamIN_lam_iff _ _ _ _ _).mpr (Or.inl hprop)

/-- Closure of `LRTermFamIN` under weak-head expansion (`WhRedCtx E Γ`) on both sides. -/
theorem lrTermFamIN_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {M M' X X' A : Expr Nat}
    (hX : WhRedCtx E Γ M X) (hX' : WhRedCtx E Γ M' X') :
    (u : CptI) → LRTermFamIN E n Γ X X' A u → LRTermFamIN E n Γ M M' A u
  | .bot, _ => lrTermFamIN_bot _ _ _ _
  | .sort, h => by
      rw [lrTermFamIN_sort_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
  | .pi a f, h => by
      rw [lrTermFamIN_pi_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
  | .spine r args, h => by
      rw [lrTermFamIN_spine_iff] at h ⊢
      rcases h with ⟨h1, h2⟩ | hprop | ⟨h1, Y, Y', hY, hY', hn, hn', hc⟩
      · exact Or.inl ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨h1, Y, Y', whRedCtx_trans hX hY, whRedCtx_trans hX' hY', hn, hn', hc⟩)
  | .lam g, h => by
      rw [lrTermFamIN_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hA, hΓ₁, hB₁, happ⟩
      · exact Or.inl hprop
      · refine Or.inr ⟨A₁, B₁, w, hA, hΓ₁, hB₁, fun s hs N N' hN hN' hc hrel => ?_⟩
        exact lrTermFamIN_expand (whRedCtx_appHead hX) (whRedCtx_appHead hX') s.2
          (happ s hs N N' hN hN' hc hrel)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
  have h₃ := sizeOf_snd_lt s
  omega

/-- At a universe `.sort u`, `LRTermFamIN` never holds at `.lam g` (unconditionally). -/
theorem lrTermFamIN_lam_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {g : List (List CptI × CptI)}
    (h : LRTermFamIN E n Γ M M' (.sort u) (.lam g)) : False := by
  rw [lrTermFamIN_lam_iff] at h
  rcases h with hprop | ⟨A₁, B₁, _, hA, _, _, _⟩
  · exact not_isNonSortPropCtx_sort u hprop
  · exact nomatch whRedCtx_sort_eq hA

/-- At a universe `.sort u`, `LRTermFamIN` at `.spine r args` forces the type-code reading
    `LRTypeFamIN E n Γ M M' (.spine r args)` (unconditionally). -/
theorem lrTermFamIN_spine_at_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {r : Nat} {args : List CptI}
    (h : LRTermFamIN E n Γ M M' (.sort u) (.spine r args)) :
    LRTypeFamIN E n Γ M M' (.spine r args) := by
  rw [lrTermFamIN_spine_iff] at h
  rcases h with ⟨_, h2⟩ | hprop | ⟨⟨r', bs, _, hsp⟩, _⟩
  · exact h2
  · exact (not_isNonSortPropCtx_sort u hprop).elim
  · rcases approxI_sort_inv hsp with h0 | h0 <;> exact CptI.noConfusion h0

/-- Unconditional extraction of `LRTypeFamIN` from `LRTermFamIN` at a universe `.sort u`. -/
theorem lrTypeFamIN_of_lrTermFamIN_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} :
    (c : CptI) → LRTermFamIN E n Γ M M' (.sort u) c → LRTypeFamIN E n Γ M M' c
  | .bot, _ => .bot _ _ _
  | .sort, h => by
      rw [lrTermFamIN_sort_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropCtx_sort u hprop).elim
      · exact h2
  | .pi _ _, h => by
      rw [lrTermFamIN_pi_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropCtx_sort u hprop).elim
      · exact h2
  | .spine _ _, h => lrTermFamIN_spine_at_sort h
  | .lam _, h => (lrTermFamIN_lam_at_sort_false h).elim

/-- Conversely, `LRTypeFamIN E n Γ M M' c` embeds into `LRTermFamIN E n Γ M M' (.sort u) c`. -/
theorem lrTermFamIN_of_lrTypeFamIN_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) :
    (c : CptI) → LRTypeFamIN E n Γ M M' c → LRTermFamIN E n Γ M M' (.sort u) c
  | .bot, _ => lrTermFamIN_bot _ _ _ _
  | .sort, h => (lrTermFamIN_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .pi _ _, h => (lrTermFamIN_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .spine _ _, h => (lrTermFamIN_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨u, .refl _⟩, h⟩)
  | .lam _, h => nomatch h

/-- At any universe `.sort u`, `LRTermFamIN E n Γ M M' (.sort u) c` is logically equivalent (`↔`)
    to `LRTypeFamIN E n Γ M M' c`. -/
theorem lrTermFamIN_sort_iff_lrTypeFamIN {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) (c : CptI) :
    LRTermFamIN E n Γ M M' (.sort u) c ↔ LRTypeFamIN E n Γ M M' c :=
  ⟨lrTypeFamIN_of_lrTermFamIN_sort c, lrTermFamIN_of_lrTypeFamIN_sort u c⟩

/-- `LRTermFamIN` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the forward
    direction `(.sort .zero, .bvar 0)` (where `FundamentalTermI` was refuted). -/
theorem lrTermFamIN_zetaSortCtx (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c) :
    LRTermFamIN E n zetaSortCtx (.sort .zero) (.bvar 0) (.sort (.succ .zero)) c :=
  lrTermFamIN_of_lrTypeFamIN_sort (.succ .zero) c (lrTypeFamIN_zetaSortCtx E n c hc)

/-- `LRTermFamIN` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the reverse
    direction `(.bvar 0, .sort .zero)`. -/
theorem lrTermFamIN_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.bvar 0) c) :
    LRTermFamIN E n zetaSortCtx (.bvar 0) (.sort .zero) (.sort (.succ .zero)) c :=
  lrTermFamIN_of_lrTypeFamIN_sort (.succ .zero) c (lrTypeFamIN_zetaSortCtx_symm E n c hc)


/-! #### Part C — Full Index Transport (`lrTermFamIN_transport`, Including `.lam g`), Symmetry (`lrTermFamIN_symm`), and Transitivity (`lrTermFamIN_trans`) of `LRTermFamIN` -/

/-- **Full Index Transport for `LRTermFamIN` Across All Compacts `c : CptI` (Including `.lam g`):**
    Discharges both the type-code compacts and the `.lam g` function compact (using
    `hasTyT_assump_dom` to transport the codomain sorting `HasTyT E n (.assumption A₁ :: Γ) B₂ (.sort w₂)`
    into the moved context `.assumption A₂ :: Γ` along `hdom.symmT : TyConvT E n Γ A₂ A₁`, and
    `ShallowTypeSoundnessCtxI` to transport the shallow spine witness in the constructor branch). -/
theorem lrTermFamIN_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A A' : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' →
    ∀ {M M' : Expr Nat}, LRTermFamIN E n Γ M M' A c → LRTermFamIN E n Γ M M' A' c
  | .bot, _, _, _, _, _, _, _, _, _, _ => lrTermFamIN_bot _ _ _ _
  | .sort, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIN_sort_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .pi a f, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIN_pi_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .spine r args, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIN_spine_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hLR⟩ | hprop | ⟨⟨r', bs, hbs, hsp⟩, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inl ⟨⟨_, hl'⟩, hLR⟩
      · exact Or.inr (Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop))
      · have hsp' : ApproxI (ctxEnvI Γ) A' (.spine r' bs) :=
          (shallowTypeSemEqI_of_tyConvT hS hΓ hAA' (.spine r' bs) hbs).mp hsp
        exact Or.inr (Or.inr ⟨⟨r', bs, hbs, hsp'⟩, Y, Y', hY, hY', hn, hn',
          ⟨convT_of_tyConv hc hAA'⟩⟩)
  | .lam g, Γ, hΓ, A, A', _, hA, hAA', M, M', h => by
      rw [lrTermFamIN_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hpi := hF hΓ hA hAA' (.pi .bot []) (approxI_ctxEnvI_pi_of_whRedCtx hcore hred)
        cases hpi with
        | @pi _ _ _ A₁' B₁' A₂ B₂ _ _ hred₁ hred₂ _ hdom hcod _ _ =>
            have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
              hred (whNormalCtx_pi A₁ B₁) hred₁ (whNormalCtx_pi A₁' B₁')
            injection e with eA eB
            subst eA; subst eB
            cases hΓ₁ with
            | assumption _ _ u₁ _ hA₁ =>
                obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hdom hA₁
                have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ u₂ hΓ hA₂
                have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
                obtain ⟨w₂, hB₂_A₁⟩ := tyConvT_endTyped hW hΓ₁' hcod hB₁
                have hB₂ : HasTyT E n (.assumption A₂ :: Γ) B₂ (.sort w₂) :=
                  hasTyT_assump_dom (envClosed_of_envWfT hW) hW hΓ hdom.symmT hA₂ hB₂_A₁
                refine Or.inr ⟨A₂, B₂, w₂, hred₂, ⟨hΓ₂⟩, ⟨hB₂⟩,
                  fun s hs N N' hN₂ hN'₂ hc₂ hrel₂ => ?_⟩
                have hN₁ : HasTyT E n Γ N A₁ := hasTyT_of_tyConv hN₂ hdom.symmT
                have hN'₁ : HasTyT E n Γ N' A₁ := hasTyT_of_tyConv hN'₂ hdom.symmT
                have hc₁ : ConvT E n Γ N N' A₁ := convT_of_tyConv hc₂ hdom.symmT
                have hrel₁ : ∀ v ∈ s.1, LRTermFamIN E n Γ N N' A₁ v :=
                  fun v hv => lrTermFamIN_transport hW hdet zsc hcore hF hS v
                    hΓ hA₂ hdom.symmT (hrel₂ v hv)
                have hout₁ := happ s hs N N' hN₁ hN'₁ hc₁ hrel₁
                have hinstTy : HasTyT E n Γ (instantiate0 N B₁) (.sort w) :=
                  hasTyT_subst0_of_envWfT hW hB₁ hN₁
                have hinstConv : TyConvT E n Γ (instantiate0 N B₁) (instantiate0 N B₂) :=
                  tyConvT_subst0_of_envWfT hW hN₁ hcod
                exact lrTermFamIN_transport hW hdet zsc hcore hF hS s.2
                  hΓ hinstTy hinstConv hout₁
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- Specialization of `lrTermFamIN_transport` to `.lam g` (the function-clause half of index
    transport). -/
theorem lrTermFamIN_transport_lam {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hAA' : TyConvT E n Γ A A')
    {M M' : Expr Nat} (g : List (List CptI × CptI))
    (h : LRTermFamIN E n Γ M M' A (.lam g)) :
    LRTermFamIN E n Γ M M' A' (.lam g) :=
  lrTermFamIN_transport hW hdet zsc hcore hF hS (.lam g) hΓ hA hAA' h

/-- **Full Symmetry of `LRTermFamIN` Across All Compacts `c : CptI` (Including `.lam g`):**
    Uses `lrTypeFamIN_symm` at type-code compacts and `convT_inst0_sortCongr` +
    `lrTermFamIN_transport` at `.lam g` to re-index `instantiate0 N' B₁` to `instantiate0 N B₁`. -/
theorem lrTermFamIN_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat}, LRTermFamIN E n Γ M M' A c → LRTermFamIN E n Γ M' M A c
  | .bot, _, _, _, _, _, _ => lrTermFamIN_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIN_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
  | .pi a f, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIN_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
  | .spine r args, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIN_spine_iff] at h ⊢
      rcases h with ⟨hl, hLR⟩ | hprop | ⟨hsp, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · exact Or.inl ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨hsp, Y', Y, hY', hY, hn', hn, ⟨.symm _ _ _ _ hc⟩⟩)
  | .lam g, Γ, hΓ, M, M', A, h => by
      rw [lrTermFamIN_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl hprop
      · cases hΓ₁ with
        | assumption _ _ u₁ _ hA₁ =>
            have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
            refine Or.inr ⟨A₁, B₁, w, hred, ⟨hΓ₁'⟩, ⟨hB₁⟩,
              fun s hs N N' hN hN' hc hrel => ?_⟩
            have hc' : ConvT E n Γ N' N A₁ := .symm _ _ _ _ hc
            have hrel' : ∀ v ∈ s.1, LRTermFamIN E n Γ N' N A₁ v :=
              fun v hv => lrTermFamIN_symm hW hdet zsc hcore hF hS v hΓ (hrel v hv)
            have hout := happ s hs N' N hN' hN hc' hrel'
            have houtSymm := lrTermFamIN_symm hW hdet zsc hcore hF hS s.2 hΓ hout
            have hinstTy : HasTyT E n Γ (instantiate0 N' B₁) (.sort w) :=
              hasTyT_subst0_of_envWfT hW hB₁ hN'
            have hinstConv : TyConvT E n Γ (instantiate0 N' B₁) (instantiate0 N B₁) :=
              .of _ _ _ w (convT_inst0_sortCongr hA₁ hB₁ hN' hN hc')
            exact lrTermFamIN_transport hW hdet zsc hcore hF hS s.2
              hΓ hinstTy hinstConv houtSymm
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Full Transitivity of `LRTermFamIN` Across All Compacts `c : CptI` (Including `.lam g`):**
    Discharges the context-aware/family-injective counterpart of `RcicNativePiModelFundCases.LRTermTrans`
    by combining `lrTypeFamIN_trans`, `not_whRedCtx_sort_and_approxI_spine`, `whRedCtx_normal_unique`,
    and `lrTermFamIN_symm`. -/
theorem lrTermFamIN_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    (hS : ShallowTypeSoundnessCtxI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M N P A : Expr Nat},
      LRTermFamIN E n Γ M N A c → LRTermFamIN E n Γ N P A c → LRTermFamIN E n Γ M P A c
  | .bot, _, _, _, _, _, _, _, _ => lrTermFamIN_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIN_sort_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
  | .pi a f, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIN_pi_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
  | .spine r args, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIN_spine_iff] at h₁ h₂ ⊢
      rcases h₁ with ⟨⟨l, hl⟩, hLR₁⟩ | hprop | ⟨⟨r', bs, hbs, hsp⟩, Y₁, Y₂, hM, hN₁, hn₁, hn₂, ⟨hc₁⟩⟩
      · rcases h₂ with ⟨_, hLR₂⟩ | hprop | ⟨⟨_, _, _, hsp⟩, _⟩
        · exact Or.inl ⟨⟨l, hl⟩,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
        · exact Or.inr (Or.inl hprop)
        · exact (not_whRedCtx_sort_and_approxI_spine hcore hl hsp).elim
      · exact Or.inr (Or.inl hprop)
      · rcases h₂ with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨_, Y₂', Y₃, hN₂, hP, hn₂', hn₃, ⟨hc₂⟩⟩
        · exact (not_whRedCtx_sort_and_approxI_spine hcore hl hsp).elim
        · exact Or.inr (Or.inl hprop)
        · have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet) hN₁ hn₂ hN₂ hn₂'
          subst e
          exact Or.inr (Or.inr ⟨⟨r', bs, hbs, hsp⟩, Y₁, Y₃, hM, hP, hn₁, hn₃,
            ⟨.trans _ _ _ _ _ hc₁ hc₂⟩⟩)
  | .lam g, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIN_lam_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, happ₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨A₂, B₂, _, hred₂, _, _, happ₂⟩
        · exact Or.inl hprop
        · have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
            hred₁ (whNormalCtx_pi A₁ B₁) hred₂ (whNormalCtx_pi A₂ B₂)
          injection e with eA eB
          subst eA; subst eB
          refine Or.inr ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, fun s hs Q Q' hQ hQ' hcQ hrel => ?_⟩
          have hrelQQ : ∀ v ∈ s.1, LRTermFamIN E n Γ Q Q A₁ v :=
            fun v hv =>
              lrTermFamIN_trans hW hdet zsc hcore hF hS v hΓ (hrel v hv)
                (lrTermFamIN_symm hW hdet zsc hcore hF hS v hΓ (hrel v hv))
          have hout₁ := happ₁ s hs Q Q hQ hQ (.refl _ _ _ hQ) hrelQQ
          have hout₂ := happ₂ s hs Q Q' hQ hQ' hcQ hrel
          exact lrTermFamIN_trans hW hdet zsc hcore hF hS s.2 hΓ hout₁ hout₂
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega


/-! #### Part D — Discharged Cases of `FundamentalTermFamIN` (`sorts`, `beta`, `zeta`, `zetaLocal`, `lit`, `refl`, `tyConv`, `symm`, `trans`, `irr`, `K`, `η-K`, Family Spines, Constructor Spines, Related Substitution) & Bridge to `PiRowField` / `FamAppRowLink` / `TypedRowsWf` -/

/-- The `HasTyT.sort` diagonal case for `LRTermFamIN`. -/
theorem fundTermFamIN_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l : Level) :
    ∀ u, ApproxI (ctxEnvI Γ) (.sort l) u →
      LRTermFamIN E n Γ (.sort l) (.sort l) (.sort (.succ l)) u := by
  intro u hu
  rcases approxI_sort_inv hu with rfl | rfl
  · exact lrTermFamIN_bot _ _ _ _
  · rw [lrTermFamIN_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, lrTypeFamIN_sort_congr Γ l l⟩

/-- The `ConvT.sorts` conversion case for `LRTermFamIN`. -/
theorem fundConvFamIN_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l l' : Level) :
    ∀ u, ApproxI (ctxEnvI Γ) (.sort l) u →
      LRTermFamIN E n Γ (.sort l) (.sort l') (.sort (.succ l)) u := by
  intro u hu
  rcases approxI_sort_inv hu with rfl | rfl
  · exact lrTermFamIN_bot _ _ _ _
  · rw [lrTermFamIN_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, lrTypeFamIN_sort_congr Γ l l'⟩

/-- Any single `WhStepCtx E Γ M M'` step (including `beta`, `zeta`, `zetaLocal`, `delta`, `iota`,
    `lit`) reduces the conversion half of `LRTermFamIN` to the diagonal on `M'`. -/
theorem fundConvFamIN_of_whStepCtx {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {M M' A : Expr Nat}
    (h : WhStepCtx E Γ M M')
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIN E n Γ M' M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A u := by
  intro u hu
  have hu' : ApproxI (ctxEnvI Γ) M' u := (approxI_ctxEnvI_whStepCtx hcore h u).mp hu
  exact lrTermFamIN_expand (.step h (.refl _)) (.refl _) u (hdiag u hu')

/-- Multi-step `WhRedCtx E Γ M M'` reduces the conversion half of `LRTermFamIN` to the diagonal
    on `M'`. -/
theorem fundConvFamIN_of_whRedCtx {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {M M' A : Expr Nat}
    (h : WhRedCtx E Γ M M')
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIN E n Γ M' M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIN E n Γ M M' A u := by
  intro u hu
  have hu' : ApproxI (ctxEnvI Γ) M' u := (approxI_ctxEnvI_whRedCtx hcore h u).mp hu
  exact lrTermFamIN_expand h (.refl _) u (hdiag u hu')

/-- `ConvT.beta` case for `LRTermFamIN` from the diagonal on `instantiate0 a b`. -/
theorem fundConvFamIN_beta {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} (A b a T : Expr Nat)
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) (instantiate0 a b) u →
      LRTermFamIN E n Γ (instantiate0 a b) (instantiate0 a b) T u) :
    ∀ u, ApproxI (ctxEnvI Γ) (.app (.lam A b) a) u →
      LRTermFamIN E n Γ (.app (.lam A b) a) (instantiate0 a b) T u :=
  fundConvFamIN_of_whStepCtx hcore (.beta A b a) hdiag

/-- `ConvT.zeta` case for `LRTermFamIN` from the diagonal on `instantiate0 v b`. -/
theorem fundConvFamIN_zeta {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} (A v b T : Expr Nat)
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) (instantiate0 v b) u →
      LRTermFamIN E n Γ (instantiate0 v b) (instantiate0 v b) T u) :
    ∀ u, ApproxI (ctxEnvI Γ) (.letE A v b) u →
      LRTermFamIN E n Γ (.letE A v b) (instantiate0 v b) T u :=
  fundConvFamIN_of_whStepCtx hcore (.zeta A v b) hdiag

/-- `ConvT.zetaLocal` case for `LRTermFamIN` from the diagonal on the local let-value `v`
    (which `RcicNativePiModelFundCases` could not handle because `WhStep` lacked `zetaLocal`). -/
theorem fundConvFamIN_zetaLocal {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {i : Nat} {v T : Expr Nat}
    (hv : lookupValue Γ i = some v)
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) v u → LRTermFamIN E n Γ v v T u) :
    ∀ u, ApproxI (ctxEnvI Γ) (.bvar i) u → LRTermFamIN E n Γ (.bvar i) v T u :=
