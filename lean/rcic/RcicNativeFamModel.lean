/-! ### §11 — Unconditional `WhDet` / `WhDetCtx` from `EnvWfT E`, Admitted Obstructions on Unrestricted Π-Demands (`idPiPropSortStep` / `closedIrrPiCpt`), the Family-Aware `BotFamCpt E` / `ApproxDI` Layer (`FundamentalLRFamINBot`, `FundamentalTermFamINDBot`, `FundamentalLRFamINBotDI`, `FundamentalTermFamINDBotDI`), and the Demand-Guarded `LRTypeFamINB` Layer (`RcicNativePiModelDeltaIota` #7649)

In `RcicNativePiModelDeltaIota` (#7649, now on `main`):
1. `PiModelDeltaIotaAudit.whDet_of_envWfT` discharges `WhDet E` unconditionally at every `EnvWfT E`,
   and `PiModelDeltaIotaAudit.whApproxInvCoreDI_of_envWfT` discharges `WhApproxInvCoreDI E` on
   `ApproxDI E` unconditionally at every `EnvWfT E` (whereas raw `WhApproxInvCore E` on `ApproxI`
   is refuted on `defSortEnv` and `natEnv`).
2. `PiModelDeltaIotaAudit.idPiProp = .pi (.sort .zero) (.bvar 0)` at
   `PiModelDeltaIotaAudit.idPiPropSortStep = .pi .bot [([.sort], .sort)]` (and `closedIrrPiL` /
   `closedIrrPiR` at `closedIrrPiCpt`) is shown to refute any type or term logical relation whose
   `.pi` clause recurses into the un-instantiated codomain `.bvar 0` under a non-`⊥` step demand
   `s.1` (`¬ BotDemand s.1`).

Here in §11 we:
- **Part A:** Prove unconditional `whDetCtx_of_envWfT` and `whRedCtx_normal_unique_of_envWfT`, and
  explicitly record the `idPiPropSortStep` and `closedIrrPiCpt` refutations of unrestricted
  `LRTypeICtx` / `FundamentalLRICtx` (§7), `LRTypeFamIN` / `FundamentalLRFamIN` /
  `FundamentalLRFamINT` (§8), `LRTermFamIN` / `FundamentalTermFamIN` (§9), and `LRTermFamIND` /
  `FundamentalTermFamIND` (§10).
- **Part B:** Define the family-aware `BotFamCpt E` predicate (extending `BotPiCpt` with `famSpine`
  for admitted `.inductiveM` family heads `r` and `BotDemand args` of length
  `(piDomsOf m.mtype).length`), prove two-sided soundness-free approximation extraction
  `approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt` in every context `Γ` (including `letBinding`s), prove
  positive satisfaction on `idPiProp`, `closedIrrPi`, and `.lam`, and derive `FundamentalLRFamINBot`,
  `PiRowField`, `FamAppRowLink`, `FamRelevantSlotConv`, and `TypedRowsWf` from
  `FundamentalTermFamINDBot`.
- **Part C:** Port our context-aware family model to `ApproxDI E` (`CtxEnvDI E Γ`, `ctxEnvDI E Γ`,
  `whStepCtx_approxDI_iff_of_envWfT`, `approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt`), deriving
  `FundamentalLRFamINBotDI`, `PiRowField`, `FamAppRowLink`, `FamRelevantSlotConv`, `TypedRowsWf`,
  `DT-012`, `DT-010`, `DT-011`, `DT-019`, and `IA-024` from `EnvWfT E` + `AllBelowScoped` +
  `FundamentalTermFamINDBotDI E n` **alone** (with zero `WhDet` or `WhApproxInvCore` hypotheses).
- **Part D:** Define the demand-guarded type logical relation `LRTypeFamINB` (guarding `.pi`
  codomain recursion by `BotDemand s.1`), which coincides with `LRTypeFamIN` on `BotFamCpt E` and
  satisfies `idPiPropSortStep` and `closedIrrPiCpt` unconditionally across all `c : CptI`. -/

/-! #### Part A — Unconditional `WhDetCtx` from `EnvWfT E` & Admitted Obstructions on Unrestricted Π-Demands (`idPiPropSortStep` and `closedIrrPiCpt`) -/

/-- Unconditional discharge of `WhDetCtx E Γ` at every `EnvWfT E` and `Γ : LCtx`
    (combining `whDetCtx_of_whDet` with `PiModelDeltaIotaAudit.whDet_of_envWfT`). -/
theorem whDetCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx) :
    WhDetCtx E Γ :=
  whDetCtx_of_whDet Γ (PiModelDeltaIotaAudit.whDet_of_envWfT hW)

/-- Unconditional uniqueness of `WhNormalCtx E Γ` normal forms of `WhRedCtx E Γ` at every
    `EnvWfT E` (without assuming `WhDet E`). -/
theorem whRedCtx_normal_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    {a X : Expr Nat} (h : WhRedCtx E Γ a X) (hX : WhNormalCtx E Γ X)
    {Y : Expr Nat} (hY : WhRedCtx E Γ a Y) (hYn : WhNormalCtx E Γ Y) : X = Y :=
  whRedCtx_normal_unique (whDetCtx_of_envWfT hW Γ) h hX hY hYn

/-- Transitivity of `LRTypeFamIN` at every `EnvWfT E` (without assuming `WhDet E`). -/
theorem lrTypeFamIN_trans_of_envWfT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hpi : PiRowField E n) (hΓ : CtxWfT E n Γ)
    {A B C : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamIN E n Γ A B c) (h₂ : LRTypeFamIN E n Γ B C c) :
    LRTypeFamIN E n Γ A C c :=
  lrTypeFamIN_trans hW (PiModelDeltaIotaAudit.whDet_of_envWfT hW) hpi hΓ h₁ h₂

/-- Transitivity of `LRTypeFamIN` at `.pi .bot []` at every `EnvWfT E` (without assuming `WhDet E`
    or `PiRowField E n`). -/
theorem lrTypeFamIN_trans_pi_bot_nil_of_envWfT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) {A B C : Expr Nat}
    (h₁ : LRTypeFamIN E n Γ A B (.pi .bot []))
    (h₂ : LRTypeFamIN E n Γ B C (.pi .bot [])) :
    LRTypeFamIN E n Γ A C (.pi .bot []) :=
  lrTypeFamIN_trans_pi_bot_nil hW (PiModelDeltaIotaAudit.whDet_of_envWfT hW) h₁ h₂

/-- Any assumption-bound variable `.bvar i` (`lookupValue Γ i = none`) takes no `WhStepCtx E Γ`
    steps. -/
theorem whStepCtx_bvar_assump_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {e : Expr Nat}
    (h : WhStepCtx E Γ (.bvar i) e) : False := by
  cases h with
  | zetaLocal hv =>
      rw [hnone] at hv
      exact Option.noConfusion hv
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      rcases list_eq_nil_or_snoc (pre ++ [major]) with hnil | ⟨pre', x, heq⟩
      · cases pre <;> cases hnil
      · rw [heq, foldApps_snoc] at hlhs
        exact Expr.noConfusion hlhs

/-- Any assumption-bound variable `.bvar i` (`lookupValue Γ i = none`) is weak-head normal in
    `WhNormalCtx E Γ`. -/
theorem whNormalCtx_bvar_of_lookupValue_none {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) :
    WhNormalCtx E Γ (.bvar i) :=
  fun _ h => whStepCtx_bvar_assump_false hnone h

/-- Any assumption-bound variable `.bvar i` (`lookupValue Γ i = none`) weak-head reduces in
    `WhRedCtx E Γ` only to itself. -/
theorem whRedCtx_bvar_assump_eq {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {e : Expr Nat}
    (h : WhRedCtx E Γ (.bvar i) e) : e = .bvar i := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepCtx_bvar_assump_false hnone hs).elim

/-- In any context `Γ` with no let-bindings (`∀ i, lookupValue Γ i = none`), no `.bvar`-headed
    spine (`isAnyBvarSpine a = true`) can take a `WhStepCtx E Γ` step. -/
theorem whStepCtx_allAssump_bvarSpine_false {E : ResolvedEnv} {Γ : LCtx}
    (hnone : ∀ i, lookupValue Γ i = none) {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) (hb : isAnyBvarSpine a = true) : False := by
  induction h with
  | beta _ _ _ => exact Bool.noConfusion hb
  | zeta _ _ _ => exact Bool.noConfusion hb
  | @zetaLocal i _ hv =>
      rw [hnone i] at hv
      exact Option.noConfusion hv
  | delta _ _ => exact Bool.noConfusion hb
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      have hbf : isAnyBvarSpine (foldApps (.const r ls) (pre ++ [major])) = false :=
        isAnyBvarSpine_foldApps_false (f := .const r ls) rfl (pre ++ [major])
      rw [hlhs, hbf] at hb
      exact Bool.noConfusion hb
  | lit _ => exact Bool.noConfusion hb
  | appHead _ ih => exact ih hb

/-- In any context `Γ` with `∀ i, lookupValue Γ i = none`, any `.bvar`-headed spine
    (`isAnyBvarSpine a = true`) weak-head reduces in `WhRedCtx E Γ` only to itself. -/
theorem whRedCtx_allAssump_bvarSpine_eq {E : ResolvedEnv} {Γ : LCtx}
    (hnone : ∀ i, lookupValue Γ i = none) {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) (hb : isAnyBvarSpine a = true) : b = a := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepCtx_allAssump_bvarSpine_false hnone hs hb).elim

/-- Pushing `.assumption A` preserves `∀ i, lookupValue Γ i = none`. -/
theorem lookupValue_assumption_cons_none (A : Expr Nat) {Γ : LCtx}
    (hnone : ∀ i, lookupValue Γ i = none) :
    ∀ i, lookupValue (.assumption A :: Γ) i = none
  | 0 => rfl
  | i + 1 => by rw [lookupValue_cons_succ, hnone i]; rfl

/-- **Admitted Obstruction (`not_lrTypeICtx_idPiProp_sortStep`):**
    `LRTypeICtx` (§7) fails on `idPiProp = .pi (.sort .zero) (.bvar 0)` at
    `idPiPropSortStep = .pi .bot [([.sort], .sort)]` because its `.pi` clause checks the
    un-instantiated codomain `.bvar 0` at `s.2 = .sort` even when `s.1 = [.sort]` is a non-`⊥`
    demand. -/
theorem not_lrTypeICtx_idPiProp_sortStep (E : ResolvedEnv) (n : Nat) :
    ¬ LRTypeICtx E n [] PiModelDeltaIotaAudit.idPiProp
        PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiPropSortStep := by
  intro h
  cases h with
  | pi h₁ _ _ _ _ rf =>
      have hEq := whRedCtx_pi_eq h₁
      injection hEq with hA₁ hB₁
      subst hA₁; subst hB₁
      have hsort := rf ([.sort], .sort) (List.mem_singleton.mpr rfl)
      cases hsort with
      | sort hs _ =>
          have := whRedCtx_bvar_assump_eq (Γ := [.assumption (.sort .zero)]) (i := 0) rfl hs
          exact Expr.noConfusion this

/-- Unconditional refutation of unrestricted `FundamentalLRICtx E n` (§7) for every `E, n`. -/
theorem not_fundamentalLRICtx (E : ResolvedEnv) (n : Nat) :
    ¬ FundamentalLRICtx E n :=
  fun F => not_lrTypeICtx_idPiProp_sortStep E n
    (F .nil (.refl [] PiModelDeltaIotaAudit.idPiProp)
      PiModelDeltaIotaAudit.idPiPropSortStep
      PiModelDeltaIotaAudit.approxI_idPiProp_sortStep)

/-- **Admitted Obstruction (`not_lrTypeFamIN_idPiProp_sortStep`):**
    `LRTypeFamIN` (§8) fails on `idPiProp` at `idPiPropSortStep` for the same reason as
    `RcicNativePiModelDeltaIota.not_lrTypeIN_idPiProp_sortStep`. -/
theorem not_lrTypeFamIN_idPiProp_sortStep (E : ResolvedEnv) (n : Nat) :
    ¬ LRTypeFamIN E n [] PiModelDeltaIotaAudit.idPiProp
        PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiPropSortStep := by
  intro h
  cases h with
  | pi h₁ _ _ _ _ _ rf =>
      have hEq := whRedCtx_pi_eq h₁
      injection hEq with hA₁ hB₁
      subst hA₁; subst hB₁
      have hsort := rf ([.sort], .sort) (List.mem_singleton.mpr rfl)
      cases hsort with
      | sort hs _ =>
          have := whRedCtx_bvar_assump_eq (Γ := [.assumption (.sort .zero)]) (i := 0) rfl hs
          exact Expr.noConfusion this

/-- Unconditional refutation of unrestricted `FundamentalLRFamIN E n` (§8) for every `E, n`. -/
theorem not_fundamentalLRFamIN (E : ResolvedEnv) (n : Nat) :
    ¬ FundamentalLRFamIN E n :=
  fun F => not_lrTypeFamIN_idPiProp_sortStep E n
    (F .nil (.refl [] PiModelDeltaIotaAudit.idPiProp)
      PiModelDeltaIotaAudit.idPiPropSortStep
      PiModelDeltaIotaAudit.approxI_idPiProp_sortStep)

/-- Unconditional refutation of unrestricted `FundamentalLRFamINT E n` (§8) for every `E, n`. -/
theorem not_fundamentalLRFamINT (E : ResolvedEnv) (n : Nat) :
    ¬ FundamentalLRFamINT E n :=
  fun F => not_lrTypeFamIN_idPiProp_sortStep E n
    (F .nil (PiModelDeltaIotaAudit.hasTyT_idPiProp E n)
      (.refl [] PiModelDeltaIotaAudit.idPiProp)
      PiModelDeltaIotaAudit.idPiPropSortStep
      PiModelDeltaIotaAudit.approxI_idPiProp_sortStep)

/-- `LRTermFamIN` (§9) fails on `idPiProp` at `idPiPropSortStep` at any sort `.sort u`. -/
theorem not_lrTermFamIN_idPiProp_sortStep (E : ResolvedEnv) (n : Nat) (u : Level) :
    ¬ LRTermFamIN E n [] PiModelDeltaIotaAudit.idPiProp
        PiModelDeltaIotaAudit.idPiProp (.sort u)
        PiModelDeltaIotaAudit.idPiPropSortStep :=
  fun h => not_lrTypeFamIN_idPiProp_sortStep E n
    (lrTypeFamIN_of_lrTermFamIN_sort PiModelDeltaIotaAudit.idPiPropSortStep h)

/-- Unconditional refutation of unrestricted `FundamentalTermFamIN E n` (§9) for every `E, n`. -/
theorem not_fundamentalTermFamIN (E : ResolvedEnv) (n : Nat) :
    ¬ FundamentalTermFamIN E n :=
  fun F => not_lrTermFamIN_idPiProp_sortStep E n _
    (F.1 .nil (PiModelDeltaIotaAudit.hasTyT_idPiProp E n)
      PiModelDeltaIotaAudit.idPiPropSortStep
      PiModelDeltaIotaAudit.approxI_idPiProp_sortStep)

/-- `LRTermFamIND` (§10) fails on `idPiProp` at `idPiPropSortStep` at any sort `.sort u`. -/
theorem not_lrTermFamIND_idPiProp_sortStep (E : ResolvedEnv) (n : Nat) (u : Level) :
    ¬ LRTermFamIND E n [] PiModelDeltaIotaAudit.idPiProp
        PiModelDeltaIotaAudit.idPiProp (.sort u)
        PiModelDeltaIotaAudit.idPiPropSortStep :=
  fun h => not_lrTypeFamIN_idPiProp_sortStep E n
    (lrTypeFamIN_of_lrTermFamIND_sort PiModelDeltaIotaAudit.idPiPropSortStep h)

/-- Unconditional refutation of unrestricted `FundamentalTermFamIND E n` (§10) for every `E, n`. -/
theorem not_fundamentalTermFamIND (E : ResolvedEnv) (n : Nat) :
    ¬ FundamentalTermFamIND E n :=
  fun F => not_lrTermFamIND_idPiProp_sortStep E n _
    (F.1 .nil (PiModelDeltaIotaAudit.hasTyT_idPiProp E n)
      PiModelDeltaIotaAudit.idPiPropSortStep
      PiModelDeltaIotaAudit.approxI_idPiProp_sortStep)

/-- `LRTypeFamIN` also fails on the closed `ConvT.irr`-under-`ConvT.pi` pair `closedIrrPiL` /
    `closedIrrPiR` at `closedIrrPiCpt` (because `closedIrrPiCpt` supplies a non-`⊥` demand for
    `F` and `p`, forcing `WhRedCtx E Γ₄ (.app (.bvar 2) (.bvar 1)) (.sort u)`). -/
theorem not_lrTypeFamIN_closedIrrPi (E : ResolvedEnv) (n : Nat) :
    ¬ LRTypeFamIN E n [] PiModelDeltaIotaAudit.closedIrrPiL
        PiModelDeltaIotaAudit.closedIrrPiR PiModelDeltaIotaAudit.closedIrrPiCpt := by
  intro h₁
  cases h₁ with
  | pi hred₁ _ _ _ _ _ rf₁ =>
      have e₁ := whRedCtx_pi_eq hred₁
      injection e₁ with hA₁ hB₁
      subst hA₁; subst hB₁
      have h₂ := rf₁ _ (List.mem_singleton.mpr rfl)
      cases h₂ with
      | pi hred₂ _ _ _ _ _ rf₂ =>
          have e₂ := whRedCtx_pi_eq hred₂
          injection e₂ with hA₂ hB₂
          subst hA₂; subst hB₂
          have h₃ := rf₂ _ (List.mem_singleton.mpr rfl)
          cases h₃ with
          | pi hred₃ _ _ _ _ _ rf₃ =>
              have e₃ := whRedCtx_pi_eq hred₃
              injection e₃ with hA₃ hB₃
              subst hA₃; subst hB₃
              have h₄ := rf₃ _ (List.mem_singleton.mpr rfl)
              cases h₄ with
              | pi hred₄ _ _ _ _ _ rf₄ =>
                  have e₄ := whRedCtx_pi_eq hred₄
                  injection e₄ with hA₄ hB₄
                  subst hA₄; subst hB₄
                  have h₅ := rf₄ _ (List.mem_singleton.mpr rfl)
                  cases h₅ with
                  | sort hs _ =>
                      have hnone₀ : ∀ i, lookupValue ([] : LCtx) i = none := by
                        intro i; cases i <;> rfl
                      have hnone₄ :=
                        lookupValue_assumption_cons_none (.bvar 2)
                          (lookupValue_assumption_cons_none (.bvar 1)
                            (lookupValue_assumption_cons_none (.pi (.bvar 0) (.sort .zero))
                              (lookupValue_assumption_cons_none (.sort .zero) hnone₀)))
                      have heq := whRedCtx_allAssump_bvarSpine_eq hnone₄ hs rfl
                      exact Expr.noConfusion heq

/-- `LRTermFamIND` fails on `closedIrrPiL` / `closedIrrPiR` at `closedIrrPiCpt` at any sort. -/
theorem not_lrTermFamIND_closedIrrPi (E : ResolvedEnv) (n : Nat) (u : Level) :
    ¬ LRTermFamIND E n [] PiModelDeltaIotaAudit.closedIrrPiL
        PiModelDeltaIotaAudit.closedIrrPiR (.sort u)
        PiModelDeltaIotaAudit.closedIrrPiCpt :=
  fun h => not_lrTypeFamIN_closedIrrPi E n
    (lrTypeFamIN_of_lrTermFamIND_sort PiModelDeltaIotaAudit.closedIrrPiCpt h)


/-! #### Part B — The Family-Aware `BotFamCpt E` Layer, Soundness-Free Two-Sided Approximation (`approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt`), `FundamentalLRFamINBot`, and `FundamentalTermFamINDBot` -/

/-- **The Family-Aware `⊥`-Demand Compact Sub-Family (`BotFamCpt E`):**
    Extends `PiModelDeltaIotaAudit.BotPiCpt` (#7649) with `famSpine`: for any admitted
    `.inductiveM` family head `r` (`E.members r = some m`, `m.mclass = .inductiveM`), `.spine r args`
    with `args.length = (piDomsOf m.mtype).length` and `BotDemand args` (`∀ u ∈ args, u = .bot`)
    is a `BotFamCpt E` compact.
    - Contains `.bot`, `.sort`, `.pi .bot []`, and `.spine r (botVecI xs)` (for saturated family
      spines `xs.length = (piDomsOf m.mtype).length`).
    - Excludes `.lam g` and any `.pi a f` with a non-`⊥` step demand (such as `idPiPropSortStep`
      and `closedIrrPiCpt`). -/
inductive BotFamCpt (E : ResolvedEnv) : CptI → Prop
  | bot : BotFamCpt E .bot
  | sort : BotFamCpt E .sort
  | pi {a : CptI} {f : List (List CptI × CptI)}
      (ha : BotFamCpt E a)
      (hbd : ∀ s ∈ f, PiModelDeltaIotaAudit.BotDemand s.1)
      (hf : ∀ s ∈ f, BotFamCpt E s.2) :
      BotFamCpt E (.pi a f)
  | famSpine {r : Nat} {m : CheckedMember} {args : List CptI}
      (hm : E.members r = some m)
      (hind : m.mclass = .inductiveM)
      (hlen : args.length = (piDomsOf m.mtype).length)
      (hbd : PiModelDeltaIotaAudit.BotDemand args) :
      BotFamCpt E (.spine r args)

/-- Every `PiModelDeltaIotaAudit.BotPiCpt c` is a `BotFamCpt E c`. -/
theorem botFamCpt_of_botPiCpt {E : ResolvedEnv} {c : CptI}
    (h : PiModelDeltaIotaAudit.BotPiCpt c) : BotFamCpt E c := by
  induction h with
  | bot => exact .bot
  | sort => exact .sort
  | pi _ hbd _ iha ihf => exact .pi iha hbd ihf

/-- `.pi .bot []` satisfies `BotFamCpt E`. -/
theorem botFamCpt_pi_bot_nil (E : ResolvedEnv) : BotFamCpt E (.pi .bot []) :=
  botFamCpt_of_botPiCpt PiModelDeltaIotaAudit.botPiCpt_pi_bot_nil

/-- Every `botVecI xs` satisfies `PiModelDeltaIotaAudit.BotDemand`. -/
theorem botDemand_botVecI (xs : List (Expr Nat)) :
    PiModelDeltaIotaAudit.BotDemand (botVecI xs) :=
  fun _ hu => mem_botVecI_eq_bot xs hu

/-- For any admitted `.inductiveM` family head `r` and any `xs` of length
    `(piDomsOf m.mtype).length`, `.spine r (botVecI xs)` satisfies `BotFamCpt E`. -/
theorem botFamCpt_famSpine_botVecI {E : ResolvedEnv}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} (hlen : xs.length = (piDomsOf m.mtype).length) :
    BotFamCpt E (.spine r (botVecI xs)) :=
  .famSpine hm hind ((botVecI_length xs).trans hlen) (botDemand_botVecI xs)

/-- Canonical `botVecI (piDomsOf m.mtype)` spine compact satisfies `BotFamCpt E`. -/
theorem botFamCpt_famSpine_doms {E : ResolvedEnv}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    BotFamCpt E (.spine r (botVecI (piDomsOf m.mtype))) :=
  botFamCpt_famSpine_botVecI hm hind rfl

/-- No `.lam g` compact is in `BotFamCpt E`. -/
theorem not_botFamCpt_lam (E : ResolvedEnv) (g : List (List CptI × CptI)) :
    ¬ BotFamCpt E (.lam g) :=
  fun h => nomatch h

/-- `idPiPropSortStep = .pi .bot [([.sort], .sort)]` is excluded by `BotFamCpt E`. -/
theorem not_botFamCpt_idPiPropSortStep (E : ResolvedEnv) :
    ¬ BotFamCpt E PiModelDeltaIotaAudit.idPiPropSortStep := by
  intro h
  cases h with
  | pi _ hbd _ =>
      have := hbd ([.sort], .sort) (List.mem_singleton.mpr rfl) .sort (List.mem_singleton.mpr rfl)
      exact CptI.noConfusion this

/-- `closedIrrPiCpt` is excluded by `BotFamCpt E`. -/
theorem not_botFamCpt_closedIrrPiCpt (E : ResolvedEnv) :
    ¬ BotFamCpt E PiModelDeltaIotaAudit.closedIrrPiCpt := by
  intro h
  cases h with
  | pi _ _ hf₁ =>
      have h₂ := hf₁ _ (List.mem_singleton.mpr rfl)
      cases h₂ with
      | pi _ hbd₂ _ =>
          have := hbd₂ _ (List.mem_singleton.mpr rfl)
            (.lam [([.sort], .sort)]) (List.mem_singleton.mpr rfl)
          exact CptI.noConfusion this

/-- Non-`⊥` environment monotonicity of `ApproxI`: since `.bot` approximates every expression in
    every environment, `ApproxI` only inspects `ρ` on compacts `c ≠ .bot`. -/
theorem approxI_mono_env_nonbot {ρ ρ' : EnvI}
    (hle : ∀ i c, c ≠ .bot → ρ i c → ρ' i c) {e : Expr Nat} {c : CptI}
    (h : ApproxI ρ e c) : ApproxI ρ' e c := by
  induction h generalizing ρ' with
  | bot => exact .bot _ _
  | @bvar ρ i c h =>
      cases c with
      | bot => exact .bot _ _
      | sort => exact .bvar (hle i .sort (fun h => nomatch h) h)
      | pi a f => exact .bvar (hle i (.pi a f) (fun h => nomatch h) h)
      | spine r args => exact .bvar (hle i (.spine r args) (fun h => nomatch h) h)
      | lam g => exact .bvar (hle i (.lam g) (fun h => nomatch h) h)
  | sort => exact .sort _ _
  | pi _ _ ihA ihB =>
      refine .pi (ihA hle) (fun s hs => ihB s hs ?_)
      intro i c hc
      cases i with
      | zero => exact id
      | succ i => exact hle i c hc
  | lam _ ihb =>
      refine .lam (fun s hs => ihb s hs ?_)
      intro i c hc
      cases i with
      | zero => exact id
      | succ i => exact hle i c hc
  | app _ hs _ ihf iha =>
      exact .app (ihf hle) hs (fun u hu => iha u hu hle)
  | const => exact .const _ _ _
  | appSpine _ _ ihf iha => exact .appSpine (ihf hle) (iha hle)
  | letE _ ih => exact .letE (ih hle)
  | lit _ ih => exact .lit (ih hle)

/-- **Key Context-Aware `BotDemand` Invariance (`approxI_cons_botDemand_ctxEnvI_iff`):**
    For **every** local context `Γ` (including contexts with `letBinding`s!), extending `ctxEnvI Γ`
    by `demand us` for any `BotDemand us` has the exact same `ApproxI` approximations as
    `ctxEnvI (.assumption A :: Γ) = EnvI.cons botSetI (ctxEnvI Γ)`. -/
theorem approxI_cons_botDemand_ctxEnvI_iff {Γ : LCtx} {us : List CptI}
    (h : PiModelDeltaIotaAudit.BotDemand us) (A e : Expr Nat) (c : CptI) :
    ApproxI (EnvI.cons (demand us) (ctxEnvI Γ)) e c ↔
      ApproxI (ctxEnvI (.assumption A :: Γ)) e c := by
  constructor
  · refine approxI_mono_env_nonbot (fun i u hne => ?_)
    cases i with
    | zero => intro hu; exact (hne (h u hu)).elim
    | succ i => exact id
  · refine approxI_mono_env_nonbot (fun i u hne => ?_)
    cases i with
    | zero => intro hu; exact (hne hu).elim
    | succ i => exact id

/-- Any argument list `xs` and compact list `cs` of equal length with `BotDemand cs` satisfy
    `ApproxIArgs ρ xs cs` in every environment `ρ : EnvI`. -/
theorem approxIArgs_of_botDemand (ρ : EnvI) :
    {xs : List (Expr Nat)} → {cs : List CptI} →
    xs.length = cs.length → PiModelDeltaIotaAudit.BotDemand cs →
    ApproxIArgs ρ xs cs
  | [], [], _, _ => .nil
  | [], _ :: _, hlen, _ => nomatch hlen
  | _ :: _, [], hlen, _ => nomatch hlen
  | x :: xs, c :: cs, hlen, hbd => by
      have hc : c = .bot := hbd c (List.mem_cons_self _ _)
      subst hc
      exact .cons (.bot ρ x)
        (approxIArgs_of_botDemand ρ (Nat.succ.inj hlen)
          (fun u hu => hbd u (List.mem_cons_of_mem _ hu)))

/-- For any `xs` and `cs` of equal length with `BotDemand cs`, `.spine r cs` approximates
    `foldApps (.const r ls) xs` at every `ρ : EnvI`. -/
theorem approxI_famApp_of_botDemand (ρ : EnvI) (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {cs : List CptI}
    (hlen : xs.length = cs.length) (hbd : PiModelDeltaIotaAudit.BotDemand cs) :
    ApproxI ρ (foldApps (.const r ls) xs) (.spine r cs) :=
  approxI_famApp r ls (approxIArgs_of_botDemand ρ hlen hbd)

/-- **Soundness-Free Two-Sided Approximation on `BotFamCpt E`
    (`approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt`):**
    Under `WhApproxInvCore E` alone (with **zero** `TypeSoundnessI` or `ShallowTypeSoundnessCtxI`
    premises), for every `BotFamCpt E c` and every local context `Γ`, `LRTypeFamIN E n Γ A B c`
    implies **both** `ApproxI (ctxEnvI Γ) A c` and `ApproxI (ctxEnvI Γ) B c`. -/
theorem approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A B c) :
    ApproxI (ctxEnvI Γ) A c ∧ ApproxI (ctxEnvI Γ) B c := by
  induction h with
  | bot => exact ⟨.bot _ _, .bot _ _⟩
  | sort hA hB =>
      exact ⟨approxI_ctxEnvI_sort_of_whRedCtx hcore hA,
             approxI_ctxEnvI_sort_of_whRedCtx hcore hB⟩
  | @pi Γ A B A₁ B₁ A₂ B₂ a f hA hB _ _ _ _ _ iha ihf =>
      cases hc with
      | pi ha hbd hf =>
          obtain ⟨ha₁, ha₂⟩ := iha ha
          have hf₁ : ∀ s ∈ f, ApproxI (EnvI.cons (demand s.1) (ctxEnvI Γ)) B₁ s.2 :=
            fun s hs =>
              (approxI_cons_botDemand_ctxEnvI_iff (hbd s hs) A₁ B₁ s.2).mpr
                (ihf s hs (hf s hs)).1
          have hf₂ : ∀ s ∈ f, ApproxI (EnvI.cons (demand s.1) (ctxEnvI Γ)) B₂ s.2 :=
            fun s hs =>
              (approxI_cons_botDemand_ctxEnvI_iff (hbd s hs) A₁ B₂ s.2).mpr
                (ihf s hs (hf s hs)).2
          exact ⟨(approxI_ctxEnvI_whRedCtx hcore hA (.pi a f)).mpr (.pi ha₁ hf₁),
                 (approxI_ctxEnvI_whRedCtx hcore hB (.pi a f)).mpr (.pi ha₂ hf₂)⟩
  | @famSpine Γ A B r m' ls ls' xs xs' _ _ args hm' _ hA hB _ _ _ _ hlenA hlenB _ =>
      cases hc with
      | famSpine hm _ hlenArgs hbd =>
          rw [hm] at hm'
          injection hm' with hm_eq
          subst hm_eq
          have hspA : ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r args) :=
            approxI_famApp_of_botDemand (ctxEnvI Γ) r ls (hlenA.trans hlenArgs.symm) hbd
          have hspB : ApproxI (ctxEnvI Γ) (foldApps (.const r ls') xs') (.spine r args) :=
            approxI_famApp_of_botDemand (ctxEnvI Γ) r ls' (hlenB.trans hlenArgs.symm) hbd
          exact ⟨(approxI_ctxEnvI_whRedCtx hcore hA (.spine r args)).mpr hspA,
                 (approxI_ctxEnvI_whRedCtx hcore hB (.spine r args)).mpr hspB⟩
  | otherSpine hnot _ _ _ _ _ =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- Right-hand projection of `approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt`. -/
theorem approxI_ctxEnvI_right_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A B c) :
    ApproxI (ctxEnvI Γ) B c :=
  (approxI_ctxEnvI_of_lrTypeFamIN_botFamCpt hcore hc h).2

/-- The `.pi` congruence case of `LRTypeFamIN` on `BotFamCpt E` at `ctxEnvI Γ`:
    because `BotFamCpt.pi` restricts every step `s ∈ f` to `BotDemand s.1`,
    `EnvI.cons (demand s.1) (ctxEnvI Γ)` reduces directly to `ctxEnvI (.assumption A₁ :: Γ)`
    (`approxI_cons_botDemand_ctxEnvI_iff`) in **every** context `Γ` (even with `letBinding`s). -/
theorem lrTypeFamIN_botFamCpt_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat}
    (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
    (hdom : TyConvT E n Γ A₁ A₂)
    (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
    (ihA : ∀ c, BotFamCpt E c → ApproxI (ctxEnvI Γ) A₁ c → LRTypeFamIN E n Γ A₁ A₂ c)
    (ihB : ∀ c, BotFamCpt E c → ApproxI (ctxEnvI (.assumption A₁ :: Γ)) B₁ c →
      LRTypeFamIN E n (.assumption A₁ :: Γ) B₁ B₂ c) :
    ∀ c, BotFamCpt E c → ApproxI (ctxEnvI Γ) (.pi A₁ B₁) c →
      LRTypeFamIN E n Γ (.pi A₁ B₁) (.pi A₂ B₂) c := by
  intro c hc hpi
  rcases approxI_pi_inv hpi with rfl | ⟨a, f, rfl, ha, hf⟩
  · exact .bot _ _ _
  · cases hc with
    | pi hca hbd hcf =>
        refine lrTypeFamIN_pi_congr hΓ₁ hdom hcod (ihA a hca ha) (fun s hs => ?_)
        have hb : ApproxI (ctxEnvI (.assumption A₁ :: Γ)) B₁ s.2 :=
          (approxI_cons_botDemand_ctxEnvI_iff (hbd s hs) A₁ B₁ s.2).mp (hf s hs)
        exact ihB s.2 (hcf s hs) hb

/-- In any context `Γ` whose entry `i` is `.assumption` (so `ctxEnvI Γ i = botSetI`), `.bvar i`
    is approximated in `ctxEnvI Γ` only by `.bot`. -/
theorem approxI_bvar_eq_bot_of_botSetI {ρ : EnvI} {i : Nat}
    (hbot : ∀ c, ρ i c → c = .bot) {c : CptI}
    (h : ApproxI ρ (.bvar i) c) : c = .bot := by
  rcases approxI_bvar_inv h with rfl | hi
  · rfl
  · exact hbot c hi

/-- In `ctxEnvI []` extended by any number of `.assumption`s, every `.bvar i` is approximated
    only by `.bot`. -/
theorem ctxEnvI_allAssump_bot {Γ : LCtx}
    (hnone : ∀ i, lookupValue Γ i = none) :
    ∀ (i : Nat) (c : CptI), ctxEnvI Γ i c → c = .bot := by
  induction Γ with
  | nil =>
      intro i c hc
      exact hc
  | cons d Γ ih =>
      cases d with
      | assumption A =>
          intro i c hc
          cases i with
          | zero => exact hc
          | succ i =>
              exact ih (fun j => by
                have := hnone (j + 1)
                rw [lookupValue_cons_succ] at this
                cases h : lookupValue Γ j with
                | none => rfl
                | some v => rw [h] at this; exact Option.noConfusion this) i c hc
      | letBinding A v =>
          have := hnone 0
          exact Option.noConfusion this

/-- **Positive Resolution of `idPiProp` on `BotFamCpt E` (`lrTypeFamIN_botFamCpt_idPiProp`):**
    `idPiProp = .pi (.sort .zero) (.bvar 0)` satisfies `LRTypeFamIN` at every `BotFamCpt E c`
    approximating `idPiProp` in `ctxEnvI []`. -/
theorem lrTypeFamIN_botFamCpt_idPiProp (E : ResolvedEnv) (n : Nat) :
    ∀ c, BotFamCpt E c →
      ApproxI (ctxEnvI []) PiModelDeltaIotaAudit.idPiProp c →
      LRTypeFamIN E n [] PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiProp c := by
  refine lrTypeFamIN_botFamCpt_pi
    (.assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero))
    (.refl [] (.sort .zero))
    (.refl [.assumption (.sort .zero)] (.bvar 0))
    (fun c _ hs => by
      rcases approxI_sort_inv hs with rfl | rfl
      · exact .bot _ _ _
      · exact lrTypeFamIN_sort_congr [] .zero .zero)
    (fun c _ hb => by
      have h0 : c = .bot :=
        approxI_bvar_eq_bot_of_botSetI (fun _ h => h) hb
      subst h0
      exact .bot _ _ _)

/-- **Positive Resolution of `idPiProp` for `LRTermFamIND` on `BotFamCpt E`
    (`lrTermFamIND_botFamCpt_idPiProp`):** -/
theorem lrTermFamIND_botFamCpt_idPiProp (E : ResolvedEnv) (n : Nat) (u : Level) :
    ∀ c, BotFamCpt E c →
      ApproxI (ctxEnvI []) PiModelDeltaIotaAudit.idPiProp c →
      LRTermFamIND E n [] PiModelDeltaIotaAudit.idPiProp
        PiModelDeltaIotaAudit.idPiProp (.sort u) c :=
  fun c hc hA =>
    lrTermFamIND_of_lrTypeFamIN_sort u c (lrTypeFamIN_botFamCpt_idPiProp E n c hc hA)

/-- **Positive Resolution of `closedIrrPiL` / `closedIrrPiR` on `BotFamCpt E`
    (`lrTypeFamIN_botFamCpt_closedIrrPi`):**
    The closed `ConvT.irr`-under-`ConvT.pi` pair `closedIrrPiL` / `closedIrrPiR` satisfies
    `LRTypeFamIN` at every `BotFamCpt E c` approximating `closedIrrPiL` in `ctxEnvI []`. -/
theorem lrTypeFamIN_botFamCpt_closedIrrPi (E : ResolvedEnv) (n : Nat) :
    ∀ c, BotFamCpt E c →
      ApproxI (ctxEnvI []) PiModelDeltaIotaAudit.closedIrrPiL c →
      LRTypeFamIN E n [] PiModelDeltaIotaAudit.closedIrrPiL
        PiModelDeltaIotaAudit.closedIrrPiR c := by
  let Γ₁ : LCtx := [.assumption (.sort .zero)]
  let Γ₂ : LCtx := .assumption (.pi (.bvar 0) (.sort .zero)) :: Γ₁
  let Γ₃ : LCtx := .assumption (.bvar 1) :: Γ₂
  let Γ₄ : LCtx := .assumption (.bvar 2) :: Γ₃
  have hΓ₁ : CtxWfT E n Γ₁ := .assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero)
  have hA₁ : HasTyT E n Γ₁ (.pi (.bvar 0) (.sort .zero)) (.sort (.imax .zero (.succ .zero))) :=
    .pi Γ₁ (.bvar 0) .zero (.sort .zero) (.succ .zero)
      (.bvar Γ₁ 0 (.sort .zero) rfl) (.sort _ .zero)
  have hΓ₂ : CtxWfT E n Γ₂ := .assumption Γ₁ _ _ hΓ₁ hA₁
  have hΓ₃ : CtxWfT E n Γ₃ := .assumption Γ₂ (.bvar 1) .zero hΓ₂ (.bvar Γ₂ 1 (.sort .zero) rfl)
  have hΓ₄ : CtxWfT E n Γ₄ := .assumption Γ₃ (.bvar 2) .zero hΓ₃ (.bvar Γ₃ 2 (.sort .zero) rfl)
  have hP : HasTyT E n Γ₄ (.bvar 3) (.sort .zero) := .bvar Γ₄ 3 (.sort .zero) rfl
  have hF : HasTyT E n Γ₄ (.bvar 2) (.pi (.bvar 3) (.sort .zero)) :=
    .bvar Γ₄ 2 (.pi (.bvar 3) (.sort .zero)) rfl
  have hp : HasTyT E n Γ₄ (.bvar 1) (.bvar 3) := .bvar Γ₄ 1 (.bvar 3) rfl
  have hq : HasTyT E n Γ₄ (.bvar 0) (.bvar 3) := .bvar Γ₄ 0 (.bvar 3) rfl
  have hbodyConv : ConvT E n Γ₄ (.app (.bvar 2) (.bvar 1)) (.app (.bvar 2) (.bvar 0)) (.sort .zero) :=
    .app Γ₄ (.bvar 2) (.bvar 2) (.bvar 1) (.bvar 0) (.bvar 3) (.sort .zero)
      (.refl Γ₄ (.bvar 2) _ hF) (.irr Γ₄ (.bvar 3) (.bvar 1) (.bvar 0) hP hp hq)
  have hcod₃ : ConvT E n Γ₃ (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))
      (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))) (.sort (.imax .zero .zero)) :=
    .pi Γ₃ _ _ _ _ .zero .zero (.refl Γ₃ _ _ (.bvar Γ₃ 2 (.sort .zero) rfl)) hbodyConv
  have hcod₂ : ConvT E n Γ₂ (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1))))
      (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))))
      (.sort (.imax .zero (.imax .zero .zero))) :=
    .pi Γ₂ _ _ _ _ .zero _ (.refl Γ₂ _ _ (.bvar Γ₂ 1 (.sort .zero) rfl)) hcod₃
  have hcod₁ : ConvT E n Γ₁
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))))
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0)))))
      (.sort (.imax (.imax .zero (.succ .zero)) (.imax .zero (.imax .zero .zero)))) :=
    .pi Γ₁ _ _ _ _ _ _ (.refl Γ₁ _ _ hA₁) hcod₂
  have hnone₀ : ∀ i, lookupValue ([] : LCtx) i = none := by intro i; cases i <;> rfl
  have hnone₁ := lookupValue_assumption_cons_none (A := .sort .zero) hnone₀
  have hnone₂ := lookupValue_assumption_cons_none (A := .pi (.bvar 0) (.sort .zero)) hnone₁
  have hnone₃ := lookupValue_assumption_cons_none (A := .bvar 1) hnone₂
  have hnone₄ := lookupValue_assumption_cons_none (A := .bvar 2) hnone₃
  refine lrTypeFamIN_botFamCpt_pi hΓ₁ (.refl [] _) (.of Γ₁ _ _ _ hcod₁)
    (fun c _ hs => by
      rcases approxI_sort_inv hs with rfl | rfl
      · exact .bot _ _ _
      · exact lrTypeFamIN_sort_congr [] .zero .zero)
    (lrTypeFamIN_botFamCpt_pi hΓ₂ (.refl Γ₁ _) (.of Γ₂ _ _ _ hcod₂)
      (lrTypeFamIN_botFamCpt_pi
        (.assumption Γ₁ (.bvar 0) .zero hΓ₁ (.bvar Γ₁ 0 (.sort .zero) rfl))
        (.refl Γ₁ _) (.refl _ _)
        (fun c _ hb => by
          have h0 := approxI_bvar_eq_bot_of_botSetI (ctxEnvI_allAssump_bot hnone₁ 0) hb
          subst h0; exact .bot _ _ _)
        (fun c _ hs => by
          rcases approxI_sort_inv hs with rfl | rfl
          · exact .bot _ _ _
          · exact lrTypeFamIN_sort_congr _ .zero .zero))
      (lrTypeFamIN_botFamCpt_pi hΓ₃ (.refl Γ₂ _) (.of Γ₃ _ _ _ hcod₃)
        (fun c _ hb => by
          have h0 := approxI_bvar_eq_bot_of_botSetI (ctxEnvI_allAssump_bot hnone₂ 1) hb
          subst h0; exact .bot _ _ _)
        (lrTypeFamIN_botFamCpt_pi hΓ₄ (.refl Γ₃ _) (.of Γ₄ _ _ _ hbodyConv)
          (fun c _ hb => by
            have h0 := approxI_bvar_eq_bot_of_botSetI (ctxEnvI_allAssump_bot hnone₃ 2) hb
            subst h0; exact .bot _ _ _)
          (fun c _ happ => by
            rcases approxI_app_inv happ with rfl | ⟨_, _, _, hf, _, _⟩ | ⟨_, _, _, _, hf, _⟩
            · exact .bot _ _ _
            · have h0 := approxI_bvar_eq_bot_of_botSetI (ctxEnvI_allAssump_bot hnone₄ 2) hf
              exact CptI.noConfusion h0
            · have h0 := approxI_bvar_eq_bot_of_botSetI (ctxEnvI_allAssump_bot hnone₄ 2) hf
              exact CptI.noConfusion h0))))

/-- **Positive Resolution of `closedIrrPiL` / `closedIrrPiR` for `LRTermFamIND` on `BotFamCpt E`
    (`lrTermFamIND_botFamCpt_closedIrrPi`):** -/
theorem lrTermFamIND_botFamCpt_closedIrrPi (E : ResolvedEnv) (n : Nat) (u : Level) :
    ∀ c, BotFamCpt E c →
      ApproxI (ctxEnvI []) PiModelDeltaIotaAudit.closedIrrPiL c →
      LRTermFamIND E n [] PiModelDeltaIotaAudit.closedIrrPiL
        PiModelDeltaIotaAudit.closedIrrPiR (.sort u) c :=
  fun c hc hA =>
    lrTypeFamIN_botFamCpt_closedIrrPi E n c hc hA |> lrTermFamIND_of_lrTypeFamIN_sort u c

/-- Any `BotFamCpt E` compact approximating `.lam A b` in `ApproxI` is `.bot`
    (since `ApproxI` on `.lam A b` yields only `.bot` or `.lam f`, and `¬ BotFamCpt E (.lam f)`). -/
theorem approxI_lam_botFamCpt_eq_bot {E : ResolvedEnv} {ρ : EnvI} {A b : Expr Nat} {u : CptI}
    (hu : BotFamCpt E u) (h : ApproxI ρ (.lam A b) u) : u = .bot := by
  rcases approxI_lam_inv h with rfl | ⟨f, rfl, _⟩
  · rfl
  · exact (not_botFamCpt_lam E f hu).elim

/-- On `BotFamCpt E` compacts, any term pair `(.lam A b, e)` with a λ-abstraction on the left
    satisfies `LRTermFamIND E n Γ (.lam A b) e T u` unconditionally (discharging `HasTyT.lam`,
    `ConvT.lam`, and left-handed `ConvT.eta` on `BotFamCpt E`). -/
theorem lrTermFamIND_botFamCpt_lam_left {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (ρ : EnvI) (A b e T : Expr Nat) :
    ∀ u, BotFamCpt E u → ApproxI ρ (.lam A b) u → LRTermFamIND E n Γ (.lam A b) e T u := by
  intro u hu hlam
  rw [approxI_lam_botFamCpt_eq_bot hu hlam]
  exact lrTermFamIND_bot Γ (.lam A b) e T

/-- **The `BotFamCpt E`-Restricted Typed Type-Level Fundamental Lemma (`FundamentalLRFamINBot E n`):**
    Repairs `FundamentalLRFamINT E n` (§8) by restricting `c` to `BotFamCpt E c`. -/
def FundamentalLRFamINBot (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, BotFamCpt E c → ApproxI (ctxEnvI Γ) A c → LRTypeFamIN E n Γ A A' c

/-- Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalLRFamINBot E n`
    (evaluating at `c = .pi .bot []`, which satisfies `botFamCpt_pi_bot_nil E`). -/
theorem piRowField_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n) : PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
        (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- Disjointness of `.pi A B` and `.sort l` under `FundamentalLRFamINBot E n`. -/
theorem not_tyConvT_pi_sort_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · exact Expr.noConfusion heq
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    have hLR := F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
      (approxI_pi_bot_nil (ctxEnvI Γ) A B)
    cases hLR with
    | pi _ hred' _ _ _ _ _ => exact nomatch whRedCtx_sort_eq hred'

/-- Disjointness of `.sort l` and `.pi A B` under `FundamentalLRFamINBot E n`. -/
theorem not_tyConvT_sort_pi_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (_hW : EnvWfT E) (F : FundamentalLRFamINBot E n)
    {Γ : LCtx} (_hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hLR := F _hΓ (.sort Γ l) hc .sort .sort (.sort (ctxEnvI Γ) l)
  cases hLR with
  | sort _ hred' => exact nomatch whRedCtx_pi_eq hred'

/-- Saturation (`xs.length = doms.length`) of any sort-typed admitted `.inductiveM` family spine
    under `FundamentalLRFamINBot E n`. -/
theorem famApp_saturated_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  have hprow : PiRowField E n := piRowField_of_fundamentalLRFamINBot hW F
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_fundamentalLRFamINBot hW F hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_fundamentalLRFamINBot hW F hΓ hconv

/-- Canonical stored-domain saturation `xs.length = (piDomsOf m.mtype).length` from
    `FundamentalLRFamINBot E n`. -/
theorem famApp_length_eq_piDomsOf_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = (piDomsOf m.mtype).length := by
  have hlen := famApp_saturated_of_fundamentalLRFamINBot hW F hΓ hm hind
    (instMtype_policyPi_of_inductiveM hW hm hind ls) hty
  rwa [List.length_map] at hlen

/-- Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from `FundamentalLRFamINBot E n`:
    saturation (`famApp_length_eq_piDomsOf_of_fundamentalLRFamINBot`) ensures `.spine r (botVecI xs)`
    is in `BotFamCpt E` (`botFamCpt_famSpine_botVecI`). -/
theorem famAppRow_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n) : FamAppRowLink E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBot hW F hΓ hm hind hty
  exact lrTypeFamIN_famApp_components hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxI_famApp_botVecI (ctxEnvI Γ) r ls xs))

/-- Derive `KernelRowsAssembly.FamRelevantSlotConv E n` (`W-F8-FAMAPP-ARG-COMPARISON`) from
    `FundamentalLRFamINBot E n`. -/
theorem famRelevantSlotConv_of_fundamentalLRFamINBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBot E n) : FamRelevantSlotConv E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBot hW F hΓ hm hind hty
  exact lrTypeFamIN_famApp_relevantSlotConv hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxI_famApp_botVecI (ctxEnvI Γ) r ls xs))

/-- Transport `IsNonSortPropCtx` along `TyConvT E n Γ A A'` using `FundamentalLRFamINBot E n`
    (which only evaluates at `c = .sort`, satisfying `BotFamCpt.sort`). -/
theorem isNonSortPropCtx_transport_bot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsNonSortPropCtx E n Γ A) :
    IsNonSortPropCtx E n Γ A' := by
  obtain ⟨hno, ⟨hA0⟩⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨fun l hred' => ?_, ⟨hA'0⟩⟩
  have hcA' : ApproxI (ctxEnvI Γ) A' .sort := approxI_ctxEnvI_sort_of_whRedCtx hcore hred'
  have hLR : LRTypeFamIN E n Γ A' A .sort := hF hΓ hA'0 hAA'.symmT .sort .sort hcA'
  cases hLR with
  | sort _ hredA => exact hno _ hredA

/-- Transport `∀ l, ¬ WhRedCtx E Γ A (.sort l)` across `TyConvT E n Γ A A'` using
    `FundamentalLRFamINBot E n` (which only evaluates at `c = .sort`). -/
theorem not_whRedCtx_sort_transport_bot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E) (hF : FundamentalLRFamINBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hc : TyConvT E n Γ A A')
    (hns : ∀ l, ¬ WhRedCtx E Γ A (.sort l)) :
    ∀ l, ¬ WhRedCtx E Γ A' (.sort l) := by
  intro l hl'
  obtain ⟨u', hA'⟩ := tyConvT_endTyped hW hΓ hc hA
  have hsortA' : ApproxI (ctxEnvI Γ) A' .sort :=
    approxI_ctxEnvI_sort_of_whRedCtx hcore hl'
  have hLR := hF hΓ hA' hc.symmT .sort .sort hsortA'
  cases hLR with
  | sort _ hredA => exact hns _ hredA

/-- **Full Index Transport for `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBot E n` and `EnvWfT E` (`lrTermFamIND_transport_bot`):**
    Requires **no** `WhDet E` hypothesis (discharged by `whDetCtx_of_envWfT hW`) and uses the
    non-vacuous `FundamentalLRFamINBot E n` (which is only evaluated at `.sort` and `.pi .bot []`). -/
theorem lrTermFamIND_transport_bot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINBot E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A A' : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' →
    ∀ {M M' : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M M' A' c
  | .bot, _, _, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport_bot hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .pi a f, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport_bot hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .spine r args, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · have hs := hF hΓ hA hAA' .sort .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inl ⟨⟨_, hl'⟩, hLR⟩
      · exact Or.inr (Or.inl (isNonSortPropCtx_transport_bot hW zsc hcore hF hΓ hAA' hprop))
      · exact Or.inr (Or.inr ⟨not_whRedCtx_sort_transport_bot hW hcore hF hΓ hA hAA' hns,
          Y, Y', hY, hY', hn, hn', ⟨convT_of_tyConv hc hAA'⟩⟩)
  | .lam g, Γ, hΓ, A, A', _, hA, hAA', M, M', h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl (isNonSortPropCtx_transport_bot hW zsc hcore hF hΓ hAA' hprop)
      · have hpi := hF hΓ hA hAA' (.pi .bot []) (botFamCpt_pi_bot_nil E)
          (approxI_ctxEnvI_pi_of_whRedCtx hcore hred)
        cases hpi with
        | @pi _ _ _ A₁' B₁' A₂ B₂ _ _ hred₁ hred₂ _ hdom hcod _ _ =>
            have e := whRedCtx_normal_unique_of_envWfT hW
              hred (whNormalCtx_pi A₁ B₁) hred₁ (whNormalCtx_pi A₁' B₁')
            injection e with eA eB
            subst eA; subst eB
            cases hΓ₁ with
            | assumption _ _ u₁ _ hA₁ =>
                obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hdom hA₁
                have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ u₂ hΓ hA₂
                have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
                obtain ⟨w₂, hB₂_A₁⟩ := tyConvT_endTyped hW hΓ₁' hcod hB₁
                have hB₂ : HasTyT E n (.assumption A₂ :: Γ) B₂ (.sort w₂) :=
                  hasTyT_assump_dom (envClosed_of_envWfT hW) hW hΓ hdom.symmT hA₂ hB₂_A₁
                refine Or.inr ⟨A₂, B₂, w₂, hred₂, ⟨hΓ₂⟩, ⟨hB₂⟩,
                  fun s hs N N' hN₂ hN'₂ hc₂ hrel₂ => ?_⟩
                have hN₁ : HasTyT E n Γ N A₁ := hasTyT_of_tyConv hN₂ hdom.symmT
                have hN'₁ : HasTyT E n Γ N' A₁ := hasTyT_of_tyConv hN'₂ hdom.symmT
                have hc₁ : ConvT E n Γ N N' A₁ := convT_of_tyConv hc₂ hdom.symmT
                have hrel₁ : ∀ v ∈ s.1, LRTermFamIND E n Γ N N' A₁ v :=
                  fun v hv => lrTermFamIND_transport_bot hW zsc hcore hF v
                    hΓ hA₂ hdom.symmT (hrel₂ v hv)
                have hout₁ := happ s hs N N' hN₁ hN'₁ hc₁ hrel₁
                have hinstTy : HasTyT E n Γ (instantiate0 N B₁) (.sort w) :=
                  hasTyT_subst0_of_envWfT hW hB₁ hN₁
                have hinstConv : TyConvT E n Γ (instantiate0 N B₁) (instantiate0 N B₂) :=
                  tyConvT_subst0_of_envWfT hW hN₁ hcod
                exact lrTermFamIND_transport_bot hW zsc hcore hF s.2
                  hΓ hinstTy hinstConv hout₁
termination_by c => sizeOf c
