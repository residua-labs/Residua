        · exact (hns l hA).elim
        · exact h2
    | famSpine =>
        rcases (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mp h with ⟨_, h2⟩ | ⟨hns, _⟩ | ⟨hns, _⟩
        · exact h2
        · exact (hns l hA).elim
        · exact (hns l hA).elim
  have hLR' := lrTypeFamINRKCanon_subst_bvarSpine_botFamCpt hcl hinst m_var vargs t hc hget hnone hvty hΓ' hLR
  cases hc with
  | bot => exact lrTermFamINDRKCanon_bot _ _ _ _
  | sort => exact (lrTermFamINDRKCanon_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)


/-! #### Part D — Discharged Constructor Cases of `LRTermFamINDRKCanon` Over `ApproxDIKCanon` & Related-Substitution Stability (`fundamentalTermFamINDRKCanonS`) -/

theorem not_whRedRecKCanon_sort_pi {E : ResolvedEnv} {Γ : LCtx} (A B : Expr Nat) :
    ∀ l, ¬ WhRedRecKCanon E Γ (.pi A B) (.sort l) :=
  fun _ h => nomatch whRedRecKCanon_pi_eq h

theorem not_whRedRecKCanon_sort_famApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    ∀ l, ¬ WhRedRecKCanon E Γ (foldApps (.const r ls) xs) (.sort l) :=
  fun l h => foldApps_const_ne_sort r ls xs l (whRedRecKCanon_famApp_eq hW hm hind h).symm

/-- At any non-sort type `A` (`∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)`), any `M, M'` that reduce
    in `WhRedRecKCanon E Γ` to normal forms `Y, Y'` (`WhNormalRecKCanon`) with `ConvT E n Γ Y Y' A`
    satisfy `LRTermFamINDRKCanon E n Γ M M' A (.spine r args)`. -/
theorem lrTermFamINDRKCanon_normal_of_not_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' Y Y' A : Expr Nat}
    (hns : ∀ l, ¬ WhRedRecKCanon E Γ A (.sort l))
    (hY : WhRedRecKCanon E Γ M Y) (hY' : WhRedRecKCanon E Γ M' Y')
    (hn : WhNormalRecKCanon E Γ Y) (hn' : WhNormalRecKCanon E Γ Y')
    (hc : ConvT E n Γ Y Y' A)
    (r : Nat) (args : List CptI) :
    LRTermFamINDRKCanon E n Γ M M' A (.spine r args) :=
  (lrTermFamINDRKCanon_spine_iff Γ M M' A r args).mpr
    (Or.inr (Or.inr ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩))

/-- `HasTyT.sort` diagonal case for `LRTermFamINDRKCanon` over `ApproxDIKCanon E Γ`. -/
theorem fundTermFamINDRKCanon_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l : Level) :
    ∀ u, ApproxDIKCanon E Γ (.sort l) u →
      LRTermFamINDRKCanon E n Γ (.sort l) (.sort l) (.sort (.succ l)) u := by
  intro u hu
  rcases PiModelDeltaIotaAudit.approxDI_sort_inv
    ((approxDIKCanon_sort_iff E Γ l u).mp hu) with rfl | rfl
  · exact lrTermFamINDRKCanon_bot _ _ _ _
  · rw [lrTermFamINDRKCanon_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, .sort (.refl _) (.refl _)⟩

/-- `ConvT.sorts` conversion case for `LRTermFamINDRKCanon` over `ApproxDIKCanon E Γ`. -/
theorem fundConvFamINDRKCanon_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l l' : Level) :
    ∀ u, ApproxDIKCanon E Γ (.sort l) u →
      LRTermFamINDRKCanon E n Γ (.sort l) (.sort l') (.sort (.succ l)) u := by
  intro u hu
  rcases PiModelDeltaIotaAudit.approxDI_sort_inv
    ((approxDIKCanon_sort_iff E Γ l u).mp hu) with rfl | rfl
  · exact lrTermFamINDRKCanon_bot _ _ _ _
  · rw [lrTermFamINDRKCanon_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, .sort (.refl _) (.refl _)⟩

/-- **Single-Step `WhStepRecKCanon` Conversion Reduction for `LRTermFamINDRKCanon`
    (`fundConvFamINDRKCanon_of_whStepRecKCanon`):**
    Under `EnvWfT E` **alone** (with zero `WhApproxInvCore` hypotheses, using
    `whStepRecKCanon_approxDIKCanon_iff_of_envWfT`!), any `WhStepRecKCanon E Γ M M'` step
    (including `beta`, `zeta`, `zetaLocal`, `delta`, `iota`, `lit`, `pmajorCanon`, `appHead`,
    `recMajor`) reduces the `ConvT` obligation for `M, M'` over `ApproxDIKCanon E Γ` to the
    diagonal on `M'`! -/
theorem fundConvFamINDRKCanon_of_whStepRecKCanon {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A : Expr Nat}
    (hs : WhStepRecKCanon E Γ M M')
    (hdiag : ∀ u, ApproxDIKCanon E Γ M' u → LRTermFamINDRKCanon E n Γ M' M' A u) :
    ∀ u, ApproxDIKCanon E Γ M u → LRTermFamINDRKCanon E n Γ M M' A u := by
  intro u hu
  have hu' : ApproxDIKCanon E Γ M' u :=
    (whStepRecKCanon_approxDIKCanon_iff_of_envWfT hW hs u).mp hu
  exact lrTermFamINDRKCanon_expand (.step hs (.refl _)) (.refl _) u (hdiag u hu')

/-- Multi-step `WhRedRecKCanon` conversion reduction for `LRTermFamINDRKCanon` under `EnvWfT E` alone. -/
theorem fundConvFamINDRKCanon_of_whRedRecKCanon {E : ResolvedEnv} {n : Nat}
