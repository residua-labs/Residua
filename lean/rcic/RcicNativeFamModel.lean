theorem whRedRecK_lam_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A b X : Expr Nat}
    (h : WhRedRecK E n Γ (.lam A b) X) : X = .lam A b := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecK_lam_false hs).elim

theorem whStepRecK_foldApps_bvar_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecK E n Γ (foldApps (.bvar i) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecK E n Γ f e → (appsSpine f).1 = .bvar i → False := by
    intro f e hstep
    induction hstep with
    | @recCtx a b hs₀ =>
        intro hsp
        have hEq : foldApps (.bvar i) (appsSpine a).2 = a := by
          have h := foldApps_appsSpine a
          rwa [hsp] at h
        rw [← hEq] at hs₀
        exact whStepRecCtx_foldApps_bvar_false hnone _ hs₀
    | @pmajor r ls pre _ x _ _ _ _ _ _ =>
        intro hsp
        unfold recCall at hsp
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [x])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [s₂] at hsp
        exact Expr.noConfusion hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r _ ls pre major _ _ _ _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        exact Expr.noConfusion hsp
  have hsp₀ := appsSpine_foldApps (.bvar i) xs
  simp only [appsSpine, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

theorem whStepRecK_bvar_of_lookupValue_none_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {e : Expr Nat}
