    rintro ⟨hno, ⟨hA0⟩⟩
    obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hcAA' hA0
    refine ⟨fun l hred' => ?_, ⟨hA'0⟩⟩
    have hcA' : ApproxDIKCanon E Γ A' .sort :=
      approxDIKCanon_of_whRedRecKCanon hred' (approxDIKCanon_sort E Γ l)
    cases hrelAA' .sort .sort (Or.inr hcA') with
    | sort hredA _ => exact hno _ hredA
  have hsort_tr : (∃ l, WhRedRecKCanon E Γ A (.sort l)) → ∃ l', WhRedRecKCanon E Γ A' (.sort l') := by
    rintro ⟨l, hl⟩
    have hcA : ApproxDIKCanon E Γ A .sort :=
      approxDIKCanon_of_whRedRecKCanon hl (approxDIKCanon_sort E Γ l)
    cases hrelAA' .sort .sort (Or.inl hcA) with
    | sort _ hl' => exact ⟨_, hl'⟩
  have hns_tr : (∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)) → ∀ l', ¬ WhRedRecKCanon E Γ A' (.sort l') := by
    intro hns l' hl'
    have hcA' : ApproxDIKCanon E Γ A' .sort :=
      approxDIKCanon_of_whRedRecKCanon hl' (approxDIKCanon_sort E Γ l')
    cases hrelAA' .sort .sort (Or.inr hcA') with
    | sort hl _ => exact hns _ hl
  cases hc with
  | bot => exact lrTermFamINDRKCanon_bot _ _ _ _
  | sort =>
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl (hprop_tr hprop)
      · exact Or.inr ⟨hsort_tr hl, hLR⟩
  | pi =>
