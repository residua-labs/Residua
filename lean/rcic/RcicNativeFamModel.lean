  exact ⟨lrTypeFamINRK_expand (.refl _) whRedRecK_mixAndRedex hdiag,
         lrTypeFamINRK_expand whRedRecK_mixAndRedex (.refl _) hdiag⟩

theorem lrTermFamINDRK_mixAnd (c : CptI) (hc : BotFamCpt andEnvU c)
