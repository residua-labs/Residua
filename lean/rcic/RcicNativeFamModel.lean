/-! #### Part A — Exact Two-Way Model Invariance (`ReadbackModelInv`) of `ApproxDIKCanon` Along `WhStepRecKCanon` & `WhRedRecKCanon`, and Positive Resolution of `W-K-OPEN` & `W-K-AND` in `SemEqDIKCanon` -/

/-- Head congruence for `WhRedRecKCanon E Γ`. -/
theorem whRedRecKCanon_appHead {E : ResolvedEnv} {Γ : LCtx} {f f' a : Expr Nat}
    (h : WhRedRecKCanon E Γ f f') : WhRedRecKCanon E Γ (.app f a) (.app f' a) := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (.appHead hs) ih

/-- Saturated recursor-major congruence for `WhRedRecKCanon E Γ`. -/
theorem whRedRecKCanon_recMajor {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls : List Level} {pre : List (Expr Nat)}
    {major major' : Expr Nat}
    (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (hlen : pre.length + 1 = piCount m.mtype)
    (h : WhRedRecKCanon E Γ major major') :
    WhRedRecKCanon E Γ (.app (foldApps (.const r ls) pre) major)
      (.app (foldApps (.const r ls) pre) major') := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (.recMajor hm hrec hlen hs) ih

/-- Monotonicity of `ApproxDI E ρ (.app f a) c` with respect to compact inclusion on `f` and `a`. -/
theorem approxDI_app_mono {E : ResolvedEnv} {ρ : EnvI} {f f' a a' : Expr Nat}
    (hf : ∀ d, PiModelDeltaIotaAudit.ApproxDI E ρ f d → PiModelDeltaIotaAudit.ApproxDI E ρ f' d)
    (ha : ∀ d, PiModelDeltaIotaAudit.ApproxDI E ρ a d → PiModelDeltaIotaAudit.ApproxDI E ρ a' d)
    {c : CptI} (h : PiModelDeltaIotaAudit.ApproxDI E ρ (.app f a) c) :
    PiModelDeltaIotaAudit.ApproxDI E ρ (.app f' a') c := by
  rcases PiModelDeltaIotaAudit.approxDI_app_inv h with
    rfl | ⟨g, s, rfl, hflam, hs, harg⟩ | ⟨r, args, u, rfl, hfsp, harg⟩
  · exact .bot ρ (.app f' a')
  · exact .app (hf (.lam g) hflam) hs (fun u hu => ha u (harg u hu))
  · exact .appSpine (hf (.spine r args) hfsp) (ha u harg)

/-- Every `WhStepRecKCanon.pmajorCanon` redex `.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)`
    with `lookupValue Γ i = none` has **only** `.bot` in `ApproxDI E (ctxEnvDI E Γ)` (`c = .bot`),
    because `foldApps (.bvar i) margs` has only `.bot` in `ApproxDI E (ctxEnvDI E Γ)`
    (`approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none`), so `approxDI_recursor_major_noSpine_eq_bot`
    applies directly. -/
theorem approxDI_pmajorCanon_eq_bot {E : ResolvedEnv} {Γ : LCtx}
    (w : IotaWitness E) {i : Nat} (hnone : lookupValue Γ i = none)
    (margs : List (Expr Nat)) {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
      (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) c) :
    c = .bot :=
  approxDI_recursor_major_noSpine_eq_bot w.hrec w.hrecK
    (by have := w.hpre; have := w.hnmin; omega)
    (fun _ _ hsp => nomatch approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hnone margs hsp) h

/-- **Forward `ApproxDI E (ctxEnvDI E Γ)` Preservation Along `WhStepRecKCanon`
    (`approxDI_ctxEnvDI_of_whStepRecKCanon`):**
    Under `EnvWfT E`, every `WhStepRecKCanon E Γ a b` step satisfies
    `ApproxDI E (ctxEnvDI E Γ) a c → ApproxDI E (ctxEnvDI E Γ) b c` (at `pmajorCanon`, the source has
    only `c = .bot` in `ApproxDI E (ctxEnvDI E Γ)` by `approxDI_pmajorCanon_eq_bot`, which `.bot`
    inhabits at the target `iotaRhsOf w`). -/
theorem approxDI_ctxEnvDI_of_whStepRecKCanon {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hs : WhStepRecKCanon E Γ a b) :
    ∀ {c : CptI}, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c := by
  induction hs with
  | beta A body arg =>
      intro c h
      exact (PiModelDeltaIotaAudit.approxDI_beta E (ctxEnvDI E Γ) A body arg c).mp h
  | zeta A v body =>
      intro c h
      exact (PiModelDeltaIotaAudit.approxDI_zeta E (ctxEnvDI E Γ) A v body c).mp h
  | zetaLocal hv =>
      intro c h
      exact (semEqDI_zetaLocal (ctxEnvDI_respects E Γ) hv c).mp h
  | delta hres hbody =>
      intro c h
      exact (PiModelDeltaIotaAudit.semEqDI_of_whStep_delta hW hres hbody (ctxEnvDI E Γ) c).mp h
  | iota hI =>
      intro c h
      exact (PiModelDeltaIotaAudit.approxDI_iotaU_of_envWfT hW hI (ctxEnvDI E Γ) c).mp h
  | lit t =>
      intro c h
      exact (PiModelDeltaIotaAudit.approxDI_lit E (ctxEnvDI E Γ) t c).mp h
  | pmajorCanon w i margs _ _ _ hnone =>
      intro c h
      rw [approxDI_pmajorCanon_eq_bot w hnone margs h]
      exact .bot _ _
  | appHead _ ih =>
      intro c h
      exact approxDI_app_mono (fun _ hd => ih hd) (fun _ hd => hd) h
  | recMajor _ _ _ _ ih =>
      intro c h
      exact approxDI_app_mono (fun _ hd => hd) (fun _ hd => ih hd) h

/-- Forward `ApproxDI E (ctxEnvDI E Γ)` preservation along `WhRedRecKCanon E Γ`. -/
theorem approxDI_ctxEnvDI_of_whRedRecKCanon {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hr : WhRedRecKCanon E Γ a b) :
    ∀ {c : CptI}, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c := by
  induction hr with
  | refl => intro _ h; exact h
  | step hs _ ih => intro _ h; exact ih (approxDI_ctxEnvDI_of_whStepRecKCanon hW hs h)

/-- **Exact Two-Way Model Invariance (`ReadbackModelInv`) of `ApproxDIKCanon` Along `WhStepRecKCanon`
    (`whStepRecKCanon_approxDIKCanon_iff_of_envWfT`):**
    Whereas raw `ApproxDI` fails two-way invariance under K steps (`not_semEqDI_trueVarSort`,
    `not_semEqDI_mixAnd`), the `WhRedRecKCanon`-closed model `ApproxDIKCanon E Γ` satisfies **exact
    two-way invariance (`ApproxDIKCanon E Γ a c ↔ ApproxDIKCanon E Γ b c`)** along every
    `WhStepRecKCanon E Γ a b` step under `EnvWfT E` **alone**:
    - `mpr` (`b → a`): immediate by prepending `hs` (`approxDIKCanon_of_whStepRecKCanon hs`).
    - `mp` (`a → b`): given `⟨X, hred, hX⟩`, if `hred = .refl a` then
      `approxDI_ctxEnvDI_of_whStepRecKCanon hW hs hX` gives `ApproxDI E (ctxEnvDI E Γ) b c` at
      `WhRedRecKCanon.refl b`; if `hred = .step hs' hred'`, then one-step determinism
      `whDetRecKCanon_of_envWfT hW Γ hs hs'` equates `b = b'`, so `⟨X, hred', hX⟩` witnesses
      `ApproxDIKCanon E Γ b c`! -/
theorem whStepRecKCanon_approxDIKCanon_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hs : WhStepRecKCanon E Γ a b) (c : CptI) :
    ApproxDIKCanon E Γ a c ↔ ApproxDIKCanon E Γ b c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    cases hred with
    | refl =>
        exact ⟨b, .refl b, approxDI_ctxEnvDI_of_whStepRecKCanon hW hs hX⟩
    | step hs' hred' =>
        have heq := whDetRecKCanon_of_envWfT hW Γ hs hs'
        subst heq
        exact ⟨X, hred', hX⟩
  · exact approxDIKCanon_of_whStepRecKCanon hs

/-- **Exact Two-Way Model Invariance of `ApproxDIKCanon` Along `WhRedRecKCanon`
    (`whRedRecKCanon_approxDIKCanon_iff_of_envWfT`):** -/
theorem whRedRecKCanon_approxDIKCanon_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hr : WhRedRecKCanon E Γ a b) (c : CptI) :
    ApproxDIKCanon E Γ a c ↔ ApproxDIKCanon E Γ b c := by
  induction hr with
  | refl => exact Iff.rfl
  | step hs _ ih =>
      exact (whStepRecKCanon_approxDIKCanon_iff_of_envWfT hW hs c).trans ih

/-- Every `WhStepRecKCanon E Γ a b` step induces `SemEqDIKCanon E Γ a b` under `EnvWfT E` alone. -/
theorem semEqDIKCanon_of_whStepRecKCanon {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hs : WhStepRecKCanon E Γ a b) :
    SemEqDIKCanon E Γ a b :=
  fun c => whStepRecKCanon_approxDIKCanon_iff_of_envWfT hW hs c

/-- Every `WhRedRecKCanon E Γ a b` reduction induces `SemEqDIKCanon E Γ a b` under `EnvWfT E` alone. -/
theorem semEqDIKCanon_of_whRedRecKCanon {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hr : WhRedRecKCanon E Γ a b) :
    SemEqDIKCanon E Γ a b :=
  fun c => whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hr c

theorem SemEqDIKCanon.refl (E : ResolvedEnv) (Γ : LCtx) (a : Expr Nat) :
    SemEqDIKCanon E Γ a a :=
  fun _ => Iff.rfl

theorem SemEqDIKCanon.symm {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : SemEqDIKCanon E Γ a b) : SemEqDIKCanon E Γ b a :=
  fun c => (h c).symm

theorem SemEqDIKCanon.trans {E : ResolvedEnv} {Γ : LCtx} {a b d : Expr Nat}
    (h₁ : SemEqDIKCanon E Γ a b) (h₂ : SemEqDIKCanon E Γ b d) :
    SemEqDIKCanon E Γ a d :=
  fun c => (h₁ c).trans (h₂ c)

/-- **Positive Resolution of `W-K-OPEN` (`trueRecVar`, `trueVarSort`, `trueVarPi`, `trueVarFam`) and
    `W-K-AND` (`mixAndRedex`) in `SemEqDIKCanon`:**
    Whereas raw `SemEqDI` failed on `trueVarSort`, `trueVarPi`, `trueVarFam` (`not_semEqDI_trueVarSort`,
    `not_semEqDI_trueVarPi`, `not_semEqDI_trueVarFam`) and on `mixAndRedex` (`not_semEqDI_mixAnd`),
    all of them satisfy exact two-sided `SemEqDIKCanon`! -/
theorem semEqDIKCanon_trueRecVar (u : Level) (motive minor : Expr Nat) :
    SemEqDIKCanon trueEnvU trueVarCtx (trueRecVar u motive minor) minor :=
  semEqDIKCanon_of_whRedRecKCanon trueEnvUWfT (whRedRecKCanon_trueRecVar u motive minor)

theorem semEqDIKCanon_trueVarSort :
    SemEqDIKCanon trueEnvU trueVarCtx trueVarSort (.sort .zero) :=
  semEqDIKCanon_of_whRedRecKCanon trueEnvUWfT whRedRecKCanon_trueVarSort

theorem semEqDIKCanon_trueVarPi :
    SemEqDIKCanon trueEnvU trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp :=
  semEqDIKCanon_of_whRedRecKCanon trueEnvUWfT whRedRecKCanon_trueVarPi

theorem semEqDIKCanon_trueVarFam :
    SemEqDIKCanon trueEnvU trueVarCtx trueVarFam (.const 0 []) :=
  semEqDIKCanon_of_whRedRecKCanon trueEnvUWfT whRedRecKCanon_trueVarFam

theorem semEqDIKCanon_mixAndRedex :
    SemEqDIKCanon andEnvU mixAndCtx mixAndRedex mixPi :=
  semEqDIKCanon_of_whRedRecKCanon andEnvUWfT whRedRecKCanon_mixAndRedex


/-! #### Part B — Bidirectional Flat-Probe Type Logical Relation `LRTypeFamINBiProbeRKCanon`, Full PER & Expansion Closure, and Bidirectional `W-K-OPEN` / `W-K-AND` Satisfaction -/

/-- **Bidirectional `FamProbeCpt E`-Restricted Type Logical Relation Over `WhRedRecKCanon` &
    `ApproxDIKCanon` (`LRTypeFamINBiProbeRKCanon E n Γ A A'`):** -/
def LRTypeFamINBiProbeRKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A A' : Expr Nat) : Prop :=
  ∀ c, FamProbeCpt E c →
    (ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c) →
    LRTypeFamINRKCanon E n Γ A A' c

theorem lrTypeFamINBiProbeRKCanon_of_lrTypeFamINBiRKCanon {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} (h : LRTypeFamINBiRKCanon E n Γ A A') :
    LRTypeFamINBiProbeRKCanon E n Γ A A' :=
  fun c hc happrox => h c (botFamCpt_of_famProbeCpt hc) happrox

/-- **`PiRowField`-Free and Coherence-Free Symmetry of `LRTypeFamINBiProbeRKCanon`
    (`lrTypeFamINBiProbeRKCanon_symm_of_envWfT`):** -/
theorem lrTypeFamINBiProbeRKCanon_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (h : LRTypeFamINBiProbeRKCanon E n Γ A A') :
    LRTypeFamINBiProbeRKCanon E n Γ A' A :=
  fun c hc happrox => lrTypeFamINRKCanon_symm_of_envWfT hW hΓ (h c hc happrox.symm)

/-- **`PiRowField`-Free and Coherence-Free Transitivity of `LRTypeFamINBiProbeRKCanon`
    (`lrTypeFamINBiProbeRKCanon_trans_of_envWfT`):**
    Combines `approxDIKCanon_of_lrTypeFamINRKCanon_famProbeCpt` (which transports `ApproxDIKCanon`
    across the middle type `B` for every `FamProbeCpt E c` without `TypeSoundness`) and
    `lrTypeFamINRKCanon_trans_of_envWfT` (which requires only `EnvWfT E` and `CtxWfT E n Γ`). -/
theorem lrTypeFamINBiProbeRKCanon_trans_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat}
    (h₁ : LRTypeFamINBiProbeRKCanon E n Γ A B)
    (h₂ : LRTypeFamINBiProbeRKCanon E n Γ B C) :
    LRTypeFamINBiProbeRKCanon E n Γ A C := by
  intro c hc happrox
  rcases happrox with hA | hC
  · have r₁ := h₁ c hc (Or.inl hA)
    have hB := (approxDIKCanon_of_lrTypeFamINRKCanon_famProbeCpt hW hc r₁).2
    exact lrTypeFamINRKCanon_trans_of_envWfT hW hΓ r₁ (h₂ c hc (Or.inl hB))
  · have r₂ := h₂ c hc (Or.inr hC)
    have hB := (approxDIKCanon_of_lrTypeFamINRKCanon_famProbeCpt hW hc r₂).1
    exact lrTypeFamINRKCanon_trans_of_envWfT hW hΓ (h₁ c hc (Or.inr hB)) r₂

/-- **Two-Sided `WhRedRecKCanon` Head Expansion for `LRTypeFamINBiRKCanon` (`lrTypeFamINBiRKCanon_expand`):**
    Enabled by `whRedRecKCanon_approxDIKCanon_iff_of_envWfT`, which transports `ApproxDIKCanon`
    forward along `hX : WhRedRecKCanon E Γ A X` and `hX' : WhRedRecKCanon E Γ A' X'` under
    `EnvWfT E` alone! -/
theorem lrTypeFamINBiRKCanon_expand {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A A' X X' : Expr Nat}
    (hX : WhRedRecKCanon E Γ A X) (hX' : WhRedRecKCanon E Γ A' X')
    (h : LRTypeFamINBiRKCanon E n Γ X X') :
    LRTypeFamINBiRKCanon E n Γ A A' := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ X c ∨ ApproxDIKCanon E Γ X' c := by
    rcases happrox with hA | hA'
    · exact Or.inl ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hX c).mp hA)
    · exact Or.inr ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hX' c).mp hA')
  exact lrTypeFamINRKCanon_expand hX hX' (h c hc happrox')

/-- **Two-Sided `WhRedRecKCanon` Head Expansion for `LRTypeFamINBiProbeRKCanon`
    (`lrTypeFamINBiProbeRKCanon_expand`):** -/
theorem lrTypeFamINBiProbeRKCanon_expand {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A A' X X' : Expr Nat}
    (hX : WhRedRecKCanon E Γ A X) (hX' : WhRedRecKCanon E Γ A' X')
    (h : LRTypeFamINBiProbeRKCanon E n Γ X X') :
    LRTypeFamINBiProbeRKCanon E n Γ A A' := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ X c ∨ ApproxDIKCanon E Γ X' c := by
    rcases happrox with hA | hA'
    · exact Or.inl ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hX c).mp hA)
    · exact Or.inr ((whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW hX' c).mp hA')
  exact lrTypeFamINRKCanon_expand hX hX' (h c hc happrox')

theorem lrTypeFamINBiRKCanon_whStepRecKCanon_left {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hs : WhStepRecKCanon E Γ M M')
    (hdiag : LRTypeFamINBiRKCanon E n Γ M' M') :
    LRTypeFamINBiRKCanon E n Γ M M' :=
  lrTypeFamINBiRKCanon_expand hW (.step hs (.refl _)) (.refl _) hdiag

theorem lrTypeFamINBiRKCanon_whStepRecKCanon_right {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hs : WhStepRecKCanon E Γ M M')
