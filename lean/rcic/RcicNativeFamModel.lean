theorem approxDIKCanon_beta_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) (A b a : Expr Nat) (c : CptI) :
    ApproxDIKCanon E Γ (.app (.lam A b) a) c ↔
      ApproxDIKCanon E Γ (instantiate0 a b) c :=
