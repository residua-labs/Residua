/-- Non-sort proposition predicate over `WhRedRecCtx E Γ`. -/
def IsNonSortPropRecCtx (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (P : Expr Nat) : Prop :=
  (∀ l, ¬ WhRedRecCtx E Γ P (.sort l)) ∧ Nonempty (HasTyT E n Γ P (.sort .zero))

theorem not_isNonSortPropRecCtx_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (u : Level) :
    ¬ IsNonSortPropRecCtx E n Γ (.sort u) :=
  fun ⟨hno, _⟩ => hno u (.refl _)

/-- **Repaired Recursor-Major-Aware Term Logical Relation (`LRTermFamINDR`):**
    Extends `LRTermFamIND` (§10) by replacing `WhRedCtx` / `WhNormalCtx` / `LRTypeFamIN` with
    `WhRedRecCtx` / `WhNormalRecCtx` / `LRTypeFamINR`. -/
def LRTermFamINDR (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort =>
      IsNonSortPropRecCtx E n Γ A ∨
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' .sort)
  | .pi a f =>
      IsNonSortPropRecCtx E n Γ A ∨
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' (.pi a f))
  | .spine r args =>
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecCtx E n Γ A ∨
      ((∀ l, ¬ WhRedRecCtx E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecCtx E Γ M Y ∧ WhRedRecCtx E Γ M' Y' ∧
          WhNormalRecCtx E Γ Y ∧ WhNormalRecCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A))
  | .lam g =>
      IsNonSortPropRecCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDR E n Γ N N' A₁ u) →
          LRTermFamINDR E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show u ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

theorem lrTermFamINDR_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDR E n Γ M M' A .bot := by
  rw [LRTermFamINDR]; trivial

theorem lrTermFamINDR_sort_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDR E n Γ M M' A .sort ↔
      IsNonSortPropRecCtx E n Γ A ∨
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' .sort) := by
  rw [LRTermFamINDR]

theorem lrTermFamINDR_pi_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (a : CptI) (f : List (List CptI × CptI)) :
    LRTermFamINDR E n Γ M M' A (.pi a f) ↔
      IsNonSortPropRecCtx E n Γ A ∨
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' (.pi a f)) := by
  rw [LRTermFamINDR]

theorem lrTermFamINDR_spine_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (r : Nat) (args : List CptI) :
    LRTermFamINDR E n Γ M M' A (.spine r args) ↔
      ((∃ l, WhRedRecCtx E Γ A (.sort l)) ∧ LRTypeFamINR E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecCtx E n Γ A ∨
      ((∀ l, ¬ WhRedRecCtx E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecCtx E Γ M Y ∧ WhRedRecCtx E Γ M' Y' ∧
          WhNormalRecCtx E Γ Y ∧ WhNormalRecCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A)) := by
  rw [LRTermFamINDR]

theorem lrTermFamINDR_lam_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (g : List (List CptI × CptI)) :
    LRTermFamINDR E n Γ M M' A (.lam g) ↔
      IsNonSortPropRecCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDR E n Γ N N' A₁ u) →
          LRTermFamINDR E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2) := by
  rw [LRTermFamINDR]

theorem lrTermFamINDR_lam_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {g : List (List CptI × CptI)}
    (h : LRTermFamINDR E n Γ M M' (.sort u) (.lam g)) : False := by
  rw [lrTermFamINDR_lam_iff] at h
  rcases h with hprop | ⟨_, _, _, hA, _, _, _⟩
  · exact not_isNonSortPropRecCtx_sort u hprop
  · exact nomatch whRedRecCtx_sort_eq hA

theorem lrTermFamINDR_spine_at_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {r : Nat} {args : List CptI}
    (h : LRTermFamINDR E n Γ M M' (.sort u) (.spine r args)) :
    LRTypeFamINR E n Γ M M' (.spine r args) := by
  rw [lrTermFamINDR_spine_iff] at h
  rcases h with ⟨_, h2⟩ | hprop | ⟨hns, _⟩
  · exact h2
  · exact (not_isNonSortPropRecCtx_sort u hprop).elim
  · exact (hns u (.refl _)).elim

/-- Unconditional extraction of `LRTypeFamINR` from `LRTermFamINDR` at a universe `.sort u`. -/
theorem lrTypeFamINR_of_lrTermFamINDR_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} :
    (c : CptI) → LRTermFamINDR E n Γ M M' (.sort u) c → LRTypeFamINR E n Γ M M' c
  | .bot, _ => .bot _ _ _
  | .sort, h => by
      rw [lrTermFamINDR_sort_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecCtx_sort u hprop).elim
      · exact h2
  | .pi _ _, h => by
      rw [lrTermFamINDR_pi_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecCtx_sort u hprop).elim
      · exact h2
  | .spine _ _, h => lrTermFamINDR_spine_at_sort h
  | .lam _, h => (lrTermFamINDR_lam_at_sort_false h).elim

/-- Conversely, `LRTypeFamINR E n Γ M M' c` embeds into `LRTermFamINDR E n Γ M M' (.sort u) c`. -/
theorem lrTermFamINDR_of_lrTypeFamINR_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) :
    (c : CptI) → LRTypeFamINR E n Γ M M' c → LRTermFamINDR E n Γ M M' (.sort u) c
  | .bot, _ => lrTermFamINDR_bot _ _ _ _
  | .sort, h => (lrTermFamINDR_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .pi _ _, h => (lrTermFamINDR_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .spine _ _, h => (lrTermFamINDR_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨u, .refl _⟩, h⟩)
  | .lam _, h => nomatch h

/-- At any universe `.sort u`, `LRTermFamINDR E n Γ M M' (.sort u) c` is logically equivalent (`↔`)
    to `LRTypeFamINR E n Γ M M' c`. -/
theorem lrTermFamINDR_sort_iff_lrTypeFamINR {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) (c : CptI) :
    LRTermFamINDR E n Γ M M' (.sort u) c ↔ LRTypeFamINR E n Γ M M' c :=
  ⟨lrTypeFamINR_of_lrTermFamINDR_sort c, lrTermFamINDR_of_lrTypeFamINR_sort u c⟩

/-- **Positive Resolution of `W-IOTA-MAJOR` in `LRTermFamINDR`:**
    `trueIotaMajorSort`, `trueIotaMajorPi`, and `trueIotaMajorFam` all satisfy `LRTermFamINDR`
    across every `BotFamCpt trueEnvU c` compact! -/
theorem lrTermFamINDR_trueIotaMajorSort (n : Nat) (Γ : LCtx) {c : CptI}
    (hc : BotFamCpt trueEnvU c)
    (h : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) trueIotaMajorSort c ∨
      PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) (.sort .zero) c) :
    LRTermFamINDR trueEnvU n Γ trueIotaMajorSort (.sort .zero) (.sort (.succ .zero)) c :=
  lrTermFamINDR_of_lrTypeFamINR_sort (.succ .zero) c
    ((lrTypeFamINBiR_trueIotaMajorSort n Γ).1 c hc h)

theorem lrTermFamINDR_trueIotaMajorPi (n : Nat) {Γ : LCtx} (hΓ : CtxWfT trueEnvU n Γ) {c : CptI}
    (hc : BotFamCpt trueEnvU c)
    (h : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) trueIotaMajorPi c ∨
      PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) PiModelDeltaIotaAudit.idPiProp c) :
    LRTermFamINDR trueEnvU n Γ trueIotaMajorPi PiModelDeltaIotaAudit.idPiProp (.sort .zero) c :=
  lrTermFamINDR_of_lrTypeFamINR_sort .zero c
    ((lrTypeFamINBiR_trueIotaMajorPi n hΓ).1 c hc h)

theorem lrTermFamINDR_trueIotaMajorFam (n : Nat) (Γ : LCtx) {c : CptI}
    (hc : BotFamCpt trueEnvU c)
    (h : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) trueIotaMajorFam c ∨
      PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU Γ) (.const 0 []) c) :
    LRTermFamINDR trueEnvU n Γ trueIotaMajorFam (.const 0 []) (.sort .zero) c :=
  lrTermFamINDR_of_lrTypeFamINR_sort .zero c
    ((lrTypeFamINBiR_trueIotaMajorFam n Γ).1 c hc h)

/-- **Repaired Recursor-Major-Aware `BotFamCpt E` Term Fundamental Property (`FundamentalTermFamINDBotR`):** -/
def FundamentalTermFamINDBotR (E : ResolvedEnv) (n : Nat) : Prop :=
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M A : Expr Nat}, HasTyT E n Γ M A →
    ∀ u, BotFamCpt E u → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M u →
      LRTermFamINDR E n Γ M M A u) ∧
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M M' A : Expr Nat}, ConvT E n Γ M M' A →
    ∀ u, BotFamCpt E u → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M u →
      LRTermFamINDR E n Γ M M' A u)

/-- Soundness-free preservation of `LRTypeFamINR` at `.pi .bot []` along any `TyConvT E n Γ A A'`
    chain from `FundamentalTermFamINDBotR E n` and `EnvWfT E` **alone** (with zero `WhDet` or
    `WhApproxInvCore` hypotheses!). -/
theorem lrTypeFamINR_pi_bot_nil_of_fundamentalTermFamINDBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotR E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.pi .bot []) →
    LRTypeFamINR E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamINR_of_lrTermFamINDR_sort (.pi .bot [])
        (F.1 hΓ hA (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamINR_of_lrTermFamINDR_sort (.pi .bot [])
        (F.2 hΓ hc (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ := lrTypeFamINR_pi_bot_nil_of_fundamentalTermFamINDBotR hW F hΓ hA c₁ hcA
      have hcM : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) _ (.pi .bot []) :=
        approxDI_ctxEnvDI_right_of_lrTypeFamINR_botFamCpt hW (botFamCpt_pi_bot_nil E) hLR₁
      exact lrTypeFamINR_trans_pi_bot_nil_of_envWfT hW hLR₁
        (lrTypeFamINR_pi_bot_nil_of_fundamentalTermFamINDBotR hW F hΓ hM c₂ hcM)

/-- Derive `PiRowField E n` from `FundamentalTermFamINDBotR E n` and `EnvWfT E` **alone**. -/
theorem piRowField_of_fundamentalTermFamINDBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotR E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamINR_pi_components
      (lrTypeFamINR_pi_bot_nil_of_fundamentalTermFamINDBotR hW F hΓ hPi hc
        (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))

/-- **Full Derivation of `FundamentalLRFamINBotR E n` from `FundamentalTermFamINDBotR E n` and
    `EnvWfT E` Alone (`fundamentalLRFamINBotR_of_fundamentalTermFamINDBotR`):**
    Requires **zero** `WhDet`, `WhApproxInvCore`, or `TypeSoundness` hypotheses! -/
theorem fundamentalLRFamINBotR_of_fundamentalTermFamINDBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotR E n) :
    FundamentalLRFamINBotR E n :=
  fundamentalLRFamINBotR_of_links hW
    (fun {_} hΓ {_ _} hA c hcpt hcA =>
      lrTypeFamINR_of_lrTermFamINDR_sort c (F.1 hΓ hA c hcpt hcA))
    (fun {_} hΓ {_ _ _} hc c hcpt hcA =>
      lrTypeFamINR_of_lrTermFamINDR_sort c (F.2 hΓ hc c hcpt hcA))

/-- Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from `FundamentalTermFamINDBotR E n`
