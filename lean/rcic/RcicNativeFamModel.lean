/-- **Constructor-Spine Substitution Stability in `LRTermFamIND` (`lrTermFamIND_subst_ctorSpine`):**
    Under `EnvWfT E`, for any `.constructorM` spines `foldApps (.const c ls) xs` and
    `foldApps (.const c' ls') xs'` convertible at a non-sort type `A` (where `A` is either a
    `.pi A₁ B₁` or an admitted `.inductiveM` family spine), `LRTermFamIND` at every
    `.spine r₀ args₀` compact is preserved by `substRemove v j Γ` / `instantiate j (lift 0 j v)`. -/
theorem lrTermFamIND_subst_ctorSpine {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (v t : Expr Nat) {Γ : LCtx} {j : Nat} (hget : Γ[j]? = some (.assumption t))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    {c c' : Nat} {mc mc' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hmc : E.members c = some mc) (hctor : mc.mclass = .constructorM)
    (hmc' : E.members c' = some mc') (hctor' : mc'.mclass = .constructorM)
    {A : Expr Nat}
    (hA : (∃ A₁ B₁, WhRedCtx E Γ A (.pi A₁ B₁)) ∨
          (∃ r m lsf ys, E.members r = some m ∧ m.mclass = .inductiveM ∧
            WhRedCtx E Γ A (foldApps (.const r lsf) ys)))
    (hconv : ConvT E n Γ (foldApps (.const c ls) xs) (foldApps (.const c' ls') xs') A)
    (r₀ : Nat) (args₀ : List CptI) :
    LRTermFamIND E n (substRemove v j Γ)
      (instantiate j (lift 0 j v) (foldApps (.const c ls) xs))
      (instantiate j (lift 0 j v) (foldApps (.const c' ls') xs'))
      (instantiate j (lift 0 j v) A) (.spine r₀ args₀) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have hns : ∀ l, ¬ WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A) (.sort l) := by
    intro l hsort
    rcases hA with ⟨A₁, B₁, hpi⟩ | ⟨r, m, lsf, ys, hm, hind, hfam⟩
    · have hpi' := whRedCtx_instantiate_of_envClosed hcl hget hpi v
      have e := whRedCtx_normal_unique_of_envWfT hW
        hsort (whNormalCtx_sort l) hpi' (whNormalCtx_pi _ _)
      exact Expr.noConfusion e
    · have hfam' := whRedCtx_instantiate_of_envClosed hcl hget hfam v
      rw [instantiate_famApp] at hfam'
      have e := whRedCtx_normal_unique_of_envWfT hW
        hsort (whNormalCtx_sort l) hfam' (whNormalCtx_famApp hW hm hind lsf _)
      exact foldApps_const_ne_sort r lsf _ l e.symm
  have hconv' := convT_substS hcl hinst v t hconv hget hvty
  rw [instantiate_famApp, instantiate_famApp] at hconv' ⊢
  exact lrTermFamIND_normal_of_not_sort hns (.refl _) (.refl _)
    (whNormalCtx_ctorApp hW hmc hctor ls _)
    (whNormalCtx_ctorApp hW hmc' hctor' ls' _)
    hconv' r₀ args₀

/-- Head (`j = 0`) specialization of `lrTermFamIND_subst_ctorSpine`. -/
theorem lrTermFamIND_subst0_ctorSpine {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {v t : Expr Nat} (hv : HasTyT E n Γ v t)
    {c c' : Nat} {mc mc' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hmc : E.members c = some mc) (hctor : mc.mclass = .constructorM)
    (hmc' : E.members c' = some mc') (hctor' : mc'.mclass = .constructorM)
    {A : Expr Nat}
    (hA : (∃ A₁ B₁, WhRedCtx E (.assumption t :: Γ) A (.pi A₁ B₁)) ∨
          (∃ r m lsf ys, E.members r = some m ∧ m.mclass = .inductiveM ∧
            WhRedCtx E (.assumption t :: Γ) A (foldApps (.const r lsf) ys)))
    (hconv : ConvT E n (.assumption t :: Γ)
      (foldApps (.const c ls) xs) (foldApps (.const c' ls') xs') A)
    (r₀ : Nat) (args₀ : List CptI) :
    LRTermFamIND E n Γ
      (instantiate0 v (foldApps (.const c ls) xs))
      (instantiate0 v (foldApps (.const c' ls') xs'))
      (instantiate0 v A) (.spine r₀ args₀) := by
  have hget0 : (LocalDecl.assumption t :: Γ)[0]? = some (.assumption t) := by simp
  have h0 := lrTermFamIND_subst_ctorSpine hW v t hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using hv)
    hmc hctor hmc' hctor' hA hconv r₀ args₀
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0


/-! #### Part D — `PEqDI` Family-Head Proof-Irrelevance, `K`, `zetaLocal`, and Sort-Level Slot Dichotomy Over `ApproxDI E` & `ctxEnvDI E Γ` (#7656) -/

/-- For any `RigidConst E r`, `IsPropIdealI E (denDI E ρ (foldApps (.const r ls) xs))` holds iff
    `r` resolves to a member `m` with `piBody m.mtype = .sort .zero`. -/
theorem isPropIdealI_denDI_famApp_iff {E : ResolvedEnv} (ρ : EnvI)
    {r : Nat} (ls : List Level) (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (xs : List (Expr Nat)) :
    IsPropIdealI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs)) ↔
      ∃ m : CheckedMember, E.members r = some m ∧ piBody m.mtype = .sort .zero := by
  constructor
  · intro hP
    have hsp : IsPropC E (.spine r (botVecI xs)) :=
      hP (.spine r (botVecI xs)) (approxDI_famApp_botVecI ρ ls hrig xs)
    exact isPropC_spine_iff.mp hsp
  · rintro ⟨m, hm, hsort⟩ c hc
    rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrig xs c).mp hc with
      rfl | ⟨_, _, rfl⟩
    · exact .bot
    · exact .spine hm hsort

/-- Under `EnvWfT E`, for any admitted `.inductiveM` family `r`, `denDI E ρ (foldApps (.const r ls) xs)`
    is a proposition ideal (`IsPropIdealI E`) iff `inductiveSortLevel hW hm hind = .zero`. -/
theorem isPropIdealI_denDI_famApp_inductiveM_iff {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    IsPropIdealI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs)) ↔
      inductiveSortLevel hW hm hind = .zero := by
  rw [isPropIdealI_denDI_famApp_iff ρ ls (rigidConst_of_inductiveM hW hm hind) xs]
  constructor
  · rintro ⟨m', hm', hsort⟩
    have hm_eq : m' = m := Option.some.inj (hm'.symm.trans hm)
    subst hm_eq
    have hbody := piBody_mtype_of_inductiveM hW hm hind
    rw [hbody] at hsort
    injection hsort
  · intro hzero
    exact ⟨m, hm, (piBody_mtype_of_inductiveM hW hm hind).trans (congrArg Expr.sort hzero)⟩

/-- When `inductiveSortLevel hW hm hind = .zero`, `denDI E ρ (foldApps (.const r ls) xs)` is a
    proposition ideal at **every** environment `ρ : EnvI`. -/
theorem isPropIdealI_denDI_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero) :
    IsPropIdealI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs)) :=
  (isPropIdealI_denDI_famApp_inductiveM_iff hW ρ hm hind ls xs).mpr hzero

/-- When `inductiveSortLevel hW hm hind ≠ .zero`, `denDI E ρ (foldApps (.const r ls) xs)` is
    never a proposition ideal at any environment `ρ : EnvI`. -/
theorem not_isPropIdealI_denDI_famApp_of_ne_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero) :
    ¬ IsPropIdealI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs)) :=
  fun h => hne ((isPropIdealI_denDI_famApp_inductiveM_iff hW ρ hm hind ls xs).mp h)

/-- For a `Prop`-valued admitted inductive family `r` (`inductiveSortLevel hW hm hind = .zero`),
    `tprojI E (denDI E ρ (foldApps (.const r ls) xs)) (denDI E ρ e)` collapses to `{.bot}` at
    every `ρ : EnvI`. -/
theorem tprojI_denDI_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (e : Expr Nat) (u : CptI) :
    tprojI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs))
      (PiModelDeltaIotaAudit.denDI E ρ e) u ↔ u = .bot :=
  PiModelDeltaIotaAudit.tprojI_denDI_prop
    (isPropIdealI_denDI_famApp_of_zero hW ρ hm hind ls xs hzero) e u

/-- **Unconditional `PEqDI` Proof Irrelevance on Concrete `Prop`-Family Spines
    (`pEqDI_irr_famApp_of_zero`):** -/
theorem pEqDI_irr_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (p q : Expr Nat) :
    PiModelDeltaIotaAudit.PEqDI E ρ (foldApps (.const r ls) xs) p q :=
  PiModelDeltaIotaAudit.pEqDI_irr
    (isPropIdealI_denDI_famApp_of_zero hW ρ hm hind ls xs hzero) p q

/-- **Unconditional `PEqDI` K-Rule on Concrete `Prop`-Family Spines Over `IotaWitnessS`
    (`pEqDI_K_famApp_of_zero`):**
    For any `w : IotaWitnessS E` whose major premise has a `Prop`-valued admitted `.inductiveM`
    family spine type `foldApps (.const r ls) xs` (`inductiveSortLevel hW hm hind = .zero`) and
    `DomTyped E` on the eliminator `foldApps (.const w.recRef w.ls) w.preMajor`,
    `PEqDI E ρ T (.app (foldApps (.const w.recRef w.ls) w.preMajor) h) (iotaRhsOfS w)` holds for
    every proof `h : Expr Nat`! -/
theorem pEqDI_K_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E)
    (w : IotaWitnessS E) (ρ : EnvI) (T : Expr Nat)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (hdom : PiModelIrrAudit.DomTyped E
      (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs))
      (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const w.recRef w.ls) w.preMajor)))
    (h : Expr Nat) :
    PiModelDeltaIotaAudit.PEqDI E ρ T
      (.app (foldApps (.const w.recRef w.ls) w.preMajor) h) (iotaRhsOfS w) := by
  have hP := isPropIdealI_denDI_famApp_of_zero hW ρ hm hind ls xs hzero
  exact PiModelDeltaIotaAudit.pEqDI_K hP
    (PiModelDeltaIotaAudit.majorStableDI_of_domTyped_recursor w w.ls hP hdom)
    (PiModelDeltaIotaAudit.iotaSoundAtDI_of_iotaWitnessS w ρ T) h

/-- Soundness of `zetaLocal` in `PEqDI E ρ T` for any `CtxEnvDI E Γ ρ` (in particular `ctxEnvDI E Γ`). -/
theorem pEqDI_zetaLocal {E : ResolvedEnv} {Γ : LCtx} {ρ : EnvI}
    (hρ : CtxEnvDI E Γ ρ) (T : Expr Nat) {i : Nat} {v : Expr Nat}
    (hv : lookupValue Γ i = some v) :
    PiModelDeltaIotaAudit.PEqDI E ρ T (.bvar i) v :=
  PiModelDeltaIotaAudit.pEqDI_of_semEqDI (semEqDI_zetaLocal hρ hv)

/-- **Finitary Projection Dichotomy in `ApproxDI` — Universe Branch (`tprojI_denDI_sort_on_spine`):**
    At any universe `.sort u`, `tprojI E (denDI E ρ (.sort u))` acts as the **identity** on every
    `RigidConst E r` spine `foldApps (.const r ls) xs`. -/
theorem tprojI_denDI_sort_on_spine {E : ResolvedEnv} (ρ : EnvI) (u : Level)
    {r : Nat} (ls : List Level) (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (xs : List (Expr Nat)) (c : CptI) :
    tprojI E (PiModelDeltaIotaAudit.denDI E ρ (.sort u))
      (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs)) c ↔
      PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs) c := by
  constructor
  · intro h
    exact h.1
  · intro hc
    rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrig xs c).mp hc with
      rfl | ⟨us, _, rfl⟩
    · exact PiModelDeltaIotaAudit.tprojI_denDI_bot E ρ (.sort u) (foldApps (.const r ls) xs)
    · exact ⟨hc, .sort, .sort ρ u, .univ (.spine r us)⟩

/-- Projected equality `PEqDI E ρ (.sort u)` between two `RigidConst E` spines is logically
    equivalent (`↔`) to `SemEqDI E ρ`. -/
theorem pEqDI_sort_famApp_iff_semEqDI {E : ResolvedEnv} (ρ : EnvI) (u : Level)
    {r r' : Nat} (ls ls' : List Level)
    (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (hrig' : PiModelDeltaIotaAudit.RigidConst E r')
    (xs xs' : List (Expr Nat)) :
    PiModelDeltaIotaAudit.PEqDI E ρ (.sort u)
        (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') ↔
      PiModelDeltaIotaAudit.SemEqDI E ρ
        (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') := by
  constructor
  · intro hp c
    exact (tprojI_denDI_sort_on_spine ρ u ls hrig xs c).symm.trans
      ((hp c).trans (tprojI_denDI_sort_on_spine ρ u ls' hrig' xs' c))
  · intro hs
    exact PiModelDeltaIotaAudit.pEqDI_of_semEqDI hs

/-- Projected equality `PEqDI E ρ (.sort u)` between two `RigidConst E` spines implies
    `r = r'`, `xs.length = xs'.length`, and slotwise `SemEqDI E ρ`. -/
theorem pEqDI_sort_famApp_inj {E : ResolvedEnv} {ρ : EnvI} {u : Level}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hrig : PiModelDeltaIotaAudit.RigidConst E r)
    (hrig' : PiModelDeltaIotaAudit.RigidConst E r')
    (h : PiModelDeltaIotaAudit.PEqDI E ρ (.sort u)
      (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat), i < xs.length →
        PiModelDeltaIotaAudit.SemEqDI E ρ (xs.getD i (.bvar 0)) (xs'.getD i (.bvar 0)) :=
  semEqDI_famApp_inj hrig hrig'
    ((pEqDI_sort_famApp_iff_semEqDI ρ u ls ls' hrig hrig' xs xs').mp h)

/-- **Finitary Projection Dichotomy in `ApproxDI` — Relevant (`non-Prop`) Family Branch
    (`tprojI_denDI_famApp_of_ne_zero_on_spine`):**
    For a relevant (non-`Prop`) admitted inductive family `r` (`inductiveSortLevel hW hm hind ≠ .zero`),
    `tprojI E (denDI E ρ (foldApps (.const r ls) xs))` acts as the **identity** on every
    `RigidConst E c₀` spine `foldApps (.const c₀ ls₀) ys`. -/
theorem tprojI_denDI_famApp_of_ne_zero_on_spine {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    {c₀ : Nat} (ls₀ : List Level) (hrig₀ : PiModelDeltaIotaAudit.RigidConst E c₀)
    (ys : List (Expr Nat)) (u : CptI) :
    tprojI E (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const r ls) xs))
      (PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const c₀ ls₀) ys)) u ↔
      PiModelDeltaIotaAudit.denDI E ρ (foldApps (.const c₀ ls₀) ys) u := by
  constructor
  · intro h
    exact h.1
  · intro hu
    rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls₀ hrig₀ ys u).mp hu with
      rfl | ⟨us, _, rfl⟩
    · exact PiModelDeltaIotaAudit.tprojI_denDI_bot E ρ
        (foldApps (.const r ls) xs) (foldApps (.const c₀ ls₀) ys)
    · exact ⟨hu, .spine r (botVecI xs),
        approxDI_famApp_botVecI_of_inductiveM hW ρ hm hind ls xs,
        .spine (not_isPropC_spine_of_inductiveSortLevel_ne_zero hW hm hind (botVecI xs) hne)⟩

/-- At a relevant (non-`Prop`) admitted inductive family type `foldApps (.const r ls) xs`,
    `PEqDI E ρ` between two `RigidConst E` spines is logically equivalent (`↔`) to `SemEqDI E ρ`. -/
theorem pEqDI_famApp_of_ne_zero_spine_iff_semEqDI {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    {c₁ c₂ : Nat} (ls₁ ls₂ : List Level)
    (hrig₁ : PiModelDeltaIotaAudit.RigidConst E c₁)
    (hrig₂ : PiModelDeltaIotaAudit.RigidConst E c₂)
    (ys₁ ys₂ : List (Expr Nat)) :
    PiModelDeltaIotaAudit.PEqDI E ρ (foldApps (.const r ls) xs)
        (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) ↔
      PiModelDeltaIotaAudit.SemEqDI E ρ
        (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) := by
  constructor
  · intro hp u
    exact (tprojI_denDI_famApp_of_ne_zero_on_spine hW ρ hm hind ls xs hne ls₁ hrig₁ ys₁ u).symm.trans
      ((hp u).trans (tprojI_denDI_famApp_of_ne_zero_on_spine hW ρ hm hind ls xs hne ls₂ hrig₂ ys₂ u))
  · intro hs
    exact PiModelDeltaIotaAudit.pEqDI_of_semEqDI hs

/-- At a relevant (non-`Prop`) admitted inductive family type `foldApps (.const r ls) xs`,
    `PEqDI E ρ` between two `RigidConst E` spines implies head, length, and slotwise `SemEqDI E ρ`
    injectivity. -/
theorem pEqDI_famApp_of_ne_zero_spine_inj {E : ResolvedEnv} (hW : EnvWfT E) {ρ : EnvI}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)}
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    {c₁ c₂ : Nat} {ls₁ ls₂ : List Level} {ys₁ ys₂ : List (Expr Nat)}
    (hrig₁ : PiModelDeltaIotaAudit.RigidConst E c₁)
    (hrig₂ : PiModelDeltaIotaAudit.RigidConst E c₂)
    (h : PiModelDeltaIotaAudit.PEqDI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)) :
    c₁ = c₂ ∧ ys₁.length = ys₂.length ∧
      ∀ (i : Nat), i < ys₁.length →
        PiModelDeltaIotaAudit.SemEqDI E ρ (ys₁.getD i (.bvar 0)) (ys₂.getD i (.bvar 0)) :=
  semEqDI_famApp_inj hrig₁ hrig₂
    ((pEqDI_famApp_of_ne_zero_spine_iff_semEqDI hW ρ hm hind ls xs hne ls₁ ls₂ hrig₁ hrig₂ ys₁ ys₂).mp h)


/-! ### §13 — `zetaPiCtx` / `zetaUnderPi` Verification Controls & `FundamentalTermBotDI` Refutation (#7657/#7666), Wall `W-IOTA-MAJOR` (`trueRecMajorBeta` Empty-Context Refutation of `WhRed`/`WhRedCtx`-Based Logical Relations in `trueEnvU`), Recursor-Major-Aware Weak-Head Reduction (`WhStepRecCtx` / `WhRedRecCtx` / `whDetRecCtx_of_envWfT`), and the Repaired `LRTypeFamINR` / `LRTypeFamINBiR` / `LRTermFamINDR` Layer -/

/-! #### Part A — `zetaPiCtx` & `zetaUnderPi` Positive Verification Controls on `LRTypeFamINBiDI` / `LRTermFamIND`, and Refutation of #7657's `FundamentalTermBotDI` -/

/-- Well-formed one-entry let-context `let X : Sort 0 := Π (P : Sort 0), P` (`idPiProp`), testing
    `ConvT.zetaLocal` and `ConvT.symm (ConvT.zetaLocal …)` at the Π consumer compact `.pi .bot []`. -/
def zetaPiCtx : LCtx :=
  [.letBinding (.sort .zero) PiModelDeltaIotaAudit.idPiProp]

/-- `zetaPiCtx` is well-formed in every `E : ResolvedEnv` and `n : Nat`. -/
noncomputable def zetaPiCtx_wf (E : ResolvedEnv) (n : Nat) : CtxWfT E n zetaPiCtx :=
  .letBinding [] (.sort .zero) (.succ .zero) PiModelDeltaIotaAudit.idPiProp
    .nil (.sort [] .zero) (PiModelDeltaIotaTermAudit.hasTyT_idPiProp_ctx E n [])

/-- `ConvT.zetaLocal` in `zetaPiCtx`: `.bvar 0 ≡ idPiProp : Sort 0`. -/
noncomputable def convT_zetaPiCtx (E : ResolvedEnv) (n : Nat) :
    ConvT E n zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp (.sort .zero) :=
  .zetaLocal zetaPiCtx 0 (.sort .zero) PiModelDeltaIotaAudit.idPiProp rfl rfl
    (PiModelDeltaIotaTermAudit.hasTyT_idPiProp_ctx E n zetaPiCtx)

/-- `ConvT.symm` of `convT_zetaPiCtx`: `idPiProp ≡ .bvar 0 : Sort 0`. -/
noncomputable def convT_zetaPiCtx_symm (E : ResolvedEnv) (n : Nat) :
    ConvT E n zetaPiCtx PiModelDeltaIotaAudit.idPiProp (.bvar 0) (.sort .zero) :=
  .symm _ _ _ _ (convT_zetaPiCtx E n)

/-- In context-free `LRTypeIN`, a variable `.bvar i` on the right is never related at `.sort`. -/
theorem lrTypeIN_bvar_right_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A : Expr Nat} {i : Nat} (h : LRTypeIN E n Γ A (.bvar i) .sort) : False := by
  cases h with
  | sort _ h' => exact nomatch whRed_bvar_eq h'

/-- In context-free `LRTypeIN`, a variable `.bvar i` on the right is never related at `.pi a f`. -/
theorem lrTypeIN_bvar_right_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A : Expr Nat} {i : Nat} {a : CptI} {f : List (List CptI × CptI)}
    (h : LRTypeIN E n Γ A (.bvar i) (.pi a f)) : False := by
  cases h with
  | pi _ h' _ _ _ _ _ => exact nomatch whRed_bvar_eq h'

/-- **Refutation of #7657's `FundamentalTermBotDI` at `.sort` (`not_fundamentalTermBotDI`):**
    Because `FundamentalTermBotDI` (`RcicNativePiModelDeltaIotaTerm`) uses `LRTermD` (whose
    readback is context-free `WhRed E`), `convT_zetaSortCtx_symm` in `zetaSortCtx` refutes
    `FundamentalTermBotDI E n` for **every** `E : ResolvedEnv` and `n : Nat`. -/
theorem not_fundamentalTermBotDI (E : ResolvedEnv) (n : Nat) :
    ¬ PiModelDeltaIotaTermAudit.FundamentalTermBotDI E n := by
  intro F
  have h := F.2 (zetaSortCtx_wf E n) (convT_zetaSortCtx_symm E n) .sort .sort
    (Or.inl (.sort EnvI.bot .zero))
  exact lrTypeIN_bvar_right_sort_false (lrTypeIN_of_lrTermD_sort .sort h)

/-- **Refutation of #7657's `FundamentalTermBotDI` at `.pi .bot []` (`not_fundamentalTermBotDI_piBotNil`):**
    `convT_zetaPiCtx_symm` in `zetaPiCtx` refutes `FundamentalTermBotDI E n` at `.pi .bot []`
    (the exact compact consumed by `piRow_of_fundamentalTermBotDI`) for **every** `E` and `n`. -/
theorem not_fundamentalTermBotDI_piBotNil (E : ResolvedEnv) (n : Nat) :
    ¬ PiModelDeltaIotaTermAudit.FundamentalTermBotDI E n := by
  intro F
  have h := F.2 (zetaPiCtx_wf E n) (convT_zetaPiCtx_symm E n) (.pi .bot [])
    PiModelDeltaIotaAudit.botPiCpt_pi_bot_nil
    (Or.inl (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E EnvI.bot (.sort .zero) (.bvar 0)))
  exact lrTypeIN_bvar_right_pi_false (lrTypeIN_of_lrTermD_sort (.pi .bot []) h)

/-- In `WhRedCtx E zetaPiCtx`, `.bvar 0` weak-head reduces to `idPiProp` via `WhStepCtx.zetaLocal`. -/
theorem whRedCtx_zetaPiCtx_bvar0 (E : ResolvedEnv) :
    WhRedCtx E zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp :=
  .step (.zetaLocal rfl) (.refl _)

/-- `LRTypeFamINBiDI E n Γ idPiProp idPiProp` holds in every well-formed context `Γ`. -/
theorem lrTypeFamINBiDI_idPiProp_ctx (E : ResolvedEnv) (n : Nat) {Γ : LCtx}
    (hΓ : CtxWfT E n Γ) :
    LRTypeFamINBiDI E n Γ PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiProp :=
  lrTypeFamINBiDI_pi_diag
    (.assumption Γ (.sort .zero) (.succ .zero) hΓ (.sort Γ .zero))
    (lrTypeFamINBiDI_sort_diag E n Γ .zero)
    (lrTypeFamINBiDI_bvar_diag_of_lookupValue_none rfl)

/-- **Positive Control (`lrTypeFamINBiDI_zetaPiCtx`):**
    Unlike context-free `LRTypeIN` / `LRTermD`, our context-aware `LRTypeFamINBiDI` holds on
    `zetaPiCtx` in the forward direction (`.bvar 0` to `idPiProp`) for every `E, n`. -/
theorem lrTypeFamINBiDI_zetaPiCtx (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp := by
  intro c hc h
  have hred : WhRedCtx E zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp :=
    whRedCtx_zetaPiCtx_bvar0 E
  have hdiag := lrTypeFamINBiDI_idPiProp_ctx E n (zetaPiCtx_wf E n) c hc
  rcases h with h0 | hid
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h0 with rfl | hmem
    · exact .bot _ _ _
    · have hid' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx)
          PiModelDeltaIotaAudit.idPiProp c :=
        (approxDI_lift0_one_ctxEnvDI_iff E []
          (.letBinding (.sort .zero) PiModelDeltaIotaAudit.idPiProp)
          PiModelDeltaIotaAudit.idPiProp c).mpr hmem
      exact lrTypeFamIN_expand hred (.refl _) (hdiag (Or.inl hid'))
  · exact lrTypeFamIN_expand hred (.refl _) (hdiag (Or.inl hid))

/-- **Positive Control (`lrTypeFamINBiDI_zetaPiCtx_symm`):**
    `LRTypeFamINBiDI` holds on `zetaPiCtx` in the reverse direction (`idPiProp` to `.bvar 0`) for
    every `E, n` — directly resolving #7666's `W-ZETALOCAL` at `.pi .bot []` and all `BotFamCpt E`
    compacts. -/
theorem lrTypeFamINBiDI_zetaPiCtx_symm (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaPiCtx PiModelDeltaIotaAudit.idPiProp (.bvar 0) := by
  intro c hc h
  have hred : WhRedCtx E zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp :=
    whRedCtx_zetaPiCtx_bvar0 E
  have hdiag := lrTypeFamINBiDI_idPiProp_ctx E n (zetaPiCtx_wf E n) c hc
  rcases h with hid | h0
  · exact lrTypeFamIN_expand (.refl _) hred (hdiag (Or.inl hid))
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h0 with rfl | hmem
    · exact .bot _ _ _
    · have hid' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx)
          PiModelDeltaIotaAudit.idPiProp c :=
        (approxDI_lift0_one_ctxEnvDI_iff E []
          (.letBinding (.sort .zero) PiModelDeltaIotaAudit.idPiProp)
          PiModelDeltaIotaAudit.idPiProp c).mpr hmem
      exact lrTypeFamIN_expand (.refl _) hred (hdiag (Or.inl hid'))

/-- `LRTermFamIND` holds on `zetaPiCtx` in the forward direction across all `BotFamCpt E` compacts. -/
theorem lrTermFamIND_zetaPiCtx (E : ResolvedEnv) (n : Nat) {c : CptI} (hc : BotFamCpt E c)
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx) (.bvar 0) c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx) PiModelDeltaIotaAudit.idPiProp c) :
    LRTermFamIND E n zetaPiCtx (.bvar 0) PiModelDeltaIotaAudit.idPiProp (.sort .zero) c :=
  lrTermFamIND_of_lrTypeFamIN_sort .zero c (lrTypeFamINBiDI_zetaPiCtx E n c hc h)

/-- `LRTermFamIND` holds on `zetaPiCtx` in the reverse direction across all `BotFamCpt E` compacts. -/
theorem lrTermFamIND_zetaPiCtx_symm (E : ResolvedEnv) (n : Nat) {c : CptI} (hc : BotFamCpt E c)
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx) PiModelDeltaIotaAudit.idPiProp c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E zetaPiCtx) (.bvar 0) c) :
    LRTermFamIND E n zetaPiCtx PiModelDeltaIotaAudit.idPiProp (.bvar 0) (.sort .zero) c :=
  lrTermFamIND_of_lrTypeFamIN_sort .zero c (lrTypeFamINBiDI_zetaPiCtx_symm E n c hc h)

/-- Left and right Π-types with a let-bound variable `.bvar 1` under the Π-binder in `zetaSortCtx`:
    `Π (_ : Sort 0), X` vs `Π (_ : Sort 0), Sort 0`. -/
def zetaUnderPiL : Expr Nat := .pi (.sort .zero) (.bvar 1)
def zetaUnderPiR : Expr Nat := .pi (.sort .zero) (.sort .zero)

/-- Under `.assumption (.sort .zero) :: zetaSortCtx`, `.bvar 1` weak-head reduces via
    `WhStepCtx.zetaLocal` to `.sort .zero`. -/
theorem whRedCtx_zetaUnderPi_bvar1 (E : ResolvedEnv) :
    WhRedCtx E (.assumption (.sort .zero) :: zetaSortCtx) (.bvar 1) (.sort .zero) :=
  .step (.zetaLocal rfl) (.refl _)

/-- **Positive Control Under a Π-Binder (`lrTypeFamINBiDI_zetaUnderPi`):**
    `LRTypeFamINBiDI` holds on `zetaUnderPiL` and `zetaUnderPiR` in `zetaSortCtx` for every `E, n`. -/
theorem lrTypeFamINBiDI_zetaUnderPi (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaSortCtx zetaUnderPiL zetaUnderPiR := by
  have hΓ₁ : CtxWfT E n (.assumption (.sort .zero) :: zetaSortCtx) :=
    .assumption zetaSortCtx (.sort .zero) (.succ .zero) (zetaSortCtx_wf E n)
      (.sort zetaSortCtx .zero)
  have hcod : ConvT E n (.assumption (.sort .zero) :: zetaSortCtx)
      (.bvar 1) (.sort .zero) (.sort (.succ .zero)) :=
    .zetaLocal (.assumption (.sort .zero) :: zetaSortCtx) 1 (.sort (.succ .zero)) (.sort .zero)
      rfl rfl (.sort _ .zero)
  refine lrTypeFamINBiDI_pi hΓ₁ (.refl _ _) (.of _ _ _ _ hcod)
    (lrTypeFamINBiDI_sort_diag E n zetaSortCtx .zero) ?_
  intro c _ h
  have hred := whRedCtx_zetaUnderPi_bvar1 E
  rcases h with h1 | hs
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h1 with rfl | hmem
    · exact .bot _ _ _
    · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hmem with rfl | rfl
      · exact .bot _ _ _
      · exact .sort hred (.refl _)
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hs with rfl | rfl
    · exact .bot _ _ _
    · exact .sort hred (.refl _)

/-- **Positive Control Under a Π-Binder (`lrTypeFamINBiDI_zetaUnderPi_symm`):**
    `LRTypeFamINBiDI` holds on `zetaUnderPiR` and `zetaUnderPiL` in `zetaSortCtx` for every `E, n`. -/
theorem lrTypeFamINBiDI_zetaUnderPi_symm (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaSortCtx zetaUnderPiR zetaUnderPiL := by
  have hΓ₁ : CtxWfT E n (.assumption (.sort .zero) :: zetaSortCtx) :=
    .assumption zetaSortCtx (.sort .zero) (.succ .zero) (zetaSortCtx_wf E n)
      (.sort zetaSortCtx .zero)
  have hcod : ConvT E n (.assumption (.sort .zero) :: zetaSortCtx)
      (.sort .zero) (.bvar 1) (.sort (.succ .zero)) :=
    .symm _ _ _ _
      (.zetaLocal (.assumption (.sort .zero) :: zetaSortCtx) 1 (.sort (.succ .zero)) (.sort .zero)
        rfl rfl (.sort _ .zero))
  refine lrTypeFamINBiDI_pi hΓ₁ (.refl _ _) (.of _ _ _ _ hcod)
    (lrTypeFamINBiDI_sort_diag E n zetaSortCtx .zero) ?_
  intro c _ h
  have hred := whRedCtx_zetaUnderPi_bvar1 E
  rcases h with hs | h1
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hs with rfl | rfl
    · exact .bot _ _ _
    · exact .sort (.refl _) hred
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h1 with rfl | hmem
    · exact .bot _ _ _
    · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hmem with rfl | rfl
      · exact .bot _ _ _
      · exact .sort (.refl _) hred


/-! #### Part B — Wall `W-IOTA-MAJOR`: Admitted Empty-Context (`Γ = []`) Recursor-Major Refutation of `WhRed`/`WhRedCtx`-Based Logical Relations Over `ApproxDI` in `trueEnvU` -/

/-- Non-canonical β-redex major argument `(λ x : True, x) True.intro` in `trueEnvU`. -/
def trueMajorBeta : Expr Nat :=
  .app (.lam (.const 0 []) (.bvar 0)) (.const 1 [])

/-- `True.intro : True` in `trueEnvU`. -/
noncomputable def hasTyT_trueIntro {n : Nat} {Γ : LCtx} :
    HasTyT trueEnvU n Γ (.const 1 []) (.const 0 []) :=
  .const Γ 1 [] trueIntroMember rfl rfl rfl

/-- `λ x : True, x : True → True` in `trueEnvU`. -/
noncomputable def hasTyT_trueIdLam {n : Nat} {Γ : LCtx} :
    HasTyT trueEnvU n Γ (.lam (.const 0 []) (.bvar 0)) (.pi (.const 0 []) (.const 0 [])) :=
  .lam Γ (.const 0 []) .zero (.bvar 0) (.const 0 [])
    (trueConstTyT rfl)
    (.bvar (.assumption (.const 0 []) :: Γ) 0 (.const 0 []) rfl)

/-- `trueMajorBeta : True` in `trueEnvU`. -/
noncomputable def hasTyT_trueMajorBeta {n : Nat} {Γ : LCtx} :
    HasTyT trueEnvU n Γ trueMajorBeta (.const 0 []) :=
  .app Γ (.lam (.const 0 []) (.bvar 0)) (.const 1 []) (.const 0 []) (.const 0 [])
    hasTyT_trueIdLam hasTyT_trueIntro

/-- `trueMajorBeta ≡ True.intro : True` via `ConvT.beta` in `trueEnvU`. -/
noncomputable def convT_trueMajorBeta {n : Nat} {Γ : LCtx} :
    ConvT trueEnvU n Γ trueMajorBeta (.const 1 []) (.const 0 []) :=
  .beta Γ (.const 0 []) (.bvar 0) (.const 1 []) (.const 0 []) .zero
    (trueConstTyT rfl)
    (.bvar (.assumption (.const 0 []) :: Γ) 0 (.const 0 []) rfl)
    hasTyT_trueIntro

/-- `trueMajorBeta` β-steps in one `WhStep` to `.const 1 []`. -/
theorem whStep_trueMajorBeta (E : ResolvedEnv) :
    WhStep E trueMajorBeta (.const 1 []) :=
  .beta (.const 0 []) (.bvar 0) (.const 1 [])

/-- `trueMajorBeta` and `.const 1 []` have identical `ApproxDI` approximations in every `E, ρ`. -/
theorem semEqDI_trueMajorBeta (E : ResolvedEnv) (ρ : EnvI) :
    PiModelDeltaIotaAudit.SemEqDI E ρ trueMajorBeta (.const 1 []) :=
  PiModelDeltaIotaAudit.approxDI_beta E ρ (.const 0 []) (.bvar 0) (.const 1 [])

/-- Parameterized legacy `IotaWitness trueEnvU` for `True.rec.{u} motive minor True.intro ↦ minor`. -/
noncomputable def trueRecWitness (u : Level) (motive minor : Expr Nat) : IotaWitness trueEnvU where
  recRef := 2
  ctorRef := 1
  ls := [u]
  lsC := []
  recMember := trueRecMemberU
  ctorMember := trueIntroMember
  hrec := rfl
  hctor := rfl
  hrecK := rfl
  hctorK := rfl
  preMajor := [motive, minor]
  fields := []
  ctorParams := []
  kinds := []
  minor := minor
  hlen := rfl
  familyRef := 0
  famMember := trueFamMember
  hfam := rfl
  hfamK := rfl
  nparams := 0
  nindices := 0
  nMinors := 1
  ctorIdx := 0
  hctorParams := rfl
  hnpar := rfl
  hnidx := rfl
  hnmin := rfl
  hidx := by decide
  hctorIdx := rfl
  hrecIdx := rfl
  hpre := rfl
  hminor := rfl
  ctorDoms := []
  ctorResult := .const 0 []
  hpeel := rfl
  hfamApp := rfl
  hkinds := rfl
  recDoms := [.pi (.const 0 []) (.sort (.param 0)),
    .app (.bvar 0) (.const 1 []), .const 0 []]
  recBody := .app (.bvar 2) (.bvar 0)
  hpeelRec := rfl
  hrecBody := rfl
  hmajorTy := rfl
  hrecClosed := rfl
  hctorClosed := rfl
  hlsLen := rfl
  ctorAfterParams := .const 0 []
  hctorAfter := rfl
  hctorTel := rfl
  hfamTel := rfl
