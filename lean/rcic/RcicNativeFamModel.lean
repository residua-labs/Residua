theorem approxDIKCanon_iota_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {lhs rhs : Expr Nat} (hI : DerivedIotaU E lhs rhs) (c : CptI) :
    ApproxDIKCanon E Γ lhs c ↔ ApproxDIKCanon E Γ rhs c :=
