/-- Soundness-free `ConvT.tyConv` case for `LRTermFamIND` (requiring **neither** `TypeSoundnessI`
    **nor** `ShallowTypeSoundnessCtxI`). -/
theorem fundConvFamIND_tyConv {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M M' A A' : Expr Nat} {w : Level}
    (hA : HasTyT E n Γ A (.sort w)) (hc : TyConvT E n Γ A A')
    (h : ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A' u :=
  fun u hu => lrTermFamIND_transport hW hdet zsc hcore hF u hΓ hA hc (h u hu)

/-- Soundness-free `ConvT.symm` case for `LRTermFamIND` (requiring **neither** `TypeSoundnessI`
    **nor** `ShallowTypeSoundnessCtxI`). -/
