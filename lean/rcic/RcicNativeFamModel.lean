theorem whStepRecKCanon_foldApps_bvar_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecKCanon E Γ (foldApps (.bvar i) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecKCanon E Γ f e → (appsSpine f).1 = .bvar i → False := by
    intro f e hstep
    induction hstep with
    | beta => intro hsp; simp [appsSpine] at hsp
    | zeta => intro hsp; simp [appsSpine] at hsp
    | @zetaLocal j v hv =>
        intro hsp
        simp only [appsSpine, Expr.bvar.injEq] at hsp
        subst hsp
        rw [hnone] at hv
        exact Option.noConfusion hv
    | delta => intro hsp; simp [appsSpine] at hsp
    | iota hI =>
        intro hsp
        obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
        unfold recCall at hl
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [hl, s₂] at hsp
        exact Expr.noConfusion hsp
    | lit => intro hsp; simp [appsSpine] at hsp
    | @pmajorCanon w j margs _ _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [foldApps (.bvar j) margs])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        exact Expr.noConfusion hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r _ ls pre major _ _ _ _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        exact Expr.noConfusion hsp
  have hsp₀ := appsSpine_foldApps (.bvar i) xs
  simp only [appsSpine, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

theorem whStepRecKCanon_bvar_of_lookupValue_none_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {e : Expr Nat}
    (h : WhStepRecKCanon E Γ (.bvar i) e) : False :=
  whStepRecKCanon_foldApps_bvar_false hnone [] h

theorem whNormalRecKCanon_bvar_of_lookupValue_none {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) : WhNormalRecKCanon E Γ (.bvar i) :=
  fun _ hs => whStepRecKCanon_bvar_of_lookupValue_none_false hnone hs

theorem whNormalRecKCanon_foldApps_bvar {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) :
    WhNormalRecKCanon E Γ (foldApps (.bvar i) xs) :=
  fun _ hs => whStepRecKCanon_foldApps_bvar_false hnone xs hs

theorem whStepRecKCanon_rigidNonRec_false {E : ResolvedEnv} {Γ : LCtx} {r : Nat}
    {m : CheckedMember} (hmem : E.members r = some m) (hbody : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (ls : List Level) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecKCanon E Γ (foldApps (.const r ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecKCanon E Γ f e → (appsSpine f).1 = .const r ls → False := by
    intro f e hstep
    induction hstep with
    | beta => intro hsp; simp [appsSpine] at hsp
    | zeta => intro hsp; simp [appsSpine] at hsp
    | zetaLocal => intro hsp; simp [appsSpine] at hsp
    | @delta c ls' m' body hres hbody' =>
        intro hsp
        simp only [appsSpine, Expr.const.injEq] at hsp
        obtain ⟨hc, _⟩ := hsp
        subst hc
        have hmEq : m' = m := Option.some.inj (hres.symm.trans hmem)
        subst hmEq
        rw [hbody] at hbody'
        exact Option.noConfusion hbody'
    | iota hI =>
        intro hsp
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [ctorMajor w])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hrec _
            subst hrec
            have hm : w.recMember = m := Option.some.inj (w.hrec.symm.trans hmem)
            subst hm
            exact hnrec w.hrecK
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
              (w.preMajor ++ [foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hrec _
            subst hrec
            have hm : w.recMember = m := Option.some.inj (w.hrec.symm.trans hmem)
            subst hm
            exact hnrec w.hrecK
    | lit => intro hsp; simp [appsSpine] at hsp
    | @pmajorCanon w j margs _ _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [foldApps (.bvar j) margs])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hrEq _
        have hmEq : w.recMember = m := Option.some.inj ((hrEq ▸ w.hrec).symm.trans hmem)
        exact hnrec (hmEq ▸ w.hrecK)
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r' m' ls' pre major _ hm' hrec' _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r' ls') (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hrEq _
        subst hrEq
        have hmEq : m' = m := Option.some.inj (hm'.symm.trans hmem)
        subst hmEq
        exact hnrec hrec'
  have hsp₀ := appsSpine_foldApps (.const r ls) xs
  simp only [appsSpine_const, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

theorem whStepRecKCanon_famApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepRecKCanon E Γ (foldApps (.const r ls) xs) e) : False :=
  whStepRecKCanon_rigidNonRec_false hm (familyNoBody_of_envWfT hW r m hm hind)
    (by rw [hind]; decide) ls xs hs

theorem whNormalRecKCanon_famApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalRecKCanon E Γ (foldApps (.const r ls) xs) :=
