/-- `botVecFin xs` depends only on `xs.length`: if `xs.length = xs'.length`, then
    `botVecFin xs = botVecFin xs'`. -/
theorem botVecFin_eq_of_length_eq :
    ∀ {xs xs' : List (Expr Nat)}, xs.length = xs'.length → botVecFin xs = botVecFin xs'
  | [], [], _ => rfl
  | _ :: _, [], h => nomatch h
  | [], _ :: _, h => nomatch h
  | _ :: _, _ :: _, h =>
      congrArg (CptFin.bot :: ·) (botVecFin_eq_of_length_eq (Nat.succ.inj h))

/-- When `xs.length = xs'.length`, `foldApps (.const r ls') xs'` unconditionally approximates
    `.spine r (botVecFin xs)` in `ApproxFin ρ` (without any soundness premise). -/
theorem approxFin_famApp_botVecFin_of_length_eq (ρ : EnvFin) (r : Nat) (ls' : List Level)
    {xs xs' : List (Expr Nat)} (hlen : xs.length = xs'.length) :
    ApproxFin ρ (foldApps (.const r ls') xs') (.spine r (botVecFin xs)) := by
  rw [botVecFin_eq_of_length_eq hlen]
  exact approxFin_famApp_botVecFin ρ r ls' xs'

/-- `botVecI xs` depends only on `xs.length`: if `xs.length = xs'.length`, then
    `botVecI xs = botVecI xs'`. -/
theorem botVecI_eq_of_length_eq :
    ∀ {xs xs' : List (Expr Nat)}, xs.length = xs'.length → botVecI xs = botVecI xs'
  | [], [], _ => rfl
  | _ :: _, [], h => nomatch h
  | [], _ :: _, h => nomatch h
  | _ :: _, _ :: _, h =>
      congrArg (CptI.bot :: ·) (botVecI_eq_of_length_eq (Nat.succ.inj h))

/-- When `xs.length = xs'.length`, `foldApps (.const r ls') xs'` unconditionally approximates
    `.spine r (botVecI xs)` in `ApproxI ρ` (without any soundness premise). -/
theorem approxI_famApp_botVecI_of_length_eq (ρ : EnvI) (r : Nat) (ls' : List Level)
    {xs xs' : List (Expr Nat)} (hlen : xs.length = xs'.length) :
    ApproxI ρ (foldApps (.const r ls') xs') (.spine r (botVecI xs)) := by
  rw [botVecI_eq_of_length_eq hlen]
  exact approxI_famApp_botVecI ρ r ls' xs'

