/-- `ConvT.lit` case for `LRTermFamIN` from the diagonal on `natExpand t`. -/
theorem fundConvFamIN_lit {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} (t : Nat) (T : Expr Nat)
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) (natExpand t) u →
      LRTermFamIN E n Γ (natExpand t) (natExpand t) T u) :
    ∀ u, ApproxI (ctxEnvI Γ) (.lit t) u → LRTermFamIN E n Γ (.lit t) (natExpand t) T u :=
  fundConvFamIN_of_whStepCtx hcore (.lit t) hdiag

/-- `ConvT.refl` case for `LRTermFamIN` from the diagonal. -/
theorem fundConvFamIN_refl_of_diag {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {M A : Expr Nat}
