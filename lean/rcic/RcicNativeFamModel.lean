    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M N P A : Expr Nat}
