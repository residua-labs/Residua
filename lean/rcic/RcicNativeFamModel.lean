/-- No spine `foldApps (.const r ls) xs` headed by a non-recursor body-less constant
    (`m.body = none ∧ m.mclass ≠ .recursorM`) ever steps under `WhStepRecK E n Γ`. -/
theorem whStepRecK_rigidNonRec_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {r : Nat}
    {m : CheckedMember} (hmem : E.members r = some m) (hbody : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (ls : List Level) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecK E n Γ (foldApps (.const r ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecK E n Γ f e → (appsSpine f).1 = .const r ls → False := by
    intro f e hstep
    induction hstep with
    | @recCtx a b hs₀ =>
        intro hsp
        have hEq : foldApps (.const r ls) (appsSpine a).2 = a := by
          have h := foldApps_appsSpine a
          rwa [hsp] at h
        rw [← hEq] at hs₀
        exact whStepRecCtx_rigidNonRec_false hmem hbody hnrec ls _ hs₀
    | @pmajor r₀ ls₀ pre _ x _ _ hI _ _ _ =>
        intro hsp
        unfold recCall at hsp
        have s₂ := appsSpine_foldApps (.const r₀ ls₀) (pre ++ [x])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [s₂] at hsp
        injection hsp with hrEq _
        subst hrEq
        rcases derivedIotaU_recHead hI with ⟨r₁, ls₁, pre₁, maj₁, m₁, hlhs, hm₁, hrec₁⟩
        unfold recCall at hlhs
        obtain ⟨hconst, _⟩ := foldApps_const_inj hlhs
        injection hconst with hr₁ _
        subst hr₁
        have hmEq : m₁ = m := Option.some.inj (hm₁.symm.trans hmem)
        subst hmEq
        exact hnrec hrec₁
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r' m' ls' pre major _ hm' hrec' _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r' ls') (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hrEq _
        subst hrEq
        have hmEq : m' = m := Option.some.inj (hm'.symm.trans hmem)
        subst hmEq
        exact hnrec hrec'
  have hsp₀ := appsSpine_foldApps (.const r ls) xs
  simp only [appsSpine_const, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

/-- Under `EnvWfT E`, no admitted `.inductiveM` family spine `foldApps (.const r ls) xs` takes a
    `WhStepRecK E n Γ` step. -/
theorem whStepRecK_famApp_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepRecK E n Γ (foldApps (.const r ls) xs) e) : False :=
  whStepRecK_rigidNonRec_false hm (familyNoBody_of_envWfT hW r m hm hind)
    (by rw [hind]; decide) ls xs hs

theorem whNormalRecK_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
