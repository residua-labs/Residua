theorem fundSubstFamINDRKCanon_bvar_lt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {ρ : EnvI} {i j : Nat} (hij : i < j) {sub sub' T : Expr Nat}
    (hdiag : ∀ c, PiModelDeltaIotaAudit.ApproxDI E ρ (.bvar i) c →
      LRTermFamINDRKCanon E n Γ (.bvar i) (.bvar i) T c) :
