/-- Under `EnvWfT E`, no recursor prefix `foldApps (.const r ls) xs` with
    `xs.length + 1 ≤ piCount m.mtype` ever steps under `WhStepRecKCanon E Γ`. -/
theorem whStepRecKCanon_recursor_prefix_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (ls : List Level) (xs : List (Expr Nat)) (hlen : xs.length + 1 ≤ piCount m.mtype) {e : Expr Nat}
    (hs : WhStepRecKCanon E Γ (foldApps (.const r ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat} (ys : List (Expr Nat)),
      WhStepRecKCanon E Γ f e → appsSpine f = (.const r ls, ys) →
      ys.length + 1 ≤ piCount m.mtype → False := by
    intro f e ys hstep
    induction hstep generalizing ys with
    | beta _ _ _ => intro hsp _; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp _; simp [appsSpine] at hsp
    | zetaLocal _ => intro hsp _; simp [appsSpine] at hsp
    | @delta r₀ _ _ _ hres hbody =>
        intro hsp _
        simp only [appsSpine, Prod.mk.injEq, Expr.const.injEq] at hsp
        obtain ⟨⟨rfl, _⟩, _⟩ := hsp
        obtain ⟨hd, _⟩ := PiModelDeltaIotaAudit.envWfT_member_body_closed hW r₀ _ _ hres hbody
        have hmEq : _ = m := Option.some.inj (hd.1.symm.trans hm)
        subst hmEq
        exact hd.2.2.1 hrec
    | @iota lhs rhs hI =>
        intro hsp hlen'
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
              (w.preMajor ++ [ctorMajor w])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hhead hargs
            injection hhead with hrecEq _
            subst hrecEq
            have hmEq : w.recMember = m := Option.some.inj (w.hrec.symm.trans hm)
            subst hmEq
            have hlenEq := congrArg List.length hargs
            simp only [List.length_append, List.length_singleton] at hlenEq
            have hp := w.hpre
            have hn := w.hnmin
            omega
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
              (w.preMajor ++ [foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hhead hargs
            injection hhead with hrecEq _
            subst hrecEq
            have hmEq : w.recMember = m := Option.some.inj (w.hrec.symm.trans hm)
            subst hmEq
            have hlenEq := congrArg List.length hargs
            simp only [List.length_append, List.length_singleton] at hlenEq
            have hp := w.hpre
            have hn := w.hnmin
            omega
    | lit _ => intro hsp _; simp [appsSpine] at hsp
    | @pmajorCanon w j margs _ _ _ _ =>
        intro hsp hlen'
        have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
          (w.preMajor ++ [foldApps (.bvar j) margs])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hhead hargs
        injection hhead with hrecEq _
        subst hrecEq
        have hmEq : w.recMember = m := Option.some.inj (w.hrec.symm.trans hm)
        subst hmEq
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton] at hlenEq
        have hp := w.hpre
        have hn := w.hnmin
        omega
    | @appHead f₀ _ _ _ ih =>
        intro hsp hlen'
        simp only [appsSpine, Prod.mk.injEq] at hsp
        obtain ⟨hhead, hargs⟩ := hsp
        subst hargs
        simp only [List.length_append, List.length_singleton] at hlen'
        exact ih (appsSpine f₀).2 (Prod.ext hhead rfl) (by omega)
    | @recMajor r' m' ls' pre major _ hm' _ hlenRec _ _ =>
        intro hsp hlen'
        have s₂ := appsSpine_foldApps (.const r' ls') (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hhead hargs
        injection hhead with hrecEq _
        subst hrecEq
        have hmEq : m' = m := Option.some.inj (hm'.symm.trans hm)
        subst hmEq
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton] at hlenEq
        omega
  have hsp₀ := appsSpine_foldApps (.const r ls) xs
  simp only [appsSpine_const, List.nil_append] at hsp₀
  exact key xs hs hsp₀ hlen

/-- One-step determinism predicate for `WhStepRecKCanon E Γ`. -/
def WhDetRecKCanon (E : ResolvedEnv) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhStepRecKCanon E Γ a b → WhStepRecKCanon E Γ a c → b = c

/-- Normal-form uniqueness predicate for `WhRedRecKCanon E Γ` / `WhNormalRecKCanon E Γ`. -/
def WhNormalUniqueRecKCanon (E : ResolvedEnv) (Γ : LCtx) : Prop :=
  ∀ {a X Y : Expr Nat}, WhRedRecKCanon E Γ a X → WhNormalRecKCanon E Γ X →
    WhRedRecKCanon E Γ a Y → WhNormalRecKCanon E Γ Y → X = Y

/-- **Unconditional One-Step Determinism of `WhStepRecKCanon E Γ` (`whDetRecKCanon_of_envWfT`):**
    At every well-formed environment `EnvWfT E` and context `Γ : LCtx`, `WhStepRecKCanon E Γ` is
    deterministic! -/
theorem whDetRecKCanon_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx) :
    WhDetRecKCanon E Γ := by
  intro a b c h₁ h₂
  induction h₁ generalizing c with
  | beta A body arg =>
      generalize ha : Expr.app (.lam A body) arg = a₀ at h₂
      cases h₂ with
      | beta =>
          injection ha with hlam harg
          injection hlam with _ hbody
          subst hbody; subst harg
          rfl
      | zeta => nomatch ha
      | zetaLocal => nomatch ha
      | delta => nomatch ha
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          rw [← ha] at hl
          simp only [recCall, foldApps_snoc, Expr.app.injEq] at hl
          exact (F8EtaK.foldApps_const_ne_lam_any hl.1.symm).elim
      | lit => nomatch ha
      | pmajorCanon _ _ _ _ _ _ _ =>
          injection ha with hrecEq _
          exact (F8EtaK.foldApps_const_ne_lam_any hrecEq.symm).elim
      | appHead hf =>
          injection ha with hfEq _
          subst hfEq
          exact (whStepRecKCanon_lam_false hf).elim
      | recMajor _ _ _ _ =>
          injection ha with hrecEq _
          exact (F8EtaK.foldApps_const_ne_lam_any hrecEq.symm).elim
  | zeta A v body =>
      cases h₂ with
      | zeta => rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | zetaLocal hv₁ =>
      cases h₂ with
      | zetaLocal hv₂ => exact Option.some.inj (hv₁.symm.trans hv₂)
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | delta hres₁ hbody₁ =>
      cases h₂ with
      | delta hres₂ hbody₂ =>
          have hm : _ = _ := Option.some.inj (hres₁.symm.trans hres₂)
          subst hm
          have hb : _ = _ := Option.some.inj (hbody₁.symm.trans hbody₂)
          subst hb
          rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | iota hI₁ =>
      obtain ⟨r₁, c₁, m_rec₁, m_ctor₁, ls₁, lsC₁, pre₁, cargs₁,
        hl₁, hm_rec₁, hrec₁, hlen₁, hm_ctor₁, hctor₁⟩ := derivedIotaU_rec_ctor_shape hI₁
      cases h₂ with
      | beta =>
          simp only [Expr.app.injEq] at hl₁
          exact (F8EtaK.foldApps_const_ne_lam_any hl₁.1.symm).elim
      | zeta => nomatch hl₁
      | zetaLocal => nomatch hl₁
      | delta => nomatch hl₁
      | iota hI₂ => exact PiModelDeltaIotaAudit.iotaDetU_of_envWfT hW hI₁ hI₂
      | lit => nomatch hl₁
      | @pmajorCanon w₂ j₂ margs₂ _ _ _ _ =>
          injection hl₁ with _ hmajEq
          have s₁ := appsSpine_foldApps (.const c₁ lsC₁) cargs₁
          have s₂ := appsSpine_foldApps (.bvar j₂) margs₂
          simp only [appsSpine_const, appsSpine_bvar, List.nil_append] at s₁ s₂
          have hs := congrArg (Prod.fst ∘ appsSpine) hmajEq
          simp only [Function.comp_apply, s₁, s₂] at hs
          exact Expr.noConfusion hs
      | appHead hf =>
          injection hl₁ with hfEq _
          subst hfEq
          exact (whStepRecKCanon_recursor_prefix_false hW hm_rec₁ hrec₁ ls₁ pre₁
            (Nat.le_of_eq hlen₁) hf).elim
      | recMajor _ _ _ hmaj =>
          injection hl₁ with _ hmajEq
          subst hmajEq
          exact (whStepRecKCanon_ctorApp_false hW hm_ctor₁ hctor₁ hmaj).elim
  | lit t =>
      cases h₂ with
      | lit => rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | @pmajorCanon w₁ j₁ margs₁ _ hidx₁ hflds₁ hnone₁ =>
      generalize ha : Expr.app (foldApps (.const w₁.recRef w₁.ls) w₁.preMajor)
        (foldApps (.bvar j₁) margs₁) = a₀ at h₂
      cases h₂ with
      | beta =>
          injection ha with hlam _
          exact (F8EtaK.foldApps_const_ne_lam_any hlam).elim
      | zeta => nomatch ha
      | zetaLocal => nomatch ha
      | delta => nomatch ha
      | iota hI₂ =>
          obtain ⟨_, c₂, _, _, _, lsC₂, _, cargs₂,
            hl₂, _, _, _, _, _⟩ := derivedIotaU_rec_ctor_shape hI₂
          rw [← ha] at hl₂
          injection hl₂ with _ hmajEq
          have s₁ := appsSpine_foldApps (.bvar j₁) margs₁
          have s₂ := appsSpine_foldApps (.const c₂ lsC₂) cargs₂
          simp only [appsSpine_bvar, appsSpine_const, List.nil_append] at s₁ s₂
          have hs := congrArg (Prod.fst ∘ appsSpine) hmajEq
          simp only [Function.comp_apply, s₁, s₂] at hs
          exact Expr.noConfusion hs
      | lit => nomatch ha
      | @pmajorCanon w₂ j₂ margs₂ _ hidx₂ hflds₂ _ =>
          injection ha with hfEq _
          obtain ⟨hconst, hpre⟩ := foldApps_const_inj hfEq
          injection hconst with hrec hls
          exact pmajorCanon_iotaRhsOf_unique w₁ w₂ hrec hls hpre hidx₁ hidx₂ hflds₁ hflds₂
      | appHead hf₂ =>
          injection ha with hfEq _
          subst hfEq
          have hlen₁ : w₁.preMajor.length + 1 ≤ piCount w₁.recMember.mtype := by
            have hp := w₁.hpre
            have hn := w₁.hnmin
            omega
          exact (whStepRecKCanon_recursor_prefix_false hW w₁.hrec w₁.hrecK
            w₁.ls w₁.preMajor hlen₁ hf₂).elim
      | recMajor _ _ _ hmaj₂ =>
          injection ha with _ hmajEq
          subst hmajEq
          exact (whStepRecKCanon_foldApps_bvar_false hnone₁ margs₁ hmaj₂).elim
  | appHead hf₁ ih =>
      cases h₂ with
      | beta => exact (whStepRecKCanon_lam_false hf₁).elim
      | iota hI₂ =>
          obtain ⟨r₂, _, m_rec₂, _, ls₂, _, pre₂, _,
            hl₂, hm_rec₂, hrec₂, hlen₂, _, _⟩ := derivedIotaU_rec_ctor_shape hI₂
          injection hl₂ with hfEq _
          subst hfEq
          exact (whStepRecKCanon_recursor_prefix_false hW hm_rec₂ hrec₂ ls₂ pre₂
            (Nat.le_of_eq hlen₂) hf₁).elim
      | @pmajorCanon w₂ _ _ _ _ _ _ =>
          have hlen₂ : w₂.preMajor.length + 1 ≤ piCount w₂.recMember.mtype := by
            have hp := w₂.hpre
            have hn := w₂.hnmin
            omega
          exact (whStepRecKCanon_recursor_prefix_false hW w₂.hrec w₂.hrecK
            w₂.ls w₂.preMajor hlen₂ hf₁).elim
      | appHead hf₂ => rw [ih hf₂]
      | recMajor hm₂ hrec₂ hlen₂ _ =>
          exact (whStepRecKCanon_recursor_prefix_false hW hm₂ hrec₂ _ _
            (Nat.le_of_eq hlen₂) hf₁).elim
  | @recMajor r₁ m₁ ls₁ pre₁ major major₁' hm₁ hrec₁ hlen₁ hmaj₁ ih =>
      generalize ha : Expr.app (foldApps (.const r₁ ls₁) pre₁) major = a₀ at h₂
      cases h₂ with
      | beta =>
          injection ha with hlam _
          exact (F8EtaK.foldApps_const_ne_lam_any hlam).elim
      | zeta => nomatch ha
      | zetaLocal => nomatch ha
      | delta => nomatch ha
      | iota hI₂ =>
          obtain ⟨_, _, _, m_ctor₂, _, _, _, _,
            hl₂, _, _, _, hm_ctor₂, hctor₂⟩ := derivedIotaU_rec_ctor_shape hI₂
          rw [← ha] at hl₂
          injection hl₂ with _ hmajEq
          subst hmajEq
          exact (whStepRecKCanon_ctorApp_false hW hm_ctor₂ hctor₂ hmaj₁).elim
      | lit => nomatch ha
      | @pmajorCanon _ j₂ margs₂ _ _ _ hnone₂ =>
          injection ha with _ hmajEq
          subst hmajEq
          exact (whStepRecKCanon_foldApps_bvar_false hnone₂ margs₂ hmaj₁).elim
      | appHead hf₂ =>
          injection ha with hfEq _
          subst hfEq
          exact (whStepRecKCanon_recursor_prefix_false hW hm₁ hrec₁ ls₁ pre₁
            (Nat.le_of_eq hlen₁) hf₂).elim
      | recMajor _ _ _ hmaj₂ =>
          injection ha with hfEq hmajEq
          subst hmajEq
          rw [hfEq, ih hmaj₂]

/-- Uniqueness of `WhNormalRecKCanon E Γ` normal forms from `WhDetRecKCanon E Γ`. -/
theorem whRedRecKCanon_normal_unique {E : ResolvedEnv} {Γ : LCtx} (hdet : WhDetRecKCanon E Γ)
    {a X Y : Expr Nat} (h₁ : WhRedRecKCanon E Γ a X) (hX : WhNormalRecKCanon E Γ X)
    (h₂ : WhRedRecKCanon E Γ a Y) (hY : WhNormalRecKCanon E Γ Y) : X = Y := by
  induction h₁ with
  | refl =>
      cases h₂ with
      | refl => rfl
      | step hs₂ _ => exact (hX _ hs₂).elim
  | step hs₁ _ ih =>
      cases h₂ with
      | refl => exact (hY _ hs₁).elim
      | step hs₂ hred₂ =>
          have heq := hdet hs₁ hs₂
          subst heq
          exact ih hX hred₂

/-- **Unconditional Normal-Form Uniqueness of `WhRedRecKCanon E Γ` (`whRedRecKCanon_normal_unique_of_envWfT`):** -/
theorem whRedRecKCanon_normal_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    {a X Y : Expr Nat} (h₁ : WhRedRecKCanon E Γ a X) (hX : WhNormalRecKCanon E Γ X)
    (h₂ : WhRedRecKCanon E Γ a Y) (hY : WhNormalRecKCanon E Γ Y) : X = Y :=
  whRedRecKCanon_normal_unique (whDetRecKCanon_of_envWfT hW Γ) h₁ hX h₂ hY

theorem whNormalUniqueRecKCanon_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx) :
    WhNormalUniqueRecKCanon E Γ :=
  fun h₁ hX h₂ hY => whRedRecKCanon_normal_unique_of_envWfT hW h₁ hX h₂ hY

/-- `WhStepRecKCanon E Γ` is invariant under `CtxSameValues Γ Γ'`. -/
theorem whStepRecKCanon_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hs : WhStepRecKCanon E Γ a b) : WhStepRecKCanon E Γ' a b := by
  induction hs with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | @zetaLocal i v hv =>
      rw [h i] at hv
      exact .zetaLocal hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | @pmajorCanon w i margs hprop hidx hflds hnone =>
      rw [h i] at hnone
      exact .pmajorCanon w i margs hprop hidx hflds hnone
  | appHead _ ih => exact .appHead ih
  | recMajor hm hrec hlen _ ih => exact .recMajor hm hrec hlen ih

theorem whRedRecKCanon_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hr : WhRedRecKCanon E Γ a b) : WhRedRecKCanon E Γ' a b := by
  induction hr with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepRecKCanon_of_sameValues h hs) ih

theorem whNormalRecKCanon_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {X : Expr Nat} (hn : WhNormalRecKCanon E Γ X) : WhNormalRecKCanon E Γ' X :=
  fun Y hs => hn Y (whStepRecKCanon_of_sameValues (ctxSameValues_symm h) hs)

/-- **Positive Resolution of `W-K-OPEN` (`trueRecVar`) and `W-K-AND` (`mixAndRedex`) Under
    Deterministic `WhRedRecKCanon`:**
    1. In `trueEnvU` at `trueVarCtx`, `trueRecVar u motive minor` steps in one `pmajorCanon` step
       to `minor` (`whRedRecKCanon_trueRecVar`).
    2. In `andEnvU` at `mixAndCtx`, `mixAndRedex` steps in three `WhStepRecKCanon` steps (`pmajorCanon`
       with `andCanonIotaWitness`, followed by two `beta` steps) to `mixPi = Sort 0 → Sort 0`
       (`whRedRecKCanon_mixAndRedex`)! -/
theorem whRedRecKCanon_trueRecVar (u : Level) (motive minor : Expr Nat) :
    WhRedRecKCanon trueEnvU trueVarCtx (trueRecVar u motive minor) minor :=
  .step
    (.pmajorCanon (trueRecWitness u motive minor) 0 [] rfl rfl rfl rfl)
    (.refl minor)

theorem whRedRecKCanon_trueVarSort :
    WhRedRecKCanon trueEnvU trueVarCtx trueVarSort (.sort .zero) :=
  whRedRecKCanon_trueRecVar (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero)

theorem whRedRecKCanon_trueVarPi :
    WhRedRecKCanon trueEnvU trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp :=
  whRedRecKCanon_trueRecVar (.succ .zero) (trueSortMotive .zero) PiModelDeltaIotaAudit.idPiProp

theorem whRedRecKCanon_trueVarFam :
    WhRedRecKCanon trueEnvU trueVarCtx trueVarFam (.const 0 []) :=
  whRedRecKCanon_trueRecVar (.succ .zero) (trueSortMotive .zero) (.const 0 [])

theorem whRedRecKCanon_mixAndRedex :
    WhRedRecKCanon andEnvU mixAndCtx mixAndRedex mixPi := by
  have hs1 : WhStepRecKCanon andEnvU mixAndCtx mixAndRedex
      (.app (.app mixAndMin famBotClosedExpr) famBotClosedExpr) :=
    .pmajorCanon (andCanonIotaWitness (.succ (.succ .zero)) mixAndMot mixAndMin) 0 [] rfl rfl rfl rfl
  have hs2 : WhStepRecKCanon andEnvU mixAndCtx
      (.app (.app mixAndMin famBotClosedExpr) famBotClosedExpr)
      (.app (.lam (.bvar 3) mixPi) famBotClosedExpr) :=
    .appHead (.beta (.bvar 4) (.lam (.bvar 4) mixPi) famBotClosedExpr)
  have hs3 : WhStepRecKCanon andEnvU mixAndCtx
      (.app (.lam (.bvar 3) mixPi) famBotClosedExpr) mixPi :=
    .beta (.bvar 3) mixPi famBotClosedExpr
  exact .step hs1 (.step hs2 (.step hs3 (.refl mixPi)))

/-- **Canonical K-Closed Concrete $\delta$/$\iota$ Family Model (`ApproxDIKCanon E Γ e c` & `SemEqDIKCanon E Γ a b`):** -/
def ApproxDIKCanon (E : ResolvedEnv) (Γ : LCtx) (e : Expr Nat) (c : CptI) : Prop :=
  ∃ X, WhRedRecKCanon E Γ e X ∧ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) X c

def SemEqDIKCanon (E : ResolvedEnv) (Γ : LCtx) (a b : Expr Nat) : Prop :=
  ∀ c, ApproxDIKCanon E Γ a c ↔ ApproxDIKCanon E Γ b c

theorem approxDIKCanon_of_approxDI {E : ResolvedEnv} {Γ : LCtx} {e : Expr Nat} {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c) : ApproxDIKCanon E Γ e c :=
  ⟨e, .refl e, h⟩

theorem approxDIKCanon_bot (E : ResolvedEnv) (Γ : LCtx) (e : Expr Nat) :
    ApproxDIKCanon E Γ e .bot :=
  ⟨e, .refl e, .bot _ e⟩

theorem approxDIKCanon_of_whStepRecKCanon {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat} {c : CptI}
    (hs : WhStepRecKCanon E Γ a b) (hb : ApproxDIKCanon E Γ b c) : ApproxDIKCanon E Γ a c := by
  rcases hb with ⟨X, hred, hX⟩
  exact ⟨X, .step hs hred, hX⟩

theorem approxDIKCanon_of_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat} {c : CptI}
    (hr : WhRedRecKCanon E Γ a b) (hb : ApproxDIKCanon E Γ b c) : ApproxDIKCanon E Γ a c := by
  rcases hb with ⟨X, hred, hX⟩
  exact ⟨X, whRedRecKCanon_trans hr hred, hX⟩

theorem approxDIKCanon_sort_iff (E : ResolvedEnv) (Γ : LCtx) (u : Level) (c : CptI) :
    ApproxDIKCanon E Γ (.sort u) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.sort u) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_sort_eq hred] at hX
  · exact approxDIKCanon_of_approxDI

theorem approxDIKCanon_pi_iff (E : ResolvedEnv) (Γ : LCtx) (A B : Expr Nat) (c : CptI) :
    ApproxDIKCanon E Γ (.pi A B) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.pi A B) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_pi_eq hred] at hX
  · exact approxDIKCanon_of_approxDI

theorem approxDIKCanon_lam_iff (E : ResolvedEnv) (Γ : LCtx) (A b : Expr Nat) (c : CptI) :
    ApproxDIKCanon E Γ (.lam A b) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.lam A b) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_lam_eq hred] at hX
  · exact approxDIKCanon_of_approxDI

theorem approxDIKCanon_famApp_iff {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIKCanon E Γ (foldApps (.const r ls) xs) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const r ls) xs) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_famApp_eq hW hm hind hred] at hX
  · exact approxDIKCanon_of_approxDI

theorem approxDIKCanon_bvar_of_lookupValue_none_iff {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (c : CptI) :
    ApproxDIKCanon E Γ (.bvar i) c ↔ c = .bot := by
  constructor
  · rintro ⟨X, hred, hX⟩
    cases hred with
    | refl => exact approxDI_ctxEnvDI_bvar_of_lookupValue_none hnone hX
    | step hs _ => exact (whStepRecKCanon_bvar_of_lookupValue_none_false hnone hs).elim
  · rintro rfl
    exact approxDIKCanon_bot E Γ (.bvar i)

theorem approxDIKCanon_sort (E : ResolvedEnv) (Γ : LCtx) (u : Level) :
    ApproxDIKCanon E Γ (.sort u) .sort :=
  approxDIKCanon_of_approxDI (.sort _ u)

theorem approxDIKCanon_pi_bot_nil (E : ResolvedEnv) (Γ : LCtx) (A B : Expr Nat) :
    ApproxDIKCanon E Γ (.pi A B) (.pi .bot []) :=
  approxDIKCanon_of_approxDI (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B)

theorem approxDIKCanon_famApp_of_botDemand {E : ResolvedEnv} (Γ : LCtx)
    {r : Nat} (ls : List Level) (hrigid : PiModelDeltaIotaAudit.RigidConst E r)
    {xs : List (Expr Nat)} {cs : List CptI}
    (hlen : xs.length = cs.length) (hbd : PiModelDeltaIotaAudit.BotDemand cs) :
    ApproxDIKCanon E Γ (foldApps (.const r ls) xs) (.spine r cs) :=
  approxDIKCanon_of_approxDI (approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls hrigid hlen hbd)

theorem approxDIKCanon_famApp_botVecI_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    (Γ : LCtx) {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    ApproxDIKCanon E Γ (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
  approxDIKCanon_of_approxDI (approxDI_famApp_botVecI_of_inductiveM hW (ctxEnvDI E Γ) hm hind ls xs)

theorem approxDIKCanon_trueVarSort :
    ApproxDIKCanon trueEnvU trueVarCtx trueVarSort .sort :=
  approxDIKCanon_of_whRedRecKCanon whRedRecKCanon_trueVarSort
    (approxDIKCanon_sort trueEnvU trueVarCtx .zero)

theorem approxDIKCanon_trueVarPi :
    ApproxDIKCanon trueEnvU trueVarCtx trueVarPi (.pi .bot []) :=
  approxDIKCanon_of_whRedRecKCanon whRedRecKCanon_trueVarPi
    (approxDIKCanon_pi_bot_nil trueEnvU trueVarCtx (.sort .zero) (.bvar 0))

theorem approxDIKCanon_trueVarFam :
    ApproxDIKCanon trueEnvU trueVarCtx trueVarFam (.spine 0 []) :=
  approxDIKCanon_of_whRedRecKCanon whRedRecKCanon_trueVarFam
    (approxDIKCanon_famApp_botVecI_of_inductiveM trueEnvUWfT trueVarCtx
      (r := 0) (m := trueFamMember) rfl rfl [] [])

theorem approxDIKCanon_mixAndRedex :
    ApproxDIKCanon andEnvU mixAndCtx mixAndRedex (.pi .bot []) :=
  approxDIKCanon_of_whRedRecKCanon whRedRecKCanon_mixAndRedex
    (approxDIKCanon_pi_bot_nil andEnvU mixAndCtx (.sort .zero) (.sort .zero))

/-- **Canonical Deterministic K + Recursor-Major Family Type Logical Relation (`LRTypeFamINRKCanon E n`):** -/
inductive LRTypeFamINRKCanon (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeFamINRKCanon E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedRecKCanon E Γ A (.sort u)) (h' : WhRedRecKCanon E Γ A' (.sort u')) :
      LRTypeFamINRKCanon E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedRecKCanon E Γ A (.pi A₁ B₁)) (h' : WhRedRecKCanon E Γ A' (.pi A₂ B₂))
      (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeFamINRKCanon E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, LRTypeFamINRKCanon E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeFamINRKCanon E n Γ A A' (.pi a f)
  | famSpine {Γ : LCtx} {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (h : WhRedRecKCanon E Γ A (foldApps (.const r ls) xs))
      (h' : WhRedRecKCanon E Γ A' (foldApps (.const r ls') xs'))
      (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
      (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
      (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = (piDomsOf m.mtype).length)
      (hlen' : xs'.length = (piDomsOf m.mtype).length)
      (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
      LRTypeFamINRKCanon E n Γ A A' (.spine r args)
  | otherSpine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
      (h : WhRedRecKCanon E Γ A X) (h' : WhRedRecKCanon E Γ A' X')
      (hn : WhNormalRecKCanon E Γ X) (hn' : WhNormalRecKCanon E Γ X')
      (hc : TyConvT E n Γ X X') :
      LRTypeFamINRKCanon E n Γ A A' (.spine r args)

/-- Closure of `LRTypeFamINRKCanon` under `WhRedRecKCanon E Γ` expansion on both sides. -/
theorem lrTypeFamINRKCanon_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A A' X X' : Expr Nat}
    {c : CptI} (hX : WhRedRecKCanon E Γ A X) (hX' : WhRedRecKCanon E Γ A' X')
    (h : LRTypeFamINRKCanon E n Γ X X' c) : LRTypeFamINRKCanon E n Γ A A' c := by
  cases h with
  | bot => exact .bot Γ A A'
  | sort h₁ h₂ => exact .sort (whRedRecKCanon_trans hX h₁) (whRedRecKCanon_trans hX' h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod ra rf =>
      exact .pi (whRedRecKCanon_trans hX h₁) (whRedRecKCanon_trans hX' h₂) hΓ₁ hdom hcod ra rf
  | famSpine hm hind h₁ h₂ hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedRecKCanon_trans hX h₁) (whRedRecKCanon_trans hX' h₂)
        hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h₁ h₂ hn hn' hc =>
      exact .otherSpine hnot (whRedRecKCanon_trans hX h₁) (whRedRecKCanon_trans hX' h₂) hn hn' hc

/-- Every `LRTypeFamINR E n Γ A A' c` derivation at `c ∈ BotFamCpt E` lifts directly to
    `LRTypeFamINRKCanon E n Γ A A' c`. -/
theorem lrTypeFamINRKCanon_of_lrTypeFamINR_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) (h : LRTypeFamINR E n Γ A A' c) :
    LRTypeFamINRKCanon E n Γ A A' c := by
  induction h with
  | bot Γ B B' => exact .bot Γ B B'
  | sort h₁ h₂ =>
      exact .sort (whRedRecCtx_to_whRedRecKCanon h₁) (whRedRecCtx_to_whRedRecKCanon h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod _ _ iha ihf =>
      cases hc with
      | pi hba _ hbf =>
          exact .pi (whRedRecCtx_to_whRedRecKCanon h₁) (whRedRecCtx_to_whRedRecKCanon h₂)
            hΓ₁ hdom hcod (iha hba) (fun s hs => ihf s hs (hbf s hs))
  | famSpine hm hind h₁ h₂ hty hty' hconv heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedRecCtx_to_whRedRecKCanon h₁) (whRedRecCtx_to_whRedRecKCanon h₂)
        hty hty' hconv heqN hlen hlen' hargs
  | otherSpine hnot _ _ _ _ _ =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

theorem lrTypeFamINRKCanon_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamINRKCanon E n Γ A A' c :=
  lrTypeFamINRKCanon_of_lrTypeFamINR_botFamCpt hc (lrTypeFamINR_of_lrTypeFamIN_botFamCpt hc h)

/-- Context transport of `LRTypeFamINRKCanon` across `CtxConvT E n Γ Γ'` and `CtxSameValues Γ Γ'`
    under `EnvClosed E`. -/
theorem lrTypeFamINRKCanon_ctx_sameValues {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ') (hΓ' : CtxWfT E n Γ')
    {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINRKCanon E n Γ A A' c) : LRTypeFamINRKCanon E n Γ' A A' c := by
  induction h generalizing Γ' with
  | bot => exact .bot _ _ _
  | sort h h' =>
      exact .sort (whRedRecKCanon_of_sameValues hval h)
        (whRedRecKCanon_of_sameValues hval h')
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u _ hA₁ =>
          have hA₁' : HasTyT E n Γ' A₁ (.sort u) := hasTyT_ctx hcl hctx hA₁
          have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ') := .assumption Γ' A₁ u hΓ' hA₁'
          exact .pi (whRedRecKCanon_of_sameValues hval h)
            (whRedRecKCanon_of_sameValues hval h')
            hΓ₁' (tyConvT_ctx hcl hctx hdom)
            (tyConvT_ctx hcl (.same (.assumption A₁) hctx) hcod)
            (iha hctx hval hΓ')
            (fun s hs => ihf s hs (.same (.assumption A₁) hctx)
              (ctxSameValues_same (.assumption A₁) hval) hΓ₁')
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind
        (whRedRecKCanon_of_sameValues hval h)
        (whRedRecKCanon_of_sameValues hval h')
        (hasTyT_ctx hcl hctx hty) (hasTyT_ctx hcl hctx hty')
        (tyConvT_ctx hcl hctx hc) heqN hlen hlen'
        (convArgsT_ctx hcl hctx hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot
        (whRedRecKCanon_of_sameValues hval h)
        (whRedRecKCanon_of_sameValues hval h')
        (whNormalRecKCanon_of_sameValues hval hn)
        (whNormalRecKCanon_of_sameValues hval hn')
        (tyConvT_ctx hcl hctx hc)

theorem lrTypeFamINRKCanon_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {B B' : Expr Nat} {c : CptI},
      LRTypeFamINRKCanon E n (.assumption A₂ :: Γ) B B' c →
      LRTypeFamINRKCanon E n (.assumption A₁ :: Γ) B B' c
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, hA₁, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTypeFamINRKCanon_ctx_sameValues hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (ctxSameValues_assumption A₂ A₁ (ctxSameValues_refl Γ))
        (.assumption Γ A₁ _ hΓ hA₁) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      lrTypeFamINRKCanon_assump_dom hcl hW hΓ c₁ hA₁
        (lrTypeFamINRKCanon_assump_dom hcl hW hΓ c₂ hM h)

/-- **`PiRowField`-Free and Coherence-Free Symmetry of `LRTypeFamINRKCanon`
    (`lrTypeFamINRKCanon_symm_of_envWfT`):**
    Holds at every `EnvWfT E` with **zero** `PiRowField` or coherence hypotheses! -/
theorem lrTypeFamINRKCanon_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINRKCanon E n Γ A A' c) :
    LRTypeFamINRKCanon E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamINRKCanon_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype_of_envWfT hW hΓ hm hind hty hty' heqN hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot h' h hn' hn hc.symmT

/-- **`PiRowField`-Free and Coherence-Free Transitivity of `LRTypeFamINRKCanon`
    (`lrTypeFamINRKCanon_trans_of_envWfT`):**
    Holds at every `EnvWfT E` across **all** compacts `c : CptI` with **zero** `PiRowField`,
    `WhPiCoh`, or `WhFamCoh` hypotheses — using `whRedRecKCanon_normal_unique_of_envWfT` and
    `convArgs_trans_instMtype_of_envWfT`! -/
theorem lrTypeFamINRKCanon_trans_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamINRKCanon E n Γ A B c) :
    ∀ {C : Expr Nat}, LRTypeFamINRKCanon E n Γ B C c → LRTypeFamINRKCanon E n Γ A C c := by
  have hcl := envClosed_of_envWfT hW
  induction h₁ with
  | bot => intro C _; exact .bot _ _ _
  | sort h _ =>
      intro C h₂
      cases h₂ with
      | sort _ hC => exact .sort h hC
  | @pi Γ A B A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      intro C h₂
      cases h₂ with
      | pi hB hC _ hdom' hcod' ra' rf' =>
          have e := whRedRecKCanon_normal_unique_of_envWfT hW
            h' (whNormalRecKCanon_pi _ _) hB (whNormalRecKCanon_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi h hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom hdom')
                (.trans _ _ _ _ hcod (tyConvT_assump_dom hW hΓ₀ hdom hcod'))
                (iha hΓ₀ ra')
                (fun s hs => ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)
                  (lrTypeFamINRKCanon_assump_dom hcl hW hΓ₀ hdom hA₁ (rf' s hs)))
  | @famSpine Γ A B r m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ args hm₁ hind₁ h₁ h₁' hty₁ hty₂ hc₁ heqN₁ hlen₁ _ hargs₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ _ hB hC _ hty₃ hc₂ heqN₂ _ hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          have e := whRedRecKCanon_normal_unique_of_envWfT hW
            h₁' (whNormalRecKCanon_famApp hW hm₁ hind₁ ls₂ xs₂)
            hB (whNormalRecKCanon_famApp hW hm₁ hind₁ _ _)
          obtain ⟨hconst, hxs⟩ := foldApps_const_inj e
          injection hconst with _ hls
          subst hls; subst hxs
          exact .famSpine hm₁ hind₁ h₁ hC hty₁ hty₃
            (.trans _ _ _ _ hc₁ hc₂)
            (eqNList_trans heqN₁ heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype_of_envWfT hW hΓ hm₁ hind₁ hty₁ hty₂ heqN₁ hargs₁ hargs₂)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | @otherSpine Γ A B X X' r args hnot₁ h₁ h₁' hn₁ hn₁' hc₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ _ _ _ _ _ _ _ _ _ =>
          exact (hnot₁ _ hm₂ hind₂).elim
      | otherSpine _ hB hC hY hY' hc₂ =>
          have e := whRedRecKCanon_normal_unique_of_envWfT hW h₁' hn₁' hB hY
          subst e
          exact .otherSpine hnot₁ h₁ hC hn₁ hY' (.trans _ _ _ _ hc₁ hc₂)

/-- Reading off Π domain and codomain `TyConvT` from `LRTypeFamINRKCanon`. -/
theorem lrTypeFamINRKCanon_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeFamINRKCanon E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  cases h with
  | pi h h' _ hdom hcod _ _ =>
      have e₁ := whRedRecKCanon_pi_eq h
      have e₂ := whRedRecKCanon_pi_eq h'
      injection e₁ with eA₁ eB₁
      injection e₂ with eA₂ eB₂
      subst eA₁; subst eB₁; subst eA₂; subst eB₂
      exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

/-- Reading off `eqNList`, equal argument lengths, and `ConvArgsT` from `LRTypeFamINRKCanon` on
    admitted `.inductiveM` family spines. -/
theorem lrTypeFamINRKCanon_famApp_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINRKCanon E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  cases h with
  | famSpine hm' _ hred hred' _ _ _ heqN hlen hlen' hargs =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have e₁ := whRedRecKCanon_famApp_eq hW hm hind hred
      have e₂ := whRedRecKCanon_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs₁⟩ := foldApps_const_inj e₁.symm
      obtain ⟨hconst₂, hxs₂⟩ := foldApps_const_inj e₂.symm
      injection hconst₁ with _ hls₁
      injection hconst₂ with _ hls₂
      subst hls₁; subst hxs₁; subst hls₂; subst hxs₂
      exact ⟨heqN, hlen.trans hlen'.symm, hargs⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

theorem lrTypeFamINRKCanon_famApp_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINRKCanon E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' :=
  relevantSlotConv_of_convArgsT hW hm hind
    (lrTypeFamINRKCanon_famApp_components hW hm hind h).2.2

/-- Soundness-free two-sided `ApproxDIKCanon E Γ` extraction from `LRTypeFamINRKCanon` across all
    `FamProbeCpt E` compacts. -/
theorem approxDIKCanon_of_lrTypeFamINRKCanon_famProbeCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c) (h : LRTypeFamINRKCanon E n Γ A B c) :
    ApproxDIKCanon E Γ A c ∧ ApproxDIKCanon E Γ B c := by
  cases hc with
  | bot => exact ⟨approxDIKCanon_bot E Γ A, approxDIKCanon_bot E Γ B⟩
  | sort =>
      cases h with
      | sort hA hB => exact ⟨⟨_, hA, .sort _ _⟩, ⟨_, hB, .sort _ _⟩⟩
  | pi_bot_nil =>
      cases h with
      | pi hA hB _ _ _ _ _ =>
          exact ⟨⟨_, hA, PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) _ _⟩,
                 ⟨_, hB, PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) _ _⟩⟩
  | famSpine hm hind hlenArgs hbd =>
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' _ _ _ hm' _ hA hB _ _ _ _ hlenA hlenB _ =>
          rw [hm] at hm'
          injection hm' with hm_eq
          subst hm_eq
          have hrig : PiModelDeltaIotaAudit.RigidConst E _ :=
            rigidConst_of_inductiveM hW hm hind
          exact ⟨⟨_, hA, approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls hrig (hlenA.trans hlenArgs.symm) hbd⟩,
                 ⟨_, hB, approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls' hrig (hlenB.trans hlenArgs.symm) hbd⟩⟩
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot _ hm hind).elim

theorem approxDIKCanon_right_of_lrTypeFamINRKCanon_famProbeCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c) (h : LRTypeFamINRKCanon E n Γ A B c) :
    ApproxDIKCanon E Γ B c :=
  (approxDIKCanon_of_lrTypeFamINRKCanon_famProbeCpt hW hc h).2

/-- Bidirectional `BotFamCpt E`-restricted type logical relation over `WhRedRecKCanon` & `ApproxDIKCanon`. -/
def LRTypeFamINBiRKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A A' : Expr Nat) : Prop :=
  ∀ c, BotFamCpt E c →
    (ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c) →
    LRTypeFamINRKCanon E n Γ A A' c

theorem lrTypeFamINBiRKCanon_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (h : LRTypeFamINBiRKCanon E n Γ A A') :
    LRTypeFamINBiRKCanon E n Γ A' A :=
  fun c hc happrox => lrTypeFamINRKCanon_symm_of_envWfT hW hΓ (h c hc happrox.symm)

/-- **Positive Resolution of `W-K-OPEN` (`trueVarSort`, `trueVarPi`, `trueVarFam`) and `W-K-AND`
    (`mixAndRedex`) in `LRTypeFamINRKCanon`:** -/
theorem lrTypeFamINRKCanon_trueVarSort (n : Nat) (c : CptI) (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIKCanon trueEnvU trueVarCtx (.sort .zero) c) :
    LRTypeFamINRKCanon trueEnvU n trueVarCtx (.sort .zero) trueVarSort c ∧
      LRTypeFamINRKCanon trueEnvU n trueVarCtx trueVarSort (.sort .zero) c := by
  have _ := hc
  have hdiag : LRTypeFamINRKCanon trueEnvU n trueVarCtx (.sort .zero) (.sort .zero) c := by
    rcases PiModelDeltaIotaAudit.approxDI_sort_inv
      ((approxDIKCanon_sort_iff trueEnvU trueVarCtx .zero c).mp h) with rfl | rfl
    · exact .bot _ _ _
    · exact .sort (.refl _) (.refl _)
  exact ⟨lrTypeFamINRKCanon_expand (.refl _) whRedRecKCanon_trueVarSort hdiag,
         lrTypeFamINRKCanon_expand whRedRecKCanon_trueVarSort (.refl _) hdiag⟩

theorem lrTypeFamINRKCanon_trueVarPi_left (n : Nat) (c : CptI) (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIKCanon trueEnvU trueVarCtx PiModelDeltaIotaAudit.idPiProp c) :
    LRTypeFamINRKCanon trueEnvU n trueVarCtx PiModelDeltaIotaAudit.idPiProp trueVarPi c ∧
      LRTypeFamINRKCanon trueEnvU n trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp c := by
  have hId : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)
      PiModelDeltaIotaAudit.idPiProp c :=
    (approxDIKCanon_pi_iff trueEnvU trueVarCtx (.sort .zero) (.bvar 0) c).mp h
  have hdiag : LRTypeFamINRKCanon trueEnvU n trueVarCtx
      PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiProp c :=
    lrTypeFamINRKCanon_of_lrTypeFamIN_botFamCpt hc
      (lrTypeFamINBiDI_idPiProp_ctx trueEnvU n (trueVarCtx_wf n) c hc (Or.inl hId))
