/-- **Refutation of One-Step `WhDiamondRecK` in `andEnvU` (`not_whDiamondRecK_andEnvU`):** -/
theorem not_whDiamondRecK_andEnvU :
    ¬ WhDiamondRecK andEnvU 0 mixAndCtx := by
  intro hdiam
  obtain ⟨d, hd1, hd2⟩ := hdiam whStepRecK_andOneStepFam_nf1 whStepRecK_andOneStepFam_nf2
  have e1 := whRedRecK_of_whNormalRecK whNormalRecK_andOneStepFamNF1 hd1
  have e2 := whRedRecK_of_whNormalRecK whNormalRecK_andOneStepFamNF2 hd2
