    ¬ WhConfluentRecK andEnvU 0 mixAndCtx :=
  fun hconf => not_whNormalUniqueRecK_andEnvU_famApp
    (whNormalUniqueRecK_of_whConfluentRecK hconf)


/-! #### Part C — Head-Component Conversion Coherence (`WhPiCohRecK` & `WhFamCohRecK`), Concrete Verification on `(andPiNF1, andPiNF2)` and `(andFamNF1, andFamNF2)`, and Transitivity of `LRTypeFamINRK` Without `NormalUnique` -/

/-- The two proofs `.bvar 1` and `mixProofY2` of `b = .bvar 3` in `mixAndCtx` are convertible
    (`ConvT.irr` or `ConvT.symm` + `ConvT.beta`). -/
noncomputable def convT_mixY_mixProofY2 :
    ConvT andEnvU 0 mixAndCtx (.bvar 1) mixProofY2 (.bvar 3) :=
  .irr mixAndCtx (.bvar 3) (.bvar 1) mixProofY2 mixTyB mixTyY mixTyY2

noncomputable def hasTyT_andConstSortLam :
    HasTyT andEnvU 0 mixAndCtx andConstSortLam (.pi (.bvar 3) (.sort (.succ .zero))) :=
  .lam mixAndCtx (.bvar 3) .zero (.sort .zero) (.sort (.succ .zero))
    mixTyB (.sort _ .zero)

/-- Although `andPiNF1 ≠ andPiNF2`, their domains `.app andConstSortLam (.bvar 1)` and
    `.app andConstSortLam mixProofY2` are `ConvT`-convertible at `.sort (.succ .zero)`! -/
noncomputable def convT_andPiNF1_dom_andPiNF2 :
    ConvT andEnvU 0 mixAndCtx
      (.app andConstSortLam (.bvar 1))
      (.app andConstSortLam mixProofY2)
      (.sort (.succ .zero)) :=
  .app mixAndCtx andConstSortLam andConstSortLam (.bvar 1) mixProofY2
    (.bvar 3) (.sort (.succ .zero))
    (.refl mixAndCtx andConstSortLam _ hasTyT_andConstSortLam)
    convT_mixY_mixProofY2

noncomputable def tyConvT_andPiNF1_dom_andPiNF2 :
    TyConvT andEnvU 0 mixAndCtx
      (.app andConstSortLam (.bvar 1))
      (.app andConstSortLam mixProofY2) :=
  .of _ _ _ _ convT_andPiNF1_dom_andPiNF2

noncomputable def hasTyT_andConstBLam :
    HasTyT andEnvU 0 mixAndCtx andConstBLam (.pi (.bvar 3) (.sort .zero)) :=
  .lam mixAndCtx (.bvar 3) .zero (.bvar 4) (.sort .zero)
    mixTyB (.bvar _ 4 _ rfl)

/-- Although `andFamNF1 ≠ andFamNF2`, their first arguments `.app andConstBLam (.bvar 1)` and
    `.app andConstBLam mixProofY2` are `ConvT`-convertible at `.sort .zero`, and their full argument
    spines satisfy `ConvArgsT`! -/
noncomputable def convT_andFamNF1_arg0_andFamNF2 :
    ConvT andEnvU 0 mixAndCtx
      (.app andConstBLam (.bvar 1))
      (.app andConstBLam mixProofY2)
      (.sort .zero) :=
  .app mixAndCtx andConstBLam andConstBLam (.bvar 1) mixProofY2
    (.bvar 3) (.sort .zero)
    (.refl mixAndCtx andConstBLam _ hasTyT_andConstBLam)
    convT_mixY_mixProofY2

theorem convArgsT_andFamNF1_andFamNF2 :
    ConvArgsT andEnvU 0 mixAndCtx (instantiateLevels [] andFamMember.mtype)
      [.app andConstBLam (.bvar 1), .bvar 3]
      [.app andConstBLam mixProofY2, .bvar 3] :=
  .cons (.sort .zero) (.pi (.sort .zero) (.sort .zero))
    (.app andConstBLam (.bvar 1)) (.app andConstBLam mixProofY2)
    [.bvar 3] [.bvar 3]
    ⟨convT_andFamNF1_arg0_andFamNF2⟩
    (.cons (.sort .zero) (.sort .zero) (.bvar 3) (.bvar 3) [] []
      ⟨.refl mixAndCtx (.bvar 3) (.sort .zero) mixTyB⟩
      (.nil (.sort .zero)))

noncomputable def convT_andFamNF1_andFamNF2 :
    ConvT andEnvU 0 mixAndCtx andFamNF1 andFamNF2 (.sort .zero) :=
  .app mixAndCtx _ _ (.bvar 3) (.bvar 3) (.sort .zero) (.sort .zero)
    (.app mixAndCtx (.const 0 []) (.const 0 [])
      (.app andConstBLam (.bvar 1)) (.app andConstBLam mixProofY2)
      (.sort .zero) (.pi (.sort .zero) (.sort .zero))
      (.refl mixAndCtx (.const 0 []) _ (.const mixAndCtx 0 [] andFamMember rfl rfl rfl))
      convT_andFamNF1_arg0_andFamNF2)
    (.refl mixAndCtx (.bvar 3) (.sort .zero) mixTyB)

noncomputable def tyConvT_andFamNF1_andFamNF2 :
    TyConvT andEnvU 0 mixAndCtx andFamNF1 andFamNF2 :=
  .of _ _ _ _ convT_andFamNF1_andFamNF2

/-- Reflexivity of `ConvArgsT` at `instantiateLevels ls m.mtype` for any sort-typed admitted
    `.inductiveM` family spine of canonical length `xs.length = (piDomsOf m.mtype).length`. -/
theorem convArgs_refl_instMtype {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {w : Level}
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs := by
  have hpiInst := instMtype_policyPi_of_inductiveM hW hm hind ls
  have hlenD : ((piDomsOf m.mtype).map (instantiateLevels ls)).length = xs.length := by
    rw [List.length_map, hlen]
  obtain ⟨⟨_, _, hargsTy, _⟩⟩ := hasTyT_spineInv_rows hW hpi hΓ hm hpiInst xs hlenD hty
  have hslot : RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs := by
    intro i x x' d _ hx hx' hd _ _
    have hxx' : x = x' := Option.some.inj (hx.symm.trans hx')
    subst hxx'
    exact ⟨.refl Γ x (instPrefix ([] ++ xs.take i) d) (hargsTy i x d hx hd)⟩
  exact (convArgsT_iff_relevantSlotConv hW hΓ hpi hm hind (eqNList_refl ls) hlen hlen hty (.refl Γ _)).mpr hslot

/-- **Weak-Head Π-Component Conversion Coherence (`WhPiCohRecK E n`):**
    Even when `WhRedRecK E n Γ` has non-unique normal forms (`¬ WhNormalUniqueRecK`), any two Π
    weak-head reducts `.pi A₁ B₁` and `.pi A₂ B₂` of the **same** expression `B` in a well-formed
    context `Γ` have `TyConvT`-convertible domains and codomains. -/
def WhPiCohRecK (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {B A₁ B₁ A₂ B₂ : Expr Nat},
    WhRedRecK E n Γ B (.pi A₁ B₁) → WhRedRecK E n Γ B (.pi A₂ B₂) →
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)

/-- **Weak-Head Family-Spine Conversion Coherence (`WhFamCohRecK E n`):**
    Even when `WhRedRecK E n Γ` has non-unique normal forms (`¬ WhNormalUniqueRecK`), any two
    admitted `.inductiveM` family-spine weak-head reducts `foldApps (.const r ls₁) xs₁` and
    `foldApps (.const r ls₂) xs₂` of the **same** expression `B` in a well-formed context `Γ`
    are `TyConvT`-convertible with `eqNList ls₁ ls₂` and
    `ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₂`. -/
def WhFamCohRecK (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {r : Nat} {m : CheckedMember},
    E.members r = some m → m.mclass = .inductiveM →
    ∀ {B : Expr Nat} {ls₁ ls₂ : List Level} {xs₁ xs₂ : List (Expr Nat)} {w₁ w₂ : Level},
      WhRedRecK E n Γ B (foldApps (.const r ls₁) xs₁) →
      WhRedRecK E n Γ B (foldApps (.const r ls₂) xs₂) →
      HasTyT E n Γ (foldApps (.const r ls₁) xs₁) (.sort w₁) →
      HasTyT E n Γ (foldApps (.const r ls₂) xs₂) (.sort w₂) →
      xs₁.length = (piDomsOf m.mtype).length →
      xs₂.length = (piDomsOf m.mtype).length →
      Nonempty (TyConvT E n Γ (foldApps (.const r ls₁) xs₁) (foldApps (.const r ls₂) xs₂)) ∧
        eqNList ls₁ ls₂ ∧ ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₂

/-- Whenever `WhNormalUniqueRecK` holds, `WhPiCohRecK` holds trivially by reflexivity. -/
theorem whPiCohRecK_of_whNormalUniqueRecK {E : ResolvedEnv} {n : Nat}
    (huniq : ∀ {Γ : LCtx}, CtxWfT E n Γ → WhNormalUniqueRecK E n Γ) :
    WhPiCohRecK E n := by
  intro Γ hΓ B A₁ B₁ A₂ B₂ h₁ h₂
  have heq := huniq hΓ h₁ (whNormalRecK_pi A₁ B₁) h₂ (whNormalRecK_pi A₂ B₂)
  injection heq with hA hB
  subst hA; subst hB
  exact ⟨⟨.refl Γ A₁⟩, ⟨.refl (.assumption A₁ :: Γ) B₁⟩⟩

/-- Whenever `WhNormalUniqueRecK` holds, `WhFamCohRecK` holds trivially by `convArgs_refl_instMtype`. -/
theorem whFamCohRecK_of_whNormalUniqueRecK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    (huniq : ∀ {Γ : LCtx}, CtxWfT E n Γ → WhNormalUniqueRecK E n Γ) :
    WhFamCohRecK E n := by
  intro Γ hΓ r m hm hind B ls₁ ls₂ xs₁ xs₂ w₁ _ h₁ h₂ hty₁ _ hlen₁ _
  have heq := huniq hΓ h₁ (whNormalRecK_famApp hW hm hind ls₁ xs₁)
    h₂ (whNormalRecK_famApp hW hm hind ls₂ xs₂)
  obtain ⟨hconst, hxs⟩ := foldApps_const_inj heq
  injection hconst with _ hls
  subst hls; subst hxs
  exact ⟨⟨.refl Γ _⟩, eqNList_refl ls₁, convArgs_refl_instMtype hW hpi hΓ hm hind hlen₁ hty₁⟩

/-- Unconditional transitivity of `LRTypeFamINRK` at `.sort` (needs **no** coherence or uniqueness
    premise at all). -/
theorem lrTypeFamINRK_trans_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B C : Expr Nat}
    (h₁ : LRTypeFamINRK E n Γ A B .sort) (h₂ : LRTypeFamINRK E n Γ B C .sort) :
    LRTypeFamINRK E n Γ A C .sort := by
  cases h₁ with
  | sort hA _ =>
      cases h₂ with
      | sort _ hC => exact .sort hA hC

/-- **Transitivity of `LRTypeFamINRK` at `.pi .bot []` Under `WhPiCohRecK` Alone
    (`lrTypeFamINRK_trans_pi_bot_nil_of_coh`):**
    Replaces `WhNormalUniqueRecK` by `WhPiCohRecK E n`: if `B` weak-head reduces to `.pi A₂ B₂` in
    `h₁` and to `.pi A₂' B₂'` in `h₂`, `WhPiCohRecK` supplies `TyConvT E n Γ A₂ A₂'` and
    `TyConvT E n (.assumption A₂ :: Γ) B₂ B₂'`, which compose with `(hdom₁, hcod₁)` and
    `(hdom₂, hcod₂)` via `tyConvT_assump_dom`! -/
theorem lrTypeFamINRK_trans_pi_bot_nil_of_coh {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcoh : WhPiCohRecK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat}
    (h₁ : LRTypeFamINRK E n Γ A B (.pi .bot []))
    (h₂ : LRTypeFamINRK E n Γ B C (.pi .bot [])) :
    LRTypeFamINRK E n Γ A C (.pi .bot []) := by
  cases h₁ with
  | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ hA hB₁ hΓ₁ hdom₁ hcod₁ _ _ =>
      cases h₂ with
      | @pi _ _ _ A₂' B₂' A₃ B₃ _ _ hB₂ hC _ hdom₂ hcod₂ _ _ =>
          obtain ⟨⟨hdomM⟩, ⟨hcodM⟩⟩ := hcoh hΓ hB₁ hB₂
          have hdom₁' : TyConvT E n Γ A₁ A₂' := .trans _ _ _ _ hdom₁ hdomM
          have hcod₁' : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂' :=
            .trans _ _ _ _ hcod₁ (tyConvT_assump_dom hW hΓ hdom₁ hcodM)
          exact .pi hA hC hΓ₁
            (.trans _ _ _ _ hdom₁' hdom₂)
            (.trans _ _ _ _ hcod₁' (tyConvT_assump_dom hW hΓ hdom₁' hcod₂))
            (.bot _ _ _)
            (fun _ hs => (List.not_mem_nil _ hs).elim)

/-- **Transitivity of `LRTypeFamINRK` at `.spine r args ∈ BotFamCpt E` Under `WhFamCohRecK`
    (`lrTypeFamINRK_trans_famSpine_of_coh`):**
    Replaces `WhNormalUniqueRecK` by `WhFamCohRecK E n`: if `B` weak-head reduces to
    `foldApps (.const r ls₂) xs₂` in `h₁` and to `foldApps (.const r ls₂') xs₂'` in `h₂`,
    `WhFamCohRecK` supplies `TyConvT`, `eqNList ls₂ ls₂'`, and `ConvArgsT` between `xs₂` and `xs₂'`,
    which compose with `hargs₁` and `hargs₂` via `convArgs_trans_instMtype`! -/
theorem lrTypeFamINRK_trans_famSpine_of_coh {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n) (hcoh : WhFamCohRecK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat} {r : Nat} {args : List CptI}
    (hcpt : BotFamCpt E (.spine r args))
    (h₁ : LRTypeFamINRK E n Γ A B (.spine r args))
    (h₂ : LRTypeFamINRK E n Γ B C (.spine r args)) :
    LRTypeFamINRK E n Γ A C (.spine r args) := by
  cases h₁ with
  | @famSpine _ _ _ _ m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ _ hm₁ hind₁ hA hB₁ hty₁ hty₂ hc₁ heqN₁ hlen₁ hlen₂ hargs₁ =>
      cases h₂ with
      | @famSpine _ _ _ _ m₂ ls₂' ls₃ xs₂' xs₃ w₂' w₃ _ hm₂ _ hB₂ hC hty₂' hty₃ hc₂ heqN₂ hlen₂' hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          obtain ⟨⟨hcM⟩, heqNM, hargsM⟩ := hcoh hΓ hm₁ hind₁ hB₁ hB₂ hty₂ hty₂' hlen₂ hlen₂'
          have heqN₁' : eqNList ls₁ ls₂' := eqNList_trans heqN₁ heqNM
          have hargs₁' : ConvArgsT E n Γ (instantiateLevels ls₁ m₁.mtype) xs₁ xs₂' :=
            convArgs_trans_instMtype hW hpi hΓ hm₁ hty₁ hty₂ heqN₁ hargs₁ hargsM
          exact .famSpine hm₁ hind₁ hA hC hty₁ hty₃
            (.trans _ _ _ _ (.trans _ _ _ _ hc₁ hcM) hc₂)
            (eqNList_trans heqN₁' heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype hW hpi hΓ hm₁ hty₁ hty₂' heqN₁' hargs₁' hargs₂)
      | otherSpine hnot _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | otherSpine hnot _ _ _ =>
      cases hcpt with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim


/-! #### Part D — Flat Probe Compact Fragment (`FamProbeCpt E`), Unconditional Two-Sided `ApproxDIK` Extraction, Single-Link `LRTypeFamINRK` Constructors, and `FundamentalLRFamINProbeRK` Chain-from-Links Assembly Without `NormalUnique` -/

/-- **Flat Probe Compact Fragment (`FamProbeCpt E`):**
    The exact set of compacts needed to discharge `PiRowField`, `not_tyConvT_pi_sort`,
    `not_tyConvT_sort_pi`, `famApp_saturated`, `FamAppRowLink`, `FamRelevantSlotConv`, and
    `TypedRowsWf`:
    - `.bot`
    - `.sort`
    - `.pi .bot []`
    - `.spine r args` for an admitted `.inductiveM` family `r` with `args.length = (piDomsOf m.mtype).length`
      and `BotDemand args`.
    Unlike arbitrary nested `.pi a f ∈ BotFamCpt E` with `f ≠ []`, `FamProbeCpt E` has
    **unconditional** two-sided `ApproxDIK E n Γ` extraction (`approxDIK_of_lrTypeFamINRK_famProbeCpt`)
    with zero binder-commutation hypotheses! -/
inductive FamProbeCpt (E : ResolvedEnv) : CptI → Prop
  | bot : FamProbeCpt E .bot
  | sort : FamProbeCpt E .sort
  | pi_bot_nil : FamProbeCpt E (.pi .bot [])
  | famSpine {r : Nat} {m : CheckedMember} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (hlen : args.length = (piDomsOf m.mtype).length)
      (hbd : PiModelDeltaIotaAudit.BotDemand args) :
      FamProbeCpt E (.spine r args)

/-- Every `FamProbeCpt E c` is a `BotFamCpt E c`. -/
theorem botFamCpt_of_famProbeCpt {E : ResolvedEnv} {c : CptI}
    (hc : FamProbeCpt E c) : BotFamCpt E c := by
  cases hc with
  | bot => exact .bot
  | sort => exact .sort
  | pi_bot_nil => exact botFamCpt_pi_bot_nil E
  | famSpine hm hind hlen hbd => exact .famSpine hm hind hlen hbd

theorem famProbeCpt_famSpine_botVecI {E : ResolvedEnv} {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} (hlen : xs.length = (piDomsOf m.mtype).length) :
    FamProbeCpt E (.spine r (botVecI xs)) :=
  .famSpine hm hind ((botVecI_length xs).trans hlen) (botDemand_botVecI xs)

/-- **Unconditional Two-Sided `ApproxDIK E n Γ` Extraction on `FamProbeCpt E`
    (`approxDIK_of_lrTypeFamINRK_famProbeCpt`):**
    At every `EnvWfT E` and `FamProbeCpt E c`, `LRTypeFamINRK E n Γ A B c` implies both
    `ApproxDIK E n Γ A c` and `ApproxDIK E n Γ B c` with **zero** `WhDet`, `WhNormalUnique`, or
    binder-commutation hypotheses! -/
theorem approxDIK_of_lrTypeFamINRK_famProbeCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c) (h : LRTypeFamINRK E n Γ A B c) :
    ApproxDIK E n Γ A c ∧ ApproxDIK E n Γ B c := by
  cases hc with
  | bot => exact ⟨approxDIK_bot E n Γ A, approxDIK_bot E n Γ B⟩
  | sort => exact approxDIK_sort_of_lrTypeFamINRK h
  | pi_bot_nil => exact approxDIK_pi_bot_nil_of_lrTypeFamINRK h
  | famSpine hm hind hlen hbd =>
      exact approxDIK_famSpine_of_lrTypeFamINRK hW (.famSpine hm hind hlen hbd) h

theorem approxDIK_right_of_lrTypeFamINRK_famProbeCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c) (h : LRTypeFamINRK E n Γ A B c) :
    ApproxDIK E n Γ B c :=
  (approxDIK_of_lrTypeFamINRK_famProbeCpt hW hc h).2

/-- **Transitivity of `LRTypeFamINRK` Across `FamProbeCpt E` Under `WhPiCohRecK` & `WhFamCohRecK`
    (`lrTypeFamINRK_trans_famProbeCpt_of_coh`):**
    Proves transitivity of `LRTypeFamINRK E n Γ A B c` across **every** `FamProbeCpt E c` compact
    without `WhNormalUniqueRecK` or `WhDetRecK`! -/
theorem lrTypeFamINRK_trans_famProbeCpt_of_coh {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    (hpiCoh : WhPiCohRecK E n) (hfamCoh : WhFamCohRecK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat} {c : CptI}
    (hc : FamProbeCpt E c)
    (h₁ : LRTypeFamINRK E n Γ A B c) (h₂ : LRTypeFamINRK E n Γ B C c) :
    LRTypeFamINRK E n Γ A C c := by
  cases hc with
  | bot => exact .bot Γ A C
  | sort => exact lrTypeFamINRK_trans_sort h₁ h₂
  | pi_bot_nil => exact lrTypeFamINRK_trans_pi_bot_nil_of_coh hW hpiCoh hΓ h₁ h₂
  | famSpine hm hind hlen hbd =>
      exact lrTypeFamINRK_trans_famSpine_of_coh hW hpi hfamCoh hΓ
        (.famSpine hm hind hlen hbd) h₁ h₂

/-- **Flat Probe Type Fundamental Property (`FundamentalLRFamINProbeRK E n`):**
    Restricts `FundamentalLRFamINBotRK E n` to `FamProbeCpt E c`. -/
def FundamentalLRFamINProbeRK (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, FamProbeCpt E c → ApproxDIK E n Γ A c →
      LRTypeFamINRK E n Γ A A' c

/-- `FundamentalLRFamINBotRK E n` implies `FundamentalLRFamINProbeRK E n`. -/
theorem fundamentalLRFamINProbeRK_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRFamINBotRK E n) : FundamentalLRFamINProbeRK E n := by
  intro Γ hΓ A A' u hA hc c hcpt happrox
  exact F hΓ hA hc c (botFamCpt_of_famProbeCpt hcpt) happrox

/-- **Chain-from-Links Assembly of `FundamentalLRFamINProbeRK E n` Without `NormalUnique`
    (`fundamentalLRFamINProbeRK_of_links_coh`):**
    Reduces `FundamentalLRFamINProbeRK E n` along arbitrary `TyConvT` chains (`refl`, `of`, `trans`)
    to its diagonal (`hdiag`) and single-link `ConvT` (`hlink`) cases under `EnvWfT E`,
    `WhPiCohRecK E n`, and `WhFamCohRecK E n` — deriving `PiRowField E n` internally at
    `c = .pi .bot []` and using `approxDIK_right_of_lrTypeFamINRK_famProbeCpt` to propagate the
    `ApproxDIK` probe across intermediate `TyConvT.trans` nodes! -/
theorem fundamentalLRFamINProbeRK_of_links_coh {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpiCoh : WhPiCohRecK E n) (hfamCoh : WhFamCohRecK E n)
    (hdiag : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      ∀ c, FamProbeCpt E c → ApproxDIK E n Γ A c →
        LRTypeFamINRK E n Γ A A c)
    (hlink : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A B : Expr Nat} {u : Level},
      ConvT E n Γ A B (.sort u) →
      ∀ c, FamProbeCpt E c → ApproxDIK E n Γ A c →
        LRTypeFamINRK E n Γ A B c) :
    FundamentalLRFamINProbeRK E n := by
  have hpiChain : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
      ApproxDIK E n Γ A (.pi .bot []) →
      LRTypeFamINRK E n Γ A A' (.pi .bot []) := by
    intro Γ hΓ A A' u hA hc
    revert u
    induction hc with
    | refl A =>
        intro u hA hcA
        exact hdiag hΓ hA (.pi .bot []) .pi_bot_nil hcA
    | of A B v hc =>
        intro _ _ hcA
        exact hlink hΓ hc (.pi .bot []) .pi_bot_nil hcA
    | trans A M B c₁ c₂ ih₁ ih₂ =>
        intro u hA hcA
        obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
        have r₁ := ih₁ hA hcA
        have hcM := (approxDIK_pi_bot_nil_of_lrTypeFamINRK r₁).2
        exact lrTypeFamINRK_trans_pi_bot_nil_of_coh hW hpiCoh hΓ r₁ (ih₂ hM hcM)
  have hpi : PiRowField E n := by
    intro Γ hΓ A B A' B' hc
    rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
    · injection heq with hA hB
      subst hA; subst hB
      exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
    · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
      exact lrTypeFamINRK_pi_components
        (hpiChain hΓ hPi hc (approxDIK_pi_bot_nil E n Γ A B))
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A => intro u hA c hcpt hcA; exact hdiag hΓ hA c hcpt hcA
  | of A B v hc => intro _ _ c hcpt hcA; exact hlink hΓ hc c hcpt hcA
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxDIK_right_of_lrTypeFamINRK_famProbeCpt hW hcpt r₁
      exact lrTypeFamINRK_trans_famProbeCpt_of_coh hW hpi hpiCoh hfamCoh hΓ hcpt r₁ (ih₂ hM c hcpt hcM)

