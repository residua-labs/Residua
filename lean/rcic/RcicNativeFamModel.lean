    ∀ u, ApproxI (ctxEnvI Γ) (.app R h) u →
      LRTermFamIN E n Γ (.app R h) m₀ (foldApps (.const r ls) xs) u :=
  fundConvFamIN_irr_famApp hW hm hind hP (.app R h) m₀

/-- **Unconditional Term-Level η-K at Any Π-Proposition `.pi A B` (`fundConvFamIN_etaK_pi`):**
    For any `f` and `.lam A (lift 0 1 x)` at a `.sort .zero`-typed Π-proposition `.pi A B`,
    `LRTermFamIN E n Γ f (.lam A (lift 0 1 x)) (.pi A B) u` holds unconditionally at every `u`. -/
theorem fundConvFamIN_etaK_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (hP : HasTyT E n Γ (.pi A B) (.sort .zero)) (f x : Expr Nat) :
    ∀ u, ApproxI (ctxEnvI Γ) f u →
