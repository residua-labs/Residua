theorem whRedRecKCanon_famApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {X : Expr Nat}
    (h : WhRedRecKCanon E Γ (foldApps (.const r ls) xs) X) :
    X = foldApps (.const r ls) xs := by
