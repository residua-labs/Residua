/-- **Model Family-Head & Arity Injectivity in `SemEqDIK` (`semEqDIK_famApp_head_length`):**
    Under `EnvWfT E`, for any admitted `.inductiveM` family heads `r` and `r'`, `SemEqDIK` of two
    family spines implies `r = r' ∧ xs.length = xs'.length`. -/
theorem semEqDIK_famApp_head_length {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {r r' : Nat} {m m' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (h : SemEqDIK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length :=
  semEqDI_famApp_head_length
    (rigidConst_of_inductiveM hW hm hind)
    (rigidConst_of_inductiveM hW hm' hind')
    (fun c => (approxDIK_famApp_iff hW n Γ hm hind ls xs c).symm.trans
      ((h c).trans (approxDIK_famApp_iff hW n Γ hm' hind' ls' xs' c)))

/-- **Model Family-Slot Injectivity in `SemEqDIK` (`semEqDIK_famApp_slot`):** -/
theorem semEqDIK_famApp_slot {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {r r' : Nat} {m m' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (h : SemEqDIK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs'))
    {i : Nat} (hi : i < xs.length) :
    PiModelDeltaIotaAudit.SemEqDI E (ctxEnvDI E Γ)
      (xs.getD i (.bvar 0)) (xs'.getD i (.bvar 0)) :=
  semEqDI_famApp_slot
    (rigidConst_of_inductiveM hW hm hind)
    (rigidConst_of_inductiveM hW hm' hind')
    (fun c => (approxDIK_famApp_iff hW n Γ hm hind ls xs c).symm.trans
      ((h c).trans (approxDIK_famApp_iff hW n Γ hm' hind' ls' xs' c)))
    hi

/-- Combined family-head, length, and slotwise injectivity in `SemEqDIK`. -/
theorem semEqDIK_famApp_inj {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {r r' : Nat} {m m' : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (h : SemEqDIK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat), i < xs.length →
        PiModelDeltaIotaAudit.SemEqDI E (ctxEnvDI E Γ)
          (xs.getD i (.bvar 0)) (xs'.getD i (.bvar 0)) :=
  ⟨(semEqDIK_famApp_head_length hW hm hind hm' hind' h).1,
   (semEqDIK_famApp_head_length hW hm hind hm' hind' h).2,
   fun _ hi => semEqDIK_famApp_slot hW hm hind hm' hind' h hi⟩

/-- Disjointness of `.pi A B` and an admitted `.inductiveM` family spine in `SemEqDIK`. -/
theorem semEqDIK_pi_famApp_disjoint {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (h : SemEqDIK E n Γ (.pi A B) (foldApps (.const r ls) xs)) : False :=
  semEqDI_pi_famApp_disjoint (rigidConst_of_inductiveM hW hm hind)
    (fun c => (approxDIK_pi_iff E n Γ A B c).symm.trans
      ((h c).trans (approxDIK_famApp_iff hW n Γ hm hind ls xs c)))

/-- Disjointness of `.sort u` and an admitted `.inductiveM` family spine in `SemEqDIK`. -/
theorem semEqDIK_sort_famApp_disjoint {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {u : Level} {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (h : SemEqDIK E n Γ (.sort u) (foldApps (.const r ls) xs)) : False :=
  semEqDI_sort_famApp_disjoint (rigidConst_of_inductiveM hW hm hind)
    (fun c => (approxDIK_sort_iff E n Γ u c).symm.trans
      ((h c).trans (approxDIK_famApp_iff hW n Γ hm hind ls xs c)))

/-- **Positive Resolution of the `ApproxDI` Model Obstruction (`approxDIK_trueRecVar`):**
    Whereas `ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) (trueRecVar u motive minor)` collapsed
    to `{.bot}` (`approxDI_trueRecVar_eq_bot`), in `ApproxDIK` every compact of `minor` is a compact
    of `trueRecVar u motive minor`! -/
theorem approxDIK_trueRecVar {n : Nat} {u : Level} {motive minor : Expr Nat} {c : CptI}
    (h : ApproxDIK trueEnvU n trueVarCtx minor c) :
    ApproxDIK trueEnvU n trueVarCtx (trueRecVar u motive minor) c :=
  approxDIK_of_whRedRecK (whRedRecK_trueRecVar n u motive minor) h

theorem approxDIK_trueVarSort (n : Nat) :
    ApproxDIK trueEnvU n trueVarCtx trueVarSort .sort :=
  approxDIK_trueRecVar (approxDIK_sort trueEnvU n trueVarCtx .zero)

theorem approxDIK_trueVarPi (n : Nat) :
    ApproxDIK trueEnvU n trueVarCtx trueVarPi (.pi .bot []) :=
  approxDIK_trueRecVar (approxDIK_pi_bot_nil trueEnvU n trueVarCtx (.sort .zero) (.bvar 0))

theorem approxDIK_trueVarFam (n : Nat) :
    ApproxDIK trueEnvU n trueVarCtx trueVarFam (.spine 0 []) :=
  approxDIK_trueRecVar
    (approxDIK_famApp_botVecI_of_inductiveM trueEnvUWfT n trueVarCtx
      (r := 0) (m := trueFamMember) rfl rfl [] [])

theorem approxDIK_trueIotaMajorSort (n : Nat) (Γ : LCtx) :
    ApproxDIK trueEnvU n Γ trueIotaMajorSort .sort :=
  approxDIK_of_approxDI (approxDI_trueIotaMajorSort (ctxEnvDI trueEnvU Γ))

theorem approxDIK_trueIotaMajorPi (n : Nat) (Γ : LCtx) :
    ApproxDIK trueEnvU n Γ trueIotaMajorPi (.pi .bot []) :=
  approxDIK_of_approxDI (approxDI_trueIotaMajorPi (ctxEnvDI trueEnvU Γ))

theorem approxDIK_trueIotaMajorFam (n : Nat) (Γ : LCtx) :
    ApproxDIK trueEnvU n Γ trueIotaMajorFam (.spine 0 []) :=
  approxDIK_of_approxDI (approxDI_trueIotaMajorFam (ctxEnvDI trueEnvU Γ))


/-! #### Part D — Repaired K + Recursor-Major Family & Term Logical Relations (`LRTypeFamINRK`, `LRTypeFamINBiRK`, `LRTermFamINDRK`, `FundamentalLRFamINBotRK`, `FundamentalTermFamINDBotRK`), Positive Resolution of `W-K-OPEN` (`trueVarSort`, `trueVarPi`, `trueVarFam`) and `W-IOTA-MAJOR`, and Downstream `piRow` / `famAppRow` / `FamRelevantSlotConv` / `TypedRowsWf` Consumers -/

/-- **K + Recursor-Major Family Type Logical Relation (`LRTypeFamINRK E n`):**
    Extends §13's `LRTypeFamINR` by reading back along `WhRedRecK E n Γ` (and dropping the
    `WhNormal` requirement on `.otherSpine`, which is never entered on `BotFamCpt E`). -/
inductive LRTypeFamINRK (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeFamINRK E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedRecK E n Γ A (.sort u)) (h' : WhRedRecK E n Γ A' (.sort u')) :
      LRTypeFamINRK E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedRecK E n Γ A (.pi A₁ B₁)) (h' : WhRedRecK E n Γ A' (.pi A₂ B₂))
      (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeFamINRK E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, LRTypeFamINRK E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeFamINRK E n Γ A A' (.pi a f)
  | famSpine {Γ : LCtx} {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (h : WhRedRecK E n Γ A (foldApps (.const r ls) xs))
      (h' : WhRedRecK E n Γ A' (foldApps (.const r ls') xs'))
      (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
      (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
      (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = (piDomsOf m.mtype).length)
      (hlen' : xs'.length = (piDomsOf m.mtype).length)
      (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
      LRTypeFamINRK E n Γ A A' (.spine r args)
  | otherSpine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
      (h : WhRedRecK E n Γ A X) (h' : WhRedRecK E n Γ A' X')
      (hc : TyConvT E n Γ X X') :
      LRTypeFamINRK E n Γ A A' (.spine r args)

/-- Closure of `LRTypeFamINRK` under `WhRedRecK E n Γ` expansion on both sides. -/
theorem lrTypeFamINRK_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A A' X X' : Expr Nat}
    {c : CptI} (hX : WhRedRecK E n Γ A X) (hX' : WhRedRecK E n Γ A' X')
    (h : LRTypeFamINRK E n Γ X X' c) : LRTypeFamINRK E n Γ A A' c := by
  cases h with
  | bot => exact .bot Γ A A'
  | sort h₁ h₂ => exact .sort (whRedRecK_trans hX h₁) (whRedRecK_trans hX' h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod ra rf =>
      exact .pi (whRedRecK_trans hX h₁) (whRedRecK_trans hX' h₂) hΓ₁ hdom hcod ra rf
  | famSpine hm hind h₁ h₂ hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedRecK_trans hX h₁) (whRedRecK_trans hX' h₂)
        hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h₁ h₂ hc =>
      exact .otherSpine hnot (whRedRecK_trans hX h₁) (whRedRecK_trans hX' h₂) hc

/-- **Lifting Theorem (`lrTypeFamINRK_of_lrTypeFamINR`):**
    Every `LRTypeFamINR E n Γ A A' c` derivation is an `LRTypeFamINRK E n Γ A A' c` derivation. -/
theorem lrTypeFamINRK_of_lrTypeFamINR {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (h : LRTypeFamINR E n Γ A A' c) :
    LRTypeFamINRK E n Γ A A' c := by
  induction h with
  | bot Γ B B' => exact .bot Γ B B'
  | sort h₁ h₂ =>
      exact .sort (whRedRecCtx_to_whRedRecK h₁) (whRedRecCtx_to_whRedRecK h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod _ _ iha ihf =>
      exact .pi (whRedRecCtx_to_whRedRecK h₁) (whRedRecCtx_to_whRedRecK h₂)
        hΓ₁ hdom hcod iha ihf
  | famSpine hm hind h₁ h₂ hty hty' hconv heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedRecCtx_to_whRedRecK h₁) (whRedRecCtx_to_whRedRecK h₂)
        hty hty' hconv heqN hlen hlen' hargs
  | otherSpine hnot h₁ h₂ _ _ hc =>
      exact .otherSpine hnot (whRedRecCtx_to_whRedRecK h₁) (whRedRecCtx_to_whRedRecK h₂) hc

theorem lrTypeFamINRK_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamINRK E n Γ A A' c :=
  lrTypeFamINRK_of_lrTypeFamINR (lrTypeFamINR_of_lrTypeFamIN_botFamCpt hc h)

/-- Context transport of `LRTypeFamINRK` across `CtxConvT E n Γ Γ'` and `CtxSameValues Γ Γ'` under `EnvClosed E`. -/
theorem lrTypeFamINRK_ctx_sameValues {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ') (hΓ' : CtxWfT E n Γ')
    {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINRK E n Γ A A' c) : LRTypeFamINRK E n Γ' A A' c := by
  induction h generalizing Γ' with
  | bot => exact .bot _ _ _
  | sort h h' =>
      exact .sort (whRedRecK_ctx_sameValues hcl hctx hval h)
        (whRedRecK_ctx_sameValues hcl hctx hval h')
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u _ hA₁ =>
          have hA₁' : HasTyT E n Γ' A₁ (.sort u) := hasTyT_ctx hcl hctx hA₁
          have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ') := .assumption Γ' A₁ u hΓ' hA₁'
          exact .pi (whRedRecK_ctx_sameValues hcl hctx hval h)
            (whRedRecK_ctx_sameValues hcl hctx hval h')
            hΓ₁' (tyConvT_ctx hcl hctx hdom)
            (tyConvT_ctx hcl (.same (.assumption A₁) hctx) hcod)
            (iha hctx hval hΓ')
            (fun s hs => ihf s hs (.same (.assumption A₁) hctx)
              (ctxSameValues_same (.assumption A₁) hval) hΓ₁')
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind
        (whRedRecK_ctx_sameValues hcl hctx hval h)
        (whRedRecK_ctx_sameValues hcl hctx hval h')
        (hasTyT_ctx hcl hctx hty) (hasTyT_ctx hcl hctx hty')
        (tyConvT_ctx hcl hctx hc) heqN hlen hlen'
        (convArgsT_ctx hcl hctx hargs)
  | otherSpine hnot h h' hc =>
      exact .otherSpine hnot
        (whRedRecK_ctx_sameValues hcl hctx hval h)
        (whRedRecK_ctx_sameValues hcl hctx hval h')
        (tyConvT_ctx hcl hctx hc)

theorem lrTypeFamINRK_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {B B' : Expr Nat} {c : CptI},
      LRTypeFamINRK E n (.assumption A₂ :: Γ) B B' c →
      LRTypeFamINRK E n (.assumption A₁ :: Γ) B B' c
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, hA₁, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTypeFamINRK_ctx_sameValues hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (ctxSameValues_assumption A₂ A₁ (ctxSameValues_refl Γ))
        (.assumption Γ A₁ _ hΓ hA₁) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      lrTypeFamINRK_assump_dom hcl hW hΓ c₁ hA₁ (lrTypeFamINRK_assump_dom hcl hW hΓ c₂ hM h)

/-- **Symmetry of `LRTypeFamINRK` (`lrTypeFamINRK_symm`):**
    Holds at every `EnvWfT E` and `PiRowField E n` (requiring **zero** `WhDet` or confluence
    hypotheses!). -/
theorem lrTypeFamINRK_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINRK E n Γ A A' c) :
    LRTypeFamINRK E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamINRK_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype hW hpi hΓ hm hind hty hty' heqN hlen hlen' hargs)
  | otherSpine hnot h h' hc =>
      exact .otherSpine hnot h' h hc.symmT

/-- Reading off Π domain and codomain `TyConvT` from `LRTypeFamINRK E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])`. -/
theorem lrTypeFamINRK_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeFamINRK E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  cases h with
  | pi h h' _ hdom hcod _ _ =>
      have e₁ := whRedRecK_pi_eq h
      have e₂ := whRedRecK_pi_eq h'
      injection e₁ with eA₁ eB₁
      injection e₂ with eA₂ eB₂
      subst eA₁; subst eB₁; subst eA₂; subst eB₂
      exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

/-- Reading off `eqNList`, equal argument lengths, and `ConvArgsT` from `LRTypeFamINRK` on admitted
    `.inductiveM` family spines. -/
theorem lrTypeFamINRK_famApp_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINRK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  cases h with
  | famSpine hm' _ hred hred' _ _ _ heqN hlen hlen' hargs =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have e₁ := whRedRecK_famApp_eq hW hm hind hred
      have e₂ := whRedRecK_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs₁⟩ := foldApps_const_inj e₁.symm
      obtain ⟨hconst₂, hxs₂⟩ := foldApps_const_inj e₂.symm
      injection hconst₁ with _ hls₁
      injection hconst₂ with _ hls₂
      subst hls₁; subst hxs₁; subst hls₂; subst hxs₂
      exact ⟨heqN, hlen.trans hlen'.symm, hargs⟩
  | otherSpine hnot _ _ _ =>
      exact (hnot m hm hind).elim

/-- Reading `LRTypeFamINRK` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    yields `RelevantSlotConv` (#7525). -/
theorem lrTypeFamINRK_famApp_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINRK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' :=
  relevantSlotConv_of_convArgsT hW hm hind
    (lrTypeFamINRK_famApp_components hW hm hind h).2.2

/-- Soundness-free two-sided `ApproxDIK E n Γ` extraction from `LRTypeFamINRK` at `.sort`,
    `.pi .bot []`, and `.spine r args ∈ BotFamCpt E` (directly from the `WhRedRecK` witnesses!). -/
theorem approxDIK_sort_of_lrTypeFamINRK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (h : LRTypeFamINRK E n Γ A B .sort) :
    ApproxDIK E n Γ A .sort ∧ ApproxDIK E n Γ B .sort := by
  cases h with
  | sort hA hB => exact ⟨⟨_, hA, .sort _ _⟩, ⟨_, hB, .sort _ _⟩⟩

theorem approxDIK_pi_bot_nil_of_lrTypeFamINRK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (h : LRTypeFamINRK E n Γ A B (.pi .bot [])) :
    ApproxDIK E n Γ A (.pi .bot []) ∧ ApproxDIK E n Γ B (.pi .bot []) := by
  cases h with
  | pi hA hB _ _ _ _ _ =>
      exact ⟨⟨_, hA, PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) _ _⟩,
             ⟨_, hB, PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) _ _⟩⟩

theorem approxDIK_famSpine_of_lrTypeFamINRK {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {r : Nat} {args : List CptI}
    (hc : BotFamCpt E (.spine r args))
    (h : LRTypeFamINRK E n Γ A B (.spine r args)) :
    ApproxDIK E n Γ A (.spine r args) ∧ ApproxDIK E n Γ B (.spine r args) := by
  cases h with
  | @famSpine _ _ _ _ m' ls ls' xs xs' _ _ _ hm' hind' hA hB _ _ _ _ hlenA hlenB _ =>
      cases hc with
      | famSpine hm _ hlenArgs hbd =>
          rw [hm] at hm'
          injection hm' with hm_eq
          subst hm_eq
          have hrig : PiModelDeltaIotaAudit.RigidConst E r :=
            rigidConst_of_inductiveM hW hm hind'
          exact ⟨⟨_, hA, approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls hrig (hlenA.trans hlenArgs.symm) hbd⟩,
                 ⟨_, hB, approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls' hrig (hlenB.trans hlenArgs.symm) hbd⟩⟩
  | otherSpine hnot _ _ _ =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- **Bidirectional `BotFamCpt E`-Restricted Type Logical Relation Over `WhRedRecK` & `ApproxDIK` (`LRTypeFamINBiRK`):** -/
def LRTypeFamINBiRK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A A' : Expr Nat) : Prop :=
  ∀ c, BotFamCpt E c →
    (ApproxDIK E n Γ A c ∨ ApproxDIK E n Γ A' c) →
    LRTypeFamINRK E n Γ A A' c

/-- Symmetry of `LRTypeFamINBiRK` under `EnvWfT E` and `PiRowField E n` (with **zero** `WhDet` hypotheses). -/
theorem lrTypeFamINBiRK_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A' : Expr Nat} (h : LRTypeFamINBiRK E n Γ A A') :
    LRTypeFamINBiRK E n Γ A' A :=
  fun c hc happrox => lrTypeFamINRK_symm hW hpi hΓ (h c hc happrox.symm)

/-- **Positive Resolution of `W-K-OPEN` in `LRTypeFamINRK` (`lrTypeFamINBiRK_trueVarSort`, `lrTypeFamINRK_trueVarPi_left`, `lrTypeFamINRK_trueVarFam_left`):**
    Whereas §13's `LRTypeFamINR` / `LRTypeFamINBiR` was refuted on `trueVarSort`, `trueVarPi`, and
    `trueVarFam` in `trueVarCtx`, `LRTypeFamINRK` holds in **both** directions across all
    `BotFamCpt trueEnvU` compacts! -/
theorem lrTypeFamINBiRK_trueVarSort (n : Nat) (c : CptI) (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx (.sort .zero) c) :
    LRTypeFamINRK trueEnvU n trueVarCtx (.sort .zero) trueVarSort c ∧
      LRTypeFamINRK trueEnvU n trueVarCtx trueVarSort (.sort .zero) c := by
  have _ := hc
  have hdiag : LRTypeFamINRK trueEnvU n trueVarCtx (.sort .zero) (.sort .zero) c := by
    rcases PiModelDeltaIotaAudit.approxDI_sort_inv
      ((approxDIK_sort_iff trueEnvU n trueVarCtx .zero c).mp h) with rfl | rfl
    · exact .bot _ _ _
    · exact .sort (.refl _) (.refl _)
  exact ⟨lrTypeFamINRK_expand (.refl _) (whRedRecK_trueVarSort n) hdiag,
         lrTypeFamINRK_expand (whRedRecK_trueVarSort n) (.refl _) hdiag⟩

/-- Positive satisfaction on `trueVarPi` and `trueVarFam` in `LRTypeFamINRK` across
    all `BotFamCpt trueEnvU` compacts of the left-hand type! -/
theorem lrTypeFamINRK_trueVarPi_left (n : Nat) (c : CptI) (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx PiModelDeltaIotaAudit.idPiProp c) :
    LRTypeFamINRK trueEnvU n trueVarCtx PiModelDeltaIotaAudit.idPiProp trueVarPi c ∧
      LRTypeFamINRK trueEnvU n trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp c := by
  have hId : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)
      PiModelDeltaIotaAudit.idPiProp c :=
    (approxDIK_pi_iff trueEnvU n trueVarCtx (.sort .zero) (.bvar 0) c).mp h
  have hdiag : LRTypeFamINRK trueEnvU n trueVarCtx
      PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiProp c :=
    lrTypeFamINRK_of_lrTypeFamIN_botFamCpt hc
      (lrTypeFamINBiDI_idPiProp_ctx trueEnvU n (trueVarCtx_wf n) c hc (Or.inl hId))
  exact ⟨lrTypeFamINRK_expand (.refl _) (whRedRecK_trueVarPi n) hdiag,
         lrTypeFamINRK_expand (whRedRecK_trueVarPi n) (.refl _) hdiag⟩

theorem lrTypeFamINRK_trueVarFam_left (n : Nat) (c : CptI) (hc : BotFamCpt trueEnvU c)
    (h : ApproxDIK trueEnvU n trueVarCtx (.const 0 []) c) :
    LRTypeFamINRK trueEnvU n trueVarCtx (.const 0 []) trueVarFam c ∧
      LRTypeFamINRK trueEnvU n trueVarCtx trueVarFam (.const 0 []) c := by
  have hFam : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)
      (.const 0 []) c :=
    (approxDIK_famApp_iff trueEnvUWfT n trueVarCtx (r := 0) (m := trueFamMember) rfl rfl [] [] c).mp h
  have hdiag : LRTypeFamINRK trueEnvU n trueVarCtx (.const 0 []) (.const 0 []) c :=
    lrTypeFamINRK_of_lrTypeFamIN_botFamCpt hc
      (lrTypeFamINBiDI_famSpine_of_convArgsT (r := 0) (m := trueFamMember) (xs := []) (xs' := [])
        trueEnvUWfT rfl rfl (trueConstTyT rfl) (trueConstTyT rfl)
        (.refl trueVarCtx (.const 0 [])) (eqNList_refl []) rfl rfl (.nil _) c hc (Or.inl hFam))
  exact ⟨lrTypeFamINRK_expand (.refl _) (whRedRecK_trueVarFam n) hdiag,
         lrTypeFamINRK_expand (whRedRecK_trueVarFam n) (.refl _) hdiag⟩

/-- **Repaired K + Recursor-Major `BotFamCpt E` Type Fundamental Property (`FundamentalLRFamINBotRK`):** -/
def FundamentalLRFamINBotRK (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, BotFamCpt E c → ApproxDIK E n Γ A c →
      LRTypeFamINRK E n Γ A A' c

/-- Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalLRFamINBotRK E n`. -/
theorem piRowField_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n) : PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamINRK_pi_components
      (F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
        (approxDIK_pi_bot_nil E n Γ A B))

/-- Disjointness of `.pi A B` and `.sort l` under `FundamentalLRFamINBotRK E n`. -/
theorem not_tyConvT_pi_sort_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · exact Expr.noConfusion heq
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    have hLR := F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
      (approxDIK_pi_bot_nil E n Γ A B)
    cases hLR with
    | pi _ hred' _ _ _ _ _ => exact nomatch whRedRecK_sort_eq hred'

/-- Disjointness of `.sort l` and `.pi A B` under `FundamentalLRFamINBotRK E n`. -/
theorem not_tyConvT_sort_pi_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (_hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hLR := F hΓ (.sort Γ l) hc .sort .sort (approxDIK_sort E n Γ l)
  cases hLR with
  | sort _ hred' => exact nomatch whRedRecK_pi_eq hred'

/-- Saturation (`xs.length = doms.length`) of any sort-typed admitted `.inductiveM` family spine
    under `FundamentalLRFamINBotRK E n`. -/
theorem famApp_saturated_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  have hprow : PiRowField E n := piRowField_of_fundamentalLRFamINBotRK hW F
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_fundamentalLRFamINBotRK hW F hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_fundamentalLRFamINBotRK hW F hΓ hconv

theorem famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = (piDomsOf m.mtype).length := by
  have hlen := famApp_saturated_of_fundamentalLRFamINBotRK hW F hΓ hm hind
    (instMtype_policyPi_of_inductiveM hW hm hind ls) hty
  rwa [List.length_map] at hlen

/-- `FamAppRowLink E n` from `FundamentalLRFamINBotRK E n` under `EnvWfT E` alone. -/
theorem famAppRow_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n) : FamAppRowLink E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotRK hW F hΓ hm hind hty
  exact lrTypeFamINRK_famApp_components hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxDIK_famApp_botVecI_of_inductiveM hW n Γ hm hind ls xs))

/-- `FamRelevantSlotConv E n` from `FundamentalLRFamINBotRK E n` under `EnvWfT E` alone. -/
theorem famRelevantSlotConv_of_fundamentalLRFamINBotRK {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotRK E n) : FamRelevantSlotConv E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotRK hW F hΓ hm hind hty
  exact lrTypeFamINRK_famApp_relevantSlotConv hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxDIK_famApp_botVecI_of_inductiveM hW n Γ hm hind ls xs))

/-- `TypedRowsWf E n` from `EnvWfT E` + `AllBelowScoped` + `FundamentalLRFamINBotRK E n` alone. -/
theorem typedRowsWf_of_allBelowScoped_fundamentalLRFamINBotRK {E : ResolvedEnv}
    (hW : EnvWfT E) {Aw : Nat → Nat} (hBel : AllBelowScoped E Aw (tableOf hW))
