/-- **Refutation of §13's `LRTermFamINDR` on All Three `W-K-OPEN` Benchmarks (`trueVarSort`, `trueVarPi`, `trueVarFam`):** -/
theorem not_lrTermFamINDR_trueVarSort (n : Nat) :
    ¬ LRTermFamINDR trueEnvU n trueVarCtx (.sort .zero) trueVarSort (.sort (.succ .zero)) .sort :=
  fun h => not_lrTypeFamINR_trueVarSort_right n (.sort .zero)
    (lrTypeFamINR_of_lrTermFamINDR_sort .sort h)

