/-- Context transport of `WhStepRecK` across `CtxConvT E n Γ Γ'` and `CtxSameValues Γ Γ'` under `EnvClosed E`. -/
theorem whStepRecK_ctx_sameValues {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hs : WhStepRecK E n Γ a b) : WhStepRecK E n Γ' a b := by
  induction hs with
  | recCtx hs₀ => exact .recCtx (whStepRecCtx_of_sameValues hval hs₀)
  | pmajor hI hP hcanon hx =>
      rcases hP with ⟨hP⟩
      rcases hcanon with ⟨hcanon⟩
      rcases hx with ⟨hx⟩
      exact .pmajor hI ⟨hasTyT_ctx hcl hctx hP⟩ ⟨hasTyT_ctx hcl hctx hcanon⟩ ⟨hasTyT_ctx hcl hctx hx⟩
  | appHead _ ih => exact .appHead ih
  | recMajor hm hrec hlen _ ih => exact .recMajor hm hrec hlen ih

theorem whRedRecK_ctx_sameValues {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hr : WhRedRecK E n Γ a b) : WhRedRecK E n Γ' a b := by
  induction hr with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepRecK_ctx_sameValues hcl hctx hval hs) ih

theorem whNormalRecK_ctx_sameValues {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ' Γ) (hval : CtxSameValues Γ' Γ)
    {X : Expr Nat} (hn : WhNormalRecK E n Γ X) : WhNormalRecK E n Γ' X :=
  fun Y hs => hn Y (whStepRecK_ctx_sameValues hcl hctx hval hs)

/-- **Positive Resolution of `W-K-OPEN` (`whRedRecK_trueRecVar`):**
    Under `WhRedRecK trueEnvU n trueVarCtx`, `trueRecVar u motive minor` steps in one `pmajor` step
    (using `trueRecWitness u motive minor` at canonical major `True.intro` and proof variable
    `.bvar 0 : True`) to `minor` for **every** `n, u, motive, minor`! -/
theorem whRedRecK_trueRecVar (n : Nat) (u : Level) (motive minor : Expr Nat) :
    WhRedRecK trueEnvU n trueVarCtx (trueRecVar u motive minor) minor :=
  .step
    (.pmajor (.ofU (trueRecWitness u motive minor))
      ⟨trueConstTyT rfl⟩ ⟨hasTyT_trueIntro⟩ ⟨hasTyT_trueVar0⟩)
    (.refl minor)

theorem whRedRecK_trueVarSort (n : Nat) :
    WhRedRecK trueEnvU n trueVarCtx trueVarSort (.sort .zero) :=
  whRedRecK_trueRecVar n (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero)

theorem whRedRecK_trueVarPi (n : Nat) :
    WhRedRecK trueEnvU n trueVarCtx trueVarPi PiModelDeltaIotaAudit.idPiProp :=
