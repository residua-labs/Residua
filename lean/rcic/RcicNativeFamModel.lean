/-- **Full Symmetry of `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBot E n` and `EnvWfT E` (`lrTermFamIND_symm_bot`):** -/
theorem lrTermFamIND_symm_bot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINBot E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M' M A c
  | .bot, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR⟩
  | .pi a f, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR⟩
  | .spine r args, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨hl, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · exact Or.inl ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨hns, Y', Y, hY', hY, hn', hn, ⟨.symm _ _ _ _ hc⟩⟩)
  | .lam g, Γ, hΓ, M, M', A, h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl hprop
      · cases hΓ₁ with
        | assumption _ _ u₁ _ hA₁ =>
            have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
            refine Or.inr ⟨A₁, B₁, w, hred, ⟨hΓ₁'⟩, ⟨hB₁⟩,
              fun s hs N N' hN hN' hc hrel => ?_⟩
            have hc' : ConvT E n Γ N' N A₁ := .symm _ _ _ _ hc
            have hrel' : ∀ v ∈ s.1, LRTermFamIND E n Γ N' N A₁ v :=
              fun v hv => lrTermFamIND_symm_bot hW zsc hcore hF v hΓ (hrel v hv)
            have hout := happ s hs N' N hN' hN hc' hrel'
            have houtSymm := lrTermFamIND_symm_bot hW zsc hcore hF s.2 hΓ hout
            have hinstTy : HasTyT E n Γ (instantiate0 N' B₁) (.sort w) :=
              hasTyT_subst0_of_envWfT hW hB₁ hN'
            have hinstConv : TyConvT E n Γ (instantiate0 N' B₁) (instantiate0 N B₁) :=
              .of _ _ _ w (convT_inst0_sortCongr hA₁ hB₁ hN' hN hc')
            exact lrTermFamIND_transport_bot hW zsc hcore hF s.2
              hΓ hinstTy hinstConv houtSymm
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Full Transitivity of `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBot E n` and `EnvWfT E` (`lrTermFamIND_trans_bot`):** -/
theorem lrTermFamIND_trans_bot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINBot E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M N P A : Expr Nat},
      LRTermFamIND E n Γ M N A c → LRTermFamIND E n Γ N P A c → LRTermFamIND E n Γ M P A c
  | .bot, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_sort_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR₁ hLR₂⟩
  | .pi a f, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_pi_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR₁ hLR₂⟩
  | .spine r args, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_spine_iff] at h₁ h₂ ⊢
      rcases h₁ with ⟨⟨l, hl⟩, hLR₁⟩ | hprop | ⟨hns, Y₁, Y₂, hM, hN₁, hn₁, hn₂, ⟨hc₁⟩⟩
      · rcases h₂ with ⟨_, hLR₂⟩ | hprop | ⟨hns, _⟩
        · exact Or.inl ⟨⟨l, hl⟩,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBot hW hF) hΓ hLR₁ hLR₂⟩
        · exact Or.inr (Or.inl hprop)
        · exact (hns l hl).elim
      · exact Or.inr (Or.inl hprop)
      · rcases h₂ with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨_, Y₂', Y₃, hN₂, hP, hn₂', hn₃, ⟨hc₂⟩⟩
        · exact (hns l hl).elim
        · exact Or.inr (Or.inl hprop)
        · have e := whRedCtx_normal_unique_of_envWfT hW hN₁ hn₂ hN₂ hn₂'
          subst e
          exact Or.inr (Or.inr ⟨hns, Y₁, Y₃, hM, hP, hn₁, hn₃,
            ⟨.trans _ _ _ _ _ hc₁ hc₂⟩⟩)
  | .lam g, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_lam_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, happ₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨A₂, B₂, _, hred₂, _, _, happ₂⟩
        · exact Or.inl hprop
        · have e := whRedCtx_normal_unique_of_envWfT hW
            hred₁ (whNormalCtx_pi A₁ B₁) hred₂ (whNormalCtx_pi A₂ B₂)
          injection e with eA eB
          subst eA; subst eB
          refine Or.inr ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, fun s hs Q Q' hQ hQ' hcQ hrel => ?_⟩
          have hrelQQ : ∀ v ∈ s.1, LRTermFamIND E n Γ Q Q A₁ v :=
            fun v hv =>
              lrTermFamIND_trans_bot hW zsc hcore hF v hΓ (hrel v hv)
                (lrTermFamIND_symm_bot hW zsc hcore hF v hΓ (hrel v hv))
          have hout₁ := happ₁ s hs Q Q hQ hQ (.refl _ _ _ hQ) hrelQQ
          have hout₂ := happ₂ s hs Q Q' hQ hQ' hcQ hrel
          exact lrTermFamIND_trans_bot hW zsc hcore hF s.2 hΓ hout₁ hout₂
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **The `BotFamCpt E`-Restricted Term Fundamental Lemma (`FundamentalTermFamINDBot E n`):**
    Repairs `FundamentalTermFamIND E n` (§10) by restricting `u` to `BotFamCpt E u`. -/
def FundamentalTermFamINDBot (E : ResolvedEnv) (n : Nat) : Prop :=
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M A : Expr Nat}, HasTyT E n Γ M A →
    ∀ u, BotFamCpt E u → ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M A u) ∧
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M M' A : Expr Nat}, ConvT E n Γ M M' A →
    ∀ u, BotFamCpt E u → ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u)

/-- Soundness-free preservation of `LRTypeFamIN` at `.pi .bot []` along any `TyConvT E n Γ A A'`
    chain from `FundamentalTermFamINDBot E n` + `WhApproxInvCore E` + `EnvWfT E` alone
    (no `WhDet E` hypothesis needed). -/
theorem lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamINDBot E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → ApproxI (ctxEnvI Γ) A (.pi .bot []) →
    LRTypeFamIN E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot [])
        (F.1 hΓ hA (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot [])
        (F.2 hΓ hc (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ := lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBot hW hcore F hΓ hA c₁ hcA
      have hcM : ApproxI (ctxEnvI Γ) _ (.pi .bot []) :=
        approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN hcore hLR₁
      exact lrTypeFamIN_trans_pi_bot_nil_of_envWfT hW hLR₁
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBot hW hcore F hΓ hM c₂ hcM)

/-- Derive `PiRowField E n` from `FundamentalTermFamINDBot E n` + `WhApproxInvCore E` + `EnvWfT E`
    (with no `WhDet E` hypothesis). -/
theorem piRowField_of_fundamentalTermFamINDBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamINDBot E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBot hW hcore F hΓ hPi hc
        (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- **Full Derivation of `FundamentalLRFamINBot E n` from `FundamentalTermFamINDBot E n` +
    `WhApproxInvCore E` + `EnvWfT E` (`fundamentalLRFamINBot_of_fundamentalTermFamINDBot`):**
    Because `approxI_ctxEnvI_right_of_lrTypeFamIN_botFamCpt` transports **every** `BotFamCpt E c`
    across the middle type `M` of `TyConvT.trans A M B c₁ c₂` without `TypeSoundnessI`,
    `FundamentalTermFamINDBot E n` implies the full `FundamentalLRFamINBot E n`! -/
theorem fundamentalLRFamINBot_of_fundamentalTermFamINDBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamINDBot E n) :
    FundamentalLRFamINBot E n := by
  have hpi : PiRowField E n := piRowField_of_fundamentalTermFamINDBot hW hcore F
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A =>
      intro u hA c hcpt hcA
      exact lrTypeFamIN_of_lrTermFamIND_sort c (F.1 hΓ hA c hcpt hcA)
  | of A B v hc =>
      intro _ _ c hcpt hcA
      exact lrTypeFamIN_of_lrTermFamIND_sort c (F.2 hΓ hc c hcpt hcA)
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨v, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxI_ctxEnvI_right_of_lrTypeFamIN_botFamCpt hcore hcpt r₁
      exact lrTypeFamIN_trans_of_envWfT hW hpi hΓ r₁ (ih₂ hM c hcpt hcM)

/-- Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from `FundamentalTermFamINDBot E n` +
    `WhApproxInvCore E` + `EnvWfT E` (with no `WhDet E` hypothesis). -/
theorem famAppRow_of_fundamentalTermFamINDBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamINDBot E n) :
    FamAppRowLink E n :=
  famAppRow_of_fundamentalLRFamINBot hW
    (fundamentalLRFamINBot_of_fundamentalTermFamINDBot hW hcore F)

/-- Derive `KernelRowsAssembly.FamRelevantSlotConv E n` (`W-F8-FAMAPP-ARG-COMPARISON`) from
    `FundamentalTermFamINDBot E n` + `WhApproxInvCore E` + `EnvWfT E`. -/
theorem famRelevantSlotConv_of_fundamentalTermFamINDBot {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamINDBot E n) :
    FamRelevantSlotConv E n :=
  famRelevantSlotConv_of_fundamentalLRFamINBot hW
    (fundamentalLRFamINBot_of_fundamentalTermFamINDBot hW hcore F)

/-- Assemble `TypedRowsWf E n` from `AllBelowScoped` + `WhApproxInvCore` +
    `FundamentalTermFamINDBot` (with no `WhDet E` hypothesis). -/
theorem typedRowsWf_of_allBelowScoped_fundamentalTermFamINDBot {E : ResolvedEnv}
    (hW : EnvWfT E) {Aw : Nat → Nat} (hBel : AllBelowScoped E Aw (tableOf hW))
    (hcore : WhApproxInvCore E) {n : Nat}
    (F : FundamentalTermFamINDBot E n) :
    TypedRowsWf E n where
  sortRow := sortRow_of_allBelowScoped_build hW hBel
  piRow := piRowField_of_fundamentalTermFamINDBot hW hcore F
  famAppRow := famAppRow_of_fundamentalTermFamINDBot hW hcore F


/-! #### Part C — Concrete $\delta$/$\iota$ Family Semantics Over `ApproxDI E` (`rigidConst_of_inductiveM`, `CtxEnvDI`, `ctxEnvDI`) & `FundamentalLRFamINBotDI` / `FundamentalTermFamINDBotDI` Without `WhDet` or `WhApproxInvCore` Hypotheses -/

/-- Under `EnvWfT E`, every admitted `.inductiveM` family head `r` (`E.members r = some m`,
    `m.mclass = .inductiveM`) is a `RigidConst E r` in `RcicNativePiModelDeltaIota`
    (since `familyNoBody_of_envWfT` gives `m.body = none` and `.inductiveM ≠ .recursorM`). -/
theorem rigidConst_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    PiModelDeltaIotaAudit.RigidConst E r := by
  intro m' hm'
  have heq : m' = m := Option.some.inj (hm'.symm.trans hm)
  subst m'
  exact ⟨Or.inl (familyNoBody_of_envWfT hW r m hm hind), by rw [hind]; decide⟩

/-- Any argument list `xs` and compact list `cs` of equal length with `BotDemand cs` satisfy
    `PiModelDeltaIotaAudit.ApproxSpineArgs E ρ xs cs` in every environment `ρ : EnvI`. -/
theorem approxSpineArgs_of_botDemand (E : ResolvedEnv) (ρ : EnvI) :
    {xs : List (Expr Nat)} → {cs : List CptI} →
    xs.length = cs.length → PiModelDeltaIotaAudit.BotDemand cs →
    PiModelDeltaIotaAudit.ApproxSpineArgs E ρ xs cs
  | [], [], _, _ => .nil
  | [], _ :: _, hlen, _ => nomatch hlen
  | _ :: _, [], hlen, _ => nomatch hlen
  | x :: xs, c :: cs, hlen, hbd => by
      have hc : c = .bot := hbd c (List.mem_cons_self _ _)
      subst hc
      exact .cons (.bot ρ x)
        (approxSpineArgs_of_botDemand E ρ (Nat.succ.inj hlen)
          (fun u hu => hbd u (List.mem_cons_of_mem _ hu)))

/-- `botVecI xs` satisfies `ApproxSpineArgs E ρ xs (botVecI xs)`. -/
theorem approxSpineArgs_botVecI (E : ResolvedEnv) (ρ : EnvI) (xs : List (Expr Nat)) :
    PiModelDeltaIotaAudit.ApproxSpineArgs E ρ xs (botVecI xs) :=
  approxSpineArgs_of_botDemand E ρ (botVecI_length xs).symm (botDemand_botVecI xs)

/-- For any `RigidConst E r` and any `xs`, `cs` of equal length with `BotDemand cs`,
    `.spine r cs` approximates `foldApps (.const r ls) xs` in `ApproxDI E ρ`. -/
theorem approxDI_famApp_of_botDemand {E : ResolvedEnv} (ρ : EnvI) {r : Nat} (ls : List Level)
    (hrigid : PiModelDeltaIotaAudit.RigidConst E r)
    {xs : List (Expr Nat)} {cs : List CptI}
    (hlen : xs.length = cs.length) (hbd : PiModelDeltaIotaAudit.BotDemand cs) :
    PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) (.spine r cs) :=
  (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hrigid xs (.spine r cs)).mpr
    (Or.inr ⟨cs, approxSpineArgs_of_botDemand E ρ hlen hbd, rfl⟩)

/-- For any `RigidConst E r`, `.spine r (botVecI xs)` approximates `foldApps (.const r ls) xs`
    in `ApproxDI E ρ`. -/
theorem approxDI_famApp_botVecI {E : ResolvedEnv} (ρ : EnvI) {r : Nat} (ls : List Level)
    (hrigid : PiModelDeltaIotaAudit.RigidConst E r) (xs : List (Expr Nat)) :
    PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
  approxDI_famApp_of_botDemand ρ ls hrigid (botVecI_length xs).symm (botDemand_botVecI xs)

/-- Under `EnvWfT E`, for any admitted `.inductiveM` family head `r`, `.spine r (botVecI xs)`
    approximates `foldApps (.const r ls) xs` in `ApproxDI E ρ`. -/
theorem approxDI_famApp_botVecI_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
  approxDI_famApp_botVecI ρ ls (rigidConst_of_inductiveM hW hm hind) xs

/-- `slotVecI xs i c` satisfies `ApproxSpineArgs E ρ xs (slotVecI xs i c)` whenever
    `ApproxDI E ρ (xs.getD i (.bvar 0)) c`. -/
theorem approxSpineArgs_slotVecI (E : ResolvedEnv) (ρ : EnvI) :
    ∀ (xs : List (Expr Nat)) (i : Nat) (c : CptI),
      PiModelDeltaIotaAudit.ApproxDI E ρ (xs.getD i (.bvar 0)) c →
      PiModelDeltaIotaAudit.ApproxSpineArgs E ρ xs (slotVecI xs i c)
  | [], _, _, _ => .nil
  | _ :: xs, 0, _, hx =>
      .cons hx (approxSpineArgs_botVecI E ρ xs)
  | x :: xs, i + 1, c, hx =>
      .cons (.bot ρ x) (approxSpineArgs_slotVecI E ρ xs i c hx)

/-- Slotwise projection of `ApproxSpineArgs E ρ xs cs` at `i < xs.length`. -/
theorem approxSpineArgs_slot_inv {E : ResolvedEnv} {ρ : EnvI} :
    ∀ {xs : List (Expr Nat)} {cs : List CptI},
      PiModelDeltaIotaAudit.ApproxSpineArgs E ρ xs cs →
      ∀ (i : Nat), i < xs.length →
      PiModelDeltaIotaAudit.ApproxDI E ρ (xs.getD i (.bvar 0)) (cs.getD i .bot)
  | _, _, .nil, _, hi => nomatch hi
  | _ :: _, _ :: _, .cons hx _, 0, _ => hx
  | _ :: _, _ :: _, .cons _ hxs, i + 1, hi =>
      approxSpineArgs_slot_inv hxs i (Nat.lt_of_succ_lt_succ hi)

/-- At `i < xs.length`, `(slotVecI xs i c).getD i .bot = c`. -/
theorem slotVecI_getD_eq :
    ∀ (xs : List (Expr Nat)) (i : Nat) (c : CptI),
      i < xs.length → (slotVecI xs i c).getD i .bot = c
  | [], _, _, hi => nomatch hi
  | _ :: _, 0, _, _ => rfl
  | _ :: xs, i + 1, c, hi => slotVecI_getD_eq xs i c (Nat.lt_of_succ_lt_succ hi)

/-- **Model Family-Head & Arity Injectivity in `SemEqDI` (`semEqDI_famApp_head_length`):**
    If `r` and `r'` are `RigidConst E` (in particular, any admitted `.inductiveM` or
    `.constructorM` heads under `EnvWfT E`), `SemEqDI E ρ (foldApps (.const r ls) xs)
    (foldApps (.const r' ls') xs')` implies `r = r' ∧ xs.length = xs'.length`. -/
theorem semEqDI_famApp_head_length {E : ResolvedEnv} {ρ : EnvI}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hr : PiModelDeltaIotaAudit.RigidConst E r)
    (hr' : PiModelDeltaIotaAudit.RigidConst E r')
    (h : PiModelDeltaIotaAudit.SemEqDI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hL : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
    approxDI_famApp_botVecI ρ ls hr xs
  have hR : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r' ls') xs') (.spine r (botVecI xs)) :=
    (h (.spine r (botVecI xs))).mp hL
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls' hr' xs' (.spine r (botVecI xs))).mp hR with
    hbot | ⟨us, hus, heq⟩
  · exact nomatch hbot
  · injection heq with hr_eq hus_eq
    subst hus_eq
    exact ⟨hr_eq, (botVecI_length xs).symm.trans hus.length_eq⟩

/-- **Model Family-Slot Injectivity in `SemEqDI` (`semEqDI_famApp_slot`):**
    For `RigidConst E r` and `RigidConst E r'`, `SemEqDI` of two spines implies `SemEqDI` at
    every argument slot `i < xs.length`. -/
theorem semEqDI_famApp_slot {E : ResolvedEnv} {ρ : EnvI}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hr : PiModelDeltaIotaAudit.RigidConst E r)
    (hr' : PiModelDeltaIotaAudit.RigidConst E r')
    (h : PiModelDeltaIotaAudit.SemEqDI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const r' ls') xs'))
    {i : Nat} (hi : i < xs.length) :
    PiModelDeltaIotaAudit.SemEqDI E ρ (xs.getD i (.bvar 0)) (xs'.getD i (.bvar 0)) := by
  obtain ⟨rfl, hlen⟩ := semEqDI_famApp_head_length hr hr' h
  have hi' : i < xs'.length := hlen ▸ hi
  intro c
  constructor
  · intro hx
    have hspL : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls) xs)
        (.spine r (slotVecI xs i c)) :=
      (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hr xs _).mpr
        (Or.inr ⟨slotVecI xs i c, approxSpineArgs_slotVecI E ρ xs i c hx, rfl⟩)
    have hspR := (h (.spine r (slotVecI xs i c))).mp hspL
    rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls' hr' xs' _).mp hspR with
      hbot | ⟨us, hus, heq⟩
    · exact nomatch hbot
    · injection heq with _ hus_eq
      subst hus_eq
      have hslot := approxSpineArgs_slot_inv hus i hi'
      rwa [slotVecI_getD_eq xs i c hi] at hslot
  · intro hx'
    have hspR : PiModelDeltaIotaAudit.ApproxDI E ρ (foldApps (.const r ls') xs')
        (.spine r (slotVecI xs' i c)) :=
      (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls' hr' xs' _).mpr
        (Or.inr ⟨slotVecI xs' i c, approxSpineArgs_slotVecI E ρ xs' i c hx', rfl⟩)
    have hspL := (h (.spine r (slotVecI xs' i c))).mpr hspR
    rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hr xs _).mp hspL with
      hbot | ⟨us, hus, heq⟩
    · exact nomatch hbot
    · injection heq with _ hus_eq
      subst hus_eq
      have hslot := approxSpineArgs_slot_inv hus i hi
      rwa [slotVecI_getD_eq xs' i c hi'] at hslot

/-- Combined family-head, length, and slotwise `SemEqDI` injectivity for `RigidConst E` spines. -/
theorem semEqDI_famApp_inj {E : ResolvedEnv} {ρ : EnvI}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hr : PiModelDeltaIotaAudit.RigidConst E r)
    (hr' : PiModelDeltaIotaAudit.RigidConst E r')
    (h : PiModelDeltaIotaAudit.SemEqDI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat), i < xs.length →
        PiModelDeltaIotaAudit.SemEqDI E ρ (xs.getD i (.bvar 0)) (xs'.getD i (.bvar 0)) :=
  ⟨(semEqDI_famApp_head_length hr hr' h).1,
   (semEqDI_famApp_head_length hr hr' h).2,
   fun _ hi => semEqDI_famApp_slot hr hr' h hi⟩

/-- Disjointness of `.pi A B` and a `RigidConst E r` spine in `SemEqDI`. -/
theorem semEqDI_pi_famApp_disjoint {E : ResolvedEnv} {ρ : EnvI}
    {A B : Expr Nat} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hr : PiModelDeltaIotaAudit.RigidConst E r)
    (h : PiModelDeltaIotaAudit.SemEqDI E ρ (.pi A B) (foldApps (.const r ls) xs)) :
    False := by
  have hpi := (h (.pi .bot [])).mp (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E ρ A B)
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hr xs (.pi .bot [])).mp hpi with
    hbot | ⟨_, _, hsp⟩ <;> exact CptI.noConfusion ‹_›

/-- Disjointness of `.sort u` and a `RigidConst E r` spine in `SemEqDI`. -/
theorem semEqDI_sort_famApp_disjoint {E : ResolvedEnv} {ρ : EnvI}
    {u : Level} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hr : PiModelDeltaIotaAudit.RigidConst E r)
    (h : PiModelDeltaIotaAudit.SemEqDI E ρ (.sort u) (foldApps (.const r ls) xs)) :
    False := by
  have hs := (h .sort).mp (.sort ρ u)
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls hr xs .sort).mp hs with
    hbot | ⟨_, _, hsp⟩ <;> exact CptI.noConfusion ‹_›

/-- Context-agreement predicate for `ApproxDI E`: every let-bound variable `i` in `Γ` with
    `lookupValue Γ i = some v` is `SemEqDI E ρ`-equivalent to `v`. -/
def CtxEnvDI (E : ResolvedEnv) (Γ : LCtx) (ρ : EnvI) : Prop :=
  ∀ (i : Nat) (v : Expr Nat), lookupValue Γ i = some v →
    PiModelDeltaIotaAudit.SemEqDI E ρ (.bvar i) v

/-- Canonical context-aware environment `ctxEnvDI E Γ : EnvI` for `ApproxDI E`:
    interprets `.assumption` by `botSetI` and `.letBinding A v` by `denDI E (ctxEnvDI E Γ) v`. -/
def ctxEnvDI (E : ResolvedEnv) : LCtx → EnvI
  | [] => EnvI.bot
  | .assumption _ :: Γ => EnvI.cons botSetI (ctxEnvDI E Γ)
  | .letBinding _ v :: Γ =>
      EnvI.cons (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) (ctxEnvDI E Γ)

@[simp] theorem ctxEnvDI_nil (E : ResolvedEnv) : ctxEnvDI E [] = EnvI.bot := rfl

@[simp] theorem ctxEnvDI_cons_assumption (E : ResolvedEnv) (A : Expr Nat) (Γ : LCtx) :
    ctxEnvDI E (.assumption A :: Γ) = EnvI.cons botSetI (ctxEnvDI E Γ) := rfl

@[simp] theorem ctxEnvDI_cons_letBinding (E : ResolvedEnv) (A v : Expr Nat) (Γ : LCtx) :
    ctxEnvDI E (.letBinding A v :: Γ) =
      EnvI.cons (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) (ctxEnvDI E Γ) := rfl

/-- `ctxEnvDI E Γ` satisfies `CtxEnvDI E Γ (ctxEnvDI E Γ)` for every `E` and `Γ`. -/
theorem ctxEnvDI_respects (E : ResolvedEnv) : ∀ (Γ : LCtx), CtxEnvDI E Γ (ctxEnvDI E Γ)
  | [] => fun i _ hw => by cases i <;> exact nomatch hw
  | .assumption A :: Γ => by
      intro i w hw
      cases i with
      | zero => exact nomatch hw
      | succ j =>
          rw [lookupValue_cons_succ] at hw
          cases h : lookupValue Γ j with
          | none => rw [h] at hw; exact nomatch hw
          | some v₀ =>
              rw [h] at hw
              injection hw with hw_eq
              subst hw_eq
              intro c
              have hsucc : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption A :: Γ))
                  (.bvar (j + 1)) c ↔
                  PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.bvar j) c := by
                constructor <;> (
                  intro hb
                  rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
                  · exact .bot _ _
                  · exact .bvar h0)
              exact hsucc.trans
                ((ctxEnvDI_respects E Γ j v₀ h c).trans
                  (PiModelDeltaIotaAudit.approxDI_lift0_one_iff E (ctxEnvDI E Γ) botSetI v₀ c).symm)
  | .letBinding A v :: Γ => by
      intro i w hw
      cases i with
      | zero =>
          injection hw with hw_eq
          subst hw_eq
          intro c
          have hzero : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding A v :: Γ))
              (.bvar 0) c ↔
              PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) v c := by
            constructor
            · intro hb
              rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
              · exact .bot _ _
              · exact h0
            · intro hv
              exact .bvar hv
          exact hzero.trans
            (PiModelDeltaIotaAudit.approxDI_lift0_one_iff E (ctxEnvDI E Γ)
              (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) v c).symm
      | succ j =>
          rw [lookupValue_cons_succ] at hw
          cases h : lookupValue Γ j with
          | none => rw [h] at hw; exact nomatch hw
          | some v₀ =>
              rw [h] at hw
              injection hw with hw_eq
              subst hw_eq
              intro c
              have hsucc : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding A v :: Γ))
                  (.bvar (j + 1)) c ↔
                  PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.bvar j) c := by
                constructor <;> (
                  intro hb
                  rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hb with rfl | h0
                  · exact .bot _ _
                  · exact .bvar h0)
              exact hsucc.trans
                ((ctxEnvDI_respects E Γ j v₀ h c).trans
                  (PiModelDeltaIotaAudit.approxDI_lift0_one_iff E (ctxEnvDI E Γ)
                    (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) v₀ c).symm)

/-- Soundness of `zetaLocal` in `SemEqDI E ρ` for any `CtxEnvDI E Γ ρ`. -/
theorem semEqDI_zetaLocal {E : ResolvedEnv} {Γ : LCtx} {ρ : EnvI}
    (hρ : CtxEnvDI E Γ ρ) {i : Nat} {v : Expr Nat}
    (hv : lookupValue Γ i = some v) :
    PiModelDeltaIotaAudit.SemEqDI E ρ (.bvar i) v :=
  hρ i v hv

/-- **Unconditional `WhStepCtx` Invariance on `ApproxDI E` (`whStepCtx_approxDI_iff_of_envWfT`):**
    Under `EnvWfT E` alone (with **zero** `WhApproxInvCore` hypotheses!), every context-aware
    weak-head step `WhStepCtx E Γ a b` (including `beta`, `zeta`, `zetaLocal`, `delta`, `iota`,
    `lit`, and `appHead`) preserves `ApproxDI E ρ` at every `CtxEnvDI E Γ ρ`. -/
theorem whStepCtx_approxDI_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvDI E Γ ρ) {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E ρ a c ↔ PiModelDeltaIotaAudit.ApproxDI E ρ b c := by
  induction h generalizing c with
  | beta A body arg => exact PiModelDeltaIotaAudit.approxDI_beta E ρ A body arg c
  | zeta A v body => exact PiModelDeltaIotaAudit.approxDI_zeta E ρ A v body c
  | zetaLocal hv => exact semEqDI_zetaLocal hρ hv c
  | delta hres hbody => exact PiModelDeltaIotaAudit.semEqDI_of_whStep_delta hW hres hbody ρ c
  | iota hI => exact PiModelDeltaIotaAudit.approxDI_iotaU_of_envWfT hW hI ρ c
  | lit t => exact PiModelDeltaIotaAudit.approxDI_lit E ρ t c
  | @appHead f f' arg _ ih =>
      exact PiModelDeltaIotaAudit.semEqDI_app ih (PiModelDeltaIotaAudit.semEqDI_refl E ρ arg) c

/-- Multi-step `WhRedCtx E Γ` invariance on `ApproxDI E ρ` under `EnvWfT E` and `CtxEnvDI E Γ ρ`. -/
theorem whRedCtx_approxDI_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvDI E Γ ρ) {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E ρ a c ↔ PiModelDeltaIotaAudit.ApproxDI E ρ b c := by
  induction h with
  | refl => exact Iff.rfl
  | step hs _ ih => exact (whStepCtx_approxDI_iff_of_envWfT hW hρ hs c).trans ih

/-- Unconditional invariance of `ApproxDI E (ctxEnvDI E Γ)` across `WhStepCtx E Γ` at `EnvWfT E`. -/
theorem approxDI_ctxEnvDI_whStepCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhStepCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c :=
  whStepCtx_approxDI_iff_of_envWfT hW (ctxEnvDI_respects E Γ) h c

/-- Unconditional invariance of `ApproxDI E (ctxEnvDI E Γ)` across `WhRedCtx E Γ` at `EnvWfT E`. -/
theorem approxDI_ctxEnvDI_whRedCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhRedCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c :=
  whRedCtx_approxDI_iff_of_envWfT hW (ctxEnvDI_respects E Γ) h c

/-- If `WhRedCtx E Γ A (.sort l)` under `EnvWfT E`, then `ApproxDI E (ctxEnvDI E Γ) A .sort`. -/
theorem approxDI_ctxEnvDI_sort_of_whRedCtx {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {A : Expr Nat} {l : Level} (h : WhRedCtx E Γ A (.sort l)) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A .sort :=
  (approxDI_ctxEnvDI_whRedCtx_of_envWfT hW h .sort).mpr (.sort (ctxEnvDI E Γ) l)

/-- If `WhRedCtx E Γ A (.pi A₁ B₁)` under `EnvWfT E`, then
    `ApproxDI E (ctxEnvDI E Γ) A (.pi .bot [])`. -/
theorem approxDI_ctxEnvDI_pi_of_whRedCtx {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {A A₁ B₁ : Expr Nat} (h : WhRedCtx E Γ A (.pi A₁ B₁)) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.pi .bot []) :=
  (approxDI_ctxEnvDI_whRedCtx_of_envWfT hW h (.pi .bot [])).mpr
    (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A₁ B₁)

/-- **Context-Aware `BotDemand` Invariance in `ApproxDI E` (`approxDI_cons_botDemand_ctxEnvDI_iff`):**
    For **every** local context `Γ` (including contexts with `letBinding`s), extending
    `ctxEnvDI E Γ` by `demand us` for any `BotDemand us` has the exact same `ApproxDI E`
    approximations as `ctxEnvDI E (.assumption A :: Γ)`. -/
theorem approxDI_cons_botDemand_ctxEnvDI_iff {E : ResolvedEnv} {Γ : LCtx} {us : List CptI}
    (h : PiModelDeltaIotaAudit.BotDemand us) (A e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (EnvI.cons (demand us) (ctxEnvDI E Γ)) e c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption A :: Γ)) e c := by
  rw [ctxEnvDI_cons_assumption]
  constructor
  · refine PiModelDeltaIotaAudit.approxDI_mono_env_nonbot (fun i u hne => ?_)
    cases i with
    | zero => intro hu; exact (hne (h u hu)).elim
    | succ i => exact id
  · refine PiModelDeltaIotaAudit.approxDI_mono_env_nonbot (fun i u hne => ?_)
    cases i with
    | zero => intro hu; exact (hne hu).elim
    | succ i => exact id

/-- **Soundness-Free Two-Sided Approximation on `BotFamCpt E` in `ApproxDI E`
    (`approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt`):**
    Under `EnvWfT E` **alone** (with zero `WhApproxInvCore` or `TypeSoundness` hypotheses!),
    for every `BotFamCpt E c` and every local context `Γ`, `LRTypeFamIN E n Γ A B c` implies
    **both** `ApproxDI E (ctxEnvDI E Γ) A c` and `ApproxDI E (ctxEnvDI E Γ) B c`. -/
theorem approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A B c) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c ∧
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) B c := by
  induction h with
  | bot => exact ⟨.bot _ _, .bot _ _⟩
  | sort hA hB =>
      exact ⟨approxDI_ctxEnvDI_sort_of_whRedCtx hW hA,
             approxDI_ctxEnvDI_sort_of_whRedCtx hW hB⟩
  | @pi Γ A B A₁ B₁ A₂ B₂ a f hA hB _ _ _ _ _ iha ihf =>
      cases hc with
      | pi ha hbd hf =>
          obtain ⟨ha₁, ha₂⟩ := iha ha
          have hf₁ : ∀ s ∈ f,
              PiModelDeltaIotaAudit.ApproxDI E (EnvI.cons (demand s.1) (ctxEnvDI E Γ)) B₁ s.2 :=
            fun s hs =>
              (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₁ s.2).mpr
                (ihf s hs (hf s hs)).1
          have hf₂ : ∀ s ∈ f,
              PiModelDeltaIotaAudit.ApproxDI E (EnvI.cons (demand s.1) (ctxEnvDI E Γ)) B₂ s.2 :=
            fun s hs =>
              (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₂ s.2).mpr
                (ihf s hs (hf s hs)).2
          exact ⟨(approxDI_ctxEnvDI_whRedCtx_of_envWfT hW hA (.pi a f)).mpr (.pi ha₁ hf₁),
                 (approxDI_ctxEnvDI_whRedCtx_of_envWfT hW hB (.pi a f)).mpr (.pi ha₂ hf₂)⟩
  | @famSpine Γ A B r m' ls ls' xs xs' _ _ args hm' hind' hA hB _ _ _ _ hlenA hlenB _ =>
      cases hc with
      | famSpine hm _ hlenArgs hbd =>
          rw [hm] at hm'
          injection hm' with hm_eq
          subst hm_eq
          have hrig : PiModelDeltaIotaAudit.RigidConst E r :=
            rigidConst_of_inductiveM hW hm hind'
          have hspA : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
              (foldApps (.const r ls) xs) (.spine r args) :=
            approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls hrig (hlenA.trans hlenArgs.symm) hbd
          have hspB : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
              (foldApps (.const r ls') xs') (.spine r args) :=
            approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls' hrig (hlenB.trans hlenArgs.symm) hbd
          exact ⟨(approxDI_ctxEnvDI_whRedCtx_of_envWfT hW hA (.spine r args)).mpr hspA,
                 (approxDI_ctxEnvDI_whRedCtx_of_envWfT hW hB (.spine r args)).mpr hspB⟩
  | otherSpine hnot _ _ _ _ _ =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- Right-hand projection of `approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt`. -/
theorem approxDI_ctxEnvDI_right_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A B c) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) B c :=
  (approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt hW hc h).2

/-- **The `BotFamCpt E`-Restricted Typed Type-Level Fundamental Lemma Over `ApproxDI E`
    (`FundamentalLRFamINBotDI E n`):** -/
def FundamentalLRFamINBotDI (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
      LRTypeFamIN E n Γ A A' c

/-- Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalLRFamINBotDI E n`. -/
theorem piRowField_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n) : PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
        (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))

/-- Disjointness of `.pi A B` and `.sort l` under `FundamentalLRFamINBotDI E n`. -/
theorem not_tyConvT_pi_sort_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · exact Expr.noConfusion heq
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    have hLR := F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
      (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B)
    cases hLR with
    | pi _ hred' _ _ _ _ _ => exact nomatch whRedCtx_sort_eq hred'

/-- Disjointness of `.sort l` and `.pi A B` under `FundamentalLRFamINBotDI E n`. -/
theorem not_tyConvT_sort_pi_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (_hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (_hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hLR := F _hΓ (.sort Γ l) hc .sort .sort (.sort (ctxEnvDI E Γ) l)
  cases hLR with
  | sort _ hred' => exact nomatch whRedCtx_pi_eq hred'

/-- Saturation (`xs.length = doms.length`) of any sort-typed admitted `.inductiveM` family spine
    under `FundamentalLRFamINBotDI E n`. -/
theorem famApp_saturated_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  have hprow : PiRowField E n := piRowField_of_fundamentalLRFamINBotDI hW F
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_fundamentalLRFamINBotDI hW F hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_fundamentalLRFamINBotDI hW F hΓ hconv

/-- Canonical stored-domain saturation `xs.length = (piDomsOf m.mtype).length` from
    `FundamentalLRFamINBotDI E n`. -/
theorem famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = (piDomsOf m.mtype).length := by
  have hlen := famApp_saturated_of_fundamentalLRFamINBotDI hW F hΓ hm hind
    (instMtype_policyPi_of_inductiveM hW hm hind ls) hty
  rwa [List.length_map] at hlen

/-- Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from `FundamentalLRFamINBotDI E n`:
    saturation (`famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotDI`) ensures
    `.spine r (botVecI xs)` is in `BotFamCpt E` (`botFamCpt_famSpine_botVecI`), and
    `rigidConst_of_inductiveM` supplies `approxDI_famApp_botVecI_of_inductiveM`. -/
theorem famAppRow_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n) : FamAppRowLink E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotDI hW F hΓ hm hind hty
  exact lrTypeFamIN_famApp_components hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxDI_famApp_botVecI_of_inductiveM hW (ctxEnvDI E Γ) hm hind ls xs))

/-- Derive `KernelRowsAssembly.FamRelevantSlotConv E n` (`W-F8-FAMAPP-ARG-COMPARISON`) from
    `FundamentalLRFamINBotDI E n`. -/
theorem famRelevantSlotConv_of_fundamentalLRFamINBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n) : FamRelevantSlotConv E n := by
  intro Γ hΓ r m ls ls' xs xs' w hm hind hty hc
  have hlen : xs.length = (piDomsOf m.mtype).length :=
    famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotDI hW F hΓ hm hind hty
  exact lrTypeFamIN_famApp_relevantSlotConv hW hm hind
    (F hΓ hty hc (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen)
      (approxDI_famApp_botVecI_of_inductiveM hW (ctxEnvDI E Γ) hm hind ls xs))

/-- Transport `IsNonSortPropCtx` along `TyConvT E n Γ A A'` using `FundamentalLRFamINBotDI E n`
    and `EnvWfT E` alone (no `WhApproxInvCore` hypothesis needed!). -/
theorem isNonSortPropCtx_transport_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsNonSortPropCtx E n Γ A) :
    IsNonSortPropCtx E n Γ A' := by
  obtain ⟨hno, ⟨hA0⟩⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨fun l hred' => ?_, ⟨hA'0⟩⟩
  have hcA' := approxDI_ctxEnvDI_sort_of_whRedCtx hW hred'
  have hLR : LRTypeFamIN E n Γ A' A .sort := hF hΓ hA'0 hAA'.symmT .sort .sort hcA'
  cases hLR with
  | sort _ hredA => exact hno _ hredA

/-- Transport `∀ l, ¬ WhRedCtx E Γ A (.sort l)` across `TyConvT E n Γ A A'` using
    `FundamentalLRFamINBotDI E n` and `EnvWfT E` alone. -/
theorem not_whRedCtx_sort_transport_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hF : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hc : TyConvT E n Γ A A')
    (hns : ∀ l, ¬ WhRedCtx E Γ A (.sort l)) :
    ∀ l, ¬ WhRedCtx E Γ A' (.sort l) := by
  intro l hl'
  obtain ⟨u', hA'⟩ := tyConvT_endTyped hW hΓ hc hA
  have hsortA' := approxDI_ctxEnvDI_sort_of_whRedCtx hW hl'
  have hLR := hF hΓ hA' hc.symmT .sort .sort hsortA'
  cases hLR with
  | sort _ hredA => exact hns _ hredA

/-- **Full Index Transport for `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBotDI E n` and `EnvWfT E` Alone (`lrTermFamIND_transport_botDI`):**
    Requires **neither** `WhDet E` **nor** `WhApproxInvCore E`! -/
theorem lrTermFamIND_transport_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINBotDI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A A' : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' →
    ∀ {M M' : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M M' A' c
  | .bot, _, _, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport_botDI hW zsc hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort (approxDI_ctxEnvDI_sort_of_whRedCtx hW hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .pi a f, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport_botDI hW zsc hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort (approxDI_ctxEnvDI_sort_of_whRedCtx hW hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .spine r args, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · have hs := hF hΓ hA hAA' .sort .sort (approxDI_ctxEnvDI_sort_of_whRedCtx hW hl)
        cases hs with
        | sort _ hl' => exact Or.inl ⟨⟨_, hl'⟩, hLR⟩
      · exact Or.inr (Or.inl (isNonSortPropCtx_transport_botDI hW zsc hF hΓ hAA' hprop))
      · exact Or.inr (Or.inr ⟨not_whRedCtx_sort_transport_botDI hW hF hΓ hA hAA' hns,
          Y, Y', hY, hY', hn, hn', ⟨convT_of_tyConv hc hAA'⟩⟩)
  | .lam g, Γ, hΓ, A, A', _, hA, hAA', M, M', h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl (isNonSortPropCtx_transport_botDI hW zsc hF hΓ hAA' hprop)
      · have hpi := hF hΓ hA hAA' (.pi .bot []) (botFamCpt_pi_bot_nil E)
          (approxDI_ctxEnvDI_pi_of_whRedCtx hW hred)
        cases hpi with
        | @pi _ _ _ A₁' B₁' A₂ B₂ _ _ hred₁ hred₂ _ hdom hcod _ _ =>
            have e := whRedCtx_normal_unique_of_envWfT hW
              hred (whNormalCtx_pi A₁ B₁) hred₁ (whNormalCtx_pi A₁' B₁')
            injection e with eA eB
            subst eA; subst eB
            cases hΓ₁ with
            | assumption _ _ u₁ _ hA₁ =>
                obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hdom hA₁
                have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ u₂ hΓ hA₂
                have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
                obtain ⟨w₂, hB₂_A₁⟩ := tyConvT_endTyped hW hΓ₁' hcod hB₁
                have hB₂ : HasTyT E n (.assumption A₂ :: Γ) B₂ (.sort w₂) :=
                  hasTyT_assump_dom (envClosed_of_envWfT hW) hW hΓ hdom.symmT hA₂ hB₂_A₁
                refine Or.inr ⟨A₂, B₂, w₂, hred₂, ⟨hΓ₂⟩, ⟨hB₂⟩,
                  fun s hs N N' hN₂ hN'₂ hc₂ hrel₂ => ?_⟩
                have hN₁ : HasTyT E n Γ N A₁ := hasTyT_of_tyConv hN₂ hdom.symmT
                have hN'₁ : HasTyT E n Γ N' A₁ := hasTyT_of_tyConv hN'₂ hdom.symmT
                have hc₁ : ConvT E n Γ N N' A₁ := convT_of_tyConv hc₂ hdom.symmT
                have hrel₁ : ∀ v ∈ s.1, LRTermFamIND E n Γ N N' A₁ v :=
                  fun v hv => lrTermFamIND_transport_botDI hW zsc hF v
                    hΓ hA₂ hdom.symmT (hrel₂ v hv)
                have hout₁ := happ s hs N N' hN₁ hN'₁ hc₁ hrel₁
                have hinstTy : HasTyT E n Γ (instantiate0 N B₁) (.sort w) :=
                  hasTyT_subst0_of_envWfT hW hB₁ hN₁
                have hinstConv : TyConvT E n Γ (instantiate0 N B₁) (instantiate0 N B₂) :=
                  tyConvT_subst0_of_envWfT hW hN₁ hcod
                exact lrTermFamIND_transport_botDI hW zsc hF s.2
                  hΓ hinstTy hinstConv hout₁
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Full Symmetry of `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBotDI E n` and `EnvWfT E` Alone (`lrTermFamIND_symm_botDI`):** -/
theorem lrTermFamIND_symm_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINBotDI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M' M A c
  | .bot, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR⟩
  | .pi a f, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR⟩
  | .spine r args, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨hl, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · exact Or.inl ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨hns, Y', Y, hY', hY, hn', hn, ⟨.symm _ _ _ _ hc⟩⟩)
  | .lam g, Γ, hΓ, M, M', A, h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl hprop
      · cases hΓ₁ with
        | assumption _ _ u₁ _ hA₁ =>
            have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
            refine Or.inr ⟨A₁, B₁, w, hred, ⟨hΓ₁'⟩, ⟨hB₁⟩,
              fun s hs N N' hN hN' hc hrel => ?_⟩
            have hc' : ConvT E n Γ N' N A₁ := .symm _ _ _ _ hc
            have hrel' : ∀ v ∈ s.1, LRTermFamIND E n Γ N' N A₁ v :=
              fun v hv => lrTermFamIND_symm_botDI hW zsc hF v hΓ (hrel v hv)
            have hout := happ s hs N' N hN' hN hc' hrel'
            have houtSymm := lrTermFamIND_symm_botDI hW zsc hF s.2 hΓ hout
            have hinstTy : HasTyT E n Γ (instantiate0 N' B₁) (.sort w) :=
              hasTyT_subst0_of_envWfT hW hB₁ hN'
            have hinstConv : TyConvT E n Γ (instantiate0 N' B₁) (instantiate0 N B₁) :=
              .of _ _ _ w (convT_inst0_sortCongr hA₁ hB₁ hN' hN hc')
            exact lrTermFamIND_transport_botDI hW zsc hF s.2
              hΓ hinstTy hinstConv houtSymm
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Full Transitivity of `LRTermFamIND` Across All Compacts `c : CptI` Under
    `FundamentalLRFamINBotDI E n` and `EnvWfT E` Alone (`lrTermFamIND_trans_botDI`):** -/
theorem lrTermFamIND_trans_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINBotDI E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M N P A : Expr Nat},
      LRTermFamIND E n Γ M N A c → LRTermFamIND E n Γ N P A c → LRTermFamIND E n Γ M P A c
  | .bot, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_sort_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR₁ hLR₂⟩
  | .pi a f, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_pi_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR₁ hLR₂⟩
  | .spine r args, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_spine_iff] at h₁ h₂ ⊢
      rcases h₁ with ⟨⟨l, hl⟩, hLR₁⟩ | hprop | ⟨hns, Y₁, Y₂, hM, hN₁, hn₁, hn₂, ⟨hc₁⟩⟩
      · rcases h₂ with ⟨_, hLR₂⟩ | hprop | ⟨hns, _⟩
        · exact Or.inl ⟨⟨l, hl⟩,
            lrTypeFamIN_trans_of_envWfT hW (piRowField_of_fundamentalLRFamINBotDI hW hF) hΓ hLR₁ hLR₂⟩
        · exact Or.inr (Or.inl hprop)
        · exact (hns l hl).elim
      · exact Or.inr (Or.inl hprop)
      · rcases h₂ with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨_, Y₂', Y₃, hN₂, hP, hn₂', hn₃, ⟨hc₂⟩⟩
        · exact (hns l hl).elim
        · exact Or.inr (Or.inl hprop)
        · have e := whRedCtx_normal_unique_of_envWfT hW hN₁ hn₂ hN₂ hn₂'
          subst e
          exact Or.inr (Or.inr ⟨hns, Y₁, Y₃, hM, hP, hn₁, hn₃,
            ⟨.trans _ _ _ _ _ hc₁ hc₂⟩⟩)
  | .lam g, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_lam_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, happ₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨A₂, B₂, _, hred₂, _, _, happ₂⟩
        · exact Or.inl hprop
        · have e := whRedCtx_normal_unique_of_envWfT hW
            hred₁ (whNormalCtx_pi A₁ B₁) hred₂ (whNormalCtx_pi A₂ B₂)
          injection e with eA eB
          subst eA; subst eB
          refine Or.inr ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, fun s hs Q Q' hQ hQ' hcQ hrel => ?_⟩
          have hrelQQ : ∀ v ∈ s.1, LRTermFamIND E n Γ Q Q A₁ v :=
            fun v hv =>
              lrTermFamIND_trans_botDI hW zsc hF v hΓ (hrel v hv)
                (lrTermFamIND_symm_botDI hW zsc hF v hΓ (hrel v hv))
          have hout₁ := happ₁ s hs Q Q hQ hQ (.refl _ _ _ hQ) hrelQQ
          have hout₂ := happ₂ s hs Q Q' hQ hQ' hcQ hrel
          exact lrTermFamIND_trans_botDI hW zsc hF s.2 hΓ hout₁ hout₂
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

