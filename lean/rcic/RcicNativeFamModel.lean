theorem lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.pi .bot []) →
    LRTypeFamIN E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot [])
        (F.1 hΓ hA (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot [])
        (F.2 hΓ hc (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ := lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBotDI hW F hΓ hA c₁ hcA
      have hcM : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) _ (.pi .bot []) :=
        approxDI_ctxEnvDI_right_of_lrTypeFamIN_botFamCpt hW (botFamCpt_pi_bot_nil E) hLR₁
      exact lrTypeFamIN_trans_pi_bot_nil_of_envWfT hW hLR₁
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBotDI hW F hΓ hM c₂ hcM)

/-- Derive `PiRowField E n` from `FundamentalTermFamINDBotDI E n` and `EnvWfT E` **alone**. -/
theorem piRowField_of_fundamentalTermFamINDBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotDI E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamINDBotDI hW F hΓ hPi hc
        (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))

/-- **Full Derivation of `FundamentalLRFamINBotDI E n` from `FundamentalTermFamINDBotDI E n` and
    `EnvWfT E` Alone (`fundamentalLRFamINBotDI_of_fundamentalTermFamINDBotDI`):**
    Requires **zero** `WhDet`, `WhApproxInvCore`, or `TypeSoundness` hypotheses! -/
theorem fundamentalLRFamINBotDI_of_fundamentalTermFamINDBotDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalTermFamINDBotDI E n) :
    FundamentalLRFamINBotDI E n := by
  have hpi : PiRowField E n := piRowField_of_fundamentalTermFamINDBotDI hW F
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A =>
      intro u hA c hcpt hcA
      exact lrTypeFamIN_of_lrTermFamIND_sort c (F.1 hΓ hA c hcpt hcA)
  | of A B v hc =>
      intro _ _ c hcpt hcA
      exact lrTypeFamIN_of_lrTermFamIND_sort c (F.2 hΓ hc c hcpt hcA)
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨v, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxDI_ctxEnvDI_right_of_lrTypeFamIN_botFamCpt hW hcpt r₁
      exact lrTypeFamIN_trans_of_envWfT hW hpi hΓ r₁ (ih₂ hM c hcpt hcM)

