    lrTypeFamIN_famApp_relevantSlotConv hW hm hind
      (lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core hW hdet hcore F hm hind hΓ hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- Shape half of family adequacy from `FundamentalTermFamIN E n` + `WhApproxInvCore E` +
    `WhDet E` alone (with zero `TypeSoundnessI` or `ShallowTypeSoundnessCtxI` premises). -/
theorem adequacyFamShapeICtx_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {A : Expr Nat} {u : Level} (hA : HasTyT E n Γ A (.sort u))
    {args : List CptI} (hc : ApproxI (ctxEnvI Γ) A (.spine r args)) :
    ∃ (ls : List Level) (xs : List (Expr Nat)),
      WhRedCtx E Γ A (foldApps (.const r ls) xs) ∧
      xs.length = (piDomsOf m.mtype).length := by
  have hLR :=
    lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core hW hdet hcore F hm hind hΓ hA (.refl Γ A) hc
  cases hLR with
  | famSpine hm' _ hred _ _ _ _ _ hlen _ _ =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      exact ⟨_, _, hred, hlen⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- **Full Family Adequacy (`AdequacyFamICtx`) from `FundamentalTermFamIN E n` +
    `WhApproxInvCore E` + `WhDet E` Alone:** -/
theorem adequacyFamICtx_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n) :
    AdequacyFamICtx E n := by
  intro Γ hΓ r m hm hind A u hA args hc
  obtain ⟨ls, xs, hred, hlen⟩ :=
    adequacyFamShapeICtx_of_fundamentalTermFamIN_core hW hdet hcore F hΓ hm hind hA hc
  have hc' : ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r args) :=
    (approxI_ctxEnvI_whRedCtx hcore hred (.spine r args)).mp hc
  rcases approxI_foldApps_const_inv hc' with hbot | ⟨cs, heq, hargs⟩
  · exact nomatch hbot
  · injection heq with _ hcs
    subst hcs
    exact ⟨ls, xs, hred, hlen, hargs⟩

