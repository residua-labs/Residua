/-! #### Part A — Exact `EnvI` Weakening & Substitution Algebra for `ctxEnvDI` and Two-Way All-Cutoff Weakening for `WhRedRecKCanon`, `ApproxDIKCanon`, `LRTypeFamINBiRKCanon`, and `LRTypeFamINBiProbeRKCanon` -/

/-- Two-way lifting equivalence for `ApproxDI E` at any insertion index `k` and compact set `S`. -/
theorem approxDI_insert_lift_iff (E : ResolvedEnv) (ρ : EnvI) (k : Nat) (S : CptI → Prop)
    (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (EnvI.insert ρ k S) (lift k 1 e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E ρ e c :=
  ⟨PiModelDeltaIotaAudit.approxDI_lift_elim e,
   fun h => PiModelDeltaIotaAudit.approxDI_lift_intro h k S⟩

/-- Exact denotation equality `denDI E (EnvI.insert ρ k S) (lift k 1 e) = denDI E ρ e`. -/
theorem denDI_insert_lift_eq (E : ResolvedEnv) (ρ : EnvI) (k : Nat) (S : CptI → Prop)
    (e : Expr Nat) :
    PiModelDeltaIotaAudit.denDI E (EnvI.insert ρ k S) (lift k 1 e) =
      PiModelDeltaIotaAudit.denDI E ρ e := by
  funext c
  exact propext (approxDI_insert_lift_iff E ρ k S e c)

/-- Exact denotation substitution equality for `denDI E`. -/
theorem denDI_insert_drop_subst_eq (E : ResolvedEnv) (ρ : EnvI) (j : Nat) (r e : Expr Nat) :
    PiModelDeltaIotaAudit.denDI E ρ (instantiate j (lift 0 j r) e) =
      PiModelDeltaIotaAudit.denDI E
        (EnvI.insert ρ j (PiModelDeltaIotaAudit.denDI E (EnvI.drop ρ j) r)) e := by
  funext c
  exact propext (PiModelDeltaIotaAudit.approxDI_subst_iff E ρ j r e c)

/-- **Exact `EnvI.insert` Decomposition of `ctxEnvDI E (insertAt d k Γ)` (`ctxEnvDI_insertAt_eq`):**
    For every `d : LocalDecl` (both `.assumption` and `.letBinding`) and every `k ≤ Γ.length`,
    `ctxEnvDI E (insertAt d k Γ) = EnvI.insert (ctxEnvDI E Γ) k S` for a compact set `S`. -/
theorem ctxEnvDI_insertAt_eq (E : ResolvedEnv) (d : LocalDecl) :
    ∀ (k : Nat) {Γ : LCtx}, k ≤ Γ.length →
      ∃ S, ctxEnvDI E (insertAt d k Γ) = EnvI.insert (ctxEnvDI E Γ) k S
  | 0, Γ, _ => by
      cases d with
      | assumption A =>
          exact ⟨botSetI, (EnvI.insert_zero botSetI (ctxEnvDI E Γ)).symm⟩
      | letBinding A v =>
          exact ⟨PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v,
            (EnvI.insert_zero _ (ctxEnvDI E Γ)).symm⟩
  | k + 1, [], hk => nomatch hk
  | k + 1, x :: Γ, hk => by
      have hk' : k ≤ Γ.length := by
        simp only [List.length_cons] at hk
        omega
      obtain ⟨S, ih⟩ := ctxEnvDI_insertAt_eq E d k hk'
      refine ⟨S, ?_⟩
      cases x with
      | assumption A =>
          show EnvI.cons botSetI (ctxEnvDI E (insertAt d k Γ)) =
            EnvI.insert (EnvI.cons botSetI (ctxEnvDI E Γ)) (k + 1) S
          rw [ih, EnvI.cons_insert]
      | letBinding A v =>
          show EnvI.cons
              (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E (insertAt d k Γ)) (lift k 1 v))
              (ctxEnvDI E (insertAt d k Γ)) =
            EnvI.insert
              (EnvI.cons (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) (ctxEnvDI E Γ))
              (k + 1) S
          rw [ih, denDI_insert_lift_eq, EnvI.cons_insert]

/-- **All-Cutoff Two-Way `ApproxDI` Weakening Invariance (`approxDI_ctxEnvDI_insertAt_lift_iff`):**
    For every `d : LocalDecl` (both `.assumption` and `.letBinding`) and `k ≤ Γ.length`,
    `ApproxDI E (ctxEnvDI E (insertAt d k Γ)) (lift k 1 e) c ↔ ApproxDI E (ctxEnvDI E Γ) e c`. -/
theorem approxDI_ctxEnvDI_insertAt_lift_iff {E : ResolvedEnv} (d : LocalDecl)
    {k : Nat} {Γ : LCtx} (hk : k ≤ Γ.length) (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (insertAt d k Γ)) (lift k 1 e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c := by
  obtain ⟨S, hEq⟩ := ctxEnvDI_insertAt_eq E d k hk
  rw [hEq]
  exact approxDI_insert_lift_iff E (ctxEnvDI E Γ) k S e c

/-- All-cutoff forward weakening for `ApproxDIKCanon` across every `d : LocalDecl` and `k ≤ Γ.length`. -/
theorem approxDIKCanon_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} (hk : k ≤ Γ.length)
    {e : Expr Nat} {c : CptI} (h : ApproxDIKCanon E Γ e c) :
    ApproxDIKCanon E (insertAt d k Γ) (lift k 1 e) c := by
  rcases h with ⟨X, hred, hX⟩
  exact ⟨lift k 1 X, whRedRecKCanon_lift_of_envClosed hcl hred d k (Or.inl hk),
    (approxDI_ctxEnvDI_insertAt_lift_iff d hk X c).mpr hX⟩

/-- `EnvI.drop` commutes with `substRemove w0 (j + 1) (x :: Γ)` for every `x : LocalDecl`. -/
theorem ctxEnvDI_drop_substRemove_succ (E : ResolvedEnv) (w0 : Expr Nat)
    (j : Nat) (x : LocalDecl) (Γ : LCtx) :
    EnvI.drop (ctxEnvDI E (substRemove w0 (j + 1) (x :: Γ))) (j + 1) =
      EnvI.drop (ctxEnvDI E (substRemove w0 j Γ)) j := by
  cases x with
  | assumption A =>
      exact EnvI.drop_cons botSetI (ctxEnvDI E (substRemove w0 j Γ)) j
  | letBinding A v =>
      exact EnvI.drop_cons
        (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E (substRemove w0 j Γ))
          (instantiate j (lift 0 j w0) v))
        (ctxEnvDI E (substRemove w0 j Γ)) j

/-- **Exact `EnvI.insert` Identity for All-Depth `.letBinding` Substitution (`ctxEnvDI_substLet_eq`):**
    At any `.letBinding t w0` hole `Γ[j]? = some (.letBinding t w0)` and for **every** `w0 : Expr Nat`
    (with zero `.bot` restriction on `w0`), inserting the denotation of `w0` at depth `j` into
    `ctxEnvDI E (substRemove w0 j Γ)` recovers `ctxEnvDI E Γ` identically! -/
theorem ctxEnvDI_substLet_eq (E : ResolvedEnv) (t w0 : Expr Nat) :
    ∀ (j : Nat) {Γ : LCtx}, Γ[j]? = some (.letBinding t w0) →
      EnvI.insert (ctxEnvDI E (substRemove w0 j Γ)) j
        (PiModelDeltaIotaAudit.denDI E
          (EnvI.drop (ctxEnvDI E (substRemove w0 j Γ)) j) w0) =
        ctxEnvDI E Γ
  | 0, [], hget => nomatch hget
  | 0, x :: Γ, hget => by
      rw [List.getElem?_cons_zero] at hget
      injection hget with hx
      subst hx
      simp only [substRemove_zero_cons, EnvI.drop_zero, EnvI.insert_zero,
        ctxEnvDI_cons_letBinding]
  | j + 1, [], hget => nomatch hget
  | j + 1, x :: Γ, hget => by
      rw [List.getElem?_cons_succ] at hget
      have ih := ctxEnvDI_substLet_eq E t w0 j hget
      rw [ctxEnvDI_drop_substRemove_succ]
      cases x with
      | assumption A =>
          show EnvI.insert (EnvI.cons botSetI (ctxEnvDI E (substRemove w0 j Γ))) (j + 1) _ =
            EnvI.cons botSetI (ctxEnvDI E Γ)
          rw [← EnvI.cons_insert, ih]
      | letBinding A v =>
          show EnvI.insert
              (EnvI.cons
                (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E (substRemove w0 j Γ))
                  (instantiate j (lift 0 j w0) v))
                (ctxEnvDI E (substRemove w0 j Γ)))
              (j + 1) _ =
            EnvI.cons (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) (ctxEnvDI E Γ)
          rw [← EnvI.cons_insert, denDI_insert_drop_subst_eq, ih]

/-- **All-Depth Two-Way `ApproxDI` `.letBinding` Substitution Equivalence (`approxDI_ctxEnvDI_substLet_iff`):**
    For **every** `w0 : Expr Nat` and `Γ[j]? = some (.letBinding t w0)`,
    `ApproxDI E (ctxEnvDI E (substRemove w0 j Γ)) (instantiate j (lift 0 j w0) e) c ↔
     ApproxDI E (ctxEnvDI E Γ) e c`! -/
theorem approxDI_ctxEnvDI_substLet_iff {E : ResolvedEnv} {t w0 : Expr Nat}
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove w0 j Γ))
      (instantiate j (lift 0 j w0) e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c := by
  rw [PiModelDeltaIotaAudit.approxDI_subst_iff, ctxEnvDI_substLet_eq E t w0 j hget]

/-- All-depth `.letBinding` substitution preserves `ApproxDIKCanon` for **every** `w0 : Expr Nat`. -/
theorem approxDIKCanon_substLet_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {t w0 : Expr Nat} {j : Nat} {Γ : LCtx}
    (hget : Γ[j]? = some (.letBinding t w0))
    {e : Expr Nat} {c : CptI} (h : ApproxDIKCanon E Γ e c) :
    ApproxDIKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) e) c := by
  rcases h with ⟨X, hred, hX⟩
  exact ⟨instantiate j (lift 0 j w0) X,
    whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hred,
    (approxDI_ctxEnvDI_substLet_iff hget X c).mpr hX⟩

/-- **Exact `EnvI.insert` Identity for All-Depth `.assumption` Substitution of `.bot`-Denoting
    Terms (`ctxEnvDI_substAssump_eq`):** -/
theorem ctxEnvDI_substAssump_eq (E : ResolvedEnv) (t v : Expr Nat) :
    ∀ (j : Nat) {Γ : LCtx}, Γ[j]? = some (.assumption t) →
      PiModelDeltaIotaAudit.denDI E
        (EnvI.drop (ctxEnvDI E (substRemove v j Γ)) j) v = botSetI →
      EnvI.insert (ctxEnvDI E (substRemove v j Γ)) j
        (PiModelDeltaIotaAudit.denDI E
          (EnvI.drop (ctxEnvDI E (substRemove v j Γ)) j) v) =
        ctxEnvDI E Γ
  | 0, [], hget, _ => nomatch hget
  | 0, x :: Γ, hget, hbot => by
      rw [List.getElem?_cons_zero] at hget
      injection hget with hx
      subst hx
      simp only [substRemove_zero_cons, EnvI.drop_zero] at hbot ⊢
      rw [hbot, EnvI.insert_zero, ctxEnvDI_cons_assumption]
  | j + 1, [], hget, _ => nomatch hget
  | j + 1, x :: Γ, hget, hbot => by
      rw [List.getElem?_cons_succ] at hget
      rw [ctxEnvDI_drop_substRemove_succ] at hbot ⊢
      have ih := ctxEnvDI_substAssump_eq E t v j hget hbot
      cases x with
      | assumption A =>
          show EnvI.insert (EnvI.cons botSetI (ctxEnvDI E (substRemove v j Γ))) (j + 1) _ =
            EnvI.cons botSetI (ctxEnvDI E Γ)
          rw [← EnvI.cons_insert, ih]
      | letBinding A w =>
          show EnvI.insert
              (EnvI.cons
                (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E (substRemove v j Γ))
                  (instantiate j (lift 0 j v) w))
                (ctxEnvDI E (substRemove v j Γ)))
              (j + 1) _ =
            EnvI.cons (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) w) (ctxEnvDI E Γ)
          rw [← EnvI.cons_insert, denDI_insert_drop_subst_eq, ih]

theorem denDI_drop_eq_botSetI_of_lift_bot {E : ResolvedEnv} {ρ : EnvI} {j : Nat} {v : Expr Nat}
    (h : ∀ c, PiModelDeltaIotaAudit.ApproxDI E ρ (lift 0 j v) c → c = .bot) :
    PiModelDeltaIotaAudit.denDI E (EnvI.drop ρ j) v = botSetI := by
  funext c
  exact propext ⟨fun hc => h c (PiModelDeltaIotaAudit.approxDI_liftN_intro ρ j hc),
    fun hc => by rcases hc with rfl; exact .bot _ _⟩

/-- Two-way `ApproxDI` equivalence for all-depth `.assumption` substitution of any `.bot`-denoting
    substituent `v`. -/
theorem approxDI_ctxEnvDI_substAssump_iff {E : ResolvedEnv} {t v : Expr Nat}
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hbot : ∀ c, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove v j Γ))
      (lift 0 j v) c → c = .bot)
    (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove v j Γ))
      (instantiate j (lift 0 j v) e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c := by
  rw [PiModelDeltaIotaAudit.approxDI_subst_iff,
      ctxEnvDI_substAssump_eq E t v j hget (denDI_drop_eq_botSetI_of_lift_bot hbot)]

/-- All-depth assumption-spine substitution preserves `ApproxDIKCanon` under `EnvClosed E`. -/
theorem approxDIKCanon_subst_bvarSpine_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {t : Expr Nat} {j m_var : Nat} {vargs : List (Expr Nat)} {Γ : LCtx}
    (hget : Γ[j]? = some (.assumption t))
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
    {e : Expr Nat} {c : CptI} (h : ApproxDIKCanon E Γ e c) :
    ApproxDIKCanon E (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) e) c := by
  let v := foldApps (.bvar m_var) vargs
  rcases h with ⟨X, hred, hX⟩
  have hbot : ∀ u, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove v j Γ))
      (lift 0 j v) u → u = .bot := by
    intro u hu
    have hlift : lift 0 j v = foldApps (.bvar (m_var + j)) (vargs.map (lift 0 j)) := by
      change lift 0 j (foldApps (.bvar m_var) vargs) = _
      rw [lift_foldApps]
      simp only [lift, if_pos (Nat.zero_le m_var)]
    rw [hlift] at hu
    exact approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hnone (vargs.map (lift 0 j)) hu
  exact ⟨instantiate j (lift 0 j v) X,
    whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hred,
    (approxDI_ctxEnvDI_substAssump_iff hget hbot X c).mpr hX⟩

/-- Any index `i ≥ Γ.length` has `lookupValue Γ i = none`. -/
theorem lookupValue_of_length_le :
    ∀ (Γ : LCtx) {i : Nat}, Γ.length ≤ i → lookupValue Γ i = none
  | [], i, _ => by cases i <;> rfl
  | _ :: _, 0, h => nomatch h
  | _ :: Γ, i + 1, h => by
      have h' : Γ.length ≤ i := by
        simp only [List.length_cons] at h
        omega
      rw [lookupValue_cons_succ, lookupValue_of_length_le Γ h']
      rfl

theorem lookupValue_length_none (Γ : LCtx) : lookupValue Γ Γ.length = none :=
  lookupValue_of_length_le Γ (Nat.le_refl _)

/-- `(insertAt d k Γ)[k]? = some d` for every `k ≤ Γ.length`. -/
theorem getElem?_insertAt_self (d : LocalDecl) :
    ∀ {k : Nat} {Γ : LCtx}, k ≤ Γ.length → (insertAt d k Γ)[k]? = some d
  | 0, _, _ => by simp
  | _ + 1, [], hk => nomatch hk
  | k + 1, _ :: Γ, hk => by
      have hk' : k ≤ Γ.length := by
        simp only [List.length_cons] at hk
        omega
      rw [insertAt_succ_cons, List.getElem?_cons_succ]
      exact getElem?_insertAt_self d hk'

/-- `instDecl k v (liftDecl k x) = x` for every `k`, `v`, and `x`. -/
theorem instDecl_liftDecl_cancel (k : Nat) (v : Expr Nat) (x : LocalDecl) :
    instDecl k v (liftDecl k x) = x := by
  cases x with
  | assumption A =>
      simp only [liftDecl, instDecl, instantiate_lift_id]
  | letBinding A w =>
      simp only [liftDecl, instDecl, instantiate_lift_id]

/-- `substRemove v k (insertAt d k Γ) = Γ` for every `k ≤ Γ.length`, `d`, and `v`. -/
theorem substRemove_insertAt_cancel (v : Expr Nat) (d : LocalDecl) :
    ∀ {k : Nat} {Γ : LCtx}, k ≤ Γ.length → substRemove v k (insertAt d k Γ) = Γ
  | 0, _, _ => rfl
  | _ + 1, [], hk => nomatch hk
  | k + 1, _ :: Γ, hk => by
      have hk' : k ≤ Γ.length := by
        simp only [List.length_cons] at hk
        omega
      rw [insertAt_succ_cons, substRemove_succ_cons,
          instDecl_liftDecl_cancel, substRemove_insertAt_cancel v d hk']

/-- **Two-Way All-Cutoff Weakening Equivalence for `WhRedRecKCanon` (`whRedRecKCanon_lift_iff`):**
    For **every** `d : LocalDecl` (both `.assumption` and `.letBinding`) and **every** `k ≤ Γ.length`,
    `WhRedRecKCanon E (insertAt d k Γ) (lift k 1 a) (lift k 1 b) ↔ WhRedRecKCanon E Γ a b` under
    `EnvClosed E` alone! -/
theorem whRedRecKCanon_lift_iff {E : ResolvedEnv} (hcl : EnvClosed E)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} (hk : k ≤ Γ.length)
    (a b : Expr Nat) :
    WhRedRecKCanon E (insertAt d k Γ) (lift k 1 a) (lift k 1 b) ↔
      WhRedRecKCanon E Γ a b := by
  constructor
  · intro h
    cases d with
    | assumption t =>
        have hget := getElem?_insertAt_self (.assumption t) hk
        have hnone : lookupValue (substRemove (foldApps (.bvar Γ.length) []) k
            (insertAt (.assumption t) k Γ)) (Γ.length + k) = none := by
          rw [substRemove_insertAt_cancel _ _ hk]
          exact lookupValue_of_length_le Γ (by omega)
        have h0 := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h
        rwa [substRemove_insertAt_cancel _ _ hk,
             instantiate_lift_id, instantiate_lift_id] at h0
    | letBinding t w0 =>
        have hget := getElem?_insertAt_self (.letBinding t w0) hk
        have h0 := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h
        rwa [substRemove_insertAt_cancel _ _ hk,
             instantiate_lift_id, instantiate_lift_id] at h0
  · intro h
    exact whRedRecKCanon_lift_of_envClosed hcl h d k (Or.inl hk)

/-- **Two-Way All-Cutoff Weakening Equivalence for `ApproxDIKCanon` (`approxDIKCanon_lift_iff`):**
    For **every** `d : LocalDecl` (both `.assumption` and `.letBinding`) and **every** `k ≤ Γ.length`,
    `ApproxDIKCanon E (insertAt d k Γ) (lift k 1 e) c ↔ ApproxDIKCanon E Γ e c` under `EnvClosed E`
    alone! -/
theorem approxDIKCanon_lift_iff {E : ResolvedEnv} (hcl : EnvClosed E)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} (hk : k ≤ Γ.length)
    (e : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (insertAt d k Γ) (lift k 1 e) c ↔ ApproxDIKCanon E Γ e c := by
  constructor
  · intro h
    cases d with
    | assumption t =>
        have hget := getElem?_insertAt_self (.assumption t) hk
        have hnone : lookupValue (substRemove (foldApps (.bvar Γ.length) []) k
            (insertAt (.assumption t) k Γ)) (Γ.length + k) = none := by
          rw [substRemove_insertAt_cancel _ _ hk]
          exact lookupValue_of_length_le Γ (by omega)
        have h0 := approxDIKCanon_subst_bvarSpine_of_envClosed hcl hget hnone h
        rwa [substRemove_insertAt_cancel _ _ hk, instantiate_lift_id] at h0
    | letBinding t w0 =>
        have hget := getElem?_insertAt_self (.letBinding t w0) hk
        have h0 := approxDIKCanon_substLet_of_envClosed hcl hget h
        rwa [substRemove_insertAt_cancel _ _ hk, instantiate_lift_id] at h0
  · exact approxDIKCanon_lift_of_envClosed hcl d hk

theorem approxDIKCanon_lift0_one_assumption_iff {E : ResolvedEnv} (hcl : EnvClosed E)
    (Γ : LCtx) (t e : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (.assumption t :: Γ) (lift 0 1 e) c ↔ ApproxDIKCanon E Γ e c :=
  approxDIKCanon_lift_iff hcl (.assumption t) (Nat.zero_le _) e c

theorem approxDIKCanon_lift0_one_iff {E : ResolvedEnv} (hcl : EnvClosed E)
    (Γ : LCtx) (d : LocalDecl) (e : Expr Nat) (c : CptI) :
    ApproxDIKCanon E (d :: Γ) (lift 0 1 e) c ↔ ApproxDIKCanon E Γ e c :=
  approxDIKCanon_lift_iff hcl d (Nat.zero_le _) e c

/-- **All-Cutoff Weakening for `LRTypeFamINBiRKCanon` (`lrTypeFamINBiRKCanon_weaken_of_envClosed`):**
    Because `approxDIKCanon_lift_iff` is two-way for every `d : LocalDecl` and `k ≤ Γ.length`,
    `LRTypeFamINBiRKCanon` weakens across **all** `d : LocalDecl` (both `.assumption` and
    `.letBinding`) and **all** `k ≤ Γ.length`! -/
theorem lrTypeFamINBiRKCanon_weaken_of_envClosed {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (d : LocalDecl) {k : Nat} {Γ : LCtx}
    (hk : k ≤ Γ.length) (hΓ' : CtxWfT E n (insertAt d k Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiRKCanon E n Γ A A') :
    LRTypeFamINBiRKCanon E n (insertAt d k Γ) (lift k 1 A) (lift k 1 A') := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDIKCanon_lift_iff hcl d hk A c).mp hL)
    · exact Or.inr ((approxDIKCanon_lift_iff hcl d hk A' c).mp hR)
  exact lrTypeFamINRKCanon_weaken_botFamCpt hcl hc d k (Or.inl hk) hΓ' (h c hc happrox')

theorem lrTypeFamINBiProbeRKCanon_weaken_of_envClosed {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (d : LocalDecl) {k : Nat} {Γ : LCtx}
    (hk : k ≤ Γ.length) (hΓ' : CtxWfT E n (insertAt d k Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiProbeRKCanon E n Γ A A') :
    LRTypeFamINBiProbeRKCanon E n (insertAt d k Γ) (lift k 1 A) (lift k 1 A') := by
  intro c hc happrox
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDIKCanon_lift_iff hcl d hk A c).mp hL)
    · exact Or.inr ((approxDIKCanon_lift_iff hcl d hk A' c).mp hR)
  exact lrTypeFamINRKCanon_weaken_famProbeCpt hcl hc d k (Or.inl hk) hΓ' (h c hc happrox')

theorem lrTypeFamINBiRKCanon_weaken0 {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (d : LocalDecl) {Γ : LCtx}
    (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiRKCanon E n Γ A A') :
    LRTypeFamINBiRKCanon E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') :=
  lrTypeFamINBiRKCanon_weaken_of_envClosed hcl d (Nat.zero_le _) hΓ' h

theorem lrTypeFamINBiProbeRKCanon_weaken0 {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (d : LocalDecl) {Γ : LCtx}
    (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiProbeRKCanon E n Γ A A') :
    LRTypeFamINBiProbeRKCanon E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') :=
  lrTypeFamINBiProbeRKCanon_weaken_of_envClosed hcl d (Nat.zero_le _) hΓ' h

/-- All-depth `.letBinding` substitution for `LRTypeFamINBiRKCanon` via `ApproxDI`. -/
theorem lrTypeFamINBiRKCanon_substLet_of_approxDI {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    (hΓ' : CtxWfT E n (substRemove w0 j Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiRKCanon E n Γ A A')
    {c : CptI} (hc : BotFamCpt E c)
    (happrox :
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove w0 j Γ))
        (instantiate j (lift 0 j w0) A) c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove w0 j Γ))
        (instantiate j (lift 0 j w0) A') c) :
    LRTypeFamINRKCanon E n (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) A) (instantiate j (lift 0 j w0) A') c := by
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl (approxDIKCanon_of_approxDI
        ((approxDI_ctxEnvDI_substLet_iff hget A c).mp hL))
    · exact Or.inr (approxDIKCanon_of_approxDI
        ((approxDI_ctxEnvDI_substLet_iff hget A' c).mp hR))
  exact lrTypeFamINRKCanon_substLet_botFamCpt hcl hinst t w0 hc hget hvty hΓ' (h c hc happrox')

/-- All-depth `.bvar`-spine substitution for `LRTypeFamINBiRKCanon` via `ApproxDI`. -/
theorem lrTypeFamINBiRKCanon_subst_bvarSpine_of_approxDI {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    (m_var : Nat) (vargs : List (Expr Nat)) (t : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
    (hvty : HasTyT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j t))
    (hΓ' : CtxWfT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiRKCanon E n Γ A A')
    {c : CptI} (hc : BotFamCpt E c)
    (happrox :
      PiModelDeltaIotaAudit.ApproxDI E
        (ctxEnvDI E (substRemove (foldApps (.bvar m_var) vargs) j Γ))
        (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A) c ∨
      PiModelDeltaIotaAudit.ApproxDI E
        (ctxEnvDI E (substRemove (foldApps (.bvar m_var) vargs) j Γ))
        (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A') c) :
    LRTypeFamINRKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A') c := by
  let v := foldApps (.bvar m_var) vargs
  have hbot : ∀ u, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (substRemove v j Γ))
      (lift 0 j v) u → u = .bot := by
    intro u hu
    have hlift : lift 0 j v = foldApps (.bvar (m_var + j)) (vargs.map (lift 0 j)) := by
      change lift 0 j (foldApps (.bvar m_var) vargs) = _
      rw [lift_foldApps]
      simp only [lift, if_pos (Nat.zero_le m_var)]
    rw [hlift] at hu
    exact approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hnone (vargs.map (lift 0 j)) hu
  have happrox' : ApproxDIKCanon E Γ A c ∨ ApproxDIKCanon E Γ A' c := by
    rcases happrox with hL | hR
    · exact Or.inl (approxDIKCanon_of_approxDI
        ((approxDI_ctxEnvDI_substAssump_iff hget hbot A c).mp hL))
    · exact Or.inr (approxDIKCanon_of_approxDI
        ((approxDI_ctxEnvDI_substAssump_iff hget hbot A' c).mp hR))
  exact lrTypeFamINRKCanon_subst_bvarSpine_botFamCpt hcl hinst m_var vargs t hc
    hget hnone hvty hΓ' (h c hc happrox')


/-! #### Part B — `ZeroSortCoherence`-Free Semantic Proposition Classifier `IsSemRigidPropRecKCanon` -/

/-- **`ZeroSortCoherence`-Free Semantic Proposition Classifier Over `WhRedRecKCanon`
    (`IsSemRigidPropRecKCanon E n Γ A`):**
    `A` is `TyConvT`-convertible to some `P` with `HasTyT E n Γ P (.sort .zero)` (`Prop`) and
    reduces under `WhRedRecKCanon E Γ` either to a `.pi A₁ B₁` or to a saturated admitted
    `.inductiveM` family spine `foldApps (.const r ls) xs` (`xs.length = (piDomsOf m.mtype).length`).
    Unlike `IsRigidPropRecKCanon` and `IsNonSortPropRecKCanon`, `IsSemRigidPropRecKCanon` transports
    along `TyConvT E n Γ A A'` using **only** `LRTypeFamINBiProbeRKCanon E n Γ A A'` and `EnvWfT E`
    (with **zero** `ZeroSortCoherence E n` and **zero** `FundamentalLRFamINProbeRKCanon E n`!). -/
def IsSemRigidPropRecKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A : Expr Nat) : Prop :=
  (∃ P : Expr Nat, Nonempty (HasTyT E n Γ P (.sort .zero)) ∧ Nonempty (TyConvT E n Γ P A)) ∧
    ((∃ A₁ B₁, WhRedRecKCanon E Γ A (.pi A₁ B₁)) ∨
     (∃ r m ls xs, E.members r = some m ∧ m.mclass = .inductiveM ∧
       xs.length = (piDomsOf m.mtype).length ∧
       WhRedRecKCanon E Γ A (foldApps (.const r ls) xs)))

theorem isSemRigidPropRecKCanon_of_isRigidPropRecKCanon {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) :
    IsSemRigidPropRecKCanon E n Γ A :=
  ⟨⟨A, h.1, ⟨.refl Γ A⟩⟩, h.2⟩

theorem isSemRigidPropRecKCanon_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ : Expr Nat}
    (h0 : HasTyT E n Γ (.pi A₁ B₁) (.sort .zero)) :
    IsSemRigidPropRecKCanon E n Γ (.pi A₁ B₁) :=
  isSemRigidPropRecKCanon_of_isRigidPropRecKCanon (isRigidPropRecKCanon_pi h0)

theorem isSemRigidPropRecKCanon_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsSemRigidPropRecKCanon E n Γ (foldApps (.const r ls) xs) :=
  isSemRigidPropRecKCanon_of_isRigidPropRecKCanon (isRigidPropRecKCanon_famApp hm hind hlen h0)

theorem isSemRigidPropRecKCanon_famApp_of_probeRKCanon {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINProbeRKCanon E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsSemRigidPropRecKCanon E n Γ (foldApps (.const r ls) xs) :=
  isSemRigidPropRecKCanon_of_isRigidPropRecKCanon
    (isRigidPropRecKCanon_famApp_of_probeRKCanon hW F hΓ hm hind h0)

/-- No `.sort u` satisfies `IsSemRigidPropRecKCanon` (with **zero** hypotheses!). -/
theorem not_isSemRigidPropRecKCanon_sort (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (u : Level) :
    ¬ IsSemRigidPropRecKCanon E n Γ (.sort u) := by
  rintro ⟨_, ⟨A₁, B₁, hpi⟩ | ⟨r, _, ls, xs, _, _, _, hfam⟩⟩
  · exact Expr.noConfusion (whRedRecKCanon_sort_eq hpi)
  · exact foldApps_const_ne_sort r ls xs u (whRedRecKCanon_sort_eq hfam)

/-- Under `EnvWfT E` alone, no `A` with `WhRedRecKCanon E Γ A (.sort u)` satisfies
    `IsSemRigidPropRecKCanon E n Γ A`. -/
theorem not_isSemRigidPropRecKCanon_of_whRed_sort {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A : Expr Nat} {u : Level}
    (hsort : WhRedRecKCanon E Γ A (.sort u)) :
    ¬ IsSemRigidPropRecKCanon E n Γ A := by
  rintro ⟨_, ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, _, hfam⟩⟩
  · have e := whRedRecKCanon_normal_unique_of_envWfT hW
      hsort (whNormalRecKCanon_sort u) hpi (whNormalRecKCanon_pi A₁ B₁)
    exact Expr.noConfusion e
  · have e := whRedRecKCanon_normal_unique_of_envWfT hW
      hsort (whNormalRecKCanon_sort u) hfam (whNormalRecKCanon_famApp hW hm hind ls xs)
    exact foldApps_const_ne_sort r ls xs u e.symm

/-- `IsSemRigidPropRecKCanon` is constructively preserved under all-cutoff weakening
    `insertAt d k Γ` / `lift k 1`. -/
theorem isSemRigidPropRecKCanon_weaken {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    (d : LocalDecl) (k : Nat) {Γ : LCtx}
    (hk : k ≤ Γ.length ∨ ∃ B, d = .assumption B)
    {A : Expr Nat} (h : IsSemRigidPropRecKCanon E n Γ A) :
    IsSemRigidPropRecKCanon E n (insertAt d k Γ) (lift k 1 A) := by
  obtain ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hshape⟩ := h
  refine ⟨⟨lift k 1 P, ⟨hasTyTWeaken d hcl (c := k) hP⟩,
    ⟨tyConvTWeaken d hcl (c := k) hcPA⟩⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨lift k 1 A₁, lift (k + 1) 1 B₁,
      whRedRecKCanon_lift_of_envClosed hcl hpi d k hk⟩
  · refine Or.inr ⟨r, m, ls, xs.map (lift k 1), hm, hind, by rw [List.length_map, hlen], ?_⟩
    have h0 := whRedRecKCanon_lift_of_envClosed hcl hfam d k hk
    rwa [foldApps_lift] at h0

/-- `IsSemRigidPropRecKCanon` is constructively preserved under all-depth `.letBinding` substitution
    `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` for **every** `w0 : Expr Nat`! -/
theorem isSemRigidPropRecKCanon_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    {A : Expr Nat} (h : IsSemRigidPropRecKCanon E n Γ A) :
    IsSemRigidPropRecKCanon E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A) := by
  obtain ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hshape⟩ := h
  refine ⟨⟨instantiate j (lift 0 j w0) P,
    ⟨hasTyT_substLetS hcl hinst t w0 hP hget hvty⟩,
    ⟨tyConvT_substLetS hcl hinst t w0 hcPA hget hvty⟩⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j w0) A₁,
      instantiate (j + 1) (lift 0 1 (lift 0 j w0)) B₁,
      whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hpi⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j w0)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hfam
    rwa [instantiate_famApp] at hr

/-- `IsSemRigidPropRecKCanon` is constructively preserved under assumption-spine substitution
    `substRemove (foldApps (.bvar m_var) vargs) j Γ`. -/
theorem isSemRigidPropRecKCanon_subst_bvarSpine {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    (m_var : Nat) (vargs : List (Expr Nat)) (t : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
    (hvty : HasTyT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j t))
    {A : Expr Nat} (h : IsSemRigidPropRecKCanon E n Γ A) :
    IsSemRigidPropRecKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A) := by
  let v := foldApps (.bvar m_var) vargs
  obtain ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hshape⟩ := h
  refine ⟨⟨instantiate j (lift 0 j v) P,
    ⟨hasTyT_substS hcl hinst v t hP hget hvty⟩,
    ⟨tyConvT_substS hcl hinst v t hcPA hget hvty⟩⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j v) A₁,
      instantiate (j + 1) (lift 0 1 (lift 0 j v)) B₁,
      whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hpi⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j v)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hfam
    rwa [instantiate_famApp] at hr

/-- Two-way head `.letBinding` weakening equivalence (`↔`) for `IsSemRigidPropRecKCanon`. -/
theorem isSemRigidPropRecKCanon_weaken0_letBinding_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx}
    {t w0 : Expr Nat} (hw0 : HasTyT E n Γ w0 t) (A : Expr Nat) :
    IsSemRigidPropRecKCanon E n (.letBinding t w0 :: Γ) (lift 0 1 A) ↔
      IsSemRigidPropRecKCanon E n Γ A := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  constructor
  · intro h
    have hget0 : (LocalDecl.letBinding t w0 :: Γ)[0]? = some (.letBinding t w0) := by simp
    have h0 := isSemRigidPropRecKCanon_substLet hcl hinst t w0 hget0
      (by simpa only [substRemove_zero_cons, lift_zero] using hw0) h
    rwa [substRemove_zero_cons, lift_zero,
         instantiate_lift_cancel 1 0 0 w0 (by omega) (by omega),
         Nat.sub_self, lift_zero] at h0
  · exact isSemRigidPropRecKCanon_weaken hcl (.letBinding t w0) 0 (Or.inl (Nat.zero_le _))

/-- **`ZeroSortCoherence`-Free Local Transport of `IsSemRigidPropRecKCanon` Along `TyConvT`
    (`isSemRigidPropRecKCanon_transport_of_typeRel`):**
    Requires **only** `EnvWfT E`, `TyConvT E n Γ A A'`, and `LRTypeFamINBiProbeRKCanon E n Γ A A'`
    (zero `ZeroSortCoherence E n`, zero `FundamentalLRFamINProbeRKCanon E n`, and zero `CtxWfT`)! -/
theorem isSemRigidPropRecKCanon_transport_of_typeRel {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A A' : Expr Nat}
    (hcAA' : TyConvT E n Γ A A')
    (hrelAA' : LRTypeFamINBiProbeRKCanon E n Γ A A')
    (h : IsSemRigidPropRecKCanon E n Γ A) :
    IsSemRigidPropRecKCanon E n Γ A' := by
  obtain ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hshape⟩ := h
  refine ⟨⟨P, ⟨hP⟩, ⟨.trans Γ P A A' hcPA hcAA'⟩⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · have hcA : ApproxDIKCanon E Γ A (.pi .bot []) :=
      approxDIKCanon_of_whRedRecKCanon hpi (approxDIKCanon_pi_bot_nil E Γ A₁ B₁)
    cases hrelAA' (.pi .bot []) .pi_bot_nil (Or.inl hcA) with
    | pi _ hpi' _ _ _ _ _ => exact Or.inl ⟨_, _, hpi'⟩
  · have hcA : ApproxDIKCanon E Γ A (.spine r (botVecI xs)) :=
      approxDIKCanon_of_whRedRecKCanon hfam
        (approxDIKCanon_famApp_botVecI_of_inductiveM hW Γ hm hind ls xs)
    cases hrelAA' (.spine r (botVecI xs)) (famProbeCpt_famSpine_botVecI hm hind hlen)
      (Or.inl hcA) with
    | famSpine hm' hind' _ hfam' _ _ _ _ _ hlen' _ =>
        exact Or.inr ⟨r, _, _, _, hm', hind', hlen', hfam'⟩
    | otherSpine hnot _ _ _ _ _ =>
        exact (hnot m hm hind).elim


/-! #### Part C — `ZeroSortCoherence`-Free Term Logical Relation `LRTermFamSemRKCanon` & `LRTermFamSemBiProbeRKCanon` With Unconditional All-Type PER and Local Index Transport -/

/-- **`ZeroSortCoherence`-Free Term Logical Relation Over `WhRedRecKCanon`
    (`LRTermFamSemRKCanon E n Γ M M' A c`):**
    - At `c = .bot`: `True`.
    - At any `c ≠ .bot`: `IsSemRigidPropRecKCanon E n Γ A` (proof irrelevance at rigid propositions)
      or `((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' c)` (type-level
      logical relation at sort-classified types). -/
def LRTermFamSemRKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | c =>
      IsSemRigidPropRecKCanon E n Γ A ∨
        ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' c)

@[simp] theorem lrTermFamSemRKCanon_bot (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (M M' A : Expr Nat) :
    LRTermFamSemRKCanon E n Γ M M' A .bot := trivial

theorem lrTermFamSemRKCanon_of_ne_bot_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' A : Expr Nat} {c : CptI} (hc : c ≠ .bot) :
    LRTermFamSemRKCanon E n Γ M M' A c ↔
      (IsSemRigidPropRecKCanon E n Γ A ∨
        ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' c)) := by
  cases c with
  | bot => exact (hc rfl).elim
  | sort | pi _ _ | lam _ | spine _ _ => rfl

theorem lrTermFamSemRKCanon_of_isSemRigidPropRecKCanon {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' A : Expr Nat} (h : IsSemRigidPropRecKCanon E n Γ A) (c : CptI) :
    LRTermFamSemRKCanon E n Γ M M' A c := by
  cases c <;> first | exact trivial | exact Or.inl h

theorem lrTermFamSemRKCanon_of_isRigidPropRecKCanon {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) (c : CptI) :
    LRTermFamSemRKCanon E n Γ M M' A c :=
  lrTermFamSemRKCanon_of_isSemRigidPropRecKCanon
    (isSemRigidPropRecKCanon_of_isRigidPropRecKCanon h) c

theorem lrTermFamSemRKCanon_of_lrTypeFamINRKCanon_of_whRed_sort {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} {l : Level}
    (hA : WhRedRecKCanon E Γ A (.sort l)) {c : CptI}
    (hLR : LRTypeFamINRKCanon E n Γ M M' c) :
    LRTermFamSemRKCanon E n Γ M M' A c := by
  cases c <;> first | exact trivial | exact Or.inr ⟨⟨l, hA⟩, hLR⟩

/-- At `A = .sort u`, `LRTermFamSemRKCanon E n Γ M M' (.sort u) c` is logically equivalent (`↔`) to
    `LRTypeFamINRKCanon E n Γ M M' c` with **zero** hypotheses! -/
theorem lrTermFamSemRKCanon_sort_iff_lrTypeFamINRKCanon {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} (M M' : Expr Nat) (u : Level) (c : CptI) :
    LRTermFamSemRKCanon E n Γ M M' (.sort u) c ↔ LRTypeFamINRKCanon E n Γ M M' c := by
  cases c with
  | bot => exact ⟨fun _ => .bot _ _ _, fun _ => trivial⟩
  | sort | pi _ _ | lam _ | spine _ _ =>
      exact ⟨fun h => h.elim (fun hp => (not_isSemRigidPropRecKCanon_sort E n Γ u hp).elim) And.right,
             fun h => Or.inr ⟨⟨u, .refl _⟩, h⟩⟩

/-- Under `EnvWfT E` alone, at any `A` with `WhRedRecKCanon E Γ A (.sort u)`,
    `LRTermFamSemRKCanon E n Γ M M' A c ↔ LRTypeFamINRKCanon E n Γ M M' c`. -/
theorem lrTermFamSemRKCanon_whRed_sort_iff_lrTypeFamINRKCanon {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A : Expr Nat} {u : Level}
    (hA : WhRedRecKCanon E Γ A (.sort u)) (c : CptI) :
    LRTermFamSemRKCanon E n Γ M M' A c ↔ LRTypeFamINRKCanon E n Γ M M' c := by
  cases c with
  | bot => exact ⟨fun _ => .bot _ _ _, fun _ => trivial⟩
  | sort | pi _ _ | lam _ | spine _ _ =>
      exact ⟨fun h => h.elim (fun hp => (not_isSemRigidPropRecKCanon_of_whRed_sort hW hA hp).elim) And.right,
             fun h => Or.inr ⟨⟨u, hA⟩, h⟩⟩

theorem lrTermFamSemRKCanon_sort_iff_lrTermFamINDRKCanon {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} (M M' : Expr Nat) (u : Level) (c : CptI) :
    LRTermFamSemRKCanon E n Γ M M' (.sort u) c ↔
      LRTermFamINDRKCanon E n Γ M M' (.sort u) c :=
  (lrTermFamSemRKCanon_sort_iff_lrTypeFamINRKCanon M M' u c).trans
    (lrTermFamINDRKCanon_sort_iff_lrTypeFamINRKCanon u c).symm

/-- **Unconditional Symmetry of `LRTermFamSemRKCanon` Across All Compacts `c : CptI` Under
    `EnvWfT E` and `CtxWfT E n Γ` Alone (`lrTermFamSemRKCanon_symm_of_envWfT`):**
    Requires **zero** `ZeroSortCoherence E n` and **zero** `FundamentalLRFamINProbeRKCanon E n`! -/
theorem lrTermFamSemRKCanon_symm_of_envWfT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M M' A : Expr Nat} (c : CptI)
    (h : LRTermFamSemRKCanon E n Γ M M' A c) :
    LRTermFamSemRKCanon E n Γ M' M A c := by
  cases c with
  | bot => exact trivial
  | sort | pi _ _ | lam _ | spine _ _ =>
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
