    ⟨mixAndFamTy⟩ ⟨mixAndMkTy2⟩ ⟨mixTyH⟩

theorem whNormalRecK_andOneStepFamNF1 :
    WhNormalRecK andEnvU 0 mixAndCtx andOneStepFamNF1 :=
