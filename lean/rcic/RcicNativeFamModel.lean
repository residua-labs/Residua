/-! #### Part B — Boundary of `LRTermFamIN` at Non-Propositional Π-Types (`not_lrTermFamIN_spine_at_nonProp_pi`) & The Non-Sort-Spine Repaired Term Logical Relation (`LRTermFamIND`) -/

/-- No `.pi A B` expression weak-head reduces in `WhRedCtx E Γ` to `.sort l`. -/
theorem not_whRedCtx_sort_pi {E : ResolvedEnv} {Γ : LCtx}
    (A B : Expr Nat) (l : Level) :
    ¬ WhRedCtx E Γ (.pi A B) (.sort l) := by
  intro hred
  exact nomatch whRedCtx_pi_eq hred

/-- Under `EnvWfT E`, no admitted `.inductiveM` family spine `foldApps (.const r ls) xs` weak-head
    reduces in `WhRedCtx E Γ` to `.sort l`. -/
theorem not_whRedCtx_sort_famApp {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) (l : Level) :
    ¬ WhRedCtx E Γ (foldApps (.const r ls) xs) (.sort l) := by
  intro hred
  exact foldApps_const_ne_sort r ls xs l (whRedCtx_famApp_eq hW hm hind hred).symm

/-- Transport `∀ l, ¬ WhRedCtx E Γ A (.sort l)` across `TyConvT E n Γ A A'` under `EnvWfT E`,
    `WhApproxInvCore E`, and `FundamentalLRFamINT E n` (requiring **no**
    `ShallowTypeSoundnessCtxI E n` premise). -/
theorem not_whRedCtx_sort_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hcore : WhApproxInvCore E) (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hc : TyConvT E n Γ A A')
    (hns : ∀ l, ¬ WhRedCtx E Γ A (.sort l)) :
    ∀ l, ¬ WhRedCtx E Γ A' (.sort l) := by
  intro l hl'
  obtain ⟨u', hA'⟩ := tyConvT_endTyped hW hΓ hc hA
  have hsortA' : ApproxI (ctxEnvI Γ) A' .sort :=
    approxI_ctxEnvI_sort_of_whRedCtx hcore hl'
  have hLR := hF hΓ hA' hc.symmT .sort hsortA'
  cases hLR with
  | sort _ hredA => exact hns _ hredA

/-- **Boundary of §9's `LRTermFamIN` at Non-Propositional Π-Types
    (`not_lrTermFamIN_spine_at_nonProp_pi`):**
    Because `LRTermFamIN`'s third disjunct at `.spine r args` requires a shallow spine
    approximation `ApproxI (ctxEnvI Γ) A (.spine r' bs)` of the type `A`, `LRTermFamIN` cannot
    hold at `.spine r args` when `A = .pi A₁ B₁` is not sorted in `Prop`
    (`¬ Nonempty (HasTyT E n Γ (.pi A₁ B₁) (.sort .zero))`), even for an opaque constant
    `M = M' = .const r ls` of type `.pi A₁ B₁`. -/
theorem not_lrTermFamIN_spine_at_nonProp_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ M M' : Expr Nat}
    (hnotProp : ¬ Nonempty (HasTyT E n Γ (.pi A₁ B₁) (.sort .zero)))
    (r : Nat) (args : List CptI) :
    ¬ LRTermFamIN E n Γ M M' (.pi A₁ B₁) (.spine r args) := by
  intro h
  rw [lrTermFamIN_spine_iff] at h
  rcases h with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨⟨r', bs, _, hsp⟩, _⟩
  · exact not_whRedCtx_sort_pi A₁ B₁ l hl
  · exact hnotProp hprop.2
  · rcases approxI_pi_inv hsp with h0 | ⟨_, _, h0, _, _⟩ <;> exact CptI.noConfusion h0

/-- **The Non-Sort-Spine Repaired Term Logical Relation (`LRTermFamIND`) Over `LRTypeFamIN`:**
    Repairs `LRTermFamIN`'s non-propositional Π-spine boundary (`not_lrTermFamIN_spine_at_nonProp_pi`)
    by guarding the non-type-code `.spine r args` disjunct with `∀ l, ¬ WhRedCtx E Γ A (.sort l)`
    (rather than `ApproxI (ctxEnvI Γ) A (.spine r' bs)`), without introducing any unconstrained
    existential list `Ts` of argument types:
    - At `.sort u`: both `IsNonSortPropCtx` and `∀ l, ¬ WhRedCtx E Γ (.sort u) (.sort l)` are
      unconditionally false, so `LRTermFamIND` at `.sort u` is unconditionally equivalent (`↔`)
      to `LRTypeFamIN` (whose `famSpine` constructor walks the actual stored telescope `m.mtype`
      via `ConvArgsT`).
    - At any `IsNonSortPropCtx E n Γ A`: `LRTermFamIND` is total across all `M, M', u`.
    - At any non-sort type `A` (`∀ l, ¬ WhRedCtx E Γ A (.sort l)` — including both family spines
      `foldApps (.const r' ls') ys` and non-propositional function types `.pi A₁ B₁`): `.spine r args`
      relates any `M, M'` that weak-head reduce in `WhRedCtx E Γ` to weak-head normal forms
      `Y, Y'` convertible at `A`. -/
def LRTermFamIND (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort =>
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' .sort)
  | .pi a f =>
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.pi a f))
  | .spine r args =>
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.spine r args)) ∨
      IsNonSortPropCtx E n Γ A ∨
      ((∀ l, ¬ WhRedCtx E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedCtx E Γ M Y ∧ WhRedCtx E Γ M' Y' ∧
          WhNormalCtx E Γ Y ∧ WhNormalCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A))
  | .lam g =>
      IsNonSortPropCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamIND E n Γ N N' A₁ u) →
          LRTermFamIND E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show u ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

theorem lrTermFamIND_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamIND E n Γ M M' A .bot := by
  rw [LRTermFamIND]; trivial

theorem lrTermFamIND_sort_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamIND E n Γ M M' A .sort ↔
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' .sort) := by
  rw [LRTermFamIND]

theorem lrTermFamIND_pi_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (a : CptI) (f : List (List CptI × CptI)) :
    LRTermFamIND E n Γ M M' A (.pi a f) ↔
      IsNonSortPropCtx E n Γ A ∨
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.pi a f)) := by
  rw [LRTermFamIND]

theorem lrTermFamIND_spine_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (r : Nat) (args : List CptI) :
    LRTermFamIND E n Γ M M' A (.spine r args) ↔
      ((∃ l, WhRedCtx E Γ A (.sort l)) ∧ LRTypeFamIN E n Γ M M' (.spine r args)) ∨
      IsNonSortPropCtx E n Γ A ∨
      ((∀ l, ¬ WhRedCtx E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedCtx E Γ M Y ∧ WhRedCtx E Γ M' Y' ∧
          WhNormalCtx E Γ Y ∧ WhNormalCtx E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A)) := by
  rw [LRTermFamIND]

theorem lrTermFamIND_lam_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (g : List (List CptI × CptI)) :
    LRTermFamIND E n Γ M M' A (.lam g) ↔
      IsNonSortPropCtx E n Γ A ∨
      (∃ A₁ B₁ w, WhRedCtx E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamIND E n Γ N N' A₁ u) →
          LRTermFamIND E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2) := by
  rw [LRTermFamIND]

/-- At any non-sort proposition `IsNonSortPropCtx E n Γ A`, `LRTermFamIND E n Γ M M' A u` holds
    for **every** compact `u : CptI` and all terms `M, M'`. -/
theorem lrTermFamIND_of_nonSortPropCtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A : Expr Nat}
    (hprop : IsNonSortPropCtx E n Γ A) (M M' : Expr Nat) :
    (u : CptI) → LRTermFamIND E n Γ M M' A u
  | .bot => lrTermFamIND_bot _ _ _ _
  | .sort => (lrTermFamIND_sort_iff _ _ _ _).mpr (Or.inl hprop)
  | .pi _ _ => (lrTermFamIND_pi_iff _ _ _ _ _ _).mpr (Or.inl hprop)
  | .spine _ _ => (lrTermFamIND_spine_iff _ _ _ _ _ _).mpr (Or.inr (Or.inl hprop))
  | .lam _ => (lrTermFamIND_lam_iff _ _ _ _ _).mpr (Or.inl hprop)

/-- Closure of `LRTermFamIND` under weak-head expansion (`WhRedCtx E Γ`) on both sides. -/
theorem lrTermFamIND_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {M M' X X' A : Expr Nat}
    (hX : WhRedCtx E Γ M X) (hX' : WhRedCtx E Γ M' X') :
    (u : CptI) → LRTermFamIND E n Γ X X' A u → LRTermFamIND E n Γ M M' A u
  | .bot, _ => lrTermFamIND_bot _ _ _ _
  | .sort, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
  | .pi a f, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
  | .spine r args, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨h1, h2⟩ | hprop | ⟨h1, Y, Y', hY, hY', hn, hn', hc⟩
      · exact Or.inl ⟨h1, lrTypeFamIN_expand hX hX' h2⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨h1, Y, Y', whRedCtx_trans hX hY, whRedCtx_trans hX' hY', hn, hn', hc⟩)
  | .lam g, h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hA, hΓ₁, hB₁, happ⟩
      · exact Or.inl hprop
      · refine Or.inr ⟨A₁, B₁, w, hA, hΓ₁, hB₁, fun s hs N N' hN hN' hc hrel => ?_⟩
        exact lrTermFamIND_expand (whRedCtx_appHead hX) (whRedCtx_appHead hX') s.2
          (happ s hs N N' hN hN' hc hrel)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
  have h₃ := sizeOf_snd_lt s
  omega

/-- At a universe `.sort u`, `LRTermFamIND` never holds at `.lam g` (unconditionally). -/
theorem lrTermFamIND_lam_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {g : List (List CptI × CptI)}
    (h : LRTermFamIND E n Γ M M' (.sort u) (.lam g)) : False := by
  rw [lrTermFamIND_lam_iff] at h
  rcases h with hprop | ⟨A₁, B₁, _, hA, _, _, _⟩
  · exact not_isNonSortPropCtx_sort u hprop
  · exact nomatch whRedCtx_sort_eq hA

/-- At a universe `.sort u`, `LRTermFamIND` at `.spine r args` forces the type-code reading
    `LRTypeFamIN E n Γ M M' (.spine r args)` (unconditionally, since `WhRedCtx.refl (.sort u)`
    refutes `∀ l, ¬ WhRedCtx E Γ (.sort u) (.sort l)`). -/
theorem lrTermFamIND_spine_at_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {r : Nat} {args : List CptI}
    (h : LRTermFamIND E n Γ M M' (.sort u) (.spine r args)) :
    LRTypeFamIN E n Γ M M' (.spine r args) := by
  rw [lrTermFamIND_spine_iff] at h
  rcases h with ⟨_, h2⟩ | hprop | ⟨hns, _⟩
  · exact h2
  · exact (not_isNonSortPropCtx_sort u hprop).elim
  · exact (hns u (.refl _)).elim

/-- Unconditional extraction of `LRTypeFamIN` from `LRTermFamIND` at a universe `.sort u`. -/
theorem lrTypeFamIN_of_lrTermFamIND_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} :
    (c : CptI) → LRTermFamIND E n Γ M M' (.sort u) c → LRTypeFamIN E n Γ M M' c
  | .bot, _ => .bot _ _ _
  | .sort, h => by
      rw [lrTermFamIND_sort_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropCtx_sort u hprop).elim
      · exact h2
  | .pi _ _, h => by
      rw [lrTermFamIND_pi_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropCtx_sort u hprop).elim
      · exact h2
  | .spine _ _, h => lrTermFamIND_spine_at_sort h
  | .lam _, h => (lrTermFamIND_lam_at_sort_false h).elim

/-- Conversely, `LRTypeFamIN E n Γ M M' c` embeds into `LRTermFamIND E n Γ M M' (.sort u) c`. -/
theorem lrTermFamIND_of_lrTypeFamIN_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) :
    (c : CptI) → LRTypeFamIN E n Γ M M' c → LRTermFamIND E n Γ M M' (.sort u) c
  | .bot, _ => lrTermFamIND_bot _ _ _ _
  | .sort, h => (lrTermFamIND_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .pi _ _, h => (lrTermFamIND_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .spine _ _, h => (lrTermFamIND_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨u, .refl _⟩, h⟩)
  | .lam _, h => nomatch h

/-- At any universe `.sort u`, `LRTermFamIND E n Γ M M' (.sort u) c` is logically equivalent (`↔`)
    to `LRTypeFamIN E n Γ M M' c`. -/
theorem lrTermFamIND_sort_iff_lrTypeFamIN {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) (c : CptI) :
    LRTermFamIND E n Γ M M' (.sort u) c ↔ LRTypeFamIN E n Γ M M' c :=
  ⟨lrTypeFamIN_of_lrTermFamIND_sort c, lrTermFamIND_of_lrTypeFamIN_sort u c⟩

/-- `LRTermFamIND` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the forward
    direction `(.sort .zero, .bvar 0)`. -/
theorem lrTermFamIND_zetaSortCtx (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c) :
    LRTermFamIND E n zetaSortCtx (.sort .zero) (.bvar 0) (.sort (.succ .zero)) c :=
  lrTermFamIND_of_lrTypeFamIN_sort (.succ .zero) c (lrTypeFamIN_zetaSortCtx E n c hc)

/-- `LRTermFamIND` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the reverse
    direction `(.bvar 0, .sort .zero)`. -/
theorem lrTermFamIND_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.bvar 0) c) :
    LRTermFamIND E n zetaSortCtx (.bvar 0) (.sort .zero) (.sort (.succ .zero)) c :=
  lrTermFamIND_of_lrTypeFamIN_sort (.succ .zero) c (lrTypeFamIN_zetaSortCtx_symm E n c hc)


/-! #### Part C — Soundness-Free Index Transport (`lrTermFamIND_transport`, Including `.lam g`), Symmetry (`lrTermFamIND_symm`), and Transitivity (`lrTermFamIND_trans`) Across All Compacts -/

/-- **Soundness-Free Full Index Transport for `LRTermFamIND` Across All Compacts `c : CptI`
    (Including `.lam g`):**
    Uses `not_whRedCtx_sort_transport` in the non-sort `.spine` branch and `hasTyT_assump_dom`
    in the `.lam g` branch, requiring **neither** `TypeSoundnessI` **nor**
    `ShallowTypeSoundnessCtxI`. -/
theorem lrTermFamIND_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A A' : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' →
    ∀ {M M' : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M M' A' c
  | .bot, _, _, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .pi a f, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .spine r args, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · have hs := hF hΓ hA hAA' .sort (approxI_ctxEnvI_sort_of_whRedCtx hcore hl)
        cases hs with
        | sort _ hl' => exact Or.inl ⟨⟨_, hl'⟩, hLR⟩
      · exact Or.inr (Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop))
      · exact Or.inr (Or.inr ⟨not_whRedCtx_sort_transport hW hcore hF hΓ hA hAA' hns,
          Y, Y', hY, hY', hn, hn', ⟨convT_of_tyConv hc hAA'⟩⟩)
  | .lam g, Γ, hΓ, A, A', _, hA, hAA', M, M', h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl (isNonSortPropCtx_transport hW zsc hcore hF hΓ hAA' hprop)
      · have hpi := hF hΓ hA hAA' (.pi .bot []) (approxI_ctxEnvI_pi_of_whRedCtx hcore hred)
        cases hpi with
        | @pi _ _ _ A₁' B₁' A₂ B₂ _ _ hred₁ hred₂ _ hdom hcod _ _ =>
            have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
              hred (whNormalCtx_pi A₁ B₁) hred₁ (whNormalCtx_pi A₁' B₁')
            injection e with eA eB
            subst eA; subst eB
            cases hΓ₁ with
            | assumption _ _ u₁ _ hA₁ =>
                obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hdom hA₁
                have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ u₂ hΓ hA₂
                have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
                obtain ⟨w₂, hB₂_A₁⟩ := tyConvT_endTyped hW hΓ₁' hcod hB₁
                have hB₂ : HasTyT E n (.assumption A₂ :: Γ) B₂ (.sort w₂) :=
                  hasTyT_assump_dom (envClosed_of_envWfT hW) hW hΓ hdom.symmT hA₂ hB₂_A₁
                refine Or.inr ⟨A₂, B₂, w₂, hred₂, ⟨hΓ₂⟩, ⟨hB₂⟩,
                  fun s hs N N' hN₂ hN'₂ hc₂ hrel₂ => ?_⟩
                have hN₁ : HasTyT E n Γ N A₁ := hasTyT_of_tyConv hN₂ hdom.symmT
                have hN'₁ : HasTyT E n Γ N' A₁ := hasTyT_of_tyConv hN'₂ hdom.symmT
                have hc₁ : ConvT E n Γ N N' A₁ := convT_of_tyConv hc₂ hdom.symmT
                have hrel₁ : ∀ v ∈ s.1, LRTermFamIND E n Γ N N' A₁ v :=
                  fun v hv => lrTermFamIND_transport hW hdet zsc hcore hF v
                    hΓ hA₂ hdom.symmT (hrel₂ v hv)
                have hout₁ := happ s hs N N' hN₁ hN'₁ hc₁ hrel₁
                have hinstTy : HasTyT E n Γ (instantiate0 N B₁) (.sort w) :=
                  hasTyT_subst0_of_envWfT hW hB₁ hN₁
                have hinstConv : TyConvT E n Γ (instantiate0 N B₁) (instantiate0 N B₂) :=
                  tyConvT_subst0_of_envWfT hW hN₁ hcod
                exact lrTermFamIND_transport hW hdet zsc hcore hF s.2
                  hΓ hinstTy hinstConv hout₁
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- Specialization of `lrTermFamIND_transport` to `.lam g`. -/
theorem lrTermFamIND_transport_lam {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hAA' : TyConvT E n Γ A A')
    {M M' : Expr Nat} (g : List (List CptI × CptI))
    (h : LRTermFamIND E n Γ M M' A (.lam g)) :
    LRTermFamIND E n Γ M M' A' (.lam g) :=
  lrTermFamIND_transport hW hdet zsc hcore hF (.lam g) hΓ hA hAA' h

/-- **Soundness-Free Full Symmetry of `LRTermFamIND` Across All Compacts `c : CptI`
    (Including `.lam g`):**
    Requires **neither** `TypeSoundnessI` **nor** `ShallowTypeSoundnessCtxI`. -/
theorem lrTermFamIND_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat}, LRTermFamIND E n Γ M M' A c → LRTermFamIND E n Γ M' M A c
  | .bot, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
  | .pi a f, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
  | .spine r args, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamIND_spine_iff] at h ⊢
      rcases h with ⟨hl, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · exact Or.inl ⟨hl, lrTypeFamIN_symm hW (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨hns, Y', Y, hY', hY, hn', hn, ⟨.symm _ _ _ _ hc⟩⟩)
  | .lam g, Γ, hΓ, M, M', A, h => by
      rw [lrTermFamIND_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl hprop
      · cases hΓ₁ with
        | assumption _ _ u₁ _ hA₁ =>
            have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
            refine Or.inr ⟨A₁, B₁, w, hred, ⟨hΓ₁'⟩, ⟨hB₁⟩,
              fun s hs N N' hN hN' hc hrel => ?_⟩
            have hc' : ConvT E n Γ N' N A₁ := .symm _ _ _ _ hc
            have hrel' : ∀ v ∈ s.1, LRTermFamIND E n Γ N' N A₁ v :=
              fun v hv => lrTermFamIND_symm hW hdet zsc hcore hF v hΓ (hrel v hv)
            have hout := happ s hs N' N hN' hN hc' hrel'
            have houtSymm := lrTermFamIND_symm hW hdet zsc hcore hF s.2 hΓ hout
            have hinstTy : HasTyT E n Γ (instantiate0 N' B₁) (.sort w) :=
              hasTyT_subst0_of_envWfT hW hB₁ hN'
            have hinstConv : TyConvT E n Γ (instantiate0 N' B₁) (instantiate0 N B₁) :=
              .of _ _ _ w (convT_inst0_sortCongr hA₁ hB₁ hN' hN hc')
            exact lrTermFamIND_transport hW hdet zsc hcore hF s.2
              hΓ hinstTy hinstConv houtSymm
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Soundness-Free Full Transitivity of `LRTermFamIND` Across All Compacts `c : CptI`
    (Including `.lam g`):**
    Requires **neither** `TypeSoundnessI` **nor** `ShallowTypeSoundnessCtxI` (and in the `.spine`
    cross-cases, `(∃ l, WhRedCtx E Γ A (.sort l))` and `(∀ l, ¬ WhRedCtx E Γ A (.sort l))`
    contradict each other directly). -/
theorem lrTermFamIND_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M N P A : Expr Nat},
      LRTermFamIND E n Γ M N A c → LRTermFamIND E n Γ N P A c → LRTermFamIND E n Γ M P A c
  | .bot, _, _, _, _, _, _, _, _ => lrTermFamIND_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_sort_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
  | .pi a f, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_pi_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨hl, hLR₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨_, hLR₂⟩
        · exact Or.inl hprop
        · exact Or.inr ⟨hl,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
  | .spine r args, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_spine_iff] at h₁ h₂ ⊢
      rcases h₁ with ⟨⟨l, hl⟩, hLR₁⟩ | hprop | ⟨hns, Y₁, Y₂, hM, hN₁, hn₁, hn₂, ⟨hc₁⟩⟩
      · rcases h₂ with ⟨_, hLR₂⟩ | hprop | ⟨hns, _⟩
        · exact Or.inl ⟨⟨l, hl⟩,
            lrTypeFamIN_trans hW hdet (piRowField_of_fundamentalLRFamINT hW hF) hΓ hLR₁ hLR₂⟩
        · exact Or.inr (Or.inl hprop)
        · exact (hns l hl).elim
      · exact Or.inr (Or.inl hprop)
      · rcases h₂ with ⟨⟨l, hl⟩, _⟩ | hprop | ⟨_, Y₂', Y₃, hN₂, hP, hn₂', hn₃, ⟨hc₂⟩⟩
        · exact (hns l hl).elim
        · exact Or.inr (Or.inl hprop)
        · have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet) hN₁ hn₂ hN₂ hn₂'
          subst e
          exact Or.inr (Or.inr ⟨hns, Y₁, Y₃, hM, hP, hn₁, hn₃,
            ⟨.trans _ _ _ _ _ hc₁ hc₂⟩⟩)
  | .lam g, Γ, hΓ, _, _, _, _, h₁, h₂ => by
      rw [lrTermFamIND_lam_iff] at h₁ h₂ ⊢
      rcases h₁ with hprop | ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, happ₁⟩
      · exact Or.inl hprop
      · rcases h₂ with hprop | ⟨A₂, B₂, _, hred₂, _, _, happ₂⟩
        · exact Or.inl hprop
        · have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
            hred₁ (whNormalCtx_pi A₁ B₁) hred₂ (whNormalCtx_pi A₂ B₂)
          injection e with eA eB
          subst eA; subst eB
          refine Or.inr ⟨A₁, B₁, w₁, hred₁, hΓ₁, hB₁, fun s hs Q Q' hQ hQ' hcQ hrel => ?_⟩
          have hrelQQ : ∀ v ∈ s.1, LRTermFamIND E n Γ Q Q A₁ v :=
            fun v hv =>
              lrTermFamIND_trans hW hdet zsc hcore hF v hΓ (hrel v hv)
                (lrTermFamIND_symm hW hdet zsc hcore hF v hΓ (hrel v hv))
          have hout₁ := happ₁ s hs Q Q hQ hQ (.refl _ _ _ hQ) hrelQQ
          have hout₂ := happ₂ s hs Q Q' hQ hQ' hcQ hrel
          exact lrTermFamIND_trans hW hdet zsc hcore hF s.2 hΓ hout₁ hout₂
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega


/-! #### Part D — Opaque Constants at Π-Types (`lrTermFamIND_const_pi_diag`), All-Arity `.inductiveM` and `.constructorM` Constant & Spine Cases, Related-Substitution Variable Cases, and Soundness-Free `TypedRowsWf` Bridge -/

/-- Any constant `.const r ls` whose member `m` has `m.body = none` takes no weak-head steps
    in `WhStepCtx E Γ`. -/
theorem whStepCtx_const_opaque_false {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) {e : Expr Nat}
    (h : WhStepCtx E Γ (.const r ls) e) : False := by
  cases h with
  | delta hres hbody' =>
      rw [hm] at hres
      injection hres with hm'
      subst hm'
      rw [hbody] at hbody'
      exact Option.noConfusion hbody'
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r', ls', pre, major, _, hlhs, _, _⟩
      rcases list_eq_nil_or_snoc (pre ++ [major]) with hnil | ⟨pre', x, heq⟩
      · cases pre <;> cases hnil
      · rw [heq, foldApps_snoc] at hlhs
        exact Expr.noConfusion hlhs

/-- Any constant `.const r ls` whose member `m` has `m.body = none` is weak-head normal in
    `WhNormalCtx E Γ`. -/
theorem whNormalCtx_const_of_opaque {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) :
    WhNormalCtx E Γ (.const r ls) :=
  fun _ h => whStepCtx_const_opaque_false hm hbody ls h

/-- At any non-sort type `A` (`∀ l, ¬ WhRedCtx E Γ A (.sort l)`), any `M, M'` that weak-head
    reduce in `WhRedCtx E Γ` to weak-head normal forms `Y, Y'` with `ConvT E n Γ Y Y' A` satisfy
    `LRTermFamIND E n Γ M M' A (.spine r args)`. -/
theorem lrTermFamIND_normal_of_not_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' Y Y' A : Expr Nat}
    (hns : ∀ l, ¬ WhRedCtx E Γ A (.sort l))
    (hY : WhRedCtx E Γ M Y) (hY' : WhRedCtx E Γ M' Y')
    (hn : WhNormalCtx E Γ Y) (hn' : WhNormalCtx E Γ Y')
    (hc : ConvT E n Γ Y Y' A)
    (r : Nat) (args : List CptI) :
    LRTermFamIND E n Γ M M' A (.spine r args) :=
  (lrTermFamIND_spine_iff Γ M M' A r args).mpr
    (Or.inr (Or.inr ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩))

/-- **Positive Diagonal for Any Opaque Constant at Any `.pi A B` Type
    (`lrTermFamIND_const_pi_diag`):**
    Directly resolves `not_fundamentalTermI_of_pi_member` (`#7640`), `lrTermS_spine_at_pi_false`
    (`#7652`), and `not_lrTermFamIN_spine_at_nonProp_pi`: any constant `.const r ls` with
    `m.body = none` typed at `.pi A B` (propositional **or** non-propositional) is related to
    itself in `LRTermFamIND` at `.spine r []`. -/
theorem lrTermFamIND_const_pi_diag {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {ls : List Level} {m : CheckedMember} {A B : Expr Nat}
    (hm : E.members r = some m) (hbody : m.body = none)
    (hM : HasTyT E n Γ (.const r ls) (.pi A B)) :
    LRTermFamIND E n Γ (.const r ls) (.const r ls) (.pi A B) (.spine r []) :=
  lrTermFamIND_normal_of_not_sort (not_whRedCtx_sort_pi A B)
    (.refl _) (.refl _)
    (whNormalCtx_const_of_opaque hm hbody ls)
    (whNormalCtx_const_of_opaque hm hbody ls)
    (.refl _ _ _ hM) r []

/-- Any two convertible opaque constants `.const r ls` and `.const r' ls'` (`m.body = none`,
    `m'.body = none`) at `.pi A B` satisfy `LRTermFamIND` at every compact `u` in
    `ApproxI (ctxEnvI Γ) (.const r ls) u`. -/
theorem fundConvFamIND_consts_pi_of_opaque {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {m m' : CheckedMember} {A B : Expr Nat}
    (hm : E.members r = some m) (hbody : m.body = none)
    (hm' : E.members r' = some m') (hbody' : m'.body = none)
    (hc : ConvT E n Γ (.const r ls) (.const r' ls') (.pi A B)) :
    ∀ u, ApproxI (ctxEnvI Γ) (.const r ls) u →
      LRTermFamIND E n Γ (.const r ls) (.const r' ls') (.pi A B) u := by
  intro u hu
  rcases approxI_const_inv hu with rfl | rfl
  · exact lrTermFamIND_bot _ _ _ _
  · exact lrTermFamIND_normal_of_not_sort (not_whRedCtx_sort_pi A B)
      (.refl _) (.refl _)
      (whNormalCtx_const_of_opaque hm hbody ls)
      (whNormalCtx_const_of_opaque hm' hbody' ls')
      hc r []

/-- The `HasTyT.sort` diagonal case for `LRTermFamIND`. -/
theorem fundTermFamIND_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l : Level) :
    ∀ u, ApproxI (ctxEnvI Γ) (.sort l) u →
      LRTermFamIND E n Γ (.sort l) (.sort l) (.sort (.succ l)) u := by
  intro u hu
  rcases approxI_sort_inv hu with rfl | rfl
  · exact lrTermFamIND_bot _ _ _ _
  · rw [lrTermFamIND_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, lrTypeFamIN_sort_congr Γ l l⟩

/-- The `ConvT.sorts` conversion case for `LRTermFamIND`. -/
theorem fundConvFamIND_sorts {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (l l' : Level) :
    ∀ u, ApproxI (ctxEnvI Γ) (.sort l) u →
      LRTermFamIND E n Γ (.sort l) (.sort l') (.sort (.succ l)) u := by
  intro u hu
  rcases approxI_sort_inv hu with rfl | rfl
  · exact lrTermFamIND_bot _ _ _ _
  · rw [lrTermFamIND_sort_iff]
    exact Or.inr ⟨⟨_, .refl _⟩, lrTypeFamIN_sort_congr Γ l l'⟩

/-- Any single `WhStepCtx E Γ M M'` step reduces the conversion half of `LRTermFamIND` to the
    diagonal on `M'`. -/
theorem fundConvFamIND_of_whStepCtx {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {M M' A : Expr Nat}
    (h : WhStepCtx E Γ M M')
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIND E n Γ M' M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u := by
  intro u hu
  have hu' : ApproxI (ctxEnvI Γ) M' u := (approxI_ctxEnvI_whStepCtx hcore h u).mp hu
  exact lrTermFamIND_expand (.step h (.refl _)) (.refl _) u (hdiag u hu')

/-- Multi-step `WhRedCtx E Γ M M'` reduces the conversion half of `LRTermFamIND` to the diagonal
    on `M'`. -/
theorem fundConvFamIND_of_whRedCtx {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} {M M' A : Expr Nat}
    (h : WhRedCtx E Γ M M')
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIND E n Γ M' M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u := by
  intro u hu
  have hu' : ApproxI (ctxEnvI Γ) M' u := (approxI_ctxEnvI_whRedCtx hcore h u).mp hu
  exact lrTermFamIND_expand h (.refl _) u (hdiag u hu')

/-- `ConvT.beta` case for `LRTermFamIND` from the diagonal on `instantiate0 a b`. -/
theorem fundConvFamIND_beta {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} (A b a T : Expr Nat)
    (hdiag : ∀ u, ApproxI (ctxEnvI Γ) (instantiate0 a b) u →
      LRTermFamIND E n Γ (instantiate0 a b) (instantiate0 a b) T u) :
    ∀ u, ApproxI (ctxEnvI Γ) (.app (.lam A b) a) u →
      LRTermFamIND E n Γ (.app (.lam A b) a) (instantiate0 a b) T u :=
  fundConvFamIND_of_whStepCtx hcore (.beta A b a) hdiag

/-- `ConvT.zeta` case for `LRTermFamIND` from the diagonal on `instantiate0 v b`. -/
theorem fundConvFamIND_zeta {E : ResolvedEnv} {n : Nat}
    (hcore : WhApproxInvCore E) {Γ : LCtx} (A v b T : Expr Nat)
