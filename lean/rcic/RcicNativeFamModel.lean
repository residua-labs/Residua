    lrTypeFamIN_famApp_components hW hm hind
      (lrTypeFamIN_famSpine_of_fundamentalTermFamIND hW hdet hcore F hm hind hΓ hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- **Soundness-Free Derivation of `KernelRowsAssembly.FamRelevantSlotConv E n`
    (`W-F8-FAMAPP-ARG-COMPARISON`) from `FundamentalTermFamIND E n` + `WhApproxInvCore E` +
    `WhDet E`:** -/
theorem famRelevantSlotConv_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n) :
    FamRelevantSlotConv E n :=
  fun {_} hΓ {r _ ls _ xs _ _} hm hind hty hc =>
    lrTypeFamIN_famApp_relevantSlotConv hW hm hind
      (lrTypeFamIN_famSpine_of_fundamentalTermFamIND hW hdet hcore F hm hind hΓ hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- **Full Family Adequacy (`AdequacyFamICtx`) from `FundamentalTermFamIND E n` +
    `WhApproxInvCore E` + `WhDet E` Alone:** -/
theorem adequacyFamICtx_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n) :
    AdequacyFamICtx E n := by
  intro Γ hΓ r m hm hind A u hA args hc
  have hLR :=
    lrTypeFamIN_famSpine_of_fundamentalTermFamIND hW hdet hcore F hm hind hΓ hA (.refl Γ A) hc
  cases hLR with
  | famSpine hm' _ hred _ _ _ _ _ hlen _ _ =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have hc' : ApproxI (ctxEnvI Γ) (foldApps (.const r _ ) _) (.spine r args) :=
        (approxI_ctxEnvI_whRedCtx hcore hred (.spine r args)).mp hc
      rcases approxI_foldApps_const_inv hc' with hbot | ⟨cs, heq, hargs⟩
      · exact nomatch hbot
      · injection heq with _ hcs
        subst hcs
        exact ⟨_, _, hred, hlen, hargs⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

