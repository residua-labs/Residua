    (h : LRTermFamINDRKCanon E n Γ M M' A c) :
    LRTermFamINDRKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) M)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) M')
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A) c := by
  have hA' := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hA
  have hLR : LRTypeFamINRKCanon E n Γ M M' c := by
