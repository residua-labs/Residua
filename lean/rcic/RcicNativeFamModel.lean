      · exact Or.inl ⟨hsort_tr hl, hLR⟩
      · exact Or.inr (Or.inl (hprop_tr hprop))
      · exact Or.inr (Or.inr ⟨hns_tr hns, Y, Y', hY, hY', hn, hn', ⟨convT_of_tyConv hcM hcAA'⟩⟩)

