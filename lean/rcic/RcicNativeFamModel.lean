    (fundamentalLRFamINBotR_of_fundamentalTermFamINDBotR trueEnvUWfT F)

/-- Any `w : IotaWitnessS trueEnvU` with `w.recRef = 2` has `w.preMajor.length = 2`. -/
theorem trueEnvU_iotaWitnessS_preMajor_length (w : IotaWitnessS trueEnvU)
    (hr : w.recRef = 2) : w.preMajor.length = 2 := by
  have hrec := w.hrec
  rw [hr] at hrec
  change some trueRecMemberU = some w.recMember at hrec
  injection hrec with hm
  have hnmin := w.hnmin
  rw [← hm] at hnmin
  change w.nparams + 1 + w.nMinors + w.nindices + 1 = 3 at hnmin
  have hpre := w.hpre
  omega

/-- Every list `us : List α` of length 2 decomposes as `[u₀, u₁]`. -/
theorem list_length_two_eq {α : Type} :
    ∀ (us : List α), us.length = 2 → ∃ u₀ u₁, us = [u₀, u₁]
  | [u₀, u₁], _ => ⟨u₀, u₁, rfl⟩
  | [], h => nomatch h
  | [_], h => nomatch h
  | _ :: _ :: _ :: _, h => nomatch h

/-- **Model-Side `ApproxDI` Obstruction (`approxDI_trueRecVar_eq_bot`):**
    In `ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)`, `trueRecVar u motive minor` has **only**
    the trivial compact `.bot` (`c = .bot`), because `ApproxDI.recursor` places demand
    `ctorDemand w.ctorRef w.nparams us_fields` (headed by `.spine w.ctorRef …`) on the major
    argument `.bvar 0`, whereas `ctxEnvDI trueEnvU trueVarCtx` assigns `botSetI = {.bot}` to `.bvar 0`! -/
theorem approxDI_trueRecVar_eq_bot {u : Level} {motive minor : Expr Nat} {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)
      (trueRecVar u motive minor) c) : c = .bot := by
  rcases PiModelDeltaIotaAudit.approxDI_app_inv h with
    rfl | ⟨g₂, s₂, rfl, hf₂, hs₂, ha₂⟩ | ⟨r₂, args₂, u₂, rfl, hf₂, _⟩
  · rfl
  · rcases PiModelDeltaIotaAudit.approxDI_app_inv hf₂ with
      hbot₂ | ⟨g₁, s₁, heq₂, hf₁, hs₁, _⟩ | ⟨_, _, _, heq₂, _, _⟩
    · exact CptI.noConfusion hbot₂
    · rcases PiModelDeltaIotaAudit.approxDI_app_inv hf₁ with
        hbot₁ | ⟨g₀, s₀, heq₁, hf₀, hs₀, _⟩ | ⟨_, _, _, heq₁, _, _⟩
      · exact CptI.noConfusion hbot₁
      · rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv
            (m := trueRecMemberU) rfl rfl hf₀ with
          hbot₀ | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, hcurry⟩
        · exact CptI.noConfusion hbot₀
        · obtain ⟨u₀, u₁, hus⟩ := list_length_two_eq us_pre
            (hpre.trans (trueEnvU_iotaWitnessS_preMajor_length w hr))
          subst hus
          simp only [List.cons_append, List.nil_append, PiModelDeltaIotaAudit.curryStep] at hcurry
          injection hcurry with hg₀
          subst hg₀
          rcases List.mem_singleton.mp hs₀ with rfl
          injection heq₁ with hg₁
          subst hg₁
          rcases List.mem_singleton.mp hs₁ with rfl
          injection heq₂ with hg₂
          subst hg₂
          rcases List.mem_singleton.mp hs₂ with rfl
          have hspMem : .spine w.ctorRef
              (List.replicate w.nparams .bot ++ List.replicate us_fields.length .bot) ∈
              PiModelDeltaIotaAudit.ctorDemand w.ctorRef w.nparams us_fields :=
            List.mem_cons_self _ _
          have hbvar := ha₂ _ hspMem
          have hbot := approxDI_ctxEnvDI_bvar_of_lookupValue_none (E := trueEnvU)
            (Γ := trueVarCtx) (i := 0) rfl hbvar
          exact CptI.noConfusion hbot
      · exact CptI.noConfusion heq₁
    · exact CptI.noConfusion heq₂
  · rcases PiModelDeltaIotaAudit.approxDI_app_inv hf₂ with
      hbot₂ | ⟨g₁, s₁, heq₂, hf₁, hs₁, _⟩ | ⟨_, _, _, heq₂, hf₁, _⟩
    · exact CptI.noConfusion hbot₂
    · rcases PiModelDeltaIotaAudit.approxDI_app_inv hf₁ with
        hbot₁ | ⟨g₀, s₀, heq₁, hf₀, hs₀, _⟩ | ⟨_, _, _, heq₁, _, _⟩
      · exact CptI.noConfusion hbot₁
      · rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv
            (m := trueRecMemberU) rfl rfl hf₀ with
          hbot₀ | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, hcurry⟩
        · exact CptI.noConfusion hbot₀
        · obtain ⟨u₀, u₁, hus⟩ := list_length_two_eq us_pre
            (hpre.trans (trueEnvU_iotaWitnessS_preMajor_length w hr))
          subst hus
          simp only [List.cons_append, List.nil_append, PiModelDeltaIotaAudit.curryStep] at hcurry
          injection hcurry with hg₀
          subst hg₀
          rcases List.mem_singleton.mp hs₀ with rfl
          injection heq₁ with hg₁
          subst hg₁
          rcases List.mem_singleton.mp hs₁ with rfl
          exact CptI.noConfusion heq₂
      · exact CptI.noConfusion heq₁
    · rcases PiModelDeltaIotaAudit.approxDI_app_inv hf₁ with
        hbot₁ | ⟨g₀, s₀, heq₁, hf₀, hs₀, _⟩ | ⟨_, _, _, _, hf₀, _⟩
      · exact CptI.noConfusion hbot₁
      · rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv
            (m := trueRecMemberU) rfl rfl hf₀ with
          hbot₀ | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, hcurry⟩
        · exact CptI.noConfusion hbot₀
        · obtain ⟨u₀, u₁, hus⟩ := list_length_two_eq us_pre
            (hpre.trans (trueEnvU_iotaWitnessS_preMajor_length w hr))
          subst hus
          simp only [List.cons_append, List.nil_append, PiModelDeltaIotaAudit.curryStep] at hcurry
          injection hcurry with hg₀
          subst hg₀
          rcases List.mem_singleton.mp hs₀ with rfl
          exact CptI.noConfusion heq₁
      · rcases PiModelDeltaIotaAudit.approxDI_recursor_const_inv
            (m := trueRecMemberU) rfl rfl hf₀ with
          hbot₀ | ⟨w, us_pre, us_fields, c₀, hr, hpre, _, _, hcurry⟩
        · exact CptI.noConfusion hbot₀
        · obtain ⟨u₀, u₁, hus⟩ := list_length_two_eq us_pre
            (hpre.trans (trueEnvU_iotaWitnessS_preMajor_length w hr))
          subst hus
          simp only [List.cons_append, List.nil_append, PiModelDeltaIotaAudit.curryStep] at hcurry
          exact CptI.noConfusion hcurry

/-- In `ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)`, `trueVarSort`, `trueVarPi`, and
    `trueVarFam` fail to inhabit `.sort`, `.pi .bot []`, and `.spine 0 []` respectively, refuting
    `SemEqDI` and two-sided `BotFamCpt` `ApproxDI` invariance under `ConvT.irr` + `ConvT.iota`. -/
theorem not_approxDI_trueVarSort_sort :
    ¬ PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) trueVarSort .sort :=
  fun h => nomatch approxDI_trueRecVar_eq_bot h

theorem not_approxDI_trueVarPi_pi :
    ¬ PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) trueVarPi (.pi .bot []) :=
  fun h => nomatch approxDI_trueRecVar_eq_bot h

theorem not_approxDI_trueVarFam_spine :
    ¬ PiModelDeltaIotaAudit.ApproxDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) trueVarFam (.spine 0 []) :=
  fun h => nomatch approxDI_trueRecVar_eq_bot h

theorem not_semEqDI_trueVarSort :
    ¬ PiModelDeltaIotaAudit.SemEqDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) (.sort .zero) trueVarSort :=
  fun h => not_approxDI_trueVarSort_sort ((h .sort).mp (.sort _ .zero))

theorem not_semEqDI_trueVarPi :
    ¬ PiModelDeltaIotaAudit.SemEqDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx)
        PiModelDeltaIotaAudit.idPiProp trueVarPi :=
  fun h => not_approxDI_trueVarPi_pi
    ((h (.pi .bot [])).mp (PiModelDeltaIotaAudit.approxDI_pi_bot_nil trueEnvU _ (.sort .zero) (.bvar 0)))

theorem not_semEqDI_trueVarFam :
    ¬ PiModelDeltaIotaAudit.SemEqDI trueEnvU (ctxEnvDI trueEnvU trueVarCtx) (.const 0 []) trueVarFam :=
  fun h => not_approxDI_trueVarFam_spine
    ((h (.spine 0 [])).mp (.const _ 0 [] (rigidConst_of_inductiveM trueEnvUWfT (m := trueFamMember) rfl rfl)))


/-! #### Part B — Native `ConvT` Soundness of Proposition-Major Recursor Steps (`convT_of_recMajor`, `convT_of_pmajor_conv`, `convT_of_pmajor_derivedIota`) & Recursor-Major + K-Aware Weak-Head Reduction (`WhStepRecK` / `WhRedRecK` / `WhNormalRecK`) -/

/-- **Native `ConvT` Soundness of Recursor-Major Reduction (`convT_of_recMajor`):**
    If the recursor prefix `foldApps (.const r ls) pre` has type `.pi P B` and `major ≡ major' : P`,
    then `.app (foldApps (.const r ls) pre) major ≡ .app (foldApps (.const r ls) pre) major' : instantiate0 major B`
    by `ConvT.app` + `ConvT.refl`. -/
noncomputable def convT_of_recMajor {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {ls : List Level} {pre : List (Expr Nat)}
    {major major' P B : Expr Nat}
    (hpre : HasTyT E n Γ (foldApps (.const r ls) pre) (.pi P B))
    (hmaj : ConvT E n Γ major major' P) :
    ConvT E n Γ (.app (foldApps (.const r ls) pre) major)
      (.app (foldApps (.const r ls) pre) major') (instantiate0 major B) :=
  .app Γ (foldApps (.const r ls) pre) (foldApps (.const r ls) pre) major major' P B
    (.refl Γ (foldApps (.const r ls) pre) (.pi P B) hpre) hmaj

/-- **Native `ConvT` Soundness of the Proposition-Major Recursor Step (`convT_of_pmajor_conv`):**
    For any proposition `P : Sort 0`, any proof `x : P`, and any canonical proof `canon : P` whose
    recursor application `recCall (.const r ls) pre canon` is convertible to `rhs` at `instantiate0 canon B`,
    `recCall (.const r ls) pre x` is natively convertible (`ConvT`) to `rhs` at `instantiate0 x B`
    by `ConvT.irr` + `ConvT.app` + `convT_inst0_sortCongr` + `ConvT.tyConv` + `ConvT.trans`
    (with **zero** `PiRowField`, `SortRow`, or `EnvWfT` hypotheses!). -/
noncomputable def convT_of_pmajor_conv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {ls : List Level} {pre : List (Expr Nat)}
    {canon x rhs P B : Expr Nat} {u : Level}
    (hP : HasTyT E n Γ P (.sort .zero))
    (hcanon : HasTyT E n Γ canon P)
    (hx : HasTyT E n Γ x P)
    (hpre : HasTyT E n Γ (foldApps (.const r ls) pre) (.pi P B))
    (hB : HasTyT E n (.assumption P :: Γ) B (.sort u))
    (hcI : ConvT E n Γ (recCall (.const r ls) pre canon) rhs (instantiate0 canon B)) :
    ConvT E n Γ (recCall (.const r ls) pre x) rhs (instantiate0 x B) := by
  have hirr : ConvT E n Γ x canon P :=
    .irr Γ P x canon hP hx hcanon
  have happ : ConvT E n Γ (recCall (.const r ls) pre x) (recCall (.const r ls) pre canon)
      (instantiate0 x B) := by
    unfold recCall
    rw [foldApps_snoc, foldApps_snoc]
    exact .app Γ (foldApps (.const r ls) pre) (foldApps (.const r ls) pre) x canon P B
      (.refl Γ (foldApps (.const r ls) pre) (.pi P B) hpre) hirr
  have hBconv : ConvT E n Γ (instantiate0 canon B) (instantiate0 x B) (.sort u) :=
    convT_inst0_sortCongr hP hB hcanon hx (.symm _ _ _ _ hirr)
  have hiotaX : ConvT E n Γ (recCall (.const r ls) pre canon) rhs (instantiate0 x B) :=
    .tyConv Γ (recCall (.const r ls) pre canon) rhs (instantiate0 canon B) (instantiate0 x B) u
      hcI hBconv
  exact .trans Γ (recCall (.const r ls) pre x) (recCall (.const r ls) pre canon) rhs
    (instantiate0 x B) happ hiotaX

/-- **Native `ConvT` Soundness of `pmajor` from `DerivedIota` (`convT_of_pmajor_derivedIota`):**
    Specializes `convT_of_pmajor_conv` to any `hI : DerivedIota E (recCall (.const r ls) pre canon) rhs`. -/
noncomputable def convT_of_pmajor_derivedIota {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {ls : List Level} {pre : List (Expr Nat)}
    {canon x rhs P B : Expr Nat} {u : Level}
    (hI : DerivedIota E (recCall (.const r ls) pre canon) rhs)
    (hP : HasTyT E n Γ P (.sort .zero))
    (hcanon : HasTyT E n Γ canon P)
    (hx : HasTyT E n Γ x P)
    (hpre : HasTyT E n Γ (foldApps (.const r ls) pre) (.pi P B))
    (hB : HasTyT E n (.assumption P :: Γ) B (.sort u))
    (hrhs : HasTyT E n Γ rhs (instantiate0 canon B)) :
    ConvT E n Γ (recCall (.const r ls) pre x) rhs (instantiate0 x B) := by
  have hLhsTy : HasTyT E n Γ (recCall (.const r ls) pre canon) (instantiate0 canon B) := by
    unfold recCall
    rw [foldApps_snoc]
    exact .app Γ (foldApps (.const r ls) pre) canon P B hpre hcanon
  exact convT_of_pmajor_conv hP hcanon hx hpre hB
    (.iota Γ (recCall (.const r ls) pre canon) rhs (instantiate0 canon B) hI hLhsTy hrhs)

/-- **Recursor-Major + Proposition-Major Weak-Head Step (`WhStepRecK E n Γ`):**
    Extends §13's `WhStepRecCtx E Γ` with the proposition-major ι step `pmajor` (when the major
    argument `x` and a canonical constructor spine `canon` inhabit the same proposition `P : Sort 0`),
    closed under `appHead` and saturated recursor-major congruence `recMajor`. -/
inductive WhStepRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | recCtx {a b : Expr Nat} (h : WhStepRecCtx E Γ a b) :
      WhStepRecK E n Γ a b
  | pmajor {r : Nat} {ls : List Level} {pre : List (Expr Nat)} {canon x rhs P : Expr Nat}
      (hI : DerivedIotaU E (recCall (.const r ls) pre canon) rhs)
      (hP : Nonempty (HasTyT E n Γ P (.sort .zero)))
      (hcanon : Nonempty (HasTyT E n Γ canon P))
      (hx : Nonempty (HasTyT E n Γ x P)) :
      WhStepRecK E n Γ (recCall (.const r ls) pre x) rhs
  | appHead {f f' a : Expr Nat} (h : WhStepRecK E n Γ f f') :
      WhStepRecK E n Γ (.app f a) (.app f' a)
  | recMajor {r : Nat} {m : CheckedMember} {ls : List Level}
      {pre : List (Expr Nat)} {major major' : Expr Nat}
      (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
      (hlen : pre.length + 1 = piCount m.mtype)
      (hmaj : WhStepRecK E n Γ major major') :
      WhStepRecK E n Γ (.app (foldApps (.const r ls) pre) major)
        (.app (foldApps (.const r ls) pre) major')

/-- Reflexive-transitive closure of `WhStepRecK E n Γ`. -/
inductive WhRedRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | refl (e : Expr Nat) : WhRedRecK E n Γ e e
  | step {a b c : Expr Nat} (h : WhStepRecK E n Γ a b) (hs : WhRedRecK E n Γ b c) :
      WhRedRecK E n Γ a c

theorem whRedRecK_trans {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedRecK E n Γ a b) (h₂ : WhRedRecK E n Γ b c) : WhRedRecK E n Γ a c := by
  induction h₁ with
  | refl => exact h₂
  | step hs _ ih => exact .step hs (ih h₂)

theorem whStepRecCtx_to_whStepRecK {E : ResolvedEnv} (n : Nat) {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepRecCtx E Γ a b) : WhStepRecK E n Γ a b :=
  .recCtx h

theorem whRedRecCtx_to_whRedRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedRecCtx E Γ a b) : WhRedRecK E n Γ a b := by
  induction h with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (.recCtx hs) ih

theorem whStepCtx_to_whStepRecK {E : ResolvedEnv} (n : Nat) {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) : WhStepRecK E n Γ a b :=
  .recCtx (whStepCtx_to_whStepRecCtx h)

theorem whRedCtx_to_whRedRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) : WhRedRecK E n Γ a b :=
  whRedRecCtx_to_whRedRecK (whRedCtx_to_whRedRecCtx h)

theorem whStep_to_whStepRecK {E : ResolvedEnv} (n : Nat) (Γ : LCtx) {a b : Expr Nat}
    (h : WhStep E a b) : WhStepRecK E n Γ a b :=
  .recCtx (whStep_to_whStepRecCtx Γ h)

theorem whRed_to_whRedRecK {E : ResolvedEnv} (n : Nat) (Γ : LCtx) {a b : Expr Nat}
    (h : WhRed E a b) : WhRedRecK E n Γ a b :=
  whRedRecCtx_to_whRedRecK (whRed_to_whRedRecCtx Γ h)

/-- Weak-head normal form with respect to `WhStepRecK E n Γ`. -/
def WhNormalRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (X : Expr Nat) : Prop :=
  ∀ Y, ¬ WhStepRecK E n Γ X Y

theorem whNormalRecCtx_of_whNormalRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {X : Expr Nat}
    (h : WhNormalRecK E n Γ X) : WhNormalRecCtx E Γ X :=
  fun Y hs => h Y (.recCtx hs)

theorem whStepRecK_sort_false_aux {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a e : Expr Nat}
    (h : WhStepRecK E n Γ a e) : ∀ {u : Level}, a = .sort u → False := by
  induction h with
  | recCtx hs =>
      intro u heq; subst heq; exact whStepRecCtx_sort_false hs
  | pmajor _ _ _ _ =>
      intro u heq
      exact foldApps_const_ne_sort _ _ _ _ heq
  | appHead _ _ =>
      intro u heq; exact Expr.noConfusion heq
  | recMajor _ _ _ _ _ =>
      intro u heq; exact Expr.noConfusion heq

theorem whStepRecK_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {u : Level} {e : Expr Nat}
    (h : WhStepRecK E n Γ (.sort u) e) : False :=
  whStepRecK_sort_false_aux h rfl

theorem whNormalRecK_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (u : Level) :
    WhNormalRecK E n Γ (.sort u) :=
  fun _ hs => whStepRecK_sort_false hs

theorem whRedRecK_sort_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {u : Level} {X : Expr Nat}
    (h : WhRedRecK E n Γ (.sort u) X) : X = .sort u := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecK_sort_false hs).elim

theorem whStepRecK_pi_false_aux {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a e : Expr Nat}
    (h : WhStepRecK E n Γ a e) : ∀ {A B : Expr Nat}, a = .pi A B → False := by
  induction h with
  | recCtx hs =>
      intro A B heq; subst heq; exact whStepRecCtx_pi_false hs
  | pmajor _ _ _ _ =>
      intro A B heq
      exact foldApps_const_ne_pi _ _ _ _ _ heq
  | appHead _ _ =>
      intro A B heq; exact Expr.noConfusion heq
  | recMajor _ _ _ _ _ =>
      intro A B heq; exact Expr.noConfusion heq

theorem whStepRecK_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B e : Expr Nat}
    (h : WhStepRecK E n Γ (.pi A B) e) : False :=
  whStepRecK_pi_false_aux h rfl

theorem whNormalRecK_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (A B : Expr Nat) :
    WhNormalRecK E n Γ (.pi A B) :=
  fun _ hs => whStepRecK_pi_false hs

theorem whRedRecK_pi_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B X : Expr Nat}
    (h : WhRedRecK E n Γ (.pi A B) X) : X = .pi A B := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecK_pi_false hs).elim

theorem whStepRecK_lam_false_aux {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a e : Expr Nat}
    (h : WhStepRecK E n Γ a e) : ∀ {A b : Expr Nat}, a = .lam A b → False := by
  induction h with
  | recCtx hs =>
      intro A b heq; subst heq; exact whStepRecCtx_lam_false hs
  | pmajor _ _ _ _ =>
      intro A b heq
      exact F8EtaK.foldApps_const_ne_lam_any heq
  | appHead _ _ =>
      intro A b heq; exact Expr.noConfusion heq
  | recMajor _ _ _ _ _ =>
      intro A b heq; exact Expr.noConfusion heq

theorem whStepRecK_lam_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A b e : Expr Nat}
