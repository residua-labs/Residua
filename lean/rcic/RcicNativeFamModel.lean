    lrTypeFamIN_famApp_components hW hm hind
      (lrTypeFamIN_famSpine_of_fundamentalTermFamIN_core hW hdet hcore F hm hind hΓ hty hc
        (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- **Soundness-Free Derivation of `KernelRowsAssembly.FamRelevantSlotConv E n`
    (`W-F8-FAMAPP-ARG-COMPARISON`) from `FundamentalTermFamIN E n` + `WhApproxInvCore E` +
    `WhDet E`:** -/
theorem famRelevantSlotConv_of_fundamentalTermFamIN_core {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIN E n) :
