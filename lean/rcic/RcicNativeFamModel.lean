theorem approxDIK_famApp_botVecI_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    (n : Nat) (Γ : LCtx) {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
