    (`fundamentalTermFamINDRKCanonS`):**
    Holds for any assumption-headed spine substituent `r = foldApps (.bvar m_var) vargs` with
    `lookupValue (substRemove r j Γ) (m_var + j) = none` (and at `.bot` and `.bvar j` for
    arbitrary `r, r' : Expr Nat`). -/
theorem fundamentalTermFamINDRKCanonS {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {ρ : EnvI} {j m_var : Nat} {vargs : List (Expr Nat)}
    {r' t T : Expr Nat} {Γ : LCtx}
    (hget : Γ[j]? = some (.assumption t))
    (hpre : ∀ i < j, lookupValue Γ i = none)
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
    (hvty : HasTyT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j t))
    (hrel : ∀ c, PiModelDeltaIotaAudit.ApproxDI E (EnvI.drop ρ j) (foldApps (.bvar m_var) vargs) c →
      LRTermFamINDRKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
        (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j r') T c) :
    let r := foldApps (.bvar m_var) vargs
    (∀ {M M' A : Expr Nat},
        LRTermFamINDRKCanon E n (substRemove r j Γ)
          (instantiate j (lift 0 j r) M)
          (instantiate j (lift 0 j r') M')
          (instantiate j (lift 0 j r) A) .bot) ∧
    (∀ {M M' A : Expr Nat},
        (IsRigidPropRecKCanon E n Γ A ∨
          (∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧
            (∃ u, WhRedRecKCanon E Γ M (.sort u)) ∧
            (∃ u', WhRedRecKCanon E (substRemove r j Γ) (instantiate j (lift 0 j r') M') (.sort u'))) →
        LRTermFamINDRKCanon E n (substRemove r j Γ)
          (instantiate j (lift 0 j r) M)
          (instantiate j (lift 0 j r') M')
          (instantiate j (lift 0 j r) A) .sort) ∧
    (∀ c, PiModelDeltaIotaAudit.ApproxDI E ρ
        (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) (.bvar j)) c →
        LRTermFamINDRKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
          (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) (.bvar j))
          (instantiate j (lift 0 j r') (.bvar j)) T c) := by
  let r := foldApps (.bvar m_var) vargs
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have _ := hpre
  refine ⟨?bot, ?sort, ?var⟩
  case bot =>
    intro _ _ _
    exact lrTermFamINDRKCanon_bot _ _ _ _
  case sort =>
    intro M M' A h
    rcases h with hrig | ⟨⟨l, hA⟩, ⟨u, hM⟩, ⟨u', hM'⟩⟩
    · exact lrTermFamINDRKCanon_of_isRigidPropRecKCanon hW
        (isRigidPropRecKCanon_subst_bvarSpine hcl hinst m_var vargs t hget hnone hvty hrig) .sort
    · rw [lrTermFamINDRKCanon_sort_iff]
      have hA₁ := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hA
      have hM₁ := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hM
      exact Or.inr ⟨⟨l, hA₁⟩, .sort hM₁ hM'⟩
  case var =>
    intro c hmem
    have hlook : PiModelDeltaIotaAudit.ApproxDI E
        (EnvI.insert ρ j (PiModelDeltaIotaAudit.denDI E (EnvI.drop ρ j) r)) (.bvar j) c :=
      (PiModelDeltaIotaAudit.approxDI_subst_iff E ρ j r (.bvar j) c).mp hmem
    have hL : instantiate j (lift 0 j r) (.bvar j) = lift 0 j r := by
      rw [instantiate, if_pos (rfl : j = j)]
    have hR : instantiate j (lift 0 j r') (.bvar j) = lift 0 j r' := by
      rw [instantiate, if_pos (rfl : j = j)]
    rw [hL, hR]
    rcases PiModelDeltaIotaAudit.approxDI_bvar_inv hlook with hbot | hmem
    · subst hbot
      exact lrTermFamINDRKCanon_bot _ _ _ _
    · rw [EnvI.insert_self] at hmem
      exact hrel c hmem

