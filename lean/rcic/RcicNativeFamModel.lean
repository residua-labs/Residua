    (hcore : WhApproxInvCore E)
    (hF : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {M M' A : Expr Nat}
    (hsound : ∀ u, ApproxI (ctxEnvI Γ) M' u → ApproxI (ctxEnvI Γ) M u)
    (h : ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u) :
    ∀ u, ApproxI (ctxEnvI Γ) M' u → LRTermFamIND E n Γ M' M A u :=
  fun u hu => lrTermFamIND_symm hW hdet zsc hcore hF u hΓ (h u (hsound u hu))

/-- Soundness-free `ConvT.trans` case for `LRTermFamIND` (requiring **neither** `TypeSoundnessI`
    **nor** `ShallowTypeSoundnessCtxI`). -/
