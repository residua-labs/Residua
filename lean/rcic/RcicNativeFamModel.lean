/-- Related-substitution stability of `LRTermFamIND` at `.bot`. -/
theorem fundSubstFamIND_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx)
    (j : Nat) (sub sub' M M' T : Expr Nat) :
    LRTermFamIND E n Γ (instantiate j (lift 0 j sub) M) (instantiate j (lift 0 j sub') M') T .bot :=
  lrTermFamIND_bot _ _ _ _

/-- Related-substitution stability of `LRTermFamIND` at the substituted variable `.bvar j`
    (`i = j`). -/
theorem fundSubstFamIND_bvar_eq {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {ρ : EnvI} {j : Nat} {sub sub' T : Expr Nat}
    (hrel : ∀ c, ApproxI (EnvI.drop ρ j) sub c →
      LRTermFamIND E n Γ (lift 0 j sub) (lift 0 j sub') T c) :
    ∀ c, ApproxI ρ (instantiate j (lift 0 j sub) (.bvar j)) c →
      LRTermFamIND E n Γ (instantiate j (lift 0 j sub) (.bvar j))
        (instantiate j (lift 0 j sub') (.bvar j)) T c := by
  intro c hmem
  have hlook : ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) (.bvar j) c :=
    (approxI_subst_iff ρ j sub (.bvar j) c).mp hmem
  have hL : instantiate j (lift 0 j sub) (.bvar j) = lift 0 j sub := by
    rw [instantiate, if_pos (rfl : j = j)]
  have hR : instantiate j (lift 0 j sub') (.bvar j) = lift 0 j sub' := by
    rw [instantiate, if_pos (rfl : j = j)]
  rw [hL, hR]
  rcases approxI_bvar_inv hlook with rfl | hmem'
  · exact lrTermFamIND_bot _ _ _ _
  · rw [EnvI.insert_self] at hmem'
    exact hrel c hmem'

/-- Related-substitution stability of `LRTermFamIND` at any variable `.bvar i` below the
    substituted index (`i < j`). -/
theorem fundSubstFamIND_bvar_lt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {ρ : EnvI} {i j : Nat} (hij : i < j) {sub sub' T : Expr Nat}
    (hdiag : ∀ c, ApproxI ρ (.bvar i) c → LRTermFamIND E n Γ (.bvar i) (.bvar i) T c) :
    ∀ c, ApproxI ρ (instantiate j (lift 0 j sub) (.bvar i)) c →
      LRTermFamIND E n Γ (instantiate j (lift 0 j sub) (.bvar i))
        (instantiate j (lift 0 j sub') (.bvar i)) T c := by
  intro c hmem
  have hne : i ≠ j := Nat.ne_of_lt hij
  have hng : ¬ j < i := Nat.not_lt.mpr (Nat.le_of_lt hij)
  have hL : instantiate j (lift 0 j sub) (.bvar i) = .bvar i := by
    simp only [instantiate, hne, hng, if_false]
  have hR : instantiate j (lift 0 j sub') (.bvar i) = .bvar i := by
    simp only [instantiate, hne, hng, if_false]
  rw [hL, hR]
  rw [hL] at hmem
  exact hdiag c hmem

/-- Related-substitution stability of `LRTermFamIND` at any variable `.bvar i` above the
    substituted index (`j < i`). -/
theorem fundSubstFamIND_bvar_gt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {ρ : EnvI} {i j : Nat} (hji : j < i) {sub sub' T : Expr Nat}
    (hdiag : ∀ c, ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) (.bvar i) c →
      LRTermFamIND E n Γ (.bvar (i - 1)) (.bvar (i - 1)) T c) :
    ∀ c, ApproxI ρ (instantiate j (lift 0 j sub) (.bvar i)) c →
      LRTermFamIND E n Γ (instantiate j (lift 0 j sub) (.bvar i))
        (instantiate j (lift 0 j sub') (.bvar i)) T c := by
  intro c hmem
  have hlook : ApproxI (EnvI.insert ρ j (denI (EnvI.drop ρ j) sub)) (.bvar i) c :=
    (approxI_subst_iff ρ j sub (.bvar i) c).mp hmem
  have hne : i ≠ j := Nat.ne_of_gt hji
  have hL : instantiate j (lift 0 j sub) (.bvar i) = .bvar (i - 1) := by
    simp only [instantiate, hne, hji, if_false, if_true]
  have hR : instantiate j (lift 0 j sub') (.bvar i) = .bvar (i - 1) := by
    simp only [instantiate, hne, hji, if_false, if_true]
  rw [hL, hR]
  exact hdiag c hlook

/-- **The Non-Sort-Spine Repaired Fundamental Lemma for Terms (`FundamentalTermFamIND E n`):**
    States the diagonal (`HasTyT`) and conversion (`ConvT`) clauses of `LRTermFamIND` at
    `ctxEnvI Γ`. -/
def FundamentalTermFamIND (E : ResolvedEnv) (n : Nat) : Prop :=
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M A : Expr Nat}, HasTyT E n Γ M A →
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M A u) ∧
  (∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {M M' A : Expr Nat}, ConvT E n Γ M M' A →
    ∀ u, ApproxI (ctxEnvI Γ) M u → LRTermFamIND E n Γ M M' A u)

/-- For any single `ConvT E n Γ A B (.sort u)` link, `FundamentalTermFamIND E n` directly yields
    `LRTypeFamIN E n Γ A B c` for every `c` in `ApproxI (ctxEnvI Γ) A c`. -/
theorem lrTypeFamIN_of_fundamentalTermFamIND_convT {E : ResolvedEnv} {n : Nat}
    (F : FundamentalTermFamIND E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A B : Expr Nat} {u : Level} (hc : ConvT E n Γ A B (.sort u))
    (c : CptI) (hcA : ApproxI (ctxEnvI Γ) A c) :
    LRTypeFamIN E n Γ A B c :=
  lrTypeFamIN_of_lrTermFamIND_sort c (F.2 hΓ hc c hcA)

/-- Soundness-free preservation of `LRTypeFamIN` at `.pi .bot []` along any `TyConvT E n Γ A A'`
    chain from `FundamentalTermFamIND E n` + `WhApproxInvCore E` + `WhDet E` alone. -/
theorem lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → ApproxI (ctxEnvI Γ) A (.pi .bot []) →
    LRTypeFamIN E n Γ A A' (.pi .bot [])
  | _, _, _, hA, .refl _ _, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot []) (F.1 hΓ hA (.pi .bot []) hcA)
  | _, _, _, _, .of _ _ _ _ hc, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.pi .bot []) (F.2 hΓ hc (.pi .bot []) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ := lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIND hW hdet hcore F hΓ hA c₁ hcA
      have hcM : ApproxI (ctxEnvI Γ) _ (.pi .bot []) :=
        approxI_ctxEnvI_pi_bot_nil_right_of_lrTypeFamIN hcore hLR₁
      exact lrTypeFamIN_trans_pi_bot_nil hW hdet hLR₁
        (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIND hW hdet hcore F hΓ hM c₂ hcM)

/-- **Soundness-Free Derivation of `PiRowField E n` (`TypedRowsWf.piRow`) from
    `FundamentalTermFamIND E n` + `WhApproxInvCore E` + `WhDet E`:** -/
theorem piRowField_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n) :
    PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (lrTypeFamIN_pi_bot_nil_of_fundamentalTermFamIND hW hdet hcore F hΓ hPi hc
        (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- Soundness-free preservation of `LRTypeFamIN` at `.spine r args` (for any admitted `.inductiveM`
    family head `r`) along any `TyConvT E n Γ A A'` chain from `FundamentalTermFamIND E n` +
    `WhApproxInvCore E` + `WhDet E` alone. -/
theorem lrTypeFamIN_famSpine_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A A' : Expr Nat} → {u : Level} → HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' → {args : List CptI} → ApproxI (ctxEnvI Γ) A (.spine r args) →
    LRTypeFamIN E n Γ A A' (.spine r args)
  | _, _, _, hA, .refl _ _, _, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.spine r _) (F.1 hΓ hA (.spine r _) hcA)
  | _, _, _, _, .of _ _ _ _ hc, _, hcA =>
      lrTypeFamIN_of_lrTermFamIND_sort (.spine r _) (F.2 hΓ hc (.spine r _) hcA)
  | _, _, _, hA, .trans _ _ _ _ c₁ c₂, args, hcA => by
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have hLR₁ :=
        lrTypeFamIN_famSpine_of_fundamentalTermFamIND hW hdet hcore F hm hind hΓ hA c₁ hcA
      have hcM : ApproxI (ctxEnvI Γ) _ (.spine r (botVecI (piDomsOf m.mtype))) :=
        approxI_ctxEnvI_famSpine_right_of_lrTypeFamIN hcore hm hind hLR₁
      have hLR₂_bot :=
        lrTypeFamIN_famSpine_of_fundamentalTermFamIND hW hdet hcore F hm hind hΓ hM c₂ hcM
      have hLR₂ := lrTypeFamIN_spine_change_args args hLR₂_bot
      exact lrTypeFamIN_trans hW hdet
        (piRowField_of_fundamentalTermFamIND hW hdet hcore F) hΓ hLR₁ hLR₂

/-- **Soundness-Free Derivation of `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) from
    `FundamentalTermFamIND E n` + `WhApproxInvCore E` + `WhDet E`:** -/
theorem famAppRow_of_fundamentalTermFamIND {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hcore : WhApproxInvCore E)
    (F : FundamentalTermFamIND E n) :
