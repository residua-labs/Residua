/-! #### Part A — All-Cutoff Weakening, Unconditional `.letBinding` Substitution, and Assumption-Spine Substitution Commutation for `WhStepRecKCanon` / `WhRedRecKCanon` & `ApproxDIKCanon` -/

/-- Lifting `List.replicate n famBotClosedExpr` at any cutoff `c` by `k` leaves it unchanged. -/
theorem map_lift_replicate_famBotClosedExpr (c k : Nat) :
    ∀ (n : Nat),
      (List.replicate n famBotClosedExpr).map (lift c k) = List.replicate n famBotClosedExpr
  | 0 => rfl
  | n + 1 => congrArg (List.cons famBotClosedExpr) (map_lift_replicate_famBotClosedExpr c k n)

/-- Instantiating `List.replicate n famBotClosedExpr` at any index `j` with `s` leaves it unchanged. -/
theorem map_instantiate_replicate_famBotClosedExpr (j : Nat) (s : Expr Nat) :
    ∀ (n : Nat),
      (List.replicate n famBotClosedExpr).map (instantiate j s) = List.replicate n famBotClosedExpr
  | 0 => rfl
  | n + 1 =>
      congrArg (List.cons famBotClosedExpr) (map_instantiate_replicate_famBotClosedExpr j s n)

/-- **All-Cutoff Weakening Commutation for `WhStepRecKCanon` (`whStepRecKCanon_lift_of_envClosed`):**
    Under `EnvClosed E`, every `WhStepRecKCanon E Γ a b` step (including `pmajorCanon`) commutes with
    `insertAt d c Γ` / `lift c 1` whenever `c ≤ Γ.length ∨ ∃ B, d = .assumption B` (in particular
    unconditionally at `c = 0` for any `d`, and at every cutoff `c` when `d = .assumption B` or
    `c ≤ Γ.length`). -/
theorem whStepRecKCanon_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhStepRecKCanon E Γ a b)
    (d : LocalDecl) (c : Nat) (hc : c ≤ Γ.length ∨ ∃ B, d = .assumption B) :
    WhStepRecKCanon E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  have hge_none : ∀ {c i : Nat} {Γ : LCtx},
      c ≤ i → lookupValue Γ i = none → lookupValue (insertAt d c Γ) (i + 1) = none := by
    intro c₀
    induction c₀ with
    | zero =>
        intro i Γ₀ _ h₀
        rw [insertAt_zero, lookupValue_cons_succ, h₀]
        rfl
    | succ c₀ ih =>
        intro i Γ₀ hic h₀
        cases Γ₀ with
        | nil =>
            cases i with
            | zero => omega
            | succ i' =>
                simp only [insertAt, lookupValue, List.get?_cons_succ, List.get?]
        | cons x Γ' =>
            cases i with
            | zero => omega
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                rw [insertAt_succ_cons, lookupValue_cons_succ, ih (by omega) h₀]
                rfl
  have hlt_none : ∀ {c i : Nat} {Γ : LCtx},
      (c ≤ Γ.length ∨ ∃ B, d = .assumption B) → i < c → lookupValue Γ i = none →
      lookupValue (insertAt d c Γ) i = none := by
    intro c₀
    induction c₀ with
    | zero =>
        intro i Γ₀ _ hic _
        omega
    | succ c₀ ih =>
        intro i Γ₀ hc₀ hic h₀
        cases Γ₀ with
        | nil =>
            rcases hc₀ with hlen | ⟨B, rfl⟩
            · simp only [List.length_nil] at hlen; omega
            · cases i with
              | zero => rfl
              | succ i' => simp only [insertAt, lookupValue, List.get?_cons_succ, List.get?]
        | cons x Γ' =>
            cases i with
            | zero =>
                cases x with
                | assumption _ =>
                    simp only [insertAt_succ_cons, lookupValue, List.get?_cons_zero, liftDecl]
                | letBinding _ _ =>
                    nomatch h₀
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                have hc' : c₀ ≤ Γ'.length ∨ ∃ B, d = .assumption B := by
                  rcases hc₀ with hlen | hB
                  · simp only [List.length_cons] at hlen
                    exact Or.inl (by omega)
                  · exact Or.inr hB
                rw [insertAt_succ_cons, lookupValue_cons_succ, ih hc' (by omega) h₀]
                rfl
  induction h with
  | beta A body arg =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.beta A body arg) d c)
  | zeta A v body =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.zeta A v body) d c)
  | zetaLocal hv =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.zetaLocal hv) d c)
  | delta hres hbody =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.delta hres hbody) d c)
  | iota hI =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.iota hI) d c)
  | lit t =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_lift_of_envClosed hcl (.lit t) d c)
  | @pmajorCanon w i margs hprop hidx hflds hnone =>
      rw [← iotaRhsOf_lift c w]
      have hflds' : (liftWitness c w).fields =
          List.replicate (liftWitness c w).fields.length famBotClosedExpr := by
        show w.fields.map (lift c 1) =
          List.replicate (w.fields.map (lift c 1)).length famBotClosedExpr
        rw [List.length_map,
          ← map_lift_replicate_famBotClosedExpr c 1 w.fields.length, ← hflds]
      have hpre : lift c 1 (foldApps (.const w.recRef w.ls) w.preMajor) =
          foldApps (.const (liftWitness c w).recRef (liftWitness c w).ls)
            (liftWitness c w).preMajor := by
        rw [lift_foldApps]; rfl
      by_cases hic : i < c
      · have hnone' : lookupValue (insertAt d c Γ) i = none :=
          hlt_none hc hic hnone
        have hm : lift c 1 (foldApps (.bvar i) margs) =
            foldApps (.bvar i) (margs.map (lift c 1)) := by
          rw [lift_foldApps]
          simp only [lift, if_neg (by omega : ¬ c ≤ i)]
        rw [show lift c 1 (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
            .app (lift c 1 (foldApps (.const w.recRef w.ls) w.preMajor))
              (lift c 1 (foldApps (.bvar i) margs)) from rfl, hpre, hm]
        exact .pmajorCanon (liftWitness c w) i (margs.map (lift c 1)) hprop hidx hflds' hnone'
      · have hci : c ≤ i := by omega
        have hnone' : lookupValue (insertAt d c Γ) (i + 1) = none :=
          hge_none hci hnone
        have hm : lift c 1 (foldApps (.bvar i) margs) =
            foldApps (.bvar (i + 1)) (margs.map (lift c 1)) := by
          rw [lift_foldApps]
          simp only [lift, if_pos hci]
        rw [show lift c 1 (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
            .app (lift c 1 (foldApps (.const w.recRef w.ls) w.preMajor))
              (lift c 1 (foldApps (.bvar i) margs)) from rfl, hpre, hm]
        exact .pmajorCanon (liftWitness c w) (i + 1) (margs.map (lift c 1)) hprop hidx hflds' hnone'
  | appHead _ ih =>
      exact .appHead ih
  | @recMajor r m ls pre major major' hm hrec hlen _ ih =>
      simp only [lift, lift_foldApps]
      refine .recMajor hm hrec ?_ ih
      rw [List.length_map]
      exact hlen

/-- All-cutoff weakening commutation for `WhRedRecKCanon` under `EnvClosed E`. -/
theorem whRedRecKCanon_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhRedRecKCanon E Γ a b)
    (d : LocalDecl) (c : Nat) (hc : c ≤ Γ.length ∨ ∃ B, d = .assumption B) :
    WhRedRecKCanon E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  induction h with
  | refl e => exact .refl (lift c 1 e)
  | step hs _ ih => exact .step (whStepRecKCanon_lift_of_envClosed hcl hs d c hc) ih

/-- **Unconditional All-Depth `.letBinding` Substitution Commutation for `WhStepRecKCanon`
    (`whStepRecKCanon_instantiate_letBinding_of_envClosed`):**
    At any `.letBinding t w0` hole (`hj : Γ'[j]? = some (.letBinding t w0)`) and for **every**
    `w0 : Expr Nat` (with zero restrictions on `w0`), `WhStepRecKCanon E Γ' a b` maps under
    `instantiate j (lift 0 j w0)` to `WhRedRecKCanon E (substRemove w0 j Γ')`:
    in the `pmajorCanon` case, `i = j` is impossible because `lookupValue Γ' j = some ... ≠ none`
    (`lookupValue_get_letBinding hj`) whereas `pmajorCanon` requires `lookupValue Γ' i = none`! -/
theorem whStepRecKCanon_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {t w0 : Expr Nat} (hj : Γ'[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhStepRecKCanon E Γ' a b) :
    WhRedRecKCanon E (substRemove w0 j Γ')
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  have hlt_none : ∀ {j i : Nat} {Γ : LCtx},
      i < j → lookupValue Γ i = none → lookupValue (substRemove w0 j Γ) i = none := by
    intro j₀
    induction j₀ with
    | zero =>
        intro i Γ₀ hij _
        omega
    | succ j₀ ih =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil =>
            cases i <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero =>
                cases x with
                | assumption _ =>
                    simp only [substRemove_succ_cons, lookupValue, List.get?_cons_zero, instDecl]
                | letBinding _ _ =>
                    nomatch h₀
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                rw [substRemove_succ_cons, lookupValue_cons_succ, ih (by omega) h₀]
                rfl
  have hgt_none : ∀ {j i : Nat} {Γ : LCtx},
      j < i → lookupValue Γ i = none → lookupValue (substRemove w0 j Γ) (i - 1) = none := by
    intro j₀
    induction j₀ with
    | zero =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil => cases (i - 1) <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero => omega
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                exact h₀
    | succ j₀ ih =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil => cases (i - 1) <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero => omega
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                have hstep := ih (by omega : j₀ < i') h₀
                rw [substRemove_succ_cons,
                  show i' + 1 - 1 = (i' - 1) + 1 from by omega,
                  lookupValue_cons_succ, hstep]
                rfl
  induction h with
  | beta A body arg =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.beta A body arg))
  | zeta A val body =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.zeta A val body))
  | zetaLocal hv =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.zetaLocal hv))
  | delta hres hbody =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.delta hres hbody))
  | iota hI =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.iota hI))
  | lit tN =>
      exact whRedCtx_to_whRedRecKCanon
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.lit tN))
  | @pmajorCanon w i margs hprop hidx hflds hnone =>
      by_cases hij : i = j
      · subst hij
        rw [lookupValue_get_letBinding hj] at hnone
        exact nomatch hnone
      · rw [← iotaRhsOf_instantiate j (lift 0 j w0) w]
        have hflds' : (instWitness j (lift 0 j w0) w).fields =
            List.replicate (instWitness j (lift 0 j w0) w).fields.length famBotClosedExpr := by
          show w.fields.map (instantiate j (lift 0 j w0)) =
            List.replicate (w.fields.map (instantiate j (lift 0 j w0))).length famBotClosedExpr
          rw [List.length_map,
            ← map_instantiate_replicate_famBotClosedExpr j (lift 0 j w0) w.fields.length, ← hflds]
        have hpre : instantiate j (lift 0 j w0) (foldApps (.const w.recRef w.ls) w.preMajor) =
            foldApps (.const (instWitness j (lift 0 j w0) w).recRef (instWitness j (lift 0 j w0) w).ls)
              (instWitness j (lift 0 j w0) w).preMajor := by
          rw [instantiate_foldApps]; rfl
        by_cases hlt : i < j
        · have hnone' : lookupValue (substRemove w0 j Γ') i = none :=
            hlt_none hlt hnone
          have hm : instantiate j (lift 0 j w0) (foldApps (.bvar i) margs) =
              foldApps (.bvar i) (margs.map (instantiate j (lift 0 j w0))) := by
            rw [instantiate_foldApps]
            simp only [instantiate, if_neg hij, if_neg (by omega : ¬ j < i)]
          rw [show instantiate j (lift 0 j w0)
                (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
              .app (instantiate j (lift 0 j w0) (foldApps (.const w.recRef w.ls) w.preMajor))
                (instantiate j (lift 0 j w0) (foldApps (.bvar i) margs)) from rfl, hpre, hm]
          exact .step (.pmajorCanon (instWitness j (lift 0 j w0) w) i
            (margs.map (instantiate j (lift 0 j w0))) hprop hidx hflds' hnone') (.refl _)
        · have hgt : j < i := by omega
          have hnone' : lookupValue (substRemove w0 j Γ') (i - 1) = none :=
            hgt_none hgt hnone
          have hm : instantiate j (lift 0 j w0) (foldApps (.bvar i) margs) =
              foldApps (.bvar (i - 1)) (margs.map (instantiate j (lift 0 j w0))) := by
            rw [instantiate_foldApps]
            simp only [instantiate, if_neg hij, if_pos hgt]
          rw [show instantiate j (lift 0 j w0)
                (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
              .app (instantiate j (lift 0 j w0) (foldApps (.const w.recRef w.ls) w.preMajor))
                (instantiate j (lift 0 j w0) (foldApps (.bvar i) margs)) from rfl, hpre, hm]
          exact .step (.pmajorCanon (instWitness j (lift 0 j w0) w) (i - 1)
            (margs.map (instantiate j (lift 0 j w0))) hprop hidx hflds' hnone') (.refl _)
  | appHead _ ih =>
      exact whRedRecKCanon_appHead ih
  | @recMajor r m ls pre major major' hm hrec hlen _ ih =>
      simp only [instantiate, instantiate_foldApps]
      refine whRedRecKCanon_recMajor hm hrec ?_ ih
      rw [List.length_map]
      exact hlen

/-- Unconditional all-depth `.letBinding` substitution commutation for `WhRedRecKCanon` under
    `EnvClosed E` (for every `w0 : Expr Nat`). -/
theorem whRedRecKCanon_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {t w0 : Expr Nat} (hj : Γ'[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhRedRecKCanon E Γ' a b) :
    WhRedRecKCanon E (substRemove w0 j Γ')
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | refl _ => exact .refl _
  | step hs _ ih =>
      exact whRedRecKCanon_trans (whStepRecKCanon_instantiate_letBinding_of_envClosed hcl hj hs) ih

/-- **All-Depth Assumption-Spine Substitution Commutation for `WhStepRecKCanon`
    (`whStepRecKCanon_instantiate_bvarSpine_of_envClosed`):**
    At any `.assumption T₀` hole (`hj : Γ'[j]? = some (.assumption T₀)`), substituting an
    assumption-headed spine `v = foldApps (.bvar m) vargs` with
    `lookupValue (substRemove (foldApps (.bvar m) vargs) j Γ') (m + j) = none` preserves
    `WhStepRecKCanon` in a single step! -/
theorem whStepRecKCanon_instantiate_bvarSpine_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {T₀ : Expr Nat} (hj : Γ'[j]? = some (.assumption T₀))
    {m : Nat} {vargs : List (Expr Nat)}
    (hnone_v : lookupValue (substRemove (foldApps (.bvar m) vargs) j Γ') (m + j) = none)
    {a b : Expr Nat} (h : WhStepRecKCanon E Γ' a b) :
    WhStepRecKCanon E (substRemove (foldApps (.bvar m) vargs) j Γ')
      (instantiate j (lift 0 j (foldApps (.bvar m) vargs)) a)
      (instantiate j (lift 0 j (foldApps (.bvar m) vargs)) b) := by
  let v := foldApps (.bvar m) vargs
  have hlt_none : ∀ {j i : Nat} {Γ : LCtx},
      i < j → lookupValue Γ i = none → lookupValue (substRemove v j Γ) i = none := by
    intro j₀
    induction j₀ with
    | zero =>
        intro i Γ₀ hij _
        omega
    | succ j₀ ih =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil =>
            cases i <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero =>
                cases x with
                | assumption _ =>
                    simp only [substRemove_succ_cons, lookupValue, List.get?_cons_zero, instDecl]
                | letBinding _ _ =>
                    nomatch h₀
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                rw [substRemove_succ_cons, lookupValue_cons_succ, ih (by omega) h₀]
                rfl
  have hgt_none : ∀ {j i : Nat} {Γ : LCtx},
      j < i → lookupValue Γ i = none → lookupValue (substRemove v j Γ) (i - 1) = none := by
    intro j₀
    induction j₀ with
    | zero =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil => cases (i - 1) <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero => omega
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                exact h₀
    | succ j₀ ih =>
        intro i Γ₀ hij h₀
        cases Γ₀ with
        | nil => cases (i - 1) <;> rfl
        | cons x Γ₁ =>
            cases i with
            | zero => omega
            | succ i' =>
                rw [lookupValue_cons_succ] at h₀
                simp only [Option.map_eq_none'] at h₀
                have hstep := ih (by omega : j₀ < i') h₀
                rw [substRemove_succ_cons,
                  show i' + 1 - 1 = (i' - 1) + 1 from by omega,
                  lookupValue_cons_succ, hstep]
                rfl
  induction h with
  | beta A body arg =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.beta A body arg) v)
  | zeta A val body =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.zeta A val body) v)
  | zetaLocal hv =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.zetaLocal hv) v)
  | delta hres hbody =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.delta hres hbody) v)
  | iota hI =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.iota hI) v)
  | lit tN =>
      exact whStepRecCtx_to_whStepRecKCanon
        (whStepRecCtx_instantiate_of_envClosed hcl hj (.lit tN) v)
  | @pmajorCanon w i margs hprop hidx hflds hnone =>
      rw [← iotaRhsOf_instantiate j (lift 0 j v) w]
      have hflds' : (instWitness j (lift 0 j v) w).fields =
          List.replicate (instWitness j (lift 0 j v) w).fields.length famBotClosedExpr := by
        show w.fields.map (instantiate j (lift 0 j v)) =
          List.replicate (w.fields.map (instantiate j (lift 0 j v))).length famBotClosedExpr
        rw [List.length_map,
          ← map_instantiate_replicate_famBotClosedExpr j (lift 0 j v) w.fields.length, ← hflds]
      have hpre : instantiate j (lift 0 j v) (foldApps (.const w.recRef w.ls) w.preMajor) =
          foldApps (.const (instWitness j (lift 0 j v) w).recRef (instWitness j (lift 0 j v) w).ls)
            (instWitness j (lift 0 j v) w).preMajor := by
        rw [instantiate_foldApps]; rfl
      by_cases hij : i = j
      · subst hij
        have hlift_v : lift 0 i v = foldApps (.bvar (m + i)) (vargs.map (lift 0 i)) := by
          change lift 0 i (foldApps (.bvar m) vargs) = _
          rw [lift_foldApps]
          simp only [lift, if_pos (Nat.zero_le m)]
        have hm : instantiate i (lift 0 i v) (foldApps (.bvar i) margs) =
            foldApps (.bvar (m + i))
              (vargs.map (lift 0 i) ++ margs.map (instantiate i (lift 0 i v))) := by
          rw [instantiate_foldApps, instantiate, if_pos (rfl : i = i), hlift_v, ← foldApps_append]
        rw [show instantiate i (lift 0 i v)
              (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
            .app (instantiate i (lift 0 i v) (foldApps (.const w.recRef w.ls) w.preMajor))
              (instantiate i (lift 0 i v) (foldApps (.bvar i) margs)) from rfl, hpre, hm]
        exact .pmajorCanon (instWitness i (lift 0 i v) w) (m + i)
          (vargs.map (lift 0 i) ++ margs.map (instantiate i (lift 0 i v)))
          hprop hidx hflds' hnone_v
      · by_cases hlt : i < j
        · have hnone' : lookupValue (substRemove v j Γ') i = none :=
            hlt_none hlt hnone
          have hm : instantiate j (lift 0 j v) (foldApps (.bvar i) margs) =
              foldApps (.bvar i) (margs.map (instantiate j (lift 0 j v))) := by
            rw [instantiate_foldApps]
            simp only [instantiate, if_neg hij, if_neg (by omega : ¬ j < i)]
          rw [show instantiate j (lift 0 j v)
                (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
              .app (instantiate j (lift 0 j v) (foldApps (.const w.recRef w.ls) w.preMajor))
                (instantiate j (lift 0 j v) (foldApps (.bvar i) margs)) from rfl, hpre, hm]
          exact .pmajorCanon (instWitness j (lift 0 j v) w) i
            (margs.map (instantiate j (lift 0 j v))) hprop hidx hflds' hnone'
        · have hgt : j < i := by omega
          have hnone' : lookupValue (substRemove v j Γ') (i - 1) = none :=
            hgt_none hgt hnone
          have hm : instantiate j (lift 0 j v) (foldApps (.bvar i) margs) =
              foldApps (.bvar (i - 1)) (margs.map (instantiate j (lift 0 j v))) := by
            rw [instantiate_foldApps]
            simp only [instantiate, if_neg hij, if_pos hgt]
          rw [show instantiate j (lift 0 j v)
                (.app (foldApps (.const w.recRef w.ls) w.preMajor) (foldApps (.bvar i) margs)) =
              .app (instantiate j (lift 0 j v) (foldApps (.const w.recRef w.ls) w.preMajor))
                (instantiate j (lift 0 j v) (foldApps (.bvar i) margs)) from rfl, hpre, hm]
          exact .pmajorCanon (instWitness j (lift 0 j v) w) (i - 1)
            (margs.map (instantiate j (lift 0 j v))) hprop hidx hflds' hnone'
  | appHead _ ih =>
      exact .appHead ih
  | @recMajor r m_rec ls pre major major' hm hrec hlen _ ih =>
      simp only [instantiate, instantiate_foldApps]
      refine .recMajor hm hrec ?_ ih
      rw [List.length_map]
      exact hlen

/-- All-depth assumption-spine substitution commutation for `WhRedRecKCanon` under `EnvClosed E`. -/
theorem whRedRecKCanon_instantiate_bvarSpine_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {T₀ : Expr Nat} (hj : Γ'[j]? = some (.assumption T₀))
    {m : Nat} {vargs : List (Expr Nat)}
    (hnone_v : lookupValue (substRemove (foldApps (.bvar m) vargs) j Γ') (m + j) = none)
    {a b : Expr Nat} (h : WhRedRecKCanon E Γ' a b) :
    WhRedRecKCanon E (substRemove (foldApps (.bvar m) vargs) j Γ')
      (instantiate j (lift 0 j (foldApps (.bvar m) vargs)) a)
      (instantiate j (lift 0 j (foldApps (.bvar m) vargs)) b) := by
  induction h with
  | refl _ => exact .refl _
  | step hs _ ih =>
      exact .step (whStepRecKCanon_instantiate_bvarSpine_of_envClosed hcl hj hnone_v hs) ih

/-- Head weakening `d :: Γ` / `lift 0 1` preserves `ApproxDIKCanon` for every `d : LocalDecl`. -/
theorem approxDIKCanon_lift0_one {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} (d : LocalDecl) {e : Expr Nat} {c : CptI}
    (h : ApproxDIKCanon E Γ e c) :
    ApproxDIKCanon E (d :: Γ) (lift 0 1 e) c := by
  rcases h with ⟨X, hred, hX⟩
  exact ⟨lift 0 1 X, whRedRecKCanon_lift_of_envClosed hcl hred d 0 (Or.inl (Nat.zero_le _)),
    (approxDI_lift0_one_ctxEnvDI_iff E Γ d X c).mpr hX⟩

/-- Unconditional head `.letBinding` substitution (`instantiate0 w0` from `.letBinding t w0 :: Γ`
    into `Γ`) preserves `ApproxDIKCanon` for **every** `w0 : Expr Nat`. -/
theorem approxDIKCanon_substLet0_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {t w0 e : Expr Nat} {c : CptI}
    (h : ApproxDIKCanon E (.letBinding t w0 :: Γ) e c) :
    ApproxDIKCanon E Γ (instantiate0 w0 e) c := by
  rcases h with ⟨X, hred, hX⟩
  have hget0 : (LocalDecl.letBinding t w0 :: Γ)[0]? = some (.letBinding t w0) := by simp
  have hred' := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget0 hred
  simp only [substRemove_zero_cons, lift_zero] at hred'
  exact ⟨instantiate0 w0 X, hred', (approxDI_substLet0_ctxEnvDI_iff E Γ t w0 X c).mpr hX⟩

/-- Two-way equivalence between `ApproxDI E (ctxEnvDI E Γ) (instantiate0 v e) c` and
    `ApproxDI E (ctxEnvDI E (.assumption t :: Γ)) e c` for any substituent `v` whose
    `ApproxDI E (ctxEnvDI E Γ)` denotation is `.bot`-only. -/
theorem approxDI_subst0_of_botDen_ctxEnvDI_iff {E : ResolvedEnv} {Γ : LCtx}
    (t : Expr Nat) {v : Expr Nat}
    (hbot : ∀ u, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) v u → u = .bot)
    (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (instantiate0 v e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption t :: Γ)) e c := by
  constructor
  · intro he
    have h0 := (PiModelDeltaIotaAudit.approxDI_subst_iff E (ctxEnvDI E Γ) 0 v e c).mp
      (by simpa only [lift_zero, instantiate0] using he)
    simp only [EnvI.drop, EnvI.insert_zero] at h0
    refine PiModelDeltaIotaAudit.approxDI_mono_env (fun i u hu => ?_) h0
    cases i with
    | zero => exact hbot u hu
    | succ i => exact hu
  · intro he
    have h0 : PiModelDeltaIotaAudit.ApproxDI E
        (EnvI.insert (ctxEnvDI E Γ) 0 (PiModelDeltaIotaAudit.denDI E (EnvI.drop (ctxEnvDI E Γ) 0) v)) e c := by
      simp only [EnvI.drop, EnvI.insert_zero]
      refine PiModelDeltaIotaAudit.approxDI_mono_env (fun i u hu => ?_) he
      cases i with
      | zero =>
          rcases hu with rfl
          exact .bot _ v
      | succ i => exact hu
    simpa only [lift_zero, instantiate0] using
      (PiModelDeltaIotaAudit.approxDI_subst_iff E (ctxEnvDI E Γ) 0 v e c).mpr h0

/-- Head (`j = 0`) assumption-spine substitution (`instantiate0 (foldApps (.bvar m) vargs)` with
    `lookupValue Γ m = none`) preserves `ApproxDIKCanon` under `EnvClosed E`. -/
theorem approxDIKCanon_subst0_bvarSpine_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} (t : Expr Nat) {m : Nat} {vargs : List (Expr Nat)}
    (hnone : lookupValue Γ m = none) {e : Expr Nat} {c : CptI}
    (h : ApproxDIKCanon E (.assumption t :: Γ) e c) :
    ApproxDIKCanon E Γ (instantiate0 (foldApps (.bvar m) vargs) e) c := by
  rcases h with ⟨X, hred, hX⟩
  have hget0 : (LocalDecl.assumption t :: Γ)[0]? = some (.assumption t) := by simp
  have hnone0 : lookupValue (substRemove (foldApps (.bvar m) vargs) 0 (.assumption t :: Γ)) (m + 0) = none := by
    simpa only [substRemove_zero_cons, Nat.add_zero] using hnone
  have hred' := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget0 hnone0 hred
  simp only [substRemove_zero_cons, lift_zero] at hred'
  have hX' := (approxDI_subst0_of_botDen_ctxEnvDI_iff t
    (fun _ hu => approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hnone vargs hu) X c).mpr hX
  exact ⟨instantiate0 (foldApps (.bvar m) vargs) X, hred', hX'⟩

/-- Under `EnvWfT E`, every admitted `.constructorM` member is a `RigidConst E`. -/
theorem rigidConst_of_ctorM {E : ResolvedEnv} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM) :
    PiModelDeltaIotaAudit.RigidConst E c := by
  intro m' hm'
  have heq : m' = m := Option.some.inj (hm'.symm.trans hm)
  subst m'
  exact ⟨Or.inl (ctorNoBody_of_envWfT hW c m hm hctor), by rw [hctor]; decide⟩

/-- On any admitted `.constructorM` spine `foldApps (.const c₀ ls) xs`, `ApproxDIKCanon E Γ`
    coincides with `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIKCanon_ctorApp_iff {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx)
    {c₀ : Nat} {m : CheckedMember} (hm : E.members c₀ = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIKCanon E Γ (foldApps (.const c₀ ls) xs) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const c₀ ls) xs) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_ctorApp_eq hW hm hctor hred] at hX
  · exact approxDIKCanon_of_approxDI

/-- On any assumption-headed spine `foldApps (.bvar i) xs` (`lookupValue Γ i = none`),
    `ApproxDIKCanon E Γ (foldApps (.bvar i) xs) c` holds iff `c = .bot`. -/
theorem approxDIKCanon_foldApps_bvar_of_lookupValue_none_iff {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIKCanon E Γ (foldApps (.bvar i) xs) c ↔ c = .bot := by
  constructor
  · rintro ⟨X, hred, hX⟩
    cases hred with
    | refl => exact approxDI_ctxEnvDI_foldApps_bvar_of_lookupValue_none hnone xs hX
    | step hs _ => exact (whStepRecKCanon_foldApps_bvar_false hnone xs hs).elim
  · rintro rfl
    exact approxDIKCanon_bot E Γ (foldApps (.bvar i) xs)

/-- Any opaque constant `.const r ls` (`m.body = none`) takes no `WhStepRecKCanon E Γ` steps. -/
theorem whStepRecKCanon_const_opaque_false {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) {e : Expr Nat}
    (h : WhStepRecKCanon E Γ (.const r ls) e) : False := by
  cases h with
  | delta hres hbody' =>
      rw [hm] at hres
      injection hres with hm'
      subst hm'
      rw [hbody] at hbody'
      exact Option.noConfusion hbody'
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r', ls', pre, major, _, hlhs, _, _⟩
      rcases list_eq_nil_or_snoc (pre ++ [major]) with hnil | ⟨pre', x, heq⟩
      · cases pre <;> cases hnil
      · rw [heq, foldApps_snoc] at hlhs
        exact Expr.noConfusion hlhs

theorem whNormalRecKCanon_const_of_opaque {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) :
    WhNormalRecKCanon E Γ (.const r ls) :=
  fun _ h => whStepRecKCanon_const_opaque_false hm hbody ls h

theorem whRedRecKCanon_const_opaque_eq {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) {X : Expr Nat}
    (h : WhRedRecKCanon E Γ (.const r ls) X) : X = .const r ls := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecKCanon_const_opaque_false hm hbody ls hs).elim

theorem approxDIKCanon_const_opaque_iff {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hbody : m.body = none)
    (ls : List Level) (c : CptI) :
    ApproxDIKCanon E Γ (.const r ls) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.const r ls) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecKCanon_const_opaque_eq hm hbody ls hred] at hX
  · exact approxDIKCanon_of_approxDI


/-! #### Part B — All-Cutoff Weakening, Unconditional `.letBinding` Substitution, Assumption-Spine Substitution, and `.letE`/`.zeta` Cases for `LRTypeFamINRKCanon`, `LRTypeFamINBiRKCanon`, and `LRTypeFamINBiProbeRKCanon` -/

/-- **All-Cutoff Weakening of `LRTypeFamINRKCanon` Across All `BotFamCpt E` Compacts
    (`lrTypeFamINRKCanon_weaken_botFamCpt`):** -/
theorem lrTypeFamINRKCanon_weaken_botFamCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} (d : LocalDecl) (k : Nat),
      (k ≤ Γ.length ∨ ∃ B, d = .assumption B) →
      CtxWfT E n (insertAt d k Γ) →
      LRTypeFamINRKCanon E n Γ A A' c →
      LRTypeFamINRKCanon E n (insertAt d k Γ) (lift k 1 A) (lift k 1 A') c := by
  induction hc with
  | bot =>
      intro Γ A A' d k _ _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' d k hk _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedRecKCanon_lift_of_envClosed hcl h₁ d k hk)
            (whRedRecKCanon_lift_of_envClosed hcl h₂ d k hk)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' d k hk hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have h₁' : WhRedRecKCanon E (insertAt d k Γ) (lift k 1 A)
              (.pi (lift k 1 A₁) (lift (k + 1) 1 B₁)) :=
            whRedRecKCanon_lift_of_envClosed hcl h₁ d k hk
          have h₂' : WhRedRecKCanon E (insertAt d k Γ) (lift k 1 A')
              (.pi (lift k 1 A₂) (lift (k + 1) 1 B₂)) :=
            whRedRecKCanon_lift_of_envClosed hcl h₂ d k hk
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hA₁' : HasTyT E n (insertAt d k Γ) (lift k 1 A₁) (.sort u) :=
            hasTyTWeaken d hcl (c := k) hA₁
          have hΓ₁' : CtxWfT E n (.assumption (lift k 1 A₁) :: insertAt d k Γ) :=
            .assumption _ _ u hΓ' hA₁'
          have hdom' : TyConvT E n (insertAt d k Γ) (lift k 1 A₁) (lift k 1 A₂) :=
            tyConvTWeaken d hcl (c := k) hdom
          have hcod' : TyConvT E n (.assumption (lift k 1 A₁) :: insertAt d k Γ)
              (lift (k + 1) 1 B₁) (lift (k + 1) 1 B₂) :=
            tyConvTWeaken d hcl (c := k + 1) (Γ := .assumption A₁ :: Γ) hcod
          exact .pi h₁' h₂' hΓ₁' hdom' hcod'
            (iha d k hk hΓ' ra)
            (fun s hs => by
              have hΓ₁_ins : CtxWfT E n (insertAt d (k + 1) (.assumption A₁ :: Γ)) := hΓ₁'
              have hk' : k + 1 ≤ (.assumption A₁ :: Γ).length ∨ ∃ B, d = .assumption B := by
                rcases hk with hlen | hB
                · simp only [List.length_cons]
                  exact Or.inl (by omega)
                · exact Or.inr hB
              exact ihf s hs d (k + 1) hk' hΓ₁_ins (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' d k hk _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedRecKCanon E (insertAt d k Γ) (lift k 1 A)
              (foldApps (.const r ls) (xs.map (lift k 1))) := by
            have h0 := whRedRecKCanon_lift_of_envClosed hcl h₁ d k hk
            rwa [foldApps_lift] at h0
          have h₂' : WhRedRecKCanon E (insertAt d k Γ) (lift k 1 A')
              (foldApps (.const r ls') (xs'.map (lift k 1))) := by
            have h0 := whRedRecKCanon_lift_of_envClosed hcl h₂ d k hk
            rwa [foldApps_lift] at h0
          have hty₁ : HasTyT E n (insertAt d k Γ)
              (foldApps (.const r ls) (xs.map (lift k 1))) (.sort w) := by
            have h0 := hasTyTWeaken d hcl (c := k) hty
            rwa [foldApps_lift] at h0
          have hty₂ : HasTyT E n (insertAt d k Γ)
              (foldApps (.const r ls') (xs'.map (lift k 1))) (.sort w') := by
            have h0 := hasTyTWeaken d hcl (c := k) hty'
            rwa [foldApps_lift] at h0
          have hc'' : TyConvT E n (insertAt d k Γ)
              (foldApps (.const r ls) (xs.map (lift k 1)))
              (foldApps (.const r ls') (xs'.map (lift k 1))) := by
            have h0 := tyConvTWeaken d hcl (c := k) hc'
            rwa [foldApps_lift, foldApps_lift] at h0
          have hlen₁ : (xs.map (lift k 1)).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (lift k 1)).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_weaken_instMtype hcl hm' ls d hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

theorem lrTypeFamINRKCanon_weaken0_botFamCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamINRKCanon E n Γ A A' c) :
    LRTypeFamINRKCanon E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') c :=
  lrTypeFamINRKCanon_weaken_botFamCpt hcl hc d 0 (Or.inl (Nat.zero_le _)) hΓ' h

theorem lrTypeFamINRKCanon_weaken_famProbeCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {c : CptI} (hc : FamProbeCpt E c)
    {Γ : LCtx} {A A' : Expr Nat} (d : LocalDecl) (k : Nat)
    (hk : k ≤ Γ.length ∨ ∃ B, d = .assumption B)
    (hΓ' : CtxWfT E n (insertAt d k Γ))
    (h : LRTypeFamINRKCanon E n Γ A A' c) :
    LRTypeFamINRKCanon E n (insertAt d k Γ) (lift k 1 A) (lift k 1 A') c :=
  lrTypeFamINRKCanon_weaken_botFamCpt hcl (botFamCpt_of_famProbeCpt hc) d k hk hΓ' h

theorem lrTypeFamINRKCanon_weaken0_famProbeCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} {c : CptI} (hc : FamProbeCpt E c)
    (h : LRTypeFamINRKCanon E n Γ A A' c) :
    LRTypeFamINRKCanon E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') c :=
  lrTypeFamINRKCanon_weaken0_botFamCpt hcl hΓ' (botFamCpt_of_famProbeCpt hc) h

/-- **Unconditional All-Depth `.letBinding` Substitution Stability of `LRTypeFamINRKCanon` Across
    All `BotFamCpt E` Compacts (`lrTypeFamINRKCanon_substLet_botFamCpt`):**
    Holds for **every** `w0 : Expr Nat` with `HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t)`
    (with zero `.bot`-denotation restriction on `w0`!). -/
theorem lrTypeFamINRKCanon_substLet_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} {j : Nat},
      Γ[j]? = some (.letBinding t w0) →
      HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t) →
      CtxWfT E n (substRemove w0 j Γ) →
      LRTypeFamINRKCanon E n Γ A A' c →
      LRTypeFamINRKCanon E n (substRemove w0 j Γ)
        (instantiate j (lift 0 j w0) A) (instantiate j (lift 0 j w0) A') c := by
  induction hc with
  | bot =>
      intro Γ A A' j _ _ _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' j hget _ _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₁)
            (whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₂)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' j hget hvty hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have hlift : lift 0 1 (lift 0 j w0) = lift 0 (j + 1) w0 :=
            lift_lift_merge 1 j 0 0 (by omega) (by omega) w0
          have h₁' : WhRedRecKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A)
              (.pi (instantiate j (lift 0 j w0) A₁) (instantiate (j + 1) (lift 0 (j + 1) w0) B₁)) := by
            have h0 := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₁
            simpa only [instantiate, hlift] using h0
          have h₂' : WhRedRecKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A')
              (.pi (instantiate j (lift 0 j w0) A₂) (instantiate (j + 1) (lift 0 (j + 1) w0) B₂)) := by
            have h0 := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₂
            simpa only [instantiate, hlift] using h0
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hA₁' : HasTyT E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A₁) (.sort u) :=
            hasTyT_substLetS hcl hinst t w0 hA₁ hget hvty
          have hΓ₁'' : CtxWfT E n (.assumption (instantiate j (lift 0 j w0) A₁) :: substRemove w0 j Γ) :=
            .assumption _ _ u hΓ' hA₁'
          have hΓ₁' : CtxWfT E n (substRemove w0 (j + 1) (.assumption A₁ :: Γ)) := by
            simpa only [substRemove_succ_cons, instDecl] using hΓ₁''
          have hget' : (LocalDecl.assumption A₁ :: Γ)[j + 1]? = some (.letBinding t w0) := by
            rw [List.getElem?_cons_succ]; exact hget
          have hvty' : HasTyT E n (substRemove w0 (j + 1) (.assumption A₁ :: Γ))
              (lift 0 (j + 1) w0) (lift 0 (j + 1) t) := by
            have h0 := hasTyTWeaken (instDecl j w0 (.assumption A₁)) hcl (c := 0) hvty
            rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
                lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
            exact h0
          have hdom' : TyConvT E n (substRemove w0 j Γ)
              (instantiate j (lift 0 j w0) A₁) (instantiate j (lift 0 j w0) A₂) :=
            tyConvT_substLetS hcl hinst t w0 hdom hget hvty
          have hcod' : TyConvT E n (.assumption (instantiate j (lift 0 j w0) A₁) :: substRemove w0 j Γ)
              (instantiate (j + 1) (lift 0 (j + 1) w0) B₁)
              (instantiate (j + 1) (lift 0 (j + 1) w0) B₂) := by
            simpa only [substRemove_succ_cons, instDecl] using
              tyConvT_substLetS hcl hinst t w0 (j := j + 1) hcod hget' hvty'
          exact .pi h₁' h₂' hΓ₁'' hdom' hcod'
            (iha hget hvty hΓ' ra)
            (fun s hs => by
              simpa only [substRemove_succ_cons, instDecl] using
                ihf s hs hget' hvty' hΓ₁' (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' j hget hvty _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedRecKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0)))) := by
            have h0 := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₁
            rwa [instantiate_famApp] at h0
          have h₂' : WhRedRecKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A')
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) := by
            have h0 := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget h₂
            rwa [instantiate_famApp] at h0
          have hty₁ : HasTyT E n (substRemove w0 j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0)))) (.sort w) := by
            have h0 := hasTyT_substLetS hcl hinst t w0 hty hget hvty
            rwa [instantiate_famApp] at h0
          have hty₂ : HasTyT E n (substRemove w0 j Γ)
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) (.sort w') := by
            have h0 := hasTyT_substLetS hcl hinst t w0 hty' hget hvty
            rwa [instantiate_famApp] at h0
          have hc'' : TyConvT E n (substRemove w0 j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0))))
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) := by
            have h0 := tyConvT_substLetS hcl hinst t w0 hc' hget hvty
            rwa [instantiate_famApp, instantiate_famApp] at h0
          have hlen₁ : (xs.map (instantiate j (lift 0 j w0))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (instantiate j (lift 0 j w0))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_substLet_instMtype hcl hinst hm' ls t w0 hget hvty hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

/-- Head (`j = 0`) specialization: `LRTypeFamINRKCanon` on any `BotFamCpt E` compact is stable under
    `instantiate0 w0` from `.letBinding t w0 :: Γ` into `Γ` for **every** `w0 : Expr Nat`! -/
theorem lrTypeFamINRKCanon_substLet0_botFamCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {t w0 A A' : Expr Nat}
    (hw0 : HasTyT E n Γ w0 t) {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamINRKCanon E n (.letBinding t w0 :: Γ) A A' c) :
    LRTypeFamINRKCanon E n Γ (instantiate0 w0 A) (instantiate0 w0 A') c := by
  have hget0 : (LocalDecl.letBinding t w0 :: Γ)[0]? = some (.letBinding t w0) := by simp
  have h0 := lrTypeFamINRKCanon_substLet_botFamCpt (envClosed_of_envWfT hW)
    (envMembersSubstStable_of_envWfT hW) t w0 hc hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using hw0)
    (by simpa only [substRemove_zero_cons] using hΓ) h
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

theorem lrTypeFamINRKCanon_substLet0_famProbeCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {t w0 A A' : Expr Nat}
    (hw0 : HasTyT E n Γ w0 t) {c : CptI} (hc : FamProbeCpt E c)
    (h : LRTypeFamINRKCanon E n (.letBinding t w0 :: Γ) A A' c) :
    LRTypeFamINRKCanon E n Γ (instantiate0 w0 A) (instantiate0 w0 A') c :=
  lrTypeFamINRKCanon_substLet0_botFamCpt hW hΓ hw0 (botFamCpt_of_famProbeCpt hc) h

/-- **All-Depth Assumption-Spine Substitution Stability of `LRTypeFamINRKCanon` Across All
    `BotFamCpt E` Compacts (`lrTypeFamINRKCanon_subst_bvarSpine_botFamCpt`):** -/
theorem lrTypeFamINRKCanon_subst_bvarSpine_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    (m_var : Nat) (vargs : List (Expr Nat)) (t : Expr Nat)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} {j : Nat},
      Γ[j]? = some (.assumption t) →
      lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none →
      HasTyT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
        (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j t) →
      CtxWfT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ) →
      LRTypeFamINRKCanon E n Γ A A' c →
      LRTypeFamINRKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
        (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A)
        (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A') c := by
  let v := foldApps (.bvar m_var) vargs
  induction hc with
  | bot =>
      intro Γ A A' j _ _ _ _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' j hget hnone _ _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₁)
            (whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₂)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' j hget hnone hvty hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have hlift : lift 0 1 (lift 0 j v) = lift 0 (j + 1) v :=
            lift_lift_merge 1 j 0 0 (by omega) (by omega) v
          have h₁' : WhRedRecKCanon E (substRemove v j Γ) (instantiate j (lift 0 j v) A)
              (.pi (instantiate j (lift 0 j v) A₁) (instantiate (j + 1) (lift 0 (j + 1) v) B₁)) := by
            have h0 := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₁
            simpa only [instantiate, hlift] using h0
          have h₂' : WhRedRecKCanon E (substRemove v j Γ) (instantiate j (lift 0 j v) A')
              (.pi (instantiate j (lift 0 j v) A₂) (instantiate (j + 1) (lift 0 (j + 1) v) B₂)) := by
            have h0 := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₂
            simpa only [instantiate, hlift] using h0
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hΓ₁' : CtxWfT E n (substRemove v (j + 1) (.assumption A₁ :: Γ)) :=
            subst_arg_wf_assump hcl hinst hget hvty hΓ' hA₁
          have hget' : (LocalDecl.assumption A₁ :: Γ)[j + 1]? = some (.assumption t) := by
            rw [List.getElem?_cons_succ]; exact hget
          have hnone' : lookupValue (substRemove v (j + 1) (.assumption A₁ :: Γ))
              (m_var + (j + 1)) = none := by
            rw [substRemove_succ_cons, instDecl, show m_var + (j + 1) = (m_var + j) + 1 by omega,
              lookupValue_cons_succ, hnone]
            rfl
          have hvty' : HasTyT E n (substRemove v (j + 1) (.assumption A₁ :: Γ))
              (lift 0 (j + 1) v) (lift 0 (j + 1) t) := by
            have h0 := hasTyTWeaken (instDecl j v (.assumption A₁)) hcl (c := 0) hvty
            rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
                lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
            exact h0
          have hdom' : TyConvT E n (substRemove v j Γ)
              (instantiate j (lift 0 j v) A₁) (instantiate j (lift 0 j v) A₂) :=
            tyConvT_substS hcl hinst v t hdom hget hvty
          have hcod' : TyConvT E n (.assumption (instantiate j (lift 0 j v) A₁) :: substRemove v j Γ)
              (instantiate (j + 1) (lift 0 (j + 1) v) B₁)
              (instantiate (j + 1) (lift 0 (j + 1) v) B₂) := by
            simpa only [substRemove_succ_cons, instDecl] using
              tyConvT_substS hcl hinst v t (j := j + 1) hcod hget' hvty'
          have hΓ₁'' : CtxWfT E n (.assumption (instantiate j (lift 0 j v) A₁) :: substRemove v j Γ) := by
            simpa only [substRemove_succ_cons, instDecl] using hΓ₁'
          exact .pi h₁' h₂' hΓ₁'' hdom' hcod'
            (iha hget hnone hvty hΓ' ra)
            (fun s hs => by
              simpa only [substRemove_succ_cons, instDecl] using
                ihf s hs hget' hnone' hvty' hΓ₁' (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' j hget hnone hvty _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedRecKCanon E (substRemove v j Γ) (instantiate j (lift 0 j v) A)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v)))) := by
            have h0 := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₁
            rwa [instantiate_famApp] at h0
          have h₂' : WhRedRecKCanon E (substRemove v j Γ) (instantiate j (lift 0 j v) A')
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) := by
            have h0 := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone h₂
            rwa [instantiate_famApp] at h0
          have hty₁ : HasTyT E n (substRemove v j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v)))) (.sort w) := by
            have h0 := hasTyT_substS hcl hinst v t hty hget hvty
            rwa [instantiate_famApp] at h0
          have hty₂ : HasTyT E n (substRemove v j Γ)
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) (.sort w') := by
            have h0 := hasTyT_substS hcl hinst v t hty' hget hvty
            rwa [instantiate_famApp] at h0
          have hc'' : TyConvT E n (substRemove v j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v))))
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) := by
            have h0 := tyConvT_substS hcl hinst v t hc' hget hvty
            rwa [instantiate_famApp, instantiate_famApp] at h0
          have hlen₁ : (xs.map (instantiate j (lift 0 j v))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (instantiate j (lift 0 j v))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_subst_instMtype hcl hinst hm' ls v t hget hvty hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

theorem lrTypeFamINRKCanon_subst0_bvarSpine_botFamCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {m_var : Nat} {vargs : List (Expr Nat)} {t A A' : Expr Nat}
    (hnone : lookupValue Γ m_var = none)
    (hv : HasTyT E n Γ (foldApps (.bvar m_var) vargs) t)
    {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamINRKCanon E n (.assumption t :: Γ) A A' c) :
    LRTypeFamINRKCanon E n Γ
      (instantiate0 (foldApps (.bvar m_var) vargs) A)
      (instantiate0 (foldApps (.bvar m_var) vargs) A') c := by
  have hget0 : (LocalDecl.assumption t :: Γ)[0]? = some (.assumption t) := by simp
  have h0 := lrTypeFamINRKCanon_subst_bvarSpine_botFamCpt (envClosed_of_envWfT hW)
    (envMembersSubstStable_of_envWfT hW) m_var vargs t hc hget0
    (by simpa only [substRemove_zero_cons, Nat.add_zero] using hnone)
    (by simpa only [substRemove_zero_cons, lift_zero] using hv)
    (by simpa only [substRemove_zero_cons] using hΓ) h
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

/-- For any `A, A'` satisfying `LRTypeFamINBiRKCanon E n (.letBinding t w0 :: Γ) A A'`,
    any `BotFamCpt E c` with `ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 A) c ∨
    ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 A') c` satisfies
    `LRTypeFamINRKCanon E n Γ (instantiate0 w0 A) (instantiate0 w0 A') c` (for **every** `w0`!). -/
theorem lrTypeFamINBiRKCanon_substLet0_of_approxDI {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {t w0 A A' : Expr Nat}
    (hw0 : HasTyT E n Γ w0 t)
    (h : LRTypeFamINBiRKCanon E n (.letBinding t w0 :: Γ) A A')
    {c : CptI} (hc : BotFamCpt E c)
    (happrox : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 A) c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 A') c) :
    LRTypeFamINRKCanon E n Γ (instantiate0 w0 A) (instantiate0 w0 A') c := by
  have happrox' : ApproxDIKCanon E (.letBinding t w0 :: Γ) A c ∨
      ApproxDIKCanon E (.letBinding t w0 :: Γ) A' c := by
    rcases happrox with hL | hR
    · exact Or.inl (approxDIKCanon_of_approxDI ((approxDI_substLet0_ctxEnvDI_iff E Γ t w0 A c).mp hL))
    · exact Or.inr (approxDIKCanon_of_approxDI ((approxDI_substLet0_ctxEnvDI_iff E Γ t w0 A' c).mp hR))
  exact lrTypeFamINRKCanon_substLet0_botFamCpt hW hΓ hw0 hc (h c hc happrox')

/-- Diagonal `.letE A v b` case of `LRTypeFamINBiProbeRKCanon` from the diagonal on `instantiate0 v b`. -/
theorem lrTypeFamINBiProbeRKCanon_letE_diag {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A v b : Expr Nat)
    (hdiag : LRTypeFamINBiProbeRKCanon E n Γ (instantiate0 v b) (instantiate0 v b)) :
    LRTypeFamINBiProbeRKCanon E n Γ (.letE A v b) (.letE A v b) :=
  lrTypeFamINBiProbeRKCanon_diag_of_whRedRecKCanon hW (.step (.zeta A v b) (.refl _)) hdiag

/-- `.zeta A v b` case of `LRTypeFamINBiProbeRKCanon` from the diagonal on `instantiate0 v b`. -/
theorem lrTypeFamINBiProbeRKCanon_zeta {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A v b : Expr Nat)
    (hdiag : LRTypeFamINBiProbeRKCanon E n Γ (instantiate0 v b) (instantiate0 v b)) :
    LRTypeFamINBiProbeRKCanon E n Γ (.letE A v b) (instantiate0 v b) :=
  lrTypeFamINBiProbeRKCanon_whStepRecKCanon_left hW (.zeta A v b) hdiag


/-! #### Part C — `IsRigidPropRecKCanon` & Constructive Weakening / `.letBinding` Substitution / Assumption-Spine Substitution / `TyConvT` Transport for `LRTermFamINDRKCanon` -/

/-- **Rigid Non-Sort Proposition Classifier Over `WhRedRecKCanon` (`IsRigidPropRecKCanon E n Γ A`):**
    A type `A` has `HasTyT E n Γ A (.sort .zero)` (`Prop`) and reduces under `WhRedRecKCanon E Γ`
    either to a `.pi A₁ B₁` or to a saturated admitted `.inductiveM` family spine
    `foldApps (.const r ls) xs` (`xs.length = (piDomsOf m.mtype).length`). -/
def IsRigidPropRecKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A : Expr Nat) : Prop :=
  Nonempty (HasTyT E n Γ A (.sort .zero)) ∧
    ((∃ A₁ B₁, WhRedRecKCanon E Γ A (.pi A₁ B₁)) ∨
     (∃ r m ls xs, E.members r = some m ∧ m.mclass = .inductiveM ∧
       xs.length = (piDomsOf m.mtype).length ∧
       WhRedRecKCanon E Γ A (foldApps (.const r ls) xs)))

theorem isRigidPropRecKCanon_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ : Expr Nat}
    (h0 : HasTyT E n Γ (.pi A₁ B₁) (.sort .zero)) :
    IsRigidPropRecKCanon E n Γ (.pi A₁ B₁) :=
  ⟨⟨h0⟩, Or.inl ⟨A₁, B₁, .refl _⟩⟩

theorem isRigidPropRecKCanon_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsRigidPropRecKCanon E n Γ (foldApps (.const r ls) xs) :=
  ⟨⟨h0⟩, Or.inr ⟨r, m, ls, xs, hm, hind, hlen, .refl _⟩⟩

theorem isRigidPropRecKCanon_famApp_of_probeRKCanon {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINProbeRKCanon E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsRigidPropRecKCanon E n Γ (foldApps (.const r ls) xs) :=
  isRigidPropRecKCanon_famApp hm hind
    (famApp_length_eq_piDomsOf_of_fundamentalLRFamINProbeRKCanon hW F hΓ hm hind h0) h0

/-- Under `EnvWfT E`, `IsRigidPropRecKCanon E n Γ A` implies `IsNonSortPropRecKCanon E n Γ A`. -/
theorem isNonSortPropRecKCanon_of_isRigidPropRecKCanon {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) :
    IsNonSortPropRecKCanon E n Γ A := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨fun l hsort => ?_, ⟨h0⟩⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, _, hfam⟩
  · have e := whRedRecKCanon_normal_unique_of_envWfT hW
      hsort (whNormalRecKCanon_sort l) hpi (whNormalRecKCanon_pi A₁ B₁)
    exact Expr.noConfusion e
  · have e := whRedRecKCanon_normal_unique_of_envWfT hW
      hsort (whNormalRecKCanon_sort l) hfam (whNormalRecKCanon_famApp hW hm hind ls xs)
    exact foldApps_const_ne_sort r ls xs l e.symm

/-- `IsRigidPropRecKCanon` is constructively preserved under all-cutoff weakening
    `insertAt d k Γ` / `lift k 1`. -/
theorem isRigidPropRecKCanon_weaken {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    (d : LocalDecl) (k : Nat) {Γ : LCtx}
    (hk : k ≤ Γ.length ∨ ∃ B, d = .assumption B)
    {A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) :
    IsRigidPropRecKCanon E n (insertAt d k Γ) (lift k 1 A) := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyTWeaken d hcl (c := k) h0⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨lift k 1 A₁, lift (k + 1) 1 B₁, whRedRecKCanon_lift_of_envClosed hcl hpi d k hk⟩
  · refine Or.inr ⟨r, m, ls, xs.map (lift k 1), hm, hind, by rw [List.length_map, hlen], ?_⟩
    have h0 := whRedRecKCanon_lift_of_envClosed hcl hfam d k hk
    rwa [foldApps_lift] at h0

/-- `IsRigidPropRecKCanon` is constructively preserved under `.letBinding` substitution
    `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` for **every** `w0 : Expr Nat`! -/
theorem isRigidPropRecKCanon_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    {A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) :
    IsRigidPropRecKCanon E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A) := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyT_substLetS hcl hinst t w0 h0 hget hvty⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j w0) A₁, instantiate (j + 1) (lift 0 1 (lift 0 j w0)) B₁,
      whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hpi⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j w0)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hfam
    rwa [instantiate_famApp] at hr

/-- `IsRigidPropRecKCanon` is constructively preserved under assumption-spine substitution
    `substRemove (foldApps (.bvar m_var) vargs) j Γ`. -/
theorem isRigidPropRecKCanon_subst_bvarSpine {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    (m_var : Nat) (vargs : List (Expr Nat)) (t : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
    (hvty : HasTyT E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (lift 0 j (foldApps (.bvar m_var) vargs)) (lift 0 j t))
    {A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) :
    IsRigidPropRecKCanon E n (substRemove (foldApps (.bvar m_var) vargs) j Γ)
      (instantiate j (lift 0 j (foldApps (.bvar m_var) vargs)) A) := by
  let v := foldApps (.bvar m_var) vargs
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyT_substS hcl hinst v t h0 hget hvty⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j v) A₁, instantiate (j + 1) (lift 0 1 (lift 0 j v)) B₁,
      whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hpi⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j v)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedRecKCanon_instantiate_bvarSpine_of_envClosed hcl hget hnone hfam
    rwa [instantiate_famApp] at hr

/-- Transport `IsRigidPropRecKCanon E n Γ A` along `TyConvT E n Γ A A'` using
    `FundamentalLRFamINProbeRKCanon E n`, `ZeroSortCoherence E n`, and `EnvWfT E` **alone**
    (evaluating `hF` only on `FamProbeCpt E` compacts `.pi .bot []` and `.spine r (botVecI xs)`). -/
theorem isRigidPropRecKCanon_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINProbeRKCanon E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsRigidPropRecKCanon E n Γ A) :
    IsRigidPropRecKCanon E n Γ A' := by
  obtain ⟨⟨hA0⟩, hshape⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨⟨hA'0⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · have hcA : ApproxDIKCanon E Γ A (.pi .bot []) :=
      approxDIKCanon_of_whRedRecKCanon hpi (approxDIKCanon_pi_bot_nil E Γ A₁ B₁)
    have hLR := hF hΓ hA0 hAA' (.pi .bot []) .pi_bot_nil hcA
    cases hLR with
    | @pi _ _ _ _ _ A₂ B₂ _ _ _ hred' _ _ _ _ _ =>
        exact Or.inl ⟨A₂, B₂, hred'⟩
  · have hcA : ApproxDIKCanon E Γ A (.spine r (botVecI xs)) :=
      approxDIKCanon_of_whRedRecKCanon hfam
        (approxDIKCanon_famApp_botVecI_of_inductiveM hW Γ hm hind ls xs)
    have hLR := hF hΓ hA0 hAA' (.spine r (botVecI xs))
      (famProbeCpt_famSpine_botVecI hm hind hlen) hcA
    cases hLR with
    | @famSpine _ _ _ _ m' _ ls' _ xs' _ _ _ hm' hind' _ hred' _ _ _ _ _ hlen' _ =>
        exact Or.inr ⟨r, m', ls', xs', hm', hind', hlen', hred'⟩
    | otherSpine hnot _ _ _ _ _ =>
        exact (hnot m hm hind).elim

theorem lrTermFamINDRKCanon_of_isRigidPropRecKCanon {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M N A : Expr Nat} (h : IsRigidPropRecKCanon E n Γ A) (u : CptI) :
    LRTermFamINDRKCanon E n Γ M N A u :=
  lrTermFamINDRKCanon_of_nonSortPropRecKCanon (isNonSortPropRecKCanon_of_isRigidPropRecKCanon hW h) u

/-- **All-Cutoff Weakening of `LRTermFamINDRKCanon` Across All `BotFamCpt E` Compacts at
    Sort-Classified Types (`lrTermFamINDRKCanon_weaken_botFamCpt_sort`):** -/
theorem lrTermFamINDRKCanon_weaken_botFamCpt_sort {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} {k : Nat}
    (hk : k ≤ Γ.length ∨ ∃ B, d = .assumption B)
    (hΓ' : CtxWfT E n (insertAt d k Γ))
    {M M' A : Expr Nat} {l : Level} (hA : WhRedRecKCanon E Γ A (.sort l))
    {c : CptI} (hc : BotFamCpt E c)
    (h : LRTermFamINDRKCanon E n Γ M M' A c) :
    LRTermFamINDRKCanon E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') (lift k 1 A) c := by
  have hA' : WhRedRecKCanon E (insertAt d k Γ) (lift k 1 A) (.sort l) :=
    whRedRecKCanon_lift_of_envClosed hcl hA d k hk
  have hLR : LRTypeFamINRKCanon E n Γ M M' c := by
    cases hc with
    | bot => exact .bot _ _ _
    | sort =>
        rcases (lrTermFamINDRKCanon_sort_iff _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | pi =>
        rcases (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | famSpine =>
        rcases (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mp h with ⟨_, h2⟩ | ⟨hns, _⟩ | ⟨hns, _⟩
        · exact h2
        · exact (hns l hA).elim
        · exact (hns l hA).elim
  have hLR' : LRTypeFamINRKCanon E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') c :=
    lrTypeFamINRKCanon_weaken_botFamCpt hcl hc d k hk hΓ' hLR
  cases hc with
  | bot => exact lrTermFamINDRKCanon_bot _ _ _ _
  | sort => exact (lrTermFamINDRKCanon_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)

/-- **Unconditional `.letBinding` Substitution Stability of `LRTermFamINDRKCanon` Across All
    `BotFamCpt E` Compacts at Sort-Classified Types (`lrTermFamINDRKCanon_substLet_botFamCpt_sort`):**
    Holds for **every** `w0 : Expr Nat`! -/
theorem lrTermFamINDRKCanon_substLet_botFamCpt_sort {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {Γ : LCtx} {j : Nat} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    (hΓ' : CtxWfT E n (substRemove w0 j Γ))
    {M M' A : Expr Nat} {l : Level} (hA : WhRedRecKCanon E Γ A (.sort l))
    {c : CptI} (hc : BotFamCpt E c)
    (h : LRTermFamINDRKCanon E n Γ M M' A c) :
    LRTermFamINDRKCanon E n (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) M) (instantiate j (lift 0 j w0) M')
      (instantiate j (lift 0 j w0) A) c := by
  have hA' : WhRedRecKCanon E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A) (.sort l) :=
    whRedRecKCanon_instantiate_letBinding_of_envClosed hcl hget hA
  have hLR : LRTypeFamINRKCanon E n Γ M M' c := by
    cases hc with
    | bot => exact .bot _ _ _
    | sort =>
        rcases (lrTermFamINDRKCanon_sort_iff _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | pi =>
        rcases (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | famSpine =>
        rcases (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mp h with ⟨_, h2⟩ | ⟨hns, _⟩ | ⟨hns, _⟩
        · exact h2
        · exact (hns l hA).elim
        · exact (hns l hA).elim
  have hLR' := lrTypeFamINRKCanon_substLet_botFamCpt hcl hinst t w0 hc hget hvty hΓ' hLR
  cases hc with
  | bot => exact lrTermFamINDRKCanon_bot _ _ _ _
  | sort => exact (lrTermFamINDRKCanon_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)

/-- **Assumption-Spine Substitution Stability of `LRTermFamINDRKCanon` Across All `BotFamCpt E`
    Compacts at Sort-Classified Types (`lrTermFamINDRKCanon_subst_bvarSpine_botFamCpt_sort`):** -/
theorem lrTermFamINDRKCanon_subst_bvarSpine_botFamCpt_sort {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    (m_var : Nat) (vargs : List (Expr Nat)) (t : Expr Nat)
    {Γ : LCtx} {j : Nat} (hget : Γ[j]? = some (.assumption t))
    (hnone : lookupValue (substRemove (foldApps (.bvar m_var) vargs) j Γ) (m_var + j) = none)
