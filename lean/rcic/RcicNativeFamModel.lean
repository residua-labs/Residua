  ⟨lrTermFamINDRK_of_lrTypeFamINRK_sort (.imax (.succ .zero) (.succ .zero)) c
     (lrTypeFamINRK_mixAnd_left c hc h).1,
   lrTermFamINDRK_of_lrTypeFamINRK_sort (.imax (.succ .zero) (.succ .zero)) c
     (lrTypeFamINRK_mixAnd_left c hc h).2⟩


/-! #### Part B — Wall `W-K-NONUNIQUE`: Refutation of `WhDetRecK`, `WhDiamondRecK`, `WhConfluentRecK`, and `WhNormalUniqueRecK` in Admitted `trueEnvU` and `andEnvU` -/

/-- One-step determinism predicate for `WhStepRecK E n Γ`. -/
def WhDetRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhStepRecK E n Γ a b → WhStepRecK E n Γ a c → b = c

/-- Normal-form uniqueness predicate for `WhRedRecK E n Γ` / `WhNormalRecK E n Γ`. -/
def WhNormalUniqueRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Prop :=
  ∀ {a X Y : Expr Nat}, WhRedRecK E n Γ a X → WhNormalRecK E n Γ X →
    WhRedRecK E n Γ a Y → WhNormalRecK E n Γ Y → X = Y

/-- Confluence predicate for `WhRedRecK E n Γ`. -/
def WhConfluentRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhRedRecK E n Γ a b → WhRedRecK E n Γ a c →
    ∃ d, WhRedRecK E n Γ b d ∧ WhRedRecK E n Γ c d

/-- One-step diamond (joinability of one-step reducts) predicate for `WhStepRecK E n Γ`. -/
def WhDiamondRecK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhStepRecK E n Γ a b → WhStepRecK E n Γ a c →
    ∃ d, WhRedRecK E n Γ b d ∧ WhRedRecK E n Γ c d

/-- Any `WhRedRecK` reduction starting from a `WhNormalRecK` expression is trivial (`Y = X`). -/
theorem whRedRecK_of_whNormalRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {X Y : Expr Nat}
    (hX : WhNormalRecK E n Γ X) (hr : WhRedRecK E n Γ X Y) : Y = X := by
  cases hr with
  | refl => rfl
  | step hs _ => exact (hX _ hs).elim

/-- `WhConfluentRecK` implies `WhNormalUniqueRecK`. -/
theorem whNormalUniqueRecK_of_whConfluentRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hconf : WhConfluentRecK E n Γ) : WhNormalUniqueRecK E n Γ := by
  intro a X Y hX hnX hY hnY
  obtain ⟨d, hdX, hdY⟩ := hconf hX hY
  exact (whRedRecK_of_whNormalRecK hnX hdX).symm.trans (whRedRecK_of_whNormalRecK hnY hdY)

/-- `WhConfluentRecK` implies `WhDiamondRecK`. -/
theorem whDiamondRecK_of_whConfluentRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hconf : WhConfluentRecK E n Γ) : WhDiamondRecK E n Γ :=
  fun h₁ h₂ => hconf (.step h₁ (.refl _)) (.step h₂ (.refl _))

/-- `WhDetRecK` implies `WhDiamondRecK`. -/
theorem whDiamondRecK_of_whDetRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hdet : WhDetRecK E n Γ) : WhDiamondRecK E n Γ := by
  intro a b c h₁ h₂
  rcases hdet h₁ h₂ with rfl
  exact ⟨b, .refl b, .refl b⟩

/-- `WhDetRecK` implies `WhNormalUniqueRecK`. -/
theorem whNormalUniqueRecK_of_whDetRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hdet : WhDetRecK E n Γ) : WhNormalUniqueRecK E n Γ := by
  intro a X Y h₁ hX h₂ hY
  induction h₁ with
  | refl =>
      cases h₂ with
      | refl => rfl
      | step hs₂ _ => exact (hX _ hs₂).elim
  | step hs₁ _ ih =>
      cases h₂ with
      | refl => exact (hY _ hs₁).elim
      | step hs₂ hred₂ =>
          rcases hdet hs₁ hs₂ with rfl
          exact ih hX hred₂

/-- **Refutation of One-Step Determinism `WhDetRecK` in Closed `trueEnvU` (`not_whDetRecK_trueEnvU`):**
    Even in `trueEnvU` at the empty context `Γ = []`, the closed redex `trueIotaMajorSort` steps in
    one step via `WhStepRecK.pmajor` to `.sort .zero` (`whStepRecK_trueIotaMajorSort_pmajor`) and in
    one step via `WhStepRecK.recMajor` to
    `iotaLhsOf (trueRecWitness (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero))`
    (`whStepRecK_trueIotaMajorSort_recMajor`), which are distinct expressions! -/
theorem whStepRecK_trueIotaMajorSort_pmajor (n : Nat) (Γ : LCtx) :
    WhStepRecK trueEnvU n Γ trueIotaMajorSort (.sort .zero) :=
  .pmajor (.ofU (trueRecWitness (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero)))
    ⟨trueConstTyT rfl⟩ ⟨hasTyT_trueIntro⟩ ⟨hasTyT_trueMajorBeta⟩

theorem whStepRecK_trueIotaMajorSort_recMajor (n : Nat) (Γ : LCtx) :
    WhStepRecK trueEnvU n Γ trueIotaMajorSort
      (iotaLhsOf (trueRecWitness (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero))) :=
  .recMajor (r := 2) (m := trueRecMemberU) (ls := [.succ (.succ .zero)])
    (pre := [trueSortMotive (.succ .zero), .sort .zero]) rfl rfl rfl
    (.recCtx (.beta (.const 0 []) (.bvar 0) (.const 1 [])))

theorem not_whDetRecK_trueEnvU (n : Nat) (Γ : LCtx) :
    ¬ WhDetRecK trueEnvU n Γ := by
  intro hdet
  have heq := hdet (whStepRecK_trueIotaMajorSort_pmajor n Γ)
    (whStepRecK_trueIotaMajorSort_recMajor n Γ)
  exact nomatch heq

theorem not_whDetRecK_trueEnvU_nil (n : Nat) :
    ¬ WhDetRecK trueEnvU n [] :=
  not_whDetRecK_trueEnvU n []

/-- Parametric `IotaWitness andEnvU` constructor for `And.rec.{u} a b mot min (And.intro a b x y)`. -/
noncomputable def andIotaWitness (u : Level) (mot min x y : Expr Nat) : IotaWitness andEnvU :=
  { mixAndW with
    ls := [u]
    preMajor := [.bvar 4, .bvar 3, mot, min]
    fields := [x, y]
    minor := min
    hlen := rfl
    hpre := rfl
    hminor := rfl
    hlsLen := rfl
    hctorAfter := rfl }

/-- Second well-typed proof `mixProofY2 = (λ z : b, z) y` of `b = .bvar 3` in `mixAndCtx`. -/
def mixProofY2 : Expr Nat :=
  .app (.lam (.bvar 3) (.bvar 0)) (.bvar 1)

noncomputable def mixTyY2 : HasTyT andEnvU 0 mixAndCtx mixProofY2 (.bvar 3) :=
  .app _ _ _ _ _
    (.lam _ (.bvar 3) .zero (.bvar 0) (.bvar 4) mixTyB (.bvar _ 0 _ rfl))
    mixTyY

/-- Second canonical constructor major `mixAndMkApp2 = And.intro a b x ((λ z : b, z) y)` of type
    `mixAndFamApp = And a b` in `mixAndCtx`. -/
def mixAndMkApp2 : Expr Nat :=
  foldApps (.const 1 []) [.bvar 4, .bvar 3, .bvar 2, mixProofY2]

noncomputable def mixAndMkTy2 : HasTyT andEnvU 0 mixAndCtx mixAndMkApp2 mixAndFamApp :=
  .app _ _ _ _ _
    (.app _ _ _ _ _
      (.app _ _ _ _ _
        (.app _ _ _ _ _
          (.const _ 1 [] andIntroMember rfl rfl rfl) mixTyA)
        mixTyB)
      mixTyX)
    mixTyY2

/-- **One-Step `WhDiamondRecK` Refutation Redex (`andOneStepFamRedex`):**
    `And.rec.{1} a b (λ _, Sort 1) And h` in `mixAndCtx`. Because the minor is the inductive family
    constant `And = .const 0 []`, a single `WhStepRecK.pmajor` step using `mixAndMkApp` produces the
    `WhNormalRecK` family spine `And x y`, while a single `WhStepRecK.pmajor` step using `mixAndMkApp2`
    produces the distinct `WhNormalRecK` family spine `And x ((λ z : b, z) y)`! -/
def andOneStepFamRedex : Expr Nat :=
  recCall (.const 2 [.succ .zero]) [.bvar 4, .bvar 3, mixAndMot, .const 0 []] (.bvar 0)

def andOneStepFamNF1 : Expr Nat :=
  foldApps (.const 0 []) [.bvar 2, .bvar 1]

