/-- Recursor application `True.rec.{u} motive minor trueMajorBeta` with non-canonical β-redex major. -/
def trueRecMajorBeta (u : Level) (motive minor : Expr Nat) : Expr Nat :=
  .app (.app (.app (.const 2 [u]) motive) minor) trueMajorBeta

/-- In `ApproxDI trueEnvU`, `trueRecMajorBeta u motive minor` is semantically equal (`SemEqDI`) to
    `minor` for every `u, motive, minor, ρ`. -/
theorem semEqDI_trueRecMajorBeta (u : Level) (motive minor : Expr Nat) (ρ : EnvI) :
    PiModelDeltaIotaAudit.SemEqDI trueEnvU ρ (trueRecMajorBeta u motive minor) minor := by
  have h₁ : PiModelDeltaIotaAudit.SemEqDI trueEnvU ρ
      (trueRecMajorBeta u motive minor) (iotaLhsOf (trueRecWitness u motive minor)) :=
    PiModelDeltaIotaAudit.semEqDI_app
      (PiModelDeltaIotaAudit.semEqDI_refl _ _ _)
      (semEqDI_trueMajorBeta trueEnvU ρ)
  have h₂ : PiModelDeltaIotaAudit.SemEqDI trueEnvU ρ
      (iotaLhsOf (trueRecWitness u motive minor)) minor :=
    PiModelDeltaIotaAudit.approxDI_iota_of_envWfT trueEnvUWfT (trueRecWitness u motive minor) ρ
  exact PiModelDeltaIotaAudit.semEqDI_trans h₁ h₂

/-- Every `DerivedIotaU E lhs rhs` source has at least 3 spine arguments
    (`3 ≤ (appsSpine lhs).2.length`), because `w.ctorIdx < w.nMinors` forces `1 ≤ w.nMinors` and
    `w.preMajor.length = w.nparams + 1 + w.nMinors + w.nindices ≥ 2`. -/
theorem derivedIotaU_args_length_ge_three {E : ResolvedEnv} {lhs rhs : Expr Nat}
    (hI : DerivedIotaU E lhs rhs) : 3 ≤ (appsSpine lhs).2.length := by
  cases hI with
  | ofU w =>
      unfold iotaLhsOf recCall
      have hsp := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [ctorMajor w])
      simp only [appsSpine_const, List.nil_append] at hsp
      rw [hsp]
      simp only [List.length_append, List.length_singleton]
      have hpre := w.hpre
      have hidx := w.hidx
      omega
  | ofUS w =>
      unfold iotaLhsOfS recCall
      have hsp := appsSpine_foldApps (.const w.recRef w.ls)
        (w.preMajor ++ [foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)])
      simp only [appsSpine_const, List.nil_append] at hsp
      rw [hsp]
      simp only [List.length_append, List.length_singleton]
      have hpre := w.hpre
      have hidx := w.hidx
      omega

/-- Every `DerivedIotaU E (.app f major) rhs` has a `.const`-headed major argument (`∃ c lsC,
    (appsSpine major).1 = .const c lsC`). -/
theorem derivedIotaU_major_headOf_const {E : ResolvedEnv} {f major rhs : Expr Nat}
    (hI : DerivedIotaU E (.app f major) rhs) :
    ∃ c lsC, (appsSpine major).1 = .const c lsC := by
  generalize hl : Expr.app f major = lhs at hI
  cases hI with
  | ofU w =>
      unfold iotaLhsOf recCall at hl
      rw [foldApps_snoc] at hl
      injection hl with _ hmaj
      unfold ctorMajor ctorSpine at hmaj
      have hsp := appsSpine_foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)
      simp only [appsSpine_const, List.nil_append] at hsp
      rw [hmaj, hsp]
      exact ⟨w.ctorRef, w.lsC, rfl⟩
  | ofUS w =>
      unfold iotaLhsOfS recCall at hl
      rw [foldApps_snoc] at hl
      injection hl with _ hmaj
      have hsp := appsSpine_foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)
      simp only [appsSpine_const, List.nil_append] at hsp
      rw [hmaj, hsp]
      exact ⟨w.ctorRef, w.lsC, rfl⟩

/-- No 2-argument or shorter spine headed by `.const 2 [u]` in `trueEnvU` takes a `WhStep`. -/
theorem whStep_trueRec_prefix_false (u : Level) (motive minor : Expr Nat) {e : Expr Nat}
    (hs : WhStep trueEnvU (.app (.app (.const 2 [u]) motive) minor) e) : False := by
  cases hs with
  | iota hI =>
      have hlen := derivedIotaU_args_length_ge_three hI
      simp [appsSpine] at hlen
  | appHead hf =>
      cases hf with
      | iota hI =>
          have hlen := derivedIotaU_args_length_ge_three hI
          simp [appsSpine] at hlen
      | appHead hf0 =>
          cases hf0 with
          | delta hres hbody =>
              change trueEnvU.members 2 = some _ at hres
              injection hres with hm
              subst hm
              exact Option.noConfusion hbody
          | iota hI =>
              have hlen := derivedIotaU_args_length_ge_three hI
              simp [appsSpine] at hlen

/-- **Key Normal-Form Theorem (`whStep_trueRecMajorBeta_false`):**
    `trueRecMajorBeta u motive minor` takes **no** `WhStep trueEnvU` step:
    - root `iota` is blocked because `headOf trueMajorBeta = .lam … ≠ .const …`
      (`derivedIotaU_major_headOf_const`);
    - `appHead` is blocked because `.app (.app (.const 2 [u]) motive) minor` has only 2 arguments
      (`whStep_trueRec_prefix_false`). -/
theorem whStep_trueRecMajorBeta_false (u : Level) (motive minor : Expr Nat) {e : Expr Nat}
    (hs : WhStep trueEnvU (trueRecMajorBeta u motive minor) e) : False := by
  cases hs with
  | iota hI =>
      obtain ⟨c, lsC, hhead⟩ := derivedIotaU_major_headOf_const hI
      exact Expr.noConfusion hhead
  | appHead hf =>
      exact whStep_trueRec_prefix_false u motive minor hf

/-- `trueRecMajorBeta u motive minor` is weak-head normal (`WhNormal trueEnvU`). -/
theorem whNormal_trueRecMajorBeta (u : Level) (motive minor : Expr Nat) :
    WhNormal trueEnvU (trueRecMajorBeta u motive minor) :=
  fun _ hs => whStep_trueRecMajorBeta_false u motive minor hs

/-- In the empty context `[]`, `WhStepCtx E [] a b` implies `WhStep E a b`. -/
theorem whStep_of_whStepCtx_nil {E : ResolvedEnv} {a b : Expr Nat}
    (h : WhStepCtx E [] a b) : WhStep E a b := by
  induction h with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | zetaLocal hv => exact Option.noConfusion hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih

/-- `trueRecMajorBeta u motive minor` is weak-head normal in `WhStepCtx trueEnvU []`. -/
theorem whNormalCtx_trueRecMajorBeta (u : Level) (motive minor : Expr Nat) :
    WhNormalCtx trueEnvU [] (trueRecMajorBeta u motive minor) :=
  fun _ hs => whStep_trueRecMajorBeta_false u motive minor (whStep_of_whStepCtx_nil hs)

/-- Any `WhRed trueEnvU (trueRecMajorBeta u motive minor) X` forces `X = trueRecMajorBeta u motive minor`. -/
theorem whRed_trueRecMajorBeta_eq {u : Level} {motive minor X : Expr Nat}
    (h : WhRed trueEnvU (trueRecMajorBeta u motive minor) X) :
    X = trueRecMajorBeta u motive minor := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStep_trueRecMajorBeta_false u motive minor hs).elim

/-- Any `WhRedCtx trueEnvU [] (trueRecMajorBeta u motive minor) X` forces `X = trueRecMajorBeta u motive minor`. -/
theorem whRedCtx_trueRecMajorBeta_eq {u : Level} {motive minor X : Expr Nat}
    (h : WhRedCtx trueEnvU [] (trueRecMajorBeta u motive minor) X) :
    X = trueRecMajorBeta u motive minor := by
  cases h with
  | refl => rfl
  | step hs _ =>
      exact (whStep_trueRecMajorBeta_false u motive minor (whStep_of_whStepCtx_nil hs)).elim

/-- Constant motive `λ _ : True, Sort u` at universe `u`. -/
def trueSortMotive (u : Level) : Expr Nat :=
  .lam (.const 0 []) (.sort u)

/-- `trueSortMotive u : True → Sort (u + 1)` in `trueEnvU`. -/
noncomputable def hasTyT_trueSortMotive (u : Level) {n : Nat} {Γ : LCtx} :
    HasTyT trueEnvU n Γ (trueSortMotive u) (.pi (.const 0 []) (.sort (.succ u))) :=
  .lam Γ (.const 0 []) .zero (.sort u) (.sort (.succ u))
    (trueConstTyT rfl)
    (.sort (.assumption (.const 0 []) :: Γ) u)

/-- `(trueSortMotive u) True.intro ≡ Sort u : Sort (u + 1)` via `ConvT.beta`. -/
noncomputable def convT_trueSortMotive_beta (u : Level) {n : Nat} {Γ : LCtx} :
    ConvT trueEnvU n Γ (.app (trueSortMotive u) (.const 1 [])) (.sort u) (.sort (.succ u)) :=
  .beta Γ (.const 0 []) (.sort u) (.const 1 []) (.sort (.succ u)) .zero
    (trueConstTyT rfl)
    (.sort (.assumption (.const 0 []) :: Γ) u)
    hasTyT_trueIntro

/-- `(trueSortMotive u) trueMajorBeta ≡ Sort u : Sort (u + 1)` via `ConvT.app` + `ConvT.beta`. -/
noncomputable def convT_trueSortMotive_majorBeta (u : Level) {n : Nat} {Γ : LCtx} :
    ConvT trueEnvU n Γ (.app (trueSortMotive u) trueMajorBeta) (.sort u) (.sort (.succ u)) :=
  .trans Γ _ (.app (trueSortMotive u) (.const 1 [])) (.sort u) (.sort (.succ u))
    (.app Γ (trueSortMotive u) (trueSortMotive u) trueMajorBeta (.const 1 [])
      (.const 0 []) (.sort (.succ u))
      (.refl Γ (trueSortMotive u) _ (hasTyT_trueSortMotive u))
      convT_trueMajorBeta)
    (convT_trueSortMotive_beta u)

/-- For any `minor : Sort u` and `hb : levelsBounded n [.succ u] = true`,
    `trueRecMajorBeta (.succ u) (trueSortMotive u) minor` has type `.sort u` in `trueEnvU`. -/
noncomputable def hasTyT_trueRecMajorBeta (u : Level) {n : Nat} {Γ : LCtx} {minor : Expr Nat}
    (hb : levelsBounded n [.succ u] = true)
    (hminor : HasTyT trueEnvU n Γ minor (.sort u)) :
    HasTyT trueEnvU n Γ (trueRecMajorBeta (.succ u) (trueSortMotive u) minor) (.sort u) := by
  have hminorK : HasTyT trueEnvU n Γ minor (.app (trueSortMotive u) (.const 1 [])) :=
    .conv Γ minor (.sort u) (.app (trueSortMotive u) (.const 1 [])) (.succ u)
      hminor (.symm _ _ _ _ (convT_trueSortMotive_beta u))
  have hprefix : HasTyT trueEnvU n Γ
      (.app (.app (.const 2 [.succ u]) (trueSortMotive u)) minor)
      (.pi (.const 0 []) (.app (trueSortMotive u) (.bvar 0))) :=
    .app Γ _ _ _ _
      (.app Γ _ _ _ _
        (.const Γ 2 [.succ u] trueRecMemberU rfl rfl hb)
        (hasTyT_trueSortMotive u))
      hminorK
  have happ : HasTyT trueEnvU n Γ (trueRecMajorBeta (.succ u) (trueSortMotive u) minor)
      (.app (trueSortMotive u) trueMajorBeta) :=
    .app Γ _ _ _ _ hprefix hasTyT_trueMajorBeta
  exact .conv Γ _ _ (.sort u) (.succ u) happ (convT_trueSortMotive_majorBeta u)

/-- For any `minor : Sort u` and `hb : levelsBounded n [.succ u] = true`,
    `trueRecMajorBeta (.succ u) (trueSortMotive u) minor ≡ minor : Sort u` in `trueEnvU`. -/
noncomputable def convT_trueRecMajorBeta (u : Level) {n : Nat} {Γ : LCtx} {minor : Expr Nat}
    (hb : levelsBounded n [.succ u] = true)
    (hminor : HasTyT trueEnvU n Γ minor (.sort u)) :
    ConvT trueEnvU n Γ (trueRecMajorBeta (.succ u) (trueSortMotive u) minor) minor (.sort u) := by
  have hminorK : HasTyT trueEnvU n Γ minor (.app (trueSortMotive u) (.const 1 [])) :=
    .conv Γ minor (.sort u) (.app (trueSortMotive u) (.const 1 [])) (.succ u)
      hminor (.symm _ _ _ _ (convT_trueSortMotive_beta u))
  have hprefix : HasTyT trueEnvU n Γ
      (.app (.app (.const 2 [.succ u]) (trueSortMotive u)) minor)
      (.pi (.const 0 []) (.app (trueSortMotive u) (.bvar 0))) :=
    .app Γ _ _ _ _
      (.app Γ _ _ _ _
        (.const Γ 2 [.succ u] trueRecMemberU rfl rfl hb)
        (hasTyT_trueSortMotive u))
      hminorK
  have hLhsTy : HasTyT trueEnvU n Γ
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor)) (.sort u) :=
    .conv Γ _ _ (.sort u) (.succ u)
      (.app Γ _ _ _ _ hprefix hasTyT_trueIntro)
      (convT_trueSortMotive_beta u)
  have hstep1 : ConvT trueEnvU n Γ
      (trueRecMajorBeta (.succ u) (trueSortMotive u) minor)
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor))
      (.sort u) :=
    .tyConv Γ _ _ (.app (trueSortMotive u) trueMajorBeta) (.sort u) (.succ u)
      (.app Γ _ _ trueMajorBeta (.const 1 []) (.const 0 []) (.app (trueSortMotive u) (.bvar 0))
        (.refl Γ _ _ hprefix) convT_trueMajorBeta)
      (convT_trueSortMotive_majorBeta u)
  have hstep2 : ConvT trueEnvU n Γ
      (iotaLhsOf (trueRecWitness (.succ u) (trueSortMotive u) minor))
      minor (.sort u) :=
    .iota Γ _ minor (.sort u) (.of (trueRecWitness (.succ u) (trueSortMotive u) minor))
      hLhsTy hminor
  exact .trans Γ _ _ minor (.sort u) hstep1 hstep2

/-- The three concrete `W-IOTA-MAJOR` instances in `trueEnvU` at `.sort`, `.pi .bot []`, and `.spine 0 []`:
    - `trueIotaMajorSort`: `True.rec.{2} (λ _, Sort 1) (Sort 0) ((λ x, x) tt)` (reduces semantically to `Sort 0`, compact `.sort`)
    - `trueIotaMajorPi`: `True.rec.{1} (λ _, Sort 0) idPiProp ((λ x, x) tt)` (reduces semantically to `idPiProp`, compact `.pi .bot []`)
    - `trueIotaMajorFam`: `True.rec.{1} (λ _, Sort 0) True ((λ x, x) tt)` (reduces semantically to `True`, compact `.spine 0 []`). -/
def trueIotaMajorSort : Expr Nat :=
  trueRecMajorBeta (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero)

def trueIotaMajorPi : Expr Nat :=
  trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) PiModelDeltaIotaAudit.idPiProp

def trueIotaMajorFam : Expr Nat :=
  trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) (.const 0 [])

noncomputable def hasTyT_trueIotaMajorSort (n : Nat) (Γ : LCtx) :
    HasTyT trueEnvU n Γ trueIotaMajorSort (.sort (.succ .zero)) :=
  hasTyT_trueRecMajorBeta (.succ .zero) rfl (.sort Γ .zero)

noncomputable def convT_trueIotaMajorSort (n : Nat) (Γ : LCtx) :
    ConvT trueEnvU n Γ trueIotaMajorSort (.sort .zero) (.sort (.succ .zero)) :=
  convT_trueRecMajorBeta (.succ .zero) rfl (.sort Γ .zero)

noncomputable def hasTyT_trueIotaMajorPi (n : Nat) (Γ : LCtx) :
    HasTyT trueEnvU n Γ trueIotaMajorPi (.sort .zero) :=
  hasTyT_trueRecMajorBeta .zero rfl (PiModelDeltaIotaTermAudit.hasTyT_idPiProp_ctx trueEnvU n Γ)

noncomputable def convT_trueIotaMajorPi (n : Nat) (Γ : LCtx) :
    ConvT trueEnvU n Γ trueIotaMajorPi PiModelDeltaIotaAudit.idPiProp (.sort .zero) :=
  convT_trueRecMajorBeta .zero rfl (PiModelDeltaIotaTermAudit.hasTyT_idPiProp_ctx trueEnvU n Γ)

noncomputable def hasTyT_trueIotaMajorFam (n : Nat) (Γ : LCtx) :
    HasTyT trueEnvU n Γ trueIotaMajorFam (.sort .zero) :=
  hasTyT_trueRecMajorBeta .zero rfl (trueConstTyT rfl)

noncomputable def convT_trueIotaMajorFam (n : Nat) (Γ : LCtx) :
    ConvT trueEnvU n Γ trueIotaMajorFam (.const 0 []) (.sort .zero) :=
  convT_trueRecMajorBeta .zero rfl (trueConstTyT rfl)

theorem approxDI_trueIotaMajorSort (ρ : EnvI) :
    PiModelDeltaIotaAudit.ApproxDI trueEnvU ρ trueIotaMajorSort .sort :=
  (semEqDI_trueRecMajorBeta (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero) ρ .sort).mpr
    (.sort ρ .zero)

theorem approxDI_trueIotaMajorPi (ρ : EnvI) :
    PiModelDeltaIotaAudit.ApproxDI trueEnvU ρ trueIotaMajorPi (.pi .bot []) :=
  (semEqDI_trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) PiModelDeltaIotaAudit.idPiProp ρ (.pi .bot [])).mpr
    (PiModelDeltaIotaAudit.approxDI_pi_bot_nil trueEnvU ρ (.sort .zero) (.bvar 0))

theorem approxDI_trueIotaMajorFam (ρ : EnvI) :
    PiModelDeltaIotaAudit.ApproxDI trueEnvU ρ trueIotaMajorFam (.spine 0 []) :=
  (semEqDI_trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) (.const 0 []) ρ (.spine 0 [])).mpr
    (.const ρ 0 [] (rigidConst_of_inductiveM trueEnvUWfT (m := trueFamMember) rfl rfl))

theorem botFamCpt_trueFam : BotFamCpt trueEnvU (.spine 0 []) :=
  .famSpine (m := trueFamMember) rfl rfl rfl (fun _ h => (List.not_mem_nil _ h).elim)

/-- `LRTypeIN` fails at `trueIotaMajorSort` (`c = .sort`) and `trueIotaMajorPi` (`c = .pi .bot []`). -/
theorem not_lrTypeIN_trueIotaMajorSort (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeIN trueEnvU n [] trueIotaMajorSort A' .sort := by
  intro h
  cases h with
  | sort hred _ => exact nomatch whRed_trueRecMajorBeta_eq hred

theorem not_lrTypeIN_trueIotaMajorPi (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeIN trueEnvU n [] trueIotaMajorPi A' (.pi .bot []) := by
  intro h
  cases h with
  | pi hred _ _ _ _ _ _ => exact nomatch whRed_trueRecMajorBeta_eq hred

/-- `LRTypeFamIN` fails at `trueIotaMajorSort` (`.sort`), `trueIotaMajorPi` (`.pi .bot []`), and
    `trueIotaMajorFam` (`.spine 0 []`) in `Γ = []`. -/
theorem not_lrTypeFamIN_trueIotaMajorSort (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeFamIN trueEnvU n [] trueIotaMajorSort A' .sort := by
  intro h
  cases h with
  | sort hred _ => exact nomatch whRedCtx_trueRecMajorBeta_eq hred

theorem not_lrTypeFamIN_trueIotaMajorPi (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeFamIN trueEnvU n [] trueIotaMajorPi A' (.pi .bot []) := by
  intro h
  cases h with
  | pi hred _ _ _ _ _ _ => exact nomatch whRedCtx_trueRecMajorBeta_eq hred

theorem not_lrTypeFamIN_trueIotaMajorFam (n : Nat) (A' : Expr Nat) :
    ¬ LRTypeFamIN trueEnvU n [] trueIotaMajorFam A' (.spine 0 []) := by
  intro h
  cases h with
  | famSpine hm _ hred _ _ _ _ _ hlen _ _ =>
      cases hm
      have heq := whRedCtx_trueRecMajorBeta_eq hred
      have hsp := congrArg (fun e => (appsSpine e).2.length) heq
      simp only [trueIotaMajorFam, trueRecMajorBeta, appsSpine, List.length] at hsp
      rw [appsSpine_foldApps] at hsp
      simp only [appsSpine_const, List.nil_append] at hsp
      exact absurd (hlen.symm.trans hsp) (by decide)
  | otherSpine hnot =>
      exact hnot trueFamMember rfl rfl

/-- **Empty-Context Refutation of `FundamentalLRINBotDI` in `trueEnvU` (`W-IOTA-MAJOR`):**
    Even in `Γ = []` (where `zetaLocal` never fires), `FundamentalLRINBotDI trueEnvU n` is refuted
    at both `.sort` and `.pi .bot []`. -/
theorem not_fundamentalLRINBotDI_trueEnvU_nil (n : Nat) :
    ¬ PiModelDeltaIotaAudit.FundamentalLRINBotDI trueEnvU n := by
  intro F
  exact not_lrTypeIN_trueIotaMajorPi n PiModelDeltaIotaAudit.idPiProp
    (F .nil (hasTyT_trueIotaMajorPi n []) (.of _ _ _ _ (convT_trueIotaMajorPi n []))
      (.pi .bot []) PiModelDeltaIotaAudit.botPiCpt_pi_bot_nil (approxDI_trueIotaMajorPi EnvI.bot))

/-- **Empty-Context Refutation of `FundamentalTermBotDI` in `trueEnvU` (`W-IOTA-MAJOR`):** -/
theorem not_fundamentalTermBotDI_trueEnvU_nil (n : Nat) :
    ¬ PiModelDeltaIotaTermAudit.FundamentalTermBotDI trueEnvU n :=
  fun F => not_fundamentalLRINBotDI_trueEnvU_nil n
    (PiModelDeltaIotaTermAudit.fundamentalLRINBotDI_of_fundamentalTermBotDI trueEnvUWfT F)

/-- **Refutation of `LRTypeFamINBiDI` in `trueEnvU` at `Γ = []` across `.sort`, `.pi .bot []`, and `.spine 0 []`:** -/
theorem not_lrTypeFamINBiDI_trueIotaMajorSort (n : Nat) :
    ¬ LRTypeFamINBiDI trueEnvU n [] trueIotaMajorSort (.sort .zero) :=
  fun H => not_lrTypeFamIN_trueIotaMajorSort n (.sort .zero)
    (H .sort .sort (Or.inl (approxDI_trueIotaMajorSort (ctxEnvDI trueEnvU []))))

theorem not_lrTypeFamINBiDI_trueIotaMajorPi (n : Nat) :
    ¬ LRTypeFamINBiDI trueEnvU n [] trueIotaMajorPi PiModelDeltaIotaAudit.idPiProp :=
  fun H => not_lrTypeFamIN_trueIotaMajorPi n PiModelDeltaIotaAudit.idPiProp
    (H (.pi .bot []) (botFamCpt_pi_bot_nil trueEnvU)
      (Or.inl (approxDI_trueIotaMajorPi (ctxEnvDI trueEnvU []))))

theorem not_lrTypeFamINBiDI_trueIotaMajorFam (n : Nat) :
    ¬ LRTypeFamINBiDI trueEnvU n [] trueIotaMajorFam (.const 0 []) :=
  fun H => not_lrTypeFamIN_trueIotaMajorFam n (.const 0 [])
    (H (.spine 0 []) botFamCpt_trueFam (Or.inl (approxDI_trueIotaMajorFam (ctxEnvDI trueEnvU []))))

/-- **Refutation of `FundamentalLRFamINBotDI` and `FundamentalTermFamINDBotDI` in `trueEnvU` (`W-IOTA-MAJOR`):** -/
theorem not_fundamentalLRFamINBotDI_trueEnvU (n : Nat) :
    ¬ FundamentalLRFamINBotDI trueEnvU n := by
  intro F
  exact not_lrTypeFamIN_trueIotaMajorFam n (.const 0 [])
    (F .nil (hasTyT_trueIotaMajorFam n []) (.of _ _ _ _ (convT_trueIotaMajorFam n []))
      (.spine 0 []) botFamCpt_trueFam (approxDI_trueIotaMajorFam (ctxEnvDI trueEnvU [])))

theorem not_fundamentalTermFamINDBotDI_trueEnvU (n : Nat) :
    ¬ FundamentalTermFamINDBotDI trueEnvU n :=
  fun F => not_fundamentalLRFamINBotDI_trueEnvU n
    (fundamentalLRFamINBotDI_of_fundamentalTermFamINDBotDI trueEnvUWfT F)


/-! #### Part C — Recursor-Major-Aware Weak-Head Reduction (`WhStepRecCtx` / `WhRedRecCtx` / `WhNormalRecCtx`), Unconditional Determinism (`whDetRecCtx_of_envWfT`), `ApproxDI` Invariance, and Weakening/Substitution Commutation -/

/-- **Recursor-Major-Aware, Context-Aware Weak-Head Step (`WhStepRecCtx E Γ`):**
    Extends `WhStepCtx E Γ` with call-by-need reduction `recMajor` in the major premise position of
    a saturated recursor application `.app (foldApps (.const r ls) pre) major`
    (`E.members r = some m`, `m.mclass = .recursorM`, `pre.length + 1 = piCount m.mtype`). -/
inductive WhStepRecCtx (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | beta (A b a : Expr Nat) :
      WhStepRecCtx E Γ (.app (.lam A b) a) (instantiate0 a b)
  | zeta (A v b : Expr Nat) :
      WhStepRecCtx E Γ (.letE A v b) (instantiate0 v b)
  | zetaLocal {i : Nat} {v : Expr Nat} (hv : lookupValue Γ i = some v) :
      WhStepRecCtx E Γ (.bvar i) v
  | delta {r : Nat} {ls : List Level} {m : CheckedMember} {b : Expr Nat}
      (hres : E.members r = some m) (hbody : m.body = some b) :
      WhStepRecCtx E Γ (.const r ls) (instantiateLevels ls b)
  | iota {lhs rhs : Expr Nat} (h : DerivedIotaU E lhs rhs) :
      WhStepRecCtx E Γ lhs rhs
  | lit (t : Nat) :
      WhStepRecCtx E Γ (.lit t) (natExpand t)
  | appHead {f f' a : Expr Nat} (h : WhStepRecCtx E Γ f f') :
      WhStepRecCtx E Γ (.app f a) (.app f' a)
  | recMajor {r : Nat} {m : CheckedMember} {ls : List Level}
      {pre : List (Expr Nat)} {major major' : Expr Nat}
      (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
      (hlen : pre.length + 1 = piCount m.mtype)
      (hmaj : WhStepRecCtx E Γ major major') :
      WhStepRecCtx E Γ (.app (foldApps (.const r ls) pre) major)
        (.app (foldApps (.const r ls) pre) major')

/-- Reflexive-transitive closure of `WhStepRecCtx E Γ`. -/
inductive WhRedRecCtx (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | refl (e : Expr Nat) : WhRedRecCtx E Γ e e
  | step {a b c : Expr Nat} (h : WhStepRecCtx E Γ a b) (hs : WhRedRecCtx E Γ b c) :
      WhRedRecCtx E Γ a c

theorem whRedRecCtx_trans {E : ResolvedEnv} {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedRecCtx E Γ a b) (h₂ : WhRedRecCtx E Γ b c) : WhRedRecCtx E Γ a c := by
  induction h₁ with
  | refl => exact h₂
  | step hs _ ih => exact .step hs (ih h₂)

/-- Every `WhStepCtx E Γ` step is a `WhStepRecCtx E Γ` step. -/
theorem whStepCtx_to_whStepRecCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) : WhStepRecCtx E Γ a b := by
  induction h with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | zetaLocal hv => exact .zetaLocal hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih

/-- Every `WhRedCtx E Γ` reduction is a `WhRedRecCtx E Γ` reduction. -/
theorem whRedCtx_to_whRedRecCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) : WhRedRecCtx E Γ a b := by
  induction h with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepCtx_to_whStepRecCtx hs) ih

/-- Every context-free `WhStep E` step is a `WhStepRecCtx E Γ` step. -/
theorem whStep_to_whStepRecCtx {E : ResolvedEnv} (Γ : LCtx) {a b : Expr Nat}
    (h : WhStep E a b) : WhStepRecCtx E Γ a b :=
  whStepCtx_to_whStepRecCtx (whStep_to_whStepCtx h)

/-- Every context-free `WhRed E` reduction is a `WhRedRecCtx E Γ` reduction. -/
theorem whRed_to_whRedRecCtx {E : ResolvedEnv} (Γ : LCtx) {a b : Expr Nat}
    (h : WhRed E a b) : WhRedRecCtx E Γ a b :=
  whRedCtx_to_whRedRecCtx (whRed_to_whRedCtx h)

/-- Weak-head normal form with respect to `WhStepRecCtx E Γ`. -/
def WhNormalRecCtx (E : ResolvedEnv) (Γ : LCtx) (X : Expr Nat) : Prop :=
  ∀ Y, ¬ WhStepRecCtx E Γ X Y

theorem whNormalCtx_of_whNormalRecCtx {E : ResolvedEnv} {Γ : LCtx} {X : Expr Nat}
    (h : WhNormalRecCtx E Γ X) : WhNormalCtx E Γ X :=
  fun Y hs => h Y (whStepCtx_to_whStepRecCtx hs)

theorem whStepRecCtx_sort_false {E : ResolvedEnv} {Γ : LCtx} {u : Level} {e : Expr Nat}
    (h : WhStepRecCtx E Γ (.sort u) e) : False := by
  cases h with
  | iota hI =>
      obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
      simp [recCall, foldApps_snoc] at hl

theorem whNormalRecCtx_sort {E : ResolvedEnv} {Γ : LCtx} (u : Level) :
    WhNormalRecCtx E Γ (.sort u) :=
  fun _ hs => whStepRecCtx_sort_false hs

theorem whRedRecCtx_sort_eq {E : ResolvedEnv} {Γ : LCtx} {u : Level} {X : Expr Nat}
    (h : WhRedRecCtx E Γ (.sort u) X) : X = .sort u := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_sort_false hs).elim

theorem whStepRecCtx_pi_false {E : ResolvedEnv} {Γ : LCtx} {A B e : Expr Nat}
    (h : WhStepRecCtx E Γ (.pi A B) e) : False := by
  cases h with
  | iota hI =>
      obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
      simp [recCall, foldApps_snoc] at hl

theorem whNormalRecCtx_pi {E : ResolvedEnv} {Γ : LCtx} (A B : Expr Nat) :
    WhNormalRecCtx E Γ (.pi A B) :=
  fun _ hs => whStepRecCtx_pi_false hs

theorem whRedRecCtx_pi_eq {E : ResolvedEnv} {Γ : LCtx} {A B X : Expr Nat}
    (h : WhRedRecCtx E Γ (.pi A B) X) : X = .pi A B := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_pi_false hs).elim

theorem whStepRecCtx_lam_false {E : ResolvedEnv} {Γ : LCtx} {A b e : Expr Nat}
    (h : WhStepRecCtx E Γ (.lam A b) e) : False := by
  cases h with
  | iota hI =>
      obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
      simp [recCall, foldApps_snoc] at hl

theorem whNormalRecCtx_lam {E : ResolvedEnv} {Γ : LCtx} (A b : Expr Nat) :
    WhNormalRecCtx E Γ (.lam A b) :=
  fun _ hs => whStepRecCtx_lam_false hs

theorem whRedRecCtx_lam_eq {E : ResolvedEnv} {Γ : LCtx} {A b X : Expr Nat}
    (h : WhRedRecCtx E Γ (.lam A b) X) : X = .lam A b := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_lam_false hs).elim

theorem whStepRecCtx_bvar_of_lookupValue_none_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {e : Expr Nat}
    (h : WhStepRecCtx E Γ (.bvar i) e) : False := by
  cases h with
  | zetaLocal hv =>
      rw [hnone] at hv
      exact Option.noConfusion hv
  | iota hI =>
      obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
      simp [recCall, foldApps_snoc] at hl

theorem whNormalRecCtx_bvar_of_lookupValue_none {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) : WhNormalRecCtx E Γ (.bvar i) :=
  fun _ hs => whStepRecCtx_bvar_of_lookupValue_none_false hnone hs

theorem whStepRecCtx_foldApps_bvar_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecCtx E Γ (foldApps (.bvar i) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecCtx E Γ f e → (appsSpine f).1 = .bvar i → False := by
    intro f e hstep
    induction hstep with
    | beta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zetaLocal hv =>
        intro hsp
        simp only [appsSpine, Expr.bvar.injEq] at hsp
        subst hsp
        rw [hnone] at hv
        exact Option.noConfusion hv
    | delta _ _ => intro hsp; simp [appsSpine] at hsp
    | iota hI =>
        intro hsp
        obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
        unfold recCall at hl
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [hl, s₂] at hsp
        exact Expr.noConfusion hsp
    | lit _ => intro hsp; simp [appsSpine] at hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r _ ls pre major _ _ _ _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r ls) (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        exact Expr.noConfusion hsp
  have hsp₀ := appsSpine_foldApps (.bvar i) xs
  simp only [appsSpine, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

theorem whNormalRecCtx_foldApps_bvar {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) :
    WhNormalRecCtx E Γ (foldApps (.bvar i) xs) :=
  fun _ hs => whStepRecCtx_foldApps_bvar_false hnone xs hs

/-- No spine `foldApps (.const r ls) xs` headed by a non-recursor body-less constant
    (`m.body = none ∧ m.mclass ≠ .recursorM`) ever steps under `WhStepRecCtx E Γ`. -/
theorem whStepRecCtx_rigidNonRec_false {E : ResolvedEnv} {Γ : LCtx} {r : Nat} {m : CheckedMember}
    (hmem : E.members r = some m) (hbody : m.body = none) (hnrec : m.mclass ≠ .recursorM)
    (ls : List Level) (xs : List (Expr Nat)) {e : Expr Nat}
    (hs : WhStepRecCtx E Γ (foldApps (.const r ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStepRecCtx E Γ f e → (appsSpine f).1 = .const r ls → False := by
    intro f e hstep
    induction hstep with
    | beta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zetaLocal _ => intro hsp; simp [appsSpine] at hsp
    | delta hres hbody' =>
        intro hsp
        simp only [appsSpine, Expr.const.injEq] at hsp
        rcases hsp with ⟨rfl, _⟩
        rw [hmem] at hres
        injection hres with hm
        subst hm
        rw [hbody] at hbody'
        exact Option.noConfusion hbody'
    | iota hI =>
        intro hsp
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [ctorMajor w])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hrec _
            subst hrec
            have hm : w.recMember = m := Option.some.inj (w.hrec.symm.trans hmem)
            subst hm
            exact hnrec w.hrecK
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
              (w.preMajor ++ [foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hrec _
            subst hrec
            have hm : w.recMember = m := Option.some.inj (w.hrec.symm.trans hmem)
            subst hm
            exact hnrec w.hrecK
    | lit _ => intro hsp; simp [appsSpine] at hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
    | @recMajor r' m' ls' pre major _ hm' hrec' _ _ _ =>
        intro hsp
        have s₂ := appsSpine_foldApps (.const r' ls') (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hrecEq _
        subst hrecEq
        have hmEq : m' = m := Option.some.inj (hm'.symm.trans hmem)
        subst hmEq
        exact hnrec hrec'
  have hsp₀ := appsSpine_foldApps (.const r ls) xs
  simp only [appsSpine_const, List.nil_append] at hsp₀
  exact key hs (congrArg Prod.fst hsp₀)

/-- Under `EnvWfT E`, no admitted `.inductiveM` family spine `foldApps (.const r ls) xs` takes a
    `WhStepRecCtx E Γ` step. -/
theorem whStepRecCtx_famApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepRecCtx E Γ (foldApps (.const r ls) xs) e) : False :=
  whStepRecCtx_rigidNonRec_false hm (familyNoBody_of_envWfT hW r m hm hind)
    (by rw [hind]; decide) ls xs hs

theorem whNormalRecCtx_famApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalRecCtx E Γ (foldApps (.const r ls) xs) :=
  fun _ hs => whStepRecCtx_famApp_false hW hm hind hs

theorem whRedRecCtx_famApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {X : Expr Nat}
    (h : WhRedRecCtx E Γ (foldApps (.const r ls) xs) X) :
    X = foldApps (.const r ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_famApp_false hW hm hind hs).elim

/-- Under `EnvWfT E`, no admitted `.constructorM` constructor spine `foldApps (.const c ls) xs`
    takes a `WhStepRecCtx E Γ` step. -/
theorem whStepRecCtx_ctorApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepRecCtx E Γ (foldApps (.const c ls) xs) e) : False :=
  whStepRecCtx_rigidNonRec_false hm (ctorNoBody_of_envWfT hW c m hm hctor)
    (by rw [hctor]; decide) ls xs hs

theorem whNormalRecCtx_ctorApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalRecCtx E Γ (foldApps (.const c ls) xs) :=
  fun _ hs => whStepRecCtx_ctorApp_false hW hm hctor hs

theorem whRedRecCtx_ctorApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    {ls : List Level} {xs : List (Expr Nat)} {X : Expr Nat}
    (h : WhRedRecCtx E Γ (foldApps (.const c ls) xs) X) :
    X = foldApps (.const c ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepRecCtx_ctorApp_false hW hm hctor hs).elim

/-- Under `EnvWfT E`, no partial `.recursorM` spine `foldApps (.const r ls) xs` with
    `xs.length + 1 ≤ piCount m.mtype` ever steps under `WhStepRecCtx E Γ`. -/
theorem whStepRecCtx_recursor_prefix_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (ls : List Level) (xs : List (Expr Nat)) (hlen : xs.length + 1 ≤ piCount m.mtype)
    {e : Expr Nat} (hs : WhStepRecCtx E Γ (foldApps (.const r ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat} (ys : List (Expr Nat)),
      WhStepRecCtx E Γ f e → appsSpine f = (.const r ls, ys) →
      ys.length + 1 ≤ piCount m.mtype → False := by
    intro f e ys hstep
    induction hstep generalizing ys with
    | beta _ _ _ => intro hsp _; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp _; simp [appsSpine] at hsp
    | zetaLocal _ => intro hsp _; simp [appsSpine] at hsp
    | @delta r₀ _ _ _ hres hbody =>
        intro hsp _
        simp only [appsSpine, Prod.mk.injEq, Expr.const.injEq] at hsp
        obtain ⟨⟨rfl, _⟩, _⟩ := hsp
        obtain ⟨hd, _⟩ := PiModelDeltaIotaAudit.envWfT_member_body_closed hW r₀ _ _ hres hbody
        have hmEq : _ = m := Option.some.inj (hd.1.symm.trans hm)
        subst hmEq
        exact hd.2.2.1 hrec
    | iota hI =>
        intro hsp hlen'
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls) (w.preMajor ++ [ctorMajor w])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hhead hargs
            injection hhead with hrecEq _
            subst hrecEq
            have hmEq : w.recMember = m := Option.some.inj (w.hrec.symm.trans hm)
            subst hmEq
            have hlenEq := congrArg List.length hargs
            simp only [List.length_append, List.length_singleton] at hlenEq
            have hp := w.hpre
            have hn := w.hnmin
            omega
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            have s₂ := appsSpine_foldApps (.const w.recRef w.ls)
              (w.preMajor ++ [foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields)])
            simp only [appsSpine_const, List.nil_append] at s₂
            rw [s₂] at hsp
            injection hsp with hhead hargs
            injection hhead with hrecEq _
            subst hrecEq
            have hmEq : w.recMember = m := Option.some.inj (w.hrec.symm.trans hm)
            subst hmEq
            have hlenEq := congrArg List.length hargs
            simp only [List.length_append, List.length_singleton] at hlenEq
            have hp := w.hpre
            have hn := w.hnmin
            omega
    | lit _ => intro hsp _; simp [appsSpine] at hsp
    | @appHead f₀ _ _ _ ih =>
        intro hsp hlen'
        simp only [appsSpine, Prod.mk.injEq] at hsp
        obtain ⟨hhead, hargs⟩ := hsp
        subst hargs
        simp only [List.length_append, List.length_singleton] at hlen'
        exact ih (appsSpine f₀).2 (Prod.ext hhead rfl) (by omega)
    | @recMajor r' m' ls' pre major _ hm' _ hlenRec _ _ =>
        intro hsp hlen'
        have s₂ := appsSpine_foldApps (.const r' ls') (pre ++ [major])
        simp only [appsSpine_const, List.nil_append] at s₂
        rw [← foldApps_snoc, s₂] at hsp
        injection hsp with hhead hargs
        injection hhead with hrecEq _
        subst hrecEq
        have hmEq : m' = m := Option.some.inj (hm'.symm.trans hm)
        subst hmEq
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton] at hlenEq
        omega
  have hsp₀ := appsSpine_foldApps (.const r ls) xs
  simp only [appsSpine_const, List.nil_append] at hsp₀
  exact key xs hs hsp₀ hlen

/-- Every `DerivedIotaU E lhs rhs` source decomposes as
    `lhs = .app (foldApps (.const r ls) pre) (foldApps (.const c lsC) cargs)` where `r` is a
    `.recursorM` member with `pre.length + 1 = piCount m_rec.mtype` and `c` is a `.constructorM`
    member. -/
theorem derivedIotaU_rec_ctor_shape {E : ResolvedEnv} {lhs rhs : Expr Nat}
    (hI : DerivedIotaU E lhs rhs) :
    ∃ (r c : Nat) (m_rec m_ctor : CheckedMember) (ls lsC : List Level)
      (pre cargs : List (Expr Nat)),
      lhs = .app (foldApps (.const r ls) pre) (foldApps (.const c lsC) cargs) ∧
        E.members r = some m_rec ∧ m_rec.mclass = .recursorM ∧
        pre.length + 1 = piCount m_rec.mtype ∧
        E.members c = some m_ctor ∧ m_ctor.mclass = .constructorM := by
  cases hI with
  | ofU w =>
      refine ⟨w.recRef, w.ctorRef, w.recMember, w.ctorMember, w.ls, w.lsC,
        w.preMajor, w.ctorParams ++ w.fields,
        foldApps_snoc (.const w.recRef w.ls) _ w.preMajor,
        w.hrec, w.hrecK, ?_, w.hctor, w.hctorK⟩
      have hp := w.hpre
      have hn := w.hnmin
      omega
  | ofUS w =>
      refine ⟨w.recRef, w.ctorRef, w.recMember, w.ctorMember, w.ls, w.lsC,
        w.preMajor, w.ctorParams ++ w.fields,
        foldApps_snoc (.const w.recRef w.ls) _ w.preMajor,
        w.hrec, w.hrecK, ?_, w.hctor, w.hctorK⟩
      have hp := w.hpre
      have hn := w.hnmin
      omega

/-- Determinism predicate for `WhStepRecCtx E Γ`. -/
def WhDetRecCtx (E : ResolvedEnv) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhStepRecCtx E Γ a b → WhStepRecCtx E Γ a c → b = c

/-- **Unconditional Determinism of `WhStepRecCtx E Γ` (`whDetRecCtx_of_envWfT`):**
    At every well-formed environment `EnvWfT E` and context `Γ : LCtx`, `WhStepRecCtx E Γ` is
    deterministic:
    - `iota × appHead` and `recMajor × appHead` are ruled out by `whStepRecCtx_recursor_prefix_false`;
    - `iota × recMajor` is ruled out by `whStepRecCtx_ctorApp_false` (since an `iota` major is a
      `.constructorM` spine, which is `WhNormalRecCtx`);
    - `iota × iota` is discharged by `iotaDetU_of_envWfT hW`. -/
theorem whDetRecCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) (Γ : LCtx) :
    WhDetRecCtx E Γ := by
  intro a b c h₁ h₂
  induction h₁ generalizing c with
  | beta A body arg =>
      generalize ha : Expr.app (.lam A body) arg = a₀ at h₂
      cases h₂ with
      | beta =>
          injection ha with hlam harg
          injection hlam with _ hbody
          subst hbody; subst harg
          rfl
      | zeta => nomatch ha
      | zetaLocal => nomatch ha
      | delta => nomatch ha
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          rw [← ha] at hl
          simp only [recCall, foldApps_snoc, Expr.app.injEq] at hl
          exact (F8EtaK.foldApps_const_ne_lam_any hl.1.symm).elim
      | lit => nomatch ha
      | appHead hf =>
          injection ha with hfEq _
          subst hfEq
          exact (whStepRecCtx_lam_false hf).elim
      | recMajor _ _ _ _ =>
          injection ha with hrecEq _
          exact (F8EtaK.foldApps_const_ne_lam_any hrecEq.symm).elim
  | zeta A v body =>
      cases h₂ with
      | zeta => rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | zetaLocal hv₁ =>
      cases h₂ with
      | zetaLocal hv₂ => exact Option.some.inj (hv₁.symm.trans hv₂)
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | delta hres₁ hbody₁ =>
      cases h₂ with
      | delta hres₂ hbody₂ =>
          have hm : _ = _ := Option.some.inj (hres₁.symm.trans hres₂)
          subst hm
          have hb : _ = _ := Option.some.inj (hbody₁.symm.trans hbody₂)
          subst hb
          rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | iota hI₁ =>
      obtain ⟨r₁, c₁, m_rec₁, m_ctor₁, ls₁, lsC₁, pre₁, cargs₁,
        hl₁, hm_rec₁, hrec₁, hlen₁, hm_ctor₁, hctor₁⟩ := derivedIotaU_rec_ctor_shape hI₁
      cases h₂ with
      | beta =>
          simp only [Expr.app.injEq] at hl₁
          exact (F8EtaK.foldApps_const_ne_lam_any hl₁.1.symm).elim
      | zeta => nomatch hl₁
      | zetaLocal => nomatch hl₁
      | delta => nomatch hl₁
      | iota hI₂ => exact PiModelDeltaIotaAudit.iotaDetU_of_envWfT hW hI₁ hI₂
      | lit => nomatch hl₁
      | appHead hf =>
          injection hl₁ with hfEq _
          subst hfEq
          exact (whStepRecCtx_recursor_prefix_false hW hm_rec₁ hrec₁ ls₁ pre₁
            (Nat.le_of_eq hlen₁) hf).elim
      | recMajor _ _ _ hmaj =>
          injection hl₁ with _ hmajEq
          subst hmajEq
          exact (whStepRecCtx_ctorApp_false hW hm_ctor₁ hctor₁ hmaj).elim
  | lit t =>
      cases h₂ with
      | lit => rfl
      | iota hI =>
          obtain ⟨r, ls, pre, major, hl⟩ := derivedIotaU_source hI
          simp [recCall, foldApps_snoc] at hl
  | appHead hf₁ ih =>
      cases h₂ with
      | beta => exact (whStepRecCtx_lam_false hf₁).elim
      | iota hI₂ =>
          obtain ⟨r₂, _, m_rec₂, _, ls₂, _, pre₂, _,
            hl₂, hm_rec₂, hrec₂, hlen₂, _, _⟩ := derivedIotaU_rec_ctor_shape hI₂
          injection hl₂ with hfEq _
          subst hfEq
          exact (whStepRecCtx_recursor_prefix_false hW hm_rec₂ hrec₂ ls₂ pre₂
            (Nat.le_of_eq hlen₂) hf₁).elim
      | appHead hf₂ => rw [ih hf₂]
      | recMajor hm₂ hrec₂ hlen₂ _ =>
          exact (whStepRecCtx_recursor_prefix_false hW hm₂ hrec₂ _ _
            (Nat.le_of_eq hlen₂) hf₁).elim
  | @recMajor r₁ m₁ ls₁ pre₁ major major₁' hm₁ hrec₁ hlen₁ hmaj₁ ih =>
      generalize ha : Expr.app (foldApps (.const r₁ ls₁) pre₁) major = a₀ at h₂
      cases h₂ with
      | beta =>
          injection ha with hlam _
          exact (F8EtaK.foldApps_const_ne_lam_any hlam).elim
      | zeta => nomatch ha
      | zetaLocal => nomatch ha
      | delta => nomatch ha
      | iota hI₂ =>
          obtain ⟨_, _, _, m_ctor₂, _, _, _, _,
            hl₂, _, _, _, hm_ctor₂, hctor₂⟩ := derivedIotaU_rec_ctor_shape hI₂
          rw [← ha] at hl₂
          injection hl₂ with _ hmajEq
          subst hmajEq
          exact (whStepRecCtx_ctorApp_false hW hm_ctor₂ hctor₂ hmaj₁).elim
      | lit => nomatch ha
      | appHead hf₂ =>
          injection ha with hfEq _
          subst hfEq
          exact (whStepRecCtx_recursor_prefix_false hW hm₁ hrec₁ ls₁ pre₁
            (Nat.le_of_eq hlen₁) hf₂).elim
      | recMajor _ _ _ hmaj₂ =>
          injection ha with hfEq hmajEq
          subst hmajEq
          rw [hfEq, ih hmaj₂]

/-- Uniqueness of `WhNormalRecCtx E Γ` normal forms from `WhDetRecCtx E Γ`. -/
theorem whRedRecCtx_normal_unique {E : ResolvedEnv} {Γ : LCtx} (hdet : WhDetRecCtx E Γ)
    {a X Y : Expr Nat} (h₁ : WhRedRecCtx E Γ a X) (hX : WhNormalRecCtx E Γ X)
    (h₂ : WhRedRecCtx E Γ a Y) (hY : WhNormalRecCtx E Γ Y) : X = Y := by
  induction h₁ with
  | refl =>
      cases h₂ with
      | refl => rfl
      | step hs₂ _ => exact (hX _ hs₂).elim
  | step hs₁ _ ih =>
      cases h₂ with
      | refl => exact (hY _ hs₁).elim
      | step hs₂ hred₂ =>
          have heq := hdet hs₁ hs₂
          subst heq
          exact ih hX hred₂

/-- Uniqueness of `WhNormalRecCtx E Γ` normal forms at every `EnvWfT E`. -/
theorem whRedRecCtx_normal_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    {a X Y : Expr Nat} (h₁ : WhRedRecCtx E Γ a X) (hX : WhNormalRecCtx E Γ X)
    (h₂ : WhRedRecCtx E Γ a Y) (hY : WhNormalRecCtx E Γ Y) : X = Y :=
  whRedRecCtx_normal_unique (whDetRecCtx_of_envWfT hW Γ) h₁ hX h₂ hY

/-- `WhStepRecCtx E Γ` is invariant under `CtxSameValues Γ Γ'`. -/
theorem whStepRecCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hs : WhStepRecCtx E Γ a b) : WhStepRecCtx E Γ' a b := by
  induction hs with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | @zetaLocal i v hv =>
      rw [h i] at hv
      exact .zetaLocal hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih
  | recMajor hm hrec hlen _ ih => exact .recMajor hm hrec hlen ih

theorem whRedRecCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hr : WhRedRecCtx E Γ a b) : WhRedRecCtx E Γ' a b := by
  induction hr with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepRecCtx_of_sameValues h hs) ih

theorem whNormalRecCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {X : Expr Nat} (hn : WhNormalRecCtx E Γ X) : WhNormalRecCtx E Γ' X :=
  fun Y hs => hn Y (whStepRecCtx_of_sameValues (ctxSameValues_symm h) hs)

/-- **Invariance of `ApproxDI E` under `WhStepRecCtx E Γ` (`whStepRecCtx_approxDI_iff_of_envWfT`):**
    At every `EnvWfT E` and `CtxEnvDI E Γ ρ`, `WhStepRecCtx E Γ` preserves `ApproxDI E ρ` in both
    directions (the `recMajor` case closes in one line by `PiModelDeltaIotaAudit.semEqDI_app`). -/
theorem whStepRecCtx_approxDI_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvDI E Γ ρ)
    {a b : Expr Nat} (hs : WhStepRecCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E ρ a c ↔ PiModelDeltaIotaAudit.ApproxDI E ρ b c := by
  induction hs generalizing c with
  | beta A body arg => exact PiModelDeltaIotaAudit.approxDI_beta E ρ A body arg c
  | zeta A v body => exact PiModelDeltaIotaAudit.approxDI_zeta E ρ A v body c
  | zetaLocal hv => exact semEqDI_zetaLocal hρ hv c
  | delta hres hbody =>
      exact PiModelDeltaIotaAudit.semEqDI_of_whStep_delta hW hres hbody ρ c
  | iota hI =>
      exact PiModelDeltaIotaAudit.approxDI_iotaU_of_envWfT hW hI ρ c
  | lit t => exact PiModelDeltaIotaAudit.approxDI_lit E ρ t c
  | appHead _ ih =>
      exact PiModelDeltaIotaAudit.semEqDI_app ih (PiModelDeltaIotaAudit.semEqDI_refl E ρ _) c
  | recMajor _ _ _ _ ih =>
      exact PiModelDeltaIotaAudit.semEqDI_app (PiModelDeltaIotaAudit.semEqDI_refl E ρ _) ih c

/-- Invariance of `ApproxDI E` under `WhRedRecCtx E Γ` at every `EnvWfT E` and `CtxEnvDI E Γ ρ`. -/
theorem whRedRecCtx_approxDI_iff_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvDI E Γ ρ)
    {a b : Expr Nat} (hr : WhRedRecCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E ρ a c ↔ PiModelDeltaIotaAudit.ApproxDI E ρ b c := by
  induction hr with
  | refl => exact Iff.rfl
  | step hs _ ih =>
      exact (whStepRecCtx_approxDI_iff_of_envWfT hW hρ hs c).trans ih

theorem approxDI_ctxEnvDI_whStepRecCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hs : WhStepRecCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c :=
  whStepRecCtx_approxDI_iff_of_envWfT hW (ctxEnvDI_respects E Γ) hs c

theorem approxDI_ctxEnvDI_whRedRecCtx_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat} (hr : WhRedRecCtx E Γ a b) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) a c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) b c :=
  whRedRecCtx_approxDI_iff_of_envWfT hW (ctxEnvDI_respects E Γ) hr c

/-- `lift` distributes over `foldApps`. -/
theorem lift_foldApps (k d : Nat) (f : Expr Nat) :
    (xs : List (Expr Nat)) →
      lift k d (foldApps f xs) = foldApps (lift k d f) (xs.map (lift k d))
  | [] => rfl
  | x :: xs => by
      simp only [foldApps, List.map, lift]
      exact lift_foldApps k d (.app f x) xs

/-- Head congruence for `WhRedRecCtx E Γ`. -/
theorem whRedRecCtx_appHead {E : ResolvedEnv} {Γ : LCtx} {f f' a : Expr Nat}
    (h : WhRedRecCtx E Γ f f') : WhRedRecCtx E Γ (.app f a) (.app f' a) := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (.appHead hs) ih

/-- Recursor-major congruence for `WhRedRecCtx E Γ`. -/
theorem whRedRecCtx_recMajor {E : ResolvedEnv} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls : List Level}
    {pre : List (Expr Nat)} {major major' : Expr Nat}
    (hm : E.members r = some m) (hrec : m.mclass = .recursorM)
    (hlen : pre.length + 1 = piCount m.mtype)
    (hmaj : WhRedRecCtx E Γ major major') :
    WhRedRecCtx E Γ (.app (foldApps (.const r ls) pre) major)
      (.app (foldApps (.const r ls) pre) major') := by
  induction hmaj with
  | refl => exact .refl _
  | step hs _ ih => exact .step (.recMajor hm hrec hlen hs) ih

/-- Weakening commutation for `WhStepRecCtx` under `EnvClosed E`. -/
theorem whStepRecCtx_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhStepRecCtx E Γ a b) :
    ∀ (d : LocalDecl) (c : Nat), WhStepRecCtx E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  induction h with
  | beta A body arg =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.beta A body arg) d c)
  | zeta A v body =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.zeta A v body) d c)
  | zetaLocal hv =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.zetaLocal hv) d c)
  | delta hres hbody =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.delta hres hbody) d c)
  | iota hI =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.iota hI) d c)
  | lit t =>
      intro d c
      exact whStepCtx_to_whStepRecCtx (whStepCtx_lift_of_envClosed hcl (.lit t) d c)
  | appHead _ ih =>
      intro d c
      exact .appHead (ih d c)
  | @recMajor r m ls pre major major' hm hrec hlen _ ih =>
      intro d c
      simp only [lift, lift_foldApps]
      refine .recMajor hm hrec ?_ (ih d c)
      rw [List.length_map]
      exact hlen

theorem whRedRecCtx_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhRedRecCtx E Γ a b) (d : LocalDecl) (c : Nat) :
    WhRedRecCtx E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  induction h with
  | refl e => exact .refl (lift c 1 e)
  | step hs _ ih => exact .step (whStepRecCtx_lift_of_envClosed hcl hs d c) ih

/-- Assumption-substitution commutation for `WhStepRecCtx` under `EnvClosed E`. -/
theorem whStepRecCtx_instantiate_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {T₀ : Expr Nat} (hj : Γ'[j]? = some (.assumption T₀))
    {a b : Expr Nat} (h : WhStepRecCtx E Γ' a b) (v : Expr Nat) :
    WhStepRecCtx E (substRemove v j Γ')
      (instantiate j (lift 0 j v) a) (instantiate j (lift 0 j v) b) := by
  induction h with
  | beta A body arg =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.beta A body arg) v)
  | zeta A val body =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.zeta A val body) v)
  | zetaLocal hv =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.zetaLocal hv) v)
  | delta hres hbody =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.delta hres hbody) v)
  | iota hI =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.iota hI) v)
  | lit t =>
      exact whStepCtx_to_whStepRecCtx (whStepCtx_instantiate_of_envClosed hcl hj (.lit t) v)
  | appHead _ ih =>
      exact .appHead ih
  | @recMajor r m ls pre major major' hm hrec hlen _ ih =>
      simp only [instantiate, instantiate_foldApps]
      refine .recMajor hm hrec ?_ ih
      rw [List.length_map]
      exact hlen

theorem whRedRecCtx_instantiate_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {T₀ : Expr Nat} (hj : Γ'[j]? = some (.assumption T₀))
    {a b : Expr Nat} (h : WhRedRecCtx E Γ' a b) (v : Expr Nat) :
    WhRedRecCtx E (substRemove v j Γ')
      (instantiate j (lift 0 j v) a) (instantiate j (lift 0 j v) b) := by
  induction h with
  | refl _ => exact .refl _
  | step hs _ ih => exact .step (whStepRecCtx_instantiate_of_envClosed hcl hj hs v) ih

/-- Let-binding-substitution commutation for `WhStepRecCtx` under `EnvClosed E`. -/
theorem whStepRecCtx_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {t w0 : Expr Nat} (hj : Γ'[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhStepRecCtx E Γ' a b) :
    WhRedRecCtx E (substRemove w0 j Γ')
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | beta A body arg =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.beta A body arg))
  | zeta A val body =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.zeta A val body))
  | zetaLocal hv =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.zetaLocal hv))
  | delta hres hbody =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.delta hres hbody))
  | iota hI =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.iota hI))
  | lit t =>
      exact whRedCtx_to_whRedRecCtx
        (whStepCtx_instantiate_letBinding_of_envClosed hcl hj (.lit t))
  | appHead _ ih =>
      exact whRedRecCtx_appHead ih
  | @recMajor r m ls pre major major' hm hrec hlen _ ih =>
      simp only [instantiate, instantiate_foldApps]
      refine whRedRecCtx_recMajor hm hrec ?_ ih
      rw [List.length_map]
      exact hlen

theorem whRedRecCtx_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ' : LCtx} {j : Nat} {t w0 : Expr Nat} (hj : Γ'[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhRedRecCtx E Γ' a b) :
    WhRedRecCtx E (substRemove w0 j Γ')
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | refl _ => exact .refl _
  | step hs _ ih =>
      exact whRedRecCtx_trans (whStepRecCtx_instantiate_letBinding_of_envClosed hcl hj hs) ih

/-- **Positive Resolution of `W-IOTA-MAJOR` (`whRedRecCtx_trueRecMajorBeta`):**
    Under `WhRedRecCtx trueEnvU Γ`, `trueRecMajorBeta u motive minor` reduces in 2 steps
    (`recMajor` of `beta` on `trueMajorBeta`, followed by root `iota` via `trueRecWitness`) to
    `minor` for **every** `u, motive, minor, Γ`! -/
theorem whRedRecCtx_trueRecMajorBeta (u : Level) (motive minor : Expr Nat) (Γ : LCtx) :
    WhRedRecCtx trueEnvU Γ (trueRecMajorBeta u motive minor) minor := by
  have hstep1 : WhStepRecCtx trueEnvU Γ
      (trueRecMajorBeta u motive minor)
      (iotaLhsOf (trueRecWitness u motive minor)) :=
    .recMajor (r := 2) (m := trueRecMemberU) (ls := [u]) (pre := [motive, minor])
      rfl rfl rfl (.beta (.const 0 []) (.bvar 0) (.const 1 []))
  have hstep2 : WhStepRecCtx trueEnvU Γ
      (iotaLhsOf (trueRecWitness u motive minor)) minor :=
    .iota (.ofU (trueRecWitness u motive minor))
  exact .step hstep1 (.step hstep2 (.refl minor))

theorem whRedRecCtx_trueIotaMajorSort (Γ : LCtx) :
    WhRedRecCtx trueEnvU Γ trueIotaMajorSort (.sort .zero) :=
  whRedRecCtx_trueRecMajorBeta (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero) Γ

theorem whRedRecCtx_trueIotaMajorPi (Γ : LCtx) :
    WhRedRecCtx trueEnvU Γ trueIotaMajorPi PiModelDeltaIotaAudit.idPiProp :=
  whRedRecCtx_trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) PiModelDeltaIotaAudit.idPiProp Γ

theorem whRedRecCtx_trueIotaMajorFam (Γ : LCtx) :
    WhRedRecCtx trueEnvU Γ trueIotaMajorFam (.const 0 []) :=
  whRedRecCtx_trueRecMajorBeta (.succ .zero) (trueSortMotive .zero) (.const 0 []) Γ


/-! #### Part D — Repaired Recursor-Major-Aware Family & Term Logical Relations (`LRTypeFamINR`, `LRTypeFamINBiR`, `LRTermFamINDR`, `FundamentalLRFamINBotR`, `FundamentalTermFamINDBotR`), Positive Resolution of `W-IOTA-MAJOR`, and Downstream `piRow` / `famAppRow` / `TypedRowsWf` Consumers -/

/-- **Recursor-Major-Aware, Family-Injective, Context-Aware Type Logical Relation (`LRTypeFamINR`):**
    Replaces `WhRedCtx` / `WhNormalCtx` in `LRTypeFamIN` with `WhRedRecCtx` / `WhNormalRecCtx`,
    resolving Wall `W-IOTA-MAJOR` while preserving all `BotFamCpt E` properties. -/
inductive LRTypeFamINR (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeFamINR E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedRecCtx E Γ A (.sort u)) (h' : WhRedRecCtx E Γ A' (.sort u')) :
      LRTypeFamINR E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedRecCtx E Γ A (.pi A₁ B₁)) (h' : WhRedRecCtx E Γ A' (.pi A₂ B₂))
      (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeFamINR E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, LRTypeFamINR E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeFamINR E n Γ A A' (.pi a f)
  | famSpine {Γ : LCtx} {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (h : WhRedRecCtx E Γ A (foldApps (.const r ls) xs))
      (h' : WhRedRecCtx E Γ A' (foldApps (.const r ls') xs'))
      (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
      (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
      (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = (piDomsOf m.mtype).length)
      (hlen' : xs'.length = (piDomsOf m.mtype).length)
      (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
      LRTypeFamINR E n Γ A A' (.spine r args)
  | otherSpine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
      (h : WhRedRecCtx E Γ A X) (h' : WhRedRecCtx E Γ A' X')
      (hX : WhNormalRecCtx E Γ X) (hX' : WhNormalRecCtx E Γ X')
      (hc : TyConvT E n Γ X X') :
      LRTypeFamINR E n Γ A A' (.spine r args)

/-- Closure of `LRTypeFamINR` under `WhRedRecCtx E Γ` expansion on both sides. -/
theorem lrTypeFamINR_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A A' X X' : Expr Nat} {c : CptI}
    (hX : WhRedRecCtx E Γ A X) (hX' : WhRedRecCtx E Γ A' X') (h : LRTypeFamINR E n Γ X X' c) :
    LRTypeFamINR E n Γ A A' c := by
  cases h with
  | bot => exact .bot Γ A A'
  | sort h₁ h₂ => exact .sort (whRedRecCtx_trans hX h₁) (whRedRecCtx_trans hX' h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod ra rf =>
      exact .pi (whRedRecCtx_trans hX h₁) (whRedRecCtx_trans hX' h₂) hΓ₁ hdom hcod ra rf
  | famSpine hm hind h₁ h₂ hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedRecCtx_trans hX h₁) (whRedRecCtx_trans hX' h₂)
        hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h₁ h₂ hN hN' hc =>
      exact .otherSpine hnot (whRedRecCtx_trans hX h₁) (whRedRecCtx_trans hX' h₂) hN hN' hc

/-- **Lifting Theorem (`lrTypeFamINR_of_lrTypeFamIN_botFamCpt`):**
    Every `LRTypeFamIN E n Γ A A' c` derivation at a `BotFamCpt E c` compact lifts directly to
    `LRTypeFamINR E n Γ A A' c` (since `WhRedCtx` embeds into `WhRedRecCtx` and `BotFamCpt E`
    excludes `otherSpine`). -/
theorem lrTypeFamINR_of_lrTypeFamIN_botFamCpt {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c) (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamINR E n Γ A A' c := by
  induction h with
  | bot Γ B B' => exact .bot Γ B B'
  | sort h₁ h₂ =>
      exact .sort (whRedCtx_to_whRedRecCtx h₁) (whRedCtx_to_whRedRecCtx h₂)
  | pi h₁ h₂ hΓ₁ hdom hcod _ _ iha ihf =>
      cases hc with
      | pi hca _ hcf =>
          exact .pi (whRedCtx_to_whRedRecCtx h₁) (whRedCtx_to_whRedRecCtx h₂) hΓ₁ hdom hcod
            (iha hca) (fun s hs => ihf s hs (hcf s hs))
  | famSpine hm hind h₁ h₂ hty hty' hconv heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedCtx_to_whRedRecCtx h₁) (whRedCtx_to_whRedRecCtx h₂)
        hty hty' hconv heqN hlen hlen' hargs
  | otherSpine hnot =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

theorem lrTypeFamINR_ctx_sameValues {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ') (hΓ' : CtxWfT E n Γ')
    {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINR E n Γ A A' c) : LRTypeFamINR E n Γ' A A' c := by
  induction h generalizing Γ' with
  | bot => exact .bot _ _ _
  | sort h h' =>
      exact .sort (whRedRecCtx_of_sameValues hval h) (whRedRecCtx_of_sameValues hval h')
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u _ hA₁ =>
          have hA₁' : HasTyT E n Γ' A₁ (.sort u) := hasTyT_ctx hcl hctx hA₁
          have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ') := .assumption Γ' A₁ u hΓ' hA₁'
          exact .pi (whRedRecCtx_of_sameValues hval h) (whRedRecCtx_of_sameValues hval h')
            hΓ₁' (tyConvT_ctx hcl hctx hdom)
            (tyConvT_ctx hcl (.same (.assumption A₁) hctx) hcod)
            (iha hctx hval hΓ')
            (fun s hs => ihf s hs (.same (.assumption A₁) hctx)
              (ctxSameValues_same (.assumption A₁) hval) hΓ₁')
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind
        (whRedRecCtx_of_sameValues hval h) (whRedRecCtx_of_sameValues hval h')
        (hasTyT_ctx hcl hctx hty) (hasTyT_ctx hcl hctx hty')
        (tyConvT_ctx hcl hctx hc) heqN hlen hlen'
        (convArgsT_ctx hcl hctx hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot
        (whRedRecCtx_of_sameValues hval h) (whRedRecCtx_of_sameValues hval h')
        (whNormalRecCtx_of_sameValues hval hn) (whNormalRecCtx_of_sameValues hval hn')
        (tyConvT_ctx hcl hctx hc)

theorem lrTypeFamINR_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {B B' : Expr Nat} {c : CptI},
      LRTypeFamINR E n (.assumption A₂ :: Γ) B B' c →
      LRTypeFamINR E n (.assumption A₁ :: Γ) B B' c
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, hA₁, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTypeFamINR_ctx_sameValues hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (ctxSameValues_assumption A₂ A₁ (ctxSameValues_refl Γ))
        (.assumption Γ A₁ _ hΓ hA₁) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      lrTypeFamINR_assump_dom hcl hW hΓ c₁ hA₁ (lrTypeFamINR_assump_dom hcl hW hΓ c₂ hM h)

/-- Symmetry of `LRTypeFamINR` at every `EnvWfT E` and `PiRowField E n`. -/
theorem lrTypeFamINR_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINR E n Γ A A' c) :
    LRTypeFamINR E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamINR_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype hW hpi hΓ hm hind hty hty' heqN hlen hlen' hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot h' h hn' hn hc.symmT

/-- Transitivity of `LRTypeFamINR` at every `EnvWfT E` and `PiRowField E n` (requiring **no**
    external `WhDet` hypothesis, since `whRedRecCtx_normal_unique_of_envWfT hW` discharges normal-form
    uniqueness unconditionally). -/
theorem lrTypeFamINR_trans_of_envWfT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamINR E n Γ A B c) :
    ∀ {C : Expr Nat}, LRTypeFamINR E n Γ B C c → LRTypeFamINR E n Γ A C c := by
  have hcl := envClosed_of_envWfT hW
  induction h₁ with
  | bot => intro C _; exact .bot _ _ _
  | sort h _ =>
      intro C h₂
      cases h₂ with
      | sort _ hC => exact .sort h hC
  | @pi Γ A B A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      intro C h₂
      cases h₂ with
      | pi hB hC _ hdom' hcod' ra' rf' =>
          have e := whRedRecCtx_normal_unique_of_envWfT hW
            h' (whNormalRecCtx_pi _ _) hB (whNormalRecCtx_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi h hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom hdom')
                (.trans _ _ _ _ hcod (tyConvT_assump_dom hW hΓ₀ hdom hcod'))
                (iha hΓ₀ ra')
                (fun s hs => ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)
                  (lrTypeFamINR_assump_dom hcl hW hΓ₀ hdom hA₁ (rf' s hs)))
  | @famSpine Γ A B r m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ args hm₁ hind₁ h₁ h₁' hty₁ hty₂ hc₁ heqN₁ hlen₁ hlen₂ hargs₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ _ hB hC _ hty₃ hc₂ heqN₂ _ hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          have e := whRedRecCtx_normal_unique_of_envWfT hW
            h₁' (whNormalRecCtx_famApp hW hm₁ hind₁ ls₂ xs₂)
            hB (whNormalRecCtx_famApp hW hm₁ hind₁ _ _)
          obtain ⟨hconst, hxs⟩ := foldApps_const_inj e
          injection hconst with _ hls
          subst hls; subst hxs
          exact .famSpine hm₁ hind₁ h₁ hC hty₁ hty₃
            (.trans _ _ _ _ hc₁ hc₂)
            (eqNList_trans heqN₁ heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype hW hpi hΓ hm₁ hty₁ hty₂ heqN₁ hargs₁ hargs₂)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | @otherSpine Γ A B X X' r args hnot₁ h₁ h₁' hn₁ hn₁' hc₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ _ _ _ _ _ _ _ _ _ =>
          exact (hnot₁ _ hm₂ hind₂).elim
      | otherSpine _ hB hC hY hY' hc₂ =>
          have e := whRedRecCtx_normal_unique_of_envWfT hW h₁' hn₁' hB hY
          subst e
          exact .otherSpine hnot₁ h₁ hC hn₁ hY' (.trans _ _ _ _ hc₁ hc₂)

/-- Transitivity of `LRTypeFamINR` at `.pi .bot []` under `EnvWfT E` alone (without `PiRowField`). -/
theorem lrTypeFamINR_trans_pi_bot_nil_of_envWfT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B C : Expr Nat}
    (h₁ : LRTypeFamINR E n Γ A B (.pi .bot []))
    (h₂ : LRTypeFamINR E n Γ B C (.pi .bot [])) :
    LRTypeFamINR E n Γ A C (.pi .bot []) := by
  cases h₁ with
  | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ hA hB₁ hΓ₁ hdom₁ hcod₁ _ _ =>
      cases h₂ with
      | @pi _ _ _ A₂' B₂' A₃ B₃ _ _ hB₂ hC _ hdom₂ hcod₂ _ _ =>
          have heq := whRedRecCtx_normal_unique_of_envWfT hW
            hB₁ (whNormalRecCtx_pi A₂ B₂) hB₂ (whNormalRecCtx_pi A₂' B₂')
          injection heq with hAeq hBeq
          subst hAeq; subst hBeq
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi hA hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom₁ hdom₂)
                (.trans _ _ _ _ hcod₁ (tyConvT_assump_dom hW hΓ₀ hdom₁ hcod₂))
                (.bot _ _ _)
                (fun _ hs => (List.not_mem_nil _ hs).elim)

/-- Reading off Π domain and codomain `TyConvT` from `LRTypeFamINR E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])`. -/
theorem lrTypeFamINR_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeFamINR E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  cases h with
  | pi h h' _ hdom hcod _ _ =>
      have e₁ := whRedRecCtx_pi_eq h
      have e₂ := whRedRecCtx_pi_eq h'
      injection e₁ with eA₁ eB₁
      injection e₂ with eA₂ eB₂
      subst eA₁; subst eB₁; subst eA₂; subst eB₂
      exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

/-- Reading off `eqNList`, equal argument lengths, and `ConvArgsT` from `LRTypeFamINR` on admitted
    `.inductiveM` family spines. -/
theorem lrTypeFamINR_famApp_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINR E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  cases h with
  | famSpine hm' _ hred hred' _ _ _ heqN hlen hlen' hargs =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have e₁ := whRedRecCtx_famApp_eq hW hm hind hred
      have e₂ := whRedRecCtx_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs₁⟩ := foldApps_const_inj e₁.symm
      obtain ⟨hconst₂, hxs₂⟩ := foldApps_const_inj e₂.symm
      injection hconst₁ with _ hls₁
      injection hconst₂ with _ hls₂
      subst hls₁; subst hxs₁; subst hls₂; subst hxs₂
      exact ⟨heqN, hlen.trans hlen'.symm, hargs⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- Reading `LRTypeFamINR` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    also yields `RelevantSlotConv` (#7525). -/
theorem lrTypeFamINR_famApp_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamINR E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' :=
  relevantSlotConv_of_convArgsT hW hm hind
    (lrTypeFamINR_famApp_components hW hm hind h).2.2

/-- Bidirectional `BotFamCpt E`-restricted type logical relation over `WhRedRecCtx E Γ` and
    `ApproxDI E (ctxEnvDI E Γ)`. -/
def LRTypeFamINBiR (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A A' : Expr Nat) : Prop :=
  ∀ c, BotFamCpt E c →
    (PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A' c) →
    LRTypeFamINR E n Γ A A' c

/-- Every `LRTypeFamINBiDI E n Γ A A'` derivation lifts directly to `LRTypeFamINBiR E n Γ A A'`. -/
theorem lrTypeFamINBiR_of_lrTypeFamINBiDI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A A' : Expr Nat} (h : LRTypeFamINBiDI E n Γ A A') :
    LRTypeFamINBiR E n Γ A A' :=
  fun c hc happrox => lrTypeFamINR_of_lrTypeFamIN_botFamCpt hc (h c hc happrox)

/-- Weak-head step conversion in `LRTypeFamINBiR` from the diagonal on the contractum under
    `EnvWfT E` alone (including `recMajor`, `iota`, `delta`, `zetaLocal`, `beta`, `zeta`, `lit`, `appHead`). -/
theorem lrTypeFamINBiR_of_whStepRecCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hs : WhStepRecCtx E Γ M M')
    (hdiag : LRTypeFamINBiR E n Γ M' M') :
    LRTypeFamINBiR E n Γ M M' := by
  intro c hc h
  have hM' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M' c :=
    h.elim (fun hM => (approxDI_ctxEnvDI_whStepRecCtx_of_envWfT hW hs c).mp hM) id
  exact lrTypeFamINR_expand (.step hs (.refl _)) (.refl _) (hdiag c hc (Or.inl hM'))

/-- Multi-step `WhRedRecCtx` conversion in `LRTypeFamINBiR` from the diagonal on the contractum. -/
theorem lrTypeFamINBiR_of_whRedRecCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hr : WhRedRecCtx E Γ M M')
    (hdiag : LRTypeFamINBiR E n Γ M' M') :
    LRTypeFamINBiR E n Γ M M' := by
  intro c hc h
  have hM' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M' c :=
    h.elim (fun hM => (approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hr c).mp hM) id
  exact lrTypeFamINR_expand hr (.refl _) (hdiag c hc (Or.inl hM'))

/-- Diagonal `WhRedRecCtx` reduction in `LRTypeFamINBiR` from the diagonal on the contractum. -/
theorem lrTypeFamINBiR_diag_of_whRedRecCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' : Expr Nat} (hr : WhRedRecCtx E Γ M M')
    (hdiag : LRTypeFamINBiR E n Γ M' M') :
    LRTypeFamINBiR E n Γ M M := by
  intro c hc h
  have hM : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M c := h.elim id id
  have hM' : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) M' c :=
    (approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hr c).mp hM
  exact lrTypeFamINR_expand hr hr (hdiag c hc (Or.inl hM'))

/-- **Positive Resolution of `W-IOTA-MAJOR` in `LRTypeFamINBiR` (`lrTypeFamINBiR_trueRecMajorBeta`):**
    For any `u, motive, minor, Γ`, if `minor` satisfies the diagonal `LRTypeFamINBiR trueEnvU n Γ minor minor`,
    then `trueRecMajorBeta u motive minor` satisfies both the conversion `LRTypeFamINBiR trueEnvU n Γ (trueRecMajorBeta u motive minor) minor`
    and the diagonal `LRTypeFamINBiR trueEnvU n Γ (trueRecMajorBeta u motive minor) (trueRecMajorBeta u motive minor)`! -/
theorem lrTypeFamINBiR_trueRecMajorBeta (n : Nat) (u : Level) (motive minor : Expr Nat)
    (Γ : LCtx) (hdiag : LRTypeFamINBiR trueEnvU n Γ minor minor) :
    LRTypeFamINBiR trueEnvU n Γ (trueRecMajorBeta u motive minor) minor ∧
      LRTypeFamINBiR trueEnvU n Γ (trueRecMajorBeta u motive minor)
        (trueRecMajorBeta u motive minor) :=
  ⟨lrTypeFamINBiR_of_whRedRecCtx trueEnvUWfT (whRedRecCtx_trueRecMajorBeta u motive minor Γ) hdiag,
   lrTypeFamINBiR_diag_of_whRedRecCtx trueEnvUWfT (whRedRecCtx_trueRecMajorBeta u motive minor Γ) hdiag⟩

/-- **Concrete Positive Satisfaction on All Three `W-IOTA-MAJOR` Benchmarks (`trueIotaMajorSort`, `trueIotaMajorPi`, `trueIotaMajorFam`):** -/
theorem lrTypeFamINBiR_trueIotaMajorSort (n : Nat) (Γ : LCtx) :
    LRTypeFamINBiR trueEnvU n Γ trueIotaMajorSort (.sort .zero) ∧
      LRTypeFamINBiR trueEnvU n Γ trueIotaMajorSort trueIotaMajorSort :=
  lrTypeFamINBiR_trueRecMajorBeta n (.succ (.succ .zero)) (trueSortMotive (.succ .zero)) (.sort .zero) Γ
    (lrTypeFamINBiR_of_lrTypeFamINBiDI (lrTypeFamINBiDI_sort_diag trueEnvU n Γ .zero))

theorem lrTypeFamINBiR_trueIotaMajorPi (n : Nat) {Γ : LCtx} (hΓ : CtxWfT trueEnvU n Γ) :
    LRTypeFamINBiR trueEnvU n Γ trueIotaMajorPi PiModelDeltaIotaAudit.idPiProp ∧
      LRTypeFamINBiR trueEnvU n Γ trueIotaMajorPi trueIotaMajorPi :=
  lrTypeFamINBiR_trueRecMajorBeta n (.succ .zero) (trueSortMotive .zero) PiModelDeltaIotaAudit.idPiProp Γ
    (lrTypeFamINBiR_of_lrTypeFamINBiDI (lrTypeFamINBiDI_idPiProp_ctx trueEnvU n hΓ))

theorem lrTypeFamINBiR_trueIotaMajorFam (n : Nat) (Γ : LCtx) :
    LRTypeFamINBiR trueEnvU n Γ trueIotaMajorFam (.const 0 []) ∧
      LRTypeFamINBiR trueEnvU n Γ trueIotaMajorFam trueIotaMajorFam := by
  have hdiagTrue : LRTypeFamINBiR trueEnvU n Γ (.const 0 []) (.const 0 []) :=
    lrTypeFamINBiR_of_lrTypeFamINBiDI
      (lrTypeFamINBiDI_famSpine_of_convArgsT (xs := []) (xs' := []) trueEnvUWfT
        (m := trueFamMember) rfl rfl (trueConstTyT rfl) (trueConstTyT rfl)
        (.refl Γ (.const 0 [])) (eqNList_refl []) rfl rfl (.nil _))
  exact lrTypeFamINBiR_trueRecMajorBeta n (.succ .zero) (trueSortMotive .zero) (.const 0 []) Γ hdiagTrue

/-- Soundness-free two-sided `ApproxDI E (ctxEnvDI E Γ)` extraction from `LRTypeFamINR` on `BotFamCpt E`. -/
theorem approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamINR E n Γ A B c) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c ∧
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) B c := by
  induction h with
  | bot => exact ⟨.bot _ _, .bot _ _⟩
  | sort hA hB =>
      exact ⟨(approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hA .sort).mpr (.sort _ _),
             (approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hB .sort).mpr (.sort _ _)⟩
  | @pi Γ A B A₁ B₁ A₂ B₂ a f hA hB _ _ _ _ _ iha ihf =>
      cases hc with
      | pi ha hbd hf =>
          obtain ⟨ha₁, ha₂⟩ := iha ha
          have hf₁ : ∀ s ∈ f,
              PiModelDeltaIotaAudit.ApproxDI E (EnvI.cons (demand s.1) (ctxEnvDI E Γ)) B₁ s.2 :=
            fun s hs =>
              (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₁ s.2).mpr
                (ihf s hs (hf s hs)).1
          have hf₂ : ∀ s ∈ f,
              PiModelDeltaIotaAudit.ApproxDI E (EnvI.cons (demand s.1) (ctxEnvDI E Γ)) B₂ s.2 :=
            fun s hs =>
              (approxDI_cons_botDemand_ctxEnvDI_iff (hbd s hs) A₁ B₂ s.2).mpr
                (ihf s hs (hf s hs)).2
          exact ⟨(approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hA (.pi a f)).mpr (.pi ha₁ hf₁),
                 (approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hB (.pi a f)).mpr (.pi ha₂ hf₂)⟩
  | @famSpine Γ A B r m' ls ls' xs xs' _ _ args hm' hind' hA hB _ _ _ _ hlenA hlenB _ =>
      cases hc with
      | famSpine hm _ hlenArgs hbd =>
          rw [hm] at hm'
          injection hm' with hm_eq
          subst hm_eq
          have hrig : PiModelDeltaIotaAudit.RigidConst E r :=
            rigidConst_of_inductiveM hW hm hind'
          have hspA : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
              (foldApps (.const r ls) xs) (.spine r args) :=
            approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls hrig (hlenA.trans hlenArgs.symm) hbd
          have hspB : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ)
              (foldApps (.const r ls') xs') (.spine r args) :=
            approxDI_famApp_of_botDemand (ctxEnvDI E Γ) ls' hrig (hlenB.trans hlenArgs.symm) hbd
          exact ⟨(approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hA (.spine r args)).mpr hspA,
                 (approxDI_ctxEnvDI_whRedRecCtx_of_envWfT hW hB (.spine r args)).mpr hspB⟩
  | otherSpine hnot _ _ _ _ _ =>
      cases hc with
      | famSpine hm hind _ _ => exact (hnot _ hm hind).elim

/-- Right-hand projection of `approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt`. -/
theorem approxDI_ctxEnvDI_right_of_lrTypeFamINR_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {c : CptI}
    (hc : BotFamCpt E c) (h : LRTypeFamINR E n Γ A B c) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) B c :=
  (approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt hW hc h).2

/-- Symmetry of `LRTypeFamINBiR` under `EnvWfT E` and `PiRowField E n`. -/
theorem lrTypeFamINBiR_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A' : Expr Nat} (h : LRTypeFamINBiR E n Γ A A') :
    LRTypeFamINBiR E n Γ A' A :=
  fun c hc happrox => lrTypeFamINR_symm hW hpi hΓ (h c hc happrox.symm)

/-- Transitivity of `LRTypeFamINBiR` under `EnvWfT E` and `PiRowField E n`. -/
theorem lrTypeFamINBiR_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A B C : Expr Nat}
    (h₁ : LRTypeFamINBiR E n Γ A B) (h₂ : LRTypeFamINBiR E n Γ B C) :
    LRTypeFamINBiR E n Γ A C := by
  intro c hc happrox
  rcases happrox with hA | hC
  · have hAB := h₁ c hc (Or.inl hA)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt hW hc hAB).2
    exact lrTypeFamINR_trans_of_envWfT hW hpi hΓ hAB (h₂ c hc (Or.inl hB))
  · have hBC := h₂ c hc (Or.inr hC)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamINR_botFamCpt hW hc hBC).1
    exact lrTypeFamINR_trans_of_envWfT hW hpi hΓ (h₁ c hc (Or.inr hB)) hBC

/-- **Repaired Recursor-Major-Aware `BotFamCpt E` Type Fundamental Property (`FundamentalLRFamINBotR`):** -/
def FundamentalLRFamINBotR (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
      LRTypeFamINR E n Γ A A' c

/-- Reduction of `FundamentalLRFamINBotR E n` to its diagonal and single-link cases under `EnvWfT E`
    alone (deriving `PiRowField E n` internally at `.pi .bot []`). -/
theorem fundamentalLRFamINBotR_of_links {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hdiag : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
        LRTypeFamINR E n Γ A A c)
    (hlink : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A B : Expr Nat} {u : Level},
      ConvT E n Γ A B (.sort u) →
      ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
        LRTypeFamINR E n Γ A B c) :
    FundamentalLRFamINBotR E n := by
  have hpiChain : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.pi .bot []) →
      LRTypeFamINR E n Γ A A' (.pi .bot []) := by
    intro Γ hΓ A A' u hA hc
    revert u
    induction hc with
    | refl A =>
        intro u hA hcA
        exact hdiag hΓ hA (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA
    | of A B v hc =>
        intro _ _ hcA
        exact hlink hΓ hc (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA
    | trans A M B c₁ c₂ ih₁ ih₂ =>
        intro u hA hcA
        obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
        have r₁ := ih₁ hA hcA
        have hcM := approxDI_ctxEnvDI_right_of_lrTypeFamINR_botFamCpt hW (botFamCpt_pi_bot_nil E) r₁
        exact lrTypeFamINR_trans_pi_bot_nil_of_envWfT hW r₁ (ih₂ hM hcM)
  have hpi : PiRowField E n := by
    intro Γ hΓ A B A' B' hc
    rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
    · injection heq with hA hB
      subst hA; subst hB
      exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
    · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
      exact lrTypeFamINR_pi_components
        (hpiChain hΓ hPi hc (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A => intro u hA c hcpt hcA; exact hdiag hΓ hA c hcpt hcA
  | of A B v hc => intro _ _ c hcpt hcA; exact hlink hΓ hc c hcpt hcA
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxDI_ctxEnvDI_right_of_lrTypeFamINR_botFamCpt hW hcpt r₁
      exact lrTypeFamINR_trans_of_envWfT hW hpi hΓ r₁ (ih₂ hM c hcpt hcM)

/-- Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalLRFamINBotR E n`. -/
theorem piRowField_of_fundamentalLRFamINBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotR E n) : PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamINR_pi_components
      (F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
        (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))

/-- Disjointness of `.pi A B` and `.sort l` under `FundamentalLRFamINBotR E n`. -/
theorem not_tyConvT_pi_sort_of_fundamentalLRFamINBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotR E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · exact Expr.noConfusion heq
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    have hLR := F hΓ hPi hc (.pi .bot []) (botFamCpt_pi_bot_nil E)
      (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B)
    cases hLR with
    | pi _ hred' _ _ _ _ _ => exact nomatch whRedRecCtx_sort_eq hred'

/-- Disjointness of `.sort l` and `.pi A B` under `FundamentalLRFamINBotR E n`. -/
theorem not_tyConvT_sort_pi_of_fundamentalLRFamINBotR {E : ResolvedEnv} {n : Nat}
    (_hW : EnvWfT E) (F : FundamentalLRFamINBotR E n)
    {Γ : LCtx} (_hΓ : CtxWfT E n Γ) {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hLR := F _hΓ (.sort Γ l) hc .sort .sort (.sort (ctxEnvDI E Γ) l)
  cases hLR with
  | sort _ hred' => exact nomatch whRedRecCtx_pi_eq hred'

/-- Saturation (`xs.length = doms.length`) of any sort-typed admitted `.inductiveM` family spine
    under `FundamentalLRFamINBotR E n`. -/
theorem famApp_saturated_of_fundamentalLRFamINBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotR E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  have hprow : PiRowField E n := piRowField_of_fundamentalLRFamINBotR hW F
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_fundamentalLRFamINBotR hW F hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_fundamentalLRFamINBotR hW F hΓ hconv

/-- Canonical stored-domain saturation `xs.length = (piDomsOf m.mtype).length` from
    `FundamentalLRFamINBotR E n`. -/
theorem famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotR {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotR E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = (piDomsOf m.mtype).length := by
  have hlen := famApp_saturated_of_fundamentalLRFamINBotR hW F hΓ hm hind
    (instMtype_policyPi_of_inductiveM hW hm hind ls) hty
  rwa [List.length_map] at hlen

