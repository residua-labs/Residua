/-! #### Part C — K-Closed Concrete $\delta$/$\iota$ Family Model (`ApproxDIK E n Γ e c` & `SemEqDIK E n Γ a b`), Backwards Invariance Along `WhRedRecK`, Exact Coincidence on Value/Spine Heads, Family-Head Injectivity, and Resolution of `not_approxDI_trueVar*` -/

/-- **K-Closed Concrete $\delta$/$\iota$ Approximation (`ApproxDIK E n Γ e c`):**
    Closes `ApproxDI E (ctxEnvDI E Γ)` under `WhRedRecK E n Γ` weak-head reduction so that
    proposition-major recursor redexes (such as `trueVarSort`, `trueVarPi`, `trueVarFam` in
    `trueVarCtx`) inherit the compacts of their contracta while `.sort`, `.pi`, `.lam`, and
    admitted `.inductiveM` / `.constructorM` spines retain their exact `ApproxDI` compacts. -/
def ApproxDIK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (e : Expr Nat) (c : CptI) : Prop :=
  ∃ X, WhRedRecK E n Γ e X ∧ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) X c

/-- Semantic equality in `ApproxDIK E n Γ`. -/
def SemEqDIK (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (a b : Expr Nat) : Prop :=
  ∀ c, ApproxDIK E n Γ a c ↔ ApproxDIK E n Γ b c

/-- Every `ApproxDI E (ctxEnvDI E Γ) e c` compact embeds directly into `ApproxDIK E n Γ e c`. -/
theorem approxDIK_of_approxDI {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {e : Expr Nat} {c : CptI}
    (h : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c) : ApproxDIK E n Γ e c :=
  ⟨e, .refl e, h⟩

/-- `.bot` approximates every expression in `ApproxDIK E n Γ`. -/
theorem approxDIK_bot (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (e : Expr Nat) :
    ApproxDIK E n Γ e .bot :=
  ⟨e, .refl e, .bot _ e⟩

/-- Backwards invariance of `ApproxDIK E n Γ` along any `WhStepRecK E n Γ` step (including `pmajor`
    and `recMajor`). -/
theorem approxDIK_of_whStepRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a b : Expr Nat} {c : CptI}
    (hs : WhStepRecK E n Γ a b) (hb : ApproxDIK E n Γ b c) : ApproxDIK E n Γ a c := by
  rcases hb with ⟨X, hred, hX⟩
  exact ⟨X, .step hs hred, hX⟩

/-- Backwards invariance of `ApproxDIK E n Γ` along any `WhRedRecK E n Γ` reduction. -/
theorem approxDIK_of_whRedRecK {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {a b : Expr Nat} {c : CptI}
    (hr : WhRedRecK E n Γ a b) (hb : ApproxDIK E n Γ b c) : ApproxDIK E n Γ a c := by
  rcases hb with ⟨X, hred, hX⟩
  exact ⟨X, whRedRecK_trans hr hred, hX⟩

/-- On `.sort u`, `ApproxDIK E n Γ` is identical (`↔`) to `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIK_sort_iff (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (u : Level) (c : CptI) :
    ApproxDIK E n Γ (.sort u) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.sort u) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecK_sort_eq hred] at hX
  · exact approxDIK_of_approxDI

/-- On `.pi A B`, `ApproxDIK E n Γ` is identical (`↔`) to `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIK_pi_iff (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A B : Expr Nat) (c : CptI) :
    ApproxDIK E n Γ (.pi A B) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.pi A B) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecK_pi_eq hred] at hX
  · exact approxDIK_of_approxDI

/-- On `.lam A b`, `ApproxDIK E n Γ` is identical (`↔`) to `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIK_lam_iff (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A b : Expr Nat) (c : CptI) :
    ApproxDIK E n Γ (.lam A b) c ↔ PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (.lam A b) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecK_lam_eq hred] at hX
  · exact approxDIK_of_approxDI

/-- Under `EnvWfT E`, on any admitted `.inductiveM` family spine `foldApps (.const r ls) xs`,
    `ApproxDIK E n Γ` is identical (`↔`) to `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIK_famApp_iff {E : ResolvedEnv} (hW : EnvWfT E) (n : Nat) (Γ : LCtx)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIK E n Γ (foldApps (.const r ls) xs) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const r ls) xs) c := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecK_famApp_eq hW hm hind hred] at hX
  · exact approxDIK_of_approxDI

/-- Under `EnvWfT E`, on any admitted `.constructorM` constructor spine `foldApps (.const c ls) xs`,
    `ApproxDIK E n Γ` is identical (`↔`) to `ApproxDI E (ctxEnvDI E Γ)`. -/
theorem approxDIK_ctorApp_iff {E : ResolvedEnv} (hW : EnvWfT E) (n : Nat) (Γ : LCtx)
    {c : Nat} {m : CheckedMember} (hm : E.members c = some m) (hctor : m.mclass = .constructorM)
    (ls : List Level) (xs : List (Expr Nat)) (u : CptI) :
    ApproxDIK E n Γ (foldApps (.const c ls) xs) u ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const c ls) xs) u := by
  constructor
  · rintro ⟨X, hred, hX⟩
    rwa [whRedRecK_ctorApp_eq hW hm hctor hred] at hX
  · exact approxDIK_of_approxDI

/-- For any assumption variable `.bvar i` (`lookupValue Γ i = none`), `ApproxDIK E n Γ (.bvar i) c ↔ c = .bot`. -/
theorem approxDIK_bvar_of_lookupValue_none_iff {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (c : CptI) :
    ApproxDIK E n Γ (.bvar i) c ↔ c = .bot := by
  constructor
  · rintro ⟨X, hred, hX⟩
    cases hred with
    | refl => exact approxDI_ctxEnvDI_bvar_of_lookupValue_none hnone hX
    | step hs _ => exact (whStepRecK_bvar_of_lookupValue_none_false hnone hs).elim
  · rintro rfl
    exact approxDIK_bot E n Γ (.bvar i)

theorem approxDIK_sort (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (u : Level) :
    ApproxDIK E n Γ (.sort u) .sort :=
  approxDIK_of_approxDI (.sort _ u)

theorem approxDIK_pi_bot_nil (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A B : Expr Nat) :
