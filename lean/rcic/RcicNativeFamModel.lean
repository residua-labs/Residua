  have hDI : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (foldApps (.const r ls) xs) c :=
    (approxDIKCanon_famApp_iff hW Γ hm hind ls xs c).mp h
  rcases (PiModelDeltaIotaAudit.approxDI_foldApps_rigid_iff ls
    (rigidConst_of_inductiveM hW hm hind) xs c).mp hDI with
    rfl | ⟨cs, _, rfl⟩
  · exact .bot _ _ _
  · exact .famSpine hm hind (.refl _) (.refl _) hty hty' hc heqN hlen hlen' hargs

theorem lrTypeFamINRKCanon_of_whStepRecKCanon_probe {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (hs : WhStepRecKCanon E Γ M M') {c : CptI}
    (hdiag : LRTypeFamINRKCanon E n Γ M' M' c) :
    LRTypeFamINRKCanon E n Γ M M' c :=
  lrTypeFamINRKCanon_expand (.step hs (.refl _)) (.refl _) hdiag

theorem lrTypeFamINRKCanon_of_whRedRecKCanon_probe {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (hr : WhRedRecKCanon E Γ M M') {c : CptI}
    (hdiag : LRTypeFamINRKCanon E n Γ M' M' c) :
    LRTypeFamINRKCanon E n Γ M M' c :=
  lrTypeFamINRKCanon_expand hr (.refl _) hdiag


/-! ### §17 — Exact Two-Way Model Invariance (`ReadbackModelInv`) of `ApproxDIKCanon` Along `WhStepRecKCanon`, Full Bidirectional PER `LRTypeFamINBiProbeRKCanon`, and Unconditional PER & Index Transport of Canonical K-Aware Term Logical Relation `LRTermFamINDRKCanon`

