/-- **`PiRowField`-Free Symmetry of `LRTypeFamINBiRK` (`lrTypeFamINBiRK_symm_of_envWfT`):** -/
theorem lrTypeFamINBiRK_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
