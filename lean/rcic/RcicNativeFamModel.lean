/-! ### §1 — L1-Fam: the model fragment for family heads and application spines -/

/-- Inversion of `Approx` at a constant `.const r ls`. -/
theorem approx_const_inv {ρ : Env} {r : Nat} {ls : List Level} {c : Cpt}
    (h : Approx ρ (.const r ls) c) :
    c = .bot ∨ c = .lam [] ∨ c = .spine r [] := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | const => exact Or.inr (Or.inr rfl)

/-- Inversion of `Approx` at a `.letE`. -/
theorem approx_letE_inv {ρ : Env} {A v b : Expr Nat} {c : Cpt}
    (h : Approx ρ (.letE A v b) c) :
    c = .bot ∨ c = .lam [] ∨ Approx ρ (.app (.lam A b) v) c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | letE h' => exact Or.inr (Or.inr h')

/-- Inversion of `Approx` at a `.lit`. -/
theorem approx_lit_inv {ρ : Env} {t : Nat} {c : Cpt}
    (h : Approx ρ (.lit t) c) :
    c = .bot ∨ c = .lam [] ∨ Approx ρ (natExpand t) c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | lit h' => exact Or.inr (Or.inr h')

/-- Pointwise approximation of an argument spine `xs : List (Expr Nat)` by a compact spine
    `us : List Cpt`. -/
inductive ApproxArgs (ρ : Env) : List (Expr Nat) → List Cpt → Prop
  | nil : ApproxArgs ρ [] []
  | cons {x : Expr Nat} {u : Cpt} {xs : List (Expr Nat)} {us : List Cpt}
      (hx : Approx ρ x u) (hxs : ApproxArgs ρ xs us) :
      ApproxArgs ρ (x :: xs) (u :: us)

/-- Equal length of `ApproxArgs`-related spines. -/
theorem approxArgs_length {ρ : Env} {xs : List (Expr Nat)} {us : List Cpt}
    (h : ApproxArgs ρ xs us) : xs.length = us.length := by
  induction h with
  | nil => rfl
  | cons _ _ ih => exact congrArg Nat.succ ih

/-- Snoc for `ApproxArgs`. -/
theorem approxArgs_snoc {ρ : Env} {xs : List (Expr Nat)} {us : List Cpt}
    {x : Expr Nat} {u : Cpt}
    (hxs : ApproxArgs ρ xs us) (hx : Approx ρ x u) :
    ApproxArgs ρ (xs ++ [x]) (us ++ [u]) := by
  induction hxs with
  | nil => exact .cons hx .nil
  | cons h₀ _ ih => exact .cons h₀ ih

/-- Spine introduction: extending a `.spine r args` approximation along an `ApproxArgs`
    argument spine. -/
theorem approx_foldApps_spine {ρ : Env} {r : Nat} {f : Expr Nat} {args : List Cpt}
    {xs : List (Expr Nat)} {us : List Cpt}
    (hf : Approx ρ f (.spine r args)) (hxs : ApproxArgs ρ xs us) :
    Approx ρ (foldApps f xs) (.spine r (args ++ us)) := by
  induction hxs generalizing f args with
  | nil =>
      simp only [foldApps, List.append_nil]
      exact hf
  | cons ha _ ih =>
      simp only [foldApps]
      have hstep := ih (.appSpine hf ha)
      rw [List.append_assoc] at hstep
      exact hstep

/-- Constant-headed spine introduction: `foldApps (.const r ls) xs` approximates `.spine r us`
    whenever `xs` approximates `us` pointwise. -/
theorem approx_famApp {ρ : Env} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {us : List Cpt}
    (h : ApproxArgs ρ xs us) :
    Approx ρ (foldApps (.const r ls) xs) (.spine r us) := by
  have h0 := approx_foldApps_spine (.const ρ r ls) h
  simpa only [List.nil_append] using h0

/-- Inductive invariant for constant-headed application spines: any compact approximating `f`
    is `.bot`, `.lam []`, or `.spine r us` with `ApproxArgs ρ pre us`.
    Because `f` never approximates `.lam g` for a non-empty step table `g`, `Approx.app`
    can never fire at `.app f x` — only `Approx.appSpine` can. -/
def IsSpineExpr (ρ : Env) (r : Nat) (pre : List (Expr Nat)) (f : Expr Nat) : Prop :=
  ∀ c, Approx ρ f c →
    c = .bot ∨ c = .lam [] ∨ ∃ us, c = .spine r us ∧ ApproxArgs ρ pre us

theorem isSpineExpr_const (ρ : Env) (r : Nat) (ls : List Level) :
    IsSpineExpr ρ r [] (.const r ls) := by
  intro c hc
  rcases approx_const_inv hc with h0 | h0 | h0
  · exact Or.inl h0
  · exact Or.inr (Or.inl h0)
  · exact Or.inr (Or.inr ⟨[], h0, .nil⟩)

theorem isSpineExpr_app {ρ : Env} {r : Nat} {pre : List (Expr Nat)} {f : Expr Nat}
    (hf : IsSpineExpr ρ r pre f) (x : Expr Nat) :
    IsSpineExpr ρ r (pre ++ [x]) (.app f x) := by
  intro c hc
  rcases approx_app_inv hc with h0 | h0 | ⟨g, p, _, hfg, hp, _⟩ | ⟨r', args, u, rfl, hfs, hxu⟩
  · exact Or.inl h0
  · exact Or.inr (Or.inl h0)
  · rcases hf (.lam g) hfg with hbot | hnil | ⟨_, hsp, _⟩
    · exact nomatch hbot
    · cases hnil; exact nomatch hp
    · exact nomatch hsp
  · rcases hf (.spine r' args) hfs with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with hr hargs
      subst hr; subst hargs
      exact Or.inr (Or.inr ⟨args ++ [u], rfl, approxArgs_snoc hus hxu⟩)

theorem isSpineExpr_foldApps {ρ : Env} {r : Nat} :
    ∀ (xs : List (Expr Nat)) {pre : List (Expr Nat)} {f : Expr Nat},
      IsSpineExpr ρ r pre f → IsSpineExpr ρ r (pre ++ xs) (foldApps f xs)
  | [], _, _, hf => by
      rw [List.append_nil]
      exact hf
  | x :: xs, _, _, hf => by
      simp only [foldApps]
      have hstep := isSpineExpr_foldApps xs (isSpineExpr_app hf x)
      rw [List.append_assoc] at hstep
      exact hstep

/-- Inversion of `Approx` at a constant-headed application spine `foldApps (.const r ls) xs`. -/
theorem approx_foldApps_const_inv {ρ : Env} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)} {c : Cpt}
    (h : Approx ρ (foldApps (.const r ls) xs) c) :
    c = .bot ∨ c = .lam [] ∨ ∃ us, c = .spine r us ∧ ApproxArgs ρ xs us := by
  have h0 := isSpineExpr_foldApps xs (isSpineExpr_const ρ r ls) c h
  simpa only [List.nil_append] using h0

/-- Canonical compact argument vector with `.bot` at every slot of `xs`. -/
def botVec : List (Expr Nat) → List Cpt
  | [] => []
  | _ :: xs => .bot :: botVec xs

theorem botVec_length : ∀ (xs : List (Expr Nat)), (botVec xs).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (botVec_length xs)

theorem approxArgs_botVec (ρ : Env) :
    ∀ (xs : List (Expr Nat)), ApproxArgs ρ xs (botVec xs)
  | [] => .nil
  | x :: xs => .cons (.bot ρ x) (approxArgs_botVec ρ xs)

/-- Every constant-headed spine `foldApps (.const r ls) xs` is approximated by
    `.spine r (botVec xs)`. -/
theorem approx_famApp_botVec (ρ : Env) (r : Nat) (ls : List Level) (xs : List (Expr Nat)) :
    Approx ρ (foldApps (.const r ls) xs) (.spine r (botVec xs)) :=
  approx_famApp r ls (approxArgs_botVec ρ xs)

/-- Probe compact vector placing `u` at slot `i` and `.bot` at all other slots of `xs`. -/
def slotVec : List (Expr Nat) → Nat → Cpt → List Cpt
  | [], _, _ => []
  | _ :: xs, 0, u => u :: botVec xs
  | _ :: xs, i + 1, u => .bot :: slotVec xs i u

theorem approxArgs_slotVec {ρ : Env} :
    ∀ {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : Cpt},
      xs[i]? = some x → Approx ρ x u → ApproxArgs ρ xs (slotVec xs i u)
  | [], _, _, _, hx, _ => by rw [List.getElem?_nil] at hx; exact Option.noConfusion hx
  | _ :: ys, 0, _, _, hx, hu => by
      rw [List.getElem?_cons_zero] at hx
      injection hx with hyx
      subst hyx
      exact .cons hu (approxArgs_botVec ρ ys)
  | y :: _, _ + 1, _, _, hx, hu => by
      rw [List.getElem?_cons_succ] at hx
      exact .cons (.bot ρ y) (approxArgs_slotVec hx hu)

theorem approxArgs_slotVec_inv {ρ : Env} :
    ∀ {xs xs' : List (Expr Nat)} {i : Nat} {x' : Expr Nat} {u : Cpt},
      xs'[i]? = some x' → ApproxArgs ρ xs' (slotVec xs i u) → Approx ρ x' u
  | [], _, _, _, _, hx', h => by
      cases h
      rw [List.getElem?_nil] at hx'; exact Option.noConfusion hx'
  | _ :: _, _ :: _, 0, _, _, hx', .cons hu' _ => by
      rw [List.getElem?_cons_zero] at hx'
      injection hx' with hyx'
      subst hyx'
      exact hu'
  | _ :: _, _ :: _, _ + 1, _, _, hx', .cons _ htail => by
      rw [List.getElem?_cons_succ] at hx'
      exact approxArgs_slotVec_inv hx' htail

theorem approx_famApp_slotVec {ρ : Env} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : Cpt}
    (hx : xs[i]? = some x) (hu : Approx ρ x u) :
    Approx ρ (foldApps (.const r ls) xs) (.spine r (slotVec xs i u)) :=
  approx_famApp r ls (approxArgs_slotVec hx hu)

/-- Family-head injectivity in the model (head constant and spine length). -/
theorem semEq_famApp_head_length {ρ : Env} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEq ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hR := (h (.spine r (botVec xs))).mp (approx_famApp_botVec ρ r ls xs)
  rcases approx_foldApps_const_inv hR with hbot | hnil | ⟨us, hsp, hus⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · injection hsp with hr hus_eq
    subst hr; subst hus_eq
    exact ⟨rfl, (botVec_length xs).symm.trans (approxArgs_length hus).symm⟩

/-- Slotwise argument injectivity in the model: if two constant-headed spines are semantically
    equal in `ρ`, then their arguments at each slot `i` are semantically equal in `ρ`. -/
theorem semEq_famApp_slot {ρ : Env} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEq ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs'))
    {i : Nat} {x x' : Expr Nat}
    (hx : xs[i]? = some x) (hx' : xs'[i]? = some x') :
    SemEq ρ x x' := by
  intro u
  constructor
  · intro hu
    have hR := (h (.spine r (slotVec xs i u))).mp (approx_famApp_slotVec r ls hx hu)
    rcases approx_foldApps_const_inv hR with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxArgs_slotVec_inv hx' hus
  · intro hu'
    have hL := (h (.spine r' (slotVec xs' i u))).mpr (approx_famApp_slotVec r' ls' hx' hu')
    rcases approx_foldApps_const_inv hL with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxArgs_slotVec_inv hx hus

/-- Full family-spine injectivity in the model: head identity, spine arity equality, and
    pointwise semantic equality of all spine arguments. -/
theorem semEq_famApp_inj {ρ : Env} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEq ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEq ρ x x' :=
  ⟨(semEq_famApp_head_length h).1, (semEq_famApp_head_length h).2,
    fun _ _ _ hx hx' => semEq_famApp_slot h hx hx'⟩

/-- Π-types and constant-headed family spines are disjoint in the model. -/
theorem semEq_pi_famApp_disjoint {ρ : Env} {A B : Expr Nat} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)}
    (h : SemEq ρ (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hR := (h (.pi .bot [])).mp (.pi (.bot ρ A) (fun _ hp => nomatch hp))
  rcases approx_foldApps_const_inv hR with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0

/-- Sorts and constant-headed family spines are disjoint in the model. -/
theorem semEq_sort_famApp_disjoint {ρ : Env} {l : Level} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)}
    (h : SemEq ρ (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hR := (h .sort).mp (.sort ρ l)
  rcases approx_foldApps_const_inv hR with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0


/-! ### §2 — L1′-Fam & L2-Fam: soundness of `ConvT` constructors relevant to family spines -/

/-- `.letE A v b` is semantically equal to the β-redex `.app (.lam A b) v`. -/
theorem semEq_letE_betaRedex (ρ : Env) (A v b : Expr Nat) :
    SemEq ρ (.letE A v b) (.app (.lam A b) v) := by
  intro c
  constructor
  · intro h
    rcases approx_letE_inv h with rfl | rfl | h'
    · exact .bot _ _
    · exact .lamNil _ _
    · exact h'
  · intro h
    exact .letE h

/-- Semantic equality is a congruence for `.letE` (the type annotation is semantically inert). -/
theorem semEq_letE {ρ : Env} {A A' v v' b b' : Expr Nat}
    (hv : SemEq ρ v v') (hb : ∀ S, SemEq (Env.cons S ρ) b b') :
    SemEq ρ (.letE A v b) (.letE A' v' b') :=
  (semEq_letE_betaRedex ρ A v b).trans
    ((semEq_app (semEq_lam (A := A) (A' := A') hb) hv).trans
      (semEq_letE_betaRedex ρ A' v' b').symm)

/-- `.lit t` is semantically equal to `natExpand t`. -/
theorem semEq_lit (ρ : Env) (t : Nat) : SemEq ρ (.lit t) (natExpand t) := by
  intro c
  constructor
  · intro h
    rcases approx_lit_inv h with rfl | rfl | h'
    · exact .bot _ _
    · exact .lamNil _ _
    · exact h'
  · intro h
    exact .lit h

/-- Pointwise semantic equality of argument spines. -/
inductive SemEqArgs (ρ : Env) : List (Expr Nat) → List (Expr Nat) → Prop
  | nil : SemEqArgs ρ [] []
  | cons {x y : Expr Nat} {xs ys : List (Expr Nat)}
      (hxy : SemEq ρ x y) (hxs : SemEqArgs ρ xs ys) :
      SemEqArgs ρ (x :: xs) (y :: ys)

/-- Semantic equality lifts across `foldApps` spines. -/
theorem semEq_foldApps {ρ : Env} {f g : Expr Nat} {xs ys : List (Expr Nat)}
    (hfg : SemEq ρ f g) (hxs : SemEqArgs ρ xs ys) :
    SemEq ρ (foldApps f xs) (foldApps g ys) := by
  induction hxs generalizing f g with
  | nil => exact hfg
  | cons hxy _ ih => exact ih (semEq_app hfg hxy)

/-- Semantic equality for constant-headed family spines with `SemEqArgs`-related arguments. -/
theorem semEq_famApp_congr {ρ : Env} (r : Nat) (ls ls' : List Level)
    {xs ys : List (Expr Nat)} (hxs : SemEqArgs ρ xs ys) :
    SemEq ρ (foldApps (.const r ls) xs) (foldApps (.const r ls') ys) :=
  semEq_foldApps (semEq_consts ρ r ls ls') hxs

/-- Pointwise inclusion of environments of ideals. -/
def EnvLe (ρ ρ' : Env) : Prop := ∀ i c, ρ i c → ρ' i c

theorem EnvLe.refl (ρ : Env) : EnvLe ρ ρ := fun _ _ h => h

theorem EnvLe.cons {ρ ρ' : Env} (h : EnvLe ρ ρ') (S : Cpt → Prop) :
    EnvLe (Env.cons S ρ) (Env.cons S ρ')
  | 0, _, hc => hc
  | i + 1, c, hc => h i c hc

theorem EnvLe.cons_mono {S S' : Cpt → Prop} {ρ ρ' : Env}
    (hS : ∀ c, S c → S' c) (hρ : EnvLe ρ ρ') :
    EnvLe (Env.cons S ρ) (Env.cons S' ρ')
  | 0, c, hc => hS c hc
  | i + 1, c, hc => hρ i c hc

/-- `Approx` is monotone in the environment `ρ`. -/
theorem approx_mono {ρ : Env} {e : Expr Nat} {c : Cpt}
    (h : Approx ρ e c) : ∀ {ρ' : Env}, EnvLe ρ ρ' → Approx ρ' e c := by
  induction h with
  | bot _ e => intro _ _; exact .bot _ e
  | lamNil _ e => intro _ _; exact .lamNil _ e
  | bvar h => intro _ hρ; exact .bvar (hρ _ _ h)
  | sort _ l => intro _ _; exact .sort _ l
  | pi _ _ ihA ihB =>
      intro _ hρ
      exact .pi (ihA hρ) (fun p hp => ihB p hp (hρ.cons _))
  | lam _ ihb =>
      intro _ hρ
      exact .lam (fun p hp => ihb p hp (hρ.cons _))
  | app _ hp _ ihf iha =>
      intro _ hρ
      exact .app (ihf hρ) hp (iha hρ)
  | const _ r ls => intro _ _; exact .const _ r ls
  | appSpine _ _ ihf iha =>
      intro _ hρ
      exact .appSpine (ihf hρ) (iha hρ)
  | letE _ ih =>
      intro _ hρ
      exact .letE (ih hρ)
  | lit _ ih =>
      intro _ hρ
      exact .lit (ih hρ)

/-- Forward β-approximation: any compact approximating `.app (.lam A b) a` also approximates
    `b` in the extended environment `Env.cons (fun u => Approx ρ a u) ρ`. -/
theorem approx_beta_to_substEnv {ρ : Env} {A b a : Expr Nat} {c : Cpt}
    (h : Approx ρ (.app (.lam A b) a) c) :
    Approx (Env.cons (fun u => Approx ρ a u) ρ) b c := by
  rcases approx_app_inv h with rfl | rfl | ⟨g, p, rfl, hlam, hp, ha⟩ | ⟨_, _, _, _, hsp, _⟩
  · exact .bot _ _
  · exact .lamNil _ _
  · rcases approx_lam_inv hlam with hbot | ⟨f, heq, hb⟩
    · exact nomatch hbot
    · injection heq with hgf
      subst hgf
      have hbp : Approx (Env.cons (Cpt.down p.1) ρ) b p.2 := hb p hp
      have hmono : EnvLe (Env.cons (Cpt.down p.1) ρ) (Env.cons (fun u => Approx ρ a u) ρ) :=
        EnvLe.cons_mono
          (fun u hu => by
            rw [Cpt.down] at hu
            subst hu
            exact ha)
          (EnvLe.refl ρ)
      exact approx_mono hbp hmono
  · rcases approx_lam_inv hsp with hbot | ⟨_, h0, _⟩
    · exact nomatch hbot
    · exact nomatch h0

/-- Admitted inductive family members are not δ-transparent: `ConvT.delta` never fires at an
    `.inductiveM` head. -/
theorem not_transparent_of_inductiveM {m : CheckedMember}
    (hind : m.mclass = .inductiveM) (htr : transparent m.mclass = true) : False := by
  rw [hind] at htr
  exact Bool.noConfusion htr

/-- Extended congruence/literal fragment of `ConvT` (`CongrFrag` + `letE` + `lit`). -/
inductive FamCongrFrag (E : ResolvedEnv) (n : Nat) :
    {Γ : LCtx} → {a b T : Expr Nat} → ConvT E n Γ a b T → Prop
  | refl {Γ : LCtx} {a A : Expr Nat} {h : HasTyT E n Γ a A} :
      FamCongrFrag E n (@ConvT.refl E n Γ a A h)
  | symm {Γ : LCtx} {a b A : Expr Nat} {h : ConvT E n Γ a b A} (hh : FamCongrFrag E n h) :
      FamCongrFrag E n (ConvT.symm Γ a b A h)
  | trans {Γ : LCtx} {a b c A : Expr Nat} {h₁ : ConvT E n Γ a b A} {h₂ : ConvT E n Γ b c A}
      (hh₁ : FamCongrFrag E n h₁) (hh₂ : FamCongrFrag E n h₂) :
      FamCongrFrag E n (ConvT.trans Γ a b c A h₁ h₂)
  | pi {Γ : LCtx} {A A' B B' : Expr Nat} {u v : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) B B' (.sort v)}
      (hh₁ : FamCongrFrag E n h₁) (hh₂ : FamCongrFrag E n h₂) :
      FamCongrFrag E n (ConvT.pi Γ A A' B B' u v h₁ h₂)
  | lam {Γ : LCtx} {A A' b b' B : Expr Nat} {u : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) b b' B}
      (hh₁ : FamCongrFrag E n h₁) (hh₂ : FamCongrFrag E n h₂) :
      FamCongrFrag E n (ConvT.lam Γ A A' b b' B u h₁ h₂)
  | app {Γ : LCtx} {f g a b A B : Expr Nat} {h₁ : ConvT E n Γ f g (.pi A B)}
      {h₂ : ConvT E n Γ a b A} (hh₁ : FamCongrFrag E n h₁) (hh₂ : FamCongrFrag E n h₂) :
      FamCongrFrag E n (ConvT.app Γ f g a b A B h₁ h₂)
  | letE {Γ : LCtx} {A A' v v' b b' B : Expr Nat} {u : Level}
      {hA : ConvT E n Γ A A' (.sort u)} {hv : ConvT E n Γ v v' A}
      {hb : ConvT E n (.letBinding A v :: Γ) b b' B}
      (hhA : FamCongrFrag E n hA) (hhv : FamCongrFrag E n hv) (hhb : FamCongrFrag E n hb) :
      FamCongrFrag E n (ConvT.letE Γ A A' v v' b b' B u hA hv hb)
  | lit {Γ : LCtx} {t : Nat} {e A : Expr Nat} {hl : LiteralExpansion t e}
      {hexp : HasTyT E n Γ e A} :
      FamCongrFrag E n (ConvT.lit Γ t e A hl hexp)
  | tyConv {Γ : LCtx} {a b A A' : Expr Nat} {u : Level} {h : ConvT E n Γ a b A}
      {hA : ConvT E n Γ A A' (.sort u)} (hh : FamCongrFrag E n h) :
      FamCongrFrag E n (ConvT.tyConv Γ a b A A' u h hA)
  | sorts {Γ : LCtx} {u v : Level} {h : eqN u v} :
      FamCongrFrag E n (ConvT.sorts Γ u v h)
  | consts {Γ : LCtx} {r : Nat} {ls ls' : List Level} {m : CheckedMember}
      {hres : E.members r = some m} {hlen : ls.length = m.arity}
      {hwf : levelsBounded n ls = true} {hwf' : levelsBounded n ls' = true}
      {h : eqNList ls ls'} :
      FamCongrFrag E n (ConvT.consts Γ r ls ls' m hres hlen hwf hwf' h)

/-- `CongrFrag` embeds into `FamCongrFrag`. -/
theorem famCongrFrag_of_congrFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : CongrFrag E n h) : FamCongrFrag E n h := by
  induction hh with
  | refl => exact .refl
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | pi _ _ ih₁ ih₂ => exact .pi ih₁ ih₂
  | lam _ _ ih₁ ih₂ => exact .lam ih₁ ih₂
  | app _ _ ih₁ ih₂ => exact .app ih₁ ih₂
  | tyConv _ ih => exact .tyConv ih
  | sorts => exact .sorts
  | consts => exact .consts

/-- Soundness of `FamCongrFrag` at every environment `ρ`. -/
theorem semEq_of_famCongrFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCongrFrag E n h) : ∀ ρ : Env, SemEq ρ a b := by
  induction hh with
  | refl => intro ρ; exact SemEq.refl ρ _
  | symm _ ih => intro ρ; exact (ih ρ).symm
  | trans _ _ ih₁ ih₂ => intro ρ; exact (ih₁ ρ).trans (ih₂ ρ)
  | pi _ _ ih₁ ih₂ => intro ρ; exact semEq_pi (ih₁ ρ) (fun S => ih₂ (Env.cons S ρ))
  | lam _ _ _ ih₂ => intro ρ; exact semEq_lam (fun S => ih₂ (Env.cons S ρ))
  | app _ _ ih₁ ih₂ => intro ρ; exact semEq_app (ih₁ ρ) (ih₂ ρ)
  | letE _ _ _ _ ihv ihb => intro ρ; exact semEq_letE (ihv ρ) (fun S => ihb (Env.cons S ρ))
  | @lit _ t _ _ hl _ =>
      intro ρ
      cases hl
      exact semEq_lit ρ t
  | tyConv _ ih => intro ρ; exact ih ρ
  | sorts => intro ρ; exact semEq_sorts ρ _ _
  | consts => intro ρ; exact semEq_consts ρ _ _ _

/-- Family-spine injectivity for conversions in `FamCongrFrag`. -/
theorem famCongrFrag_famApp_semInj {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamCongrFrag E n h) (ρ : Env) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEq ρ x x' :=
  semEq_famApp_inj (semEq_of_famCongrFrag hh ρ)

/-- The β/ζ-extended conversion fragment (`FamCongrFrag` + `ConvT.beta` + `ConvT.zeta`). -/
inductive FamBetaZetaFrag (E : ResolvedEnv) (n : Nat) :
    {Γ : LCtx} → {a b T : Expr Nat} → ConvT E n Γ a b T → Prop
  | ofCongr {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
      (hh : FamCongrFrag E n h) : FamBetaZetaFrag E n h
  | symm {Γ : LCtx} {a b A : Expr Nat} {h : ConvT E n Γ a b A}
      (hh : FamBetaZetaFrag E n h) : FamBetaZetaFrag E n (ConvT.symm Γ a b A h)
  | trans {Γ : LCtx} {a b c A : Expr Nat} {h₁ : ConvT E n Γ a b A} {h₂ : ConvT E n Γ b c A}
      (hh₁ : FamBetaZetaFrag E n h₁) (hh₂ : FamBetaZetaFrag E n h₂) :
      FamBetaZetaFrag E n (ConvT.trans Γ a b c A h₁ h₂)
  | pi {Γ : LCtx} {A A' B B' : Expr Nat} {u v : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) B B' (.sort v)}
      (hh₁ : FamBetaZetaFrag E n h₁) (hh₂ : FamBetaZetaFrag E n h₂) :
      FamBetaZetaFrag E n (ConvT.pi Γ A A' B B' u v h₁ h₂)
  | lam {Γ : LCtx} {A A' b b' B : Expr Nat} {u : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) b b' B}
      (hh₁ : FamBetaZetaFrag E n h₁) (hh₂ : FamBetaZetaFrag E n h₂) :
      FamBetaZetaFrag E n (ConvT.lam Γ A A' b b' B u h₁ h₂)
  | app {Γ : LCtx} {f g a b A B : Expr Nat} {h₁ : ConvT E n Γ f g (.pi A B)}
      {h₂ : ConvT E n Γ a b A} (hh₁ : FamBetaZetaFrag E n h₁) (hh₂ : FamBetaZetaFrag E n h₂) :
      FamBetaZetaFrag E n (ConvT.app Γ f g a b A B h₁ h₂)
  | letE {Γ : LCtx} {A A' v v' b b' B : Expr Nat} {u : Level}
      {hA : ConvT E n Γ A A' (.sort u)} {hv : ConvT E n Γ v v' A}
      {hb : ConvT E n (.letBinding A v :: Γ) b b' B}
      (hhA : FamBetaZetaFrag E n hA) (hhv : FamBetaZetaFrag E n hv)
      (hhb : FamBetaZetaFrag E n hb) :
      FamBetaZetaFrag E n (ConvT.letE Γ A A' v v' b b' B u hA hv hb)
  | beta {Γ : LCtx} {A body arg B : Expr Nat} {u : Level}
      {hA : HasTyT E n Γ A (.sort u)} {hbody : HasTyT E n (.assumption A :: Γ) body B}
      {harg : HasTyT E n Γ arg A} :
      FamBetaZetaFrag E n (ConvT.beta Γ A body arg B u hA hbody harg)
  | zeta {Γ : LCtx} {A v body B : Expr Nat} {u : Level}
      {hA : HasTyT E n Γ A (.sort u)} {hv : HasTyT E n Γ v A}
      {hbody : HasTyT E n (.letBinding A v :: Γ) body B} :
      FamBetaZetaFrag E n (ConvT.zeta Γ A v body B u hA hv hbody)
  | tyConv {Γ : LCtx} {a b A A' : Expr Nat} {u : Level} {h : ConvT E n Γ a b A}
      {hA : ConvT E n Γ A A' (.sort u)} (hh : FamBetaZetaFrag E n h) :
      FamBetaZetaFrag E n (ConvT.tyConv Γ a b A A' u h hA)

/-- Inversion of `Approx` at `.bvar i`. -/
theorem approx_bvar_inv {ρ : Env} {i : Nat} {c : Cpt}
    (h : Approx ρ (.bvar i) c) :
    c = .bot ∨ c = .lam [] ∨ ρ i c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | bvar hρ => exact Or.inr (Or.inr hρ)

theorem approx_bvar_iff (ρ : Env) (i : Nat) (c : Cpt) :
    Approx ρ (.bvar i) c ↔ c = .bot ∨ c = .lam [] ∨ ρ i c := by
  refine ⟨approx_bvar_inv, ?_⟩
  rintro (rfl | rfl | hρ)
  · exact .bot ρ (.bvar i)
  · exact .lamNil ρ (.bvar i)
  · exact .bvar hρ

theorem approx_sort_iff (ρ : Env) (l : Level) (c : Cpt) :
    Approx ρ (.sort l) c ↔ c = .bot ∨ c = .lam [] ∨ c = .sort := by
  refine ⟨approx_sort_inv, ?_⟩
  rintro (rfl | rfl | rfl)
  · exact .bot ρ (.sort l)
  · exact .lamNil ρ (.sort l)
  · exact .sort ρ l

theorem approx_const_iff (ρ : Env) (r : Nat) (ls : List Level) (c : Cpt) :
    Approx ρ (.const r ls) c ↔ c = .bot ∨ c = .lam [] ∨ c = .spine r [] := by
  refine ⟨approx_const_inv, ?_⟩
  rintro (rfl | rfl | rfl)
  · exact .bot ρ (.const r ls)
  · exact .lamNil ρ (.const r ls)
  · exact .const ρ r ls

/-- Two-environment relational congruence for `Approx` at `.pi`. -/
theorem approx_pi_rel {ρ₁ ρ₂ : Env} {A₁ B₁ A₂ B₂ : Expr Nat}
    (hA : ∀ c, Approx ρ₁ A₁ c ↔ Approx ρ₂ A₂ c)
    (hB : ∀ (S : Cpt → Prop) c, Approx (Env.cons S ρ₁) B₁ c ↔ Approx (Env.cons S ρ₂) B₂ c)
    (c : Cpt) :
    Approx ρ₁ (.pi A₁ B₁) c ↔ Approx ρ₂ (.pi A₂ B₂) c := by
  constructor
  · intro h
    rcases approx_pi_inv h with rfl | rfl | ⟨a, f, rfl, hAa, hBf⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .pi ((hA a).mp hAa) (fun p hp => (hB (Cpt.down p.1) p.2).mp (hBf p hp))
  · intro h
    rcases approx_pi_inv h with rfl | rfl | ⟨a, f, rfl, hAa, hBf⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .pi ((hA a).mpr hAa) (fun p hp => (hB (Cpt.down p.1) p.2).mpr (hBf p hp))

/-- Two-environment relational congruence for `Approx` at `.lam`. -/
theorem approx_lam_rel {ρ₁ ρ₂ : Env} {A₁ b₁ A₂ b₂ : Expr Nat}
    (hb : ∀ (S : Cpt → Prop) c, Approx (Env.cons S ρ₁) b₁ c ↔ Approx (Env.cons S ρ₂) b₂ c)
    (c : Cpt) :
    Approx ρ₁ (.lam A₁ b₁) c ↔ Approx ρ₂ (.lam A₂ b₂) c := by
  constructor
  · intro h
    rcases approx_lam_inv h with rfl | ⟨f, rfl, hbf⟩
    · exact .bot _ _
    · exact .lam (fun p hp => (hb (Cpt.down p.1) p.2).mp (hbf p hp))
  · intro h
    rcases approx_lam_inv h with rfl | ⟨f, rfl, hbf⟩
    · exact .bot _ _
    · exact .lam (fun p hp => (hb (Cpt.down p.1) p.2).mpr (hbf p hp))

/-- Two-environment relational congruence for `Approx` at `.app`. -/
theorem approx_app_rel {ρ₁ ρ₂ : Env} {f₁ a₁ f₂ a₂ : Expr Nat}
    (hf : ∀ c, Approx ρ₁ f₁ c ↔ Approx ρ₂ f₂ c)
    (ha : ∀ c, Approx ρ₁ a₁ c ↔ Approx ρ₂ a₂ c)
    (c : Cpt) :
    Approx ρ₁ (.app f₁ a₁) c ↔ Approx ρ₂ (.app f₂ a₂) c := by
  constructor
  · intro h
    rcases approx_app_inv h with rfl | rfl | ⟨g, p, rfl, hfg, hp, ha₁⟩ | ⟨r, args, u, rfl, hfs, hau⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .app ((hf (.lam g)).mp hfg) hp ((ha p.1).mp ha₁)
    · exact .appSpine ((hf (.spine r args)).mp hfs) ((ha u).mp hau)
  · intro h
    rcases approx_app_inv h with rfl | rfl | ⟨g, p, rfl, hfg, hp, ha₂⟩ | ⟨r, args, u, rfl, hfs, hau⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .app ((hf (.lam g)).mpr hfg) hp ((ha p.1).mpr ha₂)
    · exact .appSpine ((hf (.spine r args)).mpr hfs) ((ha u).mpr hau)

/-- Two-environment relational congruence for `Approx` at `.letE`. -/
theorem approx_letE_rel {ρ₁ ρ₂ : Env} {A₁ v₁ b₁ A₂ v₂ b₂ : Expr Nat}
    (hv : ∀ c, Approx ρ₁ v₁ c ↔ Approx ρ₂ v₂ c)
    (hb : ∀ (S : Cpt → Prop) c, Approx (Env.cons S ρ₁) b₁ c ↔ Approx (Env.cons S ρ₂) b₂ c)
    (c : Cpt) :
    Approx ρ₁ (.letE A₁ v₁ b₁) c ↔ Approx ρ₂ (.letE A₂ v₂ b₂) c :=
  (semEq_letE_betaRedex ρ₁ A₁ v₁ b₁ c).trans
    ((approx_app_rel (approx_lam_rel (A₁ := A₁) (A₂ := A₂) hb) hv c).trans
      (semEq_letE_betaRedex ρ₂ A₂ v₂ b₂ c).symm)

/-- `natExpand t` has environment-independent `Approx` denotation. -/
theorem approx_natExpand_rel (ρ₁ ρ₂ : Env) :
    ∀ (t : Nat) (c : Cpt), Approx ρ₁ (natExpand t) c ↔ Approx ρ₂ (natExpand t) c
  | 0, c => by
      simp only [natExpand, litZero]
      rw [approx_const_iff, approx_const_iff]
  | n + 1, c => by
      simp only [natExpand, litSucc]
      exact approx_app_rel
        (fun d => by rw [approx_const_iff, approx_const_iff])
        (approx_natExpand_rel ρ₁ ρ₂ n) c

/-- `.lit t` has environment-independent `Approx` denotation. -/
theorem approx_lit_rel (ρ₁ ρ₂ : Env) (t : Nat) (c : Cpt) :
    Approx ρ₁ (.lit t) c ↔ Approx ρ₂ (.lit t) c :=
  (semEq_lit ρ₁ t c).trans
    ((approx_natExpand_rel ρ₁ ρ₂ t c).trans (semEq_lit ρ₂ t c).symm)

/-- Insert an ideal `S` at de Bruijn depth `k` into `ρ`. -/
def Env.insertAt : Nat → (Cpt → Prop) → Env → Env
  | 0, S, ρ => Env.cons S ρ
  | k + 1, S, ρ => Env.cons (ρ 0) (Env.insertAt k S (fun i => ρ (i + 1)))

theorem Env.insertAt_eq :
    ∀ (k : Nat) (S : Cpt → Prop) (ρ : Env) (c : Cpt),
      Env.insertAt k S ρ k c ↔ S c
  | 0, _, _, _ => Iff.rfl
  | k + 1, S, ρ, c => Env.insertAt_eq k S (fun i => ρ (i + 1)) c

theorem Env.insertAt_lt :
    ∀ {k i : Nat}, i < k → ∀ (S : Cpt → Prop) (ρ : Env) (c : Cpt),
      Env.insertAt k S ρ i c ↔ ρ i c
  | 0, _, h, _, _, _ => nomatch h
  | _ + 1, 0, _, _, _, _ => Iff.rfl
  | _ + 1, _ + 1, h, S, ρ, c =>
      Env.insertAt_lt (Nat.lt_of_succ_lt_succ h) S (fun j => ρ (j + 1)) c

theorem Env.insertAt_succ_ge :
    ∀ {k i : Nat}, k ≤ i → ∀ (S : Cpt → Prop) (ρ : Env) (c : Cpt),
      Env.insertAt k S ρ (i + 1) c ↔ ρ i c
  | 0, _, _, _, _, _ => Iff.rfl
  | _ + 1, 0, h, _, _, _ => nomatch h
  | _ + 1, _ + 1, h, S, ρ, c =>
      Env.insertAt_succ_ge (Nat.le_of_succ_le_succ h) S (fun j => ρ (j + 1)) c

theorem Env.insertAt_mono :
    ∀ (k : Nat) {S S' : Cpt → Prop} (_ : ∀ c, S c → S' c) (ρ : Env),
      EnvLe (Env.insertAt k S ρ) (Env.insertAt k S' ρ)
  | 0, _, _, hS, ρ => EnvLe.cons_mono hS (EnvLe.refl ρ)
  | k + 1, _, _, hS, ρ =>
      EnvLe.cons_mono (fun _ h => h) (Env.insertAt_mono k hS (fun i => ρ (i + 1)))

/-- Lifting / weakening lemma for `Approx`: `lift k 1 e` in `Env.insertAt k S ρ` has the
    exact same compact approximations as `e` in `ρ`. -/
theorem approx_lift :
    ∀ (e : Expr Nat) (k : Nat) (S : Cpt → Prop) (ρ : Env) (c : Cpt),
      Approx (Env.insertAt k S ρ) (lift k 1 e) c ↔ Approx ρ e c
  | .bvar i, k, S, ρ, c => by
      simp only [lift]
      by_cases h : k ≤ i
      · rw [if_pos h, approx_bvar_iff, approx_bvar_iff, Env.insertAt_succ_ge h]
      · rw [if_neg h, approx_bvar_iff, approx_bvar_iff,
          Env.insertAt_lt (Nat.lt_of_not_le h)]
  | .sort _, _, _, _, c => by
      simp only [lift]
      rw [approx_sort_iff, approx_sort_iff]
  | .const _ _, _, _, _, c => by
      simp only [lift]
      rw [approx_const_iff, approx_const_iff]
  | .app f x, k, S, ρ, c => by
      simp only [lift]
      exact approx_app_rel (approx_lift f k S ρ) (approx_lift x k S ρ) c
  | .lam _ b, k, S, ρ, c => by
      simp only [lift]
      refine approx_lam_rel (fun T d => ?_) c
      exact approx_lift b (k + 1) S (Env.cons T ρ) d
  | .pi A B, k, S, ρ, c => by
      simp only [lift]
      refine approx_pi_rel (approx_lift A k S ρ) (fun T d => ?_) c
      exact approx_lift B (k + 1) S (Env.cons T ρ) d
  | .letE _ v b, k, S, ρ, c => by
      simp only [lift]
      refine approx_letE_rel (approx_lift v k S ρ) (fun T d => ?_) c
      exact approx_lift b (k + 1) S (Env.cons T ρ) d
  | .lit t, k, S, ρ, c => by
      simp only [lift]
      exact approx_lit_rel (Env.insertAt k S ρ) ρ t c

/-- Top-binder lifting lemma for `Approx`. -/
theorem approx_lift0 (S : Cpt → Prop) (ρ : Env) (a : Expr Nat) (c : Cpt) :
    Approx (Env.cons S ρ) (lift 0 1 a) c ↔ Approx ρ a c :=
  approx_lift a 0 S ρ c

/-- General index substitution lemma for `Approx`: `instantiate k a e` in `ρ` has the exact
    same compact approximations as `e` in `Env.insertAt k (fun u => Approx ρ a u) ρ`. -/
theorem approx_instantiate :
    ∀ (e : Expr Nat) (k : Nat) (a : Expr Nat) (ρ : Env) (c : Cpt),
      Approx ρ (instantiate k a e) c ↔
        Approx (Env.insertAt k (fun u => Approx ρ a u) ρ) e c
  | .bvar i, k, a, ρ, c => by
      simp only [instantiate]
      by_cases hik : i = k
      · subst hik
        rw [if_pos rfl, approx_bvar_iff, Env.insertAt_eq]
        refine ⟨fun h => Or.inr (Or.inr h), ?_⟩
        rintro (rfl | rfl | h)
        · exact .bot ρ a
        · exact .lamNil ρ a
        · exact h
      · rw [if_neg hik]
        by_cases hlt : k < i
        · cases i with
          | zero => exact nomatch hlt
          | succ j =>
              rw [if_pos hlt]
              simp only [Nat.succ_sub_succ_eq_sub, Nat.sub_zero]
              rw [approx_bvar_iff, approx_bvar_iff,
                Env.insertAt_succ_ge (Nat.le_of_lt_succ hlt)]
        · rw [if_neg hlt, approx_bvar_iff, approx_bvar_iff]
          have hlt' : i < k := Nat.lt_of_le_of_ne (Nat.le_of_not_lt hlt) hik
          rw [Env.insertAt_lt hlt']
  | .sort l, _, _, _, c => by
      simp only [instantiate]
      rw [approx_sort_iff, approx_sort_iff]
  | .const r ls, _, _, _, c => by
      simp only [instantiate]
      rw [approx_const_iff, approx_const_iff]
  | .app f x, k, a, ρ, c => by
      simp only [instantiate]
      exact approx_app_rel (approx_instantiate f k a ρ) (approx_instantiate x k a ρ) c
  | .lam _ b, k, a, ρ, c => by
      simp only [instantiate]
      refine approx_lam_rel (fun T d => ?_) c
      refine (approx_instantiate b (k + 1) (lift 0 1 a) (Env.cons T ρ) d).trans ?_
      exact ⟨fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
        (fun u hu => (approx_lift0 T ρ a u).mp hu) ρ) T),
        fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
          (fun u hu => (approx_lift0 T ρ a u).mpr hu) ρ) T)⟩
  | .pi A B, k, a, ρ, c => by
      simp only [instantiate]
      refine approx_pi_rel (approx_instantiate A k a ρ) (fun T d => ?_) c
      refine (approx_instantiate B (k + 1) (lift 0 1 a) (Env.cons T ρ) d).trans ?_
      exact ⟨fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
        (fun u hu => (approx_lift0 T ρ a u).mp hu) ρ) T),
        fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
          (fun u hu => (approx_lift0 T ρ a u).mpr hu) ρ) T)⟩
  | .letE _ v b, k, a, ρ, c => by
      simp only [instantiate]
      refine approx_letE_rel (approx_instantiate v k a ρ) (fun T d => ?_) c
      refine (approx_instantiate b (k + 1) (lift 0 1 a) (Env.cons T ρ) d).trans ?_
      exact ⟨fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
        (fun u hu => (approx_lift0 T ρ a u).mp hu) ρ) T),
        fun h => approx_mono h (EnvLe.cons (Env.insertAt_mono k
          (fun u hu => (approx_lift0 T ρ a u).mpr hu) ρ) T)⟩
  | .lit t, k, a, ρ, c => by
      simp only [instantiate]
      exact approx_lit_rel ρ (Env.insertAt k (fun u => Approx ρ a u) ρ) t c

/-- **L2 Substitution Theorem (`ApproxSubst` of `RcicNativePiModel`):**
    Discharges `ApproxSubst` unconditionally for `Approx`. -/
theorem approx_subst : ApproxSubst :=
  fun ρ a b c => approx_instantiate b 0 a ρ c

/-! #### Refutation of Singleton Compactness (`not_approxCompact`) and `TypedSoundnessAtBot` (`not_typedSoundnessAtBot`) in `Approx`

Because `RcicNativePiModel.Cpt.down u := fun c => c = u` (`RcicNativePiModel.lean:82`) binds a
variable to a single compact `u`, any body in which binder `0` occurs twice can demand two
distinct compacts `smallCpt ≠ largeCpt` simultaneously from the argument ideal
`fun u => Approx ρ twoOccArg u`. This refutes both `ApproxCompact` (`not_approxCompact`) and
`TypedSoundnessAtBot E n` at every environment `E` and universe bound `n`
(`not_typedSoundnessAtBot`, generalizing #7619). -/

/-- Single-element compactness of `Approx` at binder 0 (refuted below by `not_approxCompact`). -/
def ApproxCompact : Prop :=
  ∀ (ρ : Env) (S : Cpt → Prop) (b : Expr Nat) (c : Cpt),
    Approx (Env.cons S ρ) b c →
      c = .bot ∨ c = .lam [] ∨ ∃ u, S u ∧ Approx (Env.cons (Cpt.down u) ρ) b c

/-- First compact probe of `twoOccArg = .pi (.sort .zero) (.sort .zero)` in `Cpt`. -/
def smallCpt : Cpt := .pi .bot []

/-- Second compact probe of `twoOccArg = .pi (.sort .zero) (.sort .zero)` in `Cpt`. -/
def largeCpt : Cpt := .pi .sort []

/-- Separating probe for `twoOccBody = .pi (.bvar 0) (.bvar 1)` in `Cpt`. -/
def probeCpt : Cpt := .pi smallCpt [(.bot, largeCpt)]

/-- Sort level `imax 1 1` of `twoOccArg = .pi (.sort .zero) (.sort .zero)`. -/
def twoOccLevel : Level := .imax (.succ .zero) (.succ .zero)

/-- Closed argument `Π (_ : Sort 0), Sort 0` admitting both `smallCpt` and `largeCpt`. -/
def twoOccArg : Expr Nat := .pi (.sort .zero) (.sort .zero)

/-- Body `Π (_ : x), x` in which binder `0` (`x`) occurs in both domain and codomain. -/
def twoOccBody : Expr Nat := .pi (.bvar 0) (.bvar 1)

theorem smallCpt_ne_largeCpt : smallCpt ≠ largeCpt := by
  intro h
  injection h with h1 _
  exact Cpt.noConfusion h1

theorem approx_twoOccArg_small (ρ : Env) : Approx ρ twoOccArg smallCpt :=
  .pi (.bot ρ (.sort .zero)) (fun _ hp => nomatch hp)

theorem approx_twoOccArg_large (ρ : Env) : Approx ρ twoOccArg largeCpt :=
  .pi (.sort ρ .zero) (fun _ hp => nomatch hp)

theorem approx_twoOccBody_substEnv (ρ : Env) :
    Approx (Env.cons (fun u => Approx ρ twoOccArg u) ρ) twoOccBody probeCpt := by
  refine .pi (.bvar (approx_twoOccArg_small ρ)) (fun p hp => ?_)
  have hp' := List.mem_singleton.mp hp
  subst hp'
  exact .bvar (approx_twoOccArg_large ρ)

theorem not_approx_twoOccBody_singleton (u : Cpt) :
    ¬ Approx (Env.cons (Cpt.down u) Env.bot) twoOccBody probeCpt := by
  intro h
  rcases approx_pi_inv h with hbot | hnil | ⟨a, f, heq, hdom, hcod⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · injection heq with ha hf
    subst ha; subst hf
    rcases approx_bvar_inv hdom with h0 | h0 | hu1
    · exact nomatch h0
    · exact nomatch h0
    · have hb := hcod (.bot, largeCpt) (List.mem_singleton.mpr rfl)
      rcases approx_bvar_inv hb with h0 | h0 | hu2
      · exact nomatch h0
      · exact nomatch h0
      · change smallCpt = u at hu1
        change largeCpt = u at hu2
        exact smallCpt_ne_largeCpt (hu1.trans hu2.symm)

/-- **Refutation of `ApproxCompact` in `RcicNativePiModel.Approx`:**
    `twoOccBody` in `Env.cons (fun u => Approx Env.bot twoOccArg u) Env.bot` approximates
    `probeCpt`, but no single compact `u` via `Cpt.down u` can witness it. -/
theorem not_approxCompact : ¬ ApproxCompact := by
  intro hcomp
  rcases hcomp Env.bot (fun u => Approx Env.bot twoOccArg u) twoOccBody probeCpt
    (approx_twoOccBody_substEnv Env.bot) with hbot | hnil | ⟨u, _, hu⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · exact not_approx_twoOccBody_singleton u hu

theorem not_approx_twoOccBetaSource (u : Level) :
    ¬ Approx Env.bot (.app (.lam (.sort u) twoOccBody) twoOccArg) probeCpt := by
  intro h
  rcases approx_app_inv h with hbot | hnil | ⟨g, p, heq_p, hlam, hp, _⟩ | ⟨_, _, _, hsp, _, _⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · rcases approx_lam_inv hlam with hbot | ⟨f, heq, hb⟩
    · exact nomatch hbot
    · injection heq with hgf
      subst hgf
      have hbp := hb p hp
      rw [← heq_p] at hbp
      exact not_approx_twoOccBody_singleton p.1 hbp
  · exact nomatch hsp

theorem approx_twoOccBetaTarget :
    Approx Env.bot (instantiate0 twoOccArg twoOccBody) probeCpt :=
  (approx_subst Env.bot twoOccArg twoOccBody probeCpt).mpr (approx_twoOccBody_substEnv Env.bot)

def hasTyT_twoOccArg (E : ResolvedEnv) (n : Nat) (Γ : LCtx) :
    HasTyT E n Γ twoOccArg (.sort twoOccLevel) :=
  .pi Γ (.sort .zero) (.succ .zero) (.sort .zero) (.succ .zero)
    (.sort Γ .zero) (.sort (.assumption (.sort .zero) :: Γ) .zero)

noncomputable
def hasTyT_twoOccBody (E : ResolvedEnv) (n : Nat) :
    HasTyT E n [.assumption (.sort twoOccLevel)] twoOccBody
      (.sort (.imax twoOccLevel twoOccLevel)) :=
  .pi [.assumption (.sort twoOccLevel)] (.bvar 0) twoOccLevel (.bvar 1) twoOccLevel
    (.bvar [.assumption (.sort twoOccLevel)] 0 (.sort twoOccLevel) rfl)
    (.bvar [.assumption (.bvar 0), .assumption (.sort twoOccLevel)] 1 (.sort twoOccLevel) rfl)

noncomputable
def convT_twoOccBeta (E : ResolvedEnv) (n : Nat) :
    ConvT E n [] (.app (.lam (.sort twoOccLevel) twoOccBody) twoOccArg)
      (instantiate0 twoOccArg twoOccBody) (.sort (.imax twoOccLevel twoOccLevel)) :=
  .beta [] (.sort twoOccLevel) twoOccBody twoOccArg
    (.sort (.imax twoOccLevel twoOccLevel)) (.succ twoOccLevel)
    (.sort [] twoOccLevel) (hasTyT_twoOccBody E n) (hasTyT_twoOccArg E n [])

/-- **Universal refutation of `TypedSoundnessAtBot E n` for singleton `Approx`:**
    At every environment `E` and universe bound `n`, `convT_twoOccBeta E n` is a valid
    `ConvT.beta` step at a sort in `CtxWfT.nil`, yet `probeCpt` approximates the contractum
    and not the redex at `Env.bot`. -/
theorem not_typedSoundnessAtBot (E : ResolvedEnv) (n : Nat) :
    ¬ TypedSoundnessAtBot E n :=
  fun hsound =>
    not_approx_twoOccBetaSource twoOccLevel
      ((hsound CtxWfT.nil (convT_twoOccBeta E n) probeCpt).mpr approx_twoOccBetaTarget)


/-! ### §3 — Stored-telescope `isArity` decomposition (reusing landed `piDomsOf`/`piTailOf`/`piResult`) and scoped `FamAppSaturation` -/

/-- `piTailOf` (`RcicIotaShapeAdapter`) and `piResult` (`RcicFamRef`) coincide on all expressions. -/
theorem piTailOf_eq_piResult : ∀ (t : Expr Nat), piTailOf t = piResult t
  | .pi _ B => piTailOf_eq_piResult B
  | .bvar _ | .sort _ | .const _ _ | .app _ _ | .lam _ _ | .letE _ _ _ | .lit _ => rfl

/-- `piBody` (`RcicParRedT`) and `piResult` (`RcicFamRef`) coincide on all expressions. -/
theorem piBody_eq_piResult : ∀ (t : Expr Nat), piBody t = piResult t
  | .pi _ B => piBody_eq_piResult B
  | .bvar _ | .sort _ | .const _ _ | .app _ _ | .lam _ _ | .letE _ _ _ | .lit _ => rfl

/-- `piResult` of a `policyPi` telescope over `.sort u` is `.sort u`. -/
theorem piResult_policyPi_sort :
    ∀ (ds : List (Expr Nat)) (u : Level), piResult (policyPi ds (.sort u)) = .sort u
  | [], _ => rfl
  | _ :: ds, u => piResult_policyPi_sort ds u

/-- `piBody` of a `policyPi` telescope over `.sort u` is `.sort u`. -/
theorem piBody_policyPi_sort :
    ∀ (ds : List (Expr Nat)) (u : Level), piBody (policyPi ds (.sort u)) = .sort u
  | [], _ => rfl
  | _ :: ds, u => piBody_policyPi_sort ds u

/-- `piDomsOf` of a `policyPi` telescope over `.sort u` recovers the domain list `ds`. -/
theorem piDomsOf_policyPi_sort :
    ∀ (ds : List (Expr Nat)) (u : Level), piDomsOf (policyPi ds (.sort u)) = ds
  | [], _ => rfl
  | d :: ds, u => congrArg (d :: ·) (piDomsOf_policyPi_sort ds u)

/-- Terminal sort level of an admitted `.inductiveM` member's stored type `m.mtype` under `EnvWfT E`,
    extracted via `main`'s landed `isArity_piResult_sort` (`RcicArity`) and
    `familyArity_of_envWfT` (`RcicNativeFamilyProjection`). -/
noncomputable def inductiveSortLevel {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    Level :=
  (isArity_piResult_sort m.mtype (NativeFamilyProjection.familyArity_of_envWfT hW r m hm hind)).1

/-- For an admitted `.inductiveM` member under `EnvWfT E`,
    `piResult m.mtype = .sort (inductiveSortLevel hW hm hind)`. -/
theorem piResult_mtype_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    piResult m.mtype = .sort (inductiveSortLevel hW hm hind) :=
  (isArity_piResult_sort m.mtype (NativeFamilyProjection.familyArity_of_envWfT hW r m hm hind)).2

/-- For an admitted `.inductiveM` member under `EnvWfT E`,
    `piBody m.mtype = .sort (inductiveSortLevel hW hm hind)`. -/
theorem piBody_mtype_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    piBody m.mtype = .sort (inductiveSortLevel hW hm hind) :=
  (piBody_eq_piResult m.mtype).trans (piResult_mtype_of_inductiveM hW hm hind)

/-- For an admitted `.inductiveM` member under `EnvWfT E`, its stored type `m.mtype` decomposes
    canonically as `policyPi (piDomsOf m.mtype) (.sort (inductiveSortLevel hW hm hind))` via
    landed `policyPi_piDomsOf_piTailOf` (`RcicIATypedMinor`) and `isArity_piResult_sort` (`RcicArity`). -/
theorem mtype_policyPi_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM) :
    m.mtype = policyPi (piDomsOf m.mtype) (.sort (inductiveSortLevel hW hm hind)) := by
  have h1 := (policyPi_piDomsOf_piTailOf m.mtype).symm
  rw [piTailOf_eq_piResult, piResult_mtype_of_inductiveM hW hm hind] at h1
  exact h1

/-- Level-instantiated stored type of an admitted inductive family as a `policyPi` telescope over
    `(piDomsOf m.mtype).map (instantiateLevels ls)` (reusing landed `instantiateLevels_policyPi`
    from `RcicIotaSRRowsTel`). -/
theorem instMtype_policyPi_of_inductiveM {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) :
    instantiateLevels ls m.mtype =
      policyPi ((piDomsOf m.mtype).map (instantiateLevels ls))
        (.sort (instLevel ls (inductiveSortLevel hW hm hind))) := by
  have hmtype := congrArg (instantiateLevels ls) (mtype_policyPi_of_inductiveM hW hm hind)
  rw [instantiateLevels_policyPi] at hmtype
  exact hmtype

/-- Construct `FamAppSaturation` (#7525) from `#7569` (`famApp_saturated_of_piRow_scoped`) and
    `instMtype_policyPi_of_inductiveM`. -/
noncomputable def famAppSaturation_of_scoped {Eₐ E : ResolvedEnv} {Aw : Nat → Nat} {tbl : List CRule}
    (hBel : AllBelowScoped Eₐ Aw tbl) (hTbl : TableWF tbl)
    {n : Nat} {Γ : LCtx} (S : ScopedCtx Eₐ E n Γ)
    (hprow : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FamAppSaturation E r m ls ls' xs xs' := by
  have htelL := instMtype_policyPi_of_inductiveM S.env hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM S.env hm hind ls'
  have ⟨_, htyR⟩ := tyConvT_rhsSort S.env S.ctx h ⟨w, hty⟩
  have hlenL := famApp_saturated_of_piRow_scoped hBel hTbl S hprow hm hind htelL hty
  have hlenR := famApp_saturated_of_piRow_scoped hBel hTbl S hprow hm hind htelR htyR
  exact {
    doms := (piDomsOf m.mtype).map (instantiateLevels ls)
    doms' := (piDomsOf m.mtype).map (instantiateLevels ls')
    U := .sort (instLevel ls (inductiveSortLevel S.env hm hind))
    U' := .sort (instLevel ls' (inductiveSortLevel S.env hm hind))
    telL := htelL
    telR := htelR
    eqN := heqN
    lenDD := by simp only [List.length_map]
    lenXD := hlenL.symm
    lenXD' := hlenR.symm
  }


/-! ### §4. Finitary step-function domain model (`CptFin` / `ApproxFin`): constructive compactness, substitution, context valuation `ctxEnvFin`, and unconditional 14-constructor soundness

In `RcicNativePiModel`, step-function entries `(u, d)` in `Cpt.lam` and `Cpt.pi` take a **single**
compact `u : Cpt` on the input side (`Cpt.down u := fun c => c = u`, `RcicNativePiModel.lean:82`).
When a bound variable occurs twice in a body (such as `twoOccBody := .pi (.bvar 0) (.bvar 1)`
applied to `twoOccArg := .pi (.sort .zero) (.sort .zero)`), the substituted term
`instantiate0 twoOccArg twoOccBody = .pi twoOccArg twoOccArg` can use two distinct compact
approximations `smallCpt ≠ largeCpt` of `twoOccArg` at the two occurrences, whereas a singleton
step-function input `Cpt.down u` can supply only one (`not_approxCompact`, `not_typedSoundnessAtBot`
of §2).

In Scott domain theory / Plotkin–Engeler algebra (arXiv 2607.13662 §2.1), a compact step function
has a **finite set (join) of compacts** `U : List CptFin` on the input side
(`CptFin.downList U := fun c => c = .bot ∨ c ∈ U`). Below we define `CptFin`, `ApproxFin`, and
`SemEqFin`, prove constructive finitary compactness (`approxFin_compact_at`, `approxFin_compact`),
lifting and substitution (`approxFin_lift`, `approxFin_instantiate`,
`approxFin_subst : ApproxFinSubst`), **unconditional** β and ζ soundness (`semEqFin_beta`,
`semEqFin_zeta`, `semEqFin_twoOcc_beta`), context-aware valuation `ctxEnvFin Γ` with
**unconditional** `ConvT.zetaLocal` soundness (`semEqFin_zetaLocal`), and **unconditional**
soundness and family/Π injectivity for the 14-constructor fragment `FamBetaZetaLocalFrag`. -/

/-- Compacts with finitary (multi-element) step-function inputs `List CptFin × CptFin`. -/
inductive CptFin : Type
  | bot : CptFin
  | sort : CptFin
  | pi : CptFin → List (List CptFin × CptFin) → CptFin
  | lam : List (List CptFin × CptFin) → CptFin
  | spine : Nat → List CptFin → CptFin

/-- The finitary ideal generated by a finite list of compacts `U : List CptFin` (plus `.bot`). -/
def CptFin.downList (U : List CptFin) : CptFin → Prop :=
  fun c => c = .bot ∨ c ∈ U

/-- Variable environments over `CptFin`. -/
def EnvFin : Type := Nat → CptFin → Prop

/-- Extend a `CptFin` environment at index `0`. -/
def EnvFin.cons (S : CptFin → Prop) (ρ : EnvFin) : EnvFin
  | 0 => S
  | i + 1 => ρ i

/-- The bottom `CptFin` environment. -/
def EnvFin.bot : EnvFin := fun _ c => c = .bot

/-- The finitary compact approximation relation (`ApproxFin ρ e c`). -/
inductive ApproxFin : EnvFin → Expr Nat → CptFin → Prop
  | bot (ρ : EnvFin) (e : Expr Nat) : ApproxFin ρ e .bot
  | lamNil (ρ : EnvFin) (e : Expr Nat) : ApproxFin ρ e (.lam [])
  | bvar {ρ : EnvFin} {i : Nat} {c : CptFin} (h : ρ i c) : ApproxFin ρ (.bvar i) c
  | sort (ρ : EnvFin) (l : Level) : ApproxFin ρ (.sort l) .sort
  | pi {ρ : EnvFin} {A B : Expr Nat} {a : CptFin} {f : List (List CptFin × CptFin)}
      (hA : ApproxFin ρ A a)
      (hB : ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1) ρ) B p.2) :
      ApproxFin ρ (.pi A B) (.pi a f)
  | lam {ρ : EnvFin} {A b : Expr Nat} {f : List (List CptFin × CptFin)}
      (hb : ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1) ρ) b p.2) :
      ApproxFin ρ (.lam A b) (.lam f)
  | app {ρ : EnvFin} {f a : Expr Nat} {U : List CptFin} {d : CptFin}
      (hf : ApproxFin ρ f (.lam [(U, d)]))
      (ha : ∀ u ∈ U, ApproxFin ρ a u) :
      ApproxFin ρ (.app f a) d
  | letE {ρ : EnvFin} {A v b : Expr Nat} {U : List CptFin} {d : CptFin}
      (hv : ∀ u ∈ U, ApproxFin ρ v u)
      (hb : ApproxFin (EnvFin.cons (CptFin.downList U) ρ) b d) :
      ApproxFin ρ (.letE A v b) d
  | const (ρ : EnvFin) (r : Nat) (ls : List Level) :
      ApproxFin ρ (.const r ls) (.spine r [])
  | appSpine {ρ : EnvFin} {f a : Expr Nat} {r : Nat} {args : List CptFin} {u : CptFin}
      (hf : ApproxFin ρ f (.spine r args)) (ha : ApproxFin ρ a u) :
      ApproxFin ρ (.app f a) (.spine r (args ++ [u]))
  | lit {ρ : EnvFin} {t : Nat} {c : CptFin}
      (h : ApproxFin ρ (natExpand t) c) : ApproxFin ρ (.lit t) c

/-- Semantic equality in the finitary compact model. -/
def SemEqFin (ρ : EnvFin) (a b : Expr Nat) : Prop :=
  ∀ c, ApproxFin ρ a c ↔ ApproxFin ρ b c

/-- Pointwise inclusion of `CptFin` environments. -/
def EnvFinLe (ρ ρ' : EnvFin) : Prop :=
  ∀ i c, ρ i c → ρ' i c

theorem EnvFinLe.refl (ρ : EnvFin) : EnvFinLe ρ ρ :=
  fun _ _ h => h

theorem EnvFinLe.cons {ρ ρ' : EnvFin} (S : CptFin → Prop) (h : EnvFinLe ρ ρ') :
    EnvFinLe (EnvFin.cons S ρ) (EnvFin.cons S ρ')
  | 0, _, hc => hc
  | i + 1, c, hc => h i c hc

theorem EnvFinLe.cons_mono {ρ ρ' : EnvFin} {S S' : CptFin → Prop}
    (hS : ∀ c, S c → S' c) (h : EnvFinLe ρ ρ') :
    EnvFinLe (EnvFin.cons S ρ) (EnvFin.cons S' ρ')
  | 0, c, hc => hS c hc
  | i + 1, c, hc => h i c hc

/-- Monotonicity of `ApproxFin` with respect to `EnvFinLe`. -/
theorem approxFin_mono {ρ : EnvFin} {e : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ e c) : ∀ {ρ' : EnvFin}, EnvFinLe ρ ρ' → ApproxFin ρ' e c := by
  induction h with
  | bot _ e => intro ρ' _; exact .bot ρ' e
  | lamNil _ e => intro ρ' _; exact .lamNil ρ' e
  | bvar hρ => intro ρ' hle; exact .bvar (hle _ _ hρ)
  | sort _ l => intro ρ' _; exact .sort ρ' l
  | pi _ _ ihA ihB =>
      intro ρ' hle
      exact .pi (ihA hle) (fun p hp => ihB p hp (EnvFinLe.cons _ hle))
  | lam _ ihb =>
      intro ρ' hle
      exact .lam (fun p hp => ihb p hp (EnvFinLe.cons _ hle))
  | app _ _ ihf iha =>
      intro ρ' hle
      exact .app (ihf hle) (fun u hu => iha u hu hle)
  | letE _ _ ihv ihb =>
      intro ρ' hle
      exact .letE (fun u hu => ihv u hu hle) (ihb (EnvFinLe.cons _ hle))
  | const _ r ls => intro ρ' _; exact .const ρ' r ls
  | appSpine _ _ ihf iha =>
      intro ρ' hle
      exact .appSpine (ihf hle) (iha hle)
  | lit _ ih =>
      intro ρ' hle
      exact .lit (ih hle)

/-- Inversion of `ApproxFin` at `.lam A b`. -/
theorem approxFin_lam_inv {ρ : EnvFin} {A b : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ (.lam A b) c) :
    c = .bot ∨ ∃ f, c = .lam f ∧
      ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1) ρ) b p.2 := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr ⟨[], rfl, fun _ hp => nomatch hp⟩
  | lam hb => exact Or.inr ⟨_, rfl, hb⟩

/-- Forward β-soundness in `ApproxFin`: every compact approximating `(.app (.lam A b) a)`
    approximates `b` in the environment extended by the full denotation of `a`. -/
theorem approxFin_beta_to_substEnv {ρ : EnvFin} {A b a : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ (.app (.lam A b) a) c) :
    ApproxFin (EnvFin.cons (fun d => ApproxFin ρ a d) ρ) b c := by
  cases h with
  | bot => exact .bot _ b
  | lamNil => exact .lamNil _ b
  | app hf ha =>
      rcases approxFin_lam_inv hf with hbot | ⟨f, heq, hb⟩
      · exact nomatch hbot
      · injection heq with hf_eq
        subst hf_eq
        have hb0 := hb (_, c) (List.mem_singleton.mpr rfl)
        refine approxFin_mono hb0 (EnvFinLe.cons_mono ?_ (EnvFinLe.refl ρ))
        intro d hd
        rcases hd with rfl | hmem
        · exact .bot ρ a
        · exact ha d hmem
  | appSpine hf _ =>
      rcases approxFin_lam_inv hf with hbot | ⟨_, heq, _⟩
      · exact nomatch hbot
      · exact nomatch heq

/-- In `ApproxFin`, `.letE A v b` and `.app (.lam A b) v` have the exact same denotation. -/
theorem semEqFin_letE_betaRedex (ρ : EnvFin) (A v b : Expr Nat) :
    SemEqFin ρ (.letE A v b) (.app (.lam A b) v) := by
  intro c
  constructor
  · intro h
    cases h with
    | bot => exact .bot ρ (.app (.lam A b) v)
    | lamNil => exact .lamNil ρ (.app (.lam A b) v)
    | letE hv hb =>
        refine .app (.lam (fun p hp => ?_)) hv
        have hp' : p = (_, c) := List.mem_singleton.mp hp
        subst hp'
        exact hb
  · intro h
    cases h with
    | bot => exact .bot ρ (.letE A v b)
    | lamNil => exact .lamNil ρ (.letE A v b)
    | app hf hv =>
        rcases approxFin_lam_inv hf with hbot | ⟨f, heq, hb⟩
        · exact nomatch hbot
        · injection heq with hf_eq
          subst hf_eq
          exact .letE hv (hb (_, c) (List.mem_singleton.mpr rfl))
    | appSpine hf _ =>
        rcases approxFin_lam_inv hf with hbot | ⟨_, heq, _⟩
        · exact nomatch hbot
        · exact nomatch heq

/-- Two-occurrence β-probe in `ApproxFin`:
    For `X = .pi (.sort .zero) (.sort .zero)` and `body = .pi (.bvar 0) (.bvar 1)`,
    the separating probe `.pi (.pi .bot []) [([], .pi .sort [])]` is approximated by BOTH
    the β-target `.pi X X` and the β-redex `.app (.lam (.sort u) body) X` (via the 2-element
    step-function input `[.pi .bot [], .pi .sort []]`). -/
def smallCptFin : CptFin := .pi .bot []

def largeCptFin : CptFin := .pi .sort []

def probeCptFin : CptFin := .pi smallCptFin [([], largeCptFin)]

theorem approxFin_twoOcc_arg_small (ρ : EnvFin) :
    ApproxFin ρ (.pi (.sort .zero) (.sort .zero)) smallCptFin :=
  .pi (.bot ρ (.sort .zero)) (fun _ h => nomatch h)

theorem approxFin_twoOcc_arg_large (ρ : EnvFin) :
    ApproxFin ρ (.pi (.sort .zero) (.sort .zero)) largeCptFin :=
  .pi (.sort ρ .zero) (fun _ h => nomatch h)

theorem approxFin_twoOcc_betaTarget_probe (ρ : EnvFin) :
    ApproxFin ρ (.pi (.pi (.sort .zero) (.sort .zero)) (.pi (.sort .zero) (.sort .zero)))
      probeCptFin := by
  refine .pi (approxFin_twoOcc_arg_small ρ) ?_
  intro p hp
  have hp' := List.mem_singleton.mp hp
  subst hp'
  exact approxFin_twoOcc_arg_large (EnvFin.cons (CptFin.downList []) ρ)

theorem approxFin_twoOcc_betaSource_probe (ρ : EnvFin) (u : Level) :
    ApproxFin ρ
      (.app (.lam (.sort u) (.pi (.bvar 0) (.bvar 1))) (.pi (.sort .zero) (.sort .zero)))
      probeCptFin := by
  refine .app (U := [smallCptFin, largeCptFin]) (.lam ?_) ?_
  · intro p hp
    have hp' := List.mem_singleton.mp hp
    subst hp'
    refine .pi (.bvar (Or.inr (List.mem_cons_self _ _))) ?_
    intro q hq
    have hq' := List.mem_singleton.mp hq
    subst hq'
    exact .bvar (Or.inr (List.mem_cons_of_mem _ (List.mem_singleton.mpr rfl)))
  · intro c hc
    rcases List.mem_cons.mp hc with rfl | hc'
    · exact approxFin_twoOcc_arg_small ρ
    · have hc'' := List.mem_singleton.mp hc'
      subst hc''
      exact approxFin_twoOcc_arg_large ρ


/-- Replace slot `k` of a `CptFin` environment `ρ` with `T`. -/
def EnvFin.update : Nat → (CptFin → Prop) → EnvFin → EnvFin
  | 0, T, ρ => EnvFin.cons T (fun i => ρ (i + 1))
  | k + 1, T, ρ => EnvFin.cons (ρ 0) (EnvFin.update k T (fun i => ρ (i + 1)))

theorem EnvFin.update_eq :
    ∀ (k : Nat) (T : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      EnvFin.update k T ρ k c ↔ T c
  | 0, _, _, _ => Iff.rfl
  | k + 1, T, ρ, c => EnvFin.update_eq k T (fun i => ρ (i + 1)) c

theorem EnvFin.update_ne :
    ∀ {k i : Nat}, i ≠ k → ∀ (T : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      EnvFin.update k T ρ i c ↔ ρ i c
  | 0, 0, h, _, _, _ => absurd rfl h
  | 0, _ + 1, _, _, _, _ => Iff.rfl
  | _ + 1, 0, _, _, _, _ => Iff.rfl
  | _ + 1, _ + 1, h, T, ρ, c =>
      EnvFin.update_ne (fun heq => h (congrArg Nat.succ heq)) T (fun j => ρ (j + 1)) c

theorem EnvFin.update_mono :
    ∀ (k : Nat) {U U' : List CptFin} (_ : ∀ u ∈ U, u ∈ U') (ρ : EnvFin),
      EnvFinLe (EnvFin.update k (CptFin.downList U) ρ)
        (EnvFin.update k (CptFin.downList U') ρ)
  | 0, _, _, hU, ρ =>
      EnvFinLe.cons_mono
        (fun _ hc => by
          rcases hc with rfl | hmem
          · exact Or.inl rfl
          · exact Or.inr (hU _ hmem))
        (EnvFinLe.refl (fun i => ρ (i + 1)))
  | k + 1, _, _, hU, ρ =>
      EnvFinLe.cons (ρ 0) (EnvFin.update_mono k hU (fun i => ρ (i + 1)))

/-- Constructive finite demand collection over a `List α` in `Prop` (no `Classical.choice`). -/
theorem exists_list_of_forall_mem {α : Type} {S : CptFin → Prop}
    {P : α → List CptFin → Prop}
    (hmono : ∀ (x : α) (U U' : List CptFin), (∀ u ∈ U, u ∈ U') → P x U → P x U') :
    ∀ {xs : List α},
      (∀ x ∈ xs, ∃ U : List CptFin, (∀ u ∈ U, S u) ∧ P x U) →
      ∃ U : List CptFin, (∀ u ∈ U, S u) ∧ ∀ x ∈ xs, P x U
  | [], _ => ⟨[], (fun _ h => nomatch h), (fun _ h => nomatch h)⟩
  | x :: xs, h => by
      obtain ⟨U₁, hS₁, hPx⟩ := h x (List.mem_cons_self _ _)
      obtain ⟨U₂, hS₂, hPxs⟩ := exists_list_of_forall_mem hmono
        (fun y hy => h y (List.mem_cons_of_mem _ hy))
      refine ⟨U₁ ++ U₂, ?_, ?_⟩
      · intro u hu
        rcases List.mem_append.mp hu with hu₁ | hu₂
        · exact hS₁ u hu₁
        · exact hS₂ u hu₂
      · intro y hy
        rcases List.mem_cons.mp hy with rfl | hy'
        · exact hmono y U₁ (U₁ ++ U₂) (fun u hu => List.mem_append.mpr (Or.inl hu)) hPx
        · exact hmono y U₂ (U₁ ++ U₂) (fun u hu => List.mem_append.mpr (Or.inr hu)) (hPxs y hy')

/-- **Finitary Compactness at Binder `k` (`approxFin_compact_at`):**
    Every derivation `ApproxFin ρ e c` uses at most a finite list `U : List CptFin` of compacts
    from `ρ k`, so `ApproxFin (EnvFin.update k (CptFin.downList U) ρ) e c`. -/
theorem approxFin_compact_at {ρ : EnvFin} {e : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ e c) :
    ∀ (k : Nat),
      ∃ U : List CptFin, (∀ u ∈ U, ρ k u) ∧
        ApproxFin (EnvFin.update k (CptFin.downList U) ρ) e c := by
  induction h with
  | bot _ e =>
      intro k
      exact ⟨[], (fun _ hu => nomatch hu), .bot _ e⟩
  | lamNil _ e =>
      intro k
      exact ⟨[], (fun _ hu => nomatch hu), .lamNil _ e⟩
  | @bvar ρ i c hρ =>
      intro k
      by_cases hik : i = k
      · subst hik
        refine ⟨[c], ?_, .bvar ((EnvFin.update_eq i (CptFin.downList [c]) ρ c).mpr
          (Or.inr (List.mem_singleton.mpr rfl)))⟩
        intro u hu
        have hu' := List.mem_singleton.mp hu
        subst hu'
        exact hρ
      · exact ⟨[], (fun _ hu => nomatch hu),
          .bvar ((EnvFin.update_ne hik (CptFin.downList []) ρ c).mpr hρ)⟩
  | sort _ l =>
      intro k
      exact ⟨[], (fun _ hu => nomatch hu), .sort _ l⟩
  | @pi ρ A B a f _ _ ihA ihB =>
      intro k
      obtain ⟨U₁, hS₁, hA'⟩ := ihA k
      have hcoll :
          ∃ U₂ : List CptFin, (∀ u ∈ U₂, ρ k u) ∧
            ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1)
              (EnvFin.update k (CptFin.downList U₂) ρ)) B p.2 :=
        exists_list_of_forall_mem (α := List CptFin × CptFin) (S := ρ k)
          (P := fun p U₂ => ApproxFin (EnvFin.cons (CptFin.downList p.1)
            (EnvFin.update k (CptFin.downList U₂) ρ)) B p.2)
          (fun p _ _ hsub hp =>
            approxFin_mono hp (EnvFinLe.cons (CptFin.downList p.1) (EnvFin.update_mono k hsub ρ)))
          (fun p hp => ihB p hp (k + 1))
      obtain ⟨U₂, hS₂, hB'⟩ := hcoll
      refine ⟨U₁ ++ U₂, ?_, .pi
        (approxFin_mono hA' (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inl hu)) ρ))
        (fun p hp => approxFin_mono (hB' p hp) (EnvFinLe.cons _
          (EnvFin.update_mono k (fun u hu => List.mem_append.mpr (Or.inr hu)) ρ)))⟩
      intro u hu
      rcases List.mem_append.mp hu with hu₁ | hu₂
      · exact hS₁ u hu₁
      · exact hS₂ u hu₂
  | @lam ρ A b f _ ihb =>
      intro k
      have hcoll :
          ∃ U : List CptFin, (∀ u ∈ U, ρ k u) ∧
            ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1)
              (EnvFin.update k (CptFin.downList U) ρ)) b p.2 :=
        exists_list_of_forall_mem (α := List CptFin × CptFin) (S := ρ k)
          (P := fun p U => ApproxFin (EnvFin.cons (CptFin.downList p.1)
            (EnvFin.update k (CptFin.downList U) ρ)) b p.2)
          (fun p _ _ hsub hp =>
            approxFin_mono hp (EnvFinLe.cons (CptFin.downList p.1) (EnvFin.update_mono k hsub ρ)))
          (fun p hp => ihb p hp (k + 1))
      obtain ⟨U, hS, hb'⟩ := hcoll
      exact ⟨U, hS, .lam hb'⟩
  | @app ρ f a V d _ _ ihf iha =>
      intro k
      obtain ⟨U₁, hS₁, hf'⟩ := ihf k
      have hcoll :
          ∃ U₂ : List CptFin, (∀ u ∈ U₂, ρ k u) ∧
            ∀ v ∈ V, ApproxFin (EnvFin.update k (CptFin.downList U₂) ρ) a v :=
        exists_list_of_forall_mem (S := ρ k)
          (P := fun v U₂ => ApproxFin (EnvFin.update k (CptFin.downList U₂) ρ) a v)
          (fun _ _ _ hsub hv => approxFin_mono hv (EnvFin.update_mono k hsub ρ))
          (fun v hv => iha v hv k)
      obtain ⟨U₂, hS₂, ha'⟩ := hcoll
      refine ⟨U₁ ++ U₂, ?_, .app
        (approxFin_mono hf' (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inl hu)) ρ))
        (fun v hv => approxFin_mono (ha' v hv) (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inr hu)) ρ))⟩
      intro u hu
      rcases List.mem_append.mp hu with hu₁ | hu₂
      · exact hS₁ u hu₁
      · exact hS₂ u hu₂
  | @letE ρ A v b V d _ _ ihv ihb =>
      intro k
      have hcoll :
          ∃ U₁ : List CptFin, (∀ u ∈ U₁, ρ k u) ∧
            ∀ w ∈ V, ApproxFin (EnvFin.update k (CptFin.downList U₁) ρ) v w :=
        exists_list_of_forall_mem (S := ρ k)
          (P := fun w U₁ => ApproxFin (EnvFin.update k (CptFin.downList U₁) ρ) v w)
          (fun _ _ _ hsub hw => approxFin_mono hw (EnvFin.update_mono k hsub ρ))
          (fun w hw => ihv w hw k)
      obtain ⟨U₁, hS₁, hv'⟩ := hcoll
      obtain ⟨U₂, hS₂, hb'⟩ := ihb (k + 1)
      refine ⟨U₁ ++ U₂, ?_, .letE
        (fun w hw => approxFin_mono (hv' w hw) (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inl hu)) ρ))
        (approxFin_mono hb' (EnvFinLe.cons _ (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inr hu)) ρ)))⟩
      intro u hu
      rcases List.mem_append.mp hu with hu₁ | hu₂
      · exact hS₁ u hu₁
      · exact hS₂ u hu₂
  | const _ r ls =>
      intro k
      exact ⟨[], (fun _ hu => nomatch hu), .const _ r ls⟩
  | appSpine _ _ ihf iha =>
      intro k
      obtain ⟨U₁, hS₁, hf'⟩ := ihf k
      obtain ⟨U₂, hS₂, ha'⟩ := iha k
      refine ⟨U₁ ++ U₂, ?_, .appSpine
        (approxFin_mono hf' (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inl hu)) _))
        (approxFin_mono ha' (EnvFin.update_mono k
          (fun u hu => List.mem_append.mpr (Or.inr hu)) _))⟩
      intro u hu
      rcases List.mem_append.mp hu with hu₁ | hu₂
      · exact hS₁ u hu₁
      · exact hS₂ u hu₂
  | lit _ ih =>
      intro k
      obtain ⟨U, hS, h'⟩ := ih k
      exact ⟨U, hS, .lit h'⟩

/-- **Finitary Compactness at Binder 0 (`approxFin_compact`):**
    Any approximation `ApproxFin (EnvFin.cons S ρ) b c` is witnessed by a finite list
    `U : List CptFin` of elements of `S` via `CptFin.downList U`. -/
theorem approxFin_compact {ρ : EnvFin} {S : CptFin → Prop} {b : Expr Nat} {c : CptFin}
    (h : ApproxFin (EnvFin.cons S ρ) b c) :
    ∃ U : List CptFin, (∀ u ∈ U, S u) ∧
      ApproxFin (EnvFin.cons (CptFin.downList U) ρ) b c :=
  approxFin_compact_at h 0

/-- **Unconditional Backward β-Approximation in `ApproxFin`:**
    Follows directly from `approxFin_compact` without any external compactness hypothesis. -/
theorem approxFin_beta_of_substEnv {ρ : EnvFin} (A : Expr Nat)
    {b a : Expr Nat} {c : CptFin}
    (h : ApproxFin (EnvFin.cons (fun u => ApproxFin ρ a u) ρ) b c) :
    ApproxFin ρ (.app (.lam A b) a) c := by
  obtain ⟨U, ha, hb⟩ := approxFin_compact h
  refine .app (U := U) (.lam (fun p hp => ?_)) ha
  have hp' := List.mem_singleton.mp hp
  subst hp'
  exact hb

/-- **Unconditional β-Redex Environment Equivalence in `ApproxFin`:**
    `ApproxFin ρ (.app (.lam A b) a) c ↔ ApproxFin (EnvFin.cons (fun u => ApproxFin ρ a u) ρ) b c`. -/
theorem approxFin_beta_iff_substEnv (ρ : EnvFin) (A b a : Expr Nat) (c : CptFin) :
    ApproxFin ρ (.app (.lam A b) a) c ↔
      ApproxFin (EnvFin.cons (fun u => ApproxFin ρ a u) ρ) b c :=
  ⟨approxFin_beta_to_substEnv, approxFin_beta_of_substEnv A⟩

/-- Inversion of `ApproxFin` at `.bvar i`. -/
theorem approxFin_bvar_inv {ρ : EnvFin} {i : Nat} {c : CptFin}
    (h : ApproxFin ρ (.bvar i) c) :
    c = .bot ∨ c = .lam [] ∨ ρ i c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | bvar hρ => exact Or.inr (Or.inr hρ)

theorem approxFin_bvar_iff (ρ : EnvFin) (i : Nat) (c : CptFin) :
    ApproxFin ρ (.bvar i) c ↔ c = .bot ∨ c = .lam [] ∨ ρ i c := by
  refine ⟨approxFin_bvar_inv, ?_⟩
  rintro (rfl | rfl | hρ)
  · exact .bot ρ (.bvar i)
  · exact .lamNil ρ (.bvar i)
  · exact .bvar hρ

/-- Inversion of `ApproxFin` at `.sort l`. -/
theorem approxFin_sort_inv {ρ : EnvFin} {l : Level} {c : CptFin}
    (h : ApproxFin ρ (.sort l) c) :
    c = .bot ∨ c = .lam [] ∨ c = .sort := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | sort => exact Or.inr (Or.inr rfl)

theorem approxFin_sort_iff (ρ : EnvFin) (l : Level) (c : CptFin) :
    ApproxFin ρ (.sort l) c ↔ c = .bot ∨ c = .lam [] ∨ c = .sort := by
  refine ⟨approxFin_sort_inv, ?_⟩
  rintro (rfl | rfl | rfl)
  · exact .bot ρ (.sort l)
  · exact .lamNil ρ (.sort l)
  · exact .sort ρ l

/-- Inversion of `ApproxFin` at `.const r ls`. -/
theorem approxFin_const_inv {ρ : EnvFin} {r : Nat} {ls : List Level} {c : CptFin}
    (h : ApproxFin ρ (.const r ls) c) :
    c = .bot ∨ c = .lam [] ∨ c = .spine r [] := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | const => exact Or.inr (Or.inr rfl)

theorem approxFin_const_iff (ρ : EnvFin) (r : Nat) (ls : List Level) (c : CptFin) :
    ApproxFin ρ (.const r ls) c ↔ c = .bot ∨ c = .lam [] ∨ c = .spine r [] := by
  refine ⟨approxFin_const_inv, ?_⟩
  rintro (rfl | rfl | rfl)
  · exact .bot ρ (.const r ls)
  · exact .lamNil ρ (.const r ls)
  · exact .const ρ r ls

/-- Inversion of `ApproxFin` at `.pi A B`. -/
theorem approxFin_pi_inv {ρ : EnvFin} {A B : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ (.pi A B) c) :
    c = .bot ∨ c = .lam [] ∨
      ∃ a f, c = .pi a f ∧ ApproxFin ρ A a ∧
        ∀ p ∈ f, ApproxFin (EnvFin.cons (CptFin.downList p.1) ρ) B p.2 := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | pi hA hB => exact Or.inr (Or.inr ⟨_, _, rfl, hA, hB⟩)

/-- Inversion of `ApproxFin` at `.app f a`. -/
theorem approxFin_app_inv {ρ : EnvFin} {f a : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ (.app f a) c) :
    c = .bot ∨ c = .lam [] ∨
      (∃ U : List CptFin, ApproxFin ρ f (.lam [(U, c)]) ∧ ∀ u ∈ U, ApproxFin ρ a u) ∨
      (∃ r args u, c = .spine r (args ++ [u]) ∧ ApproxFin ρ f (.spine r args) ∧ ApproxFin ρ a u) := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | app hf ha => exact Or.inr (Or.inr (Or.inl ⟨_, hf, ha⟩))
  | appSpine hf ha => exact Or.inr (Or.inr (Or.inr ⟨_, _, _, rfl, hf, ha⟩))

/-- Inversion of `ApproxFin` at `.letE A v b`. -/
theorem approxFin_letE_inv {ρ : EnvFin} {A v b : Expr Nat} {c : CptFin}
    (h : ApproxFin ρ (.letE A v b) c) :
    c = .bot ∨ c = .lam [] ∨
      ∃ U : List CptFin, (∀ u ∈ U, ApproxFin ρ v u) ∧
        ApproxFin (EnvFin.cons (CptFin.downList U) ρ) b c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | letE hv hb => exact Or.inr (Or.inr ⟨_, hv, hb⟩)

/-- Inversion of `ApproxFin` at `.lit t`. -/
theorem approxFin_lit_inv {ρ : EnvFin} {t : Nat} {c : CptFin}
    (h : ApproxFin ρ (.lit t) c) :
    c = .bot ∨ c = .lam [] ∨ ApproxFin ρ (natExpand t) c := by
  cases h with
  | bot => exact Or.inl rfl
  | lamNil => exact Or.inr (Or.inl rfl)
  | lit h' => exact Or.inr (Or.inr h')

/-- Semantic equality for `.lit t` and `natExpand t` in `ApproxFin`. -/
theorem semEqFin_lit (ρ : EnvFin) (t : Nat) : SemEqFin ρ (.lit t) (natExpand t) := by
  intro c
  constructor
  · intro h
    rcases approxFin_lit_inv h with rfl | rfl | h'
    · exact .bot _ _
    · exact .lamNil _ _
    · exact h'
  · intro h
    exact .lit h

/-- Two-environment relational congruence for `ApproxFin` at `.pi`. -/
theorem approxFin_pi_rel {ρ₁ ρ₂ : EnvFin} {A₁ B₁ A₂ B₂ : Expr Nat}
    (hA : ∀ c, ApproxFin ρ₁ A₁ c ↔ ApproxFin ρ₂ A₂ c)
    (hB : ∀ (S : CptFin → Prop) c,
      ApproxFin (EnvFin.cons S ρ₁) B₁ c ↔ ApproxFin (EnvFin.cons S ρ₂) B₂ c)
    (c : CptFin) :
    ApproxFin ρ₁ (.pi A₁ B₁) c ↔ ApproxFin ρ₂ (.pi A₂ B₂) c := by
  constructor
  · intro h
    rcases approxFin_pi_inv h with rfl | rfl | ⟨a, f, rfl, hAa, hBf⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .pi ((hA a).mp hAa) (fun p hp => (hB (CptFin.downList p.1) p.2).mp (hBf p hp))
  · intro h
    rcases approxFin_pi_inv h with rfl | rfl | ⟨a, f, rfl, hAa, hBf⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .pi ((hA a).mpr hAa) (fun p hp => (hB (CptFin.downList p.1) p.2).mpr (hBf p hp))

/-- Two-environment relational congruence for `ApproxFin` at `.lam`. -/
theorem approxFin_lam_rel {ρ₁ ρ₂ : EnvFin} {A₁ b₁ A₂ b₂ : Expr Nat}
    (hb : ∀ (S : CptFin → Prop) c,
      ApproxFin (EnvFin.cons S ρ₁) b₁ c ↔ ApproxFin (EnvFin.cons S ρ₂) b₂ c)
    (c : CptFin) :
    ApproxFin ρ₁ (.lam A₁ b₁) c ↔ ApproxFin ρ₂ (.lam A₂ b₂) c := by
  constructor
  · intro h
    rcases approxFin_lam_inv h with rfl | ⟨f, rfl, hbf⟩
    · exact .bot _ _
    · exact .lam (fun p hp => (hb (CptFin.downList p.1) p.2).mp (hbf p hp))
  · intro h
    rcases approxFin_lam_inv h with rfl | ⟨f, rfl, hbf⟩
    · exact .bot _ _
    · exact .lam (fun p hp => (hb (CptFin.downList p.1) p.2).mpr (hbf p hp))

/-- Two-environment relational congruence for `ApproxFin` at `.app`. -/
theorem approxFin_app_rel {ρ₁ ρ₂ : EnvFin} {f₁ a₁ f₂ a₂ : Expr Nat}
    (hf : ∀ c, ApproxFin ρ₁ f₁ c ↔ ApproxFin ρ₂ f₂ c)
    (ha : ∀ c, ApproxFin ρ₁ a₁ c ↔ ApproxFin ρ₂ a₂ c)
    (c : CptFin) :
    ApproxFin ρ₁ (.app f₁ a₁) c ↔ ApproxFin ρ₂ (.app f₂ a₂) c := by
  constructor
  · intro h
    rcases approxFin_app_inv h with rfl | rfl | ⟨U, hfg, ha₁⟩ | ⟨r, args, u, rfl, hfs, hau⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .app ((hf (.lam [(U, c)])).mp hfg) (fun u hu => (ha u).mp (ha₁ u hu))
    · exact .appSpine ((hf (.spine r args)).mp hfs) ((ha u).mp hau)
  · intro h
    rcases approxFin_app_inv h with rfl | rfl | ⟨U, hfg, ha₂⟩ | ⟨r, args, u, rfl, hfs, hau⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .app ((hf (.lam [(U, c)])).mpr hfg) (fun u hu => (ha u).mpr (ha₂ u hu))
    · exact .appSpine ((hf (.spine r args)).mpr hfs) ((ha u).mpr hau)

/-- Two-environment relational congruence for `ApproxFin` at `.letE`. -/
theorem approxFin_letE_rel {ρ₁ ρ₂ : EnvFin} {A₁ v₁ b₁ A₂ v₂ b₂ : Expr Nat}
    (hv : ∀ c, ApproxFin ρ₁ v₁ c ↔ ApproxFin ρ₂ v₂ c)
    (hb : ∀ (S : CptFin → Prop) c,
      ApproxFin (EnvFin.cons S ρ₁) b₁ c ↔ ApproxFin (EnvFin.cons S ρ₂) b₂ c)
    (c : CptFin) :
    ApproxFin ρ₁ (.letE A₁ v₁ b₁) c ↔ ApproxFin ρ₂ (.letE A₂ v₂ b₂) c := by
  constructor
  · intro h
    rcases approxFin_letE_inv h with rfl | rfl | ⟨U, hv₁, hb₁⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .letE (fun u hu => (hv u).mp (hv₁ u hu)) ((hb (CptFin.downList U) c).mp hb₁)
  · intro h
    rcases approxFin_letE_inv h with rfl | rfl | ⟨U, hv₂, hb₂⟩
    · exact .bot _ _
    · exact .lamNil _ _
    · exact .letE (fun u hu => (hv u).mpr (hv₂ u hu)) ((hb (CptFin.downList U) c).mpr hb₂)

/-- `natExpand t` has environment-independent `ApproxFin` denotation. -/
theorem approxFin_natExpand_rel (ρ₁ ρ₂ : EnvFin) :
    ∀ (t : Nat) (c : CptFin), ApproxFin ρ₁ (natExpand t) c ↔ ApproxFin ρ₂ (natExpand t) c
  | 0, c => by
      simp only [natExpand, litZero]
      rw [approxFin_const_iff, approxFin_const_iff]
  | n + 1, c => by
      simp only [natExpand, litSucc]
      exact approxFin_app_rel
        (fun d => by rw [approxFin_const_iff, approxFin_const_iff])
        (approxFin_natExpand_rel ρ₁ ρ₂ n) c

/-- `.lit t` has environment-independent `ApproxFin` denotation. -/
theorem approxFin_lit_rel (ρ₁ ρ₂ : EnvFin) (t : Nat) (c : CptFin) :
    ApproxFin ρ₁ (.lit t) c ↔ ApproxFin ρ₂ (.lit t) c :=
  (semEqFin_lit ρ₁ t c).trans
    ((approxFin_natExpand_rel ρ₁ ρ₂ t c).trans (semEqFin_lit ρ₂ t c).symm)

/-- Insert an ideal `S` at de Bruijn depth `k` into a `CptFin` environment `ρ`. -/
def EnvFin.insertAt : Nat → (CptFin → Prop) → EnvFin → EnvFin
  | 0, S, ρ => EnvFin.cons S ρ
  | k + 1, S, ρ => EnvFin.cons (ρ 0) (EnvFin.insertAt k S (fun i => ρ (i + 1)))

theorem EnvFin.insertAt_eq :
    ∀ (k : Nat) (S : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      EnvFin.insertAt k S ρ k c ↔ S c
  | 0, _, _, _ => Iff.rfl
  | k + 1, S, ρ, c => EnvFin.insertAt_eq k S (fun i => ρ (i + 1)) c

theorem EnvFin.insertAt_lt :
    ∀ {k i : Nat}, i < k → ∀ (S : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      EnvFin.insertAt k S ρ i c ↔ ρ i c
  | 0, _, h, _, _, _ => nomatch h
  | _ + 1, 0, _, _, _, _ => Iff.rfl
  | _ + 1, _ + 1, h, S, ρ, c =>
      EnvFin.insertAt_lt (Nat.lt_of_succ_lt_succ h) S (fun j => ρ (j + 1)) c

theorem EnvFin.insertAt_succ_ge :
    ∀ {k i : Nat}, k ≤ i → ∀ (S : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      EnvFin.insertAt k S ρ (i + 1) c ↔ ρ i c
  | 0, _, _, _, _, _ => Iff.rfl
  | _ + 1, 0, h, _, _, _ => nomatch h
  | _ + 1, _ + 1, h, S, ρ, c =>
      EnvFin.insertAt_succ_ge (Nat.le_of_succ_le_succ h) S (fun j => ρ (j + 1)) c

theorem EnvFin.insertAt_mono :
    ∀ (k : Nat) {S S' : CptFin → Prop} (_ : ∀ c, S c → S' c) (ρ : EnvFin),
      EnvFinLe (EnvFin.insertAt k S ρ) (EnvFin.insertAt k S' ρ)
  | 0, _, _, hS, ρ => EnvFinLe.cons_mono hS (EnvFinLe.refl ρ)
  | k + 1, _, _, hS, ρ =>
      EnvFinLe.cons_mono (fun _ h => h) (EnvFin.insertAt_mono k hS (fun i => ρ (i + 1)))

/-- Lifting / weakening lemma for `ApproxFin`. -/
theorem approxFin_lift :
    ∀ (e : Expr Nat) (k : Nat) (S : CptFin → Prop) (ρ : EnvFin) (c : CptFin),
      ApproxFin (EnvFin.insertAt k S ρ) (lift k 1 e) c ↔ ApproxFin ρ e c
  | .bvar i, k, S, ρ, c => by
      simp only [lift]
      by_cases h : k ≤ i
      · rw [if_pos h, approxFin_bvar_iff, approxFin_bvar_iff, EnvFin.insertAt_succ_ge h]
      · rw [if_neg h, approxFin_bvar_iff, approxFin_bvar_iff,
          EnvFin.insertAt_lt (Nat.lt_of_not_le h)]
  | .sort _, _, _, _, c => by
      simp only [lift]
      rw [approxFin_sort_iff, approxFin_sort_iff]
  | .const _ _, _, _, _, c => by
      simp only [lift]
      rw [approxFin_const_iff, approxFin_const_iff]
  | .app f x, k, S, ρ, c => by
      simp only [lift]
      exact approxFin_app_rel (approxFin_lift f k S ρ) (approxFin_lift x k S ρ) c
  | .lam _ b, k, S, ρ, c => by
      simp only [lift]
      refine approxFin_lam_rel (fun T d => ?_) c
      exact approxFin_lift b (k + 1) S (EnvFin.cons T ρ) d
  | .pi A B, k, S, ρ, c => by
      simp only [lift]
      refine approxFin_pi_rel (approxFin_lift A k S ρ) (fun T d => ?_) c
      exact approxFin_lift B (k + 1) S (EnvFin.cons T ρ) d
  | .letE _ v b, k, S, ρ, c => by
      simp only [lift]
      refine approxFin_letE_rel (approxFin_lift v k S ρ) (fun T d => ?_) c
      exact approxFin_lift b (k + 1) S (EnvFin.cons T ρ) d
  | .lit t, k, S, ρ, c => by
      simp only [lift]
      exact approxFin_lit_rel (EnvFin.insertAt k S ρ) ρ t c

/-- Top-binder lifting lemma for `ApproxFin`. -/
theorem approxFin_lift0 (S : CptFin → Prop) (ρ : EnvFin) (a : Expr Nat) (c : CptFin) :
    ApproxFin (EnvFin.cons S ρ) (lift 0 1 a) c ↔ ApproxFin ρ a c :=
  approxFin_lift a 0 S ρ c

/-- General index substitution lemma for `ApproxFin`. -/
theorem approxFin_instantiate :
    ∀ (e : Expr Nat) (k : Nat) (a : Expr Nat) (ρ : EnvFin) (c : CptFin),
      ApproxFin ρ (instantiate k a e) c ↔
        ApproxFin (EnvFin.insertAt k (fun u => ApproxFin ρ a u) ρ) e c
  | .bvar i, k, a, ρ, c => by
      simp only [instantiate]
      by_cases hik : i = k
      · subst hik
        rw [if_pos rfl, approxFin_bvar_iff, EnvFin.insertAt_eq]
        refine ⟨fun h => Or.inr (Or.inr h), ?_⟩
        rintro (rfl | rfl | h)
        · exact .bot ρ a
        · exact .lamNil ρ a
        · exact h
      · rw [if_neg hik]
        by_cases hlt : k < i
        · cases i with
          | zero => exact nomatch hlt
          | succ j =>
              rw [if_pos hlt]
              simp only [Nat.succ_sub_succ_eq_sub, Nat.sub_zero]
              rw [approxFin_bvar_iff, approxFin_bvar_iff,
                EnvFin.insertAt_succ_ge (Nat.le_of_lt_succ hlt)]
        · rw [if_neg hlt, approxFin_bvar_iff, approxFin_bvar_iff]
          have hlt' : i < k := Nat.lt_of_le_of_ne (Nat.le_of_not_lt hlt) hik
          rw [EnvFin.insertAt_lt hlt']
  | .sort l, _, _, _, c => by
      simp only [instantiate]
      rw [approxFin_sort_iff, approxFin_sort_iff]
  | .const r ls, _, _, _, c => by
      simp only [instantiate]
      rw [approxFin_const_iff, approxFin_const_iff]
  | .app f x, k, a, ρ, c => by
      simp only [instantiate]
      exact approxFin_app_rel (approxFin_instantiate f k a ρ) (approxFin_instantiate x k a ρ) c
  | .lam _ b, k, a, ρ, c => by
      simp only [instantiate]
      refine approxFin_lam_rel (fun T d => ?_) c
      refine (approxFin_instantiate b (k + 1) (lift 0 1 a) (EnvFin.cons T ρ) d).trans ?_
      exact ⟨fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
        (fun u hu => (approxFin_lift0 T ρ a u).mp hu) ρ)),
        fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
          (fun u hu => (approxFin_lift0 T ρ a u).mpr hu) ρ))⟩
  | .pi A B, k, a, ρ, c => by
      simp only [instantiate]
      refine approxFin_pi_rel (approxFin_instantiate A k a ρ) (fun T d => ?_) c
      refine (approxFin_instantiate B (k + 1) (lift 0 1 a) (EnvFin.cons T ρ) d).trans ?_
      exact ⟨fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
        (fun u hu => (approxFin_lift0 T ρ a u).mp hu) ρ)),
        fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
          (fun u hu => (approxFin_lift0 T ρ a u).mpr hu) ρ))⟩
  | .letE _ v b, k, a, ρ, c => by
      simp only [instantiate]
      refine approxFin_letE_rel (approxFin_instantiate v k a ρ) (fun T d => ?_) c
      refine (approxFin_instantiate b (k + 1) (lift 0 1 a) (EnvFin.cons T ρ) d).trans ?_
      exact ⟨fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
        (fun u hu => (approxFin_lift0 T ρ a u).mp hu) ρ)),
        fun h => approxFin_mono h (EnvFinLe.cons T (EnvFin.insertAt_mono k
          (fun u hu => (approxFin_lift0 T ρ a u).mpr hu) ρ))⟩
  | .lit t, k, a, ρ, c => by
      simp only [instantiate]
      exact approxFin_lit_rel ρ (EnvFin.insertAt k (fun u => ApproxFin ρ a u) ρ) t c

/-- The substitution property for `ApproxFin`. -/
def ApproxFinSubst : Prop :=
  ∀ (ρ : EnvFin) (a b : Expr Nat) (c : CptFin),
    ApproxFin ρ (instantiate0 a b) c ↔
      ApproxFin (EnvFin.cons (fun u => ApproxFin ρ a u) ρ) b c

/-- **L2 Substitution Theorem for `ApproxFin` (`approxFin_subst : ApproxFinSubst`):**
    Holds unconditionally. -/
theorem approxFin_subst : ApproxFinSubst :=
  fun ρ a b c => approxFin_instantiate b 0 a ρ c

/-- **UNCONDITIONAL β-Soundness in `ApproxFin` (`semEqFin_beta`):**
    For every environment `ρ : EnvFin`, `.app (.lam A b) a` and `instantiate0 a b` have the
    exact same compact approximations (`SemEqFin`), with **no** external hypotheses. -/
theorem semEqFin_beta (ρ : EnvFin) (A b a : Expr Nat) :
    SemEqFin ρ (.app (.lam A b) a) (instantiate0 a b) :=
  fun c => (approxFin_beta_iff_substEnv ρ A b a c).trans (approxFin_subst ρ a b c).symm

/-- **UNCONDITIONAL ζ-Soundness in `ApproxFin` (`semEqFin_zeta`):**
    For every environment `ρ : EnvFin`, `.letE A a b` and `instantiate0 a b` have the
    exact same compact approximations (`SemEqFin`), with **no** external hypotheses. -/
theorem semEqFin_zeta (ρ : EnvFin) (A a b : Expr Nat) :
    SemEqFin ρ (.letE A a b) (instantiate0 a b) :=
  fun c => ((semEqFin_letE_betaRedex ρ A a b) c).trans (semEqFin_beta ρ A b a c)

theorem SemEqFin.refl (ρ : EnvFin) (a : Expr Nat) : SemEqFin ρ a a :=
  fun _ => Iff.rfl

theorem SemEqFin.symm {ρ : EnvFin} {a b : Expr Nat} (h : SemEqFin ρ a b) : SemEqFin ρ b a :=
  fun c => (h c).symm

theorem SemEqFin.trans {ρ : EnvFin} {a b d : Expr Nat}
    (h₁ : SemEqFin ρ a b) (h₂ : SemEqFin ρ b d) : SemEqFin ρ a d :=
  fun c => (h₁ c).trans (h₂ c)

/-- Congruence of `SemEqFin` for `.pi`. -/
theorem semEqFin_pi {ρ : EnvFin} {A A' B B' : Expr Nat}
    (hA : SemEqFin ρ A A')
    (hB : ∀ S, SemEqFin (EnvFin.cons S ρ) B B') :
    SemEqFin ρ (.pi A B) (.pi A' B') :=
  approxFin_pi_rel hA hB

/-- Congruence of `SemEqFin` for `.lam`. -/
theorem semEqFin_lam {ρ : EnvFin} {A A' b b' : Expr Nat}
    (hb : ∀ S, SemEqFin (EnvFin.cons S ρ) b b') :
    SemEqFin ρ (.lam A b) (.lam A' b') :=
  approxFin_lam_rel hb

/-- Congruence of `SemEqFin` for `.app`. -/
theorem semEqFin_app {ρ : EnvFin} {f f' a a' : Expr Nat}
    (hf : SemEqFin ρ f f') (ha : SemEqFin ρ a a') :
    SemEqFin ρ (.app f a) (.app f' a') :=
  approxFin_app_rel hf ha

/-- Congruence of `SemEqFin` for `.letE`. -/
theorem semEqFin_letE {ρ : EnvFin} {A A' v v' b b' : Expr Nat}
    (hv : SemEqFin ρ v v')
    (hb : ∀ S, SemEqFin (EnvFin.cons S ρ) b b') :
    SemEqFin ρ (.letE A v b) (.letE A' v' b') :=
  approxFin_letE_rel hv hb

/-- Semantic equality of sorts in `ApproxFin`. -/
theorem semEqFin_sorts (ρ : EnvFin) (u v : Level) :
    SemEqFin ρ (.sort u) (.sort v) := by
  intro c
  rw [approxFin_sort_iff, approxFin_sort_iff]

/-- Semantic equality of level-instances of the same constant in `ApproxFin`. -/
theorem semEqFin_consts (ρ : EnvFin) (r : Nat) (ls ls' : List Level) :
    SemEqFin ρ (.const r ls) (.const r ls') := by
  intro c
  rw [approxFin_const_iff, approxFin_const_iff]

/-- Π-injectivity in `ApproxFin`: if `SemEqFin ρ (.pi A₁ B₁) (.pi A₂ B₂)`, then `SemEqFin ρ A₁ A₂`
    and `∀ U, SemEqFin (EnvFin.cons (CptFin.downList U) ρ) B₁ B₂`. -/
theorem semEqFin_pi_inj {ρ : EnvFin} {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : SemEqFin ρ (.pi A₁ B₁) (.pi A₂ B₂)) :
    SemEqFin ρ A₁ A₂ ∧
      ∀ U : List CptFin, SemEqFin (EnvFin.cons (CptFin.downList U) ρ) B₁ B₂ := by
  refine ⟨fun a => ⟨fun hA => ?_, fun hA => ?_⟩, fun U b => ⟨fun hB => ?_, fun hB => ?_⟩⟩
  · have hR := (h (.pi a [])).mp (.pi hA (fun _ hp => nomatch hp))
    rcases approxFin_pi_inv hR with h0 | h0 | ⟨a', _, heq, hA', _⟩
    · exact nomatch h0
    · exact nomatch h0
    · injection heq with ha _
      subst ha
      exact hA'
  · have hL := (h (.pi a [])).mpr (.pi hA (fun _ hp => nomatch hp))
    rcases approxFin_pi_inv hL with h0 | h0 | ⟨a', _, heq, hA', _⟩
    · exact nomatch h0
    · exact nomatch h0
    · injection heq with ha _
      subst ha
      exact hA'
  · have hR := (h (.pi .bot [(U, b)])).mp
      (.pi (.bot ρ A₁) (fun p hp => by
        have hp' := List.mem_singleton.mp hp
        subst hp'
        exact hB))
    rcases approxFin_pi_inv hR with h0 | h0 | ⟨_, f, heq, _, hB'⟩
    · exact nomatch h0
    · exact nomatch h0
    · injection heq with _ hf
      subst hf
      exact hB' (U, b) (List.mem_singleton.mpr rfl)
  · have hL := (h (.pi .bot [(U, b)])).mpr
      (.pi (.bot ρ A₂) (fun p hp => by
        have hp' := List.mem_singleton.mp hp
        subst hp'
        exact hB))
    rcases approxFin_pi_inv hL with h0 | h0 | ⟨_, f, heq, _, hB'⟩
    · exact nomatch h0
    · exact nomatch h0
    · injection heq with _ hf
      subst hf
      exact hB' (U, b) (List.mem_singleton.mpr rfl)

/-- Π-types and sorts are disjoint in `ApproxFin`. -/
theorem semEqFin_pi_sort_disjoint {ρ : EnvFin} {A B : Expr Nat} {l : Level}
    (h : SemEqFin ρ (.pi A B) (.sort l)) : False := by
  have hR := (h (.pi .bot [])).mp (.pi (.bot ρ A) (fun _ hp => nomatch hp))
  rcases approxFin_sort_inv hR with h0 | h0 | h0 <;> exact nomatch h0

/-- Pointwise `ApproxFin` along an argument spine. -/
inductive ApproxFinArgs (ρ : EnvFin) : List (Expr Nat) → List CptFin → Prop
  | nil : ApproxFinArgs ρ [] []
  | cons {x : Expr Nat} {u : CptFin} {xs : List (Expr Nat)} {us : List CptFin}
      (hx : ApproxFin ρ x u) (hxs : ApproxFinArgs ρ xs us) :
      ApproxFinArgs ρ (x :: xs) (u :: us)

theorem approxFinArgs_length {ρ : EnvFin} {xs : List (Expr Nat)} {us : List CptFin}
    (h : ApproxFinArgs ρ xs us) : xs.length = us.length := by
  induction h with
  | nil => rfl
  | cons _ _ ih => exact congrArg Nat.succ ih

theorem approxFinArgs_snoc {ρ : EnvFin} {xs : List (Expr Nat)} {us : List CptFin}
    {x : Expr Nat} {u : CptFin}
    (hxs : ApproxFinArgs ρ xs us) (hx : ApproxFin ρ x u) :
    ApproxFinArgs ρ (xs ++ [x]) (us ++ [u]) := by
  induction hxs with
  | nil => exact .cons hx .nil
  | cons h₀ _ ih => exact .cons h₀ ih

theorem approxFin_foldApps_spine {ρ : EnvFin} {r : Nat} {f : Expr Nat} {args : List CptFin}
    {xs : List (Expr Nat)} {us : List CptFin}
    (hf : ApproxFin ρ f (.spine r args)) (hxs : ApproxFinArgs ρ xs us) :
    ApproxFin ρ (foldApps f xs) (.spine r (args ++ us)) := by
  induction hxs generalizing f args with
  | nil =>
      simp only [foldApps, List.append_nil]
      exact hf
  | cons ha _ ih =>
      simp only [foldApps]
      have hstep := ih (.appSpine hf ha)
      rw [List.append_assoc] at hstep
      exact hstep

theorem approxFin_famApp {ρ : EnvFin} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {us : List CptFin}
    (h : ApproxFinArgs ρ xs us) :
    ApproxFin ρ (foldApps (.const r ls) xs) (.spine r us) := by
  have h0 := approxFin_foldApps_spine (.const ρ r ls) h
  simpa only [List.nil_append] using h0

/-- Inductive spine inversion invariant for `ApproxFin`. -/
def IsSpineExprFin (ρ : EnvFin) (r : Nat) (pre : List (Expr Nat)) (f : Expr Nat) : Prop :=
  ∀ c, ApproxFin ρ f c →
    c = .bot ∨ c = .lam [] ∨ ∃ us, c = .spine r us ∧ ApproxFinArgs ρ pre us

theorem isSpineExprFin_const (ρ : EnvFin) (r : Nat) (ls : List Level) :
    IsSpineExprFin ρ r [] (.const r ls) := by
  intro c hc
  rcases approxFin_const_inv hc with h0 | h0 | h0
  · exact Or.inl h0
  · exact Or.inr (Or.inl h0)
  · exact Or.inr (Or.inr ⟨[], h0, .nil⟩)

theorem isSpineExprFin_app {ρ : EnvFin} {r : Nat} {pre : List (Expr Nat)} {f : Expr Nat}
    (hf : IsSpineExprFin ρ r pre f) (x : Expr Nat) :
    IsSpineExprFin ρ r (pre ++ [x]) (.app f x) := by
  intro c hc
  rcases approxFin_app_inv hc with h0 | h0 | ⟨U, hfg, _⟩ | ⟨r', args, u, rfl, hfs, hxu⟩
  · exact Or.inl h0
  · exact Or.inr (Or.inl h0)
  · rcases hf (.lam [(U, c)]) hfg with hbot | hnil | ⟨_, hsp, _⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · exact nomatch hsp
  · rcases hf (.spine r' args) hfs with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with hr hargs
      subst hr; subst hargs
      exact Or.inr (Or.inr ⟨args ++ [u], rfl, approxFinArgs_snoc hus hxu⟩)

theorem isSpineExprFin_foldApps {ρ : EnvFin} {r : Nat} :
    ∀ (xs : List (Expr Nat)) {pre : List (Expr Nat)} {f : Expr Nat},
      IsSpineExprFin ρ r pre f → IsSpineExprFin ρ r (pre ++ xs) (foldApps f xs)
  | [], _, _, hf => by
      rw [List.append_nil]
      exact hf
  | x :: xs, _, _, hf => by
      simp only [foldApps]
      have hstep := isSpineExprFin_foldApps xs (isSpineExprFin_app hf x)
      rw [List.append_assoc] at hstep
      exact hstep

/-- Inversion of `ApproxFin` at a constant-headed application spine `foldApps (.const r ls) xs`. -/
theorem approxFin_foldApps_const_inv {ρ : EnvFin} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)} {c : CptFin}
    (h : ApproxFin ρ (foldApps (.const r ls) xs) c) :
    c = .bot ∨ c = .lam [] ∨ ∃ us, c = .spine r us ∧ ApproxFinArgs ρ xs us := by
  have h0 := isSpineExprFin_foldApps xs (isSpineExprFin_const ρ r ls) c h
  simpa only [List.nil_append] using h0

/-- Canonical `CptFin` argument vector with `.bot` at every slot of `xs`. -/
def botVecFin : List (Expr Nat) → List CptFin
  | [] => []
  | _ :: xs => .bot :: botVecFin xs

theorem botVecFin_length : ∀ (xs : List (Expr Nat)), (botVecFin xs).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (botVecFin_length xs)

theorem approxFinArgs_botVecFin (ρ : EnvFin) :
    ∀ (xs : List (Expr Nat)), ApproxFinArgs ρ xs (botVecFin xs)
  | [] => .nil
  | x :: xs => .cons (.bot ρ x) (approxFinArgs_botVecFin ρ xs)

theorem approxFin_famApp_botVecFin (ρ : EnvFin) (r : Nat) (ls : List Level) (xs : List (Expr Nat)) :
    ApproxFin ρ (foldApps (.const r ls) xs) (.spine r (botVecFin xs)) :=
  approxFin_famApp r ls (approxFinArgs_botVecFin ρ xs)

/-- Probe `CptFin` vector placing `u` at slot `i` and `.bot` at all other slots of `xs`. -/
def slotVecFin : List (Expr Nat) → Nat → CptFin → List CptFin
  | [], _, _ => []
  | _ :: xs, 0, u => u :: botVecFin xs
  | _ :: xs, i + 1, u => .bot :: slotVecFin xs i u

theorem approxFinArgs_slotVecFin {ρ : EnvFin} :
    ∀ {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : CptFin},
      xs[i]? = some x → ApproxFin ρ x u → ApproxFinArgs ρ xs (slotVecFin xs i u)
  | [], _, _, _, hx, _ => by rw [List.getElem?_nil] at hx; exact Option.noConfusion hx
  | _ :: ys, 0, _, _, hx, hu => by
      rw [List.getElem?_cons_zero] at hx
      injection hx with hyx
      subst hyx
      exact .cons hu (approxFinArgs_botVecFin ρ ys)
  | y :: _, _ + 1, _, _, hx, hu => by
      rw [List.getElem?_cons_succ] at hx
      exact .cons (.bot ρ y) (approxFinArgs_slotVecFin hx hu)

theorem approxFinArgs_slotVecFin_inv {ρ : EnvFin} :
    ∀ {xs xs' : List (Expr Nat)} {i : Nat} {x' : Expr Nat} {u : CptFin},
      xs'[i]? = some x' → ApproxFinArgs ρ xs' (slotVecFin xs i u) → ApproxFin ρ x' u
  | [], _, _, _, _, hx', h => by
      cases h
      rw [List.getElem?_nil] at hx'; exact Option.noConfusion hx'
  | _ :: _, _ :: _, 0, _, _, hx', .cons hu' _ => by
      rw [List.getElem?_cons_zero] at hx'
      injection hx' with hyx'
      subst hyx'
      exact hu'
  | _ :: _, _ :: _, _ + 1, _, _, hx', .cons _ htail => by
      rw [List.getElem?_cons_succ] at hx'
      exact approxFinArgs_slotVecFin_inv hx' htail

theorem approxFin_famApp_slotVecFin {ρ : EnvFin} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : CptFin}
    (hx : xs[i]? = some x) (hu : ApproxFin ρ x u) :
    ApproxFin ρ (foldApps (.const r ls) xs) (.spine r (slotVecFin xs i u)) :=
  approxFin_famApp r ls (approxFinArgs_slotVecFin hx hu)

/-- Family-head and spine-length injectivity in `ApproxFin`. -/
theorem semEqFin_famApp_head_length {ρ : EnvFin} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqFin ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hR := (h (.spine r (botVecFin xs))).mp (approxFin_famApp_botVecFin ρ r ls xs)
  rcases approxFin_foldApps_const_inv hR with hbot | hnil | ⟨us, hsp, hus⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · injection hsp with hr hus_eq
    subst hr; subst hus_eq
    exact ⟨rfl, (botVecFin_length xs).symm.trans (approxFinArgs_length hus).symm⟩

/-- Slotwise argument injectivity in `ApproxFin`. -/
theorem semEqFin_famApp_slot {ρ : EnvFin} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqFin ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs'))
    {i : Nat} {x x' : Expr Nat}
    (hx : xs[i]? = some x) (hx' : xs'[i]? = some x') :
    SemEqFin ρ x x' := by
  intro u
  constructor
  · intro hu
    have hR := (h (.spine r (slotVecFin xs i u))).mp (approxFin_famApp_slotVecFin r ls hx hu)
    rcases approxFin_foldApps_const_inv hR with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxFinArgs_slotVecFin_inv hx' hus
  · intro hu'
    have hL := (h (.spine r' (slotVecFin xs' i u))).mpr (approxFin_famApp_slotVecFin r' ls' hx' hu')
    rcases approxFin_foldApps_const_inv hL with hbot | hnil | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · exact nomatch hnil
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxFinArgs_slotVecFin_inv hx hus

/-- Full family-spine injectivity in `ApproxFin`. -/
theorem semEqFin_famApp_inj {ρ : EnvFin} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqFin ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqFin ρ x x' :=
  ⟨(semEqFin_famApp_head_length h).1, (semEqFin_famApp_head_length h).2,
    fun _ _ _ hx hx' => semEqFin_famApp_slot h hx hx'⟩

/-- Π-types and constant-headed family spines are disjoint in `ApproxFin`. -/
theorem semEqFin_pi_famApp_disjoint {ρ : EnvFin} {A B : Expr Nat} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)}
    (h : SemEqFin ρ (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hR := (h (.pi .bot [])).mp (.pi (.bot ρ A) (fun _ hp => nomatch hp))
  rcases approxFin_foldApps_const_inv hR with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0

/-- Sorts and constant-headed family spines are disjoint in `ApproxFin`. -/
theorem semEqFin_sort_famApp_disjoint {ρ : EnvFin} {l : Level} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)}
    (h : SemEqFin ρ (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hR := (h .sort).mp (.sort ρ l)
  rcases approxFin_foldApps_const_inv hR with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0

/-- Unconditional soundness of `FamCongrFrag` in `ApproxFin`. -/
theorem semEqFin_of_famCongrFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCongrFrag E n h) : ∀ ρ : EnvFin, SemEqFin ρ a b := by
  induction hh with
  | refl => intro ρ; exact SemEqFin.refl ρ _
  | symm _ ih => intro ρ; exact (ih ρ).symm
  | trans _ _ ih₁ ih₂ => intro ρ; exact (ih₁ ρ).trans (ih₂ ρ)
  | pi _ _ ih₁ ih₂ => intro ρ; exact semEqFin_pi (ih₁ ρ) (fun S => ih₂ (EnvFin.cons S ρ))
  | lam _ _ _ ih₂ => intro ρ; exact semEqFin_lam (fun S => ih₂ (EnvFin.cons S ρ))
  | app _ _ ih₁ ih₂ => intro ρ; exact semEqFin_app (ih₁ ρ) (ih₂ ρ)
  | letE _ _ _ _ ihv ihb => intro ρ; exact semEqFin_letE (ihv ρ) (fun S => ihb (EnvFin.cons S ρ))
  | @lit _ t _ _ hl _ =>
      intro ρ
      cases hl
      exact semEqFin_lit ρ t
  | tyConv _ ih => intro ρ; exact ih ρ
  | sorts => intro ρ; exact semEqFin_sorts ρ _ _
  | consts => intro ρ; exact semEqFin_consts ρ _ _ _

/-- **UNCONDITIONAL Soundness of `FamBetaZetaFrag` in `ApproxFin` (`semEqFin_of_famBetaZetaFrag`):**
    Every conversion in `FamBetaZetaFrag E n` (`refl`, `symm`, `trans`, `pi`, `lam`, `app`, `letE`,
    `lit`, `tyConv`, `sorts`, `consts`, **`beta`**, and **`zeta`**) is sound in `ApproxFin` at
    every environment `ρ : EnvFin`, with **zero** unproved hypotheses. -/
theorem semEqFin_of_famBetaZetaFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamBetaZetaFrag E n h) : ∀ ρ : EnvFin, SemEqFin ρ a b := by
  induction hh with
  | ofCongr hh => intro ρ; exact semEqFin_of_famCongrFrag hh ρ
  | symm _ ih => intro ρ; exact (ih ρ).symm
  | trans _ _ ih₁ ih₂ => intro ρ; exact (ih₁ ρ).trans (ih₂ ρ)
  | pi _ _ ih₁ ih₂ => intro ρ; exact semEqFin_pi (ih₁ ρ) (fun S => ih₂ (EnvFin.cons S ρ))
  | lam _ _ _ ih₂ => intro ρ; exact semEqFin_lam (fun S => ih₂ (EnvFin.cons S ρ))
  | app _ _ ih₁ ih₂ => intro ρ; exact semEqFin_app (ih₁ ρ) (ih₂ ρ)
  | letE _ _ _ _ ihv ihb => intro ρ; exact semEqFin_letE (ihv ρ) (fun S => ihb (EnvFin.cons S ρ))
  | beta => intro ρ; exact semEqFin_beta ρ _ _ _
  | zeta => intro ρ; exact semEqFin_zeta ρ _ _ _
  | tyConv _ ih => intro ρ; exact ih ρ

/-- **UNCONDITIONAL Family-Spine Injectivity for `FamBetaZetaFrag` in `ApproxFin`:**
    Any conversion in `FamBetaZetaFrag E n` between two constant-headed family spines implies
    `r = r'`, `xs.length = xs'.length`, and `SemEqFin ρ x x'` at every slot `i`, with **no**
    external hypotheses. -/
theorem famBetaZetaFrag_famApp_semInjFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamBetaZetaFrag E n h) (ρ : EnvFin) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqFin ρ x x' :=
  semEqFin_famApp_inj (semEqFin_of_famBetaZetaFrag hh ρ)

/-- **UNCONDITIONAL Π-Injectivity for `FamBetaZetaFrag` in `ApproxFin`:**
    Any conversion in `FamBetaZetaFrag E n` between two Π-types `.pi A₁ B₁` and `.pi A₂ B₂`
    implies `SemEqFin ρ A₁ A₂` and `∀ U, SemEqFin (EnvFin.cons (CptFin.downList U) ρ) B₁ B₂`,
    with **no** external hypotheses. -/
theorem famBetaZetaFrag_pi_semInjFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ T : Expr Nat}
    {h : ConvT E n Γ (.pi A₁ B₁) (.pi A₂ B₂) T}
    (hh : FamBetaZetaFrag E n h) (ρ : EnvFin) :
    SemEqFin ρ A₁ A₂ ∧
      ∀ U : List CptFin, SemEqFin (EnvFin.cons (CptFin.downList U) ρ) B₁ B₂ :=
  semEqFin_pi_inj (semEqFin_of_famBetaZetaFrag hh ρ)

/-- **Full Semantic Equality of the Two-Occurrence β-Redex in `ApproxFin`:**
    At every environment `ρ : EnvFin` and across **all** compacts `c : CptFin`, the two-occurrence
    β-redex `(.app (.lam (.sort u) (.pi (.bvar 0) (.bvar 1))) (.pi (.sort .zero) (.sort .zero)))`
    is semantically equal (`SemEqFin ρ`) to its substituted target
    `(.pi (.pi (.sort .zero) (.sort .zero)) (.pi (.sort .zero) (.sort .zero)))`. -/
theorem semEqFin_twoOcc_beta (ρ : EnvFin) (u : Level) :
    SemEqFin ρ
      (.app (.lam (.sort u) (.pi (.bvar 0) (.bvar 1))) (.pi (.sort .zero) (.sort .zero)))
      (.pi (.pi (.sort .zero) (.sort .zero)) (.pi (.sort .zero) (.sort .zero))) :=
  semEqFin_beta ρ (.sort u) (.pi (.bvar 0) (.bvar 1)) (.pi (.sort .zero) (.sort .zero))

/-! #### Context-aware valuation `ctxEnvFin` and unconditional `ConvT.zetaLocal` / `FamBetaZetaLocalFrag` soundness -/

/-- Exact `.letE` characterization in `ApproxFin`: by `semEqFin_letE_betaRedex` and
    finitary compactness (`approxFin_beta_iff_substEnv`), approximating `.letE A v b` at `ρ`
    is equivalent to approximating `b` at the single let-extended environment
    `EnvFin.cons (fun u => ApproxFin ρ v u) ρ`. -/
theorem approxFin_letE_iff_substEnv (ρ : EnvFin) (A v b : Expr Nat) (c : CptFin) :
    ApproxFin ρ (.letE A v b) c ↔
      ApproxFin (EnvFin.cons (fun u => ApproxFin ρ v u) ρ) b c :=
  (semEqFin_letE_betaRedex ρ A v b c).trans (approxFin_beta_iff_substEnv ρ A b v c)

/-- Pointwise `.letE` congruence in `ApproxFin` requiring body equality only at the single
    let-extended environment `EnvFin.cons (fun u => ApproxFin ρ v u) ρ` (rather than `∀ S`). -/
theorem semEqFin_letE_exact {ρ : EnvFin} {A A' v v' b b' : Expr Nat}
    (hv : SemEqFin ρ v v')
    (hb : SemEqFin (EnvFin.cons (fun u => ApproxFin ρ v u) ρ) b b') :
    SemEqFin ρ (.letE A v b) (.letE A' v' b') := by
  have hv_eq : (fun u => ApproxFin ρ v u) = (fun u => ApproxFin ρ v' u) :=
    funext fun u => propext (hv u)
  intro c
  rw [approxFin_letE_iff_substEnv, approxFin_letE_iff_substEnv, ← hv_eq]
  exact hb c

/-- Shifting a `.bvar` index across `EnvFin.cons S ρ`. -/
theorem approxFin_bvar_succ (ρ : EnvFin) (S : CptFin → Prop) (j : Nat) (c : CptFin) :
    ApproxFin (EnvFin.cons S ρ) (.bvar (j + 1)) c ↔ ApproxFin ρ (.bvar j) c := by
  rw [approxFin_bvar_iff, approxFin_bvar_iff]
  rfl

/-- At `EnvFin.cons (fun u => ApproxFin ρ v u) ρ`, `.bvar 0` has the exact same compact
    approximations as `v` at `ρ`. -/
theorem approxFin_bvar_zero_let (ρ : EnvFin) (v : Expr Nat) (c : CptFin) :
    ApproxFin (EnvFin.cons (fun u => ApproxFin ρ v u) ρ) (.bvar 0) c ↔ ApproxFin ρ v c := by
  rw [approxFin_bvar_iff]
  constructor
  · rintro (rfl | rfl | hv)
    · exact .bot ρ v
    · exact .lamNil ρ v
    · exact hv
  · intro hv
    exact Or.inr (Or.inr hv)

/-- Context-agreement predicate for `EnvFin`: every let-bound variable `i` in `Γ` with
    `lookupValue Γ i = some v` is semantically equal to `v` at `ρ`. -/
def CtxEnvFin (Γ : LCtx) (ρ : EnvFin) : Prop :=
  ∀ (i : Nat) (v : Expr Nat), lookupValue Γ i = some v → SemEqFin ρ (.bvar i) v

/-- `EnvFin.bot` satisfies `CtxEnvFin []`. -/
theorem ctxEnvFin_nil : CtxEnvFin [] EnvFin.bot := by
  intro i _ hw
  cases i <;> exact nomatch hw

/-- Extending `Γ` with `.assumption A` preserves `CtxEnvFin` under `EnvFin.cons S ρ` for any `S`. -/
theorem ctxEnvFin_cons_assumption {Γ : LCtx} {ρ : EnvFin}
    (hctx : CtxEnvFin Γ ρ) (A : Expr Nat) (S : CptFin → Prop) :
    CtxEnvFin (.assumption A :: Γ) (EnvFin.cons S ρ) := by
  intro i w hw
  cases i with
  | zero => exact nomatch hw
  | succ j =>
    rw [lookupValue_cons_succ] at hw
    cases h : lookupValue Γ j with
    | none => rw [h] at hw; exact nomatch hw
    | some v₀ =>
      rw [h] at hw
      injection hw with hw_eq
      subst hw_eq
      intro c
      exact (approxFin_bvar_succ ρ S j c).trans
        ((hctx j v₀ h c).trans (approxFin_lift0 S ρ v₀ c).symm)

/-- Extending `Γ` with `.letBinding A v` preserves `CtxEnvFin` under
    `EnvFin.cons (fun u => ApproxFin ρ v u) ρ`. -/
theorem ctxEnvFin_cons_letBinding {Γ : LCtx} {ρ : EnvFin}
    (hctx : CtxEnvFin Γ ρ) (A v : Expr Nat) :
    CtxEnvFin (.letBinding A v :: Γ) (EnvFin.cons (fun u => ApproxFin ρ v u) ρ) := by
  intro i w hw
  cases i with
  | zero =>
    injection hw with hw_eq
    subst hw_eq
    intro c
    exact (approxFin_bvar_zero_let ρ v c).trans
      (approxFin_lift0 (fun u => ApproxFin ρ v u) ρ v c).symm
  | succ j =>
    rw [lookupValue_cons_succ] at hw
    cases h : lookupValue Γ j with
    | none => rw [h] at hw; exact nomatch hw
    | some v₀ =>
      rw [h] at hw
      injection hw with hw_eq
      subst hw_eq
      intro c
      exact (approxFin_bvar_succ ρ _ j c).trans
        ((hctx j v₀ h c).trans (approxFin_lift0 (fun u => ApproxFin ρ v u) ρ v₀ c).symm)

/-- Canonical context-aware environment `ctxEnvFin Γ : EnvFin` mapping `.assumption` binders to
    `.bot` and `.letBinding _ v` binders to the semantic interpretation of `v`. -/
def ctxEnvFin : LCtx → EnvFin
  | [] => EnvFin.bot
  | .assumption _ :: Γ => EnvFin.cons (fun c => c = .bot) (ctxEnvFin Γ)
  | .letBinding _ v :: Γ => EnvFin.cons (fun u => ApproxFin (ctxEnvFin Γ) v u) (ctxEnvFin Γ)

/-- `ctxEnvFin Γ` unconditionally satisfies `CtxEnvFin Γ (ctxEnvFin Γ)`. -/
theorem ctxEnvFin_respects : ∀ (Γ : LCtx), CtxEnvFin Γ (ctxEnvFin Γ)
  | [] => ctxEnvFin_nil
  | .assumption A :: Γ => ctxEnvFin_cons_assumption (ctxEnvFin_respects Γ) A (fun c => c = .bot)
  | .letBinding A v :: Γ => ctxEnvFin_cons_letBinding (ctxEnvFin_respects Γ) A v

/-- **Unconditional `ConvT.zetaLocal` soundness in `ApproxFin`:**
    At every environment `ρ` satisfying `CtxEnvFin Γ ρ` (and in particular at `ctxEnvFin Γ`),
    if `lookupValue Γ i = some v`, then `SemEqFin ρ (.bvar i) v`. -/
theorem semEqFin_zetaLocal {Γ : LCtx} {ρ : EnvFin} (hctx : CtxEnvFin Γ ρ)
    {i : Nat} {v : Expr Nat} (hv : lookupValue Γ i = some v) :
    SemEqFin ρ (.bvar i) v :=
  hctx i v hv

/-- The 14-constructor conversion fragment `FamBetaZetaLocalFrag`: extends `FamBetaZetaFrag` with
    `ConvT.zetaLocal` (`refl`, `symm`, `trans`, `pi`, `lam`, `app`, `letE`, `lit`, `tyConv`,
    `sorts`, `consts`, `beta`, `zeta`, `zetaLocal` — 14 of the 18 `ConvT` constructors). -/
inductive FamBetaZetaLocalFrag (E : ResolvedEnv) (n : Nat) :
    {Γ : LCtx} → {a b T : Expr Nat} → ConvT E n Γ a b T → Prop
  | ofBetaZeta {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
      (hh : FamBetaZetaFrag E n h) : FamBetaZetaLocalFrag E n h
  | zetaLocal {Γ : LCtx} {i : Nat} {A v : Expr Nat}
      {hval : lookupValue Γ i = some v} {hty : lookupType Γ i = some A}
      {hv : HasTyT E n Γ v A} :
      FamBetaZetaLocalFrag E n (ConvT.zetaLocal Γ i A v hval hty hv)
  | symm {Γ : LCtx} {a b A : Expr Nat} {h : ConvT E n Γ a b A}
      (hh : FamBetaZetaLocalFrag E n h) : FamBetaZetaLocalFrag E n (ConvT.symm Γ a b A h)
  | trans {Γ : LCtx} {a b c A : Expr Nat} {h₁ : ConvT E n Γ a b A} {h₂ : ConvT E n Γ b c A}
      (hh₁ : FamBetaZetaLocalFrag E n h₁) (hh₂ : FamBetaZetaLocalFrag E n h₂) :
      FamBetaZetaLocalFrag E n (ConvT.trans Γ a b c A h₁ h₂)
  | pi {Γ : LCtx} {A A' B B' : Expr Nat} {u v : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) B B' (.sort v)}
      (hh₁ : FamBetaZetaLocalFrag E n h₁) (hh₂ : FamBetaZetaLocalFrag E n h₂) :
      FamBetaZetaLocalFrag E n (ConvT.pi Γ A A' B B' u v h₁ h₂)
  | lam {Γ : LCtx} {A A' b b' B : Expr Nat} {u : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) b b' B}
      (hh₁ : FamBetaZetaLocalFrag E n h₁) (hh₂ : FamBetaZetaLocalFrag E n h₂) :
      FamBetaZetaLocalFrag E n (ConvT.lam Γ A A' b b' B u h₁ h₂)
  | app {Γ : LCtx} {f g a b A B : Expr Nat} {h₁ : ConvT E n Γ f g (.pi A B)}
      {h₂ : ConvT E n Γ a b A} (hh₁ : FamBetaZetaLocalFrag E n h₁)
      (hh₂ : FamBetaZetaLocalFrag E n h₂) :
      FamBetaZetaLocalFrag E n (ConvT.app Γ f g a b A B h₁ h₂)
  | letE {Γ : LCtx} {A A' v v' b b' B : Expr Nat} {u : Level}
      {hA : ConvT E n Γ A A' (.sort u)} {hv : ConvT E n Γ v v' A}
      {hb : ConvT E n (.letBinding A v :: Γ) b b' B}
      (hhA : FamBetaZetaLocalFrag E n hA) (hhv : FamBetaZetaLocalFrag E n hv)
      (hhb : FamBetaZetaLocalFrag E n hb) :
      FamBetaZetaLocalFrag E n (ConvT.letE Γ A A' v v' b b' B u hA hv hb)
  | tyConv {Γ : LCtx} {a b A A' : Expr Nat} {u : Level} {h : ConvT E n Γ a b A}
      {hA : ConvT E n Γ A A' (.sort u)} (hh : FamBetaZetaLocalFrag E n h) :
      FamBetaZetaLocalFrag E n (ConvT.tyConv Γ a b A A' u h hA)

/-- **UNCONDITIONAL 14-Constructor Soundness in `ApproxFin` (`semEqFin_of_famBetaZetaLocalFrag`):**
    Every conversion in `FamBetaZetaLocalFrag E n` (`refl`, `symm`, `trans`, `pi`, `lam`, `app`,
    `letE`, `lit`, `tyConv`, `sorts`, `consts`, **`beta`**, **`zeta`**, and **`zetaLocal`**) is
    sound in `ApproxFin` at every environment `ρ` satisfying `CtxEnvFin Γ ρ` (and in particular at
    `ctxEnvFin Γ`), with **zero** unproved hypotheses. -/
theorem semEqFin_of_famBetaZetaLocalFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamBetaZetaLocalFrag E n h) :
    ∀ (ρ : EnvFin), CtxEnvFin Γ ρ → SemEqFin ρ a b := by
  induction hh with
  | ofBetaZeta hh => intro ρ _; exact semEqFin_of_famBetaZetaFrag hh ρ
  | @zetaLocal _ _ _ _ hval _ _ => intro ρ hctx; exact semEqFin_zetaLocal hctx hval
  | symm _ ih => intro ρ hctx; exact (ih ρ hctx).symm
  | trans _ _ ih₁ ih₂ => intro ρ hctx; exact (ih₁ ρ hctx).trans (ih₂ ρ hctx)
  | pi _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqFin_pi (ih₁ ρ hctx)
        (fun S => ih₂ (EnvFin.cons S ρ) (ctxEnvFin_cons_assumption hctx _ S))
  | lam _ _ _ ih₂ =>
      intro ρ hctx
      exact semEqFin_lam (fun S => ih₂ (EnvFin.cons S ρ) (ctxEnvFin_cons_assumption hctx _ S))
  | app _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqFin_app (ih₁ ρ hctx) (ih₂ ρ hctx)
  | letE _ _ _ _ ihv ihb =>
      intro ρ hctx
      exact semEqFin_letE_exact (ihv ρ hctx) (ihb _ (ctxEnvFin_cons_letBinding hctx _ _))
  | tyConv _ ih => intro ρ hctx; exact ih ρ hctx

/-- **UNCONDITIONAL Family-Spine Injectivity for `FamBetaZetaLocalFrag` in `ApproxFin`:**
    Any 14-constructor conversion in `FamBetaZetaLocalFrag E n` between two constant-headed
    family spines in context `Γ` implies `r = r'`, `xs.length = xs'.length`, and
    `SemEqFin (ctxEnvFin Γ) x x'` at every slot `i`, with **no** external hypotheses. -/
theorem famBetaZetaLocalFrag_famApp_semInjFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamBetaZetaLocalFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqFin (ctxEnvFin Γ) x x' :=
  semEqFin_famApp_inj (semEqFin_of_famBetaZetaLocalFrag hh (ctxEnvFin Γ) (ctxEnvFin_respects Γ))


/-! ### §5 — Computational Fragment `FamCompFrag` Soundness, Applied η-Soundness (`semEqFin_eta_app`), Refutation of Unprojected `EtaStepFin` / `TypedSoundnessFin`, and Shallow Type-Code Soundness (`ShallowTypeSoundnessFin`) -/

/-- **Unconditional Applied η-Soundness in `ApproxFin` (`semEqFin_eta_app`):**
    At every environment `ρ : EnvFin`, applying the η-expansion `.lam A (.app (lift 0 1 f) (.bvar 0))`
    of ANY expression `f` (including variables and constants) to any argument `x` has the exact same
    denotation as `.app f x`. -/
theorem semEqFin_eta_app (ρ : EnvFin) (A f x : Expr Nat) :
    SemEqFin ρ (.app (.lam A (.app (lift 0 1 f) (.bvar 0))) x) (.app f x) := by
  intro c
  exact (approxFin_beta_iff_substEnv ρ A (.app (lift 0 1 f) (.bvar 0)) x c).trans
    (approxFin_app_rel
      (fun d => approxFin_lift0 (fun u => ApproxFin ρ x u) ρ f d)
      (fun d => approxFin_bvar_zero_let ρ x d)
      c)

/-- Named step handler in `ApproxFin` for `ConvT.delta` (transparent definition unfolding). -/
def DeltaStepFin (E : ResolvedEnv) : Prop :=
  ∀ (ρ : EnvFin) (r : Nat) (ls : List Level) (m : CheckedMember) (b : Expr Nat),
    E.members r = some m → m.body = some b → transparent m.mclass = true →
    SemEqFin ρ (.const r ls) (instantiateLevels ls b)

/-- Named step handler in `ApproxFin` for `ConvT.iota` (derived ι-reduction). -/
def IotaStepFin (E : ResolvedEnv) : Prop :=
  ∀ (ρ : EnvFin) (lhs rhs : Expr Nat), Nonempty (DerivedIota E lhs rhs) → SemEqFin ρ lhs rhs

/-- Pure inductive environment: every member is an `.inductiveM` family or `.constructorM`
    constructor with `m.body = none` (no transparent definitions and no recursors). -/
def PureInductiveEnv (E : ResolvedEnv) : Prop :=
  ∀ r m, E.members r = some m →
    (m.mclass = .inductiveM ∨ m.mclass = .constructorM) ∧ m.body = none

/-- `emptyEnv` satisfies `PureInductiveEnv`. -/
theorem pureInductiveEnv_emptyEnv : PureInductiveEnv emptyEnv := by
  intro _ _ h
  cases h

/-- `DeltaStepFin E` holds unconditionally in any `PureInductiveEnv E`. -/
theorem deltaStepFin_of_pureInductiveEnv {E : ResolvedEnv} (hE : PureInductiveEnv E) :
    DeltaStepFin E := by
  intro _ r _ m _ hres hbody _
  rw [(hE r m hres).2] at hbody
  exact Option.noConfusion hbody

/-- `IotaStepFin E` holds unconditionally in any `PureInductiveEnv E` (since no member is `.recursorM`). -/
theorem iotaStepFin_of_pureInductiveEnv {E : ResolvedEnv} (hE : PureInductiveEnv E) :
    IotaStepFin E := by
  rintro _ _ _ ⟨⟨w⟩⟩
  rcases (hE w.recRef w.recMember w.hrec).1 with hind | hctor
  · exact MemberClass.noConfusion (hind.symm.trans w.hrecK)
  · exact MemberClass.noConfusion (hctor.symm.trans w.hrecK)

/-- Concrete inhabitedness witness for `DeltaStepFin` on `emptyEnv`. -/
theorem deltaStepFin_emptyEnv : DeltaStepFin emptyEnv :=
  deltaStepFin_of_pureInductiveEnv pureInductiveEnv_emptyEnv

/-- Concrete inhabitedness witness for `IotaStepFin` on `emptyEnv`. -/
theorem iotaStepFin_emptyEnv : IotaStepFin emptyEnv :=
  iotaStepFin_of_pureInductiveEnv pureInductiveEnv_emptyEnv

/-- Unprojected step handler in `ApproxFin` for unapplied `ConvT.eta`. -/
def EtaStepFin : Prop :=
  ∀ (ρ : EnvFin) (A f : Expr Nat), SemEqFin ρ (.lam A (.app (lift 0 1 f) (.bvar 0))) f

/-- **Refutation of unapplied `EtaStepFin` in `ApproxFin` (`not_etaStepFin`):**
    Because `ApproxFin` only coalesces `.lam []` (`lamNil`) and not `.lam [([], .bot)]`, the
    unapplied η-expansion of `.bvar 0` at `EnvFin.bot` has compact `.lam [([], .bot)]` while `.bvar 0`
    does not. (No consumer in this module takes `EtaStepFin`.) -/
theorem not_etaStepFin : ¬ EtaStepFin := by
  intro heta
  have h := heta EnvFin.bot (.sort .zero) (.bvar 0) (.lam [([], .bot)])
  have hlhs : ApproxFin EnvFin.bot (.lam (.sort .zero) (.app (.bvar 1) (.bvar 0))) (.lam [([], .bot)]) :=
    .lam (fun p hp => by
      have hp' := List.mem_singleton.mp hp
      subst hp'
      exact .bot _ _)
  rcases approxFin_bvar_inv (h.mp hlhs) with h1 | h2 | h3
  · exact nomatch h1
  · exact nomatch h2
  · exact nomatch h3

/-- Unprojected full-`ConvT` soundness interface on `ApproxFin` at `ctxEnvFin Γ`. -/
def TypedSoundnessFin (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx} {a b T : Expr Nat},
    CtxWfT E n Γ → ConvT E n Γ a b T → SemEqFin (ctxEnvFin Γ) a b

/-- Context `[f : Sort 0 → Sort 0]` for witnessing `ConvT.eta` at every `(E, n)`. -/
def etaObsCtx : LCtx := [.assumption (.pi (.sort .zero) (.sort .zero))]

/-- `etaObsCtx` is well-formed (`CtxWfT E n etaObsCtx`) at every environment `E` and bound `n`. -/
def etaObsCtx_wf (E : ResolvedEnv) (n : Nat) : CtxWfT E n etaObsCtx :=
  .assumption [] (.pi (.sort .zero) (.sort .zero)) (.imax (.succ .zero) (.succ .zero))
    .nil (pinPiT E n)

/-- Native `ConvT.eta` conversion in `etaObsCtx` at every `(E, n)`. -/
noncomputable
def convT_etaObs (E : ResolvedEnv) (n : Nat) :
    ConvT E n etaObsCtx
      (.lam (.sort .zero) (.app (.bvar 1) (.bvar 0)))
      (.bvar 0)
      (.pi (.sort .zero) (.sort .zero)) :=
  .eta etaObsCtx (.bvar 0) (.sort .zero) (.sort .zero)
    (.bvar etaObsCtx 0 (.pi (.sort .zero) (.sort .zero)) rfl)

/-- **Refutation of unprojected `TypedSoundnessFin` at every `(E, n)` (`not_typedSoundnessFin`):**
    Evaluating `convT_etaObs` at `.lam [([], .bot)]` refutes `TypedSoundnessFin E n` at every
    environment `E` and bound `n`. (No consumer in this module takes `TypedSoundnessFin`.) -/
theorem not_typedSoundnessFin (E : ResolvedEnv) (n : Nat) :
    ¬ TypedSoundnessFin E n := by
  intro hS
  have hsem := hS (etaObsCtx_wf E n) (convT_etaObs E n) (.lam [([], .bot)])
  have hlhs : ApproxFin (ctxEnvFin etaObsCtx)
      (.lam (.sort .zero) (.app (.bvar 1) (.bvar 0))) (.lam [([], .bot)]) :=
    .lam (fun p hp => by
      have hp' := List.mem_singleton.mp hp
      subst hp'
      exact .bot _ _)
  rcases approxFin_bvar_inv (hsem.mp hlhs) with h1 | h2 | h3
  · exact nomatch h1
  · exact nomatch h2
  · exact nomatch h3

/-- **Computational Conversion Fragment `FamCompFrag`:**
    Extends the 14-constructor `FamBetaZetaLocalFrag` (`refl`, `symm`, `trans`, `pi`, `lam`, `app`,
    `letE`, `lit`, `tyConv`, `sorts`, `consts`, `beta`, `zeta`, `zetaLocal`) with `delta`, `iota`,
    and applied η-conversions `etaApp`, closed under `symm`, `trans`, `pi`, `lam`, `app`, `letE`,
    and `tyConv`. -/
inductive FamCompFrag (E : ResolvedEnv) (n : Nat) :
    {Γ : LCtx} → {a b T : Expr Nat} → ConvT E n Γ a b T → Prop
  | ofBetaZetaLocal {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
      (hh : FamBetaZetaLocalFrag E n h) : FamCompFrag E n h
  | delta {Γ : LCtx} {r : Nat} {ls : List Level} {m : CheckedMember} {b : Expr Nat}
      {hres : E.members r = some m} {hbody : m.body = some b}
      {htr : transparent m.mclass = true} {hlen : ls.length = m.arity}
      {hwf : levelsBounded n ls = true}
      {hb : HasTyT E n Γ (instantiateLevels ls b) (instantiateLevels ls m.mtype)} :
      FamCompFrag E n (ConvT.delta Γ r ls m b hres hbody htr hlen hwf hb)
  | iota {Γ : LCtx} {lhs rhs T : Expr Nat} {h : DerivedIota E lhs rhs}
      {hlhs : HasTyT E n Γ lhs T} {hrhs : HasTyT E n Γ rhs T} :
      FamCompFrag E n (ConvT.iota Γ lhs rhs T h hlhs hrhs)
  | etaApp {Γ : LCtx} {f a b A B : Expr Nat}
      {hf : HasTyT E n Γ f (.pi A B)} {hab : ConvT E n Γ a b A}
      (hhab : FamCompFrag E n hab) :
      FamCompFrag E n
        (ConvT.app Γ (.lam A (.app (lift 0 1 f) (.bvar 0))) f a b A B
          (ConvT.eta Γ f A B hf) hab)
  | symm {Γ : LCtx} {a b A : Expr Nat} {h : ConvT E n Γ a b A}
      (hh : FamCompFrag E n h) : FamCompFrag E n (ConvT.symm Γ a b A h)
  | trans {Γ : LCtx} {a b c A : Expr Nat} {h₁ : ConvT E n Γ a b A} {h₂ : ConvT E n Γ b c A}
      (hh₁ : FamCompFrag E n h₁) (hh₂ : FamCompFrag E n h₂) :
      FamCompFrag E n (ConvT.trans Γ a b c A h₁ h₂)
  | pi {Γ : LCtx} {A A' B B' : Expr Nat} {u v : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) B B' (.sort v)}
      (hh₁ : FamCompFrag E n h₁) (hh₂ : FamCompFrag E n h₂) :
      FamCompFrag E n (ConvT.pi Γ A A' B B' u v h₁ h₂)
  | lam {Γ : LCtx} {A A' b b' B : Expr Nat} {u : Level} {h₁ : ConvT E n Γ A A' (.sort u)}
      {h₂ : ConvT E n (.assumption A :: Γ) b b' B}
      (hh₁ : FamCompFrag E n h₁) (hh₂ : FamCompFrag E n h₂) :
      FamCompFrag E n (ConvT.lam Γ A A' b b' B u h₁ h₂)
  | app {Γ : LCtx} {f g a b A B : Expr Nat} {h₁ : ConvT E n Γ f g (.pi A B)}
      {h₂ : ConvT E n Γ a b A} (hh₁ : FamCompFrag E n h₁) (hh₂ : FamCompFrag E n h₂) :
      FamCompFrag E n (ConvT.app Γ f g a b A B h₁ h₂)
  | letE {Γ : LCtx} {A A' v v' b b' B : Expr Nat} {u : Level}
      {hA : ConvT E n Γ A A' (.sort u)} {hv : ConvT E n Γ v v' A}
      {hb : ConvT E n (.letBinding A v :: Γ) b b' B}
      (hhA : FamCompFrag E n hA) (hhv : FamCompFrag E n hv) (hhb : FamCompFrag E n hb) :
      FamCompFrag E n (ConvT.letE Γ A A' v v' b b' B u hA hv hb)
  | tyConv {Γ : LCtx} {a b A A' : Expr Nat} {u : Level} {h : ConvT E n Γ a b A}
      {hA : ConvT E n Γ A A' (.sort u)} (hh : FamCompFrag E n h) :
      FamCompFrag E n (ConvT.tyConv Γ a b A A' u h hA)

/-- Soundness of `FamCompFrag` in `ApproxFin` under `DeltaStepFin E` and `IotaStepFin E`
    (which are unconditionally inhabited on `PureInductiveEnv E` and `emptyEnv`). -/
theorem semEqFin_of_famCompFrag {E : ResolvedEnv} {n : Nat}
    (hdelta : DeltaStepFin E) (hiota : IotaStepFin E)
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCompFrag E n h) :
    ∀ (ρ : EnvFin), CtxEnvFin Γ ρ → SemEqFin ρ a b := by
  induction hh with
  | ofBetaZetaLocal hh => intro ρ hctx; exact semEqFin_of_famBetaZetaLocalFrag hh ρ hctx
  | @delta _ r ls m b hres hbody htr _ _ _ => intro ρ _; exact hdelta ρ r ls m b hres hbody htr
  | @iota _ lhs rhs _ h _ _ => intro ρ _; exact hiota ρ lhs rhs ⟨h⟩
  | @etaApp _ f a b A _ _ _ _ ihab =>
      intro ρ hctx
      exact (semEqFin_eta_app ρ A f a).trans (semEqFin_app (SemEqFin.refl ρ f) (ihab ρ hctx))
  | symm _ ih => intro ρ hctx; exact (ih ρ hctx).symm
  | trans _ _ ih₁ ih₂ => intro ρ hctx; exact (ih₁ ρ hctx).trans (ih₂ ρ hctx)
  | pi _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqFin_pi (ih₁ ρ hctx)
        (fun S => ih₂ (EnvFin.cons S ρ) (ctxEnvFin_cons_assumption hctx _ S))
  | lam _ _ _ ih₂ =>
      intro ρ hctx
      exact semEqFin_lam (fun S => ih₂ (EnvFin.cons S ρ) (ctxEnvFin_cons_assumption hctx _ S))
  | app _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqFin_app (ih₁ ρ hctx) (ih₂ ρ hctx)
  | letE _ _ _ _ ihv ihb =>
      intro ρ hctx
      exact semEqFin_letE_exact (ihv ρ hctx) (ihb _ (ctxEnvFin_cons_letBinding hctx _ _))
  | tyConv _ ih => intro ρ hctx; exact ih ρ hctx

/-- Family-spine injectivity for `FamCompFrag` in `ApproxFin`. -/
theorem famCompFrag_famApp_semInjFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hdelta : DeltaStepFin E) (hiota : IotaStepFin E)
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamCompFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqFin (ctxEnvFin Γ) x x' :=
  semEqFin_famApp_inj (semEqFin_of_famCompFrag hdelta hiota hh (ctxEnvFin Γ) (ctxEnvFin_respects Γ))

/-- **Unconditional Family-Spine Injectivity for `FamCompFrag` in `PureInductiveEnv E`:**
    In any `PureInductiveEnv E` (containing `.inductiveM` families and `.constructorM` constructors),
    `DeltaStepFin E` and `IotaStepFin E` hold unconditionally, so `FamCompFrag` gives
    unconditional family-head and slotwise `SemEqFin (ctxEnvFin Γ)` injectivity. -/
theorem famCompFrag_famApp_semInjFin_of_pureInductiveEnv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hE : PureInductiveEnv E)
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamCompFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqFin (ctxEnvFin Γ) x x' :=
  famCompFrag_famApp_semInjFin
    (deltaStepFin_of_pureInductiveEnv hE)
    (iotaStepFin_of_pureInductiveEnv hE)
    hh

/-- Shallow type-code compacts in `CptFin`: `.sort`, `.pi .bot []`, and `.spine r (botVecFin xs)`
    (where all argument slots are `.bot`, so `eta` and `irr` inside arguments cannot separate
    convertible spines). -/
inductive IsShallowTypeCptFin : CptFin → Prop
  | sort : IsShallowTypeCptFin .sort
  | piBot : IsShallowTypeCptFin (.pi .bot [])
  | spineBot (r : Nat) (xs : List (Expr Nat)) : IsShallowTypeCptFin (.spine r (botVecFin xs))

/-- Shallow type-code soundness in `ApproxFin`: every sorted type conversion
    `ConvT E n Γ A B (.sort u)` preserves shallow type-code compacts `IsShallowTypeCptFin c`
    at `ctxEnvFin Γ`. -/
def ShallowTypeSoundnessFin (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A B : Expr Nat} {u : Level}, ConvT E n Γ A B (.sort u) →
      ∀ {c : CptFin}, IsShallowTypeCptFin c →
        (ApproxFin (ctxEnvFin Γ) A c ↔ ApproxFin (ctxEnvFin Γ) B c)

/-- Lift `ShallowTypeSoundnessFin` along a `TyConvT` chain. -/
theorem shallowTypeSemEqFin_of_tyConvT {E : ResolvedEnv} {n : Nat}
    (hsound : ShallowTypeSoundnessFin E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {T₁ T₂ : Expr Nat} → TyConvT E n Γ T₁ T₂ →
      ∀ {c : CptFin}, IsShallowTypeCptFin c →
        (ApproxFin (ctxEnvFin Γ) T₁ c ↔ ApproxFin (ctxEnvFin Γ) T₂ c)
  | _, _, .refl _ _, _, _ => Iff.rfl
  | _, _, .of _ _ _ _ hc, _, hcpt => hsound hΓ hc hcpt
  | _, _, .trans _ _ _ _ c₁ c₂, _, hcpt =>
      (shallowTypeSemEqFin_of_tyConvT hsound hΓ c₁ hcpt).trans
        (shallowTypeSemEqFin_of_tyConvT hsound hΓ c₂ hcpt)

/-- Family-head and spine-length injectivity under `ShallowTypeSoundnessFin`. -/
theorem tyConvT_famApp_head_length_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hsound : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hiff := shallowTypeSemEqFin_of_tyConvT hsound hΓ h (.spineBot r xs)
  have hR := hiff.mp (approxFin_famApp_botVecFin (ctxEnvFin Γ) r ls xs)
  rcases approxFin_foldApps_const_inv hR with hbot | hnil | ⟨us, hsp, hus⟩
  · exact nomatch hbot
  · exact nomatch hnil
  · injection hsp with hr hus_eq
    subst hr; subst hus_eq
    exact ⟨rfl, (botVecFin_length xs).symm.trans (approxFinArgs_length hus).symm⟩

/-- Disjointness of `.pi A B` and `.sort l` under `ShallowTypeSoundnessFin`. -/
theorem not_tyConvT_pi_sort_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {l : Level}
    (hsound : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  have hiff := shallowTypeSemEqFin_of_tyConvT hsound hΓ hc .piBot
  have hpi : ApproxFin (ctxEnvFin Γ) (.pi A B) (.pi .bot []) :=
    .pi (.bot _ A) (fun _ hp => nomatch hp)
  rcases approxFin_sort_inv (hiff.mp hpi) with h1 | h2 | h3
  · exact nomatch h1
  · exact nomatch h2
  · exact nomatch h3

/-- Disjointness of `.sort l` and `.pi A B` under `ShallowTypeSoundnessFin`. -/
theorem not_tyConvT_sort_pi_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {l : Level}
    (hsound : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hiff := shallowTypeSemEqFin_of_tyConvT hsound hΓ hc .sort
  rcases approxFin_pi_inv (hiff.mp (.sort _ l)) with h1 | h2 | ⟨_, _, h3, _, _⟩
  · exact nomatch h1
  · exact nomatch h2
  · exact nomatch h3

/-- Disjointness of `.pi A B` and `foldApps (.const r ls) xs` under `ShallowTypeSoundnessFin`. -/
theorem not_tyConvT_pi_famApp_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hsound : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hiff := shallowTypeSemEqFin_of_tyConvT hsound hΓ hc .piBot
  have hpi : ApproxFin (ctxEnvFin Γ) (.pi A B) (.pi .bot []) :=
    .pi (.bot _ A) (fun _ hp => nomatch hp)
  rcases approxFin_foldApps_const_inv (hiff.mp hpi) with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0

/-- Disjointness of `.sort l` and `foldApps (.const r ls) xs` under `ShallowTypeSoundnessFin`. -/
theorem not_tyConvT_sort_famApp_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {l : Level} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hsound : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hiff := shallowTypeSemEqFin_of_tyConvT hsound hΓ hc .sort
  rcases approxFin_foldApps_const_inv (hiff.mp (.sort _ l)) with h0 | h0 | ⟨_, h0, _⟩ <;> exact nomatch h0

/-- Saturation of a well-typed admitted inductive family application under
    `ShallowTypeSoundnessFin` and `PiRowField`. -/
theorem famApp_saturated_of_piRow_shallowSoundnessFin {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hsound : ShallowTypeSoundnessFin E n) (hprow : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_shallowSoundnessFin hsound hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_shallowSoundnessFin hsound hΓ hconv

/-- Construct `FamAppSaturation` (#7525) from `ShallowTypeSoundnessFin` and `PiRowField`
    (without requiring `AllBelowScoped` or `TableWF`). -/
noncomputable def famAppSaturation_of_shallowSoundnessFin {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (hprow : PiRowField E n) (hsound : ShallowTypeSoundnessFin E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FamAppSaturation E r m ls ls' xs xs' := by
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM hW hm hind ls'
  have ⟨_, htyR⟩ := tyConvT_rhsSort hW hΓ h ⟨w, hty⟩
  have hlenL := famApp_saturated_of_piRow_shallowSoundnessFin hW hsound hprow hΓ hm hind htelL hty
  have hlenR := famApp_saturated_of_piRow_shallowSoundnessFin hW hsound hprow hΓ hm hind htelR htyR
  exact {
    doms := (piDomsOf m.mtype).map (instantiateLevels ls)
    doms' := (piDomsOf m.mtype).map (instantiateLevels ls')
    U := .sort (instLevel ls (inductiveSortLevel hW hm hind))
    U' := .sort (instLevel ls' (inductiveSortLevel hW hm hind))
    telL := htelL
    telR := htelR
    eqN := heqN
    lenDD := by simp only [List.length_map]
    lenXD := hlenL.symm
    lenXD' := hlenR.symm
  }


/-! ### §6 — Weak-head normal form of admitted family spines (`WhStepCtx` with `zetaLocal`), `FamLevelAndSlotConv`, and bidirectional (`↔`) equivalences -/

/-- Admitted `.inductiveM` members in `EnvWfT` have `m.body = none` (no δ-unfolding body). -/
def FamilyNoBody (E : ResolvedEnv) : Prop :=
  ∀ r m, E.members r = some m → m.mclass = .inductiveM → m.body = none

theorem familyNoBody_extend_nonfamily {E : ResolvedEnv} (hE : FamilyNoBody E)
    (r : Nat) (m : CheckedMember) (hn : m.mclass ≠ .inductiveM) :
    FamilyNoBody (extendEnv E r m) := by
  intro r' m' hres hcls
  by_cases heq : r' = r
  · subst r'
    simp only [extendEnv, if_pos rfl] at hres
    cases hres
    exact False.elim (hn hcls)
  · simp only [extendEnv, if_neg heq] at hres
    exact hE r' m' hres hcls

theorem familyNoBody_group {S E E' : ResolvedEnv}
    {ms : List (Nat × CheckedMember)} (g : GroupMembersT S E ms E') :
    FamilyNoBody E → FamilyNoBody E' := by
  induction g with
  | nil => exact fun h => h
  | cons E r m rest E' _ hnobody _ _ _ _ _ _ _ _ _ _ _ _ ih =>
      intro hE
      apply ih
      intro r' m' hres hcls
      by_cases heq : r' = r
      · subst r'
        simp only [extendEnv, if_pos rfl] at hres
        cases hres
        exact hnobody
      · simp only [extendEnv, if_neg heq] at hres
        exact hE r' m' hres hcls

theorem familyNoBody_of_envWfT : {E : ResolvedEnv} → EnvWfT E → FamilyNoBody E
  | _, .empty => by
      intro r m h
      cases h
  | _, .axiom (arity := arity) E r A _ hE .. =>
      familyNoBody_extend_nonfamily (familyNoBody_of_envWfT hE)
        r ⟨.axiomM, arity, A, none⟩ (by intro h; cases h)
  | _, .definition E r A v _ hE .. =>
      familyNoBody_extend_nonfamily (familyNoBody_of_envWfT hE)
        r ⟨.definitionM, 0, A, some v⟩ (by intro h; cases h)
  | _, .thm E r A p hE .. =>
      familyNoBody_extend_nonfamily (familyNoBody_of_envWfT hE)
        r ⟨.theoremM, 0, A, some p⟩ (by intro h; cases h)
  | _, .opaque E r A v _ hE .. =>
      familyNoBody_extend_nonfamily (familyNoBody_of_envWfT hE)
        r ⟨.opaqueM, 0, A, some v⟩ (by intro h; cases h)
  | _, .group _ _ _ _ _ _ _ hE _ _ _ hmem =>
      familyNoBody_group hmem (familyNoBody_of_envWfT hE)

/-- Every list is either `[]` or `pre ++ [x]`. -/
theorem list_eq_nil_or_snoc {α : Type} :
    ∀ (xs : List α), xs = [] ∨ ∃ (pre : List α) (x : α), xs = pre ++ [x]
  | [] => Or.inl rfl
  | x :: xs =>
      match list_eq_nil_or_snoc xs with
      | Or.inl hnil => Or.inr ⟨[], x, congrArg (x :: ·) hnil⟩
      | Or.inr ⟨pre, y, hsnoc⟩ => Or.inr ⟨x :: pre, y, congrArg (x :: ·) hsnoc⟩

/-- Every `DerivedIotaU` source is a recursor-headed spine `foldApps (.const r ls) (pre ++ [major])`
    with `m.mclass = .recursorM`. -/
theorem derivedIotaU_recHead {E : ResolvedEnv} {lhs rhs : Expr Nat}
    (hI : DerivedIotaU E lhs rhs) :
    ∃ (r : Nat) (ls : List Level) (pre : List (Expr Nat)) (major : Expr Nat) (m : CheckedMember),
      lhs = foldApps (.const r ls) (pre ++ [major]) ∧
      E.members r = some m ∧ m.mclass = .recursorM := by
  cases hI with
  | ofU w =>
      exact ⟨w.recRef, w.ls, w.preMajor,
        foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields), w.recMember,
        rfl, w.hrec, w.hrecK⟩
  | ofUS w =>
      exact ⟨w.recRef, w.ls, w.preMajor,
        foldApps (.const w.ctorRef w.lsC) (w.ctorParams ++ w.fields), w.recMember,
        rfl, w.hrec, w.hrecK⟩

/-- An `.inductiveM`-headed spine `foldApps (.const r ls) xs` can never be a `DerivedIotaU` source
    (since `.inductiveM ≠ .recursorM`). -/
theorem derivedIotaU_famApp_false {E : ResolvedEnv}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {rhs : Expr Nat}
    (hI : DerivedIotaU E (foldApps (.const r ls) xs) rhs) : False := by
  rcases derivedIotaU_recHead hI with ⟨r', ls', pre, major, m', hlhs, hrec, hrecK⟩
  obtain ⟨hconst, _⟩ := foldApps_const_inj hlhs
  injection hconst with hr _
  subst hr
  rw [hm] at hrec
  injection hrec with hm'
  subst hm'
  exact MemberClass.noConfusion (hind.symm.trans hrecK)

/-- Context-aware weak-head one-step reduction `WhStepCtx E Γ` including **`zetaLocal`**
    (local let-variable unfolding when `lookupValue Γ i = some v`), `beta`, `zeta`,
    `delta`, `iota`, `lit`, and `appHead`. -/
inductive WhStepCtx (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | beta (A b a : Expr Nat) : WhStepCtx E Γ (.app (.lam A b) a) (instantiate0 a b)
  | zeta (A v b : Expr Nat) : WhStepCtx E Γ (.letE A v b) (instantiate0 v b)
  | zetaLocal {i : Nat} {v : Expr Nat} (hv : lookupValue Γ i = some v) :
      WhStepCtx E Γ (.bvar i) v
  | delta {r : Nat} {ls : List Level} {m : CheckedMember} {b : Expr Nat}
      (hres : E.members r = some m) (hbody : m.body = some b) :
      WhStepCtx E Γ (.const r ls) (instantiateLevels ls b)
  | iota {lhs rhs : Expr Nat} (h : DerivedIotaU E lhs rhs) : WhStepCtx E Γ lhs rhs
  | lit (t : Nat) : WhStepCtx E Γ (.lit t) (natExpand t)
  | appHead {f f' a : Expr Nat} (h : WhStepCtx E Γ f f') : WhStepCtx E Γ (.app f a) (.app f' a)

/-- Reflexive-transitive closure of `WhStepCtx E Γ`. -/
inductive WhRedCtx (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | refl (e : Expr Nat) : WhRedCtx E Γ e e
  | step {a b c : Expr Nat} (h : WhStepCtx E Γ a b) (hs : WhRedCtx E Γ b c) : WhRedCtx E Γ a c

/-- Auxiliary induction on `WhStepCtx`: no spine `foldApps (.const r ls) xs` of an admitted
    inductive family head `r` can take a weak-head step (including `zetaLocal`). -/
theorem whStepCtx_famApp_false_aux {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {a e : Expr Nat} (h : WhStepCtx E Γ a e) :
    ∀ (xs : List (Expr Nat)), a = foldApps (.const r ls) xs → False := by
  induction h with
  | beta A b arg =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hf _
        exact F8EtaK.foldApps_const_ne_lam_any hf.symm
  | zeta A v b =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | zetaLocal _ =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | delta hres hbody =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · injection heq with hr _
        subst hr
        rw [hm] at hres
        injection hres with hm'
        subst hm'
        have hnone := familyNoBody_of_envWfT hW _ m hm hind
        rw [hnone] at hbody
        exact Option.noConfusion hbody
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | iota hI =>
      intro xs heq
      subst heq
      exact derivedIotaU_famApp_false hm hind hI
  | lit t =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | appHead _ ih =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hpre _
        exact ih pre hpre

/-- An admitted `.inductiveM` family spine `foldApps (.const r ls) xs` has no weak-head steps
    under `WhStepCtx E Γ` (including `zetaLocal`). -/
theorem whStepCtx_famApp_false {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} (xs : List (Expr Nat)) {e : Expr Nat}
    (h : WhStepCtx E Γ (foldApps (.const r ls) xs) e) : False :=
  whStepCtx_famApp_false_aux hW hm hind h xs rfl

/-- Any `WhRedCtx E Γ` reduction starting from an admitted `.inductiveM` family spine
    `foldApps (.const r ls) xs` is trivial (`e = foldApps (.const r ls) xs`). -/
theorem whRedCtx_famApp_eq {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (h : WhRedCtx E Γ (foldApps (.const r ls) xs) e) :
    e = foldApps (.const r ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepCtx_famApp_false hW hm hind xs hs).elim

/-- **Named Target Interface `FamLevelAndSlotConv` (the catalogued residue `W-F8-FAMAPP-ARG-COMPARISON`
    plus level coherence):**
    Given `TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')` for an
    admitted `.inductiveM` family `r`, bundles `eqNList ls ls'` and
    `RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'` (#7525). -/
def FamLevelAndSlotConv (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (m : CheckedMember) (ls ls' : List Level) (xs xs' : List (Expr Nat)) : Prop :=
  eqNList ls ls' ∧
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'

/-- Non-vacuous slot-equality soundness interface on `ApproxFin` at `ctxEnvFin Γ`:
    for any well-typed admitted `.inductiveM` family conversion
    `TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')`,
    each non-`Prop` slot (`u ≠ .zero`) satisfies `SemEqFin (ctxEnvFin Γ) x x'`. -/
def FamSlotSemEqFinSoundness (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level},
      E.members r = some m → m.mclass = .inductiveM →
      HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w) →
      TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') →
      ∀ (i : Nat) (x x' d : Expr Nat) (u : Level),
        xs[i]? = some x → xs'[i]? = some x' →
        ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d →
        HasTyT E n Γ (instPrefix (xs.take i) d) (.sort u) → u ≠ .zero →
        SemEqFin (ctxEnvFin Γ) x x'

/-- At every relevant (non-`Prop`) slot `i`, `ShallowTypeSoundnessFin`, `FamSlotSemEqFinSoundness`,
    and `#7569` (`hasTyT_spineInv_rows`) yield both semantic equality `SemEqFin (ctxEnvFin Γ) x x'`
    and native left-domain typing `HasTyT E n Γ x (instPrefix (xs.take i) d)`, together with
    probe approximation `.spine r (botVecFin xs)` on both sides. -/
theorem famSlot_semEqFin_and_leftTyping {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hshallow : ShallowTypeSoundnessFin E n)
    (hslotSound : FamSlotSemEqFinSoundness E n) (hprow : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    {i : Nat} {x x' d : Expr Nat} {u : Level}
    (hx : xs[i]? = some x) (hx' : xs'[i]? = some x')
    (hd : ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d)
    (hdT : HasTyT E n Γ (instPrefix (xs.take i) d) (.sort u)) (hu : u ≠ .zero) :
    SemEqFin (ctxEnvFin Γ) x x' ∧
      Nonempty (HasTyT E n Γ x (instPrefix (xs.take i) d)) ∧
      ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls) xs) (.spine r (botVecFin xs)) ∧
      ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls') xs') (.spine r (botVecFin xs)) := by
  have hslot : SemEqFin (ctxEnvFin Γ) x x' :=
    hslotSound hΓ hm hind hty h i x x' d u hx hx' hd hdT hu
  have hbotL : ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls) xs) (.spine r (botVecFin xs)) :=
    approxFin_famApp_botVecFin (ctxEnvFin Γ) r ls xs
  have hbotR : ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls') xs') (.spine r (botVecFin xs)) :=
    (shallowTypeSemEqFin_of_tyConvT hshallow hΓ h (.spineBot r xs)).mp hbotL
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have hlenL := famApp_saturated_of_piRow_shallowSoundnessFin hW hshallow hprow hΓ hm hind htelL hty
  obtain ⟨⟨_, _, hargsL, _⟩⟩ := hasTyT_spineInv_rows hW hprow hΓ hm htelL xs hlenL.symm hty
  exact ⟨hslot, ⟨hargsL i x d hx hd⟩, hbotL, hbotR⟩

/-- Reflection of semantic slot equality `SemEqFin (ctxEnvFin Γ) x x'` at a non-`Prop` left-instantiated
    domain (`u ≠ .zero`) to native `ConvT E n Γ x x' (instPrefix (xs.take i) d)`. -/
def SemEqFinRelevantSlotReflect (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level},
      E.members r = some m → m.mclass = .inductiveM →
      HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w) →
      TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') →
      ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls) xs) (.spine r (botVecFin xs)) →
      ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls') xs') (.spine r (botVecFin xs)) →
      ∀ (i : Nat) (x x' d : Expr Nat) (u : Level),
        xs[i]? = some x → xs'[i]? = some x' →
        ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d →
        HasTyT E n Γ (instPrefix (xs.take i) d) (.sort u) → u ≠ .zero →
        HasTyT E n Γ x (instPrefix (xs.take i) d) →
        SemEqFin (ctxEnvFin Γ) x x' →
        Nonempty (ConvT E n Γ x x' (instPrefix (xs.take i) d))

/-- Derive `RelevantSlotConv` (#7525) from `ShallowTypeSoundnessFin`, `FamSlotSemEqFinSoundness`,
    `PiRowField`, and `SemEqFinRelevantSlotReflect`: non-`Prop` slots (`u ≠ .zero`) reflect
    `SemEqFin (ctxEnvFin Γ) x x'` via `hrefl`. -/
theorem relevantSlotConv_of_shallowSoundnessFin_reflect {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hshallow : ShallowTypeSoundnessFin E n)
    (hslotSound : FamSlotSemEqFinSoundness E n) (hprow : PiRowField E n)
    (hrefl : SemEqFinRelevantSlotReflect E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' := by
  intro i x x' d u hx hx' hd hdT hu
  simp only [List.nil_append] at hdT ⊢
  obtain ⟨hslot, ⟨hxT⟩, hbotL, hbotR⟩ :=
    famSlot_semEqFin_and_leftTyping hW hshallow hslotSound hprow hΓ hm hind hty h hx hx' hd hdT hu
  exact hrefl hΓ hm hind hty h hbotL hbotR i x x' d u hx hx' hd hdT hu hxT hslot

/-- **Restatement 1 (`FundamentalFamSpineFin`, equivalent `↔` to `FamLevelAndSlotConv` under
    `ShallowTypeSoundnessFin`):**
    Combines shallow spine probe approximation `.spine r (botVecFin xs)` and length equality with
    `FamLevelAndSlotConv`. As shown in `fundamentalFamSpineFin_iff_famLevelAndSlotConv` below, under
    `ShallowTypeSoundnessFin E n` this predicate is logically equivalent (`↔`) to `FamLevelAndSlotConv`. -/
def FundamentalFamSpineFin (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (r : Nat) (m : CheckedMember) (ls ls' : List Level) (xs xs' : List (Expr Nat)) : Prop :=
  eqNList ls ls' ∧
  xs.length = xs'.length ∧
  ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls) xs) (.spine r (botVecFin xs)) ∧
  ApproxFin (ctxEnvFin Γ) (foldApps (.const r ls') xs') (.spine r (botVecFin xs)) ∧
  RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'

/-- **Bidirectional Equivalence (`↔`) between `FundamentalFamSpineFin` and `FamLevelAndSlotConv`:**
    Under `ShallowTypeSoundnessFin E n` and `TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')`,
    `FundamentalFamSpineFin` is equivalent (`↔`) to `FamLevelAndSlotConv`
    (`eqNList ls ls' ∧ RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'`). -/
theorem fundamentalFamSpineFin_iff_famLevelAndSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hshallow : ShallowTypeSoundnessFin E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} (m : CheckedMember) {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FundamentalFamSpineFin E n Γ r m ls ls' xs xs' ↔
      FamLevelAndSlotConv E n Γ m ls ls' xs xs' := by
  have hlen := (tyConvT_famApp_head_length_of_shallowSoundnessFin hshallow hΓ h).2
  have hbotL := approxFin_famApp_botVecFin (ctxEnvFin Γ) r ls xs
  have hbotR :=
    (shallowTypeSemEqFin_of_tyConvT hshallow hΓ h (.spineBot r xs)).mp hbotL
  constructor
  · rintro ⟨heqN, _, _, _, hslot⟩
    exact ⟨heqN, hslot⟩
  · rintro ⟨heqN, hslot⟩
    exact ⟨heqN, hlen, hbotL, hbotR, hslot⟩

/-- **Restatement 2 (`LRFamSpine` / `FundamentalFamLR`, equivalent `↔` to `FamLevelAndSlotConv`
    under `EnvWfT E`):**
    Weak-head reducible family-spine relation using `WhRedCtx E Γ` (which includes `zetaLocal`).
    As shown in `fundamentalFamLR_iff_famLevelAndSlotConv` below, because `whRedCtx_famApp_eq`
    collapses `WhRedCtx` on admitted `.inductiveM` spines to syntactic equality, `FundamentalFamLR`
    is logically equivalent (`↔`) to `FamLevelAndSlotConv`. -/
inductive LRFamSpine (E : ResolvedEnv) (n : Nat) (Γ : LCtx) :
    Expr Nat → Expr Nat → CptFin → Prop
  | spine {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptFin}
      (hm : E.members r = some m)
      (hind : m.mclass = .inductiveM)
      (h : WhRedCtx E Γ A (foldApps (.const r ls) xs))
      (h' : WhRedCtx E Γ A' (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = xs'.length)
      (hslots : RelevantSlotConv E n Γ []
        ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs') :
      LRFamSpine E n Γ A A' (.spine r args)

/-- Restatement `FundamentalFamLR` of `FamLevelAndSlotConv` via `LRFamSpine`. -/
def FundamentalFamLR (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (r : Nat) (m : CheckedMember) (ls ls' : List Level) (xs xs' : List (Expr Nat)) : Prop :=
  E.members r = some m → m.mclass = .inductiveM →
  xs.length = xs'.length →
  TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') →
  LRFamSpine E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')
    (.spine r (botVecFin xs))

/-- Bidirectional equivalence (`↔`) between `LRFamSpine` on two admitted `.inductiveM` family spines
    and `FamLevelAndSlotConv`, using `whRedCtx_famApp_eq` and `foldApps_const_inj`. -/
theorem lrFamSpine_iff_famLevelAndSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)} {args : List CptFin}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hlen : xs.length = xs'.length) :
    LRFamSpine E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')
      (.spine r args) ↔
      FamLevelAndSlotConv E n Γ m ls ls' xs xs' := by
  constructor
  · intro h
    cases h with
    | spine hm' _ hred hred' heqN _ hslots =>
      have e₁ := whRedCtx_famApp_eq hW hm hind hred
      have e₂ := whRedCtx_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs⟩ := foldApps_const_inj e₁
      obtain ⟨hconst₂, hxs'⟩ := foldApps_const_inj e₂
      injection hconst₁ with _ hls
      injection hconst₂ with _ hls'
      subst hls; subst hxs; subst hls'; subst hxs'
      have hm_eq := Option.some.inj (hm.symm.trans hm')
      subst hm_eq
      exact ⟨heqN, hslots⟩
  · rintro ⟨heqN, hslots⟩
    exact .spine hm hind (.refl _) (.refl _) heqN hlen hslots

/-- **Bidirectional Equivalence (`↔`) between `FundamentalFamLR` and `FamLevelAndSlotConv`:**
    Under `EnvWfT E`, `hm : E.members r = some m`, `hind : m.mclass = .inductiveM`,
    `hlen : xs.length = xs'.length`, and `h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')`,
    `FundamentalFamLR E n Γ r m ls ls' xs xs'` is equivalent (`↔`) to
    `FamLevelAndSlotConv E n Γ m ls ls' xs xs'`. -/
theorem fundamentalFamLR_iff_famLevelAndSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hlen : xs.length = xs'.length)
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FundamentalFamLR E n Γ r m ls ls' xs xs' ↔
      FamLevelAndSlotConv E n Γ m ls ls' xs xs' := by
  constructor
  · intro hLR
    exact (lrFamSpine_iff_famLevelAndSlotConv hW hm hind hlen).mp (hLR hm hind hlen h)
  · intro hconv _ _ _ _
    exact (lrFamSpine_iff_famLevelAndSlotConv hW hm hind hlen).mpr hconv

/-- Assemble `famAppRow`'s exact conclusion from `PiRowField`, `ScopedCtx`, and
    `FamLevelAndSlotConv` (`W-F8-FAMAPP-ARG-COMPARISON` + `eqNList`). -/
theorem famAppRow_of_piRow_scoped_famLevelAndSlot
    {Eₐ E : ResolvedEnv} {Aw : Nat → Nat} {tbl : List CRule}
    (hBel : AllBelowScoped Eₐ Aw tbl) (hTbl : TableWF tbl)
    {n : Nat} {Γ : LCtx} (S : ScopedCtx Eₐ E n Γ)
    (hprow : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (hfam : FamLevelAndSlotConv E n Γ m ls ls' xs xs') :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  let sat := famAppSaturation_of_scoped hBel hTbl S hprow hm hind hfam.1 hty h
  exact famAppRow_of_piRow_saturation_slotConv hprow S.env S.ctx sat hfam.2 hm hind hty h

/-- Assemble `famAppRow`'s exact conclusion from `PiRowField`, `ShallowTypeSoundnessFin`,
    `FamSlotSemEqFinSoundness`, `eqNList ls ls'`, and `SemEqFinRelevantSlotReflect`
    (without requiring `AllBelowScoped` or `TableWF`). -/
theorem famAppRow_of_piRow_shallowSoundnessFin_reflect
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (hprow : PiRowField E n) (hshallow : ShallowTypeSoundnessFin E n)
    (hslotSound : FamSlotSemEqFinSoundness E n)
    (hrefl : SemEqFinRelevantSlotReflect E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  let sat := famAppSaturation_of_shallowSoundnessFin hW hΓ hprow hshallow hm hind heqN hty h
  have hslot :=
    relevantSlotConv_of_shallowSoundnessFin_reflect hW hshallow hslotSound hprow hrefl hΓ hm hind hty h
  exact famAppRow_of_piRow_saturation_slotConv hprow hW hΓ sat hslot hm hind hty h


/-! ### §6 — Family-Head Model Fragment & Context-Aware `zetaLocal` Soundness Directly Over `main`'s Ideal Model `CptI` / `EnvI` / `ApproxI` / `SemEqI` / `WhStep` / `WhRed` -/

/-- Pointwise spine argument approximation in `ApproxI`. -/
inductive ApproxIArgs (ρ : EnvI) : List (Expr Nat) → List CptI → Prop
  | nil : ApproxIArgs ρ [] []
  | cons {x : Expr Nat} {u : CptI} {xs : List (Expr Nat)} {us : List CptI}
      (hx : ApproxI ρ x u) (hxs : ApproxIArgs ρ xs us) :
      ApproxIArgs ρ (x :: xs) (u :: us)

theorem approxIArgs_length {ρ : EnvI} {xs : List (Expr Nat)} {us : List CptI}
    (h : ApproxIArgs ρ xs us) : xs.length = us.length := by
  induction h with
  | nil => rfl
  | cons _ _ ih => exact congrArg Nat.succ ih

theorem approxIArgs_snoc {ρ : EnvI} {xs : List (Expr Nat)} {us : List CptI}
    {x : Expr Nat} {u : CptI}
    (hxs : ApproxIArgs ρ xs us) (hx : ApproxI ρ x u) :
    ApproxIArgs ρ (xs ++ [x]) (us ++ [u]) := by
  induction hxs with
  | nil => exact .cons hx .nil
  | cons h₀ _ ih => exact .cons h₀ ih

/-- Left-folded application spine introduction in `ApproxI`. -/
theorem approxI_foldApps_spine {ρ : EnvI} {r : Nat} {f : Expr Nat}
    {args : List CptI} {xs : List (Expr Nat)} {us : List CptI}
    (hf : ApproxI ρ f (.spine r args))
    (hxs : ApproxIArgs ρ xs us) :
    ApproxI ρ (foldApps f xs) (.spine r (args ++ us)) := by
  induction hxs generalizing f args with
  | nil =>
      simp only [foldApps, List.append_nil]
      exact hf
  | cons ha _ ih =>
      simp only [foldApps]
      have hstep := ih (.appSpine hf ha)
      rw [List.append_assoc] at hstep
      exact hstep

/-- Every constant-headed spine `foldApps (.const r ls) xs` is approximated by `.spine r us`
    in `ApproxI` whenever `ApproxIArgs ρ xs us`. -/
theorem approxI_famApp {ρ : EnvI} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {us : List CptI}
    (h : ApproxIArgs ρ xs us) :
    ApproxI ρ (foldApps (.const r ls) xs) (.spine r us) := by
  have h0 := approxI_foldApps_spine (.const ρ r ls) h
  simpa only [List.nil_append] using h0

/-- Inductive spine inversion invariant for `ApproxI`. -/
def IsSpineExprI (ρ : EnvI) (r : Nat) (pre : List (Expr Nat)) (f : Expr Nat) : Prop :=
  ∀ c, ApproxI ρ f c →
    c = .bot ∨ ∃ us, c = .spine r us ∧ ApproxIArgs ρ pre us

theorem isSpineExprI_const (ρ : EnvI) (r : Nat) (ls : List Level) :
    IsSpineExprI ρ r [] (.const r ls) := by
  intro c hc
  rcases approxI_const_inv hc with h0 | h0
  · exact Or.inl h0
  · exact Or.inr ⟨[], h0, .nil⟩

theorem isSpineExprI_app {ρ : EnvI} {r : Nat} {pre : List (Expr Nat)} {f : Expr Nat}
    (hf : IsSpineExprI ρ r pre f) (x : Expr Nat) :
    IsSpineExprI ρ r (pre ++ [x]) (.app f x) := by
  intro c hc
  rcases approxI_app_inv hc with h0 | ⟨g, s, rfl, hfg, _, _⟩ | ⟨r', args, u, rfl, hfs, hxu⟩
  · exact Or.inl h0
  · rcases hf (.lam g) hfg with hbot | ⟨_, hsp, _⟩
    · exact nomatch hbot
    · exact nomatch hsp
  · rcases hf (.spine r' args) hfs with hbot | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · injection hsp with hr hargs
      subst hr; subst hargs
      exact Or.inr ⟨args ++ [u], rfl, approxIArgs_snoc hus hxu⟩

theorem isSpineExprI_foldApps {ρ : EnvI} {r : Nat} :
    ∀ (xs : List (Expr Nat)) {pre : List (Expr Nat)} {f : Expr Nat},
      IsSpineExprI ρ r pre f → IsSpineExprI ρ r (pre ++ xs) (foldApps f xs)
  | [], _, _, hf => by
      rw [List.append_nil]
      exact hf
  | x :: xs, _, _, hf => by
      simp only [foldApps]
      have hstep := isSpineExprI_foldApps xs (isSpineExprI_app hf x)
      rw [List.append_assoc] at hstep
      exact hstep

/-- Inversion of `ApproxI` on a constant-headed application spine `foldApps (.const r ls) xs`. -/
theorem approxI_foldApps_const_inv {ρ : EnvI} {r : Nat} {ls : List Level}
    {xs : List (Expr Nat)} {c : CptI}
    (h : ApproxI ρ (foldApps (.const r ls) xs) c) :
    c = .bot ∨ ∃ us : List CptI, c = .spine r us ∧ ApproxIArgs ρ xs us := by
  have h0 := isSpineExprI_foldApps xs (isSpineExprI_const ρ r ls) c h
  simpa only [List.nil_append] using h0

/-- Canonical `CptI` argument vector with `.bot` at every slot of `xs`. -/
def botVecI : List (Expr Nat) → List CptI
  | [] => []
  | _ :: xs => .bot :: botVecI xs

theorem botVecI_length : ∀ (xs : List (Expr Nat)), (botVecI xs).length = xs.length
  | [] => rfl
  | _ :: xs => congrArg Nat.succ (botVecI_length xs)

theorem approxIArgs_botVecI (ρ : EnvI) :
    ∀ (xs : List (Expr Nat)), ApproxIArgs ρ xs (botVecI xs)
  | [] => .nil
  | x :: xs => .cons (.bot ρ x) (approxIArgs_botVecI ρ xs)

theorem approxI_famApp_botVecI (ρ : EnvI) (r : Nat) (ls : List Level) (xs : List (Expr Nat)) :
    ApproxI ρ (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
  approxI_famApp r ls (approxIArgs_botVecI ρ xs)

/-- Single-slot compact probe vector in `CptI`. -/
def slotVecI : List (Expr Nat) → Nat → CptI → List CptI
  | [], _, _ => []
  | _ :: xs, 0, u => u :: botVecI xs
  | _ :: xs, i + 1, u => .bot :: slotVecI xs i u

theorem approxIArgs_slotVecI {ρ : EnvI} :
    ∀ {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : CptI},
      xs[i]? = some x → ApproxI ρ x u → ApproxIArgs ρ xs (slotVecI xs i u)
  | [], _, _, _, hx, _ => by rw [List.getElem?_nil] at hx; exact Option.noConfusion hx
  | _ :: ys, 0, _, _, hx, hu => by
      rw [List.getElem?_cons_zero] at hx
      injection hx with hyx
      subst hyx
      exact .cons hu (approxIArgs_botVecI ρ ys)
  | y :: _, _ + 1, _, _, hx, hu => by
      rw [List.getElem?_cons_succ] at hx
      exact .cons (.bot ρ y) (approxIArgs_slotVecI hx hu)

theorem approxIArgs_slotVecI_inv {ρ : EnvI} :
    ∀ {xs xs' : List (Expr Nat)} {i : Nat} {x' : Expr Nat} {u : CptI},
      xs'[i]? = some x' → ApproxIArgs ρ xs' (slotVecI xs i u) → ApproxI ρ x' u
  | [], _, _, _, _, hx', h => by
      cases h
      rw [List.getElem?_nil] at hx'; exact Option.noConfusion hx'
  | _ :: _, _ :: _, 0, _, _, hx', .cons hu' _ => by
      rw [List.getElem?_cons_zero] at hx'
      injection hx' with hyx'
      subst hyx'
      exact hu'
  | _ :: _, _ :: _, _ + 1, _, _, hx', .cons _ htail => by
      rw [List.getElem?_cons_succ] at hx'
      exact approxIArgs_slotVecI_inv hx' htail

theorem approxI_famApp_slotVecI {ρ : EnvI} (r : Nat) (ls : List Level)
    {xs : List (Expr Nat)} {i : Nat} {x : Expr Nat} {u : CptI}
    (hx : xs[i]? = some x) (hu : ApproxI ρ x u) :
    ApproxI ρ (foldApps (.const r ls) xs) (.spine r (slotVecI xs i u)) :=
  approxI_famApp r ls (approxIArgs_slotVecI hx hu)

/-- Model family-head and spine-length injectivity in `SemEqI`. -/
theorem semEqI_famApp_head_length {ρ : EnvI} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqI ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hR := (h (.spine r (botVecI xs))).mp (approxI_famApp_botVecI ρ r ls xs)
  rcases approxI_foldApps_const_inv hR with hbot | ⟨us, hsp, hus⟩
  · exact nomatch hbot
  · injection hsp with hr hus_eq
    subst hr; subst hus_eq
    exact ⟨rfl, (botVecI_length xs).symm.trans (approxIArgs_length hus).symm⟩

/-- Model slotwise argument injectivity in `SemEqI`. -/
theorem semEqI_famApp_slot {ρ : EnvI} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqI ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs'))
    {i : Nat} {x x' : Expr Nat}
    (hx : xs[i]? = some x) (hx' : xs'[i]? = some x') :
    SemEqI ρ x x' := by
  intro u
  constructor
  · intro hu
    have hR := (h (.spine r (slotVecI xs i u))).mp (approxI_famApp_slotVecI r ls hx hu)
    rcases approxI_foldApps_const_inv hR with hbot | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxIArgs_slotVecI_inv hx' hus
  · intro hu'
    have hL := (h (.spine r' (slotVecI xs' i u))).mpr (approxI_famApp_slotVecI r' ls' hx' hu')
    rcases approxI_foldApps_const_inv hL with hbot | ⟨us, hsp, hus⟩
    · exact nomatch hbot
    · injection hsp with _ hus_eq
      subst hus_eq
      exact approxIArgs_slotVecI_inv hx hus

/-- Full model family-head injectivity in `SemEqI`. -/
theorem semEqI_famApp_inj {ρ : EnvI} {r r' : Nat} {ls ls' : List Level}
    {xs xs' : List (Expr Nat)}
    (h : SemEqI ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI ρ x x' :=
  ⟨(semEqI_famApp_head_length h).1,
   (semEqI_famApp_head_length h).2,
   fun _ _ _ hx hx' => semEqI_famApp_slot h hx hx'⟩

/-- Π-types and constant-headed spines are disjoint in `SemEqI`. -/
theorem semEqI_pi_famApp_disjoint {ρ : EnvI} {A B : Expr Nat}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (h : SemEqI ρ (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hprobe := (h (.spine r (botVecI xs))).mpr (approxI_famApp_botVecI ρ r ls xs)
  rcases approxI_pi_inv hprobe with hbot | ⟨_, _, heq, _, _⟩
  · cases hbot
  · cases heq

/-- Sorts and constant-headed spines are disjoint in `SemEqI`. -/
theorem semEqI_sort_famApp_disjoint {ρ : EnvI} {l : Level}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (h : SemEqI ρ (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hprobe := (h (.spine r (botVecI xs))).mpr (approxI_famApp_botVecI ρ r ls xs)
  rcases approxI_sort_inv hprobe with hbot | heq
  · cases hbot
  · cases heq

theorem SemEqI.refl (ρ : EnvI) (a : Expr Nat) : SemEqI ρ a a :=
  fun _ => Iff.rfl

theorem SemEqI.symm {ρ : EnvI} {a b : Expr Nat} (h : SemEqI ρ a b) : SemEqI ρ b a :=
  fun c => (h c).symm

theorem SemEqI.trans {ρ : EnvI} {a b d : Expr Nat}
    (h₁ : SemEqI ρ a b) (h₂ : SemEqI ρ b d) : SemEqI ρ a d :=
  fun c => (h₁ c).trans (h₂ c)

theorem semEqI_pi {ρ : EnvI} {A A' B B' : Expr Nat}
    (hA : SemEqI ρ A A')
    (hB : ∀ S : CptI → Prop, SemEqI (EnvI.cons S ρ) B B') :
    SemEqI ρ (.pi A B) (.pi A' B') := by
  intro c
  constructor
  · intro h
    rcases approxI_pi_inv h with h0 | ⟨a, f, heq, ha, hf⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .pi ((hA a).mp ha) (fun s hs => (hB (demand s.1) s.2).mp (hf s hs))
  · intro h
    rcases approxI_pi_inv h with h0 | ⟨a, f, heq, ha, hf⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .pi ((hA a).mpr ha) (fun s hs => (hB (demand s.1) s.2).mpr (hf s hs))

theorem semEqI_lam {ρ : EnvI} {A A' b b' : Expr Nat}
    (hb : ∀ S : CptI → Prop, SemEqI (EnvI.cons S ρ) b b') :
    SemEqI ρ (.lam A b) (.lam A' b') := by
  intro c
  constructor
  · intro h
    rcases approxI_lam_inv h with h0 | ⟨f, heq, hf⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .lam (fun s hs => (hb (demand s.1) s.2).mp (hf s hs))
  · intro h
    rcases approxI_lam_inv h with h0 | ⟨f, heq, hf⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .lam (fun s hs => (hb (demand s.1) s.2).mpr (hf s hs))

theorem semEqI_app {ρ : EnvI} {f f' a a' : Expr Nat}
    (hf : SemEqI ρ f f') (ha : SemEqI ρ a a') :
    SemEqI ρ (.app f a) (.app f' a') := by
  intro c
  constructor
  · intro h
    rcases approxI_app_inv h with h0 | ⟨g, s, heq, hfg, hs, hau⟩ | ⟨r, args, u, heq, hfs, hau⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .app ((hf (.lam g)).mp hfg) hs (fun u hu => (ha u).mp (hau u hu))
    · subst heq
      exact .appSpine ((hf (.spine r args)).mp hfs) ((ha u).mp hau)
  · intro h
    rcases approxI_app_inv h with h0 | ⟨g, s, heq, hfg, hs, hau⟩ | ⟨r, args, u, heq, hfs, hau⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .app ((hf (.lam g)).mpr hfg) hs (fun u hu => (ha u).mpr (hau u hu))
    · subst heq
      exact .appSpine ((hf (.spine r args)).mpr hfs) ((ha u).mpr hau)

theorem semEqI_letE {ρ : EnvI} {A A' v v' b b' : Expr Nat}
    (hv : SemEqI ρ v v')
    (hb : ∀ S : CptI → Prop, SemEqI (EnvI.cons S ρ) b b') :
    SemEqI ρ (.letE A v b) (.letE A' v' b') := by
  have happ : SemEqI ρ (.app (.lam A b) v) (.app (.lam A' b') v') :=
    semEqI_app (semEqI_lam hb) hv
  intro c
  constructor
  · intro h
    rcases approxI_letE_inv h with h0 | h'
    · subst h0; exact .bot _ _
    · exact .letE ((happ c).mp h')
  · intro h
    rcases approxI_letE_inv h with h0 | h'
    · subst h0; exact .bot _ _
    · exact .letE ((happ c).mpr h')

theorem semEqI_lit (ρ : EnvI) (t : Nat) :
    SemEqI ρ (.lit t) (natExpand t) := by
  intro c
  constructor
  · intro h
    rcases approxI_lit_inv h with h0 | h'
    · subst h0; exact .bot _ _
    · exact h'
  · intro h
    exact .lit h

theorem semEqI_sorts (ρ : EnvI) (u v : Level) :
    SemEqI ρ (.sort u) (.sort v) := by
  intro c
  constructor <;> (
    intro h
    rcases approxI_sort_inv h with h0 | h0 <;> subst h0
    · exact .bot _ _
    · exact .sort _ _)

theorem semEqI_consts (ρ : EnvI) (r : Nat) (ls ls' : List Level) :
    SemEqI ρ (.const r ls) (.const r ls') := by
  intro c
  constructor <;> (
    intro h
    rcases approxI_const_inv h with h0 | h0 <;> subst h0
    · exact .bot _ _
    · exact .const _ _ _)

/-- Pointwise semantic equality for spine argument lists in `SemEqI`. -/
inductive SemEqIArgs (ρ : EnvI) : List (Expr Nat) → List (Expr Nat) → Prop
  | nil : SemEqIArgs ρ [] []
  | cons {x x' : Expr Nat} {xs xs' : List (Expr Nat)}
      (hx : SemEqI ρ x x') (hxs : SemEqIArgs ρ xs xs') :
      SemEqIArgs ρ (x :: xs) (x' :: xs')

theorem semEqI_foldApps {ρ : EnvI} {f f' : Expr Nat} {xs xs' : List (Expr Nat)}
    (hf : SemEqI ρ f f') (hxs : SemEqIArgs ρ xs xs') :
    SemEqI ρ (foldApps f xs) (foldApps f' xs') := by
  induction hxs generalizing f f' with
  | nil => exact hf
  | cons hx _ ih => exact ih (semEqI_app hf hx)

theorem semEqI_famApp_congr {ρ : EnvI} (r : Nat) (ls ls' : List Level)
    {xs xs' : List (Expr Nat)} (hxs : SemEqIArgs ρ xs xs') :
    SemEqI ρ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') :=
  semEqI_foldApps (semEqI_consts ρ r ls ls') hxs

/-- Soundness of `FamCongrFrag` in `SemEqI`. -/
theorem semEqI_of_famCongrFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCongrFrag E n h) : ∀ ρ : EnvI, SemEqI ρ a b := by
  induction hh with
  | refl => intro ρ; exact SemEqI.refl ρ _
  | symm _ ih => intro ρ; exact SemEqI.symm (ih ρ)
  | trans _ _ ih₁ ih₂ => intro ρ; exact SemEqI.trans (ih₁ ρ) (ih₂ ρ)
  | pi _ _ ih₁ ih₂ => intro ρ; exact semEqI_pi (ih₁ ρ) (fun S => ih₂ (EnvI.cons S ρ))
  | lam _ _ _ ih₂ => intro ρ; exact semEqI_lam (fun S => ih₂ (EnvI.cons S ρ))
  | app _ _ ih₁ ih₂ => intro ρ; exact semEqI_app (ih₁ ρ) (ih₂ ρ)
  | letE _ _ _ _ ihv ihb => intro ρ; exact semEqI_letE (ihv ρ) (fun S => ihb (EnvI.cons S ρ))
  | @lit _ t _ _ hl _ =>
      intro ρ
      cases hl
      exact semEqI_lit ρ t
  | tyConv _ ih => intro ρ; exact ih ρ
  | sorts => intro ρ; exact semEqI_sorts ρ _ _
  | consts => intro ρ; exact semEqI_consts ρ _ _ _

/-- **Unconditional** soundness of `FamBetaZetaFrag` (including arbitrary `beta` and `zeta`)
    in `SemEqI`. -/
theorem semEqI_of_famBetaZetaFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamBetaZetaFrag E n h) : ∀ ρ : EnvI, SemEqI ρ a b := by
  induction hh with
  | ofCongr hh => intro ρ; exact semEqI_of_famCongrFrag hh ρ
  | symm _ ih => intro ρ; exact SemEqI.symm (ih ρ)
  | trans _ _ ih₁ ih₂ => intro ρ; exact SemEqI.trans (ih₁ ρ) (ih₂ ρ)
  | pi _ _ ih₁ ih₂ => intro ρ; exact semEqI_pi (ih₁ ρ) (fun S => ih₂ (EnvI.cons S ρ))
  | lam _ _ _ ih₂ => intro ρ; exact semEqI_lam (fun S => ih₂ (EnvI.cons S ρ))
  | app _ _ ih₁ ih₂ => intro ρ; exact semEqI_app (ih₁ ρ) (ih₂ ρ)
  | letE _ _ _ _ ihv ihb => intro ρ; exact semEqI_letE (ihv ρ) (fun S => ihb (EnvI.cons S ρ))
  | beta => intro ρ; exact approxI_beta ρ _ _ _
  | zeta => intro ρ; exact approxI_zeta ρ _ _ _
  | tyConv _ ih => intro ρ; exact ih ρ

/-- Unconditional family-spine injectivity for `FamBetaZetaFrag` in `SemEqI`. -/
theorem famBetaZetaFrag_famApp_semInjI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamBetaZetaFrag E n h) (ρ : EnvI) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI ρ x x' :=
  semEqI_famApp_inj (semEqI_of_famBetaZetaFrag hh ρ)

/-- Unconditional `lift 0 1` equivalence under `EnvI.cons S ρ`. -/
theorem approxI_cons_lift0_iff (ρ : EnvI) (S : CptI → Prop) (e : Expr Nat) (c : CptI) :
    ApproxI (EnvI.cons S ρ) (lift 0 1 e) c ↔ ApproxI ρ e c := by
  rw [← EnvI.insert_zero S ρ]
  exact ⟨approxI_lift_elim e, fun h => approxI_lift_intro h 0 S⟩

theorem semEqI_cons_lift0 {ρ : EnvI} {a b : Expr Nat} (S : CptI → Prop)
    (h : SemEqI ρ a b) :
    SemEqI (EnvI.cons S ρ) (lift 0 1 a) (lift 0 1 b) := fun c => by
  rw [approxI_cons_lift0_iff, approxI_cons_lift0_iff]
  exact h c

/-- Exact substitution-environment characterization of `.letE` in `ApproxI`. -/
theorem approxI_letE_iff_substEnv (ρ : EnvI) (A v b : Expr Nat) (c : CptI) :
    ApproxI ρ (.letE A v b) c ↔ ApproxI (EnvI.cons (denI ρ v) ρ) b c := by
  rw [approxI_zeta ρ A v b c]
  unfold instantiate0
  constructor
  · intro h
    have h₁ : ApproxI ρ (instantiate 0 (lift 0 0 v) b) c := by rwa [lift_zero_idx]
    have h₂ := approxI_subst_elim b h₁
    rwa [EnvI.insert_zero, EnvI.drop_zero] at h₂
  · intro h
    have h₁ := approxI_subst_intro h ρ 0 v (by rw [EnvI.insert_zero, EnvI.drop_zero])
    rwa [lift_zero_idx] at h₁

theorem semEqI_letE_exact {ρ : EnvI} {A A' v v' b b' : Expr Nat}
    (hv : SemEqI ρ v v')
    (hb : SemEqI (EnvI.cons (denI ρ v) ρ) b b') :
    SemEqI ρ (.letE A v b) (.letE A' v' b') := fun c => by
  have hden : denI ρ v = denI ρ v' := by
    funext d; exact propext (hv d)
  rw [approxI_letE_iff_substEnv, approxI_letE_iff_substEnv, ← hden]
  exact hb c

/-- Context-agreement predicate for `EnvI`: every let-bound variable `i` in `Γ` with
    `lookupValue Γ i = some v` is semantically equal to `v` at `ρ`. -/
def CtxEnvI (Γ : LCtx) (ρ : EnvI) : Prop :=
  ∀ (i : Nat) (v : Expr Nat), lookupValue Γ i = some v → SemEqI ρ (.bvar i) v

/-- The degenerate singleton set `{⊥}` in `CptI`. -/
def botSetI : CptI → Prop := fun c => c = .bot

/-- Canonical context-aware environment `ctxEnvI Γ : EnvI`. -/
def ctxEnvI : LCtx → EnvI
  | [] => EnvI.bot
  | .assumption _ :: Γ => EnvI.cons botSetI (ctxEnvI Γ)
  | .letBinding _ v :: Γ => EnvI.cons (denI (ctxEnvI Γ) v) (ctxEnvI Γ)

/-- `ctxEnvI Γ` satisfies `CtxEnvI Γ (ctxEnvI Γ)` for every local context `Γ`. -/
theorem ctxEnvI_respects : ∀ (Γ : LCtx), CtxEnvI Γ (ctxEnvI Γ)
  | [] => fun i _ hw => by cases i <;> exact nomatch hw
  | .assumption A :: Γ => by
      intro i w hw
      cases i with
      | zero => exact nomatch hw
      | succ j =>
        rw [lookupValue_cons_succ] at hw
        cases h : lookupValue Γ j with
        | none => rw [h] at hw; exact nomatch hw
        | some v₀ =>
          rw [h] at hw
          injection hw with hw_eq
          subst hw_eq
          intro c
          have hsucc : ApproxI (ctxEnvI (.assumption A :: Γ)) (.bvar (j + 1)) c ↔
              ApproxI (ctxEnvI Γ) (.bvar j) c := by
            constructor <;> (
              intro hb
              rcases approxI_bvar_inv hb with rfl | h0
              · exact .bot _ _
              · exact .bvar h0)
          exact hsucc.trans
            ((ctxEnvI_respects Γ j v₀ h c).trans
              (approxI_cons_lift0_iff (ctxEnvI Γ) botSetI v₀ c).symm)
  | .letBinding A v :: Γ => by
      intro i w hw
      cases i with
      | zero =>
        injection hw with hw_eq
        subst hw_eq
        intro c
        have hzero : ApproxI (ctxEnvI (.letBinding A v :: Γ)) (.bvar 0) c ↔
            ApproxI (ctxEnvI Γ) v c := by
          constructor
          · intro hb
            rcases approxI_bvar_inv hb with rfl | h0
            · exact .bot _ _
            · exact h0
          · intro hv
            exact .bvar hv
        exact hzero.trans (approxI_cons_lift0_iff (ctxEnvI Γ) (denI (ctxEnvI Γ) v) v c).symm
      | succ j =>
        rw [lookupValue_cons_succ] at hw
        cases h : lookupValue Γ j with
        | none => rw [h] at hw; exact nomatch hw
        | some v₀ =>
          rw [h] at hw
          injection hw with hw_eq
          subst hw_eq
          intro c
          have hsucc : ApproxI (ctxEnvI (.letBinding A v :: Γ)) (.bvar (j + 1)) c ↔
              ApproxI (ctxEnvI Γ) (.bvar j) c := by
            constructor <;> (
              intro hb
              rcases approxI_bvar_inv hb with rfl | h0
              · exact .bot _ _
              · exact .bvar h0)
          exact hsucc.trans
            ((ctxEnvI_respects Γ j v₀ h c).trans
              (approxI_cons_lift0_iff (ctxEnvI Γ) (denI (ctxEnvI Γ) v) v₀ c).symm)

/-- **Unconditional `ConvT.zetaLocal` soundness in `ApproxI`:**
    At every environment `ρ` satisfying `CtxEnvI Γ ρ` (in particular `ctxEnvI Γ`),
    if `lookupValue Γ i = some v`, then `.bvar i` and `v` are semantically equal. -/
theorem semEqI_zetaLocal {Γ : LCtx} {ρ : EnvI} (hctx : CtxEnvI Γ ρ)
    {i : Nat} {v : Expr Nat} (hv : lookupValue Γ i = some v) :
    SemEqI ρ (.bvar i) v :=
  hctx i v hv

/-- **Unconditional 14-Constructor (`FamBetaZetaLocalFrag`) Soundness in `ApproxI`:**
    Every derivation in `FamBetaZetaLocalFrag E n` (including arbitrary `beta`, `zeta`,
    and context-dependent `zetaLocal`) is sound at every `ρ` satisfying `CtxEnvI Γ ρ`
    (and hence unconditionally at `ctxEnvI Γ`). -/
theorem semEqI_of_famBetaZetaLocalFrag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamBetaZetaLocalFrag E n h) :
    ∀ (ρ : EnvI), CtxEnvI Γ ρ → SemEqI ρ a b := by
  induction hh with
  | ofBetaZeta hh => intro ρ _; exact semEqI_of_famBetaZetaFrag hh ρ
  | @zetaLocal _ _ _ _ hval _ _ => intro ρ hctx; exact semEqI_zetaLocal hctx hval
  | symm _ ih => intro ρ hctx; exact SemEqI.symm (ih ρ hctx)
  | trans _ _ ih₁ ih₂ => intro ρ hctx; exact SemEqI.trans (ih₁ ρ hctx) (ih₂ ρ hctx)
  | pi _ _ ih₁ ih₂ =>
      intro ρ hctx
      refine semEqI_pi (ih₁ ρ hctx) (fun S => ih₂ (EnvI.cons S ρ) ?_)
      intro i w hw
      cases i with
      | zero => exact nomatch hw
      | succ j =>
        rw [lookupValue_cons_succ] at hw
        cases h : lookupValue _ j with
        | none => rw [h] at hw; exact nomatch hw
        | some v₀ =>
          rw [h] at hw
          injection hw with hw_eq
          subst hw_eq
          intro c
          have hsucc : ApproxI (EnvI.cons S ρ) (.bvar (j + 1)) c ↔ ApproxI ρ (.bvar j) c := by
            constructor <;> (
              intro hb
              rcases approxI_bvar_inv hb with rfl | h0
              · exact .bot _ _
              · exact .bvar h0)
          exact hsucc.trans ((hctx j v₀ h c).trans (approxI_cons_lift0_iff ρ S v₀ c).symm)
  | lam _ _ _ ih₂ =>
      intro ρ hctx
      refine semEqI_lam (fun S => ih₂ (EnvI.cons S ρ) ?_)
      intro i w hw
      cases i with
      | zero => exact nomatch hw
      | succ j =>
        rw [lookupValue_cons_succ] at hw
        cases h : lookupValue _ j with
        | none => rw [h] at hw; exact nomatch hw
        | some v₀ =>
          rw [h] at hw
          injection hw with hw_eq
          subst hw_eq
          intro c
          have hsucc : ApproxI (EnvI.cons S ρ) (.bvar (j + 1)) c ↔ ApproxI ρ (.bvar j) c := by
            constructor <;> (
              intro hb
              rcases approxI_bvar_inv hb with rfl | h0
              · exact .bot _ _
              · exact .bvar h0)
          exact hsucc.trans ((hctx j v₀ h c).trans (approxI_cons_lift0_iff ρ S v₀ c).symm)
  | app _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqI_app (ih₁ ρ hctx) (ih₂ ρ hctx)
  | letE _ _ _ _ ihv ihb =>
      intro ρ hctx
      refine semEqI_letE_exact (ihv ρ hctx) (ihb _ ?_)
      intro i w hw
      cases i with
      | zero =>
        injection hw with hw_eq
        subst hw_eq
        intro c
        refine Iff.trans ?_ (approxI_cons_lift0_iff ρ _ _ c).symm
        constructor
        · intro hb
          rcases approxI_bvar_inv hb with rfl | h0
          · exact .bot _ _
          · exact h0
        · intro hv
          exact .bvar hv
      | succ j =>
        rw [lookupValue_cons_succ] at hw
        cases h : lookupValue _ j with
        | none => rw [h] at hw; exact nomatch hw
        | some v₀ =>
          rw [h] at hw
          injection hw with hw_eq
          subst hw_eq
          intro c
          refine Iff.trans ?_ ((hctx j v₀ h c).trans (approxI_cons_lift0_iff ρ _ v₀ c).symm)
          constructor <;> (
            intro hb
            rcases approxI_bvar_inv hb with rfl | h0
            · exact .bot _ _
            · exact .bvar h0)
  | tyConv _ ih => intro ρ hctx; exact ih ρ hctx

/-- Unconditional family-spine injectivity for the 14-constructor fragment
    `FamBetaZetaLocalFrag` in `ApproxI` at `ctxEnvI Γ`. -/
theorem famBetaZetaLocalFrag_famApp_semInjI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamBetaZetaLocalFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI (ctxEnvI Γ) x x' :=
  semEqI_famApp_inj (semEqI_of_famBetaZetaLocalFrag hh (ctxEnvI Γ) (ctxEnvI_respects Γ))

/-- Auxiliary lemma: no expression of the form `foldApps (.const r ls) xs` for an
    `.inductiveM` family `r` under `EnvWfT E` can take a `PiModelIdealAudit.WhStep E` step. -/
theorem whStep_famApp_false_aux {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {a b : Expr Nat} (h : WhStep E a b) :
    ∀ (xs : List (Expr Nat)), a = foldApps (.const r ls) xs → False := by
  induction h with
  | beta =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hpre _
        rcases list_eq_nil_or_snoc pre with rfl | ⟨pre', y, rfl⟩
        · exact Expr.noConfusion hpre
        · rw [foldApps_snoc] at hpre
          exact Expr.noConfusion hpre
  | zeta =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | delta hres hbody =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · injection heq with hr _
        subst hr
        rw [hm] at hres
        injection hres with hm'
        subst hm'
        have hnone := familyNoBody_of_envWfT hW _ m hm hind
        rw [hnone] at hbody
        exact Option.noConfusion hbody
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | iota hI =>
      intro xs heq
      subst heq
      exact derivedIotaU_famApp_false hm hind hI
  | lit =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        exact Expr.noConfusion heq
  | appHead _ ih =>
      intro xs heq
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
      · exact Expr.noConfusion heq
      · rw [foldApps_snoc] at heq
        injection heq with hpre _
        exact ih pre hpre

/-- Admitted inductive family spines `foldApps (.const r ls) xs` are weak-head normal
    under `PiModelIdealAudit.WhStep E` (`EnvWfT E`). -/
theorem whStep_famApp_false {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} (xs : List (Expr Nat)) {e : Expr Nat}
    (h : WhStep E (foldApps (.const r ls) xs) e) : False :=
  whStep_famApp_false_aux hW hm hind h xs rfl

/-- Weak-head reduction `PiModelIdealAudit.WhRed E` from an admitted inductive family spine
    `foldApps (.const r ls) xs` is trivial (`e = foldApps (.const r ls) xs`). -/
theorem whRed_famApp_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {e : Expr Nat}
    (h : WhRed E (foldApps (.const r ls) xs) e) :
    e = foldApps (.const r ls) xs := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStep_famApp_false hW hm hind xs hs).elim


/-! ### §7 — Family-Head Finitary Projection Dichotomy (`IsPropC` / `CTy` / `tprojI` / `PEqI`), `LRTypeIN` Normal-Spine Characterization, and Full 18-Constructor `ConvT` Soundness Over `main`'s Ideal Model (`RcicNativePiModelIrr` + `RcicNativePiModelLRCases`) -/

/-! #### Part A — Family-Head Proof-Irrelevance & Finitary Projection Dichotomy Over `RcicNativePiModelIrr` -/

/-- Exact characterization of `IsPropC E (.spine r args)` (`RcicNativePiModelIrr`):
    a spine code `.spine r args` is a proposition code iff `r` resolves to a member `m`
    with `piBody m.mtype = .sort .zero`. -/
theorem isPropC_spine_iff {E : ResolvedEnv} {r : Nat} {args : List CptI} :
    IsPropC E (.spine r args) ↔
      ∃ m : CheckedMember, E.members r = some m ∧ piBody m.mtype = .sort .zero := by
  constructor
  · intro h
    cases h with
    | spine hres hsort => exact ⟨_, hres, hsort⟩
  · rintro ⟨m, hres, hsort⟩
    exact .spine hres hsort

/-- For an admitted `.inductiveM` family `r` under `EnvWfT E`, `.spine r args` is a
    proposition code (`IsPropC E (.spine r args)`) iff its terminal sort level
    `inductiveSortLevel hW hm hind` is `.zero`. -/
theorem isPropC_spine_inductiveM_iff {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (args : List CptI) :
    IsPropC E (.spine r args) ↔ inductiveSortLevel hW hm hind = .zero := by
  rw [isPropC_spine_iff]
  constructor
  · rintro ⟨m', hm', hsort⟩
    have hm_eq : m' = m := Option.some.inj (hm'.symm.trans hm)
    subst hm_eq
    have hbody := piBody_mtype_of_inductiveM hW hm hind
    rw [hbody] at hsort
    injection hsort
  · intro hzero
    exact ⟨m, hm, (piBody_mtype_of_inductiveM hW hm hind).trans (congrArg Expr.sort hzero)⟩

/-- When `inductiveSortLevel hW hm hind = .zero`, every spine compact `.spine r args` is a
    proposition code (`IsPropC E`). -/
theorem isPropC_spine_of_inductiveSortLevel_zero {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (args : List CptI) (hzero : inductiveSortLevel hW hm hind = .zero) :
    IsPropC E (.spine r args) :=
  (isPropC_spine_inductiveM_iff hW hm hind args).mpr hzero

/-- When `inductiveSortLevel hW hm hind ≠ .zero`, no spine compact `.spine r args` is a
    proposition code (`¬ IsPropC E (.spine r args)`). -/
theorem not_isPropC_spine_of_inductiveSortLevel_ne_zero {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (args : List CptI) (hne : inductiveSortLevel hW hm hind ≠ .zero) :
    ¬ IsPropC E (.spine r args) :=
  fun h => hne ((isPropC_spine_inductiveM_iff hW hm hind args).mp h)

/-- Exact characterization of `IsPropIdealI E (denI ρ (foldApps (.const r ls) xs))`:
    at any environment `ρ : EnvI`, a family spine `foldApps (.const r ls) xs` denotes a
    proposition ideal iff `r` resolves to a member `m` with `piBody m.mtype = .sort .zero`. -/
theorem isPropIdealI_famApp_iff {E : ResolvedEnv} (ρ : EnvI)
    (r : Nat) (ls : List Level) (xs : List (Expr Nat)) :
    IsPropIdealI E (denI ρ (foldApps (.const r ls) xs)) ↔
      ∃ m : CheckedMember, E.members r = some m ∧ piBody m.mtype = .sort .zero := by
  constructor
  · intro hP
    have hsp : IsPropC E (.spine r (botVecI xs)) :=
      hP (.spine r (botVecI xs)) (approxI_famApp_botVecI ρ r ls xs)
    exact isPropC_spine_iff.mp hsp
  · rintro ⟨m, hm, hsort⟩ c hc
    rcases approxI_foldApps_const_inv hc with rfl | ⟨_, rfl, _⟩
    · exact .bot
    · exact .spine hm hsort

/-- For an admitted `.inductiveM` family `r` under `EnvWfT E`, `denI ρ (foldApps (.const r ls) xs)`
    is a proposition ideal (`IsPropIdealI E`) iff `inductiveSortLevel hW hm hind = .zero`. -/
theorem isPropIdealI_famApp_inductiveM_iff {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    IsPropIdealI E (denI ρ (foldApps (.const r ls) xs)) ↔
      inductiveSortLevel hW hm hind = .zero := by
  rw [isPropIdealI_famApp_iff]
  constructor
  · rintro ⟨m', hm', hsort⟩
    have hm_eq : m' = m := Option.some.inj (hm'.symm.trans hm)
    subst hm_eq
    have hbody := piBody_mtype_of_inductiveM hW hm hind
    rw [hbody] at hsort
    injection hsort
  · intro hzero
    exact ⟨m, hm, (piBody_mtype_of_inductiveM hW hm hind).trans (congrArg Expr.sort hzero)⟩

/-- When `inductiveSortLevel hW hm hind = .zero`, `denI ρ (foldApps (.const r ls) xs)` is a
    proposition ideal at **every** environment `ρ : EnvI` (unconditionally, with no `EnvFitsSem`
    or `PropDen` assumption). -/
theorem isPropIdealI_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero) :
    IsPropIdealI E (denI ρ (foldApps (.const r ls) xs)) :=
  (isPropIdealI_famApp_inductiveM_iff hW ρ hm hind ls xs).mpr hzero

/-- When `inductiveSortLevel hW hm hind ≠ .zero`, `denI ρ (foldApps (.const r ls) xs)` is
    never a proposition ideal at any environment `ρ : EnvI`. -/
theorem not_isPropIdealI_famApp_of_ne_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero) :
    ¬ IsPropIdealI E (denI ρ (foldApps (.const r ls) xs)) :=
  fun h => hne ((isPropIdealI_famApp_inductiveM_iff hW ρ hm hind ls xs).mp h)

/-- **Finitary Projection Dichotomy — `Prop` Family Branch (`tprojI_famApp_of_zero`):**
    For a `Prop`-valued admitted inductive family `r` (`inductiveSortLevel hW hm hind = .zero`),
    the typed projector `tprojI E (denI ρ (foldApps (.const r ls) xs))` collapses every term
    denotation `denI ρ e` to `{.bot}` at **every** environment `ρ : EnvI`. -/
theorem tprojI_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (e : Expr Nat) (u : CptI) :
    tprojI E (denI ρ (foldApps (.const r ls) xs)) (denI ρ e) u ↔ u = .bot :=
  tprojI_prop (isPropIdealI_famApp_of_zero hW ρ hm hind ls xs hzero)
    (denI_bot ρ (foldApps (.const r ls) xs)) (denI_bot ρ e) u

/-- **Unconditional `PEqI` Proof Irrelevance on Concrete `Prop`-Family Spines
    (`pEqI_irr_famApp_of_zero`):**
    For a `Prop`-valued admitted inductive family `r` (`inductiveSortLevel hW hm hind = .zero`),
    any two proof terms `p, q : Expr Nat` are projected-equal (`PEqI E ρ (foldApps (.const r ls) xs) p q`)
    at **every** environment `ρ : EnvI`, with zero `PropDen` or `EnvFitsSem` hypotheses
    (unaffected by the O1 universe-collapse obstruction on open proposition variables). -/
theorem pEqI_irr_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (p q : Expr Nat) :
    PEqI E ρ (foldApps (.const r ls) xs) p q :=
  pEqI_irr (isPropIdealI_famApp_of_zero hW ρ hm hind ls xs hzero) p q

/-- Impredicative `policyPi` closure of `IsPropIdealI`: if `R` denotes a proposition ideal at
    every environment `ρ : EnvI`, then `policyPi doms R` denotes a proposition ideal at every `ρ`. -/
theorem isPropIdealI_policyPi_of_body {E : ResolvedEnv} {R : Expr Nat}
    (hR : ∀ ρ : EnvI, IsPropIdealI E (denI ρ R)) :
    ∀ (doms : List (Expr Nat)) (ρ : EnvI), IsPropIdealI E (denI ρ (policyPi doms R))
  | [], ρ => hR ρ
  | _ :: doms, ρ =>
      isPropIdealI_pi_of_cod E
        (fun us => isPropIdealI_policyPi_of_body hR doms (EnvI.cons (demand us) ρ))

/-- Any `policyPi` telescope ending in a `Prop`-valued admitted inductive family spine
    `foldApps (.const r ls) xs` (`inductiveSortLevel hW hm hind = .zero`) denotes a proposition
    ideal at every environment `ρ : EnvI`. -/
theorem isPropIdealI_policyPi_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (doms : List (Expr Nat)) (ρ : EnvI) :
    IsPropIdealI E (denI ρ (policyPi doms (foldApps (.const r ls) xs))) :=
  isPropIdealI_policyPi_of_body
    (fun ρ' => isPropIdealI_famApp_of_zero hW ρ' hm hind ls xs hzero) doms ρ

/-- Unconditional `PEqI` proof irrelevance at any `policyPi` telescope ending in a `Prop`-valued
    admitted inductive family spine `foldApps (.const r ls) xs`. -/
theorem pEqI_irr_policyPi_famApp_of_zero {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hzero : inductiveSortLevel hW hm hind = .zero)
    (doms : List (Expr Nat)) (ρ : EnvI) (p q : Expr Nat) :
    PEqI E ρ (policyPi doms (foldApps (.const r ls) xs)) p q :=
  pEqI_irr (isPropIdealI_policyPi_famApp_of_zero hW hm hind ls xs hzero doms ρ) p q

/-- **Finitary Projection Dichotomy — Universe Branch (`tprojI_sort_on_spine`):**
    At any universe `.sort u`, the typed projector `tprojI E (denI ρ (.sort u))` acts as the
    **identity** on every constant-headed spine `foldApps (.const r ls) xs`. -/
theorem tprojI_sort_on_spine (E : ResolvedEnv) (ρ : EnvI) (u : Level)
    (r : Nat) (ls : List Level) (xs : List (Expr Nat)) (c : CptI) :
    tprojI E (denI ρ (.sort u)) (denI ρ (foldApps (.const r ls) xs)) c ↔
      denI ρ (foldApps (.const r ls) xs) c := by
  constructor
  · intro h
    exact h.1
  · intro hc
    rcases approxI_foldApps_const_inv hc with rfl | ⟨us, rfl, _⟩
    · exact tprojI_bot E ρ (.sort u) (foldApps (.const r ls) xs)
    · exact ⟨hc, .sort, .sort ρ u, .univ (.spine r us)⟩

/-- Projected equality `PEqI E ρ (.sort u)` between two constant-headed spines is logically
    equivalent (`↔`) to untyped semantic equality `SemEqI ρ`. -/
theorem pEqI_sort_famApp_iff_semEqI (E : ResolvedEnv) (ρ : EnvI) (u : Level)
    (r r' : Nat) (ls ls' : List Level) (xs xs' : List (Expr Nat)) :
    PEqI E ρ (.sort u) (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') ↔
      SemEqI ρ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') := by
  constructor
  · intro hp c
    exact (tprojI_sort_on_spine E ρ u r ls xs c).symm.trans
      ((hp c).trans (tprojI_sort_on_spine E ρ u r' ls' xs' c))
  · intro hs
    exact pEqI_of_semEqI hs

/-- Projected equality `PEqI E ρ (.sort u)` between two constant-headed spines implies
    `r = r'`, `xs.length = xs'.length`, and slotwise `SemEqI ρ x x'`. -/
theorem pEqI_sort_famApp_inj {E : ResolvedEnv} {ρ : EnvI} {u : Level}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (h : PEqI E ρ (.sort u) (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI ρ x x' :=
  semEqI_famApp_inj ((pEqI_sort_famApp_iff_semEqI E ρ u r r' ls ls' xs xs').mp h)

/-- **Finitary Projection Dichotomy — Relevant (`non-Prop`) Family Branch
    (`tprojI_famApp_of_ne_zero_on_spine`):**
    For a relevant (non-`Prop`) admitted inductive family `r` (`inductiveSortLevel hW hm hind ≠ .zero`),
    the typed projector `tprojI E (denI ρ (foldApps (.const r ls) xs))` acts as the **identity**
    on every constant-headed spine `foldApps (.const c₀ ls₀) ys`. -/
theorem tprojI_famApp_of_ne_zero_on_spine {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    (c₀ : Nat) (ls₀ : List Level) (ys : List (Expr Nat)) (c : CptI) :
    tprojI E (denI ρ (foldApps (.const r ls) xs)) (denI ρ (foldApps (.const c₀ ls₀) ys)) c ↔
      denI ρ (foldApps (.const c₀ ls₀) ys) c := by
  constructor
  · intro h
    exact h.1
  · intro hc
    rcases approxI_foldApps_const_inv hc with rfl | ⟨_, rfl, _⟩
    · exact tprojI_bot E ρ (foldApps (.const r ls) xs) (foldApps (.const c₀ ls₀) ys)
    · refine ⟨hc, .spine r (botVecI xs), approxI_famApp_botVecI ρ r ls xs, ?_⟩
      exact .spine (not_isPropC_spine_of_inductiveSortLevel_ne_zero hW hm hind (botVecI xs) hne)

/-- At a relevant (non-`Prop`) admitted inductive family `foldApps (.const r ls) xs`
    (`inductiveSortLevel hW hm hind ≠ .zero`), projected equality `PEqI` between two
    constant-headed spines is logically equivalent (`↔`) to untyped `SemEqI`. -/
theorem pEqI_famApp_of_ne_zero_spine_iff_semEqI {E : ResolvedEnv} (hW : EnvWfT E) (ρ : EnvI)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat))
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    (c₁ c₂ : Nat) (ls₁ ls₂ : List Level) (ys₁ ys₂ : List (Expr Nat)) :
    PEqI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) ↔
      SemEqI ρ (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂) := by
  constructor
  · intro hp c
    exact (tprojI_famApp_of_ne_zero_on_spine hW ρ hm hind ls xs hne c₁ ls₁ ys₁ c).symm.trans
      ((hp c).trans (tprojI_famApp_of_ne_zero_on_spine hW ρ hm hind ls xs hne c₂ ls₂ ys₂ c))
  · intro hs
    exact pEqI_of_semEqI hs

/-- At a relevant (non-`Prop`) admitted inductive family `foldApps (.const r ls) xs`
    (`inductiveSortLevel hW hm hind ≠ .zero`), projected equality `PEqI` between two
    constant-headed spines injects head `c₁ = c₂`, length `ys₁.length = ys₂.length`, and
    slotwise `SemEqI ρ y₁ y₂`. -/
theorem pEqI_famApp_of_ne_zero_spine_inj {E : ResolvedEnv} (hW : EnvWfT E) {ρ : EnvI}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)}
    (hne : inductiveSortLevel hW hm hind ≠ .zero)
    {c₁ c₂ : Nat} {ls₁ ls₂ : List Level} {ys₁ ys₂ : List (Expr Nat)}
    (h : PEqI E ρ (foldApps (.const r ls) xs)
      (foldApps (.const c₁ ls₁) ys₁) (foldApps (.const c₂ ls₂) ys₂)) :
    c₁ = c₂ ∧ ys₁.length = ys₂.length ∧
      ∀ (j : Nat) (y₁ y₂ : Expr Nat),
        ys₁[j]? = some y₁ → ys₂[j]? = some y₂ → SemEqI ρ y₁ y₂ :=
  semEqI_famApp_inj
    ((pEqI_famApp_of_ne_zero_spine_iff_semEqI hW ρ hm hind ls xs hne c₁ c₂ ls₁ ls₂ ys₁ ys₂).mp h)


/-- The universe projector `tprojI E (denI ρ (.sort u))` preserves `.sort` on any `.sort v`. -/
theorem tprojI_sort_on_sort (E : ResolvedEnv) (ρ : EnvI) (u v : Level) :
    tprojI E (denI ρ (.sort u)) (denI ρ (.sort v)) .sort :=
  ⟨.sort ρ v, .sort, .sort ρ u, .univ .sort⟩

/-- The universe projector `tprojI E (denI ρ (.sort u))` preserves `.pi .bot []` on any `.pi A B`. -/
theorem tprojI_sort_on_pi_bot_nil (E : ResolvedEnv) (ρ : EnvI) (u : Level) (A B : Expr Nat) :
    tprojI E (denI ρ (.sort u)) (denI ρ (.pi A B)) (.pi .bot []) :=
  ⟨approxI_pi_bot_nil ρ A B, .sort, .sort ρ u,
    .univ (.pi .bot (fun _ hs => (List.not_mem_nil _ hs).elim))⟩

/-- Projected equality `PEqI E ρ (.sort u)` refutes `.pi A B` vs `.sort l`. -/
theorem pEqI_sort_pi_sort_disjoint {E : ResolvedEnv} {ρ : EnvI} {u l : Level} {A B : Expr Nat}
    (h : PEqI E ρ (.sort u) (.pi A B) (.sort l)) : False := by
  have hsort : tprojI E (denI ρ (.sort u)) (denI ρ (.pi A B)) .sort :=
    (h .sort).mpr (tprojI_sort_on_sort E ρ u l)
  rcases approxI_pi_inv hsort.1 with h0 | ⟨_, _, h0, _, _⟩ <;> exact CptI.noConfusion h0

/-- Projected equality `PEqI E ρ (.sort u)` refutes `.pi A B` vs `foldApps (.const r ls) xs`. -/
theorem pEqI_sort_pi_famApp_disjoint {E : ResolvedEnv} {ρ : EnvI} {u : Level}
    {A B : Expr Nat} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (h : PEqI E ρ (.sort u) (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hpi : denI ρ (foldApps (.const r ls) xs) (.pi .bot []) :=
    (tprojI_sort_on_spine E ρ u r ls xs (.pi .bot [])).mp
      ((h (.pi .bot [])).mp (tprojI_sort_on_pi_bot_nil E ρ u A B))
  rcases approxI_foldApps_const_inv hpi with hbot | ⟨_, hsp, _⟩
  · exact CptI.noConfusion hbot
  · exact CptI.noConfusion hsp

/-- Projected equality `PEqI E ρ (.sort u)` refutes `.sort l` vs `foldApps (.const r ls) xs`. -/
theorem pEqI_sort_sort_famApp_disjoint {E : ResolvedEnv} {ρ : EnvI} {u l : Level}
    {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (h : PEqI E ρ (.sort u) (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hsort : denI ρ (foldApps (.const r ls) xs) .sort :=
    (tprojI_sort_on_spine E ρ u r ls xs .sort).mp
      ((h .sort).mp (tprojI_sort_on_sort E ρ u l))
  rcases approxI_foldApps_const_inv hsort with hbot | ⟨_, hsp, _⟩
  · exact CptI.noConfusion hbot
  · exact CptI.noConfusion hsp


/-! #### Part B — `WhNormal`, `LRTypeIN` / `LRTypeI` / `LRTermI` Spine Characterization, Refutations of Context-Free `TypeSoundnessI` / `FundamentalLRI*`, and Repaired Context-Aware `LRTypeICtx` / `FundamentalLRICtx` -/

/-- Under `EnvWfT E`, every admitted `.inductiveM` family spine `foldApps (.const r ls) xs`
    is weak-head normal (`WhNormal E` from `RcicNativePiModelLRCases`). -/
theorem whNormal_famApp {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormal E (foldApps (.const r ls) xs) :=
  fun _ h => whStep_famApp_false hW hm hind xs h

/-- A constant-headed spine `foldApps (.const r ls) xs` is never syntactically `.sort u`. -/
theorem foldApps_const_ne_sort (r : Nat) (ls : List Level) (xs : List (Expr Nat)) (u : Level) :
    foldApps (.const r ls) xs ≠ .sort u := by
  intro heq
  rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
  · exact Expr.noConfusion heq
  · rw [foldApps_snoc] at heq
    exact Expr.noConfusion heq

/-- A constant-headed spine `foldApps (.const r ls) xs` is never syntactically `.pi A B`. -/
theorem foldApps_const_ne_pi (r : Nat) (ls : List Level) (xs : List (Expr Nat)) (A B : Expr Nat) :
    foldApps (.const r ls) xs ≠ .pi A B := by
  intro heq
  rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, x, rfl⟩
  · exact Expr.noConfusion heq
  · rw [foldApps_snoc] at heq
    exact Expr.noConfusion heq

/-- In `LRTypeIN`, an admitted `.inductiveM` family spine on the left is never related at `.pi a f`. -/
theorem lrTypeIN_famApp_at_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A' : Expr Nat}
    {a : CptI} {f : List (List CptI × CptI)}
    (h : LRTypeIN E n Γ (foldApps (.const r ls) xs) A' (.pi a f)) : False := by
  cases h with
  | pi hred _ _ _ _ _ _ =>
      exact foldApps_const_ne_pi r ls xs _ _ (whRed_famApp_eq hW hm hind hred).symm

/-- In `LRTypeIN`, an admitted `.inductiveM` family spine on the right is never related at `.pi a f`. -/
theorem lrTypeIN_famApp_right_at_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A : Expr Nat}
    {a : CptI} {f : List (List CptI × CptI)}
    (h : LRTypeIN E n Γ A (foldApps (.const r ls) xs) (.pi a f)) : False := by
  cases h with
  | pi _ hred' _ _ _ _ _ =>
      exact foldApps_const_ne_pi r ls xs _ _ (whRed_famApp_eq hW hm hind hred').symm

/-- In `LRTypeIN`, an admitted `.inductiveM` family spine on the left is never related at `.sort`. -/
theorem lrTypeIN_famApp_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A' : Expr Nat}
    (h : LRTypeIN E n Γ (foldApps (.const r ls) xs) A' .sort) : False := by
  cases h with
  | sort hred _ =>
      exact foldApps_const_ne_sort r ls xs _ (whRed_famApp_eq hW hm hind hred).symm

/-- In `LRTypeIN`, an admitted `.inductiveM` family spine on the right is never related at `.sort`. -/
theorem lrTypeIN_famApp_right_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A : Expr Nat}
    (h : LRTypeIN E n Γ A (foldApps (.const r ls) xs) .sort) : False := by
  cases h with
  | sort _ hred' =>
      exact foldApps_const_ne_sort r ls xs _ (whRed_famApp_eq hW hm hind hred').symm

/-- **Shallow-Spine Equivalence for `LRTypeIN` on Admitted Family Spines
    (`lrTypeIN_famApp_iff_tyConvT`):**
    Because `LRTypeIN.spine` stores only whole-spine `TyConvT E n Γ X X'` on the weak-head normal
    reducts `X, X'`, and admitted `.inductiveM` family spines are already `WhNormal E`
    (`whNormal_famApp`, `whRed_famApp_eq`), `LRTypeIN` at `.spine r₀ args` between two admitted
    `.inductiveM` family spines is logically equivalent (`↔`) to
    `Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs'))`. -/
theorem lrTypeIN_famApp_iff_tyConvT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r r' : Nat} {m m' : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (ls ls' : List Level) (xs xs' : List (Expr Nat)) (r₀ : Nat) (args : List CptI) :
    LRTypeIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') (.spine r₀ args) ↔
      Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) := by
  constructor
  · intro h
    cases h with
    | spine hred hred' _ _ hc =>
        have e₁ := whRed_famApp_eq hW hm hind hred
        have e₂ := whRed_famApp_eq hW hm' hind' hred'
        subst e₁; subst e₂
        exact ⟨hc⟩
  · rintro ⟨hc⟩
    exact lrTypeIN_spine_congr r₀ args
      (whNormal_famApp hW hm hind ls xs)
      (whNormal_famApp hW hm' hind' ls' xs') hc

/-- Shallow-spine equivalence for `LRTypeI` (`RcicNativePiModelLR`) on admitted family spines. -/
theorem lrTypeI_famApp_iff_tyConvT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r r' : Nat} {m m' : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (ls ls' : List Level) (xs xs' : List (Expr Nat)) (r₀ : Nat) (args : List CptI) :
    LRTypeI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') (.spine r₀ args) ↔
      Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) := by
  constructor
  · intro h
    cases h with
    | spine hred hred' hc =>
        have e₁ := whRed_famApp_eq hW hm hind hred
        have e₂ := whRed_famApp_eq hW hm' hind' hred'
        subst e₁; subst e₂
        exact ⟨hc⟩
  · rintro ⟨hc⟩
    exact .spine (.refl _) (.refl _) hc

/-- Shallow-spine equivalence for `LRTermI` (`RcicNativePiModelLRTerm` #7645) at `.sort w` on
    admitted `.inductiveM` family spines. -/
theorem lrTermI_sort_famApp_iff_tyConvT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r r' : Nat} {m m' : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hm' : E.members r' = some m') (hind' : m'.mclass = .inductiveM)
    (ls ls' : List Level) (xs xs' : List (Expr Nat)) (w : Level) (r₀ : Nat) (args : List CptI) :
    LRTermI E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') (.sort w) (.spine r₀ args) ↔
      Nonempty (TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) := by
  rw [lrTermI_spine_iff]
  exact ⟨fun h => (lrTypeIN_famApp_iff_tyConvT hW hm hind hm' hind' ls ls' xs xs' r₀ args).mp h.2,
    fun h => ⟨⟨w, .refl _⟩, (lrTypeIN_famApp_iff_tyConvT hW hm hind hm' hind' ls ls' xs xs' r₀ args).mpr h⟩⟩

/-- In `LRTermI`, an admitted `.inductiveM` family spine is never related at `.pi a f`. -/
theorem lrTermI_famApp_at_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A' A : Expr Nat}
    {a : CptI} {f : List (List CptI × CptI)}
    (h : LRTermI E n Γ (foldApps (.const r ls) xs) A' A (.pi a f)) : False :=
  lrTypeIN_famApp_at_pi_false hW hm hind ((lrTermI_pi_iff Γ _ A' A a f).mp h).2

/-- Bound variables `.bvar i` have no `WhStep E` reductions (`WhStep` has no `zetaLocal` rule). -/
theorem whStep_bvar_false {E : ResolvedEnv} {i : Nat} {e : Expr Nat}
    (h : WhStep E (.bvar i) e) : False := by
  cases h with
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      rw [foldApps_snoc] at hlhs
      exact Expr.noConfusion hlhs

/-- Any `WhRed E` reduction from `.bvar i` is trivial (`e = .bvar i`). -/
theorem whRed_bvar_eq {E : ResolvedEnv} {i : Nat} {e : Expr Nat}
    (h : WhRed E (.bvar i) e) : e = .bvar i := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStep_bvar_false hs).elim

/-- Universal well-formed `zetaLocal` counterexample context:
    `[.letBinding (.sort (.succ .zero)) (.sort .zero)]`, binding `.bvar 0 := .sort .zero : Type 0`. -/
def zetaSortCtx : LCtx :=
  [.letBinding (.sort (.succ .zero)) (.sort .zero)]

/-- `zetaSortCtx` is well-formed (`CtxWfT E n zetaSortCtx`) at every `E` and `n`. -/
def zetaSortCtx_wf (E : ResolvedEnv) (n : Nat) : CtxWfT E n zetaSortCtx :=
  .letBinding [] (.sort (.succ .zero)) (.succ (.succ .zero)) (.sort .zero) .nil
    (.sort [] (.succ .zero)) (.sort [] .zero)

/-- `ConvT.zetaLocal` derives `ConvT E n zetaSortCtx (.bvar 0) (.sort .zero) (.sort (.succ .zero))`
    at every `E` and `n`. -/
noncomputable
def convT_zetaSortCtx (E : ResolvedEnv) (n : Nat) :
    ConvT E n zetaSortCtx (.bvar 0) (.sort .zero) (.sort (.succ .zero)) :=
  .zetaLocal zetaSortCtx 0 (.sort (.succ .zero)) (.sort .zero) rfl rfl (.sort zetaSortCtx .zero)

/-- Symmetric `ConvT` conversion `ConvT E n zetaSortCtx (.sort .zero) (.bvar 0) (.sort (.succ .zero))`. -/
noncomputable
def convT_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) :
    ConvT E n zetaSortCtx (.sort .zero) (.bvar 0) (.sort (.succ .zero)) :=
  .symm zetaSortCtx (.bvar 0) (.sort .zero) (.sort (.succ .zero)) (convT_zetaSortCtx E n)

/-- `TyConvT E n zetaSortCtx (.sort .zero) (.bvar 0)` holds at every `E` and `n`. -/
noncomputable
def tyConvT_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) :
    TyConvT E n zetaSortCtx (.sort .zero) (.bvar 0) :=
  .of zetaSortCtx (.sort .zero) (.bvar 0) (.succ .zero) (convT_zetaSortCtx_symm E n)

/-- **Refutation of Context-Free `TypeSoundnessI E n` (`RcicNativePiModelLRTerm` #7645):**
    Because `TypeSoundnessI` evaluates at `EnvI.bot` (which ignores local `letBinding`s in `Γ`),
    `ConvT.zetaLocal` in `zetaSortCtx` refutes `TypeSoundnessI E n` at every `E` and `n`. -/
theorem not_typeSoundnessI (E : ResolvedEnv) (n : Nat) : ¬ TypeSoundnessI E n := by
  intro hS
  have hsem := hS (zetaSortCtx_wf E n) (convT_zetaSortCtx_symm E n)
  have hsort : ApproxI EnvI.bot (.bvar 0) .sort :=
    (hsem .sort).mp (.sort EnvI.bot .zero)
  rcases approxI_bvar_inv hsort with hbot | h0
  · exact CptI.noConfusion hbot
  · exact CptI.noConfusion h0

/-- **Refutation of Context-Free `FundamentalLRI E n` (`RcicNativePiModelLR`):**
    Because `LRTypeI` uses `WhRed E` (which has no `zetaLocal` rule), `tyConvT_zetaSortCtx_symm`
    refutes `FundamentalLRI E n` at every `E` and `n`. -/
theorem not_fundamentalLRI (E : ResolvedEnv) (n : Nat) : ¬ FundamentalLRI E n := by
  intro F
  have hLR := F (zetaSortCtx_wf E n) (tyConvT_zetaSortCtx_symm E n) .sort (.sort EnvI.bot .zero)
  cases hLR with
  | sort _ hred' => exact nomatch whRed_bvar_eq hred'

/-- **Refutation of Context-Free `FundamentalLRIN E n` (`RcicNativePiModelLRCases`):**
    `tyConvT_zetaSortCtx_symm` refutes `FundamentalLRIN E n` at every `E` and `n`. -/
theorem not_fundamentalLRIN (E : ResolvedEnv) (n : Nat) : ¬ FundamentalLRIN E n := by
  intro F
  have hLR := F (zetaSortCtx_wf E n) (tyConvT_zetaSortCtx_symm E n) .sort (.sort EnvI.bot .zero)
  cases hLR with
  | sort _ hred' => exact nomatch whRed_bvar_eq hred'

/-- **Refutation of Context-Free `FundamentalLRINT E n` (`RcicNativePiModelLRTerm` #7645):**
    `tyConvT_zetaSortCtx_symm` refutes `FundamentalLRINT E n` at every `E` and `n`. -/
theorem not_fundamentalLRINT (E : ResolvedEnv) (n : Nat) : ¬ FundamentalLRINT E n := by
  intro F
  have hLR := F (zetaSortCtx_wf E n) (.sort zetaSortCtx .zero)
    (tyConvT_zetaSortCtx_symm E n) .sort (.sort EnvI.bot .zero)
  cases hLR with
  | sort _ hred' => exact nomatch whRed_bvar_eq hred'

/-- **Refutation of Context-Free `FundamentalTermI E n` (`RcicNativePiModelLRTerm` #7645):**
    `convT_zetaSortCtx_symm` refutes `FundamentalTermI E n` at every `E` and `n` (with zero
    hypotheses on `E` or `n`). -/
theorem not_fundamentalTermI (E : ResolvedEnv) (n : Nat) : ¬ FundamentalTermI E n := by
  intro F
  have hTerm := F.2 (zetaSortCtx_wf E n) (convT_zetaSortCtx_symm E n) .sort (.sort EnvI.bot .zero)
  have hLR : LRTypeIN E n zetaSortCtx (.sort .zero) (.bvar 0) .sort :=
    lrTypeIN_of_lrTermI_sort .sort hTerm
  cases hLR with
  | sort _ hred' => exact nomatch whRed_bvar_eq hred'

/-- **Positive Resolution 1 (`ctxEnvI` resolves `zetaSortCtx` in `ApproxI`):**
    Unlike `EnvI.bot`, our context-aware environment `ctxEnvI zetaSortCtx` satisfies
    `SemEqI (ctxEnvI zetaSortCtx) (.bvar 0) (.sort .zero)`. -/
theorem semEqI_ctxEnvI_zetaSortCtx :
    SemEqI (ctxEnvI zetaSortCtx) (.bvar 0) (.sort .zero) :=
  semEqI_zetaLocal (ctxEnvI_respects zetaSortCtx) (by rfl)

/-- **Positive Resolution 2 (`WhRedCtx` resolves `zetaSortCtx` in 1 step):**
    Unlike `WhRed E`, our context-aware weak-head reduction `WhRedCtx E zetaSortCtx` reduces
    `.bvar 0` to `.sort .zero`. -/
theorem whRedCtx_zetaSortCtx_bvar0 (E : ResolvedEnv) :
    WhRedCtx E zetaSortCtx (.bvar 0) (.sort .zero) :=
  .step (.zetaLocal rfl) (.refl _)

/-- **Repaired Context-Aware Logical Relation (`LRTypeICtx`) over `CptI` and `WhRedCtx E Γ`:**
    Replaces context-free `WhRed E` in `LRTypeI` (`RcicNativePiModelLR`) with context-aware
    `WhRedCtx E Γ` (which includes `WhStepCtx.zetaLocal`). -/
inductive LRTypeICtx (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeICtx E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedCtx E Γ A (.sort u)) (h' : WhRedCtx E Γ A' (.sort u')) :
      LRTypeICtx E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedCtx E Γ A (.pi A₁ B₁)) (h' : WhRedCtx E Γ A' (.pi A₂ B₂))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeICtx E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, LRTypeICtx E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeICtx E n Γ A A' (.pi a f)
  | spine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (h : WhRedCtx E Γ A X) (h' : WhRedCtx E Γ A' X') (hc : TyConvT E n Γ X X') :
      LRTypeICtx E n Γ A A' (.spine r args)

/-- `LRTypeICtx` and `ctxEnvI` satisfy the fundamental-lemma conclusion on `zetaSortCtx`
    in the forward direction `(.sort .zero, .bvar 0)`. -/
theorem lrTypeICtx_zetaSortCtx (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c) :
    LRTypeICtx E n zetaSortCtx (.sort .zero) (.bvar 0) c := by
  rcases approxI_sort_inv hc with rfl | rfl
  · exact .bot _ _ _
  · exact .sort (.refl _) (whRedCtx_zetaSortCtx_bvar0 E)

/-- `LRTypeICtx` and `ctxEnvI` also satisfy the fundamental-lemma conclusion on `zetaSortCtx`
    in the reverse direction `(.bvar 0, .sort .zero)`. -/
theorem lrTypeICtx_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.bvar 0) c) :
    LRTypeICtx E n zetaSortCtx (.bvar 0) (.sort .zero) c := by
  have hc' : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c :=
    (semEqI_ctxEnvI_zetaSortCtx c).mp hc
  rcases approxI_sort_inv hc' with rfl | rfl
  · exact .bot _ _ _
  · exact .sort (whRedCtx_zetaSortCtx_bvar0 E) (.refl _)

/-- `.pi A B` has no `WhStepCtx` steps. -/
theorem whStepCtx_pi_false {E : ResolvedEnv} {Γ : LCtx} {A B e : Expr Nat}
    (h : WhStepCtx E Γ (.pi A B) e) : False := by
  cases h with
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      rw [foldApps_snoc] at hlhs
      exact Expr.noConfusion hlhs

/-- Any `WhRedCtx` reduction from `.pi A B` is trivial (`e = .pi A B`). -/
theorem whRedCtx_pi_eq {E : ResolvedEnv} {Γ : LCtx} {A B e : Expr Nat}
    (h : WhRedCtx E Γ (.pi A B) e) : e = .pi A B := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepCtx_pi_false hs).elim

/-- `.sort u` has no `WhStepCtx` steps. -/
theorem whStepCtx_sort_false {E : ResolvedEnv} {Γ : LCtx} {u : Level} {e : Expr Nat}
    (h : WhStepCtx E Γ (.sort u) e) : False := by
  cases h with
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      rw [foldApps_snoc] at hlhs
      exact Expr.noConfusion hlhs

/-- Any `WhRedCtx` reduction from `.sort u` is trivial (`e = .sort u`). -/
theorem whRedCtx_sort_eq {E : ResolvedEnv} {Γ : LCtx} {u : Level} {e : Expr Nat}
    (h : WhRedCtx E Γ (.sort u) e) : e = .sort u := by
  cases h with
  | refl => rfl
  | step hs _ => exact (whStepCtx_sort_false hs).elim

/-- Reading `LRTypeICtx` at `.pi .bot []` for two syntactic Π-types yields component conversions. -/
theorem lrTypeICtx_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeICtx E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  cases h with
  | pi h h' hdom hcod _ _ =>
      have e₁ := whRedCtx_pi_eq h
      have e₂ := whRedCtx_pi_eq h'
      injection e₁ with eA₁ eB₁
      injection e₂ with eA₂ eB₂
      subst eA₁; subst eB₁; subst eA₂; subst eB₂
      exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

/-- In `LRTypeICtx`, an admitted `.inductiveM` family spine on the right is never related at `.pi a f`. -/
theorem lrTypeICtx_famApp_right_at_pi_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A : Expr Nat}
    {a : CptI} {f : List (List CptI × CptI)}
    (h : LRTypeICtx E n Γ A (foldApps (.const r ls) xs) (.pi a f)) : False := by
  cases h with
  | pi _ hred' _ _ _ _ =>
      exact foldApps_const_ne_pi r ls xs _ _ (whRedCtx_famApp_eq hW hm hind hred').symm

/-- In `LRTypeICtx`, an admitted `.inductiveM` family spine on the right is never related at `.sort`. -/
theorem lrTypeICtx_famApp_right_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)} {A : Expr Nat}
    (h : LRTypeICtx E n Γ A (foldApps (.const r ls) xs) .sort) : False := by
  cases h with
  | sort _ hred' =>
      exact foldApps_const_ne_sort r ls xs _ (whRedCtx_famApp_eq hW hm hind hred').symm

/-- **Repaired Context-Aware Fundamental Lemma (`FundamentalLRICtx`):**
    Under `CtxWfT E n Γ`, two convertible types `TyConvT E n Γ A A'` are related by
    `LRTypeICtx E n Γ A A' c` at every compact `c` approximating `A` at the context-aware
    environment `ctxEnvI Γ` (resolving `zetaSortCtx` in both directions via
    `lrTypeICtx_zetaSortCtx` and `lrTypeICtx_zetaSortCtx_symm`). -/
def FundamentalLRICtx (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat}, TyConvT E n Γ A A' →
    ∀ c, ApproxI (ctxEnvI Γ) A c → LRTypeICtx E n Γ A A' c

/-- Disjointness of `.pi A B` and `.sort l` under `FundamentalLRICtx E n`. -/
theorem not_tyConvT_pi_sort_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (F : FundamentalLRICtx E n) (hΓ : CtxWfT E n Γ)
    {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  have hLR := F hΓ hc (.pi .bot []) (approxI_pi_bot_nil (ctxEnvI Γ) A B)
  cases hLR with
  | pi _ hred' _ _ _ _ => exact nomatch whRedCtx_sort_eq hred'

/-- Disjointness of `.sort l` and `.pi A B` under `FundamentalLRICtx E n`. -/
theorem not_tyConvT_sort_pi_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (F : FundamentalLRICtx E n) (hΓ : CtxWfT E n Γ)
    {A B : Expr Nat} {l : Level}
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hLR := F hΓ hc .sort (.sort (ctxEnvI Γ) l)
  cases hLR with
  | sort _ hred' => exact nomatch whRedCtx_pi_eq hred'

/-- Disjointness of `.pi A B` and an admitted `.inductiveM` family spine under `FundamentalLRICtx E n`. -/
theorem not_tyConvT_pi_famApp_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (F : FundamentalLRICtx E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {A B : Expr Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hc : TyConvT E n Γ (.pi A B) (foldApps (.const r ls) xs)) : False :=
  lrTypeICtx_famApp_right_at_pi_false hW hm hind
    (F hΓ hc (.pi .bot []) (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- Disjointness of `.sort l` and an admitted `.inductiveM` family spine under `FundamentalLRICtx E n`. -/
theorem not_tyConvT_sort_famApp_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (F : FundamentalLRICtx E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {l : Level} {ls : List Level} {xs : List (Expr Nat)}
    (hc : TyConvT E n Γ (.sort l) (foldApps (.const r ls) xs)) : False :=
  lrTypeICtx_famApp_right_at_sort_false hW hm hind
    (F hΓ hc .sort (.sort (ctxEnvI Γ) l))

/-- Derive `PiRowField E n` (#7569) from `FundamentalLRICtx E n`. -/
theorem piRowField_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRICtx E n) : PiRowField E n :=
  fun {_} hΓ {_ _ _ _} hc =>
    lrTypeICtx_pi_components (F hΓ hc (.pi .bot []) (approxI_pi_bot_nil (ctxEnvI _) _ _))

/-- Saturation of a well-typed admitted inductive family application from `FundamentalLRICtx E n`. -/
theorem famApp_saturated_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRICtx E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  have hprow : PiRowField E n := piRowField_of_fundamentalLRICtx F
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_fundamentalLRICtx F hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_fundamentalLRICtx F hΓ hconv

/-- Construct `FamAppSaturation` (#7525) from `FundamentalLRICtx E n`. -/
noncomputable def famAppSaturation_of_fundamentalLRICtx {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (F : FundamentalLRICtx E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FamAppSaturation E r m ls ls' xs xs' := by
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM hW hm hind ls'
  have ⟨_, htyR⟩ := tyConvT_rhsSort hW hΓ h ⟨w, hty⟩
  have hlenL := famApp_saturated_of_fundamentalLRICtx hW F hΓ hm hind htelL hty
  have hlenR := famApp_saturated_of_fundamentalLRICtx hW F hΓ hm hind htelR htyR
  exact {
    doms := (piDomsOf m.mtype).map (instantiateLevels ls)
    doms' := (piDomsOf m.mtype).map (instantiateLevels ls')
    U := .sort (instLevel ls (inductiveSortLevel hW hm hind))
    U' := .sort (instLevel ls' (inductiveSortLevel hW hm hind))
    telL := htelL
    telR := htelR
    eqN := heqN
    lenDD := by simp only [List.length_map]
    lenXD := hlenL.symm
    lenXD' := hlenR.symm
  }

/-- Assemble `famAppRow` from `FundamentalLRICtx E n` and `FamLevelAndSlotConv`
    (with no `AllBelowScoped`, `TableWF`, or separate `PiRowField` assumption). -/
theorem famAppRow_of_fundamentalLRICtx_famLevelAndSlot
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (F : FundamentalLRICtx E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (hfam : FamLevelAndSlotConv E n Γ m ls ls' xs xs') :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  let sat := famAppSaturation_of_fundamentalLRICtx hW hΓ F hm hind hfam.1 hty h
  exact famAppRow_of_piRow_saturation_slotConv
    (piRowField_of_fundamentalLRICtx F) hW hΓ sat hfam.2 hm hind hty h


/-! #### Part C — Positive Applied/Lambda η-Soundness (`semEqI_eta_app`, `semEqI_eta_lam`), Refutation of Unprojected `EtaStepI` / `TypedSoundnessCtxI`, Inhabited Pure-Inductive Handlers, Computational Fragment (`FamCompFrag`) Soundness in `ApproxI` / `PEqI`, and Shallow / Projected `famAppRow` Assembly -/

/-- `EnvI.bot` satisfies `CtxEnvI []`. -/
theorem ctxEnvI_nil : CtxEnvI [] EnvI.bot := by
  intro i _ hw
  cases i <;> exact nomatch hw

/-- Extending `Γ` with `.assumption A` preserves `CtxEnvI` under `EnvI.cons S ρ` for any `S`. -/
theorem ctxEnvI_cons_assumption {Γ : LCtx} {ρ : EnvI}
    (hctx : CtxEnvI Γ ρ) (A : Expr Nat) (S : CptI → Prop) :
    CtxEnvI (.assumption A :: Γ) (EnvI.cons S ρ) := by
  intro i w hw
  cases i with
  | zero => exact nomatch hw
  | succ j =>
    rw [lookupValue_cons_succ] at hw
    cases h : lookupValue Γ j with
    | none => rw [h] at hw; exact nomatch hw
    | some v₀ =>
      rw [h] at hw
      injection hw with hw_eq
      subst hw_eq
      intro c
      have hsucc : ApproxI (EnvI.cons S ρ) (.bvar (j + 1)) c ↔ ApproxI ρ (.bvar j) c := by
        constructor <;> (
          intro hb
          rcases approxI_bvar_inv hb with rfl | h0
          · exact .bot _ _
          · exact .bvar h0)
      exact hsucc.trans ((hctx j v₀ h c).trans (approxI_cons_lift0_iff ρ S v₀ c).symm)

/-- Extending `Γ` with `.letBinding A v` preserves `CtxEnvI` under `EnvI.cons (denI ρ v) ρ`. -/
theorem ctxEnvI_cons_letBinding {Γ : LCtx} {ρ : EnvI}
    (hctx : CtxEnvI Γ ρ) (A v : Expr Nat) :
    CtxEnvI (.letBinding A v :: Γ) (EnvI.cons (denI ρ v) ρ) := by
  intro i w hw
  cases i with
  | zero =>
    injection hw with hw_eq
    subst hw_eq
    intro c
    have hzero : ApproxI (EnvI.cons (denI ρ v) ρ) (.bvar 0) c ↔ ApproxI ρ v c := by
      constructor
      · intro hb
        rcases approxI_bvar_inv hb with rfl | h0
        · exact .bot _ _
        · exact h0
      · intro hv
        exact .bvar hv
    exact hzero.trans (approxI_cons_lift0_iff ρ (denI ρ v) v c).symm
  | succ j =>
    rw [lookupValue_cons_succ] at hw
    cases h : lookupValue Γ j with
    | none => rw [h] at hw; exact nomatch hw
    | some v₀ =>
      rw [h] at hw
      injection hw with hw_eq
      subst hw_eq
      intro c
      have hsucc : ApproxI (EnvI.cons (denI ρ v) ρ) (.bvar (j + 1)) c ↔ ApproxI ρ (.bvar j) c := by
        constructor <;> (
          intro hb
          rcases approxI_bvar_inv hb with rfl | h0
          · exact .bot _ _
          · exact .bvar h0)
      exact hsucc.trans ((hctx j v₀ h c).trans (approxI_cons_lift0_iff ρ (denI ρ v) v₀ c).symm)

/-- `.bvar 0` under `EnvI.cons (denI ρ x) ρ` is equivalent in `ApproxI` to `x` under `ρ`. -/
theorem approxI_bvar_zero_let (ρ : EnvI) (x : Expr Nat) (c : CptI) :
    ApproxI (EnvI.cons (denI ρ x) ρ) (.bvar 0) c ↔ ApproxI ρ x c := by
  constructor
  · intro hb
    rcases approxI_bvar_inv hb with rfl | h0
    · exact .bot _ _
    · exact h0
  · intro hx
    exact .bvar hx

/-- Relational congruence of `ApproxI` for `.app` across environments. -/
theorem approxI_app_rel {ρ₁ ρ₂ : EnvI} {f₁ f₂ a₁ a₂ : Expr Nat}
    (hf : ∀ c, ApproxI ρ₁ f₁ c ↔ ApproxI ρ₂ f₂ c)
    (ha : ∀ c, ApproxI ρ₁ a₁ c ↔ ApproxI ρ₂ a₂ c)
    (c : CptI) :
    ApproxI ρ₁ (.app f₁ a₁) c ↔ ApproxI ρ₂ (.app f₂ a₂) c := by
  constructor
  · intro h
    rcases approxI_app_inv h with h0 | ⟨g, s, heq, hfg, hs, hau⟩ | ⟨r, args, u, heq, hfs, hau⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .app ((hf (.lam g)).mp hfg) hs (fun u hu => (ha u).mp (hau u hu))
    · subst heq
      exact .appSpine ((hf (.spine r args)).mp hfs) ((ha u).mp hau)
  · intro h
    rcases approxI_app_inv h with h0 | ⟨g, s, heq, hfg, hs, hau⟩ | ⟨r, args, u, heq, hfs, hau⟩
    · subst h0; exact .bot _ _
    · subst heq
      exact .app ((hf (.lam g)).mpr hfg) hs (fun u hu => (ha u).mpr (hau u hu))
    · subst heq
      exact .appSpine ((hf (.spine r args)).mpr hfs) ((ha u).mpr hau)

/-- In `ApproxI`, `.app (.lam A b) a` at `ρ` is equivalent to `b` at `EnvI.cons (denI ρ a) ρ`. -/
theorem approxI_beta_iff_substEnv (ρ : EnvI) (A b a : Expr Nat) (c : CptI) :
    ApproxI ρ (.app (.lam A b) a) c ↔ ApproxI (EnvI.cons (denI ρ a) ρ) b c :=
  (approxI_beta ρ A b a c).trans (denI_instantiate0 ρ a b c)

/-- **Unconditional Applied η-Soundness in `ApproxI` (`semEqI_eta_app`):**
    When an η-expansion `.lam A (.app (lift 0 1 f) (.bvar 0))` is applied to any argument `x`,
    it is unconditionally semantically equal (`SemEqI ρ`) to `.app f x` at every `ρ : EnvI`. -/
theorem semEqI_eta_app (ρ : EnvI) (A f x : Expr Nat) :
    SemEqI ρ (.app (.lam A (.app (lift 0 1 f) (.bvar 0))) x) (.app f x) := by
  intro c
  refine (approxI_beta_iff_substEnv ρ A (.app (lift 0 1 f) (.bvar 0)) x c).trans ?_
  exact approxI_app_rel
    (fun c' => approxI_cons_lift0_iff ρ (denI ρ x) f c')
    (fun c' => approxI_bvar_zero_let ρ x c')
    c

private theorem instantiate_bvar_lift_succ :
    ∀ (e : Expr Nat) (k : Nat), instantiate k (.bvar k) (lift (k + 1) 1 e) = e
  | .bvar i, k => by
      simp only [lift]
      by_cases h : k + 1 ≤ i
      · rw [if_pos h]
        simp only [instantiate]
        have hne : i + 1 ≠ k := by omega
        have hlt : k < i + 1 := by omega
        rw [if_neg hne, if_pos hlt]
        rfl
      · rw [if_neg h]
        simp only [instantiate]
        by_cases heq : i = k
        · rw [if_pos heq, heq]
        · have hlt : ¬ k < i := by omega
          rw [if_neg heq, if_neg hlt]
  | .sort _, _ => rfl
  | .const _ _, _ => rfl
  | .app f x, k => by
      simp only [lift, instantiate, instantiate_bvar_lift_succ f k,
        instantiate_bvar_lift_succ x k]
  | .lam A b, k => by
      simp only [lift, instantiate, Nat.zero_le, if_true,
        instantiate_bvar_lift_succ A k, instantiate_bvar_lift_succ b (k + 1)]
  | .pi A B, k => by
      simp only [lift, instantiate, Nat.zero_le, if_true,
        instantiate_bvar_lift_succ A k, instantiate_bvar_lift_succ B (k + 1)]
  | .letE A v b, k => by
      simp only [lift, instantiate, Nat.zero_le, if_true,
        instantiate_bvar_lift_succ A k, instantiate_bvar_lift_succ v k,
        instantiate_bvar_lift_succ b (k + 1)]
  | .lit _, _ => rfl

/-- **Unconditional Lambda η-Soundness in `ApproxI` (`semEqI_eta_lam`):**
    When `f = .lam A₀ b₀` is a syntactic lambda, its η-expansion
    `.lam A (.app (lift 0 1 (.lam A₀ b₀)) (.bvar 0))` is unconditionally semantically equal
    (`SemEqI ρ`) to `.lam A₀ b₀` at every `ρ : EnvI`. -/
theorem semEqI_eta_lam (ρ : EnvI) (A A₀ b₀ : Expr Nat) :
    SemEqI ρ (.lam A (.app (lift 0 1 (.lam A₀ b₀)) (.bvar 0))) (.lam A₀ b₀) := by
  refine semEqI_lam (fun S c => ?_)
  change ApproxI (EnvI.cons S ρ) (.app (.lam (lift 0 1 A₀) (lift 1 1 b₀)) (.bvar 0)) c ↔
    ApproxI (EnvI.cons S ρ) b₀ c
  have hbeta := approxI_beta (EnvI.cons S ρ) (lift 0 1 A₀) (lift 1 1 b₀) (.bvar 0) c
  unfold instantiate0 at hbeta
  rwa [instantiate_bvar_lift_succ b₀ 0] at hbeta

/-- Named step handler in `ApproxI` for `ConvT.delta` (transparent definition unfolding). -/
def DeltaStepI (E : ResolvedEnv) : Prop :=
  ∀ (ρ : EnvI) (r : Nat) (ls : List Level) (m : CheckedMember) (b : Expr Nat),
    E.members r = some m → m.body = some b → transparent m.mclass = true →
    SemEqI ρ (.const r ls) (instantiateLevels ls b)

/-- Named step handler in `ApproxI` for `ConvT.iota` (derived ι-reduction). -/
def IotaStepI (E : ResolvedEnv) : Prop :=
  ∀ (ρ : EnvI) (lhs rhs : Expr Nat), Nonempty (DerivedIota E lhs rhs) → SemEqI ρ lhs rhs

/-- Named step handler in `ApproxI` for `ConvT.eta` (unprojected η-expansion). -/
def EtaStepI : Prop :=
  ∀ (ρ : EnvI) (A f : Expr Nat), SemEqI ρ (.lam A (.app (lift 0 1 f) (.bvar 0))) f

/-- Every `PureInductiveEnv E` satisfies `DeltaStepI E`. -/
theorem deltaStepI_of_pureInductiveEnv {E : ResolvedEnv} (hP : PureInductiveEnv E) :
    DeltaStepI E := by
  intro _ r _ m _ hm hbody _
  rw [(hP r m hm).2] at hbody
  exact Option.noConfusion hbody

/-- Every `PureInductiveEnv E` satisfies `IotaStepI E`. -/
theorem iotaStepI_of_pureInductiveEnv {E : ResolvedEnv} (hP : PureInductiveEnv E) :
    IotaStepI E := by
  rintro _ _ _ ⟨⟨w⟩⟩
  rcases (hP w.recRef w.recMember w.hrec).1 with hind | hctor
  · exact MemberClass.noConfusion (hind.symm.trans w.hrecK)
  · exact MemberClass.noConfusion (hctor.symm.trans w.hrecK)

/-- Inhabitedness witness: `emptyEnv` satisfies `DeltaStepI emptyEnv`. -/
theorem deltaStepI_emptyEnv : DeltaStepI emptyEnv :=
  deltaStepI_of_pureInductiveEnv pureInductiveEnv_emptyEnv

/-- Inhabitedness witness: `emptyEnv` satisfies `IotaStepI emptyEnv`. -/
theorem iotaStepI_emptyEnv : IotaStepI emptyEnv :=
  iotaStepI_of_pureInductiveEnv pureInductiveEnv_emptyEnv

/-- Every `PureInductiveEnv E` satisfies `WhApproxInvCore E` (`RcicNativePiModelLRTerm` #7645),
    because `delta` and `iota` are absent in `PureInductiveEnv E`. -/
theorem whApproxInvCore_of_pureInductiveEnv {E : ResolvedEnv} (hP : PureInductiveEnv E) :
    WhApproxInvCore E := by
  refine ⟨fun {r _ m _} hm hbody => ?_, fun {_ _} hI => ?_⟩
  · rw [(hP r m hm).2] at hbody
    exact Option.noConfusion hbody
  · rcases derivedIotaU_recHead hI with ⟨r, _, _, _, m, _, hm, hrec⟩
    rcases (hP r m hm).1 with hind | hctor
    · exact MemberClass.noConfusion (hind.symm.trans hrec)
    · exact MemberClass.noConfusion (hctor.symm.trans hrec)

/-- Concrete inhabitedness witness for `WhApproxInvCore` (`RcicNativePiModelLRTerm` #7645):
    `emptyEnv` satisfies `WhApproxInvCore emptyEnv`. -/
theorem whApproxInvCore_emptyEnv : WhApproxInvCore emptyEnv :=
  whApproxInvCore_of_pureInductiveEnv pureInductiveEnv_emptyEnv

/-- Concrete inhabitedness witness for `WhApproxInv` (`RcicNativePiModelLRTerm` #7645):
    `emptyEnv` satisfies `WhApproxInv emptyEnv`. -/
theorem whApproxInv_emptyEnv : WhApproxInv emptyEnv :=
  whApproxInv_of_core whApproxInvCore_emptyEnv

/-- **Refutation of Unapplied/Unprojected `EtaStepI` in `ApproxI`:**
    At `ρ = EnvI.bot` and `f = .bvar 0`, the η-expansion `.lam A (.app (.bvar 1) (.bvar 0))`
    approximates `.lam []`, whereas `.bvar 0` does not (`EnvI.bot 0 (.lam []) = False`). -/
theorem not_etaStepI : ¬ EtaStepI := by
  intro heta
  have hlam : ApproxI EnvI.bot
      (.lam (.sort .zero) (.app (lift 0 1 (.bvar 0)) (.bvar 0))) (.lam []) :=
    .lam fun _ hs => (List.not_mem_nil _ hs).elim
  have hbvar : ApproxI EnvI.bot (.bvar 0) (.lam []) :=
    (heta EnvI.bot (.sort .zero) (.bvar 0) (.lam [])).mp hlam
  rcases approxI_bvar_inv hbvar with hbot | h0
  · exact CptI.noConfusion hbot
  · exact CptI.noConfusion h0

/-- Context-aware unprojected soundness predicate on `ApproxI` / `SemEqI` at `ctxEnvI Γ`
    (shown below to be refuted by unapplied `ConvT.eta` in `not_typedSoundnessCtxI`,
    motivating `FamCompFrag`, `ShallowTypeSoundnessCtxI`, and `FamSlotPEqSoundnessCtxI`). -/
def TypedSoundnessCtxI (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx} {a b T : Expr Nat},
    CtxWfT E n Γ → ConvT E n Γ a b T → SemEqI (ctxEnvI Γ) a b

/-- **Refutation of Unprojected `TypedSoundnessCtxI E n` at every `E` and `n`:**
    In `etaObsCtx = [.assumption (.pi (.sort .zero) (.sort .zero))]`, `convT_etaObs` derives
    `ConvT E n etaObsCtx (.lam (.sort .zero) (.app (.bvar 1) (.bvar 0))) (.bvar 0) (.pi (.sort .zero) (.sort .zero))`.
    At `c = .lam []`, the LHS is approximated at `ctxEnvI etaObsCtx` while `.bvar 0` is not. -/
theorem not_typedSoundnessCtxI (E : ResolvedEnv) (n : Nat) : ¬ TypedSoundnessCtxI E n := by
  intro hsound
  have hsem := hsound (etaObsCtx_wf E n) (convT_etaObs E n)
  have hlam : ApproxI (ctxEnvI etaObsCtx)
      (.lam (.sort .zero) (.app (lift 0 1 (.bvar 0)) (.bvar 0))) (.lam []) :=
    .lam fun _ hs => (List.not_mem_nil _ hs).elim
  have hbvar : ApproxI (ctxEnvI etaObsCtx) (.bvar 0) (.lam []) :=
    (hsem (.lam [])).mp hlam
  rcases approxI_bvar_inv hbvar with hbot | h0
  · exact CptI.noConfusion hbot
  · exact CptI.noConfusion h0

/-- **Computational Fragment Soundness in `ApproxI` (`semEqI_of_famCompFrag`):**
    Under `DeltaStepI E` and `IotaStepI E` (both inhabited by `PureInductiveEnv E` and `emptyEnv`),
    every `FamCompFrag E n` conversion (all 16 computational rules including `beta`, `zeta`,
    `zetaLocal`, `etaApp`, `delta`, `iota`, `lit`, and all congruences) is sound for
    `SemEqI ρ` at every `ρ` satisfying `CtxEnvI Γ ρ`. -/
theorem semEqI_of_famCompFrag {E : ResolvedEnv} {n : Nat}
    (hdelta : DeltaStepI E) (hiota : IotaStepI E)
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCompFrag E n h) :
    ∀ (ρ : EnvI), CtxEnvI Γ ρ → SemEqI ρ a b := by
  induction hh with
  | ofBetaZetaLocal hh => intro ρ hctx; exact semEqI_of_famBetaZetaLocalFrag hh ρ hctx
  | @delta _ r ls m b hres hbody htr _ _ _ => intro ρ _; exact hdelta ρ r ls m b hres hbody htr
  | @iota _ lhs rhs _ h _ _ => intro ρ _; exact hiota ρ lhs rhs ⟨h⟩
  | @etaApp _ f a b A _ _ _ _ ihab =>
      intro ρ hctx
      exact SemEqI.trans (semEqI_eta_app ρ A f a) (semEqI_app (SemEqI.refl ρ f) (ihab ρ hctx))
  | symm _ ih => intro ρ hctx; exact SemEqI.symm (ih ρ hctx)
  | trans _ _ ih₁ ih₂ => intro ρ hctx; exact SemEqI.trans (ih₁ ρ hctx) (ih₂ ρ hctx)
  | pi _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqI_pi (ih₁ ρ hctx)
        (fun S => ih₂ (EnvI.cons S ρ) (ctxEnvI_cons_assumption hctx _ S))
  | lam _ _ _ ih₂ =>
      intro ρ hctx
      exact semEqI_lam (fun S => ih₂ (EnvI.cons S ρ) (ctxEnvI_cons_assumption hctx _ S))
  | app _ _ ih₁ ih₂ =>
      intro ρ hctx
      exact semEqI_app (ih₁ ρ hctx) (ih₂ ρ hctx)
  | letE _ _ _ _ ihv ihb =>
      intro ρ hctx
      exact semEqI_letE_exact (ihv ρ hctx) (ihb _ (ctxEnvI_cons_letBinding hctx _ _))
  | tyConv _ ih => intro ρ hctx; exact ih ρ hctx

/-- Projected-equality (`PEqI`) soundness for `FamCompFrag E n` in `ApproxI`. -/
theorem pEqI_of_famCompFrag {E : ResolvedEnv} {n : Nat}
    (hdelta : DeltaStepI E) (hiota : IotaStepI E)
    {Γ : LCtx} {a b T : Expr Nat} {h : ConvT E n Γ a b T}
    (hh : FamCompFrag E n h)
    {ρ : EnvI} (hctx : CtxEnvI Γ ρ) :
    PEqI E ρ T a b :=
  pEqI_of_semEqI (semEqI_of_famCompFrag hdelta hiota hh ρ hctx)

/-- **Family-Spine Semantic Injectivity for `FamCompFrag` in `ApproxI`
    (`famCompFrag_famApp_semInjI`):**
    Under `DeltaStepI E` and `IotaStepI E`, any `FamCompFrag E n` conversion between two
    constant-headed spines yields `r = r'`, `xs.length = xs'.length`, and slotwise
    `SemEqI (ctxEnvI Γ) x x'`. -/
theorem famCompFrag_famApp_semInjI {E : ResolvedEnv} {n : Nat}
    (hdelta : DeltaStepI E) (hiota : IotaStepI E)
    {Γ : LCtx} {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamCompFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI (ctxEnvI Γ) x x' :=
  semEqI_famApp_inj (semEqI_of_famCompFrag hdelta hiota hh (ctxEnvI Γ) (ctxEnvI_respects Γ))

/-- Unconditional family-spine semantic injectivity for `FamCompFrag E n` in `ApproxI` over any
    `PureInductiveEnv E` (including `emptyEnv`). -/
theorem famCompFrag_famApp_semInjI_of_pureInductiveEnv {E : ResolvedEnv} {n : Nat}
    (hP : PureInductiveEnv E)
    {Γ : LCtx} {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {T : Expr Nat}
    {h : ConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs') T}
    (hh : FamCompFrag E n h) :
    r = r' ∧ xs.length = xs'.length ∧
      ∀ (i : Nat) (x x' : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' → SemEqI (ctxEnvI Γ) x x' :=
  famCompFrag_famApp_semInjI
    (deltaStepI_of_pureInductiveEnv hP) (iotaStepI_of_pureInductiveEnv hP) hh

/-- Shallow type-code predicate on `CptI`: excludes `.lam f` codes so unapplied `ConvT.eta`
    on function variables does not obstruct type-head disjointness or saturation. -/
def IsShallowTypeCpt : CptI → Prop
  | .bot => True
  | .sort => True
  | .pi .bot [] => True
  | .spine _ args => ∀ u ∈ args, u = .bot
  | _ => False

/-- **Context-Aware Shallow Type-Code Soundness on `ApproxI` (`ShallowTypeSoundnessCtxI`):**
    For any type-level conversion `ConvT E n Γ T₁ T₂ (.sort u)` under `CtxWfT E n Γ`,
    `T₁` and `T₂` agree on all shallow type codes `IsShallowTypeCpt c` at `ctxEnvI Γ`.
    Unlike `TypeSoundnessI` (refuted by `zetaSortCtx`) and `TypedSoundnessCtxI` (refuted by
    `etaObsCtx`), `ShallowTypeSoundnessCtxI` uses `ctxEnvI Γ`, restricts to type conversions at
    `.sort u`, and tests only shallow type codes (`IsShallowTypeCpt`). -/
def ShallowTypeSoundnessCtxI (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx} {T₁ T₂ : Expr Nat} {u : Level},
    CtxWfT E n Γ → ConvT E n Γ T₁ T₂ (.sort u) →
    ∀ c, IsShallowTypeCpt c → (ApproxI (ctxEnvI Γ) T₁ c ↔ ApproxI (ctxEnvI Γ) T₂ c)

/-- `TyConvT` preserves all shallow type codes (`IsShallowTypeCpt`) at `ctxEnvI Γ` under
    `ShallowTypeSoundnessCtxI E n`. -/
theorem shallowTypeSemEqI_of_tyConvT {E : ResolvedEnv} {n : Nat}
    (hshallow : ShallowTypeSoundnessCtxI E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {T₁ T₂ : Expr Nat} → TyConvT E n Γ T₁ T₂ →
    ∀ c, IsShallowTypeCpt c → (ApproxI (ctxEnvI Γ) T₁ c ↔ ApproxI (ctxEnvI Γ) T₂ c)
  | _, _, .refl _ _, _, _ => Iff.rfl
  | _, _, .of _ _ _ _ hc, c, hcsh => hshallow hΓ hc c hcsh
  | _, _, .trans _ _ _ _ c₁ c₂, c, hcsh =>
      (shallowTypeSemEqI_of_tyConvT hshallow hΓ c₁ c hcsh).trans
        (shallowTypeSemEqI_of_tyConvT hshallow hΓ c₂ c hcsh)

/-- `IsShallowTypeCpt (.spine r (botVecI xs))` holds for every `r` and `xs`. -/
theorem isShallowTypeCpt_spine_botVecI (r : Nat) (xs : List (Expr Nat)) :
    IsShallowTypeCpt (.spine r (botVecI xs)) := by
  intro u hu
  induction xs with
  | nil => exact nomatch hu
  | cons _ _ ih =>
    rcases List.mem_cons.mp hu with rfl | hmem
    · rfl
    · exact ih hmem

/-- Family-spine head and arity-length injectivity (`r = r' ∧ xs.length = xs'.length`) under
    `ShallowTypeSoundnessCtxI E n`. -/
theorem tyConvT_famApp_head_length_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r r' : Nat} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r' ls') xs')) :
    r = r' ∧ xs.length = xs'.length := by
  have hL : ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
    approxI_famApp_botVecI (ctxEnvI Γ) r ls xs
  have hR : ApproxI (ctxEnvI Γ) (foldApps (.const r' ls') xs') (.spine r (botVecI xs)) :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ h (.spine r (botVecI xs))
      (isShallowTypeCpt_spine_botVecI r xs)).mp hL
  rcases approxI_foldApps_const_inv hR with hbot | ⟨us, hsp, hargs⟩
  · exact CptI.noConfusion hbot
  · injection hsp with hr hus
    subst hr; subst hus
    exact ⟨rfl, (botVecI_length xs).symm.trans (approxIArgs_length hargs).symm⟩

/-- Disjointness of `.pi A B` and `.sort l` under `ShallowTypeSoundnessCtxI E n`. -/
theorem not_tyConvT_pi_sort_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {l : Level}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.pi A B) (.sort l)) : False := by
  have hsort : ApproxI (ctxEnvI Γ) (.pi A B) .sort :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ hc .sort trivial).mpr (.sort (ctxEnvI Γ) l)
  rcases approxI_pi_inv hsort with h0 | ⟨_, _, h0, _, _⟩ <;> exact CptI.noConfusion h0

/-- Disjointness of `.sort l` and `.pi A B` under `ShallowTypeSoundnessCtxI E n`. -/
theorem not_tyConvT_sort_pi_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {l : Level}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.sort l) (.pi A B)) : False := by
  have hsort : ApproxI (ctxEnvI Γ) (.pi A B) .sort :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ hc .sort trivial).mp (.sort (ctxEnvI Γ) l)
  rcases approxI_pi_inv hsort with h0 | ⟨_, _, h0, _, _⟩ <;> exact CptI.noConfusion h0

/-- Disjointness of `.pi A B` and `foldApps (.const r ls) xs` under `ShallowTypeSoundnessCtxI E n`. -/
theorem not_tyConvT_pi_famApp_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.pi A B) (foldApps (.const r ls) xs)) : False := by
  have hsp : ApproxI (ctxEnvI Γ) (.pi A B) (.spine r (botVecI xs)) :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ hc (.spine r (botVecI xs))
      (isShallowTypeCpt_spine_botVecI r xs)).mpr
      (approxI_famApp_botVecI (ctxEnvI Γ) r ls xs)
  rcases approxI_pi_inv hsp with h0 | ⟨_, _, h0, _, _⟩ <;> exact CptI.noConfusion h0

/-- Disjointness of `.sort l` and `foldApps (.const r ls) xs` under `ShallowTypeSoundnessCtxI E n`. -/
theorem not_tyConvT_sort_famApp_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {l : Level} {r : Nat} {ls : List Level} {xs : List (Expr Nat)}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    (hc : TyConvT E n Γ (.sort l) (foldApps (.const r ls) xs)) : False := by
  have hsp : ApproxI (ctxEnvI Γ) (.sort l) (.spine r (botVecI xs)) :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ hc (.spine r (botVecI xs))
      (isShallowTypeCpt_spine_botVecI r xs)).mpr
      (approxI_famApp_botVecI (ctxEnvI Γ) r ls xs)
  rcases approxI_sort_inv hsp with h0 | h0 <;> exact CptI.noConfusion h0

/-- Saturation of a well-typed admitted inductive family application under
    `ShallowTypeSoundnessCtxI E n` and `PiRowField E n` in `ApproxI`. -/
theorem famApp_saturated_of_piRow_shallowSoundnessI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hshallow : ShallowTypeSoundnessCtxI E n) (hprow : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level}
    (hm : E.members r = some m) (_hind : m.mclass = .inductiveM)
    {doms : List (Expr Nat)} {u : Level}
    (hpi : instantiateLevels ls m.mtype = policyPi doms (.sort u))
    {xs : List (Expr Nat)} {w : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w)) :
    xs.length = doms.length := by
  rcases Nat.lt_trichotomy xs.length doms.length with hlt | heq | hgt
  · exfalso
    have hne : doms.drop xs.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hlt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨D, rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hpi' : instantiateLevels ls m.mtype =
        policyPi (doms.take xs.length) (policyPi (doms.drop xs.length) (.sort u)) := by
      rw [← List.take_append_drop xs.length doms] at hpi
      rw [hpi, policyPi_append]
    have hlen' : (doms.take xs.length).length = xs.length := by
      rw [List.length_take]
      first
        | exact Nat.min_eq_right (Nat.le_of_lt hlt)
        | exact Nat.min_eq_left (Nat.le_of_lt hlt)
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi' xs hlen' hty
    rw [hrest] at hconv
    simp only [policyPi] at hconv
    rw [instPrefix_pi] at hconv
    exact not_tyConvT_pi_sort_of_shallowSoundnessI hshallow hΓ hconv
  · exact heq
  · exfalso
    have hne : xs.drop doms.length ≠ [] := fun hnil =>
      Nat.not_le_of_gt hgt (List.drop_eq_nil_iff.mp hnil)
    obtain ⟨x', rest, hrest⟩ := List.exists_cons_of_ne_nil hne
    have hsplit : foldApps (.const r ls) xs =
        foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
      calc foldApps (.const r ls) xs
          = foldApps (.const r ls) (xs.take doms.length ++ xs.drop doms.length) := by
              rw [List.take_append_drop]
        _ = foldApps (foldApps (.const r ls) (xs.take doms.length)) (xs.drop doms.length) :=
            foldApps_append _ _ _
    obtain ⟨A, B, ⟨hf⟩⟩ := hasTyT_foldApps_prefix_pi
      (f := foldApps (.const r ls) (xs.take doms.length))
      (hsplit ▸ hty) hrest
    have hlen' : doms.length = (xs.take doms.length).length := by
      rw [List.length_take]
      first
        | exact (Nat.min_eq_right (Nat.le_of_lt hgt)).symm
        | exact (Nat.min_eq_left (Nat.le_of_lt hgt)).symm
    obtain ⟨_, _, _, hconv⟩ := hasTyT_spineInv_rows hW hprow hΓ hm hpi
      (xs.take doms.length) hlen' hf
    rw [instPrefix_sort] at hconv
    exact not_tyConvT_sort_pi_of_shallowSoundnessI hshallow hΓ hconv

/-- Construct `FamAppSaturation` (#7525) from `ShallowTypeSoundnessCtxI E n` and `PiRowField E n`. -/
noncomputable def famAppSaturation_of_shallowSoundnessI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (hprow : PiRowField E n) (hshallow : ShallowTypeSoundnessCtxI E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FamAppSaturation E r m ls ls' xs xs' := by
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM hW hm hind ls'
  have ⟨_, htyR⟩ := tyConvT_rhsSort hW hΓ h ⟨w, hty⟩
  have hlenL := famApp_saturated_of_piRow_shallowSoundnessI hW hshallow hprow hΓ hm hind htelL hty
  have hlenR := famApp_saturated_of_piRow_shallowSoundnessI hW hshallow hprow hΓ hm hind htelR htyR
  exact {
    doms := (piDomsOf m.mtype).map (instantiateLevels ls)
    doms' := (piDomsOf m.mtype).map (instantiateLevels ls')
    U := .sort (instLevel ls (inductiveSortLevel hW hm hind))
    U' := .sort (instLevel ls' (inductiveSortLevel hW hm hind))
    telL := htelL
    telR := htelR
    eqN := heqN
    lenDD := by simp only [List.length_map]
    lenXD := hlenL.symm
    lenXD' := hlenR.symm
  }

/-- **Projected Slot-Equality Soundness on `ApproxI` (`FamSlotPEqSoundnessCtxI`):**
    For any well-typed admitted `.inductiveM` family conversion
    `TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')`,
    each slot `i` with left-instantiated domain `instPrefix (xs.take i) d` satisfies
    typed projected equality `PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x'`
    (`RcicNativePiModelIrr`). Note that at `Prop` slots (`u = .zero`), `PEqI` holds
    unconditionally by `pEqI_famApp_of_zero`, while at relevant slots (`u ≠ .zero`),
    `PEqI` is preserved by `tprojI_sort_on_spine` / `tprojI_famApp_of_ne_zero_on_spine`. -/
def FamSlotPEqSoundnessCtxI (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level},
      E.members r = some m → m.mclass = .inductiveM →
      HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w) →
      TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') →
      ∀ (i : Nat) (x x' d : Expr Nat),
        xs[i]? = some x → xs'[i]? = some x' →
        ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d →
        PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x'

/-- At every slot `i`, `ShallowTypeSoundnessCtxI`, `FamSlotPEqSoundnessCtxI`, and `#7569`
    (`hasTyT_spineInv_rows`) yield:
    (1) projected equality `PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x'`,
    (2) native left-domain typing `Nonempty (HasTyT E n Γ x (instPrefix (xs.take i) d))`, and
    (3) compact probe approximation `ApproxI (ctxEnvI Γ) ... (.spine r (botVecI xs))` on both sides. -/
theorem famSlot_pEqI_and_leftTyping {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hshallow : ShallowTypeSoundnessCtxI E n)
    (hslotPEq : FamSlotPEqSoundnessCtxI E n) (hprow : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    {i : Nat} {x x' d : Expr Nat}
    (hx : xs[i]? = some x) (hx' : xs'[i]? = some x')
    (hd : ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d) :
    PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x' ∧
      Nonempty (HasTyT E n Γ x (instPrefix (xs.take i) d)) ∧
      ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r (botVecI xs)) ∧
      ApproxI (ctxEnvI Γ) (foldApps (.const r ls') xs') (.spine r (botVecI xs)) := by
  have hpEq : PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x' :=
    hslotPEq hΓ hm hind hty h i x x' d hx hx' hd
  have hbotL : ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r (botVecI xs)) :=
    approxI_famApp_botVecI (ctxEnvI Γ) r ls xs
  have hbotR : ApproxI (ctxEnvI Γ) (foldApps (.const r ls') xs') (.spine r (botVecI xs)) :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ h (.spine r (botVecI xs))
      (isShallowTypeCpt_spine_botVecI r xs)).mp hbotL
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have hlenL := famApp_saturated_of_piRow_shallowSoundnessI hW hshallow hprow hΓ hm hind htelL hty
  obtain ⟨⟨_, _, hargsL, _⟩⟩ := hasTyT_spineInv_rows hW hprow hΓ hm htelL xs hlenL.symm hty
  exact ⟨hpEq, ⟨hargsL i x d hx hd⟩, hbotL, hbotR⟩

/-- Reflection of projected slot equality `PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x'`
    at a non-`Prop` left-instantiated domain (`u ≠ .zero`) to native
    `ConvT E n Γ x x' (instPrefix (xs.take i) d)`. -/
def PEqIRelevantSlotReflect (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level},
      E.members r = some m → m.mclass = .inductiveM →
      HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w) →
      TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') →
      ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r (botVecI xs)) →
      ApproxI (ctxEnvI Γ) (foldApps (.const r ls') xs') (.spine r (botVecI xs)) →
      ∀ (i : Nat) (x x' d : Expr Nat) (u : Level),
        xs[i]? = some x → xs'[i]? = some x' →
        ((piDomsOf m.mtype).map (instantiateLevels ls))[i]? = some d →
        HasTyT E n Γ (instPrefix (xs.take i) d) (.sort u) → u ≠ .zero →
        HasTyT E n Γ x (instPrefix (xs.take i) d) →
        PEqI E (ctxEnvI Γ) (instPrefix (xs.take i) d) x x' →
        Nonempty (ConvT E n Γ x x' (instPrefix (xs.take i) d))

/-- Derive `RelevantSlotConv` (#7525) from `ShallowTypeSoundnessCtxI`, `FamSlotPEqSoundnessCtxI`,
    `PiRowField`, and `PEqIRelevantSlotReflect` in `ApproxI`. -/
theorem relevantSlotConv_of_shallow_slotPEq_reflect {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hshallow : ShallowTypeSoundnessCtxI E n)
    (hslotPEq : FamSlotPEqSoundnessCtxI E n) (hprow : PiRowField E n)
    (hrefl : PEqIRelevantSlotReflect E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' := by
  intro i x x' d u hx hx' hd hdT hu
  simp only [List.nil_append] at hdT ⊢
  obtain ⟨hpEq, ⟨hxT⟩, hbotL, hbotR⟩ :=
    famSlot_pEqI_and_leftTyping hW hshallow hslotPEq hprow hΓ hm hind hty h hx hx' hd
  exact hrefl hΓ hm hind hty h hbotL hbotR i x x' d u hx hx' hd hdT hu hxT hpEq

/-- **Restatement `FundamentalFamSpineI` in `ApproxI` (equivalent `↔` to `FamLevelAndSlotConv`
    under `ShallowTypeSoundnessCtxI`):**
    Combines shallow spine probe approximation `.spine r (botVecI xs)` and length equality with
    `FamLevelAndSlotConv`. -/
def FundamentalFamSpineI (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (r : Nat) (m : CheckedMember) (ls ls' : List Level) (xs xs' : List (Expr Nat)) : Prop :=
  eqNList ls ls' ∧
  xs.length = xs'.length ∧
  ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r (botVecI xs)) ∧
  ApproxI (ctxEnvI Γ) (foldApps (.const r ls') xs') (.spine r (botVecI xs)) ∧
  RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'

/-- Bidirectional equivalence (`↔`) between `FundamentalFamSpineI` and `FamLevelAndSlotConv`
    under `ShallowTypeSoundnessCtxI E n`. -/
theorem fundamentalFamSpineI_iff_famLevelAndSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hshallow : ShallowTypeSoundnessCtxI E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} (m : CheckedMember) {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    FundamentalFamSpineI E n Γ r m ls ls' xs xs' ↔
      FamLevelAndSlotConv E n Γ m ls ls' xs xs' := by
  have hlen := (tyConvT_famApp_head_length_of_shallowSoundnessI hshallow hΓ h).2
  have hbotL := approxI_famApp_botVecI (ctxEnvI Γ) r ls xs
  have hbotR :=
    (shallowTypeSemEqI_of_tyConvT hshallow hΓ h (.spine r (botVecI xs))
      (isShallowTypeCpt_spine_botVecI r xs)).mp hbotL
  constructor
  · rintro ⟨heqN, _, _, _, hslot⟩
    exact ⟨heqN, hslot⟩
  · rintro ⟨heqN, hslot⟩
    exact ⟨heqN, hlen, hbotL, hbotR, hslot⟩

/-- Assemble `famAppRow` in `ApproxI` from `PiRowField`, `ShallowTypeSoundnessCtxI`,
    `FamSlotPEqSoundnessCtxI`, `eqNList ls ls'`, and `PEqIRelevantSlotReflect`. -/
theorem famAppRow_of_piRow_shallow_slotPEq_reflect
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ)
    (hprow : PiRowField E n) (hshallow : ShallowTypeSoundnessCtxI E n)
    (hslotPEq : FamSlotPEqSoundnessCtxI E n)
    (hrefl : PEqIRelevantSlotReflect E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  let sat := famAppSaturation_of_shallowSoundnessI hW hΓ hprow hshallow hm hind heqN hty h
  have hslot :=
    relevantSlotConv_of_shallow_slotPEq_reflect hW hshallow hslotPEq hprow hrefl hΓ hm hind hty h
  exact famAppRow_of_piRow_saturation_slotConv hprow hW hΓ sat hslot hm hind hty h


/-! ### §8 — Context-Aware Weak-Head Determinism & Invariance (`WhNormalCtx`, `WhDetCtx`), Normalized Family-Injective Logical Relation (`LRTypeFamIN` / `FundamentalLRFamINT`), Family Adequacy (`AdequacyFamICtx`), and Top-Level `RcicKernelRowsAssembly` Wiring (#7620/#7650)

In §7 we repaired the context-free `WhRed E` / `EnvI.bot` logical relation (`LRTypeIN`) into
context-aware `LRTypeICtx` over `WhRedCtx E Γ` and `ctxEnvI Γ`. Here in §8 we complete the
structural theory of the context-aware family logical relation and wire all semantic routes
into `RcicKernelRowsAssembly` (#7620/#7650):

- **Part A (`WhNormalCtx`, `WhDetCtx`, `whDetCtx_of_whDet`, `whRedCtx_normal_unique`, and `approxI_ctxEnvI_whRedCtx`):**
  Proves that `WhStepCtx E Γ` is deterministic whenever `WhStep E` is (`whDetCtx_of_whDet`),
  yielding uniqueness of `WhNormalCtx E Γ` normal forms (`whRedCtx_normal_unique`), and proves
  invariance of `ApproxI (ctxEnvI Γ)` along `WhStepCtx` / `WhRedCtx` from `WhApproxInvCore E`
  alone (`approxI_ctxEnvI_whStepCtx`, `approxI_ctxEnvI_whRedCtx`, `approxI_ctxEnvI_whRedCtx_emptyEnv`).
- **Part B (`ConvArgsT` ↔ `RelevantSlotConv`, Context Transport, and Symmetry/Transitivity Across Level Instantiations):**
  Proves `relevantSlotConv_of_convArgsT`, `convArgsT_iff_relevantSlotConv`, `convArgsT_ctx`,
  `convArgsT_assump_dom`, `hasTyT_assump_dom`, `CtxSameValues` invariance of `WhRedCtx` /
  `WhNormalCtx`, and symmetry/transitivity of `ConvArgsT` across level-convertible family
  telescopes (`convArgs_symm_walk`, `convArgs_symm_instMtype`, `convArgs_trans_instMtype`).
- **Part C (Normalized Family-Injective Logical Relation `LRTypeFamIN` / `FundamentalLRFamINT` and Family Adequacy `AdequacyFamICtx`):**
  Defines `LRTypeFamIN` (extending `LRTypeIN` with `WhRedCtx E Γ` and a family-injective
  `famSpine` clause for admitted `.inductiveM` heads), proves weak-head expansion, congruences,
  `zetaSortCtx` satisfaction, context transport, symmetry, transitivity, non-trivial read-off of
  BOTH `PiRowField` and `FamAppRowLink` (`piRowField_of_fundamentalLRFamINT`,
  `famAppRow_of_fundamentalLRFamINT`, `famRelevantSlotConv_of_fundamentalLRFamINT`), and family
  adequacy (`AdequacyFamICtx`, `adequacyFamShapeICtx_of_fundamentalLRFamINT`,
  `adequacyFamICtx_of_fundamentalLRFamINT`).
- **Part D (Top-Level Wiring into `RcicKernelRowsAssembly` #7620/#7650):**
  Supplies `KernelRowsAssembly.FamRelevantSlotConv`, `TypedRowsWf`, and downstream census
  theorems `DT-010`, `DT-011`, `DT-012`, `DT-019`, and `IA-024`. -/

/-! #### Part A — Context-Aware Weak-Head Normal Forms (`WhNormalCtx`), Determinism (`WhDetCtx`, `whDetCtx_of_whDet`, `whRedCtx_normal_unique`), and Model Invariance (`approxI_ctxEnvI_whRedCtx`) -/

/-- Transitivity of `WhRedCtx E Γ`. -/
theorem whRedCtx_trans {E : ResolvedEnv} {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedCtx E Γ a b) (h₂ : WhRedCtx E Γ b c) : WhRedCtx E Γ a c := by
  induction h₁ with
  | refl => exact h₂
  | step hs _ ih => exact .step hs (ih h₂)

/-- Every context-free `WhStep E a b` is a `WhStepCtx E Γ a b`. -/
theorem whStep_to_whStepCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhStep E a b) : WhStepCtx E Γ a b := by
  induction h with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih

/-- Every context-free `WhRed E a b` is a `WhRedCtx E Γ a b`. -/
theorem whRed_to_whRedCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRed E a b) : WhRedCtx E Γ a b := by
  induction h with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStep_to_whStepCtx hs) ih

/-- Weak-head normality under `WhStepCtx E Γ` (including `zetaLocal`). -/
def WhNormalCtx (E : ResolvedEnv) (Γ : LCtx) (X : Expr Nat) : Prop :=
  ∀ Y, ¬ WhStepCtx E Γ X Y

/-- `.pi A B` is `WhNormalCtx E Γ`. -/
theorem whNormalCtx_pi {E : ResolvedEnv} {Γ : LCtx} (A B : Expr Nat) :
    WhNormalCtx E Γ (.pi A B) :=
  fun _ h => whStepCtx_pi_false h

/-- `.sort u` is `WhNormalCtx E Γ`. -/
theorem whNormalCtx_sort {E : ResolvedEnv} {Γ : LCtx} (u : Level) :
    WhNormalCtx E Γ (.sort u) :=
  fun _ h => whStepCtx_sort_false h

/-- Every admitted `.inductiveM` family application spine `foldApps (.const r ls) xs` is
    `WhNormalCtx E Γ` under `EnvWfT E`. -/
theorem whNormalCtx_famApp {E : ResolvedEnv} {Γ : LCtx} (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (ls : List Level) (xs : List (Expr Nat)) :
    WhNormalCtx E Γ (foldApps (.const r ls) xs) :=
  fun _ h => whStepCtx_famApp_false hW hm hind xs h

/-- Boolean classifier for expressions whose leftmost application head is a bound variable `.bvar i`. -/
def isAnyBvarSpine : Expr Nat → Bool
  | .bvar _ => true
  | .app f _ => isAnyBvarSpine f
  | _ => false

/-- `foldApps f xs` preserves `isAnyBvarSpine f = false`. -/
theorem isAnyBvarSpine_foldApps_false {f : Expr Nat} (hf : isAnyBvarSpine f = false) :
    ∀ (xs : List (Expr Nat)), isAnyBvarSpine (foldApps f xs) = false
  | [] => hf
  | _ :: xs => isAnyBvarSpine_foldApps_false (by simp [isAnyBvarSpine, hf]) xs

/-- No expression `a` with `isAnyBvarSpine a = true` can take a context-free `WhStep E a b`. -/
theorem isAnyBvarSpine_of_whStep_false {E : ResolvedEnv} {a b : Expr Nat}
    (h : WhStep E a b) : isAnyBvarSpine a = false := by
  induction h with
  | beta _ _ _ => rfl
  | zeta _ _ _ => rfl
  | delta _ _ => rfl
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      rw [hlhs]
      exact isAnyBvarSpine_foldApps_false (f := .const r ls) rfl (pre ++ [major])
  | lit _ => rfl
  | appHead _ ih => exact ih

/-- Every `WhStepCtx E Γ a b` is either a context-free `WhStep E a b` or has a `.bvar`-headed
    source (`isAnyBvarSpine a = true`). -/
theorem whStepCtx_to_whStep_or_bvarSpine {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) : WhStep E a b ∨ isAnyBvarSpine a = true := by
  induction h with
  | beta A body arg => exact Or.inl (.beta A body arg)
  | zeta A v body => exact Or.inl (.zeta A v body)
  | zetaLocal _ => exact Or.inr rfl
  | delta hres hbody => exact Or.inl (.delta hres hbody)
  | iota hI => exact Or.inl (.iota hI)
  | lit t => exact Or.inl (.lit t)
  | appHead _ ih =>
      rcases ih with hs | hb
      · exact Or.inl (.appHead hs)
      · exact Or.inr hb

/-- On any `.bvar`-headed spine (`isAnyBvarSpine a = true`), `WhStepCtx E Γ` is unconditionally
    deterministic (only `zetaLocal` at the head `.bvar` can fire). -/
theorem whStepCtx_bvarSpine_unique {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h₁ : WhStepCtx E Γ a b) (hb : isAnyBvarSpine a = true) :
    ∀ {c : Expr Nat}, WhStepCtx E Γ a c → b = c := by
  induction h₁ with
  | beta _ _ _ => exact Bool.noConfusion hb
  | zeta _ _ _ => exact Bool.noConfusion hb
  | delta _ _ => exact Bool.noConfusion hb
  | lit _ => exact Bool.noConfusion hb
  | iota hI =>
      rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
      have hbf : isAnyBvarSpine (foldApps (.const r ls) (pre ++ [major])) = false :=
        isAnyBvarSpine_foldApps_false (f := .const r ls) rfl (pre ++ [major])
      rw [hlhs, hbf] at hb
      exact Bool.noConfusion hb
  | zetaLocal hv₁ =>
      intro c h₂
      cases h₂ with
      | zetaLocal hv₂ => exact Option.some.inj (hv₁.symm.trans hv₂)
      | iota hI =>
          rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
          have hbf : isAnyBvarSpine (foldApps (.const r ls) (pre ++ [major])) = false :=
            isAnyBvarSpine_foldApps_false (f := .const r ls) rfl (pre ++ [major])
          rw [hlhs, hbf] at hb
          exact Bool.noConfusion hb
  | appHead _ ih =>
      intro c h₂
      cases h₂ with
      | beta _ _ _ => exact Bool.noConfusion hb
      | iota hI =>
          rcases derivedIotaU_recHead hI with ⟨r, ls, pre, major, _, hlhs, _, _⟩
          have hbf : isAnyBvarSpine (foldApps (.const r ls) (pre ++ [major])) = false :=
            isAnyBvarSpine_foldApps_false (f := .const r ls) rfl (pre ++ [major])
          rw [hlhs, hbf] at hb
          exact Bool.noConfusion hb
      | appHead hs₂ => exact congrArg (Expr.app · _) (ih hb hs₂)

/-- Determinism of `WhStepCtx E Γ`. -/
def WhDetCtx (E : ResolvedEnv) (Γ : LCtx) : Prop :=
  ∀ {a b c : Expr Nat}, WhStepCtx E Γ a b → WhStepCtx E Γ a c → b = c

/-- `WhDet E` (`RcicNativePiModelLRCases`) automatically implies `WhDetCtx E Γ` for every context `Γ`. -/
theorem whDetCtx_of_whDet {E : ResolvedEnv} (Γ : LCtx) (hdet : WhDet E) :
    WhDetCtx E Γ := by
  intro a b c h₁ h₂
  rcases whStepCtx_to_whStep_or_bvarSpine h₁ with hs₁ | hb₁
  · rcases whStepCtx_to_whStep_or_bvarSpine h₂ with hs₂ | hb₂
    · exact hdet hs₁ hs₂
    · rw [isAnyBvarSpine_of_whStep_false hs₁] at hb₂
      exact Bool.noConfusion hb₂
  · exact whStepCtx_bvarSpine_unique h₁ hb₁ h₂

/-- Under `WhDetCtx E Γ`, `WhNormalCtx E Γ` normal forms of `WhRedCtx E Γ` are unique. -/
theorem whRedCtx_normal_unique {E : ResolvedEnv} {Γ : LCtx} (hdet : WhDetCtx E Γ)
    {a X : Expr Nat} (h : WhRedCtx E Γ a X) (hX : WhNormalCtx E Γ X) :
    ∀ {Y : Expr Nat}, WhRedCtx E Γ a Y → WhNormalCtx E Γ Y → X = Y := by
  induction h with
  | refl =>
      intro Y hY _
      cases hY with
      | refl => rfl
      | step hs _ => exact (hX _ hs).elim
  | step hs _ ih =>
      intro Y hY hYn
      cases hY with
      | refl => exact (hYn _ hs).elim
      | step hs' hr' =>
          have heq := hdet hs hs'
          subst heq
          exact ih hX hr' hYn

/-- Invariance of `ApproxI ρ` across a single `WhStepCtx E Γ` step for any context-respecting
    environment `CtxEnvI Γ ρ`, given `WhApproxInvCore E` (δ/ι invariance). -/
theorem whStepCtx_approxI_iff {E : ResolvedEnv} (hcore : WhApproxInvCore E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvI Γ ρ) {a b : Expr Nat}
    (h : WhStepCtx E Γ a b) (c : CptI) :
    ApproxI ρ a c ↔ ApproxI ρ b c := by
  induction h generalizing c with
  | beta A body arg => exact approxI_beta ρ A body arg c
  | zeta A v body => exact approxI_zeta ρ A v body c
  | zetaLocal hv => exact semEqI_zetaLocal hρ hv c
  | delta hres hbody => exact hcore.1 hres hbody ρ c
  | iota hI => exact hcore.2 hI ρ c
  | lit t => exact approxI_lit_iff ρ t c
  | appHead _ ih => exact semEqI_app_left ih c

/-- Invariance of `ApproxI ρ` across multi-step `WhRedCtx E Γ` reduction for any `CtxEnvI Γ ρ`,
    given `WhApproxInvCore E`. -/
theorem whRedCtx_approxI_iff {E : ResolvedEnv} (hcore : WhApproxInvCore E)
    {Γ : LCtx} {ρ : EnvI} (hρ : CtxEnvI Γ ρ) {a b : Expr Nat}
    (h : WhRedCtx E Γ a b) (c : CptI) :
    ApproxI ρ a c ↔ ApproxI ρ b c := by
  induction h with
  | refl => exact Iff.rfl
  | step hs _ ih => exact (whStepCtx_approxI_iff hcore hρ hs c).trans ih

/-- Invariance of `ApproxI (ctxEnvI Γ)` across `WhStepCtx E Γ` from `WhApproxInvCore E`. -/
theorem approxI_ctxEnvI_whStepCtx {E : ResolvedEnv} (hcore : WhApproxInvCore E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhStepCtx E Γ a b) (c : CptI) :
    ApproxI (ctxEnvI Γ) a c ↔ ApproxI (ctxEnvI Γ) b c :=
  whStepCtx_approxI_iff hcore (ctxEnvI_respects Γ) h c

/-- Invariance of `ApproxI (ctxEnvI Γ)` across `WhRedCtx E Γ` from `WhApproxInvCore E`. -/
theorem approxI_ctxEnvI_whRedCtx {E : ResolvedEnv} (hcore : WhApproxInvCore E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhRedCtx E Γ a b) (c : CptI) :
    ApproxI (ctxEnvI Γ) a c ↔ ApproxI (ctxEnvI Γ) b c :=
  whRedCtx_approxI_iff hcore (ctxEnvI_respects Γ) h c

/-- Unconditional invariance of `ApproxI (ctxEnvI Γ)` across `WhRedCtx emptyEnv Γ`. -/
theorem approxI_ctxEnvI_whRedCtx_emptyEnv {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedCtx emptyEnv Γ a b) (c : CptI) :
    ApproxI (ctxEnvI Γ) a c ↔ ApproxI (ctxEnvI Γ) b c :=
  approxI_ctxEnvI_whRedCtx whApproxInvCore_emptyEnv h c


/-! #### Part B — `ConvArgsT` ↔ `RelevantSlotConv`, Context Transport, and Symmetry/Transitivity Across Level Instantiations -/

/-- `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'` implies `RelevantSlotConv` at the
    canonical stored domains `(piDomsOf m.mtype).map (instantiateLevels ls)` (via `convArgsT_instPrefix`
    from `RcicIotaSRRowsTel` and `instMtype_policyPi_of_inductiveM`). -/
theorem relevantSlotConv_of_convArgsT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs xs' : List (Expr Nat)}
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' := by
  intro i x x' d _ hx hx' hd _ _
  simp only [List.nil_append]
  exact convArgsT_instPrefix hargs
    ((piDomsOf m.mtype).map (instantiateLevels ls))
    (.sort (instLevel ls (inductiveSortLevel hW hm hind)))
    (instMtype_policyPi_of_inductiveM hW hm hind ls)
    i x x' d hx hx' hd

/-- Under `EnvWfT E`, `CtxWfT E n Γ`, `PiRowField E n`, and `FamAppSaturation`,
    `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'` is logically equivalent (`↔`) to
    `RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs'`. -/
theorem convArgsT_iff_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ) (hpi : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w : Level}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (h : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs')) :
    ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' ↔
      RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' := by
  constructor
  · exact relevantSlotConv_of_convArgsT hW hm hind
  · intro hslot
    let sat : FamAppSaturation E r m ls ls' xs xs' := {
      doms := (piDomsOf m.mtype).map (instantiateLevels ls)
      doms' := (piDomsOf m.mtype).map (instantiateLevels ls')
      U := .sort (instLevel ls (inductiveSortLevel hW hm hind))
      U' := .sort (instLevel ls' (inductiveSortLevel hW hm hind))
      telL := instMtype_policyPi_of_inductiveM hW hm hind ls
      telR := instMtype_policyPi_of_inductiveM hW hm hind ls'
      eqN := heqN
      lenDD := by simp only [List.length_map]
      lenXD := by rw [List.length_map, hlen]
      lenXD' := by rw [List.length_map, hlen']
    }
    exact (famAppRow_of_piRow_saturation_slotConv hpi hW hΓ sat hslot hm hind hty h).2.2

/-- Transport `ConvArgsT` across a pointwise context conversion `CtxConvT E n Γ Γ'`. -/
theorem convArgsT_ctx {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hcc : CtxConvT E n Γ Γ') {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') : ConvArgsT E n Γ' T xs xs' := by
  induction h with
  | nil T => exact .nil T
  | cons A B f f' fs fs' hc hs ih =>
      obtain ⟨c⟩ := hc
      exact .cons A B f f' fs fs' ⟨convT_ctx hcl hcc c⟩ ih

/-- Transport `HasTyT` along a `TyConvT` chain at the head assumption. -/
def hasTyT_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {e B : Expr Nat},
      HasTyT E n (.assumption A₂ :: Γ) e B →
      HasTyT E n (.assumption A₁ :: Γ) e B
  | _, _, .refl _ _, _, _, _, _, h => h
  | _, _, .of _ _ _ _ hc, _, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      hasTyT_ctx hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc)) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      hasTyT_assump_dom hcl hW hΓ c₁ hA₁ (hasTyT_assump_dom hcl hW hΓ c₂ hM h)

/-- Transport `ConvArgsT` along a `TyConvT` chain at the head assumption. -/
theorem convArgsT_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {T : Expr Nat} {xs xs' : List (Expr Nat)},
      ConvArgsT E n (.assumption A₂ :: Γ) T xs xs' →
      ConvArgsT E n (.assumption A₁ :: Γ) T xs xs'
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ _ _ _ hc, _, _, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      convArgsT_ctx hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc)) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      convArgsT_assump_dom hcl hW hΓ c₁ hA₁ (convArgsT_assump_dom hcl hW hΓ c₂ hM h)

/-- Two contexts have the exact same local let-values at all de Bruijn indices
    (satisfied whenever contexts differ only in `.assumption` types). -/
def CtxSameValues (Γ Γ' : LCtx) : Prop :=
  ∀ i, lookupValue Γ i = lookupValue Γ' i

theorem ctxSameValues_refl (Γ : LCtx) : CtxSameValues Γ Γ :=
  fun _ => rfl

theorem ctxSameValues_symm {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ') : CtxSameValues Γ' Γ :=
  fun i => (h i).symm

theorem ctxSameValues_same (d : LocalDecl) {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ') :
    CtxSameValues (d :: Γ) (d :: Γ')
  | 0 => rfl
  | i + 1 => by
      rw [lookupValue_cons_succ, lookupValue_cons_succ, h i]

theorem ctxSameValues_assumption (A₁ A₂ : Expr Nat) {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ') :
    CtxSameValues (.assumption A₁ :: Γ) (.assumption A₂ :: Γ')
  | 0 => rfl
  | i + 1 => by
      rw [lookupValue_cons_succ, lookupValue_cons_succ, h i]

/-- `WhStepCtx` is invariant under `CtxSameValues`. -/
theorem whStepCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hs : WhStepCtx E Γ a b) : WhStepCtx E Γ' a b := by
  induction hs with
  | beta A body arg => exact .beta A body arg
  | zeta A v body => exact .zeta A v body
  | @zetaLocal i v hv =>
      rw [h i] at hv
      exact .zetaLocal hv
  | delta hres hbody => exact .delta hres hbody
  | iota hI => exact .iota hI
  | lit t => exact .lit t
  | appHead _ ih => exact .appHead ih

/-- `WhRedCtx` is invariant under `CtxSameValues`. -/
theorem whRedCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {a b : Expr Nat} (hr : WhRedCtx E Γ a b) : WhRedCtx E Γ' a b := by
  induction hr with
  | refl e => exact .refl e
  | step hs _ ih => exact .step (whStepCtx_of_sameValues h hs) ih

/-- `WhNormalCtx` is invariant under `CtxSameValues`. -/
theorem whNormalCtx_of_sameValues {E : ResolvedEnv} {Γ Γ' : LCtx} (h : CtxSameValues Γ Γ')
    {X : Expr Nat} (hn : WhNormalCtx E Γ X) : WhNormalCtx E Γ' X :=
  fun Y hs => hn Y (whStepCtx_of_sameValues (ctxSameValues_symm h) hs)

/-- Symmetry walk for `ConvArgsT` across two `instPrefix`/`policyPi` telescopes linked by `TyConvT`. -/
theorem convArgs_symm_walk {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {U U' : Expr Nat}
    (pre pre' xs ys ds ds' : List (Expr Nat))
    (hlen : ds.length = xs.length) (hlen' : ds'.length = ys.length)
    {s : Level} (hT : HasTyT E n Γ (instPrefix pre (policyPi ds U)) (.sort s))
    (res : TyConvT E n Γ (instPrefix pre (policyPi ds U)) (instPrefix pre' (policyPi ds' U')))
    (hxy : ConvArgsT E n Γ (instPrefix pre (policyPi ds U)) xs ys) :
    ConvArgsT E n Γ (instPrefix pre' (policyPi ds' U')) ys xs := by
  induction xs generalizing pre pre' ys ds ds' s with
  | nil =>
      cases ys with
      | nil => exact .nil _
      | cons _ _ => exact Nat.noConfusion (NativeFamilyProjection.convArgs_length hxy)
  | cons x xs ih =>
      cases ys with
      | nil => exact Nat.noConfusion (NativeFamilyProjection.convArgs_length hxy)
      | cons y ys =>
          cases ds with
          | nil => exact Nat.noConfusion hlen
          | cons d ds =>
              cases ds' with
              | nil => exact Nat.noConfusion hlen'
              | cons d' ds' =>
                  have hπ : instPrefix pre (policyPi (d :: ds) U) =
                      .pi (instPrefix pre d) (instTel pre (policyPi ds U)) :=
                    instPrefix_pi _ _ _
                  have hπ' : instPrefix pre' (policyPi (d' :: ds') U') =
                      .pi (instPrefix pre' d') (instTel pre' (policyPi ds' U')) :=
                    instPrefix_pi _ _ _
                  rw [hπ] at hxy hT res
                  rw [hπ'] at res ⊢
                  cases hxy with
                  | cons _ _ _ _ _ _ hc hs =>
                      obtain ⟨cxy⟩ := hc
                      obtain ⟨⟨dA⟩, _⟩ := hpi hΓ res
                      have cyx : ConvT E n Γ y x (instPrefix pre' d') :=
                        convT_of_tyConv (.symm Γ x y _ cxy) dA
                      obtain ⟨dres⟩ := NativeFamilyProjection.residual_chain hW hpi hΓ hT res cxy
                      obtain ⟨_, vB, _, hB, _⟩ := hasTyTInv_pi hT rfl
                      obtain ⟨⟨hx⟩, _⟩ := convT_endpoints hW hΓ cxy
                      have hT' : HasTyT E n Γ (instPrefix (pre ++ [x]) (policyPi ds U)) (.sort vB) := by
                        rw [instPrefix_snoc]
                        exact hasTyT_subst0_of_envWfT hW hB hx
                      have dres' : TyConvT E n Γ
                          (instPrefix (pre ++ [x]) (policyPi ds U))
                          (instPrefix (pre' ++ [y]) (policyPi ds' U')) := by
                        rw [instPrefix_snoc, instPrefix_snoc]
                        exact dres
                      have hs' : ConvArgsT E n Γ (instPrefix (pre ++ [x]) (policyPi ds U)) xs ys := by
                        rw [instPrefix_snoc]
                        exact hs
                      have htail := ih (pre ++ [x]) (pre' ++ [y]) ys ds ds'
                        (Nat.succ.inj hlen) (Nat.succ.inj hlen') hT' dres' hs'
                      rw [instPrefix_snoc] at htail
                      exact .cons _ _ y x ys xs ⟨cyx⟩ htail

/-- Symmetry of `ConvArgsT` across level-convertible instantiations of an admitted `.inductiveM`
    member's stored type `m.mtype`. -/
theorem convArgs_symm_instMtype {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hpi : PiRowField E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs ys : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') ys) (.sort w'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : ys.length = (piDomsOf m.mtype).length)
    (hxy : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs ys) :
    ConvArgsT E n Γ (instantiateLevels ls' m.mtype) ys xs := by
  obtain ⟨hlsl, hwfL⟩ := NativeFamilyProjection.native_level_facts hm hty
  obtain ⟨hlsl', hwfR⟩ := NativeFamilyProjection.native_level_facts hm hty'
  obtain ⟨d⟩ := NativeFamilyProjection.storedLevels_chain hW hm hlsl hlsl' hwfL hwfR heqN
  obtain ⟨s₀, hs₀⟩ := instMtypeSort (Γ := Γ) (envClosed_of_envWfT hW)
    (envWfT_mtypeSortTyped hW) (envWfT_levels hW) (iotaLevelsT_of_envWfT hW) hm hlsl hwfL
  have htelL := instMtype_policyPi_of_inductiveM hW hm hind ls
  have htelR := instMtype_policyPi_of_inductiveM hW hm hind ls'
  have hs₀' : HasTyT E n Γ
      (instPrefix [] (policyPi ((piDomsOf m.mtype).map (instantiateLevels ls))
        (.sort (instLevel ls (inductiveSortLevel hW hm hind))))) (.sort s₀) := by
    simpa only [instPrefix_nil, ← htelL] using hs₀
  have d' : TyConvT E n Γ
      (instPrefix [] (policyPi ((piDomsOf m.mtype).map (instantiateLevels ls))
        (.sort (instLevel ls (inductiveSortLevel hW hm hind)))))
      (instPrefix [] (policyPi ((piDomsOf m.mtype).map (instantiateLevels ls'))
        (.sort (instLevel ls' (inductiveSortLevel hW hm hind))))) := by
    simpa only [instPrefix_nil, ← htelL, ← htelR] using d
  have hxy' : ConvArgsT E n Γ
      (instPrefix [] (policyPi ((piDomsOf m.mtype).map (instantiateLevels ls))
        (.sort (instLevel ls (inductiveSortLevel hW hm hind))))) xs ys := by
    simpa only [instPrefix_nil, ← htelL] using hxy
  have hres := convArgs_symm_walk hW hpi hΓ [] [] xs ys
    ((piDomsOf m.mtype).map (instantiateLevels ls))
    ((piDomsOf m.mtype).map (instantiateLevels ls'))
    (by rw [List.length_map, hlen])
    (by rw [List.length_map, hlen'])
    hs₀' d' hxy'
  simpa only [instPrefix_nil, ← htelR] using hres

/-- Transitivity of `ConvArgsT` across level-convertible instantiations of an admitted member's
    stored type `m.mtype` (via `NativeFamilyProjection.convArgs_transAcross`). -/
theorem convArgs_trans_instMtype {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hpi : PiRowField E n) (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m)
    {ls ls' : List Level} {xs ys zs : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') ys) (.sort w'))
    (heqN : eqNList ls ls')
    (hxy : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs ys)
    (hyz : ConvArgsT E n Γ (instantiateLevels ls' m.mtype) ys zs) :
    ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs zs := by
  obtain ⟨hlsl, hwfL⟩ := NativeFamilyProjection.native_level_facts hm hty
  obtain ⟨hlsl', hwfR⟩ := NativeFamilyProjection.native_level_facts hm hty'
  obtain ⟨d⟩ := NativeFamilyProjection.storedLevels_chain hW hm hlsl hlsl' hwfL hwfR heqN
  obtain ⟨_, hs₀⟩ := instMtypeSort (Γ := Γ) (envClosed_of_envWfT hW)
    (envWfT_mtypeSortTyped hW) (envWfT_levels hW) (iotaLevelsT_of_envWfT hW) hm hlsl hwfL
  exact NativeFamilyProjection.convArgs_transAcross hW hpi hΓ hxy hs₀ d hyz


/-! #### Part C — Normalized Family-Injective Logical Relation (`LRTypeFamIN` / `FundamentalLRFamINT`), Structural Cases (`expand`, `congr`, `ctx`, `symm`, `trans`), Read-Off (`piRow` + `famAppRow`), and Family Adequacy (`AdequacyFamICtx`) -/

/-- **Normalized, Family-Injective, Context-Aware Logical Relation (`LRTypeFamIN`):**
    Extends `LRTypeIN` (`RcicNativePiModelLRCases`) with:
    (1) context-aware `WhRedCtx E Γ` and `WhNormalCtx E Γ` (including `WhStepCtx.zetaLocal`), and
    (2) a dedicated `famSpine` clause for admitted `.inductiveM` family heads `r` that records
        weak-head reduction of both sides to saturated `r`-headed spines with `eqNList ls ls'`
        and `ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'`. -/
inductive LRTypeFamIN (E : ResolvedEnv) (n : Nat) : LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (A A' : Expr Nat) : LRTypeFamIN E n Γ A A' .bot
  | sort {Γ : LCtx} {A A' : Expr Nat} {u u' : Level}
      (h : WhRedCtx E Γ A (.sort u)) (h' : WhRedCtx E Γ A' (.sort u')) :
      LRTypeFamIN E n Γ A A' .sort
  | pi {Γ : LCtx} {A A' A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
      (h : WhRedCtx E Γ A (.pi A₁ B₁)) (h' : WhRedCtx E Γ A' (.pi A₂ B₂))
      (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
      (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
      (ra : LRTypeFamIN E n Γ A₁ A₂ a)
      (rf : ∀ s ∈ f, LRTypeFamIN E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
      LRTypeFamIN E n Γ A A' (.pi a f)
  | famSpine {Γ : LCtx} {A A' : Expr Nat} {r : Nat} {m : CheckedMember}
      {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level} {args : List CptI}
      (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
      (h : WhRedCtx E Γ A (foldApps (.const r ls) xs))
      (h' : WhRedCtx E Γ A' (foldApps (.const r ls') xs'))
      (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
      (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
      (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
      (heqN : eqNList ls ls')
      (hlen : xs.length = (piDomsOf m.mtype).length)
      (hlen' : xs'.length = (piDomsOf m.mtype).length)
      (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
      LRTypeFamIN E n Γ A A' (.spine r args)
  | otherSpine {Γ : LCtx} {A A' X X' : Expr Nat} {r : Nat} {args : List CptI}
      (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
      (h : WhRedCtx E Γ A X) (h' : WhRedCtx E Γ A' X')
      (hX : WhNormalCtx E Γ X) (hX' : WhNormalCtx E Γ X')
      (hc : TyConvT E n Γ X X') :
      LRTypeFamIN E n Γ A A' (.spine r args)

/-- Closure of `LRTypeFamIN` under weak-head expansion (`WhRedCtx E Γ`) on both sides. -/
theorem lrTypeFamIN_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A A' X X' : Expr Nat} {c : CptI}
    (hX : WhRedCtx E Γ A X) (hX' : WhRedCtx E Γ A' X') (h : LRTypeFamIN E n Γ X X' c) :
    LRTypeFamIN E n Γ A A' c := by
  cases h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort (whRedCtx_trans hX h) (whRedCtx_trans hX' h')
  | pi h h' hΓ₁ hdom hcod ra rf =>
      exact .pi (whRedCtx_trans hX h) (whRedCtx_trans hX' h') hΓ₁ hdom hcod ra rf
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind (whRedCtx_trans hX h) (whRedCtx_trans hX' h')
        hty hty' hc heqN hlen hlen' hargs
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot (whRedCtx_trans hX h) (whRedCtx_trans hX' h') hn hn' hc

/-- The `.pi` congruence case for `LRTypeFamIN`. -/
theorem lrTypeFamIN_pi_congr {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ B₁ A₂ B₂ : Expr Nat} {a : CptI} {f : List (List CptI × CptI)}
    (hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ))
    (hdom : TyConvT E n Γ A₁ A₂) (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
    (ra : LRTypeFamIN E n Γ A₁ A₂ a)
    (rf : ∀ s ∈ f, LRTypeFamIN E n (.assumption A₁ :: Γ) B₁ B₂ s.2) :
    LRTypeFamIN E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi a f) :=
  .pi (.refl _) (.refl _) hΓ₁ hdom hcod ra rf

/-- The `sorts` case for `LRTypeFamIN`. -/
theorem lrTypeFamIN_sort_congr {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (u v : Level) :
    LRTypeFamIN E n Γ (.sort u) (.sort v) .sort :=
  .sort (.refl _) (.refl _)

/-- The `famSpine` congruence case for `LRTypeFamIN` from `ConvArgsT`. -/
theorem lrTypeFamIN_famSpine_congr {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    {w w' : Level} (args : List CptI)
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    LRTypeFamIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args) :=
  .famSpine hm hind (.refl _) (.refl _) hty hty' hc heqN hlen hlen' hargs

/-- Construct `LRTypeFamIN` at `.spine r args` for two family spines from `PiRowField` and
    `RelevantSlotConv` (#7525). -/
theorem lrTypeFamIN_famSpine_of_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (hΓ : CtxWfT E n Γ) (hpi : PiRowField E n)
    {r : Nat} {m : CheckedMember} {ls ls' : List Level} {xs xs' : List (Expr Nat)}
    {w : Level} (args : List CptI)
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hc : TyConvT E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs'))
    (heqN : eqNList ls ls')
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (hlen' : xs'.length = (piDomsOf m.mtype).length)
    (hslot : RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs') :
    LRTypeFamIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args) := by
  obtain ⟨w', hty'⟩ := tyConvT_rhsSort hW hΓ hc ⟨w, hty⟩
  have hargs := (convArgsT_iff_relevantSlotConv hW hΓ hpi hm hind heqN hlen hlen' hty hc).mpr hslot
  exact .famSpine hm hind (.refl _) (.refl _) hty hty' hc heqN hlen hlen' hargs

/-- The `otherSpine` congruence case for `LRTypeFamIN`. -/
theorem lrTypeFamIN_otherSpine_congr {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {X X' : Expr Nat} (r : Nat) (args : List CptI)
    (hnot : ∀ m, E.members r = some m → m.mclass ≠ .inductiveM)
    (hX : WhNormalCtx E Γ X) (hX' : WhNormalCtx E Γ X')
    (hc : TyConvT E n Γ X X') :
    LRTypeFamIN E n Γ X X' (.spine r args) :=
  .otherSpine hnot (.refl _) (.refl _) hX hX' hc

/-- `LRTypeFamIN` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the forward
    direction `(.sort .zero, .bvar 0)`. -/
theorem lrTypeFamIN_zetaSortCtx (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c) :
    LRTypeFamIN E n zetaSortCtx (.sort .zero) (.bvar 0) c := by
  rcases approxI_sort_inv hc with rfl | rfl
  · exact .bot _ _ _
  · exact .sort (.refl _) (whRedCtx_zetaSortCtx_bvar0 E)

/-- `LRTypeFamIN` satisfies the fundamental-lemma conclusion on `zetaSortCtx` in the reverse
    direction `(.bvar 0, .sort .zero)`. -/
theorem lrTypeFamIN_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) (c : CptI)
    (hc : ApproxI (ctxEnvI zetaSortCtx) (.bvar 0) c) :
    LRTypeFamIN E n zetaSortCtx (.bvar 0) (.sort .zero) c := by
  have hc' : ApproxI (ctxEnvI zetaSortCtx) (.sort .zero) c :=
    (semEqI_ctxEnvI_zetaSortCtx c).mp hc
  rcases approxI_sort_inv hc' with rfl | rfl
  · exact .bot _ _ _
  · exact .sort (whRedCtx_zetaSortCtx_bvar0 E) (.refl _)

/-- Context transport of `LRTypeFamIN` along any `CtxConvT E n Γ Γ'` that preserves local
    let-values (`CtxSameValues Γ Γ'`). -/
theorem lrTypeFamIN_ctx_sameValues {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hval : CtxSameValues Γ Γ') (hΓ' : CtxWfT E n Γ')
    {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamIN E n Γ A A' c) : LRTypeFamIN E n Γ' A A' c := by
  induction h generalizing Γ' with
  | bot => exact .bot _ _ _
  | sort h h' =>
      exact .sort (whRedCtx_of_sameValues hval h) (whRedCtx_of_sameValues hval h')
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u _ hA₁ =>
          have hA₁' : HasTyT E n Γ' A₁ (.sort u) := hasTyT_ctx hcl hctx hA₁
          have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ') := .assumption Γ' A₁ u hΓ' hA₁'
          exact .pi (whRedCtx_of_sameValues hval h) (whRedCtx_of_sameValues hval h')
            hΓ₁' (tyConvT_ctx hcl hctx hdom)
            (tyConvT_ctx hcl (.same (.assumption A₁) hctx) hcod)
            (iha hctx hval hΓ')
            (fun s hs => ihf s hs (.same (.assumption A₁) hctx)
              (ctxSameValues_same (.assumption A₁) hval) hΓ₁')
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind
        (whRedCtx_of_sameValues hval h) (whRedCtx_of_sameValues hval h')
        (hasTyT_ctx hcl hctx hty) (hasTyT_ctx hcl hctx hty')
        (tyConvT_ctx hcl hctx hc) heqN hlen hlen'
        (convArgsT_ctx hcl hctx hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot
        (whRedCtx_of_sameValues hval h) (whRedCtx_of_sameValues hval h')
        (whNormalCtx_of_sameValues hval hn) (whNormalCtx_of_sameValues hval hn')
        (tyConvT_ctx hcl hctx hc)

/-- Transport `LRTypeFamIN` along a `TyConvT` chain at the head assumption. -/
theorem lrTypeFamIN_assump_dom {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {B B' : Expr Nat} {c : CptI},
      LRTypeFamIN E n (.assumption A₂ :: Γ) B B' c →
      LRTypeFamIN E n (.assumption A₁ :: Γ) B B' c
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, hA₁, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTypeFamIN_ctx_sameValues hcl
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (ctxSameValues_assumption A₂ A₁ (ctxSameValues_refl Γ))
        (.assumption Γ A₁ _ hΓ hA₁) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      lrTypeFamIN_assump_dom hcl hW hΓ c₁ hA₁ (lrTypeFamIN_assump_dom hcl hW hΓ c₂ hM h)

/-- **Symmetry of `LRTypeFamIN`** under `EnvWfT E`, `PiRowField E n`, and `CtxWfT E n Γ`. -/
theorem lrTypeFamIN_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamIN E n Γ A A' c) : LRTypeFamIN E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamIN_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype hW hpi hΓ hm hind hty hty' heqN hlen hlen' hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot h' h hn' hn hc.symmT

/-- **Transitivity of `LRTypeFamIN`** under `EnvWfT E`, `WhDet E`, `PiRowField E n`, and `CtxWfT E n Γ`. -/
theorem lrTypeFamIN_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hdet : WhDet E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamIN E n Γ A B c) :
    ∀ {C : Expr Nat}, LRTypeFamIN E n Γ B C c → LRTypeFamIN E n Γ A C c := by
  have hcl := envClosed_of_envWfT hW
  induction h₁ with
  | bot => intro C _; exact .bot _ _ _
  | sort h _ =>
      intro C h₂
      cases h₂ with
      | sort _ hC => exact .sort h hC
  | @pi Γ A B A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      intro C h₂
      cases h₂ with
      | pi hB hC _ hdom' hcod' ra' rf' =>
          have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
            h' (whNormalCtx_pi _ _) hB (whNormalCtx_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi h hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom hdom')
                (.trans _ _ _ _ hcod (tyConvT_assump_dom hW hΓ₀ hdom hcod'))
                (iha hΓ₀ ra')
                (fun s hs => ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)
                  (lrTypeFamIN_assump_dom hcl hW hΓ₀ hdom hA₁ (rf' s hs)))
  | @famSpine Γ A B r m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ args hm₁ hind₁ h₁ h₁' hty₁ hty₂ hc₁ heqN₁ hlen₁ hlen₂ hargs₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ hB hC _ hty₃ hc₂ heqN₂ _ hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet)
            h₁' (whNormalCtx_famApp hW hm₁ hind₁ ls₂ xs₂)
            hB (whNormalCtx_famApp hW hm₁ hind₁ _ _)
          obtain ⟨hconst, hxs⟩ := foldApps_const_inj e
          injection hconst with _ hls
          subst hls; subst hxs
          exact .famSpine hm₁ hind₁ h₁ hC hty₁ hty₃
            (.trans _ _ _ _ hc₁ hc₂)
            (eqNList_trans heqN₁ heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype hW hpi hΓ hm₁ hty₁ hty₂ heqN₁ hargs₁ hargs₂)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | @otherSpine Γ A B X X' r args hnot₁ h₁ h₁' hn₁ hn₁' hc₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ _ _ _ _ _ _ _ _ _ =>
          exact (hnot₁ _ hm₂ hind₂).elim
      | otherSpine _ hB hC hY hY' hc₂ =>
          have e := whRedCtx_normal_unique (whDetCtx_of_whDet Γ hdet) h₁' hn₁' hB hY
          subst e
          exact .otherSpine hnot₁ h₁ hC hn₁ hY' (.trans _ _ _ _ hc₁ hc₂)

/-- Reading `LRTypeFamIN` at `.pi .bot []` for two syntactic Π-types yields component conversions. -/
theorem lrTypeFamIN_pi_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ A₂ B₂ : Expr Nat}
    (h : LRTypeFamIN E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot [])) :
    Nonempty (TyConvT E n Γ A₁ A₂) ∧ Nonempty (TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) := by
  cases h with
  | pi h h' _ hdom hcod _ _ =>
      have e₁ := whRedCtx_pi_eq h
      have e₂ := whRedCtx_pi_eq h'
      injection e₁ with eA₁ eB₁
      injection e₂ with eA₂ eB₂
      subst eA₁; subst eB₁; subst eA₂; subst eB₂
      exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

/-- Reading `LRTypeFamIN` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    `foldApps (.const r ls) xs` and `foldApps (.const r ls') xs'` yields `famAppRow`'s exact
    conclusion (`eqNList ls ls' ∧ xs.length = xs'.length ∧ ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs'`). -/
theorem lrTypeFamIN_famApp_components {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    eqNList ls ls' ∧ xs.length = xs'.length ∧
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' := by
  cases h with
  | famSpine hm' _ hred hred' _ _ _ heqN hlen hlen' hargs =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      have e₁ := whRedCtx_famApp_eq hW hm hind hred
      have e₂ := whRedCtx_famApp_eq hW hm hind hred'
      obtain ⟨hconst₁, hxs₁⟩ := foldApps_const_inj e₁.symm
      obtain ⟨hconst₂, hxs₂⟩ := foldApps_const_inj e₂.symm
      injection hconst₁ with _ hls₁
      injection hconst₂ with _ hls₂
      subst hls₁; subst hxs₁; subst hls₂; subst hxs₂
      exact ⟨heqN, hlen.trans hlen'.symm, hargs⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- Reading `LRTypeFamIN` at `.spine r args` for two syntactic admitted `.inductiveM` family spines
    also yields `RelevantSlotConv` (#7525). -/
theorem lrTypeFamIN_famApp_relevantSlotConv {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {args : List CptI}
    (h : LRTypeFamIN E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls') xs') (.spine r args)) :
    RelevantSlotConv E n Γ [] ((piDomsOf m.mtype).map (instantiateLevels ls)) xs xs' :=
  relevantSlotConv_of_convArgsT hW hm hind
    (lrTypeFamIN_famApp_components hW hm hind h).2.2

/-- **Untyped Fundamental Lemma for `LRTypeFamIN` (`FundamentalLRFamIN`):**
    Convertible types are related by `LRTypeFamIN` at every compact approximating the left type
    in `ctxEnvI Γ`. -/
def FundamentalLRFamIN (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat}, TyConvT E n Γ A A' →
    ∀ c, ApproxI (ctxEnvI Γ) A c → LRTypeFamIN E n Γ A A' c

/-- **Typed Fundamental Lemma for `LRTypeFamIN` (`FundamentalLRFamINT`):**
    When the left type `A` is sort-typed (`HasTyT E n Γ A (.sort u)`), any `TyConvT E n Γ A A'`
    relates `A` and `A'` in `LRTypeFamIN` at every compact approximating `A` in `ctxEnvI Γ`. -/
def FundamentalLRFamINT (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
    HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
    ∀ c, ApproxI (ctxEnvI Γ) A c → LRTypeFamIN E n Γ A A' c

/-- `FundamentalLRFamIN` implies `FundamentalLRFamINT`. -/
theorem fundamentalLRFamINT_of_fundamentalLRFamIN {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRFamIN E n) : FundamentalLRFamINT E n := by
  intro Γ hΓ A A' _ _ hc c hcA
  exact F hΓ hc c hcA

/-- Derive `PiRowField E n` (`TypedRowsWf.piRow`) from `FundamentalLRFamINT E n`
    (mirroring `RcicNativePiModelLRTerm.piRow_of_fundamentalLRINT`). -/
theorem piRowField_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINT E n) : PiRowField E n := by
  intro Γ hΓ A B A' B' hc
  rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
  · injection heq with hA hB
    subst hA; subst hB
    exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
  · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
    exact lrTypeFamIN_pi_components
      (F hΓ hPi hc (.pi .bot []) (approxI_pi_bot_nil (ctxEnvI Γ) A B))

/-- Derive `PiRowField E n` from `FundamentalLRFamIN E n`. -/
theorem piRowField_of_fundamentalLRFamIN {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRFamIN E n) : PiRowField E n :=
  fun {_} hΓ {A B _ _} hc =>
    lrTypeFamIN_pi_components
      (F hΓ hc (.pi .bot []) (approxI_pi_bot_nil (ctxEnvI _) A B))

/-- Derive `FamAppRowLink E n` (`TypedRowsWf.famAppRow`) directly from `FundamentalLRFamINT E n`
    by probing at `c = .spine r (botVecI xs)` (`approxI_famApp_botVecI`). -/
theorem famAppRow_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINT E n) : FamAppRowLink E n :=
  fun {_} hΓ {r _ ls _ xs _ _} hm hind hty hc =>
    lrTypeFamIN_famApp_components hW hm hind
      (F hΓ hty hc (.spine r (botVecI xs)) (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- Derive `FamAppRowLink E n` from `FundamentalLRFamIN E n`. -/
theorem famAppRow_of_fundamentalLRFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamIN E n) : FamAppRowLink E n :=
  famAppRow_of_fundamentalLRFamINT hW (fundamentalLRFamINT_of_fundamentalLRFamIN F)

/-- Derive `KernelRowsAssembly.FamRelevantSlotConv E n` (`W-F8-FAMAPP-ARG-COMPARISON`) from
    `FundamentalLRFamINT E n`. -/
theorem famRelevantSlotConv_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINT E n) : FamRelevantSlotConv E n :=
  fun {_} hΓ {r _ ls _ xs _ _} hm hind hty hc =>
    lrTypeFamIN_famApp_relevantSlotConv hW hm hind
      (F hΓ hty hc (.spine r (botVecI xs)) (approxI_famApp_botVecI (ctxEnvI _) r ls xs))

/-- Derive `KernelRowsAssembly.FamRelevantSlotConv E n` from `FundamentalLRFamIN E n`. -/
theorem famRelevantSlotConv_of_fundamentalLRFamIN {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamIN E n) : FamRelevantSlotConv E n :=
  famRelevantSlotConv_of_fundamentalLRFamINT hW (fundamentalLRFamINT_of_fundamentalLRFamIN F)

/-- Distinct admitted `.inductiveM` family heads `r₁ ≠ r₂` are never `TyConvT`-convertible under
    `FundamentalLRFamINT E n`. -/
theorem not_tyConvT_famApp_ne_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (hW : EnvWfT E) (F : FundamentalLRFamINT E n) (hΓ : CtxWfT E n Γ)
    {r₁ r₂ : Nat} {m₁ m₂ : CheckedMember}
    (hm₁ : E.members r₁ = some m₁) (hind₁ : m₁.mclass = .inductiveM)
    (hm₂ : E.members r₂ = some m₂) (hind₂ : m₂.mclass = .inductiveM)
    (hne : r₁ ≠ r₂)
    {ls₁ ls₂ : List Level} {xs₁ xs₂ : List (Expr Nat)} {w : Level}
    (hty₁ : HasTyT E n Γ (foldApps (.const r₁ ls₁) xs₁) (.sort w))
    (hc : TyConvT E n Γ (foldApps (.const r₁ ls₁) xs₁) (foldApps (.const r₂ ls₂) xs₂)) :
    False := by
  have hLR := F hΓ hty₁ hc (.spine r₁ (botVecI xs₁)) (approxI_famApp_botVecI (ctxEnvI Γ) r₁ ls₁ xs₁)
  cases hLR with
  | famSpine _ _ _ hred' _ _ _ _ _ _ _ =>
      have e₂ := whRedCtx_famApp_eq hW hm₂ hind₂ hred'
      obtain ⟨hconst, _⟩ := foldApps_const_inj e₂.symm
      injection hconst with hr _
      exact hne hr.symm
  | otherSpine hnot _ _ _ _ _ =>
      exact hnot m₁ hm₁ hind₁

/-- **Adequacy at an Admitted Inductive Family Spine (`AdequacyFamICtx`):**
    Any sort-typed expression `A` approximated in `ctxEnvI Γ` by `.spine r args` for an admitted
    `.inductiveM` family `r` weak-head reduces in `WhRedCtx E Γ` to a saturated `r`-headed spine
    `foldApps (.const r ls) xs` whose arguments are pointwise approximated by `args`
    (`ApproxIArgs (ctxEnvI Γ) xs args`). -/
def AdequacyFamICtx (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {r : Nat} {m : CheckedMember}, E.members r = some m → m.mclass = .inductiveM →
    ∀ {A : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    ∀ {args : List CptI}, ApproxI (ctxEnvI Γ) A (.spine r args) →
      ∃ (ls : List Level) (xs : List (Expr Nat)),
        WhRedCtx E Γ A (foldApps (.const r ls) xs) ∧
        xs.length = (piDomsOf m.mtype).length ∧
        ApproxIArgs (ctxEnvI Γ) xs args

/-- Shape half of family adequacy from `FundamentalLRFamINT E n`: any sort-typed `A` approximated
    by `.spine r args` for an admitted `.inductiveM` family `r` weak-head reduces in `WhRedCtx E Γ`
    to a saturated `r`-headed spine `foldApps (.const r ls) xs`. -/
theorem adequacyFamShapeICtx_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRFamINT E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {A : Expr Nat} {u : Level} (hA : HasTyT E n Γ A (.sort u))
    {args : List CptI} (hc : ApproxI (ctxEnvI Γ) A (.spine r args)) :
    ∃ (ls : List Level) (xs : List (Expr Nat)),
      WhRedCtx E Γ A (foldApps (.const r ls) xs) ∧
      xs.length = (piDomsOf m.mtype).length := by
  have hLR := F hΓ hA (.refl Γ A) (.spine r args) hc
  cases hLR with
  | famSpine hm' _ hred _ _ _ _ _ hlen _ _ =>
      rw [hm] at hm'
      injection hm' with hm_eq
      subst hm_eq
      exact ⟨_, _, hred, hlen⟩
  | otherSpine hnot _ _ _ _ _ =>
      exact (hnot m hm hind).elim

/-- **Full Family Adequacy (`AdequacyFamICtx`) from `FundamentalLRFamINT E n` and `WhApproxInvCore E`:**
    Combines `adequacyFamShapeICtx_of_fundamentalLRFamINT` with weak-head model invariance
    (`approxI_ctxEnvI_whRedCtx`) and our spine inversion theorem (`approxI_foldApps_const_inv`),
    mirroring `RcicNativePiModelLRTerm.adequacyPiI_of_fundamentalTermI`. -/
theorem adequacyFamICtx_of_fundamentalLRFamINT {E : ResolvedEnv} {n : Nat}
    (F : FundamentalLRFamINT E n) (hcore : WhApproxInvCore E) :
    AdequacyFamICtx E n := by
  intro Γ hΓ r m hm hind A u hA args hc
  obtain ⟨ls, xs, hred, hlen⟩ := adequacyFamShapeICtx_of_fundamentalLRFamINT F hΓ hm hind hA hc
  have hc' : ApproxI (ctxEnvI Γ) (foldApps (.const r ls) xs) (.spine r args) :=
    (approxI_ctxEnvI_whRedCtx hcore hred (.spine r args)).mp hc
  rcases approxI_foldApps_const_inv hc' with hbot | ⟨cs, heq, hargs⟩
  · exact nomatch hbot
  · injection heq with _ hcs
    subst hcs
    exact ⟨ls, xs, hred, hlen, hargs⟩


