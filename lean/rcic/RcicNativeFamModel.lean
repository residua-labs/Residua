/-- Non-sort proposition predicate over `WhRedRecKCanon E Γ`. -/
def IsNonSortPropRecKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (P : Expr Nat) : Prop :=
  (∀ l, ¬ WhRedRecKCanon E Γ P (.sort l)) ∧ Nonempty (HasTyT E n Γ P (.sort .zero))

theorem not_isNonSortPropRecKCanon_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx} (u : Level) :
    ¬ IsNonSortPropRecKCanon E n Γ (.sort u) :=
  fun ⟨hno, _⟩ => hno u (.refl _)

theorem isNonSortPropRecKCanon_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (h : HasTyT E n Γ (.pi A B) (.sort .zero)) :
    IsNonSortPropRecKCanon E n Γ (.pi A B) :=
  And.intro (fun _ hred => nomatch whRedRecKCanon_pi_eq hred) ⟨h⟩

theorem isNonSortPropRecKCanon_famApp {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) {Γ : LCtx}
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls : List Level} {xs : List (Expr Nat)}
    (h : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsNonSortPropRecKCanon E n Γ (foldApps (.const r ls) xs) :=
  And.intro (fun l hred => foldApps_const_ne_sort r ls xs l (whRedRecKCanon_famApp_eq hW hm hind hred).symm) ⟨h⟩

/-- Transport `IsNonSortPropRecKCanon` along `TyConvT E n Γ A A'` using
    `FundamentalLRFamINProbeRKCanon E n` (evaluated only at `c = .sort`, where `FamProbeCpt.sort`
    holds) and `ZeroSortCoherence E n` — with **zero** `WhApproxInvCore` hypothesis! -/
theorem isNonSortPropRecKCanon_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINProbeRKCanon E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsNonSortPropRecKCanon E n Γ A) :
    IsNonSortPropRecKCanon E n Γ A' := by
  obtain ⟨hno, ⟨hA0⟩⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨fun l hred' => ?_, ⟨hA'0⟩⟩
  have hcA' : ApproxDIKCanon E Γ A' .sort :=
    approxDIKCanon_of_whRedRecKCanon hred' (approxDIKCanon_sort E Γ l)
  have hLR : LRTypeFamINRKCanon E n Γ A' A .sort := hF hΓ hA'0 hAA'.symmT .sort .sort hcA'
  cases hLR with
  | sort _ hredA => exact hno _ hredA

/-- Transport `∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)` across `TyConvT E n Γ A A'` using
    `FundamentalLRFamINProbeRKCanon E n` (evaluated only at `c = .sort`) — with **zero**
    `WhApproxInvCore` hypothesis! -/
theorem not_whRedRecKCanon_sort_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hF : FundamentalLRFamINProbeRKCanon E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) (hc : TyConvT E n Γ A A')
    (hns : ∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)) :
    ∀ l, ¬ WhRedRecKCanon E Γ A' (.sort l) := by
  intro l hl'
  obtain ⟨_, hA'⟩ := tyConvT_endTyped hW hΓ hc hA
  have hsortA' : ApproxDIKCanon E Γ A' .sort :=
    approxDIKCanon_of_whRedRecKCanon hl' (approxDIKCanon_sort E Γ l)
  have hLR := hF hΓ hA' hc.symmT .sort .sort hsortA'
  cases hLR with
  | sort _ hredA => exact hns _ hredA

/-- **Canonical Deterministic K + Recursor-Major Term Logical Relation (`LRTermFamINDRKCanon`):**
    Combines `WhRedRecKCanon` / `WhNormalRecKCanon` / `LRTypeFamINRKCanon` with `IsNonSortPropRecKCanon`,
    restoring the `WhNormalRecKCanon E Γ Y ∧ WhNormalRecKCanon E Γ Y'` normal-form witnesses in the
    non-sort `.spine r args` clause so that transitivity (`lrTermFamINDRKCanon_trans`) closes
    unconditionally by `whRedRecKCanon_normal_unique_of_envWfT hW`! -/
def LRTermFamINDRKCanon (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort =>
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' .sort)
  | .pi a f =>
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' (.pi a f))
  | .spine r args =>
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecKCanon E Γ M Y ∧ WhRedRecKCanon E Γ M' Y' ∧
          WhNormalRecKCanon E Γ Y ∧ WhNormalRecKCanon E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A))
  | .lam g =>
      IsNonSortPropRecKCanon E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecKCanon E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDRKCanon E n Γ N N' A₁ u) →
          LRTermFamINDRKCanon E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show u ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

theorem lrTermFamINDRKCanon_bot {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDRKCanon E n Γ M M' A .bot := by
  rw [LRTermFamINDRKCanon]; trivial

theorem lrTermFamINDRKCanon_sort_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat) :
    LRTermFamINDRKCanon E n Γ M M' A .sort ↔
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' .sort) := by
  rw [LRTermFamINDRKCanon]

theorem lrTermFamINDRKCanon_pi_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (a : CptI) (f : List (List CptI × CptI)) :
    LRTermFamINDRKCanon E n Γ M M' A (.pi a f) ↔
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' (.pi a f)) := by
  rw [LRTermFamINDRKCanon]

theorem lrTermFamINDRKCanon_spine_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (r : Nat) (args : List CptI) :
    LRTermFamINDRKCanon E n Γ M M' A (.spine r args) ↔
      ((∃ l, WhRedRecKCanon E Γ A (.sort l)) ∧ LRTypeFamINRKCanon E n Γ M M' (.spine r args)) ∨
      IsNonSortPropRecKCanon E n Γ A ∨
      ((∀ l, ¬ WhRedRecKCanon E Γ A (.sort l)) ∧
        ∃ Y Y', WhRedRecKCanon E Γ M Y ∧ WhRedRecKCanon E Γ M' Y' ∧
          WhNormalRecKCanon E Γ Y ∧ WhNormalRecKCanon E Γ Y' ∧ Nonempty (ConvT E n Γ Y Y' A)) := by
  rw [LRTermFamINDRKCanon]

theorem lrTermFamINDRKCanon_lam_iff {E : ResolvedEnv} {n : Nat} (Γ : LCtx) (M M' A : Expr Nat)
    (g : List (List CptI × CptI)) :
    LRTermFamINDRKCanon E n Γ M M' A (.lam g) ↔
      IsNonSortPropRecKCanon E n Γ A ∨
      (∃ A₁ B₁ w, WhRedRecKCanon E Γ A (.pi A₁ B₁) ∧
        Nonempty (CtxWfT E n (.assumption A₁ :: Γ)) ∧
        Nonempty (HasTyT E n (.assumption A₁ :: Γ) B₁ (.sort w)) ∧
        ∀ s ∈ g, ∀ N N' : Expr Nat,
          HasTyT E n Γ N A₁ → HasTyT E n Γ N' A₁ → ConvT E n Γ N N' A₁ →
          (∀ u ∈ s.1, LRTermFamINDRKCanon E n Γ N N' A₁ u) →
          LRTermFamINDRKCanon E n Γ (.app M N) (.app M' N') (instantiate0 N B₁) s.2) := by
  rw [LRTermFamINDRKCanon]

/-- At any `IsNonSortPropRecKCanon E n Γ P`, `LRTermFamINDRKCanon E n Γ M M' P u` holds for all
    compacts `u : CptI` (proof-irrelevant prop escape). -/
theorem lrTermFamINDRKCanon_of_nonSortPropRecKCanon {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' P : Expr Nat} (hP : IsNonSortPropRecKCanon E n Γ P) :
    ∀ (u : CptI), LRTermFamINDRKCanon E n Γ M M' P u
  | .bot => lrTermFamINDRKCanon_bot Γ M M' P
  | .sort => (lrTermFamINDRKCanon_sort_iff Γ M M' P).mpr (Or.inl hP)
  | .pi a f => (lrTermFamINDRKCanon_pi_iff Γ M M' P a f).mpr (Or.inl hP)
  | .spine r args => (lrTermFamINDRKCanon_spine_iff Γ M M' P r args).mpr (Or.inr (Or.inl hP))
  | .lam g => (lrTermFamINDRKCanon_lam_iff Γ M M' P g).mpr (Or.inl hP)

/-- Closure of `LRTermFamINDRKCanon` under `WhRedRecKCanon E Γ` head expansion on both terms `M, M'`. -/
theorem lrTermFamINDRKCanon_expand {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {M M' X X' A : Expr Nat}
    (hX : WhRedRecKCanon E Γ M X) (hX' : WhRedRecKCanon E Γ M' X') :
    (u : CptI) → LRTermFamINDRKCanon E n Γ X X' A u → LRTermFamINDRKCanon E n Γ M M' A u
  | .bot, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamINRKCanon_expand hX hX' h2⟩
  | .pi a f, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h ⊢
      rcases h with hprop | ⟨h1, h2⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨h1, lrTypeFamINRKCanon_expand hX hX' h2⟩
  | .spine r args, h => by
      rw [lrTermFamINDRKCanon_spine_iff] at h ⊢
      rcases h with ⟨h1, h2⟩ | hprop | ⟨h1, Y, Y', hY, hY', hn, hn', hc⟩
      · exact Or.inl ⟨h1, lrTypeFamINRKCanon_expand hX hX' h2⟩
      · exact Or.inr (Or.inl hprop)
      · exact Or.inr (Or.inr ⟨h1, Y, Y',
          whRedRecKCanon_trans hX hY, whRedRecKCanon_trans hX' hY', hn, hn', hc⟩)
  | .lam g, h => by
      rw [lrTermFamINDRKCanon_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hA, hΓ₁, hB₁, happ⟩
      · exact Or.inl hprop
      · refine Or.inr ⟨A₁, B₁, w, hA, hΓ₁, hB₁, fun s hs N N' hN hN' hc hrel => ?_⟩
        exact lrTermFamINDRKCanon_expand
          (whRedRecKCanon_appHead hX) (whRedRecKCanon_appHead hX') s.2
          (happ s hs N N' hN hN' hc hrel)
termination_by u => sizeOf u
decreasing_by
  all_goals simp_wf
  have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
  have h₃ := sizeOf_snd_lt s
  omega

theorem lrTermFamINDRKCanon_lam_at_sort_false {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {g : List (List CptI × CptI)}
    (h : LRTermFamINDRKCanon E n Γ M M' (.sort u) (.lam g)) : False := by
  rw [lrTermFamINDRKCanon_lam_iff] at h
  rcases h with hprop | ⟨_, _, _, hA, _, _, _⟩
  · exact not_isNonSortPropRecKCanon_sort u hprop
  · exact nomatch whRedRecKCanon_sort_eq hA

theorem lrTermFamINDRKCanon_spine_at_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} {r : Nat} {args : List CptI}
    (h : LRTermFamINDRKCanon E n Γ M M' (.sort u) (.spine r args)) :
    LRTypeFamINRKCanon E n Γ M M' (.spine r args) := by
  rw [lrTermFamINDRKCanon_spine_iff] at h
  rcases h with ⟨_, h2⟩ | hprop | ⟨hns, _⟩
  · exact h2
  · exact (not_isNonSortPropRecKCanon_sort u hprop).elim
  · exact (hns u (.refl _)).elim

theorem lrTypeFamINRKCanon_of_lrTermFamINDRKCanon_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} {u : Level} :
    (c : CptI) → LRTermFamINDRKCanon E n Γ M M' (.sort u) c → LRTypeFamINRKCanon E n Γ M M' c
  | .bot, _ => .bot _ _ _
  | .sort, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecKCanon_sort u hprop).elim
      · exact h2
  | .pi _ _, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h
      rcases h with hprop | ⟨_, h2⟩
      · exact (not_isNonSortPropRecKCanon_sort u hprop).elim
      · exact h2
  | .spine _ _, h => lrTermFamINDRKCanon_spine_at_sort h
  | .lam _, h => (lrTermFamINDRKCanon_lam_at_sort_false h).elim

theorem lrTermFamINDRKCanon_of_lrTypeFamINRKCanon_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) :
    (c : CptI) → LRTypeFamINRKCanon E n Γ M M' c → LRTermFamINDRKCanon E n Γ M M' (.sort u) c
  | .bot, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, h => (lrTermFamINDRKCanon_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .pi _ _, h => (lrTermFamINDRKCanon_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨u, .refl _⟩, h⟩)
  | .spine _ _, h => (lrTermFamINDRKCanon_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨u, .refl _⟩, h⟩)
  | .lam _, h => nomatch h

theorem lrTermFamINDRKCanon_sort_iff_lrTypeFamINRKCanon {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (u : Level) (c : CptI) :
    LRTermFamINDRKCanon E n Γ M M' (.sort u) c ↔ LRTypeFamINRKCanon E n Γ M M' c :=
  ⟨lrTypeFamINRKCanon_of_lrTermFamINDRKCanon_sort c,
   lrTermFamINDRKCanon_of_lrTypeFamINRKCanon_sort u c⟩

/-- **Unconditional Index Transport for `LRTermFamINDRKCanon` Across All Compacts `c : CptI`
    (`lrTermFamINDRKCanon_transport`):**
    Under `EnvWfT E`, `ZeroSortCoherence E n`, and `FundamentalLRFamINProbeRKCanon E n` **alone**
    (requiring **zero** `WhApproxInvCore`, `WhDet`, `WhPiCoh`, `WhFamCoh`, or `PiRowField`
    hypotheses!), `LRTermFamINDRKCanon E n Γ M M' A c` transports along any `TyConvT E n Γ A A'`
    across every compact `c : CptI` (evaluating `hF` only at `.sort` and `.pi .bot []`, both in
    `FamProbeCpt E`)! -/
theorem lrTermFamINDRKCanon_transport {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINProbeRKCanon E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A A' : Expr Nat} {u : Level}, HasTyT E n Γ A (.sort u) →
    TyConvT E n Γ A A' →
    ∀ {M M' : Expr Nat}, LRTermFamINDRKCanon E n Γ M M' A c → LRTermFamINDRKCanon E n Γ M M' A' c
  | .bot, _, _, _, _, _, _, _, _, _, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropRecKCanon_transport hW zsc hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort
          (approxDIKCanon_of_whRedRecKCanon hl (approxDIKCanon_sort E Γ l))
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .pi a f, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h ⊢
      rcases h with hprop | ⟨⟨l, hl⟩, hLR⟩
      · exact Or.inl (isNonSortPropRecKCanon_transport hW zsc hF hΓ hAA' hprop)
      · have hs := hF hΓ hA hAA' .sort .sort
          (approxDIKCanon_of_whRedRecKCanon hl (approxDIKCanon_sort E Γ l))
        cases hs with
        | sort _ hl' => exact Or.inr ⟨⟨_, hl'⟩, hLR⟩
  | .spine r args, Γ, hΓ, A, A', _, hA, hAA', _, _, h => by
      rw [lrTermFamINDRKCanon_spine_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hLR⟩ | hprop | ⟨hns, Y, Y', hY, hY', hn, hn', ⟨hc⟩⟩
      · have hs := hF hΓ hA hAA' .sort .sort
          (approxDIKCanon_of_whRedRecKCanon hl (approxDIKCanon_sort E Γ l))
        cases hs with
        | sort _ hl' => exact Or.inl ⟨⟨_, hl'⟩, hLR⟩
      · exact Or.inr (Or.inl (isNonSortPropRecKCanon_transport hW zsc hF hΓ hAA' hprop))
      · exact Or.inr (Or.inr ⟨not_whRedRecKCanon_sort_transport hW hF hΓ hA hAA' hns,
          Y, Y', hY, hY', hn, hn', ⟨convT_of_tyConv hc hAA'⟩⟩)
  | .lam g, Γ, hΓ, A, A', _, hA, hAA', M, M', h => by
      rw [lrTermFamINDRKCanon_lam_iff] at h ⊢
      rcases h with hprop | ⟨A₁, B₁, w, hred, ⟨hΓ₁⟩, ⟨hB₁⟩, happ⟩
      · exact Or.inl (isNonSortPropRecKCanon_transport hW zsc hF hΓ hAA' hprop)
      · have hpi := hF hΓ hA hAA' (.pi .bot []) .pi_bot_nil
          (approxDIKCanon_of_whRedRecKCanon hred (approxDIKCanon_pi_bot_nil E Γ A₁ B₁))
        cases hpi with
        | @pi _ _ _ A₁' B₁' A₂ B₂ _ _ hred₁ hred₂ _ hdom hcod _ _ =>
            have e := whRedRecKCanon_normal_unique_of_envWfT hW
              hred (whNormalRecKCanon_pi A₁ B₁) hred₁ (whNormalRecKCanon_pi A₁' B₁')
            injection e with eA eB
            subst eA; subst eB
            cases hΓ₁ with
            | assumption _ _ u₁ _ hA₁ =>
                obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hdom hA₁
                have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ u₂ hΓ hA₂
                have hΓ₁' : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
                obtain ⟨w₂, hB₂_A₁⟩ := tyConvT_endTyped hW hΓ₁' hcod hB₁
                have hB₂ : HasTyT E n (.assumption A₂ :: Γ) B₂ (.sort w₂) :=
                  hasTyT_assump_dom (envClosed_of_envWfT hW) hW hΓ hdom.symmT hA₂ hB₂_A₁
                refine Or.inr ⟨A₂, B₂, w₂, hred₂, ⟨hΓ₂⟩, ⟨hB₂⟩,
                  fun s hs N N' hN₂ hN'₂ hc₂ hrel₂ => ?_⟩
                have hN₁ : HasTyT E n Γ N A₁ := hasTyT_of_tyConv hN₂ hdom.symmT
                have hN'₁ : HasTyT E n Γ N' A₁ := hasTyT_of_tyConv hN'₂ hdom.symmT
                have hc₁ : ConvT E n Γ N N' A₁ := convT_of_tyConv hc₂ hdom.symmT
                have hrel₁ : ∀ v ∈ s.1, LRTermFamINDRKCanon E n Γ N N' A₁ v :=
                  fun v hv => lrTermFamINDRKCanon_transport hW zsc hF v
                    hΓ hA₂ hdom.symmT (hrel₂ v hv)
                have hout₁ := happ s hs N N' hN₁ hN'₁ hc₁ hrel₁
                have hinstTy : HasTyT E n Γ (instantiate0 N B₁) (.sort w) :=
                  hasTyT_subst0_of_envWfT hW hB₁ hN₁
                have hinstConv : TyConvT E n Γ (instantiate0 N B₁) (instantiate0 N B₂) :=
                  tyConvT_subst0_of_envWfT hW hN₁ hcod
                exact lrTermFamINDRKCanon_transport hW zsc hF s.2
                  hΓ hinstTy hinstConv hout₁
termination_by c => sizeOf c
decreasing_by
  all_goals simp_wf
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₂ := List.sizeOf_lt_of_mem (show v ∈ s.1 from ‹_›)
    have h₃ := sizeOf_fst_lt s
    omega
  · have h₁ := List.sizeOf_lt_of_mem (show s ∈ g from ‹_›)
    have h₃ := sizeOf_snd_lt s
    omega

/-- **Unconditional Symmetry of `LRTermFamINDRKCanon` Across All Compacts `c : CptI`
    (`lrTermFamINDRKCanon_symm`):**
    Uses `lrTypeFamINRKCanon_symm_of_envWfT` (no `PiRowField`!) in `.sort`, `.pi`, and `.spine`,
    and `lrTermFamINDRKCanon_transport` in `.lam`! -/
theorem lrTermFamINDRKCanon_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINProbeRKCanon E n) :
    (c : CptI) →
    ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat}, LRTermFamINDRKCanon E n Γ M M' A c → LRTermFamINDRKCanon E n Γ M' M A c
  | .bot, _, _, _, _, _, _ => lrTermFamINDRKCanon_bot _ _ _ _
  | .sort, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamINDRKCanon_sort_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamINRKCanon_symm_of_envWfT hW hΓ hLR⟩
  | .pi a f, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamINDRKCanon_pi_iff] at h ⊢
      rcases h with hprop | ⟨hl, hLR⟩
      · exact Or.inl hprop
      · exact Or.inr ⟨hl, lrTypeFamINRKCanon_symm_of_envWfT hW hΓ hLR⟩
  | .spine r args, Γ, hΓ, _, _, _, h => by
      rw [lrTermFamINDRKCanon_spine_iff] at h ⊢
