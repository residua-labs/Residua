/-- `LRTypeFamINBiDI` holds on the `zetaSortCtx` counterexample in the forward direction
    (`.bvar 0` to `.sort .zero`) for every `E, n`. -/
theorem lrTypeFamINBiDI_zetaSortCtx (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaSortCtx (.bvar 0) (.sort .zero) := by
  intro c _ h
  have hred : WhRedCtx E zetaSortCtx (.bvar 0) (.sort .zero) := whRedCtx_zetaSortCtx_bvar0 E
  rcases h with h0 | hs
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h0 with rfl | hmem
    · exact .bot _ _ _
    · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hmem with rfl | rfl
      · exact .bot _ _ _
      · exact .sort hred (.refl _)
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hs with rfl | rfl
    · exact .bot _ _ _
    · exact .sort hred (.refl _)

/-- `LRTypeFamINBiDI` holds on the `zetaSortCtx` counterexample in the reverse direction
    (`.sort .zero` to `.bvar 0`) for every `E, n`. -/
theorem lrTypeFamINBiDI_zetaSortCtx_symm (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n zetaSortCtx (.sort .zero) (.bvar 0) := by
  intro c _ h
  have hred : WhRedCtx E zetaSortCtx (.bvar 0) (.sort .zero) := whRedCtx_zetaSortCtx_bvar0 E
  rcases h with hs | h0
  · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hs with rfl | rfl
    · exact .bot _ _ _
    · exact .sort (.refl _) hred
  · rcases PiModelDeltaIotaAudit.approxDI_bvar_inv h0 with rfl | hmem
    · exact .bot _ _ _
    · rcases PiModelDeltaIotaAudit.approxDI_sort_inv hmem with rfl | rfl
      · exact .bot _ _ _
      · exact .sort (.refl _) hred

/-- `LRTypeFamINBiDI` holds on `idPiProp = .pi (.sort .zero) (.bvar 0)` unconditionally for every `E, n`. -/
theorem lrTypeFamINBiDI_idPiProp (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n [] PiModelDeltaIotaAudit.idPiProp PiModelDeltaIotaAudit.idPiProp :=
  lrTypeFamINBiDI_pi_diag
    (.assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero))
    (lrTypeFamINBiDI_sort_diag E n [] .zero)
    (lrTypeFamINBiDI_bvar_diag_of_lookupValue_none rfl)

/-- `LRTypeFamINBiDI` holds on the closed `ConvT.irr`-under-`ConvT.pi` pair `closedIrrPiL` / `closedIrrPiR`
    unconditionally for every `E, n`. -/
theorem lrTypeFamINBiDI_closedIrrPi (E : ResolvedEnv) (n : Nat) :
    LRTypeFamINBiDI E n [] PiModelDeltaIotaAudit.closedIrrPiL PiModelDeltaIotaAudit.closedIrrPiR := by
  let Γ₁ : LCtx := [.assumption (.sort .zero)]
  let Γ₂ : LCtx := .assumption (.pi (.bvar 0) (.sort .zero)) :: Γ₁
  let Γ₃ : LCtx := .assumption (.bvar 1) :: Γ₂
  let Γ₄ : LCtx := .assumption (.bvar 2) :: Γ₃
  have hΓ₁ : CtxWfT E n Γ₁ := .assumption [] (.sort .zero) (.succ .zero) .nil (.sort [] .zero)
  have hA₁ : HasTyT E n Γ₁ (.pi (.bvar 0) (.sort .zero)) (.sort (.imax .zero (.succ .zero))) :=
    .pi Γ₁ (.bvar 0) .zero (.sort .zero) (.succ .zero)
      (.bvar Γ₁ 0 (.sort .zero) rfl) (.sort _ .zero)
  have hΓ₂ : CtxWfT E n Γ₂ := .assumption Γ₁ _ _ hΓ₁ hA₁
  have hΓ₃ : CtxWfT E n Γ₃ := .assumption Γ₂ (.bvar 1) .zero hΓ₂ (.bvar Γ₂ 1 (.sort .zero) rfl)
  have hΓ₄ : CtxWfT E n Γ₄ := .assumption Γ₃ (.bvar 2) .zero hΓ₃ (.bvar Γ₃ 2 (.sort .zero) rfl)
  have hP : HasTyT E n Γ₄ (.bvar 3) (.sort .zero) := .bvar Γ₄ 3 (.sort .zero) rfl
  have hF : HasTyT E n Γ₄ (.bvar 2) (.pi (.bvar 3) (.sort .zero)) :=
    .bvar Γ₄ 2 (.pi (.bvar 3) (.sort .zero)) rfl
  have hp : HasTyT E n Γ₄ (.bvar 1) (.bvar 3) := .bvar Γ₄ 1 (.bvar 3) rfl
  have hq : HasTyT E n Γ₄ (.bvar 0) (.bvar 3) := .bvar Γ₄ 0 (.bvar 3) rfl
  have hbodyConv : ConvT E n Γ₄ (.app (.bvar 2) (.bvar 1)) (.app (.bvar 2) (.bvar 0)) (.sort .zero) :=
    .app Γ₄ (.bvar 2) (.bvar 2) (.bvar 1) (.bvar 0) (.bvar 3) (.sort .zero)
      (.refl Γ₄ (.bvar 2) _ hF) (.irr Γ₄ (.bvar 3) (.bvar 1) (.bvar 0) hP hp hq)
  have hcod₃ : ConvT E n Γ₃ (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))
      (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))) (.sort (.imax .zero .zero)) :=
    .pi Γ₃ _ _ _ _ .zero .zero (.refl Γ₃ _ _ (.bvar Γ₃ 2 (.sort .zero) rfl)) hbodyConv
  have hcod₂ : ConvT E n Γ₂ (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1))))
      (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0))))
      (.sort (.imax .zero (.imax .zero .zero))) :=
    .pi Γ₂ _ _ _ _ .zero _ (.refl Γ₂ _ _ (.bvar Γ₂ 1 (.sort .zero) rfl)) hcod₃
  have hcod₁ : ConvT E n Γ₁
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 1)))))
      (.pi (.pi (.bvar 0) (.sort .zero)) (.pi (.bvar 1) (.pi (.bvar 2) (.app (.bvar 2) (.bvar 0)))))
      (.sort (.imax (.imax .zero (.succ .zero)) (.imax .zero (.imax .zero .zero)))) :=
    .pi Γ₁ _ _ _ _ _ _ (.refl Γ₁ _ _ hA₁) hcod₂
  have hinner : LRTypeFamINBiDI E n Γ₄ (.app (.bvar 2) (.bvar 1)) (.app (.bvar 2) (.bvar 0)) :=
    lrTypeFamINBiDI_foldApps_bvar (Γ := Γ₄) (i := 2) (j := 2) rfl rfl [.bvar 1] [.bvar 0]
  exact lrTypeFamINBiDI_pi hΓ₁ (.refl [] _) (.of Γ₁ _ _ _ hcod₁)
    (lrTypeFamINBiDI_sort_diag E n [] .zero)
    (lrTypeFamINBiDI_pi hΓ₂ (.refl Γ₁ _) (.of Γ₂ _ _ _ hcod₂)
      (lrTypeFamINBiDI_pi_diag
        (.assumption Γ₁ (.bvar 0) .zero hΓ₁ (.bvar Γ₁ 0 (.sort .zero) rfl))
        (lrTypeFamINBiDI_bvar_diag_of_lookupValue_none rfl)
        (lrTypeFamINBiDI_sort_diag E n (.assumption (.bvar 0) :: Γ₁) .zero))
      (lrTypeFamINBiDI_pi hΓ₃ (.refl Γ₂ _) (.of Γ₃ _ _ _ hcod₃)
        (lrTypeFamINBiDI_bvar_diag_of_lookupValue_none rfl)
        (lrTypeFamINBiDI_pi hΓ₄ (.refl Γ₃ _) (.of Γ₄ _ _ _ hbodyConv)
          (lrTypeFamINBiDI_bvar_diag_of_lookupValue_none rfl) hinner)))

/-- Symmetry of `LRTypeFamINBiDI` under `EnvWfT E` and `PiRowField E n` (with zero `TypeSoundness`
    or `WhDet` hypotheses). -/
theorem lrTypeFamINBiDI_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat}
    (h : LRTypeFamINBiDI E n Γ A B) :
    LRTypeFamINBiDI E n Γ B A :=
  fun c hc hBA => lrTypeFamIN_symm hW hpi hΓ (h c hc hBA.symm)

/-- Transitivity of `LRTypeFamINBiDI` under `EnvWfT E` and `PiRowField E n` (with zero `TypeSoundness`
    or `WhDet` hypotheses, using `approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt` and
    `lrTypeFamIN_trans_of_envWfT`). -/
theorem lrTypeFamINBiDI_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hpi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat}
    (h₁ : LRTypeFamINBiDI E n Γ A B) (h₂ : LRTypeFamINBiDI E n Γ B C) :
    LRTypeFamINBiDI E n Γ A C := by
  intro c hc hAC
  rcases hAC with hA | hC
  · have r₁ := h₁ c hc (Or.inl hA)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt hW hc r₁).2
    exact lrTypeFamIN_trans_of_envWfT hW hpi hΓ r₁ (h₂ c hc (Or.inl hB))
  · have r₂ := h₂ c hc (Or.inr hC)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt hW hc r₂).1
    exact lrTypeFamIN_trans_of_envWfT hW hpi hΓ (h₁ c hc (Or.inr hB)) r₂

/-- **Reduction of `FundamentalLRFamINBotDI E n` to Its Diagonal and Single-Link Cases Under `EnvWfT E`
    Alone (`fundamentalLRFamINBotDI_of_links`):**
    Requires **zero** `WhDet`, `WhApproxInvCore`, `PiRowField`, or `TypeSoundness` hypotheses
    (`PiRowField` is derived internally at `.pi .bot []` via `lrTypeFamIN_trans_pi_bot_nil_of_envWfT`). -/
theorem fundamentalLRFamINBotDI_of_links {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hdiag : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
        LRTypeFamIN E n Γ A A c)
    (hlink : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A B : Expr Nat} {u : Level},
      ConvT E n Γ A B (.sort u) →
      ∀ c, BotFamCpt E c → PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c →
        LRTypeFamIN E n Γ A B c) :
    FundamentalLRFamINBotDI E n := by
  have hpiChain : ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {A A' : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) → TyConvT E n Γ A A' →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.pi .bot []) →
      LRTypeFamIN E n Γ A A' (.pi .bot []) := by
    intro Γ hΓ A A' u hA hc
    revert u
    induction hc with
    | refl A =>
        intro u hA hcA
        exact hdiag hΓ hA (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA
    | of A B v hc =>
        intro _ _ hcA
        exact hlink hΓ hc (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA
    | trans A M B c₁ c₂ ih₁ ih₂ =>
        intro u hA hcA
        obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
        have r₁ := ih₁ hA hcA
        have hcM := approxDI_ctxEnvDI_right_of_lrTypeFamIN_botFamCpt hW (botFamCpt_pi_bot_nil E) r₁
        exact lrTypeFamIN_trans_pi_bot_nil_of_envWfT hW r₁ (ih₂ hM hcM)
  have hpi : PiRowField E n := by
    intro Γ hΓ A B A' B' hc
    rcases tyConvT_firstOf_data hc with heq | ⟨_, u, hc₀, _⟩
    · injection heq with hA hB
      subst hA; subst hB
      exact ⟨⟨.refl Γ A⟩, ⟨.refl (.assumption A :: Γ) B⟩⟩
    · have hPi : HasTyT E n Γ (.pi A B) (.sort u) := (convEnds hW hΓ hc₀).1
      exact lrTypeFamIN_pi_components
        (hpiChain hΓ hPi hc (PiModelDeltaIotaAudit.approxDI_pi_bot_nil E (ctxEnvDI E Γ) A B))
  intro Γ hΓ A A' u hA hc
  revert u
  induction hc with
  | refl A => intro u hA c hcpt hcA; exact hdiag hΓ hA c hcpt hcA
  | of A B v hc => intro _ _ c hcpt hcA; exact hlink hΓ hc c hcpt hcA
  | trans A M B c₁ c₂ ih₁ ih₂ =>
      intro u hA c hcpt hcA
      obtain ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA
      have r₁ := ih₁ hA c hcpt hcA
      have hcM := approxDI_ctxEnvDI_right_of_lrTypeFamIN_botFamCpt hW hcpt r₁
      exact lrTypeFamIN_trans_of_envWfT hW hpi hΓ r₁ (ih₂ hM c hcpt hcM)


/-! #### Part B — Weakening and Substitution Commutation for `WhStepCtx` / `WhRedCtx`, `ConvArgsT` / `RelevantSlotConv`, `LRTypeFamIN` on `BotFamCpt E`, and `LRTypeFamINBiDI` -/

/-- `WhStepCtx E Γ` commutes with `insertAt d c Γ` / `lift c 1` under `EnvClosed E` (with zero
    ι side hypotheses). -/
theorem whStepCtx_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhStepCtx E Γ a b) :
    ∀ (d : LocalDecl) (c : Nat), WhStepCtx E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  induction h with
  | beta A body arg =>
      intro d c
      rw [show lift c 1 (.app (.lam A body) arg) =
          .app (.lam (lift c 1 A) (lift (c + 1) 1 body)) (lift c 1 arg) from rfl,
        instantiate0, lift_instantiate_low 1 c 0 arg (Nat.zero_le c) body]
      exact .beta _ _ _
  | zeta A value body =>
      intro d c
      rw [show lift c 1 (.letE A value body) =
          .letE (lift c 1 A) (lift c 1 value) (lift (c + 1) 1 body) from rfl,
        instantiate0, lift_instantiate_low 1 c 0 value (Nat.zero_le c) body]
      exact .zeta _ _ _
  | @zetaLocal i v hval =>
      intro d c
      by_cases hic : i < c
      · simp only [lift, if_neg (by omega : ¬ c ≤ i)]
        exact .zetaLocal (lookupValue_insertAt_lt d hic hval)
      · simp only [lift, if_pos (by omega : c ≤ i)]
        exact .zetaLocal (lookupValue_insertAt_ge d (by omega : c ≤ i) hval)
  | @delta rmem ls m b hres hbody =>
      intro d c
      have hbod : ∀ k, lift k 1 b = b := (hcl rmem m hres).2 b hbody
      have hfix : lift c 1 (instantiateLevels ls b) = instantiateLevels ls b := by
        rw [lift_instantiateLevels, hbod c]
      rw [show lift c 1 (.const rmem ls) = .const rmem ls from rfl, hfix]
      exact .delta hres hbody
  | iota hI =>
      intro d c
      exact .iota (derivedIotaU_lift c hI)
  | lit t =>
      intro d c
      rw [show lift c 1 (.lit t) = .lit t from rfl, natExpand_lift c 1 t]
      exact .lit t
  | appHead _ ih =>
      intro d c
      exact .appHead (ih d c)

/-- `WhRedCtx E Γ` commutes with `insertAt d c Γ` / `lift c 1` under `EnvClosed E`. -/
theorem whRedCtx_lift_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {a b : Expr Nat} (h : WhRedCtx E Γ a b) (d : LocalDecl) (c : Nat) :
    WhRedCtx E (insertAt d c Γ) (lift c 1 a) (lift c 1 b) := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (whStepCtx_lift_of_envClosed hcl hs d c) ih

/-- `WhStepCtx E Γ` commutes with `substRemove v j Γ` / `instantiate j (lift 0 j v)` at any
    `.assumption t` hole (`Γ[j]? = some (.assumption t)`) under `EnvClosed E` (with zero ι side
    hypotheses). -/
theorem whStepCtx_instantiate_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {j : Nat} {t : Expr Nat} (hget : Γ[j]? = some (.assumption t))
    {a b : Expr Nat} (h : WhStepCtx E Γ a b) (v : Expr Nat) :
    WhStepCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) a) (instantiate j (lift 0 j v) b) := by
  induction h with
  | beta A body arg =>
      rw [show instantiate j (lift 0 j v) (.app (.lam A body) arg) =
          .app (.lam (instantiate j (lift 0 j v) A) (instantiate (j + 1) (lift 0 1 (lift 0 j v)) body))
            (instantiate j (lift 0 j v) arg) from rfl,
        instantiate0, instantiate_instantiate 0 j arg (lift 0 j v) (Nat.zero_le j) body]
      exact .beta _ _ _
  | zeta A value body =>
      rw [show instantiate j (lift 0 j v) (.letE A value body) =
          .letE (instantiate j (lift 0 j v) A) (instantiate j (lift 0 j v) value)
            (instantiate (j + 1) (lift 0 1 (lift 0 j v)) body) from rfl,
        instantiate0, instantiate_instantiate 0 j value (lift 0 j v) (Nat.zero_le j) body]
      exact .zeta _ _ _
  | @zetaLocal i v0 hval =>
      by_cases hij : i = j
      · subst hij
        rw [lookupValue_get_assumption hget] at hval
        exact nomatch hval
      · by_cases hlt : i < j
        · simp only [instantiate, if_neg hij, if_neg (by omega : ¬ j < i)]
          exact .zetaLocal (lookupValue_substRemove_lt (v := v) hlt hval)
        · simp only [instantiate, if_neg hij, if_pos (by omega : j < i)]
          exact .zetaLocal (lookupValue_substRemove_gt (v := v) (by omega : j < i) hval)
  | @delta rmem ls m b hres hbody =>
      have hbod : ∀ k, lift k 1 b = b := (hcl rmem m hres).2 b hbody
      have hfix : instantiate j (lift 0 j v) (instantiateLevels ls b) = instantiateLevels ls b := by
        rw [instantiate_eq_substT]
        exact substT_closed (lift_instantiateLevels_closedT hbod ls) _
      rw [show instantiate j (lift 0 j v) (.const rmem ls) = .const rmem ls from rfl, hfix]
      exact .delta hres hbody
  | iota hI =>
      exact .iota (derivedIotaU_subst j (lift 0 j v) hI)
  | lit tN =>
      rw [show instantiate j (lift 0 j v) (.lit tN) = .lit tN from rfl,
        natExpand_instantiate j (lift 0 j v) tN]
      exact .lit tN
  | appHead _ ih =>
      exact .appHead ih

/-- `WhRedCtx E Γ` commutes with `substRemove v j Γ` / `instantiate j (lift 0 j v)` at any
    `.assumption t` hole (`Γ[j]? = some (.assumption t)`) under `EnvClosed E`. -/
theorem whRedCtx_instantiate_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {j : Nat} {t : Expr Nat} (hget : Γ[j]? = some (.assumption t))
    {a b : Expr Nat} (h : WhRedCtx E Γ a b) (v : Expr Nat) :
    WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) a) (instantiate j (lift 0 j v) b) := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (whStepCtx_instantiate_of_envClosed hcl hget hs v) ih

/-- At a `.letBinding t w0` hole (`Γ[j]? = some (.letBinding t w0)`), `WhStepCtx E Γ a b` maps under
    `instantiate j (lift 0 j w0)` to `WhRedCtx E (substRemove w0 j Γ)` (0 steps when `zetaLocal`
    fires at `i = j`, and 1 step otherwise). -/
theorem whStepCtx_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {j : Nat} {t w0 : Expr Nat} (hget : Γ[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhStepCtx E Γ a b) :
    WhRedCtx E (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | beta A body arg =>
      rw [show instantiate j (lift 0 j w0) (.app (.lam A body) arg) =
          .app (.lam (instantiate j (lift 0 j w0) A) (instantiate (j + 1) (lift 0 1 (lift 0 j w0)) body))
            (instantiate j (lift 0 j w0) arg) from rfl,
        instantiate0, instantiate_instantiate 0 j arg (lift 0 j w0) (Nat.zero_le j) body]
      exact .step (.beta _ _ _) (.refl _)
  | zeta A value body =>
      rw [show instantiate j (lift 0 j w0) (.letE A value body) =
          .letE (instantiate j (lift 0 j w0) A) (instantiate j (lift 0 j w0) value)
            (instantiate (j + 1) (lift 0 1 (lift 0 j w0)) body) from rfl,
        instantiate0, instantiate_instantiate 0 j value (lift 0 j w0) (Nat.zero_le j) body]
      exact .step (.zeta _ _ _) (.refl _)
  | @zetaLocal i v0 hval =>
      by_cases hij : i = j
      · subst hij
        rw [lookupValue_get_letBinding hget] at hval
        injection hval with hval
        subst hval
        simp only [instantiate, if_pos rfl]
        rw [instantiate_lift_cancel (i + 1) 0 i (lift 0 i w0) (by omega) (by omega)]
        exact .refl _
      · by_cases hlt : i < j
        · simp only [instantiate, if_neg hij, if_neg (by omega : ¬ j < i)]
          exact .step (.zetaLocal (lookupValue_substRemove_lt (v := w0) hlt hval)) (.refl _)
        · simp only [instantiate, if_neg hij, if_pos (by omega : j < i)]
          exact .step (.zetaLocal (lookupValue_substRemove_gt (v := w0) (by omega : j < i) hval)) (.refl _)
  | @delta rmem ls m b hres hbody =>
      have hbod : ∀ k, lift k 1 b = b := (hcl rmem m hres).2 b hbody
      have hfix : instantiate j (lift 0 j w0) (instantiateLevels ls b) = instantiateLevels ls b := by
        rw [instantiate_eq_substT]
        exact substT_closed (lift_instantiateLevels_closedT hbod ls) _
      rw [show instantiate j (lift 0 j w0) (.const rmem ls) = .const rmem ls from rfl, hfix]
      exact .step (.delta hres hbody) (.refl _)
  | iota hI =>
      exact .step (.iota (derivedIotaU_subst j (lift 0 j w0) hI)) (.refl _)
  | lit tN =>
      rw [show instantiate j (lift 0 j w0) (.lit tN) = .lit tN from rfl,
        natExpand_instantiate j (lift 0 j w0) tN]
      exact .step (.lit tN) (.refl _)
  | @appHead f f' arg _ ih =>
      exact whRedCtx_appHead ih

/-- `WhRedCtx E Γ` commutes with `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` at any
    `.letBinding t w0` hole (`Γ[j]? = some (.letBinding t w0)`) under `EnvClosed E`. -/
theorem whRedCtx_instantiate_letBinding_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
    {Γ : LCtx} {j : Nat} {t w0 : Expr Nat} (hget : Γ[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhRedCtx E Γ a b) :
    WhRedCtx E (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih =>
      exact whRedCtx_trans (whStepCtx_instantiate_letBinding_of_envClosed hcl hget hs) ih

/-- `ConvArgsT` commutes with one-declaration weakening `insertAt d k Γ` / `lift k 1`. -/
theorem convArgsT_weaken {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') :
    ConvArgsT E n (insertAt d k Γ) (lift k 1 T) (xs.map (lift k 1)) (xs'.map (lift k 1)) := by
  induction h with
  | nil T => exact .nil (lift k 1 T)
  | cons A B f f' fs fs' hc _ ih =>
      obtain ⟨c⟩ := hc
      have hinst : lift k 1 (instantiate0 f B) = instantiate0 (lift k 1 f) (lift (k + 1) 1 B) :=
        lift_instantiate_low 1 k 0 f (Nat.zero_le k) B
      rw [hinst] at ih
      exact .cons (lift k 1 A) (lift (k + 1) 1 B) (lift k 1 f) (lift k 1 f')
        (fs.map (lift k 1)) (fs'.map (lift k 1)) ⟨convTWeaken d hcl (c := k) c⟩ ih

/-- At an admitted member's instantiated type `instantiateLevels ls m.mtype`, `ConvArgsT` weakens
    with fixed telescope `instantiateLevels ls m.mtype`. -/
theorem convArgsT_weaken_instMtype {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (ls : List Level)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ConvArgsT E n (insertAt d k Γ) (instantiateLevels ls m.mtype)
      (xs.map (lift k 1)) (xs'.map (lift k 1)) := by
  have h0 := convArgsT_weaken hcl d (k := k) h
  rwa [lift_instantiateLevels, (hcl r m hm).1 k] at h0

/-- `ConvArgsT` commutes with `substRemove v j Γ` / `instantiate j (lift 0 j v)` at an
    `.assumption t` hole (`Γ[j]? = some (.assumption t)`). -/
theorem convArgsT_subst {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (v t : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') :
    ConvArgsT E n (substRemove v j Γ) (instantiate j (lift 0 j v) T)
      (xs.map (instantiate j (lift 0 j v))) (xs'.map (instantiate j (lift 0 j v))) := by
  induction h with
  | nil T => exact .nil (instantiate j (lift 0 j v) T)
  | cons A B f f' fs fs' hc _ ih =>
      obtain ⟨c⟩ := hc
      have hlift : lift 0 1 (lift 0 j v) = lift 0 (j + 1) v :=
        lift_lift_merge 1 j 0 0 (by omega) (by omega) v
      have hinst0 : instantiate j (lift 0 j v) (instantiate0 f B) =
          instantiate0 (instantiate j (lift 0 j v) f) (instantiate (j + 1) (lift 0 (j + 1) v) B) := by
        rw [instantiate0, instantiate_instantiate 0 j f (lift 0 j v) (Nat.zero_le j) B, hlift, ← instantiate0]
      rw [hinst0] at ih
      have hpi : instantiate j (lift 0 j v) (.pi A B) =
          .pi (instantiate j (lift 0 j v) A) (instantiate (j + 1) (lift 0 (j + 1) v) B) := by
        simp only [instantiate, hlift]
      rw [hpi]
      exact .cons _ _ _ _ _ _ ⟨convT_substS hcl hinst v t c hget hvty⟩ ih

/-- At an admitted member's instantiated type `instantiateLevels ls m.mtype`, `ConvArgsT` is
    preserved by `substRemove v j Γ` / `instantiate j (lift 0 j v)` at an `.assumption t` hole. -/
theorem convArgsT_subst_instMtype {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (ls : List Level)
    (v t : Expr Nat) {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ConvArgsT E n (substRemove v j Γ) (instantiateLevels ls m.mtype)
      (xs.map (instantiate j (lift 0 j v))) (xs'.map (instantiate j (lift 0 j v))) := by
  have h0 := convArgsT_subst hcl hinst v t hget hvty h
  rwa [(hinst r m hm).1 ls (lift 0 j v) j] at h0

/-- `ConvArgsT` commutes with `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` at a
    `.letBinding t w0` hole (`Γ[j]? = some (.letBinding t w0)`). -/
theorem convArgsT_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    {T : Expr Nat} {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ T xs xs') :
    ConvArgsT E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) T)
      (xs.map (instantiate j (lift 0 j w0))) (xs'.map (instantiate j (lift 0 j w0))) := by
  induction h with
  | nil T => exact .nil (instantiate j (lift 0 j w0) T)
  | cons A B f f' fs fs' hc _ ih =>
      obtain ⟨c⟩ := hc
      have hlift : lift 0 1 (lift 0 j w0) = lift 0 (j + 1) w0 :=
        lift_lift_merge 1 j 0 0 (by omega) (by omega) w0
      have hinst0 : instantiate j (lift 0 j w0) (instantiate0 f B) =
          instantiate0 (instantiate j (lift 0 j w0) f) (instantiate (j + 1) (lift 0 (j + 1) w0) B) := by
        rw [instantiate0, instantiate_instantiate 0 j f (lift 0 j w0) (Nat.zero_le j) B, hlift, ← instantiate0]
      rw [hinst0] at ih
      have hpi : instantiate j (lift 0 j w0) (.pi A B) =
          .pi (instantiate j (lift 0 j w0) A) (instantiate (j + 1) (lift 0 (j + 1) w0) B) := by
        simp only [instantiate, hlift]
      rw [hpi]
      exact .cons _ _ _ _ _ _ ⟨convT_substLetS hcl hinst t w0 c hget hvty⟩ ih

/-- At an admitted member's instantiated type `instantiateLevels ls m.mtype`, `ConvArgsT` is
    preserved by `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` at a `.letBinding t w0` hole. -/
theorem convArgsT_substLet_instMtype {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    {r : Nat} {m : CheckedMember} (hm : E.members r = some m) (ls : List Level)
    (t w0 : Expr Nat) {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    {xs xs' : List (Expr Nat)}
    (h : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ConvArgsT E n (substRemove w0 j Γ) (instantiateLevels ls m.mtype)
      (xs.map (instantiate j (lift 0 j w0))) (xs'.map (instantiate j (lift 0 j w0))) := by
  have h0 := convArgsT_substLet hcl hinst t w0 hget hvty h
  rwa [(hinst r m hm).1 ls (lift 0 j w0) j] at h0

/-- **Weakening of `LRTypeFamIN` Across All `BotFamCpt E` Compacts (`lrTypeFamIN_weaken_botFamCpt`):**
    Under `EnvClosed E`, `LRTypeFamIN` on any `BotFamCpt E` compact (`.bot`, `.sort`, `.pi a f`,
    and saturated admitted `.inductiveM` family spines `.spine r args`) is stable under
    one-declaration weakening `insertAt d k Γ` / `lift k 1`. -/
theorem lrTypeFamIN_weaken_botFamCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} (d : LocalDecl) (k : Nat),
      CtxWfT E n (insertAt d k Γ) →
      LRTypeFamIN E n Γ A A' c →
      LRTypeFamIN E n (insertAt d k Γ) (lift k 1 A) (lift k 1 A') c := by
  induction hc with
  | bot =>
      intro Γ A A' d k _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' d k _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedCtx_lift_of_envClosed hcl h₁ d k)
            (whRedCtx_lift_of_envClosed hcl h₂ d k)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' d k hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have h₁' : WhRedCtx E (insertAt d k Γ) (lift k 1 A) (.pi (lift k 1 A₁) (lift (k + 1) 1 B₁)) :=
            whRedCtx_lift_of_envClosed hcl h₁ d k
          have h₂' : WhRedCtx E (insertAt d k Γ) (lift k 1 A') (.pi (lift k 1 A₂) (lift (k + 1) 1 B₂)) :=
            whRedCtx_lift_of_envClosed hcl h₂ d k
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hA₁' : HasTyT E n (insertAt d k Γ) (lift k 1 A₁) (.sort u) :=
            hasTyTWeaken d hcl (c := k) hA₁
          have hΓ₁' : CtxWfT E n (.assumption (lift k 1 A₁) :: insertAt d k Γ) :=
            .assumption _ _ u hΓ' hA₁'
          have hdom' : TyConvT E n (insertAt d k Γ) (lift k 1 A₁) (lift k 1 A₂) :=
            tyConvTWeaken d hcl (c := k) hdom
          have hcod' : TyConvT E n (.assumption (lift k 1 A₁) :: insertAt d k Γ)
              (lift (k + 1) 1 B₁) (lift (k + 1) 1 B₂) :=
            tyConvTWeaken d hcl (c := k + 1) (Γ := .assumption A₁ :: Γ) hcod
          exact .pi h₁' h₂' hΓ₁' hdom' hcod'
            (iha d k hΓ' ra)
            (fun s hs => by
              have hΓ₁_ins : CtxWfT E n (insertAt d (k + 1) (.assumption A₁ :: Γ)) := hΓ₁'
              exact ihf s hs d (k + 1) hΓ₁_ins (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' d k _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedCtx E (insertAt d k Γ) (lift k 1 A)
              (foldApps (.const r ls) (xs.map (lift k 1))) := by
            have h0 := whRedCtx_lift_of_envClosed hcl h₁ d k
            rwa [foldApps_lift] at h0
          have h₂' : WhRedCtx E (insertAt d k Γ) (lift k 1 A')
              (foldApps (.const r ls') (xs'.map (lift k 1))) := by
            have h0 := whRedCtx_lift_of_envClosed hcl h₂ d k
            rwa [foldApps_lift] at h0
          have hty₁ : HasTyT E n (insertAt d k Γ)
              (foldApps (.const r ls) (xs.map (lift k 1))) (.sort w) := by
            have h0 := hasTyTWeaken d hcl (c := k) hty
            rwa [foldApps_lift] at h0
          have hty₂ : HasTyT E n (insertAt d k Γ)
              (foldApps (.const r ls') (xs'.map (lift k 1))) (.sort w') := by
            have h0 := hasTyTWeaken d hcl (c := k) hty'
            rwa [foldApps_lift] at h0
          have hc'' : TyConvT E n (insertAt d k Γ)
              (foldApps (.const r ls) (xs.map (lift k 1)))
              (foldApps (.const r ls') (xs'.map (lift k 1))) := by
            have h0 := tyConvTWeaken d hcl (c := k) hc'
            rwa [foldApps_lift, foldApps_lift] at h0
          have hlen₁ : (xs.map (lift k 1)).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (lift k 1)).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_weaken_instMtype hcl hm' ls d hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

/-- Cutoff-`0` specialization: `LRTypeFamIN` on any `BotFamCpt E` compact is stable under head
    weakening `d :: Γ` / `lift 0 1`. -/
theorem lrTypeFamIN_weaken0_botFamCpt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamIN E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') c :=
  lrTypeFamIN_weaken_botFamCpt hcl hc d 0 hΓ' h

/-- **Assumption-Substitution Stability of `LRTypeFamIN` Across All `BotFamCpt E` Compacts
    (`lrTypeFamIN_subst_botFamCpt`):**
    Under `EnvClosed E` and `EnvMembersSubstStable E`, `LRTypeFamIN` on any `BotFamCpt E` compact
    (including `.famSpine`) is stable under `substRemove v j Γ` / `instantiate j (lift 0 j v)`
    at an `.assumption t` hole (`Γ[j]? = some (.assumption t)`). -/
theorem lrTypeFamIN_subst_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (v t : Expr Nat)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} {j : Nat},
      Γ[j]? = some (.assumption t) →
      HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t) →
      CtxWfT E n (substRemove v j Γ) →
      LRTypeFamIN E n Γ A A' c →
      LRTypeFamIN E n (substRemove v j Γ)
        (instantiate j (lift 0 j v) A) (instantiate j (lift 0 j v) A') c := by
  induction hc with
  | bot =>
      intro Γ A A' j _ _ _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' j hget _ _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedCtx_instantiate_of_envClosed hcl hget h₁ v)
            (whRedCtx_instantiate_of_envClosed hcl hget h₂ v)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' j hget hvty hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have hlift : lift 0 1 (lift 0 j v) = lift 0 (j + 1) v :=
            lift_lift_merge 1 j 0 0 (by omega) (by omega) v
          have h₁' : WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A)
              (.pi (instantiate j (lift 0 j v) A₁) (instantiate (j + 1) (lift 0 (j + 1) v) B₁)) := by
            have h0 := whRedCtx_instantiate_of_envClosed hcl hget h₁ v
            simpa only [instantiate, hlift] using h0
          have h₂' : WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A')
              (.pi (instantiate j (lift 0 j v) A₂) (instantiate (j + 1) (lift 0 (j + 1) v) B₂)) := by
            have h0 := whRedCtx_instantiate_of_envClosed hcl hget h₂ v
            simpa only [instantiate, hlift] using h0
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hΓ₁' : CtxWfT E n (substRemove v (j + 1) (.assumption A₁ :: Γ)) :=
            subst_arg_wf_assump hcl hinst hget hvty hΓ' hA₁
          have hget' : (LocalDecl.assumption A₁ :: Γ)[j + 1]? = some (.assumption t) := by
            rw [List.getElem?_cons_succ]; exact hget
          have hvty' : HasTyT E n (substRemove v (j + 1) (.assumption A₁ :: Γ))
              (lift 0 (j + 1) v) (lift 0 (j + 1) t) := by
            have h0 := hasTyTWeaken (instDecl j v (.assumption A₁)) hcl (c := 0) hvty
            rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
                lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
            exact h0
          have hdom' : TyConvT E n (substRemove v j Γ)
              (instantiate j (lift 0 j v) A₁) (instantiate j (lift 0 j v) A₂) :=
            tyConvT_substS hcl hinst v t hdom hget hvty
          have hcod' : TyConvT E n (.assumption (instantiate j (lift 0 j v) A₁) :: substRemove v j Γ)
              (instantiate (j + 1) (lift 0 (j + 1) v) B₁)
              (instantiate (j + 1) (lift 0 (j + 1) v) B₂) := by
            simpa only [substRemove_succ_cons, instDecl] using
              tyConvT_substS hcl hinst v t (j := j + 1) hcod hget' hvty'
          have hΓ₁'' : CtxWfT E n (.assumption (instantiate j (lift 0 j v) A₁) :: substRemove v j Γ) := by
            simpa only [substRemove_succ_cons, instDecl] using hΓ₁'
          exact .pi h₁' h₂' hΓ₁'' hdom' hcod'
            (iha hget hvty hΓ' ra)
            (fun s hs => by
              simpa only [substRemove_succ_cons, instDecl] using
                ihf s hs hget' hvty' hΓ₁' (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' j hget hvty _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v)))) := by
            have h0 := whRedCtx_instantiate_of_envClosed hcl hget h₁ v
            rwa [instantiate_famApp] at h0
          have h₂' : WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A')
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) := by
            have h0 := whRedCtx_instantiate_of_envClosed hcl hget h₂ v
            rwa [instantiate_famApp] at h0
          have hty₁ : HasTyT E n (substRemove v j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v)))) (.sort w) := by
            have h0 := hasTyT_substS hcl hinst v t hty hget hvty
            rwa [instantiate_famApp] at h0
          have hty₂ : HasTyT E n (substRemove v j Γ)
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) (.sort w') := by
            have h0 := hasTyT_substS hcl hinst v t hty' hget hvty
            rwa [instantiate_famApp] at h0
          have hc'' : TyConvT E n (substRemove v j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j v))))
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j v)))) := by
            have h0 := tyConvT_substS hcl hinst v t hc' hget hvty
            rwa [instantiate_famApp, instantiate_famApp] at h0
          have hlen₁ : (xs.map (instantiate j (lift 0 j v))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (instantiate j (lift 0 j v))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_subst_instMtype hcl hinst hm' ls v t hget hvty hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

/-- Head (`j = 0`) specialization: `LRTypeFamIN` on any `BotFamCpt E` compact is stable under
    `instantiate0 v` for any `HasTyT E n Γ v t`. -/
theorem lrTypeFamIN_subst0_botFamCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {v t A A' : Expr Nat}
    (hv : HasTyT E n Γ v t) {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamIN E n (.assumption t :: Γ) A A' c) :
    LRTypeFamIN E n Γ (instantiate0 v A) (instantiate0 v A') c := by
  have hget0 : (LocalDecl.assumption t :: Γ)[0]? = some (.assumption t) := by simp
  have h0 := lrTypeFamIN_subst_botFamCpt (envClosed_of_envWfT hW)
    (envMembersSubstStable_of_envWfT hW) v t hc hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using hv)
    (by simpa only [substRemove_zero_cons] using hΓ) h
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

/-- **Let-Binding Substitution Stability of `LRTypeFamIN` Across All `BotFamCpt E` Compacts
    (`lrTypeFamIN_substLet_botFamCpt`):**
    Under `EnvClosed E` and `EnvMembersSubstStable E`, `LRTypeFamIN` on any `BotFamCpt E` compact
    (including `.famSpine`) is stable under `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)`
    at a `.letBinding t w0` hole (`Γ[j]? = some (.letBinding t w0)`). -/
theorem lrTypeFamIN_substLet_botFamCpt {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {c : CptI} (hc : BotFamCpt E c) :
    ∀ {Γ : LCtx} {A A' : Expr Nat} {j : Nat},
      Γ[j]? = some (.letBinding t w0) →
      HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t) →
      CtxWfT E n (substRemove w0 j Γ) →
      LRTypeFamIN E n Γ A A' c →
      LRTypeFamIN E n (substRemove w0 j Γ)
        (instantiate j (lift 0 j w0) A) (instantiate j (lift 0 j w0) A') c := by
  induction hc with
  | bot =>
      intro Γ A A' j _ _ _ _
      exact .bot _ _ _
  | sort =>
      intro Γ A A' j hget _ _ h
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₁)
            (whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₂)
  | @pi a f _ _ _ iha ihf =>
      intro Γ A A' j hget hvty hΓ' h
      cases h with
      | @pi _ _ _ A₁ B₁ A₂ B₂ _ _ h₁ h₂ hΓ₁ hdom hcod ra rf =>
          have hlift : lift 0 1 (lift 0 j w0) = lift 0 (j + 1) w0 :=
            lift_lift_merge 1 j 0 0 (by omega) (by omega) w0
          have h₁' : WhRedCtx E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A)
              (.pi (instantiate j (lift 0 j w0) A₁) (instantiate (j + 1) (lift 0 (j + 1) w0) B₁)) := by
            have h0 := whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₁
            simpa only [instantiate, hlift] using h0
          have h₂' : WhRedCtx E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A')
              (.pi (instantiate j (lift 0 j w0) A₂) (instantiate (j + 1) (lift 0 (j + 1) w0) B₂)) := by
            have h0 := whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₂
            simpa only [instantiate, hlift] using h0
          have hA₁ : ∃ u, Nonempty (HasTyT E n Γ A₁ (.sort u)) := by
            cases hΓ₁ with
            | assumption _ _ u _ hA₁ => exact ⟨u, ⟨hA₁⟩⟩
          obtain ⟨u, ⟨hA₁⟩⟩ := hA₁
          have hA₁' : HasTyT E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A₁) (.sort u) :=
            hasTyT_substLetS hcl hinst t w0 hA₁ hget hvty
          have hΓ₁'' : CtxWfT E n (.assumption (instantiate j (lift 0 j w0) A₁) :: substRemove w0 j Γ) :=
            .assumption _ _ u hΓ' hA₁'
          have hΓ₁' : CtxWfT E n (substRemove w0 (j + 1) (.assumption A₁ :: Γ)) := by
            simpa only [substRemove_succ_cons, instDecl] using hΓ₁''
          have hget' : (LocalDecl.assumption A₁ :: Γ)[j + 1]? = some (.letBinding t w0) := by
            rw [List.getElem?_cons_succ]; exact hget
          have hvty' : HasTyT E n (substRemove w0 (j + 1) (.assumption A₁ :: Γ))
              (lift 0 (j + 1) w0) (lift 0 (j + 1) t) := by
            have h0 := hasTyTWeaken (instDecl j w0 (.assumption A₁)) hcl (c := 0) hvty
            rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
                lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
            exact h0
          have hdom' : TyConvT E n (substRemove w0 j Γ)
              (instantiate j (lift 0 j w0) A₁) (instantiate j (lift 0 j w0) A₂) :=
            tyConvT_substLetS hcl hinst t w0 hdom hget hvty
          have hcod' : TyConvT E n (.assumption (instantiate j (lift 0 j w0) A₁) :: substRemove w0 j Γ)
              (instantiate (j + 1) (lift 0 (j + 1) w0) B₁)
              (instantiate (j + 1) (lift 0 (j + 1) w0) B₂) := by
            simpa only [substRemove_succ_cons, instDecl] using
              tyConvT_substLetS hcl hinst t w0 (j := j + 1) hcod hget' hvty'
          exact .pi h₁' h₂' hΓ₁'' hdom' hcod'
            (iha hget hvty hΓ' ra)
            (fun s hs => by
              simpa only [substRemove_succ_cons, instDecl] using
                ihf s hs hget' hvty' hΓ₁' (rf s hs))
  | @famSpine r m args hm hind _ _ =>
      intro Γ A A' j hget hvty _ h
      cases h with
      | @famSpine _ _ _ _ m' ls ls' xs xs' w w' _ hm' hind' h₁ h₂ hty hty' hc' heqN hlen hlen' hargs =>
          have h₁' : WhRedCtx E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0)))) := by
            have h0 := whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₁
            rwa [instantiate_famApp] at h0
          have h₂' : WhRedCtx E (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A')
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) := by
            have h0 := whRedCtx_instantiate_letBinding_of_envClosed hcl hget h₂
            rwa [instantiate_famApp] at h0
          have hty₁ : HasTyT E n (substRemove w0 j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0)))) (.sort w) := by
            have h0 := hasTyT_substLetS hcl hinst t w0 hty hget hvty
            rwa [instantiate_famApp] at h0
          have hty₂ : HasTyT E n (substRemove w0 j Γ)
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) (.sort w') := by
            have h0 := hasTyT_substLetS hcl hinst t w0 hty' hget hvty
            rwa [instantiate_famApp] at h0
          have hc'' : TyConvT E n (substRemove w0 j Γ)
              (foldApps (.const r ls) (xs.map (instantiate j (lift 0 j w0))))
              (foldApps (.const r ls') (xs'.map (instantiate j (lift 0 j w0)))) := by
            have h0 := tyConvT_substLetS hcl hinst t w0 hc' hget hvty
            rwa [instantiate_famApp, instantiate_famApp] at h0
          have hlen₁ : (xs.map (instantiate j (lift 0 j w0))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen]
          have hlen₂ : (xs'.map (instantiate j (lift 0 j w0))).length = (piDomsOf m'.mtype).length := by
            rw [List.length_map, hlen']
          exact .famSpine hm' hind' h₁' h₂' hty₁ hty₂ hc'' heqN hlen₁ hlen₂
            (convArgsT_substLet_instMtype hcl hinst hm' ls t w0 hget hvty hargs)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m hm hind).elim

/-- Head (`j = 0`) specialization: `LRTypeFamIN` on any `BotFamCpt E` compact is stable under
    `instantiate0 w0` from `.letBinding t w0 :: Γ`. -/
theorem lrTypeFamIN_substLet0_botFamCpt {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {t w0 A A' : Expr Nat}
    (hw0 : HasTyT E n Γ w0 t) {c : CptI} (hc : BotFamCpt E c)
    (h : LRTypeFamIN E n (.letBinding t w0 :: Γ) A A' c) :
    LRTypeFamIN E n Γ (instantiate0 w0 A) (instantiate0 w0 A') c := by
  have hget0 : (LocalDecl.letBinding t w0 :: Γ)[0]? = some (.letBinding t w0) := by simp
  have h0 := lrTypeFamIN_substLet_botFamCpt (envClosed_of_envWfT hW)
    (envMembersSubstStable_of_envWfT hW) t w0 hc hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using hw0)
    (by simpa only [substRemove_zero_cons] using hΓ) h
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

/-- For any declaration `d : LocalDecl`, `ApproxDI E (ctxEnvDI E (d :: Γ)) (lift 0 1 e) c` is
    equivalent (`↔`) to `ApproxDI E (ctxEnvDI E Γ) e c`. -/
theorem approxDI_lift0_one_ctxEnvDI_iff (E : ResolvedEnv) (Γ : LCtx)
    (d : LocalDecl) (e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (d :: Γ)) (lift 0 1 e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) e c := by
  cases d with
  | assumption A =>
      exact PiModelDeltaIotaAudit.approxDI_lift0_one_iff E (ctxEnvDI E Γ) botSetI e c
  | letBinding A v =>
      exact PiModelDeltaIotaAudit.approxDI_lift0_one_iff E (ctxEnvDI E Γ)
        (PiModelDeltaIotaAudit.denDI E (ctxEnvDI E Γ) v) e c

/-- `LRTypeFamINBiDI` is stable under head weakening `d :: Γ` / `lift 0 1` for every `d : LocalDecl`
    (both `.assumption` and `.letBinding`!). -/
theorem lrTypeFamINBiDI_weaken0 {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} (hΓ' : CtxWfT E n (d :: Γ))
    {A A' : Expr Nat} (h : LRTypeFamINBiDI E n Γ A A') :
    LRTypeFamINBiDI E n (d :: Γ) (lift 0 1 A) (lift 0 1 A') := by
  intro c hc happrox
  have happrox₀ :
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDI_lift0_one_ctxEnvDI_iff E Γ d A c).mp hL)
    · exact Or.inr ((approxDI_lift0_one_ctxEnvDI_iff E Γ d A' c).mp hR)
  exact lrTypeFamIN_weaken0_botFamCpt hcl hΓ' hc (h c hc happrox₀)

/-- Exact equivalence between `ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 e) c` and
    `ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) e c`. -/
theorem approxDI_substLet0_ctxEnvDI_iff (E : ResolvedEnv) (Γ : LCtx)
    (t w0 e : Expr Nat) (c : CptI) :
    PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (instantiate0 w0 e) c ↔
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) e c := by
  have h0 := PiModelDeltaIotaAudit.approxDI_subst_iff E (ctxEnvDI E Γ) 0 w0 e c
  simpa only [lift_zero, instantiate0, EnvI.drop, EnvI.insert_zero, ctxEnvDI_cons_letBinding] using h0

/-- `LRTypeFamINBiDI` is stable under `instantiate0 w0` from `.letBinding t w0 :: Γ` into `Γ`. -/
theorem lrTypeFamINBiDI_substLet0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {t w0 A A' : Expr Nat}
    (hw0 : HasTyT E n Γ w0 t)
    (h : LRTypeFamINBiDI E n (.letBinding t w0 :: Γ) A A') :
    LRTypeFamINBiDI E n Γ (instantiate0 w0 A) (instantiate0 w0 A') := by
  intro c hc happrox
  have happrox' :
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) A c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.letBinding t w0 :: Γ)) A' c := by
    rcases happrox with hL | hR
    · exact Or.inl ((approxDI_substLet0_ctxEnvDI_iff E Γ t w0 A c).mp hL)
    · exact Or.inr ((approxDI_substLet0_ctxEnvDI_iff E Γ t w0 A' c).mp hR)
  exact lrTypeFamIN_substLet0_botFamCpt hW hΓ hw0 hc (h c hc happrox')

/-- `LRTypeFamINBiDI` is stable under `instantiate0 v` from `.assumption t :: Γ` into `Γ` for any
    substituent `v` whose `ApproxDI E (ctxEnvDI E Γ)` denotation is `.bot`-only
    (`∀ c, ApproxDI E (ctxEnvDI E Γ) v c → c = .bot`). -/
theorem lrTypeFamINBiDI_subst0_of_botDen {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {v t A A' : Expr Nat}
    (hv : HasTyT E n Γ v t)
    (hbot : ∀ u, PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) v u → u = .bot)
    (h : LRTypeFamINBiDI E n (.assumption t :: Γ) A A') :
    LRTypeFamINBiDI E n Γ (instantiate0 v A) (instantiate0 v A') := by
  have hsub : ∀ (e : Expr Nat) (c : CptI),
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) (instantiate0 v e) c →
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption t :: Γ)) e c := by
    intro e c he
    have h0 := (PiModelDeltaIotaAudit.approxDI_subst_iff E (ctxEnvDI E Γ) 0 v e c).mp
      (by simpa only [lift_zero, instantiate0] using he)
    simp only [EnvI.drop, EnvI.insert_zero] at h0
    refine PiModelDeltaIotaAudit.approxDI_mono_env (fun i u hu => ?_) h0
    cases i with
    | zero => exact hbot u hu
    | succ i => exact hu
  intro c hc happrox
  have happrox' :
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption t :: Γ)) A c ∨
      PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E (.assumption t :: Γ)) A' c := by
    rcases happrox with hL | hR
    · exact Or.inl (hsub A c hL)
    · exact Or.inr (hsub A' c hR)
  exact lrTypeFamIN_subst0_botFamCpt hW hΓ hv hc (h c hc happrox')


/-! #### Part C — `IsRigidPropCtx` & Related-Substitution Stability of `LRTermFamIND` Across `BotFamCpt E`, Constructor Spines, and `.bvar j` Over `ApproxI` and `ApproxDI` (Extending #7660) -/

/-- **Rigid Non-Sort Proposition Classifier (`IsRigidPropCtx E n Γ A`):**
    A type `A` has `HasTyT E n Γ A (.sort .zero)` (`Prop`) and weak-head reduces (`WhRedCtx E Γ`)
    either to a `.pi A₁ B₁` or to a saturated admitted `.inductiveM` family application spine
    `foldApps (.const r ls) xs` (`xs.length = (piDomsOf m.mtype).length`).
    - Under `EnvWfT E`, `IsRigidPropCtx E n Γ A` implies `IsNonSortPropCtx E n Γ A`
      (`isNonSortPropCtx_of_isRigidPropCtx`).
    - Unlike raw `IsNonSortPropCtx`, `IsRigidPropCtx` is **constructively preserved** by weakening
      (`isRigidPropCtx_weaken`), assumption substitution (`isRigidPropCtx_subst`), let-binding
      substitution (`isRigidPropCtx_substLet`), and `TyConvT` transport under
      `FundamentalLRFamINBotDI E n` (`isRigidPropCtx_transport_botDI`). -/
def IsRigidPropCtx (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A : Expr Nat) : Prop :=
  Nonempty (HasTyT E n Γ A (.sort .zero)) ∧
    ((∃ A₁ B₁, WhRedCtx E Γ A (.pi A₁ B₁)) ∨
     (∃ r m ls xs, E.members r = some m ∧ m.mclass = .inductiveM ∧
       xs.length = (piDomsOf m.mtype).length ∧
       WhRedCtx E Γ A (foldApps (.const r ls) xs)))

/-- Every sort-0 `.pi A₁ B₁` satisfies `IsRigidPropCtx E n Γ (.pi A₁ B₁)`. -/
theorem isRigidPropCtx_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A₁ B₁ : Expr Nat}
    (h0 : HasTyT E n Γ (.pi A₁ B₁) (.sort .zero)) :
    IsRigidPropCtx E n Γ (.pi A₁ B₁) :=
  ⟨⟨h0⟩, Or.inl ⟨A₁, B₁, .refl _⟩⟩

/-- Every sort-0 saturated admitted `.inductiveM` family spine `foldApps (.const r ls) xs`
    (`xs.length = (piDomsOf m.mtype).length`) satisfies
    `IsRigidPropCtx E n Γ (foldApps (.const r ls) xs)`. -/
theorem isRigidPropCtx_famApp {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (hlen : xs.length = (piDomsOf m.mtype).length)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsRigidPropCtx E n Γ (foldApps (.const r ls) xs) :=
  ⟨⟨h0⟩, Or.inr ⟨r, m, ls, xs, hm, hind, hlen, .refl _⟩⟩

/-- Under `FundamentalLRFamINBotDI E n`, every sort-0 admitted `.inductiveM` family spine
    automatically satisfies `IsRigidPropCtx` (saturation is derived from `h0`). -/
theorem isRigidPropCtx_famApp_of_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (F : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {m : CheckedMember} {ls : List Level} {xs : List (Expr Nat)}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    (h0 : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort .zero)) :
    IsRigidPropCtx E n Γ (foldApps (.const r ls) xs) :=
  isRigidPropCtx_famApp hm hind
    (famApp_length_eq_piDomsOf_of_fundamentalLRFamINBotDI hW F hΓ hm hind h0) h0

/-- Under `EnvWfT E`, `IsRigidPropCtx E n Γ A` implies `IsNonSortPropCtx E n Γ A`. -/
theorem isNonSortPropCtx_of_isRigidPropCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A : Expr Nat} (h : IsRigidPropCtx E n Γ A) :
    IsNonSortPropCtx E n Γ A := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨fun l hsort => ?_, ⟨h0⟩⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, _, hfam⟩
  · have e := whRedCtx_normal_unique_of_envWfT hW
      hsort (whNormalCtx_sort l) hpi (whNormalCtx_pi A₁ B₁)
    exact Expr.noConfusion e
  · have e := whRedCtx_normal_unique_of_envWfT hW
      hsort (whNormalCtx_sort l) hfam (whNormalCtx_famApp hW hm hind ls xs)
    exact foldApps_const_ne_sort r ls xs l e.symm

/-- `IsRigidPropCtx` is preserved under one-declaration weakening `insertAt d k Γ` / `lift k 1`. -/
theorem isRigidPropCtx_weaken {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    (d : LocalDecl) (k : Nat) {Γ : LCtx} {A : Expr Nat}
    (h : IsRigidPropCtx E n Γ A) :
    IsRigidPropCtx E n (insertAt d k Γ) (lift k 1 A) := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyTWeaken d hcl (c := k) h0⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨lift k 1 A₁, lift (k + 1) 1 B₁, whRedCtx_lift_of_envClosed hcl hpi d k⟩
  · refine Or.inr ⟨r, m, ls, xs.map (lift k 1), hm, hind, by rw [List.length_map, hlen], ?_⟩
    have h0 := whRedCtx_lift_of_envClosed hcl hfam d k
    rwa [foldApps_lift] at h0

/-- `IsRigidPropCtx` is preserved under `substRemove v j Γ` / `instantiate j (lift 0 j v)` at an
    `.assumption t` hole (`Γ[j]? = some (.assumption t)`). -/
theorem isRigidPropCtx_subst {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (v t : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.assumption t))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    {A : Expr Nat} (h : IsRigidPropCtx E n Γ A) :
    IsRigidPropCtx E n (substRemove v j Γ) (instantiate j (lift 0 j v) A) := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyT_substS hcl hinst v t h0 hget hvty⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j v) A₁, instantiate (j + 1) (lift 0 1 (lift 0 j v)) B₁,
      whRedCtx_instantiate_of_envClosed hcl hget hpi v⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j v)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedCtx_instantiate_of_envClosed hcl hget hfam v
    rwa [instantiate_famApp] at hr

/-- `IsRigidPropCtx` is preserved under `substRemove w0 j Γ` / `instantiate j (lift 0 j w0)` at a
    `.letBinding t w0` hole (`Γ[j]? = some (.letBinding t w0)`). -/
theorem isRigidPropCtx_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    {A : Expr Nat} (h : IsRigidPropCtx E n Γ A) :
    IsRigidPropCtx E n (substRemove w0 j Γ) (instantiate j (lift 0 j w0) A) := by
  obtain ⟨⟨h0⟩, hshape⟩ := h
  refine ⟨⟨hasTyT_substLetS hcl hinst t w0 h0 hget hvty⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · exact Or.inl ⟨instantiate j (lift 0 j w0) A₁, instantiate (j + 1) (lift 0 1 (lift 0 j w0)) B₁,
      whRedCtx_instantiate_letBinding_of_envClosed hcl hget hpi⟩
  · refine Or.inr ⟨r, m, ls, xs.map (instantiate j (lift 0 j w0)), hm, hind,
      by rw [List.length_map, hlen], ?_⟩
    have hr := whRedCtx_instantiate_letBinding_of_envClosed hcl hget hfam
    rwa [instantiate_famApp] at hr

/-- Transport `IsRigidPropCtx E n Γ A` along `TyConvT E n Γ A A'` using `FundamentalLRFamINBotDI E n`,
    `ZeroSortCoherence E n`, and `EnvWfT E` alone (with zero `WhApproxInvCore` hypotheses). -/
theorem isRigidPropCtx_transport_botDI {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    (hF : FundamentalLRFamINBotDI E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hAA' : TyConvT E n Γ A A') (hprop : IsRigidPropCtx E n Γ A) :
    IsRigidPropCtx E n Γ A' := by
  obtain ⟨⟨hA0⟩, hshape⟩ := hprop
  obtain ⟨hA'0⟩ := Rcic.Declarative.HostProp.sort_transport0 zsc hW hΓ hAA' hA0
  refine ⟨⟨hA'0⟩, ?_⟩
  rcases hshape with ⟨A₁, B₁, hpi⟩ | ⟨r, m, ls, xs, hm, hind, hlen, hfam⟩
  · have hcA := approxDI_ctxEnvDI_pi_of_whRedCtx hW hpi
    have hLR := hF hΓ hA0 hAA' (.pi .bot []) (botFamCpt_pi_bot_nil E) hcA
    cases hLR with
    | @pi _ _ _ _ _ A₂ B₂ _ _ _ hred' _ _ _ _ _ =>
        exact Or.inl ⟨A₂, B₂, hred'⟩
  · have hcA : PiModelDeltaIotaAudit.ApproxDI E (ctxEnvDI E Γ) A (.spine r (botVecI xs)) :=
      (approxDI_ctxEnvDI_whRedCtx_of_envWfT hW hfam _).mpr
        (approxDI_famApp_botVecI_of_inductiveM hW (ctxEnvDI E Γ) hm hind ls xs)
    have hLR := hF hΓ hA0 hAA' (.spine r (botVecI xs))
      (botFamCpt_famSpine_botVecI hm hind hlen) hcA
    cases hLR with
    | @famSpine _ _ _ _ m' _ ls' _ xs' _ _ _ hm' hind' _ hred' _ _ _ _ _ hlen' _ =>
        exact Or.inr ⟨r, m', ls', xs', hm', hind', hlen', hred'⟩
    | otherSpine hnot _ _ _ _ _ =>
        exact (hnot m hm hind).elim

/-- Under `EnvWfT E` and `IsRigidPropCtx E n Γ A`, `LRTermFamIND E n Γ M N A u` holds for all
    `M, N` and all `u : CptI`. -/
theorem lrTermFamIND_of_isRigidPropCtx {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M N A : Expr Nat} (h : IsRigidPropCtx E n Γ A) (u : CptI) :
    LRTermFamIND E n Γ M N A u :=
  lrTermFamIND_of_nonSortPropCtx (isNonSortPropCtx_of_isRigidPropCtx hW h) M N u

/-- **Weakening of `LRTermFamIND` Across All `BotFamCpt E` Compacts at Sort-Classified Types
    (`lrTermFamIND_weaken_botFamCpt_sort`):**
    Under `EnvClosed E`, if `WhRedCtx E Γ A (.sort l)`, then `LRTermFamIND E n Γ M M' A c` on any
    `BotFamCpt E c` (`.bot`, `.sort`, `.pi a f`, or saturated `.inductiveM` `.spine r args`)
    weakens to `LRTermFamIND E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') (lift k 1 A) c`. -/
theorem lrTermFamIND_weaken_botFamCpt_sort {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl} {k : Nat} (hΓ' : CtxWfT E n (insertAt d k Γ))
    {M M' A : Expr Nat} {l : Level} (hA : WhRedCtx E Γ A (.sort l))
    {c : CptI} (hc : BotFamCpt E c)
    (h : LRTermFamIND E n Γ M M' A c) :
    LRTermFamIND E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') (lift k 1 A) c := by
  have hA' : WhRedCtx E (insertAt d k Γ) (lift k 1 A) (.sort l) :=
    whRedCtx_lift_of_envClosed hcl hA d k
  have hLR : LRTypeFamIN E n Γ M M' c := by
    cases hc with
    | bot => exact .bot _ _ _
    | sort =>
        rcases (lrTermFamIND_sort_iff _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | pi =>
        rcases (lrTermFamIND_pi_iff _ _ _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | famSpine =>
        rcases (lrTermFamIND_spine_iff _ _ _ _ _ _).mp h with ⟨_, h2⟩ | ⟨hns, _⟩ | ⟨hns, _⟩
        · exact h2
        · exact (hns l hA).elim
        · exact (hns l hA).elim
  have hLR' : LRTypeFamIN E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') c :=
    lrTypeFamIN_weaken_botFamCpt hcl hc d k hΓ' hLR
  cases hc with
  | bot => exact lrTermFamIND_bot _ _ _ _
  | sort => exact (lrTermFamIND_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamIND_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamIND_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)

/-- **Assumption-Substitution Stability of `LRTermFamIND` Across All `BotFamCpt E` Compacts at
    Sort-Classified Types (`lrTermFamIND_subst_botFamCpt_sort`):**
    Under `EnvClosed E` and `EnvMembersSubstStable E`, if `WhRedCtx E Γ A (.sort l)`, then
    `LRTermFamIND E n Γ M M' A c` on any `BotFamCpt E c` (including `.pi a f` and saturated
    `.inductiveM` `.spine r args`) is stable under `substRemove v j Γ` / `instantiate j (lift 0 j v)`. -/
theorem lrTermFamIND_subst_botFamCpt_sort {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (v t : Expr Nat)
    {Γ : LCtx} {j : Nat} (hget : Γ[j]? = some (.assumption t))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    (hΓ' : CtxWfT E n (substRemove v j Γ))
    {M M' A : Expr Nat} {l : Level} (hA : WhRedCtx E Γ A (.sort l))
    {c : CptI} (hc : BotFamCpt E c)
    (h : LRTermFamIND E n Γ M M' A c) :
    LRTermFamIND E n (substRemove v j Γ)
      (instantiate j (lift 0 j v) M) (instantiate j (lift 0 j v) M')
      (instantiate j (lift 0 j v) A) c := by
  have hA' : WhRedCtx E (substRemove v j Γ) (instantiate j (lift 0 j v) A) (.sort l) :=
    whRedCtx_instantiate_of_envClosed hcl hget hA v
  have hLR : LRTypeFamIN E n Γ M M' c := by
    cases hc with
    | bot => exact .bot _ _ _
    | sort =>
        rcases (lrTermFamIND_sort_iff _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | pi =>
        rcases (lrTermFamIND_pi_iff _ _ _ _ _ _).mp h with ⟨hns, _⟩ | ⟨_, h2⟩
        · exact (hns l hA).elim
        · exact h2
    | famSpine =>
        rcases (lrTermFamIND_spine_iff _ _ _ _ _ _).mp h with ⟨_, h2⟩ | ⟨hns, _⟩ | ⟨hns, _⟩
        · exact h2
        · exact (hns l hA).elim
        · exact (hns l hA).elim
  have hLR' := lrTypeFamIN_subst_botFamCpt hcl hinst v t hc hget hvty hΓ' hLR
  cases hc with
  | bot => exact lrTermFamIND_bot _ _ _ _
  | sort => exact (lrTermFamIND_sort_iff _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | pi => exact (lrTermFamIND_pi_iff _ _ _ _ _ _).mpr (Or.inr ⟨⟨l, hA'⟩, hLR'⟩)
  | famSpine => exact (lrTermFamIND_spine_iff _ _ _ _ _ _).mpr (Or.inl ⟨⟨l, hA'⟩, hLR'⟩)

/-- **Let-Binding Substitution Stability of `LRTermFamIND` Across All `BotFamCpt E` Compacts at
    Sort-Classified Types (`lrTermFamIND_substLet_botFamCpt_sort`):** -/
theorem lrTermFamIND_substLet_botFamCpt_sort {E : ResolvedEnv} {n : Nat}
