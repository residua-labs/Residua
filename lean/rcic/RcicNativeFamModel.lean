/-- Multi-argument head-spine congruence for `WhStepRecKCanon E Γ`. -/
theorem whStepRecKCanon_foldApps_head {E : ResolvedEnv} {Γ : LCtx}
    {f f' : Expr Nat} (hs : WhStepRecKCanon E Γ f f') (xs : List (Expr Nat)) :
    WhStepRecKCanon E Γ (foldApps f xs) (foldApps f' xs) := by
  induction xs generalizing f f' with
  | nil => exact hs
  | cons x xs ih =>
      simpa only [foldApps] using ih (.appHead hs)

/-- Multi-argument head-spine congruence for `WhRedRecKCanon E Γ`. -/
theorem whRedRecKCanon_foldApps_head {E : ResolvedEnv} {Γ : LCtx}
    {f f' : Expr Nat} (hr : WhRedRecKCanon E Γ f f') (xs : List (Expr Nat)) :
    WhRedRecKCanon E Γ (foldApps f xs) (foldApps f' xs) := by
  induction hr with
  | refl _ => exact .refl _
  | step hs _ ih =>
      exact .step (whStepRecKCanon_foldApps_head hs xs) ih

theorem approxDIKCanon_foldApps_head_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {f f' : Expr Nat}
    (hr : WhRedRecKCanon E Γ f f') (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIKCanon E Γ (foldApps f xs) c ↔ ApproxDIKCanon E Γ (foldApps f' xs) c :=
  whRedRecKCanon_approxDIKCanon_iff_of_envWfT hW (whRedRecKCanon_foldApps_head hr xs) c

theorem semEqDIKCanon_foldApps_head {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {f f' : Expr Nat}
    (hr : WhRedRecKCanon E Γ f f') (xs : List (Expr Nat)) :
    SemEqDIKCanon E Γ (foldApps f xs) (foldApps f' xs) :=
  semEqDIKCanon_of_whRedRecKCanon hW (whRedRecKCanon_foldApps_head hr xs)

theorem approxDIKCanon_const_delta_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {r : Nat} {ls : List Level} {m : CheckedMember} {body : Expr Nat}
    (hres : E.members r = some m) (hbody : m.body = some body) (c : CptI) :
    ApproxDIKCanon E Γ (.const r ls) c ↔
      ApproxDIKCanon E Γ (instantiateLevels ls body) c :=
  whStepRecKCanon_approxDIKCanon_iff_of_envWfT hW (.delta hres hbody) c

theorem approxDIKCanon_foldApps_delta_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {r : Nat} {ls : List Level} {m : CheckedMember} {body : Expr Nat}
    (hres : E.members r = some m) (hbody : m.body = some body)
    (xs : List (Expr Nat)) (c : CptI) :
    ApproxDIKCanon E Γ (foldApps (.const r ls) xs) c ↔
      ApproxDIKCanon E Γ (foldApps (instantiateLevels ls body) xs) c :=
