theorem fundConvFamIN_irr_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat}
    (hP : HasTyT E n Γ (.pi A B) (.sort .zero)) (p q : Expr Nat) :
    ∀ u, ApproxI (ctxEnvI Γ) p u → LRTermFamIN E n Γ p q (.pi A B) u :=
