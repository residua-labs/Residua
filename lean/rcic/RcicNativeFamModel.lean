theorem lrTermFamINDRKCanon_transport_botFamCpt_of_typeRel {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (zsc : Rcic.Declarative.HostProp.ZeroSortCoherence E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A' M M' : Expr Nat}
