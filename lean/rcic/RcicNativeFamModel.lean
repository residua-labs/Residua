theorem approxDIKCanon_zetaLocal_iff {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {i : Nat} {v : Expr Nat} (hv : lookupValue Γ i = some v) (c : CptI) :
    ApproxDIKCanon E Γ (.bvar i) c ↔ ApproxDIKCanon E Γ v c :=
