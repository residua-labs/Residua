    {c : CptI} (hcpt : FamProbeCpt E c) (h : ApproxDIK E n Γ (foldApps (.const r ls) xs) c) :
    LRTypeFamINRK E n Γ (foldApps (.const r ls) xs) (foldApps (.const r ls) xs) c :=
  lrTypeFamINRK_famSpine_of_convArgsT_probe hW hm hind hty hty (.refl _ _) (eqNList_refl ls)
    hlen hlen (convArgs_refl_instMtype hW hpi hΓ hm hind hlen hty) hcpt h

theorem lrTypeFamINRK_of_whStepRecK_probe {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (hs : WhStepRecK E n Γ M M') {c : CptI}
    (hdiag : LRTypeFamINRK E n Γ M' M' c) :
    LRTypeFamINRK E n Γ M M' c :=
  lrTypeFamINRK_expand (.step hs (.refl _)) (.refl _) hdiag

theorem lrTypeFamINRK_of_whRedRecK_probe {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (hr : WhRedRecK E n Γ M M') {c : CptI}
    (hdiag : LRTypeFamINRK E n Γ M' M' c) :
    LRTypeFamINRK E n Γ M M' c :=
  lrTypeFamINRK_expand hr (.refl _) hdiag


/-! ### §16. `PiRowField`-Free `ConvArgsT` Symmetry & Transitivity (`FamConvArgsSymmT` / `FamConvArgsTransT`) and Canonical Deterministic K-Readback (`WhStepRecKCanon`, `WhRedRecKCanon`, `ApproxDIKCanon`, `LRTypeFamINRKCanon`, `FundamentalLRFamINProbeRKCanon`)

1. **Part A — `PiRowField`-Free `ConvArgsT` Symmetry & Transitivity Across Level Instantiations (`FamConvArgsSymmT`, `FamConvArgsTransT`):**
   - `hasTyT_subst_convS`: congruence of `instantiate j (lift 0 j v) e` vs `instantiate j (lift 0 j v') e` along `ConvT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j v') (lift 0 j t)` by structural recursion on `HasTyT E n Γ e A` (not mutual with `ConvT`, since `.conv` closes directly via `convT_substS` + `ConvT.tyConv`).
   - `DomsRel E n Γ ds₁ ds₂`, `domsRel_head`, `domsRel_of_instMtype`, and `domsRel_step` (stepping `DomsRel E n Γ (A₁ :: ds₁) (A₂ :: ds₂)` to `DomsRel E n Γ (instDomsT 0 x ds₁) (instDomsT 0 y ds₂)` along `ConvT E n Γ x y A₁` without `PiRowField`).
   - `convArgs_symm_domsRel`, `convArgs_trans_domsRel`, `convArgs_symm_instMtype_of_envWfT`, `convArgs_trans_instMtype_of_envWfT`, `FamConvArgsSymmT`, `FamConvArgsTransT`, `famConvArgsSymmT_of_envWfT`, `famConvArgsTransT_of_envWfT`, and `PiRowField`-free symmetry/transitivity for `LRTypeFamIN`, `LRTypeFamINBiDI`, `LRTypeFamINR`, `LRTypeFamINBiR`, and `LRTypeFamINRK`.
2. **Part B — Canonical Deterministic Fieldful + Field-Free K-Readback (`WhStepRecKCanon`, `WhRedRecKCanon`, `ApproxDIKCanon`, `LRTypeFamINRKCanon`, `FundamentalLRFamINProbeRKCanon`):**
   - Fixes the `WhStepRecK.pmajor` constructor choice in `WhStepRecKCanon` to `w.ctorIdx = 0` and canonical closed field vector `w.fields = List.replicate w.fields.length famBotClosedExpr` on assumption-headed major spines `foldApps (.bvar i) margs` with `lookupValue Γ i = none`.
   - Proves `pmajorCanon_iotaRhsOf_unique`, unconditional one-step determinism `whDetRecKCanon_of_envWfT`, and unconditional normal-form uniqueness `whRedRecKCanon_normal_unique_of_envWfT` at every `EnvWfT E` and `Γ : LCtx` — while reducing **both** 0-field `trueRecVar` (`trueEnvU`) and 2-field `mixAndRedex` (`andEnvU`)! -/


/-! #### Part A — `PiRowField`-Free `ConvArgsT` Symmetry & Transitivity Across Level Instantiations (`FamConvArgsSymmT` & `FamConvArgsTransT`) -/

/-- **Congruence of Substitution Along a `ConvT` Replacement (`hasTyT_subst_convS`):**
    Given `h : HasTyT E n Γ e A` over an assumption `Γ[j]? = some (.assumption t)`, together with
    `hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t)` and
    `hconv : ConvT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j v') (lift 0 j t)`, constructs
    `ConvT E n (substRemove v j Γ) (instantiate j (lift 0 j v) e) (instantiate j (lift 0 j v') e) (instantiate j (lift 0 j v) A)`
    by structural recursion on `h : HasTyT E n Γ e A` alone (using `convT_substS` in the `.conv`
    case). -/
noncomputable def hasTyT_subst_convS {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (v v' t : Expr Nat) :
    {j : Nat} → {Γ : LCtx} → {e A : Expr Nat} →
    HasTyT E n Γ e A → Γ[j]? = some (.assumption t) →
    HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t) →
    ConvT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j v') (lift 0 j t) →
    ConvT E n (substRemove v j Γ)
      (instantiate j (lift 0 j v) e) (instantiate j (lift 0 j v') e)
      (instantiate j (lift 0 j v) A)
  | _, _, _, _, .sort _ u, _, _, _ => by
      simp only [instantiate]
      exact .refl _ (.sort u) (.sort (.succ u)) (.sort _ u)
  | j, _, _, _, .bvar Γ i A h, hget, hvty, hconv => by
      by_cases hij : i = j
      · subst hij
        rw [lookupType_get_assumption hget] at h
        injection h with h
        subst h
        simp only [instantiate, if_pos rfl]
        rw [instantiate_lift_cancel (i + 1) 0 i (lift 0 i v) (by omega) (by omega)]
        exact hconv
      · have heq : instantiate j (lift 0 j v') (.bvar i) = instantiate j (lift 0 j v) (.bvar i) := by
          simp only [instantiate, if_neg hij]
        rw [heq]
        exact .refl _ _ _ (hasTyT_substS hcl hinst v t (.bvar Γ i A h) hget hvty)
  | j, _, _, _, .const Γ r ls m hres hlen hwf, hget, hvty, _ => by
      simp only [instantiate]
      exact .refl _ _ _ (hasTyT_substS hcl hinst v t (.const Γ r ls m hres hlen hwf) hget hvty)
  | j, _, _, _, .pi Γ A u B w hA hB, hget, hvty, hconv => by
      have hcA := hasTyT_subst_convS hcl hinst v v' t hA hget hvty hconv
      simp only [instantiate] at hcA
      have hvty' :
          HasTyT E n (substRemove v (j + 1) (LocalDecl.assumption A :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) t) := by
        have h0 := hasTyTWeaken (instDecl j v (LocalDecl.assumption A)) hcl (c := 0) hvty
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hconv' :
          ConvT E n (substRemove v (j + 1) (LocalDecl.assumption A :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) v') (lift 0 (j + 1) t) := by
        have h0 := convTWeaken (instDecl j v (LocalDecl.assumption A)) hcl (c := 0) hconv
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hget' : (LocalDecl.assumption A :: Γ)[j + 1]? = some (LocalDecl.assumption t) := by
        rw [List.getElem?_cons_succ]; exact hget
      have hcB := hasTyT_subst_convS hcl hinst v v' t (j := j + 1) hB hget' hvty' hconv'
      simp only [substRemove_succ_cons, instDecl, instantiate] at hcB
      simp only [instantiate]
      rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
          lift_lift_merge 1 j 0 0 (by omega) (by omega)]
      exact .pi _ _ _ _ _ u w hcA hcB
  | j, _, _, _, .lam Γ A u body B hA hbody, hget, hvty, hconv => by
      have hcA := hasTyT_subst_convS hcl hinst v v' t hA hget hvty hconv
      simp only [instantiate] at hcA
      have hvty' :
          HasTyT E n (substRemove v (j + 1) (LocalDecl.assumption A :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) t) := by
        have h0 := hasTyTWeaken (instDecl j v (LocalDecl.assumption A)) hcl (c := 0) hvty
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hconv' :
          ConvT E n (substRemove v (j + 1) (LocalDecl.assumption A :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) v') (lift 0 (j + 1) t) := by
        have h0 := convTWeaken (instDecl j v (LocalDecl.assumption A)) hcl (c := 0) hconv
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hget' : (LocalDecl.assumption A :: Γ)[j + 1]? = some (LocalDecl.assumption t) := by
        rw [List.getElem?_cons_succ]; exact hget
      have hcb := hasTyT_subst_convS hcl hinst v v' t (j := j + 1) hbody hget' hvty' hconv'
      simp only [substRemove_succ_cons, instDecl] at hcb
      simp only [instantiate]
      rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
          lift_lift_merge 1 j 0 0 (by omega) (by omega)]
      exact .lam _ _ _ _ _ _ u hcA hcb
  | j, _, _, _, .app Γ f a A B hf ha, hget, hvty, hconv => by
      have hcf := hasTyT_subst_convS hcl hinst v v' t hf hget hvty hconv
      have hca := hasTyT_subst_convS hcl hinst v v' t ha hget hvty hconv
      simp only [instantiate] at hcf
      have h6 := instantiate_instantiate 0 j a (lift 0 j v) (by omega) B
      simp only [instantiate, instantiate0]
      rw [h6]
      exact .app _ _ _ _ _ _ _ hcf hca
  | j, _, _, _, .letE Γ A u value B body hA hv hb, hget, hvty, hconv => by
      have hcA := hasTyT_subst_convS hcl hinst v v' t hA hget hvty hconv
      simp only [instantiate] at hcA
      have hcv := hasTyT_subst_convS hcl hinst v v' t hv hget hvty hconv
      have hvty' :
          HasTyT E n (substRemove v (j + 1) (LocalDecl.letBinding A value :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) t) := by
        have h0 := hasTyTWeaken (instDecl j v (LocalDecl.letBinding A value)) hcl (c := 0) hvty
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hconv' :
          ConvT E n (substRemove v (j + 1) (LocalDecl.letBinding A value :: Γ))
            (lift 0 (j + 1) v) (lift 0 (j + 1) v') (lift 0 (j + 1) t) := by
        have h0 := convTWeaken (instDecl j v (LocalDecl.letBinding A value)) hcl (c := 0) hconv
        rw [lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega),
            lift_lift_merge 1 j 0 0 (by omega) (by omega)] at h0
        exact h0
      have hget' : (LocalDecl.letBinding A value :: Γ)[j + 1]? = some (LocalDecl.assumption t) := by
        rw [List.getElem?_cons_succ]; exact hget
      have hcb := hasTyT_subst_convS hcl hinst v v' t (j := j + 1) hb hget' hvty' hconv'
      simp only [substRemove_succ_cons, instDecl] at hcb
      have h6 := instantiate_instantiate 0 j value (lift 0 j v) (by omega) B
      simp only [instantiate, instantiate0]
      rw [h6, lift_lift_merge 1 j 0 0 (by omega) (by omega),
          lift_lift_merge 1 j 0 0 (by omega) (by omega)]
      exact .letE _ _ _ _ _ _ _ _ u hcA hcv hcb
  | j, _, _, _, .lit Γ tl T hexp, hget, hvty, _ => by
      simp only [instantiate]
      exact .refl _ _ _ (hasTyT_substS hcl hinst v t (.lit Γ tl T hexp) hget hvty)
  | j, _, _, _, .conv Γ e A B u h hc, hget, hvty, hconv =>
      .tyConv _ _ _ _ _ u
        (hasTyT_subst_convS hcl hinst v v' t h hget hvty hconv)
        (convT_substS hcl hinst v t hc hget hvty)

/-- `substRemove v j` across `policyPrefixContext ds j ++ (.assumption A :: Γ)` produces
    `policyPrefixContext (instDomsT 0 v ds) j ++ Γ`. -/
theorem substRemove_policyPrefixContext (v : Expr Nat) (Γ : LCtx) (ds : List (Expr Nat))
    (A : Expr Nat) :
    (j : Nat) → j ≤ ds.length →
    substRemove v j (policyPrefixContext ds j ++ (.assumption A :: Γ)) =
      policyPrefixContext (instDomsT 0 v ds) j ++ Γ
  | 0, _ => rfl
  | j + 1, hj => by
      have hj' : j < ds.length := hj
      have hj_inst : j < (instDomsT 0 v ds).length := by
        rw [length_instDomsT]; exact hj'
      rw [policyPrefixContext_succ ds j hj', List.cons_append, substRemove_succ_cons,
          substRemove_policyPrefixContext v Γ ds A j (Nat.le_of_lt hj'),
          policyPrefixContext_succ (instDomsT 0 v ds) j hj_inst, List.cons_append]
      simp only [instDecl]
      rw [getElem_instDomsT 0 v ds j hj', Nat.zero_add]

/-- Looking up index `j` in `policyPrefixContext ds j ++ (.assumption A :: Γ)` returns
    `some (.assumption A)`. -/
theorem getElem?_policyPrefixContext_assumption (ds : List (Expr Nat)) (A : Expr Nat)
    (Γ : LCtx) (j : Nat) (hj : j ≤ ds.length) :
    (policyPrefixContext ds j ++ (.assumption A :: Γ))[j]? = some (.assumption A) := by
  have h0 := getElem?_hole_assump (policyPrefixContext ds j) Γ A
  rwa [policyPrefixContext_length ds j hj] at h0

/-- **Telescope Domain Relation (`DomsRel E n Γ ds₁ ds₂`):**
    Captures that two domain telescopes `ds₁, ds₂ : List (Expr Nat)` over `Γ` have equal lengths,
    sort-typed domains at every prefix `policyPrefixContext ds₁ i ++ Γ` and
    `policyPrefixContext ds₂ i ++ Γ`, and slotwise `TyConvT E n (policyPrefixContext ds₁ i ++ Γ) D₁ D₂`. -/
def DomsRel (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (ds₁ ds₂ : List (Expr Nat)) : Prop :=
  ds₁.length = ds₂.length ∧
  (∀ i D₁, ds₁[i]? = some D₁ →
    ∃ u₁, Nonempty (HasTyT E n (policyPrefixContext ds₁ i ++ Γ) D₁ (.sort u₁))) ∧
  (∀ i D₂, ds₂[i]? = some D₂ →
    ∃ u₂, Nonempty (HasTyT E n (policyPrefixContext ds₂ i ++ Γ) D₂ (.sort u₂))) ∧
  (∀ i D₁ D₂, ds₁[i]? = some D₁ → ds₂[i]? = some D₂ →
    Nonempty (TyConvT E n (policyPrefixContext ds₁ i ++ Γ) D₁ D₂))

/-- Head extraction from `DomsRel E n Γ (A₁ :: ds₁) (A₂ :: ds₂)`. -/
theorem domsRel_head {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A₁ A₂ : Expr Nat} {ds₁ ds₂ : List (Expr Nat)}
    (h : DomsRel E n Γ (A₁ :: ds₁) (A₂ :: ds₂)) :
    (∃ u₁, Nonempty (HasTyT E n Γ A₁ (.sort u₁))) ∧
    (∃ u₂, Nonempty (HasTyT E n Γ A₂ (.sort u₂))) ∧
    Nonempty (TyConvT E n Γ A₁ A₂) :=
  ⟨h.2.1 0 A₁ (by simp), h.2.2.1 0 A₂ (by simp), h.2.2.2 0 A₁ A₂ (by simp) (by simp)⟩

/-- **Initial `DomsRel` for Level-Instantiated Member Types (`domsRel_of_instMtype`):**
    Under `EnvWfT E`, for any member `E.members r = some m` and level lists `ls, ls'` with
    `eqNList ls ls'` and two sort-typed spines `foldApps (.const r ls) xs` and
    `foldApps (.const r ls') xs'` in a well-formed context `Γ`, the instantiated domain lists
    `(piDomsOf m.mtype).map (instantiateLevels ls)` and
    `(piDomsOf m.mtype).map (instantiateLevels ls')` satisfy `DomsRel E n Γ` — with **zero**
    `PiRowField` hypothesis! -/
theorem domsRel_of_instMtype {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (_hΓ : CtxWfT E n Γ) {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (heqN : eqNList ls ls') :
    DomsRel E n Γ
      ((piDomsOf m.mtype).map (instantiateLevels ls))
      ((piDomsOf m.mtype).map (instantiateLevels ls')) := by
  obtain ⟨um, hmty⟩ := envWfT_mtypeSortTyped hW r m hm
  have hpol : m.mtype = policyPi (piDomsOf m.mtype) (piTailOf m.mtype) :=
    (policyPi_piDomsOf_piTailOf m.mtype).symm
  have hmtyPol : HasTyT E m.arity [] (policyPi (piDomsOf m.mtype) (piTailOf m.mtype)) (.sort um) :=
    hpol ▸ hmty
  obtain ⟨hdoms, _⟩ := hasTyT_policyPi_inv (piDomsOf m.mtype) hmtyPol
  obtain ⟨hlsl, hwfL⟩ := NativeFamilyProjection.native_level_facts hm hty
  obtain ⟨hlsl', hwfR⟩ := NativeFamilyProjection.native_level_facts hm hty'
  refine ⟨by simp, ?_, ?_, ?_⟩
  · intro i D₁ hD₁
    rw [List.getElem?_map] at hD₁
    cases hdi : (piDomsOf m.mtype)[i]? with
    | none => rw [hdi] at hD₁; cases hD₁
    | some d =>
        rw [hdi] at hD₁
        injection hD₁ with hD₁_eq
        subst hD₁_eq
        obtain ⟨hi, hd_eq⟩ := List.getElem?_eq_some_iff.mp hdi
        subst hd_eq
        obtain ⟨u₀, ⟨hdTy⟩⟩ := hdoms i hi
        have h1 := hasTyT_instLevels (envWfT_levels hW) (iotaLevelsT_of_envWfT hW)
          hwfL hlsl hdTy
        rw [List.append_nil, instLvlsCtx_policyPrefixContext] at h1
        have h2 := hasTyT_relocateN (Γ := Γ) h1
        exact ⟨instLevel ls u₀, ⟨h2⟩⟩
  · intro i D₂ hD₂
    rw [List.getElem?_map] at hD₂
    cases hdi : (piDomsOf m.mtype)[i]? with
    | none => rw [hdi] at hD₂; cases hD₂
    | some d =>
        rw [hdi] at hD₂
        injection hD₂ with hD₂_eq
        subst hD₂_eq
        obtain ⟨hi, hd_eq⟩ := List.getElem?_eq_some_iff.mp hdi
        subst hd_eq
        obtain ⟨u₀, ⟨hdTy⟩⟩ := hdoms i hi
        have h1 := hasTyT_instLevels (envWfT_levels hW) (iotaLevelsT_of_envWfT hW)
          hwfR hlsl' hdTy
        rw [List.append_nil, instLvlsCtx_policyPrefixContext] at h1
        have h2 := hasTyT_relocateN (Γ := Γ) h1
        exact ⟨instLevel ls' u₀, ⟨h2⟩⟩
  · intro i D₁ D₂ hD₁ hD₂
    rw [List.getElem?_map] at hD₁ hD₂
    cases hdi : (piDomsOf m.mtype)[i]? with
    | none => rw [hdi] at hD₁; cases hD₁
    | some d =>
        rw [hdi] at hD₁ hD₂
        injection hD₁ with hD₁_eq
        injection hD₂ with hD₂_eq
        subst hD₁_eq; subst hD₂_eq
        obtain ⟨hi, hd_eq⟩ := List.getElem?_eq_some_iff.mp hdi
        subst hd_eq
        obtain ⟨u₀, ⟨hdTy⟩⟩ := hdoms i hi
        have hc1 := convT_instantiateLevels (envWfT_levels hW) (iotaLevelsT_of_envWfT hW)
          heqN hwfL hwfR hlsl hdTy
        rw [List.append_nil, instLvlsCtx_policyPrefixContext] at hc1
        have hc2 := convT_relocateN (Γ := Γ) hc1
        exact ⟨.of _ _ _ (instLevel ls u₀) hc2⟩

/-- **Stepping `DomsRel` Along `ConvT E n Γ x y A₁` Without `PiRowField` (`domsRel_step`):**
    Given `DomsRel E n Γ (A₁ :: ds₁) (A₂ :: ds₂)` and `ConvT E n Γ x y A₁` in a well-formed context
    `Γ`, produces `DomsRel E n Γ (instDomsT 0 x ds₁) (instDomsT 0 y ds₂)` using `hasTyT_substS`,
    `tyConvT_substS`, and `hasTyT_subst_convS` — with **zero** `PiRowField` hypothesis! -/
theorem domsRel_step {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat} {ds₁ ds₂ : List (Expr Nat)}
    (hrel : DomsRel E n Γ (A₁ :: ds₁) (A₂ :: ds₂))
    {x y : Expr Nat} (hxy : ConvT E n Γ x y A₁) :
    DomsRel E n Γ (instDomsT 0 x ds₁) (instDomsT 0 y ds₂) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  obtain ⟨⟨u₁, ⟨hA₁⟩⟩, ⟨_, ⟨_⟩⟩, ⟨hcA⟩⟩ := domsRel_head hrel
  have ends := convEnds hW hΓ hxy
  have hx : HasTyT E n Γ x A₁ := ends.1
  have hy_A₁ : HasTyT E n Γ y A₁ := ends.2.1
  have hy_A₂ : HasTyT E n Γ y A₂ :=
    (convEnds hW hΓ (convT_of_tyConv (.refl Γ y A₁ hy_A₁) hcA)).1
  have hlen₁₂ : ds₁.length = ds₂.length := Nat.succ.inj hrel.1
  refine ⟨by rw [length_instDomsT, length_instDomsT, hlen₁₂], ?_, ?_, ?_⟩
  · intro j D₁' hD₁'
    obtain ⟨hj_inst, hD₁_eq₀⟩ := List.getElem?_eq_some_iff.mp hD₁'
    subst hD₁_eq₀
    have hj_lt : j < ds₁.length := by rw [← length_instDomsT 0 x ds₁]; exact hj_inst
    rw [getElem_instDomsT 0 x ds₁ j hj_lt, Nat.zero_add]
    have hget₁ : ds₁[j]? = some (ds₁[j]'hj_lt) := List.getElem?_eq_getElem hj_lt
    obtain ⟨w₁, ⟨hty₁⟩⟩ := hrel.2.1 (j + 1) (ds₁[j]'hj_lt) (by simp [hget₁])
    rw [policyPrefixContext_cons_succ] at hty₁
    have hhole₁ := getElem?_policyPrefixContext_assumption ds₁ A₁ Γ j (Nat.le_of_lt hj_lt)
    have hsub₁ := substRemove_policyPrefixContext x Γ ds₁ A₁ j (Nat.le_of_lt hj_lt)
    have hx_lift := hasTyTLiftPrefix hcl (policyPrefixContext (instDomsT 0 x ds₁) j) hx
    rw [policyPrefixContext_length (instDomsT 0 x ds₁) j
          (by rw [length_instDomsT]; exact Nat.le_of_lt hj_lt),
        ← hsub₁] at hx_lift
    have hres := hasTyT_substS hcl hinst x A₁ hty₁ hhole₁ hx_lift
    rw [hsub₁] at hres
    exact ⟨w₁, ⟨hres⟩⟩
  · intro j D₂' hD₂'
    obtain ⟨hj_inst, hD₂_eq₀⟩ := List.getElem?_eq_some_iff.mp hD₂'
    subst hD₂_eq₀
    have hj_lt : j < ds₂.length := by rw [← length_instDomsT 0 y ds₂]; exact hj_inst
    rw [getElem_instDomsT 0 y ds₂ j hj_lt, Nat.zero_add]
    have hget₂ : ds₂[j]? = some (ds₂[j]'hj_lt) := List.getElem?_eq_getElem hj_lt
    obtain ⟨w₂, ⟨hty₂⟩⟩ := hrel.2.2.1 (j + 1) (ds₂[j]'hj_lt) (by simp [hget₂])
    rw [policyPrefixContext_cons_succ] at hty₂
    have hhole₂ := getElem?_policyPrefixContext_assumption ds₂ A₂ Γ j (Nat.le_of_lt hj_lt)
    have hsub₂ := substRemove_policyPrefixContext y Γ ds₂ A₂ j (Nat.le_of_lt hj_lt)
    have hy_lift := hasTyTLiftPrefix hcl (policyPrefixContext (instDomsT 0 y ds₂) j) hy_A₂
    rw [policyPrefixContext_length (instDomsT 0 y ds₂) j
          (by rw [length_instDomsT]; exact Nat.le_of_lt hj_lt),
        ← hsub₂] at hy_lift
    have hres := hasTyT_substS hcl hinst y A₂ hty₂ hhole₂ hy_lift
    rw [hsub₂] at hres
    exact ⟨w₂, ⟨hres⟩⟩
  · intro j D₁' D₂' hD₁' hD₂'
    obtain ⟨hj_inst₁, hD₁_eq₀⟩ := List.getElem?_eq_some_iff.mp hD₁'
    obtain ⟨hj_inst₂, hD₂_eq₀⟩ := List.getElem?_eq_some_iff.mp hD₂'
    subst hD₁_eq₀; subst hD₂_eq₀
    have hj_lt₁ : j < ds₁.length := by rw [← length_instDomsT 0 x ds₁]; exact hj_inst₁
    have hj_lt₂ : j < ds₂.length := hlen₁₂ ▸ hj_lt₁
    rw [getElem_instDomsT 0 x ds₁ j hj_lt₁, getElem_instDomsT 0 y ds₂ j hj_lt₂, Nat.zero_add]
    have hget₁ : ds₁[j]? = some (ds₁[j]'hj_lt₁) := List.getElem?_eq_getElem hj_lt₁
    have hget₂ : ds₂[j]? = some (ds₂[j]'hj_lt₂) := List.getElem?_eq_getElem hj_lt₂
    obtain ⟨w₁, ⟨hty₁⟩⟩ := hrel.2.1 (j + 1) (ds₁[j]'hj_lt₁) (by simp [hget₁])
    obtain ⟨hc₁₂⟩ := hrel.2.2.2 (j + 1) (ds₁[j]'hj_lt₁) (ds₂[j]'hj_lt₂)
      (by simp [hget₁]) (by simp [hget₂])
    rw [policyPrefixContext_cons_succ] at hty₁ hc₁₂
    have hΓ_A₁ : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
    obtain ⟨hΓ_pref⟩ := ctxWfT_prefix hΓ_A₁ ds₁ j (Nat.le_of_lt hj_lt₁) (fun k hk => by
      have hk_lt : k < ds₁.length := Nat.lt_trans hk hj_lt₁
      have hgetk : ds₁[k]? = some (ds₁[k]'hk_lt) := List.getElem?_eq_getElem hk_lt
      obtain ⟨uk, ⟨htyk⟩⟩ := hrel.2.1 (k + 1) (ds₁[k]'hk_lt) (by simp [hgetk])
      rw [policyPrefixContext_cons_succ] at htyk
      exact ⟨uk, ⟨htyk⟩⟩)
    obtain ⟨w₂', htyD₂_in_₁⟩ := tyConvT_endTyped hW hΓ_pref hc₁₂ hty₁
    have hhole₁ := getElem?_policyPrefixContext_assumption ds₁ A₁ Γ j (Nat.le_of_lt hj_lt₁)
    have hsub₁ := substRemove_policyPrefixContext x Γ ds₁ A₁ j (Nat.le_of_lt hj_lt₁)
    have hlen_inst : (policyPrefixContext (instDomsT 0 x ds₁) j).length = j :=
      policyPrefixContext_length (instDomsT 0 x ds₁) j (by rw [length_instDomsT]; exact Nat.le_of_lt hj_lt₁)
    have hx_lift := hasTyTLiftPrefix hcl (policyPrefixContext (instDomsT 0 x ds₁) j) hx
    rw [hlen_inst, ← hsub₁] at hx_lift
    have hxy_lift := convTLiftPrefix hcl (policyPrefixContext (instDomsT 0 x ds₁) j) hxy
    rw [hlen_inst, ← hsub₁] at hxy_lift
    have hc_leg1 : TyConvT E n (policyPrefixContext (instDomsT 0 x ds₁) j ++ Γ)
        (instantiate j (lift 0 j x) (ds₁[j]'hj_lt₁))
        (instantiate j (lift 0 j x) (ds₂[j]'hj_lt₂)) := by
      have h0 := tyConvT_substS hcl hinst x A₁ hc₁₂ hhole₁ hx_lift
      rwa [hsub₁] at h0
    have hc_leg2 : ConvT E n (policyPrefixContext (instDomsT 0 x ds₁) j ++ Γ)
        (instantiate j (lift 0 j x) (ds₂[j]'hj_lt₂))
        (instantiate j (lift 0 j y) (ds₂[j]'hj_lt₂))
        (.sort w₂') := by
      have h0 := hasTyT_subst_convS hcl hinst x y A₁ htyD₂_in_₁ hhole₁ hx_lift hxy_lift
      rwa [hsub₁] at h0
    exact ⟨.trans _ _ _ _ hc_leg1 (.of _ _ _ w₂' hc_leg2)⟩

/-- **`PiRowField`-Free Symmetry of `ConvArgsT` Along `DomsRel` (`convArgs_symm_domsRel`):**
    By structural induction on `ds₁`, `ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs ys` and
    `DomsRel E n Γ ds₁ ds₂` yield `ConvArgsT E n Γ (policyPi ds₂ (.sort u₂)) ys xs` with **zero**
    `PiRowField` hypothesis! -/
theorem convArgs_symm_domsRel {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) (u₁ u₂ : Level) :
    {ds₁ ds₂ : List (Expr Nat)} → DomsRel E n Γ ds₁ ds₂ →
    {xs ys : List (Expr Nat)} →
    ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs ys →
    ConvArgsT E n Γ (policyPi ds₂ (.sort u₂)) ys xs
  | [], [], _, _, _, .nil _ => .nil (.sort u₂)
  | [], _ :: _, hrel, _, _, _ => by cases hrel.1
  | _ :: _, [], hrel, _, _, _ => by cases hrel.1
  | A₁ :: ds₁, A₂ :: ds₂, _, _, _, .nil _ => .nil (policyPi (A₂ :: ds₂) (.sort u₂))
  | A₁ :: ds₁, A₂ :: ds₂, hrel, _ :: xs, _ :: ys, .cons _ _ x y _ _ ⟨hxy⟩ hrest => by
      obtain ⟨_, _, ⟨hcA⟩⟩ := domsRel_head hrel
      have hyx_A₂ : ConvT E n Γ y x A₂ :=
        convT_of_tyConv (.symm _ x y A₁ hxy) hcA
      have hrel' : DomsRel E n Γ (instDomsT 0 x ds₁) (instDomsT 0 y ds₂) :=
        domsRel_step hW hΓ hrel hxy
      have hinst₁ : instantiate0 x (policyPi ds₁ (.sort u₁)) =
          policyPi (instDomsT 0 x ds₁) (.sort u₁) := by
        simp only [instantiate0, instantiate_policyPi, instantiate]
      have hinst₂ : instantiate0 y (policyPi ds₂ (.sort u₂)) =
          policyPi (instDomsT 0 y ds₂) (.sort u₂) := by
        simp only [instantiate0, instantiate_policyPi, instantiate]
      rw [hinst₁] at hrest
      have ih := convArgs_symm_domsRel hW hΓ u₁ u₂ hrel' hrest
      rw [← hinst₂] at ih
      exact .cons A₂ (policyPi ds₂ (.sort u₂)) y x ys xs ⟨hyx_A₂⟩ ih

/-- **`PiRowField`-Free Transitivity of `ConvArgsT` Along `DomsRel` (`convArgs_trans_domsRel`):**
    By structural induction on `ds₁`, `ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs ys`,
    `ConvArgsT E n Γ (policyPi ds₂ (.sort u₂)) ys zs`, and `DomsRel E n Γ ds₁ ds₂` yield
    `ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs zs` with **zero** `PiRowField` hypothesis! -/
theorem convArgs_trans_domsRel {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) (u₁ u₂ : Level) :
    {ds₁ ds₂ : List (Expr Nat)} → DomsRel E n Γ ds₁ ds₂ →
    {xs ys zs : List (Expr Nat)} →
    ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs ys →
    ConvArgsT E n Γ (policyPi ds₂ (.sort u₂)) ys zs →
    ConvArgsT E n Γ (policyPi ds₁ (.sort u₁)) xs zs
  | [], [], _, _, _, _, .nil _, .nil _ => .nil (.sort u₁)
  | [], _ :: _, hrel, _, _, _, _, _ => by cases hrel.1
  | _ :: _, [], hrel, _, _, _, _, _ => by cases hrel.1
  | A₁ :: ds₁, A₂ :: ds₂, _, _, _, _, .nil _, .nil _ => .nil (policyPi (A₁ :: ds₁) (.sort u₁))
  | A₁ :: ds₁, A₂ :: ds₂, hrel, _ :: xs, _ :: ys, _ :: zs,
      .cons _ _ x y _ _ ⟨hxy⟩ hrest₁, .cons _ _ _ z _ _ ⟨hyz⟩ hrest₂ => by
      obtain ⟨_, _, ⟨hcA⟩⟩ := domsRel_head hrel
      have hyz_A₁ : ConvT E n Γ y z A₁ :=
        convT_of_tyConv hyz hcA.symmT
      have hxz : ConvT E n Γ x z A₁ := .trans _ x y z A₁ hxy hyz_A₁
      have hrel' : DomsRel E n Γ (instDomsT 0 x ds₁) (instDomsT 0 y ds₂) :=
        domsRel_step hW hΓ hrel hxy
      have hinst₁ : instantiate0 x (policyPi ds₁ (.sort u₁)) =
          policyPi (instDomsT 0 x ds₁) (.sort u₁) := by
        simp only [instantiate0, instantiate_policyPi, instantiate]
      have hinst₂ : instantiate0 y (policyPi ds₂ (.sort u₂)) =
          policyPi (instDomsT 0 y ds₂) (.sort u₂) := by
        simp only [instantiate0, instantiate_policyPi, instantiate]
      rw [hinst₁] at hrest₁
      rw [hinst₂] at hrest₂
      have ih := convArgs_trans_domsRel hW hΓ u₁ u₂ hrel' hrest₁ hrest₂
      rw [← hinst₁] at ih
      exact .cons A₁ (policyPi ds₁ (.sort u₁)) x z xs zs ⟨hxz⟩ ih

/-- **`PiRowField`-Free Symmetry of `ConvArgsT` at `instantiateLevels ls m.mtype`
    (`convArgs_symm_instMtype_of_envWfT`):**
    Removes `hpi : PiRowField E n` (and `hlen`, `hlen'`) from `convArgs_symm_instMtype`! -/
theorem convArgs_symm_instMtype_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level}
    (hty : HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w))
    (hty' : HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w'))
    (heqN : eqNList ls ls')
    (hargs : ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs') :
    ConvArgsT E n Γ (instantiateLevels ls' m.mtype) xs' xs := by
  have hpi₁ := instMtype_policyPi_of_inductiveM hW hm hind ls
  have hpi₂ := instMtype_policyPi_of_inductiveM hW hm hind ls'
  rw [hpi₁] at hargs
  rw [hpi₂]
  exact convArgs_symm_domsRel hW hΓ
    (instLevel ls (inductiveSortLevel hW hm hind))
    (instLevel ls' (inductiveSortLevel hW hm hind))
    (domsRel_of_instMtype hW hΓ hm hty hty' heqN) hargs

/-- **`PiRowField`-Free Transitivity of `ConvArgsT` at `instantiateLevels ls₁ m.mtype`
    (`convArgs_trans_instMtype_of_envWfT`):**
    Removes `hpi : PiRowField E n` from `convArgs_trans_instMtype`! -/
theorem convArgs_trans_instMtype_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {r : Nat} {m : CheckedMember}
    (hm : E.members r = some m) (hind : m.mclass = .inductiveM)
    {ls₁ ls₂ : List Level} {xs₁ xs₂ xs₃ : List (Expr Nat)} {w₁ w₂ : Level}
    (hty₁ : HasTyT E n Γ (foldApps (.const r ls₁) xs₁) (.sort w₁))
    (hty₂ : HasTyT E n Γ (foldApps (.const r ls₂) xs₂) (.sort w₂))
    (heqN₁₂ : eqNList ls₁ ls₂)
    (hargs₁₂ : ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₂)
    (hargs₂₃ : ConvArgsT E n Γ (instantiateLevels ls₂ m.mtype) xs₂ xs₃) :
    ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₃ := by
  have hpi₁ := instMtype_policyPi_of_inductiveM hW hm hind ls₁
  have hpi₂ := instMtype_policyPi_of_inductiveM hW hm hind ls₂
  rw [hpi₁] at hargs₁₂ ⊢
  rw [hpi₂] at hargs₂₃
  exact convArgs_trans_domsRel hW hΓ
    (instLevel ls₁ (inductiveSortLevel hW hm hind))
    (instLevel ls₂ (inductiveSortLevel hW hm hind))
    (domsRel_of_instMtype hW hΓ hm hty₁ hty₂ heqN₁₂) hargs₁₂ hargs₂₃

/-- Named interface for `PiRowField`-free symmetry of `ConvArgsT` across level instantiations
    (matching `#7673`'s `ConvArgsSymmT E n`). -/
def FamConvArgsSymmT (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {r : Nat} {m : CheckedMember},
    E.members r = some m → m.mclass = .inductiveM →
    ∀ {ls ls' : List Level} {xs xs' : List (Expr Nat)} {w w' : Level},
      HasTyT E n Γ (foldApps (.const r ls) xs) (.sort w) →
      HasTyT E n Γ (foldApps (.const r ls') xs') (.sort w') →
      eqNList ls ls' →
      ConvArgsT E n Γ (instantiateLevels ls m.mtype) xs xs' →
      ConvArgsT E n Γ (instantiateLevels ls' m.mtype) xs' xs

/-- Named interface for `PiRowField`-free transitivity of `ConvArgsT` across level instantiations
    (matching `#7673`'s `ConvArgsTransT E n`). -/
def FamConvArgsTransT (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ → ∀ {r : Nat} {m : CheckedMember},
    E.members r = some m → m.mclass = .inductiveM →
    ∀ {ls₁ ls₂ : List Level} {xs₁ xs₂ xs₃ : List (Expr Nat)} {w₁ w₂ : Level},
      HasTyT E n Γ (foldApps (.const r ls₁) xs₁) (.sort w₁) →
      HasTyT E n Γ (foldApps (.const r ls₂) xs₂) (.sort w₂) →
      eqNList ls₁ ls₂ →
      ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₂ →
      ConvArgsT E n Γ (instantiateLevels ls₂ m.mtype) xs₂ xs₃ →
      ConvArgsT E n Γ (instantiateLevels ls₁ m.mtype) xs₁ xs₃

/-- Unconditional discharge of `FamConvArgsSymmT E n` from `EnvWfT E` alone. -/
theorem famConvArgsSymmT_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) :
    FamConvArgsSymmT E n := by
  intro Γ hΓ r m hm hind ls ls' xs xs' w w' hty hty' heqN hargs
  exact convArgs_symm_instMtype_of_envWfT hW hΓ hm hind hty hty' heqN hargs

/-- Unconditional discharge of `FamConvArgsTransT E n` from `EnvWfT E` alone. -/
theorem famConvArgsTransT_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) :
    FamConvArgsTransT E n := by
  intro Γ hΓ r m hm hind ls₁ ls₂ xs₁ xs₂ xs₃ w₁ w₂ hty₁ hty₂ heqN₁₂ hargs₁₂ hargs₂₃
  exact convArgs_trans_instMtype_of_envWfT hW hΓ hm hind hty₁ hty₂ heqN₁₂ hargs₁₂ hargs₂₃

/-- **`PiRowField`-Free Symmetry of `LRTypeFamIN` (`lrTypeFamIN_symm_of_envWfT`):**
    Holds at every `EnvWfT E` with **zero** `PiRowField E n` hypothesis! -/
theorem lrTypeFamIN_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamIN E n Γ A A' c) :
    LRTypeFamIN E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamIN_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype_of_envWfT hW hΓ hm hind hty hty' heqN hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot h' h hn' hn hc.symmT

/-- **`PiRowField`-Free Transitivity of `LRTypeFamIN` (`lrTypeFamIN_trans_envWfT`):**
    Holds at every `EnvWfT E` with **zero** `PiRowField E n` hypothesis! -/
theorem lrTypeFamIN_trans_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamIN E n Γ A B c) :
    ∀ {C : Expr Nat}, LRTypeFamIN E n Γ B C c → LRTypeFamIN E n Γ A C c := by
  have hcl := envClosed_of_envWfT hW
  induction h₁ with
  | bot => intro C _; exact .bot _ _ _
  | sort h _ =>
      intro C h₂
      cases h₂ with
      | sort _ hC => exact .sort h hC
  | @pi Γ A B A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      intro C h₂
      cases h₂ with
      | pi hB hC _ hdom' hcod' ra' rf' =>
          have e := whRedCtx_normal_unique (whDetCtx_of_envWfT hW Γ)
            h' (whNormalCtx_pi _ _) hB (whNormalCtx_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi h hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom hdom')
                (.trans _ _ _ _ hcod (tyConvT_assump_dom hW hΓ₀ hdom hcod'))
                (iha hΓ₀ ra')
                (fun s hs => ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)
                  (lrTypeFamIN_assump_dom hcl hW hΓ₀ hdom hA₁ (rf' s hs)))
  | @famSpine Γ A B r m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ args hm₁ hind₁ h₁ h₁' hty₁ hty₂ hc₁ heqN₁ hlen₁ _ hargs₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ _ hB hC _ hty₃ hc₂ heqN₂ _ hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          have e := whRedCtx_normal_unique (whDetCtx_of_envWfT hW Γ)
            h₁' (whNormalCtx_famApp hW hm₁ hind₁ ls₂ xs₂)
            hB (whNormalCtx_famApp hW hm₁ hind₁ _ _)
          obtain ⟨hconst, hxs⟩ := foldApps_const_inj e
          injection hconst with _ hls
          subst hls; subst hxs
          exact .famSpine hm₁ hind₁ h₁ hC hty₁ hty₃
            (.trans _ _ _ _ hc₁ hc₂)
            (eqNList_trans heqN₁ heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype_of_envWfT hW hΓ hm₁ hind₁ hty₁ hty₂ heqN₁ hargs₁ hargs₂)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | @otherSpine Γ A B X X' r args hnot₁ h₁ h₁' hn₁ hn₁' hc₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ _ _ _ _ _ _ _ _ _ =>
          exact (hnot₁ _ hm₂ hind₂).elim
      | otherSpine _ hB hC hY hY' hc₂ =>
          have e := whRedCtx_normal_unique (whDetCtx_of_envWfT hW Γ) h₁' hn₁' hB hY
          subst e
          exact .otherSpine hnot₁ h₁ hC hn₁ hY' (.trans _ _ _ _ hc₁ hc₂)

/-- **`PiRowField`-Free Symmetry of `LRTypeFamINBiDI` (`lrTypeFamINBiDI_symm_of_envWfT`):** -/
theorem lrTypeFamINBiDI_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (h : LRTypeFamINBiDI E n Γ A A') :
    LRTypeFamINBiDI E n Γ A' A :=
  fun c hc happrox => lrTypeFamIN_symm_of_envWfT hW hΓ (h c hc happrox.symm)

/-- **`PiRowField`-Free Transitivity of `LRTypeFamINBiDI` (`lrTypeFamINBiDI_trans_of_envWfT`):** -/
theorem lrTypeFamINBiDI_trans_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat}
    (h₁ : LRTypeFamINBiDI E n Γ A B) (h₂ : LRTypeFamINBiDI E n Γ B C) :
    LRTypeFamINBiDI E n Γ A C := by
  intro c hc happrox
  rcases happrox with hA | hC
  · have r₁ := h₁ c hc (Or.inl hA)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt hW hc r₁).2
    exact lrTypeFamIN_trans_envWfT hW hΓ r₁ (h₂ c hc (Or.inl hB))
  · have r₂ := h₂ c hc (Or.inr hC)
    have hB := (approxDI_ctxEnvDI_of_lrTypeFamIN_botFamCpt hW hc r₂).1
    exact lrTypeFamIN_trans_envWfT hW hΓ (h₁ c hc (Or.inr hB)) r₂

/-- **`PiRowField`-Free Symmetry of `LRTypeFamINR` (`lrTypeFamINR_symm_of_envWfT`):** -/
theorem lrTypeFamINR_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat} {c : CptI}
    (h : LRTypeFamINR E n Γ A A' c) :
    LRTypeFamINR E n Γ A' A c := by
  have hcl := envClosed_of_envWfT hW
  induction h with
  | bot => exact .bot _ _ _
  | sort h h' => exact .sort h' h
  | @pi Γ A A' A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      cases hΓ₁ with
      | assumption _ _ u hΓ₀ hA₁ =>
          obtain ⟨v, hA₂⟩ := tyConvT_endTyped hW hΓ₀ hdom hA₁
          have hΓ₂ : CtxWfT E n (.assumption A₂ :: Γ) := .assumption Γ A₂ v hΓ₀ hA₂
          exact .pi h' h hΓ₂ hdom.symmT (tyConvT_assump_dom hW hΓ₀ hdom.symmT hcod.symmT)
            (iha hΓ₀)
            (fun s hs => lrTypeFamINR_assump_dom hcl hW hΓ₀ hdom.symmT hA₂
              (ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)))
  | famSpine hm hind h h' hty hty' hc heqN hlen hlen' hargs =>
      exact .famSpine hm hind h' h hty' hty hc.symmT (eqNList_symm heqN) hlen' hlen
        (convArgs_symm_instMtype_of_envWfT hW hΓ hm hind hty hty' heqN hargs)
  | otherSpine hnot h h' hn hn' hc =>
      exact .otherSpine hnot h' h hn' hn hc.symmT

/-- **`PiRowField`-Free Transitivity of `LRTypeFamINR` (`lrTypeFamINR_trans_envWfT`):** -/
theorem lrTypeFamINR_trans_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {c : CptI}
    (h₁ : LRTypeFamINR E n Γ A B c) :
    ∀ {C : Expr Nat}, LRTypeFamINR E n Γ B C c → LRTypeFamINR E n Γ A C c := by
  have hcl := envClosed_of_envWfT hW
  induction h₁ with
  | bot => intro C _; exact .bot _ _ _
  | sort h _ =>
      intro C h₂
      cases h₂ with
      | sort _ hC => exact .sort h hC
  | @pi Γ A B A₁ B₁ A₂ B₂ a f h h' hΓ₁ hdom hcod _ _ iha ihf =>
      intro C h₂
      cases h₂ with
      | pi hB hC _ hdom' hcod' ra' rf' =>
          have e := whRedRecCtx_normal_unique_of_envWfT hW
            h' (whNormalRecCtx_pi _ _) hB (whNormalRecCtx_pi _ _)
          injection e with eA eB
          subst eA; subst eB
          cases hΓ₁ with
          | assumption _ _ u hΓ₀ hA₁ =>
              exact .pi h hC (.assumption Γ A₁ u hΓ₀ hA₁)
                (.trans _ _ _ _ hdom hdom')
                (.trans _ _ _ _ hcod (tyConvT_assump_dom hW hΓ₀ hdom hcod'))
                (iha hΓ₀ ra')
                (fun s hs => ihf s hs (.assumption Γ A₁ u hΓ₀ hA₁)
                  (lrTypeFamINR_assump_dom hcl hW hΓ₀ hdom hA₁ (rf' s hs)))
  | @famSpine Γ A B r m₁ ls₁ ls₂ xs₁ xs₂ w₁ w₂ args hm₁ hind₁ h₁ h₁' hty₁ hty₂ hc₁ heqN₁ hlen₁ _ hargs₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ _ hB hC _ hty₃ hc₂ heqN₂ _ hlen₃ hargs₂ =>
          rw [hm₁] at hm₂
          injection hm₂ with hm_eq
          subst hm_eq
          have e := whRedRecCtx_normal_unique_of_envWfT hW
            h₁' (whNormalRecCtx_famApp hW hm₁ hind₁ ls₂ xs₂)
            hB (whNormalRecCtx_famApp hW hm₁ hind₁ _ _)
          obtain ⟨hconst, hxs⟩ := foldApps_const_inj e
          injection hconst with _ hls
          subst hls; subst hxs
          exact .famSpine hm₁ hind₁ h₁ hC hty₁ hty₃
            (.trans _ _ _ _ hc₁ hc₂)
            (eqNList_trans heqN₁ heqN₂)
            hlen₁ hlen₃
            (convArgs_trans_instMtype_of_envWfT hW hΓ hm₁ hind₁ hty₁ hty₂ heqN₁ hargs₁ hargs₂)
      | otherSpine hnot _ _ _ _ _ =>
          exact (hnot m₁ hm₁ hind₁).elim
  | @otherSpine Γ A B X X' r args hnot₁ h₁ h₁' hn₁ hn₁' hc₁ =>
      intro C h₂
      cases h₂ with
      | famSpine hm₂ hind₂ _ _ _ _ _ _ _ _ _ =>
          exact (hnot₁ _ hm₂ hind₂).elim
      | otherSpine _ hB hC hY hY' hc₂ =>
          have e := whRedRecCtx_normal_unique_of_envWfT hW h₁' hn₁' hB hY
          subst e
          exact .otherSpine hnot₁ h₁ hC hn₁ hY' (.trans _ _ _ _ hc₁ hc₂)

/-- **`PiRowField`-Free Symmetry of `LRTypeFamINBiR` (`lrTypeFamINBiR_symm_of_envWfT`):** -/
theorem lrTypeFamINBiR_symm_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (h : LRTypeFamINBiR E n Γ A A') :
    LRTypeFamINBiR E n Γ A' A :=
  fun c hc happrox => lrTypeFamINR_symm_of_envWfT hW hΓ (h c hc happrox.symm)

/-- **`PiRowField`-Free Transitivity of `LRTypeFamINBiR` (`lrTypeFamINBiR_trans_of_envWfT`):** -/
theorem lrTypeFamINBiR_trans_of_envWfT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B C : Expr Nat}
    (h₁ : LRTypeFamINBiR E n Γ A B) (h₂ : LRTypeFamINBiR E n Γ B C) :
