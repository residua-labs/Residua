theorem whRedRecKCanon_const_opaque_iff_of_whRedRecKCanon {E : ResolvedEnv} {Γ : LCtx}
    (hW : EnvWfT E) {M M' : Expr Nat} (hred : WhRedRecKCanon E Γ M M')
