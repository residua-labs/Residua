        (instantiate j (lift 0 j sub') (.bvar i)) T c := by
  intro c hmem
  have hne : i ≠ j := Nat.ne_of_lt hij
  have hng : ¬ j < i := Nat.not_lt.mpr (Nat.le_of_lt hij)
  have hL : instantiate j (lift 0 j sub) (.bvar i) = .bvar i := by
    simp only [instantiate, hne, hng, if_false]
  have hR : instantiate j (lift 0 j sub') (.bvar i) = .bvar i := by
    simp only [instantiate, hne, hng, if_false]
  rw [hL, hR]
  rw [hL] at hmem
  exact hdiag c hmem

