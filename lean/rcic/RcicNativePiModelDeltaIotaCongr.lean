/-- **Direct `PiRowField E n` Extraction from `FundamentalTermNoPiSemBiProbe` Across ALL Contexts
    `Γ : LCtx` Requiring Zero `PropTyTransport`, Zero `SortRow`, and Zero Syntactic Sort-Reduction
    on Types (`piRow_of_fundamentalTermNoPiSemBiProbe`):** -/
theorem piRow_of_fundamentalTermNoPiSemBiProbe {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hF : FundamentalTermNoPiSemBiProbe E n) : PiRowField E n := by
  intro Γ hΓ A₁ B₁ A₂ B₂ h
  have hwalk : ∀ {X Y : Expr Nat} {u : Level},
      HasTyT E n Γ X (.sort u) → TyConvT E n Γ X Y →
      ApproxDIK E (ctxEnvDIK E Γ) X (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ X Y (.pi .bot []) := by
    intro X Y u hX htc
    revert u
    induction htc with
    | refl X =>
        intro u hX hAc
        rcases hF.1 hΓ hX (.pi .bot []) .piBotNil (Or.inl hAc) with hPs | hC
        · exact (not_isSemPropTyI_sort E n Γ u hPs).elim
        · exact hC.2
    | of X Y v hc =>
        intro _ _ hAc
        rcases hF.2 hΓ (convEnds hW hΓ hc).1 (convEnds hW hΓ hc).2.1 hc
            (.pi .bot []) .piBotNil (Or.inl hAc) with hPs | hC
        · exact (not_isSemPropTyI_sort E n Γ v hPs).elim
        · exact hC.2
    | trans X M Y c₁ c₂ ih₁ ih₂ =>
        intro u hX hAc
        obtain ⟨v, hM⟩ := tyConvT_endTyped hW hΓ c₁ hX
        have r₁ := ih₁ hX hAc
        have hcM := (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW botPiCpt_pi_bot_nil r₁).2
        exact lrTypeINPiKClosedCtx_trans_of_envWfT hW r₁ (ih₂ hM hcM)
  rcases tyConvT_firstOf_data h with heq | ⟨_, u, hc₀, _⟩
  · injection heq with eA eB
    subst eA; subst eB
    exact ⟨⟨.refl _ _⟩, ⟨.refl _ _⟩⟩
  · have hpi : HasTyT E n Γ (.pi A₁ B₁) (.sort u) := (convEnds hW hΓ hc₀).1
    have hlr := hwalk hpi h (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A₁ B₁)
    cases hlr with
    | pi hA hB _ hdom hcod _ _ =>
        have e₁ := whRedPiKClosedCtx_pi_eq hA
