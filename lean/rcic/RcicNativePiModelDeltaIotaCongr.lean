  have hb₂_let₁ : LRTermDSubKClosedCtxBi E n (.letBinding A₁ (.lam D₁ (.sort l₁)) :: Γ) b₂ b₂ B :=
    lrTermDSubKClosedCtxBi_trans hW (lrTermDSubKClosedCtxBi_symm hW hb_let₁) hb_let₁
  exact lrTermDSubKClosedCtxBi_app_lam_of_letValCongr hW hSort hΓ hf hg hv₁ hb_let₁
    (lrTermDSubKClosedCtxBi_subst0_lam_sort_arg_all
      hW hSort hΓ hA₁ hv₁ hv₂ hcv hb₂_let₁ hb₂_wf2
      (lrTermDSubKClosedCtxBi_inst0_right_diag_of_let_diags
        hW hSort hΓ hA₁ hv₁ hv₂ hcv
        (prunedSemEqDIK_lam_sorts E (ctxEnvDIK E Γ) D₁ D₂ l₁ l₂)
        hb₂_let₁ hb₂_let₂))

/-- **Unconditional Two-Sided $\lambda$-Application Congruence for Convertible $\lambda$-Abstractions
    Over $\Pi$-Types (`.lam D₁ (.pi P₁ Q₁)` and `.lam D₂ (.pi P₂ Q₂)`) Across ALL 3 Probes
    (`lrTermDSubKClosedCtxBi_app_lam_lam_pi_arg_all`):** -/
theorem lrTermDSubKClosedCtxBi_app_lam_lam_pi_arg_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
