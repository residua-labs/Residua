/-- **Unconditional `.bot`-Collapse of Non-K Recursor Eliminations at Non-Constructor Majors in
    `ApproxDIK` (`approxDIK_recursor_elim_no_ctor_nonK_eq_bot`):**
    For any recursor `w : IotaWitnessS E` that is NOT a single-constructor `Prop` recursor
    (`¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)`), any pre-major list `pre` of
    length `w.preMajor.length`, and any major `x` with no `.spine w'.ctorRef args` compact in
    `ApproxDIK E ρ` for any `w'` with `w'.recRef = w.recRef`, the ONLY compact of
    `recCall (.const w.recRef ls) pre x` in `ApproxDIK E ρ` is `c = .bot`! -/
theorem approxDIK_recursor_elim_no_ctor_nonK_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (w : IotaWitnessS E)
    (hnk : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (ls : List Level) {pre : List (Expr Nat)}
    (hpre : pre.length = w.preMajor.length) {x : Expr Nat}
    (hno : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef → ∀ args, ¬ ApproxDIK E ρ x (.spine w'.ctorRef args))
    {c : CptI}
    (h : ApproxDIK E ρ (recCall (.const w.recRef ls) pre x) c) :
    c = .bot := by
  unfold recCall at h
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
    rfl |
    ⟨w', us_pre, us_fields, c₀, hrecEq, hpreLen, _, _, rfl⟩ |
    ⟨w', us_pre, u_maj, c₀, hrecEq, hk', _, _, _, rfl⟩
  · exact foldAppCptK_bot_inv hfold
  · have hpreLenEq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrecEq).2.1
    have htotLen : (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length =
        (pre ++ [x]).length := by
      simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
    rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
    · rfl
    · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
        (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
      have hlenPre : us_pre.length = us_pre'.length := by
        rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
      obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
      cases hmajArgs with
      | cons hmaj _ =>
          cases hmajEq
          have hsp := hmaj
            (.spine w'.ctorRef (List.replicate w'.nparams .bot ++ List.replicate us_fields.length .bot))
            (List.mem_cons_self _ _)
          exact (hno w' hrecEq _ hsp).elim
  · obtain ⟨_, _, _, _, _, hfamEq, hnminEq, _, _⟩ := iotaWitnessS_same_recRef w' w hrecEq
    rw [hfamEq, hnminEq] at hk'
    exact (hnk hk').elim

/-- **Unconditional `.bot`-Collapse of Applied Non-K Recursor Spines at Non-Constructor Majors in
    `ApproxDIK` (`approxDIK_recursor_foldApps_no_ctor_nonK_eq_bot`):**
    For any non-K recursor `w : IotaWitnessS E`, any `pre` with `pre.length = w.preMajor.length`,
    any non-constructor major `x`, and **any** trailing arguments `rest : List (Expr Nat)`, the
    ONLY compact `c : CptI` of `foldApps (.const w.recRef ls) (pre ++ x :: rest)` in `ApproxDIK E ρ`
    is `c = .bot`! -/
theorem approxDIK_recursor_foldApps_no_ctor_nonK_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (w : IotaWitnessS E)
    (hnk : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (ls : List Level) {pre : List (Expr Nat)}
    (hpre : pre.length = w.preMajor.length) {x : Expr Nat}
    (hno : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef → ∀ args, ¬ ApproxDIK E ρ x (.spine w'.ctorRef args))
    (rest : List (Expr Nat)) {c : CptI}
    (h : ApproxDIK E ρ (foldApps (.const w.recRef ls) (pre ++ x :: rest)) c) :
    c = .bot := by
  have heq : foldApps (.const w.recRef ls) (pre ++ x :: rest) =
      foldApps (recCall (.const w.recRef ls) pre x) rest := by
    rw [recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
  rw [heq] at h
  exact approxDIK_foldApps_eq_bot_of_eq_bot
    (fun _ hd => approxDIK_recursor_elim_no_ctor_nonK_eq_bot w hnk ls hpre hno hd) rest h

