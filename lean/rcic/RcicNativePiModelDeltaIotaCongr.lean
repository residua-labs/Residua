  unfold instantiate0
  simp only [instantiate, ↓reduceIte]
  rw [instantiate_lift_cancel 1 0 0 f (Nat.le_refl 0) Nat.zero_lt_one a, lift_zero]

/-- Instantiating `.bvar 0` by `a` in `.app (lift 0 1 f) (.bvar 0)` yields `.app f a`. -/
theorem instantiate0_app_lift0_bvar0_arg (f a : Expr Nat) :
