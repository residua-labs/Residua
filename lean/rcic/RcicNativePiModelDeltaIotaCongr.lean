private theorem list_eq_nil_or_snoc_maj {α : Type _} :
    ∀ (xs : List α), xs = [] ∨ ∃ pre x, xs = pre ++ [x]
  | [] => Or.inl rfl
  | x :: xs => by
      rcases list_eq_nil_or_snoc_maj xs with rfl | ⟨pre, y, rfl⟩
      · exact Or.inr ⟨[], x, rfl⟩
      · exact Or.inr ⟨x :: pre, y, rfl⟩

/-- No rigid-constant spine `foldApps (.const r ls) args` (`RigidConst E r`) steps under
    `WhStepPiKClosedCtxMaj E Γ` at any `EnvWfT E`
    (`whStepPiKClosedCtxMaj_foldApps_rigidConst_false`). -/
theorem whStepPiKClosedCtxMaj_foldApps_rigidConst_false {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls : List Level} (hrigid : RigidConst E r)
    (args : List (Expr Nat)) {e : Expr Nat}
    (h : WhStepPiKClosedCtxMaj E Γ (foldApps (.const r ls) args) e) : False := by
  have key : ∀ {f e : Expr Nat},
      WhStepPiKClosedCtxMaj E Γ f e → (appsSpine f).1 = .const r ls → False := by
    intro f e hs
    induction hs with
    | of_whStep hs₀ =>
        intro hsp
        have key₀ : ∀ {f₀ e₀ : Expr Nat},
            WhStep E f₀ e₀ → (appsSpine f₀).1 = .const r ls → False := by
          intro f₀ e₀ hs'
          induction hs' with
          | beta _ _ _ => intro hsp'; simp [appsSpine] at hsp'
          | zeta _ _ _ => intro hsp'; simp [appsSpine] at hsp'
          | delta hres hbody =>
              intro hsp'
              simp only [appsSpine, Expr.const.injEq] at hsp'
              obtain ⟨rfl, _⟩ := hsp'
              rw [rigidConst_body_none_of_envWfT hW hrigid hres] at hbody
              exact Option.noConfusion hbody
          | iota hI =>
              intro hsp'
              obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
              cases hT with
              | of w =>
                  unfold iotaLhsOfS recCall at hsp'
                  rw [appsSpine_foldApps_const] at hsp'
                  injection hsp' with hrec _
                  subst hrec
                  exact not_rigidConst_of_recursor w hrigid
          | lit _ => intro hsp'; simp [appsSpine] at hsp'
          | appHead _ ih₀ =>
              intro hsp'
              simp only [appsSpine] at hsp'
              exact ih₀ hsp'
        exact key₀ hs₀ hsp
    | zetaLocal _ =>
        intro hsp; simp [appsSpine] at hsp
    | iotaS w _ _ _ _ _ _ _ _ =>
        intro hsp
        unfold recCall at hsp
        rw [appsSpine_foldApps_const] at hsp
        injection hsp with hrec _
        subst hrec
        exact not_rigidConst_of_recursor w hrigid
    | iotaKClosedCtx w _ _ _ _ _ _ =>
        intro hsp
        unfold recCall at hsp
        rw [appsSpine_foldApps_const] at hsp
        injection hsp with hrec _
        subst hrec
        exact not_rigidConst_of_recursor w hrigid
    | recMajor w _ _ _ _ _ _ _ =>
        intro hsp
        unfold recCall at hsp
        rw [appsSpine_foldApps_const] at hsp
        injection hsp with hrec _
        subst hrec
        exact not_rigidConst_of_recursor w hrigid
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
  have hsp₀ : (appsSpine (foldApps (.const r ls) args)).1 = .const r ls := by
    rw [appsSpine_foldApps_const]
  exact key h hsp₀

/-- No partial recursor application `foldApps (.const w.recRef ls) xs` with
    `xs.length ≤ w.preMajor.length` steps under `WhStepPiKClosedCtxMaj E Γ` at any `EnvWfT E`
    (`not_whStepPiKClosedCtxMaj_recursor_prefix`). -/
theorem not_whStepPiKClosedCtxMaj_recursor_prefix {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level) (xs : List (Expr Nat))
    (hlen : xs.length ≤ w.preMajor.length) {e : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E Γ (foldApps (.const w.recRef ls) xs) e) : False := by
  have key : ∀ {f e : Expr Nat} (ys : List (Expr Nat)),
      WhStepPiKClosedCtxMaj E Γ f e → f = foldApps (.const w.recRef ls) ys →
      ys.length ≤ w.preMajor.length → False := by
    intro f e ys hstep
    induction hstep generalizing ys with
    | of_whStep hs₀ =>
        intro hf hlen'
        subst hf
        exact not_whStep_recursor_prefix hW w ls ys hlen' hs₀
    | zetaLocal _ =>
        intro hf _
        have hsp := congrArg appsSpine hf
        rw [appsSpine_foldApps_const] at hsp
        exact Expr.noConfusion (congrArg Prod.fst hsp)
    | iotaS w' ls' lsC' pre' params' fields' hpre' _ _ =>
        intro hf hlen'
        have hsp := congrArg appsSpine hf
        unfold recCall at hsp
        rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
        injection hsp with hhead hargs
        injection hhead with hrec _
        have hpreLen := (iotaWitnessS_preMajor_length_eq w w' hrec.symm).2
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton, hpre'] at hlenEq
        omega
    | iotaKClosedCtx w' ls' pre' x' _ hpre' _ =>
        intro hf hlen'
        have hsp := congrArg appsSpine hf
        unfold recCall at hsp
        rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
        injection hsp with hhead hargs
        injection hhead with hrec _
        have hpreLen := (iotaWitnessS_preMajor_length_eq w w' hrec.symm).2
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton, hpre'] at hlenEq
        omega
    | recMajor w' ls' pre' x' _ hpre' _ _ =>
        intro hf hlen'
        have hsp := congrArg appsSpine hf
        unfold recCall at hsp
        rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
        injection hsp with hhead hargs
        injection hhead with hrec _
        have hpreLen := (iotaWitnessS_preMajor_length_eq w w' hrec.symm).2
        have hlenEq := congrArg List.length hargs
        simp only [List.length_append, List.length_singleton, hpre'] at hlenEq
        omega
    | @appHead f₀ f₀' a _ ih =>
        intro hf hlen'
        rcases list_eq_nil_or_snoc_maj ys with rfl | ⟨pre, y, rfl⟩
        · exact Expr.noConfusion hf
        · rw [foldApps_snoc] at hf
          injection hf with hf₀ _
          simp only [List.length_append, List.length_singleton] at hlen'
          exact ih pre hf₀ (by omega)
  exact key xs hs rfl hlen

/-- Uniqueness of the `iotaS` contractum from the redex expression alone (`iotaS_det`). -/
theorem iotaS_det {E : ResolvedEnv} (w₁ w₂ : IotaWitnessS E)
    (ls₁ lsC₁ ls₂ lsC₂ : List Level)
    (pre₁ params₁ fields₁ pre₂ params₂ fields₂ : List (Expr Nat))
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpar₁ : params₁.length = w₁.nparams)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    (hpar₂ : params₂.length = w₂.nparams)
    (heq : recCall (.const w₁.recRef ls₁) pre₁
        (foldApps (.const w₁.ctorRef lsC₁) (params₁ ++ fields₁)) =
      recCall (.const w₂.recRef ls₂) pre₂
        (foldApps (.const w₂.ctorRef lsC₂) (params₂ ++ fields₂))) :
    instPrefix (pre₁ ++ fields₁) (instantiateLevels ls₁ w₁.schema) =
      instPrefix (pre₂ ++ fields₂) (instantiateLevels ls₂ w₂.schema) := by
  have hsp := congrArg appsSpine heq
  unfold recCall at hsp
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
  injection hsp with hhead hargs
  injection hhead with hrec hls
  have hpreLenEq : pre₁.length = pre₂.length := by
    rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
  obtain ⟨hpreEq, hmajEq⟩ := List.append_inj hargs hpreLenEq
  injection hmajEq with hctorAppEq
  have hspC := congrArg appsSpine hctorAppEq
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hspC
  injection hspC with hheadC hargsC
  injection hheadC with hctor _
  obtain ⟨hparEq, _, _, _, _, _, _, hschemaEq⟩ :=
    iotaWitnessS_same_branch w₁ w₂ hrec hctor
  have hparLenEq : params₁.length = params₂.length := by
    rw [hpar₁, hpar₂, hparEq]
  obtain ⟨_, hfldsEq⟩ := List.append_inj hargsC hparLenEq
  rw [hpreEq, hfldsEq, hls, hschemaEq]

/-- Uniqueness of the `iotaKClosedCtx` contractum in `WhStepPiKClosedCtxMaj` (`iotaKClosedCtxMaj_det`). -/
theorem iotaKClosedCtxMaj_det {E : ResolvedEnv} (w₁ w₂ : IotaWitnessS E)
    (ls₁ ls₂ : List Level) (pre₁ pre₂ : List (Expr Nat)) (x₁ x₂ : Expr Nat)
    (hk₁ : piBody w₁.famMember.mtype = .sort .zero ∧ w₁.nMinors = 1)
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    (heq : recCall (.const w₁.recRef ls₁) pre₁ x₁ = recCall (.const w₂.recRef ls₂) pre₂ x₂) :
    instPrefix (pre₁ ++ List.replicate w₁.fields.length botClosedExpr)
        (instantiateLevels ls₁ w₁.schema) =
      instPrefix (pre₂ ++ List.replicate w₂.fields.length botClosedExpr)
        (instantiateLevels ls₂ w₂.schema) := by
  have hsp := congrArg appsSpine heq
  unfold recCall at hsp
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
  injection hsp with hhead hargs
  injection hhead with hrec hls
  obtain ⟨_, _, _, hfldsLenEq, _, hschemaEq⟩ :=
    iotaWitnessS_unique_of_nMinors_one w₁ w₂ hrec hk₁.2
  have hpreLenEq : pre₁.length = pre₂.length := by
    rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
  obtain ⟨hpreEq, _⟩ := List.append_inj hargs hpreLenEq
  rw [hpreEq, hfldsLenEq, hls, hschemaEq]

/-- Mutual exclusion between `iotaS` and `iotaKClosedCtx` in `WhStepPiKClosedCtxMaj`
    (`not_iotaS_and_iotaKClosedCtxMaj`). -/
theorem not_iotaS_and_iotaKClosedCtxMaj {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ lsC₁ ls₂ : List Level)
    (pre₁ params₁ fields₁ pre₂ : List (Expr Nat)) (x₂ : Expr Nat)
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpar₁ : params₁.length = w₁.nparams)
    (hflds₁ : fields₁.length = w₁.fields.length)
    (hk₂ : piBody w₂.famMember.mtype = .sort .zero ∧ w₂.nMinors = 1)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    (hx₂ : ¬ ApproxDIK E (ctxEnvDIK E Γ) x₂ (ctorTagCpt w₂))
    (heq : recCall (.const w₁.recRef ls₁) pre₁
        (foldApps (.const w₁.ctorRef lsC₁) (params₁ ++ fields₁)) =
      recCall (.const w₂.recRef ls₂) pre₂ x₂) : False := by
  have hsp := congrArg appsSpine heq
  unfold recCall at hsp
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
  injection hsp with hhead hargs
  injection hhead with hrec _
  obtain ⟨_, hctorEq, _, hfldsLenEq, _, _⟩ :=
    iotaWitnessS_unique_of_nMinors_one w₂ w₁ hrec.symm hk₂.2
  obtain ⟨hparEq, _⟩ := iotaWitnessS_same_branch w₁ w₂ hrec hctorEq.symm
  have hpreLenEq : pre₁.length = pre₂.length := by
    rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
  obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
  injection hmajEq with hxEq
  have htagEq : ctorTagCpt w₁ = ctorTagCpt w₂ := by
    unfold ctorTagCpt
    rw [hctorEq.symm, hparEq, ← hfldsLenEq]
  rw [← hxEq, ← htagEq] at hx₂
  exact hx₂ (approxDIK_ctorTagCpt_of_ctor_spine hW w₁ lsC₁
    (by rw [List.length_append, hpar₁, hflds₁]) (ctxEnvDIK E Γ))

/-- Mutual exclusion between `iotaS` and `recMajor` in `WhStepPiKClosedCtxMaj`
    (`not_iotaS_and_recMajor`). -/
theorem not_iotaS_and_recMajor {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ lsC₁ ls₂ : List Level)
    (pre₁ params₁ fields₁ pre₂ : List (Expr Nat)) (x₂ x₂' : Expr Nat)
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    (hs₂ : WhStepPiKClosedCtxMaj E Γ x₂ x₂')
    (heq : recCall (.const w₁.recRef ls₁) pre₁
        (foldApps (.const w₁.ctorRef lsC₁) (params₁ ++ fields₁)) =
      recCall (.const w₂.recRef ls₂) pre₂ x₂) : False := by
  have hsp := congrArg appsSpine heq
  unfold recCall at hsp
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
  injection hsp with hhead hargs
  injection hhead with hrec _
  have hpreLenEq : pre₁.length = pre₂.length := by
    rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
  obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
  injection hmajEq with hxEq
  subst hxEq
  have hrigid : RigidConst E w₁.ctorRef :=
    rigidConst_of_ctor w₁.hctor w₁.hctorK
  exact whStepPiKClosedCtxMaj_foldApps_rigidConst_false hW hrigid (params₁ ++ fields₁) hs₂

/-- Mutual exclusion between `iotaKClosedCtx` and `recMajor` in `WhStepPiKClosedCtxMaj`
    (`not_iotaKClosedCtxMaj_and_recMajor`). -/
theorem not_iotaKClosedCtxMaj_and_recMajor {E : ResolvedEnv} {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level) (pre₁ pre₂ : List (Expr Nat))
    (x₁ x₂ : Expr Nat)
    (hk₁ : piBody w₁.famMember.mtype = .sort .zero ∧ w₁.nMinors = 1)
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hx₁ : ¬ ApproxDIK E (ctxEnvDIK E Γ) x₁ (ctorTagCpt w₁))
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    (hx₂ : ApproxDIK E (ctxEnvDIK E Γ) x₂ (ctorTagCpt w₂))
    (heq : recCall (.const w₁.recRef ls₁) pre₁ x₁ = recCall (.const w₂.recRef ls₂) pre₂ x₂) :
    False := by
  have hsp := congrArg appsSpine heq
  unfold recCall at hsp
  rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
  injection hsp with hhead hargs
  injection hhead with hrec _
  obtain ⟨_, hctorEq, _, hfldsLenEq, _, _⟩ :=
    iotaWitnessS_unique_of_nMinors_one w₁ w₂ hrec hk₁.2
  obtain ⟨hparEq, _⟩ := iotaWitnessS_same_branch w₁ w₂ hrec hctorEq
  have hpreLenEq : pre₁.length = pre₂.length := by
    rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
  obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
  injection hmajEq with hxEq
  have htagEq : ctorTagCpt w₂ = ctorTagCpt w₁ := by
    unfold ctorTagCpt
    rw [← hctorEq, ← hparEq, ← hfldsLenEq]
  rw [hxEq, ← htagEq] at hx₁
  exact hx₁ hx₂

/-- Deterministic agreement when the left step is `WhStep E` and the right step is
    `WhStepPiKClosedCtxMaj E Γ` (`whStep_and_whStepPiKClosedCtxMaj_det`). -/
theorem whStep_and_whStepPiKClosedCtxMaj_det {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhStep E a b) (h₂ : WhStepPiKClosedCtxMaj E Γ a c) : b = c := by
  induction h₂ generalizing b with
  | of_whStep hs₂ =>
      exact whDet_of_envWfT hW h₁ hs₂
  | zetaLocal _ =>
      exact (whStep_bvar_false h₁).elim
  | iotaS w₂ ls₂ lsC₂ pre₂ params₂ fields₂ hpre₂ hpar₂ hflds₂ =>
      generalize ha : recCall (.const w₂.recRef ls₂) pre₂
        (foldApps (.const w₂.ctorRef lsC₂) (params₂ ++ fields₂)) = a₀ at h₁
      cases h₁ with
      | beta =>
          unfold recCall at ha
          rw [foldApps_snoc, Expr.app.injEq] at ha
          exact (F8EtaK.foldApps_const_ne_lam_any ha.1).elim
      | zeta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | delta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | lit =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w₁ =>
              exact iotaS_det w₁ w₂ w₁.ls w₁.lsC ls₂ lsC₂
                w₁.preMajor w₁.ctorParams w₁.fields pre₂ params₂ fields₂
                rfl w₁.hctorParams hpre₂ hpar₂ ha.symm
      | appHead hf₁ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStep_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
  | iotaKClosedCtx w₂ ls₂ pre₂ x₂ hk₂ hpre₂ hx₂ =>
      generalize ha : recCall (.const w₂.recRef ls₂) pre₂ x₂ = a₀ at h₁
      cases h₁ with
      | beta =>
          unfold recCall at ha
          rw [foldApps_snoc, Expr.app.injEq] at ha
          exact (F8EtaK.foldApps_const_ne_lam_any ha.1).elim
      | zeta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | delta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | lit =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w₁ =>
              exact (not_iotaS_and_iotaKClosedCtxMaj hW w₁ w₂ w₁.ls w₁.lsC ls₂
                w₁.preMajor w₁.ctorParams w₁.fields pre₂ x₂
                rfl w₁.hctorParams rfl hk₂ hpre₂ hx₂ ha.symm).elim
      | appHead hf₁ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStep_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
  | recMajor w₂ ls₂ pre₂ x₂ x₂' hpre₂ _ hs₂ =>
      generalize ha : recCall (.const w₂.recRef ls₂) pre₂ x₂ = a₀ at h₁
      cases h₁ with
      | beta =>
          unfold recCall at ha
          rw [foldApps_snoc, Expr.app.injEq] at ha
          exact (F8EtaK.foldApps_const_ne_lam_any ha.1).elim
      | zeta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | delta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | lit =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w₁ =>
              exact (not_iotaS_and_recMajor hW w₁ w₂ w₁.ls w₁.lsC ls₂
                w₁.preMajor w₁.ctorParams w₁.fields pre₂ x₂ x₂'
                rfl hpre₂ hs₂ ha.symm).elim
      | appHead hf₁ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStep_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
  | @appHead f f' arg hf₂ ih =>
      generalize ha : Expr.app f arg = a₀ at h₁
      cases h₁ with
      | beta =>
          injection ha with hfEq _
          subst hfEq
          exact (whStepPiKClosedCtxMaj_lam_false hf₂).elim
      | zeta => exact Expr.noConfusion ha
      | delta => exact Expr.noConfusion ha
      | lit => exact Expr.noConfusion ha
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w₁ =>
              unfold iotaLhsOfS recCall at ha
              rw [foldApps_snoc] at ha
              injection ha with hfEq _
              subst hfEq
              exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₁ w₁.ls w₁.preMajor
                (Nat.le_refl _) hf₂).elim
      | appHead hs₁ =>
          injection ha with hfEq hargEq
          subst hfEq; subst hargEq
          exact congrArg (fun t => Expr.app t arg) (ih hs₁)

/-- **Exact Single-Step Determinism of `WhStepPiKClosedCtxMaj` (`whDetPiKClosedCtxMaj_of_envWfT`):**
    At every `EnvWfT E` and every context `Γ : LCtx`, the 6-constructor reduction
    `WhStepPiKClosedCtxMaj E Γ` (including `iotaS`, `iotaKClosedCtx`, and `recMajor`) is
    **100% single-step deterministic**! -/
theorem whDetPiKClosedCtxMaj_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhStepPiKClosedCtxMaj E Γ a b) (h₂ : WhStepPiKClosedCtxMaj E Γ a c) :
    b = c := by
  induction h₁ generalizing c with
  | of_whStep hs₁ =>
      exact whStep_and_whStepPiKClosedCtxMaj_det hW hs₁ h₂
  | @zetaLocal i v₁ hval₁ =>
      generalize ha : (Expr.bvar i : Expr Nat) = a₀ at h₂
      cases h₂ with
      | of_whStep hs₂ =>
          subst ha
          exact (whStep_bvar_false hs₂).elim
      | @zetaLocal j v₂ hval₂ =>
          injection ha with hij
          subst hij
          exact Option.some.inj (hval₁.symm.trans hval₂)
      | iotaS _ _ _ _ _ _ _ _ _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iotaKClosedCtx _ _ _ _ _ _ _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | recMajor _ _ _ _ _ _ _ _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | appHead _ =>
          exact Expr.noConfusion ha
  | iotaS w₁ ls₁ lsC₁ pre₁ params₁ fields₁ hpre₁ hpar₁ hflds₁ =>
      generalize ha : recCall (.const w₁.recRef ls₁) pre₁
        (foldApps (.const w₁.ctorRef lsC₁) (params₁ ++ fields₁)) = a₀ at h₂
      cases h₂ with
      | of_whStep hs₂ =>
          subst ha
          exact (whStep_and_whStepPiKClosedCtxMaj_det (Γ := Γ) hW hs₂
            (.iotaS w₁ ls₁ lsC₁ pre₁ params₁ fields₁ hpre₁ hpar₁ hflds₁)).symm
      | zetaLocal _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iotaS w₂ ls₂ lsC₂ pre₂ params₂ fields₂ hpre₂ hpar₂ _ =>
          exact iotaS_det w₁ w₂ ls₁ lsC₁ ls₂ lsC₂ pre₁ params₁ fields₁ pre₂ params₂ fields₂
            hpre₁ hpar₁ hpre₂ hpar₂ ha
      | iotaKClosedCtx w₂ ls₂ pre₂ x₂ hk₂ hpre₂ hx₂ =>
          exact (not_iotaS_and_iotaKClosedCtxMaj hW w₁ w₂ ls₁ lsC₁ ls₂
            pre₁ params₁ fields₁ pre₂ x₂ hpre₁ hpar₁ hflds₁ hk₂ hpre₂ hx₂ ha).elim
      | recMajor w₂ ls₂ pre₂ x₂ x₂' hpre₂ _ hs₂ =>
          exact (not_iotaS_and_recMajor hW w₁ w₂ ls₁ lsC₁ ls₂
            pre₁ params₁ fields₁ pre₂ x₂ x₂' hpre₁ hpre₂ hs₂ ha).elim
      | appHead hf₂ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₁ ls₁ pre₁ (by omega) hf₂).elim
  | iotaKClosedCtx w₁ ls₁ pre₁ x₁ hk₁ hpre₁ hx₁ =>
      generalize ha : recCall (.const w₁.recRef ls₁) pre₁ x₁ = a₀ at h₂
      cases h₂ with
      | of_whStep hs₂ =>
          subst ha
          exact (whStep_and_whStepPiKClosedCtxMaj_det (Γ := Γ) hW hs₂
            (.iotaKClosedCtx w₁ ls₁ pre₁ x₁ hk₁ hpre₁ hx₁)).symm
      | zetaLocal _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iotaS w₂ ls₂ lsC₂ pre₂ params₂ fields₂ hpre₂ hpar₂ hflds₂ =>
          exact (not_iotaS_and_iotaKClosedCtxMaj hW w₂ w₁ ls₂ lsC₂ ls₁
            pre₂ params₂ fields₂ pre₁ x₁ hpre₂ hpar₂ hflds₂ hk₁ hpre₁ hx₁ ha.symm).elim
      | iotaKClosedCtx w₂ ls₂ pre₂ x₂ _ hpre₂ _ =>
          exact iotaKClosedCtxMaj_det w₁ w₂ ls₁ ls₂ pre₁ pre₂ x₁ x₂ hk₁ hpre₁ hpre₂ ha
      | recMajor w₂ ls₂ pre₂ x₂ _ hpre₂ hx₂ _ =>
          exact (not_iotaKClosedCtxMaj_and_recMajor w₁ w₂ ls₁ ls₂ pre₁ pre₂ x₁ x₂
            hk₁ hpre₁ hx₁ hpre₂ hx₂ ha).elim
      | appHead hf₂ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₁ ls₁ pre₁ (by omega) hf₂).elim
  | recMajor w₁ ls₁ pre₁ x₁ x₁' hpre₁ hx₁ hs₁ ih =>
      generalize ha : recCall (.const w₁.recRef ls₁) pre₁ x₁ = a₀ at h₂
      cases h₂ with
      | of_whStep hs₂ =>
          subst ha
          exact (whStep_and_whStepPiKClosedCtxMaj_det (Γ := Γ) hW hs₂
            (.recMajor w₁ ls₁ pre₁ x₁ x₁' hpre₁ hx₁ hs₁)).symm
      | zetaLocal _ =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iotaS w₂ ls₂ lsC₂ pre₂ params₂ fields₂ hpre₂ _ _ =>
          exact (not_iotaS_and_recMajor hW w₂ w₁ ls₂ lsC₂ ls₁
            pre₂ params₂ fields₂ pre₁ x₁ x₁' hpre₂ hpre₁ hs₁ ha.symm).elim
      | iotaKClosedCtx w₂ ls₂ pre₂ x₂ hk₂ hpre₂ hx₂ =>
          exact (not_iotaKClosedCtxMaj_and_recMajor w₂ w₁ ls₂ ls₁ pre₂ pre₁ x₂ x₁
            hk₂ hpre₂ hx₂ hpre₁ hx₁ ha.symm).elim
      | recMajor w₂ ls₂ pre₂ x₂ x₂' hpre₂ _ hs₂ =>
          have hsp := congrArg appsSpine ha
          unfold recCall at hsp
          rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
          injection hsp with hhead hargs
          injection hhead with hrec hls
          have hpreLenEq : pre₁.length = pre₂.length := by
            rw [hpre₁, hpre₂, (iotaWitnessS_preMajor_length_eq w₁ w₂ hrec).2]
          obtain ⟨hpreEq, hmajEq⟩ := List.append_inj hargs hpreLenEq
          injection hmajEq with hxEq
          subst hxEq
          have hx'Eq := ih hs₂
          unfold recCall
          rw [hrec, hls, hpreEq, hx'Eq]
      | appHead hf₂ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₁ ls₁ pre₁ (by omega) hf₂).elim
  | @appHead f f' arg hf₁ ih =>
      generalize ha : Expr.app f arg = a₀ at h₂
      cases h₂ with
      | of_whStep hs₂ =>
          subst ha
          exact (whStep_and_whStepPiKClosedCtxMaj_det hW hs₂ (.appHead hf₁)).symm
      | zetaLocal _ =>
          exact Expr.noConfusion ha
      | iotaS w₂ ls₂ _ pre₂ _ _ hpre₂ _ _ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
      | iotaKClosedCtx w₂ ls₂ pre₂ _ _ hpre₂ _ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
      | recMajor w₂ ls₂ pre₂ _ _ hpre₂ _ _ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact (not_whStepPiKClosedCtxMaj_recursor_prefix hW w₂ ls₂ pre₂ (by omega) hf₁).elim
      | appHead hf₂ =>
          injection ha with hfEq hargEq
          subst hfEq; subst hargEq
          exact congrArg (fun t => Expr.app t arg) (ih hf₂)

/-- Normal forms of `WhStepPiKClosedCtxMaj E Γ`. -/
def WhNormalPiKClosedCtxMaj (E : ResolvedEnv) (Γ : LCtx) (a : Expr Nat) : Prop :=
  ∀ b, ¬ WhStepPiKClosedCtxMaj E Γ a b

theorem whNormalPiKClosedCtxMaj_sort (E : ResolvedEnv) (Γ : LCtx) (l : Level) :
    WhNormalPiKClosedCtxMaj E Γ (.sort l) :=
  fun _ h => whStepPiKClosedCtxMaj_sort_false h

theorem whNormalPiKClosedCtxMaj_pi (E : ResolvedEnv) (Γ : LCtx) (A B : Expr Nat) :
    WhNormalPiKClosedCtxMaj E Γ (.pi A B) :=
  fun _ h => whStepPiKClosedCtxMaj_pi_false h

theorem whNormalPiKClosedCtxMaj_lam (E : ResolvedEnv) (Γ : LCtx) (A b : Expr Nat) :
    WhNormalPiKClosedCtxMaj E Γ (.lam A b) :=
  fun _ h => whStepPiKClosedCtxMaj_lam_false h

theorem whRedPiKClosedCtxMaj_of_normal {E : ResolvedEnv} {Γ : LCtx} {X Y : Expr Nat}
    (hX : WhNormalPiKClosedCtxMaj E Γ X) (h : WhRedPiKClosedCtxMaj E Γ X Y) : Y = X := by
  cases h with
  | refl => rfl
  | step hs _ => exact (hX _ hs).elim

/-- **Unconditional Normal-Form Uniqueness for `WhRedPiKClosedCtxMaj`
    (`whRedPiKClosedCtxMaj_normal_unique_of_envWfT`):** -/
theorem whRedPiKClosedCtxMaj_normal_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a X Y : Expr Nat}
    (h₁ : WhRedPiKClosedCtxMaj E Γ a X) (hX : WhNormalPiKClosedCtxMaj E Γ X)
    (h₂ : WhRedPiKClosedCtxMaj E Γ a Y) (hY : WhNormalPiKClosedCtxMaj E Γ Y) : X = Y := by
  induction h₁ with
  | refl => exact (whRedPiKClosedCtxMaj_of_normal hX h₂).symm
  | step hs₁ _ ih =>
      cases h₂ with
      | refl => exact (hY _ hs₁).elim
      | step hs₂ hr₂ =>
          have e := whDetPiKClosedCtxMaj_of_envWfT hW hs₁ hs₂
          subst e
          exact ih hX hr₂

theorem whRedPiKClosedCtxMaj_pi_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a A₁ B₁ A₂ B₂ : Expr Nat}
    (h₁ : WhRedPiKClosedCtxMaj E Γ a (.pi A₁ B₁))
    (h₂ : WhRedPiKClosedCtxMaj E Γ a (.pi A₂ B₂)) :
    A₁ = A₂ ∧ B₁ = B₂ := by
  have e := whRedPiKClosedCtxMaj_normal_unique_of_envWfT hW h₁
    (whNormalPiKClosedCtxMaj_pi E Γ A₁ B₁) h₂ (whNormalPiKClosedCtxMaj_pi E Γ A₂ B₂)
  injection e with eA eB
  exact ⟨eA, eB⟩

theorem whRedPiKClosedCtxMaj_sort_unique_of_envWfT {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a : Expr Nat} {l₁ l₂ : Level}
    (h₁ : WhRedPiKClosedCtxMaj E Γ a (.sort l₁))
    (h₂ : WhRedPiKClosedCtxMaj E Γ a (.sort l₂)) :
    l₁ = l₂ := by
  have e := whRedPiKClosedCtxMaj_normal_unique_of_envWfT hW h₁
    (whNormalPiKClosedCtxMaj_sort E Γ l₁) h₂ (whNormalPiKClosedCtxMaj_sort E Γ l₂)
  injection e

theorem whStepPiKClosedCtxMaj_foldApps {E : ResolvedEnv} {Γ : LCtx} {f f' : Expr Nat}
    (h : WhStepPiKClosedCtxMaj E Γ f f') (xs : List (Expr Nat)) :
    WhStepPiKClosedCtxMaj E Γ (foldApps f xs) (foldApps f' xs) := by
  induction xs generalizing f f' with
  | nil => exact h
  | cons x xs ih => exact ih (.appHead h)

theorem whRedPiKClosedCtxMaj_foldApps {E : ResolvedEnv} {Γ : LCtx} {f f' : Expr Nat}
    (h : WhRedPiKClosedCtxMaj E Γ f f') (xs : List (Expr Nat)) :
    WhRedPiKClosedCtxMaj E Γ (foldApps f xs) (foldApps f' xs) := by
  induction h generalizing xs with
  | refl => exact .refl _
  | step hs _ ih => exact .step (whStepPiKClosedCtxMaj_foldApps hs xs) (ih xs)

/-! ### §24.3. Unconditional Normal-Form Approximation Classification for `WhNormalPiKClosedCtxMaj`
(`whNormalPiKClosedCtxMaj_approxDIK_inv`, `approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes`,
`approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes`,
`approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes`) -/

theorem approxSpineArgsK_length_eq {E : ResolvedEnv} {ρ : EnvI} :
    ∀ {xs : List (Expr Nat)} {us : List CptI},
      ApproxSpineArgsK E ρ xs us → xs.length = us.length
  | [], [], .nil => rfl
  | _ :: _, _ :: _, .cons _ hxs => congrArg Nat.succ (approxSpineArgsK_length_eq hxs)

theorem foldAppCptK_sort_cons_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (a : Expr Nat) (rest : List (Expr Nat)) {c : CptI}
    (h : FoldAppCptK E ρ .sort (a :: rest) c) : c = .bot := by
  cases h with
  | bot => rfl
  | cons hstep hrest =>
      cases hstep with
      | bot => exact foldAppCptK_bot_inv hrest

theorem foldAppCptK_pi_cons_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (a₀ : CptI) (f₀ : List (List CptI × CptI)) (a : Expr Nat) (rest : List (Expr Nat)) {c : CptI}
    (h : FoldAppCptK E ρ (.pi a₀ f₀) (a :: rest) c) : c = .bot := by
  cases h with
  | bot => rfl
  | cons hstep hrest =>
      cases hstep with
      | bot => exact foldAppCptK_bot_inv hrest

private theorem sizeOf_le_sizeOf_foldApps :
    ∀ (f : Expr Nat) (xs : List (Expr Nat)), sizeOf f ≤ sizeOf (foldApps f xs)
  | _, [] => Nat.le_refl _
  | f, x :: xs => by
      have h1 : sizeOf f ≤ sizeOf (Expr.app f x) := by simp +arith
      exact Nat.le_trans h1 (sizeOf_le_sizeOf_foldApps (.app f x) xs)

private theorem sizeOf_lt_sizeOf_foldApps_of_mem :
    ∀ (f : Expr Nat) (xs : List (Expr Nat)) {x : Expr Nat},
      x ∈ xs → sizeOf x < sizeOf (foldApps f xs)
  | f, x :: xs, y, hmem => by
      rcases List.mem_cons.mp hmem with rfl | hmem'
      · have h1 : sizeOf y < sizeOf (Expr.app f y) := by simp +arith
        exact Nat.lt_of_lt_of_le h1 (sizeOf_le_sizeOf_foldApps (.app f y) xs)
      · exact sizeOf_lt_sizeOf_foldApps_of_mem (.app f x) xs hmem'

private theorem list_split_at_of_lt {α : Type _} :
    ∀ (n : Nat) (xs : List α), n < xs.length →
      ∃ pre x rest, xs = pre ++ x :: rest ∧ pre.length = n
  | 0, x :: xs, _ => ⟨[], x, xs, rfl, rfl⟩
  | n + 1, x :: xs, hlt => by
      simp only [List.length_cons] at hlt
      obtain ⟨pre, y, rest, rfl, hlen⟩ := list_split_at_of_lt n xs (by omega)
      exact ⟨x :: pre, y, rest, rfl, by simp [hlen]⟩

private theorem list_split_of_length_add {α : Type _} (xs : List α) (m k : Nat)
    (h : xs.length = m + k) :
    ∃ as bs, xs = as ++ bs ∧ as.length = m ∧ bs.length = k :=
  ⟨xs.take m, xs.drop m, (List.take_append_drop m xs).symm,
    by rw [List.length_take]; omega,
    by rw [List.length_drop]; omega⟩

private theorem exists_foldApps_not_app :
    ∀ (e : Expr Nat), ∃ head xs, e = foldApps head xs ∧ ∀ f a, head ≠ .app f a
  | .app f a => by
      obtain ⟨head, xs, rfl, hnot⟩ := exists_foldApps_not_app f
      exact ⟨head, xs ++ [a], (foldApps_snoc head a xs).symm, hnot⟩
  | .bvar i => ⟨.bvar i, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .sort l => ⟨.sort l, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .const r ls => ⟨.const r ls, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .lam A b => ⟨.lam A b, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .pi A B => ⟨.pi A B, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .letE A v b => ⟨.letE A v b, [], rfl, fun _ _ h => Expr.noConfusion h⟩
  | .lit L => ⟨.lit L, [], rfl, fun _ _ h => Expr.noConfusion h⟩

/-- Any non-K recursor elimination `recCall (.const w.recRef ls) pre x` whose major `x` does not
    have `ctorTagCpt w'` in `ApproxDIK E ρ` for any branch `w'` (`w'.recRef = w.recRef`) has ONLY
    `.bot` in `ApproxDIK E ρ` (`approxDIK_recursor_elim_no_ctorTag_nonK_eq_bot`). -/
theorem approxDIK_recursor_elim_no_ctorTag_nonK_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (w : IotaWitnessS E)
    (hnk : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (ls : List Level) {pre : List (Expr Nat)}
    (hpre : pre.length = w.preMajor.length) {x : Expr Nat}
    (hno : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef → ¬ ApproxDIK E ρ x (ctorTagCpt w'))
    {c : CptI}
    (h : ApproxDIK E ρ (recCall (.const w.recRef ls) pre x) c) :
    c = .bot := by
  unfold recCall at h
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
    rfl |
    ⟨w', us_pre, us_fields, c₀, hrecEq, hpreLen, hfldsLen, _, rfl⟩ |
    ⟨w', us_pre, u_maj, c₀, hrecEq, hk', _, _, _, rfl⟩
  · exact foldAppCptK_bot_inv hfold
  · have hpreLenEq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrecEq).2.1
    have htotLen : (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length =
        (pre ++ [x]).length := by
      simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
    rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
    · rfl
    · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
        (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
      have hlenPre : us_pre.length = us_pre'.length := by
        rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
      obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
      cases hmajArgs with
      | cons hmaj _ =>
          cases hmajEq
          have hsp := hmaj
            (.spine w'.ctorRef (List.replicate w'.nparams .bot ++ List.replicate us_fields.length .bot))
            (List.mem_cons_self _ _)
          rw [hfldsLen] at hsp
          exact (hno w' hrecEq hsp).elim
  · obtain ⟨_, _, _, _, _, hfamEq, hnminEq, _, _⟩ := iotaWitnessS_same_recRef w' w hrecEq
    rw [hfamEq, hnminEq] at hk'
    exact (hnk hk').elim

private theorem foldAppCptK_append_elim {E : ResolvedEnv} {ρ : EnvI} :
    ∀ (xs ys : List (Expr Nat)) {d c : CptI},
      FoldAppCptK E ρ d (xs ++ ys) c →
      ∃ d', FoldAppCptK E ρ d xs d' ∧ FoldAppCptK E ρ d' ys c
  | [], ys, d, c, h => ⟨d, .nil d, h⟩
  | x :: xs, ys, d, _, .bot _ _ => ⟨.bot, .bot d (x :: xs), .bot .bot ys⟩
  | x :: xs, ys, d, _, .cons hstep hrest => by
      obtain ⟨d', hxs, hys⟩ := foldAppCptK_append_elim xs ys hrest
      exact ⟨d', .cons hstep hxs, hys⟩

theorem whNormalPiKClosedCtxMaj_foldApps_inv {E : ResolvedEnv} {Γ : LCtx} {f : Expr Nat}
    (xs : List (Expr Nat)) (h : WhNormalPiKClosedCtxMaj E Γ (foldApps f xs)) :
    WhNormalPiKClosedCtxMaj E Γ f :=
  fun _ hs => h _ (whStepPiKClosedCtxMaj_foldApps hs xs)

/-- **Unconditional Normal-Form Approximation Classification for `WhNormalPiKClosedCtxMaj`
    (`whNormalPiKClosedCtxMaj_approxDIK_inv`):**
    For **every** expression `e : Expr Nat` and **every** context `Γ : LCtx`, if `e` is
    `WhNormalPiKClosedCtxMaj E Γ e` and `ApproxDIK E (ctxEnvDIK E Γ) e c` holds:
    1. If `c = .sort`, then `∃ l, e = .sort l`.
    2. If `c = .pi a f`, then `∃ A B, e = .pi A B`.
    3. If `c = .spine r args`, then `∃ ls xs, RigidConst E r ∧ e = foldApps (.const r ls) xs ∧ xs.length = args.length`. -/
theorem whNormalPiKClosedCtxMaj_approxDIK_inv {E : ResolvedEnv} {Γ : LCtx} :
    ∀ (e : Expr Nat) {c : CptI},
      WhNormalPiKClosedCtxMaj E Γ e →
      ApproxDIK E (ctxEnvDIK E Γ) e c →
      (c = .sort → ∃ l, e = .sort l) ∧
      ((∃ a f, c = .pi a f) → ∃ A B, e = .pi A B) ∧
      (∀ r args, c = .spine r args →
        ∃ ls xs, RigidConst E r ∧ e = foldApps (.const r ls) xs ∧ xs.length = args.length) := by
  intro e
  refine @WellFounded.fix (Expr Nat)
    (fun e => ∀ {c : CptI},
      WhNormalPiKClosedCtxMaj E Γ e →
      ApproxDIK E (ctxEnvDIK E Γ) e c →
      (c = .sort → ∃ l, e = .sort l) ∧
      ((∃ a f, c = .pi a f) → ∃ A B, e = .pi A B) ∧
      (∀ r args, c = .spine r args →
        ∃ ls xs, RigidConst E r ∧ e = foldApps (.const r ls) xs ∧ xs.length = args.length))
    _ (measure (fun x : Expr Nat => sizeOf x)).wf ?_ e
  intro e ih c hnorm happrox
  have hnot_bot_or_lam :
      (c = .bot ∨ ∃ g, c = .lam g) →
      (c = .sort → ∃ l, e = .sort l) ∧
      ((∃ a f, c = .pi a f) → ∃ A B, e = .pi A B) ∧
      (∀ r args, c = .spine r args →
        ∃ ls xs, RigidConst E r ∧ e = foldApps (.const r ls) xs ∧ xs.length = args.length) := by
    rintro (rfl | ⟨g, rfl⟩)
    · refine ⟨fun h => (by cases h), ?_, fun _ _ h => (by cases h)⟩
      rintro ⟨_, _, h⟩; cases h
    · refine ⟨fun h => (by cases h), ?_, fun _ _ h => (by cases h)⟩
      rintro ⟨_, _, h⟩; cases h
  obtain ⟨head, xs, heEq, hnotApp⟩ := exists_foldApps_not_app e
  have hnorm_head : WhNormalPiKClosedCtxMaj E Γ head := by
    rw [heEq] at hnorm
    exact whNormalPiKClosedCtxMaj_foldApps_inv xs hnorm
  cases head with
  | app f a => exact (hnotApp f a rfl).elim
  | letE A v b =>
      exact (hnorm_head _ (.of_whStep (.zeta A v b))).elim
  | lit L =>
      exact (hnorm_head _ (.of_whStep (.lit L))).elim
  | bvar i =>
      cases hval : lookupValue Γ i with
      | some v =>
          exact (hnorm_head _ (.zetaLocal hval)).elim
      | none =>
          rw [heEq] at happrox
          exact hnot_bot_or_lam (Or.inl (approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hval xs happrox))
  | sort l =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          rw [heEq] at happrox
          rcases approxDIK_sort_inv happrox with rfl | rfl
          · exact hnot_bot_or_lam (Or.inl rfl)
          · refine ⟨fun _ => ⟨l, heEq⟩, ?_, fun _ _ h => (by cases h)⟩
            rintro ⟨_, _, h⟩; cases h
      | cons a rest =>
          rw [heEq, approxDIK_foldApps_iff] at happrox
          rcases happrox with ⟨d, hd, hfold⟩
          rcases approxDIK_sort_inv hd with rfl | rfl
          · exact hnot_bot_or_lam (Or.inl (foldAppCptK_bot_inv hfold))
          · exact hnot_bot_or_lam (Or.inl (foldAppCptK_sort_cons_eq_bot a rest hfold))
  | pi A B =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          rw [heEq] at happrox
          rcases approxDIK_pi_inv happrox with rfl | ⟨a₀, f₀, rfl, _, _⟩
          · exact hnot_bot_or_lam (Or.inl rfl)
          · refine ⟨fun h => (by cases h), fun _ => ⟨A, B, heEq⟩, fun _ _ h => (by cases h)⟩
      | cons a rest =>
          rw [heEq, approxDIK_foldApps_iff] at happrox
          rcases happrox with ⟨d, hd, hfold⟩
          rcases approxDIK_pi_inv hd with rfl | ⟨a₀, f₀, rfl, _, _⟩
          · exact hnot_bot_or_lam (Or.inl (foldAppCptK_bot_inv hfold))
          · exact hnot_bot_or_lam (Or.inl (foldAppCptK_pi_cons_eq_bot a₀ f₀ a rest hfold))
  | lam A b =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          rw [heEq] at happrox
          rcases approxDIK_lam_inv happrox with rfl | ⟨g, rfl, _⟩
          · exact hnot_bot_or_lam (Or.inl rfl)
          · exact hnot_bot_or_lam (Or.inr ⟨g, rfl⟩)
      | cons a rest =>
          have hstep : WhStepPiKClosedCtxMaj E Γ e (foldApps (instantiate0 a b) rest) := by
            rw [heEq]
            exact whStepPiKClosedCtxMaj_foldApps (.of_whStep (.beta A b a)) rest
          exact (hnorm _ hstep).elim
  | const r ls =>
      have happrox' := happrox
      rw [heEq, approxDIK_foldApps_iff] at happrox'
      rcases happrox' with ⟨d, hd, hfold⟩
      generalize he0 : (Expr.const r ls : Expr Nat) = e0 at hd
      cases hd with
      | bot =>
          exact hnot_bot_or_lam (Or.inl (foldAppCptK_bot_inv hfold))
      | const _ r' ls' hrigid =>
          injection he0 with hr hls
          subst hr; subst hls
          rcases (foldAppCptK_spine_iff r xs [] c).mp hfold with rfl | ⟨us, hus, rfl⟩
          · exact hnot_bot_or_lam (Or.inl rfl)
          · simp only [List.nil_append]
            refine ⟨fun h => (by cases h), ?_, ?_⟩
            · rintro ⟨_, _, h⟩; cases h
            · intro r₀ args₀ hspEq
              injection hspEq with hrEq hargsEq
              subst hrEq; subst hargsEq
              exact ⟨ls, xs, hrigid, heEq, approxSpineArgsK_length_eq hus⟩
      | delta hdelta _ =>
          injection he0 with hr hls
          subst hr; subst hls
          exact (hnorm_head _ (.of_whStep (.delta hdelta.1 hdelta.2.1))).elim
      | @recursor _ w ls' us_pre us_fields c₀ hpre hflds _ =>
          injection he0 with hr hls
          subst hr; subst hls
          by_cases hle : xs.length ≤ w.preMajor.length
          · have hlt : xs.length < (us_pre ++ [ctorDemand w.ctorRef w.nparams us_fields]).length := by
              simp only [List.length_append, List.length_singleton, hpre]
              omega
            exact hnot_bot_or_lam (foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold)
          · obtain ⟨pre, x, rest, hxsEq, hpreLen⟩ :=
              list_split_at_of_lt w.preMajor.length xs (by omega)
            have heRec : e = foldApps (recCall (.const w.recRef ls) pre x) rest := by
              rw [heEq, hxsEq, recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
            have hnorm_rec : WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
              rw [heRec] at hnorm
              exact whNormalPiKClosedCtxMaj_foldApps_inv rest hnorm
            have hxsSplit : xs = (pre ++ [x]) ++ rest := by
              rw [hxsEq, List.append_assoc, List.singleton_append]
            rw [hxsSplit] at hfold
            obtain ⟨d_rec, hfold_pre, hfold_rest⟩ :=
              foldAppCptK_append_elim (pre ++ [x]) rest hfold
            have htotLen : (us_pre ++ [ctorDemand w.ctorRef w.nparams us_fields]).length =
                (pre ++ [x]).length := by
              simp only [List.length_append, List.length_singleton, hpre, hpreLen]
            rcases (foldAppCptK_curryStep_iff htotLen).mp hfold_pre with rfl | ⟨hargs, rfl⟩
            · exact hnot_bot_or_lam (Or.inl (foldAppCptK_bot_inv hfold_rest))
            · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
                (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
              have hlenPre : us_pre.length = us_pre'.length := by
                rw [hpreArgs.length_eq, hpre, hpreLen]
              obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
              cases hmajArgs with
              | cons hmaj _ =>
                  cases hmajEq
                  have htag_x : ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) :=
                    hmaj (ctorTagCpt w) (ctorTagCpt_mem_ctorDemand w hflds)
                  have hnorm_x : WhNormalPiKClosedCtxMaj E Γ x :=
                    fun x' hsx => hnorm_rec _ (.recMajor w ls pre x x' hpreLen htag_x hsx)
                  have hsz : sizeOf x < sizeOf e := by
                    rw [heEq, hxsEq]
                    exact sizeOf_lt_sizeOf_foldApps_of_mem (.const w.recRef ls) (pre ++ x :: rest)
                      (List.mem_append_right pre (List.mem_cons_self x rest))
                  unfold ctorTagCpt at htag_x
                  obtain ⟨lsC, xsC, _, hxEq, hxsCLen⟩ :=
                    (ih x hsz hnorm_x htag_x).2.2 w.ctorRef
                      (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
                      rfl
                  simp only [List.length_append, List.length_replicate] at hxsCLen
                  obtain ⟨params, fields, hxsCSplit, hparLen, hfldsLen⟩ :=
                    list_split_of_length_add xsC w.nparams w.fields.length hxsCLen
                  rw [hxEq, hxsCSplit] at hnorm_rec
                  exact (hnorm_rec _ (.iotaS w ls lsC pre params fields hpreLen hparLen hfldsLen)).elim
      | @recursorK _ w ls' us_pre u_maj c₀ hk hpre _ _ =>
          injection he0 with hr hls
          subst hr; subst hls
          by_cases hle : xs.length ≤ w.preMajor.length
          · have hlt : xs.length < (us_pre ++ [u_maj]).length := by
              simp only [List.length_append, List.length_singleton, hpre]
              omega
            exact hnot_bot_or_lam (foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold)
          · obtain ⟨pre, x, rest, hxsEq, hpreLen⟩ :=
              list_split_at_of_lt w.preMajor.length xs (by omega)
            have heRec : e = foldApps (recCall (.const w.recRef ls) pre x) rest := by
              rw [heEq, hxsEq, recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
            have hnorm_rec : WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
              rw [heRec] at hnorm
              exact whNormalPiKClosedCtxMaj_foldApps_inv rest hnorm
            have hnot_tag : ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) := by
              intro htag_x
              have hnorm_x : WhNormalPiKClosedCtxMaj E Γ x :=
                fun x' hsx => hnorm_rec _ (.recMajor w ls pre x x' hpreLen htag_x hsx)
              have hsz : sizeOf x < sizeOf e := by
                rw [heEq, hxsEq]
                exact sizeOf_lt_sizeOf_foldApps_of_mem (.const w.recRef ls) (pre ++ x :: rest)
                  (List.mem_append_right pre (List.mem_cons_self x rest))
              unfold ctorTagCpt at htag_x
              obtain ⟨lsC, xsC, _, hxEq, hxsCLen⟩ :=
                (ih x hsz hnorm_x htag_x).2.2 w.ctorRef
                  (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
                  rfl
              simp only [List.length_append, List.length_replicate] at hxsCLen
              obtain ⟨params, fields, hxsCSplit, hparLen, hfldsLen⟩ :=
                list_split_of_length_add xsC w.nparams w.fields.length hxsCLen
              rw [hxEq, hxsCSplit] at hnorm_rec
              exact hnorm_rec _ (.iotaS w ls lsC pre params fields hpreLen hparLen hfldsLen)
            exact (hnorm_rec _ (.iotaKClosedCtx w ls pre x hk hpreLen hnot_tag)).elim
      | bvar => exact Expr.noConfusion he0
      | sort => exact Expr.noConfusion he0
      | pi => exact Expr.noConfusion he0
      | lam => exact Expr.noConfusion he0
      | app => exact Expr.noConfusion he0
      | appSpine => exact Expr.noConfusion he0
      | letE => exact Expr.noConfusion he0
      | lit => exact Expr.noConfusion he0

/-- If `recCall (.const w.recRef ls) pre x` is `WhNormalPiKClosedCtxMaj` and has a non-`.bot`
    compact `c ≠ .bot` in `ApproxDIK E (ctxEnvDIK E Γ)`, then `x` MUST approximate `ctorTagCpt w'`
    for some branch `w'` (`w'.recRef = w.recRef`)
    (`whNormalPiKClosedCtxMaj_recCall_nonbot_has_ctorTag`). -/
theorem whNormalPiKClosedCtxMaj_recCall_nonbot_has_ctorTag {E : ResolvedEnv} {Γ : LCtx}
    (w : IotaWitnessS E) (ls : List Level) {pre : List (Expr Nat)}
    (hpre : pre.length = w.preMajor.length) {x : Expr Nat}
    (hnorm : WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x))
    {c : CptI} (hne : c ≠ .bot)
    (h : ApproxDIK E (ctxEnvDIK E Γ) (recCall (.const w.recRef ls) pre x) c) :
    ∃ (w' : IotaWitnessS E), w'.recRef = w.recRef ∧ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w') := by
  unfold recCall at h
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
    rfl |
    ⟨w', us_pre, us_fields, c₀, hrecEq, hpreLen, hfldsLen, _, rfl⟩ |
    ⟨w', us_pre, u_maj, c₀, hrecEq, hk', _, _, _, rfl⟩
  · exact (hne (foldAppCptK_bot_inv hfold)).elim
  · have hpreLenEq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrecEq).2.1
    have htotLen : (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length =
        (pre ++ [x]).length := by
      simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
    rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
    · exact (hne rfl).elim
    · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
        (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
      have hlenPre : us_pre.length = us_pre'.length := by
        rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
      obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
      cases hmajArgs with
      | cons hmaj _ =>
          cases hmajEq
          exact ⟨w', hrecEq, hmaj (ctorTagCpt w') (ctorTagCpt_mem_ctorDemand w' hfldsLen)⟩
  · obtain ⟨_, _, _, _, _, hfamEq, hnminEq, _, _⟩ := iotaWitnessS_same_recRef w' w hrecEq
    rw [hfamEq, hnminEq] at hk'
    have hnot_tag : ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) := by
      intro htag_x
      have hnorm_x : WhNormalPiKClosedCtxMaj E Γ x :=
        fun x' hsx => hnorm _ (.recMajor w ls pre x x' hpre htag_x hsx)
      unfold ctorTagCpt at htag_x
      obtain ⟨lsC, xsC, _, hxEq, hxsCLen⟩ :=
        (whNormalPiKClosedCtxMaj_approxDIK_inv x hnorm_x htag_x).2.2 w.ctorRef
          (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
          rfl
      simp only [List.length_append, List.length_replicate] at hxsCLen
      obtain ⟨params, fields, hxsCSplit, hparLen, hfldsLen⟩ :=
        list_split_of_length_add xsC w.nparams w.fields.length hxsCLen
      rw [hxEq, hxsCSplit] at hnorm
      exact hnorm _ (.iotaS w ls lsC pre params fields hpre hparLen hfldsLen)
    exact (hnorm _ (.iotaKClosedCtx w ls pre x hk' hpre hnot_tag)).elim

/-- **Exact `.sort` Adequacy for `WhRedPiKClosedCtxMaj`-Normalizable Expressions
    (`approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes`):**
    At every `EnvWfT E`, if `e` reduces under `WhRedPiKClosedCtxMaj E Γ` to any normal form `nf`
    (`WhNormalPiKClosedCtxMaj E Γ nf`), then `ApproxDIK E (ctxEnvDIK E Γ) e .sort` holds **if and
    only if** `∃ l, WhRedPiKClosedCtxMaj E Γ e (.sort l)`! -/
theorem approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {e nf : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E Γ e nf)
    (hnorm : WhNormalPiKClosedCtxMaj E Γ nf) :
    ApproxDIK E (ctxEnvDIK E Γ) e .sort ↔ ∃ l, WhRedPiKClosedCtxMaj E Γ e (.sort l) := by
  constructor
  · intro h
    have hnf : ApproxDIK E (ctxEnvDIK E Γ) nf .sort :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred .sort).mp h
    obtain ⟨l, rfl⟩ := (whNormalPiKClosedCtxMaj_approxDIK_inv nf hnorm hnf).1 rfl
    exact ⟨l, hred⟩
  · rintro ⟨l, hred_l⟩
    exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_l .sort).mpr (.sort _ l)

/-- **Exact `.pi .bot []` Adequacy for `WhRedPiKClosedCtxMaj`-Normalizable Expressions
    (`approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes`):**
    At every `EnvWfT E`, if `e` reduces under `WhRedPiKClosedCtxMaj E Γ` to any normal form `nf`
    (`WhNormalPiKClosedCtxMaj E Γ nf`), then `ApproxDIK E (ctxEnvDIK E Γ) e (.pi .bot [])` holds
    **if and only if** `∃ A B, WhRedPiKClosedCtxMaj E Γ e (.pi A B)`! -/
theorem approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {e nf : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E Γ e nf)
    (hnorm : WhNormalPiKClosedCtxMaj E Γ nf) :
    ApproxDIK E (ctxEnvDIK E Γ) e (.pi .bot []) ↔ ∃ A B, WhRedPiKClosedCtxMaj E Γ e (.pi A B) := by
  constructor
  · intro h
    have hnf : ApproxDIK E (ctxEnvDIK E Γ) nf (.pi .bot []) :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (.pi .bot [])).mp h
    obtain ⟨A, B, rfl⟩ := (whNormalPiKClosedCtxMaj_approxDIK_inv nf hnorm hnf).2.1 ⟨.bot, [], rfl⟩
    exact ⟨A, B, hred⟩
  · rintro ⟨A, B, hred_pi⟩
    exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_pi (.pi .bot [])).mpr
      (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B)

/-- **Exact `ctorTagCpt` Adequacy for `WhRedPiKClosedCtxMaj`-Normalizable Expressions
    (`approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes`):**
    At every `EnvWfT E`, if `e` reduces under `WhRedPiKClosedCtxMaj E Γ` to any normal form `nf`
    (`WhNormalPiKClosedCtxMaj E Γ nf`), then `ApproxDIK E (ctxEnvDIK E Γ) e (ctorTagCpt w)` holds
    **if and only if** `e` reduces under `WhRedPiKClosedCtxMaj E Γ` to a canonical constructor spine
    `foldApps (.const w.ctorRef lsC) (params ++ fields)`! -/
theorem approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) {e nf : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E Γ e nf)
    (hnorm : WhNormalPiKClosedCtxMaj E Γ nf) :
    ApproxDIK E (ctxEnvDIK E Γ) e (ctorTagCpt w) ↔
      ∃ lsC params fields,
        params.length = w.nparams ∧
        fields.length = w.fields.length ∧
        WhRedPiKClosedCtxMaj E Γ e (foldApps (.const w.ctorRef lsC) (params ++ fields)) := by
  constructor
  · intro h
    have hnf : ApproxDIK E (ctxEnvDIK E Γ) nf (ctorTagCpt w) :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (ctorTagCpt w)).mp h
    unfold ctorTagCpt at hnf
    obtain ⟨lsC, xsC, _, rfl, hlen⟩ :=
      (whNormalPiKClosedCtxMaj_approxDIK_inv nf hnorm hnf).2.2 w.ctorRef
        (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
        rfl
    simp only [List.length_append, List.length_replicate] at hlen
    obtain ⟨params, fields, rfl, hparLen, hfldsLen⟩ :=
      list_split_of_length_add xsC w.nparams w.fields.length hlen
    exact ⟨lsC, params, fields, hparLen, hfldsLen, hred⟩
  · rintro ⟨lsC, params, fields, hparLen, hfldsLen, hred_ctor⟩
    exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_ctor (ctorTagCpt w)).mpr
      (approxDIK_ctorTagCpt_of_ctor_spine hW w lsC
        (by rw [List.length_append, hparLen, hfldsLen]) (ctxEnvDIK E Γ))

/-! ### §24.4. `hΓ₁`-Free Probe Type Relation `LRProbeTypePiKClosedCtxMaj`, `LRTermNoPiMajSemBi`,
Diagonal Adequacy from `WhRedPiKClosedCtxMajNormalizes` (Eliminating `LRPiWf2`), Positive Repair of
`W-REC-MAJOR-BETA`, and `piRow_of_fundamentalTermNoPiMajSemBiProbe` -/

/-- **`hΓ₁`-Free Probe-Compact Type Relation (`LRProbeTypePiKClosedCtxMaj`):**
    Because `tyConvT_tyConvT_head hW hΓ` (`RcicNativePiModelDeltaIota.lean:4536`) transports
    `TyConvT E n (.assumption A₁ :: Γ) B₁ B₂` along `TyConvT E n Γ A₁ A₂` using only `hΓ : CtxWfT E n Γ`
    (without requiring `CtxWfT E n (.assumption A₁ :: Γ)`), omitting `hΓ₁` from `.pi` preserves
    symmetry and transitivity while eliminating `LRPiWf2` completely on the diagonal! -/
inductive LRProbeTypePiKClosedCtxMaj (E : ResolvedEnv) (n : Nat) :
    LCtx → Expr Nat → Expr Nat → CptI → Prop
  | bot (Γ : LCtx) (X Y : Expr Nat) :
      LRProbeTypePiKClosedCtxMaj E n Γ X Y .bot
  | sort {Γ : LCtx} {X Y : Expr Nat} {l₁ l₂ : Level} :
      WhRedPiKClosedCtxMaj E Γ X (.sort l₁) →
      WhRedPiKClosedCtxMaj E Γ Y (.sort l₂) →
      LRProbeTypePiKClosedCtxMaj E n Γ X Y .sort
  | pi {Γ : LCtx} {X Y A₁ B₁ A₂ B₂ : Expr Nat} :
      WhRedPiKClosedCtxMaj E Γ X (.pi A₁ B₁) →
      WhRedPiKClosedCtxMaj E Γ Y (.pi A₂ B₂) →
      TyConvT E n Γ A₁ A₂ →
      TyConvT E n (.assumption A₁ :: Γ) B₁ B₂ →
      LRProbeTypePiKClosedCtxMaj E n Γ X Y (.pi .bot [])

theorem approxDIK_of_lrProbeTypePiKClosedCtxMaj {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {X Y : Expr Nat} {c : CptI}
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X Y c) :
    ApproxDIK E (ctxEnvDIK E Γ) X c ∧ ApproxDIK E (ctxEnvDIK E Γ) Y c := by
  cases h with
  | bot => exact ⟨.bot _ _, .bot _ _⟩
  | sort hX hY =>
      exact ⟨(semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hX .sort).mpr (.sort _ _),
        (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hY .sort).mpr (.sort _ _)⟩
  | pi hX hY _ _ =>
      exact ⟨(semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hX (.pi .bot [])).mpr
          (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) _ _),
        (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hY (.pi .bot [])).mpr
          (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) _ _)⟩

/-- Symmetry of `LRProbeTypePiKClosedCtxMaj` using `tyConvT_tyConvT_head hW hΓ` (zero `hΓ₁`!). -/
theorem lrProbeTypePiKClosedCtxMaj_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {X Y : Expr Nat} {c : CptI}
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X Y c) :
    LRProbeTypePiKClosedCtxMaj E n Γ Y X c := by
  cases h with
  | bot => exact .bot Γ Y X
  | sort hX hY => exact .sort hY hX
  | pi hX hY hdom hcod =>
      exact .pi hY hX hdom.symmT (tyConvT_tyConvT_head hW hΓ hdom hcod.symmT)

/-- Transitivity of `LRProbeTypePiKClosedCtxMaj` using `whRedPiKClosedCtxMaj_pi_unique_of_envWfT hW`
    and `tyConvT_tyConvT_head hW hΓ` (zero `hΓ₁`!). -/
theorem lrProbeTypePiKClosedCtxMaj_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {X Y Z : Expr Nat} {c : CptI}
    (h₁ : LRProbeTypePiKClosedCtxMaj E n Γ X Y c)
    (h₂ : LRProbeTypePiKClosedCtxMaj E n Γ Y Z c) :
    LRProbeTypePiKClosedCtxMaj E n Γ X Z c := by
  cases h₁ with
  | bot => exact .bot Γ X Z
  | sort hX _ =>
      cases h₂ with
      | sort _ hZ => exact .sort hX hZ
  | pi hX hY₁ hdom₁ hcod₁ =>
      cases h₂ with
      | pi hY₂ hZ hdom₂ hcod₂ =>
          obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtxMaj_pi_unique_of_envWfT hW hY₁ hY₂
          exact .pi hX hZ (.trans _ _ _ _ hdom₁ hdom₂)
            (.trans _ _ _ _ hcod₁ (tyConvT_tyConvT_head hW hΓ hdom₁.symmT hcod₂))

theorem lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {X X' Y Y' : Expr Nat} {c : CptI}
    (hX : WhRedPiKClosedCtxMaj E Γ X X')
    (hY : WhRedPiKClosedCtxMaj E Γ Y Y')
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X' Y' c) :
    LRProbeTypePiKClosedCtxMaj E n Γ X Y c := by
  cases h with
  | bot => exact .bot Γ X Y
  | sort hX' hY' => exact .sort (hX.trans hX') (hY.trans hY')
  | pi hX' hY' hdom hcod =>
      exact .pi (hX.trans hX') (hY.trans hY') hdom hcod

private theorem whRedPiKClosedCtxMaj_det_branch {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedPiKClosedCtxMaj E Γ a b) (h₂ : WhRedPiKClosedCtxMaj E Γ a c) :
    WhRedPiKClosedCtxMaj E Γ b c ∨ WhRedPiKClosedCtxMaj E Γ c b := by
  induction h₁ with
  | refl => exact Or.inl h₂
  | step hs₁ _ ih =>
      cases h₂ with
      | refl => exact Or.inr (.step hs₁ ‹_›)
      | step hs₂ hr₂ =>
          have heq := whDetPiKClosedCtxMaj_of_envWfT hW hs₁ hs₂
          subst heq
          exact ih hr₂

theorem lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_preserve {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {X X' Y Y' : Expr Nat} {c : CptI}
    (hX : WhRedPiKClosedCtxMaj E Γ X X')
    (hY : WhRedPiKClosedCtxMaj E Γ Y Y')
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X Y c) :
    LRProbeTypePiKClosedCtxMaj E n Γ X' Y' c := by
  cases h with
  | bot => exact .bot Γ X' Y'
  | sort hXs hYs =>
      rcases whRedPiKClosedCtxMaj_det_branch hW hX hXs with hX's | hX's
      · rcases whRedPiKClosedCtxMaj_det_branch hW hY hYs with hY's | hY's
        · exact .sort hX's hY's
        · rw [whRedPiKClosedCtxMaj_sort_eq hY's]; exact .sort hX's (.refl _)
      · rw [whRedPiKClosedCtxMaj_sort_eq hX's]
        rcases whRedPiKClosedCtxMaj_det_branch hW hY hYs with hY's | hY's
        · exact .sort (.refl _) hY's
        · rw [whRedPiKClosedCtxMaj_sort_eq hY's]; exact .sort (.refl _) (.refl _)
  | pi hXp hYp hdom hcod =>
      rcases whRedPiKClosedCtxMaj_det_branch hW hX hXp with hX'p | hX'p
      · rcases whRedPiKClosedCtxMaj_det_branch hW hY hYp with hY'p | hY'p
        · exact .pi hX'p hY'p hdom hcod
        · rw [whRedPiKClosedCtxMaj_pi_eq hY'p]; exact .pi hX'p (.refl _) hdom hcod
      · rw [whRedPiKClosedCtxMaj_pi_eq hX'p]
        rcases whRedPiKClosedCtxMaj_det_branch hW hY hYp with hY'p | hY'p
        · exact .pi (.refl _) hY'p hdom hcod
        · rw [whRedPiKClosedCtxMaj_pi_eq hY'p]; exact .pi (.refl _) (.refl _) hdom hcod

/-- **Purely Syntactic Diagonal Characterization of `LRProbeTypePiKClosedCtxMaj` on `.sort` and
    `.pi .bot []` (`lrProbeTypePiKClosedCtxMaj_diag_sort_iff`, `lrProbeTypePiKClosedCtxMaj_diag_pi_iff`):**
    Requires **zero** `LRPiWf2` and **zero** typing side-conditions! -/
theorem lrProbeTypePiKClosedCtxMaj_diag_sort_iff {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M : Expr Nat} :
    LRProbeTypePiKClosedCtxMaj E n Γ M M .sort ↔ ∃ l, WhRedPiKClosedCtxMaj E Γ M (.sort l) := by
  constructor
  · intro h; cases h with | sort hred _ => exact ⟨_, hred⟩
  · rintro ⟨l, hred⟩; exact .sort hred hred

theorem lrProbeTypePiKClosedCtxMaj_diag_pi_iff {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M : Expr Nat} :
    LRProbeTypePiKClosedCtxMaj E n Γ M M (.pi .bot []) ↔
      ∃ A B, WhRedPiKClosedCtxMaj E Γ M (.pi A B) := by
  constructor
  · intro h; cases h with | pi hred _ _ _ => exact ⟨_, _, hred⟩
  · rintro ⟨A, B, hred⟩; exact .pi hred hred (.refl _ A) (.refl _ B)

/-- Semantic non-$\Pi$-guarded probe core relation over `LRProbeTypePiKClosedCtxMaj`
    (`LRProbeNoPiMajCore`). -/
def LRProbeNoPiMajCore (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort => ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∧
      LRProbeTypePiKClosedCtxMaj E n Γ M M' .sort
  | .pi a f => a = .bot ∧ f = [] ∧
      ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∧
      LRProbeTypePiKClosedCtxMaj E n Γ M M' (.pi .bot [])
  | .spine _ _ => False
  | .lam _ => False

/-- Bidirectional `ProbeCpt`-restricted term logical relation over `IsSemPropTyI` and
    `LRProbeNoPiMajCore` (`LRTermNoPiMajSemBi`). -/
def LRTermNoPiMajSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : Prop :=
  ∀ c, ProbeCpt c →
    (ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c) →
    IsSemPropTyI E n Γ A ∨ LRProbeNoPiMajCore E n Γ M M' A c

theorem lrTermNoPiMajSemBi_of_isSemPropTyI {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} (hP : IsSemPropTyI E n Γ A) :
    LRTermNoPiMajSemBi E n Γ M M' A :=
  fun _ _ _ => Or.inl hP

theorem lrTermNoPiMajSemBi_of_probeCpt_eq_bot {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' : Expr Nat} (A : Expr Nat)
    (hM : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M c → c = .bot)
    (hM' : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M' c → c = .bot) :
    LRTermNoPiMajSemBi E n Γ M M' A := by
  intro c hc hor
  have hcEq : c = .bot := hor.elim (hM c hc) (hM' c hc)
  subst hcEq
  exact Or.inr trivial

theorem lrTermNoPiMajSemBi_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M M' A : Expr Nat}
    (h : LRTermNoPiMajSemBi E n Γ M M' A) :
    LRTermNoPiMajSemBi E n Γ M' M A := by
  intro c hc hor
  rcases h c hc hor.symm with hP | hC
  · exact Or.inl hP
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort => exact ⟨hC.1, lrProbeTypePiKClosedCtxMaj_symm hW hΓ hC.2⟩
    | piBotNil => exact ⟨rfl, rfl, hC.2.2.1, lrProbeTypePiKClosedCtxMaj_symm hW hΓ hC.2.2.2⟩

theorem lrTermNoPiMajSemBi_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M₁ M₂ M₃ A : Expr Nat}
    (h₁ : LRTermNoPiMajSemBi E n Γ M₁ M₂ A)
    (h₂ : LRTermNoPiMajSemBi E n Γ M₂ M₃ A) :
    LRTermNoPiMajSemBi E n Γ M₁ M₃ A := by
  intro c hc hor
  rcases hor with hM₁ | hM₃
  · rcases h₁ c hc (Or.inl hM₁) with hP | hC₁
    · exact Or.inl hP
    · cases hc with
      | bot => exact Or.inr trivial
      | sort =>
          have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ .sort :=
            (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hC₁.2).2
          rcases h₂ .sort .sort (Or.inl hM₂) with hP | hC₂
          · exact Or.inl hP
          · exact Or.inr ⟨hC₁.1, lrProbeTypePiKClosedCtxMaj_trans hW hΓ hC₁.2 hC₂.2⟩
      | piBotNil =>
          have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ (.pi .bot []) :=
            (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hC₁.2.2.2).2
          rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂) with hP | hC₂
          · exact Or.inl hP
          · exact Or.inr ⟨rfl, rfl, hC₁.2.2.1,
              lrProbeTypePiKClosedCtxMaj_trans hW hΓ hC₁.2.2.2 hC₂.2.2.2⟩
  · rcases h₂ c hc (Or.inr hM₃) with hP | hC₂
    · exact Or.inl hP
    · cases hc with
      | bot => exact Or.inr trivial
      | sort =>
          have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ .sort :=
            (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hC₂.2).1
          rcases h₁ .sort .sort (Or.inr hM₂) with hP | hC₁
          · exact Or.inl hP
          · exact Or.inr ⟨hC₁.1, lrProbeTypePiKClosedCtxMaj_trans hW hΓ hC₁.2 hC₂.2⟩
      | piBotNil =>
          have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ (.pi .bot []) :=
            (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hC₂.2.2.2).1
          rcases h₁ (.pi .bot []) .piBotNil (Or.inr hM₂) with hP | hC₁
          · exact Or.inl hP
          · exact Or.inr ⟨rfl, rfl, hC₁.2.2.1,
              lrProbeTypePiKClosedCtxMaj_trans hW hΓ hC₁.2.2.2 hC₂.2.2.2⟩

theorem lrTermNoPiMajSemBi_whRedPiKClosedCtxMaj_expand {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hM : WhRedPiKClosedCtxMaj E Γ M M')
    (hN : WhRedPiKClosedCtxMaj E Γ N N')
    (h : LRTermNoPiMajSemBi E n Γ M' N' A) :
    LRTermNoPiMajSemBi E n Γ M N A := by
