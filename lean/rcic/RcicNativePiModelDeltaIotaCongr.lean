/-- **Right-Argument Application Transfer of `ApproxDIK` Under `PrunedSemEqDIK`
    (`approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK`):**
    Because `instantiate0 a (.app (lift 0 1 f) (.bvar 0)) = .app f a`,
    `approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK` immediately implies that for **every**
    `f : Expr Nat` and **every** `PrunedPiCpt c`:
    `ApproxDIK E (ctxEnvDIK E Γ) (.app f a₁) c ↔ ApproxDIK E (ctxEnvDIK E Γ) (.app f a₂) c`
    whenever `PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂` (with **zero `EnvWfT` and zero `CtxWfT`**)! -/
theorem approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    (f : Expr Nat) {a₁ a₂ : Expr Nat}
    (ha : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    {c : CptI} (hc : PrunedPiCpt c) :
    ApproxDIK E (ctxEnvDIK E Γ) (.app f a₁) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (.app f a₂) c := by
  have h :=
    approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK ha (.app (lift 0 1 f) (.bvar 0)) hc
  rwa [instantiate0_app_lift0_bvar0_arg f a₁, instantiate0_app_lift0_bvar0_arg f a₂] at h

/-- **Two-Sided Application Congruence of `PrunedSemEqDIK` in `ctxEnvDIK`
    (`prunedSemEqDIK_ctxEnvDIK_app_congr`):**
    Combines §29.1's `approxDIK_ctxEnvDIK_app_fn_iff_of_prunedSemEqDIK` and
    `approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK` with **zero `EnvWfT` and zero `CtxWfT`**! -/
theorem prunedSemEqDIK_ctxEnvDIK_app_congr {E : ResolvedEnv} {Γ : LCtx}
    {f₁ f₂ a₁ a₂ : Expr Nat}
    (hf : PrunedSemEqDIK E (ctxEnvDIK E Γ) f₁ f₂)
    (ha : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) (.app f₁ a₁) (.app f₂ a₂) :=
  fun _ hc =>
    (approxDIK_ctxEnvDIK_app_fn_iff_of_prunedSemEqDIK hf a₁ hc).trans
      (approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK f₂ ha hc)

/-- **Recursor Major-Premise Transfer of `ApproxDIK` Under `PrunedSemEqDIK`
    (`approxDIK_ctxEnvDIK_recCall_iff_of_prunedSemEqDIK`):** -/
theorem approxDIK_ctxEnvDIK_recCall_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    (rec : Expr Nat) (pre : List (Expr Nat)) {a₁ a₂ : Expr Nat}
    (ha : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    {c : CptI} (hc : PrunedPiCpt c) :
    ApproxDIK E (ctxEnvDIK E Γ) (recCall rec pre a₁) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (recCall rec pre a₂) c := by
  simpa only [recCall, foldApps_snoc] using
    approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK (foldApps rec pre) ha hc

/-- `PrunedSemEqDIK` congruence of `recCall` across `PrunedSemEqDIK`-equal major premises
    (`prunedSemEqDIK_ctxEnvDIK_recCall`). -/
theorem prunedSemEqDIK_ctxEnvDIK_recCall {E : ResolvedEnv} {Γ : LCtx}
    (rec : Expr Nat) (pre : List (Expr Nat)) {a₁ a₂ : Expr Nat}
    (ha : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) (recCall rec pre a₁) (recCall rec pre a₂) :=
  fun _ hc => approxDIK_ctxEnvDIK_recCall_iff_of_prunedSemEqDIK rec pre ha hc

/-- **Recursor Spine Major-Premise Transfer of `ApproxDIK` Across Arbitrary Post-Major Spines `rest`
    (`approxDIK_ctxEnvDIK_recursor_foldApps_iff_of_prunedSemEqDIK`):** -/
theorem approxDIK_ctxEnvDIK_recursor_foldApps_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    (rec : Expr Nat) (pre : List (Expr Nat)) {a₁ a₂ : Expr Nat}
    (ha : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (rest : List (Expr Nat)) {c : CptI} (hc : PrunedPiCpt c) :
    ApproxDIK E (ctxEnvDIK E Γ) (foldApps (recCall rec pre a₁) rest) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps (recCall rec pre a₂) rest) c :=
  approxDIK_ctxEnvDIK_foldApps_fn_iff_of_prunedSemEqDIK
    (prunedSemEqDIK_ctxEnvDIK_recCall rec pre ha) rest hc

/-- **Simultaneous Constructor-Spine Reduction on Both `a₁` and `a₂` Under `PrunedSemEqDIK` and
    Normalization (`whRedPiKClosedCtxMaj_ctor_both_of_prunedSemEqDIK_and_normalizes`):**
    Because `ctorTagCpt w'` is a `PrunedPiCpt`, if `a₁` and `a₂` are `PrunedSemEqDIK`-equal and both
    normalize under `WhRedPiKClosedCtxMaj E Γ`, then `ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w')`
    forces **both** `a₁` and `a₂` to reduce under `WhRedPiKClosedCtxMaj E Γ` to canonical
    `w'.ctorRef` constructor spines! -/
theorem whRedPiKClosedCtxMaj_ctor_both_of_prunedSemEqDIK_and_normalizes
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w' : IotaWitnessS E) {a₁ a₂ : Expr Nat}
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w')) :
    (∃ (lsC₁ : List Level) (params₁ fields₁ : List (Expr Nat)),
      params₁.length = w'.nparams ∧
      fields₁.length = w'.fields.length ∧
      WhRedPiKClosedCtxMaj E Γ a₁ (foldApps (.const w'.ctorRef lsC₁) (params₁ ++ fields₁))) ∧
    (∃ (lsC₂ : List Level) (params₂ fields₂ : List (Expr Nat)),
      params₂.length = w'.nparams ∧
      fields₂.length = w'.fields.length ∧
      WhRedPiKClosedCtxMaj E Γ a₂ (foldApps (.const w'.ctorRef lsC₂) (params₂ ++ fields₂))) := by
  have htag₂ : ApproxDIK E (ctxEnvDIK E Γ) a₂ (ctorTagCpt w') :=
    (ha_sem (ctorTagCpt w') (prunedPiCpt_ctorTagCpt w')).mp htag₁
  obtain ⟨nf₁, hred₁, hnf₁⟩ := hnorm₁
  obtain ⟨nf₂, hred₂, hnf₂⟩ := hnorm₂
  exact ⟨(approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes hW w' hred₁ hnf₁).mp htag₁,
         (approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes hW w' hred₂ hnf₂).mp htag₂⟩

/-- **Simultaneous $\iota$-Reduction of Both Recursor Spines Under `PrunedSemEqDIK` and
    Major-Premise Normalization (`whRedPiKClosedCtxMaj_recursor_foldApps_both_of_prunedSemEqDIK_and_normalizes`):** -/
theorem whRedPiKClosedCtxMaj_recursor_foldApps_both_of_prunedSemEqDIK_and_normalizes
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w w' : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    (hrecEq : w'.recRef = w.recRef)
    {a₁ a₂ : Expr Nat} (rest : List (Expr Nat))
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w')) :
    ∃ (lsC₁ lsC₂ : List Level) (params₁ fields₁ params₂ fields₂ : List (Expr Nat)),
      params₁.length = w'.nparams ∧
      fields₁.length = w'.fields.length ∧
      params₂.length = w'.nparams ∧
      fields₂.length = w'.fields.length ∧
      WhRedPiKClosedCtxMaj E Γ a₁ (foldApps (.const w'.ctorRef lsC₁) (params₁ ++ fields₁)) ∧
      WhRedPiKClosedCtxMaj E Γ a₂ (foldApps (.const w'.ctorRef lsC₂) (params₂ ++ fields₂)) ∧
      WhRedPiKClosedCtxMaj E Γ
        (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
        (foldApps (instPrefix (pre ++ fields₁) (instantiateLevels ls w'.schema)) rest) ∧
      WhRedPiKClosedCtxMaj E Γ
        (foldApps (recCall (.const w.recRef ls) pre a₂) rest)
        (foldApps (instPrefix (pre ++ fields₂) (instantiateLevels ls w'.schema)) rest) := by
  obtain ⟨⟨lsC₁, params₁, fields₁, hpar₁, hflds₁, hctor₁⟩,
          ⟨lsC₂, params₂, fields₂, hpar₂, hflds₂, hctor₂⟩⟩ :=
    whRedPiKClosedCtxMaj_ctor_both_of_prunedSemEqDIK_and_normalizes hW w' ha_sem hnorm₁ hnorm₂ htag₁
  have hpre' : pre.length = w'.preMajor.length := by
    rw [hpre, (iotaWitnessS_same_recRef w' w hrecEq).2.1]
  have hred₁ : WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (instPrefix (pre ++ fields₁) (instantiateLevels ls w'.schema)) rest) := by
    rw [← hrecEq]
    exact whRedPiKClosedCtxMaj_recursor_foldApps_of_whRed_ctor hW w' ls lsC₁ rest hpre' hpar₁ hflds₁
      hctor₁
  have hred₂ : WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre a₂) rest)
      (foldApps (instPrefix (pre ++ fields₂) (instantiateLevels ls w'.schema)) rest) := by
    rw [← hrecEq]
    exact whRedPiKClosedCtxMaj_recursor_foldApps_of_whRed_ctor hW w' ls lsC₂ rest hpre' hpar₂ hflds₂
      hctor₂
  exact ⟨lsC₁, lsC₂, params₁, fields₁, params₂, fields₂,
    hpar₁, hflds₁, hpar₂, hflds₂, hctor₁, hctor₂, hred₁, hred₂⟩

/-- **Identical $\iota$-Contracta on Both Recursor Spines for Any 0-Field Constructor Branch
    (`whRedPiKClosedCtxMaj_recursor_foldApps_same_of_zero_fields`):**
    Because `WhStep.iotaS` discards constructor parameters `paramsᵢ` and universe levels `lsCᵢ`,
    whenever `w'.fields = []` (any 0-field constructor such as `Nat.zero`, `Bool.true`, `Bool.false`,
    `List.nil`, `True.intro`, `Eq.refl`), `fields₁ = []` and `fields₂ = []`, so **both**
    `foldApps (recCall (.const w.recRef ls) pre a₁) rest` and
    `foldApps (recCall (.const w.recRef ls) pre a₂) rest` reduce under `WhRedPiKClosedCtxMaj E Γ` to
    the **exact same expression** `foldApps (instPrefix pre (instantiateLevels ls w'.schema)) rest`! -/
theorem whRedPiKClosedCtxMaj_recursor_foldApps_same_of_zero_fields
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w w' : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    (hrecEq : w'.recRef = w.recRef)
    (hflds0 : w'.fields = [])
    {a₁ a₂ : Expr Nat} (rest : List (Expr Nat))
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w')) :
    WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (instPrefix pre (instantiateLevels ls w'.schema)) rest) ∧
    WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre a₂) rest)
      (foldApps (instPrefix pre (instantiateLevels ls w'.schema)) rest) := by
  obtain ⟨_, _, _, fields₁, _, fields₂, _, hflds₁, _, hflds₂, _, _, hred₁, hred₂⟩ :=
    whRedPiKClosedCtxMaj_recursor_foldApps_both_of_prunedSemEqDIK_and_normalizes
      hW w w' ls hpre hrecEq rest ha_sem hnorm₁ hnorm₂ htag₁
  rw [hflds0, List.length_nil] at hflds₁ hflds₂
  have hf₁ : fields₁ = [] := List.eq_nil_of_length_eq_zero hflds₁
  have hf₂ : fields₂ = [] := List.eq_nil_of_length_eq_zero hflds₂
  subst hf₁; subst hf₂
  rw [List.append_nil] at hred₁ hred₂
  exact ⟨hred₁, hred₂⟩

/-- **Unconditional Recursor Major-Premise Congruence in `LRTermMajSemBi` for Any 0-Field
    Constructor Branch (`lrTermMajSemBi_recursor_foldApps_of_zero_fields`):**
    Requires **only** the left diagonal `hdiag₁`! -/
theorem lrTermMajSemBi_recursor_foldApps_of_zero_fields
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) {Γ : LCtx}
    (w w' : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    (hrecEq : w'.recRef = w.recRef)
    (hflds0 : w'.fields = [])
    {a₁ a₂ T : Expr Nat} (rest : List (Expr Nat))
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w'))
    (hdiag₁ : LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest) T) :
    LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₂) rest) T := by
  obtain ⟨hred₁, hred₂⟩ :=
    whRedPiKClosedCtxMaj_recursor_foldApps_same_of_zero_fields
      hW w w' ls hpre hrecEq hflds0 rest ha_sem hnorm₁ hnorm₂ htag₁
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred₁ hred₂
    (lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred₁ hred₁ hdiag₁)

/-- **Master Constructive Recursor Major-Premise Congruence When `a₁` Has No Fieldful Constructor
    Tag (`lrTermMajSemBi_recursor_foldApps_of_no_fieldful_ctorTag`):**
    Simultaneously covers:
    1. **all non-K non-constructor majors** (where both sides have only `.bot` probes),
    2. **all K-recursor non-constructor majors** (where both sides reduce via `.iotaKClosedCtx` to
       the exact same expression `foldApps (instPrefix (pre ++ replicate w.fields.length botClosedExpr) ...) rest`), AND
    3. **all 0-field constructor majors** (`w'.fields = []`, where both sides reduce via `.iotaS`
       to the exact same expression `foldApps (instPrefix pre (instantiateLevels ls w'.schema)) rest`),
    from the left diagonal `hdiag₁` alone, **constructively (zero `Classical.choice`)**! -/
theorem lrTermMajSemBi_recursor_foldApps_of_no_fieldful_ctorTag
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {a₁ a₂ T : Expr Nat} (rest : List (Expr Nat))
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (hno_flds : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef → w'.fields ≠ [] →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w'))
    (hdiag₁ : LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest) T) :
    LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₂) rest) T := by
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have h₁ : ApproxDIK E (ctxEnvDIK E Γ) (foldApps (recCall (.const w.recRef ls) pre a₁) rest) c :=
    hor.elim id (fun h₂ =>
      (approxDIK_ctxEnvDIK_recursor_foldApps_iff_of_prunedSemEqDIK
        (.const w.recRef ls) pre ha_sem rest hc_p).mpr h₂)
  cases hc with
  | bot => exact Or.inr (Or.inr (.bot Γ _ _))
  | sort =>
      obtain ⟨d, hd, hfold⟩ := (approxDIK_foldApps_iff _ _ _ _ _).mp h₁
      have hd_ne : d ≠ .bot := fun h0 => by subst h0; cases foldAppCptK_bot_inv hfold
      rcases approxDIK_recCall_nonbot_of_major_normalizes_inv hW w ls hpre hd_ne hd hnorm₁ with
        ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, _⟩ |
        ⟨hk, hnot_tag₁, _⟩
      · have htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w') :=
          (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_ctor (ctorTagCpt w')).mpr
            (approxDIK_ctorTagCpt_of_ctor_spine hW w' lsC
              (by rw [List.length_append, hpar, hflds]) (ctxEnvDIK E Γ))
        cases hflds_case : w'.fields with
        | nil =>
            exact lrTermMajSemBi_recursor_foldApps_of_zero_fields hW w w' ls hpre hrecEq
              hflds_case rest ha_sem hnorm₁ hnorm₂ htag₁ hdiag₁ .sort .sort hor
        | cons f₀ fs =>
            exact (hno_flds w' hrecEq (by rw [hflds_case]; intro h0; cases h0) htag₁).elim
      · have hnot_tag₂ : ¬ ApproxDIK E (ctxEnvDIK E Γ) a₂ (ctorTagCpt w) :=
          fun h₂ => hnot_tag₁ ((ha_sem (ctorTagCpt w) (prunedPiCpt_ctorTagCpt w)).mpr h₂)
        have hred₁ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre hnot_tag₁
        have hred₂ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre hnot_tag₂
        exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred₁ hred₂
          (lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred₁ hred₁ hdiag₁) .sort .sort hor
  | piBotNil =>
      obtain ⟨d, hd, hfold⟩ := (approxDIK_foldApps_iff _ _ _ _ _).mp h₁
      have hd_ne : d ≠ .bot := fun h0 => by subst h0; cases foldAppCptK_bot_inv hfold
      rcases approxDIK_recCall_nonbot_of_major_normalizes_inv hW w ls hpre hd_ne hd hnorm₁ with
        ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, _⟩ |
        ⟨hk, hnot_tag₁, _⟩
      · have htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w') :=
          (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_ctor (ctorTagCpt w')).mpr
            (approxDIK_ctorTagCpt_of_ctor_spine hW w' lsC
              (by rw [List.length_append, hpar, hflds]) (ctxEnvDIK E Γ))
        cases hflds_case : w'.fields with
        | nil =>
            exact lrTermMajSemBi_recursor_foldApps_of_zero_fields hW w w' ls hpre hrecEq
              hflds_case rest ha_sem hnorm₁ hnorm₂ htag₁ hdiag₁ (.pi .bot []) .piBotNil hor
        | cons f₀ fs =>
            exact (hno_flds w' hrecEq (by rw [hflds_case]; intro h0; cases h0) htag₁).elim
      · have hnot_tag₂ : ¬ ApproxDIK E (ctxEnvDIK E Γ) a₂ (ctorTagCpt w) :=
          fun h₂ => hnot_tag₁ ((ha_sem (ctorTagCpt w) (prunedPiCpt_ctorTagCpt w)).mpr h₂)
        have hred₁ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre hnot_tag₁
        have hred₂ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre hnot_tag₂
        exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred₁ hred₂
          (lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred₁ hred₁ hdiag₁)
          (.pi .bot []) .piBotNil hor

/-- **Unconditional Recursor Major-Premise Congruence for Inductive Families Whose Constructors
    All Have 0 Fields (`lrTermMajSemBi_recursor_foldApps_of_all_zero_fields`):**
    For any inductive family whose constructors all have `w'.fields = []` (such as `Bool`, `True`,
    `False`, `Unit`/`PUnit`, `Eq`, or any enumeration type), major-premise congruence holds across
    **all** `PrunedSemEqDIK`-equal normalizing major premises `a₁, a₂` from `hdiag₁` alone! -/
theorem lrTermMajSemBi_recursor_foldApps_of_all_zero_fields
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {a₁ a₂ T : Expr Nat} (rest : List (Expr Nat))
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (hall0 : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef → w'.fields = [])
    (hdiag₁ : LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest) T) :
    LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w.recRef ls) pre a₁) rest)
      (foldApps (recCall (.const w.recRef ls) pre a₂) rest) T :=
  lrTermMajSemBi_recursor_foldApps_of_no_fieldful_ctorTag hW w ls hpre rest ha_sem hnorm₁ hnorm₂
    (fun w' hrecEq hne => (hne (hall0 w' hrecEq)).elim) hdiag₁

/-! ### §32.2. Applicative Function Companion (`LRAppFnDiagMajSemBi` / `LRAppFnLeftMajSemBi` /
`LRAppFnMajSemBi`) and 1-Step $\eta$-Application Equivalence -/

/-- **Diagonal Applicative Function Companion (`LRAppFnDiagMajSemBi E n Γ f A B`):**
    Asserts that for every well-typed argument `ha : HasTyT E n Γ a A` satisfying its diagonal
    relation `ih_a : LRTermMajSemBi E n Γ a a A`, the application `.app f a` satisfies its diagonal
    relation `LRTermMajSemBi E n Γ (.app f a) (.app f a) (instantiate0 a B)`. -/
def LRAppFnDiagMajSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (f A B : Expr Nat) : Prop :=
  ∀ {a : Expr Nat},
    HasTyT E n Γ a A →
    LRTermMajSemBi E n Γ a a A →
    LRTermMajSemBi E n Γ (.app f a) (.app f a) (instantiate0 a B)

/-- **Left-Head Applicative Function Companion (`LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B`):**
    Asserts that for every well-typed argument `ha : HasTyT E n Γ a A` satisfying its diagonal
    relation `ih_a : LRTermMajSemBi E n Γ a a A`, `.app f₁ a` and `.app f₂ a` are related in
    `LRTermMajSemBi E n Γ (.app f₁ a) (.app f₂ a) (instantiate0 a B)`. -/
def LRAppFnLeftMajSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (f₁ f₂ A B : Expr Nat) : Prop :=
  ∀ {a : Expr Nat},
    HasTyT E n Γ a A →
    LRTermMajSemBi E n Γ a a A →
    LRTermMajSemBi E n Γ (.app f₁ a) (.app f₂ a) (instantiate0 a B)

/-- **Two-Sided Applicative Function Companion (`LRAppFnMajSemBi E n Γ f₁ f₂ A B`):**
    Asserts that for all convertible arguments `a₁, a₂` (`hca : ConvT E n Γ a₁ a₂ A`) related in
    `ih_a : LRTermMajSemBi E n Γ a₁ a₂ A`, the applications `.app f₁ a₁` and `.app f₂ a₂` are
    related in `LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B)`. -/
def LRAppFnMajSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (f₁ f₂ A B : Expr Nat) : Prop :=
  ∀ {a₁ a₂ : Expr Nat},
    HasTyT E n Γ a₁ A → HasTyT E n Γ a₂ A → ConvT E n Γ a₁ a₂ A →
    LRTermMajSemBi E n Γ a₁ a₂ A →
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B)

/-- Every `LRAppFnMajSemBi E n Γ f₁ f₂ A B` implies `LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B`
    (`lrAppFnLeftMajSemBi_of_lrAppFnMajSemBi`). -/
theorem lrAppFnLeftMajSemBi_of_lrAppFnMajSemBi {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f₁ f₂ A B : Expr Nat}
    (hf : LRAppFnMajSemBi E n Γ f₁ f₂ A B) :
    LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B :=
  fun ha ih_a => hf ha ha (.refl Γ _ A ha) ih_a

/-- Left-endpoint diagonal projection from `LRAppFnMajSemBi` to `LRAppFnDiagMajSemBi`
    (`lrAppFnMajSemBi_diag_left`). -/
theorem lrAppFnMajSemBi_diag_left {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f₁ f₂ A B : Expr Nat}
    (hf : LRAppFnMajSemBi E n Γ f₁ f₂ A B) :
    LRAppFnDiagMajSemBi E n Γ f₁ A B :=
  fun ha ih_a => lrTermMajSemBi_diag_left (hf ha ha (.refl Γ _ A ha) ih_a)

/-- `AppDiagSupplyMajSemBi E n` implies `LRAppFnDiagMajSemBi E n Γ f A B` for every well-typed
    function `hf : HasTyT E n Γ f (.pi A B)` satisfying `ih_f : LRTermMajSemBi E n Γ f f (.pi A B)`
    (`lrAppFnDiagMajSemBi_of_appDiagSupply`). -/
theorem lrAppFnDiagMajSemBi_of_appDiagSupply {E : ResolvedEnv} {n : Nat}
    (hAppDiag : AppDiagSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {f A B : Expr Nat}
    (hf : HasTyT E n Γ f (.pi A B))
    (ih_f : LRTermMajSemBi E n Γ f f (.pi A B)) :
    LRAppFnDiagMajSemBi E n Γ f A B :=
  fun ha ih_a => hAppDiag hΓ hf ha ih_f ih_a

/-- `AppDiagSupplyMajSemBi E n` and `TypedSubst0CongrSupplyMajSemBi E n` imply
    `LRAppFnMajSemBi E n Γ f₁ f₂ A B` for every convertible function pair
    `hcf : ConvT E n Γ f₁ f₂ (.pi A B)` satisfying `ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B)`
    (`lrAppFnMajSemBi_of_appDiag_and_typedSubst0`). -/
theorem lrAppFnMajSemBi_of_appDiag_and_typedSubst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAppDiag : AppDiagSupplyMajSemBi E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {f₁ f₂ A B : Expr Nat}
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B))
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B)) :
    LRAppFnMajSemBi E n Γ f₁ f₂ A B :=
  fun _ _ hca ih_a =>
    lrTermMajSemBi_app_congr_of_appDiag_and_typedSubst0 hW hAppDiag hSubst0 hΓ hcf hca ih_f ih_a

/-- Symmetry of `LRAppFnLeftMajSemBi` (`lrAppFnLeftMajSemBi_symm`, requiring **zero `TyConvT`**). -/
theorem lrAppFnLeftMajSemBi_symm {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {f₁ f₂ A B : Expr Nat}
    (hf : LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B) :
    LRAppFnLeftMajSemBi E n Γ f₂ f₁ A B :=
  fun ha ih_a => lrTermMajSemBi_symm hW hΓ (hf ha ih_a)

/-- Transitivity of `LRAppFnLeftMajSemBi` (`lrAppFnLeftMajSemBi_trans`, requiring **zero `TyConvT`**). -/
theorem lrAppFnLeftMajSemBi_trans {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {f₁ f₂ f₃ A B : Expr Nat}
    (hf₁₂ : LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B)
    (hf₂₃ : LRAppFnLeftMajSemBi E n Γ f₂ f₃ A B) :
    LRAppFnLeftMajSemBi E n Γ f₁ f₃ A B :=
  fun ha ih_a => lrTermMajSemBi_trans hW hΓ (hf₁₂ ha ih_a) (hf₂₃ ha ih_a)

/-- **Transitivity of `LRAppFnMajSemBi` Requiring Zero `TyConvT` (`lrAppFnMajSemBi_trans`):**
    Because `.app f₁ a₁ ~ .app f₂ a₁` and `.app f₂ a₁ ~ .app f₃ a₂` are both evaluated at the
    **exact same type** `instantiate0 a₁ B`, `lrTermMajSemBi_trans` composes them with **zero `TyConvT`**! -/
theorem lrAppFnMajSemBi_trans {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {f₁ f₂ f₃ A B : Expr Nat}
    (hf₁₂ : LRAppFnMajSemBi E n Γ f₁ f₂ A B)
    (hf₂₃ : LRAppFnMajSemBi E n Γ f₂ f₃ A B) :
    LRAppFnMajSemBi E n Γ f₁ f₃ A B :=
  fun ha₁ ha₂ hca ih_a =>
    lrTermMajSemBi_trans hW hΓ
      (hf₁₂ ha₁ ha₁ (.refl Γ _ A ha₁) (lrTermMajSemBi_diag_left ih_a))
      (hf₂₃ ha₁ ha₂ hca ih_a)

/-- Two-way invariance (`↔`) of `LRAppFnDiagMajSemBi` under `WhRedPiKClosedCtxMaj`
    (`lrAppFnDiagMajSemBi_whRedPiKClosedCtxMaj_iff`). -/
theorem lrAppFnDiagMajSemBi_whRedPiKClosedCtxMaj_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f f' A B : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E Γ f f') :
    LRAppFnDiagMajSemBi E n Γ f A B ↔ LRAppFnDiagMajSemBi E n Γ f' A B :=
  ⟨fun h {a} ha ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred [a])
       (whRedPiKClosedCtxMaj_foldApps hred [a])).mp (h ha ih_a),
   fun h {a} ha ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred [a])
       (whRedPiKClosedCtxMaj_foldApps hred [a])).mpr (h ha ih_a)⟩

/-- Two-way invariance (`↔`) of `LRAppFnLeftMajSemBi` under `WhRedPiKClosedCtxMaj`
    (`lrAppFnLeftMajSemBi_whRedPiKClosedCtxMaj_iff`). -/
theorem lrAppFnLeftMajSemBi_whRedPiKClosedCtxMaj_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f₁ f₁' f₂ f₂' A B : Expr Nat}
    (hred₁ : WhRedPiKClosedCtxMaj E Γ f₁ f₁')
    (hred₂ : WhRedPiKClosedCtxMaj E Γ f₂ f₂') :
    LRAppFnLeftMajSemBi E n Γ f₁ f₂ A B ↔ LRAppFnLeftMajSemBi E n Γ f₁' f₂' A B :=
  ⟨fun h {a} ha ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred₁ [a])
       (whRedPiKClosedCtxMaj_foldApps hred₂ [a])).mp (h ha ih_a),
   fun h {a} ha ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred₁ [a])
       (whRedPiKClosedCtxMaj_foldApps hred₂ [a])).mpr (h ha ih_a)⟩

/-- Two-way invariance (`↔`) of `LRAppFnMajSemBi` under `WhRedPiKClosedCtxMaj`
    (`lrAppFnMajSemBi_whRedPiKClosedCtxMaj_iff`). -/
theorem lrAppFnMajSemBi_whRedPiKClosedCtxMaj_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f₁ f₁' f₂ f₂' A B : Expr Nat}
    (hred₁ : WhRedPiKClosedCtxMaj E Γ f₁ f₁')
    (hred₂ : WhRedPiKClosedCtxMaj E Γ f₂ f₂') :
    LRAppFnMajSemBi E n Γ f₁ f₂ A B ↔ LRAppFnMajSemBi E n Γ f₁' f₂' A B :=
  ⟨fun h {a₁ a₂} ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred₁ [a₁])
       (whRedPiKClosedCtxMaj_foldApps hred₂ [a₂])).mp (h ha₁ ha₂ hca ih_a),
   fun h {a₁ a₂} ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
       (whRedPiKClosedCtxMaj_foldApps hred₁ [a₁])
       (whRedPiKClosedCtxMaj_foldApps hred₂ [a₂])).mpr (h ha₁ ha₂ hca ih_a)⟩

/-- **1-Step $\beta$-Reduction of Applied $\eta$-Expansion (`whStep_eta_app`):**
    For **every** expression `f` and argument `a`, `.app (.lam A (.app (lift 0 1 f) (.bvar 0))) a`
    steps in 1 `WhStep.beta` step to `.app f a`! -/
theorem whStep_eta_app {E : ResolvedEnv} (A f a : Expr Nat) :
    WhStep E (.app (.lam A (.app (lift 0 1 f) (.bvar 0))) a) (.app f a) := by
  simpa only [instantiate0_app_lift0_bvar0_arg f a] using
    WhStep.beta A (.app (lift 0 1 f) (.bvar 0)) a

/-- 1-step `WhStepPiKClosedCtxMaj` reduction of applied $\eta$-expansion
    (`whStepPiKClosedCtxMaj_eta_app`). -/
theorem whStepPiKClosedCtxMaj_eta_app {E : ResolvedEnv} (Γ : LCtx) (A f a : Expr Nat) :
    WhStepPiKClosedCtxMaj E Γ (.app (.lam A (.app (lift 0 1 f) (.bvar 0))) a) (.app f a) :=
  .of_whStep (whStep_eta_app A f a)

/-- Two-way invariance (`↔`) of `LRTermMajSemBi` under $\eta$-expansion of the left function head
    (`lrTermMajSemBi_eta_app_left_iff`). -/
theorem lrTermMajSemBi_eta_app_left_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A f₁ f₂ a₁ a₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app (.lam A (.app (lift 0 1 f₁) (.bvar 0))) a₁) (.app f₂ a₂) T ↔
      LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) T :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
    (.step (whStepPiKClosedCtxMaj_eta_app Γ A f₁ a₁) (.refl _)) (.refl _)

/-- Two-way invariance (`↔`) of `LRTermMajSemBi` under $\eta$-expansion of the right function head
    (`lrTermMajSemBi_eta_app_right_iff`). -/
theorem lrTermMajSemBi_eta_app_right_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A f₁ f₂ a₁ a₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app (.lam A (.app (lift 0 1 f₂) (.bvar 0))) a₂) T ↔
      LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) T :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
    (.refl _) (.step (whStepPiKClosedCtxMaj_eta_app Γ A f₂ a₂) (.refl _))

/-- Two-way invariance (`↔`) of `LRTermMajSemBi` under $\eta$-expansion of both function heads
    (`lrTermMajSemBi_eta_app_both_iff`). -/
theorem lrTermMajSemBi_eta_app_both_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A₁ A₂ f₁ f₂ a₁ a₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ
        (.app (.lam A₁ (.app (lift 0 1 f₁) (.bvar 0))) a₁)
        (.app (.lam A₂ (.app (lift 0 1 f₂) (.bvar 0))) a₂) T ↔
      LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) T :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_iff hW
    (.step (whStepPiKClosedCtxMaj_eta_app Γ A₁ f₁ a₁) (.refl _))
    (.step (whStepPiKClosedCtxMaj_eta_app Γ A₂ f₂ a₂) (.refl _))

/-- **Exact $\eta$-Expansion Biconditional (`↔`) for `LRAppFnDiagMajSemBi`
    (`lrAppFnDiagMajSemBi_eta_iff`):**
    For **every** expression `f`, `LRAppFnDiagMajSemBi E n Γ (.lam A' (.app (lift 0 1 f) (.bvar 0))) A B`
    is equivalent (`↔`) to `LRAppFnDiagMajSemBi E n Γ f A B`! -/
theorem lrAppFnDiagMajSemBi_eta_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A' f A B : Expr Nat) :
    LRAppFnDiagMajSemBi E n Γ (.lam A' (.app (lift 0 1 f) (.bvar 0))) A B ↔
      LRAppFnDiagMajSemBi E n Γ f A B :=
  ⟨fun h _ ha ih_a => (lrTermMajSemBi_eta_app_both_iff hW A' A' f f _ _ _).mp (h ha ih_a),
   fun h _ ha ih_a => (lrTermMajSemBi_eta_app_both_iff hW A' A' f f _ _ _).mpr (h ha ih_a)⟩

/-- **Exact Right $\eta$-Expansion Biconditional (`↔`) for `LRAppFnMajSemBi`
    (`lrAppFnMajSemBi_eta_right_iff`):** -/
theorem lrAppFnMajSemBi_eta_right_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A' f₁ f₂ A B : Expr Nat) :
    LRAppFnMajSemBi E n Γ f₁ (.lam A' (.app (lift 0 1 f₂) (.bvar 0))) A B ↔
      LRAppFnMajSemBi E n Γ f₁ f₂ A B :=
  ⟨fun h _ _ ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_eta_app_right_iff hW A' f₁ f₂ _ _ _).mp (h ha₁ ha₂ hca ih_a),
   fun h _ _ ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_eta_app_right_iff hW A' f₁ f₂ _ _ _).mpr (h ha₁ ha₂ hca ih_a)⟩

/-- **Exact Left $\eta$-Expansion Biconditional (`↔`) for `LRAppFnMajSemBi`
    (`lrAppFnMajSemBi_eta_left_iff`):** -/
theorem lrAppFnMajSemBi_eta_left_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A' f₁ f₂ A B : Expr Nat) :
    LRAppFnMajSemBi E n Γ (.lam A' (.app (lift 0 1 f₁) (.bvar 0))) f₂ A B ↔
      LRAppFnMajSemBi E n Γ f₁ f₂ A B :=
  ⟨fun h _ _ ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_eta_app_left_iff hW A' f₁ f₂ _ _ _).mp (h ha₁ ha₂ hca ih_a),
   fun h _ _ ha₁ ha₂ hca ih_a =>
     (lrTermMajSemBi_eta_app_left_iff hW A' f₁ f₂ _ _ _).mpr (h ha₁ ha₂ hca ih_a)⟩

/-- **Exact `ConvT.eta` Equivalence (`↔`) in `LRAppFnMajSemBi` (`lrAppFnMajSemBi_eta_iff`):**
    Under `EnvWfT E`, `LRAppFnMajSemBi E n Γ f (.lam A' (.app (lift 0 1 f) (.bvar 0))) A B` is
    equivalent (`↔`) to the diagonal `LRAppFnMajSemBi E n Γ f f A B`! -/
theorem lrAppFnMajSemBi_eta_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (A' f A B : Expr Nat) :
    LRAppFnMajSemBi E n Γ f (.lam A' (.app (lift 0 1 f) (.bvar 0))) A B ↔
      LRAppFnMajSemBi E n Γ f f A B :=
  lrAppFnMajSemBi_eta_right_iff hW A' f f A B

/-- **Unconditional `LRAppFnDiagMajSemBi` for Any Function Reducing to `.lam A b`
    (`lrAppFnDiagMajSemBi_of_whRed_lam`):**
    Requires **only** the let-context body diagonal `hb_let` (and **zero `ih_a`**)! -/
theorem lrAppFnDiagMajSemBi_of_whRed_lam {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f A b B : Expr Nat}
    (hf : WhRedPiKClosedCtxMaj E Γ f (.lam A b))
    (hb_let : ∀ {a : Expr Nat}, HasTyT E n Γ a A →
      LRTermMajSemBi E n (.letBinding A a :: Γ) b b B) :
    LRAppFnDiagMajSemBi E n Γ f A B :=
  fun ha _ => lrTermMajSemBi_app_lam_same_arg hW hf hf ha (hb_let ha)

/-- **Unconditional `LRAppFnDiagMajSemBi` for `.lam A b` (`lrAppFnDiagMajSemBi_lam`):**
    Requires **only** `hb_let` (and **zero `ih_a`**)! -/
theorem lrAppFnDiagMajSemBi_lam {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A b B : Expr Nat}
    (hb_let : ∀ {a : Expr Nat}, HasTyT E n Γ a A →
      LRTermMajSemBi E n (.letBinding A a :: Γ) b b B) :
    LRAppFnDiagMajSemBi E n Γ (.lam A b) A B :=
  lrAppFnDiagMajSemBi_of_whRed_lam hW (.refl _) hb_let

/-- **Unconditional `LRAppFnLeftMajSemBi` for Functions Reducing to `.lam A₁ b₁` and `.lam A₂ b₂`
    (`lrAppFnLeftMajSemBi_of_whRed_lam`):** -/
theorem lrAppFnLeftMajSemBi_of_whRed_lam {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f₁ f₂ A₁ A₂ b₁ b₂ B : Expr Nat}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (.lam A₁ b₁))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (.lam A₂ b₂))
    (hb_let : ∀ {a : Expr Nat}, HasTyT E n Γ a A₁ →
      LRTermMajSemBi E n (.letBinding A₁ a :: Γ) b₁ b₂ B) :
    LRAppFnLeftMajSemBi E n Γ f₁ f₂ A₁ B :=
  fun ha _ => lrTermMajSemBi_app_lam_same_arg hW hf₁ hf₂ ha (hb_let ha)

/-- Unconditional `LRAppFnMajSemBi` for any $\Pi$-codomain `B = .pi D C`
    (`lrAppFnMajSemBi_of_pi_codomain`). -/
theorem lrAppFnMajSemBi_of_pi_codomain {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (f₁ f₂ A D C : Expr Nat) :
    LRAppFnMajSemBi E n Γ f₁ f₂ A (.pi D C) :=
  fun _ _ _ _ => lrTermMajSemBi_app_of_pi_codomain Γ f₁ f₂ _ _ D C

/-- Unconditional `LRAppFnDiagMajSemBi` for any $\Pi$-codomain `B = .pi D C`
    (`lrAppFnDiagMajSemBi_of_pi_codomain`). -/
theorem lrAppFnDiagMajSemBi_of_pi_codomain {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (f A D C : Expr Nat) :
    LRAppFnDiagMajSemBi E n Γ f A (.pi D C) :=
