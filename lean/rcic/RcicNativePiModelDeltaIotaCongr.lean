    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ M M A := by
  intro c hc hor
  rcases h c hc (Or.inl (hor.elim id id)) with hP | hpi | hlr
  · exact Or.inl hP
  · exact Or.inr (Or.inl hpi)
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_diag_left hlr))

