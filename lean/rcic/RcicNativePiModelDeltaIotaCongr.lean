/-! ### §23.2. Semantic Non-$\Pi$-Guarded `LRProbeNoPiCore`, `LRTermNoPiBi`, and `LRTermNoPiSemBi`
— Replacing Syntactic Type Sort-Reduction `∃ l, WhRedPiKClosedCtx E Γ A (.sort l)` by
`¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])` -/

/-- **Semantic Non-$\Pi$-Guarded Probe Relation (`LRProbeNoPiCore`):**
    Replaces the positive syntactic type sort-reduction guard `∃ l, WhRedPiKClosedCtx E Γ A (.sort l)`
    on `c ∈ {.sort, .pi a f}` by the purely semantic non-$\Pi$ exclusion
    `¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])`!
    Observe the exact symmetry with `IsSemPropTyI`:
    - `IsSemPropTyI E n Γ A` carries `¬ ApproxDIK E (ctxEnvDIK E Γ) A .sort` (transported along
      `TyConvT E n Γ A B` by `ih_AB` at `c = .sort`),
    - `LRProbeNoPiCore E n Γ M M' A c` carries `¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])`
      (transported along `TyConvT E n Γ A B` by `ih_AB` at `c = .pi .bot []`!). -/
def LRProbeNoPiCore (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : CptI → Prop
  | .bot => True
  | .sort => ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∧ LRTypeINPiKClosedCtx E n Γ M M' .sort
  | .pi a f => ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∧ LRTypeINPiKClosedCtx E n Γ M M' (.pi a f)
  | .spine _ _ => False
  | .lam _ => False

/-- Bidirectional `ProbeCpt`-restricted term logical relation over `IsPropTyI` and `LRProbeNoPiCore`
    (`LRTermNoPiBi`). -/
def LRTermNoPiBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : Prop :=
  ∀ c, ProbeCpt c →
    (ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c) →
    IsPropTyI E n Γ A ∨ LRProbeNoPiCore E n Γ M M' A c

/-- Bidirectional `ProbeCpt`-restricted term logical relation over `IsSemPropTyI` and
    `LRProbeNoPiCore` (`LRTermNoPiSemBi`, requiring **zero `PropTyTransport`, zero `SortRow`, and
    zero syntactic `WhRedPiKClosedCtx E Γ A (.sort l)` on types**!). -/
def LRTermNoPiSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : Prop :=
  ∀ c, ProbeCpt c →
    (ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c) →
    IsSemPropTyI E n Γ A ∨ LRProbeNoPiCore E n Γ M M' A c

/-- Any type `A` reducing by `WhRedPiKClosedCtx E Γ A (.sort l)` satisfies
    `¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])` under `EnvWfT E`. -/
theorem not_approxDIK_pi_of_whRedPiKClosedCtx_sort {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {A : Expr Nat} {l : Level}
    (hred : WhRedPiKClosedCtx E Γ A (.sort l)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) := by
  intro hpi
  have hsort_pi : ApproxDIK E (ctxEnvDIK E Γ) (.sort l) (.pi .bot []) :=
    (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred (.pi .bot [])).mp hpi
  exact approxDIK_sort_not_pi l .bot [] hsort_pi

/-- On `ProbeCpt`, `LRTermDSubKClosedCtxCore` strictly implies `LRProbeNoPiCore` under `EnvWfT E`. -/
theorem lrProbeNoPiCore_of_lrTermDSubKClosedCtxCore_probe {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A : Expr Nat} {c : CptI} (hc : ProbeCpt c)
    (h : LRTermDSubKClosedCtxCore E n Γ M M' A c) :
    LRProbeNoPiCore E n Γ M M' A c := by
  cases hc with
  | bot => trivial
  | sort =>
      rw [lrTermDSubKClosedCtxCore_sort_iff] at h
      obtain ⟨⟨l, hl⟩, hlr⟩ := h
      exact ⟨not_approxDIK_pi_of_whRedPiKClosedCtx_sort hW hl, hlr⟩
  | piBotNil =>
      have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at h
      obtain ⟨⟨l, hl⟩, hlr⟩ := h
      exact ⟨not_approxDIK_pi_of_whRedPiKClosedCtx_sort hW hl, hlr⟩

/-- `LRTermDSubKClosedCtxBi` strictly implies `LRTermNoPiBi` under `EnvWfT E`. -/
theorem lrTermNoPiBi_of_bi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermDSubKClosedCtxBi E n Γ M M' A) :
    LRTermNoPiBi E n Γ M M' A := by
  intro c hc hor
  rcases h c hc hor with hP | hC
  · exact Or.inl hP
  · exact Or.inr (lrProbeNoPiCore_of_lrTermDSubKClosedCtxCore_probe hW hc hC)

/-- `LRTermDSubKClosedCtxSemBi` strictly implies `LRTermNoPiSemBi` under `EnvWfT E`. -/
theorem lrTermNoPiSemBi_of_semBi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermDSubKClosedCtxSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n Γ M M' A := by
  intro c hc hor
  rcases h c hc hor with hP | hC
  · exact Or.inl hP
  · exact Or.inr (lrProbeNoPiCore_of_lrTermDSubKClosedCtxCore_probe hW hc hC)

/-- Every `IsSemPropTyI` type satisfies `LRTermNoPiSemBi` for all terms `M, M'`. -/
theorem lrTermNoPiSemBi_of_isSemPropTyI {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' A : Expr Nat} (hP : IsSemPropTyI E n Γ A) :
    LRTermNoPiSemBi E n Γ M M' A :=
  fun _ _ _ => Or.inl hP

/-- Any pair of terms `M, M'` with only `.bot` on `ProbeCpt` satisfies `LRTermNoPiSemBi` at every `A`. -/
theorem lrTermNoPiSemBi_of_probeCpt_eq_bot {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {M M' : Expr Nat} (A : Expr Nat)
    (hM : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M c → c = .bot)
    (hM' : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M' c → c = .bot) :
    LRTermNoPiSemBi E n Γ M M' A := by
  intro c hc hor
  have hbot : c = .bot := hor.elim (hM c hc) (hM' c hc)
  subst hbot
  exact Or.inr trivial

/-- **Symmetry of `LRTermNoPiSemBi` Across ALL Contexts `Γ : LCtx` (`lrTermNoPiSemBi_symm`):** -/
theorem lrTermNoPiSemBi_symm {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n Γ M' M A := by
  intro c hc hor
  rcases h c hc hor.symm with hP | hC
  · exact Or.inl hP
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort => exact ⟨hC.1, lrTypeINPiKClosedCtx_symm hW hC.2⟩
    | piBotNil => exact ⟨hC.1, lrTypeINPiKClosedCtx_symm hW hC.2⟩

/-- **Transitivity of `LRTermNoPiSemBi` Across ALL Contexts `Γ : LCtx` (`lrTermNoPiSemBi_trans`):** -/
theorem lrTermNoPiSemBi_trans {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M₁ M₂ M₃ A : Expr Nat}
    (h₁ : LRTermNoPiSemBi E n Γ M₁ M₂ A)
    (h₂ : LRTermNoPiSemBi E n Γ M₂ M₃ A) :
    LRTermNoPiSemBi E n Γ M₁ M₃ A := by
  intro c hc hor
  cases hc with
  | bot => exact Or.inr trivial
  | sort =>
      rcases hor with hM₁ | hM₃
      · rcases h₁ .sort .sort (Or.inl hM₁) with hP | ⟨hnoA, hlr₁⟩
        · exact Or.inl hP
        · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ .sort :=
            (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW .sort hlr₁).2
          rcases h₂ .sort .sort (Or.inl hM₂) with hP | ⟨_, hlr₂⟩
          · exact Or.inl hP
          · exact Or.inr ⟨hnoA, lrTypeINPiKClosedCtx_trans_of_envWfT hW hlr₁ hlr₂⟩
      · rcases h₂ .sort .sort (Or.inr hM₃) with hP | ⟨hnoA, hlr₂⟩
        · exact Or.inl hP
        · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ .sort :=
            (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW .sort hlr₂).1
          rcases h₁ .sort .sort (Or.inr hM₂) with hP | ⟨_, hlr₁⟩
          · exact Or.inl hP
          · exact Or.inr ⟨hnoA, lrTypeINPiKClosedCtx_trans_of_envWfT hW hlr₁ hlr₂⟩
  | piBotNil =>
      rcases hor with hM₁ | hM₃
      · rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁) with hP | ⟨hnoA, hlr₁⟩
        · exact Or.inl hP
        · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ (.pi .bot []) :=
            (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW botPiCpt_pi_bot_nil hlr₁).2
          rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂) with hP | ⟨_, hlr₂⟩
          · exact Or.inl hP
          · exact Or.inr ⟨hnoA, lrTypeINPiKClosedCtx_trans_of_envWfT hW hlr₁ hlr₂⟩
      · rcases h₂ (.pi .bot []) .piBotNil (Or.inr hM₃) with hP | ⟨hnoA, hlr₂⟩
        · exact Or.inl hP
        · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ (.pi .bot []) :=
            (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW botPiCpt_pi_bot_nil hlr₂).1
          rcases h₁ (.pi .bot []) .piBotNil (Or.inr hM₂) with hP | ⟨_, hlr₁⟩
          · exact Or.inl hP
          · exact Or.inr ⟨hnoA, lrTypeINPiKClosedCtx_trans_of_envWfT hW hlr₁ hlr₂⟩

/-- **Weak-Head Expansion in `LRTermNoPiSemBi` (`lrTermNoPiSemBi_whRedPiKClosedCtx_expand`):** -/
theorem lrTermNoPiSemBi_whRedPiKClosedCtx_expand {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hred : WhRedPiKClosedCtx E Γ M N)
    (hred' : WhRedPiKClosedCtx E Γ M' N')
    (hN : LRTermNoPiSemBi E n Γ N N' A) :
    LRTermNoPiSemBi E n Γ M M' A := by
  intro c hc hor
  have horN : ApproxDIK E (ctxEnvDIK E Γ) N c ∨ ApproxDIK E (ctxEnvDIK E Γ) N' c :=
    hor.imp (fun h => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred c).mp h)
      (fun h => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred' c).mp h)
  rcases hN c hc horN with hP | hC
  · exact Or.inl hP
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort => exact ⟨hC.1, lrTypeINPiKClosedCtx_expand hred hred' hC.2⟩
    | piBotNil => exact ⟨hC.1, lrTypeINPiKClosedCtx_expand hred hred' hC.2⟩

/-- **Forward Weak-Head Preservation in `LRTermNoPiSemBi`
    (`lrTermNoPiSemBi_whRedPiKClosedCtx_preserve`):** -/
theorem lrTermNoPiSemBi_whRedPiKClosedCtx_preserve {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hred : WhRedPiKClosedCtx E Γ M N)
    (hred' : WhRedPiKClosedCtx E Γ M' N')
    (hM : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n Γ N N' A := by
  intro c hc horN
  have hor : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c :=
    horN.imp (fun h => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred c).mpr h)
      (fun h => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred' c).mpr h)
  rcases hM c hc hor with hP | hC
  · exact Or.inl hP
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort => exact ⟨hC.1, lrTypeINPiKClosedCtx_whRedPiKClosedCtx_preserve hW hred hred' hC.2⟩
    | piBotNil => exact ⟨hC.1, lrTypeINPiKClosedCtx_whRedPiKClosedCtx_preserve hW hred hred' hC.2⟩

/-- **Two-Way (`↔`) Weak-Head Equivalence in `LRTermNoPiSemBi`
    (`lrTermNoPiSemBi_whRedPiKClosedCtx_iff`):** -/
theorem lrTermNoPiSemBi_whRedPiKClosedCtx_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hred : WhRedPiKClosedCtx E Γ M N)
    (hred' : WhRedPiKClosedCtx E Γ M' N') :
    LRTermNoPiSemBi E n Γ M M' A ↔ LRTermNoPiSemBi E n Γ N N' A :=
  ⟨lrTermNoPiSemBi_whRedPiKClosedCtx_preserve hW hred hred',
   lrTermNoPiSemBi_whRedPiKClosedCtx_expand hW hred hred'⟩

/-- **Transport of `¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])` Along `ih_AB : LRTermNoPiSemBi E n Γ A B (.sort u)`
    at `c = .pi .bot []` (`not_approxDIK_pi_tyConv_of_noPiSemBi`):**
    Requires **zero** `WhRedPiKClosedCtx` on `A` or `B`, **zero** `PropTyTransport`, and **zero** `SortRow`! -/
theorem not_approxDIK_pi_tyConv_of_noPiSemBi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {u : Level}
    (hnoA : ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (ih_AB : LRTermNoPiSemBi E n Γ A B (.sort u)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) B (.pi .bot []) := by
  intro hB_pi
  rcases ih_AB (.pi .bot []) .piBotNil (Or.inr hB_pi) with hPs | ⟨_, hlr⟩
  · exact not_isSemPropTyI_sort E n Γ u hPs
  · exact hnoA (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW botPiCpt_pi_bot_nil hlr).1

/-- **Transport of `IsSemPropTyI E n Γ A` Along `ih_AB : LRTermNoPiSemBi E n Γ A B (.sort u)`
    at `c = .sort` (`isSemPropTyI_tyConv_of_noPiSemBi`):** -/
theorem isSemPropTyI_tyConv_of_noPiSemBi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {u : Level}
    (hPA : IsSemPropTyI E n Γ A)
    (hcAB : TyConvT E n Γ A B)
    (ih_AB : LRTermNoPiSemBi E n Γ A B (.sort u)) :
    IsSemPropTyI E n Γ B := by
  obtain ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnoA⟩ := hPA
  refine ⟨⟨P, ⟨hP⟩, ⟨.trans Γ P A B hcPA hcAB⟩⟩, fun hBs => ?_⟩
  rcases ih_AB .sort .sort (Or.inr hBs) with hPs | ⟨_, hlr⟩
  · exact not_isSemPropTyI_sort E n Γ u hPs
  · exact hnoA (approxDIK_of_lrTypeINPiKClosedCtx_botPiCpt hW .sort hlr).1

/-- **Self-Contained Type-Conversion Transport in `LRTermNoPiSemBi`
    (`lrTermNoPiSemBi_tyConv_of_bi`):**
    Transports `IsSemPropTyI` using `ih_AB` at `c = .sort` and transports `LRProbeNoPiCore` using
    `ih_AB` at `c = .pi .bot []`, with **zero `WhRedPiKClosedCtx` on `A` or `B`, zero `PropTyTransport`,
    and zero `SortRow`**! -/
theorem lrTermNoPiSemBi_tyConv_of_bi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' A B : Expr Nat} {u : Level}
    (hcAB : TyConvT E n Γ A B)
    (ih_M : LRTermNoPiSemBi E n Γ M M' A)
    (ih_AB : LRTermNoPiSemBi E n Γ A B (.sort u)) :
    LRTermNoPiSemBi E n Γ M M' B := by
  intro c hc hor
  rcases ih_M c hc hor with hPA | hC
  · exact Or.inl (isSemPropTyI_tyConv_of_noPiSemBi hW hPA hcAB ih_AB)
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort => exact ⟨not_approxDIK_pi_tyConv_of_noPiSemBi hW hC.1 ih_AB, hC.2⟩
    | piBotNil => exact ⟨not_approxDIK_pi_tyConv_of_noPiSemBi hW hC.1 ih_AB, hC.2⟩

/-- **`ConvT.eta` in `LRTermNoPiSemBi` (`lrTermNoPiSemBi_eta`):**
    Because `ApproxDIK E (ctxEnvDIK E Γ) (.pi A B) (.pi .bot [])` always holds (`approxDIK_pi_bot_nil`),
    `¬ ApproxDIK E (ctxEnvDIK E Γ) (.pi A B) (.pi .bot [])` is always FALSE, so `LRProbeNoPiCore` is
    automatically false at `c ∈ {.sort, .pi .bot []}` for `T = .pi A B`! -/
theorem lrTermNoPiSemBi_eta {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B f : Expr Nat}
    (hdiag : LRTermNoPiSemBi E n Γ f f (.pi A B)) :
    LRTermNoPiSemBi E n Γ (.lam A (.app (lift 0 1 f) (.bvar 0))) f (.pi A B) := by
  intro c hc hor
  rcases hor with hlam | hf
  · rw [approxDIK_lam_botPiCpt_eq_bot (botPiCpt_of_probeCpt hc) hlam]
    exact Or.inr trivial
  · rcases hdiag c hc (Or.inl hf) with hP | hC
    · exact Or.inl hP
    · cases hc with
      | bot => exact Or.inr trivial
      | sort => exact (hC.1 (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B)).elim
      | piBotNil => exact (hC.1 (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B)).elim

/-- **All-Cutoff Weakening of `LRTermNoPiSemBi` (`lrTermNoPiSemBi_weaken`):**
    Uses `approxDIK_ctxEnvDIK_insertAt_lift_iff` directly on `A` at `c = .pi .bot []`, with **zero**
    `whRedPiKClosedCtx_lift_insertAt` needed on `A`! -/
theorem lrTermNoPiSemBi_weaken {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E)
    {Γ : LCtx} {M M' A : Expr Nat} (d : LocalDecl) {k : Nat} (hk : k ≤ Γ.length)
    (hΓ' : CtxWfT E n (insertAt d k Γ))
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') (lift k 1 A) := by
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c :=
    hor.elim
      (fun hL => Or.inl ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk M c).mp hL))
      (fun hR => Or.inr ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk M' c).mp hR))
  rcases h c hc hor₀ with hP | hC
  · exact Or.inl (isSemPropTyI_weaken hcl d hk hP)
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort =>
        exact ⟨fun hpi => hC.1 ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk A (.pi .bot [])).mp hpi),
          lrTypeINPiKClosedCtx_weaken_botPiCpt hcl .sort d hk hΓ' hC.2⟩
    | piBotNil =>
        exact ⟨fun hpi => hC.1 ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk A (.pi .bot [])).mp hpi),
          lrTypeINPiKClosedCtx_weaken_botPiCpt hcl botPiCpt_pi_bot_nil d hk hΓ' hC.2⟩

/-- Depth-0 weakening of `LRTermNoPiSemBi` (`lrTermNoPiSemBi_weaken0`). -/
theorem lrTermNoPiSemBi_weaken0 {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E)
    {Γ : LCtx} {d : LocalDecl}
    (hΓ' : CtxWfT E n (d :: Γ))
    {M M' A : Expr Nat}
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n (d :: Γ) (lift 0 1 M) (lift 0 1 M') (lift 0 1 A) :=
  lrTermNoPiSemBi_weaken hcl d (Nat.zero_le _) hΓ' h

/-- **Unconditional All-Depth `let`-Substitution of `LRTermNoPiSemBi` Across ALL Let-Values `w0`
    (`lrTermNoPiSemBi_substLet`):**
    Uses `approxDIK_ctxEnvDIK_substLet_iff` directly on `A` at `c = .pi .bot []`, with **zero**
    `whRedPiKClosedCtx_substLet_of_envClosed` needed on `A`! -/
theorem lrTermNoPiSemBi_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {Γ : LCtx} {M M' A : Expr Nat} {j : Nat}
    (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    (hΓ' : CtxWfT E n (substRemove w0 j Γ))
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiSemBi E n (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) M)
      (instantiate j (lift 0 j w0) M')
      (instantiate j (lift 0 j w0) A) := by
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c :=
    hor.elim
      (fun hL => Or.inl ((approxDIK_ctxEnvDIK_substLet_iff hget M c).mp hL))
      (fun hR => Or.inr ((approxDIK_ctxEnvDIK_substLet_iff hget M' c).mp hR))
