  have h_fn0 := hSubst0 hΓ hf₁ hf₂ hcf ih_f ih_fn_diag
  rw [instantiate0_app_bvar0_lift0 f₁ a₁, instantiate0_app_bvar0_lift0 f₂ a₁, hcancel] at h_fn0
  have ih_app₂₁ : LRTermDSubKClosedCtxSemBi E n Γ (.app f₂ a₁) (.app f₂ a₁) (instantiate0 a₁ B) :=
    lrTermDSubKClosedCtxSemBi_trans hW (lrTermDSubKClosedCtxSemBi_symm hW h_fn0) h_fn0
  have ih_arg_diag : LRTermDSubKClosedCtxSemBi E n Γ
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ B) := by
