      LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A →
      LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B) →
      LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B)

/-- **Instantiated-Diagonal 0-Instantiation Congruence Supply in `LRTermDSubKClosedCtxSemBi`
    (`Subst0CongrSupplyDSubKClosedCtxSemBi E n`):** -/
def Subst0CongrSupplyDSubKClosedCtxSemBi (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
