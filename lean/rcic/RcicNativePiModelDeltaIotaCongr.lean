/-! ### §31.1. `WhNormalPiKClosedCtxMaj` `.lam`-Compact Inversion, Constructive `ctorTagCpt`
Decidability Under Normalization, Strict Recursor-Prefix Application Vacuity, and 3-Way
$\beta$/$\iota$/$\iota_K$ Contractum Decomposition of `.app f a` -/

/-- **Exact `.lam g`-Compact Inversion for `WhNormalPiKClosedCtxMaj` Normal Forms
    (`whNormalPiKClosedCtxMaj_approxDIK_lam_inv`):**
    If `WhNormalPiKClosedCtxMaj E Γ e` and `ApproxDIK E (ctxEnvDIK E Γ) e (.lam g)`, then `e` is
    syntactically **either**:
    1. a $\lambda$-abstraction `e = .lam A b`, **or**
    2. an under-applied recursor prefix `e = foldApps (.const w.recRef ls) xs` with
       `xs.length ≤ w.preMajor.length` (strictly before or up to the pre-major arguments)!
    Any recursor spine with `xs.length > w.preMajor.length` and compact `.lam g ≠ .bot` is
    ruled out by `whNormalPiKClosedCtxMaj_approxDIK_inv` via `.iotaS` / `.iotaKClosedCtx`! -/
theorem whNormalPiKClosedCtxMaj_approxDIK_lam_inv {E : ResolvedEnv}
    {Γ : LCtx} (e : Expr Nat) {g : List (List CptI × CptI)}
    (hnorm : WhNormalPiKClosedCtxMaj E Γ e)
    (happrox : ApproxDIK E (ctxEnvDIK E Γ) e (.lam g)) :
    (∃ A b, e = .lam A b) ∨
    (∃ (w : IotaWitnessS E) (ls : List Level) (xs : List (Expr Nat)),
      xs.length ≤ w.preMajor.length ∧ e = foldApps (.const w.recRef ls) xs) := by
  obtain ⟨head, xs, heEq, hnotApp⟩ := exists_foldApps_not_app e
  have hnorm_head : WhNormalPiKClosedCtxMaj E Γ head := by
    rw [heEq] at hnorm
    exact whNormalPiKClosedCtxMaj_foldApps_inv xs hnorm
  cases head with
  | app f a => exact (hnotApp f a rfl).elim
  | letE A v b => exact (hnorm_head _ (.of_whStep (.zeta A v b))).elim
  | lit L => exact (hnorm_head _ (.of_whStep (.lit L))).elim
  | bvar i =>
      cases hval : lookupValue Γ i with
      | some v => exact (hnorm_head _ (.zetaLocal hval)).elim
      | none =>
          rw [heEq] at happrox
          exact (by cases approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hval xs happrox)
  | sort l =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          rw [heEq] at happrox
          rcases approxDIK_sort_inv happrox with h | h <;> cases h
      | cons a rest =>
          rw [heEq, approxDIK_foldApps_iff] at happrox
          rcases happrox with ⟨d, hd, hfold⟩
          rcases approxDIK_sort_inv hd with rfl | rfl
          · cases foldAppCptK_bot_inv hfold
          · cases foldAppCptK_sort_cons_eq_bot a rest hfold
  | pi A B =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          rw [heEq] at happrox
          rcases approxDIK_pi_inv happrox with h | ⟨_, _, h, _, _⟩ <;> cases h
      | cons a rest =>
          rw [heEq, approxDIK_foldApps_iff] at happrox
          rcases happrox with ⟨d, hd, hfold⟩
          rcases approxDIK_pi_inv hd with rfl | ⟨a₀, f₀, rfl, _, _⟩
          · cases foldAppCptK_bot_inv hfold
          · cases foldAppCptK_pi_cons_eq_bot a₀ f₀ a rest hfold
  | lam A b =>
      cases xs with
      | nil =>
          simp only [foldApps] at heEq
          exact Or.inl ⟨A, b, heEq⟩
      | cons a rest =>
          have hstep : WhStepPiKClosedCtxMaj E Γ e (foldApps (instantiate0 a b) rest) := by
            rw [heEq]
            exact whStepPiKClosedCtxMaj_foldApps (.of_whStep (.beta A b a)) rest
          exact (hnorm _ hstep).elim
  | const r ls =>
      have happrox' := happrox
      rw [heEq, approxDIK_foldApps_iff] at happrox'
      rcases happrox' with ⟨d, hd, hfold⟩
      generalize he0 : (Expr.const r ls : Expr Nat) = e0 at hd
      cases hd with
      | bot => cases foldAppCptK_bot_inv hfold
      | const _ r' ls' _ =>
          injection he0 with hr hls
          subst hr; subst hls
          rcases (foldAppCptK_spine_iff r xs [] (.lam g)).mp hfold with h | ⟨_, _, h⟩ <;> cases h
      | delta hdelta _ =>
          injection he0 with hr hls
          subst hr; subst hls
          exact (hnorm_head _ (.of_whStep (.delta hdelta.1 hdelta.2.1))).elim
      | @recursor _ w ls' us_pre us_fields c₀ hpre hflds _ =>
          injection he0 with hr hls
          subst hr; subst hls
          by_cases hle : xs.length ≤ w.preMajor.length
          · exact Or.inr ⟨w, ls, xs, hle, heEq⟩
          · obtain ⟨pre, x, rest, hxsEq, hpreLen⟩ :=
              list_split_at_of_lt w.preMajor.length xs (by omega)
            have heRec : e = foldApps (recCall (.const w.recRef ls) pre x) rest := by
              rw [heEq, hxsEq, recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
            have hnorm_rec : WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
              rw [heRec] at hnorm
              exact whNormalPiKClosedCtxMaj_foldApps_inv rest hnorm
            have hxsSplit : xs = (pre ++ [x]) ++ rest := by
              rw [hxsEq, List.append_assoc, List.singleton_append]
            rw [hxsSplit] at hfold
            obtain ⟨d_rec, hfold_pre, hfold_rest⟩ :=
              foldAppCptK_append_elim (pre ++ [x]) rest hfold
            have htotLen : (us_pre ++ [ctorDemand w.ctorRef w.nparams us_fields]).length =
                (pre ++ [x]).length := by
              simp only [List.length_append, List.length_singleton, hpre, hpreLen]
            rcases (foldAppCptK_curryStep_iff htotLen).mp hfold_pre with rfl | ⟨hargs, rfl⟩
            · cases foldAppCptK_bot_inv hfold_rest
            · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
                (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
              have hlenPre : us_pre.length = us_pre'.length := by
                rw [hpreArgs.length_eq, hpre, hpreLen]
              obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
              cases hmajArgs with
              | cons hmaj _ =>
                  cases hmajEq
                  have htag_x : ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) :=
                    hmaj (ctorTagCpt w) (ctorTagCpt_mem_ctorDemand w hflds)
                  have hnorm_x : WhNormalPiKClosedCtxMaj E Γ x :=
                    fun x' hsx => hnorm_rec _ (.recMajor w ls pre x x' hpreLen htag_x hsx)
                  unfold ctorTagCpt at htag_x
                  obtain ⟨lsC, xsC, _, hxEq, hxsCLen⟩ :=
                    (whNormalPiKClosedCtxMaj_approxDIK_inv x hnorm_x htag_x).2.2 w.ctorRef
                      (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
                      rfl
                  simp only [List.length_append, List.length_replicate] at hxsCLen
                  obtain ⟨params, fields, hxsCSplit, hparLen, hfldsLen⟩ :=
                    list_split_of_length_add xsC w.nparams w.fields.length hxsCLen
                  rw [hxEq, hxsCSplit] at hnorm_rec
                  exact (hnorm_rec _ (.iotaS w ls lsC pre params fields hpreLen hparLen hfldsLen)).elim
      | @recursorK _ w ls' us_pre u_maj c₀ hk hpre _ _ =>
          injection he0 with hr hls
          subst hr; subst hls
          by_cases hle : xs.length ≤ w.preMajor.length
          · exact Or.inr ⟨w, ls, xs, hle, heEq⟩
          · obtain ⟨pre, x, rest, hxsEq, hpreLen⟩ :=
              list_split_at_of_lt w.preMajor.length xs (by omega)
            have heRec : e = foldApps (recCall (.const w.recRef ls) pre x) rest := by
              rw [heEq, hxsEq, recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
            have hnorm_rec : WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
              rw [heRec] at hnorm
              exact whNormalPiKClosedCtxMaj_foldApps_inv rest hnorm
            have hnot_tag : ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) := by
              intro htag_x
              have hnorm_x : WhNormalPiKClosedCtxMaj E Γ x :=
                fun x' hsx => hnorm_rec _ (.recMajor w ls pre x x' hpreLen htag_x hsx)
              unfold ctorTagCpt at htag_x
              obtain ⟨lsC, xsC, _, hxEq, hxsCLen⟩ :=
                (whNormalPiKClosedCtxMaj_approxDIK_inv x hnorm_x htag_x).2.2 w.ctorRef
                  (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot)
                  rfl
              simp only [List.length_append, List.length_replicate] at hxsCLen
              obtain ⟨params, fields, hxsCSplit, hparLen, hfldsLen⟩ :=
                list_split_of_length_add xsC w.nparams w.fields.length hxsCLen
              rw [hxEq, hxsCSplit] at hnorm_rec
              exact hnorm_rec _ (.iotaS w ls lsC pre params fields hpreLen hparLen hfldsLen)
            exact (hnorm_rec _ (.iotaKClosedCtx w ls pre x hk hpreLen hnot_tag)).elim
      | bvar => exact Expr.noConfusion he0
      | sort => exact Expr.noConfusion he0
      | pi => exact Expr.noConfusion he0
      | lam => exact Expr.noConfusion he0
      | app => exact Expr.noConfusion he0
      | appSpine => exact Expr.noConfusion he0
      | letE => exact Expr.noConfusion he0
      | lit => exact Expr.noConfusion he0

/-- **Exact `.lam g`-Compact Adequacy for `WhRedPiKClosedCtxMaj`-Normalizable Expressions
    (`approxDIK_lam_of_normalizes_inv`):**
    At every `EnvWfT E`, if `e` reduces under `WhRedPiKClosedCtxMaj E Γ` to a normal form `nf`
    and `ApproxDIK E (ctxEnvDIK E Γ) e (.lam g)`, then `e` reduces under `WhRedPiKClosedCtxMaj E Γ`
    either to a syntactic $\lambda$-abstraction `.lam A b` or to an under-applied recursor prefix
    `foldApps (.const w.recRef ls) xs` with `xs.length ≤ w.preMajor.length`! -/
theorem approxDIK_lam_of_normalizes_inv {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {e nf : Expr Nat} {g : List (List CptI × CptI)}
    (hred : WhRedPiKClosedCtxMaj E Γ e nf)
    (hnorm : WhNormalPiKClosedCtxMaj E Γ nf)
    (happrox : ApproxDIK E (ctxEnvDIK E Γ) e (.lam g)) :
    (∃ A b, nf = .lam A b ∧ WhRedPiKClosedCtxMaj E Γ e (.lam A b)) ∨
    (∃ (w : IotaWitnessS E) (ls : List Level) (xs : List (Expr Nat)),
      xs.length ≤ w.preMajor.length ∧
      nf = foldApps (.const w.recRef ls) xs ∧
      WhRedPiKClosedCtxMaj E Γ e (foldApps (.const w.recRef ls) xs)) := by
  have hnf : ApproxDIK E (ctxEnvDIK E Γ) nf (.lam g) :=
    (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (.lam g)).mp happrox
  rcases whNormalPiKClosedCtxMaj_approxDIK_lam_inv nf hnorm hnf with
    ⟨A, b, rfl⟩ | ⟨w, ls, xs, hle, rfl⟩
  · exact Or.inl ⟨A, b, rfl, hred⟩
  · exact Or.inr ⟨w, ls, xs, hle, rfl, hred⟩

/-- **Unconditional Application Diagonal Adequacy for Strictly Under-Applied Recursor Prefixes
    (`lrTermMajSemBi_app_recursor_strict_prefix`):**
    If `f` reduces under `WhRedPiKClosedCtxMaj E Γ` to `foldApps (.const w.recRef ls) xs` with
    `xs.length < w.preMajor.length`, then for **every** argument `a` and type `T`,
    `LRTermMajSemBi E n Γ (.app f a) (.app f a) T` holds unconditionally! -/
theorem lrTermMajSemBi_app_recursor_strict_prefix {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {xs : List (Expr Nat)} (hlt : xs.length < w.preMajor.length)
    {f : Expr Nat} (hf : WhRedPiKClosedCtxMaj E Γ f (foldApps (.const w.recRef ls) xs))
    (a T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f a) (.app f a) T := by
  have hred : WhRedPiKClosedCtxMaj E Γ (.app f a)
      (foldApps (.const w.recRef ls) (xs ++ [a])) := by
    rw [foldApps_snoc]
    exact whRedPiKClosedCtxMaj_foldApps hf [a]
  have hle : (xs ++ [a]).length ≤ w.preMajor.length := by
    simp only [List.length_append, List.length_singleton]
    omega
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred hred
    (lrTermMajSemBi_recursor_prefix w w ls ls hle hle T)

/-- **Unconditional Two-Sided Application Congruence for Strictly Under-Applied Recursor Prefixes
    (`lrTermMajSemBi_app_congr_recursor_strict_prefix`):** -/
theorem lrTermMajSemBi_app_congr_recursor_strict_prefix {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {xs₁ xs₂ : List (Expr Nat)}
    (hlt₁ : xs₁.length < w₁.preMajor.length)
    (hlt₂ : xs₂.length < w₂.preMajor.length)
    {f₁ f₂ : Expr Nat}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (foldApps (.const w₁.recRef ls₁) xs₁))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (foldApps (.const w₂.recRef ls₂) xs₂))
    (a₁ a₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) T := by
  have hred₁ : WhRedPiKClosedCtxMaj E Γ (.app f₁ a₁)
      (foldApps (.const w₁.recRef ls₁) (xs₁ ++ [a₁])) := by
    rw [foldApps_snoc]
    exact whRedPiKClosedCtxMaj_foldApps hf₁ [a₁]
  have hred₂ : WhRedPiKClosedCtxMaj E Γ (.app f₂ a₂)
      (foldApps (.const w₂.recRef ls₂) (xs₂ ++ [a₂])) := by
    rw [foldApps_snoc]
    exact whRedPiKClosedCtxMaj_foldApps hf₂ [a₂]
  have hle₁ : (xs₁ ++ [a₁]).length ≤ w₁.preMajor.length := by
    simp only [List.length_append, List.length_singleton]; omega
  have hle₂ : (xs₂ ++ [a₂]).length ≤ w₂.preMajor.length := by
    simp only [List.length_append, List.length_singleton]; omega
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred₁ hred₂
    (lrTermMajSemBi_recursor_prefix w₁ w₂ ls₁ ls₂ hle₁ hle₂ T)

/-- **Constructive Decidability of `ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)` for
    `WhRedPiKClosedCtxMaj`-Normalizable Expressions (`approxDIK_ctorTagCpt_or_not_of_normalizes`):**
    If `x` normalizes under `WhRedPiKClosedCtxMaj E Γ`, then
    `ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) ∨ ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)`
    holds **constructively** (with **zero `Classical.choice`**) by inspecting the syntactic head and
    argument length of the normal form of `x`! -/
theorem approxDIK_ctorTagCpt_or_not_of_normalizes {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) {x : Expr Nat}
    (hnorm_x : WhRedPiKClosedCtxMajNormalizes E Γ x) :
    ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) ∨
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) := by
  obtain ⟨nf, hred, hnorm⟩ := hnorm_x
  obtain ⟨head, xs, hnfEq, hnotApp⟩ := exists_foldApps_not_app nf
  have hnot_of_ne :
      (∀ lsC, head ≠ .const w.ctorRef lsC ∨ xs.length ≠ w.nparams + w.fields.length) →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) := by
    intro hne htag
    have hnf : ApproxDIK E (ctxEnvDIK E Γ) nf (ctorTagCpt w) :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (ctorTagCpt w)).mp htag
    unfold ctorTagCpt at hnf
    obtain ⟨lsC, xsC, _, hnfCtor, hlenC⟩ :=
      (whNormalPiKClosedCtxMaj_approxDIK_inv nf hnorm hnf).2.2 w.ctorRef
        (List.replicate w.nparams CptI.bot ++ List.replicate w.fields.length CptI.bot) rfl
    simp only [List.length_append, List.length_replicate] at hlenC
    have hhead_spine : appsSpine head = (head, []) := by
      cases head with
      | app f a => exact (hnotApp f a rfl).elim
      | _ => rfl
    have hsp₁ : appsSpine nf = (head, xs) := by
      rw [hnfEq, appsSpine_foldApps, hhead_spine, List.nil_append]
    have hsp₂ : appsSpine nf = (.const w.ctorRef lsC, xsC) := by
      rw [hnfCtor, appsSpine_foldApps_const]
    have hsp := hsp₁.symm.trans hsp₂
    injection hsp with hheadEq hxsEq
    subst hheadEq; subst hxsEq
    rcases hne lsC with h1 | h2
    · exact h1 rfl
    · exact h2 hlenC
  cases head with
  | const r lsC =>
      by_cases hr : r = w.ctorRef
      · subst hr
        by_cases hlen : xs.length = w.nparams + w.fields.length
        · refine Or.inl ?_
          rw [hnfEq] at hred
          exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (ctorTagCpt w)).mpr
            (approxDIK_ctorTagCpt_of_ctor_spine hW w lsC hlen (ctxEnvDIK E Γ))
        · exact Or.inr (hnot_of_ne (fun _ => Or.inr hlen))
      · exact Or.inr (hnot_of_ne (fun _ => Or.inl (fun h => hr (by injection h))))
  | bvar _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))
  | sort _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))
  | pi _ _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))
  | lam _ _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))
  | app f a => exact (hnotApp f a rfl).elim
  | letE _ _ _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))
  | lit _ => exact Or.inr (hnot_of_ne (fun _ => Or.inl (by intro h; cases h)))

/-- **Constructive $\iota$/$\iota_K$ Contractum Reduction for Any Non-`.bot` `recCall` Whose Major
    Normalizes (`approxDIK_recCall_nonbot_of_major_normalizes_inv`):**
    Requires **zero `hctorOrNo` hypothesis and zero `Classical.choice`**! -/
theorem approxDIK_recCall_nonbot_of_major_normalizes_inv {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat} {c : CptI} (hne : c ≠ .bot)
    (hrec : ApproxDIK E (ctxEnvDIK E Γ) (recCall (.const w.recRef ls) pre x) c)
    (hnorm_x : WhRedPiKClosedCtxMajNormalizes E Γ x) :
    (∃ (w' : IotaWitnessS E) (lsC : List Level) (params fields : List (Expr Nat)),
      w'.recRef = w.recRef ∧
      params.length = w'.nparams ∧
      fields.length = w'.fields.length ∧
      WhRedPiKClosedCtxMaj E Γ x (foldApps (.const w'.ctorRef lsC) (params ++ fields)) ∧
      WhRedPiKClosedCtxMaj E Γ
        (recCall (.const w.recRef ls) pre x)
        (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema))) ∨
    ((piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) ∧
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) ∧
      WhRedPiKClosedCtxMaj E Γ
        (recCall (.const w.recRef ls) pre x)
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema))) := by
  unfold recCall at hrec
  rw [approxDIK_foldApps_iff] at hrec
  rcases hrec with ⟨d, hd, hfold⟩
  rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
    rfl |
    ⟨w', us_pre, us_fields, c₀, hrecEq, hpreLen, hfldsLen, _, rfl⟩ |
    ⟨w', us_pre, u_maj, c₀, hrecEq, hk', _, _, _, rfl⟩
  · exact (hne (foldAppCptK_bot_inv hfold)).elim
  · have hpreLenEq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrecEq).2.1
    have htotLen : (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length =
        (pre ++ [x]).length := by
      simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
    rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
    · exact (hne rfl).elim
    · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
        (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
      have hlenPre : us_pre.length = us_pre'.length := by
        rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
      obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
      cases hmajArgs with
      | cons hmaj _ =>
          cases hmajEq
          have htag_x : ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w') :=
            hmaj (ctorTagCpt w') (ctorTagCpt_mem_ctorDemand w' hfldsLen)
          obtain ⟨nf_x, hred_x, hnf_x⟩ := hnorm_x
          obtain ⟨lsC, params, fields, hpar, hflds, hred_ctor⟩ :=
            (approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes hW w' hred_x hnf_x).mp htag_x
          have hpre' : pre.length = w'.preMajor.length := by
            rw [hpre, hpreLenEq.symm]
          have hred_call : WhRedPiKClosedCtxMaj E Γ
              (recCall (.const w.recRef ls) pre x)
              (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) := by
            rw [← hrecEq]
            exact whRedPiKClosedCtxMaj_recCall_of_whRed_ctor hW w' ls lsC hpre' hpar hflds hred_ctor
          exact Or.inl ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, hred_call⟩
  · obtain ⟨_, _, _, _, _, hfamEq, hnminEq, _, _⟩ := iotaWitnessS_same_recRef w' w hrecEq
    rw [hfamEq, hnminEq] at hk'
    rcases approxDIK_ctorTagCpt_or_not_of_normalizes hW w hnorm_x with htag_x | hnot_tag
    · obtain ⟨nf_x, hred_x, hnf_x⟩ := hnorm_x
      obtain ⟨lsC, params, fields, hpar, hflds, hred_ctor⟩ :=
        (approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes hW w hred_x hnf_x).mp htag_x
      exact Or.inl ⟨w, lsC, params, fields, rfl, hpar, hflds, hred_ctor,
        whRedPiKClosedCtxMaj_recCall_of_whRed_ctor hW w ls lsC hpre hpar hflds hred_ctor⟩
    · exact Or.inr ⟨hk', hnot_tag,
        .step (.iotaKClosedCtx w ls pre x hk' hpre hnot_tag) (.refl _)⟩

/-- **Non-`.bot` `ProbeCpt` Inversion for `.app f a` When `f` Normalizes
    (`approxDIK_app_probeCpt_nonbot_of_fn_normalizes_inv`):**
    If `f` normalizes to `nf` under `WhRedPiKClosedCtxMaj E Γ` and `ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c`
    with `ProbeCpt c` and `c ≠ .bot`, then **strict recursor prefixes (`xs.length < w.preMajor.length`)
    are impossible**, so `nf` is either:
    1. a $\lambda$-abstraction `nf = .lam A' b` (so `.app f a ↠whMaj instantiate0 a b`), or
    2. an exact pre-major recursor prefix `nf = foldApps (.const w.recRef ls) pre` with
       `pre.length = w.preMajor.length` (so `.app f a ↠whMaj recCall (.const w.recRef ls) pre a`)! -/
theorem approxDIK_app_probeCpt_nonbot_of_fn_normalizes_inv {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {f nf a : Expr Nat} {c : CptI}
    (hred_f : WhRedPiKClosedCtxMaj E Γ f nf)
    (hnorm_f : WhNormalPiKClosedCtxMaj E Γ nf)
    (hc : ProbeCpt c) (hne : c ≠ .bot)
    (happ : ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c) :
    (∃ A' b, nf = .lam A' b ∧
      WhRedPiKClosedCtxMaj E Γ f (.lam A' b) ∧
      WhRedPiKClosedCtxMaj E Γ (.app f a) (instantiate0 a b)) ∨
    (∃ (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)),
      pre.length = w.preMajor.length ∧
      nf = foldApps (.const w.recRef ls) pre ∧
      WhRedPiKClosedCtxMaj E Γ (.app f a) (recCall (.const w.recRef ls) pre a) ∧
      ApproxDIK E (ctxEnvDIK E Γ) (recCall (.const w.recRef ls) pre a) c) := by
  rcases approxDIK_app_inv happ with rfl | ⟨g, _, _, hf_lam, _, _⟩ | ⟨_, _, _, rfl, _, _⟩
  · exact (hne rfl).elim
  · rcases approxDIK_lam_of_normalizes_inv hW hred_f hnorm_f hf_lam with
      ⟨A', b, rfl, hred_lam⟩ | ⟨w, ls, xs, hle, rfl, hred_rec⟩
    · refine Or.inl ⟨A', b, rfl, hred_lam, ?_⟩
      exact whRedPiKClosedCtxMaj_app_lam hred_lam a
    · have hred_app : WhRedPiKClosedCtxMaj E Γ (.app f a)
          (foldApps (.const w.recRef ls) (xs ++ [a])) := by
        rw [foldApps_snoc]
        exact whRedPiKClosedCtxMaj_foldApps hred_rec [a]
      have happ_rec : ApproxDIK E (ctxEnvDIK E Γ)
          (foldApps (.const w.recRef ls) (xs ++ [a])) c :=
        (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_app c).mp happ
      by_cases hlt : xs.length < w.preMajor.length
      · have hle' : (xs ++ [a]).length ≤ w.preMajor.length := by
          simp only [List.length_append, List.length_singleton]; omega
        exact (hne (approxDIK_recursor_prefix_probeCpt_eq_bot w ls (ctxEnvDIK E Γ)
          (xs ++ [a]) hle' hc happ_rec)).elim
      · have hpreEq : xs.length = w.preMajor.length := by omega
        exact Or.inr ⟨w, ls, xs, hpreEq, rfl, hred_app, happ_rec⟩
  · cases hc

/-- **3-Way $\beta$/$\iota$/$\iota_K$ Contractum Decomposition of `.app f a` When Both `f` and `a`
    Normalize (`approxDIK_app_probeCpt_nonbot_of_fn_and_arg_normalize_inv`):**
    If both `f` and `a` normalize under `WhRedPiKClosedCtxMaj E Γ` and
    `ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c` with `ProbeCpt c` and `c ≠ .bot`, then `.app f a`
    **always takes a weak-head step** under `WhRedPiKClosedCtxMaj E Γ` to either:
    1. a $\beta$-contractum `instantiate0 a b` (`f ↠whMaj .lam A' b`),
    2. a canonical $\iota$-contractum `instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)`
       (`f ↠whMaj foldApps (.const w.recRef ls) pre` and `a ↠whMaj foldApps (.const w'.ctorRef lsC) (params ++ fields)`), or
    3. a proposition-major $\iota_K$-contractum
       `instPrefix (pre ++ List.replicate w.fields.length botClosedExpr) (instantiateLevels ls w.schema)`! -/
theorem approxDIK_app_probeCpt_nonbot_of_fn_and_arg_normalize_inv {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {f nf a : Expr Nat} {c : CptI}
    (hred_f : WhRedPiKClosedCtxMaj E Γ f nf)
    (hnorm_f : WhNormalPiKClosedCtxMaj E Γ nf)
    (hnorm_a : WhRedPiKClosedCtxMajNormalizes E Γ a)
    (hc : ProbeCpt c) (hne : c ≠ .bot)
    (happ : ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c) :
    (∃ A' b, nf = .lam A' b ∧
      WhRedPiKClosedCtxMaj E Γ f (.lam A' b) ∧
      WhRedPiKClosedCtxMaj E Γ (.app f a) (instantiate0 a b)) ∨
    (∃ (w w' : IotaWitnessS E) (ls lsC : List Level) (pre params fields : List (Expr Nat)),
      pre.length = w.preMajor.length ∧
      w'.recRef = w.recRef ∧
      params.length = w'.nparams ∧
      fields.length = w'.fields.length ∧
      nf = foldApps (.const w.recRef ls) pre ∧
      WhRedPiKClosedCtxMaj E Γ a (foldApps (.const w'.ctorRef lsC) (params ++ fields)) ∧
      WhRedPiKClosedCtxMaj E Γ (.app f a)
        (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema))) ∨
    (∃ (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)),
      pre.length = w.preMajor.length ∧
      nf = foldApps (.const w.recRef ls) pre ∧
      (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) ∧
      ¬ ApproxDIK E (ctxEnvDIK E Γ) a (ctorTagCpt w) ∧
      WhRedPiKClosedCtxMaj E Γ (.app f a)
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema))) := by
  rcases approxDIK_app_probeCpt_nonbot_of_fn_normalizes_inv hW hred_f hnorm_f hc hne happ with
    ⟨A', b, hnfEq, hred_lam, hred_beta⟩ |
    ⟨w, ls, pre, hpre, hnfEq, hred_app, hrec_c⟩
  · exact Or.inl ⟨A', b, hnfEq, hred_lam, hred_beta⟩
  · rcases approxDIK_recCall_nonbot_of_major_normalizes_inv hW w ls hpre hne hrec_c hnorm_a with
      ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, hred_iota⟩ |
      ⟨hk, hnot_tag, hred_k⟩
    · exact Or.inr (Or.inl ⟨w, w', ls, lsC, pre, params, fields, hpre, hrecEq, hpar, hflds,
        hnfEq, hred_ctor, hred_app.trans hred_iota⟩)
    · exact Or.inr (Or.inr ⟨w, ls, pre, hpre, hnfEq, hk, hnot_tag, hred_app.trans hred_k⟩)

/-- **Constructive Non-`.bot` Probe Reduction of `AppDiagSupplyMajSemBi`
    (`appDiagSupplyMajSemBi_of_probe_nonbot`):**
    Strengthens §30.2's `appDiagSupplyMajSemBi_of_lam_probe` by supplying the caller with the
    non-`.bot` probe `c` (`hc : ProbeCpt c`, `hne : c ≠ .bot`), the graph entry `(s, c) ∈ g`,
    `ApproxDIK E (ctxEnvDIK E Γ) f (.lam g)`, `∀ u ∈ s, ApproxDIK E (ctxEnvDIK E Γ) a u`, and
    `ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c`, and requiring only
    `IsSemPropTyI E n Γ (instantiate0 a B) ∨ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a B) (.pi .bot []) ∨ LRProbeTypePiKClosedCtxMaj E n Γ (.app f a) (.app f a) c`! -/
theorem appDiagSupplyMajSemBi_of_probe_nonbot {E : ResolvedEnv} {n : Nat}
    (h : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B : Expr Nat} {c : CptI} {s : List CptI} {g : List (List CptI × CptI)},
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) →
        LRTermMajSemBi E n Γ a a A →
        ProbeCpt c → c ≠ .bot →
        ApproxDIK E (ctxEnvDIK E Γ) f (.lam g) →
        (s, c) ∈ g →
        (∀ u ∈ s, ApproxDIK E (ctxEnvDIK E Γ) a u) →
        ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c →
        IsSemPropTyI E n Γ (instantiate0 a B) ∨
        ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a B) (.pi .bot []) ∨
        LRProbeTypePiKClosedCtxMaj E n Γ (.app f a) (.app f a) c) :
    AppDiagSupplyMajSemBi E n := by
  intro Γ hΓ f a A B hf ha ih_f ih_a c hc hor
  have happ : ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c := hor.elim id id
  cases hc with
  | bot => exact Or.inr (Or.inr (.bot Γ (.app f a) (.app f a)))
  | sort =>
      rcases approxDIK_app_inv happ with
        hbot | ⟨g, ⟨s, c'⟩, heq, hflam, hmem, hau⟩ | ⟨_, _, _, hsp, _, _⟩
      · cases hbot
      · cases heq
        exact h hΓ hf ha ih_f ih_a .sort (by intro h0; cases h0) hflam hmem hau happ
      · cases hsp
  | piBotNil =>
      rcases approxDIK_app_inv happ with
        hbot | ⟨g, ⟨s, c'⟩, heq, hflam, hmem, hau⟩ | ⟨_, _, _, hsp, _, _⟩
      · cases hbot
      · cases heq
        exact h hΓ hf ha ih_f ih_a .piBotNil (by intro h0; cases h0) hflam hmem hau happ
      · cases hsp

/-! ### §31.2. Convertible Let-Value Context Refinement `CtxRefinesMaj`, Factorization
`Γ →[CtxRefines] midCtx →[CtxConvT] Γ'`, and Two-Let-Diagonal `ConvT.letE` & `ConvT.app`
Congruence Without `TypedWhAdequateMaj` -/

/-- **Convertible Let-Value Context Refinement (`CtxRefinesMaj E n Γ Γ'`):**
    Extends `CtxRefines Γ Γ'` with `letBindingConv`, allowing `.letBinding A v₁ :: Γ` to refine to
    `.letBinding A v₂ :: Γ'` whenever `v₁` and `v₂` are `ConvT`-convertible and `LRTermMajSemBi`-related
    in `Γ'`. All binder types `A` remain syntactically identical (`lookupType Γ' i = lookupType Γ i`),
    and every `href : CtxRefinesMaj E n Γ Γ'` factors as
    `Γ →[CtxRefines] midCtx href →[CtxConvT E n] Γ'`! -/
inductive CtxRefinesMaj (E : ResolvedEnv) (n : Nat) : LCtx → LCtx → Type
  | nil : CtxRefinesMaj E n [] []
  | assumption {A : Expr Nat} {Γ Γ' : LCtx} :
      CtxRefinesMaj E n Γ Γ' → CtxRefinesMaj E n (.assumption A :: Γ) (.assumption A :: Γ')
  | letBinding {A v : Expr Nat} {Γ Γ' : LCtx} :
      CtxRefinesMaj E n Γ Γ' → CtxRefinesMaj E n (.letBinding A v :: Γ) (.letBinding A v :: Γ')
  | letBindingConv {A v₁ v₂ : Expr Nat} {u : Level} {Γ Γ' : LCtx} :
      CtxRefinesMaj E n Γ Γ' →
      HasTyT E n Γ' A (.sort u) →
      HasTyT E n Γ' v₂ A →
      ConvT E n Γ' v₁ v₂ A →
      LRTermMajSemBi E n Γ' v₁ v₂ A →
      CtxRefinesMaj E n (.letBinding A v₁ :: Γ) (.letBinding A v₂ :: Γ')
  | assumpToLet {A v : Expr Nat} {Γ Γ' : LCtx} :
      CtxRefinesMaj E n Γ Γ' → CtxRefinesMaj E n (.assumption A :: Γ) (.letBinding A v :: Γ')

def ctxRefinesMaj_refl (E : ResolvedEnv) (n : Nat) : (Γ : LCtx) → CtxRefinesMaj E n Γ Γ
  | [] => .nil
  | .assumption _ :: Γ => .assumption (ctxRefinesMaj_refl E n Γ)
  | .letBinding _ _ :: Γ => .letBinding (ctxRefinesMaj_refl E n Γ)

def ctxRefinesMaj_of_ctxRefines {E : ResolvedEnv} {n : Nat} :
    {Γ Γ' : LCtx} → CtxRefines Γ Γ' → CtxRefinesMaj E n Γ Γ'
  | [], [], _ => .nil
  | [], _ :: _, h => False.elim (by cases h)
  | _ :: _, [], h => False.elim (by cases h)
  | .assumption A :: Γ, .assumption A' :: Γ', h =>
      have hEq : A' = A ∧ CtxRefines Γ Γ' := by cases h; exact ⟨rfl, ‹_›⟩
      hEq.1 ▸ .assumption (ctxRefinesMaj_of_ctxRefines hEq.2)
  | .assumption A :: Γ, .letBinding A' v :: Γ', h =>
      have hEq : A' = A ∧ CtxRefines Γ Γ' := by cases h; exact ⟨rfl, ‹_›⟩
      hEq.1 ▸ .assumpToLet (ctxRefinesMaj_of_ctxRefines hEq.2)
  | .letBinding _ _ :: _, .assumption _ :: _, h => False.elim (by cases h)
  | .letBinding A v :: Γ, .letBinding A' v' :: Γ', h =>
      have hEq : A' = A ∧ v' = v ∧ CtxRefines Γ Γ' := by cases h; exact ⟨rfl, rfl, ‹_›⟩
      hEq.1 ▸ hEq.2.1 ▸ .letBinding (ctxRefinesMaj_of_ctxRefines hEq.2.2)

/-- Intermediate context `midCtx href` factoring `CtxRefinesMaj E n Γ Γ'` into
    `CtxRefines Γ (midCtx href)` followed by `CtxConvT E n (midCtx href) Γ'` (`midCtx`). -/
def midCtx {E : ResolvedEnv} {n : Nat} : {Γ Γ' : LCtx} → CtxRefinesMaj E n Γ Γ' → LCtx
  | _, _, .nil => []
  | _, _, .assumption (A := A) href => .assumption A :: midCtx href
  | _, _, .letBinding (A := A) (v := v) href => .letBinding A v :: midCtx href
  | _, _, .letBindingConv (A := A) (v₁ := v₁) href _ _ _ _ => .letBinding A v₁ :: midCtx href
  | _, _, .assumpToLet (A := A) (v := v) href => .letBinding A v :: midCtx href

theorem ctxRefines_midCtx {E : ResolvedEnv} {n : Nat} :
    {Γ Γ' : LCtx} → (href : CtxRefinesMaj E n Γ Γ') → CtxRefines Γ (midCtx href)
  | _, _, .nil => .nil
  | _, _, .assumption href => .assumption (ctxRefines_midCtx href)
  | _, _, .letBinding href => .letBinding (ctxRefines_midCtx href)
  | _, _, .letBindingConv href _ _ _ _ => .letBinding (ctxRefines_midCtx href)
  | _, _, .assumpToLet href => .assumpToLet (ctxRefines_midCtx href)

def ctxConvT_midCtx {E : ResolvedEnv} {n : Nat} :
    {Γ Γ' : LCtx} → (href : CtxRefinesMaj E n Γ Γ') → CtxConvT E n (midCtx href) Γ'
  | _, _, .nil => .nil
  | _, _, .assumption (A := A) href => .same (.assumption A) (ctxConvT_midCtx href)
  | _, _, .letBinding (A := A) (v := v) href => .same (.letBinding A v) (ctxConvT_midCtx href)
  | _, _, .letBindingConv (A := A) (u := u) (Γ' := Γ'₀) href hA hv₂ hcv _ =>
      .letBinding (ctxConvT_midCtx href) hA hA (.refl Γ'₀ A (.sort u) hA) hv₂ hcv
  | _, _, .assumpToLet (A := A) (v := v) href => .same (.letBinding A v) (ctxConvT_midCtx href)

/-- 1-line transport of `HasTyT` along `CtxRefinesMaj E n Γ Γ'` (`hasTyT_of_ctxRefinesMaj`). -/
def hasTyT_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ Γ' : LCtx} {e A : Expr Nat} (h : HasTyT E n Γ e A)
    (href : CtxRefinesMaj E n Γ Γ') : HasTyT E n Γ' e A :=
  hasTyT_ctx (envClosed_of_envWfT hW) (ctxConvT_midCtx href)
    (hasTyT_of_ctxRefines h (ctxRefines_midCtx href))

/-- 1-line transport of `ConvT` along `CtxRefinesMaj E n Γ Γ'` (`convT_of_ctxRefinesMaj`). -/
def convT_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ Γ' : LCtx} {a b A : Expr Nat} (h : ConvT E n Γ a b A)
    (href : CtxRefinesMaj E n Γ Γ') : ConvT E n Γ' a b A :=
  convT_ctx (envClosed_of_envWfT hW) (ctxConvT_midCtx href)
    (convT_of_ctxRefines h (ctxRefines_midCtx href))

/-- Transport of `TyConvT` along `CtxRefinesMaj E n Γ Γ'` (`tyConvT_of_ctxRefinesMaj`). -/
def tyConvT_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E) :
    {Γ : LCtx} → {A B : Expr Nat} → TyConvT E n Γ A B →
    {Γ' : LCtx} → CtxRefinesMaj E n Γ Γ' → TyConvT E n Γ' A B
  | _, _, _, .refl _ A, _, _ => .refl _ A
  | _, _, _, .of _ A B u h, _, href => .of _ A B u (convT_of_ctxRefinesMaj hW h href)
  | _, _, _, .trans _ A B C h₁ h₂, _, href =>
      .trans _ A B C (tyConvT_of_ctxRefinesMaj hW h₁ href) (tyConvT_of_ctxRefinesMaj hW h₂ href)

theorem lookupType_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat}
    {Γ Γ' : LCtx} (href : CtxRefinesMaj E n Γ Γ') (i : Nat) :
    lookupType Γ' i = lookupType Γ i := by
  induction href generalizing i with
  | nil => rfl
  | assumption _ ih =>
      cases i with
      | zero => rfl
      | succ i => simp only [lookupType_cons_succ, ih i]
  | letBinding _ ih =>
      cases i with
      | zero => rfl
      | succ i => simp only [lookupType_cons_succ, ih i]
  | letBindingConv _ _ _ _ _ ih =>
      cases i with
      | zero => rfl
      | succ i => simp only [lookupType_cons_succ, ih i]
  | assumpToLet _ ih =>
      cases i with
      | zero => rfl
      | succ i => simp only [lookupType_cons_succ, ih i]

private theorem lookupValue_succ_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ Γ' : LCtx} (d d' : LocalDecl) {i : Nat} {v A : Expr Nat}
    (ih : ∀ {i : Nat} {v A : Expr Nat},
      lookupValue Γ i = some v → lookupType Γ i = some A →
      ∃ v', lookupValue Γ' i = some v' ∧ (v' = v ∨ LRTermMajSemBi E n Γ' v v' A))
    (hval : lookupValue (d :: Γ) (i + 1) = some v)
    (hty : lookupType (d :: Γ) (i + 1) = some A) :
    ∃ v', lookupValue (d' :: Γ') (i + 1) = some v' ∧
      (v' = v ∨ LRTermMajSemBi E n (d' :: Γ') v v' A) := by
  rw [lookupValue_cons_succ] at hval
  rw [lookupType_cons_succ] at hty
  cases hv₀ : lookupValue Γ i with
  | none => rw [hv₀] at hval; cases hval
  | some v₀ =>
      rw [hv₀, Option.map_some'] at hval
      injection hval with hvEq
      subst hvEq
      cases hA₀ : lookupType Γ i with
      | none => rw [hA₀] at hty; cases hty
      | some A₀ =>
          rw [hA₀, Option.map_some'] at hty
          injection hty with hAEq
          subst hAEq
          obtain ⟨v₀', hval', heq | hlr⟩ := ih hv₀ hA₀
          · subst heq
            exact ⟨lift 0 1 v₀', by rw [lookupValue_cons_succ, hval']; rfl, Or.inl rfl⟩
          · exact ⟨lift 0 1 v₀', by rw [lookupValue_cons_succ, hval']; rfl,
              Or.inr (lrTermMajSemBi_weaken0 (envClosed_of_envWfT hW) d' hlr)⟩

/-- Value lookup across `CtxRefinesMaj E n Γ Γ'` (`lookupValue_of_ctxRefinesMaj`). -/
theorem lookupValue_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ Γ' : LCtx} (href : CtxRefinesMaj E n Γ Γ') {i : Nat} {v A : Expr Nat}
    (hval : lookupValue Γ i = some v) (hty : lookupType Γ i = some A) :
    ∃ v', lookupValue Γ' i = some v' ∧ (v' = v ∨ LRTermMajSemBi E n Γ' v v' A) := by
  induction href generalizing i v A with
  | nil => cases i <;> simp [lookupValue] at hval
  | @assumption B _ _ _ ih =>
      cases i with
      | zero => simp [lookupValue] at hval
      | succ i =>
          exact lookupValue_succ_of_ctxRefinesMaj hW (.assumption B) (.assumption B) ih hval hty
  | @letBinding B w _ _ _ ih =>
      cases i with
      | zero =>
          simp only [lookupValue] at hval ⊢
          exact ⟨v, hval, Or.inl rfl⟩
      | succ i =>
          exact lookupValue_succ_of_ctxRefinesMaj hW (.letBinding B w) (.letBinding B w) ih hval hty
  | @letBindingConv B v₁ v₂ _ Γ₀ Γ'₀ _ _ _ _ ih_v ih =>
      cases i with
      | zero =>
          have hval0 : lookupValue (.letBinding B v₁ :: Γ₀) 0 = some (lift 0 1 v₁) := rfl
          have hty0 : lookupType (.letBinding B v₁ :: Γ₀) 0 = some (lift 0 1 B) := rfl
          have hvEq : v = lift 0 1 v₁ := Option.some.inj (hval.symm.trans hval0)
          have hAEq : A = lift 0 1 B := Option.some.inj (hty.symm.trans hty0)
          subst hvEq; subst hAEq
          exact ⟨lift 0 1 v₂, rfl,
            Or.inr (lrTermMajSemBi_weaken0 (envClosed_of_envWfT hW) (.letBinding B v₂) ih_v)⟩
      | succ i =>
          exact lookupValue_succ_of_ctxRefinesMaj hW (.letBinding B v₁) (.letBinding B v₂) ih hval hty
  | @assumpToLet B w _ _ _ ih =>
      cases i with
      | zero => simp [lookupValue] at hval
      | succ i =>
          exact lookupValue_succ_of_ctxRefinesMaj hW (.assumption B) (.letBinding B w) ih hval hty

/-- `ConvT.zetaLocal` in `LRTermMajSemBi` across any `CtxRefinesMaj E n Γ Γ'`
    (`lrTermMajSemBi_zetaLocal_of_ctxRefinesMaj`). -/
theorem lrTermMajSemBi_zetaLocal_of_ctxRefinesMaj {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ Γ' : LCtx} (href : CtxRefinesMaj E n Γ Γ')
    (hΓ' : CtxWfT E n Γ') {i : Nat} {v A : Expr Nat}
    (hval : lookupValue Γ i = some v) (hty : lookupType Γ i = some A)
    (ih_v : LRTermMajSemBi E n Γ' v v A) :
    LRTermMajSemBi E n Γ' (.bvar i) v A := by
  obtain ⟨v', hval', rfl | hvv'⟩ := lookupValue_of_ctxRefinesMaj hW href hval hty
  · exact lrTermMajSemBi_zetaLocal hW hval' ih_v
  · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
      (.step (.zetaLocal hval') (.refl v')) (.refl v)
      (lrTermMajSemBi_symm hW hΓ' hvv')

/-- **Left-Head `ConvT.app` Congruence in `LRTermMajSemBi` from `AppDiagSupplyMajSemBi` and
    `TypedSubst0CongrSupplyMajSemBi` (`lrTermMajSemBi_app_fn_congr_of_appDiag_and_typedSubst0`):**
    Uses `hAppDiag` on `(f₁, a)` and `(f₂, a)` in `Γ` to supply **both** let-context diagonals
    `hb_let₁` and `hb_let₂` (and `hb_inst₁, hb_inst₂`) to `TypedSubst0CongrSupplyMajSemBi`, with
    **zero `TypedWhAdequateMaj E n`**! -/
theorem lrTermMajSemBi_app_fn_congr_of_appDiag_and_typedSubst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAppDiag : AppDiagSupplyMajSemBi E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ a A B : Expr Nat}
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B))
    (ha : HasTyT E n Γ a A)
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a a A) :
    LRTermMajSemBi E n Γ (.app f₁ a) (.app f₂ a) (instantiate0 a B) := by
  have endsf := convEnds hW hΓ hcf
  obtain ⟨u_pi, hpiAB⟩ := endsf.2.2
  have hb₁ : HasTyT E n (.letBinding (.pi A B) f₁ :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (lift 0 1 (instantiate0 a B)) :=
    hasTyT_letBinding_app_bvar0_lift0 hW f₁ ha
  have hb₂ : HasTyT E n (.letBinding (.pi A B) f₂ :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (lift 0 1 (instantiate0 a B)) :=
    hasTyT_letBinding_app_bvar0_lift0 hW f₂ ha
  have ih_app₁ : LRTermMajSemBi E n Γ (.app f₁ a) (.app f₁ a) (instantiate0 a B) :=
    hAppDiag hΓ endsf.1 ha (lrTermMajSemBi_diag_left ih_f) ih_a
  have ih_app₂ : LRTermMajSemBi E n Γ (.app f₂ a) (.app f₂ a) (instantiate0 a B) :=
    hAppDiag hΓ endsf.2.1 ha (lrTermMajSemBi_diag_right ih_f) ih_a
  have hb_let₁ : LRTermMajSemBi E n (.letBinding (.pi A B) f₁ :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (.app (.bvar 0) (lift 0 1 a))
      (lift 0 1 (instantiate0 a B)) :=
    lrTermMajSemBi_letBinding_app_bvar0_lift0_of_app_diag hW A ih_app₁
  have hb_let₂ : LRTermMajSemBi E n (.letBinding (.pi A B) f₂ :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (.app (.bvar 0) (lift 0 1 a))
      (lift 0 1 (instantiate0 a B)) :=
    lrTermMajSemBi_letBinding_app_bvar0_lift0_of_app_diag hW A ih_app₂
  have hb_inst₁ := lrTermMajSemBi_substLet0 hW endsf.1 hb_let₁
  have hb_inst₂ := lrTermMajSemBi_substLet0 hW endsf.2.1 hb_let₂
  have h_fn0 := hSubst0 hΓ hpiAB endsf.1 endsf.2.1 hcf hb₁ hb₂ ih_f
    hb_let₁ hb_let₂ hb_inst₁ hb_inst₂
  have hcancel : instantiate0 f₁ (lift 0 1 (instantiate0 a B)) = instantiate0 a B :=
    (instantiate_lift_cancel 1 0 0 f₁ (Nat.le_refl 0) Nat.zero_lt_one (instantiate0 a B)).trans
      (lift_zero 0 (instantiate0 a B))
  rwa [instantiate0_app_bvar0_lift0 f₁ a, instantiate0_app_bvar0_lift0 f₂ a, hcancel] at h_fn0

/-- **Right-Argument `ConvT.app` Congruence in `LRTermMajSemBi` from `AppDiagSupplyMajSemBi` and
    `TypedSubst0CongrSupplyMajSemBi` (`lrTermMajSemBi_app_arg_congr_of_appDiag_and_typedSubst0`):**
    Uses `lrTermMajSemBi_letBinding_app_lift0_bvar0_of_appDiag` in `.letBinding A a₁ :: Γ` and
    `.letBinding A a₂ :: Γ` to supply **both** `hb_let₁` and `hb_let₂` (and `hb_inst₁, hb_inst₂`)
    to `TypedSubst0CongrSupplyMajSemBi`, with **zero `TypedWhAdequateMaj E n`**! -/
theorem lrTermMajSemBi_app_arg_congr_of_appDiag_and_typedSubst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAppDiag : AppDiagSupplyMajSemBi E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f a₁ a₂ A B : Expr Nat}
    (hf : HasTyT E n Γ f (.pi A B))
    (hca : ConvT E n Γ a₁ a₂ A)
    (ih_f : LRTermMajSemBi E n Γ f f (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a₁ a₂ A) :
    LRTermMajSemBi E n Γ (.app f a₁) (.app f a₂) (instantiate0 a₁ B) := by
  have endsa := convEnds hW hΓ hca
  obtain ⟨u_A, hA⟩ := endsa.2.2
  have hb₁ : HasTyT E n (.letBinding A a₁ :: Γ) (.app (lift 0 1 f) (.bvar 0)) B :=
    hasTyT_letBinding_app_lift0_bvar0 hW a₁ hf
  have hb₂ : HasTyT E n (.letBinding A a₂ :: Γ) (.app (lift 0 1 f) (.bvar 0)) B :=
    hasTyT_letBinding_app_lift0_bvar0 hW a₂ hf
  have hb_let₁ : LRTermMajSemBi E n (.letBinding A a₁ :: Γ)
      (.app (lift 0 1 f) (.bvar 0)) (.app (lift 0 1 f) (.bvar 0)) B :=
    lrTermMajSemBi_letBinding_app_lift0_bvar0_of_appDiag hW hAppDiag hΓ hA hf endsa.1
      ih_f (lrTermMajSemBi_diag_left ih_a)
  have hb_let₂ : LRTermMajSemBi E n (.letBinding A a₂ :: Γ)
      (.app (lift 0 1 f) (.bvar 0)) (.app (lift 0 1 f) (.bvar 0)) B :=
    lrTermMajSemBi_letBinding_app_lift0_bvar0_of_appDiag hW hAppDiag hΓ hA hf endsa.2.1
      ih_f (lrTermMajSemBi_diag_right ih_a)
  have hb_inst₁ := lrTermMajSemBi_substLet0 hW endsa.1 hb_let₁
  have hb_inst₂ := lrTermMajSemBi_substLet0 hW endsa.2.1 hb_let₂
  have h_arg0 := hSubst0 hΓ hA endsa.1 endsa.2.1 hca hb₁ hb₂ ih_a
    hb_let₁ hb_let₂ hb_inst₁ hb_inst₂
  rwa [instantiate0_app_lift0_bvar0_arg f a₁, instantiate0_app_lift0_bvar0_arg f a₂] at h_arg0

/-- **Full Two-Sided `ConvT.app` Congruence in `LRTermMajSemBi` from `AppDiagSupplyMajSemBi` and
