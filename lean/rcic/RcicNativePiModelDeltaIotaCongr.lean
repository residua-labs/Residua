/-- **`ConvT.irr` Rule for `LRAppFnMajSemBi` on `Prop`-Typed Codomains
    (`lrAppFnMajSemBi_irr_of_codomain_no_whRed_sort`):**
    Whenever `B` is typed at `.sort .zero` in `.assumption A :: Γ` and for every `ha : HasTyT E n Γ a A`,
    `instantiate0 a B` satisfies `LRTermMajSemBi` at `.sort .zero` and does not weak-head reduce to
    any `.sort l`, **every** pair `p, q : Expr Nat` satisfies `LRAppFnMajSemBi E n Γ p q A B`! -/
theorem lrAppFnMajSemBi_irr_of_codomain_no_whRed_sort
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat}
    (hB0 : HasTyT E n (.assumption A :: Γ) B (.sort .zero))
    (ih_B : ∀ {a : Expr Nat}, HasTyT E n Γ a A →
      LRTermMajSemBi E n Γ (instantiate0 a B) (instantiate0 a B) (.sort .zero))
    (hno : ∀ {a : Expr Nat} (l : Level), HasTyT E n Γ a A →
      ¬ WhRedPiKClosedCtxMaj E Γ (instantiate0 a B) (.sort l))
    (p q : Expr Nat) :
    LRAppFnMajSemBi E n Γ p q A B := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  intro a₁ _ ha₁ _ _ _
  refine lrTermMajSemBi_of_isSemPropTyI ?_
  have hget0 : (LocalDecl.assumption A :: Γ)[0]? = some (.assumption A) := by simp
  have hinstB0 : HasTyT E n Γ (instantiate0 a₁ B) (.sort .zero) := by
    simpa only [substRemove_zero_cons, lift_zero, instantiate0] using
      hasTyT_substS hcl hinst _ A hB0 hget0
        (by simpa only [substRemove_zero_cons, lift_zero] using ha₁)
  exact (isSemPropTyI_iff_no_whRed_sort_of_majSemBi hW hinstB0 (ih_B ha₁)).mpr
    (fun l => hno l ha₁)

/-- Diagonal specialization of `lrAppFnMajSemBi_irr_of_codomain_no_whRed_sort`
    (`lrAppFnDiagMajSemBi_irr_of_codomain_no_whRed_sort`). -/
theorem lrAppFnDiagMajSemBi_irr_of_codomain_no_whRed_sort
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat}
    (hB0 : HasTyT E n (.assumption A :: Γ) B (.sort .zero))
    (ih_B : ∀ {a : Expr Nat}, HasTyT E n Γ a A →
      LRTermMajSemBi E n Γ (instantiate0 a B) (instantiate0 a B) (.sort .zero))
    (hno : ∀ {a : Expr Nat} (l : Level), HasTyT E n Γ a A →
      ¬ WhRedPiKClosedCtxMaj E Γ (instantiate0 a B) (.sort l))
    (p : Expr Nat) :
    LRAppFnDiagMajSemBi E n Γ p A B :=
  fun {a} ha ih_a =>
    (lrAppFnMajSemBi_irr_of_codomain_no_whRed_sort hW hB0 ih_B hno p p)
      ha ha (.refl _ a _ ha) ih_a

