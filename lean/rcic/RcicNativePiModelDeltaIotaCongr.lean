/-- **Two-Way Domain/Codomain Type-Conversion Invariance (`↔`) for `LRAppFnDiagMajSemBi`
    (`lrAppFnDiagMajSemBi_tyConv_iff`):** -/
theorem lrAppFnDiagMajSemBi_tyConv_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f A₁ A₂ B₁ B₂ : Expr Nat} {u₁ u₂ : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u₁))
    (ih_A : LRTermMajSemBi E n Γ A₁ A₂ (.sort u₁))
    (hcB : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂)
    (ih_B : ∀ {a : Expr Nat}, HasTyT E n Γ a A₁ →
      LRTermMajSemBi E n (.letBinding A₁ a :: Γ) B₁ B₂ (.sort u₂)) :
    LRAppFnDiagMajSemBi E n Γ f A₁ B₁ ↔ LRAppFnDiagMajSemBi E n Γ f A₂ B₂ := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have ih_A_symm := lrTermMajSemBi_symm hW hΓ ih_A
  constructor
  · intro hf a ha₂ ih_a₂
    have ha₁ : HasTyT E n Γ a A₁ := .conv Γ a A₂ A₁ u₁ ha₂ (.symm _ _ _ _ hcA)
    have ih_a₁ : LRTermMajSemBi E n Γ a a A₁ :=
      lrTermMajSemBi_tyConv_of_bi hW (.of Γ A₂ A₁ u₁ (.symm _ _ _ _ hcA)) ih_a₂ ih_A_symm
    have hget0 : (LocalDecl.assumption A₁ :: Γ)[0]? = some (.assumption A₁) := by simp
    have hcB_inst : TyConvT E n Γ (instantiate0 a B₁) (instantiate0 a B₂) := by
      simpa only [substRemove_zero_cons, lift_zero, instantiate0] using
        tyConvT_substS hcl hinst a A₁ hcB hget0
          (by simpa only [substRemove_zero_cons, lift_zero] using ha₁)
    exact lrTermMajSemBi_tyConv_of_bi hW hcB_inst (hf ha₁ ih_a₁)
      (lrTermMajSemBi_substLet0 hW ha₁ (ih_B ha₁))
  · intro hf a ha₁ ih_a₁
