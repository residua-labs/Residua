    (lrTermMajSemBi_letBinding_lift0_instantiate0_iff hW ht hw0 hA).mp
      (lrTermMajSemBi_weaken0 hcl (.letBinding t w0) ih_a)
  have happ := lrTermMajSemBi_substLet0 hW hw0 (hM ha₁_let ha₂_let hca_let ih_a_let)
