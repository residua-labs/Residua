/-! ### §22.3. Recursor Prefix Exclusion (`approxDIK_recursor_prefix_probeCpt_eq_bot`) and
Unconditional Proposition-Major K-Recursor Spine Congruence in `LRTermDSubKClosedCtxBi` and
`LRTermDSubKClosedCtxSemBi` -/

/-- Applying `curryStep uss c₀` to strictly fewer than `uss.length` arguments in `ApproxDIK`
    yields only `.bot` or `.lam g` compacts (never `.sort`, `.pi a f`, or `.spine r args`). -/
theorem foldAppCptK_curryStep_lt {E : ResolvedEnv} {ρ : EnvI} :
    ∀ (xs : List (Expr Nat)) (uss : List (List CptI)) (c₀ c : CptI),
      xs.length < uss.length →
      FoldAppCptK E ρ (curryStep uss c₀) xs c →
      c = .bot ∨ ∃ g, c = .lam g
  | [], [], _, _, hlt, _ => by simp at hlt
  | [], us :: uss, c₀, c, _, h => by
      cases h with
      | bot => exact Or.inl rfl
      | nil => exact Or.inr ⟨[(us, curryStep uss c₀)], rfl⟩
  | _ :: _, [], _, _, hlt, _ => by simp at hlt
  | _ :: xs, _ :: uss, c₀, c, hlt, h => by
      cases h with
      | bot => exact Or.inl rfl
      | cons hstep hrest =>
          cases hstep with
          | bot => exact Or.inl (foldAppCptK_bot_inv hrest)
          | app hs _ =>
              have heq := List.mem_singleton.mp hs
              cases heq
              simp only [List.length_cons] at hlt
              exact foldAppCptK_curryStep_lt xs uss c₀ c (by omega) hrest

/-- **Recursor Prefix `ProbeCpt` Exclusion in `ApproxDIK`
    (`approxDIK_recursor_prefix_probeCpt_eq_bot`):**
    For **every** admitted recursor `w : IotaWitnessS E` and **every** argument list `xs` with
    `xs.length ≤ w.preMajor.length` (any partial application before the major premise is supplied),
    the ONLY `ProbeCpt` compact in `ApproxDIK E ρ (foldApps (.const w.recRef ls) xs)` is `c = .bot`! -/
theorem approxDIK_recursor_prefix_probeCpt_eq_bot {E : ResolvedEnv} (w : IotaWitnessS E)
    (ls : List Level) (ρ : EnvI) (xs : List (Expr Nat))
    (hlen : xs.length ≤ w.preMajor.length)
    {c : CptI} (hc : ProbeCpt c)
    (h : ApproxDIK E ρ (foldApps (.const w.recRef ls) xs) c) :
    c = .bot := by
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
    rfl | ⟨w', us_pre, us_fields, c₀, hrec', hpre', _, _, rfl⟩ |
      ⟨w', us_pre, u_maj, c₀, hrec', _, hpre', _, _, rfl⟩
  · exact foldAppCptK_bot_inv hfold
  · have hpre_eq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrec').2.1
    have hlt : xs.length < (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length := by
      simp only [List.length_append, List.length_singleton, hpre', hpre_eq]
      omega
    rcases foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold with rfl | ⟨g, rfl⟩
    · rfl
    · cases hc
  · have hpre_eq : w'.preMajor.length = w.preMajor.length :=
      (iotaWitnessS_same_recRef w' w hrec').2.1
    have hlt : xs.length < (us_pre ++ [u_maj]).length := by
      simp only [List.length_append, List.length_singleton, hpre', hpre_eq]
      omega
    rcases foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold with rfl | ⟨g, rfl⟩
    · rfl
    · cases hc

/-- **Unconditional Relatedness of All Partial Recursor Applications in `LRTermDSubKClosedCtxBi`
    (`lrTermDSubKClosedCtxBi_recursor_prefix`):**
    Any two partial recursor applications `foldApps (.const w₁.recRef ls₁) xs₁` and
    `foldApps (.const w₂.recRef ls₂) xs₂` with `xs₁.length ≤ w₁.preMajor.length` and
    `xs₂.length ≤ w₂.preMajor.length` are unconditionally related in `LRTermDSubKClosedCtxBi` at
    every type `T`! -/
theorem lrTermDSubKClosedCtxBi_recursor_prefix {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    (xs₁ xs₂ : List (Expr Nat))
    (hlen₁ : xs₁.length ≤ w₁.preMajor.length)
    (hlen₂ : xs₂.length ≤ w₂.preMajor.length)
    (T : Expr Nat) :
    LRTermDSubKClosedCtxBi E n Γ
      (foldApps (.const w₁.recRef ls₁) xs₁)
      (foldApps (.const w₂.recRef ls₂) xs₂) T :=
  lrTermDSubKClosedCtxBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₁ ls₁ (ctxEnvDIK E Γ) xs₁ hlen₁ hc h)
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₂ ls₂ (ctxEnvDIK E Γ) xs₂ hlen₂ hc h)

/-- **Unconditional Relatedness of All Partial Recursor Applications in `LRTermDSubKClosedCtxSemBi`
    Requiring Zero `PropTyTransport` and Zero `SortRow`
    (`lrTermDSubKClosedCtxSemBi_recursor_prefix`):** -/
theorem lrTermDSubKClosedCtxSemBi_recursor_prefix {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    (xs₁ xs₂ : List (Expr Nat))
    (hlen₁ : xs₁.length ≤ w₁.preMajor.length)
    (hlen₂ : xs₂.length ≤ w₂.preMajor.length)
    (T : Expr Nat) :
    LRTermDSubKClosedCtxSemBi E n Γ
      (foldApps (.const w₁.recRef ls₁) xs₁)
      (foldApps (.const w₂.recRef ls₂) xs₂) T :=
  lrTermDSubKClosedCtxSemBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₁ ls₁ (ctxEnvDIK E Γ) xs₁ hlen₁ hc h)
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₂ ls₂ (ctxEnvDIK E Γ) xs₂ hlen₂ hc h)

/-- **Single-Step K-Reduction of Applied Proposition-Major Recursor Spines in `WhStepPiKClosedCtx`
    (`whStepPiKClosedCtx_recursor_k_foldApps`):**
    For any single-constructor `Prop` recursor witness `w : IotaWitnessS E` with
    `w.fields = List.replicate w.fields.length botClosedExpr`, any `maj : Expr Nat` with no
    `.spine w.ctorRef _` compact in `ApproxDIK E (ctxEnvDIK E Γ)`, and any trailing arguments
    `rest : List (Expr Nat)`, `foldApps (.const w.recRef w.ls) (w.preMajor ++ maj :: rest)` steps
    in ONE `WhStepPiKClosedCtx` step to `foldApps (iotaRhsOfS w) rest` (completely independent of
    `maj`!). -/
theorem whStepPiKClosedCtx_recursor_k_foldApps {E : ResolvedEnv} {Γ : LCtx}
    (w : IotaWitnessS E)
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hflds : w.fields = List.replicate w.fields.length botClosedExpr)
    {maj : Expr Nat}
    (hmaj : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj (.spine w.ctorRef args))
    (rest : List (Expr Nat)) :
    WhStepPiKClosedCtx E Γ
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj :: rest))
      (foldApps (iotaRhsOfS w) rest) := by
  have hhead : WhStepPiKClosedCtx E Γ (recCall (.const w.recRef w.ls) w.preMajor maj) (iotaRhsOfS w) :=
    .iotaKClosedCtx w maj hk hflds hmaj
  have hstep := whStepPiKClosedCtx_foldApps hhead rest
  have heq : foldApps (recCall (.const w.recRef w.ls) w.preMajor maj) rest =
      foldApps (.const w.recRef w.ls) (w.preMajor ++ maj :: rest) := by
    rw [recCall, ← foldApps_append, List.append_assoc, List.singleton_append]
  rwa [heq] at hstep

/-- **Unconditional `SemEqDIK` Identification of Applied Proposition-Major Recursor Spines
    Across All Non-Constructor Majors (`semEqDIK_ctxEnvDIK_recursor_k_foldApps`):** -/
theorem semEqDIK_ctxEnvDIK_recursor_k_foldApps {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E)
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hflds : w.fields = List.replicate w.fields.length botClosedExpr)
    {maj₁ maj₂ : Expr Nat}
    (hmaj₁ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₁ (.spine w.ctorRef args))
    (hmaj₂ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₂ (.spine w.ctorRef args))
    (rest : List (Expr Nat)) :
    SemEqDIK E (ctxEnvDIK E Γ)
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₁ :: rest))
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₂ :: rest)) :=
  semEqDIK_trans
    (semEqDIK_ctxEnvDIK_whStepPiKClosedCtx hW
      (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₁ rest))
    (semEqDIK_symm
      (semEqDIK_ctxEnvDIK_whStepPiKClosedCtx hW
        (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₂ rest)))

/-- **Exact Equivalence (`↔`) of Applied Proposition-Major K-Recursor Spine Congruence to the
    Shared K-Reduct Diagonal in `LRTermDSubKClosedCtxBi`
    (`lrTermDSubKClosedCtxBi_recursor_k_congr_iff`):** -/
theorem lrTermDSubKClosedCtxBi_recursor_k_congr_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E)
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hflds : w.fields = List.replicate w.fields.length botClosedExpr)
    {maj₁ maj₂ : Expr Nat}
    (hmaj₁ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₁ (.spine w.ctorRef args))
    (hmaj₂ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₂ (.spine w.ctorRef args))
    (rest : List (Expr Nat)) (T : Expr Nat) :
    LRTermDSubKClosedCtxBi E n Γ
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₁ :: rest))
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₂ :: rest)) T ↔
      LRTermDSubKClosedCtxBi E n Γ (foldApps (iotaRhsOfS w) rest) (foldApps (iotaRhsOfS w) rest) T :=
  lrTermDSubKClosedCtxBi_whRedPiKClosedCtx_iff hW
    (.step (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₁ rest) (.refl _))
    (.step (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₂ rest) (.refl _))

/-- **Exact Equivalence (`↔`) of Applied Proposition-Major K-Recursor Spine Congruence to the
    Shared K-Reduct Diagonal in `LRTermDSubKClosedCtxSemBi` Requiring Zero `PropTyTransport` and
    Zero `SortRow` (`lrTermDSubKClosedCtxSemBi_recursor_k_congr_iff`):** -/
theorem lrTermDSubKClosedCtxSemBi_recursor_k_congr_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E)
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hflds : w.fields = List.replicate w.fields.length botClosedExpr)
    {maj₁ maj₂ : Expr Nat}
    (hmaj₁ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₁ (.spine w.ctorRef args))
    (hmaj₂ : ∀ args, ¬ ApproxDIK E (ctxEnvDIK E Γ) maj₂ (.spine w.ctorRef args))
    (rest : List (Expr Nat)) (T : Expr Nat) :
    LRTermDSubKClosedCtxSemBi E n Γ
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₁ :: rest))
      (foldApps (.const w.recRef w.ls) (w.preMajor ++ maj₂ :: rest)) T ↔
      LRTermDSubKClosedCtxSemBi E n Γ (foldApps (iotaRhsOfS w) rest) (foldApps (iotaRhsOfS w) rest) T :=
  lrTermDSubKClosedCtxSemBi_whRedPiKClosedCtx_iff hW
    (.step (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₁ rest) (.refl _))
    (.step (whStepPiKClosedCtx_recursor_k_foldApps w hk hflds hmaj₂ rest) (.refl _))


/-! ## §23. Unconditional `.bot`-Collapse of Assumption-Variable Spines & Non-K Recursor Spines at
Non-Constructor Majors, and Semantic Non-$\Pi$-Guarded `LRProbeNoPiCore` / `LRTermNoPiSemBi` -/

/-! ### §23.1. Unconditional `.bot`-Collapse of Assumption-Variable Spines and Non-K Recursor
Spines at Non-Constructor Majors in `ApproxDIK` (`approxDIK_foldApps_eq_bot_of_eq_bot`,
`approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot`, `approxDIK_recursor_foldApps_no_ctor_nonK_eq_bot`) -/

/-- If `f` has only `.bot` in `ApproxDIK E ρ`, then for **every** argument spine `xs : List (Expr Nat)`,
    `foldApps f xs` has only `.bot` in `ApproxDIK E ρ` across **all** compacts `c : CptI`! -/
theorem approxDIK_foldApps_eq_bot_of_eq_bot {E : ResolvedEnv} {ρ : EnvI} {f : Expr Nat}
    (hf : ∀ d, ApproxDIK E ρ f d → d = .bot) (xs : List (Expr Nat)) {c : CptI}
    (h : ApproxDIK E ρ (foldApps f xs) c) : c = .bot := by
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rw [hf d hd] at hfold
  exact foldAppCptK_bot_inv hfold

/-- **Unconditional `.bot`-Collapse of All Assumption-Variable Spines in `ApproxDIK E (ctxEnvDIK E Γ)`
    (`approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot`):**
    For **every** assumption variable `i` (`lookupValue Γ i = none`) and **every** argument list
    `xs : List (Expr Nat)` (regardless of the complexity of `xs`!), the ONLY compact `c : CptI` in
    `ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) xs)` is `c = .bot`! -/
theorem approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) {c : CptI}
    (h : ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) xs) c) : c = .bot :=
  approxDIK_foldApps_eq_bot_of_eq_bot (fun _ hd => approxDIK_ctxEnvDIK_bvar_none_eq_bot hnone hd) xs h

/-- Every assumption-variable spine `foldApps (.bvar i) xs` (`lookupValue Γ i = none`) has NO
    `.spine r args` compact in `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_foldApps_bvar_none_not_spine {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (xs : List (Expr Nat)) (r : Nat) (args : List CptI) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) xs) (.spine r args) :=
  fun h => CptI.noConfusion (approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone xs h)

/-- **Unconditional `SemEqDIK` Identification of All Assumption-Variable Spines in `ctxEnvDIK E Γ`
    (`semEqDIK_ctxEnvDIK_foldApps_bvar_none`):**
    Any two assumption-variable spines `foldApps (.bvar i₁) xs₁` and `foldApps (.bvar i₂) xs₂`
    (`lookupValue Γ i₁ = none`, `lookupValue Γ i₂ = none`) have identical denotation `{.bot}` in
    `ApproxDIK E (ctxEnvDIK E Γ)` with **zero** hypotheses on `i₁, i₂, xs₁, xs₂`! -/
theorem semEqDIK_ctxEnvDIK_foldApps_bvar_none {E : ResolvedEnv} {Γ : LCtx} {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) :
    SemEqDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) := by
  intro c
  constructor
  · intro h
    rw [approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₁ xs₁ h]
    exact .bot _ _
  · intro h
    rw [approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₂ xs₂ h]
    exact .bot _ _

/-- **Unconditional `PrunedSemEqDIK` Identification of All Assumption-Variable Spines in
    `ctxEnvDIK E Γ` (`prunedSemEqDIK_ctxEnvDIK_foldApps_bvar_none`):** -/
theorem prunedSemEqDIK_ctxEnvDIK_foldApps_bvar_none {E : ResolvedEnv} {Γ : LCtx} {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) :=
  prunedSemEqDIK_of_semEqDIK (semEqDIK_ctxEnvDIK_foldApps_bvar_none hnone₁ hnone₂ xs₁ xs₂)

/-- **Unconditional Relatedness of All Assumption-Variable Spines in `LRTermDSubKClosedCtxBi`
    (`lrTermDSubKClosedCtxBi_foldApps_bvar_none`):** -/
theorem lrTermDSubKClosedCtxBi_foldApps_bvar_none {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermDSubKClosedCtxBi E n Γ (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) T :=
  lrTermDSubKClosedCtxBi_of_probeCpt_eq_bot T
    (fun _ _ h => approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₁ xs₁ h)
    (fun _ _ h => approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₂ xs₂ h)

/-- **Unconditional Relatedness of All Assumption-Variable Spines in `LRTermDSubKClosedCtxSemBi`
    Requiring Zero `PropTyTransport` and Zero `SortRow`
    (`lrTermDSubKClosedCtxSemBi_foldApps_bvar_none`):** -/
theorem lrTermDSubKClosedCtxSemBi_foldApps_bvar_none {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermDSubKClosedCtxSemBi E n Γ (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) T :=
  lrTermDSubKClosedCtxSemBi_of_probeCpt_eq_bot T
    (fun _ _ h => approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₁ xs₁ h)
    (fun _ _ h => approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₂ xs₂ h)

/-- **Unconditional 3-Probe 0-Instantiation Congruence for Assumption-Variable Spines Removing the
    `hv_sem : PrunedSemEqDIK` Premise (`lrTermDSubKClosedCtxBi_subst0_bvar_none_spine_uncond`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_bvar_none_spine_uncond
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A b B : Expr Nat} {u : Level}
    {i₁ i₂ : Nat} {args₁ args₂ : List (Expr Nat)}
    (hnone₁ : lookupValue Γ i₁ = none)
    (hnone₂ : lookupValue Γ i₂ = none)
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.bvar i₁) args₁) A)
    (hv₂ : HasTyT E n Γ (foldApps (.bvar i₂) args₂) A)
    (hcv : ConvT E n Γ (foldApps (.bvar i₁) args₁) (foldApps (.bvar i₂) args₂) A)
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (foldApps (.bvar i₁) args₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (foldApps (.bvar i₁) args₁) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (foldApps (.bvar i₂) args₂) b)
      (instantiate0 (foldApps (.bvar i₂) args₂) b)
      (instantiate0 (foldApps (.bvar i₁) args₁) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (foldApps (.bvar i₁) args₁) b)
      (instantiate0 (foldApps (.bvar i₂) args₂) b)
      (instantiate0 (foldApps (.bvar i₁) args₁) B) :=
  lrTermDSubKClosedCtxBi_subst0_bvar_none_spine_all hW hSort hΓ hnone₁ hA hv₁ hv₂ hcv
    (prunedSemEqDIK_ctxEnvDIK_foldApps_bvar_none hnone₁ hnone₂ args₁ args₂)
    hb_let hb_wf2 h₂

/-- **Unconditional 3-Probe Two-Sided $\lambda$-Application Congruence for Assumption-Variable
    Spines Removing `hv_sem : PrunedSemEqDIK`
    (`lrTermDSubKClosedCtxBi_app_lam_bvar_none_spine_uncond`):** -/
theorem lrTermDSubKClosedCtxBi_app_lam_bvar_none_spine_uncond
    {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f g A₁ A₂ b₁ b₂ B : Expr Nat} {u : Level}
    {i₁ i₂ : Nat} {args₁ args₂ : List (Expr Nat)}
    (hnone₁ : lookupValue Γ i₁ = none)
    (hnone₂ : lookupValue Γ i₂ = none)
    (hf_red : WhRedPiKClosedCtx E Γ f (.lam A₁ b₁))
    (hg_red : WhRedPiKClosedCtx E Γ g (.lam A₂ b₂))
    (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.bvar i₁) args₁) A₁)
    (hv₂ : HasTyT E n Γ (foldApps (.bvar i₂) args₂) A₁)
    (hcv : ConvT E n Γ (foldApps (.bvar i₁) args₁) (foldApps (.bvar i₂) args₂) A₁)
    (hb_let₁ : LRTermDSubKClosedCtxBi E n (.letBinding A₁ (foldApps (.bvar i₁) args₁) :: Γ) b₁ b₂ B)
    (hb₂_let₂ : LRTermDSubKClosedCtxBi E n (.letBinding A₁ (foldApps (.bvar i₂) args₂) :: Γ) b₂ b₂ B)
    (hb₂_wf2 : LRPiWf2 E n (.letBinding A₁ (foldApps (.bvar i₁) args₁) :: Γ) b₂) :
    LRTermDSubKClosedCtxBi E n Γ
      (.app f (foldApps (.bvar i₁) args₁))
      (.app g (foldApps (.bvar i₂) args₂))
      (instantiate0 (foldApps (.bvar i₁) args₁) B) :=
  lrTermDSubKClosedCtxBi_app_lam_bvar_none_spine_arg_all hW hSort hΓ hnone₁
    hf_red hg_red hA₁ hv₁ hv₂ hcv
    (prunedSemEqDIK_ctxEnvDIK_foldApps_bvar_none hnone₁ hnone₂ args₁ args₂)
    hb_let₁ hb₂_let₂ hb₂_wf2

/-- **Unconditional 3-Probe Two-Sided `ConvT.letE` Congruence for Assumption-Variable Spines
    Removing `hv_sem : PrunedSemEqDIK` (`lrTermDSubKClosedCtxBi_letE_bvar_none_spine_uncond`):** -/
theorem lrTermDSubKClosedCtxBi_letE_bvar_none_spine_uncond
