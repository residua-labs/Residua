/-! ## §19. Full `CtxConvT` + `SameLetProfile` Transport for `IsPropTyI`, `LRPiWf2`, and
`LRTermDSubKClosedCtxBi` (Zero `PropTyTransport`), Full Two-Sided `ConvT.letE` Congruence Across
All 3 Probes, and Principal-Type Uniqueness (`hasTyT_unique_tyConvT`) Discharging `PropTyTransport` -/

/-! ### §19.1. Full `CtxConvT` + `SameLetProfile` Transport, Assumption-Domain Conversion, and
`letBinding` Type-and-Value Conversion for `IsPropTyI`, `LRPiWf2`, and `LRTermDSubKClosedCtxBi`
(Zero `PropTyTransport`, Zero `SortRow`) -/

/-- Replacing `.letBinding A₁ v` by `.letBinding A₂ v` at the head of a context (same let-value `v`,
    different type annotations `A₁` and `A₂`) preserves `SameLetProfile` identically! -/
theorem sameLetProfile_let_head_sameVal (A₁ A₂ v : Expr Nat) (Γ : LCtx) :
    SameLetProfile (.letBinding A₁ v :: Γ) (.letBinding A₂ v :: Γ) := by
  refine ⟨fun i => ?_, fun _ => rfl⟩
  cases i with
  | zero => rfl
  | succ i => simp only [lookupValue_cons_succ]

/-- Pushing `.letBinding A v` onto `SameLetProfile`-equivalent contexts preserves `SameLetProfile`. -/
theorem sameLetProfile_cons_let_sameVal (A v : Expr Nat) {Γ Γ' : LCtx}
    (h : SameLetProfile Γ Γ') :
    SameLetProfile (.letBinding A v :: Γ) (.letBinding A v :: Γ') := by
  refine ⟨fun i => ?_, fun E => by simp only [ctxEnvDIK, h.2 E]⟩
  cases i with
  | zero => rfl
  | succ i => simp only [lookupValue_cons_succ, h.1 i]

/-- **Pure Syntactic Context-Conversion Transport of `IsPropTyI` (`isPropTyI_ctx`):**
    For any `hctx : CtxConvT E n Γ Γ'`, `hasTyT_ctx` transports `IsPropTyI E n Γ B` to
    `IsPropTyI E n Γ' B` with **zero `PropTyTransport`** and **zero `SortRow`**! -/
theorem isPropTyI_ctx {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') {B : Expr Nat}
    (h : IsPropTyI E n Γ B) :
    IsPropTyI E n Γ' B := by
  rcases h with ⟨⟨hB0⟩, hns⟩
  exact ⟨⟨hasTyT_ctx hcl hctx hB0⟩, hns⟩

/-- Transport of `IsPropTyI` along an assumption-domain `TyConvT` chain (`isPropTyI_assump_dom`,
    zero `PropTyTransport`, zero `SortRow`). -/
theorem isPropTyI_assump_dom {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ →
    ∀ {B : Expr Nat}, IsPropTyI E n (.assumption A₂ :: Γ) B → IsPropTyI E n (.assumption A₁ :: Γ) B
  | _, _, .refl _ _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, h =>
      let ends := convEnds hW hΓ hc
      isPropTyI_ctx (envClosed_of_envWfT hW)
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc)) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, h =>
      isPropTyI_assump_dom hW hΓ c₁ (isPropTyI_assump_dom hW hΓ c₂ h)

/-- Two-way equivalence (`↔`) of `IsPropTyI` under assumption-domain `TyConvT` conversion
    (`isPropTyI_assump_dom_iff`, zero `PropTyTransport`, zero `SortRow`). -/
theorem isPropTyI_assump_dom_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat}
    (hcA : TyConvT E n Γ A₁ A₂) (B : Expr Nat) :
    IsPropTyI E n (.assumption A₁ :: Γ) B ↔ IsPropTyI E n (.assumption A₂ :: Γ) B :=
  ⟨isPropTyI_assump_dom hW hΓ hcA.symmT, isPropTyI_assump_dom hW hΓ hcA⟩

/-- Telescope-general let-declaration conversion transport of `IsPropTyI` via `hasTyTConvLetAt`
    (`isPropTyI_convLetAt`, zero `PropTyTransport`, zero `SortRow`). -/
theorem isPropTyI_convLetAt {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {A A' v v' : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A' A (.sort u)) (hcv : ConvT E n Γ v' v A)
    (hv'A' : HasTyT E n Γ v' A') (Δ : LCtx) {B : Expr Nat}
    (h : IsPropTyI E n (Δ ++ .letBinding A v :: Γ) B) :
    IsPropTyI E n (Δ ++ .letBinding A' v' :: Γ) B := by
  rcases h with ⟨⟨hB0⟩, hns⟩
  exact ⟨⟨hasTyTConvLetAt hcl hcA hcv hv'A' Δ hB0⟩, hns⟩

/-- **Full Two-Way `letBinding` Type-and-Value Conversion Invariance of `IsPropTyI`
    (`isPropTyI_convLet_full`):**
    Generalizes §18.1's `isPropTyI_convLet` to simultaneous conversion of **both** the let-binder
    type `A₁ ~ A₂ : .sort u` and the let-value `v₁ ~ v₂ : A₁`, with **zero `PropTyTransport`** and
    **zero `SortRow`**! -/
theorem isPropTyI_convLet_full {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ v₁ v₂ : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u)) (hcv : ConvT E n Γ v₁ v₂ A₁) (B : Expr Nat) :
    IsPropTyI E n (.letBinding A₁ v₁ :: Γ) B ↔ IsPropTyI E n (.letBinding A₂ v₂ :: Γ) B := by
  have hcl := envClosed_of_envWfT hW
  have hv₁ : HasTyT E n Γ v₁ A₁ := (convEnds hW hΓ hcv).1
  have hv₂ : HasTyT E n Γ v₂ A₁ := (convEnds hW hΓ hcv).2.1
  have hv₂A₂ : HasTyT E n Γ v₂ A₂ := .conv Γ v₂ A₁ A₂ u hv₂ hcA
  have hcv₂ : ConvT E n Γ v₁ v₂ A₂ := .tyConv Γ v₁ v₂ A₁ A₂ u hcv hcA
  constructor
  · exact isPropTyI_convLetAt hcl (.symm _ _ _ _ hcA) (.symm _ _ _ _ hcv) hv₂A₂ []
  · exact isPropTyI_convLetAt hcl hcA hcv₂ hv₁ []

/-- **Context-Conversion Transport of `LRPiWf2` Under `SameLetProfile`
    (`lrPiWf2_ctx_of_sameLetProfile`):** -/
theorem lrPiWf2_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {M : Expr Nat} (h : LRPiWf2 E n Γ M) :
    LRPiWf2 E n Γ' M := by
  intro D₁ D₂ hred'
  have hred : WhRedPiKClosedCtx E Γ M (.pi D₁ D₂) :=
    whRedPiKClosedCtx_of_sameLetProfile (sameLetProfile_symm hprof) hred'
  obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := h D₁ D₂ hred
  exact ⟨u₁, u₂, ⟨hasTyT_ctx hcl hctx hD₁⟩,
    ⟨hasTyT_ctx hcl (.same (.assumption D₁) hctx) hD₂⟩⟩

/-- Transport of `LRPiWf2` along an assumption-domain `TyConvT` chain (`lrPiWf2_assump_dom`). -/
theorem lrPiWf2_assump_dom {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ →
    ∀ {M : Expr Nat}, LRPiWf2 E n (.assumption A₂ :: Γ) M → LRPiWf2 E n (.assumption A₁ :: Γ) M
  | _, _, .refl _ _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, h =>
      let ends := convEnds hW hΓ hc
      lrPiWf2_ctx_of_sameLetProfile (envClosed_of_envWfT hW)
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (sameLetProfile_assump_head A₂ A₁ Γ) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, h =>
      lrPiWf2_assump_dom hW hΓ c₁ (lrPiWf2_assump_dom hW hΓ c₂ h)

/-- Two-way equivalence (`↔`) of `LRPiWf2` under assumption-domain `TyConvT` conversion
    (`lrPiWf2_assump_dom_iff`). -/
theorem lrPiWf2_assump_dom_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat}
    (hcA : TyConvT E n Γ A₁ A₂) (M : Expr Nat) :
    LRPiWf2 E n (.assumption A₁ :: Γ) M ↔ LRPiWf2 E n (.assumption A₂ :: Γ) M :=
  ⟨lrPiWf2_assump_dom hW hΓ hcA.symmT, lrPiWf2_assump_dom hW hΓ hcA⟩

/-- Two-way equivalence (`↔`) of `LRPiWf2` when replacing `.letBinding A₁ v` by `.letBinding A₂ v`
    along `hcA : ConvT E n Γ A₁ A₂ (.sort u)` (`lrPiWf2_let_sameVal_iff`). -/
theorem lrPiWf2_let_sameVal_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ v : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u)) (hv : HasTyT E n Γ v A₁) (M : Expr Nat) :
    LRPiWf2 E n (.letBinding A₁ v :: Γ) M ↔ LRPiWf2 E n (.letBinding A₂ v :: Γ) M := by
  have hcl := envClosed_of_envWfT hW
  have ends := convEnds hW hΓ hcA
  have hv₂ : HasTyT E n Γ v A₂ := .conv Γ v A₁ A₂ u hv hcA
  constructor
  · exact lrPiWf2_ctx_of_sameLetProfile hcl
      (.letBinding (ctxConvT_refl Γ) ends.1 ends.2.1 hcA hv₂ (.refl Γ v A₁ hv))
      (sameLetProfile_let_head_sameVal A₁ A₂ v Γ)
  · exact lrPiWf2_ctx_of_sameLetProfile hcl
      (.letBinding (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hcA) hv (.refl Γ v A₂ hv₂))
      (sameLetProfile_let_head_sameVal A₂ A₁ v Γ)

/-- **Context-Conversion Transport of `LRTermDSubKClosedCtxCore` on `ProbeCpt` Under `SameLetProfile`
    (`lrTermDSubKClosedCtxCore_probe_ctx_of_sameLetProfile`):** -/
theorem lrTermDSubKClosedCtxCore_probe_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ') (hΓ' : CtxWfT E n Γ')
    {M M' B : Expr Nat} {c : CptI} (hc : ProbeCpt c)
    (h : LRTermDSubKClosedCtxCore E n Γ M M' B c) :
    LRTermDSubKClosedCtxCore E n Γ' M M' B c := by
  cases hc with
  | bot => rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial
  | sort =>
      rw [lrTermDSubKClosedCtxCore_sort_iff] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hlr⟩
      exact ⟨⟨l, whRedPiKClosedCtx_of_sameLetProfile hprof hl⟩,
        lrTypeINPiKClosedCtx_ctx_of_sameLetProfile hW hctx hprof hΓ' hlr⟩
  | piBotNil =>
      have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at h ⊢
      rcases h with ⟨⟨l, hl⟩, hlr⟩
      exact ⟨⟨l, whRedPiKClosedCtx_of_sameLetProfile hprof hl⟩,
        lrTypeINPiKClosedCtx_ctx_of_sameLetProfile hW hctx hprof hΓ' hlr⟩

/-- **Context-Conversion Transport of `LRTermDSubKClosedCtx` on `ProbeCpt` Under `SameLetProfile`
    (`lrTermDSubKClosedCtx_probe_ctx_of_sameLetProfile`):**
    Requires **zero `PropTyTransport`** and **zero `SortRow`**! -/
theorem lrTermDSubKClosedCtx_probe_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ') (hΓ' : CtxWfT E n Γ')
    {M M' B : Expr Nat} {c : CptI} (hc : ProbeCpt c)
    (h : LRTermDSubKClosedCtx E n Γ M M' B c) :
    LRTermDSubKClosedCtx E n Γ' M M' B c := by
  rcases h with hP | hC
  · exact Or.inl (isPropTyI_ctx (envClosed_of_envWfT hW) hctx hP)
  · exact Or.inr (lrTermDSubKClosedCtxCore_probe_ctx_of_sameLetProfile hW hctx hprof hΓ' hc hC)

/-- **Context-Conversion Transport of `LRTermDSubKClosedCtxBi` Under `SameLetProfile`
    (`lrTermDSubKClosedCtxBi_ctx_of_sameLetProfile`):**
    Transports `LRTermDSubKClosedCtxBi` across any `CtxConvT E n Γ Γ'` with `SameLetProfile Γ Γ'`
    using **zero `PropTyTransport`** and **zero `SortRow`**! -/
theorem lrTermDSubKClosedCtxBi_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ') (hΓ' : CtxWfT E n Γ')
    {M M' B : Expr Nat} (h : LRTermDSubKClosedCtxBi E n Γ M M' B) :
    LRTermDSubKClosedCtxBi E n Γ' M M' B := by
  intro c hc hor
  rw [← hprof.2 E] at hor
  exact lrTermDSubKClosedCtx_probe_ctx_of_sameLetProfile hW hctx hprof hΓ' hc (h c hc hor)

/-- Transport of `LRTermDSubKClosedCtxBi` along an assumption-domain `TyConvT` chain
    (`lrTermDSubKClosedCtxBi_assump_dom`, zero `PropTyTransport`, zero `SortRow`). -/
theorem lrTermDSubKClosedCtxBi_assump_dom {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ → {u : Level} → HasTyT E n Γ A₁ (.sort u) →
    ∀ {M M' B : Expr Nat},
      LRTermDSubKClosedCtxBi E n (.assumption A₂ :: Γ) M M' B →
      LRTermDSubKClosedCtxBi E n (.assumption A₁ :: Γ) M M' B
  | _, _, .refl _ _, _, _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, hA₁, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTermDSubKClosedCtxBi_ctx_of_sameLetProfile hW
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (sameLetProfile_assump_head A₂ A₁ Γ)
        (.assumption Γ A₁ _ hΓ hA₁) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, hA₁, _, _, _, h =>
      let ⟨_, hM⟩ := tyConvT_endTyped hW hΓ c₁ hA₁
      lrTermDSubKClosedCtxBi_assump_dom hW hΓ c₁ hA₁
        (lrTermDSubKClosedCtxBi_assump_dom hW hΓ c₂ hM h)

/-- Two-way equivalence (`↔`) of `LRTermDSubKClosedCtxBi` under assumption-domain `TyConvT`
    conversion (`lrTermDSubKClosedCtxBi_assump_dom_iff`, zero `PropTyTransport`, zero `SortRow`). -/
theorem lrTermDSubKClosedCtxBi_assump_dom_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat} {u : Level}
    (hcA : TyConvT E n Γ A₁ A₂) (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (M M' B : Expr Nat) :
    LRTermDSubKClosedCtxBi E n (.assumption A₁ :: Γ) M M' B ↔
      LRTermDSubKClosedCtxBi E n (.assumption A₂ :: Γ) M M' B := by
  obtain ⟨u₂, hA₂⟩ := tyConvT_endTyped hW hΓ hcA hA₁
  exact ⟨lrTermDSubKClosedCtxBi_assump_dom hW hΓ hcA.symmT hA₂,
    lrTermDSubKClosedCtxBi_assump_dom hW hΓ hcA hA₁⟩

/-- **Two-Way Equivalence (`↔`) of `LRTermDSubKClosedCtxBi` Under `letBinding` Type Conversion
    (`lrTermDSubKClosedCtxBi_let_sameVal_iff`):**
    Replacing `.letBinding A₁ v` by `.letBinding A₂ v` along `hcA : ConvT E n Γ A₁ A₂ (.sort u)`
    preserves `LRTermDSubKClosedCtxBi` in **both** directions with **zero `PropTyTransport`** and
    **zero `SortRow`**! -/
theorem lrTermDSubKClosedCtxBi_let_sameVal_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ v : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u)) (hv : HasTyT E n Γ v A₁)
    (M M' B : Expr Nat) :
    LRTermDSubKClosedCtxBi E n (.letBinding A₁ v :: Γ) M M' B ↔
      LRTermDSubKClosedCtxBi E n (.letBinding A₂ v :: Γ) M M' B := by
  have ends := convEnds hW hΓ hcA
  have hv₂ : HasTyT E n Γ v A₂ := .conv Γ v A₁ A₂ u hv hcA
  constructor
  · exact lrTermDSubKClosedCtxBi_ctx_of_sameLetProfile hW
