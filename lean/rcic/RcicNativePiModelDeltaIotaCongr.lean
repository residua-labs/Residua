/-- **Exact 0-or-1-Step `let`-Substitution Commutation for `WhStepPiKClosedCtxMaj`
    (`whStepPiKClosedCtxMaj_substLet_eq_or_step`):**
    For every `j : Nat` and every `t, w0 : Expr Nat` with `Γ[j]? = some (.letBinding t w0)`,
    any single `WhStepPiKClosedCtxMaj E Γ a b` step becomes either an equality (`0` steps, when
    `zetaLocal` unfolds `.bvar j` itself, possibly inside `recMajor` / `appHead`) or a single
    `WhStepPiKClosedCtxMaj E (substRemove w0 j Γ)` step (`1` step), requiring **only** `hcl : EnvClosed E`! -/
theorem whStepPiKClosedCtxMaj_substLet_eq_or_step {E : ResolvedEnv} (hcl : EnvClosed E)
    {t w0 : Expr Nat} {j : Nat} {Γ : LCtx} (hget : Γ[j]? = some (.letBinding t w0))
    {a b : Expr Nat} (h : WhStepPiKClosedCtxMaj E Γ a b) :
    instantiate j (lift 0 j w0) a = instantiate j (lift 0 j w0) b ∨
      WhStepPiKClosedCtxMaj E (substRemove w0 j Γ)
        (instantiate j (lift 0 j w0) a) (instantiate j (lift 0 j w0) b) := by
  induction h with
  | of_whStep hs =>
      exact Or.inr (.of_whStep (whStep_instantiate_of_envClosed hcl hs j (lift 0 j w0)))
  | @zetaLocal i v0 hvl =>
      by_cases hij : i = j
      · subst hij
        rw [lookupValue_get_letBinding hget] at hvl
        injection hvl with hvl
        subst hvl
        simp only [instantiate, if_true]
        rw [instantiate_lift_cancel (i + 1) 0 i (lift 0 i w0) (by omega) (by omega),
            Nat.add_sub_cancel]
        exact Or.inl rfl
      · by_cases hlt : i < j
        · have hsub := lookupValue_substRemove_lt (v := w0) hlt hvl
          simp only [instantiate, if_neg hij, if_neg (by omega : ¬ j < i)]
          exact Or.inr (.zetaLocal hsub)
        · have hsub := lookupValue_substRemove_gt (v := w0) (by omega : j < i) hvl
          simp only [instantiate, if_neg hij, if_pos (by omega : j < i)]
          exact Or.inr (.zetaLocal hsub)
  | iotaS w ls lsC pre params fields hpre hpar hflds =>
      have hclSchema : exprClosedAt (pre ++ fields).length (instantiateLevels ls w.schema) = true := by
        rw [exprClosedAt_instantiateLevels, List.length_append, hpre, hflds, w.hpre]
        exact w.hschemaScope
      rw [recCall_instantiate, foldApps_instantiate,
        ← instPrefix_map_instantiate_of_closed (pre ++ fields) j (lift 0 j w0)
          (instantiateLevels ls w.schema) hclSchema,
        List.map_append, List.map_append]
      simp only [instantiate]
      exact Or.inr (.iotaS w ls lsC
        (pre.map (instantiate j (lift 0 j w0)))
        (params.map (instantiate j (lift 0 j w0)))
        (fields.map (instantiate j (lift 0 j w0)))
        (by rw [List.length_map, hpre])
        (by rw [List.length_map, hpar])
        (by rw [List.length_map, hflds]))
  | iotaKClosedCtx w ls pre x hk_prop hpre hx =>
      have hclSchema : exprClosedAt (pre ++ List.replicate w.fields.length botClosedExpr).length
          (instantiateLevels ls w.schema) = true := by
        rw [exprClosedAt_instantiateLevels, List.length_append, List.length_replicate, hpre, w.hpre]
        exact w.hschemaScope
      rw [recCall_instantiate,
        ← instPrefix_map_instantiate_of_closed (pre ++ List.replicate w.fields.length botClosedExpr)
          j (lift 0 j w0) (instantiateLevels ls w.schema) hclSchema,
        List.map_append, replicate_botClosedExpr_map_instantiate]
      simp only [instantiate]
      exact Or.inr (.iotaKClosedCtx w ls
        (pre.map (instantiate j (lift 0 j w0)))
        (instantiate j (lift 0 j w0) x) hk_prop
        (by rw [List.length_map, hpre])
        (fun htag => hx ((approxDIK_ctxEnvDIK_substLet_iff hget x (ctorTagCpt w)).mp htag)))
  | recMajor w ls pre x x' hpre htag _ ih =>
      rcases ih with heq | hs'
      · exact Or.inl (by rw [recCall_instantiate, recCall_instantiate, heq])
      · rw [recCall_instantiate, recCall_instantiate]
        simp only [instantiate]
        exact Or.inr (.recMajor w ls
          (pre.map (instantiate j (lift 0 j w0)))
          (instantiate j (lift 0 j w0) x)
          (instantiate j (lift 0 j w0) x')
          (by rw [List.length_map, hpre])
          ((approxDIK_ctxEnvDIK_substLet_iff hget x (ctorTagCpt w)).mpr htag)
          hs')
  | @appHead f f' arg _ ih =>
      rcases ih with heq | hs'
      · exact Or.inl (by simp only [instantiate, heq])
      · exact Or.inr (.appHead hs')

theorem whStepPiKClosedCtxMaj_substLet_of_envClosed {E : ResolvedEnv} (hcl : EnvClosed E)
