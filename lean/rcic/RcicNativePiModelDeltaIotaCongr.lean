  ⟨fun h _ ha ih_a => (lrTermMajSemBi_eta_app_left_iff hW A' f₁ f₂ _ _ _).mp (h ha ih_a),
   fun h _ ha ih_a => (lrTermMajSemBi_eta_app_left_iff hW A' f₁ f₂ _ _ _).mpr (h ha ih_a)⟩

