theorem lrTermDSubKClosedCtxBi_app_congr_of_subst0Congr {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hSubst0 : Subst0CongrSupplyDSubKClosedCtxBi E n)
