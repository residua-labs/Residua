    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : TypedSubst0CongrSupplyLet1MajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ a₁ a₂ A B : Expr Nat}
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B))
    (hca : ConvT E n Γ a₁ a₂ A)
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a₁ a₂ A) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B) :=
  lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0 hW hAdeq
    (typedSubst0CongrSupplyMajSemBi_of_let1 hSubst0) hΓ hcf hca ih_f ih_a

