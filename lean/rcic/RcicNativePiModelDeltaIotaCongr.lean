    instantiate0 v (instantiate0 (lift 0 1 a) (lift 1 1 B)) = instantiate0 a B := by
  rw [instantiate0_instantiate0_lift0 v a (lift 1 1 B),
      instantiate_lift_id 1 (lift 0 1 v) B]

