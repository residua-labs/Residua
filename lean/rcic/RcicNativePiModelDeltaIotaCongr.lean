/-- **`PrunedSemEqDIK` Extraction from `LRTermMajSemBi` for Non-`.spine`, Non-`.lam` Terms
    (`prunedSemEqDIK_of_lrTermMajSemBi_no_spine_no_lam`):**
    Because `prunedPiCpt_iff_probeCpt_or_spine_or_lam` partitions `PrunedPiCpt` into `ProbeCpt`,
    `.spine r args`, and `.lam g`, any `LRTermMajSemBi E n Γ M N A` at a non-proposition,
    non-$\Pi$ type `A` where `M` and `N` have neither `.spine` nor `.lam` in `ApproxDIK`
    automatically satisfies `PrunedSemEqDIK E (ctxEnvDIK E Γ) M N`! -/
theorem prunedSemEqDIK_of_lrTermMajSemBi_no_spine_no_lam {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M N A : Expr Nat}
    (h : LRTermMajSemBi E n Γ M N A)
    (hnoprop : ¬ IsSemPropTyI E n Γ A)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (hM_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) M (.spine r args))
    (hN_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) N (.spine r args))
    (hM_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) M (.lam g))
    (hN_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) N (.lam g)) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) M N := by
  intro c hc
  rcases prunedPiCpt_iff_probeCpt_or_spine_or_lam hc with
    hprobe | ⟨r, args, rfl⟩ | ⟨g, rfl⟩
  · exact approxDIK_probeCpt_iff_of_lrTermMajSemBi hW h hnoprop hnopi hprobe
  · exact ⟨fun hM => (hM_nosp r args hM).elim, fun hN => (hN_nosp r args hN).elim⟩
  · exact ⟨fun hM => (hM_nolam g hM).elim, fun hN => (hN_nolam g hN).elim⟩

