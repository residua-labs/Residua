    LRProbeTypePiKClosedCtxMaj E n Γ Y Y c := by
  cases h with
  | bot => exact .bot Γ Y Y
  | sort _ hY => exact .sort hY hY
  | @pi _ _ A₂ B₂ _ hY _ _ => exact .pi hY hY (.refl _ A₂) (.refl _ B₂)

/-- **Left Endpoint Diagonal Extraction for `LRTermMajSemBi` (`lrTermMajSemBi_diag_left`):**
    Any `LRTermMajSemBi E n Γ M M' A` immediately yields `LRTermMajSemBi E n Γ M M A` with
    **zero `EnvWfT` and zero `CtxWfT`**! -/
