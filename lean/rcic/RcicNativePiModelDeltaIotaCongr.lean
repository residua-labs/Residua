  have hcl := envClosed_of_envWfT hW
  intro a₁ a₂ ha₁ ha₂ hca ih_a
  have hc_lift := convT_letBinding_type_lift0_instantiate0 hW ht hw0 hA
  have ha₁_let : HasTyT E n (.letBinding t w0 :: Γ) (lift 0 1 a₁) A :=
