    `WhNormalPiKClosedCtxMaj` at every `EnvWfT E` (`whNormalPiKClosedCtxMaj_foldApps_rigidConst`). -/
theorem whNormalPiKClosedCtxMaj_foldApps_rigidConst {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls : List Level} (hrigid : RigidConst E r)
    (args : List (Expr Nat)) :
    WhNormalPiKClosedCtxMaj E Γ (foldApps (.const r ls) args) :=
  fun _ hs => whStepPiKClosedCtxMaj_foldApps_rigidConst_false hW hrigid args hs

theorem whRedPiKClosedCtxMaj_foldApps_rigidConst_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls : List Level} (hrigid : RigidConst E r)
    (args : List (Expr Nat)) {e : Expr Nat}
    (h : WhRedPiKClosedCtxMaj E Γ (foldApps (.const r ls) args) e) :
    e = foldApps (.const r ls) args :=
  whRedPiKClosedCtxMaj_of_normal (whNormalPiKClosedCtxMaj_foldApps_rigidConst hW hrigid args) h

/-- Because `foldApps (.const r ls) args` with `RigidConst E r` has neither `.sort` nor `.pi` in
    `ApproxDIK`, any two rigid-constant spines are unconditionally `LRTermNoPiMajSemBi`-related at
    every type `T` (`lrTermNoPiMajSemBi_foldApps_rigidConst`). -/
private theorem approxDIK_foldApps_rigidConst_probeCpt_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    {r : Nat} {ls : List Level} (hrigid : RigidConst E r) (args : List (Expr Nat))
    {c : CptI} (hc : ProbeCpt c)
    (h : ApproxDIK E ρ (foldApps (.const r ls) args) c) : c = .bot := by
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  rcases approxDIK_rigid_const_inv hrigid hd with rfl | rfl
  · exact foldAppCptK_bot_inv hfold
  · rcases (foldAppCptK_spine_iff r args [] c).mp hfold with rfl | ⟨_, _, rfl⟩
    · rfl
    · cases hc

theorem lrTermNoPiMajSemBi_foldApps_rigidConst {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {r₁ r₂ : Nat} {ls₁ ls₂ : List Level}
    (hrigid₁ : RigidConst E r₁) (hrigid₂ : RigidConst E r₂)
    (args₁ args₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermNoPiMajSemBi E n Γ (foldApps (.const r₁ ls₁) args₁) (foldApps (.const r₂ ls₂) args₂) T :=
  lrTermNoPiMajSemBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_foldApps_rigidConst_probeCpt_eq_bot hrigid₁ args₁ hc h)
    (fun _ hc h => approxDIK_foldApps_rigidConst_probeCpt_eq_bot hrigid₂ args₂ hc h)

/-- Every under-applied recursor prefix `foldApps (.const w.recRef ls) xs` with
    `xs.length ≤ w.preMajor.length` is `WhNormalPiKClosedCtxMaj` at every `EnvWfT E`
    (`whNormalPiKClosedCtxMaj_recursor_prefix`). -/
theorem whNormalPiKClosedCtxMaj_recursor_prefix {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level) (xs : List (Expr Nat))
    (hlen : xs.length ≤ w.preMajor.length) :
    WhNormalPiKClosedCtxMaj E Γ (foldApps (.const w.recRef ls) xs) :=
  fun _ hs => not_whStepPiKClosedCtxMaj_recursor_prefix hW w ls xs hlen hs

theorem whRedPiKClosedCtxMaj_recursor_prefix_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level) (xs : List (Expr Nat))
    (hlen : xs.length ≤ w.preMajor.length) {e : Expr Nat}
    (h : WhRedPiKClosedCtxMaj E Γ (foldApps (.const w.recRef ls) xs) e) :
    e = foldApps (.const w.recRef ls) xs :=
  whRedPiKClosedCtxMaj_of_normal (whNormalPiKClosedCtxMaj_recursor_prefix hW w ls xs hlen) h

/-- Any two under-applied recursor prefixes (`xsᵢ.length ≤ wᵢ.preMajor.length`) are unconditionally
    `LRTermNoPiMajSemBi`-related at every type `T` (`lrTermNoPiMajSemBi_recursor_prefix`). -/
theorem lrTermNoPiMajSemBi_recursor_prefix {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {xs₁ xs₂ : List (Expr Nat)}
    (hlen₁ : xs₁.length ≤ w₁.preMajor.length)
    (hlen₂ : xs₂.length ≤ w₂.preMajor.length)
    (T : Expr Nat) :
    LRTermNoPiMajSemBi E n Γ
      (foldApps (.const w₁.recRef ls₁) xs₁)
      (foldApps (.const w₂.recRef ls₂) xs₂) T :=
  lrTermNoPiMajSemBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₁ ls₁ (ctxEnvDIK E Γ) xs₁ hlen₁ hc h)
    (fun _ hc h => approxDIK_recursor_prefix_probeCpt_eq_bot w₂ ls₂ (ctxEnvDIK E Γ) xs₂ hlen₂ hc h)

/-- Any `WhStepPiKClosedCtxMaj` step on an application `.app (foldApps (recCall (.const w.recRef ls) pre x) rest) a`
    (with `pre.length = w.preMajor.length`, i.e., strictly past the major premise!) must come from
    `appHead` (`whStepPiKClosedCtxMaj_app_recCall_foldApps_inv`). -/
theorem whStepPiKClosedCtxMaj_app_recCall_foldApps_inv {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    (x : Expr Nat) (rest : List (Expr Nat)) (a : Expr Nat) {e : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E Γ (.app (foldApps (recCall (.const w.recRef ls) pre x) rest) a) e) :
    ∃ f', e = .app f' a ∧ WhStepPiKClosedCtxMaj E Γ (foldApps (recCall (.const w.recRef ls) pre x) rest) f' := by
  have hsp_lhs : appsSpine (Expr.app (foldApps (recCall (.const w.recRef ls) pre x) rest) a) =
      (.const w.recRef ls, (pre ++ [x]) ++ (rest ++ [a])) := by
    rw [← foldApps_snoc, recCall, ← foldApps_append, appsSpine_foldApps_const]
  generalize ha₀ : Expr.app (foldApps (recCall (.const w.recRef ls) pre x) rest) a = a₀ at hs
  cases hs with
  | of_whStep hs₀ =>
      cases hs₀ with
      | beta =>
          injection ha₀ with hlam _
          rw [recCall, ← foldApps_append] at hlam
          exact (F8EtaK.foldApps_const_ne_lam_any hlam).elim
      | zeta => exact Expr.noConfusion ha₀
      | delta => exact Expr.noConfusion ha₀
      | lit => exact Expr.noConfusion ha₀
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w' =>
              have hsp := hsp_lhs.symm.trans (congrArg appsSpine ha₀)
              unfold iotaLhsOfS recCall at hsp
              rw [appsSpine_foldApps_const] at hsp
              injection hsp with hhead hargs
              injection hhead with hrec _
              have hpreEq := (iotaWitnessS_preMajor_length_eq w w' hrec).2
              have hlen := congrArg List.length hargs
              simp only [List.length_append, List.length_singleton, hpre, hpreEq] at hlen
              exact False.elim (by omega)
      | appHead hf₀ =>
          injection ha₀ with hfEq haEq
          subst hfEq; subst haEq
          exact ⟨_, rfl, .of_whStep hf₀⟩
  | zetaLocal _ =>
      exact Expr.noConfusion ha₀
  | iotaS w' ls' lsC' pre' params' fields' hpre' _ _ =>
      have hsp := hsp_lhs.symm.trans (congrArg appsSpine ha₀)
      unfold recCall at hsp
      rw [appsSpine_foldApps_const] at hsp
      injection hsp with hhead hargs
      injection hhead with hrec _
      have hpreEq := (iotaWitnessS_preMajor_length_eq w w' hrec).2
      have hlen := congrArg List.length hargs
      simp only [List.length_append, List.length_singleton, hpre, hpre', hpreEq] at hlen
      exact False.elim (by omega)
  | iotaKClosedCtx w' ls' pre' x' _ hpre' _ =>
      have hsp := hsp_lhs.symm.trans (congrArg appsSpine ha₀)
      unfold recCall at hsp
      rw [appsSpine_foldApps_const] at hsp
      injection hsp with hhead hargs
      injection hhead with hrec _
      have hpreEq := (iotaWitnessS_preMajor_length_eq w w' hrec).2
      have hlen := congrArg List.length hargs
      simp only [List.length_append, List.length_singleton, hpre, hpre', hpreEq] at hlen
      exact False.elim (by omega)
  | recMajor w' ls' pre' x' _ hpre' _ _ =>
      have hsp := hsp_lhs.symm.trans (congrArg appsSpine ha₀)
      unfold recCall at hsp
      rw [appsSpine_foldApps_const] at hsp
      injection hsp with hhead hargs
      injection hhead with hrec _
      have hpreEq := (iotaWitnessS_preMajor_length_eq w w' hrec).2
      have hlen := congrArg List.length hargs
      simp only [List.length_append, List.length_singleton, hpre, hpre', hpreEq] at hlen
      exact False.elim (by omega)
  | appHead hf =>
      injection ha₀ with hfEq haEq
      subst hfEq; subst haEq
      exact ⟨_, rfl, hf⟩

/-- **Exact Post-Major Spine Normal-Form Equivalence (`whNormalPiKClosedCtxMaj_foldApps_recCall_iff`):**
    For any `w : IotaWitnessS E`, `pre.length = w.preMajor.length`, `x`, and trailing arguments
    `rest : List (Expr Nat)`, `foldApps (recCall (.const w.recRef ls) pre x) rest` is
    `WhNormalPiKClosedCtxMaj` **if and only if** `recCall (.const w.recRef ls) pre x` is
    `WhNormalPiKClosedCtxMaj`! -/
theorem whNormalPiKClosedCtxMaj_foldApps_recCall_iff {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    (x : Expr Nat) (rest : List (Expr Nat)) :
    WhNormalPiKClosedCtxMaj E Γ (foldApps (recCall (.const w.recRef ls) pre x) rest) ↔
      WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
  constructor
  · exact whNormalPiKClosedCtxMaj_foldApps_inv rest
  · intro hnorm
    have key : ∀ (n : Nat) (ys : List (Expr Nat)), ys.length = n →
        WhNormalPiKClosedCtxMaj E Γ (foldApps (recCall (.const w.recRef ls) pre x) ys) := by
      intro n
      induction n with
      | zero =>
          intro ys hlen
          rw [List.eq_nil_of_length_eq_zero hlen]
          exact hnorm
      | succ n ih =>
          intro ys hlen
          rcases list_eq_nil_or_snoc_maj ys with rfl | ⟨rest₀, a, rfl⟩
          · cases hlen
          · simp only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] at hlen
            rw [foldApps_snoc]
            intro e hs
            obtain ⟨f', _, hf'⟩ := whStepPiKClosedCtxMaj_app_recCall_foldApps_inv hW w ls hpre x rest₀ a hs
            exact ih rest₀ hlen f' hf'
    exact key rest.length rest rfl

/-- When `¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)` (non-K recursor) and no
    constructor branch `w'` (`w'.recRef = w.recRef`) has `ctorTagCpt w'` in
    `ApproxDIK E (ctxEnvDIK E Γ) x`, `recCall (.const w.recRef ls) pre x` is
    `WhNormalPiKClosedCtxMaj E Γ`-normal at every `EnvWfT E`
    (`whNormalPiKClosedCtxMaj_recCall_nonK_no_ctorTag`). -/
theorem whNormalPiKClosedCtxMaj_recCall_nonK_no_ctorTag {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat}
    (hnotK : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (hnoCtor : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')) :
    WhNormalPiKClosedCtxMaj E Γ (recCall (.const w.recRef ls) pre x) := by
  intro e hs
  generalize ha : recCall (.const w.recRef ls) pre x = a₀ at hs
  cases hs with
  | of_whStep hs₀ =>
      cases hs₀ with
      | beta =>
          unfold recCall at ha
          rw [foldApps_snoc, Expr.app.injEq] at ha
          exact F8EtaK.foldApps_const_ne_lam_any ha.1
      | zeta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | delta =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | lit =>
          unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
      | iota hI =>
          obtain ⟨hT⟩ := derivedIotaT_of_derivedIotaU_envWfT hW hI
          cases hT with
          | of w' =>
              have hsp := congrArg appsSpine ha
              unfold iotaLhsOfS recCall at hsp
              rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
              injection hsp with hhead hargs
              injection hhead with hrec _
              have hpreLenEq : pre.length = w'.preMajor.length := by
                rw [hpre, (iotaWitnessS_preMajor_length_eq w w' hrec).2]
              obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
              injection hmajEq with hxEq
              rw [hxEq] at hnoCtor
              exact hnoCtor w' hrec.symm
                (approxDIK_ctorTagCpt_of_ctor_spine hW w' w'.lsC
                  (by rw [List.length_append, w'.hctorParams]) (ctxEnvDIK E Γ))
      | appHead hf₀ =>
          unfold recCall at ha
          rw [foldApps_snoc] at ha
          injection ha with hfEq _
          subst hfEq
          exact not_whStep_recursor_prefix hW w ls pre (Nat.le_of_eq hpre) hf₀
  | zetaLocal _ =>
      unfold recCall at ha; rw [foldApps_snoc] at ha; exact Expr.noConfusion ha
  | iotaS w' ls' lsC' pre' params' fields' hpre' hpar' hflds' =>
      have hsp := congrArg appsSpine ha
      unfold recCall at hsp
      rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
      injection hsp with hhead hargs
      injection hhead with hrec _
      have hpreLenEq : pre.length = pre'.length := by
        rw [hpre, hpre', (iotaWitnessS_preMajor_length_eq w w' hrec).2]
      obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
      injection hmajEq with hxEq
      rw [hxEq] at hnoCtor
      exact hnoCtor w' hrec.symm
        (approxDIK_ctorTagCpt_of_ctor_spine hW w' lsC'
          (by rw [List.length_append, hpar', hflds']) (ctxEnvDIK E Γ))
  | iotaKClosedCtx w' ls' pre' x' hk' _ _ =>
      have hsp := congrArg appsSpine ha
      unfold recCall at hsp
      rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
      injection hsp with hhead _
      injection hhead with hrec _
      obtain ⟨_, _, _, _, _, hfamEq, hnminEq, _, _⟩ := iotaWitnessS_same_recRef w' w hrec.symm
      rw [hfamEq, hnminEq] at hk'
      exact hnotK hk'
  | recMajor w' ls' pre' x' _ hpre' htag' _ =>
      have hsp := congrArg appsSpine ha
      unfold recCall at hsp
      rw [appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
      injection hsp with hhead hargs
      injection hhead with hrec _
      have hpreLenEq : pre.length = pre'.length := by
        rw [hpre, hpre', (iotaWitnessS_preMajor_length_eq w w' hrec).2]
      obtain ⟨_, hmajEq⟩ := List.append_inj hargs hpreLenEq
      injection hmajEq with hxEq
      rw [← hxEq] at htag'
      exact hnoCtor w' hrec.symm htag'
  | appHead hf =>
      unfold recCall at ha
      rw [foldApps_snoc] at ha
      injection ha with hfEq _
      subst hfEq
      exact not_whStepPiKClosedCtxMaj_recursor_prefix hW w ls pre (Nat.le_of_eq hpre) hf

/-- Any non-K recursor spine `foldApps (recCall (.const w.recRef ls) pre x) rest` whose major argument
    `x` has no `ctorTagCpt w'` in `ApproxDIK E (ctxEnvDIK E Γ)` is `WhNormalPiKClosedCtxMaj E Γ`-normal
    (`whNormalPiKClosedCtxMaj_recursor_nonK_no_ctorTag`). -/
theorem whNormalPiKClosedCtxMaj_recursor_nonK_no_ctorTag {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat} (rest : List (Expr Nat))
    (hnotK : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (hnoCtor : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')) :
    WhNormalPiKClosedCtxMaj E Γ (foldApps (recCall (.const w.recRef ls) pre x) rest) :=
  (whNormalPiKClosedCtxMaj_foldApps_recCall_iff hW w ls hpre x rest).mpr
    (whNormalPiKClosedCtxMaj_recCall_nonK_no_ctorTag hW w ls hpre hnotK hnoCtor)

/-- Full `.bot`-collapse across ALL compacts `c : CptI` for any non-K recursor spine
    `foldApps (recCall (.const w.recRef ls) pre x) rest` when `x` approximates no `ctorTagCpt w'`
    (`approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot`). -/
theorem approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot {E : ResolvedEnv} {ρ : EnvI}
    (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat} (rest : List (Expr Nat))
    (hnotK : ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1))
    (hnoCtor : ∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
      ¬ ApproxDIK E ρ x (ctorTagCpt w'))
    {c : CptI}
    (h : ApproxDIK E ρ (foldApps (recCall (.const w.recRef ls) pre x) rest) c) :
    c = .bot :=
  approxDIK_foldApps_eq_bot_of_eq_bot
    (fun _ hc => approxDIK_recursor_elim_no_ctorTag_nonK_eq_bot w hnotK ls hpre hnoCtor hc)
    rest h

/-- Any two non-K recursor spines whose major arguments approximate no `ctorTagCpt w'` are
    unconditionally `LRTermNoPiMajSemBi`-related at every type `T`
    (`lrTermNoPiMajSemBi_recursor_nonK_no_ctorTag`). -/
theorem lrTermNoPiMajSemBi_recursor_nonK_no_ctorTag {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {pre₁ pre₂ : List (Expr Nat)}
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    {x₁ x₂ : Expr Nat} (rest₁ rest₂ : List (Expr Nat))
    (hnotK₁ : ¬ (piBody w₁.famMember.mtype = .sort .zero ∧ w₁.nMinors = 1))
    (hnotK₂ : ¬ (piBody w₂.famMember.mtype = .sort .zero ∧ w₂.nMinors = 1))
    (hnoCtor₁ : ∀ (w' : IotaWitnessS E), w'.recRef = w₁.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₁ (ctorTagCpt w'))
    (hnoCtor₂ : ∀ (w' : IotaWitnessS E), w'.recRef = w₂.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₂ (ctorTagCpt w'))
    (T : Expr Nat) :
    LRTermNoPiMajSemBi E n Γ
      (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁)
      (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) T :=
  lrTermNoPiMajSemBi_of_probeCpt_eq_bot T
    (fun _ _ h => approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot w₁ ls₁ hpre₁ rest₁ hnotK₁ hnoCtor₁ h)
    (fun _ _ h => approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot w₂ ls₂ hpre₂ rest₂ hnotK₂ hnoCtor₂ h)

/-- **Multi-Step Major-Premise Reduction Congruence (`whRedPiKClosedCtxMaj_recMajor`):**
    Because `semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj` preserves `ApproxDIK E (ctxEnvDIK E Γ) xᵢ (ctorTagCpt w)`
    at every intermediate step `xᵢ`, any multi-step reduction `WhRedPiKClosedCtxMaj E Γ x x'` with
    `ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)` lifts to a multi-step reduction of
    `recCall (.const w.recRef ls) pre x`! -/
theorem whRedPiKClosedCtxMaj_recMajor {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat))
    {x x' : Expr Nat}
    (hpre : pre.length = w.preMajor.length)
    (htag : ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w))
    (hred : WhRedPiKClosedCtxMaj E Γ x x') :
    WhRedPiKClosedCtxMaj E Γ
      (recCall (.const w.recRef ls) pre x)
      (recCall (.const w.recRef ls) pre x') := by
  induction hred with
  | refl => exact .refl _
  | step hs _ ih =>
      have htag' : ApproxDIK E (ctxEnvDIK E Γ) _ (ctorTagCpt w) :=
        (semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj hW hs (ctorTagCpt w)).mp htag
      exact .step (.recMajor w ls pre _ _ hpre htag hs) (ih htag')

/-- **Multi-Step Constructor-Major $\iota$-Reduction (`whRedPiKClosedCtxMaj_recCall_of_whRed_ctor`):**
    Whenever the major premise `x` reduces under `WhRedPiKClosedCtxMaj E Γ` to a canonical constructor
    spine `foldApps (.const w.ctorRef lsC) (params ++ fields)`, `recCall (.const w.recRef ls) pre x`
    reduces under `WhRedPiKClosedCtxMaj E Γ` to `instPrefix (pre ++ fields) (instantiateLevels ls w.schema)`! -/
theorem whRedPiKClosedCtxMaj_recCall_of_whRed_ctor {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls lsC : List Level)
    {pre params fields : List (Expr Nat)} {x : Expr Nat}
    (hpre : pre.length = w.preMajor.length)
    (hpar : params.length = w.nparams)
    (hflds : fields.length = w.fields.length)
    (hx : WhRedPiKClosedCtxMaj E Γ x (foldApps (.const w.ctorRef lsC) (params ++ fields))) :
    WhRedPiKClosedCtxMaj E Γ
      (recCall (.const w.recRef ls) pre x)
      (instPrefix (pre ++ fields) (instantiateLevels ls w.schema)) := by
  have htag : ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) :=
    (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hx (ctorTagCpt w)).mpr
      (approxDIK_ctorTagCpt_of_ctor_spine hW w lsC
        (by rw [List.length_append, hpar, hflds]) (ctxEnvDIK E Γ))
  exact (whRedPiKClosedCtxMaj_recMajor hW w ls pre hpre htag hx).trans
    (.step (.iotaS w ls lsC pre params fields hpre hpar hflds) (.refl _))

/-- Post-major spine congruence of `whRedPiKClosedCtxMaj_recCall_of_whRed_ctor` across any trailing
    arguments `rest : List (Expr Nat)` (`whRedPiKClosedCtxMaj_recursor_foldApps_of_whRed_ctor`). -/
theorem whRedPiKClosedCtxMaj_recursor_foldApps_of_whRed_ctor {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (w : IotaWitnessS E) (ls lsC : List Level)
    {pre params fields : List (Expr Nat)} {x : Expr Nat} (rest : List (Expr Nat))
    (hpre : pre.length = w.preMajor.length)
    (hpar : params.length = w.nparams)
    (hflds : fields.length = w.fields.length)
    (hx : WhRedPiKClosedCtxMaj E Γ x (foldApps (.const w.ctorRef lsC) (params ++ fields))) :
    WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre x) rest)
      (foldApps (instPrefix (pre ++ fields) (instantiateLevels ls w.schema)) rest) :=
  whRedPiKClosedCtxMaj_foldApps
    (whRedPiKClosedCtxMaj_recCall_of_whRed_ctor hW w ls lsC hpre hpar hflds hx) rest

/-- Single-step K-recursor spine reduction in `WhStepPiKClosedCtxMaj` across any trailing arguments
    `rest : List (Expr Nat)` (`whStepPiKClosedCtxMaj_recursor_k_foldApps`). -/
theorem whStepPiKClosedCtxMaj_recursor_k_foldApps {E : ResolvedEnv}
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} {x : Expr Nat} (rest : List (Expr Nat))
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hpre : pre.length = w.preMajor.length)
    (hx : ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)) :
    WhStepPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre x) rest)
      (foldApps (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
        (instantiateLevels ls w.schema)) rest) :=
  whStepPiKClosedCtxMaj_foldApps (.iotaKClosedCtx w ls pre x hk hpre hx) rest

theorem whRedPiKClosedCtxMaj_recursor_k_foldApps {E : ResolvedEnv}
    {Γ : LCtx} (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} {x : Expr Nat} (rest : List (Expr Nat))
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (hpre : pre.length = w.preMajor.length)
    (hx : ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)) :
    WhRedPiKClosedCtxMaj E Γ
      (foldApps (recCall (.const w.recRef ls) pre x) rest)
      (foldApps (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
        (instantiateLevels ls w.schema)) rest) :=
  .step (whStepPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre hx) (.refl _)

private def isSortZeroExpr : Expr Nat → Bool
  | .sort .zero => true
  | _ => false

private theorem isSortZeroExpr_eq_true_iff (e : Expr Nat) :
    isSortZeroExpr e = true ↔ e = .sort .zero := by
  cases e with
  | sort l => cases l <;> simp [isSortZeroExpr]
  | _ => simp [isSortZeroExpr]

private theorem isKTarget_or_not {E : ResolvedEnv} (w : IotaWitnessS E) :
    (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) ∨
      ¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) := by
  cases hsz : isSortZeroExpr (piBody w.famMember.mtype)
  · exact Or.inr (fun h => by rw [(isSortZeroExpr_eq_true_iff _).mpr h.1] at hsz; cases hsz)
  · cases Nat.decEq w.nMinors 1 with
    | isFalse hne => exact Or.inr (fun h => hne h.2)
    | isTrue heq => exact Or.inl ⟨(isSortZeroExpr_eq_true_iff _).mp hsz, heq⟩

/-- **Complete Recursor Spine Trichotomy Under `WhRedPiKClosedCtxMaj` When the Major Premise
    Normalizes (`recursor_spine_whRedPiKClosedCtxMaj_trichotomy_of_major_normalizes`):**
    At every `EnvWfT E`, for any recursor spine `foldApps (recCall (.const w.recRef ls) pre x) rest`
    with `pre.length = w.preMajor.length` whose major premise `x` normalizes under
    `WhRedPiKClosedCtxMaj E Γ`, given the constructive constructor-tag case split `hctorOrNo`,
    **one of three cases holds**:
    1. **(Constructor-Major $\iota$-Reduction)**: `x` reduces under `WhRedPiKClosedCtxMaj E Γ` to a
       canonical constructor spine `foldApps (.const w'.ctorRef lsC) (params ++ fields)` for some
       branch `w'` with `w'.recRef = w.recRef`, and `foldApps (recCall (.const w.recRef ls) pre x) rest`
       reduces under `WhRedPiKClosedCtxMaj E Γ` to
       `foldApps (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) rest`;
    2. **(K-Target Non-Constructor $\iota_K$-Reduction)**: `piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1`,
       `¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)`, and `foldApps (recCall (.const w.recRef ls) pre x) rest`
       steps in 1 `WhStepPiKClosedCtxMaj` step to
       `foldApps (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr) (instantiateLevels ls w.schema)) rest`;
    3. **(Non-K Neutral Normal Form & `.bot`-Collapse)**: `¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)`,
       no branch `w'` has `ctorTagCpt w'` in `ApproxDIK E (ctxEnvDIK E Γ) x`,
       `foldApps (recCall (.const w.recRef ls) pre x) rest` is **already `WhNormalPiKClosedCtxMaj E Γ`-normal**,
       and its `ApproxDIK E (ctxEnvDIK E Γ)` denotation is `{.bot}`! -/
theorem recursor_spine_whRedPiKClosedCtxMaj_trichotomy_of_major_normalizes
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat} (rest : List (Expr Nat))
    (hnorm_x : WhRedPiKClosedCtxMajNormalizes E Γ x)
    (hctorOrNo :
      (∃ (w' : IotaWitnessS E), w'.recRef = w.recRef ∧
        ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')) ∨
      (∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
        ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w'))) :
    (∃ (w' : IotaWitnessS E) (lsC : List Level) (params fields : List (Expr Nat)),
      w'.recRef = w.recRef ∧
      params.length = w'.nparams ∧
      fields.length = w'.fields.length ∧
      WhRedPiKClosedCtxMaj E Γ x (foldApps (.const w'.ctorRef lsC) (params ++ fields)) ∧
      WhRedPiKClosedCtxMaj E Γ
        (foldApps (recCall (.const w.recRef ls) pre x) rest)
        (foldApps (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) rest)) ∨
    ((piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) ∧
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) ∧
      WhRedPiKClosedCtxMaj E Γ
        (foldApps (recCall (.const w.recRef ls) pre x) rest)
        (foldApps (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema)) rest)) ∨
    (¬ (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) ∧
      (∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
        ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')) ∧
      WhNormalPiKClosedCtxMaj E Γ (foldApps (recCall (.const w.recRef ls) pre x) rest) ∧
      (∀ c, ApproxDIK E (ctxEnvDIK E Γ) (foldApps (recCall (.const w.recRef ls) pre x) rest) c →
        c = .bot)) := by
  rcases hctorOrNo with ⟨w', hrecEq, htag⟩ | hnoCtor
  · obtain ⟨nf_x, hred_x, hnf_x⟩ := hnorm_x
    obtain ⟨lsC, params, fields, hpar, hflds, hred_ctor⟩ :=
      (approxDIK_ctorTagCpt_iff_whRedPiKClosedCtxMaj_of_normalizes hW w' hred_x hnf_x).mp htag
    have hpre' : pre.length = w'.preMajor.length := by
      rw [hpre, (iotaWitnessS_preMajor_length_eq w w' hrecEq.symm).2]
    have hred_spine : WhRedPiKClosedCtxMaj E Γ
        (foldApps (recCall (.const w.recRef ls) pre x) rest)
        (foldApps (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) rest) := by
      rw [← hrecEq]
      exact whRedPiKClosedCtxMaj_recursor_foldApps_of_whRed_ctor hW w' ls lsC rest
        hpre' hpar hflds hred_ctor
    exact Or.inl ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, hred_spine⟩
  · rcases isKTarget_or_not w with hk | hnotK
    · exact Or.inr (Or.inl ⟨hk, hnoCtor w rfl,
        whRedPiKClosedCtxMaj_recursor_k_foldApps w ls rest hk hpre (hnoCtor w rfl)⟩)
    · exact Or.inr (Or.inr ⟨hnotK, hnoCtor,
        whNormalPiKClosedCtxMaj_recursor_nonK_no_ctorTag hW w ls hpre rest hnotK hnoCtor,
        fun _ hc => approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot w ls hpre rest hnotK hnoCtor hc⟩)

/-- **Recursor Spine Weak-Head Normalizability Criterion
    (`whRedPiKClosedCtxMajNormalizes_recursor_spine_of_major_normalizes`):**
    If the major premise `x` normalizes under `WhRedPiKClosedCtxMaj E Γ`, then
    `foldApps (recCall (.const w.recRef ls) pre x) rest` normalizes whenever its applicable
    $\iota$-branch (or $\iota_K$-branch) contractum normalizes (and in the non-K non-constructor
    case, it is **already normal in 0 steps** without any hypothesis on the contracta)! -/
theorem whRedPiKClosedCtxMajNormalizes_recursor_spine_of_major_normalizes
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (w : IotaWitnessS E) (ls : List Level)
    {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {x : Expr Nat} (rest : List (Expr Nat))
    (hnorm_x : WhRedPiKClosedCtxMajNormalizes E Γ x)
    (hctorOrNo :
      (∃ (w' : IotaWitnessS E), w'.recRef = w.recRef ∧
        ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')) ∨
      (∀ (w' : IotaWitnessS E), w'.recRef = w.recRef →
        ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w')))
    (hiota : ∀ (w' : IotaWitnessS E) (lsC : List Level) (params fields : List (Expr Nat)),
      w'.recRef = w.recRef →
      params.length = w'.nparams →
      fields.length = w'.fields.length →
      WhRedPiKClosedCtxMaj E Γ x (foldApps (.const w'.ctorRef lsC) (params ++ fields)) →
      WhRedPiKClosedCtxMajNormalizes E Γ
        (foldApps (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) rest))
    (hiotaK : (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) →
      WhRedPiKClosedCtxMajNormalizes E Γ
        (foldApps (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema)) rest)) :
    WhRedPiKClosedCtxMajNormalizes E Γ (foldApps (recCall (.const w.recRef ls) pre x) rest) := by
  rcases recursor_spine_whRedPiKClosedCtxMaj_trichotomy_of_major_normalizes
      hW w ls hpre rest hnorm_x hctorOrNo with
    ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, hred_sp⟩ |
    ⟨hk, hno, hred_sp⟩ |
    ⟨_, _, hnorm_sp, _⟩
  · obtain ⟨nf, hred_nf, hnf⟩ := hiota w' lsC params fields hrecEq hpar hflds hred_ctor
    exact ⟨nf, hred_sp.trans hred_nf, hnf⟩
  · obtain ⟨nf, hred_nf, hnf⟩ := hiotaK hk hno
    exact ⟨nf, hred_sp.trans hred_nf, hnf⟩
  · exact ⟨_, .refl _, hnorm_sp⟩

/-! ### §25.2. `SameLetProfile` Invariance, Context Weakening (`weaken` / `weaken0`), and
Let-Substitution (`substLet` / `substLet0`) for `WhStepPiKClosedCtxMaj`, `WhRedPiKClosedCtxMaj`,
`LRProbeTypePiKClosedCtxMaj`, and `LRTermNoPiMajSemBi` -/

/-- `WhStepPiKClosedCtxMaj` is invariant under `SameLetProfile Γ Γ'` (requiring **zero** `EnvWfT E`!)
    (`whStepPiKClosedCtxMaj_of_sameLetProfile`). -/
theorem whStepPiKClosedCtxMaj_of_sameLetProfile {E : ResolvedEnv} {Γ Γ' : LCtx}
    (hprof : SameLetProfile Γ Γ') {a b : Expr Nat}
    (h : WhStepPiKClosedCtxMaj E Γ a b) :
    WhStepPiKClosedCtxMaj E Γ' a b := by
  induction h with
  | of_whStep hs => exact .of_whStep hs
  | zetaLocal hval =>
      rw [hprof.1] at hval
      exact .zetaLocal hval
  | iotaS w ls lsC pre params fields hpre hpar hflds =>
      exact .iotaS w ls lsC pre params fields hpre hpar hflds
  | iotaKClosedCtx w ls pre x hk hpre hx =>
      rw [hprof.2 E] at hx
      exact .iotaKClosedCtx w ls pre x hk hpre hx
  | recMajor w ls pre x x' hpre htag _ ih =>
      rw [hprof.2 E] at htag
      exact .recMajor w ls pre x x' hpre htag ih
  | appHead _ ih =>
      exact .appHead ih

theorem whRedPiKClosedCtxMaj_of_sameLetProfile {E : ResolvedEnv} {Γ Γ' : LCtx}
    (hprof : SameLetProfile Γ Γ') {a b : Expr Nat}
    (h : WhRedPiKClosedCtxMaj E Γ a b) :
    WhRedPiKClosedCtxMaj E Γ' a b := by
  induction h with
  | refl a => exact .refl a
  | step hs _ ih => exact .step (whStepPiKClosedCtxMaj_of_sameLetProfile hprof hs) ih

theorem whNormalPiKClosedCtxMaj_of_sameLetProfile {E : ResolvedEnv} {Γ Γ' : LCtx}
    (hprof : SameLetProfile Γ Γ') {a : Expr Nat}
    (h : WhNormalPiKClosedCtxMaj E Γ a) :
    WhNormalPiKClosedCtxMaj E Γ' a :=
  fun b hs => h b (whStepPiKClosedCtxMaj_of_sameLetProfile (sameLetProfile_symm hprof) hs)

theorem whRedPiKClosedCtxMajNormalizes_of_sameLetProfile {E : ResolvedEnv} {Γ Γ' : LCtx}
    (hprof : SameLetProfile Γ Γ') {a : Expr Nat}
    (h : WhRedPiKClosedCtxMajNormalizes E Γ a) :
    WhRedPiKClosedCtxMajNormalizes E Γ' a := by
  obtain ⟨nf, hred, hnorm⟩ := h
  exact ⟨nf, whRedPiKClosedCtxMaj_of_sameLetProfile hprof hred,
    whNormalPiKClosedCtxMaj_of_sameLetProfile hprof hnorm⟩

/-- Context conversion of `LRProbeTypePiKClosedCtxMaj` under `SameLetProfile Γ Γ'` (requiring **only**
    `hcl : EnvClosed E`, `hctx : CtxConvT E n Γ Γ'`, and `hprof : SameLetProfile Γ Γ'` — **zero**
    `CtxWfT E n Γ'`!) (`lrProbeTypePiKClosedCtxMaj_ctx_of_sameLetProfile`). -/
theorem lrProbeTypePiKClosedCtxMaj_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {X Y : Expr Nat} {c : CptI}
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X Y c) :
    LRProbeTypePiKClosedCtxMaj E n Γ' X Y c := by
  cases h with
  | bot => exact .bot Γ' X Y
  | sort hX hY =>
      exact .sort (whRedPiKClosedCtxMaj_of_sameLetProfile hprof hX)
        (whRedPiKClosedCtxMaj_of_sameLetProfile hprof hY)
  | @pi A₁ B₁ A₂ B₂ hX hY hdom hcod =>
      exact .pi (whRedPiKClosedCtxMaj_of_sameLetProfile hprof hX)
        (whRedPiKClosedCtxMaj_of_sameLetProfile hprof hY)
        (tyConvT_ctx hcl hctx hdom)
        (tyConvT_ctx hcl (.same (.assumption A₁) hctx) hcod)

/-- Context conversion of `LRTermNoPiMajSemBi` under `SameLetProfile Γ Γ'` (requiring **only**
    `hcl : EnvClosed E`, `hctx : CtxConvT E n Γ Γ'`, and `hprof : SameLetProfile Γ Γ'` — **zero**
    `CtxWfT E n Γ'`!) (`lrTermNoPiMajSemBi_ctx_of_sameLetProfile`). -/
theorem lrTermNoPiMajSemBi_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {M M' A : Expr Nat}
    (h : LRTermNoPiMajSemBi E n Γ M M' A) :
    LRTermNoPiMajSemBi E n Γ' M M' A := by
  have henv : ctxEnvDIK E Γ = ctxEnvDIK E Γ' := hprof.2 E
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c := by
    rwa [henv]
  rcases h c hc hor₀ with hP | hC
  · exact Or.inl (isSemPropTyI_ctx_of_sameLetProfile hcl hctx hprof hP)
  · refine Or.inr ?_
    cases hc with
    | bot => trivial
    | sort =>
        refine ⟨?_, lrProbeTypePiKClosedCtxMaj_ctx_of_sameLetProfile hcl hctx hprof hC.2⟩
        rw [← henv]
        exact hC.1
    | piBotNil =>
        refine ⟨rfl, rfl, ?_,
          lrProbeTypePiKClosedCtxMaj_ctx_of_sameLetProfile hcl hctx hprof hC.2.2.2⟩
        rw [← henv]
        exact hC.2.2.1

theorem lrTermNoPiMajSemBi_assump_dom_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u)) (M M' B : Expr Nat) :
    LRTermNoPiMajSemBi E n (.assumption A₁ :: Γ) M M' B ↔
      LRTermNoPiMajSemBi E n (.assumption A₂ :: Γ) M M' B := by
  have ends := convEnds hW hΓ hcA
  have hcl := envClosed_of_envWfT hW
  constructor
  · exact lrTermNoPiMajSemBi_ctx_of_sameLetProfile hcl
      (.assumption (ctxConvT_refl Γ) ends.1 ends.2.1 hcA)
      (sameLetProfile_assump_head A₁ A₂ Γ)
  · exact lrTermNoPiMajSemBi_ctx_of_sameLetProfile hcl
      (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hcA))
      (sameLetProfile_assump_head A₂ A₁ Γ)

theorem lrTermNoPiMajSemBi_let_sameVal_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ v : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u))
    (hv : HasTyT E n Γ v A₁)
    (M M' B : Expr Nat) :
    LRTermNoPiMajSemBi E n (.letBinding A₁ v :: Γ) M M' B ↔
      LRTermNoPiMajSemBi E n (.letBinding A₂ v :: Γ) M M' B := by
  have ends := convEnds hW hΓ hcA
  have hcl := envClosed_of_envWfT hW
  have hv₂ : HasTyT E n Γ v A₂ := .conv Γ v A₁ A₂ u hv hcA
  constructor
  · exact lrTermNoPiMajSemBi_ctx_of_sameLetProfile hcl
      (.letBinding (ctxConvT_refl Γ) ends.1 ends.2.1 hcA hv₂ (.refl Γ v A₁ hv))
      (sameLetProfile_let_head_sameVal A₁ A₂ v Γ)
  · exact lrTermNoPiMajSemBi_ctx_of_sameLetProfile hcl
      (.letBinding (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hcA) hv (.refl Γ v A₂ hv₂))
      (sameLetProfile_let_head_sameVal A₂ A₁ v Γ)

/-- **All-Cutoff Weakening Commutation for `WhStepPiKClosedCtxMaj` (`whStepPiKClosedCtxMaj_lift_insertAt`):**
    Requires **only** `hcl : EnvClosed E`! -/
theorem whStepPiKClosedCtxMaj_lift_insertAt {E : ResolvedEnv} (hcl : EnvClosed E)
    (d : LocalDecl) {k : Nat} {Γ : LCtx} (hk : k ≤ Γ.length)
    {a b : Expr Nat} (h : WhStepPiKClosedCtxMaj E Γ a b) :
    WhStepPiKClosedCtxMaj E (insertAt d k Γ) (lift k 1 a) (lift k 1 b) := by
  induction h with
  | of_whStep hs =>
      exact .of_whStep (whStep_lift_of_envClosed hcl hs k)
  | @zetaLocal i v hval =>
      by_cases hik : i < k
      · have hsub := lookupValue_insertAt_lt d hik hval
        simp only [lift, if_neg (by omega : ¬ k ≤ i)]
        exact .zetaLocal hsub
      · have hsub := lookupValue_insertAt_ge d (by omega : k ≤ i) hval
        simp only [lift, if_pos (by omega : k ≤ i)]
        exact .zetaLocal hsub
  | iotaS w ls lsC pre params fields hpre hpar hflds =>
      have hclSchema : exprClosedAt (pre ++ fields).length (instantiateLevels ls w.schema) = true := by
        rw [exprClosedAt_instantiateLevels, List.length_append, hpre, hflds, w.hpre]
        exact w.hschemaScope
      rw [recCall_lift, foldApps_lift,
        ← instPrefix_map_lift_of_closed (pre ++ fields) k (instantiateLevels ls w.schema) hclSchema,
        List.map_append, List.map_append]
      simp only [lift]
      exact .iotaS w ls lsC (pre.map (lift k 1)) (params.map (lift k 1)) (fields.map (lift k 1))
        (by rw [List.length_map, hpre])
        (by rw [List.length_map, hpar])
        (by rw [List.length_map, hflds])
  | iotaKClosedCtx w ls pre x hk_prop hpre hx =>
      have hclSchema : exprClosedAt (pre ++ List.replicate w.fields.length botClosedExpr).length
          (instantiateLevels ls w.schema) = true := by
        rw [exprClosedAt_instantiateLevels, List.length_append, List.length_replicate, hpre, w.hpre]
        exact w.hschemaScope
      rw [recCall_lift,
        ← instPrefix_map_lift_of_closed (pre ++ List.replicate w.fields.length botClosedExpr) k
          (instantiateLevels ls w.schema) hclSchema,
        List.map_append, replicate_botClosedExpr_map_lift]
      simp only [lift]
      exact .iotaKClosedCtx w ls (pre.map (lift k 1)) (lift k 1 x) hk_prop
        (by rw [List.length_map, hpre])
        (fun htag => hx ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk x (ctorTagCpt w)).mp htag))
  | recMajor w ls pre x x' hpre htag _ ih =>
      rw [recCall_lift, recCall_lift]
      simp only [lift]
      exact .recMajor w ls (pre.map (lift k 1)) (lift k 1 x) (lift k 1 x')
        (by rw [List.length_map, hpre])
        ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk x (ctorTagCpt w)).mpr htag)
        ih
  | appHead _ ih =>
      exact .appHead ih

