      (lrTermDSubKClosedCtxBi_inst0_right_diag_of_let_diags
        hW hSort hΓ hA₁ hv₁ hv₂ hcv
        (prunedSemEqDIK_lam_pi E (ctxEnvDIK E Γ) D₁ P₁ Q₁ D₂ P₂ Q₂)
