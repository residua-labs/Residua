    (hb₂_wf2 : LRPiWf2 E n (.letBinding A₁ (.lam D₁ (.sort l₁)) :: Γ) b₂) :
    LRTermDSubKClosedCtxBi E n Γ
      (.letE A₁ (.lam D₁ (.sort l₁)) b₁)
      (.letE A₂ (.lam D₂ (.sort l₂)) b₂)
      (instantiate0 (.lam D₁ (.sort l₁)) B) := by
  have hA₁ : HasTyT E n Γ A₁ (.sort u) := (convEnds hW hΓ hcA).1
  have hb₂_let₁ : LRTermDSubKClosedCtxBi E n
      (.letBinding A₁ (.lam D₁ (.sort l₁)) :: Γ) b₂ b₂ B :=
    lrTermDSubKClosedCtxBi_trans hW (lrTermDSubKClosedCtxBi_symm hW hb_let₁) hb_let₁
  have hb₂_let₁_v₂ : LRTermDSubKClosedCtxBi E n
      (.letBinding A₁ (.lam D₂ (.sort l₂)) :: Γ) b₂ b₂ B :=
    (lrTermDSubKClosedCtxBi_let_sameVal_iff hW hΓ hcA hv₂ b₂ b₂ B).mpr hb₂_let₂
  exact lrTermDSubKClosedCtxBi_letE_of_letValCongr hW hSort hΓ hv₁ hb_let₁
    (lrTermDSubKClosedCtxBi_subst0_lam_sort_arg_all
      hW hSort hΓ hA₁ hv₁ hv₂ hcv hb₂_let₁ hb₂_wf2
      (lrTermDSubKClosedCtxBi_inst0_right_diag_of_let_diags
        hW hSort hΓ hA₁ hv₁ hv₂ hcv
        (prunedSemEqDIK_lam_sorts E (ctxEnvDIK E Γ) D₁ D₂ l₁ l₂)
        hb₂_let₁ hb₂_let₁_v₂))

/-- **Unconditional Two-Sided `ConvT.letE` Congruence for Convertible $\lambda$-Abstractions Over
    $\Pi$-Types Across ALL 3 Probes (`lrTermDSubKClosedCtxBi_letE_lam_pi_val_all`):** -/
theorem lrTermDSubKClosedCtxBi_letE_lam_pi_val_all
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A₁ A₂ D₁ P₁ Q₁ D₂ P₂ Q₂ b₁ b₂ B : Expr Nat} {u uD u₁ u₂ : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u))
    (hv₁ : HasTyT E n Γ (.lam D₁ (.pi P₁ Q₁)) A₁)
    (hv₂ : HasTyT E n Γ (.lam D₂ (.pi P₂ Q₂)) A₁)
    (hcv : ConvT E n Γ (.lam D₁ (.pi P₁ Q₁)) (.lam D₂ (.pi P₂ Q₂)) A₁)
    (hD₁ : HasTyT E n Γ D₁ (.sort uD))
    (hP₁ : HasTyT E n (.assumption D₁ :: Γ) P₁ (.sort u₁))
    (hQ₁ : HasTyT E n (.assumption P₁ :: .assumption D₁ :: Γ) Q₁ (.sort u₂))
    (hcP : ConvT E n (.assumption D₁ :: Γ) P₁ P₂ (.sort u₁))
    (hcQ : ConvT E n (.assumption P₁ :: .assumption D₁ :: Γ) Q₁ Q₂ (.sort u₂))
    (harg_ty : ∀ arg₀ : Expr Nat,
      WhRedPiKClosedCtx E (.letBinding A₁ (.lam D₁ (.pi P₁ Q₁)) :: Γ) b₂ (.app (.bvar 0) arg₀) →
      Nonempty (HasTyT E n (.letBinding A₁ (.lam D₁ (.pi P₁ Q₁)) :: Γ) arg₀ (lift 0 1 D₁)))
    (hb_let₁ : LRTermDSubKClosedCtxBi E n (.letBinding A₁ (.lam D₁ (.pi P₁ Q₁)) :: Γ) b₁ b₂ B)
    (hb₂_let₂ : LRTermDSubKClosedCtxBi E n (.letBinding A₂ (.lam D₂ (.pi P₂ Q₂)) :: Γ) b₂ b₂ B)
    (hb₂_wf2 : LRPiWf2 E n (.letBinding A₁ (.lam D₁ (.pi P₁ Q₁)) :: Γ) b₂) :
    LRTermDSubKClosedCtxBi E n Γ
      (.letE A₁ (.lam D₁ (.pi P₁ Q₁)) b₁)
      (.letE A₂ (.lam D₂ (.pi P₂ Q₂)) b₂)
      (instantiate0 (.lam D₁ (.pi P₁ Q₁)) B) := by
  have hA₁ : HasTyT E n Γ A₁ (.sort u) := (convEnds hW hΓ hcA).1
  have hb₂_let₁ : LRTermDSubKClosedCtxBi E n
      (.letBinding A₁ (.lam D₁ (.pi P₁ Q₁)) :: Γ) b₂ b₂ B :=
    lrTermDSubKClosedCtxBi_trans hW (lrTermDSubKClosedCtxBi_symm hW hb_let₁) hb_let₁
  have hb₂_let₁_v₂ : LRTermDSubKClosedCtxBi E n
      (.letBinding A₁ (.lam D₂ (.pi P₂ Q₂)) :: Γ) b₂ b₂ B :=
    (lrTermDSubKClosedCtxBi_let_sameVal_iff hW hΓ hcA hv₂ b₂ b₂ B).mpr hb₂_let₂
  exact lrTermDSubKClosedCtxBi_letE_of_letValCongr hW hSort hΓ hv₁ hb_let₁
    (lrTermDSubKClosedCtxBi_subst0_lam_pi_arg_all
      hW hSort hΓ hA₁ hv₁ hv₂ hcv hD₁ hP₁ hQ₁ hcP hcQ harg_ty hb₂_let₁ hb₂_wf2
      (lrTermDSubKClosedCtxBi_inst0_right_diag_of_let_diags
        hW hSort hΓ hA₁ hv₁ hv₂ hcv
        (prunedSemEqDIK_lam_pi E (ctxEnvDIK E Γ) D₁ P₁ Q₁ D₂ P₂ Q₂)
        hb₂_let₁ hb₂_let₁_v₂))

/-! ### §19.3. Principal-Type Uniqueness (`hasTyT_unique_tyConvT_of_noApp` / `hasTyT_unique_tyConvT_of_piRow`)
and Discharging `PropTyTransport E n` -/

/-- Congruence of `eqN` under `.imax`. -/
theorem eqN_imax_congr {u₁ u₂ v₁ v₂ : Level} (hu : eqN u₁ u₂) (hv : eqN v₁ v₂) :
    eqN (.imax u₁ v₁) (.imax u₂ v₂) :=
  fun ρ => by simp only [eval, hu ρ, hv ρ]

/-- Codomain `TyConvT` congruence under `.pi A` (`tyConvT_pi_cod_of_hasTyT`, `Type`-valued, zero `EnvWfT`). -/
def tyConvT_pi_cod_of_hasTyT {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u)) :
    {B₁ B₂ : Expr Nat} → TyConvT E n (.assumption A :: Γ) B₁ B₂ →
    TyConvT E n Γ (.pi A B₁) (.pi A B₂)
  | _, _, .refl _ B => .refl Γ (.pi A B)
  | _, _, .of _ B₁ B₂ v hc =>
      .of Γ (.pi A B₁) (.pi A B₂) (.imax u v)
        (.pi Γ A A B₁ B₂ u v (.refl Γ A (.sort u) hA) hc)
  | _, _, .trans _ B₁ M B₂ c₁ c₂ =>
      .trans Γ (.pi A B₁) (.pi A M) (.pi A B₂)
        (tyConvT_pi_cod_of_hasTyT hA c₁) (tyConvT_pi_cod_of_hasTyT hA c₂)

/-- Syntactic check that an expression contains no `.app` or `.lit` constructor (`noAppLitExpr`). -/
def noAppLitExpr : Expr Nat → Bool
  | .bvar _ => true
  | .sort _ => true
  | .const _ _ => true
  | .pi A B => noAppLitExpr A && noAppLitExpr B
  | .lam A b => noAppLitExpr A && noAppLitExpr b
  | .letE A v b => noAppLitExpr A && noAppLitExpr v && noAppLitExpr b
  | .app _ _ => false
  | .lit _ => false

/-- **Type-Valued Principal-Type Uniqueness for `.app`/`.lit`-Free Expressions
    (`hasTyT_unique_tyConvT_of_noApp`):**
    Requires **only** `EnvWfT E` and `hSort` — with **zero `CtxWfT`**, **zero `PiInj`**,
    **zero `PiRowField`**, and **zero `PropTyTransport`**! -/
def hasTyT_unique_tyConvT_of_noApp {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂) :
    {Γ : LCtx} → {e T₁ T₂ : Expr Nat} →
    HasTyT E n Γ e T₁ →
    noAppLitExpr e = true →
    HasTyT E n Γ e T₂ →
    TyConvT E n Γ T₁ T₂
  | _, _, _, _, .sort _ _, _, h₂ =>
      hasTyTInv_sortT h₂ rfl
  | _, _, _, _, .bvar _ _ T₁ hget₁, _, h₂ => by
      obtain ⟨A₀, hget₂, hc₂⟩ := hasTyTInv_bvar h₂ rfl
      have heq : T₁ = A₀ := Option.some.inj (hget₁.symm.trans hget₂)
      subst heq
      exact hc₂
  | _, _, _, _, .const _ _ _ m₁ hm₁ _ _, _, h₂ => by
      obtain ⟨m₂, hm₂, _, _, hc₂⟩ := hasTyTInv_const h₂ rfl
      have heq : m₁ = m₂ := Option.some.inj (hm₁.symm.trans hm₂)
      subst heq
      exact hc₂
  | Γ, _, _, T₂, .pi _ A u₁ B v₁ hA₁ hB₁, hno, h₂ => by
      simp only [noAppLitExpr, Bool.and_eq_true] at hno
      obtain ⟨u₂, v₂, hA₂, hB₂, hc₂⟩ := hasTyTInv_pi h₂ rfl
      have hu : eqN u₁ u₂ := hSort (hasTyT_unique_tyConvT_of_noApp hW hSort hA₁ hno.1 hA₂)
      have hv : eqN v₁ v₂ := hSort (hasTyT_unique_tyConvT_of_noApp hW hSort hB₁ hno.2 hB₂)
      exact .trans Γ (.sort (.imax u₁ v₁)) (.sort (.imax u₂ v₂)) T₂
        (.of Γ (.sort (.imax u₁ v₁)) (.sort (.imax u₂ v₂)) (.succ (.imax u₁ v₁))
          (.sorts Γ (.imax u₁ v₁) (.imax u₂ v₂) (eqN_imax_congr hu hv)))
        hc₂
  | Γ, _, _, T₂, .lam _ A _ _ B₁ hA₁ hb₁, hno, h₂ => by
      simp only [noAppLitExpr, Bool.and_eq_true] at hno
      obtain ⟨_, B₂, _, hb₂, hc₂⟩ := hasTyTInv_lam h₂ rfl
      have hcB : TyConvT E n (.assumption A :: Γ) B₁ B₂ :=
        hasTyT_unique_tyConvT_of_noApp hW hSort hb₁ hno.2 hb₂
      exact .trans Γ (.pi A B₁) (.pi A B₂) T₂ (tyConvT_pi_cod_of_hasTyT hA₁ hcB) hc₂
  | _, _, _, _, .app _ _ _ _ _ _ _, hno, _ => nomatch hno
  | Γ, _, _, T₂, .letE _ A _ v B₁ _ _ hv₁ hb₁, hno, h₂ => by
      simp only [noAppLitExpr, Bool.and_eq_true] at hno
      obtain ⟨_, B₂, _, _, hb₂, hc₂⟩ := hasTyTInv_letE h₂ rfl
      have hcB : TyConvT E n (.letBinding A v :: Γ) B₁ B₂ :=
        hasTyT_unique_tyConvT_of_noApp hW hSort hb₁ hno.2 hb₂
      have hcB0 : TyConvT E n Γ (instantiate0 v B₁) (instantiate0 v B₂) := by
        have h0 := tyConvT_substLetS (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW)
          A v hcB (j := 0) List.getElem?_cons_zero
          (by simpa only [substRemove_zero_cons, lift_zero] using hv₁)
        simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0
      exact .trans Γ (instantiate0 v B₁) (instantiate0 v B₂) T₂ hcB0 hc₂
  | _, _, _, _, .lit _ _ _ _, hno, _ => nomatch hno
  | Γ, _, _, T₂, .conv _ _ S₁ T₁ u₁ he₁ hc₁, hno, h₂ =>
      .trans Γ T₁ S₁ T₂ (.symmT (.of Γ S₁ T₁ u₁ hc₁))
        (hasTyT_unique_tyConvT_of_noApp hW hSort he₁ hno h₂)

/-- Sort-level uniqueness `eqN u₁ u₂` for any `.app`/`.lit`-free type `A` typed at both `.sort u₁`
    and `.sort u₂` (`hasTyT_sort_unique_eqN_of_noApp`). -/
theorem hasTyT_sort_unique_eqN_of_noApp {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} {A : Expr Nat} {u₁ u₂ : Level}
    (hno : noAppLitExpr A = true)
    (h₁ : HasTyT E n Γ A (.sort u₁)) (h₂ : HasTyT E n Γ A (.sort u₂)) :
    eqN u₁ u₂ :=
  hSort (hasTyT_unique_tyConvT_of_noApp hW hSort h₁ hno h₂)

/-- Whenever `hc : ConvT E n Γ A B (.sort u)` and `eqN u .zero`, `IsPropTyI E n Γ B` holds
    unconditionally (`isPropTyI_of_convT_sort_eqN_zero`, zero `PropTyTransport`!). -/
theorem isPropTyI_of_convT_sort_eqN_zero {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {u : Level}
    (hc : ConvT E n Γ A B (.sort u)) (hu : eqN u .zero) :
    IsPropTyI E n Γ B :=
  isPropTyI_of_hasTyT_sort_zero hSort
    (.conv Γ B (.sort u) (.sort .zero) (.succ u)
      (convEnds hW hΓ hc).2.1 (.sorts Γ u .zero hu))

/-- **Unconditional `IsPropTyI` Transport Across `ConvT E n Γ A B (.sort u)` for Any `.app`/`.lit`-Free
    Source Type `A` (`isPropTyI_transport_of_noApp_convT`):**
    Requires **zero `PropTyTransport`** and **zero `PiInj`**! -/
theorem isPropTyI_transport_of_noApp_convT {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {u : Level}
    (hno : noAppLitExpr A = true)
    (hc : ConvT E n Γ A B (.sort u)) (hPA : IsPropTyI E n Γ A) :
    IsPropTyI E n Γ B := by
  rcases hPA with ⟨⟨hA0⟩, _⟩
  exact isPropTyI_of_convT_sort_eqN_zero hW hSort hΓ hc
    (hasTyT_sort_unique_eqN_of_noApp hW hSort hno (convEnds hW hΓ hc).1 hA0)

/-- **Full 9-Constructor Principal-Type Uniqueness Across ALL Expressions Under `PiRowField E n`
    (`hasTyT_unique_tyConvT_of_piRow`):** -/
theorem hasTyT_unique_tyConvT_of_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n) :
    {Γ : LCtx} → {e T₁ T₂ : Expr Nat} →
    HasTyT E n Γ e T₁ →
    CtxWfT E n Γ →
    HasTyT E n Γ e T₂ →
    Nonempty (TyConvT E n Γ T₁ T₂)
  | _, _, _, _, .sort _ _, _, h₂ =>
      ⟨hasTyTInv_sortT h₂ rfl⟩
  | _, _, _, _, .bvar _ _ T₁ hget₁, _, h₂ => by
      obtain ⟨A₀, hget₂, hc₂⟩ := hasTyTInv_bvar h₂ rfl
      have heq : T₁ = A₀ := Option.some.inj (hget₁.symm.trans hget₂)
      subst heq
      exact ⟨hc₂⟩
  | _, _, _, _, .const _ _ _ m₁ hm₁ _ _, _, h₂ => by
      obtain ⟨m₂, hm₂, _, _, hc₂⟩ := hasTyTInv_const h₂ rfl
      have heq : m₁ = m₂ := Option.some.inj (hm₁.symm.trans hm₂)
      subst heq
      exact ⟨hc₂⟩
  | Γ, _, _, T₂, .pi _ A u₁ B v₁ hA₁ hB₁, hΓ, h₂ => by
      obtain ⟨u₂, v₂, hA₂, hB₂, hc₂⟩ := hasTyTInv_pi h₂ rfl
      obtain ⟨hc_u⟩ := hasTyT_unique_tyConvT_of_piRow hW hSort hPi hA₁ hΓ hA₂
      obtain ⟨hc_v⟩ :=
        hasTyT_unique_tyConvT_of_piRow hW hSort hPi hB₁ (.assumption Γ A u₁ hΓ hA₁) hB₂
      exact ⟨.trans Γ (.sort (.imax u₁ v₁)) (.sort (.imax u₂ v₂)) T₂
        (.of Γ (.sort (.imax u₁ v₁)) (.sort (.imax u₂ v₂)) (.succ (.imax u₁ v₁))
          (.sorts Γ (.imax u₁ v₁) (.imax u₂ v₂) (eqN_imax_congr (hSort hc_u) (hSort hc_v))))
        hc₂⟩
  | Γ, _, _, T₂, .lam _ A u₁ _ B₁ hA₁ hb₁, hΓ, h₂ => by
      obtain ⟨_, B₂, _, hb₂, hc₂⟩ := hasTyTInv_lam h₂ rfl
      obtain ⟨hcB⟩ :=
        hasTyT_unique_tyConvT_of_piRow hW hSort hPi hb₁ (.assumption Γ A u₁ hΓ hA₁) hb₂
      exact ⟨.trans Γ (.pi A B₁) (.pi A B₂) T₂ (tyConvT_pi_cod_of_hasTyT hA₁ hcB) hc₂⟩
  | Γ, _, _, T₂, .app _ _ a A₁ B₁ hf₁ ha₁, hΓ, h₂ => by
      obtain ⟨_, B₂, hf₂, _, hc₂⟩ := hasTyTInv_app h₂ rfl
      obtain ⟨hc_pi⟩ := hasTyT_unique_tyConvT_of_piRow hW hSort hPi hf₁ hΓ hf₂
      obtain ⟨_, ⟨hcB⟩⟩ := hPi hΓ hc_pi
      have hcB0 : TyConvT E n Γ (instantiate0 a B₁) (instantiate0 a B₂) := by
        have h0 := tyConvT_substS (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW)
          a A₁ hcB (j := 0) List.getElem?_cons_zero
          (by simpa only [substRemove_zero_cons, lift_zero] using ha₁)
        simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0
      exact ⟨.trans Γ (instantiate0 a B₁) (instantiate0 a B₂) T₂ hcB0 hc₂⟩
  | Γ, _, _, T₂, .letE _ A u₁ v B₁ _ hA₁ hv₁ hb₁, hΓ, h₂ => by
      obtain ⟨_, B₂, _, _, hb₂, hc₂⟩ := hasTyTInv_letE h₂ rfl
      obtain ⟨hcB⟩ :=
        hasTyT_unique_tyConvT_of_piRow hW hSort hPi hb₁ (.letBinding Γ A u₁ v hΓ hA₁ hv₁) hb₂
      have hcB0 : TyConvT E n Γ (instantiate0 v B₁) (instantiate0 v B₂) := by
        have h0 := tyConvT_substLetS (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW)
          A v hcB (j := 0) List.getElem?_cons_zero
          (by simpa only [substRemove_zero_cons, lift_zero] using hv₁)
        simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0
      exact ⟨.trans Γ (instantiate0 v B₁) (instantiate0 v B₂) T₂ hcB0 hc₂⟩
  | _, _, _, T₂, .lit _ _ _ hexp₁, hΓ, h₂ => by
      obtain ⟨T', hexp₂, hc₂⟩ := hasTyTInv_lit h₂ rfl
      obtain ⟨hc₁⟩ := hasTyT_unique_tyConvT_of_piRow hW hSort hPi hexp₁ hΓ hexp₂
      exact ⟨.trans _ _ T' T₂ hc₁ hc₂⟩
  | Γ, _, _, T₂, .conv _ _ S₁ T₁ u₁ he₁ hc₁, hΓ, h₂ => by
      obtain ⟨hcS⟩ := hasTyT_unique_tyConvT_of_piRow hW hSort hPi he₁ hΓ h₂
      exact ⟨.trans Γ T₁ S₁ T₂ (.symmT (.of Γ S₁ T₁ u₁ hc₁)) hcS⟩

/-- Sort-level uniqueness `eqN u₁ u₂` across ALL expressions `A` under `PiRowField E n`
    (`hasTyT_sort_unique_eqN_of_piRow`). -/
theorem hasTyT_sort_unique_eqN_of_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A : Expr Nat} {u₁ u₂ : Level}
    (h₁ : HasTyT E n Γ A (.sort u₁)) (h₂ : HasTyT E n Γ A (.sort u₂)) :
    eqN u₁ u₂ := by
  obtain ⟨hc⟩ := hasTyT_unique_tyConvT_of_piRow hW hSort hPi h₁ hΓ h₂
  exact hSort hc

/-- Single-link `IsPropTyI` transport along `ConvT E n Γ A B (.sort u)` under `PiRowField E n`
    (`isPropTyI_of_convT_sort_piRow`). -/
theorem isPropTyI_of_convT_sort_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A B : Expr Nat} {u : Level}
    (hc : ConvT E n Γ A B (.sort u)) (hPA : IsPropTyI E n Γ A) :
    IsPropTyI E n Γ B := by
  rcases hPA with ⟨⟨hA0⟩, _⟩
  exact isPropTyI_of_convT_sort_eqN_zero hW hSort hΓ hc
    (hasTyT_sort_unique_eqN_of_piRow hW hSort hPi hΓ (convEnds hW hΓ hc).1 hA0)

/-- Chain `IsPropTyI` transport along `TyConvT E n Γ A A'` under `PiRowField E n`
    (`isPropTyI_tyConvT_of_piRow`). -/
theorem isPropTyI_tyConvT_of_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A A' : Expr Nat}
    (hc : TyConvT E n Γ A A') (hPA : IsPropTyI E n Γ A) :
    IsPropTyI E n Γ A' := by
  induction hc with
  | refl _ => exact hPA
  | of _ _ _ hc => exact isPropTyI_of_convT_sort_piRow hW hSort hPi hΓ hc hPA
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₂ (ih₁ hPA)

/-- **Discharge of `PropTyTransport E n` from `EnvWfT E`, `SortRow`, and `PiRowField E n`
    (`propTyTransport_of_piRow`):** -/
theorem propTyTransport_of_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n) :
    PropTyTransport E n := by
  intro _ hΓ _ _ _ _ hc hPA
  exact isPropTyI_tyConvT_of_piRow hW hSort hPi hΓ hc hPA


/-! ## §20. `TyConvT`-Closed Semantic Proposition-Type Predicate (`IsSemPropTyI`),
`PropTyTransport`-Free `LRTermDSubKClosedCtxSemBi`, and 27-Constructor Reduction Discharging
Both `PiRowField` and `PropTyTransport` -/

/-! ### §20.1. `IsSemPropTyI`: `TyConvT`-Closed Semantic Proposition-Type Predicate Requiring
Zero `PropTyTransport` and Zero `SortRow` for Weakening, Substitution, and Type Conversion -/

/-- **`TyConvT`-Closed Semantic Proposition-Type Predicate (`IsSemPropTyI E n Γ A`):**
    `A` is `TyConvT`-convertible to some proposition `P` with `HasTyT E n Γ P (.sort .zero)`,
    and `A` does not have `.sort` in its `ApproxDIK E (ctxEnvDIK E Γ)` denotation
    (`¬ ApproxDIK E (ctxEnvDIK E Γ) A .sort`).
    Unlike `IsPropTyI`, `IsSemPropTyI` is preserved by:
    - all-cutoff weakening (`isSemPropTyI_weaken`),
    - `let`-substitution (`isSemPropTyI_substLet`, `isSemPropTyI_substLet0`),
    - `⊥`-approximated assumption substitution (`isSemPropTyI_substAssump0`),
    - `CtxConvT` + `SameLetProfile` (`isSemPropTyI_ctx_of_sameLetProfile`), and
    - type conversion `hc : ConvT E n Γ A B (.sort u)` (`isSemPropTyI_tyConv_of_bi`)
    all with **zero `PropTyTransport E n` and zero `SortRow`**! -/
def IsSemPropTyI (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A : Expr Nat) : Prop :=
  (∃ P : Expr Nat, Nonempty (HasTyT E n Γ P (.sort .zero)) ∧ Nonempty (TyConvT E n Γ P A)) ∧
  ¬ ApproxDIK E (ctxEnvDIK E Γ) A .sort

/-- Every sort `.sort u` is excluded from `IsSemPropTyI` with **zero hypotheses and zero axioms**. -/
theorem not_isSemPropTyI_sort (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (u : Level) :
    ¬ IsSemPropTyI E n Γ (.sort u) :=
  fun h => h.2 (.sort (ctxEnvDIK E Γ) u)

/-- Direct introduction of `IsSemPropTyI E n Γ P` from `HasTyT E n Γ P (.sort .zero)` and
    `¬ ApproxDIK E (ctxEnvDIK E Γ) P .sort` (zero `SortRow`). -/
theorem isSemPropTyI_of_hasTyT_sort_zero {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {P : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero)) (hnot : ¬ ApproxDIK E (ctxEnvDIK E Γ) P .sort) :
    IsSemPropTyI E n Γ P :=
  ⟨⟨P, ⟨hP⟩, ⟨.refl Γ P⟩⟩, hnot⟩

/-- A $\Pi$-type `.pi A B` never has `.sort` in `ApproxDIK E ρ` (`approxDIK_pi_not_sort`). -/
theorem approxDIK_pi_not_sort {E : ResolvedEnv} {ρ : EnvI} (A B : Expr Nat) :
    ¬ ApproxDIK E ρ (.pi A B) .sort := by
  intro h
  rcases approxDIK_pi_inv h with h0 | ⟨_, _, h0, _, _⟩ <;> cases h0

/-- Every $\Pi$-proposition (`HasTyT E n Γ (.pi A B) (.sort .zero)`) unconditionally satisfies
    `IsSemPropTyI E n Γ (.pi A B)` with **zero `SortRow`**. -/
theorem isSemPropTyI_pi_of_hasTyT_sort_zero {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {A B : Expr Nat} (hpi : HasTyT E n Γ (.pi A B) (.sort .zero)) :
    IsSemPropTyI E n Γ (.pi A B) :=
  isSemPropTyI_of_hasTyT_sort_zero hpi (approxDIK_pi_not_sort A B)

/-- `idPiProp = .pi (.sort .zero) (.bvar 0)` (`Π (X : Prop), X`) unconditionally satisfies
    `IsSemPropTyI E n Γ idPiProp` in every `E, n, Γ` with **zero hypotheses**. -/
theorem isSemPropTyI_idPiProp (E : ResolvedEnv) (n : Nat) (Γ : LCtx) :
    IsSemPropTyI E n Γ idPiProp :=
  isSemPropTyI_pi_of_hasTyT_sort_zero (hasTyT_idPiProp_ctx E n Γ)

/-- Every non-recursor constant with `m.body = none` (inductive type formers, constructors, axioms)
    has no `.sort` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_rigidConst_not_sort {E : ResolvedEnv} {ρ : EnvI} {r : Nat} {ls : List Level}
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) :
    ¬ ApproxDIK E ρ (.const r ls) .sort := by
  intro h
  rcases approxDIK_rigid_const_inv (rigidConst_of_body_none hm hb hnrec) h with h0 | h0 <;> cases h0

/-- Every spine `foldApps (.const r ls) args` headed by a non-recursor constant with `m.body = none`
    (including all applied inductive propositions `True`, `False`, `And P Q`, `Eq a b`, etc.)
    has no `.sort` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_foldApps_rigidConst_not_sort {E : ResolvedEnv} {ρ : EnvI} {r : Nat}
    {ls : List Level} {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) :
    ∀ (args : List (Expr Nat)), ¬ ApproxDIK E ρ (foldApps (.const r ls) args) .sort
  | [] => approxDIK_rigidConst_not_sort hm hb hnrec
  | a :: args => fun h => by
      have hbot := approxDIK_foldApps_probeCpt_eq_bot_of_no_lam
        (approxDIK_rigidConst_not_lam hm hb hnrec) a args .sort h
      cases hbot

/-- Every applied inductive/axiom proposition `foldApps (.const r ls) args` with `HasTyT ... (.sort .zero)`
    unconditionally satisfies `IsSemPropTyI` with **zero `SortRow`**. -/
theorem isSemPropTyI_foldApps_rigidConst_of_hasTyT_sort_zero {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none) (hnrec : m.mclass ≠ .recursorM)
    {args : List (Expr Nat)}
    (hP : HasTyT E n Γ (foldApps (.const r ls) args) (.sort .zero)) :
    IsSemPropTyI E n Γ (foldApps (.const r ls) args) :=
  isSemPropTyI_of_hasTyT_sort_zero hP (approxDIK_foldApps_rigidConst_not_sort hm hb hnrec args)

/-- Every assumption bound variable (`lookupValue Γ i = none`) has no `.sort` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_bvar_none_not_sort {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (.bvar i) .sort := by
  intro h
  have hbot := approxDIK_ctxEnvDIK_bvar_none_eq_bot hnone h
  cases hbot

/-- Every spine `foldApps (.bvar i) args` headed by an assumption variable (`lookupValue Γ i = none`)
    has no `.sort` compact in `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_foldApps_bvar_none_not_sort {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) :
    ∀ (args : List (Expr Nat)), ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) args) .sort
  | [] => approxDIK_ctxEnvDIK_bvar_none_not_sort hnone
  | a :: args => fun h => by
      have hbot := approxDIK_foldApps_probeCpt_eq_bot_of_no_lam
        (approxDIK_ctxEnvDIK_bvar_none_not_lam hnone) a args .sort h
      cases hbot

/-- Every assumption propositional variable or spine `foldApps (.bvar i) args` with
    `lookupValue Γ i = none` and `HasTyT E n Γ (foldApps (.bvar i) args) (.sort .zero)`
    unconditionally satisfies `IsSemPropTyI` with **zero `SortRow`**. -/
theorem isSemPropTyI_foldApps_bvar_none_of_hasTyT_sort_zero {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i : Nat} (hnone : lookupValue Γ i = none) {args : List (Expr Nat)}
    (hP : HasTyT E n Γ (foldApps (.bvar i) args) (.sort .zero)) :
    IsSemPropTyI E n Γ (foldApps (.bvar i) args) :=
  isSemPropTyI_of_hasTyT_sort_zero hP (approxDIK_foldApps_bvar_none_not_sort hnone args)

/-- **All-Cutoff Weakening of `IsSemPropTyI` (`isSemPropTyI_weaken`):**
    Requires **only** `EnvClosed E` — **zero `PropTyTransport` and zero `SortRow`**! -/
theorem isSemPropTyI_weaken {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} {A : Expr Nat} (d : LocalDecl) {k : Nat} (hk : k ≤ Γ.length)
    (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n (insertAt d k Γ) (lift k 1 A) := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnot⟩
  refine ⟨⟨lift k 1 P, ⟨hasTyTWeaken d hcl (c := k) hP⟩, ⟨tyConvTWeaken d hcl (c := k) hcPA⟩⟩, ?_⟩
  intro hsort
  exact hnot ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk A .sort).mp hsort)

/-- Head weakening (`k = 0`) of `IsSemPropTyI` (`isSemPropTyI_weaken0`, zero `PropTyTransport`,
    zero `SortRow`). -/
theorem isSemPropTyI_weaken0 {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} (d : LocalDecl) {A : Expr Nat} (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n (d :: Γ) (lift 0 1 A) :=
  isSemPropTyI_weaken hcl d (Nat.zero_le _) hPA

/-- **General `let`-Substitution Stability of `IsSemPropTyI` (`isSemPropTyI_substLet`):**
    Requires **only** `EnvClosed E` and `EnvMembersSubstStable E` — **zero `PropTyTransport` and
    zero `SortRow`**! -/
theorem isSemPropTyI_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    {Γ : LCtx} {t v A : Expr Nat} {j : Nat}
    (hget : Γ[j]? = some (.letBinding t v))
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n (substRemove v j Γ) (instantiate j (lift 0 j v) A) := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnot⟩
  have hP' : HasTyT E n (substRemove v j Γ) (instantiate j (lift 0 j v) P) (.sort .zero) := by
    simpa only [instantiate] using hasTyT_substLetS hcl hinst t v hP hget hvty
  have hcPA' : TyConvT E n (substRemove v j Γ)
      (instantiate j (lift 0 j v) P) (instantiate j (lift 0 j v) A) :=
    tyConvT_substLetS hcl hinst t v hcPA hget hvty
  refine ⟨⟨instantiate j (lift 0 j v) P, ⟨hP'⟩, ⟨hcPA'⟩⟩, ?_⟩
  intro hsort
  exact hnot ((approxDIK_ctxEnvDIK_substLet_iff hget A .sort).mp hsort)

/-- Head (`j = 0`) `let`-substitution stability of `IsSemPropTyI` (`isSemPropTyI_substLet0`,
    zero `PropTyTransport`, zero `SortRow`). -/
theorem isSemPropTyI_substLet0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {t v A : Expr Nat} (hvty : HasTyT E n Γ v t)
    (hPA : IsSemPropTyI E n (.letBinding t v :: Γ) A) :
    IsSemPropTyI E n Γ (instantiate0 v A) := by
  have h0 := isSemPropTyI_substLet (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW)
    (Γ := .letBinding t v :: Γ) (j := 0) List.getElem?_cons_zero
    (by simpa only [substRemove_zero_cons, lift_zero] using hvty) hPA
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

/-- Assumption-substitution stability of `IsSemPropTyI` for `⊥`-approximated `v`
    (`isSemPropTyI_substAssump`, zero `PropTyTransport`, zero `SortRow`). -/
theorem isSemPropTyI_substAssump {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E)
    {Γ : LCtx} {t v A : Expr Nat} {j : Nat}
    (hget : Γ[j]? = some (.assumption t))
    (hv : ∀ u, ApproxDIK E (ctxEnvDIK E (substRemove v j Γ)) (lift 0 j v) u → u = .bot)
    (hvty : HasTyT E n (substRemove v j Γ) (lift 0 j v) (lift 0 j t))
    (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n (substRemove v j Γ) (instantiate j (lift 0 j v) A) := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnot⟩
  have hP' : HasTyT E n (substRemove v j Γ) (instantiate j (lift 0 j v) P) (.sort .zero) := by
    simpa only [instantiate] using hasTyT_substS hcl hinst v t hP hget hvty
  have hcPA' : TyConvT E n (substRemove v j Γ)
      (instantiate j (lift 0 j v) P) (instantiate j (lift 0 j v) A) :=
    tyConvT_substS hcl hinst v t hcPA hget hvty
  refine ⟨⟨instantiate j (lift 0 j v) P, ⟨hP'⟩, ⟨hcPA'⟩⟩, ?_⟩
  intro hsort
  exact hnot ((approxDIK_ctxEnvDIK_substAssump_iff hget hv A .sort).mp hsort)

/-- Context-conversion transport of `IsSemPropTyI` along `CtxConvT E n Γ Γ'` and
    `SameLetProfile Γ Γ'` (`isSemPropTyI_ctx_of_sameLetProfile`, zero `PropTyTransport`,
    zero `SortRow`). -/
theorem isSemPropTyI_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {A : Expr Nat} (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n Γ' A := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnot⟩
  refine ⟨⟨P, ⟨hasTyT_ctx hcl hctx hP⟩, ⟨tyConvT_ctx hcl hctx hcPA⟩⟩, ?_⟩
  rw [← hprof.2 E]
  exact hnot

/-- Under `EnvWfT E`, `SortRow`, and `PiRowField E n`, every `IsSemPropTyI E n Γ A` implies
    `IsPropTyI E n Γ A` (`isPropTyI_of_isSemPropTyI_piRow`). -/
theorem isPropTyI_of_isSemPropTyI_piRow {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    (hPi : PiRowField E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A : Expr Nat}
    (hPA : IsSemPropTyI E n Γ A) :
    IsPropTyI E n Γ A := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, _⟩
  exact isPropTyI_tyConvT_of_piRow hW hSort hPi hΓ hcPA (isPropTyI_of_hasTyT_sort_zero hSort hP)

/-! ### §20.2. `PropTyTransport`-Free `LRTermDSubKClosedCtxSemBi` and Unconditional Type-Conversion
Transport (`isSemPropTyI_tyConv_of_bi`, `lrTermDSubKClosedCtxSemBi_tyConv_of_bi`) -/

/-- Top-level `IsSemPropTyI`-collapsed `LRTermDSubKClosedCtxSem`. -/
def LRTermDSubKClosedCtxSem (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (M M' A : Expr Nat) (u : CptI) : Prop :=
  IsSemPropTyI E n Γ A ∨ LRTermDSubKClosedCtxCore E n Γ M M' A u

/-- Bidirectional `ProbeCpt` relation `LRTermDSubKClosedCtxSemBi` over `IsSemPropTyI` and
    `LRTermDSubKClosedCtxCore`. -/
def LRTermDSubKClosedCtxSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (M M' A : Expr Nat) : Prop :=
  ∀ c, ProbeCpt c →
    (ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c) →
    LRTermDSubKClosedCtxSem E n Γ M M' A c

/-- Whenever `IsSemPropTyI E n Γ A` holds, `LRTermDSubKClosedCtxSemBi E n Γ M M' A` holds
    for all `M, M'`. -/
theorem lrTermDSubKClosedCtxSemBi_of_isSemPropTyI {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} (hPA : IsSemPropTyI E n Γ A) :
    LRTermDSubKClosedCtxSemBi E n Γ M M' A :=
  fun _ _ _ => Or.inl hPA

/-- Whenever the `ProbeCpt` compacts of `M` and `M'` in `ApproxDIK E (ctxEnvDIK E Γ)` are
    only `.bot`, `LRTermDSubKClosedCtxSemBi E n Γ M M' T` holds unconditionally for **every**
    type `T : Expr Nat` with **zero `IsSemPropTyI` and zero `PropTyTransport`**. -/
theorem lrTermDSubKClosedCtxSemBi_of_probeCpt_eq_bot {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' : Expr Nat} (T : Expr Nat)
    (hM : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M c → c = .bot)
    (hM' : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M' c → c = .bot) :
    LRTermDSubKClosedCtxSemBi E n Γ M M' T := by
  intro c hc hor
  have hc_bot : c = .bot := hor.elim (hM c hc) (hM' c hc)
  subst hc_bot
  exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)

/-- **Unconditional `IsSemPropTyI` Transport Across `ConvT E n Γ A B (.sort u)` Using Only `ih_AB`
    (`isSemPropTyI_tyConv_of_bi`):**
    Requires **only** `EnvWfT E`, `hc : TyConvT E n Γ A B`, and
    `ih_AB : LRTermDSubKClosedCtxSemBi E n Γ A B (.sort u)` — with **zero `PropTyTransport`**,
    **zero `PiRowField`**, and **zero `SortRow`**! -/
theorem isSemPropTyI_tyConv_of_bi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A B : Expr Nat} {u : Level}
    (hcAB : TyConvT E n Γ A B)
    (ih_AB : LRTermDSubKClosedCtxSemBi E n Γ A B (.sort u))
    (hPA : IsSemPropTyI E n Γ A) :
    IsSemPropTyI E n Γ B := by
  rcases hPA with ⟨⟨P, ⟨hP⟩, ⟨hcPA⟩⟩, hnotA⟩
  refine ⟨⟨P, ⟨hP⟩, ⟨.trans Γ P A B hcPA hcAB⟩⟩, ?_⟩
  intro hBs
  rcases ih_AB .sort .sort (Or.inr hBs) with hPs | hCs
  · exact not_isSemPropTyI_sort E n Γ u hPs
  · obtain ⟨_, hABs⟩ :=
      (lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort (by intro h0; cases h0)).mp hCs
    cases hABs with
    | sort hAs _ =>
        exact hnotA (approxDIK_ctxEnvDIK_sort_of_whRedPiKClosedCtx hW hAs)

/-- **Unconditional `LRTermDSubKClosedCtxSemBi` Type-Conversion Transport (`HasTyT.conv` / `ConvT.tyConv`)
    Requiring Zero `PropTyTransport` and Zero `SortRow` (`lrTermDSubKClosedCtxSemBi_tyConv_of_bi`):** -/
theorem lrTermDSubKClosedCtxSemBi_tyConv_of_bi {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {M M' A B : Expr Nat} {u : Level}
    (hcAB : TyConvT E n Γ A B)
    (ih_M : LRTermDSubKClosedCtxSemBi E n Γ M M' A)
    (ih_AB : LRTermDSubKClosedCtxSemBi E n Γ A B (.sort u)) :
    LRTermDSubKClosedCtxSemBi E n Γ M M' B := by
  intro c hc hor
  rcases ih_M c hc hor with hPA | hC
  · exact Or.inl (isSemPropTyI_tyConv_of_bi hW hcAB ih_AB hPA)
  · refine Or.inr ?_
    cases hc with
    | bot => rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial
    | sort =>
        rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort (by intro h0; cases h0)] at hC ⊢
        obtain ⟨⟨l, hl⟩, hlr⟩ := hC
        have hAs : ApproxDIK E (ctxEnvDIK E Γ) A .sort :=
          approxDIK_ctxEnvDIK_sort_of_whRedPiKClosedCtx hW hl
        rcases ih_AB .sort .sort (Or.inl hAs) with hPs | hCs
        · exact (not_isSemPropTyI_sort E n Γ u hPs).elim
        · obtain ⟨_, hABs⟩ :=
            (lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort (by intro h0; cases h0)).mp hCs
          cases hABs with
          | sort _ hBs => exact ⟨⟨_, hBs⟩, hlr⟩
    | piBotNil =>
        rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil (by intro h0; cases h0)] at hC ⊢
        obtain ⟨⟨l, hl⟩, hlr⟩ := hC
        have hAs : ApproxDIK E (ctxEnvDIK E Γ) A .sort :=
          approxDIK_ctxEnvDIK_sort_of_whRedPiKClosedCtx hW hl
        rcases ih_AB .sort .sort (Or.inl hAs) with hPs | hCs
        · exact (not_isSemPropTyI_sort E n Γ u hPs).elim
        · obtain ⟨_, hABs⟩ :=
