/-- Two-sided off-diagonal `ConvT.app` congruence in `LRTermMajSemBi` from `Subst0CongrSupplyMajSemBi`
    and the left application diagonal `ih_app₁` (`lrTermMajSemBi_app_congr_of_subst0Congr`). -/
theorem lrTermMajSemBi_app_congr_of_subst0Congr {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ a₁ a₂ A B : Expr Nat}
    (hf₁ : HasTyT E n Γ f₁ (.pi A B)) (hf₂ : HasTyT E n Γ f₂ (.pi A B))
    (ha₁ : HasTyT E n Γ a₁ A) (ha₂ : HasTyT E n Γ a₂ A)
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B)) (hca : ConvT E n Γ a₁ a₂ A)
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a₁ a₂ A)
    (ih_app₁ : LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₁ a₁) (instantiate0 a₁ B)) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B) := by
  have hcancel : instantiate0 f₁ (lift 0 1 (instantiate0 a₁ B)) = instantiate0 a₁ B :=
    (instantiate_lift_cancel 1 0 0 f₁ (Nat.le_refl 0) Nat.zero_lt_one (instantiate0 a₁ B)).trans
      (lift_zero 0 (instantiate0 a₁ B))
  have ih_fn_diag : LRTermMajSemBi E n Γ
      (instantiate0 f₁ (.app (.bvar 0) (lift 0 1 a₁)))
      (instantiate0 f₁ (.app (.bvar 0) (lift 0 1 a₁)))
      (instantiate0 f₁ (lift 0 1 (instantiate0 a₁ B))) := by
    simpa only [instantiate0_app_bvar0_lift0 f₁ a₁, hcancel] using ih_app₁
  have h_fn0 := hSubst0 hΓ hf₁ hf₂ hcf ih_f ih_fn_diag
  rw [instantiate0_app_bvar0_lift0 f₁ a₁, instantiate0_app_bvar0_lift0 f₂ a₁, hcancel] at h_fn0
  have ih_app₂₁ : LRTermMajSemBi E n Γ (.app f₂ a₁) (.app f₂ a₁) (instantiate0 a₁ B) :=
    lrTermMajSemBi_trans hW hΓ (lrTermMajSemBi_symm hW hΓ h_fn0) h_fn0
  have ih_arg_diag : LRTermMajSemBi E n Γ
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ B) := by
    simpa only [instantiate0_app_lift0_bvar0_arg f₂ a₁] using ih_app₂₁
  have h_arg0 := hSubst0 hΓ ha₁ ha₂ hca ih_a ih_arg_diag
  rw [instantiate0_app_lift0_bvar0_arg f₂ a₁, instantiate0_app_lift0_bvar0_arg f₂ a₂] at h_arg0
  exact lrTermMajSemBi_trans hW hΓ h_fn0 h_arg0

/-- `ConvT.irr` in `LRTermMajSemBi` from `WhRedPiKClosedCtxMajNormalizes E Γ P` and
    `∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)` (`lrTermMajSemBi_irr_of_normalizes_and_no_whRed_sort`). -/
theorem lrTermMajSemBi_irr_of_normalizes_and_no_whRed_sort {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {P : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero))
    (hnormP : WhRedPiKClosedCtxMajNormalizes E Γ P)
    (hnw : ∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l))
    (p q : Expr Nat) :
    LRTermMajSemBi E n Γ p q P := by
  obtain ⟨nf, hred, hnf⟩ := hnormP
  refine lrTermMajSemBi_of_isSemPropTyI ⟨⟨P, ⟨hP⟩, ⟨.refl Γ P⟩⟩, fun hPs => ?_⟩
  obtain ⟨l, hred_l⟩ := (approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred hnf).mp hPs
  exact hnw l hred_l

/-- Fundamental-property target for `LRTermMajSemBi` (`FundamentalTermMajSemBiProbe`). -/
def FundamentalTermMajSemBiProbe (E : ResolvedEnv) (n : Nat) : Prop :=
  (∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M A : Expr Nat}, HasTyT E n Γ M A → LRTermMajSemBi E n Γ M M A) ∧
  (∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M M' A : Expr Nat},
      HasTyT E n Γ M A → HasTyT E n Γ M' A → ConvT E n Γ M M' A →
      LRTermMajSemBi E n Γ M M' A)

/-- **Direct Projection from `FundamentalTermMajSemBiProbe E n` to `PiRowField E n`
    (`piRow_of_fundamentalTermMajSemBiProbe`):** -/
theorem piRow_of_fundamentalTermMajSemBiProbe {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hF : FundamentalTermMajSemBiProbe E n) :
    PiRowField E n := by
  intro Γ hΓ A₁ B₁ A₂ B₂ h
  have hwalk : ∀ {X Y : Expr Nat} {u : Level},
      HasTyT E n Γ X (.sort u) → TyConvT E n Γ X Y →
      ApproxDIK E (ctxEnvDIK E Γ) X (.pi .bot []) →
      LRProbeTypePiKClosedCtxMaj E n Γ X Y (.pi .bot []) := by
    intro X Y u hX htc
    revert u
    induction htc with
    | refl X =>
        intro u hX hAc
        rcases hF.1 hΓ hX (.pi .bot []) .piBotNil (Or.inl hAc) with hPs | hpiS | hlr
        · exact (not_isSemPropTyI_sort E n Γ u hPs).elim
        · exact (approxDIK_sort_not_pi u .bot [] hpiS).elim
        · exact hlr
    | of X Y v hc =>
        intro _ _ hAc
        rcases hF.2 hΓ (convEnds hW hΓ hc).1 (convEnds hW hΓ hc).2.1 hc
            (.pi .bot []) .piBotNil (Or.inl hAc) with hPs | hpiS | hlr
        · exact (not_isSemPropTyI_sort E n Γ v hPs).elim
        · exact (approxDIK_sort_not_pi v .bot [] hpiS).elim
        · exact hlr
    | trans X M Y c₁ c₂ ih₁ ih₂ =>
        intro u hX hAc
        obtain ⟨v, hM⟩ := tyConvT_endTyped hW hΓ c₁ hX
        have r₁ := ih₁ hX hAc
        have hcM := (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW r₁).2
        exact lrProbeTypePiKClosedCtxMaj_trans hW hΓ r₁ (ih₂ hM hcM)
  rcases tyConvT_firstOf_data h with heq | ⟨_, u, hc₀, _⟩
  · injection heq with eA eB
    subst eA; subst eB
    exact ⟨⟨.refl _ _⟩, ⟨.refl _ _⟩⟩
  · have hpi : HasTyT E n Γ (.pi A₁ B₁) (.sort u) := (convEnds hW hΓ hc₀).1
    have hlr := hwalk hpi h (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A₁ B₁)
    cases hlr with
    | pi hA hB hdom hcod =>
        have e₁ := whRedPiKClosedCtxMaj_pi_eq hA
        have e₂ := whRedPiKClosedCtxMaj_pi_eq hB
        injection e₁ with eA₁ eB₁
        injection e₂ with eA₂ eB₂
        subst eA₁; subst eB₁; subst eA₂; subst eB₂
        exact ⟨⟨hdom⟩, ⟨hcod⟩⟩

private theorem fundMajSemBiProbe_convT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hNorm : TypedWhNormalizesMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    {Γ : LCtx} → {M M' A : Expr Nat} → ConvT E n Γ M M' A →
      CtxWfT E n Γ → LRTermMajSemBi E n Γ M M' A
  | _, _, _, _, .refl _ _ A he, hΓ =>
      lrTermMajSemBi_diag_of_normalizes hW A (hNorm hΓ he)
  | _, _, _, _, .symm _ _ _ _ h, hΓ =>
      lrTermMajSemBi_symm hW hΓ (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr h hΓ)
  | _, _, _, _, .trans _ _ _ _ _ h₁ h₂, hΓ =>
      lrTermMajSemBi_trans hW hΓ
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr h₁ hΓ)
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr h₂ hΓ)
  | _, _, _, _, .beta Γ₀ A body arg B u hA hbody harg, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 arg body) (instantiate0 arg B) :=
        (convEnds hW hΓ (.beta Γ₀ A body arg B u hA hbody harg)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.beta A body arg))
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hR))
  | _, _, _, _, .zeta Γ₀ A v b B u hA hv hb, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 v b) (instantiate0 v B) :=
        (convEnds hW hΓ (.zeta Γ₀ A v b B u hA hv hb)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.zeta A v b))
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hR))
  | _, _, _, _, .zetaLocal _ _ _ _ hval _ hv, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.zetaLocal hval)
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hv))
  | _, _, _, _, .delta _ _ _ _ _ hres hbody _ _ _ hb, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.delta hres hbody))
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hb))
  | _, _, _, _, .iota _ _ _ _ hI _ hrhs, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW
        (.of_whStep (.iota (derivedIotaU_ofDerivedIota hI)))
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hrhs))
  | _, _, _, _, .lit _ t _ _ hlit hexp, hΓ => by
      cases hlit
      exact lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.lit t))
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hexp))
  | _, _, _, _, .app Γ₀ f₁ f₂ a₁ a₂ A B hcf hca, hΓ =>
      have endsf := convEnds hW hΓ hcf
      have endsa := convEnds hW hΓ hca
      have happ₁ : HasTyT E n Γ₀ (.app f₁ a₁) (instantiate0 a₁ B) :=
        .app Γ₀ f₁ a₁ A B endsf.1 endsa.1
      lrTermMajSemBi_app_congr_of_subst0Congr hW hSubst0 hΓ
        endsf.1 endsf.2.1 endsa.1 endsa.2.1 hcf hca
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hcf hΓ)
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hca hΓ)
        (lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ happ₁))
  | _, _, _, _, .lam _ A₁ A₂ b₁ b₂ B _ _ _, _ =>
      lrTermMajSemBi_lam A₁ A₂ b₁ b₂ (.pi A₁ B)
  | _, _, _, _, .pi Γ₀ A₁ A₂ B₁ B₂ u v hcA hcB, _ =>
      lrTermMajSemBi_pi (.sort (.imax u v)) (.of Γ₀ A₁ A₂ u hcA) (.of _ B₁ B₂ v hcB)
  | _, _, _, _, .letE Γ₀ A₁ A₂ v₁ v₂ b₁ b₂ B u hcA hcv hcb, hΓ =>
      have endsA := convEnds hW hΓ hcA
      have endsv := convEnds hW hΓ hcv
      have hΓ_let₁ : CtxWfT E n (.letBinding A₁ v₁ :: Γ₀) :=
        .letBinding Γ₀ A₁ u v₁ hΓ endsA.1 endsv.1
      have h_inst_b : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₁) (instantiate0 v₁ b₂)
          (instantiate0 v₁ B) :=
        lrTermMajSemBi_substLet0 hW endsv.1
          (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hcb hΓ_let₁)
      have ih_inst_b₂ : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₂) (instantiate0 v₁ b₂)
          (instantiate0 v₁ B) :=
        lrTermMajSemBi_trans hW hΓ (lrTermMajSemBi_symm hW hΓ h_inst_b) h_inst_b
      have h_inst_v : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₂) (instantiate0 v₂ b₂)
          (instantiate0 v₁ B) :=
        hSubst0 hΓ endsv.1 endsv.2.1 hcv
          (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hcv hΓ) ih_inst_b₂
      have hL : WhRedPiKClosedCtxMaj E Γ₀ (.letE A₁ v₁ b₁) (instantiate0 v₁ b₁) :=
        .step (.of_whStep (.zeta A₁ v₁ b₁)) (.refl _)
      have hR : WhRedPiKClosedCtxMaj E Γ₀ (.letE A₂ v₂ b₂) (instantiate0 v₂ b₂) :=
        .step (.of_whStep (.zeta A₂ v₂ b₂)) (.refl _)
      lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hL hR
        (lrTermMajSemBi_trans hW hΓ h_inst_b h_inst_v)
  | _, _, _, _, .sorts _ _ _ _, _ =>
      lrTermMajSemBi_sorts _
  | _, _, _, _, .consts Γ₀ r ls₁ ls₂ m hm hlen hwf₁ _ heq, hΓ => by
      cases hb : m.body with
      | none => exact lrTermMajSemBi_consts_of_body_none ls₁ ls₂ _ hm hb
      | some b =>
          have har : m.arity = 0 := envWfT_body_arity_zero hW r m b hm hb
          have hls₁ : ls₁ = [] := List.eq_nil_of_length_eq_zero (hlen.trans har)
          subst hls₁
          have hls₂ : ls₂ = [] := by
            cases ls₂ with
            | nil => rfl
            | cons _ _ => exact False.elim heq
          subst hls₂
          have hconst : HasTyT E n Γ₀ (.const r []) (instantiateLevels [] m.mtype) :=
            .const Γ₀ r [] m hm hlen hwf₁
          exact lrTermMajSemBi_diag_of_normalizes hW _ (hNorm hΓ hconst)
  | _, _, _, _, .eta Γ₀ f A B _, _ =>
      lrTermMajSemBi_eta Γ₀ A B f
  | _, _, _, _, .irr _ P p q hP _ _, hΓ =>
      lrTermMajSemBi_irr_of_normalizes_and_no_whRed_sort hW hP (hNorm hΓ hP) (hIrr hΓ hP) p q
  | _, _, _, _, .tyConv Γ₀ _ _ A A' u hc hA, hΓ =>
      lrTermMajSemBi_tyConv_of_bi hW (.of Γ₀ A A' u hA)
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hc hΓ)
        (fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hA hΓ)

/-- **Standalone Non-Mutual 27-Constructor Fundamental Theorem Reduction in `LRTermMajSemBi`
    (`fundamentalTermMajSemBiProbe_of_normalizes_and_subst0`):**
    Because `lrTermMajSemBi_diag_of_normalizes` discharges all 9 `HasTyT` constructors (and every
    diagonal in `ConvT.refl`, `ConvT.beta`, `ConvT.zeta`, `ConvT.zetaLocal`, `ConvT.delta`,
    `ConvT.iota`, `ConvT.lit`, `ConvT.consts`, and `ConvT.app`) directly from `TypedWhNormalizesMaj E n`
    without calling `ConvT`, the entire 27-constructor induction decouples into a 1-line `HasTyT`
    proof and a standalone non-mutual induction on `ConvT` requiring **zero `CtxRefines`, zero
    `CtxBVarOKSem`, zero `LRPiWf2`, zero `PropTyTransport`, zero `SortRow`, zero `DeltaConst`
    supply, and zero `AppDiag` supply**! -/
theorem fundamentalTermMajSemBiProbe_of_normalizes_and_subst0 {E : ResolvedEnv} {n : Nat}
