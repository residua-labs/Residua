/-- Left endpoint diagonal extraction for `LRProbeTypePiKClosedCtxMaj` requiring **zero `EnvWfT`**
    and **zero `CtxWfT`** (`lrProbeTypePiKClosedCtxMaj_diag_left`). -/
theorem lrProbeTypePiKClosedCtxMaj_diag_left {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {X Y : Expr Nat} {c : CptI}
    (h : LRProbeTypePiKClosedCtxMaj E n Γ X Y c) :
    LRProbeTypePiKClosedCtxMaj E n Γ X X c := by
  cases h with
  | bot => exact .bot Γ X X
  | sort hX _ => exact .sort hX hX
  | @pi A₁ B₁ _ _ hX _ _ _ => exact .pi hX hX (.refl _ A₁) (.refl _ B₁)

/-- Right endpoint diagonal extraction for `LRProbeTypePiKClosedCtxMaj` requiring **zero `EnvWfT`**
    and **zero `CtxWfT`** (`lrProbeTypePiKClosedCtxMaj_diag_right`). -/
