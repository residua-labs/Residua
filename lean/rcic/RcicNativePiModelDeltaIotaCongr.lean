variable {E : ResolvedEnv} {n : Nat}

private theorem list_eq_nil_or_snoc {α : Type _} :
    ∀ (xs : List α), xs = [] ∨ ∃ pre x, xs = pre ++ [x]
  | [] => Or.inl rfl
  | x :: xs => by
      rcases list_eq_nil_or_snoc xs with rfl | ⟨pre, y, rfl⟩
      · exact Or.inr ⟨[], x, rfl⟩
      · exact Or.inr ⟨x :: pre, y, rfl⟩

/-! ## §13. `WhStepPiKClosedCtx` / `WhRedPiKClosedCtx` Let-Binding Dichotomy & 3-Way Instantiated
Reduction Trichotomy, Depth-2 $\Pi$-Well-Formedness (`LRPiWf2`), and Full 0-Instantiation
Congruence Across All 3 Probes `{.bot, .sort, .pi .bot []}` for Non-`.lam` Arguments -/

/-! ### §13.1. `WhStepPiKClosedCtx` / `WhRedPiKClosedCtx` Let-Binding Dichotomy and 3-Way
Instantiated Reduction Trichotomy Under `PrunedSemEqDIK` -/

/-- **Single-Step `letBinding` Dichotomy for `WhStepPiKClosedCtx` Under `PrunedSemEqDIK`
    (`whStepPiKClosedCtx_letBinding_dichotomy`):**
    Because `approxDIK_ctxEnvDIK_letBinding_iff_of_prunedSemEqDIK` and `approxDIK_ctxEnvDIK_prunePiCpt`
    preserve the non-constructor-headedness guard of `WhStepPiKClosedCtx.iotaKClosedCtx` between
    `.letBinding A₁ v₁ :: Γ` and `.letBinding A₂ v₂ :: Γ` whenever `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂`,
    any step `WhStepPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) a b` either:
    1. takes the **exact same step** `WhStepPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) a b`, OR
    2. has `.bvar 0` at the head of `a` (`∃ args, a = foldApps (.bvar 0) args`, where `zetaLocal`
       unfolds `.bvar 0`)! -/
theorem whStepPiKClosedCtx_letBinding_dichotomy {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    {a b : Expr Nat}
    (hs : WhStepPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) a b) :
    WhStepPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) a b ∨
      ∃ args : List (Expr Nat), a = foldApps (.bvar 0) args := by
  induction hs with
  | of_whStep hs₀ =>
      exact Or.inl (.of_whStep hs₀)
  | @zetaLocal i val hval =>
      cases i with
      | zero => exact Or.inr ⟨[], rfl⟩
      | succ k => exact Or.inl (.zetaLocal hval)
  | iotaKClosedCtx w x hk hflds hx =>
      refine Or.inl (.iotaKClosedCtx w x hk hflds (fun args h₂ => ?_))
      have h₂_p : ApproxDIK E (ctxEnvDIK E (.letBinding A₂ v₂ :: Γ)) x
          (.spine w.ctorRef (prunePiList args)) := by
        simpa only [prunePiCpt_spine] using approxDIK_ctxEnvDIK_prunePiCpt h₂
      have hc_p : PrunedPiCpt (.spine w.ctorRef (prunePiList args)) := by
        simpa only [prunePiCpt_spine] using prunedPiCpt_prunePiCpt (.spine w.ctorRef args)
      exact hx (prunePiList args)
        ((approxDIK_ctxEnvDIK_letBinding_iff_of_prunedSemEqDIK A₁ A₂ hv x hc_p).mpr h₂_p)
  | @appHead f f' arg _ ih =>
      rcases ih with hs₂ | ⟨args, rfl⟩
      · exact Or.inl (.appHead hs₂)
      · exact Or.inr ⟨args ++ [arg], by rw [foldApps_snoc]⟩

/-- For any expression `a` not headed by `.bvar 0` (`∀ args, a ≠ foldApps (.bvar 0) args`),
    `WhStepPiKClosedCtx` is two-way invariant (`↔`) between `.letBinding A₁ v₁ :: Γ` and
    `.letBinding A₂ v₂ :: Γ` under `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂`. -/
theorem whStepPiKClosedCtx_letBinding_iff_of_ne_foldApps_bvar0 {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    {a b : Expr Nat} (hne : ∀ args : List (Expr Nat), a ≠ foldApps (.bvar 0) args) :
    WhStepPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) a b ↔
      WhStepPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) a b :=
  ⟨fun hs => (whStepPiKClosedCtx_letBinding_dichotomy A₁ A₂ hv hs).elim id
      (fun ⟨args, heq⟩ => (hne args heq).elim),
   fun hs => (whStepPiKClosedCtx_letBinding_dichotomy A₂ A₁ (prunedSemEqDIK_symm hv) hs).elim id
      (fun ⟨args, heq⟩ => (hne args heq).elim)⟩

/-- **Multi-Step `letBinding` Dichotomy for `WhRedPiKClosedCtx` Under `PrunedSemEqDIK`
    (`whRedPiKClosedCtx_letBinding_dichotomy`):**
    Given `WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b c` and `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂`,
    either:
    1. `b` weak-head reduces in `.letBinding A₂ v₂ :: Γ` to the **exact same target `c`**, OR
    2. `b` weak-head reduces in **both** `.letBinding A₁ v₁ :: Γ` and `.letBinding A₂ v₂ :: Γ` to a
       shared `.bvar 0`-headed spine `foldApps (.bvar 0) args` before `.bvar 0` is unfolded! -/
theorem whRedPiKClosedCtx_letBinding_dichotomy {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b c) :
    WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b c ∨
      ∃ args : List (Expr Nat),
        WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b (foldApps (.bvar 0) args) ∧
        WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b (foldApps (.bvar 0) args) ∧
        WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) (foldApps (.bvar 0) args) c := by
  induction hred with
  | refl a =>
      exact Or.inl (.refl a)
  | @step a m c hs hrest ih =>
      rcases whStepPiKClosedCtx_letBinding_dichotomy A₁ A₂ hv hs with hs₂ | ⟨args, rfl⟩
      · rcases ih with hrest₂ | ⟨args, hm₁, hm₂, hrem⟩
        · exact Or.inl (.step hs₂ hrest₂)
        · exact Or.inr ⟨args, .step hs hm₁, .step hs₂ hm₂, hrem⟩
      · exact Or.inr ⟨args, .refl _, .refl _, .step hs hrest⟩

/-- Instantiation commutes with `foldApps` across any argument list `args`. -/
theorem instantiate_foldApps (k : Nat) (v f : Expr Nat) :
    ∀ (args : List (Expr Nat)),
      instantiate k v (foldApps f args) = foldApps (instantiate k v f) (args.map (instantiate k v))
  | [] => rfl
  | a :: args => instantiate_foldApps k v (.app f a) args

/-- 0-instantiation of `foldApps (.bvar 0) args` by `v` equals `foldApps v (args.map (instantiate0 v))`. -/
theorem instantiate0_foldApps_bvar0 (v : Expr Nat) (args : List (Expr Nat)) :
    instantiate0 v (foldApps (.bvar 0) args) = foldApps v (args.map (instantiate0 v)) :=
  instantiate_foldApps 0 v (.bvar 0) args

/-- **3-Way Instantiated Reduction Trichotomy Under `PrunedSemEqDIK`
    (`whRedPiKClosedCtx_substLet0_trichotomy`):**
    Combining `whRedPiKClosedCtx_letBinding_dichotomy` with `whRedPiKClosedCtx_substLet0_of_envClosed`
    splits any reduction `WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b c` under
    `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂` into three explicit branches in `Γ`:
    1. **Shared target `c`:** `instantiate0 v₁ b ↠wh instantiate0 v₁ c` AND
       `instantiate0 v₂ b ↠wh instantiate0 v₂ c`,
    2. **Direct reduction through `.bvar 0` (`args = []`):** `instantiate0 v₁ b ↠wh v₁` AND
       `instantiate0 v₂ b ↠wh v₂`,
    3. **Applied reduction through `foldApps (.bvar 0) (arg₀ :: rest)`:**
       `instantiate0 v₁ b ↠wh foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))` AND
       `instantiate0 v₂ b ↠wh foldApps v₂ (instantiate0 v₂ arg₀ :: rest.map (instantiate0 v₂))`. -/
theorem whRedPiKClosedCtx_substLet0_trichotomy {E : ResolvedEnv} (hcl : EnvClosed E) {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b c) :
    (WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b c ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (instantiate0 v₁ c) ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (instantiate0 v₂ c)) ∨
    (WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) v₁ ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) v₂) ∨
    (∃ (arg₀ : Expr Nat) (rest : List (Expr Nat)),
      WhRedPiKClosedCtx E Γ (instantiate0 v₁ b)
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₂ b)
        (foldApps v₂ (instantiate0 v₂ arg₀ :: rest.map (instantiate0 v₂)))) := by
  rcases whRedPiKClosedCtx_letBinding_dichotomy A₁ A₂ hv hred with hred₂ | ⟨args, hm₁, hm₂, _⟩
  · exact Or.inl ⟨hred₂,
      whRedPiKClosedCtx_substLet0_of_envClosed hcl A₁ v₁ hred,
      whRedPiKClosedCtx_substLet0_of_envClosed hcl A₂ v₂ hred₂⟩
  · have hsub₁ := whRedPiKClosedCtx_substLet0_of_envClosed hcl A₁ v₁ hm₁
    have hsub₂ := whRedPiKClosedCtx_substLet0_of_envClosed hcl A₂ v₂ hm₂
    rw [instantiate0_foldApps_bvar0] at hsub₁ hsub₂
    cases args with
    | nil =>
        exact Or.inr (Or.inl ⟨hm₁, hm₂, hsub₁, hsub₂⟩)
    | cons arg₀ rest =>
        exact Or.inr (Or.inr ⟨arg₀, rest, hsub₁, hsub₂⟩)

/-- **2-Way Instantiated Reduction Dichotomy for Non-`.lam` Arguments on Non-`⊥` Probes
    (`whRedPiKClosedCtx_substLet0_dichotomy_of_no_lam`):**
    When `v₁` has no `.lam g` compact in `ApproxDIK E (ctxEnvDIK E Γ)` and `instantiate0 v₁ b` has
    some non-`⊥` `ProbeCpt` compact `c₀ ∈ {.sort, .pi .bot []}`, Branch 3 of
    `whRedPiKClosedCtx_substLet0_trichotomy` is **impossible** (by `semEqDIK_ctxEnvDIK_whRedPiKClosedCtx` +
    `approxDIK_foldApps_probeCpt_eq_bot_of_no_lam`), leaving only Branch 1 (shared target `c`) or
    Branch 2 (direct reduction to `v₁` and `v₂`)! -/
theorem whRedPiKClosedCtx_substLet0_dichotomy_of_no_lam {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b c)
    {c₀ : CptI} (hc₀ : ProbeCpt c₀) (hne : c₀ ≠ .bot)
    (happrox : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c₀) :
    (WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b c ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (instantiate0 v₁ c) ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (instantiate0 v₂ c)) ∨
    (WhRedPiKClosedCtx E (.letBinding A₁ v₁ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtx E (.letBinding A₂ v₂ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) v₁ ∧
      WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) v₂) := by
  have hcl := envClosed_of_envWfT hW
  rcases whRedPiKClosedCtx_substLet0_trichotomy hcl A₁ A₂ hv hred with
    hbranch1 | hbranch2 | ⟨arg₀, rest, hsub₁, _⟩
  · exact Or.inl hbranch1
  · exact Or.inr hbranch2
  · have hsp : ApproxDIK E (ctxEnvDIK E Γ)
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) c₀ :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hsub₁ c₀).mp happrox
    exact (hne (approxDIK_foldApps_probeCpt_eq_bot_of_no_lam hv_nolam
      (instantiate0 v₁ arg₀) (rest.map (instantiate0 v₁)) hc₀ hsp)).elim

/-! ### §13.2. Depth-2 $\Pi$-Well-Formedness (`LRPiWf2`) and Two-Way Invariance Under
`WhRedPiKClosedCtx` -/

/-- **Depth-2 $\Pi$-Well-Formedness (`LRPiWf2 E n Γ M`):**
    Whenever `M` weak-head reduces in `WhRedPiKClosedCtx E Γ` to `.pi D₁ D₂`, both the domain `D₁`
    (in `Γ`) and the codomain `D₂` (in `.assumption D₁ :: Γ`) are sort-typed in `HasTyT`.
    Because `LRPiWf2` is defined on `WhRedPiKClosedCtx`-reducts, it is two-way invariant (`↔`)
    under `WhRedPiKClosedCtx` without requiring post-hoc subject reduction for `WhRedPiKClosedCtx`! -/
def LRPiWf2 (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M : Expr Nat) : Prop :=
  ∀ D₁ D₂, WhRedPiKClosedCtx E Γ M (.pi D₁ D₂) →
    ∃ u₁ u₂, Nonempty (HasTyT E n Γ D₁ (.sort u₁)) ∧
      Nonempty (HasTyT E n (.assumption D₁ :: Γ) D₂ (.sort u₂))

/-- Every well-typed $\Pi$-type `.pi A B` satisfies `LRPiWf2` at birth. -/
theorem lrPiWf2_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat} {u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u₁))
    (hB : HasTyT E n (.assumption A :: Γ) B (.sort u₂)) :
    LRPiWf2 E n Γ (.pi A B) := by
  intro D₁ D₂ hred
  have heq := whRedPiKClosedCtx_pi_eq hred
  injection heq with e₁ e₂
  subst e₁; subst e₂
  exact ⟨u₁, u₂, ⟨hA⟩, ⟨hB⟩⟩

/-- Every sort `.sort l` satisfies `LRPiWf2` vacuously. -/
theorem lrPiWf2_sort (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (l : Level) :
    LRPiWf2 E n Γ (.sort l) := by
  intro D₁ D₂ hred
  exact Expr.noConfusion (whRedPiKClosedCtx_sort_eq hred)

/-- Every $\lambda$-abstraction `.lam A b` satisfies `LRPiWf2` vacuously. -/
theorem lrPiWf2_lam (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A b : Expr Nat) :
    LRPiWf2 E n Γ (.lam A b) := by
  intro D₁ D₂ hred
  exact Expr.noConfusion (whRedPiKClosedCtx_of_normal (whNormalPiKClosedCtx_lam E Γ A b) hred)

/-- Any expression `M` that does not have `.pi .bot []` in `ApproxDIK E (ctxEnvDIK E Γ)` satisfies
    `LRPiWf2 E n Γ M` vacuously under `EnvWfT E`. -/
theorem lrPiWf2_of_no_pi_approx {E : ResolvedEnv} (hW : EnvWfT E) (n : Nat) {Γ : LCtx}
    {M : Expr Nat} (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) M (.pi .bot [])) :
    LRPiWf2 E n Γ M := by
  intro D₁ D₂ hred
  have hpi : ApproxDIK E (ctxEnvDIK E Γ) (.pi D₁ D₂) (.pi .bot []) :=
    .pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim)
  exact (hnopi (approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW hred hpi)).elim

/-- **Two-Way Weak-Head Reduction Equivalence (`↔`) of `LRPiWf2` (`lrPiWf2_whRedPiKClosedCtx_iff`):**
    By `whRedPiKClosedCtx_pi_iff_of_whRed`, `LRPiWf2` is two-way invariant (`↔`) under
    `WhRedPiKClosedCtx E Γ M X`, automatically propagating across `.beta`, `.zeta`, `.zetaLocal`,
    `.delta`, `.iota`, `.lit`, `.iotaKClosedCtx`, and `.letE`! -/
theorem lrPiWf2_whRedPiKClosedCtx_iff {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {M X : Expr Nat} (hMX : WhRedPiKClosedCtx E Γ M X) :
    LRPiWf2 E n Γ M ↔ LRPiWf2 E n Γ X :=
  ⟨fun hM D₁ D₂ hX => hM D₁ D₂ ((whRedPiKClosedCtx_pi_iff_of_whRed hW hMX D₁ D₂).mpr hX),
   fun hX D₁ D₂ hM => hX D₁ D₂ ((whRedPiKClosedCtx_pi_iff_of_whRed hW hMX D₁ D₂).mp hM)⟩

theorem lrPiWf2_of_whStepPiKClosedCtx {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {M X : Expr Nat} (hs : WhStepPiKClosedCtx E Γ M X) (hX : LRPiWf2 E n Γ X) :
    LRPiWf2 E n Γ M :=
  (lrPiWf2_whRedPiKClosedCtx_iff hW (.step hs (.refl _))).mpr hX

/-! ### §13.3. Full 0-Instantiation Congruence Across All 3 Probes `{.bot, .sort, .pi .bot []}`
for Non-`.lam` `PrunedSemEqDIK`-Equal Arguments (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam`,
`lrTermDSubKClosedCtxBi_subst0_pi_arg_all`, `lrTermDSubKClosedCtxBi_subst0_sort_arg_all`) -/

/-- **Closing Branch 1 (Shared $\Pi$-Reduct `.pi D₁ D₂`) via `convT_inst0_sortCongrLet` and
    `convT_inst1_sortCongrLet` (`pi_tyConv_of_whRedPiKClosedCtx_same_pi`):**
    When `instantiate0 v₁ b ↠wh instantiate0 v₁ (.pi D₁ D₂)` and
    `instantiate0 v₂ b ↠wh instantiate0 v₂ (.pi D₁ D₂)`, determinism `whRedPiKClosedCtx_pi_unique_of_envWfT`
    identifies `(P₁, Q₁)` and `(P₂, Q₂)` with the instantiated domain/codomain of `.pi D₁ D₂`, and
    `convT_inst0_sortCongrLet` + §12.2 `convT_inst1_sortCongrLet` supply `TyConvT` on both domain
    and codomain with **zero `PiInj` premise**! -/
theorem pi_tyConv_of_whRedPiKClosedCtx_same_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {A v₁ v₂ b D₁ D₂ P₁ Q₁ P₂ Q₂ : Expr Nat} {u u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hD₁ : HasTyT E n (.letBinding A v₁ :: Γ) D₁ (.sort u₁))
    (hD₂ : HasTyT E n (.assumption D₁ :: .letBinding A v₁ :: Γ) D₂ (.sort u₂))
    (h₁_pi : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (instantiate0 v₁ (.pi D₁ D₂)))
    (h₂_pi : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (instantiate0 v₂ (.pi D₁ D₂)))
    (hred₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (.pi P₁ Q₁))
    (hred₂ : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (.pi P₂ Q₂)) :
    Nonempty (TyConvT E n Γ P₁ P₂) ∧ Nonempty (TyConvT E n (.assumption P₁ :: Γ) Q₁ Q₂) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have h₁_pi' : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b)
      (.pi (instantiate0 v₁ D₁) (instantiate 1 (lift 0 1 v₁) D₂)) := by
    simpa only [instantiate0, instantiate] using h₁_pi
  have h₂_pi' : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b)
      (.pi (instantiate0 v₂ D₁) (instantiate 1 (lift 0 1 v₂) D₂)) := by
    simpa only [instantiate0, instantiate] using h₂_pi
  obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hred₁ h₁_pi'
  obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hred₂ h₂_pi'
  have hD₁_v₂ : HasTyT E n (.letBinding A v₂ :: Γ) D₁ (.sort u₁) :=
    hasTyTConvLet hcl (.refl Γ A (.sort u) hA) (.symm _ _ _ _ hcv) hv₂ hD₁
  have hcD₁ : ConvT E n Γ (instantiate0 v₁ D₁) (instantiate0 v₂ D₁) (.sort u₁) :=
    convT_inst0_sortCongrLet hA hD₁ hD₁_v₂ hv₁ hv₂ hcv
  have hcD₂ : ConvT E n (.assumption (instantiate0 v₁ D₁) :: Γ)
      (instantiate 1 (lift 0 1 v₁) D₂) (instantiate 1 (lift 0 1 v₂) D₂) (.sort u₂) :=
    convT_inst1_sortCongrLet hcl hinst hA hv₁ hv₂ hcv hD₁ hD₂
  exact ⟨⟨.of Γ _ _ u₁ hcD₁⟩, ⟨.of _ _ _ u₂ hcD₂⟩⟩

/-- **Closing Branch 2 (Direct Reduction Through `.bvar 0` to `v₁` and `v₂`)
    (`pi_tyConv_of_whRedPiKClosedCtx_to_val`):**
    When `instantiate0 v₁ b ↠wh v₁` and `instantiate0 v₂ b ↠wh v₂`, normal-form confluence
    `whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal` shows `v₁ ↠wh .pi P₁ Q₁` and `v₂ ↠wh .pi P₂ Q₂`,
    so `hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) → LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot [])`
    yields `TyConvT` between `(P₁, Q₁)` and `(P₂, Q₂)` directly! -/
theorem pi_tyConv_of_whRedPiKClosedCtx_to_val {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {v₁ v₂ b P₁ Q₁ P₂ Q₂ : Expr Nat}
    (hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []))
    (h₁_v : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) v₁)
    (h₂_v : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) v₂)
    (hred₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (.pi P₁ Q₁))
    (hred₂ : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (.pi P₂ Q₂)) :
    Nonempty (TyConvT E n Γ P₁ P₂) ∧ Nonempty (TyConvT E n (.assumption P₁ :: Γ) Q₁ Q₂) := by
  have hv₁_pi : WhRedPiKClosedCtx E Γ v₁ (.pi P₁ Q₁) :=
    whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal hW h₁_v hred₁
      (whNormalPiKClosedCtx_pi E Γ P₁ Q₁)
  have hv₂_pi : WhRedPiKClosedCtx E Γ v₂ (.pi P₂ Q₂) :=
    whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal hW h₂_v hred₂
      (whNormalPiKClosedCtx_pi E Γ P₂ Q₂)
  have hv₁_approx : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) :=
    approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW hv₁_pi
      (.pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim))
  cases hlr_v hv₁_approx with
  | pi h1 h2 _ hcA hcB _ _ =>
      obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hv₁_pi h1
      obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hv₂_pi h2
      exact ⟨⟨hcA⟩, ⟨hcB⟩⟩

/-- **Unified $\Pi$-Head `TyConvT` Extraction for Non-`.lam` `PrunedSemEqDIK`-Equal Arguments
    (`pi_tyConv_subst0_of_prunedSemEqDIK_no_lam`):**
    Combines `whRedPiKClosedCtx_substLet0_dichotomy_of_no_lam`, `pi_tyConv_of_whRedPiKClosedCtx_same_pi`,
    and `pi_tyConv_of_whRedPiKClosedCtx_to_val` to discharge both branches of `c = .pi .bot []`! -/
theorem pi_tyConv_subst0_of_prunedSemEqDIK_no_lam {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {A v₁ v₂ b D₁ D₂ P₁ Q₁ P₂ Q₂ : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []))
    (hred_b : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂))
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (hred₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (.pi P₁ Q₁))
    (hred₂ : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (.pi P₂ Q₂)) :
    Nonempty (TyConvT E n Γ P₁ P₂) ∧ Nonempty (TyConvT E n (.assumption P₁ :: Γ) Q₁ Q₂) := by
  have hpi_v₁b : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) (.pi .bot []) :=
    approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW hred₁
      (.pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim))
  have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
  rcases whRedPiKClosedCtx_substLet0_dichotomy_of_no_lam hW A A hv_sem hv_nolam
      hred_b .piBotNil hne hpi_v₁b with ⟨_, h₁_pi, h₂_pi⟩ | ⟨_, _, h₁_v, h₂_v⟩
  · obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := hb_wf2 D₁ D₂ hred_b
    exact pi_tyConv_of_whRedPiKClosedCtx_same_pi hW hA hv₁ hv₂ hcv hD₁ hD₂
      h₁_pi h₂_pi hred₁ hred₂
  · exact pi_tyConv_of_whRedPiKClosedCtx_to_val hW hlr_v h₁_v h₂_v hred₁ hred₂

/-- **Core 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    Non-`.lam` `PrunedSemEqDIK`-Equal Arguments (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_core`):**
    Requires **zero** `hSort` premise! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_core
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []))
    (hb_pi : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) →
      IsPropTyI E n Γ (instantiate0 v₁ B) ∨
        ∃ D₁ D₂, WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂))
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hsem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) (instantiate0 v₂ b) :=
    prunedSemEqDIK_instantiate0_of_prunedSemEqDIK (prunedEnvLe_ctxEnvDIK E Γ) hv_sem b
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hM₁ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c :=
    hor.elim id (fun h => (hsem c hc_p).mpr h)
  have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₂ b) c :=
    (hsem c hc_p).mp hM₁
  cases hc with
  | bot =>
      exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)
  | sort =>
      rcases h₁ .sort .sort (Or.inl hM₁) with hP | hC₁
      · exact Or.inl hP
      · rcases h₂ .sort .sort (Or.inl hM₂) with hP | hC₂
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_sort_iff] at hC₁ hC₂
          rcases hC₁ with ⟨hT, hlr₁⟩
          rcases hC₂ with ⟨_, hlr₂⟩
          cases hlr₁ with
          | sort hred₁ _ =>
              cases hlr₂ with
              | sort hred₂ _ =>
                  refine Or.inr ?_
                  rw [lrTermDSubKClosedCtxCore_sort_iff]
                  exact ⟨hT, .sort hred₁ hred₂⟩
  | piBotNil =>
      rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁) with hP | hC₁
      · exact Or.inl hP
      · rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂) with hP | hC₂
        · exact Or.inl hP
        · have hb_approx : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) :=
            (approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ b (.pi .bot [])).mp hM₁
          rcases hb_pi hb_approx with hP | ⟨D₁, D₂, hred_b⟩
          · exact Or.inl hP
          · have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₁ hC₂
            rcases hC₁ with ⟨hT, hlr₁⟩
            rcases hC₂ with ⟨_, hlr₂⟩
            cases hlr₁ with
            | @pi _ _ _ P₁ Q₁ _ _ _ _ hred₁ _ hΓ₁ _ _ _ _ =>
                cases hlr₂ with
                | @pi _ _ _ P₂ Q₂ _ _ _ _ hred₂ _ _ _ _ _ _ =>
                    obtain ⟨⟨hcA⟩, ⟨hcB⟩⟩ := pi_tyConv_subst0_of_prunedSemEqDIK_no_lam
                      hW hA hv₁ hv₂ hcv hv_sem hv_nolam hlr_v hred_b hb_wf2 hred₁ hred₂
                    refine Or.inr ?_
                    rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne]
                    exact ⟨hT, .pi hred₁ hred₂ hΓ₁ hcA hcB (.bot Γ P₁ P₂)
                      (fun _ hs => (List.not_mem_nil _ hs).elim)⟩

/-- **Full 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    Non-`.lam` `PrunedSemEqDIK`-Equal Arguments (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam`):**
    Upgrades §12.3's `lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_pi_probe` by removing the
    `¬ ApproxDIK ... (.pi .bot [])` restriction on `b` and closing **all three probes**
    `{.bot, .sort, .pi .bot []}` for any `PrunedSemEqDIK`-equal, non-`.lam` arguments `v₁, v₂`
    Directly from `hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B`, `hb_wf2`,
    and `h₂`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B) :=
    lrTermDSubKClosedCtxBi_substLet0 hW hSort hΓ hv₁ hb_let
  have hb_pi : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) →
      IsPropTyI E n Γ (instantiate0 v₁ B) ∨
        ∃ D₁ D₂, WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂) := by
    intro hb_approx
    rcases hb_let (.pi .bot []) .piBotNil (Or.inl hb_approx) with hP_let | hC_let
    · exact Or.inl (isPropTyI_substLet0_of_sortRow hW hSort hv₁ hP_let)
    · have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC_let
      cases hC_let.2 with
      | pi hred_b _ _ _ _ _ _ => exact Or.inr ⟨_, _, hred_b⟩
  exact lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_core
    hW hA hv₁ hv₂ hcv hv_sem hv_nolam hlr_v hb_pi hb_wf2 h₁ h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    ANY Convertible $\Pi$-Type Arguments (`lrTermDSubKClosedCtxBi_subst0_pi_arg_all`):**
    Removes the `¬ ApproxDIK ... (.pi .bot [])` restriction of §12.3's
    `lrTermDSubKClosedCtxBi_subst0_pi_arg_of_no_pi_probe`: for **every** pair of convertible
    $\Pi$-types `.pi A₁ B₁` and `.pi A₂ B₂` (even when `ConvT.irr` or `ConvT.eta` occurs inside
    `Aᵢ, Bᵢ`!) and **every** body `b` (whether `⊥`-probed, sort-probed, or $\Pi$-probed!),
    `LRTermDSubKClosedCtxBi E n Γ (instantiate0 (.pi A₁ B₁) b) (instantiate0 (.pi A₂ B₂) b) (instantiate0 (.pi A₁ B₁) B)`
    holds unconditionally! -/
theorem lrTermDSubKClosedCtxBi_subst0_pi_arg_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A₁ B₁ A₂ B₂ b B : Expr Nat} {u u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (.pi A₁ B₁) A)
    (hv₂ : HasTyT E n Γ (.pi A₂ B₂) A)
    (hcv : ConvT E n Γ (.pi A₁ B₁) (.pi A₂ B₂) A)
    (hcA : ConvT E n Γ A₁ A₂ (.sort u₁))
    (hcB : ConvT E n (.assumption A₁ :: Γ) B₁ B₂ (.sort u₂))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (.pi A₁ B₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (.pi A₁ B₁) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.pi A₂ B₂) b) (instantiate0 (.pi A₂ B₂) b) (instantiate0 (.pi A₁ B₁) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.pi A₁ B₁) b) (instantiate0 (.pi A₂ B₂) b) (instantiate0 (.pi A₁ B₁) B) := by
  have hA₁ : HasTyT E n Γ A₁ (.sort u₁) := (convEnds hW hΓ hcA).1
  have hΓ₁ : CtxWfT E n (.assumption A₁ :: Γ) := .assumption Γ A₁ u₁ hΓ hA₁
  have hlr_v : ApproxDIK E (ctxEnvDIK E Γ) (.pi A₁ B₁) (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ (.pi A₁ B₁) (.pi A₂ B₂) (.pi .bot []) :=
    fun _ => .pi (.refl _) (.refl _) hΓ₁ (.of Γ A₁ A₂ u₁ hcA) (.of _ B₁ B₂ u₂ hcB)
      (.bot Γ A₁ A₂) (fun _ hs => (List.not_mem_nil _ hs).elim)
  exact lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam
    hW hSort hΓ hA hv₁ hv₂ hcv
    (prunedSemEqDIK_pi E (ctxEnvDIK E Γ) A₁ B₁ A₂ B₂)
    (approxDIK_pi_not_lam A₁ B₁)
    hlr_v hb_let hb_wf2 h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    ANY Convertible Sort Arguments (`lrTermDSubKClosedCtxBi_subst0_sort_arg_all`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_sort_arg_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A b B : Expr Nat} {u l₁ l₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (.sort l₁) A)
    (hv₂ : HasTyT E n Γ (.sort l₂) A)
    (hcv : ConvT E n Γ (.sort l₁) (.sort l₂) A)
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (.sort l₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (.sort l₁) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.sort l₂) b) (instantiate0 (.sort l₂) b) (instantiate0 (.sort l₁) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.sort l₁) b) (instantiate0 (.sort l₂) b) (instantiate0 (.sort l₁) B) := by
  have hlr_v : ApproxDIK E (ctxEnvDIK E Γ) (.sort l₁) (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ (.sort l₁) (.sort l₂) (.pi .bot []) := by
    intro h
    rcases approxDIK_sort_inv h with h0 | h0 <;> cases h0
  exact lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam
    hW hSort hΓ hA hv₁ hv₂ hcv
    (prunedSemEqDIK_sorts E (ctxEnvDIK E Γ) l₁ l₂)
    (approxDIK_sort_not_lam l₁)
    hlr_v hb_let hb_wf2 h₂

/-! ## §14. Non-`λ` / Non-`Π` Spine Exclusions, Automatic `hlr_v` Discharge from `ih_v` or
`¬ ApproxDIK ... (.pi .bot [])`, and Unconditional 0-Instantiation Congruence Across ALL
Arguments `v₁, v₂` for Bodies Reducing to `.pi D₁ D₂` or `.sort l` -/

/-! ### §14.1. Non-`λ` and Non-`Π` Characterization of Rigid-Constant Spines, Constructor Spines,
and Assumption-Variable Spines in `ApproxDIK` -/

/-- If `f` has no `.lam g` compact in `ApproxDIK E ρ`, then `.app f a` has no `.pi d s` compact
    in `ApproxDIK E ρ` for any argument `a : Expr Nat`. -/
theorem approxDIK_app_not_pi_of_not_lam {E : ResolvedEnv} {ρ : EnvI} {f : Expr Nat}
    (hf : ∀ g, ¬ ApproxDIK E ρ f (.lam g)) (a : Expr Nat)
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E ρ (.app f a) (.pi d s) := by
  intro h
  rcases approxDIK_app_inv h with hbot | ⟨g₀, _, _, hfg₀, _, _⟩ | ⟨_, _, _, hsp, _, _⟩
  · cases hbot
  · exact hf g₀ hfg₀
  · cases hsp

/-- For any non-empty argument list `a :: args`, if `hd` has no `.lam g` compact in `ApproxDIK E ρ`,
    then `foldApps hd (a :: args)` has no `.pi d s` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_foldApps_not_pi_of_not_lam {E : ResolvedEnv} {ρ : EnvI} {hd : Expr Nat}
    (hhd : ∀ g, ¬ ApproxDIK E ρ hd (.lam g)) :
    ∀ (a : Expr Nat) (args : List (Expr Nat)) (d : CptI) (s : List (List CptI × CptI)),
      ¬ ApproxDIK E ρ (foldApps hd (a :: args)) (.pi d s)
  | a, [], d, s => approxDIK_app_not_pi_of_not_lam hhd a d s
  | a, a' :: args, d, s =>
      approxDIK_foldApps_not_pi_of_not_lam
        (approxDIK_app_not_lam_of_not_lam hhd a) a' args d s

/-- A sort `.sort l` has no `.pi d s` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_sort_not_pi {E : ResolvedEnv} {ρ : EnvI} (l : Level)
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E ρ (.sort l) (.pi d s) := by
  intro h
  rcases approxDIK_sort_inv h with h0 | h0 <;> cases h0

/-- An assumption bound variable (`lookupValue Γ i = none`) has no `.pi d s` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_bvar_none_not_pi {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (.bvar i) (.pi d s) := by
  intro h
  have hbot := approxDIK_ctxEnvDIK_bvar_none_eq_bot hnone h
  cases hbot

/-- Every non-recursor constant with `m.body = none` (axioms, inductive type formers, constructors)
    has no `.pi d s` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_rigidConst_not_pi {E : ResolvedEnv} {ρ : EnvI} {r : Nat} {ls : List Level}
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E ρ (.const r ls) (.pi d s) := by
  intro h
  rcases approxDIK_rigid_const_inv (rigidConst_of_body_none hm hb hnrec) h with h0 | h0 <;> cases h0

/-- Every spine `foldApps (.const r ls) args` headed by a non-recursor constant with `m.body = none`
    (axioms, inductive type formers, constructors) has no `.lam g` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_foldApps_rigidConst_not_lam {E : ResolvedEnv} {ρ : EnvI} {r : Nat} {ls : List Level}
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (args : List (Expr Nat)) (g : List (List CptI × CptI)) :
    ¬ ApproxDIK E ρ (foldApps (.const r ls) args) (.lam g) :=
  approxDIK_foldApps_not_lam_of_not_lam (approxDIK_rigidConst_not_lam hm hb hnrec) args g

/-- Every spine `foldApps (.const r ls) args` headed by a non-recursor constant with `m.body = none`
    (axioms, inductive type formers, constructors) has no `.pi d s` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_foldApps_rigidConst_not_pi {E : ResolvedEnv} {ρ : EnvI} {r : Nat} {ls : List Level}
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) :
    ∀ (args : List (Expr Nat)) (d : CptI) (s : List (List CptI × CptI)),
      ¬ ApproxDIK E ρ (foldApps (.const r ls) args) (.pi d s)
  | [], d, s => approxDIK_rigidConst_not_pi hm hb hnrec d s
  | a :: args, d, s =>
      approxDIK_foldApps_not_pi_of_not_lam (approxDIK_rigidConst_not_lam hm hb hnrec) a args d s

/-- Every spine `foldApps (.bvar i) args` headed by an assumption variable (`lookupValue Γ i = none`)
    has no `.lam g` compact in `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_foldApps_bvar_none_not_lam {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (args : List (Expr Nat)) (g : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) args) (.lam g) :=
  approxDIK_foldApps_not_lam_of_not_lam (approxDIK_ctxEnvDIK_bvar_none_not_lam hnone) args g

/-- Every spine `foldApps (.bvar i) args` headed by an assumption variable (`lookupValue Γ i = none`)
    has no `.pi d s` compact in `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_foldApps_bvar_none_not_pi {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) :
    ∀ (args : List (Expr Nat)) (d : CptI) (s : List (List CptI × CptI)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) args) (.pi d s)
  | [], d, s => approxDIK_ctxEnvDIK_bvar_none_not_pi hnone d s
  | a :: args, d, s =>
      approxDIK_foldApps_not_pi_of_not_lam (approxDIK_ctxEnvDIK_bvar_none_not_lam hnone) a args d s

/-! ### §14.2. Automatic Discharge of `hlr_v` in `lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam`
from Either `¬ ApproxDIK ... v₁ (.pi .bot [])` OR `ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A` -/

/-- **Full 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    Non-`.lam`, Non-$\Pi$ `PrunedSemEqDIK`-Equal Arguments
    (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_no_pi`):**
    When `v₁` has neither `.lam g` nor `.pi .bot []` in `ApproxDIK E (ctxEnvDIK E Γ)` (which holds
    for all constructor spines, all inductive/axiom spines, all assumption-variable spines, and all
    sorts), `hlr_v` is vacuously satisfied (`fun h => (hv_nopi h).elim`), so 0-instantiation
    congruence holds across **all 3 probes `{.bot, .sort, .pi .bot []}`** with **zero `ih_v`
    premise**! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_no_pi
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv_nopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem hv_nolam (fun h => (hv_nopi h).elim) hb_let hb_wf2 h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    `PrunedSemEqDIK`-Equal Rigid-Constant Spines (Constructors, Inductive Formers, Axioms)
    (`lrTermDSubKClosedCtxBi_subst0_rigidConst_spine_all`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_rigidConst_spine_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hbody : m.body = none) (hnrec : m.mclass ≠ .recursorM)
    {args : List (Expr Nat)} {A v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.const r ls) args) A)
    (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ (foldApps (.const r ls) args) v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (foldApps (.const r ls) args) v₂)
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (foldApps (.const r ls) args) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (foldApps (.const r ls) args) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 (foldApps (.const r ls) args) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (foldApps (.const r ls) args) b) (instantiate0 v₂ b)
      (instantiate0 (foldApps (.const r ls) args) B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_no_pi
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem
    (approxDIK_foldApps_rigidConst_not_lam hm hbody hnrec args)
    (approxDIK_foldApps_rigidConst_not_pi hm hbody hnrec args .bot [])
    hb_let hb_wf2 h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    `PrunedSemEqDIK`-Equal Assumption-Variable Spines
    (`lrTermDSubKClosedCtxBi_subst0_bvar_none_spine_all`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_bvar_none_spine_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {i : Nat} (hnone : lookupValue Γ i = none)
    {args : List (Expr Nat)} {A v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.bvar i) args) A)
    (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ (foldApps (.bvar i) args) v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (foldApps (.bvar i) args) v₂)
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (foldApps (.bvar i) args) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (foldApps (.bvar i) args) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 (foldApps (.bvar i) args) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (foldApps (.bvar i) args) b) (instantiate0 v₂ b)
      (instantiate0 (foldApps (.bvar i) args) B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_no_pi
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem
    (approxDIK_foldApps_bvar_none_not_lam hnone args)
    (approxDIK_foldApps_bvar_none_not_pi hnone args .bot [])
    hb_let hb_wf2 h₂

/-- When `¬ IsPropTyI E n Γ A`, the induction hypothesis `ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A`
    automatically supplies `hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) → LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot [])`. -/
theorem hlr_v_of_lrTermDSubKClosedCtxBi_not_prop
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {v₁ v₂ A : Expr Nat}
    (ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsPropTyI E n Γ A)
    (hv₁_approx : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot [])) :
    LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []) := by
  rcases ih_v (.pi .bot []) .piBotNil (Or.inl hv₁_approx) with hP | hC
  · exact (hnoprop hP).elim
  · exact lrTypeINPiKClosedCtx_of_lrTermDSubKClosedCtxCore_probe .piBotNil hC

/-- **Full 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    Non-`.lam` `PrunedSemEqDIK`-Equal Arguments at Any Non-Proposition Type `A`
    (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_of_ih_v`):**
    Discharges `hlr_v` automatically from `ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A` and
    `hnoprop : ¬ IsPropTyI E n Γ A`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam_of_ih_v
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsPropTyI E n Γ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem hv_nolam
    (hlr_v_of_lrTermDSubKClosedCtxBi_not_prop ih_v hnoprop)
    hb_let hb_wf2 h₂

/-! ### §14.3. Unconditional 0-Instantiation Congruence Across ALL Arguments `v₁, v₂` (Including
$\lambda$-Abstractions and `ConvT.irr` Proof Terms!) for Bodies Reducing to `.pi D₁ D₂` or `.sort l` -/

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` and
    ALL Arguments `v₁, v₂` When `b` Weak-Head Reduces to `.pi D₁ D₂` in Both `letBinding` Contexts
    (`lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_pi`):**
    Requires **ZERO** `PrunedSemEqDIK`, **ZERO** `hv_nolam`, **ZERO** `ih_v`, and **ZERO** `hSort`!
    Applies even when `v₁, v₂` are $\lambda$-abstractions `.lam ...` or `ConvT.irr` proof terms! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_pi
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B D₁ D₂ : Expr Nat} {u u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hred_b₁ : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂))
    (hred_b₂ : WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (.pi D₁ D₂))
    (hD₁ : HasTyT E n (.letBinding A v₁ :: Γ) D₁ (.sort u₁))
    (hD₂ : HasTyT E n (.assumption D₁ :: .letBinding A v₁ :: Γ) D₂ (.sort u₂))
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hcl := envClosed_of_envWfT hW
  have h₁_pi : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (instantiate0 v₁ (.pi D₁ D₂)) :=
    whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₁ hred_b₁
  have h₂_pi : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (instantiate0 v₂ (.pi D₁ D₂)) :=
    whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₂ hred_b₂
  have h₁_pi' : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b)
      (.pi (instantiate0 v₁ D₁) (instantiate 1 (lift 0 1 v₁) D₂)) := by
    simpa only [instantiate0, instantiate] using h₁_pi
  have h₂_pi' : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b)
      (.pi (instantiate0 v₂ D₁) (instantiate 1 (lift 0 1 v₂) D₂)) := by
    simpa only [instantiate0, instantiate] using h₂_pi
  have hM₁_pi : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) (.pi .bot []) :=
    approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW h₁_pi'
      (.pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim))
  have hM₂_pi : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₂ b) (.pi .bot []) :=
    approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW h₂_pi'
      (.pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim))
  intro c hc hor
  cases hc with
  | bot =>
      exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)
  | sort =>
      rcases hor with hM₁_s | hM₂_s
      · rcases h₁ .sort .sort (Or.inl hM₁_s) with hP | hC₁
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_sort_iff] at hC₁
          cases hC₁.2 with
          | sort hred_s _ =>
              have heq := whRedPiKClosedCtx_normal_unique_of_envWfT hW
                hred_s (whNormalPiKClosedCtx_sort E Γ _)
                h₁_pi' (whNormalPiKClosedCtx_pi E Γ _ _)
              exact Expr.noConfusion heq
      · rcases h₂ .sort .sort (Or.inl hM₂_s) with hP | hC₂
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_sort_iff] at hC₂
          cases hC₂.2 with
          | sort hred_s _ =>
              have heq := whRedPiKClosedCtx_normal_unique_of_envWfT hW
                hred_s (whNormalPiKClosedCtx_sort E Γ _)
                h₂_pi' (whNormalPiKClosedCtx_pi E Γ _ _)
              exact Expr.noConfusion heq
  | piBotNil =>
      rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁_pi) with hP | hC₁
      · exact Or.inl hP
      · rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂_pi) with hP | hC₂
        · exact Or.inl hP
        · have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
          rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₁ hC₂
          rcases hC₁ with ⟨hT, hlr₁⟩
          rcases hC₂ with ⟨_, hlr₂⟩
          cases hlr₁ with
          | @pi _ _ _ P₁ Q₁ _ _ _ _ hred₁ _ hΓ₁ _ _ _ _ =>
              cases hlr₂ with
              | @pi _ _ _ P₂ Q₂ _ _ _ _ hred₂ _ _ _ _ _ _ =>
                  obtain ⟨⟨hcA⟩, ⟨hcB⟩⟩ := pi_tyConv_of_whRedPiKClosedCtx_same_pi
                    hW hA hv₁ hv₂ hcv hD₁ hD₂ h₁_pi h₂_pi hred₁ hred₂
                  refine Or.inr ?_
                  rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne]
                  exact ⟨hT, .pi hred₁ hred₂ hΓ₁ hcA hcB (.bot Γ P₁ P₂)
                    (fun _ hs => (List.not_mem_nil _ hs).elim)⟩

/-- Specialization of `lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_pi` when `b`
    weak-head reduces to `.pi D₁ D₂` in pure context-free `WhRed E b (.pi D₁ D₂)`. -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRed_pi
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B D₁ D₂ : Expr Nat} {u u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hred : WhRed E b (.pi D₁ D₂))
    (hD₁ : HasTyT E n (.letBinding A v₁ :: Γ) D₁ (.sort u₁))
    (hD₂ : HasTyT E n (.assumption D₁ :: .letBinding A v₁ :: Γ) D₂ (.sort u₂))
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_pi hW hA hv₁ hv₂ hcv
    (whRedPiKClosedCtx_of_whRed hred) (whRedPiKClosedCtx_of_whRed hred)
    hD₁ hD₂ h₁ h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` and
    ALL Arguments `v₁, v₂` When `b` Weak-Head Reduces to `.sort lᵢ` in Both `letBinding` Contexts
    (`lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_sort`):**
    Requires **ZERO** `PrunedSemEqDIK`, **ZERO** `hv_nolam`, **ZERO** `ih_v`, and **ZERO** `hSort`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_sort
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B : Expr Nat} {l₁ l₂ : Level}
    (hred_b₁ : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.sort l₁))
    (hred_b₂ : WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (.sort l₂))
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hcl := envClosed_of_envWfT hW
  have h₁_s : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (.sort l₁) :=
    whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₁ hred_b₁
  have h₂_s : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (.sort l₂) :=
    whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₂ hred_b₂
  have hM₁_s : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) .sort :=
    approxDIK_ctxEnvDIK_sort_of_whRedPiKClosedCtx hW h₁_s
  intro c hc hor
  cases hc with
  | bot =>
      exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)
  | sort =>
      rcases h₁ .sort .sort (Or.inl hM₁_s) with hP | hC₁
      · exact Or.inl hP
      · rw [lrTermDSubKClosedCtxCore_sort_iff] at hC₁
        refine Or.inr ?_
        rw [lrTermDSubKClosedCtxCore_sort_iff]
        exact ⟨hC₁.1, .sort h₁_s h₂_s⟩
  | piBotNil =>
      have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      rcases hor with hM₁_pi | hM₂_pi
      · rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁_pi) with hP | hC₁
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₁
          cases hC₁.2 with
          | pi hred_pi _ _ _ _ _ _ =>
              have heq := whRedPiKClosedCtx_normal_unique_of_envWfT hW
                h₁_s (whNormalPiKClosedCtx_sort E Γ _)
                hred_pi (whNormalPiKClosedCtx_pi E Γ _ _)
              exact Expr.noConfusion heq
      · rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂_pi) with hP | hC₂
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₂
          cases hC₂.2 with
          | pi hred_pi _ _ _ _ _ _ =>
              have heq := whRedPiKClosedCtx_normal_unique_of_envWfT hW
                h₂_s (whNormalPiKClosedCtx_sort E Γ _)
                hred_pi (whNormalPiKClosedCtx_pi E Γ _ _)
              exact Expr.noConfusion heq

/-- Specialization of `lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_sort` when `b`
    weak-head reduces to `.sort l` in pure context-free `WhRed E b (.sort l)`. -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRed_sort
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {v₁ v₂ b B : Expr Nat} {l : Level}
    (hred : WhRed E b (.sort l))
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_same_sort (A := .sort .zero) hW
    (whRedPiKClosedCtx_of_whRed hred) (whRedPiKClosedCtx_of_whRed hred) h₁ h₂

/-! ## §15. Exact `WhStepPiKClosedCtx` / `WhRedPiKClosedCtx` Spine Characterizations,
Type-Independent Weak-Head Reduction Bridge (`lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop`),
and Unconditional 0-Instantiation Congruence for `.bvar 0` and Applied `.bvar 0` Spines -/

/-! ### §15.1. Exact `WhStepPiKClosedCtx` / `WhRedPiKClosedCtx` Normal-Form and Unfolding
Characterizations on Variable Spines and Rigid-Constant Spines -/

/-- `appsSpine` of a `.bvar i`-headed spine `foldApps (.bvar i) args` is `(.bvar i, args)`. -/
theorem appsSpine_foldApps_bvar (i : Nat) (args : List (Expr Nat)) :
    appsSpine (foldApps (.bvar i) args) = (.bvar i, args) := by
  simpa only [appsSpine_bvar, List.nil_append] using appsSpine_foldApps (.bvar i) args

/-- No pure `WhStep E` can step a `.bvar i`-headed spine `foldApps (.bvar i) args`. -/
theorem whStep_foldApps_bvar_false {E : ResolvedEnv} {i : Nat} {args : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStep E (foldApps (.bvar i) args) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStep E f e → (appsSpine f).1 = .bvar i → False := by
    intro f e hstep
    induction hstep with
    | beta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | delta _ _ => intro hsp; simp [appsSpine] at hsp
    | iota hI =>
        intro hsp
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            rw [appsSpine_foldApps_const] at hsp
            exact Expr.noConfusion hsp
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            rw [appsSpine_foldApps_const] at hsp
            exact Expr.noConfusion hsp
    | lit _ => intro hsp; simp [appsSpine] at hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
  exact key hs (congrArg Prod.fst (appsSpine_foldApps_bvar i args))

/-- Head congruence of `WhStepPiKClosedCtx` across `foldApps`. -/
theorem whStepPiKClosedCtx_foldApps {E : ResolvedEnv} {Γ : LCtx} {f f' : Expr Nat}
    (hs : WhStepPiKClosedCtx E Γ f f') :
    ∀ (args : List (Expr Nat)), WhStepPiKClosedCtx E Γ (foldApps f args) (foldApps f' args)
  | [] => hs
  | _ :: args => whStepPiKClosedCtx_foldApps (.appHead hs) args

/-- Head congruence of `WhRedPiKClosedCtx` across `foldApps`. -/
theorem whRedPiKClosedCtx_foldApps {E : ResolvedEnv} {Γ : LCtx} {f f' : Expr Nat}
    (hr : WhRedPiKClosedCtx E Γ f f') :
    ∀ (args : List (Expr Nat)), WhRedPiKClosedCtx E Γ (foldApps f args) (foldApps f' args)
  | [] => hr
  | _ :: args => whRedPiKClosedCtx_foldApps (whRedPiKClosedCtx_appHead hr) args

/-- **Exact Inversion of `WhStepPiKClosedCtx` on `.bvar i`-Headed Spines
    (`whStepPiKClosedCtx_foldApps_bvar_inv`):**
    Any single `WhStepPiKClosedCtx E Γ` step from `foldApps (.bvar i) args` must come from
    `lookupValue Γ i = some w` and produce `foldApps w args`. -/
theorem whStepPiKClosedCtx_foldApps_bvar_inv {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    {args : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepPiKClosedCtx E Γ (foldApps (.bvar i) args) e) :
    ∃ w, lookupValue Γ i = some w ∧ e = foldApps w args := by
  have key : ∀ {f e : Expr Nat} (ys : List (Expr Nat)),
      WhStepPiKClosedCtx E Γ f e → f = foldApps (.bvar i) ys →
      ∃ w, lookupValue Γ i = some w ∧ e = foldApps w ys := by
    intro f e ys hstep
    induction hstep generalizing ys with
    | of_whStep hs₀ =>
        intro hf
        subst hf
        exact (whStep_foldApps_bvar_false hs₀).elim
    | @zetaLocal j w hval =>
        intro hf
        have hsp := congrArg appsSpine hf
        rw [appsSpine_bvar, appsSpine_foldApps_bvar] at hsp
        injection hsp with hhead hargs
        injection hhead with hij
        subst hij; subst hargs
        exact ⟨w, hval, rfl⟩
    | iotaKClosedCtx w x _ _ _ =>
        intro hf
        have hsp := congrArg (Prod.fst ∘ appsSpine) hf
        unfold recCall at hsp
        rw [Function.comp_apply, Function.comp_apply,
          appsSpine_foldApps_const, appsSpine_foldApps_bvar] at hsp
        exact Expr.noConfusion hsp
    | @appHead f₀ f₀' arg _ ih =>
        intro hf
        rcases list_eq_nil_or_snoc ys with rfl | ⟨pre, y, rfl⟩
        · exact Expr.noConfusion hf
        · rw [foldApps_snoc] at hf
          injection hf with hf₀ harg
          subst harg
          obtain ⟨w, hval, rfl⟩ := ih pre hf₀
          exact ⟨w, hval, by rw [foldApps_snoc]⟩
  exact key args hs rfl

/-- Any `WhStepPiKClosedCtx E Γ` step from `.bvar i` is given by `lookupValue Γ i = some e`. -/
theorem whStepPiKClosedCtx_bvar_inv {E : ResolvedEnv} {Γ : LCtx} {i : Nat} {e : Expr Nat}
    (hs : WhStepPiKClosedCtx E Γ (.bvar i) e) :
    lookupValue Γ i = some e := by
  obtain ⟨w, hw, rfl⟩ := whStepPiKClosedCtx_foldApps_bvar_inv (args := []) hs
  exact hw

/-- When `lookupValue Γ i = none`, no `WhStepPiKClosedCtx E Γ` step can fire on
    `foldApps (.bvar i) args`. -/
theorem whStepPiKClosedCtx_foldApps_bvar_none_false {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {args : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStepPiKClosedCtx E Γ (foldApps (.bvar i) args) e) : False := by
  obtain ⟨w, hw, _⟩ := whStepPiKClosedCtx_foldApps_bvar_inv hs
  rw [hnone] at hw
  exact Option.noConfusion hw

/-- Every assumption-variable spine `foldApps (.bvar i) args` (`lookupValue Γ i = none`) is a
    `WhNormalPiKClosedCtx E Γ` normal form. -/
theorem whNormalPiKClosedCtx_foldApps_bvar_none {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) (args : List (Expr Nat)) :
    WhNormalPiKClosedCtx E Γ (foldApps (.bvar i) args) :=
  fun _ hs => whStepPiKClosedCtx_foldApps_bvar_none_false hnone hs

/-- Every `WhRedPiKClosedCtx E Γ` reduction from an assumption-variable spine
    `foldApps (.bvar i) args` (`lookupValue Γ i = none`) is stationary. -/
theorem whRedPiKClosedCtx_foldApps_bvar_none_eq {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    (hnone : lookupValue Γ i = none) {args : List (Expr Nat)} {e : Expr Nat}
    (hr : WhRedPiKClosedCtx E Γ (foldApps (.bvar i) args) e) :
    e = foldApps (.bvar i) args :=
  whRedPiKClosedCtx_of_normal (whNormalPiKClosedCtx_foldApps_bvar_none hnone args) hr

/-- Exact characterization (`↔`) of `WhStepPiKClosedCtx E Γ` on a let-bound variable spine
    `foldApps (.bvar i) args` (`lookupValue Γ i = some w`). -/
theorem whStepPiKClosedCtx_foldApps_bvar_some_iff {E : ResolvedEnv} {Γ : LCtx} {i : Nat}
    {w : Expr Nat} (hsome : lookupValue Γ i = some w) (args : List (Expr Nat)) (e : Expr Nat) :
    WhStepPiKClosedCtx E Γ (foldApps (.bvar i) args) e ↔ e = foldApps w args := by
  constructor
  · intro hs
    obtain ⟨w', hw', rfl⟩ := whStepPiKClosedCtx_foldApps_bvar_inv hs
    rw [hsome] at hw'
    injection hw' with hw_eq
    subst hw_eq
    rfl
  · rintro rfl
    exact whStepPiKClosedCtx_foldApps (.zetaLocal hsome) args

/-- Exact characterization (`↔`) of `WhStepPiKClosedCtx E (.letBinding A v :: Γ)` on a
    `.bvar 0`-headed spine `foldApps (.bvar 0) args`: its unique 1-step reduct is
    `foldApps (lift 0 1 v) args`. -/
theorem whStepPiKClosedCtx_letBinding_foldApps_bvar0_iff {E : ResolvedEnv} {Γ : LCtx}
    (A v : Expr Nat) (args : List (Expr Nat)) (e : Expr Nat) :
    WhStepPiKClosedCtx E (.letBinding A v :: Γ) (foldApps (.bvar 0) args) e ↔
      e = foldApps (lift 0 1 v) args :=
  whStepPiKClosedCtx_foldApps_bvar_some_iff
    (rfl : lookupValue (.letBinding A v :: Γ) 0 = some (lift 0 1 v)) args e

/-- For any target `c ≠ foldApps (.bvar 0) args` (such as `.sort l`, `.pi D₁ D₂`, or `.lam Dom body`),
    `WhRedPiKClosedCtx E (.letBinding A v :: Γ) (foldApps (.bvar 0) args) c` is two-way equivalent (`↔`)
    to `WhRedPiKClosedCtx E (.letBinding A v :: Γ) (foldApps (lift 0 1 v) args) c`. -/
theorem whRedPiKClosedCtx_letBinding_foldApps_bvar0_of_ne {E : ResolvedEnv} {Γ : LCtx}
    (A v : Expr Nat) (args : List (Expr Nat)) {c : Expr Nat}
    (hne : c ≠ foldApps (.bvar 0) args) :
    WhRedPiKClosedCtx E (.letBinding A v :: Γ) (foldApps (.bvar 0) args) c ↔
      WhRedPiKClosedCtx E (.letBinding A v :: Γ) (foldApps (lift 0 1 v) args) c := by
  constructor
  · intro hred
    cases hred with
    | refl => exact (hne rfl).elim
    | step hs hrest =>
        rw [(whStepPiKClosedCtx_letBinding_foldApps_bvar0_iff A v args _).mp hs] at hrest
        exact hrest
  · intro hrest
    exact .step ((whStepPiKClosedCtx_letBinding_foldApps_bvar0_iff A v args _).mpr rfl) hrest

/-- Under `EnvWfT E`, no pure `WhStep E` can step a `RigidConst E r` spine `foldApps (.const r ls) args`. -/
theorem whStep_foldApps_rigidConst_false {E : ResolvedEnv} (hW : EnvWfT E)
    {r : Nat} (hrig : RigidConst E r) {ls : List Level} {args : List (Expr Nat)} {e : Expr Nat}
    (hs : WhStep E (foldApps (.const r ls) args) e) : False := by
  have key : ∀ {f e : Expr Nat}, WhStep E f e → (appsSpine f).1 = .const r ls → False := by
    intro f e hstep
    induction hstep with
    | beta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | zeta _ _ _ => intro hsp; simp [appsSpine] at hsp
    | delta hres hbody' =>
        intro hsp
        simp only [appsSpine, Expr.const.injEq] at hsp
        rcases hsp with ⟨rfl, _⟩
        rw [rigidConst_body_none_of_envWfT hW hrig hres] at hbody'
        exact Option.noConfusion hbody'
    | iota hI =>
        intro hsp
        cases hI with
        | ofU w =>
            unfold iotaLhsOf recCall at hsp
            rw [appsSpine_foldApps_const] at hsp
            injection hsp with hrec _
            subst hrec
            exact (hrig w.recMember w.hrec).2 w.hrecK
        | ofUS w =>
            unfold iotaLhsOfS recCall at hsp
            rw [appsSpine_foldApps_const] at hsp
            injection hsp with hrec _
            subst hrec
            exact (hrig w.recMember w.hrec).2 w.hrecK
    | lit _ => intro hsp; simp [appsSpine] at hsp
    | appHead _ ih =>
        intro hsp
        simp only [appsSpine] at hsp
        exact ih hsp
  have hsp₀ : (appsSpine (foldApps (.const r ls) args)).1 = .const r ls := by
    rw [appsSpine_foldApps_const]
  exact key hs hsp₀

/-- Under `EnvWfT E`, no `WhStepPiKClosedCtx E Γ` step can fire on a `RigidConst E r` spine
    `foldApps (.const r ls) args`. -/
theorem whStepPiKClosedCtx_foldApps_rigidConst_false {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} (hrig : RigidConst E r) {ls : List Level} {args : List (Expr Nat)}
    {e : Expr Nat} (hs : WhStepPiKClosedCtx E Γ (foldApps (.const r ls) args) e) : False := by
  have key : ∀ {f e : Expr Nat} (ys : List (Expr Nat)),
      WhStepPiKClosedCtx E Γ f e → f = foldApps (.const r ls) ys → False := by
    intro f e ys hstep
    induction hstep generalizing ys with
    | of_whStep hs₀ =>
        intro hf
        subst hf
        exact whStep_foldApps_rigidConst_false hW hrig hs₀
    | zetaLocal _ =>
        intro hf
        have hsp := congrArg (Prod.fst ∘ appsSpine) hf
        rw [Function.comp_apply, Function.comp_apply,
          appsSpine_bvar, appsSpine_foldApps_const] at hsp
        exact Expr.noConfusion hsp
    | iotaKClosedCtx w x _ _ _ =>
        intro hf
        have hsp := congrArg (Prod.fst ∘ appsSpine) hf
        unfold recCall at hsp
        rw [Function.comp_apply, Function.comp_apply,
          appsSpine_foldApps_const, appsSpine_foldApps_const] at hsp
        injection hsp with hrec _
        subst hrec
        exact not_rigidConst_of_recursor w hrig
    | @appHead f₀ f₀' arg _ ih =>
        intro hf
        rcases list_eq_nil_or_snoc ys with rfl | ⟨pre, y, rfl⟩
        · exact Expr.noConfusion hf
        · rw [foldApps_snoc] at hf
          injection hf with hf₀ _
          exact ih pre hf₀
  exact key args hs rfl

/-- Under `EnvWfT E`, every `RigidConst E r` spine `foldApps (.const r ls) args` is a
    `WhNormalPiKClosedCtx E Γ` normal form. -/
theorem whNormalPiKClosedCtx_foldApps_rigidConst {E : ResolvedEnv} (hW : EnvWfT E)
    (Γ : LCtx) {r : Nat} (hrig : RigidConst E r) (ls : List Level) (args : List (Expr Nat)) :
    WhNormalPiKClosedCtx E Γ (foldApps (.const r ls) args) :=
  fun _ hs => whStepPiKClosedCtx_foldApps_rigidConst_false hW hrig hs

/-- Under `EnvWfT E`, every `WhRedPiKClosedCtx E Γ` reduction from a `RigidConst E r` spine
    `foldApps (.const r ls) args` is stationary. -/
theorem whRedPiKClosedCtx_foldApps_rigidConst_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} (hrig : RigidConst E r) {ls : List Level} {args : List (Expr Nat)}
    {e : Expr Nat} (hr : WhRedPiKClosedCtx E Γ (foldApps (.const r ls) args) e) :
    e = foldApps (.const r ls) args :=
  whRedPiKClosedCtx_of_normal (whNormalPiKClosedCtx_foldApps_rigidConst hW Γ hrig ls args) hr

/-! ### §15.2. Type-Independent Weak-Head Reduction Bridge
(`lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop`) and Unconditional 0-Instantiation
Congruence for Bodies Reducing to `.bvar 0` or Applied `.bvar 0` Spines -/

/-- **Type-Independent Weak-Head Reduction Bridge (`lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop`):**
    Because `LRTypeINPiKClosedCtx E n Γ N₁ N₂ c` on any non-`⊥` probe `c ∈ {.sort, .pi .bot []}` is
    completely independent of the type annotation `A₀` in `LRTermDSubKClosedCtxCore E n Γ N₁ N₂ A₀ c`,
    if `M₁ ↠wh N₁` and `M₂ ↠wh N₂` in `WhRedPiKClosedCtx E Γ`, `LRTermDSubKClosedCtxBi E n Γ N₁ N₂ A₀`
    holds at **any** non-proposition type `A₀` (`¬ IsPropTyI E n Γ A₀`), and the endpoint diagonal
    relations `h₁ : LRTermDSubKClosedCtxBi E n Γ M₁ M₁ B₀` and `h₂ : LRTermDSubKClosedCtxBi E n Γ M₂ M₂ B₀`
    hold at `B₀`, then `LRTermDSubKClosedCtxBi E n Γ M₁ M₂ B₀` holds at `B₀` — with **ZERO**
    `TyConvT E n Γ A₀ B₀` premise! -/
theorem lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {M₁ M₂ N₁ N₂ A₀ B₀ : Expr Nat}
    (hred₁ : WhRedPiKClosedCtx E Γ M₁ N₁)
    (hred₂ : WhRedPiKClosedCtx E Γ M₂ N₂)
    (hN : LRTermDSubKClosedCtxBi E n Γ N₁ N₂ A₀)
    (hnoprop : ¬ IsPropTyI E n Γ A₀)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ M₁ M₁ B₀)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ M₂ M₂ B₀) :
    LRTermDSubKClosedCtxBi E n Γ M₁ M₂ B₀ := by
  intro c hc hor
  cases hc with
  | bot =>
      exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)
  | sort =>
      have hne : CptI.sort ≠ .bot := by intro h0; cases h0
      have hor_N : ApproxDIK E (ctxEnvDIK E Γ) N₁ .sort ∨ ApproxDIK E (ctxEnvDIK E Γ) N₂ .sort :=
        hor.elim
          (fun hM₁ => Or.inl ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred₁ .sort).mp hM₁))
          (fun hM₂ => Or.inr ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred₂ .sort).mp hM₂))
      rcases hN .sort .sort hor_N with hP_A | hC_N
      · exact (hnoprop hP_A).elim
      · have hlr_M : LRTypeINPiKClosedCtx E n Γ M₁ M₂ .sort :=
          lrTypeINPiKClosedCtx_expand hred₁ hred₂
            (lrTypeINPiKClosedCtx_of_lrTermDSubKClosedCtxCore_probe .sort hC_N)
        rcases hor with hM₁ | hM₂
        · rcases h₁ .sort .sort (Or.inl hM₁) with hP_B | hC₁
          · exact Or.inl hP_B
          · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort hne] at hC₁
            refine Or.inr ?_
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort hne]
            exact ⟨hC₁.1, hlr_M⟩
        · rcases h₂ .sort .sort (Or.inl hM₂) with hP_B | hC₂
          · exact Or.inl hP_B
          · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort hne] at hC₂
            refine Or.inr ?_
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .sort hne]
            exact ⟨hC₂.1, hlr_M⟩
  | piBotNil =>
      have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      have hor_N : ApproxDIK E (ctxEnvDIK E Γ) N₁ (.pi .bot []) ∨
          ApproxDIK E (ctxEnvDIK E Γ) N₂ (.pi .bot []) :=
        hor.elim
          (fun hM₁ => Or.inl ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred₁ (.pi .bot [])).mp hM₁))
          (fun hM₂ => Or.inr ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtx hW hred₂ (.pi .bot [])).mp hM₂))
      rcases hN (.pi .bot []) .piBotNil hor_N with hP_A | hC_N
      · exact (hnoprop hP_A).elim
      · have hlr_M : LRTypeINPiKClosedCtx E n Γ M₁ M₂ (.pi .bot []) :=
          lrTypeINPiKClosedCtx_expand hred₁ hred₂
            (lrTypeINPiKClosedCtx_of_lrTermDSubKClosedCtxCore_probe .piBotNil hC_N)
        rcases hor with hM₁ | hM₂
        · rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁) with hP_B | hC₁
          · exact Or.inl hP_B
          · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₁
            refine Or.inr ?_
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne]
            exact ⟨hC₁.1, hlr_M⟩
        · rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂) with hP_B | hC₂
          · exact Or.inl hP_B
          · rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₂
            refine Or.inr ?_
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne]
            exact ⟨hC₂.1, hlr_M⟩

/-- **Type-Change Without `TyConvT` (`lrTermDSubKClosedCtxBi_change_type_of_not_prop`):**
    If `LRTermDSubKClosedCtxBi E n Γ M₁ M₂ A₀` holds at any non-proposition type `A₀`
    (`¬ IsPropTyI E n Γ A₀`), and the endpoint diagonal relations `h₁` and `h₂` hold at `B₀`,
    then `LRTermDSubKClosedCtxBi E n Γ M₁ M₂ B₀` holds at `B₀` with **zero** `TyConvT E n Γ A₀ B₀`. -/
theorem lrTermDSubKClosedCtxBi_change_type_of_not_prop
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {M₁ M₂ A₀ B₀ : Expr Nat}
    (hM : LRTermDSubKClosedCtxBi E n Γ M₁ M₂ A₀)
    (hnoprop : ¬ IsPropTyI E n Γ A₀)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ M₁ M₁ B₀)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ M₂ M₂ B₀) :
    LRTermDSubKClosedCtxBi E n Γ M₁ M₂ B₀ :=
  lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop hW (.refl M₁) (.refl M₂) hM hnoprop h₁ h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}`
    When `b` Weak-Head Reduces to `.bvar 0` in Both `letBinding` Contexts
    (`lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_bvar0`):**
    Closes Branch 2 of `whRedPiKClosedCtx_substLet0_trichotomy` across all 3 probes with **ZERO**
    `PrunedSemEqDIK`, **ZERO** `hv_nolam`, **ZERO** `hb_wf2`, and **ZERO** `TyConvT`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_bvar0
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B : Expr Nat}
    (hred_b₁ : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.bvar 0))
    (hred_b₂ : WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (.bvar 0))
    (ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsPropTyI E n Γ A)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hcl := envClosed_of_envWfT hW
  have hsub₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) v₁ := by
    simpa only [instantiate0, instantiate] using
      whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₁ hred_b₁
  have hsub₂ : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) v₂ := by
    simpa only [instantiate0, instantiate] using
      whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₂ hred_b₂
  exact lrTermDSubKClosedCtxBi_of_whRedPiKClosedCtx_nonprop hW hsub₁ hsub₂ ih_v hnoprop h₁ h₂

/-- Specialization of `lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_bvar0` when `b`
    weak-head reduces to `.bvar 0` in pure context-free `WhRed E b (.bvar 0)` (in particular when
    `b = .bvar 0`). -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRed_bvar0
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B : Expr Nat}
    (hred : WhRed E b (.bvar 0))
    (ih_v : LRTermDSubKClosedCtxBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsPropTyI E n Γ A)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_bvar0 hW
    (whRedPiKClosedCtx_of_whRed hred) (whRedPiKClosedCtx_of_whRed hred) ih_v hnoprop h₁ h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}`
    When `b` Weak-Head Reduces to `foldApps (.bvar 0) args` in Both `letBinding` Contexts
    (`lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_foldApps_bvar0`):**
    Closes both Branch 2 (`args = []`) and Branch 3 (`args = arg₀ :: rest`) of
    `whRedPiKClosedCtx_substLet0_trichotomy` whenever the instantiated spines
    `foldApps v₁ (args.map (instantiate0 v₁))` and `foldApps v₂ (args.map (instantiate0 v₂))` are
    related in `LRTermDSubKClosedCtxBi` at **any** non-proposition type `A₀`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_whRedPiKClosedCtx_foldApps_bvar0
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B A₀ : Expr Nat} {args : List (Expr Nat)}
    (hred_b₁ : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (foldApps (.bvar 0) args))
    (hred_b₂ : WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (foldApps (.bvar 0) args))
    (hsp : LRTermDSubKClosedCtxBi E n Γ
      (foldApps v₁ (args.map (instantiate0 v₁)))
      (foldApps v₂ (args.map (instantiate0 v₂))) A₀)
    (hnoprop : ¬ IsPropTyI E n Γ A₀)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hcl := envClosed_of_envWfT hW
  have hsub₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b)
      (foldApps v₁ (args.map (instantiate0 v₁))) := by
