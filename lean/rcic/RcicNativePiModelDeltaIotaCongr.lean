  have ih_arg_diag : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ (.app (lift 0 1 f₂) (.bvar 0)))
      (instantiate0 a₁ B) := by
    simpa only [instantiate0_app_lift0_bvar0_arg f₂ a₁] using ih_app₂₁
  have h_arg0 := hSubst0 hΓ ha₁ ha₂ hca ih_a ih_arg_diag
  rw [instantiate0_app_lift0_bvar0_arg f₂ a₁, instantiate0_app_lift0_bvar0_arg f₂ a₂] at h_arg0
  exact lrTermDSubKClosedCtxBi_trans hW h_fn0 h_arg0

