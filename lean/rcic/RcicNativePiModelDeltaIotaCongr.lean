    HasTyT trueEnvU n trueEnvU_kVarCtx trueEnvU_kRecIdTt (.sort (.succ .zero)) :=
  let hhead : HasTyT trueEnvU n trueEnvU_kVarCtx trueEnvU_kRecElim
      (.pi (.const 0 []) (.app (.lam (.const 0 []) (.sort (.succ .zero))) (.bvar 0))) :=
    .app _ _ _ _ _
      (.app _ _ _ _ _
        (.const _ 2 [.succ (.succ .zero)] trueRecMemberU rfl rfl rfl)
        trueEnvUM_ty)
      trueEnvUS0_ty
  let hid : HasTyT trueEnvU n trueEnvU_kVarCtx
      (.lam (.const 0 []) (.bvar 0)) (.pi (.const 0 []) (.const 0 [])) :=
    .lam _ (.const 0 []) .zero (.bvar 0) (.const 0 []) trueEnvUF_ty (.bvar _ 0 _ rfl)
  let hidTt : HasTyT trueEnvU n trueEnvU_kVarCtx
      (.app (.lam (.const 0 []) (.bvar 0)) (.const 1 [])) (.const 0 []) :=
    .app _ _ _ _ _ hid trueEnvUtt_ty
  .conv _ _ _ (.sort (.succ .zero)) (.succ (.succ .zero))
    (.app _ _ _ _ _ hhead hidTt)
    (.trans _ _ (.app (.lam (.const 0 []) (.sort (.succ .zero))) (.const 1 []))
      (.sort (.succ .zero)) (.sort (.succ (.succ .zero)))
      (.app _ _ _ _ _ _ _
        (.refl _ _ _ trueEnvUM_ty)
        (.symm _ _ _ _ (.irr _ _ _ _ trueEnvUF_ty trueEnvUtt_ty hidTt)))
      trueEnvU_betaK)

/-- `TyConvT trueEnvU n trueEnvU_kVarCtx (.sort .zero) trueEnvU_kRecIdTt`. -/
