/-! ## §29. Exact `let`-Substitution Biconditional for `IsSemPropTyI`, Unconditional Two-Sided
Application/Spine Congruence for All Non-$\lambda$ Function Heads Under `PrunedSemEqDIK`, and
Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Supply (`TypedSubst0CongrSupplyLet1MajSemBi`) -/

/-! ### §29.1. Exact `let`-Substitution Biconditional for `IsSemPropTyI` (`isSemPropTyI_substLet0_iff`)
and `PrunedSemEqDIK` Function-Head Application/Spine Transfer
(`approxDIK_ctxEnvDIK_app_fn_iff_of_prunedSemEqDIK`, `approxDIK_ctxEnvDIK_foldApps_fn_iff_of_prunedSemEqDIK`) -/

/-- **Declarative Conversion Between `lift 0 1 (instantiate0 v B)` and `B` in `.letBinding A v :: Γ`
    (`convT_letBinding_type_lift0_instantiate0`):**
    Combines `ConvT.zeta` at `lift 0 1 v`, `ConvT.letE` along `ConvT.zetaLocal` (`lift 0 1 v ↔ .bvar 0`),
    and `ConvT.zeta` at `.bvar 0` (`instantiate0 (.bvar 0) (lift 1 1 B) = B`)! -/
def convT_letBinding_type_lift0_instantiate0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w)) :
    ConvT E n (.letBinding A v :: Γ) (lift 0 1 (instantiate0 v B)) B (.sort w) := by
  have hcl := envClosed_of_envWfT hW
  have hA_wk : HasTyT E n (.letBinding A v :: Γ) (lift 0 1 A) (.sort u) :=
    hasTyTWeaken (.letBinding A v) hcl (c := 0) hA
  have hv_wk : HasTyT E n (.letBinding A v :: Γ) (lift 0 1 v) (lift 0 1 A) :=
    hasTyTWeaken (.letBinding A v) hcl (c := 0) hv
  have hbv0 : HasTyT E n (.letBinding A v :: Γ) (.bvar 0) (lift 0 1 A) :=
    .bvar (.letBinding A v :: Γ) 0 (lift 0 1 A) rfl
  have hzl : ConvT E n (.letBinding A v :: Γ) (lift 0 1 v) (.bvar 0) (lift 0 1 A) :=
    ConvT.symm _ _ _ _ (.zetaLocal (.letBinding A v :: Γ) 0 (lift 0 1 A) (lift 0 1 v) rfl rfl hv_wk)
  have hB_wk1 : HasTyT E n (.letBinding (lift 0 1 A) (lift 0 1 v) :: .letBinding A v :: Γ)
      (lift 1 1 B) (.sort w) :=
    hasTyTWeaken (.letBinding A v) hcl (c := 1) hB
  have hB_wk1_bv0 : HasTyT E n (.letBinding (lift 0 1 A) (.bvar 0) :: .letBinding A v :: Γ)
      (lift 1 1 B) (.sort w) :=
    hasTyT_letBinding_conv_val hW hA_wk hbv0 hzl hB_wk1
  have hz₁ : ConvT E n (.letBinding A v :: Γ)
      (.letE (lift 0 1 A) (lift 0 1 v) (lift 1 1 B))
      (instantiate0 (lift 0 1 v) (lift 1 1 B)) (.sort w) :=
    .zeta (.letBinding A v :: Γ) (lift 0 1 A) (lift 0 1 v) (lift 1 1 B) (.sort w) u
      hA_wk hv_wk hB_wk1
  have heq₁ : lift 0 1 (instantiate0 v B) = instantiate0 (lift 0 1 v) (lift 1 1 B) :=
    lift_instantiate_low 1 0 0 v (Nat.le_refl 0) B
  rw [← heq₁] at hz₁
  have hc_let : ConvT E n (.letBinding A v :: Γ)
      (.letE (lift 0 1 A) (lift 0 1 v) (lift 1 1 B))
      (.letE (lift 0 1 A) (.bvar 0) (lift 1 1 B)) (.sort w) :=
    .letE (.letBinding A v :: Γ) (lift 0 1 A) (lift 0 1 A) (lift 0 1 v) (.bvar 0)
      (lift 1 1 B) (lift 1 1 B) (.sort w) u
      (.refl _ (lift 0 1 A) (.sort u) hA_wk) hzl
      (.refl _ (lift 1 1 B) (.sort w) hB_wk1)
  have hz₂ : ConvT E n (.letBinding A v :: Γ)
      (.letE (lift 0 1 A) (.bvar 0) (lift 1 1 B))
      (instantiate0 (.bvar 0) (lift 1 1 B)) (.sort w) :=
    .zeta (.letBinding A v :: Γ) (lift 0 1 A) (.bvar 0) (lift 1 1 B) (.sort w) u
      hA_wk hbv0 hB_wk1_bv0
  rw [instantiate0_bvar0_lift1 B] at hz₂
  exact .trans _ _ _ _ _ (.symm _ _ _ _ hz₁) (.trans _ _ _ _ _ hc_let hz₂)

/-- `TyConvT` wrapper for `convT_letBinding_type_lift0_instantiate0`
    (`tyConvT_letBinding_lift0_instantiate0`). -/
def tyConvT_letBinding_lift0_instantiate0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w)) :
    TyConvT E n (.letBinding A v :: Γ) (lift 0 1 (instantiate0 v B)) B :=
  .of _ _ _ w (convT_letBinding_type_lift0_instantiate0 hW hA hv hB)

/-- **Inverse Head `let`-Substitution for `IsSemPropTyI` (`isSemPropTyI_of_substLet0`):**
    Whenever `IsSemPropTyI E n Γ (instantiate0 v B)` holds for a sort-typed `B` in
    `.letBinding A v :: Γ`, `IsSemPropTyI E n (.letBinding A v :: Γ) B` holds with
    **zero `SortRow` and zero `PiRowField`**! -/
theorem isSemPropTyI_of_substLet0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w))
    (hPA : IsSemPropTyI E n Γ (instantiate0 v B)) :
    IsSemPropTyI E n (.letBinding A v :: Γ) B := by
  have hcl := envClosed_of_envWfT hW
  rcases isSemPropTyI_weaken0 hcl (.letBinding A v) hPA with ⟨⟨P', ⟨hP'⟩, ⟨hcP'⟩⟩, _⟩
  refine ⟨⟨P', ⟨hP'⟩, ⟨.trans _ _ _ _ hcP'
    (tyConvT_letBinding_lift0_instantiate0 hW hA hv hB)⟩⟩, ?_⟩
  intro hsort
  exact hPA.2 ((approxDIK_ctxEnvDIK_substLet0_iff E A v Γ B .sort).mpr hsort)

/-- **Exact Head `let`-Substitution Biconditional (`↔`) for `IsSemPropTyI`
    (`isSemPropTyI_substLet0_iff`):**
    Requires **zero `SortRow` and zero `PiRowField`**! -/
theorem isSemPropTyI_substLet0_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w)) :
    IsSemPropTyI E n (.letBinding A v :: Γ) B ↔ IsSemPropTyI E n Γ (instantiate0 v B) :=
  ⟨isSemPropTyI_substLet0 hW hv, isSemPropTyI_of_substLet0 hW hA hv hB⟩

/-- **Function-Head Application Transfer of `ApproxDIK` Under `PrunedSemEqDIK`
    (`approxDIK_ctxEnvDIK_app_fn_iff_of_prunedSemEqDIK`):**
    Whenever `hf : PrunedSemEqDIK E (ctxEnvDIK E Γ) f₁ f₂`, for **every** argument `a : Expr Nat`
    and **every** `PrunedPiCpt c`:
    `ApproxDIK E (ctxEnvDIK E Γ) (.app f₁ a) c ↔ ApproxDIK E (ctxEnvDIK E Γ) (.app f₂ a) c`! -/
theorem approxDIK_ctxEnvDIK_app_fn_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    {f₁ f₂ : Expr Nat} (hf : PrunedSemEqDIK E (ctxEnvDIK E Γ) f₁ f₂)
    (a : Expr Nat) {c : CptI} (hc : PrunedPiCpt c) :
    ApproxDIK E (ctxEnvDIK E Γ) (.app f₁ a) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (.app f₂ a) c := by
  have h :=
    approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hf (.app (.bvar 0) (lift 0 1 a)) hc
  rwa [instantiate0_app_bvar0_lift0 f₁ a, instantiate0_app_bvar0_lift0 f₂ a] at h

/-- Mapping `instantiate0 f` after `lift 0 1` cancels on every argument list
    (`map_instantiate0_map_lift0`). -/
theorem map_instantiate0_map_lift0 (f : Expr Nat) :
    ∀ (args : List (Expr Nat)), (args.map (lift 0 1)).map (instantiate0 f) = args
  | [] => rfl
  | a :: args => by
      simp only [List.map, instantiate0]
      have ha : instantiate 0 f (lift 0 1 a) = a :=
        (instantiate_lift_cancel 1 0 0 f (Nat.le_refl 0) Nat.zero_lt_one a).trans (lift_zero 0 a)
      rw [ha]
      exact congrArg (a :: ·) (map_instantiate0_map_lift0 f args)

/-- Instantiating index `0` with `f` in `foldApps (.bvar 0) (args.map (lift 0 1))` produces
    `foldApps f args` (`instantiate0_foldApps_bvar0_map_lift0`). -/
theorem instantiate0_foldApps_bvar0_map_lift0 (f : Expr Nat) (args : List (Expr Nat)) :
    instantiate0 f (foldApps (.bvar 0) (args.map (lift 0 1))) = foldApps f args := by
  rw [instantiate0_foldApps_bvar0, map_instantiate0_map_lift0]

/-- **Multi-Argument Spine Function-Head Transfer of `ApproxDIK` Under `PrunedSemEqDIK`
    (`approxDIK_ctxEnvDIK_foldApps_fn_iff_of_prunedSemEqDIK`):**
    Whenever `hf : PrunedSemEqDIK E (ctxEnvDIK E Γ) f₁ f₂`, for **every** argument spine
    `args : List (Expr Nat)` and **every** `PrunedPiCpt c`:
    `ApproxDIK E (ctxEnvDIK E Γ) (foldApps f₁ args) c ↔ ApproxDIK E (ctxEnvDIK E Γ) (foldApps f₂ args) c`! -/
theorem approxDIK_ctxEnvDIK_foldApps_fn_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    {f₁ f₂ : Expr Nat} (hf : PrunedSemEqDIK E (ctxEnvDIK E Γ) f₁ f₂)
    (args : List (Expr Nat)) {c : CptI} (hc : PrunedPiCpt c) :
    ApproxDIK E (ctxEnvDIK E Γ) (foldApps f₁ args) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps f₂ args) c := by
  have h :=
    approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hf
      (foldApps (.bvar 0) (args.map (lift 0 1))) hc
  rwa [instantiate0_foldApps_bvar0_map_lift0 f₁ args,
       instantiate0_foldApps_bvar0_map_lift0 f₂ args] at h

