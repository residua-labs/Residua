/-! ## §16. General Target-Reduction $\Pi$-Head `TyConvT` Extraction, Full 3-Branch 0-Instantiation
Congruence Removing `hv_nolam` (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general`), and
Unconditional 3-Probe 0-Instantiation Congruence for $\lambda$-Abstractions Over Sorts, Rigid
Spines, and $\Pi$-Types -/

/-! ### §16.1. General Target-Reduction $\Pi$-Head `TyConvT` Extraction and Full 3-Branch
0-Instantiation Congruence Removing `hv_nolam` -/

/-- **General Target-Reduction $\Pi$-Head `TyConvT` Extraction
    (`pi_tyConv_of_whRedPiKClosedCtx_to_target`):**
    Generalizes §13.3's `pi_tyConv_of_whRedPiKClosedCtx_to_val`: whenever `M₁ ↠wh N₁` and
    `M₂ ↠wh N₂` in `WhRedPiKClosedCtx E Γ`, normal-form confluence
    `whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal` shows `N₁ ↠wh .pi P₁ Q₁` and `N₂ ↠wh .pi P₂ Q₂`,
    so `hlr_N : ApproxDIK E (ctxEnvDIK E Γ) N₁ (.pi .bot []) → LRTypeINPiKClosedCtx E n Γ N₁ N₂ (.pi .bot [])`
    yields `TyConvT` between `(P₁, Q₁)` and `(P₂, Q₂)` directly! -/
theorem pi_tyConv_of_whRedPiKClosedCtx_to_target {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {M₁ M₂ N₁ N₂ P₁ Q₁ P₂ Q₂ : Expr Nat}
    (hlr_N : ApproxDIK E (ctxEnvDIK E Γ) N₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ N₁ N₂ (.pi .bot []))
    (h₁_N : WhRedPiKClosedCtx E Γ M₁ N₁)
    (h₂_N : WhRedPiKClosedCtx E Γ M₂ N₂)
    (hred₁ : WhRedPiKClosedCtx E Γ M₁ (.pi P₁ Q₁))
    (hred₂ : WhRedPiKClosedCtx E Γ M₂ (.pi P₂ Q₂)) :
    Nonempty (TyConvT E n Γ P₁ P₂) ∧ Nonempty (TyConvT E n (.assumption P₁ :: Γ) Q₁ Q₂) := by
  have hN₁_pi : WhRedPiKClosedCtx E Γ N₁ (.pi P₁ Q₁) :=
    whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal hW h₁_N hred₁
      (whNormalPiKClosedCtx_pi E Γ P₁ Q₁)
  have hN₂_pi : WhRedPiKClosedCtx E Γ N₂ (.pi P₂ Q₂) :=
    whRedPiKClosedCtx_of_whRedPiKClosedCtx_normal hW h₂_N hred₂
      (whNormalPiKClosedCtx_pi E Γ P₂ Q₂)
  have hN₁_approx : ApproxDIK E (ctxEnvDIK E Γ) N₁ (.pi .bot []) :=
    approxDIK_ctxEnvDIK_whRedPiKClosedCtx_back hW hN₁_pi
      (.pi (.bot _ _) (fun _ hs => (List.not_mem_nil _ hs).elim))
  cases hlr_N hN₁_approx with
  | pi h1 h2 _ hcA hcB _ _ =>
      obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hN₁_pi h1
      obtain ⟨rfl, rfl⟩ := whRedPiKClosedCtx_pi_unique_of_envWfT hW hN₂_pi h2
      exact ⟨⟨hcA⟩, ⟨hcB⟩⟩

/-- **Unified 3-Branch $\Pi$-Head `TyConvT` Extraction Under `PrunedSemEqDIK` Removing `hv_nolam`
    (`pi_tyConv_subst0_of_prunedSemEqDIK_general`):**
    Upgrades §13.3's `pi_tyConv_subst0_of_prunedSemEqDIK_no_lam` by dropping `hv_nolam` and
    handling **both** Branch 2 (`args = []`) and Branch 3 (`args = arg₀ :: rest`) of
    `whRedPiKClosedCtx_letBinding_dichotomy` uniformly via `pi_tyConv_of_whRedPiKClosedCtx_to_target`! -/
theorem pi_tyConv_subst0_of_prunedSemEqDIK_general {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {A v₁ v₂ b D₁ D₂ P₁ Q₁ P₂ Q₂ : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hlr_sp : ∀ args : List (Expr Nat),
      WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (foldApps (.bvar 0) args) →
      WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (foldApps (.bvar 0) args) →
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (args.map (instantiate0 v₁))) (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ
        (foldApps v₁ (args.map (instantiate0 v₁)))
        (foldApps v₂ (args.map (instantiate0 v₂)))
        (.pi .bot []))
    (hred_b : WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂))
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (hred₁ : WhRedPiKClosedCtx E Γ (instantiate0 v₁ b) (.pi P₁ Q₁))
    (hred₂ : WhRedPiKClosedCtx E Γ (instantiate0 v₂ b) (.pi P₂ Q₂)) :
    Nonempty (TyConvT E n Γ P₁ P₂) ∧ Nonempty (TyConvT E n (.assumption P₁ :: Γ) Q₁ Q₂) := by
  have hcl := envClosed_of_envWfT hW
  rcases whRedPiKClosedCtx_letBinding_dichotomy A A hv_sem hred_b with hred_b₂ | ⟨args, hm₁, hm₂, _⟩
  · obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := hb_wf2 D₁ D₂ hred_b
    exact pi_tyConv_of_whRedPiKClosedCtx_same_pi hW hA hv₁ hv₂ hcv hD₁ hD₂
      (whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₁ hred_b)
      (whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₂ hred_b₂)
      hred₁ hred₂
  · have hsub₁ := whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₁ hm₁
    have hsub₂ := whRedPiKClosedCtx_substLet0_of_envClosed hcl A v₂ hm₂
    rw [instantiate0_foldApps_bvar0] at hsub₁ hsub₂
    exact pi_tyConv_of_whRedPiKClosedCtx_to_target hW (hlr_sp args hm₁ hm₂)
      hsub₁ hsub₂ hred₁ hred₂

/-- **Core 3-Branch 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}`
    Removing `hv_nolam` (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general_core`):**
    Requires **zero** `hSort` premise and **zero** `hv_nolam` premise! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general_core
    {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hlr_sp : ∀ args : List (Expr Nat),
      WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (foldApps (.bvar 0) args) →
      WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (foldApps (.bvar 0) args) →
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (args.map (instantiate0 v₁))) (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ
        (foldApps v₁ (args.map (instantiate0 v₁)))
        (foldApps v₂ (args.map (instantiate0 v₂)))
        (.pi .bot []))
    (hb_pi : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) →
      IsPropTyI E n Γ (instantiate0 v₁ B) ∨
        ∃ D₁ D₂, WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂))
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B))
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hsem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) (instantiate0 v₂ b) :=
    prunedSemEqDIK_instantiate0_of_prunedSemEqDIK (prunedEnvLe_ctxEnvDIK E Γ) hv_sem b
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hM₁ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c :=
    hor.elim id (fun h => (hsem c hc_p).mpr h)
  have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₂ b) c :=
    (hsem c hc_p).mp hM₁
  cases hc with
  | bot =>
      exact Or.inr (by rw [lrTermDSubKClosedCtxCore_bot_iff]; trivial)
  | sort =>
      rcases h₁ .sort .sort (Or.inl hM₁) with hP | hC₁
      · exact Or.inl hP
      · rcases h₂ .sort .sort (Or.inl hM₂) with hP | hC₂
        · exact Or.inl hP
        · rw [lrTermDSubKClosedCtxCore_sort_iff] at hC₁ hC₂
          rcases hC₁ with ⟨hT, hlr₁⟩
          rcases hC₂ with ⟨_, hlr₂⟩
          cases hlr₁ with
          | sort hred₁ _ =>
              cases hlr₂ with
              | sort hred₂ _ =>
                  refine Or.inr ?_
                  rw [lrTermDSubKClosedCtxCore_sort_iff]
                  exact ⟨hT, .sort hred₁ hred₂⟩
  | piBotNil =>
      rcases h₁ (.pi .bot []) .piBotNil (Or.inl hM₁) with hP | hC₁
      · exact Or.inl hP
      · rcases h₂ (.pi .bot []) .piBotNil (Or.inl hM₂) with hP | hC₂
        · exact Or.inl hP
        · have hb_approx : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) :=
            (approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ b (.pi .bot [])).mp hM₁
          rcases hb_pi hb_approx with hP | ⟨D₁, D₂, hred_b⟩
          · exact Or.inl hP
          · have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
            rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC₁ hC₂
            rcases hC₁ with ⟨hT, hlr₁⟩
            rcases hC₂ with ⟨_, hlr₂⟩
            cases hlr₁ with
            | @pi _ _ _ P₁ Q₁ _ _ _ _ hred₁ _ hΓ₁ _ _ _ _ =>
                cases hlr₂ with
                | @pi _ _ _ P₂ Q₂ _ _ _ _ hred₂ _ _ _ _ _ _ =>
                    obtain ⟨⟨hcA⟩, ⟨hcB⟩⟩ := pi_tyConv_subst0_of_prunedSemEqDIK_general
                      hW hA hv₁ hv₂ hcv hv_sem hlr_sp hred_b hb_wf2 hred₁ hred₂
                    refine Or.inr ?_
                    rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne]
                    exact ⟨hT, .pi hred₁ hred₂ hΓ₁ hcA hcB (.bot Γ P₁ P₂)
                      (fun _ hs => (List.not_mem_nil _ hs).elim)⟩

/-- **Full 3-Branch 0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}`
    Removing `hv_nolam` (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general`):**
    Upgrades §13.3's `lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam` by removing `hv_nolam`
    entirely and closing **all three branches** of `whRedPiKClosedCtx_substLet0_trichotomy` across
    all 3 probes `{.bot, .sort, .pi .bot []}` (applying to $\lambda$-abstractions as well as
    non-$\lambda$ arguments!). -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hlr_sp : ∀ args : List (Expr Nat),
      WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (foldApps (.bvar 0) args) →
      WhRedPiKClosedCtx E (.letBinding A v₂ :: Γ) b (foldApps (.bvar 0) args) →
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (args.map (instantiate0 v₁))) (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ
        (foldApps v₁ (args.map (instantiate0 v₁)))
        (foldApps v₂ (args.map (instantiate0 v₂)))
        (.pi .bot []))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have h₁ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B) :=
    lrTermDSubKClosedCtxBi_substLet0 hW hSort hΓ hv₁ hb_let
  have hb_pi : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b (.pi .bot []) →
      IsPropTyI E n Γ (instantiate0 v₁ B) ∨
        ∃ D₁ D₂, WhRedPiKClosedCtx E (.letBinding A v₁ :: Γ) b (.pi D₁ D₂) := by
    intro hb_approx
    rcases hb_let (.pi .bot []) .piBotNil (Or.inl hb_approx) with hP_let | hC_let
    · exact Or.inl (isPropTyI_substLet0_of_sortRow hW hSort hv₁ hP_let)
    · have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      rw [lrTermDSubKClosedCtxCore_probe_nonbot_iff .piBotNil hne] at hC_let
      cases hC_let.2 with
      | pi hred_b _ _ _ _ _ _ => exact Or.inr ⟨_, _, hred_b⟩
  exact lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general_core
    hW hA hv₁ hv₂ hcv hv_sem hlr_sp hb_pi hb_wf2 h₁ h₂

/-- **0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` Replacing
    `hv_nolam` by Non-$\Pi$ on Positive-Arity Applications
    (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_pos_app_pi`):**
    Strictly weakens `hv_nolam` in §13.3's `lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_lam`
    to `hv_noapp_pi : ∀ arg₀ rest, ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (arg₀ :: rest)) (.pi .bot [])`,
    which holds not only for all non-`.lam` expressions (`approxDIK_foldApps_not_pi_of_not_lam`),
    but also for $\lambda$-abstractions over sorts, rigid-constant spines, andassumption spines! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_pos_app_pi
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_noapp_pi : ∀ (arg₀ : Expr Nat) (rest : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (arg₀ :: rest)) (.pi .bot []))
    (hlr_v : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) →
      LRTypeINPiKClosedCtx E n Γ v₁ v₂ (.pi .bot []))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  refine lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_general
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem ?_ hb_let hb_wf2 h₂
  intro args _ _ happrox
  cases args with
  | nil => exact hlr_v happrox
  | cons arg₀ rest =>
      exact (hv_noapp_pi (instantiate0 v₁ arg₀) (rest.map (instantiate0 v₁)) happrox).elim

/-- **0-Instantiation Value Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` When Neither
    `v₁` Nor Any Positive-Arity Application of `v₁` Approximates `.pi .bot []`
    (`lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_all_app_pi`):**
    Requires **zero** `hv_nolam` and **zero** `hlr_v`! -/
theorem lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_all_app_pi
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []))
    (hv_noapp_pi : ∀ (arg₀ : Expr Nat) (rest : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ (arg₀ :: rest)) (.pi .bot []))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A v₁ :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_pos_app_pi
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem hv_noapp_pi (fun h => (hv_nopi h).elim) hb_let hb_wf2 h₂

/-! ### §16.2. Unconditional `PrunedSemEqDIK`, Non-$\Pi$ Spine Exclusions, and Full 3-Probe
0-Instantiation Congruence for $\lambda$-Abstractions Over Sorts, Rigid Spines, and $\Pi$-Types -/

/-- Every $\lambda$-abstraction `.lam A b` has no `.pi d s` compact in `ApproxDIK E ρ`. -/
theorem approxDIK_lam_not_pi {E : ResolvedEnv} {ρ : EnvI} (A b : Expr Nat)
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E ρ (.lam A b) (.pi d s) := by
  intro h
  rcases approxDIK_lam_inv h with h0 | ⟨_, h0, _⟩ <;> cases h0

/-- Any applied $\lambda$-abstraction `foldApps (.lam A b) (a :: args)` takes a head $\beta$-step in
    `WhStepPiKClosedCtx E Γ` to `foldApps (instantiate0 a b) args`. -/
theorem whStepPiKClosedCtx_foldApps_lam_cons (E : ResolvedEnv) (Γ : LCtx)
    (A b a : Expr Nat) (args : List (Expr Nat)) :
    WhStepPiKClosedCtx E Γ (foldApps (.lam A b) (a :: args)) (foldApps (instantiate0 a b) args) :=
  whStepPiKClosedCtx_foldApps (.of_whStep (.beta A b a)) args

/-- Any applied $\lambda$-abstraction `foldApps (.lam A b) (a :: args)` weak-head reduces in
    `WhRedPiKClosedCtx E Γ` to `foldApps (instantiate0 a b) args`. -/
theorem whRedPiKClosedCtx_foldApps_lam_cons (E : ResolvedEnv) (Γ : LCtx)
    (A b a : Expr Nat) (args : List (Expr Nat)) :
    WhRedPiKClosedCtx E Γ (foldApps (.lam A b) (a :: args)) (foldApps (instantiate0 a b) args) :=
  .step (whStepPiKClosedCtx_foldApps_lam_cons E Γ A b a args) (.refl _)

/-- Under `EnvWfT E`, `ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A b) (a :: args)) c` is
    equivalent (`↔`) to `ApproxDIK E (ctxEnvDIK E Γ) (foldApps (instantiate0 a b) args) c`. -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_cons_iff {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    (A b a : Expr Nat) (args : List (Expr Nat)) (c : CptI) :
    ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A b) (a :: args)) c ↔
      ApproxDIK E (ctxEnvDIK E Γ) (foldApps (instantiate0 a b) args) c :=
  semEqDIK_ctxEnvDIK_whStepPiKClosedCtx hW (whStepPiKClosedCtx_foldApps_lam_cons E Γ A b a args) c

/-- If `hd` has neither `.lam g` nor `.pi d s` in `ApproxDIK E ρ`, then `foldApps hd args` has no
    `.pi d s` compact in `ApproxDIK E ρ` for **any** `args : List (Expr Nat)` (`[]` or `a :: args'`). -/
theorem approxDIK_foldApps_not_pi_of_not_lam_not_pi {E : ResolvedEnv} {ρ : EnvI} {hd : Expr Nat}
    (hhd_lam : ∀ g, ¬ ApproxDIK E ρ hd (.lam g))
    (hhd_pi : ∀ d s, ¬ ApproxDIK E ρ hd (.pi d s)) :
    ∀ (args : List (Expr Nat)) (d : CptI) (s : List (List CptI × CptI)),
      ¬ ApproxDIK E ρ (foldApps hd args) (.pi d s)
  | [], d, s => hhd_pi d s
  | a :: args, d, s => approxDIK_foldApps_not_pi_of_not_lam hhd_lam a args d s

/-- Under `EnvWfT E`, if `instantiate0 a b` has neither `.lam g` nor `.pi d s` in
    `ApproxDIK E (ctxEnvDIK E Γ)`, then `foldApps (.lam A b) (a :: args)` has no `.pi d s` compact
    in `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_cons_not_pi_of_body {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A b a : Expr Nat) (args : List (Expr Nat))
    (hb_lam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b) (.lam g))
    (hb_pi : ∀ d s, ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b) (.pi d s))
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A b) (a :: args)) (.pi d s) := by
  rw [approxDIK_ctxEnvDIK_foldApps_lam_cons_iff hW A b a args (.pi d s)]
  exact approxDIK_foldApps_not_pi_of_not_lam_not_pi hb_lam hb_pi args d s

/-- Under `EnvWfT E`, any positive-arity application `foldApps (.lam A (.sort l)) (a :: args)` of a
    $\lambda$-abstraction over a sort `.sort l` has no `.pi d s` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_sort_not_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A : Expr Nat) (l : Level) (a : Expr Nat) (args : List (Expr Nat))
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A (.sort l)) (a :: args)) (.pi d s) :=
  approxDIK_ctxEnvDIK_foldApps_lam_cons_not_pi_of_body hW A (.sort l) a args
    (approxDIK_sort_not_lam l) (approxDIK_sort_not_pi l) d s

/-- Under `EnvWfT E`, any positive-arity application
    `foldApps (.lam A (foldApps (.const r ls) cargs)) (a :: args)` of a $\lambda$-abstraction over a
    rigid-constant spine (`m.body = none`, `m.mclass ≠ .recursorM`) has no `.pi d s` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_rigidConst_not_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none) (hnrec : m.mclass ≠ .recursorM)
    (A : Expr Nat) (cargs : List (Expr Nat)) (a : Expr Nat) (args : List (Expr Nat))
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ)
      (foldApps (.lam A (foldApps (.const r ls) cargs)) (a :: args)) (.pi d s) := by
  refine approxDIK_ctxEnvDIK_foldApps_lam_cons_not_pi_of_body hW A
    (foldApps (.const r ls) cargs) a args ?_ ?_ d s
  · intro g
    rw [show instantiate0 a (foldApps (.const r ls) cargs) =
        foldApps (.const r ls) (cargs.map (instantiate0 a)) from
      instantiate_foldApps 0 a (.const r ls) cargs]
    exact approxDIK_foldApps_rigidConst_not_lam hm hb hnrec (cargs.map (instantiate0 a)) g
  · intro d' s'
    rw [show instantiate0 a (foldApps (.const r ls) cargs) =
        foldApps (.const r ls) (cargs.map (instantiate0 a)) from
      instantiate_foldApps 0 a (.const r ls) cargs]
    exact approxDIK_foldApps_rigidConst_not_pi hm hb hnrec (cargs.map (instantiate0 a)) d' s'

/-- Under `EnvWfT E`, any application `foldApps (.lam A (.pi D₁ D₂)) (a₁ :: a₂ :: args)` of a
    $\lambda$-abstraction over a $\Pi$-type to two or more arguments has no `.pi d s` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`. -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_pi_two_args_not_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A D₁ D₂ a₁ a₂ : Expr Nat) (args : List (Expr Nat))
    (d : CptI) (s : List (List CptI × CptI)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A (.pi D₁ D₂)) (a₁ :: a₂ :: args)) (.pi d s) := by
  rw [approxDIK_ctxEnvDIK_foldApps_lam_cons_iff hW A (.pi D₁ D₂) a₁ (a₂ :: args) (.pi d s)]
  exact approxDIK_foldApps_not_pi_of_not_lam
    (approxDIK_pi_not_lam (instantiate0 a₁ D₁) (instantiate 1 (lift 0 1 a₁) D₂))
    a₂ args d s

/-- Any two $\lambda$-abstractions over sorts `.lam A₁ (.sort l₁)` and `.lam A₂ (.sort l₂)` are
    unconditionally `PrunedSemEqDIK`-equal in any valuation `ρ`. -/
theorem prunedSemEqDIK_lam_sorts (E : ResolvedEnv) (ρ : EnvI)
    (A₁ A₂ : Expr Nat) (l₁ l₂ : Level) :
    PrunedSemEqDIK E ρ (.lam A₁ (.sort l₁)) (.lam A₂ (.sort l₂)) :=
  prunedSemEqDIK_lam A₁ A₂ (fun us _ => prunedSemEqDIK_sorts E (EnvI.cons (demand us) ρ) l₁ l₂)

/-- Any two $\lambda$-abstractions over $\Pi$-types `.lam A₁ (.pi D₁ C₁)` and `.lam A₂ (.pi D₂ C₂)`
    are unconditionally `PrunedSemEqDIK`-equal in any valuation `ρ`. -/
theorem prunedSemEqDIK_lam_pi (E : ResolvedEnv) (ρ : EnvI)
    (A₁ D₁ C₁ A₂ D₂ C₂ : Expr Nat) :
    PrunedSemEqDIK E ρ (.lam A₁ (.pi D₁ C₁)) (.lam A₂ (.pi D₂ C₂)) :=
  prunedSemEqDIK_lam A₁ A₂ (fun us _ => prunedSemEqDIK_pi E (EnvI.cons (demand us) ρ) D₁ C₁ D₂ C₂)

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    `PrunedSemEqDIK`-Equal $\lambda$-Abstractions Whose Instantiated Bodies Have Neither `.lam g`
    Nor `.pi d s` (`lrTermDSubKClosedCtxBi_subst0_lam_arg_of_body_no_lam_no_pi`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_lam_arg_of_body_no_lam_no_pi
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A₁ b₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (.lam A₁ b₁) A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ (.lam A₁ b₁) v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (.lam A₁ b₁) v₂)
    (hb_lam : ∀ a g, ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b₁) (.lam g))
    (hb_pi : ∀ a d s, ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b₁) (.pi d s))
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (.lam A₁ b₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (.lam A₁ b₁) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 (.lam A₁ b₁) B)) :
    LRTermDSubKClosedCtxBi E n Γ (instantiate0 (.lam A₁ b₁) b) (instantiate0 v₂ b) (instantiate0 (.lam A₁ b₁) B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_all_app_pi
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem
    (approxDIK_lam_not_pi A₁ b₁ .bot [])
    (fun arg₀ rest => approxDIK_ctxEnvDIK_foldApps_lam_cons_not_pi_of_body
      hW A₁ b₁ arg₀ rest (hb_lam arg₀) (hb_pi arg₀) .bot [])
    hb_let hb_wf2 h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    ANY Convertible $\lambda$-Abstractions Over Sorts (`lrTermDSubKClosedCtxBi_subst0_lam_sort_arg_all`):**
    Requires **zero** `PrunedSemEqDIK` premise (discharged automatically by `prunedSemEqDIK_lam_sorts`)
    and **zero** `hv_nolam` premise! -/
theorem lrTermDSubKClosedCtxBi_subst0_lam_sort_arg_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A A₁ A₂ b B : Expr Nat} {u l₁ l₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (.lam A₁ (.sort l₁)) A)
    (hv₂ : HasTyT E n Γ (.lam A₂ (.sort l₂)) A)
    (hcv : ConvT E n Γ (.lam A₁ (.sort l₁)) (.lam A₂ (.sort l₂)) A)
    (hb_let : LRTermDSubKClosedCtxBi E n (.letBinding A (.lam A₁ (.sort l₁)) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (.lam A₁ (.sort l₁)) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.lam A₂ (.sort l₂)) b) (instantiate0 (.lam A₂ (.sort l₂)) b)
      (instantiate0 (.lam A₁ (.sort l₁)) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.lam A₁ (.sort l₁)) b) (instantiate0 (.lam A₂ (.sort l₂)) b)
      (instantiate0 (.lam A₁ (.sort l₁)) B) :=
  lrTermDSubKClosedCtxBi_subst0_lam_arg_of_body_no_lam_no_pi
    hW hSort hΓ hA hv₁ hv₂ hcv
    (prunedSemEqDIK_lam_sorts E (ctxEnvDIK E Γ) A₁ A₂ l₁ l₂)
    (fun _ => approxDIK_sort_not_lam l₁)
    (fun _ => approxDIK_sort_not_pi l₁)
    hb_let hb_wf2 h₂

/-- **Unconditional 0-Instantiation Congruence Across ALL 3 Probes `{.bot, .sort, .pi .bot []}` for
    `PrunedSemEqDIK`-Equal $\lambda$-Abstractions Over Rigid-Constant Spines (Constructors, Inductive
    Formers, Axioms, `lrTermDSubKClosedCtxBi_subst0_lam_rigidConst_spine_arg_all`):** -/
theorem lrTermDSubKClosedCtxBi_subst0_lam_rigidConst_spine_arg_all
    {E : ResolvedEnv} (hW : EnvWfT E)
    (hSort : ∀ {Δ : LCtx} {l₁ l₂ : Level}, TyConvT E n Δ (.sort l₁) (.sort l₂) → eqN l₁ l₂)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hbody : m.body = none) (hnrec : m.mclass ≠ .recursorM)
    {cargs : List (Expr Nat)} {A A₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (.lam A₁ (foldApps (.const r ls) cargs)) A)
    (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ (.lam A₁ (foldApps (.const r ls) cargs)) v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (.lam A₁ (foldApps (.const r ls) cargs)) v₂)
    (hb_let : LRTermDSubKClosedCtxBi E n
      (.letBinding A (.lam A₁ (foldApps (.const r ls) cargs)) :: Γ) b b B)
    (hb_wf2 : LRPiWf2 E n (.letBinding A (.lam A₁ (foldApps (.const r ls) cargs)) :: Γ) b)
    (h₂ : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 v₂ b) (instantiate0 v₂ b)
      (instantiate0 (.lam A₁ (foldApps (.const r ls) cargs)) B)) :
    LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 (.lam A₁ (foldApps (.const r ls) cargs)) b) (instantiate0 v₂ b)
      (instantiate0 (.lam A₁ (foldApps (.const r ls) cargs)) B) :=
  lrTermDSubKClosedCtxBi_subst0_of_prunedSemEqDIK_no_all_app_pi
    hW hSort hΓ hA hv₁ hv₂ hcv hv_sem
    (approxDIK_lam_not_pi A₁ (foldApps (.const r ls) cargs) .bot [])
    (fun arg₀ rest => approxDIK_ctxEnvDIK_foldApps_lam_rigidConst_not_pi
      hW hm hbody hnrec A₁ cargs arg₀ rest .bot [])
    hb_let hb_wf2 h₂

/-! ## §17. Two-Sided Depth-0 and Depth-1 Sort-Typed Instantiation Congruence in `ConvT` (Zero
`PiInj`), Unconditional Application Congruence for $\lambda$-Abstractions Over Sorts and
$\Pi$-Types (`polyPi`), and Full 3-Probe 0-Instantiation Congruence for $\lambda$-Abstractions
Over $\Pi$-Types -/

/-! ### §17.1. Depth-1 Substitution (`hasTyT_subst1S` / `convT_subst1S`) and Two-Sided Depth-0
and Depth-1 Sort-Typed Instantiation Congruence in `ConvT` (Zero `PiInj`) -/

/-- Depth-1 assumption substitution on `HasTyT` (`hasTyT_subst1S`): instantiating slot `1` of
    `.assumption D :: .assumption t :: Γ` by `v : t` produces a typing in
    `.assumption (instantiate0 v D) :: Γ`. -/
def hasTyT_subst1S {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) {v t D : Expr Nat}
    {Γ : LCtx} {e A : Expr Nat}
    (h : HasTyT E n (.assumption D :: .assumption t :: Γ) e A)
    (hv : HasTyT E n Γ v t) :
    HasTyT E n (.assumption (instantiate0 v D) :: Γ)
      (instantiate 1 (lift 0 1 v) e) (instantiate 1 (lift 0 1 v) A) := by
  have hget1 : (LocalDecl.assumption D :: LocalDecl.assumption t :: Γ)[1]? =
      some (.assumption t) := by simp
  have hv' : HasTyT E n (.assumption (instantiate0 v D) :: Γ) (lift 0 1 v) (lift 0 1 t) :=
    hasTyTWeaken (.assumption (instantiate0 v D)) hcl (c := 0) hv
  have h1 := hasTyT_substS hcl hinst v t (j := 1) h hget1
    (by simpa only [substRemove_succ_cons, substRemove_zero_cons, instDecl,
          lift_zero, instantiate0] using hv')
  simpa only [substRemove_succ_cons, substRemove_zero_cons, instDecl,
    lift_zero, instantiate0] using h1

/-- Depth-1 assumption substitution on `ConvT` (`convT_subst1S`): instantiating slot `1` of
    `.assumption D :: .assumption t :: Γ` by `v : t` produces a conversion in
    `.assumption (instantiate0 v D) :: Γ`. -/
def convT_subst1S {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) {v t D : Expr Nat}
    {Γ : LCtx} {a b T : Expr Nat}
    (h : ConvT E n (.assumption D :: .assumption t :: Γ) a b T)
    (hv : HasTyT E n Γ v t) :
    ConvT E n (.assumption (instantiate0 v D) :: Γ)
      (instantiate 1 (lift 0 1 v) a) (instantiate 1 (lift 0 1 v) b)
      (instantiate 1 (lift 0 1 v) T) := by
  have hget1 : (LocalDecl.assumption D :: LocalDecl.assumption t :: Γ)[1]? =
      some (.assumption t) := by simp
  have hv' : HasTyT E n (.assumption (instantiate0 v D) :: Γ) (lift 0 1 v) (lift 0 1 t) :=
    hasTyTWeaken (.assumption (instantiate0 v D)) hcl (c := 0) hv
  have h1 := convT_substS hcl hinst v t (j := 1) h hget1
    (by simpa only [substRemove_succ_cons, substRemove_zero_cons, instDecl,
          lift_zero, instantiate0] using hv')
  simpa only [substRemove_succ_cons, substRemove_zero_cons, instDecl,
    lift_zero, instantiate0] using h1

/-- **Two-Sided Depth-0 Sort-Typed Instantiation Congruence in `ConvT` (`convT_inst0_twoSided_sort`):**
    Combines `convT_inst0_assumpCongr` (`v₁ ~ v₂` in `D₁`) with `convT_subst0S` (`D₁ ~ D₂` at `v₂`)
    to derive `ConvT E n Γ (instantiate0 v₁ D₁) (instantiate0 v₂ D₂) (.sort u₁)` with **zero `PiInj`**! -/
def convT_inst0_twoSided_sort {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ D₁ D₂ : Expr Nat} {u u₁ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hD₁ : HasTyT E n (.assumption A :: Γ) D₁ (.sort u₁))
    (hcD : ConvT E n (.assumption A :: Γ) D₁ D₂ (.sort u₁)) :
    ConvT E n Γ (instantiate0 v₁ D₁) (instantiate0 v₂ D₂) (.sort u₁) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have hc₁ : ConvT E n Γ (instantiate0 v₁ D₁) (instantiate0 v₂ D₁) (.sort u₁) :=
    convT_inst0_assumpCongr hW hΓ hA hv₁ hv₂ hcv hD₁
  have hc₂ : ConvT E n Γ (instantiate0 v₂ D₁) (instantiate0 v₂ D₂) (.sort u₁) :=
    convT_subst0S hcl hinst hcD hv₂
  exact .trans _ _ _ _ _ hc₁ hc₂

/-- **Two-Sided Depth-1 Codomain Instantiation Congruence in `ConvT` (`convT_inst1_twoSided_sort`):**
    Combines §12.2's `convT_inst1_sortCongr` (`v₁ ~ v₂` at depth 1 in `C₁`), `convT_subst1S`
    (`C₁ ~ C₂` at depth 1 at `v₂`), and `convT_tyConvT_head` along `instantiate0 v₁ D₁ ~ instantiate0 v₂ D₁`
    to derive `ConvT E n (.assumption (instantiate0 v₁ D₁) :: Γ) (instantiate 1 (lift 0 1 v₁) C₁)
    (instantiate 1 (lift 0 1 v₂) C₂) (.sort u₂)` — **with ZERO `PiInj` premise**! -/
def convT_inst1_twoSided_sort {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ D₁ C₁ C₂ : Expr Nat} {u u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hD₁ : HasTyT E n (.assumption A :: Γ) D₁ (.sort u₁))
    (hC₁ : HasTyT E n (.assumption D₁ :: .assumption A :: Γ) C₁ (.sort u₂))
    (hcC : ConvT E n (.assumption D₁ :: .assumption A :: Γ) C₁ C₂ (.sort u₂)) :
    ConvT E n (.assumption (instantiate0 v₁ D₁) :: Γ)
      (instantiate 1 (lift 0 1 v₁) C₁) (instantiate 1 (lift 0 1 v₂) C₂) (.sort u₂) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have hcD_arg : ConvT E n Γ (instantiate0 v₁ D₁) (instantiate0 v₂ D₁) (.sort u₁) :=
    convT_inst0_assumpCongr hW hΓ hA hv₁ hv₂ hcv hD₁
  have hc₁ : ConvT E n (.assumption (instantiate0 v₁ D₁) :: Γ)
      (instantiate 1 (lift 0 1 v₁) C₁) (instantiate 1 (lift 0 1 v₂) C₁) (.sort u₂) :=
    convT_inst1_sortCongr hcl hinst hA hv₁ hv₂ hcv hD₁ hC₁
  have hc₂_raw : ConvT E n (.assumption (instantiate0 v₂ D₁) :: Γ)
      (instantiate 1 (lift 0 1 v₂) C₁) (instantiate 1 (lift 0 1 v₂) C₂) (.sort u₂) :=
    convT_subst1S hcl hinst hcC hv₂
  have hc₂ : ConvT E n (.assumption (instantiate0 v₁ D₁) :: Γ)
      (instantiate 1 (lift 0 1 v₂) C₁) (instantiate 1 (lift 0 1 v₂) C₂) (.sort u₂) :=
    convT_tyConvT_head hW hΓ (.of Γ _ _ u₁ (.symm _ _ _ _ hcD_arg)) hc₂_raw
  exact .trans _ _ _ _ _ hc₁ hc₂

/-! ### §17.2. Unconditional Application Congruence in `LRTypeINPiKClosedCtx` and
`LRTermDSubKClosedCtxBi` for $\lambda$-Abstractions Over Sorts and $\Pi$-Types (`polyPi`),
and Full 3-Probe 0-Instantiation Congruence for $\lambda$-Abstractions Over $\Pi$-Types -/

/-- If `f ↠wh .lam A (.sort l)` in `WhRedPiKClosedCtx E Γ`, then `.app f v ↠wh .sort l` for any `v`. -/
theorem whRedPiKClosedCtx_app_lam_sort {E : ResolvedEnv} {Γ : LCtx} {f A : Expr Nat} {l : Level}
    (hf : WhRedPiKClosedCtx E Γ f (.lam A (.sort l))) (v : Expr Nat) :
    WhRedPiKClosedCtx E Γ (.app f v) (.sort l) :=
  whRedPiKClosedCtx_trans (whRedPiKClosedCtx_appHead hf)
    (.step (.of_whStep (.beta A (.sort l) v)) (.refl _))

/-- If `f ↠wh .lam A (.pi D C)` in `WhRedPiKClosedCtx E Γ`, then
    `.app f v ↠wh .pi (instantiate0 v D) (instantiate 1 (lift 0 1 v) C)` for any `v`. -/
theorem whRedPiKClosedCtx_app_lam_pi {E : ResolvedEnv} {Γ : LCtx} {f A D C : Expr Nat}
    (hf : WhRedPiKClosedCtx E Γ f (.lam A (.pi D C))) (v : Expr Nat) :
    WhRedPiKClosedCtx E Γ (.app f v)
      (.pi (instantiate0 v D) (instantiate 1 (lift 0 1 v) C)) :=
  whRedPiKClosedCtx_trans (whRedPiKClosedCtx_appHead hf)
    (.step (.of_whStep (.beta A (.pi D C) v)) (.refl _))

/-- Unconditional `LRTypeINPiKClosedCtx` at `.sort` for any applications `.app f₁ v₁` and `.app f₂ v₂`
    where `f₁ ↠wh .lam A₁ (.sort l₁)` and `f₂ ↠wh .lam A₂ (.sort l₂)`. -/
theorem lrTypeINPiKClosedCtx_app_lam_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f₁ f₂ A₁ A₂ : Expr Nat} {l₁ l₂ : Level}
    (hf₁ : WhRedPiKClosedCtx E Γ f₁ (.lam A₁ (.sort l₁)))
    (hf₂ : WhRedPiKClosedCtx E Γ f₂ (.lam A₂ (.sort l₂)))
    (v₁ v₂ : Expr Nat) :
    LRTypeINPiKClosedCtx E n Γ (.app f₁ v₁) (.app f₂ v₂) .sort :=
  .sort (whRedPiKClosedCtx_app_lam_sort hf₁ v₁) (whRedPiKClosedCtx_app_lam_sort hf₂ v₂)

/-- **Unconditional Two-Sided Application Congruence in `LRTermDSubKClosedCtxBi` for
    $\lambda$-Abstractions Over Sorts (`lrTermDSubKClosedCtxBi_app_lam_sort`):**
    Requires **zero** hypotheses on `v₁, v₂, A₁, A₂`! -/
theorem lrTermDSubKClosedCtxBi_app_lam_sort {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {f₁ f₂ A₁ A₂ : Expr Nat} {l₁ l₂ : Level}
    (hf₁ : WhRedPiKClosedCtx E Γ f₁ (.lam A₁ (.sort l₁)))
    (hf₂ : WhRedPiKClosedCtx E Γ f₂ (.lam A₂ (.sort l₂)))
    (v₁ v₂ : Expr Nat) :
    LRTermDSubKClosedCtxBi E n Γ (.app f₁ v₁) (.app f₂ v₂) (.sort (.succ l₁)) :=
  lrTermDSubKClosedCtxBi_whRedPiKClosedCtx_expand hW
    (whRedPiKClosedCtx_app_lam_sort hf₁ v₁)
    (whRedPiKClosedCtx_app_lam_sort hf₂ v₂)
    (lrTermDSubKClosedCtxBi_sorts Γ l₁ l₂)

/-- **Unconditional Two-Sided Application Congruence in `LRTypeINPiKClosedCtx` at `.pi .bot []` for
    $\lambda$-Abstractions Over $\Pi$-Types (`lrTypeINPiKClosedCtx_app_lam_pi`):**
    Requires **zero** semantic hypotheses on `v₁, v₂, D₁, D₂, C₁, C₂` and **zero** `PiInj`! -/
theorem lrTypeINPiKClosedCtx_app_lam_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ A₁ A₂ D₁ C₁ D₂ C₂ v₁ v₂ : Expr Nat} {u u₁ u₂ : Level}
    (hf₁ : WhRedPiKClosedCtx E Γ f₁ (.lam A₁ (.pi D₁ C₁)))
    (hf₂ : WhRedPiKClosedCtx E Γ f₂ (.lam A₂ (.pi D₂ C₂)))
    (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A₁) (hv₂ : HasTyT E n Γ v₂ A₁)
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hD₁ : HasTyT E n (.assumption A₁ :: Γ) D₁ (.sort u₁))
    (hC₁ : HasTyT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ (.sort u₂))
    (hcD : ConvT E n (.assumption A₁ :: Γ) D₁ D₂ (.sort u₁))
    (hcC : ConvT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ C₂ (.sort u₂)) :
    LRTypeINPiKClosedCtx E n Γ (.app f₁ v₁) (.app f₂ v₂) (.pi .bot []) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have hΓ₁ : CtxWfT E n (.assumption (instantiate0 v₁ D₁) :: Γ) :=
    .assumption Γ _ u₁ hΓ (hasTyT_subst0S hcl hinst hD₁ hv₁)
  exact .pi
    (whRedPiKClosedCtx_app_lam_pi hf₁ v₁)
    (whRedPiKClosedCtx_app_lam_pi hf₂ v₂)
    hΓ₁
    (.of Γ _ _ u₁ (convT_inst0_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hcD))
    (.of _ _ _ u₂ (convT_inst1_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hC₁ hcC))
    (.bot Γ _ _)
    (fun _ hs => (List.not_mem_nil _ hs).elim)

/-- **Unconditional Two-Sided Application Congruence in `LRTermDSubKClosedCtxBi` Across ALL 3
    Probes `{.bot, .sort, .pi .bot []}` for $\lambda$-Abstractions Over $\Pi$-Types
    (`lrTermDSubKClosedCtxBi_app_lam_pi`):**
    Applies to any type-valued $\Pi$-family `λ (x : Aᵢ) => Π (y : Dᵢ), Cᵢ` (including `polyPi`),
    even when `v₁, v₂` or `Dᵢ, Cᵢ` contain `ConvT.irr` or `ConvT.eta`! -/
theorem lrTermDSubKClosedCtxBi_app_lam_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ A₁ A₂ D₁ C₁ D₂ C₂ v₁ v₂ : Expr Nat} {u u₁ u₂ : Level}
    (hf₁ : WhRedPiKClosedCtx E Γ f₁ (.lam A₁ (.pi D₁ C₁)))
    (hf₂ : WhRedPiKClosedCtx E Γ f₂ (.lam A₂ (.pi D₂ C₂)))
    (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A₁) (hv₂ : HasTyT E n Γ v₂ A₁)
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hD₁ : HasTyT E n (.assumption A₁ :: Γ) D₁ (.sort u₁))
    (hC₁ : HasTyT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ (.sort u₂))
    (hcD : ConvT E n (.assumption A₁ :: Γ) D₁ D₂ (.sort u₁))
    (hcC : ConvT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ C₂ (.sort u₂)) :
    LRTermDSubKClosedCtxBi E n Γ (.app f₁ v₁) (.app f₂ v₂) (.sort (.imax u₁ u₂)) := by
  have hcl := envClosed_of_envWfT hW
  have hinst := envMembersSubstStable_of_envWfT hW
  have hΓ₁ : CtxWfT E n (.assumption (instantiate0 v₁ D₁) :: Γ) :=
    .assumption Γ _ u₁ hΓ (hasTyT_subst0S hcl hinst hD₁ hv₁)
  exact lrTermDSubKClosedCtxBi_whRedPiKClosedCtx_expand hW
    (whRedPiKClosedCtx_app_lam_pi hf₁ v₁)
    (whRedPiKClosedCtx_app_lam_pi hf₂ v₂)
    (lrTermDSubKClosedCtxBi_pi hΓ₁
      (.of Γ _ _ u₁ (convT_inst0_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hcD))
      (.of _ _ _ u₂ (convT_inst1_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hC₁ hcC)))

/-- **Positive Resolution of the `polyPi` Benchmark Under Two-Sided Application in
    `LRTermDSubKClosedCtxBi` (`lrTermDSubKClosedCtxBi_polyPi_app`):**
    For `polyPi = .lam (.sort (.succ .zero)) (.pi (.bvar 0) (.bvar 1))` (`fun (X : Sort 1) => X → X`)
    and **any** convertible types `X₁, X₂ : .sort (.succ .zero)` in `Γ`,
    `LRTermDSubKClosedCtxBi E n Γ (.app polyPi X₁) (.app polyPi X₂) (.sort (.imax (.succ .zero) (.succ .zero)))`
    holds unconditionally across all 3 probes `{.bot, .sort, .pi .bot []}`! -/
theorem lrTermDSubKClosedCtxBi_polyPi_app {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {X₁ X₂ : Expr Nat}
    (hX₁ : HasTyT E n Γ X₁ (.sort (.succ .zero)))
    (hX₂ : HasTyT E n Γ X₂ (.sort (.succ .zero)))
    (hcX : ConvT E n Γ X₁ X₂ (.sort (.succ .zero))) :
    LRTermDSubKClosedCtxBi E n Γ (.app polyPi X₁) (.app polyPi X₂)
      (.sort (.imax (.succ .zero) (.succ .zero))) := by
  have hb0 : HasTyT E n (.assumption (.sort (.succ .zero)) :: Γ) (.bvar 0) (.sort (.succ .zero)) :=
    .bvar _ 0 (.sort (.succ .zero)) rfl
  have hb1 : HasTyT E n (.assumption (.bvar 0) :: .assumption (.sort (.succ .zero)) :: Γ)
      (.bvar 1) (.sort (.succ .zero)) :=
    .bvar _ 1 (.sort (.succ .zero)) rfl
  exact lrTermDSubKClosedCtxBi_app_lam_pi hW hΓ (.refl _) (.refl _)
