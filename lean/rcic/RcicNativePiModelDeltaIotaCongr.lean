/-- **Unrestricted Type-Disjunctive Logical Relation (`LRTermMajSemBi`):**
    Places `ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])` as a positive disjunct alongside
    `IsSemPropTyI E n Γ A` and `LRProbeTypePiKClosedCtxMaj E n Γ M M' c`!
    - At `A = .sort u`, both `IsSemPropTyI E n Γ (.sort u)` and
      `ApproxDIK E (ctxEnvDIK E Γ) (.sort u) (.pi .bot [])` are **false**, so
      `LRTermMajSemBi E n Γ X Y (.sort u)` is **100% equivalent** to
      `LRTermNoPiMajSemBi E n Γ X Y (.sort u)`!
    - At `A = .pi D C`, `ApproxDIK E (ctxEnvDIK E Γ) (.pi D C) (.pi .bot [])` is **always true**
      (`approxDIK_pi_bot_nil`), so `ConvT.eta`, `HasTyT.lam`, and `ConvT.lam` hold in **1 line**
      with **zero** premises!
    - On the diagonal `M' = M`, `lrTermMajSemBi_diag_of_normalizes` holds at **every** type
      `A : Expr Nat` with **zero** hypotheses on `A`! -/
def LRTermMajSemBi (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M M' A : Expr Nat) : Prop :=
  ∀ c, ProbeCpt c →
    (ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c) →
    IsSemPropTyI E n Γ A ∨
      ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∨
      LRProbeTypePiKClosedCtxMaj E n Γ M M' c

theorem lrTermMajSemBi_of_isSemPropTyI {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} (hP : IsSemPropTyI E n Γ A) :
    LRTermMajSemBi E n Γ M M' A :=
  fun _ _ _ => Or.inl hP

theorem lrTermMajSemBi_of_pi_approx {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} (hpi : ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])) :
    LRTermMajSemBi E n Γ M M' A :=
  fun _ _ _ => Or.inr (Or.inl hpi)

/-- At any syntactic $\Pi$-type `.pi A B`, `LRTermMajSemBi E n Γ M M' (.pi A B)` holds
    **unconditionally** in 1 line (`lrTermMajSemBi_of_pi_type`)! -/
theorem lrTermMajSemBi_of_pi_type {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (M M' A B : Expr Nat) :
    LRTermMajSemBi E n Γ M M' (.pi A B) :=
  lrTermMajSemBi_of_pi_approx (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B)

/-- Unconditional 1-line `ConvT.eta` in `LRTermMajSemBi` requiring **zero** premises (`lrTermMajSemBi_eta`)! -/
theorem lrTermMajSemBi_eta {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (A B f : Expr Nat) :
    LRTermMajSemBi E n Γ (.lam A (.app (lift 0 1 f) (.bvar 0))) f (.pi A B) :=
  lrTermMajSemBi_of_pi_type Γ _ f A B

theorem lrTermMajSemBi_of_probeCpt_eq_bot {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' : Expr Nat} (A : Expr Nat)
    (hM : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M c → c = .bot)
    (hM' : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) M' c → c = .bot) :
    LRTermMajSemBi E n Γ M M' A := by
  intro c hc hor
  have hbot : c = .bot := hor.elim (hM c hc) (hM' c hc)
  subst hbot
  exact Or.inr (Or.inr (.bot Γ M M'))

theorem lrTermMajSemBi_of_noPiMajSemBi {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermNoPiMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ M M' A := by
  intro c hc hor
  rcases h c hc hor with hP | hC
  · exact Or.inl hP
  · refine Or.inr (Or.inr ?_)
    cases hc with
    | bot => exact .bot Γ M M'
    | sort => exact hC.2
    | piBotNil => exact hC.2.2.2

/-- At any sort `.sort u`, `LRTermMajSemBi` and `LRTermNoPiMajSemBi` are **100% equivalent (`↔`)**
    (`lrTermNoPiMajSemBi_sort_iff_lrTermMajSemBi_sort`). -/
theorem lrTermNoPiMajSemBi_sort_iff_lrTermMajSemBi_sort {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {X Y : Expr Nat} {u : Level} :
    LRTermNoPiMajSemBi E n Γ X Y (.sort u) ↔ LRTermMajSemBi E n Γ X Y (.sort u) := by
  constructor
  · exact lrTermMajSemBi_of_noPiMajSemBi
  · intro h c hc hor
    rcases h c hc hor with hPs | hpi | hlr
    · exact Or.inl hPs
    · exact (approxDIK_sort_not_pi u .bot [] hpi).elim
    · refine Or.inr ?_
      cases hc with
      | bot => trivial
      | sort => exact ⟨approxDIK_sort_not_pi u .bot [], hlr⟩
      | piBotNil => exact ⟨rfl, rfl, approxDIK_sort_not_pi u .bot [], hlr⟩

theorem lrTermMajSemBi_symm {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M M' A : Expr Nat}
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ M' M A := by
  intro c hc hor
  rcases h c hc hor.symm with hP | hpi | hlr
  · exact Or.inl hP
  · exact Or.inr (Or.inl hpi)
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_symm hW hΓ hlr))

theorem lrTermMajSemBi_trans {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M₁ M₂ M₃ A : Expr Nat}
    (h₁ : LRTermMajSemBi E n Γ M₁ M₂ A)
    (h₂ : LRTermMajSemBi E n Γ M₂ M₃ A) :
    LRTermMajSemBi E n Γ M₁ M₃ A := by
  intro c hc hor
  rcases hor with hM₁ | hM₃
  · rcases h₁ c hc (Or.inl hM₁) with hP | hpi | hlr₁
    · exact Or.inl hP
    · exact Or.inr (Or.inl hpi)
    · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ c :=
        (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hlr₁).2
      rcases h₂ c hc (Or.inl hM₂) with hP | hpi | hlr₂
      · exact Or.inl hP
      · exact Or.inr (Or.inl hpi)
      · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_trans hW hΓ hlr₁ hlr₂))
  · rcases h₂ c hc (Or.inr hM₃) with hP | hpi | hlr₂
    · exact Or.inl hP
    · exact Or.inr (Or.inl hpi)
    · have hM₂ : ApproxDIK E (ctxEnvDIK E Γ) M₂ c :=
        (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hlr₂).1
      rcases h₁ c hc (Or.inr hM₂) with hP | hpi | hlr₁
      · exact Or.inl hP
      · exact Or.inr (Or.inl hpi)
      · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_trans hW hΓ hlr₁ hlr₂))

theorem lrTermMajSemBi_whRedPiKClosedCtxMaj_expand {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hM : WhRedPiKClosedCtxMaj E Γ M M')
    (hN : WhRedPiKClosedCtxMaj E Γ N N')
    (h : LRTermMajSemBi E n Γ M' N' A) :
    LRTermMajSemBi E n Γ M N A := by
  intro c hc hor
  have hor' : ApproxDIK E (ctxEnvDIK E Γ) M' c ∨ ApproxDIK E (ctxEnvDIK E Γ) N' c :=
    hor.imp (fun h₁ => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hM c).mp h₁)
      (fun h₂ => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hN c).mp h₂)
  rcases h c hc hor' with hP | hpi | hlr
  · exact Or.inl hP
  · exact Or.inr (Or.inl hpi)
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hM hN hlr))

theorem lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hM : WhRedPiKClosedCtxMaj E Γ M M')
    (hN : WhRedPiKClosedCtxMaj E Γ N N')
    (h : LRTermMajSemBi E n Γ M N A) :
    LRTermMajSemBi E n Γ M' N' A := by
  intro c hc hor'
  have hor : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) N c :=
    hor'.imp (fun h₁ => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hM c).mpr h₁)
      (fun h₂ => (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hN c).mpr h₂)
  rcases h c hc hor with hP | hpi | hlr
  · exact Or.inl hP
  · exact Or.inr (Or.inl hpi)
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_preserve hW hM hN hlr))

theorem lrTermMajSemBi_whRedPiKClosedCtxMaj_iff {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' N N' A : Expr Nat}
    (hM : WhRedPiKClosedCtxMaj E Γ M M')
    (hN : WhRedPiKClosedCtxMaj E Γ N N') :
    LRTermMajSemBi E n Γ M N A ↔ LRTermMajSemBi E n Γ M' N' A :=
  ⟨lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hM hN,
   lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hM hN⟩

theorem lrTermMajSemBi_of_whStepPiKClosedCtxMaj {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E Γ M M')
    (hdiag : LRTermMajSemBi E n Γ M' M' A) :
    LRTermMajSemBi E n Γ M M' A :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW (.step hs (.refl M')) (.refl M') hdiag

theorem approxDIK_pi_tyConv_of_majSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {u : Level}
    (hpiA : ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (ih_AB : LRTermMajSemBi E n Γ A B (.sort u)) :
    ApproxDIK E (ctxEnvDIK E Γ) B (.pi .bot []) := by
  rcases ih_AB (.pi .bot []) .piBotNil (Or.inl hpiA) with hPs | hpiS | hlr
  · exact (not_isSemPropTyI_sort E n Γ u hPs).elim
  · exact (approxDIK_sort_not_pi u .bot [] hpiS).elim
  · exact (approxDIK_of_lrProbeTypePiKClosedCtxMaj hW hlr).2

theorem isSemPropTyI_tyConv_of_majSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A B : Expr Nat} {u : Level}
    (hPA : IsSemPropTyI E n Γ A)
    (hcAB : TyConvT E n Γ A B)
    (ih_AB : LRTermMajSemBi E n Γ A B (.sort u)) :
    IsSemPropTyI E n Γ B :=
  isSemPropTyI_tyConv_of_noPiMajSemBi hW hPA hcAB
    (lrTermNoPiMajSemBi_sort_iff_lrTermMajSemBi_sort.mpr ih_AB)

/-- Self-contained type-conversion transport in `LRTermMajSemBi` (`lrTermMajSemBi_tyConv_of_bi`). -/
theorem lrTermMajSemBi_tyConv_of_bi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A B : Expr Nat} {u : Level}
    (hcAB : TyConvT E n Γ A B)
    (ih_M : LRTermMajSemBi E n Γ M M' A)
    (ih_AB : LRTermMajSemBi E n Γ A B (.sort u)) :
    LRTermMajSemBi E n Γ M M' B := by
  intro c hc hor
  rcases ih_M c hc hor with hPA | hpiA | hlr
  · exact Or.inl (isSemPropTyI_tyConv_of_majSemBi hW hPA hcAB ih_AB)
  · exact Or.inr (Or.inl (approxDIK_pi_tyConv_of_majSemBi hW hpiA ih_AB))
  · exact Or.inr (Or.inr hlr)

theorem lrTermMajSemBi_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {M M' A : Expr Nat}
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ' M M' A := by
  have henv : ctxEnvDIK E Γ = ctxEnvDIK E Γ' := hprof.2 E
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c := by
    rwa [henv]
  rcases h c hc hor₀ with hP | hpi | hlr
  · exact Or.inl (isSemPropTyI_ctx_of_sameLetProfile hcl hctx hprof hP)
  · exact Or.inr (Or.inl (by rwa [← henv]))
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_ctx_of_sameLetProfile hcl hctx hprof hlr))

theorem lrTermMajSemBi_weaken {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ : LCtx} {M M' A : Expr Nat}
    (d : LocalDecl) {k : Nat} (hk : k ≤ Γ.length)
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n (insertAt d k Γ) (lift k 1 M) (lift k 1 M') (lift k 1 A) := by
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c :=
    hor.elim
      (fun hL => Or.inl ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk M c).mp hL))
      (fun hR => Or.inr ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk M' c).mp hR))
  rcases h c hc hor₀ with hP | hpi | hlr
  · exact Or.inl (isSemPropTyI_weaken hcl d hk hP)
  · exact Or.inr (Or.inl ((approxDIK_ctxEnvDIK_insertAt_lift_iff E d hk A (.pi .bot [])).mpr hpi))
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_weaken hcl d hk hlr))

theorem lrTermMajSemBi_weaken0 {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ : LCtx} (d : LocalDecl)
    {M M' A : Expr Nat}
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n (d :: Γ) (lift 0 1 M) (lift 0 1 M') (lift 0 1 A) :=
  lrTermMajSemBi_weaken hcl d (Nat.zero_le _) h

theorem lrTermMajSemBi_substLet {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) (hinst : EnvMembersSubstStable E) (t w0 : Expr Nat)
    {Γ : LCtx} {M M' A : Expr Nat} {j : Nat}
    (hget : Γ[j]? = some (.letBinding t w0))
    (hvty : HasTyT E n (substRemove w0 j Γ) (lift 0 j w0) (lift 0 j t))
    (h : LRTermMajSemBi E n Γ M M' A) :
    LRTermMajSemBi E n (substRemove w0 j Γ)
      (instantiate j (lift 0 j w0) M)
      (instantiate j (lift 0 j w0) M')
      (instantiate j (lift 0 j w0) A) := by
  intro c hc hor
  have hor₀ : ApproxDIK E (ctxEnvDIK E Γ) M c ∨ ApproxDIK E (ctxEnvDIK E Γ) M' c :=
    hor.elim
      (fun hL => Or.inl ((approxDIK_ctxEnvDIK_substLet_iff hget M c).mp hL))
      (fun hR => Or.inr ((approxDIK_ctxEnvDIK_substLet_iff hget M' c).mp hR))
  rcases h c hc hor₀ with hP | hpi | hlr
  · exact Or.inl (isSemPropTyI_substLet hcl hinst hget hvty hP)
  · exact Or.inr (Or.inl ((approxDIK_ctxEnvDIK_substLet_iff hget A (.pi .bot [])).mpr hpi))
  · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_substLet hcl hinst t w0 hget hvty hlr))

theorem lrTermMajSemBi_substLet0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {t w0 : Expr Nat}
    (hw0ty : HasTyT E n Γ w0 t)
    {M M' A : Expr Nat}
    (h : LRTermMajSemBi E n (.letBinding t w0 :: Γ) M M' A) :
    LRTermMajSemBi E n Γ (instantiate0 w0 M) (instantiate0 w0 M') (instantiate0 w0 A) := by
  have hget0 : (LocalDecl.letBinding t w0 :: Γ)[0]? = some (.letBinding t w0) := by simp
  have h0 := lrTermMajSemBi_substLet
    (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW) t w0 hget0
    (by simpa only [substRemove_zero_cons, lift_zero] using hw0ty) h
  simpa only [substRemove_zero_cons, lift_zero, instantiate0] using h0

theorem lrTermMajSemBi_sorts {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {l₁ l₂ : Level} (T : Expr Nat) :
    LRTermMajSemBi E n Γ (.sort l₁) (.sort l₂) T := by
  intro c hc hor
  refine Or.inr (Or.inr ?_)
  cases hc with
  | bot => exact .bot Γ _ _
  | sort => exact .sort (.refl _) (.refl _)
  | piBotNil =>
      rcases hor with h₁ | h₂
      · exact (approxDIK_sort_not_pi l₁ .bot [] h₁).elim
      · exact (approxDIK_sort_not_pi l₂ .bot [] h₂).elim

theorem lrTermMajSemBi_pi {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {A₁ A₂ B₁ B₂ : Expr Nat} (T : Expr Nat)
    (hdom : TyConvT E n Γ A₁ A₂)
    (hcod : TyConvT E n (.assumption A₁ :: Γ) B₁ B₂) :
    LRTermMajSemBi E n Γ (.pi A₁ B₁) (.pi A₂ B₂) T := by
  intro c hc hor
  refine Or.inr (Or.inr ?_)
  cases hc with
  | bot => exact .bot Γ _ _
  | sort =>
      rcases hor with h₁ | h₂
      · exact (approxDIK_pi_not_sort A₁ B₁ h₁).elim
      · exact (approxDIK_pi_not_sort A₂ B₂ h₂).elim
  | piBotNil =>
      exact .pi (.refl _) (.refl _) hdom hcod

theorem lrTermMajSemBi_lam {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} (A₁ A₂ b₁ b₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.lam A₁ b₁) (.lam A₂ b₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi (lrTermNoPiMajSemBi_lam A₁ A₂ b₁ b₂ T)

theorem lrTermMajSemBi_consts_of_body_none {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {r : Nat} (ls₁ ls₂ : List Level) (T : Expr Nat)
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none) :
    LRTermMajSemBi E n Γ (.const r ls₁) (.const r ls₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi (lrTermNoPiMajSemBi_consts_of_body_none ls₁ ls₂ T hm hb)

/-- **Unconditional Diagonal Adequacy at EVERY Type `A : Expr Nat` from
    `WhRedPiKClosedCtxMajNormalizes` (`lrTermMajSemBi_diag_of_normalizes`):**
    At every `EnvWfT E`, **every** expression `M` that weak-head normalizes under
    `WhRedPiKClosedCtxMaj E Γ` satisfies `LRTermMajSemBi E n Γ M M A` at **every** type `A : Expr Nat`
    with **zero** hypotheses on `A` and **zero** `LRPiWf2`! -/
theorem lrTermMajSemBi_diag_of_normalizes {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M : Expr Nat} (A : Expr Nat)
    (hnorm : WhRedPiKClosedCtxMajNormalizes E Γ M) :
    LRTermMajSemBi E n Γ M M A := by
  obtain ⟨nf, hred, hnf⟩ := hnorm
  intro c hc hor
  have hM : ApproxDIK E (ctxEnvDIK E Γ) M c := hor.elim id id
  refine Or.inr (Or.inr ?_)
  cases hc with
  | bot => exact .bot Γ M M
  | sort =>
      obtain ⟨l, hred_l⟩ :=
        (approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred hnf).mp hM
      exact .sort hred_l hred_l
  | piBotNil =>
      obtain ⟨D, C, hred_pi⟩ :=
        (approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred hnf).mp hM
      exact .pi hred_pi hred_pi (.refl _ D) (.refl _ C)

/-- **Two-Sided Normal-Form Adequacy Under `PrunedSemEqDIK` (`lrTermMajSemBi_of_prunedSemEqDIK_and_normalizes`):**
    For **any** two expressions `M, N` that weak-head normalize under `WhRedPiKClosedCtxMaj E Γ`
    and agree on `PrunedPiCpt` in `ApproxDIK E (ctxEnvDIK E Γ)`:
    - The `.bot` and `.sort` probes of `LRTermMajSemBi E n Γ M N A` hold **100% unconditionally**, and
    - The `.pi .bot []` probe reduces purely to `Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)`
      when `M ↠wh .pi D₁ C₁` and `N ↠wh .pi D₂ C₂`! -/
theorem lrTermMajSemBi_of_prunedSemEqDIK_and_normalizes {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M N : Expr Nat} (A : Expr Nat)
    (hsem : PrunedSemEqDIK E (ctxEnvDIK E Γ) M N)
    (hnormM : WhRedPiKClosedCtxMajNormalizes E Γ M)
    (hnormN : WhRedPiKClosedCtxMajNormalizes E Γ N)
    (hpi : ∀ {D₁ C₁ D₂ C₂ : Expr Nat},
      WhRedPiKClosedCtxMaj E Γ M (.pi D₁ C₁) →
      WhRedPiKClosedCtxMaj E Γ N (.pi D₂ C₂) →
      Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)) :
    LRTermMajSemBi E n Γ M N A := by
  obtain ⟨nf₁, hred₁, hnf₁⟩ := hnormM
  obtain ⟨nf₂, hred₂, hnf₂⟩ := hnormN
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hM : ApproxDIK E (ctxEnvDIK E Γ) M c :=
    hor.elim id (fun hN => (hsem c hc_p).mpr hN)
  have hN : ApproxDIK E (ctxEnvDIK E Γ) N c :=
    (hsem c hc_p).mp hM
  refine Or.inr (Or.inr ?_)
  cases hc with
  | bot => exact .bot Γ M N
  | sort =>
      obtain ⟨l₁, hred_s₁⟩ :=
        (approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred₁ hnf₁).mp hM
      obtain ⟨l₂, hred_s₂⟩ :=
        (approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred₂ hnf₂).mp hN
      exact .sort hred_s₁ hred_s₂
  | piBotNil =>
      obtain ⟨D₁, C₁, hred_p₁⟩ :=
        (approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred₁ hnf₁).mp hM
      obtain ⟨D₂, C₂, hred_p₂⟩ :=
        (approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_normalizes hW hred₂ hnf₂).mp hN
      obtain ⟨⟨hdom⟩, ⟨hcod⟩⟩ := hpi hred_p₁ hred_p₂
      exact .pi hred_p₁ hred_p₂ hdom hcod

/-- **0-Instantiation Congruence in `LRTermMajSemBi` Under `PrunedSemEqDIK` and Normalizability
    (`lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_normalizes`):**
    Closes `c = .bot` and `c = .sort` **100% unconditionally** for ALL `v₁, v₂, b` with
    `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂` (requiring **zero `hv_nolam` and zero trichotomy on `b`**!),
    and reduces `c = .pi .bot []` to `TyConvT` between the $\Pi$-normal forms of
