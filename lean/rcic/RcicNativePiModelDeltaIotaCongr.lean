  lrTermMajSemBi_foldApps_const_body_none_le_two ls₁ ls₂ hm₁ hb₁ hm₂ hb₂
    (xs₁ := [a₁]) (xs₂ := [a₂]) (by simp : [a₁].length ≤ 2) (by simp : [a₂].length ≤ 2) T

