/-! ### §29.3. Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Supply
(`TypedSubst0CongrSupplyLet1MajSemBi`), Zero-Adequacy `ConvT.letE` Congruence, and
27-Constructor Reduction -/

/-- **Single-Let-Diagonal (`hb_let₁`-Only) Well-Typed 0-Instantiation Congruence Supply in
    `LRTermMajSemBi` (`TypedSubst0CongrSupplyLet1MajSemBi E n`):**
    Sharpens `TypedSubst0CongrSupplyMajSemBi E n` by requiring **only** the single left let-context
    diagonal `hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B` (and `hb₁ : HasTyT E n (.letBinding A v₁ :: Γ) b B`),
    dropping `hb₂`, `hb_let₂`, `hb_inst₁`, and `hb_inst₂`! -/
def TypedSubst0CongrSupplyLet1MajSemBi (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A v₁ v₂ b B : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      HasTyT E n Γ v₁ A → HasTyT E n Γ v₂ A → ConvT E n Γ v₁ v₂ A →
      HasTyT E n (.letBinding A v₁ :: Γ) b B →
      LRTermMajSemBi E n Γ v₁ v₂ A →
      LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B →
      LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B)

/-- `TypedSubst0CongrSupplyLet1MajSemBi` conservatively implies `TypedSubst0CongrSupplyMajSemBi`
    (`typedSubst0CongrSupplyMajSemBi_of_let1`). -/
theorem typedSubst0CongrSupplyMajSemBi_of_let1 {E : ResolvedEnv} {n : Nat}
    (h : TypedSubst0CongrSupplyLet1MajSemBi E n) :
    TypedSubst0CongrSupplyMajSemBi E n :=
  fun {_} hΓ {_ _ _ _ _ _} hA hv₁ hv₂ hcv hb₁ _ ih_v hb_let₁ _ _ _ =>
    h hΓ hA hv₁ hv₂ hcv hb₁ ih_v hb_let₁

/-- **Zero-Adequacy Two-Sided `ConvT.letE` Congruence in `LRTermMajSemBi` from
    `TypedSubst0CongrSupplyLet1MajSemBi` (`lrTermMajSemBi_letE_congr_of_typedSubst0Let1`):**
    Because `lrTermMajSemBi_diag_right ih_b` extracts `hb₂_let₁ : LRTermMajSemBi E n (.letBinding A₁ v₁ :: Γ) b₂ b₂ B`
    directly from `ih_b`, `ConvT.letE` requires **zero `TypedWhAdequateMaj E n`** under
    `TypedSubst0CongrSupplyLet1MajSemBi E n`! -/
theorem lrTermMajSemBi_letE_congr_of_typedSubst0Let1 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hSubst0 : TypedSubst0CongrSupplyLet1MajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A₁ A₂ v₁ v₂ b₁ b₂ B : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u))
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hcb : ConvT E n (.letBinding A₁ v₁ :: Γ) b₁ b₂ B)
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A₁)
    (ih_b : LRTermMajSemBi E n (.letBinding A₁ v₁ :: Γ) b₁ b₂ B) :
    LRTermMajSemBi E n Γ (.letE A₁ v₁ b₁) (.letE A₂ v₂ b₂) (instantiate0 v₁ B) := by
  have endsA := convEnds hW hΓ hcA
  have endsv := convEnds hW hΓ hcv
  have hΓ_let₁ : CtxWfT E n (.letBinding A₁ v₁ :: Γ) :=
    .letBinding Γ A₁ u v₁ hΓ endsA.1 endsv.1
  have endsb := convEnds hW hΓ_let₁ hcb
  exact lrTermMajSemBi_letE_of_subst0_let₁ hW hΓ endsv.1 ih_b
    (fun hb₂_let₁ => hSubst0 hΓ endsA.1 endsv.1 endsv.2.1 hcv endsb.2.1 ih_v hb₂_let₁)

/-- In `.letBinding A f :: Γ`, the left-head application template `.app (.bvar 0) (lift 0 1 a)`
    steps in 1 `WhStepPiKClosedCtxMaj` step to `lift 0 1 (.app f a)`
    (`whStepPiKClosedCtxMaj_letBinding_app_bvar0_lift0`). -/
theorem whStepPiKClosedCtxMaj_letBinding_app_bvar0_lift0 (E : ResolvedEnv) (Γ : LCtx)
    (A f a : Expr Nat) :
    WhStepPiKClosedCtxMaj E (.letBinding A f :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (lift 0 1 (.app f a)) :=
  .appHead (.zetaLocal rfl)

/-- **Lifting an Application Diagonal in `Γ` to the Left-Head Template Diagonal in
    `.letBinding (.pi A B) f :: Γ` (`lrTermMajSemBi_letBinding_app_bvar0_lift0_of_app_diag`):**
    Combines `lrTermMajSemBi_weaken0` and `lrTermMajSemBi_of_whStepPiKClosedCtxMaj` with
    `whStepPiKClosedCtxMaj_letBinding_app_bvar0_lift0` (requiring **zero `TypedWhAdequateMaj`**)! -/
theorem lrTermMajSemBi_letBinding_app_bvar0_lift0_of_app_diag {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {f a : Expr Nat} (A : Expr Nat) {B : Expr Nat}
    (hdiag : LRTermMajSemBi E n Γ (.app f a) (.app f a) (instantiate0 a B)) :
    LRTermMajSemBi E n (.letBinding (.pi A B) f :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (.app (.bvar 0) (lift 0 1 a))
      (lift 0 1 (instantiate0 a B)) := by
  have hwk := lrTermMajSemBi_weaken0 (envClosed_of_envWfT hW) (.letBinding (.pi A B) f) hdiag
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
    (.step (whStepPiKClosedCtxMaj_letBinding_app_bvar0_lift0 E Γ (.pi A B) f a) (.refl _))
    (.step (whStepPiKClosedCtxMaj_letBinding_app_bvar0_lift0 E Γ (.pi A B) f a) (.refl _))
    hwk

/-- **Zero-Adequacy Left-Head Function Congruence in `LRTermMajSemBi` from
    `TypedSubst0CongrSupplyLet1MajSemBi` and the Left Application Diagonal
    (`lrTermMajSemBi_app_fn_congr_of_typedSubst0Let1`):**
    Derives `LRTermMajSemBi E n Γ (.app f₁ a) (.app f₂ a) (instantiate0 a B)` from
    `hSubst0 : TypedSubst0CongrSupplyLet1MajSemBi E n` and `hdiag : LRTermMajSemBi E n Γ (.app f₁ a) (.app f₁ a) (instantiate0 a B)`
    in `Γ` (with **zero `TypedWhAdequateMaj E n`**)! -/
theorem lrTermMajSemBi_app_fn_congr_of_typedSubst0Let1 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hSubst0 : TypedSubst0CongrSupplyLet1MajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ a A B : Expr Nat}
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B))
    (ha : HasTyT E n Γ a A)
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B))
    (hdiag : LRTermMajSemBi E n Γ (.app f₁ a) (.app f₁ a) (instantiate0 a B)) :
    LRTermMajSemBi E n Γ (.app f₁ a) (.app f₂ a) (instantiate0 a B) := by
  have endsf := convEnds hW hΓ hcf
  obtain ⟨u_pi, hpiAB⟩ := endsf.2.2
  have hb₁ : HasTyT E n (.letBinding (.pi A B) f₁ :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (lift 0 1 (instantiate0 a B)) :=
    hasTyT_letBinding_app_bvar0_lift0 hW f₁ ha
  have hb_let₁ := lrTermMajSemBi_letBinding_app_bvar0_lift0_of_app_diag hW A hdiag
  have h_fn0 := hSubst0 hΓ hpiAB endsf.1 endsf.2.1 hcf hb₁ ih_f hb_let₁
  have hcancel : instantiate0 f₁ (lift 0 1 (instantiate0 a B)) = instantiate0 a B :=
    (instantiate_lift_cancel 1 0 0 f₁ (Nat.le_refl 0) Nat.zero_lt_one (instantiate0 a B)).trans
      (lift_zero 0 (instantiate0 a B))
  rwa [instantiate0_app_bvar0_lift0 f₁ a, instantiate0_app_bvar0_lift0 f₂ a, hcancel] at h_fn0

/-- Two-sided `ConvT.app` congruence in `LRTermMajSemBi` from `TypedWhAdequateMaj` and
    `TypedSubst0CongrSupplyLet1MajSemBi` (`lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0Let1`). -/
theorem lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0Let1 {E : ResolvedEnv} {n : Nat}
