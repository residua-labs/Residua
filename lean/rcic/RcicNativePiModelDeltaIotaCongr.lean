    (hNorm : TypedWhNormalizesMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    FundamentalTermMajSemBiProbe E n :=
  ⟨fun {_} hΓ {_ A} hM => lrTermMajSemBi_diag_of_normalizes hW A (hNorm hΓ hM),
   fun {_} hΓ {_ _ _} _ _ hc => fundMajSemBiProbe_convT hW hNorm hSubst0 hIrr hc hΓ⟩

/-- **Direct Projection to `PiRowField E n` from `TypedWhNormalizesMaj`, `Subst0CongrSupplyMajSemBi`,
    and `IrrNoWhRedSortMaj` (`piRow_of_normalizes_and_subst0_maj`):** -/
theorem piRow_of_normalizes_and_subst0_maj {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hNorm : TypedWhNormalizesMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
