theorem lrTermMajSemBi_change_type_of_sort
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {M N : Expr Nat} {u : Level} (T : Expr Nat)
    (h : LRTermMajSemBi E n Γ M N (.sort u)) :
    LRTermMajSemBi E n Γ M N T :=
  lrTermMajSemBi_change_type_of_not_prop_not_pi T h
    (not_isSemPropTyI_sort E n Γ u) (approxDIK_sort_not_pi u .bot [])

/-- **Unconditional 0-Instantiation Congruence in `LRTermMajSemBi` When `b` Weak-Head Reduces to
    `.bvar 0` in Both `letBinding` Contexts (`lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0`):**
    Requires **zero** endpoint diagonals `h₁, h₂` and **zero** `PrunedSemEqDIK`! -/
theorem lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A₁ A₂ v₁ v₂ b A₀ : Expr Nat} (T : Expr Nat)
    (hred_b₁ : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (.bvar 0))
    (hred_b₂ : WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (.bvar 0))
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A₀)
    (hnoprop : ¬ IsSemPropTyI E n Γ A₀)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A₀ (.pi .bot [])) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) T := by
  have hcl := envClosed_of_envWfT hW
  have hsub₁ : WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) v₁ := by
    simpa only [instantiate0, instantiate] using
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₁ v₁ hred_b₁
  have hsub₂ : WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) v₂ := by
    simpa only [instantiate0, instantiate] using
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₂ v₂ hred_b₂
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hsub₁ hsub₂
    (lrTermMajSemBi_change_type_of_not_prop_not_pi T ih_v hnoprop hnopi)

/-- Specialization of `lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0` for sort-typed
    arguments `ih_v : LRTermMajSemBi E n Γ v₁ v₂ (.sort u)`
    (`lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0_sort_arg`). -/
theorem lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0_sort_arg
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A₁ A₂ v₁ v₂ b : Expr Nat} {u : Level} (T : Expr Nat)
    (hred_b₁ : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (.bvar 0))
    (hred_b₂ : WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (.bvar 0))
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ (.sort u)) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) T :=
  lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_bvar0 hW T hred_b₁ hred_b₂ ih_v
    (not_isSemPropTyI_sort E n Γ u) (approxDIK_sort_not_pi u .bot [])

/-- **Unconditional 0-Instantiation Congruence in `LRTermMajSemBi` When `b` Weak-Head Reduces to
    `foldApps (.bvar 0) args` in Both `letBinding` Contexts
    (`lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_foldApps_bvar0`):** -/
theorem lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_foldApps_bvar0
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A₁ A₂ v₁ v₂ b A₀ : Expr Nat} {args : List (Expr Nat)} (T : Expr Nat)
    (hred_b₁ : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (foldApps (.bvar 0) args))
    (hred_b₂ : WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (foldApps (.bvar 0) args))
    (hsp : LRTermMajSemBi E n Γ
      (foldApps v₁ (args.map (instantiate0 v₁)))
      (foldApps v₂ (args.map (instantiate0 v₂))) A₀)
    (hnoprop : ¬ IsSemPropTyI E n Γ A₀)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A₀ (.pi .bot [])) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) T := by
  have hcl := envClosed_of_envWfT hW
  have hsub₁ : WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b)
      (foldApps v₁ (args.map (instantiate0 v₁))) := by
    simpa only [instantiate0_foldApps_bvar0] using
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₁ v₁ hred_b₁
  have hsub₂ : WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b)
      (foldApps v₂ (args.map (instantiate0 v₂))) := by
    simpa only [instantiate0_foldApps_bvar0] using
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₂ v₂ hred_b₂
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hsub₁ hsub₂
    (lrTermMajSemBi_change_type_of_not_prop_not_pi T hsp hnoprop hnopi)

/-- Well-typed weak-head adequacy under `WhApproxAdequateAtMaj` (`TypedWhAdequateMaj`),
    strictly weaker than `TypedWhNormalizesMaj E n` (`typedWhAdequateMaj_of_normalizes`) since it
    requires weak-head reduction only when `M` approximates `.sort` or `.pi .bot []` at a
    non-proposition, non-$\Pi$ type `A`. -/
def TypedWhAdequateMaj (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {M A : Expr Nat}, HasTyT E n Γ M A → WhApproxAdequateAtMaj E n Γ M A

/-- `TypedWhNormalizesMaj E n` strictly implies `TypedWhAdequateMaj E n` under `EnvWfT E`
    (`typedWhAdequateMaj_of_normalizes`). -/
theorem typedWhAdequateMaj_of_normalizes {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hNorm : TypedWhNormalizesMaj E n) :
    TypedWhAdequateMaj E n :=
  fun {_} hΓ {_ A} hM => whApproxAdequateAtMaj_of_normalizes hW A (hNorm hΓ hM)

/-- Every well-typed expression `M : A` is diagonally related in `LRTermMajSemBi E n Γ M M A`
    under `TypedWhAdequateMaj E n` (`lrTermMajSemBi_diag_of_adequate`). -/
theorem lrTermMajSemBi_diag_of_adequate {E : ResolvedEnv} {n : Nat}
    (hAdeq : TypedWhAdequateMaj E n) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {M A : Expr Nat} (hM : HasTyT E n Γ M A) :
    LRTermMajSemBi E n Γ M M A :=
  (lrTermMajSemBi_diag_iff E n Γ M A).mpr (hAdeq hΓ hM)

/-- `ConvT.irr` in `LRTermMajSemBi` from `WhApproxAdequateAtMaj E n Γ P (.sort .zero)` and
    `∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)` (`lrTermMajSemBi_irr_of_adequate_and_no_whRed_sort`),
    requiring **zero** `WhRedPiKClosedCtxMajNormalizes`! -/
theorem lrTermMajSemBi_irr_of_adequate_and_no_whRed_sort {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {P : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero))
    (hadP : WhApproxAdequateAtMaj E n Γ P (.sort .zero))
    (hnw : ∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l))
    (p q : Expr Nat) :
    LRTermMajSemBi E n Γ p q P := by
  refine lrTermMajSemBi_of_isSemPropTyI ⟨⟨P, ⟨hP⟩, ⟨.refl Γ P⟩⟩, fun hPs => ?_⟩
  rcases hadP.1 hPs with hPs0 | hpi0 | ⟨l, hred_l⟩
  · exact not_isSemPropTyI_sort E n Γ .zero hPs0
  · exact approxDIK_sort_not_pi .zero .bot [] hpi0
  · exact hnw l hred_l

private theorem fundMajSemBiProbe_adeq_convT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    {Γ : LCtx} → {M M' A : Expr Nat} → ConvT E n Γ M M' A →
      CtxWfT E n Γ → LRTermMajSemBi E n Γ M M' A
  | _, _, _, _, .refl _ _ _ he, hΓ =>
      lrTermMajSemBi_diag_of_adequate hAdeq hΓ he
  | _, _, _, _, .symm _ _ _ _ h, hΓ =>
      lrTermMajSemBi_symm hW hΓ (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr h hΓ)
  | _, _, _, _, .trans _ _ _ _ _ h₁ h₂, hΓ =>
      lrTermMajSemBi_trans hW hΓ
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr h₁ hΓ)
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr h₂ hΓ)
  | _, _, _, _, .beta Γ₀ A body arg B u hA hbody harg, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 arg body) (instantiate0 arg B) :=
        (convEnds hW hΓ (.beta Γ₀ A body arg B u hA hbody harg)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.beta A body arg))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hR)
  | _, _, _, _, .zeta Γ₀ A v b B u hA hv hb, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 v b) (instantiate0 v B) :=
        (convEnds hW hΓ (.zeta Γ₀ A v b B u hA hv hb)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.zeta A v b))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hR)
  | _, _, _, _, .zetaLocal _ _ _ _ hval _ hv, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.zetaLocal hval)
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hv)
  | _, _, _, _, .delta _ _ _ _ _ hres hbody _ _ _ hb, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.delta hres hbody))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hb)
  | _, _, _, _, .iota _ _ _ _ hI _ hrhs, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW
        (.of_whStep (.iota (derivedIotaU_ofDerivedIota hI)))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hrhs)
  | _, _, _, _, .lit _ t _ _ hlit hexp, hΓ => by
      cases hlit
      exact lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.lit t))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hexp)
  | _, _, _, _, .app Γ₀ f₁ f₂ a₁ a₂ A B hcf hca, hΓ =>
      have endsf := convEnds hW hΓ hcf
      have endsa := convEnds hW hΓ hca
      have happ₁ : HasTyT E n Γ₀ (.app f₁ a₁) (instantiate0 a₁ B) :=
        .app Γ₀ f₁ a₁ A B endsf.1 endsa.1
      lrTermMajSemBi_app_congr_of_subst0Congr hW hSubst0 hΓ
        endsf.1 endsf.2.1 endsa.1 endsa.2.1 hcf hca
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hcf hΓ)
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hca hΓ)
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ happ₁)
  | _, _, _, _, .lam _ A₁ A₂ b₁ b₂ B _ _ _, _ =>
      lrTermMajSemBi_lam A₁ A₂ b₁ b₂ (.pi A₁ B)
  | _, _, _, _, .pi Γ₀ A₁ A₂ B₁ B₂ u v hcA hcB, _ =>
      lrTermMajSemBi_pi (.sort (.imax u v)) (.of Γ₀ A₁ A₂ u hcA) (.of _ B₁ B₂ v hcB)
  | _, _, _, _, .letE Γ₀ A₁ A₂ v₁ v₂ b₁ b₂ B u hcA hcv hcb, hΓ =>
      have endsA := convEnds hW hΓ hcA
      have endsv := convEnds hW hΓ hcv
      have hΓ_let₁ : CtxWfT E n (.letBinding A₁ v₁ :: Γ₀) :=
        .letBinding Γ₀ A₁ u v₁ hΓ endsA.1 endsv.1
      have h_inst_b : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₁) (instantiate0 v₁ b₂)
          (instantiate0 v₁ B) :=
        lrTermMajSemBi_substLet0 hW endsv.1
          (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hcb hΓ_let₁)
      have ih_inst_b₂ : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₂) (instantiate0 v₁ b₂)
          (instantiate0 v₁ B) :=
        lrTermMajSemBi_trans hW hΓ (lrTermMajSemBi_symm hW hΓ h_inst_b) h_inst_b
      have h_inst_v : LRTermMajSemBi E n Γ₀ (instantiate0 v₁ b₂) (instantiate0 v₂ b₂)
          (instantiate0 v₁ B) :=
        hSubst0 hΓ endsv.1 endsv.2.1 hcv
          (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hcv hΓ) ih_inst_b₂
      have hL : WhRedPiKClosedCtxMaj E Γ₀ (.letE A₁ v₁ b₁) (instantiate0 v₁ b₁) :=
        .step (.of_whStep (.zeta A₁ v₁ b₁)) (.refl _)
      have hR : WhRedPiKClosedCtxMaj E Γ₀ (.letE A₂ v₂ b₂) (instantiate0 v₂ b₂) :=
        .step (.of_whStep (.zeta A₂ v₂ b₂)) (.refl _)
      lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hL hR
        (lrTermMajSemBi_trans hW hΓ h_inst_b h_inst_v)
  | _, _, _, _, .sorts _ _ _ _, _ =>
      lrTermMajSemBi_sorts _
  | _, _, _, _, .consts Γ₀ r ls₁ ls₂ m hm hlen hwf₁ _ heq, hΓ => by
      cases hb : m.body with
      | none => exact lrTermMajSemBi_consts_of_body_none ls₁ ls₂ _ hm hb
      | some b =>
          have har : m.arity = 0 := envWfT_body_arity_zero hW r m b hm hb
          have hls₁ : ls₁ = [] := List.eq_nil_of_length_eq_zero (hlen.trans har)
          subst hls₁
          have hls₂ : ls₂ = [] := by
            cases ls₂ with
            | nil => rfl
            | cons _ _ => exact False.elim heq
          subst hls₂
          have hconst : HasTyT E n Γ₀ (.const r []) (instantiateLevels [] m.mtype) :=
            .const Γ₀ r [] m hm hlen hwf₁
          exact lrTermMajSemBi_diag_of_adequate hAdeq hΓ hconst
  | _, _, _, _, .eta Γ₀ f A B _, _ =>
      lrTermMajSemBi_eta Γ₀ A B f
  | _, _, _, _, .irr _ P p q hP _ _, hΓ =>
      lrTermMajSemBi_irr_of_adequate_and_no_whRed_sort hP (hAdeq hΓ hP) (hIrr hΓ hP) p q
  | _, _, _, _, .tyConv Γ₀ _ _ A A' u hc hA, hΓ =>
      lrTermMajSemBi_tyConv_of_bi hW (.of Γ₀ A A' u hA)
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hc hΓ)
        (fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hA hΓ)

/-- **Standalone Non-Mutual 27-Constructor Fundamental Theorem Reduction from `TypedWhAdequateMaj`
    and `Subst0CongrSupplyMajSemBi` (`fundamentalTermMajSemBiProbe_of_adequate_and_subst0`):**
    Strengthens `fundamentalTermMajSemBiProbe_of_normalizes_and_subst0` by replacing
    `TypedWhNormalizesMaj E n` with the strictly weaker `TypedWhAdequateMaj E n`! -/
theorem fundamentalTermMajSemBiProbe_of_adequate_and_subst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    FundamentalTermMajSemBiProbe E n :=
  ⟨fun {_} hΓ {_ _} hM => lrTermMajSemBi_diag_of_adequate hAdeq hΓ hM,
   fun {_} hΓ {_ _ _} _ _ hc => fundMajSemBiProbe_adeq_convT hW hAdeq hSubst0 hIrr hc hΓ⟩

/-- **Direct Projection to `PiRowField E n` from `TypedWhAdequateMaj`, `Subst0CongrSupplyMajSemBi`,
    and `IrrNoWhRedSortMaj` (`piRow_of_adequate_and_subst0_maj`):** -/
theorem piRow_of_adequate_and_subst0_maj {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : Subst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    PiRowField E n :=
  piRow_of_fundamentalTermMajSemBiProbe hW
    (fundamentalTermMajSemBiProbe_of_adequate_and_subst0 hW hAdeq hSubst0 hIrr)

/-! ## §27. `WhStepPiKClosedCtxMaj` / `WhRedPiKClosedCtxMaj` Let-Binding Step & Reduction
Trichotomy, Depth-2 $\Pi$-Well-Formedness (`LRPiWf2Maj`), Single-Let-Diagonal (`hb_let₁`-Only)
0-Instantiation Discharges in `LRTermMajSemBi`, and Well-Typed 0-Instantiation Supply
(`TypedSubst0CongrSupplyMajSemBi` / `piRow_of_adequate_and_typedSubst0_maj`) -/

/-! ### §27.1. Non-`λ` Spine Inversion in `ApproxDIK`, `letBinding` Step/Reduction Trichotomy for
`WhStepPiKClosedCtxMaj` / `WhRedPiKClosedCtxMaj`, and `LRPiWf2Maj` Calculus -/

/-- A sort `.sort l` has no `.spine r args` compact in `ApproxDIK E ρ`
    (`approxDIK_sort_not_spine`). -/
theorem approxDIK_sort_not_spine {E : ResolvedEnv} {ρ : EnvI} (l : Level)
    (r : Nat) (args : List CptI) :
    ¬ ApproxDIK E ρ (.sort l) (.spine r args) := by
  intro h
  rcases approxDIK_sort_inv h with h0 | h0 <;> cases h0

/-- A $\Pi$-type `.pi A B` has no `.spine r args` compact in `ApproxDIK E ρ`
    (`approxDIK_pi_not_spine`). -/
theorem approxDIK_pi_not_spine {E : ResolvedEnv} {ρ : EnvI} (A B : Expr Nat)
    (r : Nat) (args : List CptI) :
    ¬ ApproxDIK E ρ (.pi A B) (.spine r args) := by
  intro h
  rcases approxDIK_pi_inv h with h0 | ⟨_, _, h0, _, _⟩ <;> cases h0

/-- **Non-`λ` Application Spine Inversion (`approxDIK_app_spine_inv_of_no_lam`):**
    If `f` has no `.lam g` compact in `ApproxDIK E ρ`, then any `.spine r us` compact of `.app f x`
    must arise from `ApproxDIK.appSpine` (`∃ args u, us = args ++ [u] ∧ ApproxDIK E ρ f (.spine r args) ∧ ApproxDIK E ρ x u`). -/
theorem approxDIK_app_spine_inv_of_no_lam {E : ResolvedEnv} {ρ : EnvI} {f x : Expr Nat}
    (hf : ∀ g, ¬ ApproxDIK E ρ f (.lam g)) {r : Nat} {us : List CptI}
    (h : ApproxDIK E ρ (.app f x) (.spine r us)) :
    ∃ args u, us = args ++ [u] ∧ ApproxDIK E ρ f (.spine r args) ∧ ApproxDIK E ρ x u := by
  rcases approxDIK_app_inv h with hbot | ⟨g, _, _, hfg, _, _⟩ | ⟨r', args, u, hsp, hfs, hxu⟩
  · cases hbot
  · exact (hf g hfg).elim
  · injection hsp with hr hus
    subst hr
    exact ⟨args, u, hus, hfs, hxu⟩

/-- **Multi-Argument Non-`λ` Spine Inversion (`approxDIK_foldApps_spine_inv_of_no_lam`):**
    If `f` has no `.lam g` compact in `ApproxDIK E ρ`, then any `.spine r us` compact of
    `foldApps f xs` forces `∃ us₀, ApproxDIK E ρ f (.spine r us₀)` on the head `f`! -/
theorem approxDIK_foldApps_spine_inv_of_no_lam {E : ResolvedEnv} {ρ : EnvI} {f : Expr Nat}
    (hf : ∀ g, ¬ ApproxDIK E ρ f (.lam g)) :
    ∀ (xs : List (Expr Nat)) {r : Nat} {us : List CptI},
      ApproxDIK E ρ (foldApps f xs) (.spine r us) →
      ∃ us₀, ApproxDIK E ρ f (.spine r us₀)
  | [], _, us, h => ⟨us, h⟩
  | x :: xs, _, _, h => by
      obtain ⟨us₁, hfx⟩ :=
        approxDIK_foldApps_spine_inv_of_no_lam (approxDIK_app_not_lam_of_not_lam hf x) xs h
      obtain ⟨args, _, _, hf_sp, _⟩ := approxDIK_app_spine_inv_of_no_lam hf hfx
      exact ⟨args, hf_sp⟩

/-- **Non-`λ`, Non-Constructor-Spine `ctorTagCpt` Exclusion Across Arbitrary Argument Spines
    (`approxDIK_foldApps_not_ctorTagCpt_of_no_lam_no_ctor_spine`):**
    Whenever `v` has no `.lam g` compact and no `.spine w.ctorRef us` compact in `ApproxDIK E ρ`,
    `foldApps v args` can **never** approximate `ctorTagCpt w` for **any** `w : IotaWitnessS E` and
    **any** `args : List (Expr Nat)`! -/
theorem approxDIK_foldApps_not_ctorTagCpt_of_no_lam_no_ctor_spine
    {E : ResolvedEnv} {ρ : EnvI} {v : Expr Nat}
    (hnolam : ∀ g, ¬ ApproxDIK E ρ v (.lam g))
    (hnoCtor : ∀ (w : IotaWitnessS E) (us : List CptI), ¬ ApproxDIK E ρ v (.spine w.ctorRef us))
    (w : IotaWitnessS E) (args : List (Expr Nat)) :
    ¬ ApproxDIK E ρ (foldApps v args) (ctorTagCpt w) := by
  intro h
  unfold ctorTagCpt at h
  obtain ⟨us₀, hv_sp⟩ := approxDIK_foldApps_spine_inv_of_no_lam hnolam args h
  exact hnoCtor w us₀ hv_sp

/-- If `f` has neither `.lam g` nor `.spine r us` in `ApproxDIK E ρ`, then `.app f x` only
    approximates `.bot` (`approxDIK_app_eq_bot_of_no_lam_no_spine`). -/
theorem approxDIK_app_eq_bot_of_no_lam_no_spine {E : ResolvedEnv} {ρ : EnvI} {f x : Expr Nat}
    (hnolam : ∀ g, ¬ ApproxDIK E ρ f (.lam g))
    (hnosp : ∀ r us, ¬ ApproxDIK E ρ f (.spine r us))
    {c : CptI} (h : ApproxDIK E ρ (.app f x) c) :
    c = .bot := by
  rcases approxDIK_app_inv h with rfl | ⟨g, _, _, hfg, _, _⟩ | ⟨r, args, _, _, hfs, _⟩
  · rfl
  · exact (hnolam g hfg).elim
  · exact (hnosp r args hfs).elim

/-- If `f` has neither `.lam g` nor `.spine r us` in `ApproxDIK E ρ`, then `foldApps f (x :: xs)`
    only approximates `.bot` across **all** compacts `c : CptI`
    (`approxDIK_foldApps_cons_eq_bot_of_no_lam_no_spine`). -/
theorem approxDIK_foldApps_cons_eq_bot_of_no_lam_no_spine
    {E : ResolvedEnv} {ρ : EnvI} {f : Expr Nat}
    (hnolam : ∀ g, ¬ ApproxDIK E ρ f (.lam g))
    (hnosp : ∀ r us, ¬ ApproxDIK E ρ f (.spine r us))
    (x : Expr Nat) (xs : List (Expr Nat)) {c : CptI}
    (h : ApproxDIK E ρ (foldApps f (x :: xs)) c) :
    c = .bot :=
  approxDIK_foldApps_eq_bot_of_eq_bot
    (fun _ hc => approxDIK_app_eq_bot_of_no_lam_no_spine hnolam hnosp hc) xs h

/-- Every non-constructor `RigidConst E r` spine `foldApps (.const r ls) args` (`m.body = none`,
    `m.mclass ≠ .recursorM`, `m.mclass ≠ .constructorM`) has no `.spine w.ctorRef us` compact in
    `ApproxDIK E ρ` (`approxDIK_foldApps_rigidConst_nonCtor_not_ctor_spine`). -/
theorem approxDIK_foldApps_rigidConst_nonCtor_not_ctor_spine
    {E : ResolvedEnv} {ρ : EnvI} {r : Nat} {ls : List Level}
    {m : CheckedMember} (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (hnctor : m.mclass ≠ .constructorM)
    (args : List (Expr Nat)) (w : IotaWitnessS E) (us : List CptI) :
    ¬ ApproxDIK E ρ (foldApps (.const r ls) args) (.spine w.ctorRef us) := by
  intro h
  obtain ⟨us₀, hc⟩ :=
    approxDIK_foldApps_spine_inv_of_no_lam (approxDIK_rigidConst_not_lam hm hb hnrec) args h
  rcases approxDIK_rigid_const_inv (rigidConst_of_body_none hm hb hnrec) hc with hbot | hsp
  · cases hbot
  · injection hsp with hr _
    have hmem : some w.ctorMember = some m := by rw [← w.hctor, hr, hm]
    injection hmem with hmem'
    exact hnctor (hmem' ▸ w.hctorK)

/-- **Single-Step `letBinding` Trichotomy for `WhStepPiKClosedCtxMaj` Under `PrunedSemEqDIK`
    (`whStepPiKClosedCtxMaj_letBinding_trichotomy`):**
    Because `iotaKClosedCtxMaj_letBinding_guard_iff_of_prunedSemEqDIK` preserves `ctorTagCpt w`
    between `.letBinding A₁ v₁ :: Γ` and `.letBinding A₂ v₂ :: Γ` whenever
    `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂`, any single step
    `WhStepPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) a b` satisfies one of three cases:
    1. **Shared step**: `WhStepPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) a b` holds in `.letBinding A₂ v₂ :: Γ`,
    2. **Top-level `.bvar 0` spine**: `∃ args, a = foldApps (.bvar 0) args`, or
    3. **Major-premise `.bvar 0` spine with `ctorTagCpt w`**: `.zetaLocal 0` fired inside `recMajor`,
       so `∃ w args, ApproxDIK E (ctxEnvDIK E (.letBinding A₁ v₁ :: Γ)) (foldApps (.bvar 0) args) (ctorTagCpt w)`. -/
theorem whStepPiKClosedCtxMaj_letBinding_trichotomy {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    {a b : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) a b) :
    WhStepPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) a b ∨
      (∃ args : List (Expr Nat), a = foldApps (.bvar 0) args) ∨
      (∃ (w : IotaWitnessS E) (args : List (Expr Nat)),
        ApproxDIK E (ctxEnvDIK E (.letBinding A₁ v₁ :: Γ)) (foldApps (.bvar 0) args) (ctorTagCpt w)) := by
  induction hs with
  | of_whStep hs₀ =>
      exact Or.inl (.of_whStep hs₀)
  | @zetaLocal i val hval =>
      cases i with
      | zero => exact Or.inr (Or.inl ⟨[], rfl⟩)
      | succ k => exact Or.inl (.zetaLocal hval)
  | iotaS w ls lsC pre params fields hpre hpar hflds =>
      exact Or.inl (.iotaS w ls lsC pre params fields hpre hpar hflds)
  | iotaKClosedCtx w ls pre x hk hpre hx =>
      exact Or.inl (.iotaKClosedCtx w ls pre x hk hpre
        (fun h₂ => hx ((iotaKClosedCtxMaj_letBinding_guard_iff_of_prunedSemEqDIK w A₁ A₂ hv x).mpr h₂)))
  | @recMajor w ls pre x x' hpre htag _ ih =>
      rcases ih with hs₂ | ⟨args, rfl⟩ | ⟨w', args, htag'⟩
      · exact Or.inl (.recMajor w ls pre x x' hpre
          ((iotaKClosedCtxMaj_letBinding_guard_iff_of_prunedSemEqDIK w A₁ A₂ hv x).mp htag) hs₂)
      · exact Or.inr (Or.inr ⟨w, args, htag⟩)
      · exact Or.inr (Or.inr ⟨w', args, htag'⟩)
  | @appHead f f' arg _ ih =>
      rcases ih with hs₂ | ⟨args, rfl⟩ | ⟨w', args, htag'⟩
      · exact Or.inl (.appHead hs₂)
      · exact Or.inr (Or.inl ⟨args ++ [arg], by rw [foldApps_snoc]⟩)
      · exact Or.inr (Or.inr ⟨w', args, htag'⟩)

/-- **Single-Step `letBinding` Dichotomy for `WhStepPiKClosedCtxMaj` When `foldApps v₁ args` Never
    Approximates `ctorTagCpt w` (`whStepPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag`):**
    Eliminates Branch 3 of `whStepPiKClosedCtxMaj_letBinding_trichotomy`, leaving the exact 2-way
    dichotomy `WhStepPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) a b ∨ ∃ args, a = foldApps (.bvar 0) args`! -/
theorem whStepPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_noCtor : ∀ (w : IotaWitnessS E) (args : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ args) (ctorTagCpt w))
    {a b : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) a b) :
    WhStepPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) a b ∨
      ∃ args : List (Expr Nat), a = foldApps (.bvar 0) args := by
  rcases whStepPiKClosedCtxMaj_letBinding_trichotomy A₁ A₂ hv hs with
    hs₂ | hbvar | ⟨w, args, htag⟩
  · exact Or.inl hs₂
  · exact Or.inr hbvar
  · have htag0 : ApproxDIK E (ctxEnvDIK E Γ)
        (instantiate0 v₁ (foldApps (.bvar 0) args)) (ctorTagCpt w) :=
      (approxDIK_ctxEnvDIK_substLet0_iff E A₁ v₁ Γ (foldApps (.bvar 0) args) (ctorTagCpt w)).mpr htag
    rw [instantiate0_foldApps_bvar0] at htag0
    exact (hv_noCtor w (args.map (instantiate0 v₁)) htag0).elim

/-- **Multi-Step `letBinding` Dichotomy for `WhRedPiKClosedCtxMaj` When `foldApps v₁ args` Never
    Approximates `ctorTagCpt w` (`whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag`):** -/
theorem whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag {E : ResolvedEnv} {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_noCtor : ∀ (w : IotaWitnessS E) (args : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ args) (ctorTagCpt w))
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b c) :
    WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b c ∨
      ∃ args : List (Expr Nat),
        WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (foldApps (.bvar 0) args) ∧
        WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (foldApps (.bvar 0) args) ∧
        WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) (foldApps (.bvar 0) args) c := by
  induction hred with
  | refl a =>
      exact Or.inl (.refl a)
  | @step a m c hs hrest ih =>
      rcases whStepPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag A₁ A₂ hv hv_noCtor hs with
        hs₂ | ⟨args, rfl⟩
      · rcases ih with hrest₂ | ⟨args, hm₁, hm₂, hrem⟩
        · exact Or.inl (.step hs₂ hrest₂)
        · exact Or.inr ⟨args, .step hs hm₁, .step hs₂ hm₂, hrem⟩
      · exact Or.inr ⟨args, .refl _, .refl _, .step hs hrest⟩

/-- **3-Way Instantiated Reduction Trichotomy for `WhRedPiKClosedCtxMaj`
    (`whRedPiKClosedCtxMaj_substLet0_trichotomy_of_no_ctorTag`):** -/
theorem whRedPiKClosedCtxMaj_substLet0_trichotomy_of_no_ctorTag {E : ResolvedEnv}
    (hcl : EnvClosed E) {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_noCtor : ∀ (w : IotaWitnessS E) (args : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ args) (ctorTagCpt w))
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b c) :
    (WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b c ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (instantiate0 v₁ c) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (instantiate0 v₂ c)) ∨
    (WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) v₁ ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) v₂) ∨
    (∃ (arg₀ : Expr Nat) (rest : List (Expr Nat)),
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b)
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b)
        (foldApps v₂ (instantiate0 v₂ arg₀ :: rest.map (instantiate0 v₂)))) := by
  rcases whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag A₁ A₂ hv hv_noCtor hred with
    hred₂ | ⟨args, hm₁, hm₂, _⟩
  · exact Or.inl ⟨hred₂,
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₁ v₁ hred,
      whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₂ v₂ hred₂⟩
  · have hsub₁ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₁ v₁ hm₁
    have hsub₂ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A₂ v₂ hm₂
    rw [instantiate0_foldApps_bvar0] at hsub₁ hsub₂
    cases args with
    | nil =>
        exact Or.inr (Or.inl ⟨hm₁, hm₂, hsub₁, hsub₂⟩)
    | cons arg₀ rest =>
        exact Or.inr (Or.inr ⟨arg₀, rest, hsub₁, hsub₂⟩)

/-- **2-Way Instantiated Reduction Dichotomy for `WhRedPiKClosedCtxMaj` on Non-`⊥` Probes When `v₁`
    Has Neither `.lam g` Nor `ctorTagCpt w` Spines
    (`whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctorTag`):**
    Eliminates Branch 3 (`args = arg₀ :: rest`) on any non-`⊥` `ProbeCpt` compact `c₀`, leaving ONLY:
    - **Branch 1 (shared target `c`)**: `b ↠whMaj c` in both `.letBinding` contexts, so
      `instantiate0 v₁ b ↠whMaj instantiate0 v₁ c` and `instantiate0 v₂ b ↠whMaj instantiate0 v₂ c`, or
    - **Branch 2 (direct reduction through `.bvar 0`)**: `b ↠whMaj .bvar 0` in both `.letBinding`
      contexts, so `instantiate0 v₁ b ↠whMaj v₁` and `instantiate0 v₂ b ↠whMaj v₂`! -/
theorem whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctorTag {E : ResolvedEnv}
    (hW : EnvWfT E) {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv_noCtor : ∀ (w : IotaWitnessS E) (args : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ args) (ctorTagCpt w))
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b c)
    {c₀ : CptI} (hc₀ : ProbeCpt c₀) (hne : c₀ ≠ .bot)
    (happrox : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c₀) :
    (WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b c ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (instantiate0 v₁ c) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (instantiate0 v₂ c)) ∨
    (WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) v₁ ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) v₂) := by
  have hcl := envClosed_of_envWfT hW
  rcases whRedPiKClosedCtxMaj_substLet0_trichotomy_of_no_ctorTag hcl A₁ A₂ hv hv_noCtor hred with
    hbranch1 | hbranch2 | ⟨arg₀, rest, hsub₁, _⟩
  · exact Or.inl hbranch1
  · exact Or.inr hbranch2
  · have hsp : ApproxDIK E (ctxEnvDIK E Γ)
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) c₀ :=
      (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ c₀).mp happrox
    exact (hne (approxDIK_foldApps_probeCpt_eq_bot_of_no_lam hv_nolam
      (instantiate0 v₁ arg₀) (rest.map (instantiate0 v₁)) hc₀ hsp)).elim

/-- Specialization of `whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctorTag` using
    `approxDIK_foldApps_not_ctorTagCpt_of_no_lam_no_ctor_spine`
    (`whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctor_spine`). -/
theorem whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctor_spine {E : ResolvedEnv}
    (hW : EnvWfT E) {Γ : LCtx}
    (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv_noCtorSp : ∀ (w : IotaWitnessS E) (us : List CptI),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine w.ctorRef us))
    {b c : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b c)
    {c₀ : CptI} (hc₀ : ProbeCpt c₀) (hne : c₀ ≠ .bot)
    (happrox : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c₀) :
    (WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b c ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (instantiate0 v₁ c) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (instantiate0 v₂ c)) ∨
    (WhRedPiKClosedCtxMaj E (.letBinding A₁ v₁ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E (.letBinding A₂ v₂ :: Γ) b (.bvar 0) ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) v₁ ∧
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) v₂) :=
  whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctorTag hW A₁ A₂ hv hv_nolam
    (approxDIK_foldApps_not_ctorTagCpt_of_no_lam_no_ctor_spine hv_nolam hv_noCtorSp)
    hred hc₀ hne happrox

/-- Two-way invariance (`↔`) of `WhRedPiKClosedCtxMaj E Γ · (.pi D₁ D₂)` along any weak-head
    reduction `WhRedPiKClosedCtxMaj E Γ M X` (`whRedPiKClosedCtxMaj_pi_iff_of_whRed`). -/
theorem whRedPiKClosedCtxMaj_pi_iff_of_whRed {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {M X : Expr Nat} (hMX : WhRedPiKClosedCtxMaj E Γ M X) (D₁ D₂ : Expr Nat) :
    WhRedPiKClosedCtxMaj E Γ M (.pi D₁ D₂) ↔ WhRedPiKClosedCtxMaj E Γ X (.pi D₁ D₂) := by
  constructor
  · intro hM
    rcases whRedPiKClosedCtxMaj_det_branch hW hMX hM with hX | hpi
    · exact hX
    · rw [whRedPiKClosedCtxMaj_pi_eq hpi]; exact .refl _
  · exact hMX.trans

/-- **Depth-2 $\Pi$-Well-Formedness Under `WhRedPiKClosedCtxMaj` (`LRPiWf2Maj E n Γ M`):**
    Whenever `M` weak-head reduces under `WhRedPiKClosedCtxMaj E Γ` to `.pi D₁ D₂`, both `D₁`
    (in `Γ`) and `D₂` (in `.assumption D₁ :: Γ`) are sort-typed in `HasTyT`. -/
def LRPiWf2Maj (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M : Expr Nat) : Prop :=
  ∀ D₁ D₂, WhRedPiKClosedCtxMaj E Γ M (.pi D₁ D₂) →
    ∃ u₁ u₂, Nonempty (HasTyT E n Γ D₁ (.sort u₁)) ∧
      Nonempty (HasTyT E n (.assumption D₁ :: Γ) D₂ (.sort u₂))

theorem lrPiWf2Maj_pi {E : ResolvedEnv} {n : Nat} {Γ : LCtx} {A B : Expr Nat} {u₁ u₂ : Level}
    (hA : HasTyT E n Γ A (.sort u₁))
    (hB : HasTyT E n (.assumption A :: Γ) B (.sort u₂)) :
    LRPiWf2Maj E n Γ (.pi A B) := by
  intro D₁ D₂ hred
  have heq := whRedPiKClosedCtxMaj_pi_eq hred
  injection heq with e₁ e₂
  subst e₁; subst e₂
  exact ⟨u₁, u₂, ⟨hA⟩, ⟨hB⟩⟩

theorem lrPiWf2Maj_sort (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (l : Level) :
    LRPiWf2Maj E n Γ (.sort l) := by
  intro D₁ D₂ hred
  exact Expr.noConfusion (whRedPiKClosedCtxMaj_sort_eq hred)

theorem lrPiWf2Maj_lam (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (A b : Expr Nat) :
    LRPiWf2Maj E n Γ (.lam A b) := by
  intro D₁ D₂ hred
  exact Expr.noConfusion (whRedPiKClosedCtxMaj_of_normal (whNormalPiKClosedCtxMaj_lam E Γ A b) hred)

theorem lrPiWf2Maj_of_no_pi_approx {E : ResolvedEnv} (hW : EnvWfT E) (n : Nat) {Γ : LCtx}
    {M : Expr Nat} (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) M (.pi .bot [])) :
    LRPiWf2Maj E n Γ M := by
  intro D₁ D₂ hred
  have hpi : ApproxDIK E (ctxEnvDIK E Γ) M (.pi .bot []) :=
    (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (.pi .bot [])).mpr
      (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) D₁ D₂)
  exact (hnopi hpi).elim

theorem lrPiWf2Maj_whRedPiKClosedCtxMaj_iff {E : ResolvedEnv} (hW : EnvWfT E) {n : Nat} {Γ : LCtx}
    {M X : Expr Nat} (hMX : WhRedPiKClosedCtxMaj E Γ M X) :
    LRPiWf2Maj E n Γ M ↔ LRPiWf2Maj E n Γ X :=
  ⟨fun hM D₁ D₂ hX => hM D₁ D₂ ((whRedPiKClosedCtxMaj_pi_iff_of_whRed hW hMX D₁ D₂).mpr hX),
   fun hX D₁ D₂ hM => hX D₁ D₂ ((whRedPiKClosedCtxMaj_pi_iff_of_whRed hW hMX D₁ D₂).mp hM)⟩

theorem lrPiWf2Maj_ctx_of_sameLetProfile {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ Γ' : LCtx} (hctx : CtxConvT E n Γ Γ') (hprof : SameLetProfile Γ Γ')
    {M : Expr Nat} (h : LRPiWf2Maj E n Γ M) :
    LRPiWf2Maj E n Γ' M := by
  intro D₁ D₂ hred'
  have hred : WhRedPiKClosedCtxMaj E Γ M (.pi D₁ D₂) :=
    whRedPiKClosedCtxMaj_of_sameLetProfile (sameLetProfile_symm hprof) hred'
  obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := h D₁ D₂ hred
  exact ⟨u₁, u₂, ⟨hasTyT_ctx hcl hctx hD₁⟩,
    ⟨hasTyT_ctx hcl (.same (.assumption D₁) hctx) hD₂⟩⟩

/-! ### §27.2. Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Discharges in `LRTermMajSemBi`
Across All Non-`λ`, Non-Constructor-Spine Let-Values (Zero `hb_inst₁`, Zero `hb_inst₂`, Zero `hb_let₂`,
Zero `CtxWfT`) -/

/-- **Master Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence Theorem in
    `LRTermMajSemBi` for Non-`λ`, Non-Constructor-Spine Let-Values
    (`lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine`):**
    Whenever `v₁` has no `.lam g` compact and no `.spine w.ctorRef us` compact in
    `ApproxDIK E (ctxEnvDIK E Γ)`:
    - Every `ProbeCpt` compact `c ∈ {.bot, .sort, .pi .bot []}` of `instantiate0 v₁ b` or
      `instantiate0 v₂ b` transfers via `hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂` and
      `approxDIK_ctxEnvDIK_substLet0_iff` to `ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b c`;
    - Applying `hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B` directly yields either
      `IsSemPropTyI E n Γ (instantiate0 v₁ B)` (via `isSemPropTyI_substLet0`),
      `ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ B) (.pi .bot [])` (via `approxDIK_ctxEnvDIK_substLet0_iff`),
      or a weak-head reduction `b ↠whMaj .sort l₁` / `b ↠whMaj .pi D₁ C₁` in `.letBinding A v₁ :: Γ`;
    - Applying `whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctor_spine` splits that
      reduction into Branch 1 (shared target `.sort l₁` or `.pi D₁ C₁`, closed by
      `lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_same_pi` + `hb_wf2`) or Branch 2
      (`instantiate0 v₁ b ↠whMaj v₁` and `instantiate0 v₂ b ↠whMaj v₂`, closed by `hv_probe`)!
    Requires **ZERO `hb_inst₁`, ZERO `hb_inst₂`, ZERO `hb_let₂`, and ZERO `CtxWfT E n Γ`**! -/
theorem lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv_noCtorSp : ∀ (w : IotaWitnessS E) (us : List CptI),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine w.ctorRef us))
    (hv_probe : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) v₁ c →
      LRProbeTypePiKClosedCtxMaj E n Γ v₁ v₂ c)
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hinst₁ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c :=
    hor.elim id (fun h₂ => (approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hv_sem b hc_p).mpr h₂)
  have hb_c : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b c :=
    (approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ b c).mp hinst₁
  rcases hb_let₁ c hc (Or.inl hb_c) with hPB | hpiB | hlr
  · exact Or.inl (isSemPropTyI_substLet0 hW hv₁ hPB)
  · exact Or.inr (Or.inl
      ((approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ B (.pi .bot [])).mpr hpiB))
  · cases hc with
    | bot => exact Or.inr (Or.inr (.bot Γ _ _))
    | sort =>
        obtain ⟨l₁, hred_b⟩ := lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlr
        have hne : CptI.sort ≠ .bot := by intro h0; cases h0
        rcases whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctor_spine
            hW A A hv_sem hv_nolam hv_noCtorSp hred_b .sort hne hinst₁ with
          ⟨_, hsub₁, hsub₂⟩ | ⟨_, _, hsub₁, hsub₂⟩
        · exact Or.inr (Or.inr (.sort hsub₁ hsub₂))
        · have hv₁_s : ApproxDIK E (ctxEnvDIK E Γ) v₁ .sort :=
            (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ .sort).mp hinst₁
          exact Or.inr (Or.inr
            (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
              (hv_probe .sort .sort hv₁_s)))
    | piBotNil =>
        obtain ⟨D₁, D₂, hred_b⟩ := lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlr
        have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
        rcases whRedPiKClosedCtxMaj_substLet0_dichotomy_of_no_lam_no_ctor_spine
            hW A A hv_sem hv_nolam hv_noCtorSp hred_b .piBotNil hne hinst₁ with
          ⟨hred_b₂, _, _⟩ | ⟨_, _, hsub₁, hsub₂⟩
        · obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := hb_wf2 D₁ D₂ hred_b
          exact lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_same_pi hW
            (instantiate0 v₁ B) hA hv₁ hv₂ hcv hred_b hred_b₂ hD₁ hD₂
            (.pi .bot []) .piBotNil (Or.inl hinst₁)
        · have hv₁_pi : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) :=
            (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ (.pi .bot [])).mp hinst₁
          exact Or.inr (Or.inr
            (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
              (hv_probe (.pi .bot []) .piBotNil hv₁_pi)))

/-- **Automatic `PrunedSemEqDIK` + Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence
    for Non-`.spine`, Non-`.lam` Terms (`lrTermMajSemBi_subst0_of_no_spine_no_lam`):**
    Combines `prunedSemEqDIK_of_lrTermMajSemBi_no_spine_no_lam` with
    `lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine` so that **not even `hv_sem : PrunedSemEqDIK`
    needs to be supplied**! -/
theorem lrTermMajSemBi_subst0_of_no_spine_no_lam
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsSemPropTyI E n Γ A)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (hv₁_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine r args))
    (hv₂_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₂ (.spine r args))
    (hv₁_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv₂_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₂ (.lam g))
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  have hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂ :=
    prunedSemEqDIK_of_lrTermMajSemBi_no_spine_no_lam hW ih_v hnoprop hnopi
      hv₁_nosp hv₂_nosp hv₁_nolam hv₂_nolam
  have hv_probe : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) v₁ c →
      LRProbeTypePiKClosedCtxMaj E n Γ v₁ v₂ c := by
    intro c hc hv₁_c
    rcases ih_v c hc (Or.inl hv₁_c) with hPA | hpiA | hlr
    · exact (hnoprop hPA).elim
    · exact (hnopi hpiA).elim
    · exact hlr
  exact lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv hv_sem
    hv₁_nolam (fun w us => hv₁_nosp w.ctorRef us) hv_probe hb_let₁ hb_wf2

/-- Specialization of `lrTermMajSemBi_subst0_of_no_spine_no_lam` to `A = .sort u`
    (`lrTermMajSemBi_subst0_of_no_spine_no_lam_sort`). -/
theorem lrTermMajSemBi_subst0_of_no_spine_no_lam_sort
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {v₁ v₂ b B : Expr Nat} {u : Level}
    (hv₁ : HasTyT E n Γ v₁ (.sort u)) (hv₂ : HasTyT E n Γ v₂ (.sort u))
    (hcv : ConvT E n Γ v₁ v₂ (.sort u))
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ (.sort u))
    (hv₁_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine r args))
    (hv₂_nosp : ∀ r args, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₂ (.spine r args))
    (hv₁_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g))
    (hv₂_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₂ (.lam g))
    (hb_let₁ : LRTermMajSemBi E n (.letBinding (.sort u) v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding (.sort u) v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermMajSemBi_subst0_of_no_spine_no_lam hW (.sort Γ u) hv₁ hv₂ hcv ih_v
    (not_isSemPropTyI_sort E n Γ u) (approxDIK_sort_not_pi u .bot [])
    hv₁_nosp hv₂_nosp hv₁_nolam hv₂_nolam hb_let₁ hb_wf2

/-- **Unconditional Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence for Any Two
    Assumption-Variable Spines (`lrTermMajSemBi_subst0_bvar_none_spine_of_let₁`):**
    Holds at **every** type `A` (even when `A` is a $\Pi$-type or proposition!) with **zero `ih_v`,
    zero `hv_sem`, zero `hb_inst₁, hb_inst₂, hb_let₂`, and zero `CtxWfT E n Γ`**! -/
theorem lrTermMajSemBi_subst0_bvar_none_spine_of_let₁
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) {A b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.bvar i₁) xs₁) A)
    (hv₂ : HasTyT E n Γ (foldApps (.bvar i₂) xs₂) A)
    (hcv : ConvT E n Γ (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) A)
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A (foldApps (.bvar i₁) xs₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A (foldApps (.bvar i₁) xs₁) :: Γ) b) :
    LRTermMajSemBi E n Γ
      (instantiate0 (foldApps (.bvar i₁) xs₁) b)
      (instantiate0 (foldApps (.bvar i₂) xs₂) b)
      (instantiate0 (foldApps (.bvar i₁) xs₁) B) := by
  refine lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv
    (prunedSemEqDIK_ctxEnvDIK_foldApps_bvar_none hnone₁ hnone₂ xs₁ xs₂)
    (approxDIK_foldApps_bvar_none_not_lam hnone₁ xs₁)
    (fun w us => approxDIK_ctxEnvDIK_foldApps_bvar_none_not_spine hnone₁ xs₁ w.ctorRef us)
    (fun c _ hc => ?_) hb_let₁ hb_wf2
  rw [approxDIK_ctxEnvDIK_foldApps_bvar_none_eq_bot hnone₁ xs₁ hc]
  exact .bot Γ _ _

/-- **Unconditional Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence for Any Two
    Non-K Recursor Spines at Non-`ctorTagCpt` Majors
    (`lrTermMajSemBi_subst0_recursor_nonK_no_ctorTag_of_let₁`):**
    Holds at **every** type `A` with **zero `ih_v`, zero `hv_sem`, zero `hb_inst₁, hb_inst₂, hb_let₂`,
    and zero `CtxWfT E n Γ`**! -/
theorem lrTermMajSemBi_subst0_recursor_nonK_no_ctorTag_of_let₁
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {pre₁ pre₂ : List (Expr Nat)}
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    {x₁ x₂ : Expr Nat} (rest₁ rest₂ : List (Expr Nat))
    (hnotK₁ : ¬ (piBody w₁.famMember.mtype = .sort .zero ∧ w₁.nMinors = 1))
    (hnotK₂ : ¬ (piBody w₂.famMember.mtype = .sort .zero ∧ w₂.nMinors = 1))
    (hnoCtor₁ : ∀ (w' : IotaWitnessS E), w'.recRef = w₁.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₁ (ctorTagCpt w'))
    (hnoCtor₂ : ∀ (w' : IotaWitnessS E), w'.recRef = w₂.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₂ (ctorTagCpt w'))
    {A b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) A)
    (hv₂ : HasTyT E n Γ (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) A)
    (hcv : ConvT E n Γ
      (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁)
      (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) A)
    (hb_let₁ : LRTermMajSemBi E n
      (.letBinding A (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n
      (.letBinding A (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) :: Γ) b) :
    LRTermMajSemBi E n Γ
      (instantiate0 (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) b)
      (instantiate0 (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) b)
      (instantiate0 (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) B) := by
  have hbot₁ : ∀ c, ApproxDIK E (ctxEnvDIK E Γ)
      (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁) c → c = .bot :=
    fun _ hc => approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot w₁ ls₁ hpre₁ rest₁ hnotK₁ hnoCtor₁ hc
  have hbot₂ : ∀ c, ApproxDIK E (ctxEnvDIK E Γ)
      (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) c → c = .bot :=
    fun _ hc => approxDIK_recursor_foldApps_no_ctorTag_nonK_eq_bot w₂ ls₂ hpre₂ rest₂ hnotK₂ hnoCtor₂ hc
  have hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ)
      (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁)
      (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) := by
    intro c _
    exact ⟨fun h₁ => by rw [hbot₁ c h₁]; exact .bot _ _,
           fun h₂ => by rw [hbot₂ c h₂]; exact .bot _ _⟩
  refine lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv hv_sem
    (fun g h => by have h0 := hbot₁ (.lam g) h; cases h0)
    (fun w us h => by have h0 := hbot₁ (.spine w.ctorRef us) h; cases h0)
    (fun c _ hc => by rw [hbot₁ c hc]; exact .bot Γ _ _)
    hb_let₁ hb_wf2

/-- **Unconditional Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence for Any
    Non-Constructor `RigidConst` Spine (`lrTermMajSemBi_subst0_rigidConst_nonCtor_spine_of_let₁`):**
    Requires **zero `ih_v`, zero `hb_inst₁, hb_inst₂, hb_let₂`, and zero `CtxWfT E n Γ`**! -/
theorem lrTermMajSemBi_subst0_rigidConst_nonCtor_spine_of_let₁
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (hnctor : m.mclass ≠ .constructorM)
    {args : List (Expr Nat)} {A v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ (foldApps (.const r ls) args) A)
    (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ (foldApps (.const r ls) args) v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) (foldApps (.const r ls) args) v₂)
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A (foldApps (.const r ls) args) :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A (foldApps (.const r ls) args) :: Γ) b) :
    LRTermMajSemBi E n Γ
      (instantiate0 (foldApps (.const r ls) args) b)
      (instantiate0 v₂ b)
      (instantiate0 (foldApps (.const r ls) args) B) := by
  refine lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv hv_sem
    (approxDIK_foldApps_rigidConst_not_lam hm hb hnrec args)
    (approxDIK_foldApps_rigidConst_nonCtor_not_ctor_spine hm hb hnrec hnctor args)
    (fun c hc h => ?_) hb_let₁ hb_wf2
  rw [approxDIK_foldApps_rigidConst_probeCpt_eq_bot (rigidConst_of_body_none hm hb hnrec) args hc h]
  exact .bot Γ _ _

/-- **Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence When `v₁` Weak-Head Reduces
    Under `WhRedPiKClosedCtxMaj` to a Sort `.sort l₁`
    (`lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_sort_of_let₁`):**
    Upgrades `lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_sort` by eliminating `hb_inst₁` and
    `hb_inst₂` in `Γ` completely, requiring ONLY `ih_v`, `hred₁ : WhRedPiKClosedCtxMaj E Γ v₁ (.sort l₁)`,
    `hb_let₁`, and `hb_wf2`! -/
theorem lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_sort_of_let₁
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ b B : Expr Nat} {l₁ u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsSemPropTyI E n Γ A)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (hred₁ : WhRedPiKClosedCtxMaj E Γ v₁ (.sort l₁))
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  obtain ⟨⟨l₂, hred₂⟩, hv_sem⟩ :=
    whRedPiKClosedCtxMaj_sort_right_and_prunedSemEqDIK_of_lrTermMajSemBi
      hW ih_v hnoprop hnopi hred₁
  have hsem₁ := semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred₁
  have hv₁_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g) :=
    fun g h => approxDIK_sort_not_lam l₁ g ((hsem₁ (.lam g)).mp h)
  have hv₁_noCtor : ∀ (w : IotaWitnessS E) (us : List CptI),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine w.ctorRef us) :=
    fun w us h => approxDIK_sort_not_spine l₁ w.ctorRef us ((hsem₁ (.spine w.ctorRef us)).mp h)
  have hv_probe : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) v₁ c →
      LRProbeTypePiKClosedCtxMaj E n Γ v₁ v₂ c := by
    intro c hc hv₁_c
    cases hc with
    | bot => exact .bot Γ v₁ v₂
    | sort => exact .sort hred₁ hred₂
    | piBotNil => exact (approxDIK_sort_not_pi l₁ .bot [] ((hsem₁ (.pi .bot [])).mp hv₁_c)).elim
  exact lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv hv_sem
    hv₁_nolam hv₁_noCtor hv_probe hb_let₁ hb_wf2

/-- **Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence When `v₁` Weak-Head Reduces
    Under `WhRedPiKClosedCtxMaj` to a $\Pi$-Type `.pi P₁ Q₁`
    (`lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_pi_of_let₁`):**
    Requires ONLY `ih_v`, `hred₁ : WhRedPiKClosedCtxMaj E Γ v₁ (.pi P₁ Q₁)`, `hb_let₁`, and `hb_wf2`
    (with **zero `hb_inst₁`, zero `hb_inst₂`, zero `hb_let₂`, and zero `CtxWfT E n Γ`**)! -/
theorem lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_pi_of_let₁
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ P₁ Q₁ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A)
    (hnoprop : ¬ IsSemPropTyI E n Γ A)
    (hnopi : ¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []))
    (hred₁ : WhRedPiKClosedCtxMaj E Γ v₁ (.pi P₁ Q₁))
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  obtain ⟨⟨P₂, Q₂, hred₂, ⟨hdom⟩, ⟨hcod⟩⟩, hv_sem⟩ :=
    whRedPiKClosedCtxMaj_pi_right_and_prunedSemEqDIK_of_lrTermMajSemBi
      hW ih_v hnoprop hnopi hred₁
  have hsem₁ := semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred₁
  have hv₁_nolam : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.lam g) :=
    fun g h => approxDIK_pi_not_lam P₁ Q₁ g ((hsem₁ (.lam g)).mp h)
  have hv₁_noCtor : ∀ (w : IotaWitnessS E) (us : List CptI),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) v₁ (.spine w.ctorRef us) :=
    fun w us h => approxDIK_pi_not_spine P₁ Q₁ w.ctorRef us ((hsem₁ (.spine w.ctorRef us)).mp h)
  have hv_probe : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) v₁ c →
      LRProbeTypePiKClosedCtxMaj E n Γ v₁ v₂ c := by
    intro c hc hv₁_c
    cases hc with
    | bot => exact .bot Γ v₁ v₂
    | sort => exact (approxDIK_pi_not_sort P₁ Q₁ ((hsem₁ .sort).mp hv₁_c)).elim
    | piBotNil => exact .pi hred₁ hred₂ hdom hcod
  exact lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine hW hA hv₁ hv₂ hcv hv_sem
    hv₁_nolam hv₁_noCtor hv_probe hb_let₁ hb_wf2

/-! ### §27.3. Adequacy-Based `PrunedSemEqDIK` 0-Instantiation Criteria
(`lrTermMajSemBi_of_prunedSemEqDIK_and_diags`, `lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_let_diags`),
Well-Typed 0-Instantiation Supply (`TypedSubst0CongrSupplyMajSemBi`), and 27-Constructor Reduction
(`piRow_of_adequate_and_typedSubst0_maj`) -/

/-- **Two-Sided Diagonal-Adequacy Criterion Under `PrunedSemEqDIK`
    (`lrTermMajSemBi_of_prunedSemEqDIK_and_diags`):**
    Strengthens `lrTermMajSemBi_of_prunedSemEqDIK_and_normalizes` by replacing
    `WhRedPiKClosedCtxMajNormalizes` with the endpoint diagonals `hdiagM : LRTermMajSemBi E n Γ M M A`
    and `hdiagN : LRTermMajSemBi E n Γ N N A` (requiring **zero `EnvWfT E`**!):
    - `.bot` and `.sort` hold **100% unconditionally**, and
    - `.pi .bot []` holds whenever `IsSemPropTyI E n Γ A` or `ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])`
      or `hpi` supplies `TyConvT` between the $\Pi$-reducts of `M` and `N`! -/
theorem lrTermMajSemBi_of_prunedSemEqDIK_and_diags {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M N A : Expr Nat}
    (hsem : PrunedSemEqDIK E (ctxEnvDIK E Γ) M N)
    (hdiagM : LRTermMajSemBi E n Γ M M A)
    (hdiagN : LRTermMajSemBi E n Γ N N A)
    (hpi : ∀ {D₁ C₁ D₂ C₂ : Expr Nat},
      WhRedPiKClosedCtxMaj E Γ M (.pi D₁ C₁) →
      WhRedPiKClosedCtxMaj E Γ N (.pi D₂ C₂) →
      Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)) :
    LRTermMajSemBi E n Γ M N A := by
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hM : ApproxDIK E (ctxEnvDIK E Γ) M c :=
    hor.elim id (fun hN => (hsem c hc_p).mpr hN)
  have hN : ApproxDIK E (ctxEnvDIK E Γ) N c :=
    (hsem c hc_p).mp hM
  rcases hdiagM c hc (Or.inl hM) with hPA | hpiA | hlrM
  · exact Or.inl hPA
  · exact Or.inr (Or.inl hpiA)
  · rcases hdiagN c hc (Or.inl hN) with hPA | hpiA | hlrN
    · exact Or.inl hPA
    · exact Or.inr (Or.inl hpiA)
    · refine Or.inr (Or.inr ?_)
      cases hc with
      | bot => exact .bot Γ M N
      | sort =>
          obtain ⟨l₁, hred₁⟩ := lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlrM
          obtain ⟨l₂, hred₂⟩ := lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlrN
          exact .sort hred₁ hred₂
      | piBotNil =>
          obtain ⟨D₁, C₁, hred₁⟩ := lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlrM
          obtain ⟨D₂, C₂, hred₂⟩ := lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlrN
          obtain ⟨⟨hdom⟩, ⟨hcod⟩⟩ := hpi hred₁ hred₂
          exact .pi hred₁ hred₂ hdom hcod

/-- **0-Instantiation Congruence in `LRTermMajSemBi` Under `PrunedSemEqDIK` and Endpoint Diagonals
    (`lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_diags`):**
    Strengthens `lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_normalizes` by replacing
    `WhRedPiKClosedCtxMajNormalizes` with the endpoint diagonals `hdiag₁` and `hdiag₂`! -/
theorem lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_diags {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {v₁ v₂ b A : Expr Nat}
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hdiag₁ : LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) A)
    (hdiag₂ : LRTermMajSemBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) A)
    (hpi : ∀ {D₁ C₁ D₂ C₂ : Expr Nat},
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (.pi D₁ C₁) →
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (.pi D₂ C₂) →
      Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) A :=
  lrTermMajSemBi_of_prunedSemEqDIK_and_diags
    (fun _ hc => approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hv_sem b hc)
    hdiag₁ hdiag₂ hpi

/-- **Single-Endpoint Right-Instantiation Diagonal at `instantiate0 v₁ B` from `hb_let₂` Alone
    (`lrTermMajSemBi_inst0_right_diag_of_let_diag`):**
    From `hb_let₂ : LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B` and
    `hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂`, derives
    `LRTermMajSemBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B)` at the
    **left** instantiated type `instantiate0 v₁ B` (requiring **zero `hb_let₁`**)! -/
theorem lrTermMajSemBi_inst0_right_diag_of_let_diag {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hb_let₂ : LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B) :
    LRTermMajSemBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  intro c hc hor
  have hc_b : ApproxDIK E (ctxEnvDIK E (.letBinding A v₂ :: Γ)) b c :=
    (approxDIK_ctxEnvDIK_substLet0_iff E A v₂ Γ b c).mp (hor.elim id id)
  rcases hb_let₂ c hc (Or.inl hc_b) with hPB₂ | hpiB₂ | hlr₂
  · exact Or.inl
      (isSemPropTyI_inst0_of_letBinding_right_of_prunedSemEqDIK hW hΓ hA hv₁ hcv hv_sem hPB₂)
  · have hpi_inst₂ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₂ B) (.pi .bot []) :=
      (approxDIK_ctxEnvDIK_substLet0_iff E A v₂ Γ B (.pi .bot [])).mpr hpiB₂
    exact Or.inr (Or.inl
      ((approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hv_sem B
        (prunedPiCpt_of_probeCpt .piBotNil)).mpr hpi_inst₂))
  · have hget0 : (LocalDecl.letBinding A v₂ :: Γ)[0]? = some (.letBinding A v₂) := by simp
    have hlr₀ := lrProbeTypePiKClosedCtxMaj_substLet
      (envClosed_of_envWfT hW) (envMembersSubstStable_of_envWfT hW) A v₂ hget0
      (by simpa only [substRemove_zero_cons, lift_zero] using hv₂) hlr₂
    exact Or.inr (Or.inr
      (by simpa only [substRemove_zero_cons, lift_zero, instantiate0] using hlr₀))

/-- **0-Instantiation Congruence in `LRTermMajSemBi` Under `PrunedSemEqDIK` and Let-Context Diagonals
    `hb_let₁, hb_let₂` (`lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_let_diags`):**
    Derives both instantiated diagonals `hdiag₁` and `hdiag₂` automatically from `hb_let₁` and
    `hb_let₂` via `lrTermMajSemBi_substLet0` and `lrTermMajSemBi_inst0_right_diag_of_let_diag`! -/
theorem lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_let_diags {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_let₂ : LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B)
    (hpi : ∀ {D₁ C₁ D₂ C₂ : Expr Nat},
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (.pi D₁ C₁) →
      WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (.pi D₂ C₂) →
      Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) :=
  lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_diags hv_sem
    (lrTermMajSemBi_substLet0 hW hv₁ hb_let₁)
    (lrTermMajSemBi_inst0_right_diag_of_let_diag hW hΓ hA hv₁ hv₂ hcv hv_sem hb_let₂)
    hpi

/-- Transport `HasTyT E n (.letBinding A v₁ :: Γ) b B` to `HasTyT E n (.letBinding A v₂ :: Γ) b B`
    along `ConvT E n Γ v₁ v₂ A` (`hasTyT_letBinding_conv_val`). -/
def hasTyT_letBinding_conv_val {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hb₁ : HasTyT E n (.letBinding A v₁ :: Γ) b B) :
    HasTyT E n (.letBinding A v₂ :: Γ) b B :=
  hasTyT_ctx (envClosed_of_envWfT hW)
    (.letBinding (ctxConvT_refl Γ) hA hA (.refl Γ A (.sort u) hA) hv₂ hcv)
    hb₁

/-- Typing of the left-head application template `.app (.bvar 0) (lift 0 1 a)` in `.letBinding (.pi A B) f :: Γ`
    (`hasTyT_letBinding_app_bvar0_lift0`). -/
def hasTyT_letBinding_app_bvar0_lift0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (f : Expr Nat) {a A B : Expr Nat}
    (ha : HasTyT E n Γ a A) :
    HasTyT E n (.letBinding (.pi A B) f :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (lift 0 1 (instantiate0 a B)) := by
  have hcl := envClosed_of_envWfT hW
  have hbv0 : HasTyT E n (.letBinding (.pi A B) f :: Γ)
      (.bvar 0) (.pi (lift 0 1 A) (lift 1 1 B)) :=
    .bvar (.letBinding (.pi A B) f :: Γ) 0 (.pi (lift 0 1 A) (lift 1 1 B)) rfl
  have ha_wk : HasTyT E n (.letBinding (.pi A B) f :: Γ) (lift 0 1 a) (lift 0 1 A) :=
    hasTyTWeaken (.letBinding (.pi A B) f) hcl (c := 0) ha
  have happ : HasTyT E n (.letBinding (.pi A B) f :: Γ)
      (.app (.bvar 0) (lift 0 1 a)) (instantiate0 (lift 0 1 a) (lift 1 1 B)) :=
    .app (.letBinding (.pi A B) f :: Γ) (.bvar 0) (lift 0 1 a) (lift 0 1 A) (lift 1 1 B)
      hbv0 ha_wk
  have heq : lift 0 1 (instantiate0 a B) = instantiate0 (lift 0 1 a) (lift 1 1 B) :=
    lift_instantiate_low 1 0 0 a (Nat.le_refl 0) B
  rwa [heq]

/-- Typing of the right-argument application template `.app (lift 0 1 f) (.bvar 0)` in `.letBinding A a :: Γ`
    (`hasTyT_letBinding_app_lift0_bvar0`). -/
def hasTyT_letBinding_app_lift0_bvar0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f A B : Expr Nat} (a : Expr Nat)
    (hf : HasTyT E n Γ f (.pi A B)) :
    HasTyT E n (.letBinding A a :: Γ) (.app (lift 0 1 f) (.bvar 0)) B := by
  have hcl := envClosed_of_envWfT hW
  have hf_wk : HasTyT E n (.letBinding A a :: Γ) (lift 0 1 f) (.pi (lift 0 1 A) (lift 1 1 B)) :=
    hasTyTWeaken (.letBinding A a) hcl (c := 0) hf
  have hbv0 : HasTyT E n (.letBinding A a :: Γ) (.bvar 0) (lift 0 1 A) :=
    .bvar (.letBinding A a :: Γ) 0 (lift 0 1 A) rfl
  have happ : HasTyT E n (.letBinding A a :: Γ)
      (.app (lift 0 1 f) (.bvar 0)) (instantiate0 (.bvar 0) (lift 1 1 B)) :=
    .app (.letBinding A a :: Γ) (lift 0 1 f) (.bvar 0) (lift 0 1 A) (lift 1 1 B) hf_wk hbv0
  rwa [instantiate0_bvar0_lift1 B] at happ

/-- **Well-Typed 0-Instantiation Congruence Supply in `LRTermMajSemBi`
    (`TypedSubst0CongrSupplyMajSemBi E n`):**
    Strengthens `Subst0CongrSupplyMajSemBi E n` by supplying the full well-typed and
    diagonal-adequacy context available at every `ConvT.app` and `ConvT.letE` call site:
    - `hA : HasTyT E n Γ A (.sort u)`
    - `hv₁ : HasTyT E n Γ v₁ A`, `hv₂ : HasTyT E n Γ v₂ A`, `hcv : ConvT E n Γ v₁ v₂ A`
    - `hb₁ : HasTyT E n (.letBinding A v₁ :: Γ) b B`, `hb₂ : HasTyT E n (.letBinding A v₂ :: Γ) b B`
    - `ih_v : LRTermMajSemBi E n Γ v₁ v₂ A`
    - `hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B`
    - `hb_let₂ : LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B`
    - `hb_inst₁ : LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B)`
    - `hb_inst₂ : LRTermMajSemBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₂ B)`! -/
def TypedSubst0CongrSupplyMajSemBi (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {A v₁ v₂ b B : Expr Nat} {u : Level},
      HasTyT E n Γ A (.sort u) →
      HasTyT E n Γ v₁ A → HasTyT E n Γ v₂ A → ConvT E n Γ v₁ v₂ A →
      HasTyT E n (.letBinding A v₁ :: Γ) b B →
      HasTyT E n (.letBinding A v₂ :: Γ) b B →
      LRTermMajSemBi E n Γ v₁ v₂ A →
      LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B →
      LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B →
      LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₁ b) (instantiate0 v₁ B) →
      LRTermMajSemBi E n Γ (instantiate0 v₂ b) (instantiate0 v₂ b) (instantiate0 v₂ B) →
      LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B)

/-- `Subst0CongrSupplyMajSemBi` conservatively implies `TypedSubst0CongrSupplyMajSemBi`
    (`typedSubst0CongrSupplyMajSemBi_of_subst0CongrSupply`). -/
theorem typedSubst0CongrSupplyMajSemBi_of_subst0CongrSupply {E : ResolvedEnv} {n : Nat}
    (h : Subst0CongrSupplyMajSemBi E n) :
    TypedSubst0CongrSupplyMajSemBi E n :=
  fun {_} hΓ {_ _ _ _ _ _} _ hv₁ hv₂ hcv _ _ ih_v _ _ hb_inst₁ _ =>
    h hΓ hv₁ hv₂ hcv ih_v hb_inst₁

/-- **Reduction of `TypedSubst0CongrSupplyMajSemBi` to `PrunedSemEqDIK` and $\Pi$-Reduct `TyConvT`
    (`typedSubst0CongrSupplyMajSemBi_of_prunedSemEqDIK_and_pi_conv`):**
    Because `hb_let₁, hb_let₂` are already hypotheses of `TypedSubst0CongrSupplyMajSemBi`:
    - `IsSemPropTyI E n Γ (instantiate0 v₁ B)` and `ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ B) (.pi .bot [])`
      are **100% discharged** immediately,
    - `c = .bot` and `c = .sort` are **100% discharged** by `lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_let_diags`
      whenever `PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂` holds, and
    - ONLY `c = .pi .bot []` when `instantiate0 v₁ b ↠whMaj .pi D₁ C₁` and
      `instantiate0 v₂ b ↠whMaj .pi D₂ C₂` remains! -/
theorem typedSubst0CongrSupplyMajSemBi_of_prunedSemEqDIK_and_pi_conv
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hsem : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {A v₁ v₂ b B : Expr Nat} {u : Level},
        HasTyT E n Γ A (.sort u) →
        HasTyT E n Γ v₁ A → HasTyT E n Γ v₂ A → ConvT E n Γ v₁ v₂ A →
        HasTyT E n (.letBinding A v₁ :: Γ) b B →
        HasTyT E n (.letBinding A v₂ :: Γ) b B →
        LRTermMajSemBi E n Γ v₁ v₂ A →
        LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B →
        LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B →
        PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hpi : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {A v₁ v₂ b B D₁ C₁ D₂ C₂ : Expr Nat} {u : Level},
        HasTyT E n Γ A (.sort u) →
        HasTyT E n Γ v₁ A → HasTyT E n Γ v₂ A → ConvT E n Γ v₁ v₂ A →
        HasTyT E n (.letBinding A v₁ :: Γ) b B →
        HasTyT E n (.letBinding A v₂ :: Γ) b B →
        LRTermMajSemBi E n Γ v₁ v₂ A →
        LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B →
        LRTermMajSemBi E n (.letBinding A v₂ :: Γ) b b B →
        PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂ →
        WhRedPiKClosedCtxMaj E Γ (instantiate0 v₁ b) (.pi D₁ C₁) →
        WhRedPiKClosedCtxMaj E Γ (instantiate0 v₂ b) (.pi D₂ C₂) →
        Nonempty (TyConvT E n Γ D₁ D₂) ∧ Nonempty (TyConvT E n (.assumption D₁ :: Γ) C₁ C₂)) :
    TypedSubst0CongrSupplyMajSemBi E n := by
  intro Γ hΓ A v₁ v₂ b B u hA hv₁ hv₂ hcv hb₁ hb₂ ih_v hb_let₁ hb_let₂ _ _
  have hv_sem := hsem hΓ hA hv₁ hv₂ hcv hb₁ hb₂ ih_v hb_let₁ hb_let₂
  exact lrTermMajSemBi_subst0_of_prunedSemEqDIK_and_let_diags hW hΓ hA hv₁ hv₂ hcv hv_sem
    hb_let₁ hb_let₂
    (fun hred₁ hred₂ => hpi hΓ hA hv₁ hv₂ hcv hb₁ hb₂ ih_v hb_let₁ hb_let₂ hv_sem hred₁ hred₂)

/-- Two-sided `ConvT.app` congruence in `LRTermMajSemBi` from `TypedWhAdequateMaj` and
    `TypedSubst0CongrSupplyMajSemBi` (`lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0`). -/
theorem lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ a₁ a₂ A B : Expr Nat}
    (hcf : ConvT E n Γ f₁ f₂ (.pi A B))
    (hca : ConvT E n Γ a₁ a₂ A)
    (ih_f : LRTermMajSemBi E n Γ f₁ f₂ (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a₁ a₂ A) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B) := by
  have endsf := convEnds hW hΓ hcf
  have endsa := convEnds hW hΓ hca
  obtain ⟨u_pi, hpiAB⟩ := endsf.2.2
  obtain ⟨u_A, hA⟩ := endsa.2.2
  have hb₁ : HasTyT E n (.letBinding (.pi A B) f₁ :: Γ)
      (.app (.bvar 0) (lift 0 1 a₁)) (lift 0 1 (instantiate0 a₁ B)) :=
    hasTyT_letBinding_app_bvar0_lift0 hW f₁ endsa.1
  have hb₂ : HasTyT E n (.letBinding (.pi A B) f₂ :: Γ)
      (.app (.bvar 0) (lift 0 1 a₁)) (lift 0 1 (instantiate0 a₁ B)) :=
    hasTyT_letBinding_app_bvar0_lift0 hW f₂ endsa.1
  have hΓ_let₁ : CtxWfT E n (.letBinding (.pi A B) f₁ :: Γ) :=
    .letBinding Γ (.pi A B) u_pi f₁ hΓ hpiAB endsf.1
  have hΓ_let₂ : CtxWfT E n (.letBinding (.pi A B) f₂ :: Γ) :=
    .letBinding Γ (.pi A B) u_pi f₂ hΓ hpiAB endsf.2.1
  have hb_let₁ := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₁ hb₁
  have hb_let₂ := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₂ hb₂
  have hb_inst₁ := lrTermMajSemBi_substLet0 hW endsf.1 hb_let₁
  have hb_inst₂ := lrTermMajSemBi_substLet0 hW endsf.2.1 hb_let₂
  have h_fn0 := hSubst0 hΓ hpiAB endsf.1 endsf.2.1 hcf hb₁ hb₂ ih_f hb_let₁ hb_let₂ hb_inst₁ hb_inst₂
  have hcancel : instantiate0 f₁ (lift 0 1 (instantiate0 a₁ B)) = instantiate0 a₁ B :=
    (instantiate_lift_cancel 1 0 0 f₁ (Nat.le_refl 0) Nat.zero_lt_one (instantiate0 a₁ B)).trans
      (lift_zero 0 (instantiate0 a₁ B))
  rw [instantiate0_app_bvar0_lift0 f₁ a₁, instantiate0_app_bvar0_lift0 f₂ a₁, hcancel] at h_fn0
  have hb₁' : HasTyT E n (.letBinding A a₁ :: Γ) (.app (lift 0 1 f₂) (.bvar 0)) B :=
    hasTyT_letBinding_app_lift0_bvar0 hW a₁ endsf.2.1
  have hb₂' : HasTyT E n (.letBinding A a₂ :: Γ) (.app (lift 0 1 f₂) (.bvar 0)) B :=
    hasTyT_letBinding_app_lift0_bvar0 hW a₂ endsf.2.1
  have hΓ_let₁' : CtxWfT E n (.letBinding A a₁ :: Γ) :=
    .letBinding Γ A u_A a₁ hΓ hA endsa.1
  have hΓ_let₂' : CtxWfT E n (.letBinding A a₂ :: Γ) :=
    .letBinding Γ A u_A a₂ hΓ hA endsa.2.1
  have hb_let₁' := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₁' hb₁'
  have hb_let₂' := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₂' hb₂'
  have hb_inst₁' := lrTermMajSemBi_substLet0 hW endsa.1 hb_let₁'
  have hb_inst₂' := lrTermMajSemBi_substLet0 hW endsa.2.1 hb_let₂'
  have h_arg0 := hSubst0 hΓ hA endsa.1 endsa.2.1 hca hb₁' hb₂' ih_a
    hb_let₁' hb_let₂' hb_inst₁' hb_inst₂'
  rw [instantiate0_app_lift0_bvar0_arg f₂ a₁, instantiate0_app_lift0_bvar0_arg f₂ a₂] at h_arg0
  exact lrTermMajSemBi_trans hW hΓ h_fn0 h_arg0

/-- Two-sided `ConvT.letE` congruence in `LRTermMajSemBi` from `TypedWhAdequateMaj` and
    `TypedSubst0CongrSupplyMajSemBi` (`lrTermMajSemBi_letE_congr_of_adequate_and_typedSubst0`). -/
theorem lrTermMajSemBi_letE_congr_of_adequate_and_typedSubst0 {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {A₁ A₂ v₁ v₂ b₁ b₂ B : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u))
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hcb : ConvT E n (.letBinding A₁ v₁ :: Γ) b₁ b₂ B)
    (ih_v : LRTermMajSemBi E n Γ v₁ v₂ A₁)
    (ih_b : LRTermMajSemBi E n (.letBinding A₁ v₁ :: Γ) b₁ b₂ B) :
    LRTermMajSemBi E n Γ (.letE A₁ v₁ b₁) (.letE A₂ v₂ b₂) (instantiate0 v₁ B) := by
  have endsA := convEnds hW hΓ hcA
  have endsv := convEnds hW hΓ hcv
  have hΓ_let₁ : CtxWfT E n (.letBinding A₁ v₁ :: Γ) :=
    .letBinding Γ A₁ u v₁ hΓ endsA.1 endsv.1
  have hΓ_let₂ : CtxWfT E n (.letBinding A₁ v₂ :: Γ) :=
    .letBinding Γ A₁ u v₂ hΓ endsA.1 endsv.2.1
  have endsb := convEnds hW hΓ_let₁ hcb
  have hb₂_let₁ : HasTyT E n (.letBinding A₁ v₁ :: Γ) b₂ B := endsb.2.1
  have hb₂_let₂ : HasTyT E n (.letBinding A₁ v₂ :: Γ) b₂ B :=
    hasTyT_letBinding_conv_val hW endsA.1 endsv.2.1 hcv hb₂_let₁
  have hb_let₁ := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₁ hb₂_let₁
  have hb_let₂ := lrTermMajSemBi_diag_of_adequate hAdeq hΓ_let₂ hb₂_let₂
  have hb_inst₁ := lrTermMajSemBi_substLet0 hW endsv.1 hb_let₁
  have hb_inst₂ := lrTermMajSemBi_substLet0 hW endsv.2.1 hb_let₂
  have h_inst_b : LRTermMajSemBi E n Γ (instantiate0 v₁ b₁) (instantiate0 v₁ b₂)
      (instantiate0 v₁ B) :=
    lrTermMajSemBi_substLet0 hW endsv.1 ih_b
  have h_inst_v : LRTermMajSemBi E n Γ (instantiate0 v₁ b₂) (instantiate0 v₂ b₂)
      (instantiate0 v₁ B) :=
    hSubst0 hΓ endsA.1 endsv.1 endsv.2.1 hcv hb₂_let₁ hb₂_let₂ ih_v
      hb_let₁ hb_let₂ hb_inst₁ hb_inst₂
  have hL : WhRedPiKClosedCtxMaj E Γ (.letE A₁ v₁ b₁) (instantiate0 v₁ b₁) :=
    .step (.of_whStep (.zeta A₁ v₁ b₁)) (.refl _)
  have hR : WhRedPiKClosedCtxMaj E Γ (.letE A₂ v₂ b₂) (instantiate0 v₂ b₂) :=
    .step (.of_whStep (.zeta A₂ v₂ b₂)) (.refl _)
  exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hL hR
    (lrTermMajSemBi_trans hW hΓ h_inst_b h_inst_v)

private theorem fundMajSemBiProbe_adeq_typedSubst0_convT {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAdeq : TypedWhAdequateMaj E n)
    (hSubst0 : TypedSubst0CongrSupplyMajSemBi E n)
    (hIrr : IrrNoWhRedSortMaj E n) :
    {Γ : LCtx} → {M M' A : Expr Nat} → ConvT E n Γ M M' A →
      CtxWfT E n Γ → LRTermMajSemBi E n Γ M M' A
  | _, _, _, _, .refl _ _ _ he, hΓ =>
      lrTermMajSemBi_diag_of_adequate hAdeq hΓ he
  | _, _, _, _, .symm _ _ _ _ h, hΓ =>
      lrTermMajSemBi_symm hW hΓ (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr h hΓ)
  | _, _, _, _, .trans _ _ _ _ _ h₁ h₂, hΓ =>
      lrTermMajSemBi_trans hW hΓ
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr h₁ hΓ)
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr h₂ hΓ)
  | _, _, _, _, .beta Γ₀ A body arg B u hA hbody harg, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 arg body) (instantiate0 arg B) :=
        (convEnds hW hΓ (.beta Γ₀ A body arg B u hA hbody harg)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.beta A body arg))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hR)
  | _, _, _, _, .zeta Γ₀ A v b B u hA hv hb, hΓ =>
      have hR : HasTyT E n Γ₀ (instantiate0 v b) (instantiate0 v B) :=
        (convEnds hW hΓ (.zeta Γ₀ A v b B u hA hv hb)).2.1
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.zeta A v b))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hR)
  | _, _, _, _, .zetaLocal _ _ _ _ hval _ hv, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.zetaLocal hval)
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hv)
  | _, _, _, _, .delta _ _ _ _ _ hres hbody _ _ _ hb, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.delta hres hbody))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hb)
  | _, _, _, _, .iota _ _ _ _ hI _ hrhs, hΓ =>
      lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW
        (.of_whStep (.iota (derivedIotaU_ofDerivedIota hI)))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hrhs)
  | _, _, _, _, .lit _ t _ _ hlit hexp, hΓ => by
      cases hlit
      exact lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.lit t))
        (lrTermMajSemBi_diag_of_adequate hAdeq hΓ hexp)
  | _, _, _, _, .app _ _ _ _ _ _ _ hcf hca, hΓ =>
      lrTermMajSemBi_app_congr_of_adequate_and_typedSubst0 hW hAdeq hSubst0 hΓ hcf hca
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hcf hΓ)
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hca hΓ)
  | _, _, _, _, .lam _ A₁ A₂ b₁ b₂ B _ _ _, _ =>
      lrTermMajSemBi_lam A₁ A₂ b₁ b₂ (.pi A₁ B)
  | _, _, _, _, .pi Γ₀ A₁ A₂ B₁ B₂ u v hcA hcB, _ =>
      lrTermMajSemBi_pi (.sort (.imax u v)) (.of Γ₀ A₁ A₂ u hcA) (.of _ B₁ B₂ v hcB)
  | _, _, _, _, .letE Γ₀ A₁ _ v₁ _ _ _ _ _ hcA hcv hcb, hΓ =>
      have endsA := convEnds hW hΓ hcA
      have endsv := convEnds hW hΓ hcv
      have hΓ_let₁ : CtxWfT E n (.letBinding A₁ v₁ :: Γ₀) :=
        .letBinding Γ₀ A₁ _ v₁ hΓ endsA.1 endsv.1
      lrTermMajSemBi_letE_congr_of_adequate_and_typedSubst0 hW hAdeq hSubst0 hΓ hcA hcv hcb
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hcv hΓ)
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hcb hΓ_let₁)
  | _, _, _, _, .sorts _ _ _ _, _ =>
      lrTermMajSemBi_sorts _
  | _, _, _, _, .consts Γ₀ r ls₁ ls₂ m hm hlen hwf₁ _ heq, hΓ => by
      cases hb : m.body with
      | none => exact lrTermMajSemBi_consts_of_body_none ls₁ ls₂ _ hm hb
      | some b =>
          have har : m.arity = 0 := envWfT_body_arity_zero hW r m b hm hb
          have hls₁ : ls₁ = [] := List.eq_nil_of_length_eq_zero (hlen.trans har)
          subst hls₁
          have hls₂ : ls₂ = [] := by
            cases ls₂ with
            | nil => rfl
            | cons _ _ => exact False.elim heq
          subst hls₂
          have hconst : HasTyT E n Γ₀ (.const r []) (instantiateLevels [] m.mtype) :=
            .const Γ₀ r [] m hm hlen hwf₁
          exact lrTermMajSemBi_diag_of_adequate hAdeq hΓ hconst
  | _, _, _, _, .eta Γ₀ f A B _, _ =>
      lrTermMajSemBi_eta Γ₀ A B f
  | _, _, _, _, .irr _ P p q hP _ _, hΓ =>
      lrTermMajSemBi_irr_of_adequate_and_no_whRed_sort hP (hAdeq hΓ hP) (hIrr hΓ hP) p q
  | _, _, _, _, .tyConv Γ₀ _ _ A A' u hc hA, hΓ =>
      lrTermMajSemBi_tyConv_of_bi hW (.of Γ₀ A A' u hA)
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hc hΓ)
        (fundMajSemBiProbe_adeq_typedSubst0_convT hW hAdeq hSubst0 hIrr hA hΓ)

