`AppDiagSupplyMajSemBi` to `.lam`-Head Non-$\Pi$/Non-Prop Probes, and `IrrProbeSupplyMajSemBi` -/

/-! ### §30.1. `ih_P` Sort/$\Pi$ Weak-Head Reduction Equivalence, `IsSemPropTyI` Biconditional,
`CtxWfT`-Free Closed Context Weakening, `DeltaConst`, and `CtxBVarOKMajSem` in `LRTermMajSemBi` -/

/-- **Exact Characterization of `ApproxDIK E (ctxEnvDIK E Γ) P .sort` from `ih_P` in `LRTermMajSemBi`
    (`approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_majSemBi`):**
    Under `EnvWfT E` alone (with **zero `TypedWhAdequateMaj`, zero `PropTyTransport`, and zero
    `SortRow`**), for any `ih_P : LRTermMajSemBi E n Γ P P (.sort u)`, `ApproxDIK E (ctxEnvDIK E Γ) P .sort`
    holds if and only if `P` weak-head reduces in `WhRedPiKClosedCtxMaj E Γ` to some `.sort l`! -/
theorem approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_majSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {P : Expr Nat} {u : Level}
    (ih_P : LRTermMajSemBi E n Γ P P (.sort u)) :
    ApproxDIK E (ctxEnvDIK E Γ) P .sort ↔ ∃ l, WhRedPiKClosedCtxMaj E Γ P (.sort l) := by
  constructor
  · intro hPs
    rcases ih_P .sort .sort (Or.inl hPs) with hprop | hpi | hlr
    · exact (not_isSemPropTyI_sort E n Γ u hprop).elim
    · exact (approxDIK_sort_not_pi u .bot [] hpi).elim
    · exact lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlr
  · rintro ⟨l, hred⟩
    exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred .sort).mpr (.sort _ l)

/-- **Exact Characterization of `ApproxDIK E (ctxEnvDIK E Γ) P (.pi .bot [])` from `ih_P` in
    `LRTermMajSemBi` (`approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_majSemBi`):**
    Under `EnvWfT E` alone, for any `ih_P : LRTermMajSemBi E n Γ P P (.sort u)`,
    `ApproxDIK E (ctxEnvDIK E Γ) P (.pi .bot [])` holds if and only if `P` weak-head reduces in
    `WhRedPiKClosedCtxMaj E Γ` to some `.pi A B`! -/
theorem approxDIK_pi_iff_whRedPiKClosedCtxMaj_of_majSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {P : Expr Nat} {u : Level}
    (ih_P : LRTermMajSemBi E n Γ P P (.sort u)) :
    ApproxDIK E (ctxEnvDIK E Γ) P (.pi .bot []) ↔ ∃ A B, WhRedPiKClosedCtxMaj E Γ P (.pi A B) := by
  constructor
  · intro hPpi
    rcases ih_P (.pi .bot []) .piBotNil (Or.inl hPpi) with hprop | hpi | hlr
    · exact (not_isSemPropTyI_sort E n Γ u hprop).elim
    · exact (approxDIK_sort_not_pi u .bot [] hpi).elim
    · exact lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlr
  · rintro ⟨A, B, hred⟩
    exact (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (.pi .bot [])).mpr
      (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B)

/-- **Pure Weak-Head Reduction Characterization of `IsSemPropTyI` from `ih_P` in `LRTermMajSemBi`
    (`isSemPropTyI_iff_no_whRed_sort_of_majSemBi`):**
    Under `EnvWfT E`, for any `hP : HasTyT E n Γ P (.sort .zero)` with
    `ih_P : LRTermMajSemBi E n Γ P P (.sort .zero)`, `IsSemPropTyI E n Γ P` holds if and only if
    `∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)`! -/
theorem isSemPropTyI_iff_no_whRed_sort_of_majSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {P : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero))
    (ih_P : LRTermMajSemBi E n Γ P P (.sort .zero)) :
    IsSemPropTyI E n Γ P ↔ ∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l) := by
  constructor
  · intro hsem l hred
    exact hsem.2 ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred .sort).mpr (.sort _ l))
  · intro hnw
    refine ⟨⟨P, ⟨hP⟩, ⟨.refl Γ P⟩⟩, fun hPs => ?_⟩
    obtain ⟨l, hred⟩ := (approxDIK_sort_iff_whRedPiKClosedCtxMaj_of_majSemBi hW ih_P).mp hPs
    exact hnw l hred

/-- **`ConvT.irr` in `LRTermMajSemBi` Directly from `ih_P` and `∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)`
    (`lrTermMajSemBi_irr_of_ihP_and_no_whRed_sort`):**
    Requires **zero `EnvWfT E`, zero `TypedWhAdequateMaj`, and zero `WhRedPiKClosedCtxMajNormalizes`**! -/
theorem lrTermMajSemBi_irr_of_ihP_and_no_whRed_sort {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {P : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero))
    (ih_P : LRTermMajSemBi E n Γ P P (.sort .zero))
    (hnw : ∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l))
    (p q : Expr Nat) :
    LRTermMajSemBi E n Γ p q P :=
  lrTermMajSemBi_irr_of_adequate_and_no_whRed_sort hP
    ((lrTermMajSemBi_diag_iff E n Γ P (.sort .zero)).mp ih_P) hnw p q

/-- **Unconditional `ConvT.irr` in `LRTermMajSemBi` for Any $\Pi$-Proposition `.pi A B`
    (`lrTermMajSemBi_irr_of_pi_prop`):**
    Because `ApproxDIK E (ctxEnvDIK E Γ) (.pi A B) (.pi .bot [])` holds unconditionally,
    `LRTermMajSemBi E n Γ p q (.pi A B)` holds for all proof terms `p, q` with **zero
    `IrrNoWhRedSortMaj`, zero `IsSemPropTyI`, and zero `EnvWfT`**! -/
theorem lrTermMajSemBi_irr_of_pi_prop {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (A B p q : Expr Nat) :
    LRTermMajSemBi E n Γ p q (.pi A B) :=
  lrTermMajSemBi_of_pi_type Γ p q A B

/-- **Unconditional `ConvT.irr` in `LRTermMajSemBi` Whenever `P ↠whMaj .pi A B`
    (`lrTermMajSemBi_irr_of_whRedPiKClosedCtxMaj_pi_prop`):**
    Under `EnvWfT E`, if `P` weak-head reduces in `WhRedPiKClosedCtxMaj E Γ` to `.pi A B`, then
    `LRTermMajSemBi E n Γ p q P` holds for all `p, q` with **zero `IrrNoWhRedSortMaj` and zero
    `IsSemPropTyI`**! -/
theorem lrTermMajSemBi_irr_of_whRedPiKClosedCtxMaj_pi_prop {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {P A B : Expr Nat}
    (hred : WhRedPiKClosedCtxMaj E Γ P (.pi A B))
    (p q : Expr Nat) :
    LRTermMajSemBi E n Γ p q P :=
  lrTermMajSemBi_of_pi_approx
    ((semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred (.pi .bot [])).mpr
      (approxDIK_pi_bot_nil E (ctxEnvDIK E Γ) A B))

/-- **Refined `ConvT.irr` Supply Guarded by Non-`⊥` Proof Term Probes
    (`IrrProbeSupplyMajSemBi E n`):**
    Weakens `IrrNoWhRedSortMaj E n` by requiring `∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)`
    **only** when `p` or `q` approximates a non-`⊥` probe `c ∈ {.sort, .pi .bot []}` (since proof
    terms whose `ProbeCpt` compacts are only `.bot` — such as constructor spines,
    $\lambda$-abstractions, assumption-variable spines, and non-K recursor spines — are already
    unconditionally satisfied in `LRTermMajSemBi`)! -/
def IrrProbeSupplyMajSemBi (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {P p q : Expr Nat},
      HasTyT E n Γ P (.sort .zero) →
      HasTyT E n Γ p P → HasTyT E n Γ q P →
      LRTermMajSemBi E n Γ P P (.sort .zero) →
      LRTermMajSemBi E n Γ p p P →
      LRTermMajSemBi E n Γ q q P →
      ∀ c, ProbeCpt c → c ≠ .bot →
        (ApproxDIK E (ctxEnvDIK E Γ) p c ∨ ApproxDIK E (ctxEnvDIK E Γ) q c) →
        ∀ l, ¬ WhRedPiKClosedCtxMaj E Γ P (.sort l)

/-- `IrrNoWhRedSortMaj E n` conservatively implies `IrrProbeSupplyMajSemBi E n`
    (`irrProbeSupplyMajSemBi_of_irrNoWhRedSortMaj`). -/
theorem irrProbeSupplyMajSemBi_of_irrNoWhRedSortMaj {E : ResolvedEnv} {n : Nat}
    (hIrr : IrrNoWhRedSortMaj E n) :
    IrrProbeSupplyMajSemBi E n :=
  fun {_} hΓ {_ _ _} hP _ _ _ _ _ _ _ _ _ => hIrr hΓ hP

/-- Closing `ConvT.irr` in `LRTermMajSemBi` constructively from `IrrProbeSupplyMajSemBi E n`
    (`lrTermMajSemBi_irr_of_irrProbeSupply`, zero `Classical.choice`). -/
theorem lrTermMajSemBi_irr_of_irrProbeSupply {E : ResolvedEnv} {n : Nat}
    (hIrr : IrrProbeSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {P p q : Expr Nat}
    (hP : HasTyT E n Γ P (.sort .zero))
    (hp : HasTyT E n Γ p P) (hq : HasTyT E n Γ q P)
    (ih_P : LRTermMajSemBi E n Γ P P (.sort .zero))
    (ih_p : LRTermMajSemBi E n Γ p p P)
    (ih_q : LRTermMajSemBi E n Γ q q P) :
    LRTermMajSemBi E n Γ p q P := by
  intro c hc hor
  cases hc with
  | bot => exact Or.inr (Or.inr (.bot Γ p q))
  | sort =>
      have hne : CptI.sort ≠ .bot := by intro h0; cases h0
      have hnw := hIrr hΓ hP hp hq ih_P ih_p ih_q .sort .sort hne hor
      exact lrTermMajSemBi_irr_of_ihP_and_no_whRed_sort hP ih_P hnw p q .sort .sort hor
  | piBotNil =>
      have hne : CptI.pi .bot [] ≠ .bot := by intro h0; cases h0
      have hnw := hIrr hΓ hP hp hq ih_P ih_p ih_q (.pi .bot []) .piBotNil hne hor
      exact lrTermMajSemBi_irr_of_ihP_and_no_whRed_sort hP ih_P hnw p q (.pi .bot []) .piBotNil hor

/-- **`CtxWfT`-Free Closed-Context Weakening from `[]` to Arbitrary `Γ : LCtx` in `LRTermMajSemBi`
    (`lrTermMajSemBi_closed_weaken_ctx`):**
    Because `lrTermMajSemBi_weaken0` requires **zero `CtxWfT`**, any `LRTermMajSemBi E n [] M M' A`
    on closed `M, M', A` weakens to **any** context `Γ : LCtx` with **zero `CtxWfT E n Γ`**! -/
theorem lrTermMajSemBi_closed_weaken_ctx {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {M M' A : Expr Nat}
    (hM : lift 0 1 M = M) (hM' : lift 0 1 M' = M') (hA : lift 0 1 A = A)
    (Γ : LCtx)
    (h0 : LRTermMajSemBi E n [] M M' A) :
    LRTermMajSemBi E n Γ M M' A := by
  induction Γ with
  | nil => exact h0
  | cons d Γ₀ ih =>
      have h1 := lrTermMajSemBi_weaken0 hcl d ih
      rwa [hM, hM', hA] at h1

/-- `DeltaConst` step expansion in `LRTermMajSemBi` (`lrTermMajSemBi_deltaConsts`, zero `CtxWfT`). -/
theorem lrTermMajSemBi_deltaConsts {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {r : Nat} {ls₁ ls₂ : List Level} {A : Expr Nat}
    {m : CheckedMember} {b : Expr Nat} (hd : DeltaConst E r m b)
    (hbody : LRTermMajSemBi E n Γ (instantiateLevels ls₁ b) (instantiateLevels ls₂ b) A) :
    LRTermMajSemBi E n Γ (.const r ls₁) (.const r ls₂) A :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
    (.step (.of_whStep (.delta hd.1 hd.2.1)) (.refl _))
    (.step (.of_whStep (.delta hd.1 hd.2.1)) (.refl _))
    hbody

/-- Unconditional `ConvT.beta` in `LRTermMajSemBi` from `ih_b_let` in `.letBinding A a :: Γ`
    (`lrTermMajSemBi_beta_via_let`, zero `CtxWfT`, zero `TypedWhAdequateMaj`). -/
theorem lrTermMajSemBi_beta_via_let {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A a b B : Expr Nat}
    (ha_ty : HasTyT E n Γ a A)
    (ih_b_let : LRTermMajSemBi E n (.letBinding A a :: Γ) b b B) :
    LRTermMajSemBi E n Γ (.app (.lam A b) a) (instantiate0 a b) (instantiate0 a B) :=
  lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.beta A b a))
    (lrTermMajSemBi_substLet0 hW ha_ty ih_b_let)

/-- Unconditional `ConvT.zeta` in `LRTermMajSemBi` from `ih_b` in `.letBinding A v :: Γ`
    (`lrTermMajSemBi_zeta`, zero `CtxWfT`, zero `TypedWhAdequateMaj`). -/
theorem lrTermMajSemBi_zeta {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v b B : Expr Nat}
    (hv_ty : HasTyT E n Γ v A)
    (ih_b : LRTermMajSemBi E n (.letBinding A v :: Γ) b b B) :
    LRTermMajSemBi E n Γ (.letE A v b) (instantiate0 v b) (instantiate0 v B) :=
  lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.of_whStep (.zeta A v b))
    (lrTermMajSemBi_substLet0 hW hv_ty ih_b)

/-- Unconditional `ConvT.zetaLocal` in `LRTermMajSemBi` from `ih_v`
    (`lrTermMajSemBi_zetaLocal`, zero `CtxWfT`, zero `TypedWhAdequateMaj`). -/
theorem lrTermMajSemBi_zetaLocal {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {i : Nat} {A v : Expr Nat}
    (hval : lookupValue Γ i = some v)
    (ih_v : LRTermMajSemBi E n Γ v v A) :
    LRTermMajSemBi E n Γ (.bvar i) v A :=
  lrTermMajSemBi_of_whStepPiKClosedCtxMaj hW (.zetaLocal hval) ih_v

/-- Unconditional `.bvar i` diagonal in `LRTermMajSemBi` when `lookupValue Γ i = none`
    (`lrTermMajSemBi_bvar_of_lookupValue_none`, zero `CtxWfT`). -/
theorem lrTermMajSemBi_bvar_of_lookupValue_none {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {i : Nat} (A : Expr Nat) (hnone : lookupValue Γ i = none) :
    LRTermMajSemBi E n Γ (.bvar i) (.bvar i) A :=
  lrTermMajSemBi_foldApps_bvar_none hnone hnone [] [] A

/-- Bound-variable adequacy for `LRTermMajSemBi` (`CtxBVarOKMajSem`). -/
def CtxBVarOKMajSem (E : ResolvedEnv) (n : Nat) (Γ : LCtx) : Prop :=
  ∀ i A, lookupType Γ i = some A → LRTermMajSemBi E n Γ (.bvar i) (.bvar i) A

theorem ctxBVarOKMajSem_nil (E : ResolvedEnv) (n : Nat) : CtxBVarOKMajSem E n [] := by
  intro _ _ hty
  exact Option.noConfusion hty

/-- Pushing `.assumption B` preserves `CtxBVarOKMajSem` with **zero `CtxWfT`**
    (`ctxBVarOKMajSem_cons_assumption`). -/
theorem ctxBVarOKMajSem_cons_assumption {E : ResolvedEnv} {n : Nat} (hcl : EnvClosed E)
    {Γ : LCtx} (B : Expr Nat)
    (hbv : CtxBVarOKMajSem E n Γ) :
    CtxBVarOKMajSem E n (.assumption B :: Γ) := by
  intro i A hty
  cases i with
  | zero =>
      exact lrTermMajSemBi_bvar_of_lookupValue_none A rfl
  | succ i =>
      rw [lookupType_cons_succ] at hty
      cases hty₀ : lookupType Γ i with
      | none => rw [hty₀] at hty; exact Option.noConfusion hty
      | some A' =>
          rw [hty₀] at hty
          injection hty with hA
          subst hA
          have ih := lrTermMajSemBi_weaken0 hcl (.assumption B) (hbv i A' hty₀)
          have hlift : lift 0 1 (.bvar i : Expr Nat) = .bvar (i + 1) := by simp [lift]
          rwa [hlift] at ih

/-- Pushing `.letBinding B v` preserves `CtxBVarOKMajSem` with **zero `CtxWfT`**
    (`ctxBVarOKMajSem_cons_letBinding`). -/
theorem ctxBVarOKMajSem_cons_letBinding {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {B v : Expr Nat}
    (hbv : CtxBVarOKMajSem E n Γ)
    (hv : LRTermMajSemBi E n Γ v v B) :
    CtxBVarOKMajSem E n (.letBinding B v :: Γ) := by
  have hcl := envClosed_of_envWfT hW
  intro i A hty
  cases i with
  | zero =>
      have hty0 : lookupType (.letBinding B v :: Γ) 0 = some (lift 0 1 B) := rfl
      have hA : A = lift 0 1 B := Option.some.inj (hty.symm.trans hty0)
      subst hA
      have hval₀ : lookupValue (.letBinding B v :: Γ) 0 = some (lift 0 1 v) := rfl
      have hstep : WhRedPiKClosedCtxMaj E (.letBinding B v :: Γ) (.bvar 0) (lift 0 1 v) :=
        .step (.zetaLocal hval₀) (.refl _)
      exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hstep hstep
        (lrTermMajSemBi_weaken0 hcl (.letBinding B v) hv)
  | succ i =>
      rw [lookupType_cons_succ] at hty
      cases hty₀ : lookupType Γ i with
      | none => rw [hty₀] at hty; exact Option.noConfusion hty
      | some A' =>
          rw [hty₀] at hty
          injection hty with hA
          subst hA
          have ih := lrTermMajSemBi_weaken0 hcl (.letBinding B v) (hbv i A' hty₀)
          have hlift : lift 0 1 (.bvar i : Expr Nat) = .bvar (i + 1) := by simp [lift]
          rwa [hlift] at ih

/-! ### §30.2. `AppDiagSupplyMajSemBi`, Reduction of `AppDiagSupplyMajSemBi` to `.lam`-Head
Probes, and `TypedWhAdequateMaj`-Free Right-Argument & Two-Sided `ConvT.app` Congruence -/

/-- **Diagonal `HasTyT.app` Adequacy Supply in `LRTermMajSemBi` (`AppDiagSupplyMajSemBi E n`):**
    Replaces `TypedWhAdequateMaj E n` (which assumed diagonal adequacy for all 9 `HasTyT`
    constructors) by diagonal adequacy **only** on `HasTyT.app`, given `ih_f` and `ih_a`! -/
def AppDiagSupplyMajSemBi (E : ResolvedEnv) (n : Nat) : Prop :=
  ∀ {Γ : LCtx}, CtxWfT E n Γ →
    ∀ {f a A B : Expr Nat},
      HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
      LRTermMajSemBi E n Γ f f (.pi A B) →
      LRTermMajSemBi E n Γ a a A →
      LRTermMajSemBi E n Γ (.app f a) (.app f a) (instantiate0 a B)

/-- `TypedWhAdequateMaj E n` conservatively implies `AppDiagSupplyMajSemBi E n`
    (`appDiagSupplyMajSemBi_of_adequate`). -/
theorem appDiagSupplyMajSemBi_of_adequate {E : ResolvedEnv} {n : Nat}
    (hAdeq : TypedWhAdequateMaj E n) :
    AppDiagSupplyMajSemBi E n :=
  fun {Γ} hΓ {f a A B} hf ha _ _ =>
    lrTermMajSemBi_diag_of_adequate hAdeq hΓ (.app Γ f a A B hf ha)

/-- `TypedWhNormalizesMaj E n` conservatively implies `AppDiagSupplyMajSemBi E n` under `EnvWfT E`
    (`appDiagSupplyMajSemBi_of_normalizes`). -/
theorem appDiagSupplyMajSemBi_of_normalizes {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) (hNorm : TypedWhNormalizesMaj E n) :
    AppDiagSupplyMajSemBi E n :=
  appDiagSupplyMajSemBi_of_adequate (typedWhAdequateMaj_of_normalizes hW hNorm)

/-- **Constructive Reduction of `AppDiagSupplyMajSemBi E n` to `.lam`-Head Probes
    (`appDiagSupplyMajSemBi_of_lam_probe`, zero `Classical.choice`):**
    Because `approxDIK_app_inv` forces `f` to approximate `.lam g` whenever `.app f a` approximates
    `.sort` or `.pi .bot []`, `AppDiagSupplyMajSemBi E n` reduces constructively to `.lam`-head
    applications `ApproxDIK E (ctxEnvDIK E Γ) f (.lam g)`! -/
theorem appDiagSupplyMajSemBi_of_lam_probe {E : ResolvedEnv} {n : Nat}
    (hsort : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B : Expr Nat} {g : List (List CptI × CptI)},
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) →
        LRTermMajSemBi E n Γ a a A →
        ApproxDIK E (ctxEnvDIK E Γ) f (.lam g) →
        ApproxDIK E (ctxEnvDIK E Γ) (.app f a) .sort →
        IsSemPropTyI E n Γ (instantiate0 a B) ∨
          ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a B) (.pi .bot []) ∨
          ∃ l, WhRedPiKClosedCtxMaj E Γ (.app f a) (.sort l))
    (hpi : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B : Expr Nat} {g : List (List CptI × CptI)},
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) →
        LRTermMajSemBi E n Γ a a A →
        ApproxDIK E (ctxEnvDIK E Γ) f (.lam g) →
        ApproxDIK E (ctxEnvDIK E Γ) (.app f a) (.pi .bot []) →
        IsSemPropTyI E n Γ (instantiate0 a B) ∨
          ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a B) (.pi .bot []) ∨
          ∃ D C, WhRedPiKClosedCtxMaj E Γ (.app f a) (.pi D C)) :
    AppDiagSupplyMajSemBi E n := by
  intro Γ hΓ f a A B hf ha ih_f ih_a
  rw [lrTermMajSemBi_diag_iff]
  refine ⟨fun happ_s => ?_, fun happ_p => ?_⟩
  · rcases approxDIK_app_inv happ_s with hbot | ⟨g, _, _, hfg, _, _⟩ | ⟨_, _, _, hsp, _, _⟩
    · cases hbot
    · exact hsort hΓ hf ha ih_f ih_a hfg happ_s
    · cases hsp
  · rcases approxDIK_app_inv happ_p with hbot | ⟨g, _, _, hfg, _, _⟩ | ⟨_, _, _, hsp, _, _⟩
    · cases hbot
    · exact hpi hΓ hf ha ih_f ih_a hfg happ_p
    · cases hsp

/-- Head `.bvar 0` diagonal in `.letBinding A a :: Γ` from `ih_a : LRTermMajSemBi E n Γ a a A`
    (`lrTermMajSemBi_letBinding_bvar0_of_val_diag`, zero `CtxWfT`, zero `TypedWhAdequateMaj`). -/
theorem lrTermMajSemBi_letBinding_bvar0_of_val_diag {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {A a : Expr Nat}
    (ih_a : LRTermMajSemBi E n Γ a a A) :
    LRTermMajSemBi E n (.letBinding A a :: Γ) (.bvar 0) (.bvar 0) (lift 0 1 A) :=
  have hstep : WhRedPiKClosedCtxMaj E (.letBinding A a :: Γ) (.bvar 0) (lift 0 1 a) :=
    .step (.zetaLocal rfl) (.refl _)
  lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hstep hstep
    (lrTermMajSemBi_weaken0 (envClosed_of_envWfT hW) (.letBinding A a) ih_a)

/-- **Right-Argument Template Diagonal in `.letBinding A a :: Γ` from `AppDiagSupplyMajSemBi`
    (`lrTermMajSemBi_letBinding_app_lift0_bvar0_of_appDiag`):**
    Proves `LRTermMajSemBi E n (.letBinding A a :: Γ) (.app (lift 0 1 f) (.bvar 0)) (.app (lift 0 1 f) (.bvar 0)) B`
    directly from `hAppDiag : AppDiagSupplyMajSemBi E n`, `ih_f`, and `ih_a` with **zero
    `TypedWhAdequateMaj E n`**! -/
theorem lrTermMajSemBi_letBinding_app_lift0_bvar0_of_appDiag {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E)
    (hAppDiag : AppDiagSupplyMajSemBi E n)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f a A B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hf : HasTyT E n Γ f (.pi A B))
    (ha : HasTyT E n Γ a A)
    (ih_f : LRTermMajSemBi E n Γ f f (.pi A B))
    (ih_a : LRTermMajSemBi E n Γ a a A) :
    LRTermMajSemBi E n (.letBinding A a :: Γ)
      (.app (lift 0 1 f) (.bvar 0)) (.app (lift 0 1 f) (.bvar 0)) B := by
  have hcl := envClosed_of_envWfT hW
  have hΓ_let : CtxWfT E n (.letBinding A a :: Γ) := .letBinding Γ A u a hΓ hA ha
  have hf_wk : HasTyT E n (.letBinding A a :: Γ) (lift 0 1 f) (.pi (lift 0 1 A) (lift 1 1 B)) :=
    hasTyTWeaken (.letBinding A a) hcl (c := 0) hf
  have hbv0 : HasTyT E n (.letBinding A a :: Γ) (.bvar 0) (lift 0 1 A) :=
    .bvar (.letBinding A a :: Γ) 0 (lift 0 1 A) rfl
  have ih_f_wk : LRTermMajSemBi E n (.letBinding A a :: Γ)
