`LRAppFnDiagMajSemBi`, `LRAppFnLeftMajSemBi`, and `LRAppFnMajSemBi` -/

/-- Two-way equivalence (`↔`) of `LRTermMajSemBi` under `CtxConvT` and `SameLetProfile`
    (`lrTermMajSemBi_ctx_of_sameLetProfile_iff`, zero `CtxWfT`, zero `PropTyTransport`, zero `SortRow`). -/
theorem lrTermMajSemBi_ctx_of_sameLetProfile_iff {E : ResolvedEnv} {n : Nat}
    (hcl : EnvClosed E) {Γ Γ' : LCtx}
    (hctx₁₂ : CtxConvT E n Γ Γ') (hctx₂₁ : CtxConvT E n Γ' Γ)
    (hprof : SameLetProfile Γ Γ')
    (M M' A : Expr Nat) :
    LRTermMajSemBi E n Γ M M' A ↔ LRTermMajSemBi E n Γ' M M' A :=
  ⟨lrTermMajSemBi_ctx_of_sameLetProfile hcl hctx₁₂ hprof,
   lrTermMajSemBi_ctx_of_sameLetProfile hcl hctx₂₁ (sameLetProfile_symm hprof)⟩

/-- Transport of `LRTermMajSemBi` along an assumption-domain `TyConvT` chain
    (`lrTermMajSemBi_assump_dom`, zero `HasTyT E n Γ A₁ (.sort u)` premise, zero `PropTyTransport`,
    zero `SortRow`). -/
theorem lrTermMajSemBi_assump_dom {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) :
    {A₁ A₂ : Expr Nat} → TyConvT E n Γ A₁ A₂ →
    ∀ {M M' B : Expr Nat},
      LRTermMajSemBi E n (.assumption A₂ :: Γ) M M' B →
      LRTermMajSemBi E n (.assumption A₁ :: Γ) M M' B
  | _, _, .refl _ _, _, _, _, h => h
  | _, _, .of _ A₁ A₂ _ hc, _, _, _, h =>
      let ends := convEnds hW hΓ hc
      lrTermMajSemBi_ctx_of_sameLetProfile (envClosed_of_envWfT hW)
        (.assumption (ctxConvT_refl Γ) ends.2.1 ends.1 (.symm _ _ _ _ hc))
        (sameLetProfile_assump_head A₂ A₁ Γ) h
  | _, _, .trans _ _ _ _ c₁ c₂, _, _, _, h =>
      lrTermMajSemBi_assump_dom hW hΓ c₁
        (lrTermMajSemBi_assump_dom hW hΓ c₂ h)

/-- Two-way equivalence (`↔`) of `LRTermMajSemBi` under assumption-domain `TyConvT` conversion
    (`lrTermMajSemBi_assump_dom_iff`, zero `HasTyT E n Γ A₁ (.sort u)` premise). -/
theorem lrTermMajSemBi_assump_dom_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ : Expr Nat}
    (hcA : TyConvT E n Γ A₁ A₂)
    (M M' B : Expr Nat) :
    LRTermMajSemBi E n (.assumption A₁ :: Γ) M M' B ↔
      LRTermMajSemBi E n (.assumption A₂ :: Γ) M M' B :=
  ⟨lrTermMajSemBi_assump_dom hW hΓ hcA.symmT,
   lrTermMajSemBi_assump_dom hW hΓ hcA⟩

/-- Two-way equivalence (`↔`) of `LRTermMajSemBi` under `letBinding` type conversion
    (`lrTermMajSemBi_let_sameVal_iff`, zero `PropTyTransport`, zero `SortRow`). -/
theorem lrTermMajSemBi_let_sameVal_iff {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} (hΓ : CtxWfT E n Γ) {A₁ A₂ v : Expr Nat} {u : Level}
    (hcA : ConvT E n Γ A₁ A₂ (.sort u)) (hv : HasTyT E n Γ v A₁)
    (M M' B : Expr Nat) :
