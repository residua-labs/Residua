/-! ### §24.2. Major-Premise-Reducing K-Closed Context-Aware Weak-Head Reduction
(`ctorTagCpt`, `WhStepPiKClosedCtxMaj`, `WhRedPiKClosedCtxMaj`), Unconditional `ApproxDIK`
Soundness, and Single-Step Determinism (`whDetPiKClosedCtxMaj_of_envWfT`) -/

/-- The canonical constructor head-tag spine compact for a shape witness `w : IotaWitnessS E`:
    `.spine w.ctorRef (List.replicate w.nparams .bot ++ List.replicate w.fields.length .bot)`.
    This is always the head element of `ctorDemand w.ctorRef w.nparams us_fields` whenever
    `us_fields.length = w.fields.length`. -/
def ctorTagCpt {E : ResolvedEnv} (w : IotaWitnessS E) : CptI :=
  .spine w.ctorRef (List.replicate w.nparams .bot ++ List.replicate w.fields.length .bot)

theorem ctorTagCpt_mem_ctorDemand {E : ResolvedEnv} (w : IotaWitnessS E)
    {us_fields : List (List CptI)} (hflds : us_fields.length = w.fields.length) :
    ctorTagCpt w ∈ ctorDemand w.ctorRef w.nparams us_fields := by
  unfold ctorTagCpt ctorDemand
  rw [← hflds]
  exact List.mem_cons_self _ _

/-- Every canonical constructor spine `foldApps (.const w.ctorRef lsC) xs_maj` with
    `xs_maj.length = w.nparams + w.fields.length` has `ctorTagCpt w` in `ApproxDIK E ρ`
    at every `EnvWfT E` and every valuation `ρ : EnvI`. -/
theorem approxDIK_ctorTagCpt_of_ctor_spine {E : ResolvedEnv} (_hW : EnvWfT E)
    (w : IotaWitnessS E) (lsC : List Level) {xs_maj : List (Expr Nat)}
    (hlen : xs_maj.length = w.nparams + w.fields.length) (ρ : EnvI) :
    ApproxDIK E ρ (foldApps (.const w.ctorRef lsC) xs_maj) (ctorTagCpt w) := by
  have hpar : (xs_maj.take w.nparams).length = w.nparams := by
    rw [List.length_take]; omega
  have hflds : (List.replicate (xs_maj.drop w.nparams).length ([] : List CptI)).length =
      w.fields.length := by
    rw [List.length_replicate, List.length_drop]; omega
  have h : ApproxDIK E ρ
      (foldApps (.const w.ctorRef lsC) (xs_maj.take w.nparams ++ xs_maj.drop w.nparams))
      (ctorTagCpt w) :=
    ctorDemandK_intro lsC (rigidConst_of_ctor w.hctor w.hctorK) hpar
      (approxArgsDemandK_replicate_nil (xs_maj.drop w.nparams))
      (ctorTagCpt w) (ctorTagCpt_mem_ctorDemand w hflds)
  rwa [List.take_append_drop] at h

/-- General `SemEqDIK` soundness of `IotaWitnessS` schema reduction for arbitrary universe levels
    `ls, lsC : List Level` and argument lists `pre, params, fields : List (Expr Nat)` matching the
    lengths of `w : IotaWitnessS E` (`semEqDIK_iotaS_gen`). -/
theorem semEqDIK_iotaS_gen {E : ResolvedEnv} (w : IotaWitnessS E)
    (ls lsC : List Level) {pre params fields : List (Expr Nat)}
    (hpre : pre.length = w.preMajor.length)
    (hpar : params.length = w.nparams)
    (hflds : fields.length = w.fields.length) (ρ : EnvI) :
    SemEqDIK E ρ
      (recCall (.const w.recRef ls) pre (foldApps (.const w.ctorRef lsC) (params ++ fields)))
      (instPrefix (pre ++ fields) (instantiateLevels ls w.schema)) := by
  let w' : IotaWitnessS E :=
    { w with
      lsC := lsC
      preMajor := pre
      ctorParams := params
      fields := fields
      hctorParams := hpar
      hnpar := by rw [hflds]; exact w.hnpar
      hpre := by rw [hpre]; exact w.hpre
      hpeel := by rw [hflds]; exact w.hpeel
      hschema := by rw [hflds]; exact w.hschema
      hstable := by rw [hflds]; exact w.hstable
      hschemaScope := by rw [hflds]; exact w.hschemaScope }
  have hlhs : SemEqDIK E ρ
      (recCall (.const w.recRef ls) pre (foldApps (.const w.ctorRef lsC) (params ++ fields)))
      (iotaLhsOfS w') := by
    intro c
    unfold iotaLhsOfS recCall
    rw [approxDIK_foldApps_iff, approxDIK_foldApps_iff]
    exact ⟨fun ⟨d, hd, hf⟩ => ⟨d, (semEqDIK_const_levels E ρ w.recRef ls w.ls d).mp hd, hf⟩,
      fun ⟨d, hd, hf⟩ => ⟨d, (semEqDIK_const_levels E ρ w.recRef ls w.ls d).mpr hd, hf⟩⟩
  have hrhs : SemEqDIK E ρ (iotaRhsOfS w')
      (instPrefix (pre ++ fields) (instantiateLevels ls w.schema)) := by
    intro c
    unfold iotaRhsOfS
    have hcl : exprClosedAt (pre ++ fields).length (instantiateLevels w.ls w.schema) = true := by
      rw [exprClosedAt_instantiateLevels, List.length_append, hpre, hflds, w.hpre]
      exact w.hschemaScope
    have hcl' : exprClosedAt (pre ++ fields).length (instantiateLevels ls w.schema) = true := by
      rw [exprClosedAt_instantiateLevels, List.length_append, hpre, hflds, w.hpre]
      exact w.hschemaScope
    rw [approxDIK_instPrefix_closed_iff E ρ (pre ++ fields) _ hcl,
        approxDIK_instPrefix_closed_iff E ρ (pre ++ fields) _ hcl']
    constructor <;>
      (rintro ⟨uss, hargs, hsc⟩;
       exact ⟨uss, hargs, approxDIK_instantiateLevels_swap hsc _ _ rfl⟩)
  exact semEqDIK_trans hlhs (semEqDIK_trans (approxDIK_iotaS w' ρ) hrhs)

/-- General `SemEqDIK` soundness of `iotaKClosedCtx` for arbitrary `ls : List Level` and
    `pre : List (Expr Nat)` with `pre.length = w.preMajor.length`, guarded only by the head-tag
    spine exclusion `¬ ApproxDIK E ρ x (ctorTagCpt w)` (`semEqDIK_k_botClosedExpr_gen`). -/
theorem semEqDIK_k_botClosedExpr_gen {E : ResolvedEnv} (w : IotaWitnessS E)
    (hk : piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1)
    (ls : List Level) {pre : List (Expr Nat)} (hpre : pre.length = w.preMajor.length)
    {ρ : EnvI} {x : Expr Nat}
    (hx : ¬ ApproxDIK E ρ x (ctorTagCpt w)) :
    SemEqDIK E ρ (recCall (.const w.recRef ls) pre x)
      (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
        (instantiateLevels ls w.schema)) := by
  have hclSchema : exprClosedAt (pre ++ List.replicate w.fields.length botClosedExpr).length
      (instantiateLevels ls w.schema) = true := by
    rw [exprClosedAt_instantiateLevels, List.length_append, List.length_replicate, hpre, w.hpre]
    exact w.hschemaScope
  intro c
  constructor
  · intro hlhs
    unfold recCall at hlhs
    rw [approxDIK_foldApps_iff] at hlhs
    obtain ⟨d, hd, hfold⟩ := hlhs
    rcases approxDIK_recursor_const_inv w.hrec w.hrecK hd with
      rfl |
      ⟨w', us_pre, us_fields, c₀, hrecEq, hpreLen, hfldsLen, _, rfl⟩ |
      ⟨w', us_pre, u_maj, c₀, hrecEq, hk', hpreLen, _, hschema', rfl⟩
    · rw [foldAppCptK_bot_inv hfold]
      exact .bot ρ _
    · obtain ⟨_, hpreLenEq⟩ := iotaWitnessS_preMajor_length_eq w' w hrecEq
      have htotLen : (us_pre ++ [ctorDemand w'.ctorRef w'.nparams us_fields]).length =
          (pre ++ [x]).length := by
        simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
      rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
      · exact .bot ρ _
      · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, hmajArgs⟩ :=
          (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
        have hlenPre : us_pre.length = us_pre'.length := by
          rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
        obtain ⟨rfl, hmajEq⟩ := List.append_inj hsplitEq hlenPre
        cases hmajArgs with
        | cons hmaj _ =>
            cases hmajEq
            obtain ⟨_, hctorEq, _, hfldsLenEq, _, _⟩ :=
              iotaWitnessS_unique_of_nMinors_one w w' hrecEq.symm hk.2
            obtain ⟨hparEq, _⟩ := iotaWitnessS_same_branch w w' hrecEq.symm hctorEq
            have htag := hmaj (ctorTagCpt w') (ctorTagCpt_mem_ctorDemand w' hfldsLen)
            have htagEq : ctorTagCpt w' = ctorTagCpt w := by
              unfold ctorTagCpt
              rw [← hctorEq, ← hparEq, ← hfldsLenEq]
            rw [htagEq] at htag
            exact (hx htag).elim
    · obtain ⟨_, hpreLenEq⟩ := iotaWitnessS_preMajor_length_eq w' w hrecEq
      have htotLen : (us_pre ++ [u_maj]).length = (pre ++ [x]).length := by
        simp only [List.length_append, List.length_singleton, hpreLen, hpreLenEq, hpre]
      rcases (foldAppCptK_curryStep_iff htotLen).mp hfold with rfl | ⟨hargs, rfl⟩
      · exact .bot ρ _
      · obtain ⟨us_pre', us_maj', hsplitEq, hpreArgs, _⟩ :=
          (ApproxArgsDemandK.append_iff pre [x] _).mp hargs
        have hlenPre : us_pre.length = us_pre'.length := by
          rw [hpreArgs.length_eq, hpreLen, hpreLenEq, hpre]
        obtain ⟨rfl, _⟩ := List.append_inj hsplitEq hlenPre
        obtain ⟨_, _, _, hfldsLenEq, _, hschemaEq⟩ :=
          iotaWitnessS_unique_of_nMinors_one w' w hrecEq hk'.2
        rw [hfldsLenEq, hschemaEq] at hschema'
        rw [approxDIK_instPrefix_closed_iff E ρ _ _ hclSchema]
        refine ⟨us_pre ++ List.replicate w.fields.length [],
          (ApproxArgsDemandK.append_iff _ _ _).mpr
            ⟨us_pre, List.replicate w.fields.length [], rfl, hpreArgs, ?_⟩,
          hschema'⟩
        have hrep : ∀ k : Nat,
            ApproxArgsDemandK E ρ (List.replicate k botClosedExpr) (List.replicate k []) := by
          intro k
          induction k with
          | zero => exact .nil
          | succ k ih => exact .cons (fun _ hu => nomatch hu) ih
        exact hrep w.fields.length
  · intro hrhs
    rw [approxDIK_instPrefix_closed_iff E ρ _ _ hclSchema] at hrhs
    obtain ⟨uss, hargs, hsc⟩ := hrhs
    obtain ⟨us_pre, us_flds, rfl, hpreArgs, hfldsArgs⟩ :=
      (ApproxArgsDemandK.append_iff pre (List.replicate w.fields.length botClosedExpr) uss).mp hargs
    have hpreLen : us_pre.length = w.preMajor.length := by
      rw [hpreArgs.length_eq, hpre]
    have hfldsBot : ∀ f ∈ List.replicate w.fields.length botClosedExpr,
        ∀ u, ApproxDIK E ρ f u → u = .bot := by
      intro f hf u hu
      rw [(List.mem_replicate.mp hf).2] at hu
      exact approxDIK_botClosedExpr_inv hu
    have hbd : BotDemandList us_flds := botDemandList_of_approxArgsDemandK hfldsBot hfldsArgs
    have hsc_empty : ApproxDIK E
        (EnvI.pushArgs ((us_pre ++ List.replicate w.fields.length []).map demand) EnvI.bot)
        (instantiateLevels ls w.schema) c := by
      have hlenFlds : w.fields.length = (List.replicate w.fields.length botClosedExpr).length := by
        rw [List.length_replicate]
      rw [hlenFlds, ← hfldsArgs.length_eq]
      rw [List.map_append, EnvI.pushArgs_append] at hsc ⊢
      exact approxDIK_mono_env_nonbot
        (pushArgs_botDemandList_nonbot_le hbd (fun _ _ _ => id)) hsc
    unfold recCall
    rw [approxDIK_foldApps_iff]
    refine ⟨curryStep (us_pre ++ [[]]) c,
      .recursorK ls hk hpreLen (fun _ hu => nomatch hu) hsc_empty, ?_⟩
    have htotLen : (us_pre ++ [[]]).length = (pre ++ [x]).length := by
      simp only [List.length_append, List.length_singleton, hpreLen, hpre]
    exact (foldAppCptK_curryStep_iff htotLen).mpr
      (Or.inr ⟨(ApproxArgsDemandK.append_iff pre [x] (us_pre ++ [[]])).mpr
        ⟨us_pre, [[]], rfl, hpreArgs, .cons (fun _ hu => nomatch hu) .nil⟩, rfl⟩)

/-- **Major-Premise-Reducing Context-Aware K-Closed Weak-Head Reduction
    (`WhStepPiKClosedCtxMaj`):**
    Extends `WhStepPiKClosedCtx E Γ` with:
    - `iotaS`: canonical `IotaWitnessS` reduction at any levels `ls, lsC` and argument lists
      `pre, params, fields` of the witness lengths,
    - `iotaKClosedCtx`: single-constructor `Prop` recursor reduction guarded by the exact
      complement `¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)`, and
    - `recMajor`: major-premise reduction `WhStepPiKClosedCtxMaj E Γ x x'` inside
      `recCall (.const w.recRef ls) pre x` when `ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w)`
      holds! -/
inductive WhStepPiKClosedCtxMaj (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | of_whStep {a b : Expr Nat} :
      WhStep E a b → WhStepPiKClosedCtxMaj E Γ a b
  | zetaLocal {i : Nat} {e : Expr Nat} :
      lookupValue Γ i = some e →
      WhStepPiKClosedCtxMaj E Γ (.bvar i) e
  | iotaS (w : IotaWitnessS E) (ls lsC : List Level) (pre params fields : List (Expr Nat)) :
      pre.length = w.preMajor.length →
      params.length = w.nparams →
      fields.length = w.fields.length →
      WhStepPiKClosedCtxMaj E Γ
        (recCall (.const w.recRef ls) pre (foldApps (.const w.ctorRef lsC) (params ++ fields)))
        (instPrefix (pre ++ fields) (instantiateLevels ls w.schema))
  | iotaKClosedCtx (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)) (x : Expr Nat) :
      (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) →
      pre.length = w.preMajor.length →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) →
      WhStepPiKClosedCtxMaj E Γ
        (recCall (.const w.recRef ls) pre x)
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema))
  | recMajor (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)) (x x' : Expr Nat) :
      pre.length = w.preMajor.length →
      ApproxDIK E (ctxEnvDIK E Γ) x (ctorTagCpt w) →
      WhStepPiKClosedCtxMaj E Γ x x' →
      WhStepPiKClosedCtxMaj E Γ
        (recCall (.const w.recRef ls) pre x)
        (recCall (.const w.recRef ls) pre x')
  | appHead {f f' a : Expr Nat} :
      WhStepPiKClosedCtxMaj E Γ f f' →
      WhStepPiKClosedCtxMaj E Γ (.app f a) (.app f' a)

/-- Reflexive-transitive closure of `WhStepPiKClosedCtxMaj E Γ` (`WhRedPiKClosedCtxMaj`). -/
inductive WhRedPiKClosedCtxMaj (E : ResolvedEnv) (Γ : LCtx) : Expr Nat → Expr Nat → Prop
  | refl (a : Expr Nat) : WhRedPiKClosedCtxMaj E Γ a a
  | step {a b c : Expr Nat} :
      WhStepPiKClosedCtxMaj E Γ a b →
      WhRedPiKClosedCtxMaj E Γ b c →
      WhRedPiKClosedCtxMaj E Γ a c

theorem WhRedPiKClosedCtxMaj.trans {E : ResolvedEnv} {Γ : LCtx} {a b c : Expr Nat}
    (h₁ : WhRedPiKClosedCtxMaj E Γ a b) (h₂ : WhRedPiKClosedCtxMaj E Γ b c) :
    WhRedPiKClosedCtxMaj E Γ a c := by
  induction h₁ with
  | refl => exact h₂
  | step hs _ ih => exact .step hs (ih h₂)

/-- Every `WhStepPiKClosedCtx E Γ` step is a `WhStepPiKClosedCtxMaj E Γ` step
    (`whStepPiKClosedCtxMaj_of_whStepPiKClosedCtx`). -/
theorem whStepPiKClosedCtxMaj_of_whStepPiKClosedCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhStepPiKClosedCtx E Γ a b) : WhStepPiKClosedCtxMaj E Γ a b := by
  induction h with
  | of_whStep hs => exact .of_whStep hs
  | zetaLocal hval => exact .zetaLocal hval
  | iotaKClosedCtx w x hk hflds hx =>
      have hrhs : instPrefix (w.preMajor ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels w.ls w.schema) = iotaRhsOfS w := by
        unfold iotaRhsOfS
        rw [← hflds]
      rw [← hrhs]
      exact .iotaKClosedCtx w w.ls w.preMajor x hk rfl (hx _)
  | appHead _ ih => exact .appHead ih

/-- Every `WhRedPiKClosedCtx E Γ` reduction is a `WhRedPiKClosedCtxMaj E Γ` reduction
    (`whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx`). -/
theorem whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx {E : ResolvedEnv} {Γ : LCtx} {a b : Expr Nat}
    (h : WhRedPiKClosedCtx E Γ a b) : WhRedPiKClosedCtxMaj E Γ a b := by
  induction h with
  | refl a => exact .refl a
  | step hs _ ih => exact .step (whStepPiKClosedCtxMaj_of_whStepPiKClosedCtx hs) ih

/-- **Unconditional Model Invariance of `WhStepPiKClosedCtxMaj` Over `ApproxDIK E (ctxEnvDIK E Γ)`
    (`semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj`):** -/
theorem semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E Γ a b) :
    SemEqDIK E (ctxEnvDIK E Γ) a b := by
  induction hs with
  | of_whStep hs₀ =>
      exact semEqDIK_whStep hW hs₀ (ctxEnvDIK E Γ)
  | zetaLocal hval =>
      exact semEqDIK_ctxEnvDIK_zetaLocal E Γ hval
  | iotaS w ls lsC pre params fields hpre hpar hflds =>
      exact semEqDIK_iotaS_gen w ls lsC hpre hpar hflds (ctxEnvDIK E Γ)
  | iotaKClosedCtx w ls pre x hk hpre hx =>
      exact semEqDIK_k_botClosedExpr_gen w hk ls hpre hx
  | recMajor w ls pre x x' _ _ _ ih =>
      unfold recCall
      rw [foldApps_snoc, foldApps_snoc]
      exact semEqDIK_app (semEqDIK_refl E (ctxEnvDIK E Γ) _) ih
  | @appHead _ _ arg _ ih =>
      exact semEqDIK_app ih (semEqDIK_refl E (ctxEnvDIK E Γ) arg)

/-- Multi-step model invariance of `WhRedPiKClosedCtxMaj` over `ApproxDIK E (ctxEnvDIK E Γ)`
    (`semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj`). -/
theorem semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat}
    (hr : WhRedPiKClosedCtxMaj E Γ a b) :
    SemEqDIK E (ctxEnvDIK E Γ) a b := by
  induction hr with
  | refl e => exact semEqDIK_refl E (ctxEnvDIK E Γ) e
  | step hs _ ih => exact semEqDIK_trans (semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj hW hs) ih

/-- **Positive Repair of `W-REC-MAJOR-BETA` (`whRedPiKClosedCtxMaj_trueEnvU_kRecIdTt_sort`):**
    Whereas `trueEnvU_kRecIdTt` is stuck in `WhStepPiKClosedCtx`
    (`whStepPiKClosedCtx_trueEnvU_kRecIdTt_false`), in `WhRedPiKClosedCtxMaj` it steps via
    `recMajor` ($\beta$-reducing the major premise `((λ y : True. y) True.intro)` to `True.intro`)
    followed by `WhStep.iota` to `.sort .zero` in **every** context `Γ : LCtx`! -/
theorem whRedPiKClosedCtxMaj_trueEnvU_kRecIdTt_sort (Γ : LCtx) :
    WhRedPiKClosedCtxMaj trueEnvU Γ trueEnvU_kRecIdTt (.sort .zero) := by
  obtain ⟨wS, hrecS, hctorS, _, _, hpreS, hfldsS, _, _, _, hparS, _⟩ :=
    iotaWitnessS_of_iotaWitness_envWfT trueEnvUWfT wTrueRecU
  have htag : ApproxDIK trueEnvU (ctxEnvDIK trueEnvU Γ)
      (.app (.lam (.const 0 []) (.bvar 0)) (.const 1 [])) (ctorTagCpt wS) := by
    have hpar0 : wS.nparams = 0 := hparS
    have hflds0 : wS.fields.length = 0 := by
      rw [hfldsS]; rfl
    unfold ctorTagCpt
    rw [hctorS, hpar0, hflds0]
    exact approxDIK_trueEnvU_idTt_spine1 (ctxEnvDIK trueEnvU Γ)
  have hstep1 : WhStepPiKClosedCtxMaj trueEnvU Γ
      trueEnvU_kRecIdTt (iotaLhsOf wTrueRecU) := by
    change WhStepPiKClosedCtxMaj trueEnvU Γ
      (recCall (.const 2 [.succ (.succ .zero)]) wTrueRecU.preMajor
        (.app (.lam (.const 0 []) (.bvar 0)) (.const 1 [])))
      (recCall (.const 2 [.succ (.succ .zero)]) wTrueRecU.preMajor (.const 1 []))
    have hrec2 : (2 : Nat) = wS.recRef := hrecS.symm
    rw [hrec2]
    exact .recMajor wS [.succ (.succ .zero)] wTrueRecU.preMajor
      (.app (.lam (.const 0 []) (.bvar 0)) (.const 1 [])) (.const 1 [])
      (congrArg List.length hpreS.symm) htag (.of_whStep (.beta (.const 0 []) (.bvar 0) (.const 1 [])))
  have hstep2 : WhStepPiKClosedCtxMaj trueEnvU Γ (iotaLhsOf wTrueRecU) (.sort .zero) :=
    .of_whStep (.iota (.ofU wTrueRecU))
  exact .step hstep1 (.step hstep2 (.refl (.sort .zero)))

theorem whStepPiKClosedCtxMaj_sort_false {E : ResolvedEnv} {Γ : LCtx} {l : Level} {e : Expr Nat}
    (h : WhStepPiKClosedCtxMaj E Γ (.sort l) e) : False := by
  generalize ha : (Expr.sort l : Expr Nat) = a at h
  cases h with
  | of_whStep hs => subst ha; exact whStep_sort_false hs
  | zetaLocal _ => exact Expr.noConfusion ha
  | iotaS _ _ _ _ _ _ _ _ _ =>
      have hsp := congrArg appsSpine ha
      unfold recCall at hsp
