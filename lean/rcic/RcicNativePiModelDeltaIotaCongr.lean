/-! ### §33.2. Head `let`-Substitution Commutation (`substLet0`), Curried $\lambda$-Application
Peeling, `letE`/$\zeta$/$\beta$ Rules, and Type-Conversion Invariance (`↔`) for `LRAppFn*` -/

/-- Exact `ApproxDIK` equivalence between `lift 0 1 (instantiate0 v B)` and `B` in
    `.letBinding A v :: Γ` (`approxDIK_ctxEnvDIK_letBinding_lift0_instantiate0_iff`). -/
theorem approxDIK_ctxEnvDIK_letBinding_lift0_instantiate0_iff
    (E : ResolvedEnv) (A v : Expr Nat) (Γ : LCtx) (B : Expr Nat) (c : CptI) :
    ApproxDIK E (ctxEnvDIK E (.letBinding A v :: Γ)) (lift 0 1 (instantiate0 v B)) c ↔
      ApproxDIK E (ctxEnvDIK E (.letBinding A v :: Γ)) B c :=
  (approxDIK_ctxEnvDIK_insertAt_lift_iff E (.letBinding A v) (Nat.zero_le Γ.length)
    (instantiate0 v B) c).trans
    (approxDIK_ctxEnvDIK_substLet0_iff E A v Γ B c)

/-- Exact `IsSemPropTyI` equivalence between `lift 0 1 (instantiate0 v B)` and `B` in
    `.letBinding A v :: Γ` (`isSemPropTyI_letBinding_lift0_instantiate0_iff`, requiring **zero
    `ih_B`, zero `SortRow`, and zero `PiRowField`**). -/
theorem isSemPropTyI_letBinding_lift0_instantiate0_iff
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w)) :
    IsSemPropTyI E n (.letBinding A v :: Γ) (lift 0 1 (instantiate0 v B)) ↔
      IsSemPropTyI E n (.letBinding A v :: Γ) B := by
  have hcl := envClosed_of_envWfT hW
  constructor
  · intro ⟨⟨P', ⟨hP'⟩, ⟨hcP'⟩⟩, hnot⟩
    refine ⟨⟨P', ⟨hP'⟩, ⟨.trans _ _ _ _ hcP'
      (tyConvT_letBinding_lift0_instantiate0 hW hA hv hB)⟩⟩, ?_⟩
    intro hsort
    exact hnot ((approxDIK_ctxEnvDIK_letBinding_lift0_instantiate0_iff E A v Γ B .sort).mpr hsort)
  · intro hPB
    exact isSemPropTyI_weaken0 hcl (.letBinding A v)
      (isSemPropTyI_substLet0 hW hv hPB)

/-- **Exact `LRTermMajSemBi` Type Equivalence Between `lift 0 1 (instantiate0 v B)` and `B` in
    `.letBinding A v :: Γ` (`lrTermMajSemBi_letBinding_lift0_instantiate0_iff`):**
    Requires **zero `ih_B`, zero `SortRow`, and zero `PiRowField`**! -/
theorem lrTermMajSemBi_letBinding_lift0_instantiate0_iff
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v X Y B : Expr Nat} {u w : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv : HasTyT E n Γ v A)
    (hB : HasTyT E n (.letBinding A v :: Γ) B (.sort w)) :
    LRTermMajSemBi E n (.letBinding A v :: Γ) X Y (lift 0 1 (instantiate0 v B)) ↔
      LRTermMajSemBi E n (.letBinding A v :: Γ) X Y B := by
  have hP_iff := isSemPropTyI_letBinding_lift0_instantiate0_iff hW hA hv hB
  have hpi_iff := approxDIK_ctxEnvDIK_letBinding_lift0_instantiate0_iff E A v Γ B (.pi .bot [])
  constructor
  · intro h c hc hor
    rcases h c hc hor with hP | hpi | hlr
    · exact Or.inl (hP_iff.mp hP)
    · exact Or.inr (Or.inl (hpi_iff.mp hpi))
    · exact Or.inr (Or.inr hlr)
  · intro h c hc hor
    rcases h c hc hor with hP | hpi | hlr
    · exact Or.inl (hP_iff.mpr hP)
    · exact Or.inr (Or.inl (hpi_iff.mpr hpi))
    · exact Or.inr (Or.inr hlr)

/-- Commutation of `instantiate0 v` with `instantiate0 (lift 0 1 a)` on a codomain `B`
    (`instantiate0_instantiate0_lift0`). -/
theorem instantiate0_instantiate0_lift0 (v a B : Expr Nat) :
    instantiate0 v (instantiate0 (lift 0 1 a) B) =
      instantiate0 a (instantiate 1 (lift 0 1 v) B) := by
  simp only [instantiate0]
  rw [instantiate_instantiate 0 0 (lift 0 1 a) v (Nat.le_refl 0) B,
      instantiate_lift_id 0 v a]

/-- `instantiate0 v (.app M (lift 0 1 a)) = .app (instantiate0 v M) a`
    (`instantiate0_app_lift0_right`). -/
theorem instantiate0_app_lift0_right (v M a : Expr Nat) :
    instantiate0 v (.app M (lift 0 1 a)) = .app (instantiate0 v M) a := by
  simp only [instantiate0, instantiate, instantiate_lift_id 0 v a]

/-- **Head `let`-Substitution Commutation for `LRAppFnDiagMajSemBi` (`lrAppFnDiagMajSemBi_substLet0`):**
    Note that `instantiate0 w0 (.pi A B) = .pi (instantiate0 w0 A) (instantiate 1 (lift 0 1 w0) B)`.
    Requires **zero `ih_A` and zero `ih_B`**! -/
theorem lrAppFnDiagMajSemBi_substLet0 {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {t w0 M A B : Expr Nat} {u_t u_A : Level}
    (ht : HasTyT E n Γ t (.sort u_t))
    (hw0 : HasTyT E n Γ w0 t)
    (hA : HasTyT E n (.letBinding t w0 :: Γ) A (.sort u_A))
    (hM : LRAppFnDiagMajSemBi E n (.letBinding t w0 :: Γ) M A B) :
    LRAppFnDiagMajSemBi E n Γ (instantiate0 w0 M)
      (instantiate0 w0 A) (instantiate 1 (lift 0 1 w0) B) := by
  have hcl := envClosed_of_envWfT hW
  intro a ha ih_a
  have ha_wk : HasTyT E n (.letBinding t w0 :: Γ) (lift 0 1 a) (lift 0 1 (instantiate0 w0 A)) :=
    hasTyTWeaken (.letBinding t w0) hcl (c := 0) ha
  have ha_let : HasTyT E n (.letBinding t w0 :: Γ) (lift 0 1 a) A :=
    .conv _ _ _ A u_A ha_wk (convT_letBinding_type_lift0_instantiate0 hW ht hw0 hA)
  have ih_a_let : LRTermMajSemBi E n (.letBinding t w0 :: Γ) (lift 0 1 a) (lift 0 1 a) A :=
    (lrTermMajSemBi_letBinding_lift0_instantiate0_iff hW ht hw0 hA).mp
      (lrTermMajSemBi_weaken0 hcl (.letBinding t w0) ih_a)
  have happ := lrTermMajSemBi_substLet0 hW hw0 (hM ha_let ih_a_let)
  rwa [instantiate0_app_lift0_right w0 M a, instantiate0_instantiate0_lift0 w0 a B] at happ

