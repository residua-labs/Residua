    (ih_f : LRTermDSubKClosedCtxBi E n Γ f₁ f₂ (.pi A B))
    (ih_a : LRTermDSubKClosedCtxBi E n Γ a₁ a₂ A)
    (ih_app₁ : LRTermDSubKClosedCtxBi E n Γ (.app f₁ a₁) (.app f₁ a₁) (instantiate0 a₁ B)) :
    LRTermDSubKClosedCtxBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ B) := by
  have hcancel : instantiate0 f₁ (lift 0 1 (instantiate0 a₁ B)) = instantiate0 a₁ B :=
    (instantiate_lift_cancel 1 0 0 f₁ (Nat.le_refl 0) Nat.zero_lt_one (instantiate0 a₁ B)).trans
      (lift_zero 0 (instantiate0 a₁ B))
  have ih_fn_diag : LRTermDSubKClosedCtxBi E n Γ
      (instantiate0 f₁ (.app (.bvar 0) (lift 0 1 a₁)))
      (instantiate0 f₁ (.app (.bvar 0) (lift 0 1 a₁)))
      (instantiate0 f₁ (lift 0 1 (instantiate0 a₁ B))) := by
    simpa only [instantiate0_app_bvar0_lift0 f₁ a₁, hcancel] using ih_app₁
  have h_fn0 := hSubst0 hΓ hf₁ hf₂ hcf ih_f ih_fn_diag
  rw [instantiate0_app_bvar0_lift0 f₁ a₁, instantiate0_app_bvar0_lift0 f₂ a₁, hcancel] at h_fn0
  have ih_app₂₁ : LRTermDSubKClosedCtxBi E n Γ (.app f₂ a₁) (.app f₂ a₁) (instantiate0 a₁ B) :=
