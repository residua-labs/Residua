/-! ### §28.1. $\beta$-Spine Reduction Under `WhRedPiKClosedCtxMaj`, `ctorTagCpt` Exclusion for
$\lambda$-Abstractions, and General 3-Branch Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation
Congruence (`lrTermMajSemBi_subst0_of_no_ctorTag`) -/

/-- Every $\lambda$-abstraction `.lam A b` has no `.spine r args` compact in `ApproxDIK E ρ`
    (`approxDIK_lam_not_spine`). -/
theorem approxDIK_lam_not_spine {E : ResolvedEnv} {ρ : EnvI} (A b : Expr Nat)
    (r : Nat) (args : List CptI) :
    ¬ ApproxDIK E ρ (.lam A b) (.spine r args) := by
  intro h
  rcases approxDIK_lam_inv h with h0 | ⟨_, h0, _⟩ <;> cases h0

/-- Any applied $\lambda$-abstraction `foldApps (.lam A b) (a :: args)` takes a head $\beta$-step in
    `WhStepPiKClosedCtxMaj E Γ` to `foldApps (instantiate0 a b) args`
    (`whStepPiKClosedCtxMaj_foldApps_lam_cons`). -/
theorem whStepPiKClosedCtxMaj_foldApps_lam_cons (E : ResolvedEnv) (Γ : LCtx)
    (A b a : Expr Nat) (args : List (Expr Nat)) :
    WhStepPiKClosedCtxMaj E Γ (foldApps (.lam A b) (a :: args)) (foldApps (instantiate0 a b) args) :=
  whStepPiKClosedCtxMaj_foldApps (.of_whStep (.beta A b a)) args

/-- Any applied $\lambda$-abstraction `foldApps (.lam A b) (a :: args)` weak-head reduces in
    `WhRedPiKClosedCtxMaj E Γ` to `foldApps (instantiate0 a b) args`
    (`whRedPiKClosedCtxMaj_foldApps_lam_cons`). -/
theorem whRedPiKClosedCtxMaj_foldApps_lam_cons (E : ResolvedEnv) (Γ : LCtx)
    (A b a : Expr Nat) (args : List (Expr Nat)) :
    WhRedPiKClosedCtxMaj E Γ (foldApps (.lam A b) (a :: args)) (foldApps (instantiate0 a b) args) :=
  .step (whStepPiKClosedCtxMaj_foldApps_lam_cons E Γ A b a args) (.refl _)

/-- If `f ↠whMaj .lam A b` in `WhRedPiKClosedCtxMaj E Γ`, then `.app f v ↠whMaj instantiate0 v b`
    for any `v` (`whRedPiKClosedCtxMaj_app_lam`). -/
theorem whRedPiKClosedCtxMaj_app_lam {E : ResolvedEnv} {Γ : LCtx} {f A b : Expr Nat}
    (hf : WhRedPiKClosedCtxMaj E Γ f (.lam A b)) (v : Expr Nat) :
    WhRedPiKClosedCtxMaj E Γ (.app f v) (instantiate0 v b) :=
  (whRedPiKClosedCtxMaj_foldApps hf [v]).trans
    (.step (.of_whStep (.beta A b v)) (.refl _))

/-- If `f ↠whMaj .lam A (.sort l)` in `WhRedPiKClosedCtxMaj E Γ`, then `.app f v ↠whMaj .sort l`
    for any `v` (`whRedPiKClosedCtxMaj_app_lam_sort`). -/
theorem whRedPiKClosedCtxMaj_app_lam_sort {E : ResolvedEnv} {Γ : LCtx} {f A : Expr Nat} {l : Level}
    (hf : WhRedPiKClosedCtxMaj E Γ f (.lam A (.sort l))) (v : Expr Nat) :
    WhRedPiKClosedCtxMaj E Γ (.app f v) (.sort l) :=
  whRedPiKClosedCtxMaj_app_lam hf v

/-- If `f ↠whMaj .lam A (.pi D C)` in `WhRedPiKClosedCtxMaj E Γ`, then
    `.app f v ↠whMaj .pi (instantiate0 v D) (instantiate 1 (lift 0 1 v) C)` for any `v`
    (`whRedPiKClosedCtxMaj_app_lam_pi`). -/
theorem whRedPiKClosedCtxMaj_app_lam_pi {E : ResolvedEnv} {Γ : LCtx} {f A D C : Expr Nat}
    (hf : WhRedPiKClosedCtxMaj E Γ f (.lam A (.pi D C))) (v : Expr Nat) :
    WhRedPiKClosedCtxMaj E Γ (.app f v)
      (.pi (instantiate0 v D) (instantiate 1 (lift 0 1 v) C)) :=
  whRedPiKClosedCtxMaj_app_lam hf v

/-- **All-Arity `ctorTagCpt` Exclusion for $\lambda$-Abstractions Whose Instantiated Bodies Have
    Neither `.lam` Nor `.spine w.ctorRef` (`approxDIK_ctxEnvDIK_foldApps_lam_not_ctorTagCpt_of_body`):**
    Under `EnvWfT E`, if for every argument `a : Expr Nat`, `instantiate0 a b` has neither `.lam g`
    nor `.spine w.ctorRef us` in `ApproxDIK E (ctxEnvDIK E Γ)`, then `foldApps (.lam A b) args` never
    approximates `ctorTagCpt w` for **any** `w : IotaWitnessS E` and **any** `args : List (Expr Nat)`! -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_not_ctorTagCpt_of_body {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A b : Expr Nat)
    (hb_lam : ∀ a g, ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b) (.lam g))
    (hb_noCtorSp : ∀ a (w : IotaWitnessS E) us,
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 a b) (.spine w.ctorRef us))
    (w : IotaWitnessS E) (args : List (Expr Nat)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A b) args) (ctorTagCpt w) := by
  cases args with
  | nil =>
      exact approxDIK_lam_not_spine A b w.ctorRef _
  | cons a₀ rest =>
      rw [approxDIK_ctxEnvDIK_foldApps_lam_cons_iff hW A b a₀ rest (ctorTagCpt w)]
      exact approxDIK_foldApps_not_ctorTagCpt_of_no_lam_no_ctor_spine
        (hb_lam a₀) (hb_noCtorSp a₀) w rest

/-- Under `EnvWfT E`, `foldApps (.lam A (.sort l)) args` never approximates `ctorTagCpt w` for any
    `w : IotaWitnessS E` and `args : List (Expr Nat)`
    (`approxDIK_ctxEnvDIK_foldApps_lam_sort_not_ctorTagCpt`). -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_sort_not_ctorTagCpt {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A : Expr Nat) (l : Level)
    (w : IotaWitnessS E) (args : List (Expr Nat)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A (.sort l)) args) (ctorTagCpt w) :=
  approxDIK_ctxEnvDIK_foldApps_lam_not_ctorTagCpt_of_body hW A (.sort l)
    (fun _ => approxDIK_sort_not_lam l)
    (fun _ w' us => approxDIK_sort_not_spine l w'.ctorRef us)
    w args

/-- Under `EnvWfT E`, `foldApps (.lam A (.pi D₁ D₂)) args` never approximates `ctorTagCpt w` for any
    `w : IotaWitnessS E` and `args : List (Expr Nat)`
    (`approxDIK_ctxEnvDIK_foldApps_lam_pi_not_ctorTagCpt`). -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_pi_not_ctorTagCpt {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} (A D₁ D₂ : Expr Nat)
    (w : IotaWitnessS E) (args : List (Expr Nat)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps (.lam A (.pi D₁ D₂)) args) (ctorTagCpt w) :=
  approxDIK_ctxEnvDIK_foldApps_lam_not_ctorTagCpt_of_body hW A (.pi D₁ D₂)
    (fun a => approxDIK_pi_not_lam (instantiate0 a D₁) (instantiate 1 (lift 0 1 a) D₂))
    (fun a w' us => approxDIK_pi_not_spine (instantiate0 a D₁) (instantiate 1 (lift 0 1 a) D₂) w'.ctorRef us)
    w args

/-- Under `EnvWfT E`, `foldApps (.lam A (foldApps (.const r ls) cargs)) args` never approximates
    `ctorTagCpt w` for any non-constructor `RigidConst` (`hm : E.members r = some m`,
    `hb : m.body = none`, `hnrec : m.mclass ≠ .recursorM`, `hnctor : m.mclass ≠ .constructorM`),
    any `w : IotaWitnessS E`, and any `args : List (Expr Nat)`
    (`approxDIK_ctxEnvDIK_foldApps_lam_rigidConst_nonCtor_not_ctorTagCpt`). -/
theorem approxDIK_ctxEnvDIK_foldApps_lam_rigidConst_nonCtor_not_ctorTagCpt
    {E : ResolvedEnv} (hW : EnvWfT E) {Γ : LCtx}
    {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none)
    (hnrec : m.mclass ≠ .recursorM) (hnctor : m.mclass ≠ .constructorM)
    (A : Expr Nat) (cargs : List (Expr Nat))
    (w : IotaWitnessS E) (args : List (Expr Nat)) :
    ¬ ApproxDIK E (ctxEnvDIK E Γ)
      (foldApps (.lam A (foldApps (.const r ls) cargs)) args) (ctorTagCpt w) := by
  refine approxDIK_ctxEnvDIK_foldApps_lam_not_ctorTagCpt_of_body hW A
    (foldApps (.const r ls) cargs) ?_ ?_ w args
  · intro a g
    rw [show instantiate0 a (foldApps (.const r ls) cargs) =
        foldApps (.const r ls) (cargs.map (instantiate0 a)) from
      instantiate_foldApps 0 a (.const r ls) cargs]
    exact approxDIK_foldApps_rigidConst_not_lam hm hb hnrec (cargs.map (instantiate0 a)) g
  · intro a w' us
    rw [show instantiate0 a (foldApps (.const r ls) cargs) =
        foldApps (.const r ls) (cargs.map (instantiate0 a)) from
      instantiate_foldApps 0 a (.const r ls) cargs]
    exact approxDIK_foldApps_rigidConst_nonCtor_not_ctor_spine
      hm hb hnrec hnctor (cargs.map (instantiate0 a)) w' us

/-- **Master 3-Branch Single-Let-Diagonal (`hb_let₁`-Only) 0-Instantiation Congruence Theorem in
    `LRTermMajSemBi` Removing `hv_nolam` (`lrTermMajSemBi_subst0_of_no_ctorTag`):**
    Generalizes §27.2's `lrTermMajSemBi_subst0_of_no_lam_no_ctor_spine` by removing `hv_nolam`
    completely and closing all three branches of `whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag`:
    - **Branch 1 (shared target `c`)**: `b ↠whMaj .sort l₁` or `b ↠whMaj .pi D₁ D₂` in both
      `.letBinding` contexts, closed by `LRProbeTypePiKClosedCtxMaj.sort` or
      `lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_same_pi` + `hb_wf2`;
    - **Branch 2 (`args = []`, direct reduction through `.bvar 0`)**:
      `instantiate0 v₁ b ↠whMaj v₁` and `instantiate0 v₂ b ↠whMaj v₂`, closed by `hv_probe`;
    - **Branch 3 (`args = arg₀ :: rest`, positive-arity spine through `.bvar 0`)**:
      `b ↠whMaj foldApps (.bvar 0) (arg₀ :: rest)` in both `.letBinding` contexts so that
      `instantiate0 v₁ b ↠whMaj foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))`
      and `instantiate0 v₂ b ↠whMaj foldApps v₂ (instantiate0 v₂ arg₀ :: rest.map (instantiate0 v₂))`,
      closed by `hv_app_probe`!
    Requires **ZERO `hv_nolam`, ZERO `hb_inst₁`, ZERO `hb_inst₂`, ZERO `hb_let₂`, and ZERO `CtxWfT`**! -/
theorem lrTermMajSemBi_subst0_of_no_ctorTag
    {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {A v₁ v₂ b B : Expr Nat} {u : Level}
    (hA : HasTyT E n Γ A (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A) (hv₂ : HasTyT E n Γ v₂ A)
    (hcv : ConvT E n Γ v₁ v₂ A)
    (hv_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂)
    (hv_noCtor : ∀ (w : IotaWitnessS E) (args : List (Expr Nat)),
      ¬ ApproxDIK E (ctxEnvDIK E Γ) (foldApps v₁ args) (ctorTagCpt w))
    (hv_probe : ∀ c, ProbeCpt c → ApproxDIK E (ctxEnvDIK E Γ) v₁ c →
      LRProbeTypePiKClosedCtxMaj E n Γ v₁ v₂ c)
    (hv_app_probe : ∀ (arg₀ : Expr Nat) (rest : List (Expr Nat)) (c : CptI),
      ProbeCpt c →
      WhRedPiKClosedCtxMaj E (.letBinding A v₁ :: Γ) b (foldApps (.bvar 0) (arg₀ :: rest)) →
      WhRedPiKClosedCtxMaj E (.letBinding A v₂ :: Γ) b (foldApps (.bvar 0) (arg₀ :: rest)) →
      ApproxDIK E (ctxEnvDIK E Γ)
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) c →
      LRProbeTypePiKClosedCtxMaj E n Γ
        (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁)))
        (foldApps v₂ (instantiate0 v₂ arg₀ :: rest.map (instantiate0 v₂))) c)
    (hb_let₁ : LRTermMajSemBi E n (.letBinding A v₁ :: Γ) b b B)
    (hb_wf2 : LRPiWf2Maj E n (.letBinding A v₁ :: Γ) b) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ B) := by
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have hinst₁ : ApproxDIK E (ctxEnvDIK E Γ) (instantiate0 v₁ b) c :=
    hor.elim id (fun h₂ => (approxDIK_ctxEnvDIK_instantiate0_iff_of_prunedSemEqDIK hv_sem b hc_p).mpr h₂)
  have hb_c : ApproxDIK E (ctxEnvDIK E (.letBinding A v₁ :: Γ)) b c :=
    (approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ b c).mp hinst₁
  rcases hb_let₁ c hc (Or.inl hb_c) with hPB | hpiB | hlr
  · exact Or.inl (isSemPropTyI_substLet0 hW hv₁ hPB)
  · exact Or.inr (Or.inl
      ((approxDIK_ctxEnvDIK_substLet0_iff E A v₁ Γ B (.pi .bot [])).mpr hpiB))
  · have hcl := envClosed_of_envWfT hW
    cases hc with
    | bot => exact Or.inr (Or.inr (.bot Γ _ _))
    | sort =>
        obtain ⟨l₁, hred_b⟩ := lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlr
        rcases whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag A A hv_sem hv_noCtor hred_b with
          hred_b₂ | ⟨args, hm₁, hm₂, _⟩
        · exact Or.inr (Or.inr (.sort
            (whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₁ hred_b)
            (whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₂ hred_b₂)))
        · have hsub₁ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₁ hm₁
          have hsub₂ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₂ hm₂
          rw [instantiate0_foldApps_bvar0] at hsub₁ hsub₂
          cases args with
          | nil =>
              have hv₁_s : ApproxDIK E (ctxEnvDIK E Γ) v₁ .sort :=
                (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ .sort).mp hinst₁
              exact Or.inr (Or.inr
                (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
                  (hv_probe .sort .sort hv₁_s)))
          | cons arg₀ rest =>
              have hsp_s : ApproxDIK E (ctxEnvDIK E Γ)
                  (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) .sort :=
                (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ .sort).mp hinst₁
              exact Or.inr (Or.inr
                (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
                  (hv_app_probe arg₀ rest .sort .sort hm₁ hm₂ hsp_s)))
    | piBotNil =>
        obtain ⟨D₁, D₂, hred_b⟩ := lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlr
        rcases whRedPiKClosedCtxMaj_letBinding_dichotomy_of_no_ctorTag A A hv_sem hv_noCtor hred_b with
          hred_b₂ | ⟨args, hm₁, hm₂, _⟩
        · obtain ⟨u₁, u₂, ⟨hD₁⟩, ⟨hD₂⟩⟩ := hb_wf2 D₁ D₂ hred_b
          exact lrTermMajSemBi_subst0_of_whRedPiKClosedCtxMaj_same_pi hW
            (instantiate0 v₁ B) hA hv₁ hv₂ hcv hred_b hred_b₂ hD₁ hD₂
            (.pi .bot []) .piBotNil (Or.inl hinst₁)
        · have hsub₁ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₁ hm₁
          have hsub₂ := whRedPiKClosedCtxMaj_substLet0_of_envClosed hcl A v₂ hm₂
          rw [instantiate0_foldApps_bvar0] at hsub₁ hsub₂
          cases args with
          | nil =>
              have hv₁_pi : ApproxDIK E (ctxEnvDIK E Γ) v₁ (.pi .bot []) :=
                (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ (.pi .bot [])).mp hinst₁
              exact Or.inr (Or.inr
                (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
                  (hv_probe (.pi .bot []) .piBotNil hv₁_pi)))
          | cons arg₀ rest =>
              have hsp_pi : ApproxDIK E (ctxEnvDIK E Γ)
                  (foldApps v₁ (instantiate0 v₁ arg₀ :: rest.map (instantiate0 v₁))) (.pi .bot []) :=
                (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hsub₁ (.pi .bot [])).mp hinst₁
              exact Or.inr (Or.inr
                (lrProbeTypePiKClosedCtxMaj_whRedPiKClosedCtxMaj_expand hsub₁ hsub₂
                  (hv_app_probe arg₀ rest (.pi .bot []) .piBotNil hm₁ hm₂ hsp_pi)))

/-! ### §28.2. Unconditional Application Congruence in `LRProbeTypePiKClosedCtxMaj` and `LRTermMajSemBi`
for $\lambda$-Abstractions Over Sorts and $\Pi$-Types (`polyPi`), and Single-Let-Diagonal
(`hb_let₁`-Only) 0-Instantiation Discharges for $\lambda$-Abstractions and Proposition-Major
K-Recursor Spines -/

/-- Unconditional `LRProbeTypePiKClosedCtxMaj` at `.sort` for any applications `.app f₁ v₁` and
    `.app f₂ v₂` where `f₁ ↠whMaj .lam A₁ (.sort l₁)` and `f₂ ↠whMaj .lam A₂ (.sort l₂)`
    (`lrProbeTypePiKClosedCtxMaj_app_lam_sort`). -/
theorem lrProbeTypePiKClosedCtxMaj_app_lam_sort {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f₁ f₂ A₁ A₂ : Expr Nat} {l₁ l₂ : Level}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (.lam A₁ (.sort l₁)))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (.lam A₂ (.sort l₂)))
    (v₁ v₂ : Expr Nat) :
    LRProbeTypePiKClosedCtxMaj E n Γ (.app f₁ v₁) (.app f₂ v₂) .sort :=
  .sort (whRedPiKClosedCtxMaj_app_lam_sort hf₁ v₁) (whRedPiKClosedCtxMaj_app_lam_sort hf₂ v₂)

/-- **Unconditional Two-Sided Application Congruence in `LRTermMajSemBi` for $\lambda$-Abstractions
    Over Sorts (`lrTermMajSemBi_app_lam_sort`):**
    Holds at **every** type `T : Expr Nat` with **zero** hypotheses on `v₁, v₂, A₁, A₂`! -/
theorem lrTermMajSemBi_app_lam_sort {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} {f₁ f₂ A₁ A₂ : Expr Nat} {l₁ l₂ : Level}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (.lam A₁ (.sort l₁)))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (.lam A₂ (.sort l₂)))
    (v₁ v₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ v₁) (.app f₂ v₂) T :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
    (whRedPiKClosedCtxMaj_app_lam_sort hf₁ v₁)
    (whRedPiKClosedCtxMaj_app_lam_sort hf₂ v₂)
    (lrTermMajSemBi_sorts T)

/-- **Unconditional Two-Sided Application Congruence in `LRProbeTypePiKClosedCtxMaj` at `.pi .bot []`
    for $\lambda$-Abstractions Over $\Pi$-Types (`lrProbeTypePiKClosedCtxMaj_app_lam_pi`):**
    Requires **zero** semantic hypotheses on `v₁, v₂, D₁, D₂, C₁, C₂` and **zero** `PiInj`! -/
theorem lrProbeTypePiKClosedCtxMaj_app_lam_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ A₁ A₂ D₁ C₁ D₂ C₂ v₁ v₂ : Expr Nat} {u u₁ u₂ : Level}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (.lam A₁ (.pi D₁ C₁)))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (.lam A₂ (.pi D₂ C₂)))
    (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A₁) (hv₂ : HasTyT E n Γ v₂ A₁)
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hD₁ : HasTyT E n (.assumption A₁ :: Γ) D₁ (.sort u₁))
    (hC₁ : HasTyT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ (.sort u₂))
    (hcD : ConvT E n (.assumption A₁ :: Γ) D₁ D₂ (.sort u₁))
    (hcC : ConvT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ C₂ (.sort u₂)) :
    LRProbeTypePiKClosedCtxMaj E n Γ (.app f₁ v₁) (.app f₂ v₂) (.pi .bot []) :=
  .pi
    (whRedPiKClosedCtxMaj_app_lam_pi hf₁ v₁)
    (whRedPiKClosedCtxMaj_app_lam_pi hf₂ v₂)
    (.of Γ _ _ u₁ (convT_inst0_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hcD))
    (.of _ _ _ u₂ (convT_inst1_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hC₁ hcC))

/-- **Unconditional Two-Sided Application Congruence in `LRTermMajSemBi` for $\lambda$-Abstractions
    Over $\Pi$-Types (`lrTermMajSemBi_app_lam_pi`):**
    Holds at **every** type `T : Expr Nat` with **zero** semantic hypotheses on `v₁, v₂, D₁, D₂, C₁, C₂`! -/
theorem lrTermMajSemBi_app_lam_pi {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {f₁ f₂ A₁ A₂ D₁ C₁ D₂ C₂ v₁ v₂ : Expr Nat} {u u₁ u₂ : Level}
    (hf₁ : WhRedPiKClosedCtxMaj E Γ f₁ (.lam A₁ (.pi D₁ C₁)))
    (hf₂ : WhRedPiKClosedCtxMaj E Γ f₂ (.lam A₂ (.pi D₂ C₂)))
    (hA₁ : HasTyT E n Γ A₁ (.sort u))
    (hv₁ : HasTyT E n Γ v₁ A₁) (hv₂ : HasTyT E n Γ v₂ A₁)
    (hcv : ConvT E n Γ v₁ v₂ A₁)
    (hD₁ : HasTyT E n (.assumption A₁ :: Γ) D₁ (.sort u₁))
    (hC₁ : HasTyT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ (.sort u₂))
    (hcD : ConvT E n (.assumption A₁ :: Γ) D₁ D₂ (.sort u₁))
    (hcC : ConvT E n (.assumption D₁ :: .assumption A₁ :: Γ) C₁ C₂ (.sort u₂))
    (T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ v₁) (.app f₂ v₂) T :=
  lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
    (whRedPiKClosedCtxMaj_app_lam_pi hf₁ v₁)
    (whRedPiKClosedCtxMaj_app_lam_pi hf₂ v₂)
    (lrTermMajSemBi_pi T
      (.of Γ _ _ u₁ (convT_inst0_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hcD))
      (.of _ _ _ u₂ (convT_inst1_twoSided_sort hW hΓ hA₁ hv₁ hv₂ hcv hD₁ hC₁ hcC)))

/-- **Positive Resolution of the `polyPi` Benchmark Under Two-Sided Application in `LRTermMajSemBi`
    (`lrTermMajSemBi_polyPi_app`):**
    For `polyPi = .lam (.sort (.succ .zero)) (.pi (.bvar 0) (.bvar 1))` (`fun (X : Sort 1) => X → X`)
    and **any** convertible types `X₁, X₂ : .sort (.succ .zero)` in `Γ`,
    `LRTermMajSemBi E n Γ (.app polyPi X₁) (.app polyPi X₂) T` holds unconditionally at every type `T`! -/
theorem lrTermMajSemBi_polyPi_app {E : ResolvedEnv} (hW : EnvWfT E)
    {n : Nat} {Γ : LCtx} (hΓ : CtxWfT E n Γ)
    {X₁ X₂ : Expr Nat}
    (hX₁ : HasTyT E n Γ X₁ (.sort (.succ .zero)))
