/-! ### §32.3. Constructive 3-Contractum ($\beta$/$\iota$/$\iota_K$) Reduction of
`AppDiagSupplyMajSemBi` and Right-Argument `ConvT.app` Congruence -/

/-- **Constructive 3-Contractum ($\beta$/$\iota$/$\iota_K$) Reduction of Application Diagonal
    Adequacy (`lrTermMajSemBi_app_diag_of_contracta`):**
    By §31.1's `approxDIK_app_probeCpt_nonbot_of_fn_and_arg_normalize_inv`, when `f` normalizes to
    `nf` and `a` normalizes under `WhRedPiKClosedCtxMaj E Γ`, all non-`λ` heads, all strict recursor
    prefixes (`xs.length < w.preMajor.length`), and all non-K non-constructor recursor calls have
    **only `.bot` `ProbeCpt` compacts**, so `LRTermMajSemBi E n Γ (.app f a) (.app f a) T` reduces
    **constructively (zero `Classical.choice`)** to the 3 contractum diagonals ($\beta$, $\iota$, $\iota_K$)! -/
theorem lrTermMajSemBi_app_diag_of_contracta {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f nf a T : Expr Nat}
    (hred_f : WhRedPiKClosedCtxMaj E Γ f nf)
    (hnorm_f : WhNormalPiKClosedCtxMaj E Γ nf)
    (hnorm_a : WhRedPiKClosedCtxMajNormalizes E Γ a)
    (hbeta : ∀ A' b,
      nf = .lam A' b →
      WhRedPiKClosedCtxMaj E Γ f (.lam A' b) →
      WhRedPiKClosedCtxMaj E Γ (.app f a) (instantiate0 a b) →
      LRTermMajSemBi E n Γ (instantiate0 a b) (instantiate0 a b) T)
    (hiota : ∀ (w w' : IotaWitnessS E) (ls lsC : List Level) (pre params fields : List (Expr Nat)),
      pre.length = w.preMajor.length →
      w'.recRef = w.recRef →
      params.length = w'.nparams →
      fields.length = w'.fields.length →
      nf = foldApps (.const w.recRef ls) pre →
      WhRedPiKClosedCtxMaj E Γ a (foldApps (.const w'.ctorRef lsC) (params ++ fields)) →
      WhRedPiKClosedCtxMaj E Γ (.app f a)
        (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) →
      LRTermMajSemBi E n Γ
        (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema))
        (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) T)
    (hiotaK : ∀ (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)),
      pre.length = w.preMajor.length →
      nf = foldApps (.const w.recRef ls) pre →
      (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) a (ctorTagCpt w) →
      WhRedPiKClosedCtxMaj E Γ (.app f a)
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema)) →
      LRTermMajSemBi E n Γ
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema))
        (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
          (instantiateLevels ls w.schema)) T) :
    LRTermMajSemBi E n Γ (.app f a) (.app f a) T := by
  intro c hc hor
  have happ : ApproxDIK E (ctxEnvDIK E Γ) (.app f a) c := hor.elim id id
  cases hc with
  | bot => exact Or.inr (Or.inr (.bot Γ (.app f a) (.app f a)))
  | sort =>
      rcases approxDIK_app_probeCpt_nonbot_of_fn_and_arg_normalize_inv hW hred_f hnorm_f hnorm_a
          .sort (by intro h0; cases h0) happ with
        ⟨A', b, hnfEq, hred_lam, hred_beta⟩ |
        ⟨w, w', ls, lsC, pre, params, fields, hpre, hrecEq, hpar, hflds, hnfEq, hred_ctor, hred_iota⟩ |
        ⟨w, ls, pre, hpre, hnfEq, hk, hnot_tag, hred_k⟩
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_beta hred_beta
          (hbeta A' b hnfEq hred_lam hred_beta) .sort .sort hor
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_iota hred_iota
          (hiota w w' ls lsC pre params fields hpre hrecEq hpar hflds hnfEq hred_ctor hred_iota)
          .sort .sort hor
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_k hred_k
          (hiotaK w ls pre hpre hnfEq hk hnot_tag hred_k) .sort .sort hor
  | piBotNil =>
      rcases approxDIK_app_probeCpt_nonbot_of_fn_and_arg_normalize_inv hW hred_f hnorm_f hnorm_a
          .piBotNil (by intro h0; cases h0) happ with
        ⟨A', b, hnfEq, hred_lam, hred_beta⟩ |
        ⟨w, w', ls, lsC, pre, params, fields, hpre, hrecEq, hpar, hflds, hnfEq, hred_ctor, hred_iota⟩ |
        ⟨w, ls, pre, hpre, hnfEq, hk, hnot_tag, hred_k⟩
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_beta hred_beta
          (hbeta A' b hnfEq hred_lam hred_beta) (.pi .bot []) .piBotNil hor
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_iota hred_iota
          (hiota w w' ls lsC pre params fields hpre hrecEq hpar hflds hnfEq hred_ctor hred_iota)
          (.pi .bot []) .piBotNil hor
      · exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_k hred_k
          (hiotaK w ls pre hpre hnfEq hk hnot_tag hred_k) (.pi .bot []) .piBotNil hor

/-- **Constructive 3-Contractum ($\beta$/$\iota$/$\iota_K$) Reduction of `AppDiagSupplyMajSemBi`
    (`appDiagSupplyMajSemBi_of_contracta`):** -/
theorem appDiagSupplyMajSemBi_of_contracta {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    (hnorm_fn : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f A B : Expr Nat},
        HasTyT E n Γ f (.pi A B) → LRTermMajSemBi E n Γ f f (.pi A B) →
        WhRedPiKClosedCtxMajNormalizes E Γ f)
    (hnorm_arg : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {a A : Expr Nat},
        HasTyT E n Γ a A → LRTermMajSemBi E n Γ a a A →
        WhRedPiKClosedCtxMajNormalizes E Γ a)
    (hbeta : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B A' b : Expr Nat},
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) → LRTermMajSemBi E n Γ a a A →
        WhRedPiKClosedCtxMaj E Γ f (.lam A' b) →
        WhRedPiKClosedCtxMaj E Γ (.app f a) (instantiate0 a b) →
        LRTermMajSemBi E n Γ (instantiate0 a b) (instantiate0 a b) (instantiate0 a B))
    (hiota : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B : Expr Nat} (w w' : IotaWitnessS E) (ls lsC : List Level)
        (pre params fields : List (Expr Nat)),
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) → LRTermMajSemBi E n Γ a a A →
        pre.length = w.preMajor.length →
        w'.recRef = w.recRef →
        params.length = w'.nparams →
        fields.length = w'.fields.length →
        WhRedPiKClosedCtxMaj E Γ f (foldApps (.const w.recRef ls) pre) →
        WhRedPiKClosedCtxMaj E Γ a (foldApps (.const w'.ctorRef lsC) (params ++ fields)) →
        WhRedPiKClosedCtxMaj E Γ (.app f a)
          (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) →
        LRTermMajSemBi E n Γ
          (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema))
          (instPrefix (pre ++ fields) (instantiateLevels ls w'.schema)) (instantiate0 a B))
    (hiotaK : ∀ {Γ : LCtx}, CtxWfT E n Γ →
      ∀ {f a A B : Expr Nat} (w : IotaWitnessS E) (ls : List Level) (pre : List (Expr Nat)),
        HasTyT E n Γ f (.pi A B) → HasTyT E n Γ a A →
        LRTermMajSemBi E n Γ f f (.pi A B) → LRTermMajSemBi E n Γ a a A →
        pre.length = w.preMajor.length →
        WhRedPiKClosedCtxMaj E Γ f (foldApps (.const w.recRef ls) pre) →
        (piBody w.famMember.mtype = .sort .zero ∧ w.nMinors = 1) →
        ¬ ApproxDIK E (ctxEnvDIK E Γ) a (ctorTagCpt w) →
        WhRedPiKClosedCtxMaj E Γ (.app f a)
          (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
            (instantiateLevels ls w.schema)) →
        LRTermMajSemBi E n Γ
          (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
            (instantiateLevels ls w.schema))
          (instPrefix (pre ++ List.replicate w.fields.length botClosedExpr)
            (instantiateLevels ls w.schema)) (instantiate0 a B)) :
    AppDiagSupplyMajSemBi E n := by
  intro Γ hΓ f a A B hf ha ih_f ih_a
  obtain ⟨nf, hred_f, hnf⟩ := hnorm_fn hΓ hf ih_f
  exact lrTermMajSemBi_app_diag_of_contracta hW hred_f hnf (hnorm_arg hΓ ha ih_a)
    (fun A' b _ hred_lam hred_beta => hbeta hΓ hf ha ih_f ih_a hred_lam hred_beta)
    (fun w w' ls lsC pre params fields hpre hrecEq hpar hflds hnfEq hred_ctor hred_iota =>
      hiota hΓ w w' ls lsC pre params fields hf ha ih_f ih_a hpre hrecEq hpar hflds
        (hnfEq ▸ hred_f) hred_ctor hred_iota)
    (fun w ls pre hpre hnfEq hk hnot_tag hred_k =>
      hiotaK hΓ w ls pre hf ha ih_f ih_a hpre (hnfEq ▸ hred_f) hk hnot_tag hred_k)

/-- **Constructive Reduction of Right-Argument `ConvT.app` Congruence to $\beta$-Contracta and
    Fieldful Constructor $\iota$-Contracta (`lrTermMajSemBi_app_arg_congr_of_contracta`):**
    Automatically discharges from `hdiag₁` alone:
    - all non-`.lam` heads `f` (variables, axioms, inductive type formers, constructors, non-K
      non-constructor recursor spines, strictly under-applied recursor prefixes),
    - all K-recursor non-constructor calls (`.iotaKClosedCtx`), and
    - all 0-field constructor $\iota$-calls (`w'.fields = []`),
    leaving **only** the $\beta$-branch (`f ↠whMaj .lam A' b`) and the fieldful constructor
    $\iota$-branch (`w'.fields ≠ []`)! -/
theorem lrTermMajSemBi_app_arg_congr_of_contracta {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {f nf a₁ a₂ T : Expr Nat}
    (hred_f : WhRedPiKClosedCtxMaj E Γ f nf)
    (hnorm_f : WhNormalPiKClosedCtxMaj E Γ nf)
    (ha_sem : PrunedSemEqDIK E (ctxEnvDIK E Γ) a₁ a₂)
    (hnorm_a₁ : WhRedPiKClosedCtxMajNormalizes E Γ a₁)
    (hnorm_a₂ : WhRedPiKClosedCtxMajNormalizes E Γ a₂)
    (hdiag₁ : LRTermMajSemBi E n Γ (.app f a₁) (.app f a₁) T)
    (hbeta : ∀ A' b,
      nf = .lam A' b →
      WhRedPiKClosedCtxMaj E Γ f (.lam A' b) →
      LRTermMajSemBi E n Γ (instantiate0 a₁ b) (instantiate0 a₂ b) T)
    (hiota_flds : ∀ (w w' : IotaWitnessS E) (ls lsC₁ lsC₂ : List Level)
      (pre params₁ fields₁ params₂ fields₂ : List (Expr Nat)),
      pre.length = w.preMajor.length →
      w'.recRef = w.recRef →
      w'.fields ≠ [] →
      params₁.length = w'.nparams →
      fields₁.length = w'.fields.length →
      params₂.length = w'.nparams →
      fields₂.length = w'.fields.length →
      nf = foldApps (.const w.recRef ls) pre →
      WhRedPiKClosedCtxMaj E Γ a₁ (foldApps (.const w'.ctorRef lsC₁) (params₁ ++ fields₁)) →
      WhRedPiKClosedCtxMaj E Γ a₂ (foldApps (.const w'.ctorRef lsC₂) (params₂ ++ fields₂)) →
      LRTermMajSemBi E n Γ
        (instPrefix (pre ++ fields₁) (instantiateLevels ls w'.schema))
        (instPrefix (pre ++ fields₂) (instantiateLevels ls w'.schema)) T) :
    LRTermMajSemBi E n Γ (.app f a₁) (.app f a₂) T := by
  intro c hc hor
  have hc_p : PrunedPiCpt c := prunedPiCpt_of_probeCpt hc
  have h₁ : ApproxDIK E (ctxEnvDIK E Γ) (.app f a₁) c :=
    hor.elim id (fun h₂ => (approxDIK_ctxEnvDIK_app_arg_iff_of_prunedSemEqDIK f ha_sem hc_p).mpr h₂)
  cases hc with
  | bot => exact Or.inr (Or.inr (.bot Γ _ _))
  | sort =>
      rcases approxDIK_app_probeCpt_nonbot_of_fn_normalizes_inv hW hred_f hnorm_f
          .sort (by intro h0; cases h0) h₁ with
        ⟨A', b, hnfEq, hred_lam, hred_beta₁⟩ |
        ⟨w, ls, pre, hpre, hnfEq, hred_app₁, hrec_c⟩
      · have hred_beta₂ : WhRedPiKClosedCtxMaj E Γ (.app f a₂) (instantiate0 a₂ b) :=
          whRedPiKClosedCtxMaj_app_lam hred_lam a₂
        exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_beta₁ hred_beta₂
          (hbeta A' b hnfEq hred_lam) .sort .sort hor
      · have hred_rec : WhRedPiKClosedCtxMaj E Γ f (foldApps (.const w.recRef ls) pre) :=
          hnfEq ▸ hred_f
        have hred_app₂ : WhRedPiKClosedCtxMaj E Γ (.app f a₂)
            (recCall (.const w.recRef ls) pre a₂) := by
          rw [recCall, foldApps_snoc]
          exact whRedPiKClosedCtxMaj_foldApps hred_rec [a₂]
        have hdiag_rec₁ : LRTermMajSemBi E n Γ
            (recCall (.const w.recRef ls) pre a₁)
            (recCall (.const w.recRef ls) pre a₁) T :=
          lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred_app₁ hred_app₁ hdiag₁
        rcases approxDIK_recCall_nonbot_of_major_normalizes_inv hW w ls hpre
            (by intro h0; cases h0) hrec_c hnorm_a₁ with
          ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, _⟩ |
          ⟨hk, hnot_tag₁, _⟩
        · have htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w') :=
            (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_ctor (ctorTagCpt w')).mpr
              (approxDIK_ctorTagCpt_of_ctor_spine hW w' lsC
                (by rw [List.length_append, hpar, hflds]) (ctxEnvDIK E Γ))
          cases hflds_case : w'.fields with
          | nil =>
              exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_app₁ hred_app₂
                (lrTermMajSemBi_recursor_foldApps_of_zero_fields hW w w' ls hpre hrecEq
                  hflds_case [] ha_sem hnorm_a₁ hnorm_a₂ htag₁ hdiag_rec₁)
                .sort .sort hor
          | cons f₀ fs =>
              obtain ⟨lsC₁, lsC₂, params₁, fields₁, params₂, fields₂,
                      hpar₁, hflds₁, hpar₂, hflds₂, hctor₁, hctor₂, hcall₁, hcall₂⟩ :=
                whRedPiKClosedCtxMaj_recursor_foldApps_both_of_prunedSemEqDIK_and_normalizes
                  hW w w' ls hpre hrecEq [] ha_sem hnorm_a₁ hnorm_a₂ htag₁
              exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
                (hred_app₁.trans hcall₁) (hred_app₂.trans hcall₂)
                (hiota_flds w w' ls lsC₁ lsC₂ pre params₁ fields₁ params₂ fields₂
                  hpre hrecEq (by rw [hflds_case]; intro h0; cases h0)
                  hpar₁ hflds₁ hpar₂ hflds₂ hnfEq hctor₁ hctor₂)
                .sort .sort hor
        · have hnot_tag₂ : ¬ ApproxDIK E (ctxEnvDIK E Γ) a₂ (ctorTagCpt w) :=
            fun h₂ => hnot_tag₁ ((ha_sem (ctorTagCpt w) (prunedPiCpt_ctorTagCpt w)).mpr h₂)
          have hred_k₁ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls [] hk hpre hnot_tag₁
          have hred_k₂ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls [] hk hpre hnot_tag₂
          exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
            (hred_app₁.trans hred_k₁) (hred_app₂.trans hred_k₂)
            (lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred_k₁ hred_k₁ hdiag_rec₁)
            .sort .sort hor
  | piBotNil =>
      rcases approxDIK_app_probeCpt_nonbot_of_fn_normalizes_inv hW hred_f hnorm_f
          .piBotNil (by intro h0; cases h0) h₁ with
        ⟨A', b, hnfEq, hred_lam, hred_beta₁⟩ |
        ⟨w, ls, pre, hpre, hnfEq, hred_app₁, hrec_c⟩
      · have hred_beta₂ : WhRedPiKClosedCtxMaj E Γ (.app f a₂) (instantiate0 a₂ b) :=
          whRedPiKClosedCtxMaj_app_lam hred_lam a₂
        exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_beta₁ hred_beta₂
          (hbeta A' b hnfEq hred_lam) (.pi .bot []) .piBotNil hor
      · have hred_rec : WhRedPiKClosedCtxMaj E Γ f (foldApps (.const w.recRef ls) pre) :=
          hnfEq ▸ hred_f
        have hred_app₂ : WhRedPiKClosedCtxMaj E Γ (.app f a₂)
            (recCall (.const w.recRef ls) pre a₂) := by
          rw [recCall, foldApps_snoc]
          exact whRedPiKClosedCtxMaj_foldApps hred_rec [a₂]
        have hdiag_rec₁ : LRTermMajSemBi E n Γ
            (recCall (.const w.recRef ls) pre a₁)
            (recCall (.const w.recRef ls) pre a₁) T :=
          lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred_app₁ hred_app₁ hdiag₁
        rcases approxDIK_recCall_nonbot_of_major_normalizes_inv hW w ls hpre
            (by intro h0; cases h0) hrec_c hnorm_a₁ with
          ⟨w', lsC, params, fields, hrecEq, hpar, hflds, hred_ctor, _⟩ |
          ⟨hk, hnot_tag₁, _⟩
        · have htag₁ : ApproxDIK E (ctxEnvDIK E Γ) a₁ (ctorTagCpt w') :=
            (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hred_ctor (ctorTagCpt w')).mpr
              (approxDIK_ctorTagCpt_of_ctor_spine hW w' lsC
                (by rw [List.length_append, hpar, hflds]) (ctxEnvDIK E Γ))
          cases hflds_case : w'.fields with
          | nil =>
              exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW hred_app₁ hred_app₂
                (lrTermMajSemBi_recursor_foldApps_of_zero_fields hW w w' ls hpre hrecEq
                  hflds_case [] ha_sem hnorm_a₁ hnorm_a₂ htag₁ hdiag_rec₁)
                (.pi .bot []) .piBotNil hor
          | cons f₀ fs =>
              obtain ⟨lsC₁, lsC₂, params₁, fields₁, params₂, fields₂,
                      hpar₁, hflds₁, hpar₂, hflds₂, hctor₁, hctor₂, hcall₁, hcall₂⟩ :=
                whRedPiKClosedCtxMaj_recursor_foldApps_both_of_prunedSemEqDIK_and_normalizes
                  hW w w' ls hpre hrecEq [] ha_sem hnorm_a₁ hnorm_a₂ htag₁
              exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
                (hred_app₁.trans hcall₁) (hred_app₂.trans hcall₂)
                (hiota_flds w w' ls lsC₁ lsC₂ pre params₁ fields₁ params₂ fields₂
                  hpre hrecEq (by rw [hflds_case]; intro h0; cases h0)
                  hpar₁ hflds₁ hpar₂ hflds₂ hnfEq hctor₁ hctor₂)
                (.pi .bot []) .piBotNil hor
        · have hnot_tag₂ : ¬ ApproxDIK E (ctxEnvDIK E Γ) a₂ (ctorTagCpt w) :=
            fun h₂ => hnot_tag₁ ((ha_sem (ctorTagCpt w) (prunedPiCpt_ctorTagCpt w)).mpr h₂)
          have hred_k₁ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls [] hk hpre hnot_tag₁
          have hred_k₂ := whRedPiKClosedCtxMaj_recursor_k_foldApps w ls [] hk hpre hnot_tag₂
          exact lrTermMajSemBi_whRedPiKClosedCtxMaj_expand hW
            (hred_app₁.trans hred_k₁) (hred_app₂.trans hred_k₂)
            (lrTermMajSemBi_whRedPiKClosedCtxMaj_preserve hW hred_k₁ hred_k₁ hdiag_rec₁)
            (.pi .bot []) .piBotNil hor


/-! ## §33. Unconditional Bodyless-Constant Applicative Closure (`2 ≤ w.preMajor.length`),
`let`-Substitution & Curried $\lambda$-Application Peeling for `LRAppFn*`, Type-Conversion
Invariance (`↔`), and `LRAppFnLeftMajSemBi` $\eta$ & `ConvT.app` Bridges -/

/-! ### §33.1. Structural Lower Bound `2 ≤ w.preMajor.length` for Every Recursor Witness `w : IotaWitnessS E`
and Unconditional Applicative Closure (`LRAppFnMajSemBi` / `LRAppFnDiagMajSemBi`) for All Bodyless
Constants (`m.body = none`, Zero `m.mclass` Restriction) -/

/-- Every recursor witness `w : IotaWitnessS E` has `0 < w.nMinors` (since `w.ctorIdx < w.nMinors`)
    (`iotaWitnessS_nMinors_pos`). -/
theorem iotaWitnessS_nMinors_pos {E : ResolvedEnv} (w : IotaWitnessS E) :
    0 < w.nMinors :=
  Nat.lt_of_le_of_lt (Nat.zero_le w.ctorIdx) w.hidx

/-- **Universal Pre-Major Length Lower Bound (`iotaWitnessS_preMajor_length_ge_two`):**
    Every recursor witness `w : IotaWitnessS E` satisfies `2 ≤ w.preMajor.length`
    (since `w.preMajor.length = w.nparams + 1 + w.nMinors + w.nindices` with `1 ≤ w.nMinors`)! -/
theorem iotaWitnessS_preMajor_length_ge_two {E : ResolvedEnv} (w : IotaWitnessS E) :
    2 ≤ w.preMajor.length := by
  have hmin := iotaWitnessS_nMinors_pos w
  rw [w.hpre]
  omega

/-- Every recursor witness `w : IotaWitnessS E` satisfies `0 < w.preMajor.length`
    (`iotaWitnessS_preMajor_length_pos`). -/
theorem iotaWitnessS_preMajor_length_pos {E : ResolvedEnv} (w : IotaWitnessS E) :
    0 < w.preMajor.length := by
  have h := iotaWitnessS_preMajor_length_ge_two w
  omega

/-- **Unconditional `.bot`-Collapse of `ProbeCpt` Compacts for Any Bodyless Constant Applied to
    At Most 2 Arguments (`approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot`):**
    For **every** bodyless constant `.const r ls` (`hm : E.members r = some m`, `hb : m.body = none` —
    with **zero `m.mclass` restriction**, covering `inductiveM`, `constructorM`, `axiomM`, `opaqueM`,
    AND `recursorM`!) and **every** spine `xs` with `xs.length ≤ 2`, every `ProbeCpt c` of
    `foldApps (.const r ls) xs` in `ApproxDIK E ρ` is `c = .bot`!
    Proved by a direct 5-way `cases hd` on `hd : ApproxDIK E ρ (.const r ls) d` with **zero `by_cases`
    and zero `Classical.choice`**. -/
theorem approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot
    {E : ResolvedEnv} {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none)
    (ρ : EnvI) {xs : List (Expr Nat)} (hlen : xs.length ≤ 2)
    {c : CptI} (hc : ProbeCpt c)
    (h : ApproxDIK E ρ (foldApps (.const r ls) xs) c) :
    c = .bot := by
  rw [approxDIK_foldApps_iff] at h
  rcases h with ⟨d, hd, hfold⟩
  cases hd with
  | bot => exact foldAppCptK_bot_inv hfold
  | const _ _ _ _ =>
      rcases (foldAppCptK_spine_iff r xs [] c).mp hfold with rfl | ⟨_, _, rfl⟩
      · rfl
      · cases hc
  | delta hdelta _ =>
      rcases hdelta with ⟨hm', hb'⟩
      rw [hm] at hm'
      injection hm' with hmEq
      subst hmEq
      rw [hb] at hb'
      exact Option.noConfusion hb'.1
  | @recursor _ w _ us_pre us_fields c₀ hpre _ _ =>
      have hge := iotaWitnessS_preMajor_length_ge_two w
      have hlt : xs.length < (us_pre ++ [ctorDemand w.ctorRef w.nparams us_fields]).length := by
        simp only [List.length_append, List.length_singleton, hpre]
        omega
      rcases foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold with rfl | ⟨_, rfl⟩
      · rfl
      · cases hc
  | @recursorK _ w _ us_pre u_maj c₀ _ hpre _ _ =>
      have hge := iotaWitnessS_preMajor_length_ge_two w
      have hlt : xs.length < (us_pre ++ [u_maj]).length := by
        simp only [List.length_append, List.length_singleton, hpre]
        omega
      rcases foldAppCptK_curryStep_lt xs _ c₀ c hlt hfold with rfl | ⟨_, rfl⟩
      · rfl
      · cases hc

/-- 1-argument specialization of `approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot`
    (`approxDIK_app_const_body_none_probeCpt_eq_bot`). -/
theorem approxDIK_app_const_body_none_probeCpt_eq_bot
    {E : ResolvedEnv} {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none)
    (ρ : EnvI) (a : Expr Nat) {c : CptI} (hc : ProbeCpt c)
    (h : ApproxDIK E ρ (.app (.const r ls) a) c) :
    c = .bot :=
  approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot hm hb ρ (xs := [a])
    (by simp : [a].length ≤ 2) hc h

/-- 2-argument specialization of `approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot`
    (`approxDIK_app2_const_body_none_probeCpt_eq_bot`). -/
theorem approxDIK_app2_const_body_none_probeCpt_eq_bot
    {E : ResolvedEnv} {r : Nat} {ls : List Level} {m : CheckedMember}
    (hm : E.members r = some m) (hb : m.body = none)
    (ρ : EnvI) (a₁ a₂ : Expr Nat) {c : CptI} (hc : ProbeCpt c)
    (h : ApproxDIK E ρ (.app (.app (.const r ls) a₁) a₂) c) :
    c = .bot :=
  approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot hm hb ρ (xs := [a₁, a₂])
    (by simp : [a₁, a₂].length ≤ 2) hc h

/-- Unconditional relatedness in `LRTermMajSemBi` of any two bodyless-constant spines of length
    `≤ 2` (`lrTermMajSemBi_foldApps_const_body_none_le_two`, zero `m.mclass` restriction). -/
theorem lrTermMajSemBi_foldApps_const_body_none_le_two
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r₁ r₂ : Nat} (ls₁ ls₂ : List Level) {m₁ m₂ : CheckedMember}
    (hm₁ : E.members r₁ = some m₁) (hb₁ : m₁.body = none)
    (hm₂ : E.members r₂ = some m₂) (hb₂ : m₂.body = none)
    {xs₁ xs₂ : List (Expr Nat)}
    (hlen₁ : xs₁.length ≤ 2) (hlen₂ : xs₂.length ≤ 2)
    (T : Expr Nat) :
    LRTermMajSemBi E n Γ
      (foldApps (.const r₁ ls₁) xs₁)
      (foldApps (.const r₂ ls₂) xs₂) T :=
  lrTermMajSemBi_of_probeCpt_eq_bot T
    (fun _ hc h =>
      approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot hm₁ hb₁ (ctxEnvDIK E Γ) hlen₁ hc h)
    (fun _ hc h =>
      approxDIK_foldApps_const_body_none_le_two_probeCpt_eq_bot hm₂ hb₂ (ctxEnvDIK E Γ) hlen₂ hc h)

/-- Unconditional relatedness in `LRTermMajSemBi` of 1-applied bodyless constants
    (`lrTermMajSemBi_app_const_body_none`, zero `m.mclass` restriction). -/
theorem lrTermMajSemBi_app_const_body_none
    {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r₁ r₂ : Nat} (ls₁ ls₂ : List Level) {m₁ m₂ : CheckedMember}
