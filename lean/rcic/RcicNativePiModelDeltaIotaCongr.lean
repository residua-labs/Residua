/-- **Positive Resolution of `etaIdPiPropFn` Under Application (`lrAppFnMajSemBi_eta_bvar_none`):**
    While an assumption variable `f = foldApps (.bvar i) xs` (`lookupValue Γ i = none`) has no `.lam g`
    compact in `ApproxDIK` whereas its $\eta$-expansion `.lam A' (.app (lift 0 1 f) (.bvar 0))` does,
    when applied to any arguments `a₁, a₂`, `.app (.lam A' (.app (lift 0 1 f) (.bvar 0))) a₂` steps
    in 1 $\beta$-step (`whStepPiKClosedCtxMaj_eta_app`) to `.app f a₂`, so `f` and its $\eta$-expansion
    are **unconditionally related in `LRAppFnMajSemBi`** at every `(A, B)`! -/
theorem lrAppFnMajSemBi_eta_bvar_none {E : ResolvedEnv} {n : Nat} (hW : EnvWfT E)
    {Γ : LCtx} {i₁ i₂ : Nat}
    (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) (A A' B : Expr Nat) :
    LRAppFnMajSemBi E n Γ
      (foldApps (.bvar i₁) xs₁)
      (.lam A' (.app (lift 0 1 (foldApps (.bvar i₂) xs₂)) (.bvar 0)))
      A B :=
  (lrAppFnMajSemBi_eta_right_iff hW A' (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) A B).mpr
    (lrAppFnMajSemBi_foldApps_bvar_none hnone₁ hnone₂ xs₁ xs₂ A B)

