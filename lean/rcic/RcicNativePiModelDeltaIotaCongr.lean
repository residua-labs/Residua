/-! ### §26.1. Exact Diagonal Adequacy Equivalence (`lrTermMajSemBi_diag_iff`), Conservative
Embeddings of `LRTypeINPiKClosedCtx` / `LRTermNoPiSemBi` / `LRTermDSubKClosedCtxSemBi` into
`LRTermMajSemBi`, and Unconditional Application & Instantiation Vacuity -/

/-- Pure weak-head adequacy predicate for a single term `M` at type `A` in `LRTermMajSemBi`
    (`WhApproxAdequateAtMaj`), containing **zero** off-diagonal `TyConvT` obligations and **zero**
    `CtxWfT` obligations. -/
def WhApproxAdequateAtMaj (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M A : Expr Nat) : Prop :=
  (ApproxDIK E (ctxEnvDIK E Γ) M .sort →
    IsSemPropTyI E n Γ A ∨
      ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∨
      ∃ l, WhRedPiKClosedCtxMaj E Γ M (.sort l)) ∧
  (ApproxDIK E (ctxEnvDIK E Γ) M (.pi .bot []) →
    IsSemPropTyI E n Γ A ∨
      ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot []) ∨
      ∃ A₁ B₁, WhRedPiKClosedCtxMaj E Γ M (.pi A₁ B₁))

/-- **Exact Diagonal Equivalence for `LRTermMajSemBi` (`lrTermMajSemBi_diag_iff`):**
    For every `M, A : Expr Nat`, the diagonal relation `LRTermMajSemBi E n Γ M M A` is
    100% equivalent (`↔`) to `WhApproxAdequateAtMaj E n Γ M A`, proved constructively with
    zero `Classical.choice`! -/
theorem lrTermMajSemBi_diag_iff (E : ResolvedEnv) (n : Nat) (Γ : LCtx) (M A : Expr Nat) :
    LRTermMajSemBi E n Γ M M A ↔ WhApproxAdequateAtMaj E n Γ M A := by
  constructor
  · intro h
    refine ⟨fun hMs => ?_, fun hMp => ?_⟩
    · rcases h .sort .sort (Or.inl hMs) with hP | hpi | hlr
      · exact Or.inl hP
      · exact Or.inr (Or.inl hpi)
      · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mp hlr))
    · rcases h (.pi .bot []) .piBotNil (Or.inl hMp) with hP | hpi | hlr
      · exact Or.inl hP
      · exact Or.inr (Or.inl hpi)
      · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mp hlr))
  · rintro ⟨hsort, hpi⟩ c hc hor
    have hM : ApproxDIK E (ctxEnvDIK E Γ) M c := hor.elim id id
    cases hc with
    | bot => exact Or.inr (Or.inr (.bot Γ M M))
    | sort =>
        rcases hsort hM with hP | hpiA | hred
        · exact Or.inl hP
        · exact Or.inr (Or.inl hpiA)
        · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_diag_sort_iff.mpr hred))
    | piBotNil =>
        rcases hpi hM with hP | hpiA | hred
        · exact Or.inl hP
        · exact Or.inr (Or.inl hpiA)
        · exact Or.inr (Or.inr (lrProbeTypePiKClosedCtxMaj_diag_pi_iff.mpr hred))

/-- Every `WhRedPiKClosedCtxMaj`-normalizable expression `M` satisfies
    `WhApproxAdequateAtMaj E n Γ M A` at every type `A` (`whApproxAdequateAtMaj_of_normalizes`). -/
theorem whApproxAdequateAtMaj_of_normalizes {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M : Expr Nat} (A : Expr Nat)
    (hnorm : WhRedPiKClosedCtxMajNormalizes E Γ M) :
    WhApproxAdequateAtMaj E n Γ M A :=
  (lrTermMajSemBi_diag_iff E n Γ M A).mp (lrTermMajSemBi_diag_of_normalizes hW A hnorm)

/-- Confluence between `WhRedPiKClosedCtx` and `WhRedPiKClosedCtxMaj` at sort normal forms
    (`whRedPiKClosedCtx_and_maj_sort_eq`). -/
theorem whRedPiKClosedCtx_and_maj_sort_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {M : Expr Nat} {l₁ l₂ : Level}
    (h₁ : WhRedPiKClosedCtx E Γ M (.sort l₁))
    (h₂ : WhRedPiKClosedCtxMaj E Γ M (.sort l₂)) :
    l₁ = l₂ :=
  whRedPiKClosedCtxMaj_sort_unique_of_envWfT hW
    (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₁) h₂

/-- Confluence between `WhRedPiKClosedCtx` and `WhRedPiKClosedCtxMaj` at $\Pi$ normal forms
    (`whRedPiKClosedCtx_and_maj_pi_eq`). -/
theorem whRedPiKClosedCtx_and_maj_pi_eq {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {M A₁ B₁ A₂ B₂ : Expr Nat}
    (h₁ : WhRedPiKClosedCtx E Γ M (.pi A₁ B₁))
    (h₂ : WhRedPiKClosedCtxMaj E Γ M (.pi A₂ B₂)) :
    A₁ = A₂ ∧ B₁ = B₂ :=
  whRedPiKClosedCtxMaj_pi_unique_of_envWfT hW
    (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₁) h₂

/-- Conservative embedding of `LRTypeINPiKClosedCtx` into `LRProbeTypePiKClosedCtxMaj` on
    `ProbeCpt` (`lrProbeTypePiKClosedCtxMaj_of_lrTypeINPiKClosedCtx_probe`). -/
theorem lrProbeTypePiKClosedCtxMaj_of_lrTypeINPiKClosedCtx_probe {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' : Expr Nat} {c : CptI} (hc : ProbeCpt c)
    (h : LRTypeINPiKClosedCtx E n Γ M M' c) :
    LRProbeTypePiKClosedCtxMaj E n Γ M M' c := by
  cases hc with
  | bot => exact .bot Γ M M'
  | sort =>
      cases h with
      | sort h₁ h₂ =>
          exact .sort (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₁)
            (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₂)
  | piBotNil =>
      cases h with
      | pi h₁ h₂ _ hdom hcod _ _ =>
          exact .pi (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₁)
            (whRedPiKClosedCtxMaj_of_whRedPiKClosedCtx h₂) hdom hcod

/-- Conservative embedding of `LRProbeNoPiCore` into `LRProbeNoPiMajCore` on `ProbeCpt`
    (`lrProbeNoPiMajCore_of_lrProbeNoPiCore`). -/
theorem lrProbeNoPiMajCore_of_lrProbeNoPiCore {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat} {c : CptI} (hc : ProbeCpt c)
    (h : LRProbeNoPiCore E n Γ M M' A c) :
    LRProbeNoPiMajCore E n Γ M M' A c := by
  cases hc with
  | bot => trivial
  | sort =>
      exact ⟨h.1, lrProbeTypePiKClosedCtxMaj_of_lrTypeINPiKClosedCtx_probe .sort h.2⟩
  | piBotNil =>
      exact ⟨rfl, rfl, h.1,
        lrProbeTypePiKClosedCtxMaj_of_lrTypeINPiKClosedCtx_probe .piBotNil h.2⟩

/-- Every `LRTermNoPiSemBi` relation is a `LRTermNoPiMajSemBi` relation
    (`lrTermNoPiMajSemBi_of_lrTermNoPiSemBi`). -/
theorem lrTermNoPiMajSemBi_of_lrTermNoPiSemBi {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermNoPiMajSemBi E n Γ M M' A := by
  intro c hc hor
  rcases h c hc hor with hP | hC
  · exact Or.inl hP
  · exact Or.inr (lrProbeNoPiMajCore_of_lrProbeNoPiCore hc hC)

/-- Every `LRTermNoPiSemBi` relation is a `LRTermMajSemBi` relation
    (`lrTermMajSemBi_of_lrTermNoPiSemBi`). -/
theorem lrTermMajSemBi_of_lrTermNoPiSemBi {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermNoPiSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ M M' A :=
  lrTermMajSemBi_of_noPiMajSemBi (lrTermNoPiMajSemBi_of_lrTermNoPiSemBi h)

/-- Under `EnvWfT E`, every `LRTermDSubKClosedCtxSemBi` relation is a `LRTermMajSemBi` relation
    (`lrTermMajSemBi_of_lrTermDSubKClosedCtxSemBi`). -/
theorem lrTermMajSemBi_of_lrTermDSubKClosedCtxSemBi {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M M' A : Expr Nat}
    (h : LRTermDSubKClosedCtxSemBi E n Γ M M' A) :
    LRTermMajSemBi E n Γ M M' A :=
  lrTermMajSemBi_of_lrTermNoPiSemBi (lrTermNoPiSemBi_of_semBi hW h)

/-- Under `EnvWfT E`, `WhApproxAdequateAtSem` implies `WhApproxAdequateAtMaj`
    (`whApproxAdequateAtMaj_of_whApproxAdequateAtSem`). -/
theorem whApproxAdequateAtMaj_of_whApproxAdequateAtSem {E : ResolvedEnv} {n : Nat}
    (hW : EnvWfT E) {Γ : LCtx} {M A : Expr Nat}
    (h : WhApproxAdequateAtSem E n Γ M A) :
    WhApproxAdequateAtMaj E n Γ M A :=
  (lrTermMajSemBi_diag_iff E n Γ M A).mp
    (lrTermMajSemBi_of_lrTermDSubKClosedCtxSemBi hW
      ((lrTermDSubKClosedCtxSemBi_diag_iff E n Γ M A).mpr h))

/-- Unconditional relatedness of all assumption-variable spines in `LRTermMajSemBi`
    (`lrTermMajSemBi_foldApps_bvar_none`). -/
theorem lrTermMajSemBi_foldApps_bvar_none {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {i₁ i₂ : Nat} (hnone₁ : lookupValue Γ i₁ = none) (hnone₂ : lookupValue Γ i₂ = none)
    (xs₁ xs₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermMajSemBi E n Γ (foldApps (.bvar i₁) xs₁) (foldApps (.bvar i₂) xs₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi
    (lrTermNoPiMajSemBi_foldApps_bvar_none hnone₁ hnone₂ xs₁ xs₂ T)

/-- Unconditional relatedness of all rigid-constant spines in `LRTermMajSemBi`
    (`lrTermMajSemBi_foldApps_rigidConst`). -/
theorem lrTermMajSemBi_foldApps_rigidConst {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {r₁ r₂ : Nat} {ls₁ ls₂ : List Level}
    (hrig₁ : RigidConst E r₁) (hrig₂ : RigidConst E r₂)
    (args₁ args₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermMajSemBi E n Γ (foldApps (.const r₁ ls₁) args₁) (foldApps (.const r₂ ls₂) args₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi
    (lrTermNoPiMajSemBi_foldApps_rigidConst hrig₁ hrig₂ args₁ args₂ T)

/-- Unconditional relatedness of all under-applied recursor prefixes in `LRTermMajSemBi`
    (`lrTermMajSemBi_recursor_prefix`). -/
theorem lrTermMajSemBi_recursor_prefix {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {xs₁ xs₂ : List (Expr Nat)}
    (h₁ : xs₁.length ≤ w₁.preMajor.length)
    (h₂ : xs₂.length ≤ w₂.preMajor.length)
    (T : Expr Nat) :
    LRTermMajSemBi E n Γ
      (foldApps (.const w₁.recRef ls₁) xs₁)
      (foldApps (.const w₂.recRef ls₂) xs₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi (lrTermNoPiMajSemBi_recursor_prefix w₁ w₂ ls₁ ls₂ h₁ h₂ T)

/-- Unconditional relatedness of all non-K recursor spines at non-`ctorTagCpt` majors in
    `LRTermMajSemBi` (`lrTermMajSemBi_recursor_nonK_no_ctorTag`). -/
theorem lrTermMajSemBi_recursor_nonK_no_ctorTag {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    (w₁ w₂ : IotaWitnessS E) (ls₁ ls₂ : List Level)
    {pre₁ pre₂ : List (Expr Nat)}
    (hpre₁ : pre₁.length = w₁.preMajor.length)
    (hpre₂ : pre₂.length = w₂.preMajor.length)
    {x₁ x₂ : Expr Nat} (rest₁ rest₂ : List (Expr Nat))
    (hnotK₁ : ¬ (piBody w₁.famMember.mtype = .sort .zero ∧ w₁.nMinors = 1))
    (hnotK₂ : ¬ (piBody w₂.famMember.mtype = .sort .zero ∧ w₂.nMinors = 1))
    (hnoCtor₁ : ∀ (w' : IotaWitnessS E), w'.recRef = w₁.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₁ (ctorTagCpt w'))
    (hnoCtor₂ : ∀ (w' : IotaWitnessS E), w'.recRef = w₂.recRef →
      ¬ ApproxDIK E (ctxEnvDIK E Γ) x₂ (ctorTagCpt w'))
    (T : Expr Nat) :
    LRTermMajSemBi E n Γ
      (foldApps (recCall (.const w₁.recRef ls₁) pre₁ x₁) rest₁)
      (foldApps (recCall (.const w₂.recRef ls₂) pre₂ x₂) rest₂) T :=
  lrTermMajSemBi_of_noPiMajSemBi
    (lrTermNoPiMajSemBi_recursor_nonK_no_ctorTag w₁ w₂ ls₁ ls₂
      hpre₁ hpre₂ rest₁ rest₂ hnotK₁ hnotK₂ hnoCtor₁ hnoCtor₂ T)

/-- Unconditional application congruence in `LRTermMajSemBi` for non-`.lam` heads
    (`lrTermMajSemBi_app_of_no_lam`). -/
theorem lrTermMajSemBi_app_of_no_lam {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {f₁ f₂ : Expr Nat}
    (hf₁ : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) f₁ (.lam g))
    (hf₂ : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) f₂ (.lam g))
    (a₁ a₂ T : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) T :=
  lrTermMajSemBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_app_probeCpt_eq_bot_of_no_lam hf₁ hc h)
    (fun _ hc h => approxDIK_app_probeCpt_eq_bot_of_no_lam hf₂ hc h)

/-- Multi-argument spine generalization of `lrTermMajSemBi_app_of_no_lam`
    (`lrTermMajSemBi_foldApps_of_no_lam`). -/
theorem lrTermMajSemBi_foldApps_of_no_lam {E : ResolvedEnv} {n : Nat}
    {Γ : LCtx} {hd₁ hd₂ : Expr Nat}
    (hhd₁ : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) hd₁ (.lam g))
    (hhd₂ : ∀ g, ¬ ApproxDIK E (ctxEnvDIK E Γ) hd₂ (.lam g))
    (a₁ a₂ : Expr Nat) (args₁ args₂ : List (Expr Nat)) (T : Expr Nat) :
    LRTermMajSemBi E n Γ (foldApps hd₁ (a₁ :: args₁)) (foldApps hd₂ (a₂ :: args₂)) T :=
  lrTermMajSemBi_of_probeCpt_eq_bot T
    (fun _ hc h => approxDIK_foldApps_probeCpt_eq_bot_of_no_lam hhd₁ a₁ args₁ hc h)
    (fun _ hc h => approxDIK_foldApps_probeCpt_eq_bot_of_no_lam hhd₂ a₂ args₂ hc h)

/-- **Unconditional 1-Line 0-Instantiation Congruence at Any $\Pi$-Type `B = .pi D C` in
    `LRTermMajSemBi` (`lrTermMajSemBi_subst0_of_pi_type`):**
    Because `instantiate0 v₁ (.pi D C)` is syntactically a $\Pi$-type, `LRTermMajSemBi` holds
    for **every** `v₁, v₂, b, D, C` with **zero** hypotheses! -/
theorem lrTermMajSemBi_subst0_of_pi_type {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (v₁ v₂ b D C : Expr Nat) :
    LRTermMajSemBi E n Γ (instantiate0 v₁ b) (instantiate0 v₂ b) (instantiate0 v₁ (.pi D C)) :=
  lrTermMajSemBi_of_pi_type Γ (instantiate0 v₁ b) (instantiate0 v₂ b)
    (instantiate0 v₁ D) (instantiate 1 (lift 0 1 v₁) C)

/-- **Unconditional 1-Line Application Congruence for Any $\Pi$-Codomain Function in
    `LRTermMajSemBi` (`lrTermMajSemBi_app_of_pi_codomain`):**
    Whenever the codomain `B` of a function type `.pi A B` is a $\Pi$-type `.pi D C` (for example,
    every curried multi-argument function `f : Π (x : A) (y : D), C`), `.app f₁ a₁` and `.app f₂ a₂`
    are unconditionally related in `LRTermMajSemBi` at `instantiate0 a₁ (.pi D C)` with **zero**
    hypotheses on `f₁, f₂, a₁, a₂, D, C`! -/
theorem lrTermMajSemBi_app_of_pi_codomain {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (f₁ f₂ a₁ a₂ D C : Expr Nat) :
    LRTermMajSemBi E n Γ (.app f₁ a₁) (.app f₂ a₂) (instantiate0 a₁ (.pi D C)) :=
  lrTermMajSemBi_of_pi_type Γ (.app f₁ a₁) (.app f₂ a₂)
    (instantiate0 a₁ D) (instantiate 1 (lift 0 1 a₁) C)

/-- **Unconditional 1-Line `letE` Congruence at Any $\Pi$-Type `B = .pi D C` in `LRTermMajSemBi`
    (`lrTermMajSemBi_letE_of_pi_type`):** -/
theorem lrTermMajSemBi_letE_of_pi_type {E : ResolvedEnv} {n : Nat}
    (Γ : LCtx) (A₁ A₂ v₁ v₂ b₁ b₂ D C : Expr Nat) :
    LRTermMajSemBi E n Γ (.letE A₁ v₁ b₁) (.letE A₂ v₂ b₂) (instantiate0 v₁ (.pi D C)) :=
  lrTermMajSemBi_of_pi_type Γ (.letE A₁ v₁ b₁) (.letE A₂ v₂ b₂)
    (instantiate0 v₁ D) (instantiate 1 (lift 0 1 v₁) C)

/-! ### §26.2. `PrunedSemEqDIK` Invariance of `WhRedPiKClosedCtxMaj` / `ctorTagCpt` Guards and
Extracting `PrunedSemEqDIK` & Right-Hand Weak-Head Reductions from `LRTermMajSemBi` -/

/-- Every `ctorTagCpt w` is a `PrunedPiCpt` (`prunedPiCpt_ctorTagCpt`). -/
theorem prunedPiCpt_ctorTagCpt {E : ResolvedEnv} (w : IotaWitnessS E) :
    PrunedPiCpt (ctorTagCpt w) := by
  unfold ctorTagCpt
  rw [prunedPiCpt_spine_iff, prunePiList_append,
    prunePiList_replicate_bot, prunePiList_replicate_bot]

/-- Invariance of the `WhStepPiKClosedCtxMaj.iotaKClosedCtx` / `recMajor` guard
    `ApproxDIK E ρ x (ctorTagCpt w)` under `PrunedSemEqDIK E ρ`
    (`iotaKClosedCtxMaj_guard_iff_of_prunedSemEqDIK`). -/
theorem iotaKClosedCtxMaj_guard_iff_of_prunedSemEqDIK {E : ResolvedEnv} {ρ : EnvI}
    (w : IotaWitnessS E) {x₁ x₂ : Expr Nat}
    (hx : PrunedSemEqDIK E ρ x₁ x₂) :
    ApproxDIK E ρ x₁ (ctorTagCpt w) ↔ ApproxDIK E ρ x₂ (ctorTagCpt w) :=
  hx (ctorTagCpt w) (prunedPiCpt_ctorTagCpt w)

/-- Invariance of `ApproxDIK E (ctxEnvDIK E (.letBinding A v :: Γ)) x (ctorTagCpt w)` across
    `PrunedSemEqDIK`-equal let-values `v₁, v₂`
    (`iotaKClosedCtxMaj_letBinding_guard_iff_of_prunedSemEqDIK`). -/
theorem iotaKClosedCtxMaj_letBinding_guard_iff_of_prunedSemEqDIK {E : ResolvedEnv} {Γ : LCtx}
    (w : IotaWitnessS E) (A₁ A₂ : Expr Nat) {v₁ v₂ : Expr Nat}
    (hv : PrunedSemEqDIK E (ctxEnvDIK E Γ) v₁ v₂) (x : Expr Nat) :
    ApproxDIK E (ctxEnvDIK E (.letBinding A₁ v₁ :: Γ)) x (ctorTagCpt w) ↔
      ApproxDIK E (ctxEnvDIK E (.letBinding A₂ v₂ :: Γ)) x (ctorTagCpt w) :=
  approxDIK_ctxEnvDIK_letBinding_iff_of_prunedSemEqDIK A₁ A₂ hv x (prunedPiCpt_ctorTagCpt w)

/-- Every `WhStepPiKClosedCtxMaj` step preserves `PrunedSemEqDIK E (ctxEnvDIK E Γ)` under `EnvWfT E`
    (`prunedSemEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj`). -/
theorem prunedSemEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat}
    (hs : WhStepPiKClosedCtxMaj E Γ a b) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) a b :=
  prunedSemEqDIK_of_semEqDIK (semEqDIK_ctxEnvDIK_whStepPiKClosedCtxMaj hW hs)

/-- Every `WhRedPiKClosedCtxMaj` reduction preserves `PrunedSemEqDIK E (ctxEnvDIK E Γ)` under
    `EnvWfT E` (`prunedSemEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj`). -/
theorem prunedSemEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj {E : ResolvedEnv} (hW : EnvWfT E)
    {Γ : LCtx} {a b : Expr Nat}
    (hr : WhRedPiKClosedCtxMaj E Γ a b) :
    PrunedSemEqDIK E (ctxEnvDIK E Γ) a b :=
  prunedSemEqDIK_of_semEqDIK (semEqDIK_ctxEnvDIK_whRedPiKClosedCtxMaj hW hr)

/-- **Exact 3-Way Decomposition of `PrunedPiCpt` (`prunedPiCpt_iff_probeCpt_or_spine_or_lam`):**
    Every `PrunedPiCpt c` is either a `ProbeCpt` (`c ∈ {.bot, .sort, .pi .bot []}`), a pruned
    `.spine r args`, or a pruned `.lam g`. -/
theorem prunedPiCpt_iff_probeCpt_or_spine_or_lam {c : CptI} (hc : PrunedPiCpt c) :
    ProbeCpt c ∨ (∃ r args, c = .spine r args) ∨ (∃ g, c = .lam g) := by
  cases c with
  | bot => exact Or.inl .bot
  | sort => exact Or.inl .sort
  | pi a f =>
      obtain ⟨rfl, rfl⟩ := prunedPiCpt_pi_inv hc
      exact Or.inl .piBotNil
  | spine r args => exact Or.inr (Or.inl ⟨r, args, rfl⟩)
  | lam g => exact Or.inr (Or.inr ⟨g, rfl⟩)

/-- **Exact `ProbeCpt` Denotation Agreement from `LRTermMajSemBi`
    (`approxDIK_probeCpt_iff_of_lrTermMajSemBi`):**
    At any type `A` with `¬ IsSemPropTyI E n Γ A` and `¬ ApproxDIK E (ctxEnvDIK E Γ) A (.pi .bot [])`,
    `LRTermMajSemBi E n Γ M N A` implies that `M` and `N` have identical `ProbeCpt` approximations
    in `ApproxDIK E (ctxEnvDIK E Γ)`! -/
theorem approxDIK_probeCpt_iff_of_lrTermMajSemBi {E : ResolvedEnv} {n : Nat}
