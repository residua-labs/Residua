/- DT-024 (02 §14: "declarative rules mention no machine fuel or artifact"),
mechanized REFLECTIVELY: enumerate the judgment constructors and refuse any
whose field types mention the machine-artifact type (fuel/verdict shape). -/
open Elab Command in
run_cmd do
  let env ← getEnv
  let artifact : Name := `Rcic.Declarative.MachineArtifact
  for ind in [`Rcic.Declarative.HasTy, `Rcic.Declarative.Step, `Rcic.Declarative.Conv] do
    match env.find? ind with
    | some (.inductInfo info) =>
      for ctorName in info.ctors do
        match env.find? ctorName with
        | some (.ctorInfo ctor) =>
          let used : Array Name := ctor.type.getUsedConstants
          let bad := used.any fun n =>
            (n.toString.splitOn "MachineArtifact").length > 1 || (n.toString.splitOn "Fuel").length > 1
          if bad then
            throwError "[rcic_kernel_seal] DT-024: {ctorName} mentions a machine artifact"
        | _ => pure ()
    | _ => throwError "[rcic_kernel_seal] DT-024: {ind} not found"
  logInfo "[rcic_kernel_seal] DT-024 reflective check: no judgment constructor mentions a machine artifact"

/- DT-024 typed face (extended to the whole typed-root judgment
surface): the same reflective check applied to EVERY typed judgment
family the typed rows use — `HasTyT`, `ConvT`, `TyConvT`, `CtxWfT`,
`EnvWfT`, `GroupMembersT`, `IndGroupAdmitted`, `ParRedT`,
`ParRedArgsT`, `ParRedCtxT`, `ParRedTStar`, `PEqT`, `CtxConvT`,
`TyLookT`, `ValLookT`, the `ParRedTInv*` inversion families,
`DerivedIota`, `DerivedIotaU`, `LiteralExpansion`,
`EliminationSelection`. ADDITIVE — the legacy guard above is
unchanged. DELIBERATELY EXCLUDED: the witness/admission bundles
`IotaWitness`, `IotaWitnessS`, `RecursorGroupIdxAdmittedT` — their
field types legitimately carry the fuel-bounded checker surface
(`recIdxSrcFuelWalk`, `fieldShapesFuel`, `fuelAt`); they are the
artifact boundary the judgments abstract over, not judgment rows.
The negative test requires the mock `mockDT024T_artifactJudgment.step`
to be flagged by `ctorMentionsMachineArtifact`. -/
open Elab Command in
run_cmd do
  let env ← getEnv
  for ind in [`Rcic.Declarative.HasTyT, `Rcic.Declarative.ConvT,
      `Rcic.Declarative.TyConvT, `Rcic.Declarative.CtxWfT,
      `Rcic.Declarative.EnvWfT, `Rcic.Declarative.GroupMembersT,
      `Rcic.Declarative.IndGroupAdmitted,
      `Rcic.Declarative.ParRedT, `Rcic.Declarative.ParRedArgsT,
      `Rcic.Declarative.ParRedCtxT, `Rcic.Declarative.ParRedTStar,
      `Rcic.Declarative.PEqT,
      `Rcic.Declarative.CtxConvT, `Rcic.Declarative.TyLookT,
      `Rcic.Declarative.ValLookT,
      `Rcic.Declarative.ParRedTInvSort, `Rcic.Declarative.ParRedTInvPi,
      `Rcic.Declarative.ParRedTInvLam, `Rcic.Declarative.ParRedTInvConst,
      `Rcic.Declarative.DerivedIota, `Rcic.Declarative.DerivedIotaU,
      `Rcic.Declarative.LiteralExpansion,
      `Rcic.Declarative.EliminationSelection,
      `Rcic.Declarative.HeadStepT,
      `Rcic.Declarative.HeadStepTInvApp] do
    match env.find? ind with
    | some (.inductInfo info) =>
      for ctorName in info.ctors do
        if ctorMentionsMachineArtifact env ctorName then
          throwError "[rcic_kernel_seal] DT-024T: {ctorName} mentions a machine artifact"
    | _ => throwError "[rcic_kernel_seal] DT-024T: {ind} not found"
  let mock := `Rcic.FoundationSeal.mockDT024T_artifactJudgment.step
  unless ctorMentionsMachineArtifact env mock do
    throwError "[rcic_kernel_seal] DT-024T negative test failed: \
      {mock} was not flagged"
  logInfo "[rcic_kernel_seal] DT-024T reflective check: no typed judgment constructor mentions a machine artifact"

/- EG-017 (ruling on #6538): every `EnvWfT` constructor that adds an
entry carries that entry's admission judgment — `HasTyT` definition
typing for the singleton members (`axiom`/`definition`/`thm`/`opaque`),
`GroupMembersT` for the inductive group (which internally carries
`IndGroupAdmitted`/`IdxAdmittedT`/`IndGroupTypedT` per member). The
constructor list is pinned exactly — a future constructor without its
premise fails the seal build, as does any renamed or extra constructor
until this guard is consciously updated. The two fabricated-env
refutation pins (`not_envWfT_fabricatedAx99Env`,
`not_envWfT_vecOnlyEnvU`, sealed above) are the semantic teeth; this
guard is the structural tooth. The negative test requires the
premise-less mock `mockEG017_rogueEnv.rogue` to be flagged. -/
open Elab Command in
run_cmd do
  let env ← getEnv
  match env.find? `Rcic.Declarative.EnvWfT with
  | some (.inductInfo info) =>
    let expected :=
      [`Rcic.Declarative.EnvWfT.empty, `Rcic.Declarative.EnvWfT.axiom,
        `Rcic.Declarative.EnvWfT.definition, `Rcic.Declarative.EnvWfT.thm,
        `Rcic.Declarative.EnvWfT.opaque, `Rcic.Declarative.EnvWfT.group]
    let missing := expected.filter fun c => !(info.ctors.any (· == c))
    let extra := info.ctors.filter fun c => !(expected.any (· == c))
    unless missing.isEmpty && extra.isEmpty do
      throwError "[rcic_kernel_seal] EG-017: EnvWfT's constructor \
        list changed (missing {missing}, extra {extra})"
    for ctorName in info.ctors do
      if ctorSkipsEnvAdmission env ctorName then
        throwError "[rcic_kernel_seal] EG-017: {ctorName} extends \
          the env without an admission premise"
  | _ => throwError "[rcic_kernel_seal] EG-017: EnvWfT not found"
  let mock := `Rcic.FoundationSeal.mockEG017_rogueEnv.rogue
  unless ctorSkipsEnvAdmission env mock do
    throwError "[rcic_kernel_seal] EG-017 negative test failed: \
      {mock} was not flagged"
  logInfo "[rcic_kernel_seal] EG-017 reflective check: every entry-adding EnvWfT constructor carries its admission premise"

open Elab Command in
run_cmd do
  let env ← getEnv
  for t in sealedTheorems do
    let (_, s) := ((CollectAxioms.collect t).run env).run {}
    for ax in s.axioms do
      unless allowedAxioms.contains ax do
        throwError "[rcic_kernel_seal] {t} depends on non-allowlisted axiom {ax}"
  logInfo m!"[rcic_kernel_seal] {sealedTheorems.length} theorems sealed; axioms ⊆ {allowedAxioms}"

