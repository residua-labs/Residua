/-! ## Reflective structural guards — shared predicates and mocks

Two guards run below. **DT-024T** (extended): every typed-root
judgment family's constructors mention no machine-artifact constant.
**EG-017** (ruling on #6538): every `EnvWfT` constructor that adds an
entry carries that entry's admission premise, and the constructor
list is exactly the admitted six — a future constructor without its
premise fails the seal build. Each guard's negative test requires its
deliberately bad mock to be flagged by the shared predicate — the
mocks are sealed names, so the teeth are load-bearing. -/

/-- a fabricated machine-artifact type for the DT-024T negative
    test. -/
inductive mockMachineArtifactT : Type where
  | mk

/-- DT-024T negative-test mock: a judgment-shaped inductive whose
    constructor's field type mentions the artifact type — the guard
    must flag it. -/
inductive mockDT024T_artifactJudgment : Type where
  | step (h : mockMachineArtifactT) : mockDT024T_artifactJudgment

/-- EG-017 negative-test mock: an `EnvWfT`-shaped inductive whose
    entry-adding constructor carries no admission premise (no
    `HasTyT` typing, no `GroupMembersT` chain). -/
inductive mockEG017_rogueEnv : Rcic.Declarative.ResolvedEnv → Type where
  | empty : mockEG017_rogueEnv Rcic.Declarative.emptyEnv
  | rogue (E : Rcic.Declarative.ResolvedEnv) (r : Nat)
      (A : Rcic.Declarative.Expr Nat) (hE : mockEG017_rogueEnv E) :
      mockEG017_rogueEnv
        (Rcic.Declarative.extendEnv E r
          ⟨Rcic.Declarative.MemberClass.axiomM, 0, A, none⟩)

/-- whether a constructor's type mentions a machine-artifact constant
    — the DT-024 name-substring check, shared by the guard and its
    negative test. -/
def ctorMentionsMachineArtifact (env : Environment) (ctorName : Name) :
    Bool :=
  match env.find? ctorName with
  | some (.ctorInfo ctor) =>
      ctor.type.getUsedConstants.any fun n =>
        (n.toString.splitOn "MachineArtifact").length > 1 ||
        (n.toString.splitOn "Fuel").length > 1
  | _ => false

/-- whether a constructor extends the environment (`extendEnv` in its
    type) without carrying an entry-admission premise — `HasTyT`
    definition typing for the singleton members, `GroupMembersT`
    (which internally carries `IndGroupAdmitted`/`IdxAdmittedT`/
    `IndGroupTypedT`) for the group. EG-017's per-constructor tooth. -/
def ctorSkipsEnvAdmission (env : Environment) (ctorName : Name) : Bool :=
  match env.find? ctorName with
  | some (.ctorInfo ctor) =>
      let used := ctor.type.getUsedConstants
      used.contains `Rcic.Declarative.extendEnv &&
        !(used.contains `Rcic.Declarative.HasTyT ||
          used.contains `Rcic.Declarative.GroupMembersT)
  | _ => false

