/-! `RcicTmEqNoGo` — the `TmEq`-closure no-go (cc ruling on #6293, 03:40Z,
adversarial check #9, "cheapest test"; r1b).

T3″'s K-neutral disjunct needs the **fire case**: after the guarded ι★K
step, `M a refl` must relate to `M b q` by a NON-`⊥` witness — endpoint
evidence for `a ≡ b`. This file closes exactly the recursor-lemma
hypotheses (`a == a' | w_a`, `b == b' | w_b`, the motive and minor
clauses, `Conv a b`, `rec ~> m`) under the LogRel closure rules
(`bot / symm / trans / conv / mono / join / whr`) and shows the crossing
is unreachable: **no non-`⊥` witness relates an a-side term to a b-side
term** (`tmEq_cross_bot`, instantiated at the fire pair by
`fire_pair_bot`).

The load-bearing choices:

* `Conv a b` enters the closure only as the `⊥`-witnessed pair
  `hypConv`. In the T3″ model proofs denote `⊥`, so the ambient typing
  hypothesis `Δ ⊢ a ≡ b` supplies no endpoint evidence — that is exactly
  what the paper's `Id` `ref w` clause carries and irrelevance erases.
* `Cnv` (the conversion the `conv` rule closes under) is only the
  definitional equivalence generated by the fire step; `Δ ⊢ a ≡ b` is
  not a definitional conversion and is deliberately not a `Cnv` base.
  Feeding it in would be a conversion-closure rule of FL strength — the
  very thing whose availability is in question.

`closure_claim` stays 0. -/

namespace Rcic

/-- Atoms of the closure. `a a'` are the endpoint's two sides; `b b' q`
the major's side (`q : Eq α a b`); `m m'` the minor; `MA = M a refl`,
`MA'`, `MB = M b q` the motive instances (the fire pair); `r` the mixed
K-redex `rec α a M m b q`; `n` a neutral term. -/
inductive Tm where
  | a | a' | b | b' | m | m' | r | q | MA | MA' | MB | n
  deriving DecidableEq

/-- The a-cluster: terms built from a-endpoint data, plus the mixed
redex `r` (it mentions both endpoints). The b-cluster is its
complement's pure part. -/
def Tm.inS : Tm → Prop
  | .a | .a' | .m | .m' | .MA | .MA' | .r => True
  | _ => False

/-- Pure a-side terms. -/
def Tm.aSide (x : Tm) : Prop := x.inS ∧ x ≠ .r

/-- Pure b-side terms. -/
def Tm.bSide : Tm → Prop
  | .b | .b' | .q | .MB => True
  | _ => False

/-- Witness codes; `wt` fuses trans legs. -/
inductive W where
  | bot | wa | wb | wM | wm | wj | wt : W → W → W
  deriving DecidableEq

/-- `⊥`-absorbing fusion for `trans`. -/
def W.join : W → W → W
  | .bot, _ => .bot
  | _, .bot => .bot
  | u, v => .wt u v

/-- `w ⊑ v`: `w` is at most as defined as `v` (downward `mono`). -/
def W.le (w v : W) : Prop := w = v ∨ w = .bot

/-- Weak head reduction: the guarded fire step `rec … b q ~> m`. -/
inductive Whr : Tm → Tm → Prop where
  | fire : Whr .r .m

/-- Its reflexive-transitive closure (for `join`). -/
inductive WhrS : Tm → Tm → Prop where
  | refl (x : Tm) : WhrS x x
  | step {x y z : Tm} : Whr x y → WhrS y z → WhrS x z

/-- Definitional conversion inside the closure: the equivalence
generated by the fire step. No `a ≡ b` generator — see the header. -/
inductive Cnv : Tm → Tm → Prop where
  | ofWhr {x y : Tm} : Whr x y → Cnv x y
  | refl (x : Tm) : Cnv x x
  | symm {x y : Tm} : Cnv x y → Cnv y x
  | trans {x y z : Tm} : Cnv x y → Cnv y z → Cnv x z

/-- `TmEq`: the inductive closure of the recursor-lemma hypotheses under
the LogRel rules. Every generator is cluster-local or `⊥`-witnessed. -/
inductive TmEq : Tm → Tm → W → Prop where
  | hypA : TmEq .a .a' .wa
  | hypB : TmEq .b .b' .wb
  | hypMot : TmEq .MA .MA' .wM
  | hypMin : TmEq .m .m' .wm
  | hypConv : TmEq .a .b .bot
  | bot (x y : Tm) : TmEq x y .bot
  | symm {x y : Tm} {w : W} : TmEq x y w → TmEq y x w
  | trans {x y z : Tm} {u v : W} :
      TmEq x y u → TmEq y z v → TmEq x z (u.join v)
  | convL {x x' y : Tm} {w : W} : Cnv x x' → TmEq x' y w → TmEq x y w
  | convR {x y y' : Tm} {w : W} : TmEq x y' w → Cnv y y' → TmEq x y w
  | mono {x y : Tm} {w v : W} : W.le w v → TmEq x y v → TmEq x y w
  | join {x y c : Tm} : WhrS x c → WhrS y c → TmEq x y .wj
  | whrL {x x' y : Tm} {w : W} : Whr x x' → TmEq x' y w → TmEq x y w
  | whrR {x y y' : Tm} {w : W} : TmEq x y' w → Whr y y' → TmEq x y w

/-- The fire step keeps `inS` (`r` and `m` are both in the a-cluster). -/
theorem whr_inS {x y : Tm} (h : Whr x y) : x.inS ↔ y.inS := by
  cases h; exact Iff.rfl

theorem whrS_inS {x y : Tm} (h : WhrS x y) : x.inS ↔ y.inS := by
  induction h with
  | refl => exact Iff.rfl
  | step h _ ih => exact (whr_inS h).trans ih

theorem cnv_inS {x y : Tm} (h : Cnv x y) : x.inS ↔ y.inS := by
  induction h with
  | ofWhr h => exact whr_inS h
  | refl => exact Iff.rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem W.join_ne_bot {u v : W} (h : u.join v ≠ .bot) :
    u ≠ .bot ∧ v ≠ .bot := by
  cases u <;> cases v <;> simp_all [W.join]

theorem W.le_of_ne_bot {w v : W} (h : W.le w v) (hw : w ≠ .bot) : v ≠ .bot := by
  cases h with
  | inl he => exact he ▸ hw
  | inr he => exact absurd he hw

/-- The invariant: a non-`⊥` witness never crosses the cluster line.
Every rule preserves it — `join` because pure classes share no reduct,
`conv`/`whr` because `Cnv`/`Whr` preserve `inS`, `trans` because `join`
is `⊥`-absorbing, `mono` because `⊑` is downward. -/
theorem tmEq_inS {x y : Tm} {w : W} (h : TmEq x y w) (hw : w ≠ .bot) :
    x.inS ↔ y.inS := by
  revert hw
  induction h with
  | hypA => intro _; exact Iff.rfl
  | hypB => intro _; exact Iff.rfl
  | hypMot => intro _; exact Iff.rfl
  | hypMin => intro _; exact Iff.rfl
  | hypConv => intro hw; exact absurd rfl hw
  | bot _ _ => intro hw; exact absurd rfl hw
  | symm _ ih => intro hw; exact (ih hw).symm
  | trans _ _ ih₁ ih₂ =>
      intro hw
      exact (ih₁ (W.join_ne_bot hw).1).trans (ih₂ (W.join_ne_bot hw).2)
  | convL hc _ ih => intro hw; exact (cnv_inS hc).trans (ih hw)
  | convR _ hc ih => intro hw; exact (ih hw).trans (cnv_inS hc).symm
  | mono hle _ ih => intro hw; exact ih (W.le_of_ne_bot hle hw)
  | join hx hy => intro _; exact (whrS_inS hx).trans (whrS_inS hy).symm
  | whrL hh _ ih => intro hw; exact (whr_inS hh).trans (ih hw)
  | whrR _ hh ih => intro hw; exact (ih hw).trans (whr_inS hh).symm

theorem bSide_not_inS {y : Tm} : y.bSide → ¬ y.inS := by
  cases y <;> simp [Tm.bSide, Tm.inS]

/-- The no-go: no non-`⊥` witness relates an a-side term to a b-side
term. The fire case's `Mot a refl` vs `Mot b q` is unreachable — it
needs a conversion-closure rule as strong as FL. -/
theorem tmEq_cross_bot {x y : Tm} {w : W} (h : TmEq x y w)
    (hx : x.aSide) (hy : y.bSide) : w = .bot :=
  if he : w = .bot then he
  else absurd ((tmEq_inS h he).1 hx.1) (bSide_not_inS hy)

/-- The fire pair itself: `M a refl` vs `M b q` carries only `⊥`. -/
theorem fire_pair_bot {w : W} (h : TmEq .MA .MB w) : w = .bot :=
  tmEq_cross_bot h ⟨trivial, fun e => Tm.noConfusion e⟩ trivial

/-- Non-vacuous: the `⊥` cross-side witness does exist — the model's
proof-irrelevant one. -/
example : TmEq .MA .MB .bot := .bot _ _

#print axioms tmEq_inS
#print axioms tmEq_cross_bot
#print axioms fire_pair_bot

end Rcic
