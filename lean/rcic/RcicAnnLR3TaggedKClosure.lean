import rcic.RcicAnnLR3TaggedSaturatedTower
import rcic.RcicAnnLR3SaturatedCandidatePiBoundary
import rcic.RcicAnnLR3NeutralK

/-!
# Guarded code PER closure and its exact coherence obligation

The least code PER is generated by same-tag raw image agreement and
guarded forward K edges. The raw existential image El is not silently
asserted transitive. Decoded is its least PER closure, and its membership
theorem proves that this closure adds no new raw members.

Conditional coherence consumes actual bidirectional element-pair transport
for generators. Such transport is not supplied merely by naming an edge.
No converse from completed relatedness to the semantic guard is asserted.
Concrete source/frame producers and separating instances are separate.
closure_claim = 0.
-/
set_option autoImplicit false
namespace Rcic.Declarative.Ann.LR3.TaggedKClosure
open Rcic.Declarative
open Rcic.Declarative.NativeValleys.PiModelIdealAudit
open UnitModel TypedPER TypedStatements TaggedSaturatedTower
universe u v

structure Frame (k : Nat) where
  source : Value → Value → Prop
  left : Value
  right : Value
  major : Value
  call : Code.{u} k
  minor : Code.{u} k

def Guard {k : Nat} (f : Frame.{u} k) : Prop := f.source f.left f.right

def KEdge {k : Nat} (f : Frame.{u} k) (C D : Code.{u} k) : Prop :=
  C = f.call ∧ D = f.minor ∧ Guard f

theorem kEdge_endpoints_iff {k : Nat} (f : Frame.{u} k) (C D : Code.{u} k) :
    KEdge f C D ↔ C = f.call ∧ D = f.minor ∧ Guard f := Iff.rfl

theorem kEdge_iff {k : Nat} (f : Frame.{u} k) :
    KEdge f f.call f.minor ↔ Guard f :=
  ⟨fun h => h.2.2, fun h => ⟨rfl, rfl, h⟩⟩

def Base {k : Nat} (C D : Code.{u} k) : Prop :=
  C.tag = D.tag ∧ ValueEq C.view.value D.view.value

def Seed {k : Nat} (AtTarget : Frame.{u} k → Prop) (C D : Code.{u} k) : Prop :=
  Base C D ∨ ∃ f, AtTarget f ∧ KEdge f C D

def Related {k : Nat} (AtTarget : Frame.{u} k → Prop) (C D : Code.{u} k) : Prop :=
  NeutralK.Path (Seed AtTarget) C D

theorem seed_related {k : Nat} (AtTarget : Frame.{u} k → Prop)
    {C D : Code.{u} k} (h : Seed AtTarget C D) : Related AtTarget C D :=
  NeutralK.Path.forward h

theorem base_related {k : Nat} (AtTarget : Frame.{u} k → Prop)
    {C D : Code.{u} k} (h : Base C D) : Related AtTarget C D :=
  seed_related AtTarget (Or.inl h)

theorem k_related {k : Nat} (AtTarget : Frame.{u} k → Prop)
    (f : Frame.{u} k) (hf : AtTarget f) (hg : Guard f) :
    Related AtTarget f.call f.minor :=
  seed_related AtTarget (Or.inr ⟨f, hf, rfl, rfl, hg⟩)

theorem related_refl {k : Nat} (AtTarget : Frame.{u} k → Prop) (C : Code.{u} k) :
    Related AtTarget C C :=
  base_related AtTarget ⟨rfl, ValueEq.refl _⟩

theorem related_symm {k : Nat} {AtTarget : Frame.{u} k → Prop}
    {C D : Code.{u} k} (h : Related AtTarget C D) : Related AtTarget D C :=
  NeutralK.path_symm h

theorem related_trans {k : Nat} {AtTarget : Frame.{u} k → Prop}
    {C D E : Code.{u} k} (h : Related AtTarget C D) (h' : Related AtTarget D E) :
    Related AtTarget C E := NeutralK.path_trans h h'

theorem related_laws {k : Nat} (AtTarget : Frame.{u} k → Prop) :
    NeutralK.PERLaws (Related AtTarget) := NeutralK.path_laws (Seed AtTarget)

theorem related_carrier_laws {k : Nat} (AtTarget : Frame.{u} k → Prop) :
    NeutralDataFamily.RelLaws (Related AtTarget) :=
  ⟨related_symm, related_trans⟩

theorem related_least {k : Nat} {AtTarget : Frame.{u} k → Prop}
    {R : Code.{u} k → Code.{u} k → Prop} (hR : NeutralK.PERLaws R)
    (hinclude : ∀ {C D}, Seed AtTarget C D → R C D)
    {C D : Code.{u} k} (h : Related AtTarget C D) : R C D :=
  NeutralK.path_least hR hinclude h

/-- The exact existential raw image of the retained element PER. -/
def El {k : Nat} (C : Code.{u} k) (x y : Value) : Prop :=
  ∃ a b : C.Element, C.view.relation a b ∧
    ValueEq (C.erase a) x ∧ ValueEq (C.erase b) y

def Good {k : Nat} (C : Code.{u} k) (x : Value) : Prop :=
  ∃ a : C.Element, C.view.relation a a ∧ ValueEq (C.erase a) x

/-- A PER even when the existential raw image is not transitive. -/
def Decoded {k : Nat} (C : Code.{u} k) (x y : Value) : Prop :=
  NeutralK.Path (El C) x y

theorem el_good_left {k : Nat} {C : Code.{u} k} {x y : Value}
    (h : El C x y) : Good C x := by
  rcases h with ⟨a, b, hab, hax, hby⟩
  exact ⟨a, C.view.lawful.trans hab (C.view.lawful.symm hab), hax⟩

theorem el_good_right {k : Nat} {C : Code.{u} k} {x y : Value}
    (h : El C x y) : Good C y := by
  rcases h with ⟨a, b, hab, hax, hby⟩
  exact ⟨b, C.view.lawful.trans (C.view.lawful.symm hab) hab, hby⟩

theorem good_el {k : Nat} {C : Code.{u} k} {x : Value}
    (h : Good C x) : El C x x := by
  rcases h with ⟨a, haa, hax⟩
  exact ⟨a, a, haa, hax, hax⟩

theorem decoded_of_el {k : Nat} {C : Code.{u} k} {x y : Value}
    (h : El C x y) : Decoded C x y := NeutralK.Path.forward h

theorem decoded_good {k : Nat} {C : Code.{u} k} {x y : Value}
    (h : Decoded C x y) : Good C x ∧ Good C y := by
  induction h with
  | forward h => exact ⟨el_good_left h, el_good_right h⟩
  | backward h => exact ⟨el_good_right h, el_good_left h⟩
  | append _ _ ih ih' => exact ⟨ih.1, ih'.2⟩

theorem decoded_member_iff {k : Nat} (C : Code.{u} k) (x : Value) :
    Decoded C x x ↔ Good C x :=
  ⟨fun h => (decoded_good h).1, fun h => decoded_of_el (good_el h)⟩

theorem decoded_laws {k : Nat} (C : Code.{u} k) :
    NeutralK.PERLaws (Decoded C) := NeutralK.path_laws (El C)

theorem decoded_typed_laws {k : Nat} (C : Code.{u} k) :
    TypedPER.Laws (Decoded C) := NeutralK.path_typed_laws (El C)

theorem decoded_least {k : Nat} {C : Code.{u} k}
    {R : Value → Value → Prop} (hR : NeutralK.PERLaws R)
    (hinclude : ∀ {x y}, El C x y → R x y)
    {x y : Value} (h : Decoded C x y) : R x y :=
  NeutralK.path_least hR hinclude h

/-- Target witnesses and both actual erasure equations are retained. -/
def PairTransport {k : Nat} (C : Code.{u} k) (D : Code.{v} k) : Prop :=
  ∀ a b : C.Element, C.view.relation a b →
    ∃ c d : D.Element, D.view.relation c d ∧
      ValueEq (D.erase c) (C.erase a) ∧ ValueEq (D.erase d) (C.erase b)

theorem el_of_pairTransport {k : Nat} {C : Code.{u} k} {D : Code.{v} k}
    (h : PairTransport C D) {x y : Value} (hxy : El C x y) : El D x y := by
  rcases hxy with ⟨a, b, hab, hax, hby⟩
  rcases h a b hab with ⟨c, d, hcd, hca, hdb⟩
  exact ⟨c, d, hcd, hca.trans hax, hdb.trans hby⟩

theorem decoded_of_pairTransport {k : Nat} {C : Code.{u} k} {D : Code.{v} k}
    (h : PairTransport C D) {x y : Value} (hxy : Decoded C x y) : Decoded D x y :=
  NeutralK.path_mono (fun h' => el_of_pairTransport h h') hxy

theorem same_of_pairTransport {k : Nat} {C : Code.{u} k} {D : Code.{v} k}
    (h : PairTransport C D) (h' : PairTransport D C) :
    NeutralK.Same (El C) (El D) := by
  intro x y
  exact ⟨el_of_pairTransport h, el_of_pairTransport h'⟩

theorem decoded_same_of_pairTransport {k : Nat} {C : Code.{u} k} {D : Code.{v} k}
    (h : PairTransport C D) (h' : PairTransport D C) :
    NeutralK.Same (Decoded C) (Decoded D) :=
  NeutralK.path_same (same_of_pairTransport h h')

theorem pairTransport_of_kernelIso {k : Nat} {C : Code.{u} k} {D : Code.{v} k}
    (e : KernelIso C.kernel D.kernel) : PairTransport C D := by
  intro a b hab
  exact ⟨e.forward a, e.forward b, (e.relation a b).mp hab,
    e.element_image a, e.element_image b⟩

theorem codeRelated_decoded_same {k : Nat} {C D : Code.{u} k}
    (h : TaggedSaturatedTower.CodeRelated C D) :
    NeutralK.Same (Decoded C) (Decoded D) := by
  rcases h.2 with ⟨e⟩
  exact decoded_same_of_pairTransport
    (pairTransport_of_kernelIso e) (pairTransport_of_kernelIso e.symm)

def Coherent {k : Nat} (AtTarget : Frame.{u} k → Prop) : Prop :=
  ∀ C D : Code.{u} k, Related AtTarget C D → NeutralK.Same (Decoded C) (Decoded D)

/-- This theorem does not manufacture transport from raw type equality. -/
theorem coherence_of_seed_transport {k : Nat} (AtTarget : Frame.{u} k → Prop)
    (hseed : ∀ C D : Code.{u} k, Seed AtTarget C D →
      PairTransport C D ∧ PairTransport D C) : Coherent AtTarget := by
  intro C D h
  induction h with
  | forward h =>
    rcases hseed _ _ h with ⟨hCD, hDC⟩
    exact decoded_same_of_pairTransport hCD hDC
  | backward h =>
    rcases hseed _ _ h with ⟨hDC, hCD⟩
    exact decoded_same_of_pairTransport hCD hDC
  | append _ _ ih ih' =>
    intro x y
    exact (ih x y).trans (ih' x y)

theorem coherence_of_generator_transport {k : Nat} (AtTarget : Frame.{u} k → Prop)
    (hbase : ∀ C D : Code.{u} k, Base C D → PairTransport C D ∧ PairTransport D C)
    (hk : ∀ f : Frame.{u} k, AtTarget f → Guard f →
      PairTransport f.call f.minor ∧ PairTransport f.minor f.call) : Coherent AtTarget := by
  apply coherence_of_seed_transport AtTarget
  intro C D h
  rcases h with hbaseCD | ⟨f, hf, he⟩
  · exact hbase C D hbaseCD
  · rcases he with ⟨rfl, rfl, hg⟩
    exact hk f hf hg

/-- A genuine Pi application law excludes a native point from membership. -/
theorem native_point_not_good {k : Nat} (P : Code.{u} k)
    (a : Value) (ha : a .bot) (j : Option Nat)
    (happ : ∀ f : P.Element, P.view.relation f f →
      SortMember j (NeutralPi.applyValue (P.erase f) a))
    (i : Option Nat) (name : Nat) :
    ¬ Good P (NativeMemberValues.value i name) := by
  rintro ⟨f, hff, hf⟩
  have hs := happ f hff
  have he := NeutralPi.applyValue_congr hf (ValueEq.refl a)
  exact SaturatedCandidatePiBoundary.native_typed_application_not_sort
    i j name a ha (sortMember_congr he hs)

theorem native_point_not_decoded {k : Nat} (P : Code.{u} k)
    (a : Value) (ha : a .bot) (j : Option Nat)
    (happ : ∀ f : P.Element, P.view.relation f f →
      SortMember j (NeutralPi.applyValue (P.erase f) a))
    (i : Option Nat) (name : Nat) :
    ¬ Decoded P (NativeMemberValues.value i name) (NativeMemberValues.value i name) := by
  intro h
  exact native_point_not_good P a ha j happ i name
    ((decoded_member_iff P _).mp h)

theorem no_decoded_same_at_native_point {k : Nat}
    (N : Code.{u} k) (P : Code.{v} k)
    (n : N.Element) (hn : N.view.relation n n)
    (i : Option Nat) (name : Nat)
    (en : ValueEq (N.erase n) (NativeMemberValues.value i name))
    (a : Value) (ha : a .bot) (j : Option Nat)
    (happ : ∀ f : P.Element, P.view.relation f f →
      SortMember j (NeutralPi.applyValue (P.erase f) a)) :
    ¬ NeutralK.Same (Decoded N) (Decoded P) := by
  intro hs
  have hN : Decoded N (NativeMemberValues.value i name) (NativeMemberValues.value i name) :=
    (decoded_member_iff N _).mpr ⟨n, hn, en⟩
  exact native_point_not_decoded P a ha j happ i name
    ((hs (NativeMemberValues.value i name) (NativeMemberValues.value i name)).mp hN)

end Rcic.Declarative.Ann.LR3.TaggedKClosure
