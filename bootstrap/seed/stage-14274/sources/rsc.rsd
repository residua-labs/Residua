def rtNil : RtNode := { tag := 5, val := 0, ty := 2, args := [] }

def rtAt : Nat → List RtNode → RtNode
  | _, [] => rtNil
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtAt n xs

def rtTypeAt : Nat → List Int → Int
  | _, [] => -1
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtTypeAt n xs

def rtPrimAt : Nat → List RtPrim → RtPrim
  | _, [] => { name := "", args := [], result := -1, opcode := [], memory := false }
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtPrimAt n xs

def rtPrimIndex : Nat → List RtPrim → String → Int
  | _, [], _ => -1
  | i, x :: xs, name => if x.name == name then (i : Int) else rtPrimIndex (i + 1) xs name

def rtSigAt : Nat → List RtSignature → RtSignature
  | _, [] => { name := "", params := [], result := -1 }
  | 0, x :: _ => x
  | n + 1, _ :: xs => rtSigAt n xs

def rtSigIndex : Nat → List RtSignature → String → Int
  | _, [], _ => -1
  | i, x :: xs, name => if x.name == name then (i : Int) else rtSigIndex (i + 1) xs name

-- Signed LEB is independent of a target backend. The wire carries scalar
-- values, type ids, and semantic node/primitive ids, never target code.
partial def rtLeb (value : Int) : List Int :=
  let byte := value % 128
  let rest := value / 128
  if (rest == 0 && byte < 64) || (rest == -1 && byte >= 64) then [byte]
  else (byte + 128) :: rtLeb rest

mutual
  def rtNodeWire : RtNode → List Int
    | ⟨tag, value, ty, args⟩ =>
      rtLeb tag ++ rtLeb value ++ rtLeb ty
      ++ rtLeb (args.length : Int) ++ rtNodesWire args
  def rtNodesWire : List RtNode → List Int
    | [] => []
    | node :: nodes => rtNodeWire node ++ rtNodesWire nodes
end

def rtIntsWire : List Int → List Int
  | [] => []
  | x :: xs => rtLeb x ++ rtIntsWire xs

def rtStringWire (name : String) : List Int :=
  let chars := name.toList
  rtLeb (chars.length : Int) ++ chars.map (fun c => (c.toNat : Int))

def rtFunctionWire (fn : RtFunction) : List Int :=
  rtStringWire fn.name ++ rtLeb (fn.params.length : Int) ++ rtIntsWire fn.params
  ++ rtLeb fn.result ++ rtLeb (fn.locals.length : Int) ++ rtIntsWire fn.locals
  ++ rtNodeWire fn.body

def rtFunctionsWire : List RtFunction → List Int
  | [] => []
  | fn :: rest => rtFunctionWire fn ++ rtFunctionsWire rest

def rtModuleWire (fns : List RtFunction) : List Int :=
  [82, 83, 67, 77, 127, 1] ++ rtLeb (fns.length : Int) ++ rtFunctionsWire fns

end RscSourceModule_706b87a10d32300e04c560c058b8a41b5346ec002080bcad0d97ab93f95ef8f4
section RscSourceModule_ef6530cd8980b22f67c5a0ff2445a8e222fc0ac690fcf1821e86febb76a210a3
structure RtDecoded where
  rest : List Int
  value : Int
  node : RtNode
  nodes : List RtNode
  ints : List Int
  functions : List RtFunction
  error : Nat

structure RtEmission where
  bytes : List Int
  error : Nat

def rtDecoded (bs : List Int) : RtDecoded :=
  { rest := bs, value := 0, node := rtNil, nodes := [], ints := [], functions := [], error := 0 }

def rtReadInt : Nat → Int → Int → RtDecoded → RtDecoded
  | 0, _, _, state => { state with error := 20 }
  | _ + 1, _, _, { rest := [], .. } => { (rtDecoded []) with error := 20 }
  | fuel + 1, value, place, state =>
    let byte := state.rest.headD (-1)
    if byte < 0 || byte > 255 then { state with error := 20 }
    else
      let low := byte % 128
      let value := value + low * place
      let s := { state with rest := state.rest.drop 1 }
      if byte >= 128 then rtReadInt fuel value (place * 128) s
      else { s with value := if low >= 64 then value - place * 128 else value }

def rtInteger (state : RtDecoded) : RtDecoded :=
  if state.error != 0 then state else rtReadInt 10 0 1 state

def rtReadInts : Nat → Nat → RtDecoded → List Int → RtDecoded
  | 0, _, state, _ => { state with error := 20 }
  | _ + 1, 0, state, acc => { state with ints := acc.reverse }
  | fuel + 1, count + 1, state, acc =>
    let s := rtInteger state
    rtReadInts fuel count s (s.value :: acc)

mutual
  def rtReadNode (fuel : Nat) (state : RtDecoded) : RtDecoded :=
    match fuel with
    | 0 => { state with error := 20 }
    | fuel + 1 =>
      let s := rtInteger state
      let tag := s.value
      let s := rtInteger s
      let value := s.value
      let s := rtInteger s
      let ty := s.value
      let s := rtInteger s
      if s.value < 0 || s.value > 200000 then { s with error := 20 }
      else
        let s := rtReadNodes fuel s.value.toNat s []
        { s with node := { tag := tag, val := value, ty := ty, args := s.nodes } }
  def rtReadNodes (fuel count : Nat) (state : RtDecoded) (acc : List RtNode) : RtDecoded :=
    match fuel, count with
    | 0, _ => { state with error := 20 }
    | _ + 1, 0 => { state with nodes := acc.reverse }
    | fuel + 1, count + 1 =>
      let s := rtReadNode fuel state
      rtReadNodes fuel count s (s.node :: acc)
end

def rtReadFunctions (fuel count : Nat) (state : RtDecoded) (acc : List RtFunction) : RtDecoded :=
  match fuel, count with
  | 0, _ => { state with error := 20 }
  | _ + 1, 0 => { state with functions := acc.reverse }
  | fuel + 1, count + 1 =>
    let s := rtInteger state
    if s.value < 0 || s.value > 256 then { s with error := 20 }
    else
      let name := String.mk ((s.rest.take s.value.toNat).map (fun x => Char.ofNat x.toNat))
      let s := { s with rest := s.rest.drop s.value.toNat }
      let s := rtInteger s
      if s.value < 0 || s.value > 64 then { s with error := 20 }
      else
        let s := rtReadInts 100 s.value.toNat s []
        let params := s.ints
        let s := rtInteger s
        let result := s.value
        let s := rtInteger s
        if s.value < 0 || s.value > 256 then { s with error := 20 }
        else
          let s := rtReadInts 300 s.value.toNat s []
          let locals := s.ints
          let s := rtReadNode 200000 s
          let fn : RtFunction := { name := name, params := params, result := result, locals := locals, body := s.node }
          rtReadFunctions fuel count s (fn :: acc)

def rtDecodeModule (bs : List Int) : RtDecoded :=
  if bs.take 6 != [82, 83, 67, 77, 127, 1] then { (rtDecoded bs) with error := 20 }
  else
    let s := rtInteger (rtDecoded (bs.drop 6))
    if s.value < 1 || s.value > 1000 then { s with error := 20 }
    else
      let s := rtReadFunctions 1100 s.value.toNat s []
      if !s.rest.isEmpty then { s with error := 20 } else s

def rtEmitOk (bytes : List Int) : RtEmission := { bytes := bytes, error := 0 }
def rtEmitError (error : Nat) : RtEmission := { bytes := [], error := error }
def rtEmitJoin (a b : RtEmission) : RtEmission :=
  if a.error != 0 then a else if b.error != 0 then b else rtEmitOk (a.bytes ++ b.bytes)

def rtWasmType (ty : Int) : Int := if ty == 0 then vtI64 else if ty == 1 || ty == 4 then vtI32 else 64

def rtInvert (bytes : List Int) : List Int :=
  -- Boolean negation is a single target instruction.  The comparison
  -- complement is an ordinary peephole, independent of object layout.
  match bytes.reverse with
  | op :: rest =>
    let inverse :=
      if op == 70 then 71 else if op == 71 then 70
      else if op == 81 then 82 else if op == 82 then 81
      else if op == 72 then 78 else if op == 78 then 72
      else if op == 73 then 79 else if op == 79 then 73
      else if op == 74 then 76 else if op == 76 then 74
      else if op == 75 then 77 else if op == 77 then 75
      else if op == 83 then 89 else if op == 89 then 83
      else if op == 84 then 90 else if op == 90 then 84
      else if op == 85 then 87 else if op == 87 then 85
      else if op == 86 then 88 else if op == 88 then 86 else -1
    if inverse >= 0 then rest.reverse ++ [inverse] else bytes ++ [69]
  | [] => [69]

-- Tail-position break exits by falling through the loop's end. A repeat
-- with a mandatory terminal break needs no enclosing block.  A continue
-- still targets the loop label; nested conditionals add their own labels.
mutual
  def rtTailExit (fuel : Nat) (node : RtNode) : Bool :=
    match fuel with
    | 0 => false
    | fuel + 1 =>
      if node.tag == 9 || node.tag == 10 || node.tag == 11 || node.tag == 12 then true
      else if node.tag == 5 then rtTailExit fuel (node.args.getLast?.getD rtNil)
      else if node.tag == 4 && node.args.length == 3 then
        rtTailExit fuel (rtAt 1 node.args) && rtTailExit fuel (rtAt 2 node.args)
      else false
  def rtBreakBeforeTail (fuel : Nat) (node : RtNode) (tail : Bool) : Bool :=
    match fuel with
    | 0 => true
    | fuel + 1 =>
      if node.tag == 9 then !tail
      else if node.tag == 7 || node.tag == 8 then false
      else if node.tag == 5 then rtBreaksList fuel node.args tail
      else if node.tag == 4 then
        rtBreakBeforeTail fuel (rtAt 1 node.args) tail || rtBreakBeforeTail fuel (rtAt 2 node.args) tail
      else false
  def rtBreaksList (fuel : Nat) (nodes : List RtNode) (tail : Bool) : Bool :=
    match fuel, nodes with
    | 0, _ => true
    | _ + 1, [] => false
    | fuel + 1, node :: nodes =>
      rtBreakBeforeTail fuel node (tail && nodes.isEmpty) || rtBreaksList fuel nodes tail
end

mutual
  def rtLowerNodeWithFold (fuel : Nat) (rc foldConfiguration : Bool) (types : List Int) (signatures : List RtSignature)
      (result : Int) (continueDepth breakDepth : Nat) (inLoop tail : Bool) (node : RtNode) : RtEmission :=
    match fuel with
    | 0 => rtEmitError 19
    | fuel + 1 =>
      if node.tag == 0 then
        if !node.args.isEmpty || (node.ty != 0 && node.ty != 1 && node.ty != 4) then rtEmitError 15
        else if node.ty == 0 then rtEmitOk (i64Const (if node.val % 18446744073709551616 >= 9223372036854775808 then node.val % 18446744073709551616 - 18446744073709551616 else node.val % 18446744073709551616))
        else rtEmitOk (i32Const (if node.val % 4294967296 >= 2147483648 then node.val % 4294967296 - 4294967296 else node.val % 4294967296))
      else if node.tag == 1 then
        if node.val < 0 || rtTypeAt node.val.toNat types != node.ty || !node.args.isEmpty then rtEmitError 15
        else rtEmitOk (lg node.val.toNat)
      else if node.tag == 13 then
        if node.ty != 4 || !node.args.isEmpty then rtEmitError 15
        else rtEmitOk (i32Const (if rc then 1 else 0))
      else if node.tag == 2 || node.tag == 3 then
        let prim := rtPrimAt node.val.toNat rtPrimitives
        let signature := rtSigAt node.val.toNat signatures
        let args := if node.tag == 2 then prim.args else signature.params
        let ty := if node.tag == 2 then prim.result else signature.result
        if node.val < 0 || ty < 0 || node.ty != ty || node.args.length != args.length then rtEmitError 15
        else if node.tag == 2 && prim.memory then
          let offset := rtAt 1 node.args
          if offset.tag != 0 || offset.ty != 0 || offset.val < 0 || offset.val > 4294967295 then rtEmitError 15
          else
            let nodes := [rtAt 0 node.args] ++ node.args.drop 2
            let types2 := [rtTypeAt 0 args] ++ args.drop 2
            let code := rtLowerArgsWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop nodes types2
            rtEmitJoin code (rtEmitOk (prim.opcode ++ lebS offset.val))
        else
          let code := rtLowerArgsWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop node.args args
          rtEmitJoin code (rtEmitOk (if node.tag == 2 then prim.opcode else callFn node.val.toNat))
      else if node.tag == 4 then
        let cond := rtAt 0 node.args
        let yes := rtAt 1 node.args
        let no := rtAt 2 node.args
        if node.args.length < 2 || node.args.length > 3 || cond.ty != 4 then rtEmitError 15
        else if foldConfiguration && cond.tag == 13 then
          rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop tail (if rc then yes else no)
        else
          let c := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop false cond
          if foldConfiguration && inLoop && tail && yes.tag == 10 && no.tag == 9 then
            rtEmitJoin c (rtEmitOk ([13] ++ lebU continueDepth))
          else if foldConfiguration && node.ty == 2 && yes.tag == 5 && yes.args.length == 1 && (rtAt 0 yes.args).tag == 9 && node.args.length == 2 then
            if !inLoop then rtEmitError 18 else rtEmitJoin c (rtEmitOk ([13] ++ lebU breakDepth))
          else
            let y := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result (continueDepth + 1) (breakDepth + 1) inLoop tail yes
            let n := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result (continueDepth + 1) (breakDepth + 1) inLoop tail no
            let beginCode := rtEmitJoin c (rtEmitOk [4, rtWasmType node.ty])
            let arms := rtEmitJoin y (if node.args.length == 3 then rtEmitJoin (rtEmitOk [5]) n else rtEmitOk [])
            rtEmitJoin (rtEmitJoin beginCode arms) (rtEmitOk [11])
      else if node.tag == 5 then
        rtLowerSequenceWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop tail node.args
      else if node.tag == 6 then
        let value := rtAt 0 node.args
        if node.args.length != 1 || node.val < 0 || !rtCompatible2 (rtTypeAt node.val.toNat types) value.ty then rtEmitError 15
        else rtEmitJoin (rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop false value) (rtEmitOk (ls node.val.toNat))
      else if node.tag == 7 then
        let cond := rtAt 0 node.args
        if node.args.length != 2 || cond.ty != 4 then rtEmitError 15
        else
          let hasBreak := rtBreakBeforeTail fuel (rtAt 1 node.args) false
          let c := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result 1 2 true false cond
          let body := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result 1 2 true false (rtAt 1 node.args)
          let beginCode := if hasBreak then [2, 64, 3, 64] else [3, 64]
          let endCode := if hasBreak then [12, 1, 11, 11, 11] else [12, 1, 11, 11]
          rtEmitJoin (rtEmitOk beginCode) (rtEmitJoin c (rtEmitJoin (rtEmitOk [4, 64]) (rtEmitJoin body (rtEmitOk endCode))))
      else if node.tag == 8 then
        let body := rtAt 0 node.args
        let flat := if node.args.length == 2 then !rtBreakBeforeTail fuel body false
          else rtTailExit fuel body && !rtBreakBeforeTail fuel body true
        let b := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result 0 1 true (flat && node.args.length == 1) body
        let beginCode := if flat then [3, 64] else [2, 64, 3, 64]
        if node.args.length == 2 then
          let cond := rtAt 1 node.args
          let c := rtLowerNodeWithFold fuel rc foldConfiguration types signatures result 0 1 true false cond
          if cond.ty != 4 then rtEmitError 15
          else rtEmitJoin (rtEmitOk beginCode) (rtEmitJoin b (rtEmitJoin { c with bytes := rtInvert c.bytes } (rtEmitOk (if flat then [13, 0, 11] else [13, 0, 11, 11]))))
        else if node.args.length == 1 then
          rtEmitJoin (rtEmitOk beginCode) (rtEmitJoin b (rtEmitOk (if flat then [11] else [12, 0, 11, 11])))
        else rtEmitError 15
      else if node.tag == 9 || node.tag == 10 then
        if !inLoop then rtEmitError 18
        else if node.tag == 9 && tail then rtEmitOk []
        else rtEmitOk ([12] ++ lebU (if node.tag == 9 then breakDepth else continueDepth))
      else if node.tag == 11 || node.tag == 12 then
        if (node.tag == 11 && node.ty != result) || node.args.length != (if node.ty == 2 then 0 else 1) || (node.ty != 2 && !rtCompatible2 node.ty (rtAt 0 node.args).ty) then rtEmitError 15
        else
          let value := if node.ty == 2 then rtEmitOk [] else rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop false (rtAt 0 node.args)
          rtEmitJoin value (rtEmitOk (if node.tag == 12 || tail then [] else [15]))
      else rtEmitError 20

  def rtCompatible2 (expected actual : Int) : Bool := expected == actual || actual == 3

  def rtLowerArgsWithFold (fuel : Nat) (rc foldConfiguration : Bool) (types : List Int) (signatures : List RtSignature)
      (result : Int) (continueDepth breakDepth : Nat) (inLoop : Bool) (nodes : List RtNode) (expected : List Int) : RtEmission :=
    match fuel, nodes, expected with
    | 0, _, _ => rtEmitError 19
    | _ + 1, [], [] => rtEmitOk []
    | fuel + 1, node :: nodes, ty :: expected =>
      if !rtCompatible2 ty node.ty then rtEmitError 15
      else rtEmitJoin (rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop false node)
        (rtLowerArgsWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop nodes expected)
    | _, _, _ => rtEmitError 15

  def rtLowerSequenceWithFold (fuel : Nat) (rc foldConfiguration : Bool) (types : List Int) (signatures : List RtSignature)
      (result : Int) (continueDepth breakDepth : Nat) (inLoop tail : Bool) (nodes : List RtNode) : RtEmission :=
    match fuel, nodes with
    | 0, _ => rtEmitError 19
    | _ + 1, [] => rtEmitOk []
    | fuel + 1, node :: nodes =>
      rtEmitJoin (rtLowerNodeWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop (tail && nodes.isEmpty) node)
        (rtLowerSequenceWithFold fuel rc foldConfiguration types signatures result continueDepth breakDepth inLoop tail nodes)
end

-- Validate every branch before configuration folding.  In particular, a
-- value-block return is allowed only as that block's final statement; it
-- cannot accidentally return from an enclosing function or leave a value
-- on an intermediate wasm stack.
def rtScalarType (ty : Int) : Bool := ty == 0 || ty == 1 || ty == 4

mutual
  def rtCheckFlow (fuel : Nat) (result : Int) (finalValue : Int) (node : RtNode) : Bool :=
    match fuel with
    | 0 => false
    | fuel + 1 =>
      if node.tag == 12 then
        finalValue == node.ty && node.args.length == (if node.ty == 2 then 0 else 1)
          && rtCheckFlowList fuel result (-1) node.args
      else if node.tag == 11 then
        finalValue == -1 && node.ty == result
          && node.args.length == (if result == 2 then 0 else 1)
          && rtCheckFlowList fuel result (-1) node.args
      else if node.tag == 5 then
        if node.val == 1 then
          (rtScalarType node.ty || node.ty == 2) && !node.args.isEmpty
            && rtCheckBlock fuel result node.ty node.args
        else node.val == 0 && node.ty == 2 && rtCheckBlock fuel result (-1) node.args
      else if node.tag == 4 then
        let yes := rtAt 1 node.args
        let no := rtAt 2 node.args
        (node.args.length == 2 || node.args.length == 3) && (rtAt 0 node.args).ty == 4
          && (if node.ty == 2 then yes.ty == 2 && no.ty == 2
              else node.args.length == 3 && rtCompatible2 node.ty yes.ty && rtCompatible2 node.ty no.ty)
          && rtCheckFlowList fuel result (-1) node.args
      else if node.tag == 0 then
        node.args.isEmpty && rtScalarType node.ty && (node.ty != 4 || node.val == 0 || node.val == 1)
      else if node.tag == 1 || node.tag == 13 then rtScalarType node.ty && node.args.isEmpty
      else if node.tag == 6 || node.tag == 7 || node.tag == 8 || node.tag == 9 || node.tag == 10 then
        node.ty == 2 && rtCheckFlowList fuel result (-1) node.args
      else if node.tag == 2 || node.tag == 3 then rtCheckFlowList fuel result (-1) node.args
      else false
  def rtCheckFlowList (fuel : Nat) (result finalValue : Int) (nodes : List RtNode) : Bool :=
    match fuel, nodes with
    | 0, _ => false
    | _ + 1, [] => true
    | fuel + 1, node :: nodes =>
      rtCheckFlow fuel result finalValue node && rtCheckFlowList fuel result finalValue nodes
  def rtCheckBlock (fuel : Nat) (result finalValue : Int) (nodes : List RtNode) : Bool :=
    match fuel, nodes with
    | 0, _ => false
    | _ + 1, [] => finalValue == -1
    | fuel + 1, node :: nodes =>
      if nodes.isEmpty && finalValue != -1 then
        node.tag == 12 && rtCheckFlow fuel result finalValue node
      else (node.ty == 2 || node.ty == 3 || node.tag == 11)
        && rtCheckFlow fuel result (-1) node && rtCheckBlock fuel result finalValue nodes
end

def rtReturns : Nat → RtNode → Bool
  | 0, _ => false
  | fuel + 1, node =>
    if node.tag == 11 || (node.tag == 2 && node.ty == 3) then true
    else if node.tag == 5 then rtReturns fuel (node.args.getLast?.getD rtNil)
    else node.tag == 4 && node.args.length == 3
      && rtReturns fuel (rtAt 1 node.args) && rtReturns fuel (rtAt 2 node.args)

-- The first lowering walk is a type/control check with configuration
-- folding disabled. No unchecked inactive branch reaches code emission.
-- The second walk retains the byte-preserving RC configuration fold.
def rtLowerNode (fuel : Nat) (rc : Bool) (types : List Int) (signatures : List RtSignature)
    (result : Int) (continueDepth breakDepth : Nat) (inLoop tail : Bool) (node : RtNode) : RtEmission :=
  rtLowerNodeWithFold fuel rc true types signatures result continueDepth breakDepth inLoop tail node

def rtLowerFunction (rc : Bool) (signatures : List RtSignature) (fn : RtFunction) : RtEmission :=
  if !(fn.params ++ fn.locals).all rtScalarType || !(rtScalarType fn.result || fn.result == 2)
      || !rtCheckFlow 200000 fn.result (-1) fn.body || (fn.result != 2 && !rtReturns 200000 fn.body) then rtEmitError 15
  else
    let checked := rtLowerNodeWithFold 200000 rc false (fn.params ++ fn.locals) signatures fn.result 0 0 false true fn.body
    if checked.error != 0 then rtEmitError checked.error
    else
      let code := rtLowerNode 200000 rc (fn.params ++ fn.locals) signatures fn.result 0 0 false true fn.body
      rtEmitJoin code (rtEmitOk [11])

def rtWasmFunction (rc : Bool) (signatures : List RtSignature) (fn : RtFunction) : WFn :=
  { params := fn.params.map rtWasmType,
    results := if fn.result == 2 then [] else [rtWasmType fn.result],
    locals := fn.locals.map rtWasmType,
    code := (rtLowerFunction rc signatures fn).bytes }

end RscSourceModule_ef6530cd8980b22f67c5a0ff2445a8e222fc0ac690fcf1821e86febb76a210a3
section RscSourceModule_25c62083cd36038a17e07a4218c01349bdb9be31c4bca53109747bda5e9b07d2
structure RgI where
  ok : Bool
  op : Int
  n : Nat
  bs : List Int
  rest : List Int

def rgFail : RgI := { ok := false, op := 0, n := 0, bs := [], rest := [] }

def rgLebGo : Nat → Nat → Nat → List Int → List Int → RgI
  | 0, _, _, _, _ => rgFail
  | _, _, _, _, [] => rgFail
  | k + 1, v, place, acc, b :: bs =>
    let low : Int := if b ≥ 128 then b - 128 else b
    let v2 := v + low.toNat * place
    if b < 128 then { ok := true, op := 0, n := v2, bs := reverse (b :: acc), rest := bs }
    else rgLebGo k v2 (place * 128) (b :: acc) bs

def rgLeb (bs : List Int) : RgI :=
  rgLebGo profile.lebSFuel 0 1 [] bs

-- Constant immediates and memory operands are copied, not interpreted by
-- this pass. A signed i64 LEB can occupy ten bytes; accumulating its
-- unsigned value or the next radix place would overflow the target Int.
def rgSkipLebGo : Nat → List Int → List Int → RgI
  | 0, _, _ => rgFail
  | _, _, [] => rgFail
  | k + 1, acc, b :: bs =>
    if b < 128 then { ok := true, op := 0, n := 0, bs := reverse (b :: acc), rest := bs }
    else rgSkipLebGo k (b :: acc) bs

def rgSkipLeb (bs : List Int) : RgI :=
  rgSkipLebGo profile.lebSFuel [] bs

def rgLebs : Nat → List Int → List Int → RgI
  | 0, acc, bs => { ok := true, op := 0, n := 0, bs := reverse acc, rest := bs }
  | k + 1, acc, bs =>
    let l := rgSkipLeb bs
    if !l.ok then rgFail else rgLebs k (revAppend l.bs acc) l.rest

def rgOne (b : Int) (n : Nat) (bs rest : List Int) : RgI :=
  { ok := true, op := b, n := n, bs := b :: bs, rest := rest }

-- One instruction of the set rsc emits: its opcode, index, bytes, rest.
def rgStep : List Int → RgI
  | [] => rgFail
  | b :: r =>
    if b == 65 || b == 66 then
      let l := rgSkipLeb r
      if !l.ok then rgFail else rgOne b 0 l.bs l.rest
    -- 8: `throw` and its tag (lib/lrc/Emit.rsd "How a function ends"); like `return`, it leaves
    -- the function, so no local is read after it
    else if b == 32 || b == 33 || b == 34 || b == 12 || b == 13 || b == 16 || b == 18 || b == 8 then
      let l := rgLeb r
      if !l.ok then rgFail else rgOne b l.n l.bs l.rest
    else if b == 2 || b == 3 || b == 4 then
      match r with
      | t :: r2 => if t == 64 || (t ≥ 123 && t ≤ 127) then rgOne b 0 [t] r2 else rgFail
      | [] => rgFail
    else if b ≥ 40 && b ≤ 62 then
      let l := rgLebs 2 [] r
      if !l.ok then rgFail else rgOne b 0 l.bs l.rest
    else if b == 63 || b == 64 then
      match r with
      | 0 :: r2 => rgOne b 0 [0] r2
      | _ => rgFail
    else if b == 14 then
      let c := rgLeb r
      if !c.ok then rgFail
      else
        let l := rgLebs (c.n + 1) [] c.rest
        if !l.ok then rgFail else rgOne b 0 (c.bs ++ l.bs) l.rest
    else if b == 252 then
      match r with
      | 10 :: 0 :: 0 :: r2 => rgOne b 0 [10, 0, 0] r2
      | 11 :: 0 :: r2 => rgOne b 0 [11, 0] r2
      | _ => rgFail
    else if b == 0 || b == 1 || b == 5 || b == 11 || b == 15 || b == 26 || b == 27 || (b ≥ 69 && b ≤ 196) then
      rgOne b 0 [] r
    else rgFail



end RscSourceModule_25c62083cd36038a17e07a4218c01349bdb9be31c4bca53109747bda5e9b07d2
section RscSourceModule_302e5d5e9b0d28d7b1ec6dd7eaae0e331fcbba1903fc2aaf887e5ca876654770
structure RiCode where
  ok : Bool := false
  code : List Int := []

def riCat : List (List Int) → List Int → List Int
  | [], acc => acc
  | c :: cs, acc => riCat cs (c ++ acc)

def riJoin (chunks : List (List Int)) : List Int :=
  riCat chunks []

def riBody : Nat → Nat → Nat → Nat → List (List Int) → List Int → RiCode
  | 0, _, _, _, _, _ => {}
  | _ + 1, _, _, _, _, [] => {}
  | fuel + 1, base, slots, depth, acc, bs =>
    let i := rgStep bs
    if !i.ok then {}
    else if i.op == 11 && depth == 0 then
      if i.rest.isEmpty then { ok := true, code := riJoin ([11] :: acc) } else {}
    else if i.op == 32 || i.op == 33 || i.op == 34 then
      if i.n >= slots then {}
      else riBody fuel base slots depth ((i.op :: lebU (base + i.n)) :: acc) i.rest
    else if i.op == 15 then
      riBody fuel base slots depth (([12] ++ lebU depth) :: acc) i.rest
    else if i.op == 18 then {}
    else if i.op == 2 || i.op == 3 || i.op == 4 then
      riBody fuel base slots (depth + 1) (i.bs :: acc) i.rest
    else if i.op == 11 then
      riBody fuel base slots (depth - 1) (i.bs :: acc) i.rest
    else riBody fuel base slots depth (i.bs :: acc) i.rest

def riSaveArgs : Nat → Nat → List Int
  | _, 0 => []
  | base, n + 1 => ls (base + n) ++ riSaveArgs base n

def riZero : Nat → List Int → List Int
  | _, [] => []
  | base, ty :: tys =>
    (if ty == vtI64 then i64Const 0 else i32Const 0) ++ ls base ++ riZero (base + 1) tys

def riExpand (f : WFn) (base : Nat) : RiCode :=
  if !f.results.isEmpty || (f.params ++ f.locals).any (fun t => t != vtI64 && t != vtI32) then {}
  else
    let body := riBody (f.code.length + 1) base (f.params.length + f.locals.length) 0 [] f.code
    { ok := body.ok, code := riSaveArgs base f.params.length ++ riZero (base + f.params.length) f.locals
        ++ [2, 64] ++ body.code }

structure RiWalk where
  ok : Bool := false
  code : List Int := []
  locals : List Int := []
  dupBase : Nat := 0
  dropBase : Nat := 0
  hasDup : Bool := false
  hasDrop : Bool := false
  sites : Nat := 0
  size : Nat := 0

-- FABLE-EMIT-SIZE-0: the caller-size cap of the expansion, in bytes of the
-- caller's instruction code after it. A caller that would exceed the cap keeps its
-- `call 6` / `call 7` sites: the body stays in the runtime, as in Lean's
-- lean.h (lean_inc_ref, lean_dec_ref, lean_dec_ref_cold) and Koka's
-- kklib.h (kk_block_dup, kk_block_drop, kk_block_check_drop).
-- Rule: HotSpot C2 refuses an inline once the caller reaches
-- DesiredMethodLimit = 8000 bytecodes after inlining
-- (InlineTree::try_to_inline, opto/bytecodeInfo.cpp, "size >
-- DesiredMethodLimit"); GCC has the same shape in large-function-insns and
-- large-function-growth (ipa-inline.cc caller_growth_limits). The unit
-- here is the same: bytes of stack bytecode. The decision is per caller,
-- all or nothing: its sites carry no profile to rank them.
-- Cost: the initial code length and decoding can traverse the original
-- caller. With fixed runtime templates and bounded Wasm indices, the pass
-- is O(|code| + |params| + |locals|) plus attempted expansion work.
-- The cap counts instruction-code bytes, excluding encoded local groups.
def riCodeCap : Nat := 8000

-- Templates are exactly the two source-lowered functions, not guessed byte
-- sequences. A failed decode preserves the entire original function, and
-- so does a rewritten body larger than `cap` bytes.
def riWalk (dup drop : WFn) (np cap : Nat) : Nat → RiWalk → List (List Int) → List Int → RiWalk
  | 0, _, _, _ => {}
  | _ + 1, state, acc, [] => { state with ok := true, code := riJoin acc }
  | fuel + 1, state, acc, bs =>
    let i := rgStep bs
    if !i.ok || state.size > cap then {}
    else if i.op == 16 && (i.n == 6 || i.n == 7) then
      let isDup := i.n == 6
      let f := if isDup then dup else drop
      let present := if isDup then state.hasDup else state.hasDrop
      let base := if present then (if isDup then state.dupBase else state.dropBase) else np + state.locals.length
      let expansion := riExpand f base
      if !expansion.ok then {}
      else
        let next := { state with
          locals := if present then state.locals else state.locals ++ f.params ++ f.locals
          dupBase := if isDup then base else state.dupBase
          dropBase := if isDup then state.dropBase else base
          hasDup := state.hasDup || isDup
          hasDrop := state.hasDrop || !isDup
          sites := state.sites + 1
          size := state.size + expansion.code.length }
        riWalk dup drop np cap fuel next (expansion.code :: acc) i.rest
    else riWalk dup drop np cap fuel { state with size := state.size + i.bs.length } (i.bs :: acc) i.rest

def riFunction (dup drop : WFn) (f : WFn) : WFn :=
  let rewritten := riWalk dup drop f.params.length riCodeCap (f.code.length + 1) { locals := f.locals } [] f.code
  if rewritten.ok && rewritten.sites > 0 && rewritten.size ≤ riCodeCap then
    { f with code := rewritten.code, locals := rewritten.locals }
  else f

def runtimeInlineFns (lay : Layers) (rtCount : Nat) (fns : List WFn) : List WFn :=
  if !lay.rc then fns
  else
    let empty : WFn := { params := [], results := [], locals := [], code := [] }
    let dup := fns.getD 6 empty
    let drop := fns.getD 7 empty
    fns.take rtCount ++ (fns.drop rtCount).map (riFunction dup drop)

end RscSourceModule_302e5d5e9b0d28d7b1ec6dd7eaae0e331fcbba1903fc2aaf887e5ca876654770
section RscSourceModule_03fc0bbb36e2743ba6c3dadb0543e028793ab356c5823ef758474befdabb64d3
structure RaItem where
  alloc : Bool := false
  code : List Int := []
  rest : List Int := []
  dest : Nat := 0
  bytes : Nat := 0
  tag : Nat := 0
  other : Nat := 0
  otherCode : List Int := []

def raSmall (bs : List Int) : RgI :=
  match bs with
  | 66 :: rest =>
    let l := rgLebGo 2 0 1 [] rest
    if l.ok && i64Const (l.n : Int) == 66 :: l.bs then l else rgFail
  | _ => rgFail

def raLocal (types : List Int) (n : Nat) : Bool :=
  n < types.length && types.getD n 0 == vtI64

def raAlloc (types : List Int) (bs : List Int) : RaItem :=
  let base := rgStep bs
  let bytes := raSmall base.rest
  let tag := raSmall bytes.rest
  let other := raSmall tag.rest
  let call := rgStep other.rest
  let dst := rgStep call.rest
  if !base.ok || base.op != 32 || base.n != 0 || !raLocal types 0
      || !bytes.ok || bytes.n < 8 || bytes.n > 4096 || !tag.ok || tag.n > 250
      || !other.ok || other.n > 255 || (tag.n == 250 && (bytes.n != 32 || other.n != 0))
      || !call.ok || call.op != 16 || call.n != 0 || !dst.ok || dst.op != 33
      || dst.n == 0 || !raLocal types dst.n then {}
  else
    let code := storageAlloc dst.n (bytes.n : Int) (tag.n : Int) (other.n : Int)
    if bs.take code.length != code then {}
    else { alloc := true, code := code, rest := bs.drop code.length, dest := dst.n, bytes := bytes.n, tag := tag.n, other := other.n }

def raForget (known : List (Nat × Nat)) (n : Nat) : List (Nat × Nat) :=
  known.filter (fun p => p.1 != n)

def raKnown : List (Nat × Nat) → Nat → Nat
  | [], _ => 0
  | p :: ps, n => if p.1 == n then p.2 else raKnown ps n

-- A value packet consumes none of the caller's previous operand stack.
def raValue (types : List Int) (bs : List Int) : RgI :=
  let i := rgStep bs
  if i.ok && ((i.op == 32 && raLocal types i.n) || i.op == 66) then i else rgFail

-- Runtime source calls do not contain storageAlloc's program failure packet.
-- Match only stack-neutral, constant-size/tag calls; keep the following
-- source failure branch in place. Dynamic metadata is checked before use.
def raRuntimeAlloc (types : List Int) (bs : List Int) : RaItem :=
  let base := rgStep bs
  let bytes := raSmall base.rest
  let tag := raSmall bytes.rest
  let other := raValue types tag.rest
  let call := rgStep other.rest
  let dst := rgStep call.rest
  if !base.ok || base.op != 32 || base.n != 0 || !raLocal types 0
      || !bytes.ok || bytes.n < 8 || bytes.n > 4096 || !tag.ok || tag.n >= 250
      || !other.ok || !call.ok || call.op != 16 || call.n != 0
      || !dst.ok || dst.op != 33 || dst.n == 0 || !raLocal types dst.n then {}
  else
    { alloc := true
      code := bs.take (bs.length - dst.rest.length)
      rest := dst.rest
      dest := dst.n
      bytes := bytes.n
      tag := tag.n
      otherCode := other.bs }

def raMove (types : List Int) (bs : List Int) : RaItem :=
  let value := raValue types bs
  let dst := rgStep value.rest
  if !value.ok || !dst.ok || dst.op != 33 || dst.n == 0 || !raLocal types dst.n then {}
  else { code := value.bs ++ dst.bs, rest := dst.rest, dest := dst.n }

def raStore (types : List Int) (known : List (Nat × Nat)) (bs : List Int) : RaItem :=
  let p := rgStep bs
  if !p.ok || p.op != 32 || !raLocal types p.n then {}
  else
    match p.rest with
    | 167 :: rest =>
      let value := raValue types rest
      if !value.ok then {}
      else
        match value.rest with
        | op :: align :: offsets =>
          let off := rgLebGo 2 0 1 [] offsets
          let width := if op == 55 && align >= 0 && align <= 3 then 8 else if op == 60 && align == 0 then 1 else 0
          if !off.ok || width == 0 || off.n < 8 || off.n + width > raKnown known p.n
              || lebU off.n != off.bs then {}
          else { code := p.bs ++ [167] ++ value.bs ++ [op, align] ++ off.bs, rest := off.rest }
        | _ => {}
    | _ => {}

structure RaSegment where
  items : List RaItem := []
  rest : List Int := []

def raSegment (types : List Int) : Nat → List (Nat × Nat) → List RaItem → List Int → RaSegment
  | 0, _, items, bs => { items := items.reverse, rest := bs }
  | fuel + 1, known, items, bs =>
    let a := raAlloc types bs
    if a.alloc then
      raSegment types fuel ((a.dest, a.bytes) :: raForget known a.dest) (a :: items) a.rest
    else
      let move := raMove types bs
      if !move.code.isEmpty then
        raSegment types fuel (raForget known move.dest) (move :: items) move.rest
      else
        let store := raStore types known bs
        if !store.code.isEmpty then raSegment types fuel known (store :: items) store.rest
        else { items := items.reverse, rest := bs }

def raRounded (bytes : Nat) : Nat := ((bytes + 7) / 8) * 8

def raClasses : List RaItem → List Nat → List Nat
  | [], classes => classes.reverse
  | a :: rest, classes =>
    let size := raRounded a.bytes
    raClasses rest (if a.alloc && !(classes.contains size) then size :: classes else classes)

def raCount (size : Nat) (items : List RaItem) : Nat :=
  (items.filter (fun a => a.alloc && raRounded a.bytes == size)).length

-- Specialize only the private templates' trailing UInt64 parameters. The
-- unspecialized source is checked first; assignments to a static parameter
-- and exhausted walks refuse. No target byte sequence implements a runtime
-- operation here. The one folded comparison is the static tail-zero test.
def raSpecialNode : Nat → Nat → List Int → RtNode → RtNode
  | 0, _, _, _ => { rtNil with tag := -1 }
  | fuel + 1, keep, values, node =>
    let np := keep + values.length
    if node.tag == 1 && node.val >= (keep : Int) && node.val < (np : Int) then
      { tag := 0, val := values.getD (node.val.toNat - keep) 0, ty := node.ty, args := [] }
    else if node.tag == 6 && node.val >= (keep : Int) && node.val < (np : Int) then
      { rtNil with tag := -1 }
    else
      let args := node.args.map (raSpecialNode fuel keep values)
      let n := { node with args := args, val := if (node.tag == 1 || node.tag == 6) && node.val >= (np : Int) then node.val - (values.length : Int) else node.val }
      if n.tag == 2 && n.val == rtPrimIndex 0 rtPrimitives "RT.gtU64" && args.length == 2
          && (rtAt 0 args).tag == 0 && (rtAt 1 args).tag == 0
          && (rtAt 0 args).val >= 0 && (rtAt 0 args).val <= 4096
          && (rtAt 1 args).val >= 0 && (rtAt 1 args).val <= 4096 then
        { tag := 0, val := if (rtAt 0 args).val > (rtAt 1 args).val then 1 else 0, ty := 4, args := [] }
      else if n.tag == 4 && n.ty == 2 && (rtAt 0 args).tag == 0 && (rtAt 0 args).ty == 4 then
        if (rtAt 0 args).val == 1 then rtAt 1 args else rtAt 2 args
      else n

def raTemplate (source : RtFunction) (keep : Nat) (values : List Int) : WFn :=
  if source.params.length != keep + values.length || source.params.any (fun t => t != 0)
      || (rtLowerFunction true [] source).error != 0 then
    { params := [], results := [], locals := [], code := [] }
  else
    let fn := { source with params := source.params.take keep, body := raSpecialNode 1000 keep values source.body }
    if (rtLowerFunction true [] fn).error != 0 then { params := [], results := [], locals := [], code := [] }
    else rtWasmFunction true [] fn

def raExpand (fn : WFn) (base : Nat) : RiCode :=
  if fn.results != [vtI64] || (fn.params ++ fn.locals).any (fun t => t != vtI64 && t != vtI32) then {}
  else
    let body := riBody (fn.code.length + 1) base (fn.params.length + fn.locals.length) 0 [] fn.code
    { ok := body.ok, code := riSaveArgs base fn.params.length ++ riZero (base + fn.params.length) fn.locals
      ++ [2, vtI64] ++ body.code }

def raClassIndex : Nat → Nat → List Nat → Nat
  | _, i, [] => i
  | size, i, x :: xs => if size == x then i else raClassIndex size (i + 1) xs

structure RaCode where
  ok : Bool := false
  code : List Int := []
  sites : Nat := 0
  checks : Nat := 0

def raGuards (guard : RtFunction) (items : List RaItem) (base pages : Nat) : Nat → List Nat → RaCode
  | _, [] => { ok := true }
  | i, size :: sizes =>
    let fn := raTemplate guard 1 [((size - 8) : Int), ((size + 8) : Int), (((raCount size items + 1) * (size + 8)) : Int), (raCount size items : Int)]
    let e := raExpand fn base
    let rest := raGuards guard items base pages (i + 1) sizes
    { ok := e.ok && rest.ok, code := lg 0 ++ e.code ++ ls (pages + i) ++ rest.code, checks := rest.checks + 1 }

def raConditions (pages : Nat) : Nat → List Nat → List Int
  | _, [] => []
  | i, _ :: sizes => lg (pages + i) ++ [80, 69] ++ raConditions pages (i + 1) sizes ++ (if sizes.isEmpty then [] else [113])

def raFastItems (bump : RtFunction) (base pages : Nat) (classes : List Nat) : List RaItem → RaCode
  | [] => { ok := true }
  | a :: items =>
    let rest := raFastItems bump base pages classes items
    if !a.alloc then { rest with code := a.code ++ rest.code }
    else
      let rounded := raRounded a.bytes
      let fn := raTemplate bump 3 [(rounded : Int), ((rounded + 8) : Int)]
      let e := raExpand fn base
      { rest with ok := e.ok && rest.ok, code := lg 0 ++ lg (pages + raClassIndex rounded 0 classes)
        ++ i64Const (storageHeader 1 (a.tag : Int) (a.other : Int)) ++ e.code ++ ls a.dest ++ rest.code, sites := rest.sites + 1 }

structure RaWalk where
  ok : Bool := false
  code : List Int := []
  sites : Nat := 0
  checks : Nat := 0
  pageSlots : Nat := 0

def raWalk (guard bump : RtFunction) (types : List Int) (guardBase bumpBase pages : Nat) :
    Nat → RaWalk → List (List Int) → List Int → RaWalk
  | 0, _, _, _ => {}
  | _ + 1, state, acc, [] => { state with ok := true, code := riJoin acc }
  | fuel + 1, state, acc, bs =>
    let a := raAlloc types bs
    if a.alloc then
      let segment := raSegment types (bs.length + 1) [] [] bs
      let classes := raClasses segment.items []
      let guards := raGuards guard segment.items guardBase pages 0 classes
      let hot := raFastItems bump bumpBase pages classes segment.items
      if !guards.ok || !hot.ok then {}
      else
        let cold := (segment.items.map (fun x => x.code)).flatten
        let code := guards.code ++ raConditions pages 0 classes ++ [4, 64] ++ hot.code ++ [5] ++ cold ++ [11]
        raWalk guard bump types guardBase bumpBase pages fuel
          { state with sites := state.sites + hot.sites, checks := state.checks + guards.checks, pageSlots := max state.pageSlots classes.length } (code :: acc) segment.rest
    else
      let i := rgStep bs
      if !i.ok then {} else raWalk guard bump types guardBase bumpBase pages fuel state (i.bs :: acc) i.rest

def raFunction (guard bump : RtFunction) (fn : WFn) : WFn :=
  let types := fn.params ++ fn.locals
  let guardBase := types.length
  let guardLocals := 1 + guard.locals.length
  let bumpBase := guardBase + guardLocals
  let bumpLocals := 3 + bump.locals.length
  let pages := bumpBase + bumpLocals
  let r := raWalk guard bump types guardBase bumpBase pages (fn.code.length + 1) {} [] fn.code
  if !r.ok || r.sites == 0 then fn
  else { fn with code := r.code, locals := fn.locals ++ List.replicate (guardLocals + bumpLocals + r.pageSlots) vtI64 }

def raRuntimeWalk (guard bump : RtFunction) (types : List Int) (guardBase bumpBase page : Nat) :
    Nat → RaWalk → List (List Int) → List Int → RaWalk
  | 0, _, _, _ => {}
  | _ + 1, state, acc, [] => { state with ok := true, code := riJoin acc }
  | fuel + 1, state, acc, bs =>
    let a := raRuntimeAlloc types bs
    if a.alloc then
      -- A runtime function with multiple eligible sites stays cold for now.
      -- The admitted function has one site, hence one size-class limit check
      -- in its basic block (including each iteration of a source loop).
      if state.sites != 0 then {}
      else
        let size := raRounded a.bytes
        let g := raExpand (raTemplate guard 1 [((size - 8) : Int), ((size + 8) : Int), (2 * (size + 8) : Int), 1]) guardBase
        let b := raExpand (raTemplate bump 3 [(size : Int), ((size + 8) : Int)]) bumpBase
        if !g.ok || !b.ok then {}
        else
          let header := a.otherCode ++ i64Const 48 ++ [134]
            ++ i64Const (storageHeader 1 (a.tag : Int) 0) ++ [132]
          let code := lg 0 ++ g.code ++ ls page
            ++ lg page ++ [80, 69] ++ a.otherCode ++ i64Const 255 ++ [88, 113, 4, 64]
            ++ lg 0 ++ lg page ++ header ++ b.code ++ ls a.dest ++ [5] ++ a.code ++ [11]
          raRuntimeWalk guard bump types guardBase bumpBase page fuel
            { state with sites := 1, checks := 1, pageSlots := 1 } (code :: acc) a.rest
    else
      let i := rgStep bs
      if !i.ok then {} else raRuntimeWalk guard bump types guardBase bumpBase page fuel state (i.bs :: acc) i.rest

def raRuntimeFunction (guard bump : RtFunction) (fn : WFn) : WFn :=
  let types := fn.params ++ fn.locals
  let guardBase := types.length
  let guardLocals := 1 + guard.locals.length
  let bumpBase := guardBase + guardLocals
  let bumpLocals := 3 + bump.locals.length
  let page := bumpBase + bumpLocals
  let r := raRuntimeWalk guard bump types guardBase bumpBase page (fn.code.length + 1) {} [] fn.code
  if !r.ok || r.sites != 1 then fn
  else { fn with code := r.code, locals := fn.locals ++ List.replicate (guardLocals + bumpLocals + 1) vtI64 }

def runtimeAllocFns (lay : Layers) (rtCount : Nat) (templates : List RtFunction) (fns : List WFn) : List WFn :=
  if !lay.rc || !lay.alloc || templates.length != 2 then fns
  else
    let empty : RtFunction := { name := "", params := [], result := 2, locals := [], body := rtNil }
    let guard := templates.getD 0 empty
    let bump := templates.getD 1 empty
    if guard.name != "rsd_rt_alloc_guard" || bump.name != "rsd_rt_alloc_bump"
        || guard.params != [0, 0, 0, 0, 0] || bump.params != [0, 0, 0, 0, 0]
        || guard.locals.any (fun t => t != 0) || bump.locals.any (fun t => t != 0) then fns
    else (fns.zip (List.range fns.length)).map fun (fn, i) =>
      if i == 0 then fn
      else if i < rtCount then raRuntimeFunction guard bump fn
      else raFunction guard bump fn

end RscSourceModule_03fc0bbb36e2743ba6c3dadb0543e028793ab356c5823ef758474befdabb64d3
section RscSourceModule_504799594dae73e7da63a75824daf56733b24aac51fcebed453e2438ed292746
structure RtParser where
  tokens : List String
  names : List String
  types : List Int
  mutableNames : List String
  signatures : List RtSignature
  result : Int
  node : RtNode
  error : Nat
  position : Nat
  declarations : Bool
  nesting : Nat

structure RtParsed where
  functions : List RtFunction
  error : Nat
  position : Nat
  deriving Inhabited

-- 13 scope, 14 syntax, 15 type, 16 unknown primitive/call,
-- 17 duplicate binder, 18 loop scope, 19 fuel, 20 wire.
def rtFrontRefusal (n : Nat) : String :=
  if n == 0 then "ok"
  else if n == 13 then "rsdc_runtime_primitive_scope"
  else if n == 14 then "rsdc_runtime_syntax"
  else if n == 15 then "rsdc_runtime_type"
  else if n == 16 then "rsdc_runtime_name"
  else if n == 17 then "rsdc_runtime_binder"
  else if n == 18 then "rsdc_runtime_loop_scope"
  else if n == 19 then "rsdc_runtime_fuel"
  else "rsdc_runtime_wire"

def rtWhite (c : Char) : Bool := c == ' ' || c == '\n' || c == '\r' || c == '\t'
def rtWordChar (c : Char) : Bool :=
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
  (c >= '0' && c <= '9') || c == '_' || c == '.'

def rtLexWord : List Char → List Char → List Char × List Char
  | [], acc => (acc.reverse, [])
  | c :: cs, acc =>
    if rtWordChar c then rtLexWord cs (c :: acc) else (acc.reverse, c :: cs)

def rtLexComment : List Char → List Char
  | [] => []
  | c :: cs => if c == '\n' then cs else rtLexComment cs

partial def rtLex : List Char → List String
  | [] => []
  | '-' :: '-' :: cs => rtLex (rtLexComment cs)
  | ':' :: '=' :: cs => ":=" :: rtLex cs
  | c :: cs =>
    if rtWhite c then rtLex cs
    else if rtWordChar c then
      let w := rtLexWord (c :: cs) []
      String.mk w.1 :: rtLex w.2
    else String.singleton c :: rtLex cs

def rtToken (st : RtParser) : String := st.tokens.headD ""
def rtPop (st : RtParser) : RtParser :=
  { st with tokens := st.tokens.drop 1, position := st.position + 1 }
def rtError (st : RtParser) (error : Nat) : RtParser :=
  if st.error != 0 then st else { st with error := error }
def rtEat (st : RtParser) (token : String) : RtParser :=
  if rtToken st == token then rtPop st else rtError st 14

def rtType (name : String) : Int :=
  if name == "UInt64" || name == "USize" then 0
  else if name == "UInt32" then 1
  else if name == "Bool" then 4
  else if name == "Unit" then 2 else -1

def rtNameIndex : Nat → List String → String → Int
  | _, [], _ => -1
  | i, name :: names, wanted =>
    if name == wanted then (i : Int) else rtNameIndex (i + 1) names wanted

def rtSetNode (st : RtParser) (tag value ty : Int) (args : List RtNode) : RtParser :=
  { st with node := { tag := tag, val := value, ty := ty, args := args } }

def rtInit (tokens : List String) (signatures : List RtSignature) : RtParser :=
  { tokens := tokens, names := [], types := [], mutableNames := [],
    signatures := signatures, result := 2, node := rtNil, error := 0, position := 0, declarations := true, nesting := 0 }

instance : Inhabited RtParser := ⟨rtInit [] []⟩

def rtCompatible (expected actual : Int) : Bool := expected == actual || actual == 3

mutual
  partial def rtExpr (st : RtParser) (expected : Int) : RtParser :=
    if st.error != 0 then st
    else if rtToken st == "(" then
      let s := rtPop st
      let s := if rtToken s == "←" then rtPop s else s
      let s := rtExpr s expected
      rtEat s ")"
    else if rtToken st == "pure" then rtExpr (rtPop st) expected
    else if rtToken st == "do" then
      let s := rtSeq { (rtPop st) with result := expected } 0 true
      let s := { s with result := st.result }
      if rtCompatible expected s.node.ty then s else rtError s 15
    else if rtToken st == "if" then
      let s := rtExpr (rtPop st) 4
      let cond := s.node
      let s := rtExpr (rtEat s "then") expected
      let yes := s.node
      let s := rtExpr (rtEat s "else") expected
      rtSetNode s 4 0 expected [cond, yes, s.node]
    else if rtToken st == "-" then
      -- Stock Lean has no Neg instance for these unsigned types.
      rtError st 15
    else
      let name := rtToken st
      let s := rtPop st
      match name.toNat? with
      | some value =>
        -- Keep the independent machine-word front's literal bound. UInt32
        -- OfNat still wraps exactly as stock Lean does within this bound.
        if expected > 1 || value >= 18446744073709551616 then rtError st 15
        else rtSetNode s 0 (value : Int) expected []
      | none =>
        if name == "RT.rc" then
          if expected == 4 then rtSetNode s 13 0 4 [] else rtError s 15
        else if name == "true" || name == "false" then
          if expected == 4 then rtSetNode s 0 (if name == "true" then 1 else 0) 4 [] else rtError s 15
        else
          let localIndex := rtNameIndex 0 st.names name
          if localIndex >= 0 then
            let ty := rtTypeAt localIndex.toNat st.types
            if rtCompatible expected ty then rtSetNode s 1 localIndex ty [] else rtError s 15
          else
            let prim := rtPrimIndex 0 rtPrimitives name
            if prim >= 0 then
              let signature := rtPrimAt prim.toNat rtPrimitives
              if !rtCompatible expected signature.result then rtError st 15
              else
                let s := rtExprArgs s signature.args []
                rtSetNode s 2 prim signature.result s.node.args
            else
              let call := rtSigIndex 0 st.signatures name
              if call < 0 then rtError st 16
              else
                let signature := rtSigAt call.toNat st.signatures
                if !rtCompatible expected signature.result then rtError st 15
                else
                  let s := rtExprArgs s signature.params []
                  rtSetNode s 3 call signature.result s.node.args

  partial def rtExprArgs (st : RtParser) (types : List Int) (acc : List RtNode) : RtParser :=
    match types with
    | [] => rtSetNode st 5 0 2 acc.reverse
    | ty :: types =>
      let s := rtExpr st ty
      rtExprArgs s types (s.node :: acc)

  partial def rtStatement (st : RtParser) (depth : Nat) (valueBlock : Bool) : RtParser :=
    if st.error != 0 then st
    else if rtToken st == "let" then
      let st := if st.nesting != 1 || !st.declarations then rtError st 17 else st
      let s := rtEat (rtPop st) "mut"
      let name := rtToken s
      let s := rtEat (rtPop s) ":"
      let ty := rtType (rtToken s)
      let s := rtEat (rtPop s) ":="
      if ty != 0 && ty != 1 && ty != 4 then rtError s 15
      else if rtNameIndex 0 st.names name >= 0 then
        -- Lean's `let mut p : T := p` makes a parameter mutable; retain
        -- its physical slot rather than manufacturing a second local.
        let index := rtNameIndex 0 st.names name
        if rtToken s != name || rtTypeAt index.toNat st.types != ty || st.mutableNames.contains name then rtError s 17
        else rtSetNode { (rtPop s) with mutableNames := name :: st.mutableNames } 5 0 2 []
      else
        let index := st.names.length
        -- The initializer sees the old environment, as in Lean.
        let s := if rtToken s == "default" then rtSetNode (rtPop s) 5 0 2 []
          else
            let s := rtExpr s ty
            rtSetNode s 6 (index : Int) 2 [s.node]
        { s with names := st.names ++ [name], types := st.types ++ [ty], mutableNames := name :: st.mutableNames }
    else if rtToken st == "if" then
      let s := rtExpr (rtPop st) 4
      let cond := s.node
      let s := rtSeq (rtEat s "then") depth valueBlock
      let yes := s.node
      if rtToken s == "else" then
        let s := rtSeq (rtPop s) depth valueBlock
        rtSetNode s 4 0 2 [cond, yes, s.node]
      else rtSetNode s 4 0 2 [cond, yes]
    else if rtToken st == "while" then
      let s := rtExpr (rtPop st) 4
      let cond := s.node
      let s := rtSeq (rtEat s "do") (depth + 1) valueBlock
      rtSetNode s 7 0 2 [cond, s.node]
    else if rtToken st == "repeat" then
      let s := rtSeq (rtPop st) (depth + 1) valueBlock
      let body := s.node
      if rtToken s == "until" then
        let s := rtExpr (rtPop s) 4
        rtSetNode s 8 0 2 [body, s.node]
      else rtSetNode s 8 0 2 [body]
    else if rtToken st == "break" || rtToken st == "continue" then
      if depth == 0 then rtError st 18
      else rtSetNode (rtPop st) (if rtToken st == "break" then 9 else 10) 0 2 []
    else if rtToken st == "return" then
      let s := rtPop st
      if st.result == 2 then
        let s := if rtToken s == "(" then rtEat (rtEat s "(") ")" else s
        rtSetNode s (if valueBlock then 12 else 11) 0 2 []
      else
        let s := rtExpr s st.result
        rtSetNode s (if valueBlock then 12 else 11) 0 st.result [s.node]
    else
      let name := rtToken st
      let index := rtNameIndex 0 st.names name
      if index >= 0 then
        if !st.mutableNames.contains name then rtError st 17
        else
          let s := rtExpr (rtEat (rtPop st) ":=") (rtTypeAt index.toNat st.types)
          rtSetNode s 6 index 2 [s.node]
      else rtExpr st 2

  partial def rtSeq (st : RtParser) (depth : Nat) (valueBlock : Bool) : RtParser :=
    let s := rtSeqItems { (rtEat st "{") with nesting := st.nesting + 1 } depth valueBlock []
    { s with nesting := st.nesting }

  partial def rtSeqItems (st : RtParser) (depth : Nat) (valueBlock : Bool) (acc : List RtNode) : RtParser :=
    if st.error != 0 then st
    else if rtToken st == "}" then
      let nodes := acc.reverse
      let ty := if valueBlock then (acc.headD rtNil).ty else 2
      rtSetNode (rtPop st) 5 (if valueBlock then 1 else 0) ty nodes
    else
      let st := if rtToken st == "let" then st else { st with declarations := false }
      let s := rtStatement st depth valueBlock
      let s := if rtToken s == ";" then rtPop s else s
      rtSeqItems s depth valueBlock (s.node :: acc)
end

partial def rtBinders (st : RtParser) : RtParser :=
  if rtToken st != "(" then st
  else
    let s := rtPop st
    let name := rtToken s
    let s := rtEat (rtPop s) ":"
    let ty := rtType (rtToken s)
    let s := rtEat (rtPop s) ")"
    if ty != 0 && ty != 1 && ty != 4 then rtError s 15
    else if st.names.contains name then rtError s 17
    else rtBinders { s with names := st.names ++ [name], types := st.types ++ [ty] }

def rtFunctionHeader (st : RtParser) : RtParser :=
  let s := rtBinders st
  let s := rtEat s ":"
  let s := rtEat s "RT.M"
  let ty := rtType (rtToken s)
  if ty < 0 then rtError s 15 else { (rtPop s) with result := ty }

-- First collect all signatures, so forward calls have the same meaning as
-- backward calls.  Bodies are skipped structurally, not by text searching.
partial def rtSkipBody (depth : Nat) (st : RtParser) : RtParser :=
  if st.error != 0 || rtToken st == "" then rtError st 14
  else if rtToken st == "}" && depth == 1 then rtPop st
  else if rtToken st == "}" then rtSkipBody (depth - 1) (rtPop st)
  else if rtToken st == "{" then rtSkipBody (depth + 1) (rtPop st)
  else rtSkipBody depth (rtPop st)

partial def rtSignatures (st : RtParser) (acc : List RtSignature) : RtParser :=
  if st.error != 0 || rtToken st == "" then { st with signatures := acc.reverse }
  else
    let s := if rtToken st == "partial" then rtPop st else st
    let s := rtEat s "def"
    let name := rtToken s
    let s := rtFunctionHeader { (rtPop s) with names := [], types := [] }
    if rtSigIndex 0 acc name >= 0 then rtError s 17
    else
      let signature := { name := name, params := s.types, result := s.result : RtSignature }
      let s := rtEat (rtEat s ":=") "do"
      let s := rtSkipBody 0 s
      rtSignatures s (signature :: acc)

partial def rtParseFunctions (st : RtParser) (acc : List RtFunction) : RtParsed :=
  if st.error != 0 then { functions := [], error := st.error, position := st.position }
  else if rtToken st == "" then { functions := acc.reverse, error := 0, position := st.position }
  else
    let s := if rtToken st == "partial" then rtPop st else st
    let s := rtEat s "def"
    let name := rtToken s
    let s := rtFunctionHeader { (rtPop s) with names := [], types := [], mutableNames := [], declarations := true, nesting := 0 }
    let params := s.types
    let s := rtSeq (rtEat (rtEat s ":=") "do") 0 false
    let fn : RtFunction := { name := name, params := params, result := s.result, locals := s.types.drop params.length, body := s.node }
    rtParseFunctions s (fn :: acc)

def rtSourceTokens (source : String) : List String :=
  let chars := source.toList
  let rawTokens := rtLex chars
  let tokens := if rawTokens.headD "" == "mutual" then
      if rawTokens.getLast?.getD "" == "end" then (rawTokens.drop 1).take (rawTokens.length - 2)
      else ["<syntax>"]
    else rawTokens
  -- A generated query of the one shared RSCM layout function.  It is
  -- appended (rather than prepended) to keep source function indices stable.
  let tokens := if tokens.contains "rsd_rt_v1_slot_class" then
      tokens ++ rtLex objectSlotRuntimeSource.toList else tokens
  tokens

-- Runtime extensions use the already checked prefix signatures. Calls in
-- their wire therefore retain their absolute runtime-function indices.
def rtParseExtension (prefixFns : List RtFunction) (source : String) : RtParsed :=
  let tokens := rtSourceTokens source
  let signatures := rtSignatures (rtInit tokens []) (rtSignaturesOf prefixFns).reverse
  if signatures.error != 0 then { functions := [], error := signatures.error, position := signatures.position }
  else rtParseFunctions (rtInit tokens signatures.signatures) []

def rtParseSource (source : String) : RtParsed := rtParseExtension [] source

def rtEmitSource (source : String) : List Int :=
  let parsed := rtParseSource source
  if parsed.error == 0 then rtModuleWire parsed.functions else []

end RscSourceModule_504799594dae73e7da63a75824daf56733b24aac51fcebed453e2438ed292746
