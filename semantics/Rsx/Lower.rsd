/-! ### Per-kind refusal tallying, accounting conservation laws, 1-to-1 `cap` vs `cap + 1`
    boundary pairs, and source-bound endpoint certificates (`P1-SOURCE-CERT-CLOSE`) -/

theorem rsxConstructCounts_add_comm (a b : RsxConstructCounts) :
    RsxConstructCounts.add a b = RsxConstructCounts.add b a := by
  cases a; cases b
  simp only [RsxConstructCounts.add, Nat.add_comm]

theorem rsxConstructCounts_add_assoc (a b c : RsxConstructCounts) :
    RsxConstructCounts.add (RsxConstructCounts.add a b) c =
      RsxConstructCounts.add a (RsxConstructCounts.add b c) := by
  cases a; cases b; cases c
  simp only [RsxConstructCounts.add, Nat.add_assoc]

theorem rsxConstructCounts_add_left_comm (a b c : RsxConstructCounts) :
    RsxConstructCounts.add a (RsxConstructCounts.add b c) =
      RsxConstructCounts.add b (RsxConstructCounts.add a c) := by
  rw [← rsxConstructCounts_add_assoc, rsxConstructCounts_add_comm a b,
    rsxConstructCounts_add_assoc]

theorem rsxConstructCounts_add_zero (a : RsxConstructCounts) :
    RsxConstructCounts.add a {} = a := by
  cases a
  simp only [RsxConstructCounts.add, Nat.add_zero]

theorem rsxConstructCounts_zero_add (a : RsxConstructCounts) :
    RsxConstructCounts.add {} a = a := by
  cases a
  simp only [RsxConstructCounts.add, Nat.zero_add]

structure RsxRefusalKindBucket where
  kind : String
  declCount : Nat := 0
  constructs : RsxConstructCounts := {}
  deriving DecidableEq, Repr

def insertRefusalKind (kind : String) (cs : RsxConstructCounts) :
    List RsxRefusalKindBucket → List RsxRefusalKindBucket
  | [] => [{ kind := kind, declCount := 1, constructs := cs }]
  | b :: rest =>
      if b.kind = kind then
        { b with
          declCount := 1 + b.declCount,
          constructs := RsxConstructCounts.add cs b.constructs } :: rest
      else
        b :: insertRefusalKind kind cs rest

def sumBucketDecls : List RsxRefusalKindBucket → Nat
  | [] => 0
  | b :: rest => b.declCount + sumBucketDecls rest

def sumBucketConstructs : List RsxRefusalKindBucket → RsxConstructCounts
  | [] => {}
  | b :: rest => RsxConstructCounts.add b.constructs (sumBucketConstructs rest)

theorem insertRefusalKind_ne_nil (kind : String) (cs : RsxConstructCounts)
    (bs : List RsxRefusalKindBucket) :
    insertRefusalKind kind cs bs ≠ [] := by
  cases bs with
  | nil => intro h; exact List.noConfusion h
  | cons b rest =>
      simp only [insertRefusalKind]
      split <;> (intro h; exact List.noConfusion h)

theorem sumBucketDecls_insert (kind : String) (cs : RsxConstructCounts) :
    ∀ (bs : List RsxRefusalKindBucket),
      sumBucketDecls (insertRefusalKind kind cs bs) = 1 + sumBucketDecls bs
  | [] => rfl
  | b :: rest => by
      simp only [insertRefusalKind]
      split
      · simp only [sumBucketDecls]
        omega
      · simp only [sumBucketDecls, sumBucketDecls_insert kind cs rest]
        omega

theorem sumBucketConstructs_insert (kind : String) (cs : RsxConstructCounts) :
    ∀ (bs : List RsxRefusalKindBucket),
      sumBucketConstructs (insertRefusalKind kind cs bs) =
        RsxConstructCounts.add cs (sumBucketConstructs bs)
  | [] => by simp only [insertRefusalKind, sumBucketConstructs]
  | b :: rest => by
      simp only [insertRefusalKind]
      split
      · simp only [sumBucketConstructs, rsxConstructCounts_add_assoc]
      · simp only [sumBucketConstructs, sumBucketConstructs_insert kind cs rest]
        exact rsxConstructCounts_add_left_comm b.constructs cs (sumBucketConstructs rest)

structure RsxKindBatchReport where
  certifiedDecls : Nat := 0
  certifiedConstructs : RsxConstructCounts := {}
  refusedByKind : List RsxRefusalKindBucket := []
  deriving DecidableEq, Repr

def certifyStepByKind (E : ResolvedEnv) (n fw lf fv F : Nat)
    (t : BootTy) (e : Expr Nat) (rep : RsxKindBatchReport) : RsxKindBatchReport :=
  match walkExprConstructs E fw e with
  | .error err =>
      { rep with refusedByKind := insertRefusalKind err {} rep.refusedByKind }
  | .ok cs =>
      match checkRsxCert E n lf fv F t e with
      | .ok _ =>
          { rep with
            certifiedDecls := 1 + rep.certifiedDecls,
            certifiedConstructs := RsxConstructCounts.add cs rep.certifiedConstructs }
      | .error err =>
          { rep with
            refusedByKind := insertRefusalKind err cs rep.refusedByKind }

def certifyBatchByKind (E : ResolvedEnv) (n fw lf fv F : Nat) :
    List (BootTy × Expr Nat) → RsxKindBatchReport
  | [] => {}
  | p :: rest =>
      certifyStepByKind E n fw lf fv F p.1 p.2
        (certifyBatchByKind E n fw lf fv F rest)

def walkBatchConstructs (E : ResolvedEnv) (fw : Nat) :
    List (BootTy × Expr Nat) → RsxConstructCounts
  | [] => {}
  | p :: rest =>
      match walkExprConstructs E fw p.2 with
      | .ok cs => RsxConstructCounts.add cs (walkBatchConstructs E fw rest)
      | .error _ => walkBatchConstructs E fw rest

theorem certifyBatchByKind_certifiedDecls_eq (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      (certifyBatchByKind E n fw lf fv F decls).certifiedDecls =
        (certifyBatch E n fw lf fv F decls).certifiedDecls
  | [] => rfl
  | p :: rest => by
      simp only [certifyBatchByKind, certifyBatch, certifyStepByKind, certifyOne]
      cases walkExprConstructs E fw p.2 with
      | error err =>
          simp only [RsxBatchReport.append, Nat.zero_add,
            certifyBatchByKind_certifiedDecls_eq E n fw lf fv F rest]
      | ok cs =>
          cases checkRsxCert E n lf fv F p.1 p.2 with
          | ok _ =>
              simp only [RsxBatchReport.append,
                certifyBatchByKind_certifiedDecls_eq E n fw lf fv F rest]
          | error err =>
              simp only [RsxBatchReport.append, Nat.zero_add,
                certifyBatchByKind_certifiedDecls_eq E n fw lf fv F rest]

theorem certifyBatchByKind_certifiedConstructs_eq (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      (certifyBatchByKind E n fw lf fv F decls).certifiedConstructs =
        (certifyBatch E n fw lf fv F decls).certifiedConstructs
  | [] => rfl
  | p :: rest => by
      simp only [certifyBatchByKind, certifyBatch, certifyStepByKind, certifyOne]
      cases walkExprConstructs E fw p.2 with
      | error err =>
          simp only [RsxBatchReport.append, rsxConstructCounts_zero_add,
            certifyBatchByKind_certifiedConstructs_eq E n fw lf fv F rest]
      | ok cs =>
          cases checkRsxCert E n lf fv F p.1 p.2 with
          | ok _ =>
              simp only [RsxBatchReport.append,
                certifyBatchByKind_certifiedConstructs_eq E n fw lf fv F rest]
          | error err =>
              simp only [RsxBatchReport.append, rsxConstructCounts_zero_add,
                certifyBatchByKind_certifiedConstructs_eq E n fw lf fv F rest]

theorem certifyBatchByKind_refusedConstructs_eq (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      sumBucketConstructs (certifyBatchByKind E n fw lf fv F decls).refusedByKind =
        (certifyBatch E n fw lf fv F decls).refusedConstructs
  | [] => rfl
  | p :: rest => by
      simp only [certifyBatchByKind, certifyBatch, certifyStepByKind, certifyOne]
      cases walkExprConstructs E fw p.2 with
      | error err =>
          simp only [RsxBatchReport.append, sumBucketConstructs_insert,
            certifyBatchByKind_refusedConstructs_eq E n fw lf fv F rest]
      | ok cs =>
          cases checkRsxCert E n lf fv F p.1 p.2 with
          | ok _ =>
              simp only [RsxBatchReport.append, rsxConstructCounts_zero_add,
                certifyBatchByKind_refusedConstructs_eq E n fw lf fv F rest]
          | error err =>
              simp only [RsxBatchReport.append, sumBucketConstructs_insert,
                certifyBatchByKind_refusedConstructs_eq E n fw lf fv F rest]

theorem certifyBatchByKind_decl_conservation (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      (certifyBatchByKind E n fw lf fv F decls).certifiedDecls +
        sumBucketDecls (certifyBatchByKind E n fw lf fv F decls).refusedByKind =
        decls.length
  | [] => rfl
  | p :: rest => by
      have ih := certifyBatchByKind_decl_conservation E n fw lf fv F rest
      simp only [certifyBatchByKind, certifyStepByKind, List.length_cons]
      cases walkExprConstructs E fw p.2 with
      | error err =>
          simp only [sumBucketDecls_insert]
          omega
      | ok cs =>
          cases checkRsxCert E n lf fv F p.1 p.2 with
          | ok _ =>
              simp only
              omega
          | error err =>
              simp only [sumBucketDecls_insert]
              omega

theorem certifyBatchByKind_construct_conservation (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      RsxConstructCounts.add
        (certifyBatchByKind E n fw lf fv F decls).certifiedConstructs
        (sumBucketConstructs (certifyBatchByKind E n fw lf fv F decls).refusedByKind) =
        walkBatchConstructs E fw decls
  | [] => rfl
  | p :: rest => by
      have ih := certifyBatchByKind_construct_conservation E n fw lf fv F rest
      simp only [certifyBatchByKind, certifyStepByKind, walkBatchConstructs]
      cases walkExprConstructs E fw p.2 with
      | error err =>
          simp only [sumBucketConstructs_insert, rsxConstructCounts_zero_add]
          exact ih
      | ok cs =>
          cases checkRsxCert E n lf fv F p.1 p.2 with
          | ok _ =>
              simp only [rsxConstructCounts_add_assoc, ih]
          | error err =>
              simp only [sumBucketConstructs_insert]
              rw [rsxConstructCounts_add_left_comm, ih]

theorem allCertified_of_refusedByKind_nil (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      (certifyBatchByKind E n fw lf fv F decls).refusedByKind = [] →
      AllCertified E n lf fv F decls = true
  | [], _ => rfl
  | p :: rest, h => by
      simp only [certifyBatchByKind, certifyStepByKind] at h
      cases hw : walkExprConstructs E fw p.2 with
      | error err =>
          rw [hw] at h
          exact absurd h (insertRefusalKind_ne_nil err {} _)
      | ok cs =>
          rw [hw] at h
          simp only [AllCertified]
          cases hc : checkRsxCert E n lf fv F p.1 p.2 with
          | error err =>
              rw [hc] at h
              exact absurd h (insertRefusalKind_ne_nil err cs _)
          | ok _ =>
              rw [hc] at h
              exact allCertified_of_refusedByKind_nil E n fw lf fv F rest h

theorem certifyBatchByKind_no_refusals_sound {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n fw lf fv F : Nat) (decls : List (BootTy × Expr Nat))
    (hnil : (certifyBatchByKind E n fw lf fv F decls).refusedByKind = []) :
    ∀ p, p ∈ decls →
      ∃ v w,
        norm E lf p.2 = some v ∧
        scmValOf E fv v = some w ∧
        ∃ F₀, ∀ F', F₀ ≤ F' →
          ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
            (lowerF E n F' (S := S) p.1 p.2) = some w :=
  allCertified_sound progs E n lf fv F decls
    (allCertified_of_refusedByKind_nil E n fw lf fv F decls hnil)

theorem certifyBatchByKind_no_refusals_traceErasable
    (E : ResolvedEnv) (n fw lf fv F : Nat) (decls : List (BootTy × Expr Nat))
    (hnil : (certifyBatchByKind E n fw lf fv F decls).refusedByKind = []) :
    ∀ p, p ∈ decls → TraceErasable E n lf p.2 :=
  allCertified_traceErasable E n lf fv F decls
    (allCertified_of_refusedByKind_nil E n fw lf fv F decls hnil)

theorem certifyBatchByKind_no_refusals_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n fw lf fv F : Nat)
    (hWf : EnvWf E) (hB : BodiesTyped E n)
    (decls : List (BootTy × Expr Nat))
    (hnil : (certifyBatchByKind E n fw lf fv F decls).refusedByKind = []) :
    ∀ p, p ∈ decls →
      TraceErasable E n lf p.2 ∧
      ∃ v w,
        norm E lf p.2 = some v ∧
        scmValOf E fv v = some w ∧
        ∃ F₀, ∀ F', F₀ ≤ F' →
          ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
            (lowerF E n F' (S := S) p.1 p.2) = some w :=
  allCertified_sound_via_adequacyClosed progs E n lf fv F hWf hB decls
    (allCertified_of_refusedByKind_nil E n fw lf fv F decls hnil)

theorem certifyBatchByKind_ctlBatch_report :
    certifyBatchByKind ctlEnv 0 8 8 4 8 ctlBatch =
      { certifiedDecls := 14,
        certifiedConstructs :=
          { bvar := 11, sort := 1, constHead := 25, constDelta := 2,
            app := 20, lam := 10, pi := 2, letE := 2, lit := 11 },
        refusedByKind := [] } := rfl

def ctlRefusalSamples : List (BootTy × Expr Nat) :=
  [(.i64, .bvar 0),
   (.i64, .bvar 1),
   (tyNat1, .sort .zero),
   (tyNat1, g16),
   (cIntroTyNat, cIntro),
   (tyNat1, .lit 5)]

def ctlMixedBatch : List (BootTy × Expr Nat) := ctlBatch ++ ctlRefusalSamples

theorem certifyBatchByKind_ctlMixedBatch_report :
    certifyBatchByKind ctlEnv 0 8 8 4 8 ctlMixedBatch =
      { certifiedDecls := 14,
        certifiedConstructs :=
          { bvar := 11, sort := 1, constHead := 25, constDelta := 2,
            app := 20, lam := 10, pi := 2, letE := 2, lit := 11 },
        refusedByKind :=
          [{ kind := "[rsx_cert_val_not_fitting]", declCount := 1,
             constructs := { lit := 1 } },
           { kind := "[rsx_cert_irrelevant_root]", declCount := 1,
             constructs := { constHead := 1 } },
           { kind := "[rsx_cert_not_scm_val]", declCount := 1,
             constructs := { constHead := 1 } },
           { kind := "[rsx_cert_not_data_ty]", declCount := 1,
             constructs := { sort := 1 } },
           { kind := "[rsx_cert_untyped]", declCount := 2,
             constructs := { bvar := 2 } }] } := rfl

/-! ### Complete 1-to-1 `cap` vs `cap + 1` fuel boundary pairs for `checkRsxCert` -/

theorem checkRsxCert_refuses_norm_fuel0_g02 :
    checkRsxCert ctlEnv 0 0 4 8 tyNat1 g02 = .error "[rsx_cert_norm_fuel]" := rfl
theorem checkRsxCert_refuses_norm_timeout_cap_g02 :
    checkRsxCert ctlEnv 0 1 4 8 tyNat1 g02 = .error "[rsx_cert_norm_timeout]" := rfl
theorem checkRsxCert_accepts_norm_timeout_cap_succ_g02 :
    checkRsxCert ctlEnv 0 2 4 8 tyNat1 g02 = .ok (cZero, .inj 1 (.list [])) := rfl

theorem checkRsxCert_refuses_norm_timeout_cap_g01 :
    checkRsxCert ctlEnv 0 1 4 8 .i64 g01 = .error "[rsx_cert_norm_timeout]" := rfl
theorem checkRsxCert_accepts_norm_timeout_cap_succ_g01 :
    checkRsxCert ctlEnv 0 2 4 8 .i64 g01 = .ok (.lit 5, .int 5) := rfl

theorem checkRsxCert_accepts_val_fuel1 :
    checkRsxCert ctlEnv 0 8 1 8 .i64 g01 = .ok (.lit 5, .int 5) := rfl

theorem checkRsxCert_refuses_lower_fuel0_g02 :
    checkRsxCert ctlEnv 0 8 4 0 tyNat1 g02 = .error "[rsx_cert_lower_fuel]" := rfl
theorem checkRsxCert_accepts_lower_fuel1_g02 :
    checkRsxCert ctlEnv 0 8 4 1 tyNat1 g02 = .ok (cZero, .inj 1 (.list [])) := rfl

theorem checkRsxCert_accepts_val_fuel_cap_succ :
    checkRsxCert ctlEnv 0 8 2 8 tyNat1 g03 =
      .ok (.app cSucc (.lit 4), .inj 2 (.list [.int 4])) := rfl

theorem checkRsxCert_accepts_erase_fuel_cap_succ :
    checkRsxCert ctlEnv 0 8 4 2 tyNat1 g03 =
      .ok (.app cSucc (.lit 4), .inj 2 (.list [.int 4])) := rfl

def vSucc5Zero : Expr Nat :=
  .app cSucc (.app cSucc (.app cSucc (.app cSucc (.app cSucc cZero))))
def wSucc5Zero : Val :=
  .inj 2 (.list [.inj 2 (.list [.inj 2 (.list [.inj 2 (.list [.inj 2 (.list [.inj 1 (.list [])])])])])])

theorem checkRsxCert_accepts_erase_val_fuel_cap_succ :
    checkRsxCert ctlEnv 0 8 8 6 (sumL 3 (sumL 3 (sumL 3 tyNat3))) eraseValCapTerm =
      .ok (vSucc5Zero, wSucc5Zero) := rfl

/-! ### Source-bound endpoint certificate checker (`RsxDeclAnchor`, `checkRsxBoundCert`) -/

structure RsxDeclAnchor where
  profile : String
  imports : List String
  declName : String
  numUnivs : Nat
  tyExpr : Expr Nat
  bodyExpr : Expr Nat
  deriving DecidableEq

theorem rsxDeclAnchor_ext {a b : RsxDeclAnchor}
    (hp : a.profile = b.profile)
    (hi : a.imports = b.imports)
    (hn : a.declName = b.declName)
    (hu : a.numUnivs = b.numUnivs)
    (ht : a.tyExpr = b.tyExpr)
    (hb : a.bodyExpr = b.bodyExpr) :
    a = b := by
  cases a; cases b
  simp only at hp hi hn hu ht hb
  subst hp; subst hi; subst hn; subst hu; subst ht; subst hb
  rfl

def checkRsxBoundCert (E : ResolvedEnv) (lf fv F : Nat) (t : BootTy)
    (anchor candidate : RsxDeclAnchor) : Except String (Expr Nat × Val) :=
  match decide (anchor.profile = candidate.profile) with
  | false => .error "[rsx_cert_profile_mismatch]"
  | true =>
    match decide (anchor.imports = candidate.imports) with
    | false => .error "[rsx_cert_imports_mismatch]"
    | true =>
      match decide (anchor.declName = candidate.declName) with
      | false => .error "[rsx_cert_name_mismatch]"
      | true =>
        match decide (anchor.numUnivs = candidate.numUnivs) with
        | false => .error "[rsx_cert_univs_mismatch]"
        | true =>
          match decide (anchor.tyExpr = candidate.tyExpr) with
          | false => .error "[rsx_cert_type_mismatch]"
          | true =>
            match decide (anchor.bodyExpr = candidate.bodyExpr) with
            | false => .error "[rsx_cert_body_mismatch]"
            | true =>
              match inferT E anchor.numUnivs [] candidate.bodyExpr with
              | none => .error "[rsx_cert_untyped]"
              | some T =>
                match decide (T = anchor.tyExpr) with
                | false => .error "[rsx_cert_inferred_type_mismatch]"
                | true =>
                  checkRsxCert E anchor.numUnivs lf fv F t candidate.bodyExpr

theorem checkRsxBoundCert_ok_inv {E : ResolvedEnv} {lf fv F : Nat} {t : BootTy}
    {anchor candidate : RsxDeclAnchor} {v : Expr Nat} {w : Val}
    (h : checkRsxBoundCert E lf fv F t anchor candidate = .ok (v, w)) :
    candidate = anchor ∧
    inferT E anchor.numUnivs [] anchor.bodyExpr = some anchor.tyExpr ∧
    checkRsxCert E anchor.numUnivs lf fv F t anchor.bodyExpr = .ok (v, w) := by
  unfold checkRsxBoundCert at h
  cases hp : decide (anchor.profile = candidate.profile) with
  | false => simp only [hp] at h; exact Except.noConfusion h
  | true =>
    simp only [hp] at h
    cases hi : decide (anchor.imports = candidate.imports) with
    | false => simp only [hi] at h; exact Except.noConfusion h
    | true =>
      simp only [hi] at h
      cases hn : decide (anchor.declName = candidate.declName) with
      | false => simp only [hn] at h; exact Except.noConfusion h
      | true =>
        simp only [hn] at h
        cases hu : decide (anchor.numUnivs = candidate.numUnivs) with
        | false => simp only [hu] at h; exact Except.noConfusion h
        | true =>
          simp only [hu] at h
          cases ht : decide (anchor.tyExpr = candidate.tyExpr) with
          | false => simp only [ht] at h; exact Except.noConfusion h
          | true =>
            simp only [ht] at h
            cases hb : decide (anchor.bodyExpr = candidate.bodyExpr) with
            | false => simp only [hb] at h; exact Except.noConfusion h
            | true =>
              simp only [hb] at h
              cases hinf : inferT E anchor.numUnivs [] candidate.bodyExpr with
              | none => simp only [hinf] at h; exact Except.noConfusion h
              | some T =>
                simp only [hinf] at h
                cases hteq : decide (T = anchor.tyExpr) with
                | false => simp only [hteq] at h; exact Except.noConfusion h
                | true =>
                  simp only [hteq] at h
                  have hcand : candidate = anchor :=
                    (rsxDeclAnchor_ext
                      (of_decide_eq_true hp) (of_decide_eq_true hi)
                      (of_decide_eq_true hn) (of_decide_eq_true hu)
                      (of_decide_eq_true ht) (of_decide_eq_true hb)).symm
                  have hT : T = anchor.tyExpr := of_decide_eq_true hteq
                  rw [hcand] at hinf h
                  rw [← hT]
                  exact ⟨hcand, hinf, h⟩

theorem checkRsxBoundCert_sound {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {lf fv F : Nat} {t : BootTy}
    {anchor candidate : RsxDeclAnchor} {v : Expr Nat} {w : Val}
    (h : checkRsxBoundCert E lf fv F t anchor candidate = .ok (v, w)) :
    candidate = anchor ∧
    inferT E anchor.numUnivs [] anchor.bodyExpr = some anchor.tyExpr ∧
    norm E lf anchor.bodyExpr = some v ∧
    scmValOf E fv v = some w ∧
    ∃ F₀, ∀ F', F₀ ≤ F' →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E anchor.numUnivs F' (S := S) t anchor.bodyExpr) = some w := by
  obtain ⟨hcand, hinf, hcert⟩ := checkRsxBoundCert_ok_inv h
  exact ⟨hcand, hinf, checkRsxCert_sound progs hcert⟩

def anchorG03 : RsxDeclAnchor where
  profile := "rsd-annot-1"
  imports := ["Core"]
