      ctlEnv_wf ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl rfl
      traceErasable_ctl_g04
  obtain ⟨lf, hev⟩ := hF (F₀ + 4) (Nat.le_add_right F₀ 4)
  dsimp only at hev
