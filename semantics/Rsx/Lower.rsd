  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hirr : irrelevant E n [] (.app (.const c lsc) (.lit nlit)) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  exact good_app_ctor_lit progs E n c nlit lsc hnone hirrC
    lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem good_const_delta_app_lit_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n r c nlit : Nat) (ls lsc : List Level)
    (hb : transparentBody E r ls = some (.app (.const c lsc) (.lit nlit)))
    (hnone : transparentBody E c lsc = none) :
    Good progs E n (.const r ls) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hv := norm_const_app_lit_val E lf r c nlit ls lsc hb hnone hn
  have hvinf' : inferT E n [] (.app (.const c lsc) (.lit nlit)) = some T := hv ▸ hvinf
  have hirrv' : irrelevant E n [] (.app (.const c lsc) (.lit nlit)) = false := hv ▸ hirrv
  have hirr : irrelevant E n [] (.const r ls) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hvinf' hirrv'
  exact good_const_delta_app_lit progs E n r c nlit ls lsc hb hnone hirr hirrC
    lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem good_beta_ctor_lit_wf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c nlit : Nat) (lsc : List Level) (A : Expr Nat)
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none) :
    Good progs E n (.app (.lam A (.app (.const c lsc) (.bvar 0))) (.lit nlit)) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hv := norm_beta_ctor_lit_val E lf c nlit lsc A hnone hn
  have hvinf' : inferT E n [] (.app (.const c lsc) (.lit nlit)) = some T := hv ▸ hvinf
  have hrel' : relevantSpine E n fv (.app (.const c lsc) (.lit nlit)) = true := hv ▸ hrel
  have hirr : irrelevant E n []
      (.app (.lam A (.app (.const c lsc) (.bvar 0))) (.lit nlit)) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrL : irrelevant E n [] (.lam A (.app (.const c lsc) (.bvar 0))) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  have hirrA : irrelevant E n (.assumption A :: [])
      (.app (.const c lsc) (.bvar 0)) = false :=
    irrelevant_body_false_of_beta hE hi hirr
  obtain ⟨_, _, hlam, _, _⟩ := inferT_app_some.mp hi
  obtain ⟨_, _, _, hbody, _⟩ := inferT_lam_some.mp hlam
  have hirrC : irrelevant E n (.assumption A :: []) (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hbody hirrA
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      have hrel1 :
          (!irrelevant E n [] (.lit nlit) &&
            relevantSpine E n m (.lit nlit)) = true := by
        simpa [relevantSpine, appsSpine, List.nil_append, List.all_cons,
          List.all_nil, Bool.and_true] using hrel'
      cases hirrF : irrelevant E n [] (.lit nlit) with
      | true =>
          simp only [hirrF, Bool.not_true, Bool.false_and] at hrel1
          exact Bool.noConfusion hrel1
      | false =>
          have hirrB : irrelevant E n (.assumption A :: []) (.bvar 0) = false :=
            irrelevant_bvar0_false_of_beta_ctor hE hi hvinf' hirrF
          exact good_beta_ctor_lit progs E n c nlit lsc A hnone
            hirr hirrL hirrA hirrC hirrB
            lf (m + 1) T v t w hB hi hD hn hs hrel hirrv hf hvinf her

/-! ### Let-beta equivalence on `whnfFuel`/`norm`/`inferT`/`irrelevant`, `erase_ctx_eq`,
    `Good → Good` composition combinators, and `ctlEnv` positive control proofs -/

theorem whnf_let_eq_beta (E : ResolvedEnv) (f : Nat) (A arg body : Expr Nat) :
    whnfFuel E f (.letE A arg body) = whnfFuel E f (.app (.lam A body) arg) := by
  cases f with
  | zero => rfl
  | succ k =>
      rw [whnf_zeta E k A arg body, whnf_beta E k A body arg]

theorem norm_let_eq_beta (E : ResolvedEnv) (lf : Nat) (A arg body : Expr Nat) :
    norm E lf (.letE A arg body) = norm E lf (.app (.lam A body) arg) := by
  cases lf with
  | zero => rfl
  | succ f =>
      unfold norm
      rw [whnf_let_eq_beta E f A arg body]

theorem inferT_let_eq_beta (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (A arg body : Expr Nat) :
    inferT E n Γ (.letE A arg body) = inferT E n Γ (.app (.lam A body) arg) := by
  cases h2 : inferT E n Γ (.app (.lam A body) arg) with
  | none =>
      cases h1 : inferT E n Γ (.letE A arg body) with
      | none => rfl
      | some T =>
          obtain ⟨u, B, hA, harg, hbody, hT⟩ := inferT_letE_some.mp h1
          have hbody' : inferT E n (.assumption A :: Γ) body = some B := by
            rw [← inferT_ctx_eq (E := E) (n := n) body (lookupType_let_eq_assumption A arg Γ)]
            exact hbody
          have h2' := inferT_app_some.mpr
            ⟨A, B, inferT_lam_some.mpr ⟨u, B, hA, hbody', rfl⟩, harg, hT⟩
          rw [h2] at h2'
          exact Option.noConfusion h2'
  | some T =>
      obtain ⟨A', B, hlam, harg, hT⟩ := inferT_app_some.mp h2
      obtain ⟨u, B', hA, hbody, hpi⟩ := inferT_lam_some.mp hlam
      injection hpi with hAA hBB
      rw [hAA] at harg
      rw [← hBB] at hbody
      have hbody' : inferT E n (.letBinding A arg :: Γ) body = some B := by
        rw [inferT_ctx_eq (E := E) (n := n) body (lookupType_let_eq_assumption A arg Γ)]
        exact hbody
      exact inferT_letE_some.mpr ⟨u, B, hA, harg, hbody', hT⟩

theorem irrelevant_let_eq_beta (E : ResolvedEnv) (n : Nat) (Γ : LCtx)
    (A arg body : Expr Nat) :
    irrelevant E n Γ (.letE A arg body) = irrelevant E n Γ (.app (.lam A body) arg) := by
  unfold irrelevant
  rw [inferT_let_eq_beta E n Γ A arg body]

theorem erase_ctx_eq {E : ResolvedEnv} {n : Nat} :
    ∀ (F : Nat) (e : Expr Nat) {Γ1 Γ2 : LCtx},
      (∀ i, lookupType Γ1 i = lookupType Γ2 i) →
      erase E n F Γ1 e = erase E n F Γ2 e
  | 0, _, _, _, _ => rfl
  | _ + 1, .sort _, _, _, _ => rfl
  | _ + 1, .pi _ _, _, _, _ => rfl
  | _ + 1, .lit _, _, _, _ => rfl
  | _ + 1, .bvar i, Γ1, Γ2, h => by
      simp only [erase, eraseWith, irrelevant_ctx_eq (.bvar i) h]
  | _ + 1, .const r ls, Γ1, Γ2, h => by
      simp only [erase, eraseWith, irrelevant_ctx_eq (.const r ls) h]
  | F + 1, .app g a, Γ1, Γ2, h => by
      simp only [erase, eraseWith, irrelevant_ctx_eq (.app g a) h]
      have ihg : eraseWith (irrelevant E n) noGlobals E F Γ1 g =
          eraseWith (irrelevant E n) noGlobals E F Γ2 g := erase_ctx_eq F g h
      have iha : eraseWith (irrelevant E n) noGlobals E F Γ1 a =
          eraseWith (irrelevant E n) noGlobals E F Γ2 a := erase_ctx_eq F a h
      rw [ihg, iha]
  | F + 1, .lam A b, Γ1, Γ2, h => by
      simp only [erase, eraseWith, irrelevant_ctx_eq (.lam A b) h]
      have ihb : eraseWith (irrelevant E n) noGlobals E F (.assumption A :: Γ1) b =
          eraseWith (irrelevant E n) noGlobals E F (.assumption A :: Γ2) b :=
        erase_ctx_eq F b (lookupType_cons_ext (.assumption A) h)
      rw [ihb]
  | F + 1, .letE A v b, Γ1, Γ2, h => by
      simp only [erase, eraseWith, irrelevant_ctx_eq (.letE A v b) h]
      have ihv : eraseWith (irrelevant E n) noGlobals E F Γ1 v =
          eraseWith (irrelevant E n) noGlobals E F Γ2 v := erase_ctx_eq F v h
      have ihb : eraseWith (irrelevant E n) noGlobals E F (.letBinding A v :: Γ1) b =
          eraseWith (irrelevant E n) noGlobals E F (.letBinding A v :: Γ2) b :=
        erase_ctx_eq F b (lookupType_cons_ext (.letBinding A v) h)
      rw [ihv, ihb]

theorem erase_letBinding_eq_assumption (E : ResolvedEnv) (n F : Nat) (A v : Expr Nat)
    (Γ : LCtx) (b : Expr Nat) :
    erase E n F (.letBinding A v :: Γ) b = erase E n F (.assumption A :: Γ) b :=
  erase_ctx_eq F b (lookupType_let_eq_assumption A v Γ)

theorem erasable_of_const_delta {E : ResolvedEnv} {n r : Nat} {ls : List Level} {b : Expr Nat}
    (hirr : irrelevant E n [] (.const r ls) = false)
    (hb : transparentBody E r ls = some b)
    (her : Erasable E n (.const r ls)) :
    Erasable E n b := by
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_const_delta E n F' r ls b hirr hb] at he
      exact ⟨F', l, he⟩

theorem erasable_of_app_keep {E : ResolvedEnv} {n : Nat} {g a : Expr Nat}
    (hirr : irrelevant E n [] (.app g a) = false)
    (her : Erasable E n (.app g a)) :
    Erasable E n g ∧ Erasable E n a := by
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_app_keep E n F' [] g a hirr] at he
      cases hg : erase E n F' [] g with
      | none =>
          rw [hg] at he
          exact Option.noConfusion he
      | some lg =>
          cases ha : erase E n F' [] a with
          | none =>
              rw [hg, ha] at he
              exact Option.noConfusion he
          | some la =>
              exact ⟨⟨F', lg, hg⟩, ⟨F', la, ha⟩⟩

theorem erasable_of_let_keep {E : ResolvedEnv} {n : Nat} {A v b : Expr Nat}
    (hirr : irrelevant E n [] (.letE A v b) = false)
    (her : Erasable E n (.letE A v b)) :
    Erasable E n v := by
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_let_keep E n F' [] A v b hirr] at he
      cases hv : erase E n F' [] v with
      | none =>
          rw [hv] at he
          exact Option.noConfusion he
      | some lv =>
          exact ⟨F', lv, hv⟩

theorem inferT_beta_id_arg_eq {E : ResolvedEnv} {n : Nat} {A arg T : Expr Nat}
    (hi : inferT E n [] (.app (.lam A (.bvar 0)) arg) = some T) :
    inferT E n [] arg = some T := by
  obtain ⟨A', B, hlam, harg, hT⟩ := inferT_app_some.mp hi
  obtain ⟨_, B', _, hbody, hpi⟩ := inferT_lam_some.mp hlam
  injection hpi with hAA hBB
  rw [hAA] at harg
  rw [← hBB] at hbody
  have hb0 : inferT E n (.assumption A :: []) (.bvar 0) = some (lift 0 1 A) := rfl
  rw [hb0] at hbody
  have hB : B = (lift 0 1 A) := (Option.some.inj hbody).symm
  have hTA : T = A := by
    rw [hT, hB, instantiate0, instantiate_lift_cancel 0 arg A]
  rwa [hTA]

theorem inferT_let_id_bound_eq {E : ResolvedEnv} {n : Nat} {A bound T : Expr Nat}
    (hi : inferT E n [] (.letE A bound (.bvar 0)) = some T) :
    inferT E n [] bound = some T := by
  rw [inferT_let_eq_beta E n [] A bound (.bvar 0)] at hi
  exact inferT_beta_id_arg_eq hi

theorem inferT_app_same_head_arg {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f a1 a2 T1 T2 : Expr Nat}
    (h1 : inferT E n Γ (.app f a1) = some T1)
    (h2 : inferT E n Γ (.app f a2) = some T2) :
    ∃ A B, inferT E n Γ f = some (.pi A B) ∧
      inferT E n Γ a1 = some A ∧ inferT E n Γ a2 = some A := by
  obtain ⟨A1, B1, hf1, ha1, _⟩ := inferT_app_some.mp h1
  obtain ⟨A2, B2, hf2, ha2, _⟩ := inferT_app_some.mp h2
  rw [hf1] at hf2
  injection (Option.some.inj hf2) with hA _
  rw [← hA] at ha2
  exact ⟨A1, B1, hf1, ha1, ha2⟩

theorem defunc_let_ctor (c : Nat) (la : LExpr) :
    defunc (.letE la (.app (.ctor c) (.bvar 0))) =
      (.letE (defunc la).1 (.apply (.ctor c) (.var 0)), (defunc la).2) := rfl

theorem run_let_ctor_val (F c : Nat) (la : LExpr) (dv : DVal)
    (hr : run (defunc la).2 (F + 1) [] (defunc la).1 = some dv) :
    run (defunc (.letE la (.app (.ctor c) (.bvar 0)))).2 (F + 3) []
      (defunc (.letE la (.app (.ctor c) (.bvar 0)))).1 = some (.ctor c [dv]) := by
  rw [defunc_let_ctor c la]
  dsimp only
  have hr2 : run (defunc la).2 (F + 2) [] (defunc la).1 = some dv :=
    run_mono (defunc la).2 (F + 1) (F + 2) [] (defunc la).1 dv (Nat.le_succ (F + 1)) hr
  rw [run_let_some (defunc la).2 (F + 2) [] (defunc la).1 (.apply (.ctor c) (.var 0)) dv hr2]
  exact run_apply_ctor_var (defunc la).2 F c dv

theorem lowerF_let_ctor_eval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n F lf c : Nat) (lsc : List Level) (A arg : Expr Nat)
    (t : BootTy) (w : Val)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hirr : irrelevant E n [] (.letE A arg (.app (.const c lsc) (.bvar 0))) = false)
    (hirrBody : irrelevant E n (.letBinding A arg :: [])
      (.app (.const c lsc) (.bvar 0)) = false)
    (hirrC : irrelevant E n (.letBinding A arg :: []) (.const c lsc) = false)
    (hirrB : irrelevant E n (.letBinding A arg :: []) (.bvar 0) = false)
    (la : LExpr)
    (ha : erase E n (F + 2) [] arg = some la)
    (dv : DVal)
    (hr : run (defunc la).2 (F + 1) [] (defunc la).1 = some dv)
    (he : Residua.Bootstrap.Semantics.eval lawsA progs lf []
        (emit (S := S) (G := []) (F + 2) t (.ctor c [dv])) = some w) :
    Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (lowerF E n (F + 4) (S := S) t
        (.letE A arg (.app (.const c lsc) (.bvar 0)))) = some w := by
  have hC : erase E n (F + 1) (.letBinding A arg :: []) (.const c lsc) =
      some (.ctor c) := by
    simp only [erase, eraseWith, hirrC, Bool.false_eq_true, if_false,
      noGlobals, hnone, hctor, if_true]
  have hB : erase E n (F + 1) (.letBinding A arg :: []) (.bvar 0) =
      some (.bvar 0) := by
    simp only [erase, eraseWith, hirrB, Bool.false_eq_true, if_false]
  have hBody : erase E n (F + 2) (.letBinding A arg :: [])
      (.app (.const c lsc) (.bvar 0)) =
      some (.app (.ctor c) (.bvar 0)) := by
    rw [erase_app_keep E n (F + 1) (.letBinding A arg :: [])
      (.const c lsc) (.bvar 0) hirrBody, hC, hB]
  have ha3 : erase E n (F + 3) [] arg = some la :=
    erase_mono E n (F + 2) (F + 3) [] arg la (Nat.le_succ (F + 2)) ha
  have hBody3 : erase E n (F + 3) (.letBinding A arg :: [])
      (.app (.const c lsc) (.bvar 0)) =
      some (.app (.ctor c) (.bvar 0)) :=
    erase_mono E n (F + 2) (F + 3) (.letBinding A arg :: [])
      (.app (.const c lsc) (.bvar 0)) (.app (.ctor c) (.bvar 0))
      (Nat.le_succ (F + 2)) hBody
  have hrun := run_let_ctor_val F c la dv hr
  have he3 : Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (emit (S := S) (G := []) (F + 3) t (.ctor c [dv])) = some w :=
    emitWith_evalStable relevantArgs progs lf [] (F + 2) (F + 3) t (.ctor c [dv]) w
      (Nat.le_succ (F + 2)) he
  exact lowerF_let_eval progs E n (F + 3) lf A arg (.app (.const c lsc) (.bvar 0)) t w
    hirr la (.app (.ctor c) (.bvar 0)) ha3 hBody3 (.ctor c [dv]) hrun he3

theorem norm_let_ctor_arg_of_norm (E : ResolvedEnv) (lf c : Nat) (lsc : List Level)
    (A arg v : Expr Nat) (hnone : transparentBody E c lsc = none)
    (hn : norm E lf (.letE A arg (.app (.const c lsc) (.bvar 0))) = some v) :
    ∃ k varg, lf = k + 3 ∧ norm E (k + 2) arg = some varg ∧
      v = .app (.const c lsc) varg := by
  rw [norm_let_eq_beta E lf A arg (.app (.const c lsc) (.bvar 0))] at hn
  exact norm_beta_ctor_arg_of_norm E lf c lsc A arg v hnone hn

theorem good_let_ctor_of_eval_wf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (A arg : Expr Nat)
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (harg : ∀ (lf fv : Nat) (v : Expr Nat) (t : BootTy) (w : Val),
      norm E lf arg = some v →
      scmValOf E fv v = some w →
      relevantSpine E n fv v = true →
      irrelevant E n [] v = false →
      valFits fv t w = true →
      ∃ F lf',
        Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF E n F (S := S) t arg) = some w) :
    Good progs E n (.letE A arg (.app (.const c lsc) (.bvar 0))) := by
  refine good_of_exists progs E n (.letE A arg (.app (.const c lsc) (.bvar 0))) ?_
  intro lf fv T v t w _ hi _ hn hs hrel hirrv hf hvinf _
  have hirr : irrelevant E n [] (.letE A arg (.app (.const c lsc) (.bvar 0))) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrBody : irrelevant E n (.letBinding A arg :: [])
      (.app (.const c lsc) (.bvar 0)) = false :=
    irrelevant_body_false_of_let hE hi hirr
  obtain ⟨_, B, _, _, hbody, _⟩ := inferT_letE_some.mp hi
  have hirrC : irrelevant E n (.letBinding A arg :: []) (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hbody hirrBody
  have hiBeta : inferT E n [] (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) = some T := by
    rw [← inferT_let_eq_beta E n [] A arg (.app (.const c lsc) (.bvar 0))]
    exact hi
  obtain ⟨k, varg, _, hargn, hv⟩ :=
    norm_let_ctor_arg_of_norm E lf c lsc A arg v hnone hn
  subst hv
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      cases m with
      | zero =>
          have hs0 : scmValOf E 1 (.app (.const c lsc) varg) = none := by
            simp only [scmValOf, appsSpine, List.nil_append, List.mapM_cons,
              List.mapM_nil, Option.bind, Option.pure_def]
            split
            · rename_i mm hm
              by_cases hc : mm.mclass = .constructorM
              · simp [hm, hc, scmValOf]
              · simp [hm, hc]
            · rename_i hm
              simp [hm]
          rw [hs0] at hs
          exact Option.noConfusion hs
      | succ q =>
          have hs' : (match E.members c with
              | some mm =>
                  if mm.mclass = .constructorM then
                    match List.mapM (scmValOf E (q + 1)) [varg] with
                    | some vs => some (.inj c (.list vs))
                    | none => none
                  else none
              | none => none) = some w := by
            simpa [scmValOf, appsSpine, List.nil_append] using hs
          cases hm : E.members c with
          | none =>
              simp only [hm] at hs'
              exact Option.noConfusion hs'
          | some mm =>
              simp only [hm] at hs'
              by_cases hcm : mm.mclass = .constructorM
              · simp only [hcm, ite_true] at hs'
                rw [List.mapM_cons, List.mapM_nil] at hs'
                cases hfield : scmValOf E (q + 1) varg with
                | none =>
                    simp only [hfield, Option.bind, Option.pure_def] at hs'
                    exact Option.noConfusion hs'
                | some wfield =>
                    simp only [hfield, Option.bind, Option.pure_def] at hs'
                    have hw : w = .inj c (.list [wfield]) := (Option.some.inj hs').symm
                    subst hw
                    have hctor : isCtor E c = true := by simp [isCtor, hm, hcm]
                    have hrel1 :
                        (!irrelevant E n [] varg &&
                          relevantSpine E n (q + 1) varg) = true := by
                      simpa [relevantSpine, appsSpine, List.nil_append, List.all_cons,
                        List.all_nil, Bool.and_true] using hrel
                    cases hirrF : irrelevant E n [] varg with
                    | true =>
                        simp only [hirrF, Bool.not_true, Bool.false_and] at hrel1
                        exact Bool.noConfusion hrel1
                    | false =>
                        simp only [hirrF, Bool.not_false, Bool.true_and] at hrel1
                        have hirrB : irrelevant E n (.letBinding A arg :: []) (.bvar 0) = false := by
                          rw [irrelevant_ctx_eq (.bvar 0) (lookupType_let_eq_assumption A arg [])]
                          exact irrelevant_bvar0_false_of_beta_ctor hE hiBeta hvinf hirrF
                        cases t with
                        | sum ts =>
                            have hf' : (match ts.get? c with
                                | some (.list τ) =>
                                    valFits (q + 1) τ wfield
                                | _ => false) = true := by
                              simpa [valFits, List.all_cons, List.all_nil, Bool.and_true]
                                using hf
                            split at hf'
                            · rename_i τ hg
                              obtain ⟨G, lfe, he⟩ :=
                                harg (k + 2) (q + 1) varg τ wfield hargn hfield hrel1
                                  hirrF hf'
                              unfold lowerF pipeline at he
                              cases ha : erase E n G [] arg with
                              | none =>
                                  simp only [ha] at he
                                  exact absurd he (eval_refuse_ne progs lfe [] wfield)
                              | some la =>
                                  simp only [ha] at he
                                  cases hr : run (defunc la).2 G [] (defunc la).1 with
                                  | none =>
                                      simp only [hr] at he
                                      exact absurd he (eval_refuse_ne progs lfe [] wfield)
                                  | some dv =>
                                      simp only [hr] at he
                                      cases G with
                                      | zero =>
                                          simp only [erase, eraseWith] at ha
                                          exact Option.noConfusion ha
                                      | succ F =>
                                          have ha2 : erase E n (F + 2) [] arg = some la :=
                                            erase_mono E n (F + 1) (F + 2) [] arg la
                                              (Nat.le_succ (F + 1)) ha
                                          have heC := eval_emit_ctor_one progs F lfe c ts τ
                                            dv wfield hg he
                                          exact ⟨F + 4, lfe,
                                            lowerF_let_ctor_eval progs E n F lfe c lsc A arg
                                              (.sum ts) (.inj c (.list [wfield])) hnone hctor
                                              hirr hirrBody hirrC hirrB la ha2 dv hr heC⟩
                            · exact Bool.noConfusion hf'
                        | i64 | bool | str | bytes | list _ | pair _ _ | record _ |
                          option _ | residue _ =>
                            simp only [valFits] at hf
                            exact Bool.noConfusion hf
              · simp only [hcm, ite_false] at hs'
                exact Option.noConfusion hs'

theorem good_let_ctor_lit_wf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c nlit : Nat) (lsc : List Level) (A : Expr Nat)
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none) :
    Good progs E n (.letE A (.lit nlit) (.app (.const c lsc) (.bvar 0))) := by
  refine good_let_ctor_of_eval_wf progs E n c lsc A (.lit nlit) hE hnone ?_
  intro lf fv v t w hn hs _ _ hf
  rw [norm_lit_val hn] at hs
  cases fv with
  | zero => exact Option.noConfusion hs
  | succ m =>
      have hs2 : scmValOf E (m + 1) (.lit nlit) = some (.int (Int.ofNat nlit)) := rfl
      rw [hs2] at hs
      cases hs
      cases t
      case i64 =>
          have hk : inI64Range (Int.ofNat nlit) = true := hf
          refine ⟨1, 1, ?_⟩
          rw [lowerF_lit, if_pos hk]
          exact eval_litI progs _ hk
      all_goals cases hf

/-! ### `ctlEnv` positive controls as universal `Good` theorems (`g01..g06`, `g11`) -/

theorem ctlNData : DataTy ctlEnv cN :=
  ⟨0, [], [], ⟨.inductiveM, 0, .sort (.succ .zero), none⟩, rfl, rfl, rfl⟩

/-! ### Code-table suffix monotonicity (`run_append_code`), multi-step weak-head
    reduction transport (`norm_of_whnf_steps`, `good_of_whnf_steps_and_run_eq`),
    recursive `Good → Good` combinators (`good_app_const_delta_of_good`,
    `good_beta_ctor_of_good_arg`, `good_let_ctor_of_good_arg`), binary constructor
    slice (`good_app_ctor2_lit_any`), and remaining `ctlEnv` positive controls
    (`g07..g10`, `g12..g14`) -/

theorem list_get?_append_of_some {α : Type} :
    ∀ (xs ys : List α) (i : Nat) (x : α),
      xs.get? i = some x → (xs ++ ys).get? i = some x
  | [], _, _, _, h => Option.noConfusion h
  | _ :: _, _, 0, _, h => h
  | _ :: xs, ys, i + 1, x, h => list_get?_append_of_some xs ys i x h

theorem run_glob_eq (code : List Code) (F l : Nat) (env : List DVal) :
    run code (F + 1) env (.glob l) =
      match code.get? l with
      | some c => run code F [] c.body
      | none => none := by
  unfold run
  rfl

theorem run_append_code (code ext : List Code) :
    ∀ (F : Nat) (env : List DVal) (e : DExpr) (dv : DVal),
      run code F env e = some dv →
      run (code ++ ext) F env e = some dv := by
  intro F
  induction F with
  | zero =>
      intro env e dv h
      unfold run runWith at h
      exact Option.noConfusion h
  | succ F ih =>
      intro env e dv h
      cases e with
      | var i =>
          rw [run_var_eq] at h ⊢
          exact h
      | box =>
          rw [run_box_eq] at h ⊢
          exact h
      | lit k =>
          rw [run_lit_eq] at h ⊢
          exact h
      | ctor r =>
          rw [run_ctor_eq] at h ⊢
          exact h
      | rigid r =>
          rw [run_rigid_eq] at h ⊢
          exact h
      | clo l caps =>
          rw [run_clo_eq] at h ⊢
          exact h
      | glob l =>
          rw [run_glob_eq] at h ⊢
          cases hc : code.get? l with
          | none =>
              rw [hc] at h
              exact Option.noConfusion h
          | some c =>
              rw [hc] at h
              rw [list_get?_append_of_some code ext l c hc]
              exact ih [] c.body dv h
      | apply g a =>
          rw [run_apply_eq] at h ⊢
          cases hg : run code F env g with
          | none =>
              rw [hg] at h
              exact Option.noConfusion h
          | some vg =>
              rw [hg] at h
              rw [ih env g vg hg]
              cases ha : run code F env a with
              | none =>
                  rw [ha] at h
                  cases vg <;> exact Option.noConfusion h
              | some va =>
                  rw [ha] at h
                  rw [ih env a va ha]
                  cases vg with
                  | box => exact h
                  | lit _ => exact Option.noConfusion h
                  | ctor r args => exact h
                  | rigid r args => exact h
                  | clo l caps =>
                      have h' : (match code.get? l with
                          | some c => run code F (bindArg va caps) c.body
                          | none => none) = some dv := h
                      change (match (code ++ ext).get? l with
                          | some c => run (code ++ ext) F (bindArg va caps) c.body
                          | none => none) = some dv
                      cases hc : code.get? l with
                      | none =>
                          rw [hc] at h'
                          exact Option.noConfusion h'
                      | some c =>
                          rw [hc] at h'
                          rw [list_get?_append_of_some code ext l c hc]
                          exact ih (bindArg va caps) c.body dv h'
      | letE v b =>
          rw [run_let_eq] at h ⊢
          cases hv : run code F env v with
          | none =>
              rw [hv] at h
              exact Option.noConfusion h
          | some vv =>
              rw [hv] at h
              rw [ih env v vv hv]
              exact ih (vv :: env) b dv h

theorem run_defunc_let_step (F : Nat) (lv lb : LExpr) (dv : DVal)
    (hv : run (defunc lv).2 F [] (defunc lv).1 = some dv) :
    run (defunc (.letE lv lb)).2 (F + 1) [] (defunc (.letE lv lb)).1 =
      run (convWith capRen (liftRen id) (defunc lv).2 lb).2 F [dv]
        (convWith capRen (liftRen id) (defunc lv).2 lb).1 := by
  obtain ⟨ext, hext⟩ := convWith_suffix capRen (liftRen id) (defunc lv).2 lb
  have hv' : run (convWith capRen (liftRen id) (defunc lv).2 lb).2 F []
      (defunc lv).1 = some dv := by
    rw [hext]
    exact run_append_code (defunc lv).2 ext F [] (defunc lv).1 dv hv
  exact run_let_some (convWith capRen (liftRen id) (defunc lv).2 lb).2 F []
    (defunc lv).1 (convWith capRen (liftRen id) (defunc lv).2 lb).1 dv hv'

theorem whnfFuel_mono_le (E : ResolvedEnv) (e w : Expr Nat) :
    ∀ {a b : Nat}, a ≤ b → whnfFuel E a e = some w → whnfFuel E b e = some w
  | _, 0, hle, h => by
      have ha : _ = 0 := Nat.eq_zero_of_le_zero hle
      subst ha
      exact h
  | a, b + 1, hle, h => by
      by_cases hab : a ≤ b
      · exact whnfFuel_mono E b e w (whnfFuel_mono_le E e w hab h)
      · have heq : a = b + 1 := by omega
        subst heq
        exact h

theorem norm_mono_le (E : ResolvedEnv) (e v : Expr Nat) :
    ∀ {a b : Nat}, a ≤ b → norm E a e = some v → norm E b e = some v
  | _, 0, hle, h => by
      have ha : _ = 0 := Nat.eq_zero_of_le_zero hle
      subst ha
      exact h
  | a, b + 1, hle, h => by
      by_cases hab : a ≤ b
      · exact norm_mono E b e v (norm_mono_le E e v hab h)
      · have heq : a = b + 1 := by omega
        subst heq
        exact h

theorem norm_unique (E : ResolvedEnv) (f1 f2 : Nat) (e v1 v2 : Expr Nat)
    (h1 : norm E f1 e = some v1) (h2 : norm E f2 e = some v2) :
    v1 = v2 := by
  have h1' : norm E (f1 + f2) e = some v1 :=
    norm_mono_le E e v1 (Nat.le_add_right f1 f2) h1
  have h2' : norm E (f1 + f2) e = some v2 :=
    norm_mono_le E e v2 (Nat.le_add_left f2 f1) h2
  rw [h1'] at h2'
  exact Option.some.inj h2'

theorem norm_of_whnf_steps (E : ResolvedEnv) (d lf : Nat) (e1 e2 v : Expr Nat)
    (hsteps : ∀ m, whnfFuel E (m + d) e1 = whnfFuel E m e2)
    (hn : norm E lf e1 = some v) :
    norm E lf e2 = some v := by
  cases lf with
  | zero =>
      rw [norm_fuel0] at hn
      exact Option.noConfusion hn
  | succ f =>
      cases hw : whnfFuel E f e1 with
      | none =>
          unfold norm at hn
          rw [hw] at hn
          exact Option.noConfusion hn
      | some w =>
          by_cases hdf : d ≤ f
          · have hsub : (f - d) + d = f := Nat.sub_add_cancel hdf
            have hw2 : whnfFuel E (f - d) e2 = some w := by
              rw [← hsteps (f - d), hsub]
              exact hw
            have hw2' : whnfFuel E f e2 = some w :=
              whnfFuel_mono_le E e2 w (Nat.sub_le f d) hw2
            unfold norm at hn ⊢
            rw [hw] at hn
            rw [hw2']
            exact hn
          · have hfd : f ≤ d := Nat.le_of_not_le hdf
            have hwd : whnfFuel E d e1 = some w :=
              whnfFuel_mono_le E e1 w hfd hw
            have h0 := hsteps 0
            rw [Nat.zero_add, whnfFuel_fuel0] at h0
            rw [h0] at hwd
            exact Option.noConfusion hwd

theorem lowerF_eq_of_erase_run {S : SigTable} (E : ResolvedEnv) (n F : Nat)
    (t : BootTy) (e : Expr Nat) (l : LExpr) (dv : DVal)
    (he : erase E n F [] e = some l)
    (hr : run (defunc l).2 F [] (defunc l).1 = some dv) :
    lowerF E n F (S := S) t e = emit (S := S) (G := []) F t dv := by
  unfold lowerF pipeline
  simp only [he, hr]

theorem erase_app_const_delta (E : ResolvedEnv) (n F r : Nat) (ls : List Level)
    (f arg : Expr Nat) (lf la : LExpr)
    (hb : transparentBody E r ls = some f)
    (hirrApp : irrelevant E n [] (.app (.const r ls) arg) = false)
    (hirrC : irrelevant E n [] (.const r ls) = false)
    (hf : erase E n F [] f = some lf)
    (ha : erase E n F [] arg = some la) :
    erase E n (F + 2) [] (.app (.const r ls) arg) = some (.app lf la) := by
  have hc : erase E n (F + 1) [] (.const r ls) = some lf := by
    rw [erase_const_delta E n F r ls f hirrC hb]
    exact hf
  have ha' : erase E n (F + 1) [] arg = some la :=
    erase_mono E n F (F + 1) [] arg la (Nat.le_succ F) ha
  rw [erase_app_keep E n (F + 1) [] (.const r ls) arg hirrApp, hc, ha']

theorem inferT_beta_ctor_arg {E : ResolvedEnv} {n c : Nat}
    {lsc : List Level} {A arg varg T : Expr Nat} (hE : EnvClosed E)
    (hi : inferT E n [] (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) = some T)
    (hvinf : inferT E n [] (.app (.const c lsc) varg) = some T) :
    inferT E n [] arg = some A ∧ inferT E n [] varg = some A := by
  obtain ⟨A', B, hlam, harg_ty, _⟩ := inferT_app_some.mp hi
  obtain ⟨u, B', hA, hbody, hpi⟩ := inferT_lam_some.mp hlam
  injection hpi with hAA _
  rw [hAA] at harg_ty
  obtain ⟨Ac, Bc, hc_assump, hb0, _⟩ := inferT_app_some.mp hbody
  have hb0_eq : inferT E n (.assumption A :: []) (.bvar 0) = some (lift 0 1 A) := rfl
  rw [hb0_eq] at hb0
  have hAc : Ac = lift 0 1 A := (Option.some.inj hb0).symm
  obtain ⟨Av, Bv, hc_nil, hvarg_ty, _⟩ := inferT_app_some.mp hvinf
  have hcind := inferT_const_indep (E := E) (n := n) (.assumption A :: []) [] c lsc
  rw [hc_assump, hc_nil] at hcind
  injection (Option.some.inj hcind) with hAv _
  have hAv_eq : Av = lift 0 1 A := hAv.symm.trans hAc
  obtain ⟨m, hm, _, _, hTy⟩ := inferT_const_some.mp hc_nil
  have hclPi : closedAt 0 (.pi Av Bv) = true := by
    rw [hTy, closedAt_instantiateLevels]
    exact closedAt_member (envSubst_of_envClosed hE) hm 0
  simp only [closedAt, Bool.and_eq_true] at hclPi
  have hclLift : closedAt 0 (lift 0 1 A) = true := hAv_eq ▸ hclPi.1
  have hclA : closedAt 0 A = true := closedAt_of_lift_one A 0 hclLift
  have hAvA : Av = A := hAv_eq.trans (lift_id_of_closedAt A 0 1 hclA)
  rw [hAvA] at hvarg_ty
  exact ⟨harg_ty, hvarg_ty⟩

theorem good_beta_discard_irr_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n kbody : Nat) (A arg : Expr Nat)
    (hirrA : irrelevant E n [] arg = true) (hl : ∀ k, arg ≠ .lit k) :
    Good progs E n (.app (.lam A (.lit kbody)) arg) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hirr : irrelevant E n [] (.app (.lam A (.lit kbody)) arg) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrL : irrelevant E n [] (.lam A (.lit kbody)) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  exact good_beta_discard_irr progs E n kbody A arg hirr hirrL hirrA hl
    lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem good_let_discard_irr_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n kbody : Nat) (A bound : Expr Nat)
    (hirrB : irrelevant E n [] bound = true) (hl : ∀ k, bound ≠ .lit k) :
    Good progs E n (.letE A bound (.lit kbody)) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hirr : irrelevant E n [] (.letE A bound (.lit kbody)) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  exact good_let_discard_irr progs E n kbody A bound hirr hirrB hl
    lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem norm_app_ctor2_lit (E : ResolvedEnv) (k c n1 n2 : Nat) (lsc : List Level)
    (hnone : transparentBody E c lsc = none) :
    norm E (k + 3) (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
      some (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) := by
  have hwb : whnfFuel E (k + 2) (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
      some (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) := by
    simp only [whnfFuel, appsSpine, List.nil_append, List.cons_append, hnone]
  have hlit1 : norm E (k + 2) (.lit n1) = some (.lit n1) := by
    have hw1 : whnfFuel E (k + 1) (.lit n1) = some (.lit n1) := by
      simp only [whnfFuel, appsSpine]
    unfold norm
    rw [hw1]
  have hlit2 : norm E (k + 2) (.lit n2) = some (.lit n2) := by
    have hw2 : whnfFuel E (k + 1) (.lit n2) = some (.lit n2) := by
      simp only [whnfFuel, appsSpine]
    unfold norm
    rw [hw2]
  unfold norm
  rw [hwb]
  have hsp : appsSpine (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
      (.const c lsc, [.lit n1, .lit n2]) := by
    simp only [appsSpine, List.nil_append, List.cons_append]
  simp only [hsp]
  have hm : [.lit n1, .lit n2].mapM (norm E (k + 2)) = some [.lit n1, .lit n2] := by
    rw [List.mapM_cons, hlit1, List.mapM_cons, hlit2, List.mapM_nil]
    rfl
  simp only [hm, foldApps]

theorem norm_app_ctor2_lit_val (E : ResolvedEnv) (lf c n1 n2 : Nat) (lsc : List Level)
    {v : Expr Nat}
    (hnone : transparentBody E c lsc = none)
    (hn : norm E lf (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) = some v) :
    v = .app (.app (.const c lsc) (.lit n1)) (.lit n2) := by
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ lf =>
    cases lf with
    | zero =>
      unfold norm at hn
      rw [whnfFuel_fuel0] at hn
      exact Option.noConfusion hn
    | succ lf =>
      cases lf with
      | zero =>
        have hwb : whnfFuel E 1 (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
            some (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) := by
          simp only [whnfFuel, appsSpine, List.nil_append, List.cons_append, hnone]
        have hlit0 : norm E 1 (.lit n1) = none := by
          unfold norm
          rw [whnfFuel_fuel0]
        unfold norm at hn
        rw [hwb] at hn
        have hsp : appsSpine (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
            (.const c lsc, [.lit n1, .lit n2]) := by
          simp only [appsSpine, List.nil_append, List.cons_append]
        simp only [hsp] at hn
        rw [List.mapM_cons, hlit0] at hn
        exact Option.noConfusion hn
      | succ j =>
        rw [norm_app_ctor2_lit E j c n1 n2 lsc hnone] at hn
        exact (Option.some.inj hn).symm

theorem eval_emit_ctor2_lit {S : SigTable} (progs : Programs S S) (n1 n2 r : Nat)
    (ts : List BootTy) (hg : ts.get? r = some (.list .i64))
    (hk1 : inI64Range (Int.ofNat n1) = true)
    (hk2 : inI64Range (Int.ofNat n2) = true) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) 3 (.sum ts) (.ctor r [.lit n1, .lit n2])) =
      some (.inj r (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)])) := by
  obtain ⟨hlt, hget⟩ := list_get?_some ts r _ hg
  simp only [emit, emitWith]
  rw [dif_pos hlt]
  split
  · rename_i τ' hτ'
    have hτi : τ' = .i64 :=
      BootTy.list.inj (hτ'.symm.trans hget)
    subst hτi
    simp only [Residua.Bootstrap.Semantics.eval]
    rw [eval_cast_eq progs _ [] hτ'.symm]
    simp only [Residua.Bootstrap.Semantics.eval, relevantArgs, listOf, emitWith]
    rw [if_pos hk1, if_pos hk2]
    simp [Residua.Bootstrap.Semantics.eval, hk1, hk2]
    have hk1' : inI64Range (↑n1) = true := hk1
    have hk2' : inI64Range (↑n2) = true := hk2
    rw [if_pos hk1', if_pos hk2']
    rfl
  · rename_i hne
    exact absurd hget (hne .i64)

theorem good_app_ctor2_lit_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c n1 n2 : Nat) (lsc : List Level)
    (hnone : transparentBody E c lsc = none) :
    Good progs E n (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) := by
  refine good_of_exists progs E n (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) ?_
  intro lf fv T v t w _ hi _ hn hs _ hval hf hvinf _
  have hirr : irrelevant E n [] (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) = false :=
    irrelevant_false_of_same_type hi hvinf hval
  have hirr1 : irrelevant E n [] (.app (.const c lsc) (.lit n1)) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  obtain ⟨_, _, h1, _, _⟩ := inferT_app_some.mp hi
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr h1 hirr1
  have hv := norm_app_ctor2_lit_val E lf c n1 n2 lsc hnone hn
  subst hv
  cases fv with
  | zero => exact Option.noConfusion hs
  | succ m =>
    cases m with
    | zero =>
      have hs0 : scmValOf E 1 (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) = none := by
        simp only [scmValOf, appsSpine, List.nil_append, List.cons_append, List.mapM_cons,
          List.mapM_nil, Option.bind, Option.pure_def]
        split
        · rename_i mm hm
          by_cases hc : mm.mclass = .constructorM
          · simp [hm, hc, scmValOf]
          · simp [hm, hc]
        · rename_i hm
          simp [hm]
      rw [hs0] at hs
      exact Option.noConfusion hs
    | succ q =>
      have hlit1 : scmValOf E (q + 1) (.lit n1) = some (.int (Int.ofNat n1)) := rfl
      have hlit2 : scmValOf E (q + 1) (.lit n2) = some (.int (Int.ofNat n2)) := rfl
      have hs' : (match E.members c with
          | some mm =>
              if mm.mclass = .constructorM then
                some (.inj c (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)]))
              else none
          | none => none) = some w := by
        simpa [scmValOf, appsSpine, List.nil_append, List.cons_append, List.mapM_cons,
          List.mapM_nil, hlit1, hlit2, Option.bind, Option.pure_def] using hs
      cases hm : E.members c with
      | none =>
        rw [hm] at hs'
        exact Option.noConfusion hs'
      | some mm =>
        rw [hm] at hs'
        by_cases hcm : mm.mclass = .constructorM
        · simp [hcm] at hs'
          subst hs'
          cases t with
          | sum ts =>
            have hf' : (match ts.get? c with
                | some (.list τ) =>
                    ([.int (Int.ofNat n1), .int (Int.ofNat n2)] : List Val).all
                      (valFits (q + 1) τ)
                | _ => false) = true := hf
            split at hf'
            · rename_i τ hg
              cases τ with
              | i64 =>
                simp only [valFits, List.all_cons, List.all_nil, Bool.and_true,
                  Bool.and_eq_true] at hf'
                have hctor : isCtor E c = true := by simp [isCtor, hm, hcm]
                have he : erase E n 3 []
                    (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
                    some (.app (.app (.ctor c) (.lit n1)) (.lit n2)) := by
                  simp only [erase, eraseWith, hirr, hirr1, hirrC, Bool.false_eq_true,
                    if_false, noGlobals, hnone, hctor, if_true]
                have hlow : lowerF E n 3 (S := S) (.sum ts)
                    (.app (.app (.const c lsc) (.lit n1)) (.lit n2)) =
                    emit 3 (.sum ts) (.ctor c [.lit n1, .lit n2]) := by
                  unfold lowerF pipeline
                  rw [he]
                  rfl
                have hbody : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                    (lowerF E n 3 (S := S) (.sum ts)
                      (.app (.app (.const c lsc) (.lit n1)) (.lit n2))) =
                    some (.inj c (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)])) := by
                  rw [hlow]
                  exact eval_emit_ctor2_lit progs n1 n2 c ts hg hf'.1 hf'.2
                exact ⟨3, 1, hbody⟩
              | bool | str | bytes | list _ | pair _ _ | sum _ | record _ | option _ | residue _ =>
                simp only [valFits, List.all_cons, List.all_nil] at hf'
                exact Bool.noConfusion hf'
            · exact Bool.noConfusion hf'
          | _ => cases hf
        · simp [hcm] at hs'

theorem whnf_ctl_g08 (m : Nat) :
    whnfFuel ctlEnv (m + 2) g08 = whnfFuel ctlEnv m (.lit 9) := by
  have h1 : whnfFuel ctlEnv (m + 2) g08 =
      whnfFuel ctlEnv (m + 1) (.app (.lam cN (.bvar 0)) (.lit 9)) :=
    whnf_beta_spine ctlEnv (m + 1) (.sort (.succ .zero))
      (.lam (.bvar 0) (.bvar 0)) cN [.lit 9]
  rw [h1]
  exact whnf_beta ctlEnv m cN (.bvar 0) (.lit 9)

theorem whnf_ctl_g09 (m : Nat) :
    whnfFuel ctlEnv (m + 2) g09 = whnfFuel ctlEnv m (.app cSucc (.lit 1)) := by
  have h1 : whnfFuel ctlEnv (m + 2) g09 =
      whnfFuel ctlEnv (m + 1) (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 1)) :=
    whnf_beta ctlEnv (m + 1) (.pi cN cN) (.app (.bvar 0) (.lit 1))
      (.lam cN (.app cSucc (.bvar 0)))
  rw [h1]
  exact whnf_beta ctlEnv m cN (.app cSucc (.bvar 0)) (.lit 1)

theorem whnf_ctl_g10 (m : Nat) :
    whnfFuel ctlEnv (m + 2) g10 =
      whnfFuel ctlEnv m (.app (.app cMk (.lit 2)) (.lit 1)) := by
  have h1 : whnfFuel ctlEnv (m + 2) g10 =
      whnfFuel ctlEnv (m + 1)
        (.app (.lam cN (.app (.app cMk (.bvar 0)) (.lit 1))) (.lit 2)) :=
    whnf_beta_spine ctlEnv (m + 1) cN
      (.lam cN (.app (.app cMk (.bvar 0)) (.bvar 1))) (.lit 1) [.lit 2]
  rw [h1]
  exact whnf_beta ctlEnv m cN (.app (.app cMk (.bvar 0)) (.lit 1)) (.lit 2)

theorem whnf_ctl_g12_body (m : Nat) :
    whnfFuel ctlEnv (m + 1)
      (.app (.lam cN (.app cSucc (.app cSucc (.bvar 0)))) (.lit 0)) =
      whnfFuel ctlEnv m (.app cSucc (.app cSucc (.lit 0))) :=
  whnf_beta ctlEnv m cN (.app cSucc (.app cSucc (.bvar 0))) (.lit 0)

theorem whnf_ctl_g13 (m : Nat) :
    whnfFuel ctlEnv (m + 2) g13 =
      whnfFuel ctlEnv m
        (.app cSucc (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0))) := by
  have h1 : whnfFuel ctlEnv (m + 2) g13 =
      whnfFuel ctlEnv (m + 1)
        (.app (.lam cN (.app cSucc (.bvar 0)))
          (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0))) :=
    whnf_zeta ctlEnv (m + 1) (.pi cN cN) (.lam cN (.app cSucc (.bvar 0)))
      (.app (.bvar 0) (.app (.bvar 0) (.lit 0)))
  rw [h1]
  exact whnf_beta ctlEnv m cN (.app cSucc (.bvar 0))
    (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0))

theorem whnf_ctl_g14 (m : Nat) :
    whnfFuel ctlEnv (m + 1) g14 = whnfFuel ctlEnv m (.app cSucc cZero) :=
  whnf_beta ctlEnv m cTrue (.app cSucc cZero) (.const 14 [])

/-! ### Spine-level β/ζ/δ typing preservation, closed-cutoff context independence
    (`inferT_ctx_eq_of_closedAt`, `closedAt_of_inferT`, `irrelevant_ctx_eq_of_closedAt`,
    `erase_ctx_eq_of_closedAt`), closedness of erased (`closedAtL`) and
    defunctionalized (`closedAtD`) terms, and general β/ζ discard `Good → Good`
    combinators (`good_let_discard_of_good`, `good_beta_discard_of_good`) -/

theorem inferT_beta_some {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A b a T : Expr Nat}
    (h : inferT E n [] (.app (.lam A b) a) = some T) :
    inferT E n [] (instantiate0 a b) = some T := by
  obtain ⟨A', B, hlam, ha, hT⟩ := inferT_app_some.mp h
  obtain ⟨u, B', hA, hb, hpi⟩ := inferT_lam_some.mp hlam
  injection hpi with hAA hBB
  rw [hAA] at ha
  rw [← hBB] at hb
  rw [hT]
  exact (inferT_beta hE hA hb ha).2

theorem inferT_zeta_some {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A v b T : Expr Nat}
    (h : inferT E n [] (.letE A v b) = some T) :
    inferT E n [] (instantiate0 v b) = some T := by
  rw [inferT_let_eq_beta E n [] A v b] at h
  exact inferT_beta_some hE h

theorem inferT_foldApps_congr {E : ResolvedEnv} {n : Nat} {f f' : Expr Nat}
    (hff' : ∀ T, inferT E n [] f = some T → inferT E n [] f' = some T) :
    ∀ (args : List (Expr Nat)) (T : Expr Nat),
      inferT E n [] (foldApps f args) = some T →
      inferT E n [] (foldApps f' args) = some T
  | [], T, h => hff' T h
  | a :: args, T, h => by
      refine inferT_foldApps_congr (f := .app f a) (f' := .app f' a) ?_ args T h
      intro T1 h1
      obtain ⟨A, B, hf, ha, hT1⟩ := inferT_app_some.mp h1
      exact inferT_app_some.mpr ⟨A, B, hff' (.pi A B) hf, ha, hT1⟩

theorem inferT_beta_spine_some {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A b a : Expr Nat} {args : List (Expr Nat)} {T : Expr Nat}
    (h : inferT E n [] (foldApps (.lam A b) (a :: args)) = some T) :
    inferT E n [] (foldApps (instantiate0 a b) args) = some T :=
  inferT_foldApps_congr (fun _ h0 => inferT_beta_some hE h0) args T h

theorem inferT_zeta_spine_some {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A v b : Expr Nat} {args : List (Expr Nat)} {T : Expr Nat}
    (h : inferT E n [] (foldApps (.letE A v b) args) = some T) :
    inferT E n [] (foldApps (instantiate0 v b) args) = some T :=
  inferT_foldApps_congr (fun _ h0 => inferT_zeta_some hE h0) args T h

theorem inferT_delta_spine_some {E : ResolvedEnv} {n r : Nat} {ls : List Level}
    {b : Expr Nat} {args : List (Expr Nat)} {T : Expr Nat}
    (hTy : ∀ T0, inferT E n [] (.const r ls) = some T0 → inferT E n [] b = some T0)
    (h : inferT E n [] (foldApps (.const r ls) args) = some T) :
    inferT E n [] (foldApps b args) = some T :=
  inferT_foldApps_congr hTy args T h

theorem irrelevant_false_of_instantiate0 {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A a e Te : Expr Nat}
    (ha : inferT E n [] a = some A)
    (he : inferT E n (.assumption A :: []) e = some Te)
    (hirr : irrelevant E n [] (instantiate0 a e) = false) :
    irrelevant E n (.assumption A :: []) e = false ∧
      irrelevant E n (.letBinding A a :: []) e = false := by
  have hinst := inferT_instantiate hE a A ha [] e Te he
  simp only [List.nil_append, List.length_nil, substPrefix] at hinst
  rw [lift_zero_amount a 0] at hinst
  have hinst0 : inferT E n [] (instantiate0 a e) = some (instantiate0 a Te) := by
    simpa [instantiate0] using hinst
  obtain ⟨hAr, hProp⟩ := irrelevant_of_inferT_false hinst0 hirr
  have hArTe : isArity Te = false := isArity_false_of_instantiate0 rfl hAr
  have h1 : irrelevant E n (.assumption A :: []) e = false := by
    unfold irrelevant
    rw [he]
    dsimp only
    rw [hArTe, Bool.false_or]
    cases hTeU : inferT E n (.assumption A :: []) Te with
    | none => rfl
    | some U =>
        dsimp only
        cases hU : isPropSort U with
        | false => rfl
        | true =>
            have hU0 : U = .sort .zero := isPropSort_eq_true hU
            subst hU0
            have hinstT := inferT_instantiate hE a A ha [] Te (.sort .zero) hTeU
            simp only [List.nil_append, List.length_nil, substPrefix] at hinstT
            rw [lift_zero_amount a 0] at hinstT
            have hTU : inferT E n [] (instantiate0 a Te) = some (.sort .zero) := by
              simpa [instantiate0] using hinstT
            exact hProp (.sort .zero) hTU
  refine ⟨h1, ?_⟩
  rw [irrelevant_ctx_eq e (lookupType_let_eq_assumption A a [])]
  exact h1

theorem lookupType_cons_ext_lt (d : LocalDecl) {Γ1 Γ2 : LCtx} {c : Nat}
    (h : ∀ i < c, lookupType Γ1 i = lookupType Γ2 i) :
    ∀ i < c + 1, lookupType (d :: Γ1) i = lookupType (d :: Γ2) i
  | 0, _ => rfl
  | j + 1, hlt => by
      rw [lookupType_cons_succ, lookupType_cons_succ, h j (Nat.lt_of_succ_lt_succ hlt)]

theorem inferT_ctx_eq_of_closedAt {E : ResolvedEnv} {n : Nat} :
    ∀ (e : Expr Nat) (c : Nat) {Γ1 Γ2 : LCtx},
      closedAt c e = true →
      (∀ i < c, lookupType Γ1 i = lookupType Γ2 i) →
      inferT E n Γ1 e = inferT E n Γ2 e
  | .sort l, _, _, _, _, _ => by rw [inferT_sort, inferT_sort]
  | .bvar i, c, _, _, hcl, h => by
      have hi : i < c := by simpa [closedAt, decide_eq_true_eq] using hcl
      rw [inferT_bvar, inferT_bvar, h i hi]
  | .const r ls, _, Γ1, Γ2, _, _ => inferT_const_indep Γ1 Γ2 r ls
  | .lit t, _, Γ1, Γ2, _, _ => inferT_lit_indep t Γ1 Γ2
  | .app f a, c, Γ1, Γ2, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      have ihf := inferT_ctx_eq_of_closedAt (E := E) (n := n) f c hcl.1 h
      have iha := inferT_ctx_eq_of_closedAt (E := E) (n := n) a c hcl.2 h
      cases h2 : inferT E n Γ2 (.app f a) with
      | none =>
          cases h1 : inferT E n Γ1 (.app f a) with
          | none => rfl
          | some T =>
              obtain ⟨A, B, hf, ha, hT⟩ := inferT_app_some.mp h1
              rw [ihf] at hf
              rw [iha] at ha
              have h2' := inferT_app_some.mpr ⟨A, B, hf, ha, hT⟩
              rw [h2] at h2'
              exact Option.noConfusion h2'
      | some T =>
          obtain ⟨A, B, hf, ha, hT⟩ := inferT_app_some.mp h2
          rw [← ihf] at hf
          rw [← iha] at ha
          exact inferT_app_some.mpr ⟨A, B, hf, ha, hT⟩
  | .pi A B, c, Γ1, Γ2, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      have ihA := inferT_ctx_eq_of_closedAt (E := E) (n := n) A c hcl.1 h
      have ihB := inferT_ctx_eq_of_closedAt (E := E) (n := n) B (c + 1) hcl.2
        (lookupType_cons_ext_lt (.assumption A) h)
      cases h2 : inferT E n Γ2 (.pi A B) with
      | none =>
          cases h1 : inferT E n Γ1 (.pi A B) with
          | none => rfl
          | some T =>
              obtain ⟨u, v, hA, hB, hT⟩ := inferT_pi_some.mp h1
              rw [ihA] at hA
              rw [ihB] at hB
              have h2' := inferT_pi_some.mpr ⟨u, v, hA, hB, hT⟩
              rw [h2] at h2'
              exact Option.noConfusion h2'
      | some T =>
          obtain ⟨u, v, hA, hB, hT⟩ := inferT_pi_some.mp h2
          rw [← ihA] at hA
          rw [← ihB] at hB
          exact inferT_pi_some.mpr ⟨u, v, hA, hB, hT⟩
  | .lam A b, c, Γ1, Γ2, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      have ihA := inferT_ctx_eq_of_closedAt (E := E) (n := n) A c hcl.1 h
      have ihb := inferT_ctx_eq_of_closedAt (E := E) (n := n) b (c + 1) hcl.2
        (lookupType_cons_ext_lt (.assumption A) h)
      cases h2 : inferT E n Γ2 (.lam A b) with
      | none =>
          cases h1 : inferT E n Γ1 (.lam A b) with
          | none => rfl
          | some T =>
              obtain ⟨u, B, hA, hb, hT⟩ := inferT_lam_some.mp h1
              rw [ihA] at hA
              rw [ihb] at hb
              have h2' := inferT_lam_some.mpr ⟨u, B, hA, hb, hT⟩
              rw [h2] at h2'
              exact Option.noConfusion h2'
      | some T =>
          obtain ⟨u, B, hA, hb, hT⟩ := inferT_lam_some.mp h2
          rw [← ihA] at hA
          rw [← ihb] at hb
          exact inferT_lam_some.mpr ⟨u, B, hA, hb, hT⟩
  | .letE A v b, c, Γ1, Γ2, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      have ihA := inferT_ctx_eq_of_closedAt (E := E) (n := n) A c hcl.1.1 h
      have ihv := inferT_ctx_eq_of_closedAt (E := E) (n := n) v c hcl.1.2 h
      have ihb := inferT_ctx_eq_of_closedAt (E := E) (n := n) b (c + 1) hcl.2
        (lookupType_cons_ext_lt (.letBinding A v) h)
      cases h2 : inferT E n Γ2 (.letE A v b) with
      | none =>
          cases h1 : inferT E n Γ1 (.letE A v b) with
          | none => rfl
          | some T =>
              obtain ⟨u, B, hA, hv, hb, hT⟩ := inferT_letE_some.mp h1
              rw [ihA] at hA
              rw [ihv] at hv
              rw [ihb] at hb
              have h2' := inferT_letE_some.mpr ⟨u, B, hA, hv, hb, hT⟩
              rw [h2] at h2'
              exact Option.noConfusion h2'
      | some T =>
          obtain ⟨u, B, hA, hv, hb, hT⟩ := inferT_letE_some.mp h2
          rw [← ihA] at hA
          rw [← ihv] at hv
          rw [← ihb] at hb
          exact inferT_letE_some.mpr ⟨u, B, hA, hv, hb, hT⟩

theorem inferT_closed0_ctx_indep {E : ResolvedEnv} {n : Nat} (e : Expr Nat)
    (Γ1 Γ2 : LCtx) (hcl : closedAt 0 e = true) :
    inferT E n Γ1 e = inferT E n Γ2 e :=
  inferT_ctx_eq_of_closedAt e 0 hcl (fun _ hi => absurd hi (Nat.not_lt_zero _))

theorem closedAt_instantiate_le :
    ∀ (e : Expr Nat) (c k : Nat) (v : Expr Nat),
      k ≤ c →
      closedAt (c + 1) e = true →
      closedAt c v = true →
      closedAt c (instantiate k v e) = true
  | .bvar j, c, k, v, hkc, he, hv => by
      have hlt : j < c + 1 := by simpa [closedAt, decide_eq_true_eq] using he
      by_cases heq : j = k
      · simp only [instantiate, if_pos heq]
        exact hv
      · by_cases hgt : k < j
        · simp only [instantiate, if_neg heq, if_pos hgt]
          cases j with
          | zero => exact absurd hgt (Nat.not_lt_zero k)
          | succ j' =>
              rw [Nat.add_sub_cancel j' 1]
              simp only [closedAt, decide_eq_true_eq]
              exact Nat.lt_of_succ_lt_succ hlt
        · simp only [instantiate, if_neg heq, if_neg hgt, closedAt, decide_eq_true_eq]
          have hle : j ≤ k := Nat.not_lt.mp hgt
          have hjk : j < k := Nat.lt_of_le_of_ne hle heq
          exact Nat.lt_of_lt_of_le hjk hkc
  | .sort _, _, _, _, _, _, _ => rfl
  | .const _ _, _, _, _, _, _, _ => rfl
  | .lit _, _, _, _, _, _, _ => rfl
  | .app f x, c, k, v, hkc, he, hv => by
      simp only [closedAt, Bool.and_eq_true] at he
      simp only [instantiate, closedAt,
        closedAt_instantiate_le f c k v hkc he.1 hv,
        closedAt_instantiate_le x c k v hkc he.2 hv, Bool.and_self]
  | .lam a b, c, k, v, hkc, he, hv => by
      simp only [closedAt, Bool.and_eq_true] at he
      have hb := closedAt_instantiate_le b (c + 1) (k + 1) (lift 0 1 v)
        (Nat.succ_le_succ hkc) he.2 (closedAt_lift v c 0 hv)
      simp only [instantiate, closedAt,
        closedAt_instantiate_le a c k v hkc he.1 hv, hb, Bool.and_self]
  | .pi a b, c, k, v, hkc, he, hv => by
      simp only [closedAt, Bool.and_eq_true] at he
      have hb := closedAt_instantiate_le b (c + 1) (k + 1) (lift 0 1 v)
        (Nat.succ_le_succ hkc) he.2 (closedAt_lift v c 0 hv)
      simp only [instantiate, closedAt,
        closedAt_instantiate_le a c k v hkc he.1 hv, hb, Bool.and_self]
  | .letE a v0 b, c, k, v, hkc, he, hv => by
      simp only [closedAt, Bool.and_eq_true] at he
      have hb := closedAt_instantiate_le b (c + 1) (k + 1) (lift 0 1 v)
        (Nat.succ_le_succ hkc) he.2 (closedAt_lift v c 0 hv)
      simp only [instantiate, closedAt,
        closedAt_instantiate_le a c k v hkc he.1.1 hv,
        closedAt_instantiate_le v0 c k v hkc he.1.2 hv, hb, Bool.and_self]

theorem closedAt_member_body {E : ResolvedEnv} (hS : EnvSubst E) {r : Nat}
    {m : CheckedMember} {b : Expr Nat}
    (hm : E.members r = some m) (hb : m.body = some b) (c : Nat) :
    closedAt c b = true := by
  apply closedAt_of_instantiateLift b c 0
  intro w
  rw [lift_zero_idx]
  exact (hS r m hm).2 b hb w c

theorem closedAt_transparentBody {E : ResolvedEnv} (hE : EnvClosed E)
    {r : Nat} {ls : List Level} {b : Expr Nat}
    (hb : transparentBody E r ls = some b) (c : Nat) :
    closedAt c b = true := by
  have hS : EnvSubst E := envSubst_of_envClosed hE
  unfold transparentBody at hb
  cases hm : E.members r with
  | none =>
      rw [hm] at hb
      exact Option.noConfusion hb
  | some m =>
      rw [hm] at hb
      dsimp only at hb
      by_cases htr : transparent m.mclass = true
      · rw [if_pos htr] at hb
        cases hbody : m.body with
        | none =>
            rw [hbody] at hb
            exact Option.noConfusion hb
        | some b0 =>
            rw [hbody] at hb
            have hb_eq : b = instantiateLevels ls b0 := (Option.some.inj hb).symm
            rw [hb_eq, closedAt_instantiateLevels]
            exact closedAt_member_body hS hm hbody c
      · rw [if_neg htr] at hb
        exact Option.noConfusion hb

theorem lookupType_cons_closedAt {Γ : LCtx} {c : Nat} {A : Expr Nat}
    (hA : closedAt c A = true)
    (hΓ : ∀ i < c, ∀ B, lookupType Γ i = some B → closedAt c B = true) :
    ∀ d : LocalDecl, (d = .assumption A ∨ ∃ v, d = .letBinding A v) →
      ∀ i < c + 1, ∀ B, lookupType (d :: Γ) i = some B → closedAt (c + 1) B = true := by
  intro d hd i hi B hlook
  cases i with
  | zero =>
      rcases hd with rfl | ⟨v, rfl⟩
      · simp only [lookupType, List.get?_cons_zero] at hlook
        have hB : B = lift 0 1 A := (Option.some.inj hlook).symm
        rw [hB]
        exact closedAt_lift A c 0 hA
      · simp only [lookupType, List.get?_cons_zero] at hlook
        have hB : B = lift 0 1 A := (Option.some.inj hlook).symm
        rw [hB]
        exact closedAt_lift A c 0 hA
  | succ j =>
      have hj : j < c := Nat.lt_of_succ_lt_succ hi
      rw [lookupType_cons_succ] at hlook
      cases h0 : lookupType Γ j with
      | none =>
          rw [h0] at hlook
          exact Option.noConfusion hlook
      | some A0 =>
          rw [h0, Option.map] at hlook
          have hB : B = lift 0 1 A0 := (Option.some.inj hlook).symm
          rw [hB]
          exact closedAt_lift A0 c 0 (hΓ j hj A0 h0)

theorem closedAt_of_inferT {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E) :
    ∀ (e : Expr Nat) (c : Nat) (Γ : LCtx) (T : Expr Nat),
      closedAt c e = true →
      (∀ i < c, ∀ B, lookupType Γ i = some B → closedAt c B = true) →
      inferT E n Γ e = some T →
      closedAt c T = true
  | .sort l, _, Γ, T, _, _, he => by
      rw [inferT_sort] at he
      have hT : T = .sort (.succ l) := (Option.some.inj he).symm
      subst hT
      rfl
  | .bvar i, c, Γ, T, hcl, hΓ, he => by
      have hi : i < c := by simpa [closedAt, decide_eq_true_eq] using hcl
      rw [inferT_bvar] at he
      exact hΓ i hi T he
  | .const r ls, c, _, T, _, _, he => by
      obtain ⟨m, hm, _, _, hT⟩ := inferT_const_some.mp he
      rw [hT, closedAt_instantiateLevels]
      exact closedAt_member (envSubst_of_envClosed hE) hm c
  | .lit t, c, Γ, T, _, _, he => by
      have h0 := closedAt_inferT_lit (envSubst_of_envClosed hE) t Γ T he
      exact closedAt_mono T 0 c (Nat.zero_le c) h0
  | .pi _ _, _, _, T, _, _, he => by
      obtain ⟨u, v, _, _, hT⟩ := inferT_pi_some.mp he
      subst hT
      rfl
  | .lam A b, c, Γ, T, hcl, hΓ, he => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      obtain ⟨_, B, _, hb, hT⟩ := inferT_lam_some.mp he
      subst hT
      simp only [closedAt, hcl.1, Bool.true_and]
      exact closedAt_of_inferT hE b (c + 1) (.assumption A :: Γ) B hcl.2
        (lookupType_cons_closedAt hcl.1 hΓ (.assumption A) (Or.inl rfl)) hb
  | .app f a, c, Γ, T, hcl, hΓ, he => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      obtain ⟨A, B, hf, _, hT⟩ := inferT_app_some.mp he
      subst hT
      have hclPi := closedAt_of_inferT hE f c Γ (.pi A B) hcl.1 hΓ hf
      simp only [closedAt, Bool.and_eq_true] at hclPi
      exact closedAt_instantiate_le B c 0 a (Nat.zero_le c) hclPi.2 hcl.2
  | .letE A v b, c, Γ, T, hcl, hΓ, he => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      obtain ⟨_, B, _, _, hb, hT⟩ := inferT_letE_some.mp he
      subst hT
      have hclB := closedAt_of_inferT hE b (c + 1) (.letBinding A v :: Γ) B hcl.2
        (lookupType_cons_closedAt hcl.1.1 hΓ (.letBinding A v) (Or.inr ⟨v, rfl⟩)) hb
      exact closedAt_instantiate_le B c 0 v (Nat.zero_le c) hclB hcl.1.2

theorem closedAt_of_inferT_closed0 {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {Γ : LCtx} {e T : Expr Nat}
    (hcl : closedAt 0 e = true)
    (he : inferT E n Γ e = some T) :
    closedAt 0 T = true :=
  closedAt_of_inferT hE e 0 Γ T hcl (fun _ hi => absurd hi (Nat.not_lt_zero _)) he

theorem irrelevant_ctx_eq_of_closedAt {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    (e : Expr Nat) (c : Nat) {Γ1 Γ2 : LCtx}
    (hcl : closedAt c e = true)
    (hΓ : ∀ i < c, ∀ B, lookupType Γ2 i = some B → closedAt c B = true)
    (h : ∀ i < c, lookupType Γ1 i = lookupType Γ2 i) :
    irrelevant E n Γ1 e = irrelevant E n Γ2 e := by
  unfold irrelevant
  rw [inferT_ctx_eq_of_closedAt (E := E) (n := n) e c hcl h]
  cases hT : inferT E n Γ2 e with
  | none => rfl
  | some T =>
      dsimp only
      have hclT : closedAt c T = true :=
        closedAt_of_inferT hE e c Γ2 T hcl hΓ hT
      rw [inferT_ctx_eq_of_closedAt (E := E) (n := n) T c hclT h]

theorem irrelevant_closed0_ctx_indep {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    (e : Expr Nat) (Γ1 Γ2 : LCtx) (hcl : closedAt 0 e = true) :
    irrelevant E n Γ1 e = irrelevant E n Γ2 e :=
  irrelevant_ctx_eq_of_closedAt hE e 0 hcl
    (fun _ hi => absurd hi (Nat.not_lt_zero _))
    (fun _ hi => absurd hi (Nat.not_lt_zero _))

theorem erase_ctx_eq_of_closedAt {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E) :
    ∀ (F : Nat) (e : Expr Nat) (c : Nat) {Γ1 Γ2 : LCtx},
      closedAt c e = true →
      (∀ i < c, ∀ B, lookupType Γ2 i = some B → closedAt c B = true) →
      (∀ i < c, lookupType Γ1 i = lookupType Γ2 i) →
      erase E n F Γ1 e = erase E n F Γ2 e
  | 0, _, _, _, _, _, _, _ => rfl
  | _ + 1, .sort _, _, _, _, _, _, _ => rfl
  | _ + 1, .pi _ _, _, _, _, _, _, _ => rfl
  | _ + 1, .lit _, _, _, _, _, _, _ => rfl
  | _ + 1, .bvar i, c, Γ1, Γ2, hcl, hΓ, h => by
      simp only [erase, eraseWith,
        irrelevant_ctx_eq_of_closedAt (n := n) hE (.bvar i) c hcl hΓ h]
  | _ + 1, .const r ls, c, Γ1, Γ2, hcl, hΓ, h => by
      simp only [erase, eraseWith,
        irrelevant_ctx_eq_of_closedAt (n := n) hE (.const r ls) c hcl hΓ h]
  | F + 1, .app g a, c, Γ1, Γ2, hcl, hΓ, h => by
      have hirr := irrelevant_ctx_eq_of_closedAt (n := n) hE (.app g a) c hcl hΓ h
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith, hirr]
      have ihg : eraseWith (irrelevant E n) noGlobals E F Γ1 g =
          eraseWith (irrelevant E n) noGlobals E F Γ2 g :=
        erase_ctx_eq_of_closedAt (n := n) hE F g c hcl.1 hΓ h
      have iha : eraseWith (irrelevant E n) noGlobals E F Γ1 a =
          eraseWith (irrelevant E n) noGlobals E F Γ2 a :=
        erase_ctx_eq_of_closedAt (n := n) hE F a c hcl.2 hΓ h
      rw [ihg, iha]
  | F + 1, .lam A b, c, Γ1, Γ2, hcl, hΓ, h => by
      have hirr := irrelevant_ctx_eq_of_closedAt (n := n) hE (.lam A b) c hcl hΓ h
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith, hirr]
      have ihb : eraseWith (irrelevant E n) noGlobals E F (.assumption A :: Γ1) b =
          eraseWith (irrelevant E n) noGlobals E F (.assumption A :: Γ2) b :=
        erase_ctx_eq_of_closedAt (n := n) hE F b (c + 1) hcl.2
          (lookupType_cons_closedAt hcl.1 hΓ (.assumption A) (Or.inl rfl))
          (lookupType_cons_ext_lt (.assumption A) h)
      rw [ihb]
  | F + 1, .letE A v b, c, Γ1, Γ2, hcl, hΓ, h => by
      have hirr := irrelevant_ctx_eq_of_closedAt (n := n) hE (.letE A v b) c hcl hΓ h
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith, hirr]
      have ihv : eraseWith (irrelevant E n) noGlobals E F Γ1 v =
          eraseWith (irrelevant E n) noGlobals E F Γ2 v :=
        erase_ctx_eq_of_closedAt (n := n) hE F v c hcl.1.2 hΓ h
      have ihb : eraseWith (irrelevant E n) noGlobals E F (.letBinding A v :: Γ1) b =
          eraseWith (irrelevant E n) noGlobals E F (.letBinding A v :: Γ2) b :=
        erase_ctx_eq_of_closedAt (n := n) hE F b (c + 1) hcl.2
          (lookupType_cons_closedAt hcl.1.1 hΓ (.letBinding A v) (Or.inr ⟨v, rfl⟩))
          (lookupType_cons_ext_lt (.letBinding A v) h)
      rw [ihv, ihb]

theorem erase_closed0_ctx_indep {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    (F : Nat) (e : Expr Nat) (Γ1 Γ2 : LCtx) (hcl : closedAt 0 e = true) :
    erase E n F Γ1 e = erase E n F Γ2 e :=
  erase_ctx_eq_of_closedAt hE F e 0 hcl
    (fun _ hi => absurd hi (Nat.not_lt_zero _))
    (fun _ hi => absurd hi (Nat.not_lt_zero _))

def closedAtL (c : Nat) : LExpr → Bool
  | .bvar i => decide (i < c)
  | .app f a => closedAtL c f && closedAtL c a
  | .lam b => closedAtL (c + 1) b
  | .letE v b => closedAtL c v && closedAtL (c + 1) b
  | _ => true

theorem closedAtL_mono :
    ∀ (l : LExpr) (c d : Nat), c ≤ d → closedAtL c l = true → closedAtL d l = true
  | .bvar i, c, d, hle, h => by
      have hlt : i < c := by simpa [closedAtL, decide_eq_true_eq] using h
      simp only [closedAtL, decide_eq_true_eq]
      exact Nat.lt_of_lt_of_le hlt hle
  | .box, _, _, _, _ => rfl
  | .lit _, _, _, _, _ => rfl
  | .ctor _, _, _, _, _ => rfl
  | .rigid _, _, _, _, _ => rfl
  | .glob _, _, _, _, _ => rfl
  | .app f a, c, d, hle, h => by
      simp only [closedAtL, Bool.and_eq_true] at h ⊢
      exact ⟨closedAtL_mono f c d hle h.1, closedAtL_mono a c d hle h.2⟩
  | .lam b, c, d, hle, h => by
      simp only [closedAtL] at h ⊢
      exact closedAtL_mono b (c + 1) (d + 1) (Nat.succ_le_succ hle) h
  | .letE v b, c, d, hle, h => by
      simp only [closedAtL, Bool.and_eq_true] at h ⊢
      exact ⟨closedAtL_mono v c d hle h.1,
        closedAtL_mono b (c + 1) (d + 1) (Nat.succ_le_succ hle) h.2⟩

theorem closedAtL_erase {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E) :
    ∀ (F : Nat) (c : Nat) (Γ : LCtx) (e : Expr Nat) (l : LExpr),
      closedAt c e = true →
      erase E n F Γ e = some l →
      closedAtL c l = true
  | 0, _, _, _, _, _, h => Option.noConfusion h
  | _ + 1, _, _, .sort _, _, _, h => by
      simp only [erase, eraseWith] at h
      cases h
      rfl
  | _ + 1, _, _, .pi _ _, _, _, h => by
      simp only [erase, eraseWith] at h
      cases h
      rfl
  | _ + 1, _, _, .lit _, _, _, h => by
      simp only [erase, eraseWith] at h
      cases h
      rfl
  | _ + 1, c, Γ, .bvar i, l, hcl, h => by
      simp only [erase, eraseWith] at h
      cases hi : irrelevant E n Γ (.bvar i)
      · simp only [hi, Bool.false_eq_true, if_false] at h
        cases h
        exact hcl
      · simp only [hi, if_true] at h
        cases h
        rfl
  | F + 1, c, Γ, .const r ls, l, _, h => by
      simp only [erase, eraseWith] at h
      cases hi : irrelevant E n Γ (.const r ls)
      · simp only [hi, Bool.false_eq_true, if_false, noGlobals] at h
        cases hb : transparentBody E r ls with
        | none =>
            rw [hb] at h
            cases hctor : isCtor E r
            · simp only [hctor, ite_false] at h
              cases h
              rfl
            · simp only [hctor, ite_true] at h
              cases h
              rfl
        | some b =>
            rw [hb] at h
            have hclb : closedAt 0 b = true := closedAt_transparentBody hE hb 0
            have h0 : closedAtL 0 l = true := closedAtL_erase hE F 0 [] b l hclb h
            exact closedAtL_mono l 0 c (Nat.zero_le c) h0
      · simp only [hi, if_true] at h
        cases h
        rfl
  | F + 1, c, Γ, .app g a, l, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith] at h
      cases hi : irrelevant E n Γ (.app g a)
      · simp only [hi, Bool.false_eq_true, if_false] at h
        cases hg : eraseWith (irrelevant E n) noGlobals E F Γ g with
        | none =>
            simp only [hg] at h
            exact Option.noConfusion h
        | some g' =>
            cases ha : eraseWith (irrelevant E n) noGlobals E F Γ a with
            | none =>
                simp only [hg, ha] at h
                exact Option.noConfusion h
            | some a' =>
                simp only [hg, ha] at h
                cases h
                simp only [closedAtL, Bool.and_eq_true]
                exact ⟨closedAtL_erase hE F c Γ g g' hcl.1 hg,
                  closedAtL_erase hE F c Γ a a' hcl.2 ha⟩
      · simp only [hi, if_true] at h
        cases h
        rfl
  | F + 1, c, Γ, .lam A b, l, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith] at h
      cases hi : irrelevant E n Γ (.lam A b)
      · simp only [hi, Bool.false_eq_true, if_false] at h
        cases hb : eraseWith (irrelevant E n) noGlobals E F (.assumption A :: Γ) b with
        | none =>
            simp only [hb, Option.map] at h
            exact Option.noConfusion h
        | some b' =>
            simp only [hb, Option.map] at h
            cases h
            simp only [closedAtL]
            exact closedAtL_erase hE F (c + 1) (.assumption A :: Γ) b b' hcl.2 hb
      · simp only [hi, if_true] at h
        cases h
        rfl
  | F + 1, c, Γ, .letE A v b, l, hcl, h => by
      simp only [closedAt, Bool.and_eq_true] at hcl
      simp only [erase, eraseWith] at h
      cases hi : irrelevant E n Γ (.letE A v b)
      · simp only [hi, Bool.false_eq_true, if_false] at h
        cases hv : eraseWith (irrelevant E n) noGlobals E F Γ v with
        | none =>
            simp only [hv] at h
            exact Option.noConfusion h
        | some v' =>
            cases hb : eraseWith (irrelevant E n) noGlobals E F (.letBinding A v :: Γ) b with
            | none =>
                simp only [hv, hb] at h
                exact Option.noConfusion h
            | some b' =>
                simp only [hv, hb] at h
                cases h
                simp only [closedAtL, Bool.and_eq_true]
                exact ⟨closedAtL_erase hE F c Γ v v' hcl.1.2 hv,
                  closedAtL_erase hE F (c + 1) (.letBinding A v :: Γ) b b' hcl.2 hb⟩
      · simp only [hi, if_true] at h
        cases h
        rfl

theorem freeVars_eq_nil_of_closedAtL :
    ∀ (l : LExpr) (c : Nat), closedAtL c l = true → freeVars c l = []
  | .bvar i, c, h => by
      have hlt : i < c := by simpa [closedAtL, decide_eq_true_eq] using h
      have hnle : ¬ c ≤ i := Nat.not_le.mpr hlt
      simp only [freeVars, hnle, ite_false]
  | .box, _, _ => rfl
  | .lit _, _, _ => rfl
  | .ctor _, _, _ => rfl
  | .rigid _, _, _ => rfl
  | .glob _, _, _ => rfl
  | .app f a, c, h => by
      simp only [closedAtL, Bool.and_eq_true] at h
      simp only [freeVars, freeVars_eq_nil_of_closedAtL f c h.1,
        freeVars_eq_nil_of_closedAtL a c h.2]
      rfl
  | .lam b, c, h => by
      simp only [closedAtL] at h
      simp only [freeVars, freeVars_eq_nil_of_closedAtL b (c + 1) h]
  | .letE v b, c, h => by
      simp only [closedAtL, Bool.and_eq_true] at h
      simp only [freeVars, freeVars_eq_nil_of_closedAtL v c h.1,
        freeVars_eq_nil_of_closedAtL b (c + 1) h.2]
      rfl

theorem mem_addUniq {xs : List Nat} {x y : Nat} (h : y ∈ addUniq xs x) :
    y ∈ xs ∨ y = x := by
  unfold addUniq at h
  split at h
  · exact Or.inl h
  · simp only [List.mem_append, List.mem_singleton] at h
    exact h

theorem mem_unionL :
    ∀ (ys xs : List Nat) {z : Nat}, z ∈ unionL xs ys → z ∈ xs ∨ z ∈ ys
  | [], _, _, h => Or.inl h
  | y :: ys, xs, z, h => by
      unfold unionL at h
      simp only [List.foldl_cons] at h
      rcases mem_unionL ys (addUniq xs y) h with h1 | h2
      · rcases mem_addUniq h1 with h1' | rfl
        · exact Or.inl h1'
        · exact Or.inr (List.mem_cons_self _ _)
      · exact Or.inr (List.mem_cons_of_mem _ h2)

theorem nat_sub_lt_of_lt_add :
    ∀ (d i c : Nat), d ≤ i → i < c + d → i - d < c
  | 0, i, c, _, hlt => by
      simpa only [Nat.add_zero, Nat.sub_zero] using hlt
  | d + 1, 0, _, hle, _ =>
      absurd hle (Nat.not_le_of_gt (Nat.zero_lt_succ d))
  | d + 1, i + 1, c, hle, hlt => by
      rw [Nat.succ_sub_succ i d]
      exact nat_sub_lt_of_lt_add d i c (Nat.le_of_succ_le_succ hle)
        (Nat.lt_of_succ_lt_succ hlt)

theorem freeVars_lt_of_closedAtL :
    ∀ (l : LExpr) (c d : Nat),
      closedAtL (c + d) l = true →
      ∀ x ∈ freeVars d l, x < c
  | .bvar i, c, d, hcl, x, hx => by
      have hlt : i < c + d := by simpa [closedAtL, decide_eq_true_eq] using hcl
      simp only [freeVars] at hx
      by_cases hle : d ≤ i
      · simp only [hle, ite_true, List.mem_singleton] at hx
        subst hx
        exact nat_sub_lt_of_lt_add d i c hle hlt
      · simp only [hle, ite_false] at hx
        nomatch hx
  | .box, _, _, _, _, hx => nomatch hx
  | .lit _, _, _, _, _, hx => nomatch hx
  | .ctor _, _, _, _, _, hx => nomatch hx
  | .rigid _, _, _, _, _, hx => nomatch hx
  | .glob _, _, _, _, _, hx => nomatch hx
  | .app f a, c, d, hcl, x, hx => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      simp only [freeVars] at hx
      rcases mem_unionL (freeVars d a) (freeVars d f) hx with hf | ha
      · exact freeVars_lt_of_closedAtL f c d hcl.1 x hf
      · exact freeVars_lt_of_closedAtL a c d hcl.2 x ha
  | .lam b, c, d, hcl, x, hx => by
      simp only [closedAtL] at hcl
      simp only [freeVars] at hx
      exact freeVars_lt_of_closedAtL b c (d + 1) hcl x hx
  | .letE v b, c, d, hcl, x, hx => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      simp only [freeVars] at hx
      rcases mem_unionL (freeVars (d + 1) b) (freeVars d v) hx with hv | hb
      · exact freeVars_lt_of_closedAtL v c d hcl.1 x hv
      · exact freeVars_lt_of_closedAtL b c (d + 1) hcl.2 x hb

theorem list_map_eq_of_mem {α β : Type} (f g : α → β) :
    ∀ (xs : List α), (∀ x ∈ xs, f x = g x) → xs.map f = xs.map g
  | [], _ => rfl
  | x :: xs, h => by
      simp only [List.map_cons]
      rw [h x (List.mem_cons_self x xs),
        list_map_eq_of_mem f g xs (fun y hy => h y (List.mem_cons_of_mem x hy))]

theorem convWith_ren_eq_of_closedAtL (cr : List Nat → Nat → Nat) :
    ∀ (l : LExpr) (c : Nat) (ρ1 ρ2 : Nat → Nat) (code : List Code),
      closedAtL c l = true →
      (∀ i < c, ρ1 i = ρ2 i) →
      convWith cr ρ1 code l = convWith cr ρ2 code l
  | .bvar i, c, ρ1, ρ2, code, hcl, hρ => by
      have hi : i < c := by simpa [closedAtL, decide_eq_true_eq] using hcl
      simp only [convWith, hρ i hi]
  | .box, _, _, _, _, _, _ => rfl
  | .lit _, _, _, _, _, _, _ => rfl
  | .ctor _, _, _, _, _, _, _ => rfl
  | .rigid _, _, _, _, _, _, _ => rfl
  | .glob _, _, _, _, _, _, _ => rfl
  | .app f a, c, ρ1, ρ2, code, hcl, hρ => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      have ihf := convWith_ren_eq_of_closedAtL cr f c ρ1 ρ2 code hcl.1 hρ
      have iha := convWith_ren_eq_of_closedAtL cr a c ρ1 ρ2 (convWith cr ρ2 code f).2 hcl.2 hρ
      simp only [convWith, ihf, iha]
  | .lam b, c, ρ1, ρ2, code, hcl, hρ => by
      simp only [closedAtL] at hcl
      have hmap : (freeVars 1 b).map ρ1 = (freeVars 1 b).map ρ2 :=
        list_map_eq_of_mem ρ1 ρ2 (freeVars 1 b)
          (fun x hx => hρ x (freeVars_lt_of_closedAtL b c 1 hcl x hx))
      simp only [convWith, hmap]
  | .letE v b, c, ρ1, ρ2, code, hcl, hρ => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      have ihv := convWith_ren_eq_of_closedAtL cr v c ρ1 ρ2 code hcl.1 hρ
      have hρ' : ∀ i < c + 1, liftRen ρ1 i = liftRen ρ2 i := by
        intro i hi
        cases i with
        | zero => rfl
        | succ j =>
            simp only [liftRen]
            exact congrArg (· + 1) (hρ j (Nat.lt_of_succ_lt_succ hi))
      have ihb := convWith_ren_eq_of_closedAtL cr b (c + 1) (liftRen ρ1) (liftRen ρ2)
        (convWith cr ρ2 code v).2 hcl.2 hρ'
      simp only [convWith, ihv, ihb]

theorem convWith_closed0_ren_indep (cr : List Nat → Nat → Nat)
    (l : LExpr) (ρ1 ρ2 : Nat → Nat) (code : List Code)
    (hcl : closedAtL 0 l = true) :
    convWith cr ρ1 code l = convWith cr ρ2 code l :=
  convWith_ren_eq_of_closedAtL cr l 0 ρ1 ρ2 code hcl
    (fun _ hi => absurd hi (Nat.not_lt_zero _))

theorem convWith_closed0_lam (lb : LExpr) (hcl : closedAtL 0 lb = true) :
    convWith capRen id [] (.lam lb) =
      (.clo (defunc lb).2.length [],
       (defunc lb).2 ++ [{ ncap := 0, body := (defunc lb).1 }]) := by
  have hcl1 : closedAtL 1 lb = true := closedAtL_mono lb 0 1 (Nat.zero_le 1) hcl
  have hfv : freeVars 1 lb = [] := freeVars_eq_nil_of_closedAtL lb 1 hcl1
  have hren : convWith capRen (capRen []) [] lb = defunc lb :=
    convWith_closed0_ren_indep capRen lb (capRen []) id [] hcl
  simp only [convWith, hfv, List.map_nil, List.length_nil, hren]

def closedAtD (c : Nat) : DExpr → Bool
  | .var i => decide (i < c)
  | .clo _ caps => caps.all (fun i => decide (i < c))
  | .apply f a => closedAtD c f && closedAtD c a
  | .letE v b => closedAtD c v && closedAtD (c + 1) b
  | _ => true

theorem list_all_map_lt (ρ : Nat → Nat) (c d : Nat)
    (hρ : ∀ i < c, ρ i < d) :
    ∀ (xs : List Nat), (∀ x ∈ xs, x < c) →
      (xs.map ρ).all (fun i => decide (i < d)) = true
  | [], _ => rfl
  | x :: xs, hxs => by
      simp only [List.map_cons, List.all_cons, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨hρ x (hxs x (List.mem_cons_self x xs)),
        list_all_map_lt ρ c d hρ xs (fun y hy => hxs y (List.mem_cons_of_mem x hy))⟩

theorem closedAtD_convWith_of_closedAtL (cr : List Nat → Nat → Nat) :
    ∀ (l : LExpr) (c d : Nat) (ρ : Nat → Nat) (code : List Code),
      closedAtL c l = true →
      (∀ i < c, ρ i < d) →
      closedAtD d (convWith cr ρ code l).1 = true
  | .bvar i, c, d, ρ, _, hcl, hρ => by
      have hi : i < c := by simpa [closedAtL, decide_eq_true_eq] using hcl
      simp only [convWith, closedAtD, decide_eq_true_eq]
      exact hρ i hi
  | .box, _, _, _, _, _, _ => rfl
  | .lit _, _, _, _, _, _, _ => rfl
  | .ctor _, _, _, _, _, _, _ => rfl
  | .rigid _, _, _, _, _, _, _ => rfl
  | .glob _, _, _, _, _, _, _ => rfl
  | .app f a, c, d, ρ, code, hcl, hρ => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      simp only [convWith, closedAtD, Bool.and_eq_true]
      exact ⟨closedAtD_convWith_of_closedAtL cr f c d ρ code hcl.1 hρ,
        closedAtD_convWith_of_closedAtL cr a c d ρ (convWith cr ρ code f).2 hcl.2 hρ⟩
  | .lam b, c, d, ρ, code, hcl, hρ => by
      simp only [closedAtL] at hcl
      simp only [convWith, closedAtD]
      exact list_all_map_lt ρ c d hρ (freeVars 1 b)
        (freeVars_lt_of_closedAtL b c 1 hcl)
  | .letE v b, c, d, ρ, code, hcl, hρ => by
      simp only [closedAtL, Bool.and_eq_true] at hcl
      have hρ' : ∀ i < c + 1, liftRen ρ i < d + 1 := by
        intro i hi
        cases i with
        | zero => exact Nat.zero_lt_succ d
        | succ j =>
            simp only [liftRen]
            exact Nat.succ_lt_succ (hρ j (Nat.lt_of_succ_lt_succ hi))
      simp only [convWith, closedAtD, Bool.and_eq_true]
      exact ⟨closedAtD_convWith_of_closedAtL cr v c d ρ code hcl.1 hρ,
        closedAtD_convWith_of_closedAtL cr b (c + 1) (d + 1) (liftRen ρ)
          (convWith cr ρ code v).2 hcl.2 hρ'⟩

theorem closedAtD_convWith_closed0 (cr : List Nat → Nat → Nat)
    (ρ : Nat → Nat) (code : List Code) (l : LExpr)
    (hcl : closedAtL 0 l = true) :
    closedAtD 0 (convWith cr ρ code l).1 = true :=
  closedAtD_convWith_of_closedAtL cr l 0 0 ρ code hcl
    (fun _ hi => absurd hi (Nat.not_lt_zero _))

theorem list_mapM_get?_eq_of_all_lt (c : Nat) (env1 env2 : List DVal)
    (henv : ∀ i < c, env1.get? i = env2.get? i) :
    ∀ (caps : List Nat), caps.all (fun i => decide (i < c)) = true →
      caps.mapM (fun i => env1.get? i) = caps.mapM (fun i => env2.get? i)
  | [], _ => rfl
  | i :: caps, hall => by
      simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq] at hall
      rw [List.mapM_cons, List.mapM_cons, henv i hall.1,
        list_mapM_get?_eq_of_all_lt c env1 env2 henv caps hall.2]

theorem run_env_eq_of_closedAtD (code : List Code) :
    ∀ (d : DExpr) (F c : Nat) (env1 env2 : List DVal),
      closedAtD c d = true →
      (∀ i < c, env1.get? i = env2.get? i) →
      run code F env1 d = run code F env2 d
  | .var i, F, c, env1, env2, hcl, henv => by
      cases F with
      | zero => rfl
      | succ F =>
          have hi : i < c := by simpa [closedAtD, decide_eq_true_eq] using hcl
          rw [run_var_eq, run_var_eq, henv i hi]
  | .box, F, _, _, _, _, _ => by cases F <;> rfl
  | .lit _, F, _, _, _, _, _ => by cases F <;> rfl
  | .ctor _, F, _, _, _, _, _ => by cases F <;> rfl
  | .rigid _, F, _, _, _, _, _ => by cases F <;> rfl
  | .glob _, F, _, _, _, _, _ => by cases F <;> rfl
  | .clo l caps, F, c, env1, env2, hcl, henv => by
      cases F with
      | zero => rfl
      | succ F =>
          simp only [closedAtD] at hcl
          rw [run_clo_eq, run_clo_eq,
            list_mapM_get?_eq_of_all_lt c env1 env2 henv caps hcl]
  | .apply g a, F, c, env1, env2, hcl, henv => by
      cases F with
      | zero => rfl
      | succ F =>
          simp only [closedAtD, Bool.and_eq_true] at hcl
          rw [run_apply_eq, run_apply_eq,
            run_env_eq_of_closedAtD code g F c env1 env2 hcl.1 henv,
            run_env_eq_of_closedAtD code a F c env1 env2 hcl.2 henv]
  | .letE v b, F, c, env1, env2, hcl, henv => by
      cases F with
      | zero => rfl
      | succ F =>
          simp only [closedAtD, Bool.and_eq_true] at hcl
          rw [run_let_eq, run_let_eq,
            run_env_eq_of_closedAtD code v F c env1 env2 hcl.1 henv]
          cases run code F env2 v with
          | none => rfl
          | some vv =>
              have henv' : ∀ i < c + 1, (vv :: env1).get? i = (vv :: env2).get? i := by
                intro i hi
                cases i with
                | zero => rfl
                | succ j => exact henv j (Nat.lt_of_succ_lt_succ hi)
              exact run_env_eq_of_closedAtD code b F (c + 1)
                (vv :: env1) (vv :: env2) hcl.2 henv'

theorem run_closed0_env_indep (code : List Code) (d : DExpr) (F : Nat)
    (env1 env2 : List DVal) (hcl : closedAtD 0 d = true) :
    run code F env1 d = run code F env2 d :=
  run_env_eq_of_closedAtD code d F 0 env1 env2 hcl
    (fun _ hi => absurd hi (Nat.not_lt_zero _))

theorem run_let_discard_closed (lv lb : LExpr) (F : Nat) (dv_v dv_b : DVal)
    (hcl : closedAtL 0 lb = true)
    (hgb : noGlobL lb = true)
    (hcb : noCloD dv_b = true)
    (hrv : run (defunc lv).2 (F + 1) [] (defunc lv).1 = some dv_v)
    (hrb : run (defunc lb).2 (F + 1) [] (defunc lb).1 = some dv_b) :
    run (defunc (.letE lv lb)).2 (F + 2) [] (defunc (.letE lv lb)).1 = some dv_b := by
  rw [run_defunc_let_step (F + 1) lv lb dv_v hrv]
  have hren : convWith capRen (liftRen id) (defunc lv).2 lb =
      convWith capRen id (defunc lv).2 lb :=
    convWith_closed0_ren_indep capRen lb (liftRen id) id (defunc lv).2 hcl
  rw [hren]
  have hclD : closedAtD 0 (convWith capRen id (defunc lv).2 lb).1 = true :=
    closedAtD_convWith_closed0 capRen id (defunc lv).2 lb hcl
  rw [run_closed0_env_indep (convWith capRen id (defunc lv).2 lb).2
    (convWith capRen id (defunc lv).2 lb).1 (F + 1) [dv_v] [] hclD]
  have hclean := noGlob_conv capRen id [] lb (fun _ h => nomatch h) hgb
  let pre : List Code := (defunc lv).2
  have hs := convWith_shift_start capRen id pre [] lb
  simp only [List.map_nil, List.append_nil] at hs
  have hr' := run_shift pre.length (F + 1) pre (defunc lb).2 [] (defunc lb).1
    rfl hclean.1 hclean.2
  rw [List.map_nil, hrb, option_map_some,
      shiftDVal_id_of_noClo pre.length dv_b hcb] at hr'
  rw [hs.1, hs.2]
  exact hr'

theorem run_beta_discard_closed (lb la : LExpr) (F : Nat) (dv_a dv_b : DVal)
    (hcl : closedAtL 0 lb = true)
    (hga : noGlobL la = true)
    (hra : run (defunc la).2 (F + 1) [] (defunc la).1 = some dv_a)
    (hrb : run (defunc lb).2 (F + 1) [] (defunc lb).1 = some dv_b) :
    run (defunc (.app (.lam lb) la)).2 (F + 2) []
      (defunc (.app (.lam lb) la)).1 = some dv_b := by
  let pre : List Code := (defunc lb).2 ++ [{ ncap := 0, body := (defunc lb).1 }]
  have hlam : convWith capRen id [] (.lam lb) =
      (.clo (defunc lb).2.length [], pre) :=
    convWith_closed0_lam lb hcl
  have hdef : defunc (.app (.lam lb) la) =
      (.apply (.clo (defunc lb).2.length []) (convWith capRen id pre la).1,
       (convWith capRen id pre la).2) := by
    change (let p := convWith capRen id [] (.lam lb)
            let q := convWith capRen id p.2 la
            (DExpr.apply p.1 q.1, q.2)) = _
    rw [hlam]
  rw [hdef]
  dsimp only
  have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
  have hs := convWith_shift_start capRen id pre [] la
  simp only [List.map_nil, List.append_nil] at hs
  have hra' := run_shift pre.length (F + 1) pre (defunc la).2 [] (defunc la).1
    rfl hclean.1 hclean.2
  rw [List.map_nil, hra, option_map_some] at hra'
  have hrq : run (convWith capRen id pre la).2 (F + 1) []
      (convWith capRen id pre la).1 = some (shiftDVal pre.length dv_a) := by
    rw [hs.1, hs.2]
    exact hra'
  have hc_entry : (convWith capRen id pre la).2.get? (defunc lb).2.length =
      some (⟨0, (defunc lb).1⟩ : Code) := by
    rw [hs.2]
    exact list_get?_append_of_some pre
      ((defunc la).2.map (shiftCode pre.length))
      (defunc lb).2.length ⟨0, (defunc lb).1⟩
      (list_get?_append_last (defunc lb).2 ⟨0, (defunc lb).1⟩)
  have hclD : closedAtD 0 (defunc lb).1 = true :=
    closedAtD_convWith_closed0 capRen id [] lb hcl
  have hpre : (convWith capRen id pre la).2 =
      (defunc lb).2 ++
        ([{ ncap := 0, body := (defunc lb).1 }] ++
          (defunc la).2.map (shiftCode pre.length)) := by
    rw [hs.2]
    exact List.append_assoc (defunc lb).2 [{ ncap := 0, body := (defunc lb).1 }]
      ((defunc la).2.map (shiftCode pre.length))
  have hrb_ext : run (convWith capRen id pre la).2 (F + 1)
      [shiftDVal pre.length dv_a] (defunc lb).1 = some dv_b := by
    rw [run_closed0_env_indep (convWith capRen id pre la).2 (defunc lb).1
      (F + 1) [shiftDVal pre.length dv_a] [] hclD]
    rw [hpre]
    exact run_append_code (defunc lb).2
      ([{ ncap := 0, body := (defunc lb).1 }] ++
        (defunc la).2.map (shiftCode pre.length))
      (F + 1) [] (defunc lb).1 dv_b hrb
  exact run_apply_clo_nil (convWith capRen id pre la).2 F (defunc lb).2.length []
    (convWith capRen id pre la).1 (defunc lb).1
    (shiftDVal pre.length dv_a) dv_b hc_entry hrq hrb_ext

theorem erasable_body_of_let_closed0 {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A v b : Expr Nat}
    (hcl : closedAt 0 b = true)
    (hirr : irrelevant E n [] (.letE A v b) = false)
    (her : Erasable E n (.letE A v b)) :
    Erasable E n b := by
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_let_keep E n F' [] A v b hirr] at he
      cases hv : erase E n F' [] v with
      | none =>
          rw [hv] at he
          exact Option.noConfusion he
      | some lv =>
          cases hb : erase E n F' (.letBinding A v :: []) b with
          | none =>
              rw [hv, hb] at he
              exact Option.noConfusion he
          | some lb =>
              rw [erase_closed0_ctx_indep hE F' b (.letBinding A v :: []) [] hcl] at hb
              exact ⟨F', lb, hb⟩

theorem erasable_body_of_lam_closed0 {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E)
    {A b : Expr Nat}
    (hcl : closedAt 0 b = true)
    (hirrL : irrelevant E n [] (.lam A b) = false)
    (her : Erasable E n (.lam A b)) :
    Erasable E n b := by
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_lam_keep E n F' [] A b hirrL] at he
      cases hb : erase E n F' (.assumption A :: []) b with
      | none =>
          rw [hb] at he
          exact Option.noConfusion he
      | some lb =>
          rw [erase_closed0_ctx_indep hE F' b (.assumption A :: []) [] hcl] at hb
          exact ⟨F', lb, hb⟩

/-! ### SCM fuel independence of `emitWith` (`emitWith_lf_indep`, `emit_eval_fuel1`),
    constructor spine step (`run_app_ctor_spine_step`), and recursive `Good → Good`
    combinators for binary constructors (`good_app_ctor2_of_eval_any`,
    `good_app_ctor2_of_good_args`) -/

theorem listOf_lf_indep {S : SigTable} {τ : BootTy} (progs : Programs S S)
    (m1 m2 : Nat) (g : DVal → BootExpr S [] τ) :
    ∀ (xs : List DVal),
      (∀ x ∈ xs,
        Residua.Bootstrap.Semantics.eval lawsA progs (m1 + 1) [] (g x) =
          Residua.Bootstrap.Semantics.eval lawsA progs (m2 + 1) [] (g x)) →
      Residua.Bootstrap.Semantics.eval lawsA progs (m1 + 1) [] (listOf (xs.map g)) =
        Residua.Bootstrap.Semantics.eval lawsA progs (m2 + 1) [] (listOf (xs.map g))
  | [], _ => by
      simp [listOf, Residua.Bootstrap.Semantics.eval]
  | x :: xs, h => by
      change Residua.Bootstrap.Semantics.eval lawsA progs (m1 + 1) []
          (BootExpr.listAppend (BootExpr.listSingleton (g x)) (listOf (xs.map g))) =
        Residua.Bootstrap.Semantics.eval lawsA progs (m2 + 1) []
          (BootExpr.listAppend (BootExpr.listSingleton (g x)) (listOf (xs.map g)))
      simp only [Residua.Bootstrap.Semantics.eval]
      rw [h x (List.mem_cons_self x xs),
        listOf_lf_indep progs m1 m2 g xs (fun y hy => h y (List.mem_cons_of_mem x hy))]

theorem emitWith_lf_indep (fields : List DVal → List DVal) {S : SigTable}
    (progs : Programs S S) (m1 m2 : Nat) :
    ∀ (F : Nat) (t : BootTy) (dv : DVal),
      Residua.Bootstrap.Semantics.eval lawsA progs (m1 + 1) []
        (emitWith fields (S := S) (G := []) F t dv) =
      Residua.Bootstrap.Semantics.eval lawsA progs (m2 + 1) []
        (emitWith fields (S := S) (G := []) F t dv)
  | 0, t, dv => by
      have h0 : emitWith fields (S := S) (G := []) 0 t dv = refuse := by
        cases t <;> cases dv <;> rfl
      rw [h0]
      unfold refuse
      rw [eval_refuse, eval_refuse]
  | F + 1, t, dv => by
      cases dv with
      | box =>
          have href : emitWith fields (S := S) (G := []) (F + 1) t .box = refuse := by
            cases t <;> rfl
          rw [href]
          unfold refuse
          rw [eval_refuse, eval_refuse]
      | clo l caps =>
          have href : emitWith fields (S := S) (G := []) (F + 1) t (.clo l caps) = refuse := by
            cases t <;> rfl
          rw [href]
          unfold refuse
          rw [eval_refuse, eval_refuse]
      | rigid r args =>
          have href : emitWith fields (S := S) (G := []) (F + 1) t (.rigid r args) = refuse := by
            cases t <;> rfl
          rw [href]
          unfold refuse
          rw [eval_refuse, eval_refuse]
      | lit k =>
          cases t with
          | i64 =>
              simp only [emitWith]
              by_cases hk : inI64Range (Int.ofNat k) = true
              · rw [if_pos hk]
                simp [Residua.Bootstrap.Semantics.eval, hk]
              · rw [if_neg hk]
                unfold refuse
                rw [eval_refuse, eval_refuse]
          | bool | str | bytes | list _ | pair _ _ | sum _ | record _ | option _ | residue _ =>
              simp only [emitWith]
              unfold refuse
              rw [eval_refuse, eval_refuse]
      | ctor r args =>
          cases t with
          | sum ts =>
              simp only [emitWith]
              by_cases hr : r < ts.length
              · rw [dif_pos hr]
                split
                · rename_i τ hτ
                  simp only [Residua.Bootstrap.Semantics.eval]
                  rw [eval_cast_eq progs (m1 + 1) [] hτ.symm,
                      eval_cast_eq progs (m2 + 1) [] hτ.symm,
                      listOf_lf_indep progs m1 m2 (emitWith fields (S := S) (G := []) F τ)
                        (fields args) (fun x _ => emitWith_lf_indep fields progs m1 m2 F τ x)]
                · unfold refuse
                  rw [eval_refuse, eval_refuse]
              · rw [dif_neg hr]
                unfold refuse
                rw [eval_refuse, eval_refuse]
          | i64 | bool | str | bytes | list _ | pair _ _ | record _ | option _ | residue _ =>
              simp only [emitWith]
              unfold refuse
              rw [eval_refuse, eval_refuse]

theorem emit_eval_fuel1 {S : SigTable} (progs : Programs S S)
    (F lf : Nat) (t : BootTy) (dv : DVal) (w : Val)
    (h : Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (emit (S := S) (G := []) F t dv) = some w) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) F t dv) = some w := by
  cases lf with
  | zero =>
      rw [eval_fuel0] at h
      exact Option.noConfusion h
  | succ m =>
      unfold emit at h ⊢
      rw [emitWith_lf_indep relevantArgs progs 0 m F t dv]
      exact h

theorem relevantArgs_append :
    ∀ (xs ys : List DVal), relevantArgs (xs ++ ys) = relevantArgs xs ++ relevantArgs ys
  | [], _ => rfl
  | .box :: xs, ys => by
      rw [List.cons_append, relevantArgs_box, relevantArgs_box, relevantArgs_append xs ys]
  | .lit n :: xs, ys => by
      rw [List.cons_append, relevantArgs_lit, relevantArgs_lit, relevantArgs_append xs ys,
        List.cons_append]
  | .ctor r args :: xs, ys => by
      rw [List.cons_append, relevantArgs_ctor, relevantArgs_ctor, relevantArgs_append xs ys,
        List.cons_append]
  | .rigid r args :: xs, ys => by
      rw [List.cons_append, relevantArgs_rigid, relevantArgs_rigid, relevantArgs_append xs ys,
        List.cons_append]
  | .clo l caps :: xs, ys => by
      rw [List.cons_append, relevantArgs_clo, relevantArgs_clo, relevantArgs_append xs ys,
        List.cons_append]

theorem relevantArgs_keep_of_emit {S : SigTable} (progs : Programs S S)
    (F lf : Nat) (τ : BootTy) (dv : DVal) (w : Val)
    (he : Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (emit (S := S) (G := []) (F + 1) τ dv) = some w) :
    relevantArgs [dv] = [dv] := by
  cases dv with
  | box =>
      have href : emit (S := S) (G := []) (F + 1) τ .box = refuse := by
        cases τ <;> rfl
      rw [href] at he
      exact absurd he (eval_refuse_ne progs lf [] w)
  | lit n => simpa using relevantArgs_lit n []
  | ctor r ys => simpa using relevantArgs_ctor r ys []
  | rigid r ys => simpa using relevantArgs_rigid r ys []
  | clo l caps => simpa using relevantArgs_clo l caps []

theorem eval_listOf_snoc {S : SigTable} {τ : BootTy} (progs : Programs S S)
    (e : BootExpr S [] τ) (w : Val)
    (he : Residua.Bootstrap.Semantics.eval lawsA progs 1 [] e = some w) :
    ∀ (es : List (BootExpr S [] τ)) (ws : List Val),
      Residua.Bootstrap.Semantics.eval lawsA progs 1 [] (listOf es) = some (.list ws) →
      Residua.Bootstrap.Semantics.eval lawsA progs 1 [] (listOf (es ++ [e])) =
        some (.list (ws ++ [w]))
  | [], ws, hes => by
      have h0 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (listOf ([] : List (BootExpr S [] τ))) = some (.list []) := by
        simp [listOf, Residua.Bootstrap.Semantics.eval]
      rw [h0] at hes
      have hws : ws = [] := Val.list.inj (Option.some.inj hes.symm)
      subst hws
      change Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (BootExpr.listAppend (BootExpr.listSingleton e)
            (listOf ([] : List (BootExpr S [] τ)))) = some (.list [w])
      simp only [listOf, Residua.Bootstrap.Semantics.eval, he, List.append_nil]
      rfl
  | e0 :: es, ws, hes => by
      change Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (BootExpr.listAppend (BootExpr.listSingleton e0) (listOf es)) =
        some (.list ws) at hes
      change Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (BootExpr.listAppend (BootExpr.listSingleton e0) (listOf (es ++ [e]))) =
        some (.list (ws ++ [w]))
      simp only [Residua.Bootstrap.Semantics.eval] at hes ⊢
      cases he0 : Residua.Bootstrap.Semantics.eval lawsA progs 1 [] e0 with
      | none =>
          rw [he0] at hes
          exact Option.noConfusion hes
      | some w0 =>
          rw [he0] at hes
          cases htail : Residua.Bootstrap.Semantics.eval lawsA progs 1 [] (listOf es) with
          | none =>
              rw [htail] at hes
              exact Option.noConfusion hes
          | some vtail =>
              rw [htail] at hes
              cases vtail with
              | list wst =>
                  have hws : ws = w0 :: wst := (Val.list.inj (Option.some.inj hes)).symm
                  subst hws
                  rw [eval_listOf_snoc progs e w he es wst htail]
                  rfl
              | int _ | bool _ | str _ | bytes _ | pair _ _ | inj _ _ |
                recV _ | someV _ | noneV | ok _ | res _ =>
                  exact Option.noConfusion hes

theorem eval_emit_ctor_two {S : SigTable} (progs : Programs S S)
    (F c : Nat) (ts : List BootTy) (τ : BootTy) (dv1 dv2 : DVal) (w1 w2 : Val)
    (hg : ts.get? c = some (.list τ))
    (he1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 1) τ dv1) = some w1)
    (he2 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 1) τ dv2) = some w2) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 2) (.sum ts) (.ctor c [dv1, dv2])) =
      some (.inj c (.list [w1, w2])) := by
  obtain ⟨hlt, hget⟩ := list_get?_some ts c (.list τ) hg
  have hk1 : relevantArgs [dv1] = [dv1] :=
    relevantArgs_keep_of_emit progs F 1 τ dv1 w1 he1
  have hk2 : relevantArgs [dv2] = [dv2] :=
    relevantArgs_keep_of_emit progs F 1 τ dv2 w2 he2
  have hkeep : relevantArgs [dv1, dv2] = [dv1, dv2] := by
    change relevantArgs ([dv1] ++ [dv2]) = [dv1, dv2]
    rw [relevantArgs_append, hk1, hk2]
    rfl
  have hnil : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf ([] : List (BootExpr S [] τ))) = some (.list []) := by
    simp [listOf, Residua.Bootstrap.Semantics.eval]
  have hlist1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf [emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv1]) =
      some (.list [w1]) :=
    eval_listOf_snoc progs (emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv1)
      w1 he1 [] [] hnil
  have hlist2 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf [emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv1,
               emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv2]) =
      some (.list [w1, w2]) :=
    eval_listOf_snoc progs (emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv2)
      w2 he2 [emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv1] [w1] hlist1
  simp only [emit, emitWith]
  rw [dif_pos hlt]
  split
  · rename_i τ' hτ'
    have hτeq : τ' = τ := BootTy.list.inj (hτ'.symm.trans hget)
    cases hτeq
    simp only [Residua.Bootstrap.Semantics.eval]
    rw [eval_cast_eq progs 1 [] hτ'.symm, hkeep, List.map_cons, List.map_cons,
      List.map_nil, hlist2]
    rfl
  · rename_i hne
    exact absurd hget (hne τ)

theorem run_app_ctor_spine_step (lg la : LExpr) (F c : Nat)
    (dvs : List DVal) (dv : DVal)
    (hga : noGlobL la = true)
    (hca : noCloD dv = true)
    (hrg : run (defunc lg).2 (F + 1) [] (defunc lg).1 = some (.ctor c dvs))
    (hra : run (defunc la).2 (F + 1) [] (defunc la).1 = some dv) :
    run (defunc (.app lg la)).2 (F + 2) [] (defunc (.app lg la)).1 =
      some (.ctor c (dvs ++ [dv])) := by
  let pre : List Code := (defunc lg).2
  have hdef : defunc (.app lg la) =
      (.apply (defunc lg).1 (convWith capRen id pre la).1,
       (convWith capRen id pre la).2) := rfl
  rw [hdef]
  dsimp only
  obtain ⟨ext, hext⟩ := convWith_suffix capRen id pre la
  have hrg' : run (convWith capRen id pre la).2 (F + 1) [] (defunc lg).1 =
      some (.ctor c dvs) := by
    rw [hext]
    exact run_append_code pre ext (F + 1) [] (defunc lg).1 (.ctor c dvs) hrg
  have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
  have hs := convWith_shift_start capRen id pre [] la
  simp only [List.map_nil, List.append_nil] at hs
  have hra' := run_shift pre.length (F + 1) pre (defunc la).2 [] (defunc la).1
    rfl hclean.1 hclean.2
  rw [List.map_nil, hra, option_map_some,
      shiftDVal_id_of_noClo pre.length dv hca] at hra'
  have hrq : run (convWith capRen id pre la).2 (F + 1) []
      (convWith capRen id pre la).1 = some dv := by
    rw [hs.1, hs.2]
    exact hra'
  rw [run_apply_eq (convWith capRen id pre la).2 (F + 1) []
    (defunc lg).1 (convWith capRen id pre la).1, hrg', hrq]

theorem run_app_ctor2_val (la1 la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hga2 : noGlobL la2 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 2) [] (defunc la2).1 = some dv2) :
    run (defunc (.app (.app (.ctor c) la1) la2)).2 (F + 3) []
      (defunc (.app (.app (.ctor c) la1) la2)).1 =
      some (.ctor c [dv1, dv2]) := by
  have hr1_ctor : run (defunc (.app (.ctor c) la1)).2 (F + 2) []
      (defunc (.app (.ctor c) la1)).1 = some (.ctor c [dv1]) := by
    rw [defunc_app_ctor c la1]
    exact run_apply_ctor_val (defunc la1).2 F c (defunc la1).1 dv1 hr1
  exact run_app_ctor_spine_step (.app (.ctor c) la1) la2 (F + 1) c [dv1] dv2
    hga2 hca2 hr1_ctor hr2

theorem lowerF_app_ctor2_eval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n F lf c : Nat) (lsc : List Level) (arg1 arg2 : Expr Nat)
    (t : BootTy) (w : Val)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hirr : irrelevant E n [] (.app (.app (.const c lsc) arg1) arg2) = false)
    (hirr1 : irrelevant E n [] (.app (.const c lsc) arg1) = false)
    (hirrC : irrelevant E n [] (.const c lsc) = false)
    (la1 la2 : LExpr)
    (ha1 : erase E n (F + 1) [] arg1 = some la1)
    (ha2 : erase E n (F + 2) [] arg2 = some la2)
    (dv1 dv2 : DVal)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 2) [] (defunc la2).1 = some dv2)
    (hca2 : noCloD dv2 = true)
    (he : Residua.Bootstrap.Semantics.eval lawsA progs lf []
        (emit (S := S) (G := []) (F + 2) t (.ctor c [dv1, dv2])) = some w) :
    Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (lowerF E n (F + 3) (S := S) t
        (.app (.app (.const c lsc) arg1) arg2)) = some w := by
  have hC1 : erase E n 1 [] (.const c lsc) = some (.ctor c) := by
    simp only [erase, eraseWith, hirrC, Bool.false_eq_true, if_false, noGlobals, hnone,
      hctor, if_true]
  have hC : erase E n (F + 1) [] (.const c lsc) = some (.ctor c) :=
    erase_mono E n 1 (F + 1) [] (.const c lsc) (.ctor c) (Nat.le_add_left 1 F) hC1
  have he1 : erase E n (F + 2) [] (.app (.const c lsc) arg1) =
      some (.app (.ctor c) la1) := by
    simp only [erase_app_keep E n (F + 1) [] (.const c lsc) arg1 hirr1, hC, ha1]
  have hee : erase E n (F + 3) [] (.app (.app (.const c lsc) arg1) arg2) =
      some (.app (.app (.ctor c) la1) la2) := by
    simp only [erase_app_keep E n (F + 2) [] (.app (.const c lsc) arg1) arg2 hirr,
      he1, ha2]
  have hga2 : noGlobL la2 = true := noGlobL_erase E n (F + 2) [] arg2 la2 ha2
  have hrA : run (defunc (.app (.app (.ctor c) la1) la2)).2 (F + 3) []
      (defunc (.app (.app (.ctor c) la1) la2)).1 = some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_val la1 la2 F c dv1 dv2 hga2 hca2 hr1 hr2
  unfold lowerF pipeline
  simp only [hee, hrA]
  exact emitWith_evalStable relevantArgs progs lf [] (F + 2) (F + 3) t
    (.ctor c [dv1, dv2]) w (Nat.le_succ (F + 2)) he

theorem transparentBody_eq_none_of_isCtor (E : ResolvedEnv) (c : Nat) (lsc : List Level)
    (hctor : isCtor E c = true) :
    transparentBody E c lsc = none := by
  unfold isCtor at hctor
  unfold transparentBody
  rcases members_cases (E := E) c with hm | ⟨m, hm⟩
  · rw [hm]
  · rw [hm] at hctor ⊢
    dsimp only at hctor ⊢
    have hmc : m.mclass = .constructorM := of_decide_eq_true hctor
    rw [hmc]
    rfl

theorem norm_app_ctor2_args (E : ResolvedEnv) (k c : Nat) (lsc : List Level)
    (arg1 arg2 varg1 varg2 : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (harg1 : norm E (k + 2) arg1 = some varg1)
    (harg2 : norm E (k + 2) arg2 = some varg2) :
    norm E (k + 3) (.app (.app (.const c lsc) arg1) arg2) =
      some (.app (.app (.const c lsc) varg1) varg2) := by
  have hwb : whnfFuel E (k + 2) (.app (.app (.const c lsc) arg1) arg2) =
      some (.app (.app (.const c lsc) arg1) arg2) := by
    simp only [whnfFuel, appsSpine, List.nil_append, List.cons_append, hnone]
  unfold norm
  rw [hwb]
  have hsp : appsSpine (.app (.app (.const c lsc) arg1) arg2) =
      (.const c lsc, [arg1, arg2]) := by
    simp only [appsSpine, List.nil_append, List.cons_append]
  simp only [hsp]
  have hm : [arg1, arg2].mapM (norm E (k + 2)) = some [varg1, varg2] := by
    rw [List.mapM_cons, harg1, List.mapM_cons, harg2, List.mapM_nil]
    rfl
  simp only [hm, foldApps]

theorem norm_app_ctor2_args_of_norm (E : ResolvedEnv) (lf c : Nat) (lsc : List Level)
    (arg1 arg2 v : Expr Nat) (hnone : transparentBody E c lsc = none)
    (hn : norm E lf (.app (.app (.const c lsc) arg1) arg2) = some v) :
    ∃ k varg1 varg2, lf = k + 2 ∧
      norm E (k + 1) arg1 = some varg1 ∧
      norm E (k + 1) arg2 = some varg2 ∧
      v = .app (.app (.const c lsc) varg1) varg2 := by
  cases lf with
  | zero =>
      rw [norm_fuel0] at hn
      exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          unfold norm at hn
          have hstuck : whnfFuel E (k + 1) (.app (.app (.const c lsc) arg1) arg2) =
              some (.app (.app (.const c lsc) arg1) arg2) := by
            simp only [whnfFuel, appsSpine, List.nil_append, List.cons_append, hnone]
          rw [hstuck] at hn
          have hsp : appsSpine (.app (.app (.const c lsc) arg1) arg2) =
              (.const c lsc, [arg1, arg2]) := by
            simp only [appsSpine, List.nil_append, List.cons_append]
          simp only [hsp] at hn
          cases harg1 : norm E (k + 1) arg1 with
          | none =>
              have hmap : [arg1, arg2].mapM (norm E (k + 1)) = none := by
                rw [List.mapM_cons, harg1]
                rfl
              simp only [hmap] at hn
              exact Option.noConfusion hn
          | some varg1 =>
              cases harg2 : norm E (k + 1) arg2 with
              | none =>
                  have hmap : [arg1, arg2].mapM (norm E (k + 1)) = none := by
                    rw [List.mapM_cons, harg1, List.mapM_cons, harg2]
                    rfl
                  simp only [hmap] at hn
                  exact Option.noConfusion hn
              | some varg2 =>
                  have hmap : [arg1, arg2].mapM (norm E (k + 1)) =
                      some [varg1, varg2] := by
                    rw [List.mapM_cons, harg1, List.mapM_cons, harg2, List.mapM_nil]
                    rfl
                  simp only [hmap, foldApps] at hn
                  exact ⟨k, varg1, varg2, rfl, harg1, harg2, (Option.some.inj hn).symm⟩

theorem inferT_app_ctor2_args {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f a1 a2 v1 v2 T1 T2 : Expr Nat}
    (h1 : inferT E n Γ (.app (.app f a1) a2) = some T1)
    (h2 : inferT E n Γ (.app (.app f v1) v2) = some T2)
    (hNonDep : ∀ A1 B1, inferT E n Γ f = some (.pi A1 B1) → closedAt 0 B1 = true) :
    ∃ A1 A2,
      inferT E n Γ a1 = some A1 ∧ inferT E n Γ v1 = some A1 ∧
      inferT E n Γ a2 = some A2 ∧ inferT E n Γ v2 = some A2 := by
  obtain ⟨A2, B2, hfa1, ha2, _⟩ := inferT_app_some.mp h1
  obtain ⟨A2', B2', hfv1, hv2, _⟩ := inferT_app_some.mp h2
  obtain ⟨A1, B1, hf, ha1, _⟩ := inferT_app_some.mp hfa1
  obtain ⟨A1', B1', hf', hv1, hpi1'⟩ := inferT_app_some.mp hfv1
  have hpi1 : (.pi A2 B2 : Expr Nat) = instantiate0 a1 B1 := by
    have hfa1' := inferT_app_some.mpr ⟨A1, B1, hf, ha1, rfl⟩
    rw [hfa1] at hfa1'
    exact Option.some.inj hfa1'
  rw [hf] at hf'
  injection (Option.some.inj hf') with hA1 hB1
  rw [← hA1] at hv1
  rw [← hB1] at hpi1'
  have hclB1 : closedAt 0 B1 = true := hNonDep A1 B1 hf
  unfold instantiate0 at hpi1 hpi1'
  rw [instantiate_id_closed0 B1 0 a1 hclB1] at hpi1
  rw [instantiate_id_closed0 B1 0 v1 hclB1] at hpi1'
  have hpi_eq : (.pi A2 B2 : Expr Nat) = .pi A2' B2' := hpi1.trans hpi1'.symm
  injection hpi_eq with hA2 _
  rw [← hA2] at hv2
  exact ⟨A1, A2, ha1, hv1, ha2, hv2⟩

theorem good_app_ctor2_of_eval_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (arg1 arg2 : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (harg1 : ∀ (lf fv : Nat) (v1 : Expr Nat) (t : BootTy) (w1 : Val),
      norm E lf arg1 = some v1 →
      scmValOf E fv v1 = some w1 →
      relevantSpine E n fv v1 = true →
      irrelevant E n [] v1 = false →
      valFits fv t w1 = true →
      ∃ F lf',
        Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF E n F (S := S) t arg1) = some w1)
    (harg2 : ∀ (lf fv : Nat) (v2 : Expr Nat) (t : BootTy) (w2 : Val),
      norm E lf arg2 = some v2 →
      scmValOf E fv v2 = some w2 →
      relevantSpine E n fv v2 = true →
      irrelevant E n [] v2 = false →
      valFits fv t w2 = true →
      ∃ F lf',
        Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF E n F (S := S) t arg2) = some w2) :
    Good progs E n (.app (.app (.const c lsc) arg1) arg2) := by
  refine good_of_exists progs E n (.app (.app (.const c lsc) arg1) arg2) ?_
  intro lf fv T v t w _ hi _ hn hs hrel hirrv hf hvinf _
  have hirr : irrelevant E n [] (.app (.app (.const c lsc) arg1) arg2) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirr1 : irrelevant E n [] (.app (.const c lsc) arg1) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  obtain ⟨_, _, hfa1, _, _⟩ := inferT_app_some.mp hi
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hfa1 hirr1
  obtain ⟨k, varg1, varg2, _, harg1n, harg2n, hv⟩ :=
    norm_app_ctor2_args_of_norm E lf c lsc arg1 arg2 v hnone hn
  subst hv
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      cases m with
      | zero =>
          have hs0 : scmValOf E 1 (.app (.app (.const c lsc) varg1) varg2) = none := by
            simp only [scmValOf, appsSpine, List.nil_append, List.cons_append,
              List.mapM_cons, List.mapM_nil, Option.bind, Option.pure_def]
            split
            · rename_i mm hm
              by_cases hc : mm.mclass = .constructorM
              · simp [hm, hc, scmValOf]
              · simp [hm, hc]
            · rename_i hm
              simp [hm]
          rw [hs0] at hs
          exact Option.noConfusion hs
      | succ q =>
          have hs' : (match E.members c with
              | some mm =>
                  if mm.mclass = .constructorM then
                    match List.mapM (scmValOf E (q + 1)) [varg1, varg2] with
                    | some vs => some (.inj c (.list vs))
                    | none => none
                  else none
              | none => none) = some w := by
            simpa [scmValOf, appsSpine, List.nil_append, List.cons_append] using hs
          cases hm : E.members c with
          | none =>
              simp only [hm] at hs'
              exact Option.noConfusion hs'
          | some mm =>
              simp only [hm] at hs'
              by_cases hcm : mm.mclass = .constructorM
              · simp only [hcm, ite_true] at hs'
                rw [List.mapM_cons, List.mapM_cons, List.mapM_nil] at hs'
                cases hfield1 : scmValOf E (q + 1) varg1 with
                | none =>
                    simp only [hfield1, Option.bind, Option.pure_def] at hs'
                    exact Option.noConfusion hs'
                | some w1 =>
                    cases hfield2 : scmValOf E (q + 1) varg2 with
                    | none =>
                        simp only [hfield1, hfield2, Option.bind, Option.pure_def] at hs'
                        exact Option.noConfusion hs'
                    | some w2 =>
                        simp only [hfield1, hfield2, Option.bind, Option.pure_def] at hs'
                        have hw : w = .inj c (.list [w1, w2]) :=
                          (Option.some.inj hs').symm
                        subst hw
                        have hctor : isCtor E c = true := by simp [isCtor, hm, hcm]
                        have hrel12 :
                            ((!irrelevant E n [] varg1 &&
                              relevantSpine E n (q + 1) varg1) &&
                             (!irrelevant E n [] varg2 &&
                              relevantSpine E n (q + 1) varg2)) = true := by
                          simpa [relevantSpine, appsSpine, List.nil_append,
                            List.cons_append, List.all_cons, List.all_nil,
                            Bool.and_true] using hrel
                        simp only [Bool.and_eq_true] at hrel12
                        cases hirrF1 : irrelevant E n [] varg1 with
                        | true =>
                            simp only [hirrF1, Bool.not_true] at hrel12
                            exact Bool.noConfusion hrel12.1.1
                        | false =>
                            cases hirrF2 : irrelevant E n [] varg2 with
                            | true =>
                                simp only [hirrF2, Bool.not_true] at hrel12
                                exact Bool.noConfusion hrel12.2.1
                            | false =>
                                cases t with
                                | sum ts =>
                                    have hf' : (match ts.get? c with
                                        | some (.list τ) =>
                                            valFits (q + 1) τ w1 && valFits (q + 1) τ w2
                                        | _ => false) = true := by
                                      simpa [valFits, List.all_cons, List.all_nil,
                                        Bool.and_true] using hf
                                    split at hf'
                                    · rename_i τ hg
                                      simp only [Bool.and_eq_true] at hf'
                                      obtain ⟨G1, lfe1, he1⟩ :=
                                        harg1 (k + 1) (q + 1) varg1 τ w1 harg1n hfield1
                                          hrel12.1.2 hirrF1 hf'.1
                                      obtain ⟨G2, lfe2, he2⟩ :=
                                        harg2 (k + 1) (q + 1) varg2 τ w2 harg2n hfield2
                                          hrel12.2.2 hirrF2 hf'.2
                                      unfold lowerF pipeline at he1 he2
                                      cases ha1 : erase E n G1 [] arg1 with
                                      | none =>
                                          simp only [ha1] at he1
                                          exact absurd he1 (eval_refuse_ne progs lfe1 [] w1)
                                      | some la1 =>
                                          simp only [ha1] at he1
                                          cases hr1 : run (defunc la1).2 G1 [] (defunc la1).1 with
                                          | none =>
                                              simp only [hr1] at he1
                                              exact absurd he1 (eval_refuse_ne progs lfe1 [] w1)
                                          | some dv1 =>
                                              simp only [hr1] at he1
                                              cases ha2 : erase E n G2 [] arg2 with
                                              | none =>
                                                  simp only [ha2] at he2
                                                  exact absurd he2 (eval_refuse_ne progs lfe2 [] w2)
                                              | some la2 =>
                                                  simp only [ha2] at he2
                                                  cases hr2 : run (defunc la2).2 G2 [] (defunc la2).1 with
                                                  | none =>
                                                      simp only [hr2] at he2
                                                      exact absurd he2 (eval_refuse_ne progs lfe2 [] w2)
                                                  | some dv2 =>
                                                      simp only [hr2] at he2
                                                      have hca2 : noCloD dv2 = true :=
                                                        noCloD_emitWith progs G2 lfe2 τ dv2 w2 he2
                                                      have he1_1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                                                          (emit (S := S) (G := []) G1 τ dv1) = some w1 :=
                                                        emit_eval_fuel1 progs G1 lfe1 τ dv1 w1 he1
                                                      have he2_1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                                                          (emit (S := S) (G := []) G2 τ dv2) = some w2 :=
                                                        emit_eval_fuel1 progs G2 lfe2 τ dv2 w2 he2
                                                      let F := G1 + G2
                                                      have hle1 : G1 ≤ F + 1 :=
                                                        Nat.le_trans (Nat.le_add_right G1 G2) (Nat.le_succ F)
                                                      have hle2 : G2 ≤ F + 1 :=
                                                        Nat.le_trans (Nat.le_add_left G2 G1) (Nat.le_succ F)
                                                      have hle2' : G2 ≤ F + 2 :=
                                                        Nat.le_trans hle2 (Nat.le_succ (F + 1))
                                                      have ha1' : erase E n (F + 1) [] arg1 = some la1 :=
                                                        erase_mono E n G1 (F + 1) [] arg1 la1 hle1 ha1
                                                      have ha2' : erase E n (F + 2) [] arg2 = some la2 :=
                                                        erase_mono E n G2 (F + 2) [] arg2 la2 hle2' ha2
                                                      have hr1' : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1 :=
                                                        run_mono (defunc la1).2 G1 (F + 1) [] (defunc la1).1 dv1 hle1 hr1
                                                      have hr2' : run (defunc la2).2 (F + 2) [] (defunc la2).1 = some dv2 :=
                                                        run_mono (defunc la2).2 G2 (F + 2) [] (defunc la2).1 dv2 hle2' hr2
                                                      have he1_F : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                                                          (emit (S := S) (G := []) (F + 1) τ dv1) = some w1 :=
                                                        emitWith_evalStable relevantArgs progs 1 [] G1 (F + 1) τ dv1 w1 hle1 he1_1
                                                      have he2_F : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                                                          (emit (S := S) (G := []) (F + 1) τ dv2) = some w2 :=
                                                        emitWith_evalStable relevantArgs progs 1 [] G2 (F + 1) τ dv2 w2 hle2 he2_1
                                                      have heC := eval_emit_ctor_two progs F c ts τ dv1 dv2 w1 w2
                                                        hg he1_F he2_F
                                                      exact ⟨F + 3, 1,
                                                        lowerF_app_ctor2_eval progs E n F 1 c lsc arg1 arg2
                                                          (.sum ts) (.inj c (.list [w1, w2]))
                                                          hnone hctor hirr hirr1 hirrC la1 la2 ha1' ha2'
                                                          dv1 dv2 hr1' hr2' hca2 heC⟩
                                    · exact Bool.noConfusion hf'
                                | i64 | bool | str | bytes | list _ | pair _ _ | record _ |
                                  option _ | residue _ =>
                                    simp only [valFits] at hf
                                    exact Bool.noConfusion hf
              · simp only [hcm, ite_false] at hs'
                exact Option.noConfusion hs'

theorem inferT_foldApps_head_some (E : ResolvedEnv) (n : Nat) :
    ∀ (args : List (Expr Nat)) (f T : Expr Nat),
      inferT E n [] (foldApps f args) = some T →
      ∃ Tf, inferT E n [] f = some Tf
  | [], _, T, h => ⟨T, h⟩
  | a :: as, f, T, h => by
      obtain ⟨Tap, hTap⟩ := inferT_foldApps_head_some E n as (.app f a) T h
      obtain ⟨A, B, hf, _, _⟩ := inferT_app_some.mp hTap
      exact ⟨.pi A B, hf⟩

theorem irrelevant_foldApps_head_false (E : ResolvedEnv) (n : Nat) :
    ∀ (args : List (Expr Nat)) (f T : Expr Nat),
      inferT E n [] (foldApps f args) = some T →
      irrelevant E n [] (foldApps f args) = false →
      irrelevant E n [] f = false
  | [], _, _, _, hirr => hirr
  | a :: as, f, T, hi, hirr => by
      have hirr_app : irrelevant E n [] (.app f a) = false :=
        irrelevant_foldApps_head_false E n as (.app f a) T hi hirr
      obtain ⟨Tap, hTap⟩ := inferT_foldApps_head_some E n as (.app f a) T hi
      exact irrelevant_fun_false_of_app_irr hTap hirr_app

theorem erase_foldApps_congr_head (E : ResolvedEnv) (n : Nat) :
    ∀ (args : List (Expr Nat)) {f1 f2 : Expr Nat}
      (hTy : ∀ T0, inferT E n [] f1 = some T0 → inferT E n [] f2 = some T0)
      (hEr : ∀ F Tf lf,
        inferT E n [] f1 = some Tf →
        irrelevant E n [] f1 = false →
        erase E n F [] f2 = some lf →
        erase E n (F + 1) [] f1 = some lf)
      {F : Nat} {T : Expr Nat} {l : LExpr},
      inferT E n [] (foldApps f1 args) = some T →
      irrelevant E n [] (foldApps f1 args) = false →
      erase E n F [] (foldApps f2 args) = some l →
      erase E n (F + 1) [] (foldApps f1 args) = some l
  | [], _, _, _, hEr, F, T, l, hi, hirr, he2 =>
      hEr F T l hi hirr he2
  | a :: as, f1, f2, hTy, hEr, F, T, l, hi, hirr, he2 => by
      have hTy' : ∀ T0, inferT E n [] (.app f1 a) = some T0 →
          inferT E n [] (.app f2 a) = some T0 := by
        intro T0 h1
        obtain ⟨A, B, hf1, ha, hT0⟩ := inferT_app_some.mp h1
        exact inferT_app_some.mpr ⟨A, B, hTy (.pi A B) hf1, ha, hT0⟩
      refine erase_foldApps_congr_head E n as hTy' ?_ hi hirr he2
      intro F0 Tap lap hi_app1 hirr_app1 he_app2
      cases F0 with
      | zero =>
          simp only [erase, eraseWith] at he_app2
          exact Option.noConfusion he_app2
      | succ F' =>
          have hi_app2 : inferT E n [] (.app f2 a) = some Tap := hTy' Tap hi_app1
          have hirr_app2 : irrelevant E n [] (.app f2 a) = false :=
            irrelevant_false_of_same_type hi_app2 hi_app1 hirr_app1
          rw [erase_app_keep E n F' [] f2 a hirr_app2] at he_app2
          cases hf2 : erase E n F' [] f2 with
          | none =>
              simp only [hf2] at he_app2
              exact Option.noConfusion he_app2
          | some lf2 =>
              cases ha2 : erase E n F' [] a with
              | none =>
                  simp only [hf2, ha2] at he_app2
                  exact Option.noConfusion he_app2
              | some la =>
                  simp only [hf2, ha2] at he_app2
                  have hlap : lap = .app lf2 la := (Option.some.inj he_app2).symm
                  subst hlap
                  obtain ⟨A, B, hf1_ty, _, _⟩ := inferT_app_some.mp hi_app1
                  have hirr_f1 : irrelevant E n [] f1 = false :=
                    irrelevant_fun_false_of_app_irr hi_app1 hirr_app1
                  have hf1 : erase E n (F' + 1) [] f1 = some lf2 :=
                    hEr F' (.pi A B) lf2 hf1_ty hirr_f1 hf2
                  have ha1 : erase E n (F' + 1) [] a = some la :=
                    erase_mono E n F' (F' + 1) [] a la (Nat.le_succ F') ha2
                  rw [erase_app_keep E n (F' + 1) [] f1 a hirr_app1, hf1, ha1]

theorem erasable_foldApps_congr_head (E : ResolvedEnv) (n : Nat) :
    ∀ (args : List (Expr Nat)) {f1 f2 : Expr Nat}
      (hTy : ∀ T0, inferT E n [] f1 = some T0 → inferT E n [] f2 = some T0)
      (hEr : ∀ Tf,
        inferT E n [] f1 = some Tf →
        irrelevant E n [] f1 = false →
        Erasable E n f1 →
        Erasable E n f2)
      {T : Expr Nat},
      inferT E n [] (foldApps f1 args) = some T →
      irrelevant E n [] (foldApps f1 args) = false →
      Erasable E n (foldApps f1 args) →
      Erasable E n (foldApps f2 args)
  | [], _, _, _, hEr, T, hi, hirr, her1 =>
      hEr T hi hirr her1
  | a :: as, f1, f2, hTy, hEr, T, hi, hirr, her1 => by
      have hTy' : ∀ T0, inferT E n [] (.app f1 a) = some T0 →
          inferT E n [] (.app f2 a) = some T0 := by
        intro T0 h1
        obtain ⟨A, B, hf1, ha, hT0⟩ := inferT_app_some.mp h1
        exact inferT_app_some.mpr ⟨A, B, hTy (.pi A B) hf1, ha, hT0⟩
      refine erasable_foldApps_congr_head E n as hTy' ?_ hi hirr her1
      intro Tap hi_app1 hirr_app1 her_app1
      obtain ⟨her_f1, ⟨Fa, la, ha⟩⟩ := erasable_of_app_keep hirr_app1 her_app1
      obtain ⟨A, B, hf1_ty, _, _⟩ := inferT_app_some.mp hi_app1
      have hirr_f1 : irrelevant E n [] f1 = false :=
        irrelevant_fun_false_of_app_irr hi_app1 hirr_app1
      obtain ⟨Ff2, lf2, hf2⟩ := hEr (.pi A B) hf1_ty hirr_f1 her_f1
      have hi_app2 : inferT E n [] (.app f2 a) = some Tap := hTy' Tap hi_app1
      have hirr_app2 : irrelevant E n [] (.app f2 a) = false :=
        irrelevant_false_of_same_type hi_app2 hi_app1 hirr_app1
      refine ⟨Ff2 + Fa + 1, .app lf2 la, ?_⟩
      rw [erase_app_keep E n (Ff2 + Fa) [] f2 a hirr_app2,
          erase_mono E n Ff2 (Ff2 + Fa) [] f2 lf2 (Nat.le_add_right Ff2 Fa) hf2,
          erase_mono E n Fa (Ff2 + Fa) [] a la (Nat.le_add_left Fa Ff2) ha]

theorem erase_foldApps_const_delta (E : ResolvedEnv) (n r F : Nat) (ls : List Level)
    (b : Expr Nat) (args : List (Expr Nat)) {T : Expr Nat} {l : LExpr}
    (hb : transparentBody E r ls = some b)
    (hTy : ∀ T0, inferT E n [] (.const r ls) = some T0 → inferT E n [] b = some T0)
    (hi : inferT E n [] (foldApps (.const r ls) args) = some T)
    (hirr : irrelevant E n [] (foldApps (.const r ls) args) = false)
    (he : erase E n F [] (foldApps b args) = some l) :
    erase E n (F + 1) [] (foldApps (.const r ls) args) = some l := by
  refine erase_foldApps_congr_head E n args hTy ?_ hi hirr he
  intro F0 _ lf _ hirrC he2
  rw [erase_const_delta E n F0 r ls b hirrC hb]
  exact he2

theorem erasable_foldApps_const_delta (E : ResolvedEnv) (n r : Nat) (ls : List Level)
    (b : Expr Nat) (args : List (Expr Nat)) {T : Expr Nat}
    (hb : transparentBody E r ls = some b)
    (hTy : ∀ T0, inferT E n [] (.const r ls) = some T0 → inferT E n [] b = some T0)
    (hi : inferT E n [] (foldApps (.const r ls) args) = some T)
    (hirr : irrelevant E n [] (foldApps (.const r ls) args) = false)
    (her : Erasable E n (foldApps (.const r ls) args)) :
    Erasable E n (foldApps b args) := by
  refine erasable_foldApps_congr_head E n args hTy ?_ hi hirr her
  intro _ _ hirrC herC
  exact erasable_of_const_delta hirrC hb herC

theorem eval_emit_ctor_of_list {S : SigTable} (progs : Programs S S)
    (F c : Nat) (ts : List BootTy) (τ : BootTy) (dvs : List DVal) (ws : List Val)
    (hg : ts.get? c = some (.list τ))
    (hlist : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf ((relevantArgs dvs).map (emitWith relevantArgs (S := S) (G := []) (F + 1) τ))) =
      some (.list ws)) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 2) (.sum ts) (.ctor c dvs)) =
      some (.inj c (.list ws)) := by
  obtain ⟨hlt, hget⟩ := list_get?_some ts c (.list τ) hg
  simp only [emit, emitWith]
  rw [dif_pos hlt]
  split
  · rename_i τ' hτ'
    have hτeq : τ' = τ := BootTy.list.inj (hτ'.symm.trans hget)
    cases hτeq
    simp only [Residua.Bootstrap.Semantics.eval]
    rw [eval_cast_eq progs 1 [] hτ'.symm, hlist]
    rfl
  · rename_i hne
    exact absurd hget (hne τ)

theorem eval_list_of_emit_ctor {S : SigTable} (progs : Programs S S)
    (F c : Nat) (ts : List BootTy) (τ : BootTy) (dvs : List DVal) (ws : List Val)
    (hg : ts.get? c = some (.list τ))
    (he_ctor : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 2) (.sum ts) (.ctor c dvs)) =
      some (.inj c (.list ws))) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf ((relevantArgs dvs).map (emitWith relevantArgs (S := S) (G := []) (F + 1) τ))) =
      some (.list ws) := by
  obtain ⟨hlt, hget⟩ := list_get?_some ts c (.list τ) hg
  simp only [emit, emitWith] at he_ctor
  rw [dif_pos hlt] at he_ctor
  split at he_ctor
  · rename_i τ' hτ'
    have hτeq : τ' = τ := BootTy.list.inj (hτ'.symm.trans hget)
    cases hτeq
    simp only [Residua.Bootstrap.Semantics.eval] at he_ctor
    rw [eval_cast_eq progs 1 [] hτ'.symm] at he_ctor
    cases hlist : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
        (listOf (List.map (emitWith relevantArgs (S := S) (G := []) (F + 1) τ)
          (relevantArgs dvs))) with
    | none =>
        rw [hlist] at he_ctor
        exact Option.noConfusion he_ctor
    | some vlist =>
        rw [hlist] at he_ctor
        have hinj : Val.inj c vlist = Val.inj c (.list ws) := Option.some.inj he_ctor
        injection hinj with _ hv
        rw [hv]
  · rename_i hne
    exact absurd hget (hne τ)

theorem eval_emit_ctor_snoc {S : SigTable} (progs : Programs S S)
    (F c : Nat) (ts : List BootTy) (τ : BootTy) (dvs : List DVal) (dv : DVal)
    (ws : List Val) (w : Val)
    (hg : ts.get? c = some (.list τ))
    (he_ctor : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 2) (.sum ts) (.ctor c dvs)) =
      some (.inj c (.list ws)))
    (he_dv : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 1) τ dv) = some w) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) (F + 2) (.sum ts) (.ctor c (dvs ++ [dv]))) =
      some (.inj c (.list (ws ++ [w]))) := by
  have hlist := eval_list_of_emit_ctor progs F c ts τ dvs ws hg he_ctor
  have hk : relevantArgs [dv] = [dv] :=
    relevantArgs_keep_of_emit progs F 1 τ dv w he_dv
  have happ : (relevantArgs (dvs ++ [dv])).map
      (emitWith relevantArgs (S := S) (G := []) (F + 1) τ) =
      (relevantArgs dvs).map (emitWith relevantArgs (S := S) (G := []) (F + 1) τ) ++
        [emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv] := by
    rw [relevantArgs_append, hk, List.map_append, List.map_cons, List.map_nil]
  have hsnoc := eval_listOf_snoc progs
    (emitWith relevantArgs (S := S) (G := []) (F + 1) τ dv) w he_dv
    ((relevantArgs dvs).map (emitWith relevantArgs (S := S) (G := []) (F + 1) τ)) ws hlist
  rw [← happ] at hsnoc
  exact eval_emit_ctor_of_list progs F c ts τ (dvs ++ [dv]) (ws ++ [w]) hg hsnoc

theorem convWith_closed1_lam (lb : LExpr) (hcl : closedAtL 1 lb = true) :
    convWith capRen id [] (.lam lb) =
      (.clo (defunc lb).2.length [],
       (defunc lb).2 ++ [{ ncap := 0, body := (defunc lb).1 }]) := by
  have hfv : freeVars 1 lb = [] := freeVars_eq_nil_of_closedAtL lb 1 hcl
  have hren : convWith capRen (capRen []) [] lb = defunc lb :=
    convWith_ren_eq_of_closedAtL capRen lb 1 (capRen []) id [] hcl
      (fun i hi => by
        cases i with
        | zero => rfl
        | succ j => exact absurd (Nat.lt_of_succ_lt_succ hi) (Nat.not_lt_zero j))
  simp only [convWith, hfv, List.map_nil, List.length_nil, hren]

theorem run_let_closed1 (lv lb : LExpr) (F : Nat) (dv_v dv_b : DVal)
    (hcl : closedAtL 1 lb = true)
    (hgb : noGlobL lb = true)
    (hcv : noCloD dv_v = true)
    (hcb : noCloD dv_b = true)
    (hrv : run (defunc lv).2 (F + 1) [] (defunc lv).1 = some dv_v)
    (hrb : run (defunc lb).2 (F + 1) [dv_v] (defunc lb).1 = some dv_b) :
    run (defunc (.letE lv lb)).2 (F + 2) [] (defunc (.letE lv lb)).1 = some dv_b := by
  rw [run_defunc_let_step (F + 1) lv lb dv_v hrv]
  have hren : convWith capRen (liftRen id) (defunc lv).2 lb =
      convWith capRen id (defunc lv).2 lb :=
    convWith_ren_eq_of_closedAtL capRen lb 1 (liftRen id) id (defunc lv).2 hcl
      (fun i hi => by
        cases i with
        | zero => rfl
        | succ j => exact absurd (Nat.lt_of_succ_lt_succ hi) (Nat.not_lt_zero j))
  rw [hren]
  have hclean := noGlob_conv capRen id [] lb (fun _ h => nomatch h) hgb
  let pre : List Code := (defunc lv).2
  have hs := convWith_shift_start capRen id pre [] lb
  simp only [List.map_nil, List.append_nil] at hs
  have hr' := run_shift pre.length (F + 1) pre (defunc lb).2 [dv_v] (defunc lb).1
    rfl hclean.1 hclean.2
  rw [List.map_cons, List.map_nil, shiftDVal_id_of_noClo pre.length dv_v hcv,
      hrb, option_map_some, shiftDVal_id_of_noClo pre.length dv_b hcb] at hr'
  rw [hs.1, hs.2]
  exact hr'

theorem run_beta_closed1 (lb la : LExpr) (F : Nat) (dv_a dv_b : DVal)
    (hcl : closedAtL 1 lb = true)
    (hga : noGlobL la = true)
    (hca : noCloD dv_a = true)
    (hra : run (defunc la).2 (F + 1) [] (defunc la).1 = some dv_a)
    (hrb : run (defunc lb).2 (F + 1) [dv_a] (defunc lb).1 = some dv_b) :
    run (defunc (.app (.lam lb) la)).2 (F + 2) []
      (defunc (.app (.lam lb) la)).1 = some dv_b := by
  let pre : List Code := (defunc lb).2 ++ [{ ncap := 0, body := (defunc lb).1 }]
  have hlam : convWith capRen id [] (.lam lb) =
      (.clo (defunc lb).2.length [], pre) :=
    convWith_closed1_lam lb hcl
  have hdef : defunc (.app (.lam lb) la) =
      (.apply (.clo (defunc lb).2.length []) (convWith capRen id pre la).1,
       (convWith capRen id pre la).2) := by
    change (let p := convWith capRen id [] (.lam lb)
            let q := convWith capRen id p.2 la
            (DExpr.apply p.1 q.1, q.2)) = _
    rw [hlam]
  rw [hdef]
  dsimp only
  have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
  have hs := convWith_shift_start capRen id pre [] la
  simp only [List.map_nil, List.append_nil] at hs
  have hra' := run_shift pre.length (F + 1) pre (defunc la).2 [] (defunc la).1
    rfl hclean.1 hclean.2
  rw [List.map_nil, hra, option_map_some,
      shiftDVal_id_of_noClo pre.length dv_a hca] at hra'
  have hrq : run (convWith capRen id pre la).2 (F + 1) []
      (convWith capRen id pre la).1 = some dv_a := by
    rw [hs.1, hs.2]
    exact hra'
  have hc_entry : (convWith capRen id pre la).2.get? (defunc lb).2.length =
      some (⟨0, (defunc lb).1⟩ : Code) := by
    rw [hs.2]
    exact list_get?_append_of_some pre
      ((defunc la).2.map (shiftCode pre.length))
      (defunc lb).2.length ⟨0, (defunc lb).1⟩
      (list_get?_append_last (defunc lb).2 ⟨0, (defunc lb).1⟩)
  have hpre : (convWith capRen id pre la).2 =
      (defunc lb).2 ++
        ([{ ncap := 0, body := (defunc lb).1 }] ++
          (defunc la).2.map (shiftCode pre.length)) := by
    rw [hs.2]
    exact List.append_assoc (defunc lb).2 [{ ncap := 0, body := (defunc lb).1 }]
      ((defunc la).2.map (shiftCode pre.length))
  have hrb_ext : run (convWith capRen id pre la).2 (F + 1)
      [dv_a] (defunc lb).1 = some dv_b := by
    rw [hpre]
    exact run_append_code (defunc lb).2
      ([{ ncap := 0, body := (defunc lb).1 }] ++
        (defunc la).2.map (shiftCode pre.length))
      (F + 1) [dv_a] (defunc lb).1 dv_b hrb
  exact run_apply_clo_nil (convWith capRen id pre la).2 F (defunc lb).2.length []
    (convWith capRen id pre la).1 (defunc lb).1
    dv_a dv_b hc_entry hrq hrb_ext

theorem run_app_ctor_spine_step_env (lg la : LExpr) (F c : Nat)
    (env : List DVal) (dvs : List DVal) (dv : DVal)
    (henv : ∀ k, env.map (shiftDVal k) = env)
    (hga : noGlobL la = true)
    (hca : noCloD dv = true)
    (hrg : run (defunc lg).2 (F + 1) env (defunc lg).1 = some (.ctor c dvs))
    (hra : run (defunc la).2 (F + 1) env (defunc la).1 = some dv) :
    run (defunc (.app lg la)).2 (F + 2) env (defunc (.app lg la)).1 =
      some (.ctor c (dvs ++ [dv])) := by
  let pre : List Code := (defunc lg).2
  have hdef : defunc (.app lg la) =
      (.apply (defunc lg).1 (convWith capRen id pre la).1,
       (convWith capRen id pre la).2) := rfl
  rw [hdef]
  dsimp only
  obtain ⟨ext, hext⟩ := convWith_suffix capRen id pre la
  have hrg' : run (convWith capRen id pre la).2 (F + 1) env (defunc lg).1 =
      some (.ctor c dvs) := by
    rw [hext]
    exact run_append_code pre ext (F + 1) env (defunc lg).1 (.ctor c dvs) hrg
  have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
  have hs := convWith_shift_start capRen id pre [] la
  simp only [List.map_nil, List.append_nil] at hs
  have hra' := run_shift pre.length (F + 1) pre (defunc la).2 env (defunc la).1
    rfl hclean.1 hclean.2
  rw [henv pre.length, hra, option_map_some,
      shiftDVal_id_of_noClo pre.length dv hca] at hra'
  have hrq : run (convWith capRen id pre la).2 (F + 1) env
      (convWith capRen id pre la).1 = some dv := by
    rw [hs.1, hs.2]
    exact hra'
  rw [run_apply_eq (convWith capRen id pre la).2 (F + 1) env
    (defunc lg).1 (convWith capRen id pre la).1, hrg', hrq]

theorem erasable_let_of_beta {E : ResolvedEnv} {n : Nat} {A arg b T : Expr Nat}
    (hi : inferT E n [] (.app (.lam A b) arg) = some T)
    (hirr : irrelevant E n [] (.app (.lam A b) arg) = false)
    (her : Erasable E n (.app (.lam A b) arg)) :
    Erasable E n (.letE A arg b) := by
  have hirrL : irrelevant E n [] (.lam A b) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  have hirrLet : irrelevant E n [] (.letE A arg b) = false := by
    rw [irrelevant_let_eq_beta]
    exact hirr
  obtain ⟨⟨FL, lL, hL⟩, ⟨Fa, la, ha⟩⟩ := erasable_of_app_keep hirr her
  cases FL with
  | zero =>
      simp only [erase, eraseWith] at hL
      exact Option.noConfusion hL
  | succ Fb =>
      rw [erase_lam_keep E n Fb [] A b hirrL] at hL
      cases hb : erase E n Fb (.assumption A :: []) b with
      | none =>
          rw [hb] at hL
          exact Option.noConfusion hL
      | some lb =>
          have hb_let : erase E n Fb (.letBinding A arg :: []) b = some lb := by
            rw [erase_letBinding_eq_assumption]
            exact hb
          refine ⟨Fb + Fa + 1, .letE la lb, ?_⟩
          rw [erase_let_keep E n (Fb + Fa) [] A arg b hirrLet,
              erase_mono E n Fa (Fb + Fa) [] arg la (Nat.le_add_left Fa Fb) ha,
              erase_mono E n Fb (Fb + Fa) (.letBinding A arg :: []) b lb
                (Nat.le_add_right Fb Fa) hb_let]

/-! ### Code-table label bounds (`labelsLtD`, `labelsLtVal`), code-table prefix
    invariance equality (`run_append_code_eq`), shift inversion (`run_of_run_shift_noClo`),
    constructor-spine shape and exact `run` inversion (`isCtorSpineL`,
    `run_isCtorSpineL_shape`, `run_app_ctor_spine_inv`), and bidirectional 1-binder
    `let` ↔ `β` execution and adequacy equivalence (`run_let_closed1_inv`,
    `run_beta_closed1_inv`, `good_beta_of_good_let`, `good_let_of_good_beta`) -/

mutual
theorem noCloD_shiftDVal (k : Nat) : ∀ dv, noCloD (shiftDVal k dv) = noCloD dv
  | .box => rfl
  | .lit _ => rfl
  | .clo _ _ => rfl
  | .ctor _ xs => by simp only [shiftDVal, noCloD, noCloAll_shiftDVals k xs]
  | .rigid _ xs => by simp only [shiftDVal, noCloD, noCloAll_shiftDVals k xs]

theorem noCloAll_shiftDVals (k : Nat) : ∀ xs, noCloAll (shiftDVals k xs) = noCloAll xs
  | [] => rfl
  | v :: vs => by
      simp only [shiftDVals, noCloAll, noCloD_shiftDVal k v, noCloAll_shiftDVals k vs]
end

theorem noCloAll_append :
    ∀ (xs ys : List DVal), noCloAll (xs ++ ys) = (noCloAll xs && noCloAll ys)
  | [], _ => by simp only [noCloAll, List.nil_append, Bool.true_and]
  | v :: xs, ys => by
      rw [List.cons_append, noCloAll, noCloAll, noCloAll_append xs ys, Bool.and_assoc]

theorem env_map_shiftDVal_id_of_noCloAll (k : Nat) (env : List DVal)
    (h : noCloAll env = true) :
    env.map (shiftDVal k) = env := by
  rw [← shiftDVals_eq_map k env]
  exact shiftDVals_id_of_noClo k env h

theorem run_of_run_shift_noClo (k F : Nat) (pre code : List Code)
    (env : List DVal) (e : DExpr) (dv : DVal)
    (hk : pre.length = k)
    (henv : noCloAll env = true)
    (he : noGlobD e = true)
    (hcode : ∀ c ∈ code, noGlobD c.body = true)
    (hcdv : noCloD dv = true)
    (hr : run (pre ++ code.map (shiftCode k)) F env (shiftD k e) = some dv) :
    run code F env e = some dv := by
  have hs := run_shift k F pre code env e hk he hcode
  rw [env_map_shiftDVal_id_of_noCloAll k env henv, hr] at hs
  cases h0 : run code F env e with
  | none =>
      rw [h0, option_map_none] at hs
      exact Option.noConfusion hs
  | some dv0 =>
      rw [h0, option_map_some] at hs
      have hsh : shiftDVal k dv0 = dv := (Option.some.inj hs).symm
      have hc0 : noCloD dv0 = true := by
        rw [← noCloD_shiftDVal k dv0, hsh]
        exact hcdv
      rw [shiftDVal_id_of_noClo k dv0 hc0] at hsh
      rw [hsh]

def labelsLtD (B : Nat) : DExpr → Bool
  | .clo l _ => decide (l < B)
  | .apply f a => labelsLtD B f && labelsLtD B a
  | .letE v b => labelsLtD B v && labelsLtD B b
  | .glob l => decide (l < B)
  | _ => true

mutual
def labelsLtVal (B : Nat) : DVal → Bool
  | .clo l caps => decide (l < B) && labelsLtVals B caps
  | .ctor _ xs => labelsLtVals B xs
  | .rigid _ xs => labelsLtVals B xs
  | _ => true

def labelsLtVals (B : Nat) : List DVal → Bool
  | [] => true
  | v :: vs => labelsLtVal B v && labelsLtVals B vs
end

theorem labelsLtD_mono :
    ∀ (d : DExpr) {B1 B2 : Nat}, B1 ≤ B2 → labelsLtD B1 d = true → labelsLtD B2 d = true
  | .var _, _, _, _, _ => rfl
  | .box, _, _, _, _ => rfl
  | .lit _, _, _, _, _ => rfl
  | .ctor _, _, _, _, _ => rfl
  | .rigid _, _, _, _, _ => rfl
  | .clo l _, _, _, hle, h => by
      simp only [labelsLtD, decide_eq_true_eq] at h ⊢
      exact Nat.lt_of_lt_of_le h hle
  | .glob l, _, _, hle, h => by
      simp only [labelsLtD, decide_eq_true_eq] at h ⊢
      exact Nat.lt_of_lt_of_le h hle
  | .apply f a, _, _, hle, h => by
      simp only [labelsLtD, Bool.and_eq_true] at h ⊢
      exact ⟨labelsLtD_mono f hle h.1, labelsLtD_mono a hle h.2⟩
  | .letE v b, _, _, hle, h => by
      simp only [labelsLtD, Bool.and_eq_true] at h ⊢
      exact ⟨labelsLtD_mono v hle h.1, labelsLtD_mono b hle h.2⟩

mutual
theorem labelsLtVal_of_noCloD (B : Nat) :
    ∀ (dv : DVal), noCloD dv = true → labelsLtVal B dv = true
  | .box, _ => rfl
  | .lit _, _ => rfl
  | .clo _ _, h => Bool.noConfusion h
  | .ctor _ xs, h => by
      simp only [noCloD] at h
      simp only [labelsLtVal]
      exact labelsLtVals_of_noCloAll B xs h
  | .rigid _ xs, h => by
      simp only [noCloD] at h
      simp only [labelsLtVal]
      exact labelsLtVals_of_noCloAll B xs h

theorem labelsLtVals_of_noCloAll (B : Nat) :
    ∀ (xs : List DVal), noCloAll xs = true → labelsLtVals B xs = true
  | [], _ => rfl
  | v :: vs, h => by
      simp only [noCloAll, Bool.and_eq_true] at h
      simp only [labelsLtVals, Bool.and_eq_true]
      exact ⟨labelsLtVal_of_noCloD B v h.1, labelsLtVals_of_noCloAll B vs h.2⟩
end

theorem labelsLtVals_append (B : Nat) :
    ∀ (xs ys : List DVal),
      labelsLtVals B (xs ++ ys) = (labelsLtVals B xs && labelsLtVals B ys)
  | [], _ => by simp only [labelsLtVals, List.nil_append, Bool.true_and]
  | v :: xs, ys => by
      rw [List.cons_append, labelsLtVals, labelsLtVals, labelsLtVals_append B xs ys,
        Bool.and_assoc]

theorem labelsLtVal_of_get? (B : Nat) :
    ∀ (env : List DVal) (i : Nat) (dv : DVal),
      labelsLtVals B env = true → env.get? i = some dv → labelsLtVal B dv = true
  | [], _, _, _, h => Option.noConfusion h
  | v :: _, 0, dv, hall, h => by
      simp only [labelsLtVals, Bool.and_eq_true] at hall
      simp only [List.get?_cons_zero] at h
      have hdv : dv = v := (Option.some.inj h).symm
      rw [hdv]
      exact hall.1
  | _ :: vs, i + 1, dv, hall, h => by
      simp only [labelsLtVals, Bool.and_eq_true] at hall
      simp only [List.get?_cons_succ] at h
      exact labelsLtVal_of_get? B vs i dv hall.2 h

theorem labelsLtVals_of_mapM_get? (B : Nat) (env : List DVal)
    (henv : labelsLtVals B env = true) :
    ∀ (caps : List Nat) (vs : List DVal),
      caps.mapM (fun i => env.get? i) = some vs →
      labelsLtVals B vs = true
  | [], vs, h => by
      simp only [List.mapM_nil, Option.pure_def] at h
      have hvs : vs = [] := (Option.some.inj h).symm
      subst hvs
      rfl
  | i :: caps, vs, h => by
      rw [List.mapM_cons] at h
      cases hg : env.get? i with
      | none =>
          simp only [hg, Option.bind, Option.none_bind] at h
          exact Option.noConfusion h
      | some v =>
          simp only [hg, Option.bind] at h
          cases hrest : caps.mapM (fun j => env.get? j) with
          | none =>
              simp only [hrest] at h
              exact Option.noConfusion h
          | some vst =>
              simp only [hrest, Option.pure_def] at h
              have hvs : vs = v :: vst := (Option.some.inj h).symm
              subst hvs
              simp only [labelsLtVals, Bool.and_eq_true]
              exact ⟨labelsLtVal_of_get? B env i v henv hg,
                labelsLtVals_of_mapM_get? B env henv caps vst hrest⟩

theorem list_get?_append_of_lt {α : Type} :
    ∀ (xs ys : List α) (i : Nat), i < xs.length → (xs ++ ys).get? i = xs.get? i
  | [], _, _, h => absurd h (Nat.not_lt_zero _)
  | _ :: _, _, 0, _ => rfl
  | _ :: xs, ys, i + 1, h =>
      list_get?_append_of_lt xs ys i (Nat.lt_of_succ_lt_succ h)

theorem convWith_length_le (cr : List Nat → Nat → Nat) (ρ : Nat → Nat)
    (code : List Code) (l : LExpr) :
    code.length ≤ (convWith cr ρ code l).2.length := by
  obtain ⟨ext, hext⟩ := convWith_suffix cr ρ code l
  rw [hext, List.length_append]
  exact Nat.le_add_right code.length ext.length

theorem labelsLtD_convWith (cr : List Nat → Nat → Nat) :
    ∀ (l : LExpr) (ρ : Nat → Nat) (code : List Code),
      noGlobL l = true →
      (∀ c ∈ code, labelsLtD code.length c.body = true) →
      labelsLtD (convWith cr ρ code l).2.length (convWith cr ρ code l).1 = true ∧
      ∀ c ∈ (convWith cr ρ code l).2, labelsLtD (convWith cr ρ code l).2.length c.body = true
  | .bvar _, _, _, _, hcode => ⟨rfl, hcode⟩
  | .box, _, _, _, hcode => ⟨rfl, hcode⟩
  | .lit _, _, _, _, hcode => ⟨rfl, hcode⟩
  | .ctor _, _, _, _, hcode => ⟨rfl, hcode⟩
  | .rigid _, _, _, _, hcode => ⟨rfl, hcode⟩
  | .glob _, _, _, hl, _ => Bool.noConfusion hl
  | .app f a, ρ, code, hl, hcode => by
      simp only [noGlobL, Bool.and_eq_true] at hl
      obtain ⟨hf1, hf2⟩ := labelsLtD_convWith cr f ρ code hl.1 hcode
      obtain ⟨ha1, ha2⟩ := labelsLtD_convWith cr a ρ (convWith cr ρ code f).2 hl.2 hf2
      have hle : (convWith cr ρ code f).2.length ≤
          (convWith cr ρ (convWith cr ρ code f).2 a).2.length :=
        convWith_length_le cr ρ (convWith cr ρ code f).2 a
      simp only [convWith, labelsLtD, Bool.and_eq_true]
      exact ⟨⟨labelsLtD_mono (convWith cr ρ code f).1 hle hf1, ha1⟩, ha2⟩
  | .lam b, _, code, hl, hcode => by
      simp only [noGlobL] at hl
      let fs := freeVars 1 b
      obtain ⟨hb1, hb2⟩ := labelsLtD_convWith cr b (cr fs) code hl hcode
      let p := convWith cr (cr fs) code b
      let entry : Code := { ncap := fs.length, body := p.1 }
      have hlen : (p.2 ++ [entry]).length = p.2.length + 1 := by
        rw [List.length_append, List.length_singleton]
      have hle : p.2.length ≤ (p.2 ++ [entry]).length := by
        rw [hlen]
        exact Nat.le_succ p.2.length
      simp only [convWith]
      refine ⟨?_, ?_⟩
      · simp only [labelsLtD, decide_eq_true_eq]
        change p.2.length < (p.2 ++ [entry]).length
        rw [hlen]
        exact Nat.lt_succ_self p.2.length
      · intro c hc
        simp only [List.mem_append, List.mem_singleton] at hc
        rcases hc with hc1 | rfl
        · exact labelsLtD_mono c.body hle (hb2 c hc1)
        · exact labelsLtD_mono p.1 hle hb1
  | .letE v b, ρ, code, hl, hcode => by
      simp only [noGlobL, Bool.and_eq_true] at hl
      obtain ⟨hv1, hv2⟩ := labelsLtD_convWith cr v ρ code hl.1 hcode
      obtain ⟨hb1, hb2⟩ := labelsLtD_convWith cr b (liftRen ρ) (convWith cr ρ code v).2 hl.2 hv2
      have hle : (convWith cr ρ code v).2.length ≤
          (convWith cr (liftRen ρ) (convWith cr ρ code v).2 b).2.length :=
        convWith_length_le cr (liftRen ρ) (convWith cr ρ code v).2 b
      simp only [convWith, labelsLtD, Bool.and_eq_true]
      exact ⟨⟨labelsLtD_mono (convWith cr ρ code v).1 hle hv1, hb1⟩, hb2⟩

theorem labelsLtD_defunc (l : LExpr) (hl : noGlobL l = true) :
    labelsLtD (defunc l).2.length (defunc l).1 = true ∧
    ∀ c ∈ (defunc l).2, labelsLtD (defunc l).2.length c.body = true :=
  labelsLtD_convWith capRen l id [] hl (fun _ h => nomatch h)

theorem run_labelsLtVal (code : List Code)
    (hcode : ∀ c ∈ code, labelsLtD code.length c.body = true) :
    ∀ (F : Nat) (env : List DVal) (e : DExpr) (dv : DVal),
      labelsLtD code.length e = true →
      labelsLtVals code.length env = true →
      run code F env e = some dv →
      labelsLtVal code.length dv = true := by
  intro F
  induction F with
  | zero =>
      intro _ _ _ _ _ h
      unfold run runWith at h
      exact Option.noConfusion h
  | succ F ih =>
      intro env e dv he henv h
      cases e with
      | var i =>
          rw [run_var_eq] at h
          exact labelsLtVal_of_get? code.length env i dv henv h
      | box =>
          rw [run_box_eq] at h
          have hdv : dv = .box := (Option.some.inj h).symm
          subst hdv
          rfl
      | lit k =>
          rw [run_lit_eq] at h
          have hdv : dv = .lit k := (Option.some.inj h).symm
          subst hdv
          rfl
      | ctor r =>
          rw [run_ctor_eq] at h
          have hdv : dv = .ctor r [] := (Option.some.inj h).symm
          subst hdv
          rfl
      | rigid r =>
          rw [run_rigid_eq] at h
          have hdv : dv = .rigid r [] := (Option.some.inj h).symm
          subst hdv
          rfl
      | clo l caps =>
          rw [run_clo_eq] at h
          cases hm : caps.mapM (fun i => env.get? i) with
          | none =>
              rw [hm, option_map_none] at h
              exact Option.noConfusion h
          | some vs =>
              rw [hm, option_map_some] at h
              have hdv : dv = .clo l vs := (Option.some.inj h).symm
              subst hdv
              simp only [labelsLtD] at he
              simp only [labelsLtVal, Bool.and_eq_true]
              exact ⟨he, labelsLtVals_of_mapM_get? code.length env henv caps vs hm⟩
      | glob l =>
          rw [run_glob_eq] at h
          cases hc : code.get? l with
          | none =>
              rw [hc] at h
              exact Option.noConfusion h
          | some c =>
              rw [hc] at h
              exact ih [] c.body dv (hcode c (list_mem_of_get? code l c hc)) rfl h
      | apply g a =>
          simp only [labelsLtD, Bool.and_eq_true] at he
          rw [run_apply_eq] at h
          cases hg : run code F env g with
          | none =>
              rw [hg] at h
              exact Option.noConfusion h
          | some vg =>
              rw [hg] at h
              have hvg := ih env g vg he.1 henv hg
              cases ha : run code F env a with
              | none =>
                  rw [ha] at h
                  cases vg <;> exact Option.noConfusion h
              | some va =>
                  rw [ha] at h
                  have hva := ih env a va he.2 henv ha
                  cases vg with
                  | box =>
                      have hdv : dv = .box := (Option.some.inj h).symm
                      subst hdv
                      rfl
                  | lit _ => exact Option.noConfusion h
                  | ctor r args =>
                      have hdv : dv = .ctor r (args ++ [va]) := (Option.some.inj h).symm
                      subst hdv
                      simp only [labelsLtVal] at hvg ⊢
                      rw [labelsLtVals_append]
                      simp only [labelsLtVals, Bool.and_true, Bool.and_eq_true]
                      exact ⟨hvg, hva⟩
                  | rigid r args =>
                      have hdv : dv = .rigid r (args ++ [va]) := (Option.some.inj h).symm
                      subst hdv
                      simp only [labelsLtVal] at hvg ⊢
                      rw [labelsLtVals_append]
                      simp only [labelsLtVals, Bool.and_true, Bool.and_eq_true]
                      exact ⟨hvg, hva⟩
                  | clo l caps =>
                      simp only [labelsLtVal, Bool.and_eq_true] at hvg
                      have h' : (match code.get? l with
                          | some c => run code F (bindArg va caps) c.body
                          | none => none) = some dv := h
                      cases hc : code.get? l with
                      | none =>
                          rw [hc] at h'
                          exact Option.noConfusion h'
                      | some c =>
                          rw [hc] at h'
                          have hbind : labelsLtVals code.length (bindArg va caps) = true := by
                            simp only [bindArg, labelsLtVals, Bool.and_eq_true]
                            exact ⟨hva, hvg.2⟩
                          exact ih (bindArg va caps) c.body dv
                            (hcode c (list_mem_of_get? code l c hc)) hbind h'
      | letE v b =>
          simp only [labelsLtD, Bool.and_eq_true] at he
          rw [run_let_eq] at h
          cases hv : run code F env v with
          | none =>
              rw [hv] at h
              exact Option.noConfusion h
          | some vv =>
              rw [hv] at h
              have hvv := ih env v vv he.1 henv hv
              have henv' : labelsLtVals code.length (vv :: env) = true := by
                simp only [labelsLtVals, Bool.and_eq_true]
                exact ⟨hvv, henv⟩
              exact ih (vv :: env) b dv he.2 henv' h

theorem run_append_code_eq (code ext : List Code)
    (hcode : ∀ c ∈ code, labelsLtD code.length c.body = true) :
    ∀ (F : Nat) (env : List DVal) (e : DExpr),
      labelsLtD code.length e = true →
      labelsLtVals code.length env = true →
      run (code ++ ext) F env e = run code F env e := by
  intro F
  induction F with
  | zero =>
      intro _ _ _ _
      rfl
  | succ F ih =>
      intro env e he henv
      cases e with
      | var i =>
          rw [run_var_eq, run_var_eq]
      | box =>
          rw [run_box_eq, run_box_eq]
      | lit k =>
          rw [run_lit_eq, run_lit_eq]
      | ctor r =>
          rw [run_ctor_eq, run_ctor_eq]
      | rigid r =>
          rw [run_rigid_eq, run_rigid_eq]
      | clo l caps =>
          rw [run_clo_eq, run_clo_eq]
      | glob l =>
          simp only [labelsLtD, decide_eq_true_eq] at he
          rw [run_glob_eq, run_glob_eq, list_get?_append_of_lt code ext l he]
          cases hc : code.get? l with
          | none => rfl
          | some c =>
              exact ih [] c.body (hcode c (list_mem_of_get? code l c hc)) rfl
      | apply g a =>
          simp only [labelsLtD, Bool.and_eq_true] at he
          rw [run_apply_eq, run_apply_eq, ih env g he.1 henv, ih env a he.2 henv]
          cases hg : run code F env g with
          | none => rfl
          | some vg =>
              cases ha : run code F env a with
              | none =>
                  cases vg <;> rfl
              | some va =>
                  cases vg with
                  | box => rfl
                  | lit _ => rfl
                  | ctor _ _ => rfl
                  | rigid _ _ => rfl
                  | clo l caps =>
                      have hvg := run_labelsLtVal code hcode F env g (.clo l caps) he.1 henv hg
                      have hva := run_labelsLtVal code hcode F env a va he.2 henv ha
                      simp only [labelsLtVal, Bool.and_eq_true, decide_eq_true_eq] at hvg
                      change (match (code ++ ext).get? l with
                          | some c => run (code ++ ext) F (bindArg va caps) c.body
                          | none => none) =
                        (match code.get? l with
                          | some c => run code F (bindArg va caps) c.body
                          | none => none)
                      rw [list_get?_append_of_lt code ext l hvg.1]
                      cases hc : code.get? l with
                      | none => rfl
                      | some c =>
                          have hbind : labelsLtVals code.length (bindArg va caps) = true := by
                            simp only [bindArg, labelsLtVals, Bool.and_eq_true]
                            exact ⟨hva, hvg.2⟩
                          exact ih (bindArg va caps) c.body
                            (hcode c (list_mem_of_get? code l c hc)) hbind
      | letE v b =>
          simp only [labelsLtD, Bool.and_eq_true] at he
          rw [run_let_eq, run_let_eq, ih env v he.1 henv]
          cases hv : run code F env v with
          | none => rfl
          | some vv =>
              have hvv := run_labelsLtVal code hcode F env v vv he.1 henv hv
              have henv' : labelsLtVals code.length (vv :: env) = true := by
                simp only [labelsLtVals, Bool.and_eq_true]
                exact ⟨hvv, henv⟩
              exact ih (vv :: env) b he.2 henv'

def isCtorSpineL (c : Nat) : LExpr → Bool
  | .ctor r => decide (r = c)
  | .app g _ => isCtorSpineL c g
  | _ => false

theorem run_isCtorSpineL_shape (c : Nat) :
    ∀ (lg : LExpr) (ρ : Nat → Nat) (pre code : List Code)
      (F : Nat) (env : List DVal) (dv : DVal),
      isCtorSpineL c lg = true →
      run code F env (convWith capRen ρ pre lg).1 = some dv →
      ∃ dvs, dv = .ctor c dvs
  | .bvar _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .box, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .lit _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .rigid _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .lam _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .letE _ _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .glob _, _, _, _, _, _, _, h, _ => Bool.noConfusion h
  | .ctor r, _, _, _, 0, _, _, _, hr => by
      unfold run runWith at hr
      exact Option.noConfusion hr
  | .ctor r, _, _, _, F + 1, _, dv, h, hr => by
      have hrc : r = c := of_decide_eq_true h
      subst hrc
      simp only [convWith] at hr
      rw [run_ctor_eq] at hr
      exact ⟨[], (Option.some.inj hr).symm⟩
  | .app g a, _, _, _, 0, _, _, _, hr => by
      unfold run runWith at hr
      exact Option.noConfusion hr
  | .app g a, ρ, pre, code, F + 1, env, dv, h, hr => by
      simp only [isCtorSpineL] at h
      simp only [convWith] at hr
      rw [run_apply_eq] at hr
      cases hg : run code F env (convWith capRen ρ pre g).1 with
      | none =>
          rw [hg] at hr
          exact Option.noConfusion hr
      | some vg =>
          rw [hg] at hr
          obtain ⟨dvs, hvg⟩ :=
            run_isCtorSpineL_shape c g ρ pre code F env vg h hg
          subst hvg
          cases ha : run code F env (convWith capRen ρ (convWith capRen ρ pre g).2 a).1 with
          | none =>
              rw [ha] at hr
              exact Option.noConfusion hr
          | some va =>
              rw [ha] at hr
              exact ⟨dvs ++ [va], (Option.some.inj hr).symm⟩

theorem run_app_ctor_spine_inv (lg la : LExpr) (F c : Nat)
    (env : List DVal) (dv : DVal)
    (hcs : isCtorSpineL c lg = true)
    (hgg : noGlobL lg = true)
    (hga : noGlobL la = true)
    (henv : noCloAll env = true)
    (hcdv : noCloD dv = true)
    (hr : run (defunc (.app lg la)).2 F env (defunc (.app lg la)).1 = some dv) :
    ∃ F' dvs va, F = F' + 1 ∧
      noCloAll dvs = true ∧
      noCloD va = true ∧
      run (defunc lg).2 F' env (defunc lg).1 = some (.ctor c dvs) ∧
      run (defunc la).2 F' env (defunc la).1 = some va ∧
      dv = .ctor c (dvs ++ [va]) := by
  cases F with
  | zero =>
      unfold run runWith at hr
      exact Option.noConfusion hr
  | succ F' =>
      let pre : List Code := (defunc lg).2
      have hdef : defunc (.app lg la) =
          (.apply (defunc lg).1 (convWith capRen id pre la).1,
           (convWith capRen id pre la).2) := rfl
      rw [hdef] at hr
      dsimp only at hr
      rw [run_apply_eq] at hr
      cases hrg_ext : run (convWith capRen id pre la).2 F' env (defunc lg).1 with
      | none =>
          rw [hrg_ext] at hr
          exact Option.noConfusion hr
      | some vg =>
          rw [hrg_ext] at hr
          obtain ⟨dvs, hvg⟩ :=
            run_isCtorSpineL_shape c lg id [] (convWith capRen id pre la).2 F' env vg hcs hrg_ext
          subst hvg
          cases hra_ext : run (convWith capRen id pre la).2 F' env
              (convWith capRen id pre la).1 with
          | none =>
              rw [hra_ext] at hr
              exact Option.noConfusion hr
          | some va =>
              rw [hra_ext] at hr
              have hdv : dv = .ctor c (dvs ++ [va]) := (Option.some.inj hr).symm
              have hcdv' : noCloD (.ctor c (dvs ++ [va])) = true := hdv ▸ hcdv
              simp only [noCloD, noCloAll_append, noCloAll, Bool.and_true,
                Bool.and_eq_true] at hcdv'
              obtain ⟨ext, hext⟩ := convWith_suffix capRen id pre la
              obtain ⟨hlg1, hlg2⟩ := labelsLtD_defunc lg hgg
              have hrg : run (defunc lg).2 F' env (defunc lg).1 = some (.ctor c dvs) := by
                rw [← run_append_code_eq pre ext hlg2 F' env (defunc lg).1 hlg1
                  (labelsLtVals_of_noCloAll pre.length env henv), ← hext]
                exact hrg_ext
              have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
              have hs := convWith_shift_start capRen id pre [] la
              simp only [List.map_nil, List.append_nil] at hs
              rw [hs.1, hs.2] at hra_ext
              have hra : run (defunc la).2 F' env (defunc la).1 = some va :=
                run_of_run_shift_noClo pre.length F' pre (defunc la).2 env (defunc la).1 va
                  rfl henv hclean.1 hclean.2 hcdv'.2 hra_ext
              exact ⟨F', dvs, va, rfl, hcdv'.1, hcdv'.2, hrg, hra, hdv⟩

theorem erase_app_keep_inv {E : ResolvedEnv} {n F : Nat} {Γ : LCtx}
    {g a : Expr Nat} {l : LExpr}
    (hirr : irrelevant E n Γ (.app g a) = false)
    (he : erase E n F Γ (.app g a) = some l) :
    ∃ F' lg la, F = F' + 1 ∧
      erase E n F' Γ g = some lg ∧
      erase E n F' Γ a = some la ∧
      l = .app lg la := by
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_app_keep E n F' Γ g a hirr] at he
      cases hg : erase E n F' Γ g with
      | none =>
          rw [hg] at he
          exact Option.noConfusion he
      | some lg =>
          cases ha : erase E n F' Γ a with
          | none =>
              rw [hg, ha] at he
              exact Option.noConfusion he
          | some la =>
              rw [hg, ha] at he
              exact ⟨F', lg, la, rfl, hg, ha, (Option.some.inj he).symm⟩

theorem erase_const_ctor_inv {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {Γ : LCtx} {l : LExpr}
    (hirr : irrelevant E n Γ (.const c lsc) = false)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (he : erase E n F Γ (.const c lsc) = some l) :
    ∃ F', F = F' + 1 ∧ l = .ctor c := by
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      simp only [erase, eraseWith, hirr, Bool.false_eq_true, if_false,
        noGlobals, hnone, hctor, if_true] at he
      exact ⟨F', rfl, (Option.some.inj he).symm⟩

theorem run_let_closed1_inv (lv lb : LExpr) (F : Nat) (dv_b : DVal)
    (hcl : closedAtL 1 lb = true)
    (hgv : noGlobL lv = true)
    (hgb : noGlobL lb = true)
    (hcb : noCloD dv_b = true)
    (hnoClo_v : ∀ Fv dv_v, run (defunc lv).2 Fv [] (defunc lv).1 = some dv_v →
      noCloD dv_v = true)
    (hr : run (defunc (.letE lv lb)).2 F [] (defunc (.letE lv lb)).1 = some dv_b) :
    ∃ F' dv_v, F = F' + 1 ∧
      noCloD dv_v = true ∧
      run (defunc lv).2 F' [] (defunc lv).1 = some dv_v ∧
      run (defunc lb).2 F' [dv_v] (defunc lb).1 = some dv_b := by
  cases F with
  | zero =>
      unfold run runWith at hr
      exact Option.noConfusion hr
  | succ F' =>
      let pre : List Code := (defunc lv).2
      have hdef : defunc (.letE lv lb) =
          (.letE (defunc lv).1 (convWith capRen (liftRen id) pre lb).1,
           (convWith capRen (liftRen id) pre lb).2) := rfl
      rw [hdef] at hr
      dsimp only at hr
      rw [run_let_eq] at hr
      cases hrv_ext : run (convWith capRen (liftRen id) pre lb).2 F' [] (defunc lv).1 with
      | none =>
          rw [hrv_ext] at hr
          exact Option.noConfusion hr
      | some dv_v =>
          rw [hrv_ext] at hr
          obtain ⟨ext, hext⟩ := convWith_suffix capRen (liftRen id) pre lb
          obtain ⟨hlv1, hlv2⟩ := labelsLtD_defunc lv hgv
          have hrv : run (defunc lv).2 F' [] (defunc lv).1 = some dv_v := by
            rw [← run_append_code_eq pre ext hlv2 F' [] (defunc lv).1 hlv1 rfl, ← hext]
            exact hrv_ext
          have hcv : noCloD dv_v = true := hnoClo_v F' dv_v hrv
          have hren : convWith capRen (liftRen id) pre lb = convWith capRen id pre lb :=
            convWith_ren_eq_of_closedAtL capRen lb 1 (liftRen id) id pre hcl
              (fun i hi => by
                cases i with
                | zero => rfl
                | succ j => exact absurd (Nat.lt_of_succ_lt_succ hi) (Nat.not_lt_zero j))
          rw [hren] at hr
          have hclean := noGlob_conv capRen id [] lb (fun _ h => nomatch h) hgb
          have hs := convWith_shift_start capRen id pre [] lb
          simp only [List.map_nil, List.append_nil] at hs
          rw [hs.1, hs.2] at hr
          have henv : noCloAll [dv_v] = true := by simp [noCloAll, hcv]
          have hrb : run (defunc lb).2 F' [dv_v] (defunc lb).1 = some dv_b :=
            run_of_run_shift_noClo pre.length F' pre (defunc lb).2 [dv_v] (defunc lb).1 dv_b
              rfl henv hclean.1 hclean.2 hcb hr
          exact ⟨F', dv_v, rfl, hcv, hrv, hrb⟩

theorem run_beta_closed1_inv (lb la : LExpr) (F : Nat) (dv_b : DVal)
    (hcl : closedAtL 1 lb = true)
    (hga : noGlobL la = true)
    (hgb : noGlobL lb = true)
    (hnoClo_a : ∀ Fa dv_a, run (defunc la).2 Fa [] (defunc la).1 = some dv_a →
      noCloD dv_a = true)
    (hr : run (defunc (.app (.lam lb) la)).2 F []
      (defunc (.app (.lam lb) la)).1 = some dv_b) :
    ∃ F' dv_a, F = F' + 2 ∧
      noCloD dv_a = true ∧
      run (defunc la).2 (F' + 1) [] (defunc la).1 = some dv_a ∧
      run (defunc lb).2 (F' + 1) [dv_a] (defunc lb).1 = some dv_b := by
  cases F with
  | zero =>
      unfold run runWith at hr
      exact Option.noConfusion hr
  | succ F' =>
      let pre : List Code := (defunc lb).2 ++ [{ ncap := 0, body := (defunc lb).1 }]
      have hlam : convWith capRen id [] (.lam lb) =
          (.clo (defunc lb).2.length [], pre) :=
        convWith_closed1_lam lb hcl
      have hdef : defunc (.app (.lam lb) la) =
          (.apply (.clo (defunc lb).2.length []) (convWith capRen id pre la).1,
           (convWith capRen id pre la).2) := by
        change (let p := convWith capRen id [] (.lam lb)
                let q := convWith capRen id p.2 la
                (DExpr.apply p.1 q.1, q.2)) = _
        rw [hlam]
      rw [hdef] at hr
      dsimp only at hr
      cases F' with
      | zero =>
          rw [run_apply_eq] at hr
          have h0 : run (convWith capRen id pre la).2 0 []
              (.clo (defunc lb).2.length []) = none := rfl
          rw [h0] at hr
          exact Option.noConfusion hr
      | succ F'' =>
          rw [run_apply_eq] at hr
          have hclo : run (convWith capRen id pre la).2 (F'' + 1) []
              (.clo (defunc lb).2.length []) =
              some (.clo (defunc lb).2.length []) := by
            rw [run_clo_eq]
            rfl
          rw [hclo] at hr
          cases hra_ext : run (convWith capRen id pre la).2 (F'' + 1) []
              (convWith capRen id pre la).1 with
          | none =>
              rw [hra_ext] at hr
              exact Option.noConfusion hr
          | some va =>
              rw [hra_ext] at hr
              have hclean := noGlob_conv capRen id [] la (fun _ h => nomatch h) hga
              have hs := convWith_shift_start capRen id pre [] la
              simp only [List.map_nil, List.append_nil] at hs
              have hsh : (run (defunc la).2 (F'' + 1) [] (defunc la).1).map
                  (shiftDVal pre.length) = some va := by
                have hsh0 := (run_shift pre.length (F'' + 1) pre (defunc la).2 [] (defunc la).1
                  rfl hclean.1 hclean.2).symm
                rw [List.map_nil] at hsh0
                have hra_sh : run (pre ++ (defunc la).2.map (shiftCode pre.length)) (F'' + 1) []
                    (shiftD pre.length (defunc la).1) = some va := by
                  change run (pre ++ (convWith capRen id [] la).2.map (shiftCode pre.length))
                      (F'' + 1) [] (shiftD pre.length (convWith capRen id [] la).1) = some va
                  rw [← hs.1, ← hs.2]
                  exact hra_ext
                exact hsh0.trans hra_sh
              cases hra : run (defunc la).2 (F'' + 1) [] (defunc la).1 with
              | none =>
                  rw [hra, option_map_none] at hsh
                  exact Option.noConfusion hsh
              | some dv_a =>
                  rw [hra, option_map_some] at hsh
                  have hca : noCloD dv_a = true := hnoClo_a (F'' + 1) dv_a hra
                  have hva : va = dv_a := by
                    rw [← Option.some.inj hsh, shiftDVal_id_of_noClo pre.length dv_a hca]
                  rw [hva] at hr
                  have hc_entry : (convWith capRen id pre la).2.get? (defunc lb).2.length =
                      some (⟨0, (defunc lb).1⟩ : Code) := by
                    rw [hs.2]
                    exact list_get?_append_of_some pre
                      ((defunc la).2.map (shiftCode pre.length))
                      (defunc lb).2.length ⟨0, (defunc lb).1⟩
                      (list_get?_append_last (defunc lb).2 ⟨0, (defunc lb).1⟩)
                  have hr' : (match (convWith capRen id pre la).2.get? (defunc lb).2.length with
                      | some c => run (convWith capRen id pre la).2 (F'' + 1) [dv_a] c.body
                      | none => none) = some dv_b := hr
                  rw [hc_entry] at hr'
                  dsimp only at hr'
                  have hpre : (convWith capRen id pre la).2 =
                      (defunc lb).2 ++
                        ([{ ncap := 0, body := (defunc lb).1 }] ++
                          (defunc la).2.map (shiftCode pre.length)) := by
                    rw [hs.2]
                    exact List.append_assoc (defunc lb).2 [{ ncap := 0, body := (defunc lb).1 }]
                      ((defunc la).2.map (shiftCode pre.length))
                  obtain ⟨hlb1, hlb2⟩ := labelsLtD_defunc lb hgb
                  have henv : labelsLtVals (defunc lb).2.length [dv_a] = true := by
                    simp only [labelsLtVals, labelsLtVal_of_noCloD (defunc lb).2.length dv_a hca,
                      Bool.and_self]
                  have hrb : run (defunc lb).2 (F'' + 1) [dv_a] (defunc lb).1 = some dv_b := by
                    rw [← run_append_code_eq (defunc lb).2
                      ([{ ncap := 0, body := (defunc lb).1 }] ++
                        (defunc la).2.map (shiftCode pre.length))
                      hlb2 (F'' + 1) [dv_a] (defunc lb).1 hlb1 henv, ← hpre]
                    exact hr'
                  exact ⟨F'', dv_a, rfl, hca, hra, hrb⟩

theorem erasable_beta_of_let {E : ResolvedEnv} {n : Nat} {A arg b : Expr Nat}
    (hirr : irrelevant E n [] (.letE A arg b) = false)
    (her : Erasable E n (.letE A arg b)) :
    Erasable E n (.app (.lam A b) arg) := by
  have hirrBeta : irrelevant E n [] (.app (.lam A b) arg) = false := by
    rw [← irrelevant_let_eq_beta]
    exact hirr
  obtain ⟨F, l, he⟩ := her
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_let_keep E n F' [] A arg b hirr] at he
      cases ha : erase E n F' [] arg with
      | none =>
          rw [ha] at he
          exact Option.noConfusion he
      | some la =>
          cases hb : erase E n F' (.letBinding A arg :: []) b with
          | none =>
              rw [ha, hb] at he
              exact Option.noConfusion he
          | some lb =>
              rw [erase_letBinding_eq_assumption] at hb
              by_cases hirrL : irrelevant E n [] (.lam A b) = true
              · have hL : erase E n (F' + 1) [] (.lam A b) = some .box := by
                  simp only [erase, eraseWith, hirrL, if_true]
                have ha1 : erase E n (F' + 1) [] arg = some la :=
                  erase_mono E n F' (F' + 1) [] arg la (Nat.le_succ F') ha
                refine ⟨F' + 2, .app .box la, ?_⟩
                rw [erase_app_keep E n (F' + 1) [] (.lam A b) arg hirrBeta, hL, ha1]
              · have hirrLf : irrelevant E n [] (.lam A b) = false :=
                  Bool.eq_false_iff.mpr hirrL
                have hL : erase E n (F' + 1) [] (.lam A b) = some (.lam lb) := by
                  rw [erase_lam_keep E n F' [] A b hirrLf, hb]
                  rfl
                have ha1 : erase E n (F' + 1) [] arg = some la :=
                  erase_mono E n F' (F' + 1) [] arg la (Nat.le_succ F') ha
                refine ⟨F' + 2, .app (.lam lb) la, ?_⟩
                rw [erase_app_keep E n (F' + 1) [] (.lam A b) arg hirrBeta, hL, ha1]

/-! ### Cross-fuel determinism of `erase` and `run` (`erase_unique`, `run_unique`),
    syntactic first-order (`noLamL`, `noCloExprD`) closure-freeness
    (`noCloD_of_run_noLamL`), single-witness `let` ↔ `β` adequacy equivalence
    (`good_beta_of_good_let_of_noLamL`, `good_let_of_good_beta_of_noLamL`,
    `good_beta_of_good_let_of_val`, `good_let_of_good_beta_of_val`,
    `good_beta_of_good_let_of_irrelevant`, `good_let_of_good_beta_of_irrelevant`),
    closed-type relevance invariance under `instantiate0`
    (`irrelevant_instantiate0_eq_of_closed_ty`), and binary constructor `let`/`β`
    defunctionalized reduction (`run_let_ctor2_left_val`, `run_beta_ctor2_left_val`,
    `run_let_ctor2_right_val`, `run_beta_ctor2_right_val`,
    `run_let_ctor2_diag_val`, `run_beta_ctor2_diag_val`) -/

theorem erase_unique (E : ResolvedEnv) (n F1 F2 : Nat) (Γ : LCtx)
    (e : Expr Nat) (l1 l2 : LExpr)
    (h1 : erase E n F1 Γ e = some l1)
    (h2 : erase E n F2 Γ e = some l2) :
    l1 = l2 := by
  have h1' : erase E n (F1 + F2) Γ e = some l1 :=
    erase_mono E n F1 (F1 + F2) Γ e l1 (Nat.le_add_right F1 F2) h1
  have h2' : erase E n (F1 + F2) Γ e = some l2 :=
    erase_mono E n F2 (F1 + F2) Γ e l2 (Nat.le_add_left F2 F1) h2
  rw [h1'] at h2'
  exact Option.some.inj h2'

theorem run_unique (code : List Code) (F1 F2 : Nat) (env : List DVal)
    (d : DExpr) (dv1 dv2 : DVal)
    (h1 : run code F1 env d = some dv1)
    (h2 : run code F2 env d = some dv2) :
    dv1 = dv2 := by
  have h1' : run code (F1 + F2) env d = some dv1 :=
    run_mono code F1 (F1 + F2) env d dv1 (Nat.le_add_right F1 F2) h1
  have h2' : run code (F1 + F2) env d = some dv2 :=
    run_mono code F2 (F1 + F2) env d dv2 (Nat.le_add_left F2 F1) h2
  rw [h1'] at h2'
  exact Option.some.inj h2'

def noLamL : LExpr → Bool
  | .app f a => noLamL f && noLamL a
  | .letE v b => noLamL v && noLamL b
  | .lam _ => false
  | .glob _ => false
  | _ => true

def noCloExprD : DExpr → Bool
  | .apply f a => noCloExprD f && noCloExprD a
  | .letE v b => noCloExprD v && noCloExprD b
  | .clo _ _ => false
  | .glob _ => false
  | _ => true

theorem convWith_code_eq_of_noLamL (cr : List Nat → Nat → Nat) :
    ∀ (l : LExpr) (ρ : Nat → Nat) (code : List Code),
      noLamL l = true → (convWith cr ρ code l).2 = code
  | .bvar _, _, _, _ => rfl
  | .box, _, _, _ => rfl
  | .lit _, _, _, _ => rfl
  | .ctor _, _, _, _ => rfl
  | .rigid _, _, _, _ => rfl
  | .lam _, _, _, h => Bool.noConfusion h
  | .glob _, _, _, h => Bool.noConfusion h
  | .app f a, ρ, code, h => by
      simp only [noLamL, Bool.and_eq_true] at h
      simp only [convWith, convWith_code_eq_of_noLamL cr f ρ code h.1,
        convWith_code_eq_of_noLamL cr a ρ code h.2]
  | .letE v b, ρ, code, h => by
      simp only [noLamL, Bool.and_eq_true] at h
      simp only [convWith, convWith_code_eq_of_noLamL cr v ρ code h.1,
        convWith_code_eq_of_noLamL cr b (liftRen ρ) code h.2]

theorem defunc_code_nil_of_noLamL (l : LExpr) (h : noLamL l = true) :
    (defunc l).2 = [] :=
  convWith_code_eq_of_noLamL capRen l id [] h

theorem noCloExprD_convWith_of_noLamL (cr : List Nat → Nat → Nat) :
    ∀ (l : LExpr) (ρ : Nat → Nat) (code : List Code),
      noLamL l = true → noCloExprD (convWith cr ρ code l).1 = true
  | .bvar _, _, _, _ => rfl
  | .box, _, _, _ => rfl
  | .lit _, _, _, _ => rfl
  | .ctor _, _, _, _ => rfl
  | .rigid _, _, _, _ => rfl
  | .lam _, _, _, h => Bool.noConfusion h
  | .glob _, _, _, h => Bool.noConfusion h
  | .app f a, ρ, code, h => by
      simp only [noLamL, Bool.and_eq_true] at h
      simp only [convWith, noCloExprD, Bool.and_eq_true]
      exact ⟨noCloExprD_convWith_of_noLamL cr f ρ code h.1,
        noCloExprD_convWith_of_noLamL cr a ρ (convWith cr ρ code f).2 h.2⟩
  | .letE v b, ρ, code, h => by
      simp only [noLamL, Bool.and_eq_true] at h
      simp only [convWith, noCloExprD, Bool.and_eq_true]
      exact ⟨noCloExprD_convWith_of_noLamL cr v ρ code h.1,
        noCloExprD_convWith_of_noLamL cr b (liftRen ρ) (convWith cr ρ code v).2 h.2⟩

theorem noCloD_of_get? :
    ∀ (env : List DVal) (i : Nat) (dv : DVal),
      noCloAll env = true → env.get? i = some dv → noCloD dv = true
  | [], _, _, _, h => Option.noConfusion h
  | v :: _, 0, dv, hall, h => by
      simp only [noCloAll, Bool.and_eq_true] at hall
      simp only [List.get?_cons_zero] at h
      have hdv : dv = v := (Option.some.inj h).symm
      rw [hdv]
      exact hall.1
  | _ :: vs, i + 1, dv, hall, h => by
      simp only [noCloAll, Bool.and_eq_true] at hall
      simp only [List.get?_cons_succ] at h
      exact noCloD_of_get? vs i dv hall.2 h

theorem noCloD_of_run_noCloExprD (code : List Code) :
    ∀ (F : Nat) (env : List DVal) (e : DExpr) (dv : DVal),
      noCloExprD e = true →
      noCloAll env = true →
      run code F env e = some dv →
      noCloD dv = true := by
  intro F
  induction F with
  | zero =>
      intro _ _ _ _ _ h
      unfold run runWith at h
      exact Option.noConfusion h
  | succ F ih =>
      intro env e dv he henv h
      cases e with
      | var i =>
          rw [run_var_eq] at h
          exact noCloD_of_get? env i dv henv h
      | box =>
          rw [run_box_eq] at h
          have hdv : dv = .box := (Option.some.inj h).symm
          subst hdv
          rfl
      | lit k =>
          rw [run_lit_eq] at h
          have hdv : dv = .lit k := (Option.some.inj h).symm
          subst hdv
          rfl
      | ctor r =>
          rw [run_ctor_eq] at h
          have hdv : dv = .ctor r [] := (Option.some.inj h).symm
          subst hdv
          rfl
      | rigid r =>
          rw [run_rigid_eq] at h
          have hdv : dv = .rigid r [] := (Option.some.inj h).symm
          subst hdv
          rfl
      | clo _ _ =>
          simp only [noCloExprD] at he
          exact Bool.noConfusion he
      | glob _ =>
          simp only [noCloExprD] at he
          exact Bool.noConfusion he
      | apply g a =>
          simp only [noCloExprD, Bool.and_eq_true] at he
          rw [run_apply_eq] at h
          cases hg : run code F env g with
          | none =>
              rw [hg] at h
              exact Option.noConfusion h
          | some vg =>
              rw [hg] at h
              have hvg := ih env g vg he.1 henv hg
              cases ha : run code F env a with
              | none =>
                  rw [ha] at h
                  cases vg <;> exact Option.noConfusion h
              | some va =>
                  rw [ha] at h
                  have hva := ih env a va he.2 henv ha
                  cases vg with
                  | box =>
                      have hdv : dv = .box := (Option.some.inj h).symm
                      subst hdv
                      rfl
                  | lit _ => exact Option.noConfusion h
                  | ctor r args =>
                      have hdv : dv = .ctor r (args ++ [va]) := (Option.some.inj h).symm
                      subst hdv
                      simp only [noCloD] at hvg ⊢
                      rw [noCloAll_append]
                      simp only [noCloAll, Bool.and_true, Bool.and_eq_true]
                      exact ⟨hvg, hva⟩
                  | rigid r args =>
                      have hdv : dv = .rigid r (args ++ [va]) := (Option.some.inj h).symm
                      subst hdv
                      simp only [noCloD] at hvg ⊢
                      rw [noCloAll_append]
                      simp only [noCloAll, Bool.and_true, Bool.and_eq_true]
                      exact ⟨hvg, hva⟩
                  | clo _ _ =>
                      simp only [noCloD] at hvg
                      exact Bool.noConfusion hvg
      | letE v b =>
          simp only [noCloExprD, Bool.and_eq_true] at he
          rw [run_let_eq] at h
          cases hv : run code F env v with
          | none =>
              rw [hv] at h
              exact Option.noConfusion h
          | some vv =>
              rw [hv] at h
              have hvv := ih env v vv he.1 henv hv
              have henv' : noCloAll (vv :: env) = true := by
                simp only [noCloAll, Bool.and_eq_true]
                exact ⟨hvv, henv⟩
              exact ih (vv :: env) b dv he.2 henv' h

theorem noCloD_of_run_noLamL (l : LExpr) (F : Nat) (env : List DVal) (dv : DVal)
    (hl : noLamL l = true)
    (henv : noCloAll env = true)
    (hr : run (defunc l).2 F env (defunc l).1 = some dv) :
    noCloD dv = true :=
  noCloD_of_run_noCloExprD (defunc l).2 F env (defunc l).1 dv
    (noCloExprD_convWith_of_noLamL capRen l id [] hl) henv hr

theorem irrelevant_instantiate0_eq_of_closed_ty {E : ResolvedEnv} {n : Nat}
    (hE : EnvClosed E) {A a e Te : Expr Nat}
    (ha : inferT E n [] a = some A)
    (he : inferT E n (.assumption A :: []) e = some Te)
    (hclTe : closedAt 0 Te = true) :
    irrelevant E n (.assumption A :: []) e =
      irrelevant E n [] (instantiate0 a e) := by
  have hinst := inferT_instantiate hE a A ha [] e Te he
  simp only [List.nil_append, List.length_nil, substPrefix] at hinst
  rw [lift_zero_amount a 0] at hinst
  have hinst0 : inferT E n [] (instantiate0 a e) = some Te := by
    have h1 : inferT E n [] (instantiate0 a e) = some (instantiate0 a Te) := by
      simpa [instantiate0] using hinst
    unfold instantiate0 at h1
    rw [instantiate_id_closed0 Te 0 a hclTe] at h1
    exact h1
  unfold irrelevant
  rw [he, hinst0]
  dsimp only
  rw [inferT_closed0_ctx_indep Te (.assumption A :: []) [] hclTe]

theorem run_app_ctor2_left_env (la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl2 : closedAtL 0 la2 = true)
    (hga2 : noGlobL la2 = true)
    (hca1 : noCloD dv1 = true)
    (hca2 : noCloD dv2 = true)
    (hr2 : run (defunc la2).2 (F + 1) [] (defunc la2).1 = some dv2) :
    run (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).1 =
      some (.ctor c [dv1, dv2]) := by
  have hr_left : run (defunc (.app (.ctor c) (.bvar 0))).2 (F + 2) [dv1]
      (defunc (.app (.ctor c) (.bvar 0))).1 = some (.ctor c [dv1]) := by
    change run [] (F + 2) [dv1] (.apply (.ctor c) (.var 0)) = some (.ctor c [dv1])
    exact run_apply_ctor_var [] F c dv1
  have hr2_2 : run (defunc la2).2 (F + 2) [] (defunc la2).1 = some dv2 :=
    run_mono (defunc la2).2 (F + 1) (F + 2) [] (defunc la2).1 dv2 (Nat.le_succ (F + 1)) hr2
  have hclD2 : closedAtD 0 (defunc la2).1 = true :=
    closedAtD_convWith_closed0 capRen id [] la2 hcl2
  have hr2_env : run (defunc la2).2 (F + 2) [dv1] (defunc la2).1 = some dv2 := by
    rw [run_closed0_env_indep (defunc la2).2 (defunc la2).1 (F + 2) [dv1] [] hclD2]
    exact hr2_2
  have henv : ∀ k, [dv1].map (shiftDVal k) = [dv1] := by
    intro k
    rw [List.map_cons, List.map_nil, shiftDVal_id_of_noClo k dv1 hca1]
  exact run_app_ctor_spine_step_env (.app (.ctor c) (.bvar 0)) la2 (F + 1) c
    [dv1] [dv1] dv2 henv hga2 hca2 hr_left hr2_env

theorem run_app_ctor2_right_env (la1 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl1 : closedAtL 0 la1 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1) :
    run (defunc (.app (.app (.ctor c) la1) (.bvar 0))).2 (F + 3) [dv2]
      (defunc (.app (.app (.ctor c) la1) (.bvar 0))).1 =
      some (.ctor c [dv1, dv2]) := by
  have hr1_ctor : run (defunc (.app (.ctor c) la1)).2 (F + 2) []
      (defunc (.app (.ctor c) la1)).1 = some (.ctor c [dv1]) := by
    rw [defunc_app_ctor c la1]
    exact run_apply_ctor_val (defunc la1).2 F c (defunc la1).1 dv1 hr1
  have hcl_app1 : closedAtL 0 (.app (.ctor c) la1) = true := by
    simp only [closedAtL, hcl1, Bool.and_self]
  have hclD1 : closedAtD 0 (defunc (.app (.ctor c) la1)).1 = true :=
    closedAtD_convWith_closed0 capRen id [] (.app (.ctor c) la1) hcl_app1
  have hr1_env : run (defunc (.app (.ctor c) la1)).2 (F + 2) [dv2]
      (defunc (.app (.ctor c) la1)).1 = some (.ctor c [dv1]) := by
    rw [run_closed0_env_indep (defunc (.app (.ctor c) la1)).2
      (defunc (.app (.ctor c) la1)).1 (F + 2) [dv2] [] hclD1]
    exact hr1_ctor
  have hr_bvar0 : run (defunc (.bvar 0)).2 (F + 2) [dv2] (defunc (.bvar 0)).1 =
      some dv2 := by
    change run [] (F + 2) [dv2] (.var 0) = some dv2
    rw [run_var_eq]
    rfl
  have henv : ∀ k, [dv2].map (shiftDVal k) = [dv2] := by
    intro k
    rw [List.map_cons, List.map_nil, shiftDVal_id_of_noClo k dv2 hca2]
  exact run_app_ctor_spine_step_env (.app (.ctor c) la1) (.bvar 0) (F + 1) c
    [dv2] [dv1] dv2 henv rfl hca2 hr1_env hr_bvar0

theorem run_app_ctor2_diag_env (F c : Nat) (dv1 : DVal)
    (hca1 : noCloD dv1 = true) :
    run (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).1 =
      some (.ctor c [dv1, dv1]) := by
  have hr_left : run (defunc (.app (.ctor c) (.bvar 0))).2 (F + 2) [dv1]
      (defunc (.app (.ctor c) (.bvar 0))).1 = some (.ctor c [dv1]) := by
    change run [] (F + 2) [dv1] (.apply (.ctor c) (.var 0)) = some (.ctor c [dv1])
    exact run_apply_ctor_var [] F c dv1
  have hr_right : run (defunc (.bvar 0)).2 (F + 2) [dv1] (defunc (.bvar 0)).1 =
      some dv1 := by
    change run [] (F + 2) [dv1] (.var 0) = some dv1
    rw [run_var_eq]
    rfl
  have henv : ∀ k, [dv1].map (shiftDVal k) = [dv1] := by
    intro k
    rw [List.map_cons, List.map_nil, shiftDVal_id_of_noClo k dv1 hca1]
  exact run_app_ctor_spine_step_env (.app (.ctor c) (.bvar 0)) (.bvar 0) (F + 1) c
    [dv1] [dv1] dv1 henv rfl hca1 hr_left hr_right

theorem run_let_ctor2_left_val (la1 la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl2 : closedAtL 0 la2 = true)
    (hga2 : noGlobL la2 = true)
    (hca1 : noCloD dv1 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 1) [] (defunc la2).1 = some dv2) :
    run (defunc (.letE la1 (.app (.app (.ctor c) (.bvar 0)) la2))).2 (F + 4) []
      (defunc (.letE la1 (.app (.app (.ctor c) (.bvar 0)) la2))).1 =
      some (.ctor c [dv1, dv2]) := by
  have hcl_b : closedAtL 1 (.app (.app (.ctor c) (.bvar 0)) la2) = true := by
    change ((true && true) && closedAtL 1 la2) = true
    exact closedAtL_mono la2 0 1 (Nat.zero_le 1) hcl2
  have hgb : noGlobL (.app (.app (.ctor c) (.bvar 0)) la2) = true := by
    simp only [noGlobL, Bool.true_and, hga2]
  have hcb : noCloD (.ctor c [dv1, dv2]) = true := by
    simp only [noCloD, noCloAll, hca1, hca2, Bool.and_self]
  have hr1_3 : run (defunc la1).2 (F + 3) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (F + 1) (F + 3) [] (defunc la1).1 dv1
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr1
  have hrb : run (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).1 = some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_left_env la2 F c dv1 dv2 hcl2 hga2 hca1 hca2 hr2
  exact run_let_closed1 la1 (.app (.app (.ctor c) (.bvar 0)) la2) (F + 2)
    dv1 (.ctor c [dv1, dv2]) hcl_b hgb hca1 hcb hr1_3 hrb

theorem run_beta_ctor2_left_val (la1 la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl2 : closedAtL 0 la2 = true)
    (hga1 : noGlobL la1 = true)
    (hga2 : noGlobL la2 = true)
    (hca1 : noCloD dv1 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 1) [] (defunc la2).1 = some dv2) :
    run (defunc (.app (.lam (.app (.app (.ctor c) (.bvar 0)) la2)) la1)).2 (F + 4) []
      (defunc (.app (.lam (.app (.app (.ctor c) (.bvar 0)) la2)) la1)).1 =
      some (.ctor c [dv1, dv2]) := by
  have hcl_b : closedAtL 1 (.app (.app (.ctor c) (.bvar 0)) la2) = true := by
    change ((true && true) && closedAtL 1 la2) = true
    exact closedAtL_mono la2 0 1 (Nat.zero_le 1) hcl2
  have hr1_3 : run (defunc la1).2 (F + 3) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (F + 1) (F + 3) [] (defunc la1).1 dv1
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr1
  have hrb : run (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).1 = some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_left_env la2 F c dv1 dv2 hcl2 hga2 hca1 hca2 hr2
  exact run_beta_closed1 (.app (.app (.ctor c) (.bvar 0)) la2) la1 (F + 2)
    dv1 (.ctor c [dv1, dv2]) hcl_b hga1 hca1 hr1_3 hrb

theorem run_let_ctor2_right_val (la1 la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl1 : closedAtL 0 la1 = true)
    (hga1 : noGlobL la1 = true)
    (hca1 : noCloD dv1 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 1) [] (defunc la2).1 = some dv2) :
    run (defunc (.letE la2 (.app (.app (.ctor c) la1) (.bvar 0)))).2 (F + 4) []
      (defunc (.letE la2 (.app (.app (.ctor c) la1) (.bvar 0)))).1 =
      some (.ctor c [dv1, dv2]) := by
  have hcl_b : closedAtL 1 (.app (.app (.ctor c) la1) (.bvar 0)) = true := by
    change ((true && closedAtL 1 la1) && true) = true
    rw [Bool.true_and, Bool.and_true]
    exact closedAtL_mono la1 0 1 (Nat.zero_le 1) hcl1
  have hgb : noGlobL (.app (.app (.ctor c) la1) (.bvar 0)) = true := by
    simp only [noGlobL, Bool.and_true, Bool.true_and, hga1]
  have hcb : noCloD (.ctor c [dv1, dv2]) = true := by
    simp only [noCloD, noCloAll, hca1, hca2, Bool.and_self]
  have hr2_3 : run (defunc la2).2 (F + 3) [] (defunc la2).1 = some dv2 :=
    run_mono (defunc la2).2 (F + 1) (F + 3) [] (defunc la2).1 dv2
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr2
  have hrb : run (defunc (.app (.app (.ctor c) la1) (.bvar 0))).2 (F + 3) [dv2]
      (defunc (.app (.app (.ctor c) la1) (.bvar 0))).1 = some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_right_env la1 F c dv1 dv2 hcl1 hca2 hr1
  exact run_let_closed1 la2 (.app (.app (.ctor c) la1) (.bvar 0)) (F + 2)
    dv2 (.ctor c [dv1, dv2]) hcl_b hgb hca2 hcb hr2_3 hrb

theorem run_beta_ctor2_right_val (la1 la2 : LExpr) (F c : Nat) (dv1 dv2 : DVal)
    (hcl1 : closedAtL 0 la1 = true)
    (hga2 : noGlobL la2 = true)
    (hca2 : noCloD dv2 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1)
    (hr2 : run (defunc la2).2 (F + 1) [] (defunc la2).1 = some dv2) :
    run (defunc (.app (.lam (.app (.app (.ctor c) la1) (.bvar 0))) la2)).2 (F + 4) []
      (defunc (.app (.lam (.app (.app (.ctor c) la1) (.bvar 0))) la2)).1 =
      some (.ctor c [dv1, dv2]) := by
  have hcl_b : closedAtL 1 (.app (.app (.ctor c) la1) (.bvar 0)) = true := by
    change ((true && closedAtL 1 la1) && true) = true
    rw [Bool.true_and, Bool.and_true]
    exact closedAtL_mono la1 0 1 (Nat.zero_le 1) hcl1
  have hr2_3 : run (defunc la2).2 (F + 3) [] (defunc la2).1 = some dv2 :=
    run_mono (defunc la2).2 (F + 1) (F + 3) [] (defunc la2).1 dv2
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr2
  have hrb : run (defunc (.app (.app (.ctor c) la1) (.bvar 0))).2 (F + 3) [dv2]
      (defunc (.app (.app (.ctor c) la1) (.bvar 0))).1 = some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_right_env la1 F c dv1 dv2 hcl1 hca2 hr1
  exact run_beta_closed1 (.app (.app (.ctor c) la1) (.bvar 0)) la2 (F + 2)
    dv2 (.ctor c [dv1, dv2]) hcl_b hga2 hca2 hr2_3 hrb

theorem run_let_ctor2_diag_val (la1 : LExpr) (F c : Nat) (dv1 : DVal)
    (hca1 : noCloD dv1 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1) :
    run (defunc (.letE la1 (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)))).2 (F + 4) []
      (defunc (.letE la1 (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)))).1 =
      some (.ctor c [dv1, dv1]) := by
  have hcb : noCloD (.ctor c [dv1, dv1]) = true := by
    simp only [noCloD, noCloAll, hca1, Bool.and_self]
  have hr1_3 : run (defunc la1).2 (F + 3) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (F + 1) (F + 3) [] (defunc la1).1 dv1
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr1
  have hrb : run (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).1 = some (.ctor c [dv1, dv1]) :=
    run_app_ctor2_diag_env F c dv1 hca1
  exact run_let_closed1 la1 (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)) (F + 2)
    dv1 (.ctor c [dv1, dv1]) rfl rfl hca1 hcb hr1_3 hrb

theorem run_beta_ctor2_diag_val (la1 : LExpr) (F c : Nat) (dv1 : DVal)
    (hga1 : noGlobL la1 = true)
    (hca1 : noCloD dv1 = true)
    (hr1 : run (defunc la1).2 (F + 1) [] (defunc la1).1 = some dv1) :
    run (defunc (.app (.lam (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))) la1)).2 (F + 4) []
      (defunc (.app (.lam (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))) la1)).1 =
      some (.ctor c [dv1, dv1]) := by
  have hr1_3 : run (defunc la1).2 (F + 3) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (F + 1) (F + 3) [] (defunc la1).1 dv1
      (Nat.le_trans (Nat.le_succ (F + 1)) (Nat.le_succ (F + 2))) hr1
  have hrb : run (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).2 (F + 3) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).1 = some (.ctor c [dv1, dv1]) :=
    run_app_ctor2_diag_env F c dv1 hca1
  exact run_beta_closed1 (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)) la1 (F + 2)
    dv1 (.ctor c [dv1, dv1]) rfl hga1 hca1 hr1_3 hrb

/-! ### Unary/binary constructor erasure and execution inversion (`erase_app_ctor1_inv`,
    `erase_app_ctor2_inv`, `run_app_ctor1_inv`, `run_app_ctor2_inv`), constructor spine
    `scmValOf`/`relevantSpine` decomposition (`isCtor_of_scmValOf_foldApps`,
    `relevantSpine_foldApps_const`, `ctor2_norm_scm_props`), and binary constructor
    `let`/`β` compositional adequacy (`good_let_ctor2_left_of_good`,
    `good_beta_ctor2_left_of_good`, `good_let_ctor2_right_of_good`,
    `good_beta_ctor2_right_of_good`, `good_let_ctor2_diag_of_good`,
    `good_beta_ctor2_diag_of_good`, `good_let_ctor2_left_of_good_args`,
    `good_beta_ctor2_left_of_good_args`, `good_let_ctor2_right_of_good_args`,
    `good_beta_ctor2_right_of_good_args`, `good_let_ctor2_diag_of_good_arg`,
    `good_beta_ctor2_diag_of_good_arg`) -/

theorem instantiate0_app_ctor2_left (c : Nat) (lsc : List Level) (a1 a2 : Expr Nat)
    (hcl2 : closedAt 0 a2 = true) :
    instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) a2) =
      .app (.app (.const c lsc) a1) a2 := by
  simp only [instantiate0, instantiate, if_true,
    instantiate_id_closed0 a2 0 a1 hcl2]

theorem instantiate0_app_ctor2_right (c : Nat) (lsc : List Level) (a1 a2 : Expr Nat)
    (hcl1 : closedAt 0 a1 = true) :
    instantiate0 a2 (.app (.app (.const c lsc) a1) (.bvar 0)) =
      .app (.app (.const c lsc) a1) a2 := by
  simp only [instantiate0, instantiate, if_true,
    instantiate_id_closed0 a1 0 a2 hcl1]

theorem instantiate0_app_ctor2_diag (c : Nat) (lsc : List Level) (a1 : Expr Nat) :
    instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) =
      .app (.app (.const c lsc) a1) a1 := rfl

theorem closedAt_app_ctor2_left (c : Nat) (lsc : List Level) (a2 : Expr Nat)
    (hcl2 : closedAt 0 a2 = true) :
    closedAt 1 (.app (.app (.const c lsc) (.bvar 0)) a2) = true := by
  change ((true && true) && closedAt 1 a2) = true
  exact closedAt_mono a2 0 1 (Nat.zero_le 1) hcl2

theorem closedAt_app_ctor2_right (c : Nat) (lsc : List Level) (a1 : Expr Nat)
    (hcl1 : closedAt 0 a1 = true) :
    closedAt 1 (.app (.app (.const c lsc) a1) (.bvar 0)) = true := by
  change ((true && closedAt 1 a1) && true) = true
  rw [Bool.true_and, Bool.and_true]
  exact closedAt_mono a1 0 1 (Nat.zero_le 1) hcl1

theorem erase_let_keep_inv {E : ResolvedEnv} {n F : Nat} {Γ : LCtx}
    {A v b : Expr Nat} {l : LExpr}
    (hirr : irrelevant E n Γ (.letE A v b) = false)
    (he : erase E n F Γ (.letE A v b) = some l) :
    ∃ F' lv lb, F = F' + 1 ∧
      erase E n F' Γ v = some lv ∧
      erase E n F' (.assumption A :: Γ) b = some lb ∧
      l = .letE lv lb := by
  cases F with
  | zero =>
      simp only [erase, eraseWith] at he
      exact Option.noConfusion he
  | succ F' =>
      rw [erase_let_keep E n F' Γ A v b hirr] at he
      cases hv : erase E n F' Γ v with
      | none =>
          rw [hv] at he
          exact Option.noConfusion he
      | some lv =>
          cases hb : erase E n F' (.letBinding A v :: Γ) b with
          | none =>
              rw [hv, hb] at he
              exact Option.noConfusion he
          | some lb =>
              rw [hv, hb] at he
              rw [erase_letBinding_eq_assumption] at hb
              exact ⟨F', lv, lb, rfl, hv, hb, (Option.some.inj he).symm⟩

theorem erase_app_ctor1_inv {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {Γ : LCtx} {a1 : Expr Nat} {l : LExpr}
    (hirr : irrelevant E n Γ (.app (.const c lsc) a1) = false)
    (hirrC : irrelevant E n Γ (.const c lsc) = false)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (he : erase E n F Γ (.app (.const c lsc) a1) = some l) :
    ∃ F0 la1, F = F0 + 2 ∧
      erase E n (F0 + 1) Γ a1 = some la1 ∧
      l = .app (.ctor c) la1 := by
  obtain ⟨F1, lc, la1, hF1, hc, ha1, hl⟩ := erase_app_keep_inv hirr he
  obtain ⟨F0, hF0, hlc⟩ := erase_const_ctor_inv hirrC hnone hctor hc
  subst hF0
  subst hlc
  exact ⟨F0, la1, hF1, ha1, hl⟩

theorem erase_app_ctor2_inv {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {Γ : LCtx} {a1 a2 : Expr Nat} {l : LExpr}
    (hirr : irrelevant E n Γ (.app (.app (.const c lsc) a1) a2) = false)
    (hirr1 : irrelevant E n Γ (.app (.const c lsc) a1) = false)
    (hirrC : irrelevant E n Γ (.const c lsc) = false)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (he : erase E n F Γ (.app (.app (.const c lsc) a1) a2) = some l) :
    ∃ F0 la1 la2, F = F0 + 3 ∧
      erase E n (F0 + 1) Γ a1 = some la1 ∧
      erase E n (F0 + 2) Γ a2 = some la2 ∧
      l = .app (.app (.ctor c) la1) la2 := by
  obtain ⟨F2, lg, la2, hF2, hg, ha2, hl⟩ := erase_app_keep_inv hirr he
  obtain ⟨F0, la1, hF0, ha1, hlg⟩ :=
    erase_app_ctor1_inv hirr1 hirrC hnone hctor hg
  subst hF0
  subst hlg
  exact ⟨F0, la1, la2, hF2, ha1, ha2, hl⟩

theorem run_app_ctor1_inv (la1 : LExpr) (F c : Nat) (dv : DVal)
    (hga1 : noGlobL la1 = true)
    (hcdv : noCloD dv = true)
    (hr : run (defunc (.app (.ctor c) la1)).2 F []
      (defunc (.app (.ctor c) la1)).1 = some dv) :
    ∃ F0 dv1, F = F0 + 2 ∧
      noCloD dv1 = true ∧
      run (defunc la1).2 (F0 + 1) [] (defunc la1).1 = some dv1 ∧
      dv = .ctor c [dv1] := by
  have hcs : isCtorSpineL c (.ctor c) = true := by
    simp only [isCtorSpineL, decide_eq_true_eq]
  obtain ⟨F1, dvs, dv1, hF1, _, hca1, hrc, hra1, hdv⟩ :=
    run_app_ctor_spine_inv (.ctor c) la1 F c [] dv hcs rfl hga1 rfl hcdv hr
  cases F1 with
  | zero =>
      unfold run runWith at hrc
      exact Option.noConfusion hrc
  | succ F0 =>
      change run [] (F0 + 1) [] (.ctor c) = some (.ctor c dvs) at hrc
      rw [run_ctor_eq] at hrc
      have hdvs : dvs = [] := by
        injection (Option.some.inj hrc) with _ hd
        exact hd.symm
      subst hdvs
      simp only [List.nil_append] at hdv
      exact ⟨F0, dv1, hF1, hca1, hra1, hdv⟩

theorem run_app_ctor2_inv (la1 la2 : LExpr) (F c : Nat) (dv : DVal)
    (hga1 : noGlobL la1 = true)
    (hga2 : noGlobL la2 = true)
    (hcdv : noCloD dv = true)
    (hr : run (defunc (.app (.app (.ctor c) la1) la2)).2 F []
      (defunc (.app (.app (.ctor c) la1) la2)).1 = some dv) :
    ∃ F0 dv1 dv2, F = F0 + 3 ∧
      noCloD dv1 = true ∧
      noCloD dv2 = true ∧
      run (defunc la1).2 (F0 + 1) [] (defunc la1).1 = some dv1 ∧
      run (defunc la2).2 (F0 + 2) [] (defunc la2).1 = some dv2 ∧
      dv = .ctor c [dv1, dv2] := by
  have hcs : isCtorSpineL c (.app (.ctor c) la1) = true := by
    simp only [isCtorSpineL, decide_eq_true_eq]
  have hgg : noGlobL (.app (.ctor c) la1) = true := by
    simp only [noGlobL, Bool.true_and, hga1]
  obtain ⟨F1, dvs, dv2, hF1, hdvs_clo, hca2, hr1_spine, hra2, hdv⟩ :=
    run_app_ctor_spine_inv (.app (.ctor c) la1) la2 F c [] dv hcs hgg hga2 rfl hcdv hr
  have hc1 : noCloD (.ctor c dvs) = true := hdvs_clo
  obtain ⟨F0, dv1, hF0, hca1, hra1, hctor1⟩ :=
    run_app_ctor1_inv la1 F1 c (.ctor c dvs) hga1 hc1 hr1_spine
  subst hF0
  have hdvs : dvs = [dv1] := by
    injection hctor1 with _ hd
  subst hdvs
  simp only [List.cons_append, List.nil_append] at hdv
  exact ⟨F0, dv1, dv2, hF1, hca1, hca2, hra1, hra2, hdv⟩

theorem erasable_app_ctor2 {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {a1 a2 T : Expr Nat}
    (hnone : transparentBody E c lsc = none)
    (hi : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T)
    (hirr : irrelevant E n [] (.app (.app (.const c lsc) a1) a2) = false)
    (her1 : Erasable E n a1)
    (her2 : Erasable E n a2) :
    Erasable E n (.app (.app (.const c lsc) a1) a2) := by
  have hirr1 : irrelevant E n [] (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  obtain ⟨_, _, hi_app1, _, _⟩ := inferT_app_some.mp hi
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi_app1 hirr1
  obtain ⟨F1, la1, ha1⟩ := her1
  obtain ⟨F2, la2, ha2⟩ := her2
  let lc : LExpr := if isCtor E c then .ctor c else .rigid c
  have hc : erase E n (F1 + F2 + 1) [] (.const c lsc) = some lc := by
    simp only [erase, eraseWith, hirrC, Bool.false_eq_true, if_false,
      noGlobals, hnone, lc]
  have ha1' : erase E n (F1 + F2 + 1) [] a1 = some la1 :=
    erase_mono E n F1 (F1 + F2 + 1) [] a1 la1
      (Nat.le_trans (Nat.le_add_right F1 F2) (Nat.le_succ (F1 + F2))) ha1
  have hg : erase E n (F1 + F2 + 2) [] (.app (.const c lsc) a1) =
      some (.app lc la1) := by
    rw [erase_app_keep E n (F1 + F2 + 1) [] (.const c lsc) a1 hirr1, hc, ha1']
  have ha2' : erase E n (F1 + F2 + 2) [] a2 = some la2 :=
    erase_mono E n F2 (F1 + F2 + 2) [] a2 la2
      (Nat.le_trans (Nat.le_add_left F2 F1) (Nat.le_add_right (F1 + F2) 2)) ha2
  refine ⟨F1 + F2 + 3, .app (.app lc la1) la2, ?_⟩
  rw [erase_app_keep E n (F1 + F2 + 2) [] (.app (.const c lsc) a1) a2 hirr, hg, ha2']

theorem foldApps_ne_lit :
    ∀ (args : List (Expr Nat)) (f : Expr Nat),
      (∀ k, f ≠ .lit k) → ∀ k, foldApps f args ≠ .lit k
  | [], f, hf, k => hf k
  | a :: as, f, _, k =>
      foldApps_ne_lit as (.app f a) (fun _ h => Expr.noConfusion h) k

theorem isCtor_of_scmValOf_foldApps {E : ResolvedEnv} {fv c : Nat}
    {lsc : List Level} {args : List (Expr Nat)} {w : Val}
    (hs : scmValOf E fv (foldApps (.const c lsc) args) = some w) :
    isCtor E c = true := by
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      have hne : ∀ k, foldApps (.const c lsc) args ≠ .lit k :=
        foldApps_ne_lit args (.const c lsc) (fun _ h => Expr.noConfusion h)
      have hsp : appsSpine (foldApps (.const c lsc) args) = (.const c lsc, args) := by
        rw [appsSpine_foldApps]
        simp only [appsSpine, List.nil_append]
      have hs' : (match appsSpine (foldApps (.const c lsc) args) with
          | (.const r _, as) =>
              match E.members r with
              | some mm =>
                  if mm.mclass = .constructorM then
                    match as.mapM (scmValOf E m) with
                    | some vs => some (.inj r (.list vs))
                    | none => none
                  else none
              | none => none
          | _ => none) = some w := by
        cases h : foldApps (.const c lsc) args with
        | lit k => exact absurd h (hne k)
        | bvar _ | sort _ | const _ _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ =>
            simpa [scmValOf, h] using hs
      rw [hsp] at hs'
      dsimp only at hs'
      cases hm : E.members c with
      | none =>
          rw [hm] at hs'
          exact Option.noConfusion hs'
      | some mm =>
          rw [hm] at hs'
          dsimp only at hs'
          by_cases hcm : mm.mclass = .constructorM
          · simp [isCtor, hm, hcm]
          · rw [if_neg hcm] at hs'
            exact Option.noConfusion hs'

theorem relevantSpine_foldApps_const {E : ResolvedEnv} {n fv c : Nat}
    {lsc : List Level} {args : List (Expr Nat)}
    (hrel : relevantSpine E n fv (foldApps (.const c lsc) args) = true) :
    ∃ m, fv = m + 1 ∧
      args.all (fun a => !irrelevant E n [] a && relevantSpine E n m a) = true := by
  cases fv with
  | zero =>
      simp only [relevantSpine] at hrel
      exact Bool.noConfusion hrel
  | succ m =>
      have hne : ∀ k, foldApps (.const c lsc) args ≠ .lit k :=
        foldApps_ne_lit args (.const c lsc) (fun _ h => Expr.noConfusion h)
      have hsp : appsSpine (foldApps (.const c lsc) args) = (.const c lsc, args) := by
        rw [appsSpine_foldApps]
        simp only [appsSpine, List.nil_append]
      have hrel' : (match appsSpine (foldApps (.const c lsc) args) with
          | (.const _ _, as) =>
              as.all (fun a => !irrelevant E n [] a && relevantSpine E n m a)
          | _ => false) = true := by
        cases h : foldApps (.const c lsc) args with
        | lit k => exact absurd h (hne k)
        | bvar _ | sort _ | const _ _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ =>
            simpa [relevantSpine, h] using hrel
      rw [hsp] at hrel'
      exact ⟨m, rfl, hrel'⟩

theorem irrelevant_false_of_not_eq_true {b : Bool} (h : (!b) = true) : b = false := by
  cases b with
  | false => rfl
  | true => exact Bool.noConfusion h

theorem inferT_app2_first_arg {E : ResolvedEnv} {n : Nat} {Γ : LCtx}
    {f a1 a2 v1 v2 T1 T2 : Expr Nat}
    (h1 : inferT E n Γ (.app (.app f a1) a2) = some T1)
    (h2 : inferT E n Γ (.app (.app f v1) v2) = some T2) :
    ∃ A1, inferT E n Γ a1 = some A1 ∧ inferT E n Γ v1 = some A1 := by
  obtain ⟨_, _, hfa1, _, _⟩ := inferT_app_some.mp h1
  obtain ⟨_, _, hfv1, _, _⟩ := inferT_app_some.mp h2
  obtain ⟨A1, B1, hf, ha1, _⟩ := inferT_app_some.mp hfa1
  obtain ⟨A1', B1', hf', hv1, _⟩ := inferT_app_some.mp hfv1
  rw [hf] at hf'
  injection (Option.some.inj hf') with hA1 _
  rw [← hA1] at hv1
  exact ⟨A1, ha1, hv1⟩

theorem ctor2_norm_scm_props {E : ResolvedEnv} {n lf fv c : Nat}
    {lsc : List Level} {a1 a2 v T : Expr Nat} {w : Val}
    (hnone : transparentBody E c lsc = none)
    (hi : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T)
    (hn : norm E lf (.app (.app (.const c lsc) a1) a2) = some v)
    (hs : scmValOf E fv v = some w)
    (hrel : relevantSpine E n fv v = true)
    (hvinf : inferT E n [] v = some T) :
    isCtor E c = true ∧
      irrelevant E n [] a1 = false ∧
      ((∀ A1 B1, inferT E n [] (.const c lsc) = some (.pi A1 B1) → closedAt 0 B1 = true) →
        irrelevant E n [] a2 = false) := by
  obtain ⟨_, v1, v2, _, _, _, hv⟩ :=
    norm_app_ctor2_args_of_norm E lf c lsc a1 a2 v hnone hn
  have hv_fold : v = foldApps (.const c lsc) [v1, v2] := hv
  have hs_fold : scmValOf E fv (foldApps (.const c lsc) [v1, v2]) = some w :=
    hv_fold ▸ hs
  have hctor : isCtor E c = true := isCtor_of_scmValOf_foldApps hs_fold
  have hrel_fold : relevantSpine E n fv (foldApps (.const c lsc) [v1, v2]) = true :=
    hv_fold ▸ hrel
  obtain ⟨m, _, hall⟩ := relevantSpine_foldApps_const hrel_fold
  simp only [List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hall
  have hirr_v1 : irrelevant E n [] v1 = false :=
    irrelevant_false_of_not_eq_true hall.1.1
  have hirr_v2 : irrelevant E n [] v2 = false :=
    irrelevant_false_of_not_eq_true hall.2.1
  have hvinf' : inferT E n [] (.app (.app (.const c lsc) v1) v2) = some T :=
    hv ▸ hvinf
  obtain ⟨A1, ha1_ty, hv1_ty⟩ := inferT_app2_first_arg hi hvinf'
  have hirr_a1 : irrelevant E n [] a1 = false :=
    irrelevant_false_of_same_type ha1_ty hv1_ty hirr_v1
  refine ⟨hctor, hirr_a1, fun hNonDep => ?_⟩
  obtain ⟨_, A2, _, _, ha2_ty, hv2_ty⟩ := inferT_app_ctor2_args hi hvinf' hNonDep
  exact irrelevant_false_of_same_type ha2_ty hv2_ty hirr_v2

theorem erase_app_ctor2_left_body {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat} {la2 : LExpr}
    (hE : EnvClosed E)
    (hcl2 : closedAt 0 a2 = true)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hiLet : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = some T)
    (hirrLet : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = false)
    (hirr_a1 : irrelevant E n [] a1 = false)
    (ha2 : erase E n (F + 2) [] a2 = some la2) :
    erase E n (F + 3) (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) a2) =
      some (.app (.app (.ctor c) (.bvar 0)) la2) := by
  obtain ⟨u, B, hA, ha1_ty, hbody_let, _⟩ := inferT_letE_some.mp hiLet
  have hbody : inferT E n (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) a2) = some B := by
    rw [← inferT_ctx_eq (.app (.app (.const c lsc) (.bvar 0)) a2)
      (lookupType_let_eq_assumption A a1 [])]
    exact hbody_let
  have hirr_b : irrelevant E n (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) a2) = false := by
    rw [← irrelevant_ctx_eq (.app (.app (.const c lsc) (.bvar 0)) a2)
      (lookupType_let_eq_assumption A a1 [])]
    exact irrelevant_body_false_of_let hE hiLet hirrLet
  have hirr_g : irrelevant E n (.assumption A :: [])
      (.app (.const c lsc) (.bvar 0)) = false :=
    irrelevant_fun_false_of_app_irr hbody hirr_b
  obtain ⟨_, _, hg_ty, _, _⟩ := inferT_app_some.mp hbody
  have hirr_c : irrelevant E n (.assumption A :: []) (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hg_ty hirr_g
  have hirr_b0 : irrelevant E n (.assumption A :: []) (.bvar 0) = false := by
    rw [(irrelevant_bvar0_eq_arg hE hA ha1_ty).1]
    exact hirr_a1
  have hc : erase E n (F + 1) (.assumption A :: []) (.const c lsc) = some (.ctor c) := by
    simp only [erase, eraseWith, hirr_c, Bool.false_eq_true, if_false,
      noGlobals, hnone, hctor, if_true]
  have hb0 : erase E n (F + 1) (.assumption A :: []) (.bvar 0) = some (.bvar 0) := by
    simp only [erase, eraseWith, hirr_b0, Bool.false_eq_true, if_false]
  have hg : erase E n (F + 2) (.assumption A :: [])
      (.app (.const c lsc) (.bvar 0)) = some (.app (.ctor c) (.bvar 0)) := by
    rw [erase_app_keep E n (F + 1) (.assumption A :: []) (.const c lsc) (.bvar 0) hirr_g,
      hc, hb0]
  have ha2_ctx : erase E n (F + 2) (.assumption A :: []) a2 = some la2 := by
    rw [erase_closed0_ctx_indep hE (F + 2) a2 (.assumption A :: []) [] hcl2]
    exact ha2
  rw [erase_app_keep E n (F + 2) (.assumption A :: [])
    (.app (.const c lsc) (.bvar 0)) a2 hirr_b, hg, ha2_ctx]

theorem erase_app_ctor2_right_body {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat} {la1 : LExpr}
    (hE : EnvClosed E)
    (hcl1 : closedAt 0 a1 = true)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hiLet : inferT E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = some T)
    (hirrLet : irrelevant E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = false)
    (hirr_a2 : irrelevant E n [] a2 = false)
    (ha1 : erase E n (F + 1) [] a1 = some la1) :
    erase E n (F + 3) (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) =
      some (.app (.app (.ctor c) la1) (.bvar 0)) := by
  obtain ⟨u, B, hA, ha2_ty, hbody_let, _⟩ := inferT_letE_some.mp hiLet
  have hbody : inferT E n (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) = some B := by
    rw [← inferT_ctx_eq (.app (.app (.const c lsc) a1) (.bvar 0))
      (lookupType_let_eq_assumption A a2 [])]
    exact hbody_let
  have hirr_b : irrelevant E n (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) = false := by
    rw [← irrelevant_ctx_eq (.app (.app (.const c lsc) a1) (.bvar 0))
      (lookupType_let_eq_assumption A a2 [])]
    exact irrelevant_body_false_of_let hE hiLet hirrLet
  have hirr_g : irrelevant E n (.assumption A :: [])
      (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hbody hirr_b
  obtain ⟨_, _, hg_ty, _, _⟩ := inferT_app_some.mp hbody
  have hirr_c : irrelevant E n (.assumption A :: []) (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hg_ty hirr_g
  have hirr_b0 : irrelevant E n (.assumption A :: []) (.bvar 0) = false := by
    rw [(irrelevant_bvar0_eq_arg hE hA ha2_ty).1]
    exact hirr_a2
  have hc : erase E n (F + 1) (.assumption A :: []) (.const c lsc) = some (.ctor c) := by
    simp only [erase, eraseWith, hirr_c, Bool.false_eq_true, if_false,
      noGlobals, hnone, hctor, if_true]
  have ha1_ctx : erase E n (F + 1) (.assumption A :: []) a1 = some la1 := by
    rw [erase_closed0_ctx_indep hE (F + 1) a1 (.assumption A :: []) [] hcl1]
    exact ha1
  have hg : erase E n (F + 2) (.assumption A :: [])
      (.app (.const c lsc) a1) = some (.app (.ctor c) la1) := by
    rw [erase_app_keep E n (F + 1) (.assumption A :: []) (.const c lsc) a1 hirr_g,
      hc, ha1_ctx]
  have hb0 : erase E n (F + 2) (.assumption A :: []) (.bvar 0) = some (.bvar 0) := by
    simp only [erase, eraseWith, hirr_b0, Bool.false_eq_true, if_false]
  rw [erase_app_keep E n (F + 2) (.assumption A :: [])
    (.app (.const c lsc) a1) (.bvar 0) hirr_b, hg, hb0]

theorem erase_app_ctor2_diag_body {E : ResolvedEnv} {n F c : Nat} {lsc : List Level}
    {A a1 T : Expr Nat}
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hiLet : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = some T)
    (hirrLet : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = false)
    (hirr_a1 : irrelevant E n [] a1 = false) :
    erase E n (F + 3) (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) =
      some (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)) := by
  obtain ⟨u, B, hA, ha1_ty, hbody_let, _⟩ := inferT_letE_some.mp hiLet
  have hbody : inferT E n (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) = some B := by
    rw [← inferT_ctx_eq (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))
      (lookupType_let_eq_assumption A a1 [])]
    exact hbody_let
  have hirr_b : irrelevant E n (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) = false := by
    rw [← irrelevant_ctx_eq (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))
      (lookupType_let_eq_assumption A a1 [])]
    exact irrelevant_body_false_of_let hE hiLet hirrLet
  have hirr_g : irrelevant E n (.assumption A :: [])
      (.app (.const c lsc) (.bvar 0)) = false :=
    irrelevant_fun_false_of_app_irr hbody hirr_b
  obtain ⟨_, _, hg_ty, _, _⟩ := inferT_app_some.mp hbody
  have hirr_c : irrelevant E n (.assumption A :: []) (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hg_ty hirr_g
  have hirr_b0 : irrelevant E n (.assumption A :: []) (.bvar 0) = false := by
    rw [(irrelevant_bvar0_eq_arg hE hA ha1_ty).1]
    exact hirr_a1
  have hc : erase E n (F + 1) (.assumption A :: []) (.const c lsc) = some (.ctor c) := by
    simp only [erase, eraseWith, hirr_c, Bool.false_eq_true, if_false,
      noGlobals, hnone, hctor, if_true]
  have hb0_1 : erase E n (F + 1) (.assumption A :: []) (.bvar 0) = some (.bvar 0) := by
    simp only [erase, eraseWith, hirr_b0, Bool.false_eq_true, if_false]
  have hg : erase E n (F + 2) (.assumption A :: [])
      (.app (.const c lsc) (.bvar 0)) = some (.app (.ctor c) (.bvar 0)) := by
    rw [erase_app_keep E n (F + 1) (.assumption A :: []) (.const c lsc) (.bvar 0) hirr_g,
      hc, hb0_1]
  have hb0_2 : erase E n (F + 2) (.assumption A :: []) (.bvar 0) = some (.bvar 0) := by
    simp only [erase, eraseWith, hirr_b0, Bool.false_eq_true, if_false]
  rw [erase_app_keep E n (F + 2) (.assumption A :: [])
    (.app (.const c lsc) (.bvar 0)) (.bvar 0) hirr_b, hg, hb0_2]

theorem erasable_ctor2_left_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat}
    (hE : EnvClosed E)
    (hcl2 : closedAt 0 a2 = true)
    (hnone : transparentBody E c lsc = none)
    (hi1 : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = some T)
    (hirr1 : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = false)
    (her1 : Erasable E n (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2))) :
    Erasable E n (instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) := by
  have hinst := instantiate0_app_ctor2_left c lsc a1 a2 hcl2
  rw [hinst]
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T := by
    rw [← hinst]
    exact inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a2) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  have hirr_b : irrelevant E n (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) a2) = false := by
    rw [← irrelevant_ctx_eq (.app (.app (.const c lsc) (.bvar 0)) a2)
      (lookupType_let_eq_assumption A a1 [])]
    exact irrelevant_body_false_of_let hE hi1 hirr1
  obtain ⟨F, l, he⟩ := her1
  obtain ⟨F1, la1, lb, _, ha1, hb, _⟩ := erase_let_keep_inv hirr1 he
  obtain ⟨F2, _, la2, _, _, ha2, _⟩ := erase_app_keep_inv hirr_b hb
  rw [erase_closed0_ctx_indep hE F2 a2 (.assumption A :: []) [] hcl2] at ha2
  exact erasable_app_ctor2 hnone hi2 hirr2 ⟨F1, la1, ha1⟩ ⟨F2, la2, ha2⟩

theorem lift_ctor2_left_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat} {G : Nat} {l2 : LExpr} {dv_b : DVal}
    (hE : EnvClosed E)
    (hcl2 : closedAt 0 a2 = true)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hirr_a1 : irrelevant E n [] a1 = false)
    (hi1 : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = some T)
    (hirr1 : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = false)
    (he2 : erase E n (G + 1) []
      (instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) a2)) = some l2)
    (hr2 : run (defunc l2).2 (G + 1) [] (defunc l2).1 = some dv_b)
    (hcb : noCloD dv_b = true) :
    ∃ F la lb dv_a, G ≤ F ∧
      erase E n (F + 1) [] a1 = some la ∧
      erase E n (F + 1) (.assumption A :: [])
        (.app (.app (.const c lsc) (.bvar 0)) a2) = some lb ∧
      run (defunc la).2 (F + 1) [] (defunc la).1 = some dv_a ∧
      noCloD dv_a = true ∧
      run (defunc lb).2 (F + 1) [dv_a] (defunc lb).1 = some dv_b := by
  have hinst := instantiate0_app_ctor2_left c lsc a1 a2 hcl2
  rw [hinst] at he2
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T := by
    rw [← hinst]
    exact inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a2) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  have hirr_app1 : irrelevant E n [] (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hi2 hirr2
  obtain ⟨_, _, hi_app1, _, _⟩ := inferT_app_some.mp hi2
  have hirr_c : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi_app1 hirr_app1
  obtain ⟨Fe, la1, la2, hGFe, ha1, ha2, hl2⟩ :=
    erase_app_ctor2_inv hirr2 hirr_app1 hirr_c hnone hctor he2
  subst hl2
  have hga1 : noGlobL la1 = true := noGlobL_erase E n (Fe + 1) [] a1 la1 ha1
  have hga2 : noGlobL la2 = true := noGlobL_erase E n (Fe + 2) [] a2 la2 ha2
  obtain ⟨Fr, dv1, dv2, hGFr, hca1, hca2, hr1, hr2_val, hdv_b⟩ :=
    run_app_ctor2_inv la1 la2 (G + 1) c dv_b hga1 hga2 hcb hr2
  have hFeFr : Fe = Fr := Nat.succ.inj (Nat.succ.inj (Nat.succ.inj (hGFe.symm.trans hGFr)))
  subst hFeFr
  subst hdv_b
  have ha1_4 : erase E n (Fe + 4) [] a1 = some la1 :=
    erase_mono E n (Fe + 1) (Fe + 4) [] a1 la1
      (Nat.le_trans (Nat.le_succ (Fe + 1)) (Nat.le_add_right (Fe + 2) 2)) ha1
  have ha2_3 : erase E n (Fe + 3) [] a2 = some la2 :=
    erase_mono E n (Fe + 2) (Fe + 3) [] a2 la2 (Nat.le_succ (Fe + 2)) ha2
  have hb_4 : erase E n (Fe + 4) (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) a2) =
      some (.app (.app (.ctor c) (.bvar 0)) la2) :=
    erase_app_ctor2_left_body hE hcl2 hnone hctor hi1 hirr1 hirr_a1 ha2_3
  have hr1_4 : run (defunc la1).2 (Fe + 4) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (Fe + 1) (Fe + 4) [] (defunc la1).1 dv1
      (Nat.le_trans (Nat.le_succ (Fe + 1)) (Nat.le_add_right (Fe + 2) 2)) hr1
  have hclL2 : closedAtL 0 la2 = true :=
    closedAtL_erase hE (Fe + 2) 0 [] a2 la2 hcl2 ha2
  have hrb_4 : run (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).2 (Fe + 4) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) la2)).1 =
      some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_left_env la2 (Fe + 1) c dv1 dv2 hclL2 hga2 hca1 hca2 hr2_val
  have hG_eq : G = Fe + 2 := Nat.succ.inj hGFe
  have hle : G ≤ Fe + 3 := hG_eq ▸ Nat.le_succ (Fe + 2)
  exact ⟨Fe + 3, la1, .app (.app (.ctor c) (.bvar 0)) la2, dv1,
    hle, ha1_4, hb_4, hr1_4, hca1, hrb_4⟩

theorem erasable_ctor2_right_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat}
    (hE : EnvClosed E)
    (hcl1 : closedAt 0 a1 = true)
    (hnone : transparentBody E c lsc = none)
    (hi1 : inferT E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = some T)
    (hirr1 : irrelevant E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = false)
    (her1 : Erasable E n (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0)))) :
    Erasable E n (instantiate0 a2 (.app (.app (.const c lsc) a1) (.bvar 0))) := by
  have hinst := instantiate0_app_ctor2_right c lsc a1 a2 hcl1
  rw [hinst]
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T := by
    rw [← hinst]
    exact inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a2) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  obtain ⟨_, B, _, _, hbody_let, _⟩ := inferT_letE_some.mp hi1
  have hbody : inferT E n (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) = some B := by
    rw [← inferT_ctx_eq (.app (.app (.const c lsc) a1) (.bvar 0))
      (lookupType_let_eq_assumption A a2 [])]
    exact hbody_let
  have hirr_b : irrelevant E n (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) = false := by
    rw [← irrelevant_ctx_eq (.app (.app (.const c lsc) a1) (.bvar 0))
      (lookupType_let_eq_assumption A a2 [])]
    exact irrelevant_body_false_of_let hE hi1 hirr1
  have hirr_g : irrelevant E n (.assumption A :: [])
      (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hbody hirr_b
  obtain ⟨F, l, he⟩ := her1
  obtain ⟨F1, la2, lb, _, ha2, hb, _⟩ := erase_let_keep_inv hirr1 he
  obtain ⟨F2, lg, _, _, hg, _, _⟩ := erase_app_keep_inv hirr_b hb
  obtain ⟨F3, _, la1, _, _, ha1, _⟩ := erase_app_keep_inv hirr_g hg
  rw [erase_closed0_ctx_indep hE F3 a1 (.assumption A :: []) [] hcl1] at ha1
  exact erasable_app_ctor2 hnone hi2 hirr2 ⟨F3, la1, ha1⟩ ⟨F1, la2, ha2⟩

theorem lift_ctor2_right_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 a2 T : Expr Nat} {G : Nat} {l2 : LExpr} {dv_b : DVal}
    (hE : EnvClosed E)
    (hcl1 : closedAt 0 a1 = true)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hirr_a2 : irrelevant E n [] a2 = false)
    (hi1 : inferT E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = some T)
    (hirr1 : irrelevant E n [] (.letE A a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = false)
    (he2 : erase E n (G + 1) []
      (instantiate0 a2 (.app (.app (.const c lsc) a1) (.bvar 0))) = some l2)
    (hr2 : run (defunc l2).2 (G + 1) [] (defunc l2).1 = some dv_b)
    (hcb : noCloD dv_b = true) :
    ∃ F la lb dv_a, G ≤ F ∧
      erase E n (F + 1) [] a2 = some la ∧
      erase E n (F + 1) (.assumption A :: [])
        (.app (.app (.const c lsc) a1) (.bvar 0)) = some lb ∧
      run (defunc la).2 (F + 1) [] (defunc la).1 = some dv_a ∧
      noCloD dv_a = true ∧
      run (defunc lb).2 (F + 1) [dv_a] (defunc lb).1 = some dv_b := by
  have hinst := instantiate0_app_ctor2_right c lsc a1 a2 hcl1
  rw [hinst] at he2
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a2) = some T := by
    rw [← hinst]
    exact inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a2) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  have hirr_app1 : irrelevant E n [] (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hi2 hirr2
  obtain ⟨_, _, hi_app1, _, _⟩ := inferT_app_some.mp hi2
  have hirr_c : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi_app1 hirr_app1
  obtain ⟨Fe, la1, la2, hGFe, ha1, ha2, hl2⟩ :=
    erase_app_ctor2_inv hirr2 hirr_app1 hirr_c hnone hctor he2
  subst hl2
  have hga1 : noGlobL la1 = true := noGlobL_erase E n (Fe + 1) [] a1 la1 ha1
  have hga2 : noGlobL la2 = true := noGlobL_erase E n (Fe + 2) [] a2 la2 ha2
  obtain ⟨Fr, dv1, dv2, hGFr, _, hca2, hr1, hr2_val, hdv_b⟩ :=
    run_app_ctor2_inv la1 la2 (G + 1) c dv_b hga1 hga2 hcb hr2
  have hFeFr : Fe = Fr := Nat.succ.inj (Nat.succ.inj (Nat.succ.inj (hGFe.symm.trans hGFr)))
  subst hFeFr
  subst hdv_b
  have ha1_2 : erase E n (Fe + 2) [] a1 = some la1 :=
    erase_mono E n (Fe + 1) (Fe + 2) [] a1 la1 (Nat.le_succ (Fe + 1)) ha1
  have ha2_4 : erase E n (Fe + 4) [] a2 = some la2 :=
    erase_mono E n (Fe + 2) (Fe + 4) [] a2 la2 (Nat.le_add_right (Fe + 2) 2) ha2
  have hb_4 : erase E n (Fe + 4) (.assumption A :: [])
      (.app (.app (.const c lsc) a1) (.bvar 0)) =
      some (.app (.app (.ctor c) la1) (.bvar 0)) :=
    erase_app_ctor2_right_body hE hcl1 hnone hctor hi1 hirr1 hirr_a2 ha1_2
  have hr1_2 : run (defunc la1).2 (Fe + 2) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (Fe + 1) (Fe + 2) [] (defunc la1).1 dv1 (Nat.le_succ (Fe + 1)) hr1
  have hr2_4 : run (defunc la2).2 (Fe + 4) [] (defunc la2).1 = some dv2 :=
    run_mono (defunc la2).2 (Fe + 2) (Fe + 4) [] (defunc la2).1 dv2
      (Nat.le_add_right (Fe + 2) 2) hr2_val
  have hclL1 : closedAtL 0 la1 = true :=
    closedAtL_erase hE (Fe + 1) 0 [] a1 la1 hcl1 ha1
  have hrb_4 : run (defunc (.app (.app (.ctor c) la1) (.bvar 0))).2 (Fe + 4) [dv2]
      (defunc (.app (.app (.ctor c) la1) (.bvar 0))).1 =
      some (.ctor c [dv1, dv2]) :=
    run_app_ctor2_right_env la1 (Fe + 1) c dv1 dv2 hclL1 hca2 hr1_2
  have hG_eq : G = Fe + 2 := Nat.succ.inj hGFe
  have hle : G ≤ Fe + 3 := hG_eq ▸ Nat.le_succ (Fe + 2)
  exact ⟨Fe + 3, la2, .app (.app (.ctor c) la1) (.bvar 0), dv2,
    hle, ha2_4, hb_4, hr2_4, hca2, hrb_4⟩

theorem erasable_ctor2_diag_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 T : Expr Nat}
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (hi1 : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = some T)
    (hirr1 : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = false)
    (her1 : Erasable E n (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)))) :
    Erasable E n (instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) := by
  change Erasable E n (.app (.app (.const c lsc) a1) a1)
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a1) = some T :=
    inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a1) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  have her_a1 : Erasable E n a1 := erasable_of_let_keep hirr1 her1
  exact erasable_app_ctor2 hnone hi2 hirr2 her_a1 her_a1

theorem lift_ctor2_diag_of_let {E : ResolvedEnv} {n c : Nat} {lsc : List Level}
    {A a1 T : Expr Nat} {G : Nat} {l2 : LExpr} {dv_b : DVal}
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hirr_a1 : irrelevant E n [] a1 = false)
    (hi1 : inferT E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = some T)
    (hirr1 : irrelevant E n [] (.letE A a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = false)
    (he2 : erase E n (G + 1) []
      (instantiate0 a1 (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0))) = some l2)
    (hr2 : run (defunc l2).2 (G + 1) [] (defunc l2).1 = some dv_b)
    (hcb : noCloD dv_b = true) :
    ∃ F la lb dv_a, G ≤ F ∧
      erase E n (F + 1) [] a1 = some la ∧
      erase E n (F + 1) (.assumption A :: [])
        (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) = some lb ∧
      run (defunc la).2 (F + 1) [] (defunc la).1 = some dv_a ∧
      noCloD dv_a = true ∧
      run (defunc lb).2 (F + 1) [dv_a] (defunc lb).1 = some dv_b := by
  change erase E n (G + 1) [] (.app (.app (.const c lsc) a1) a1) = some l2 at he2
  have hi2 : inferT E n [] (.app (.app (.const c lsc) a1) a1) = some T :=
    inferT_zeta_some hE hi1
  have hirr2 : irrelevant E n [] (.app (.app (.const c lsc) a1) a1) = false :=
    irrelevant_false_of_same_type hi2 hi1 hirr1
  have hirr_app1 : irrelevant E n [] (.app (.const c lsc) a1) = false :=
    irrelevant_fun_false_of_app_irr hi2 hirr2
  obtain ⟨_, _, hi_app1, _, _⟩ := inferT_app_some.mp hi2
  have hirr_c : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi_app1 hirr_app1
  obtain ⟨Fe, la1, la2, hGFe, ha1, ha2, hl2⟩ :=
    erase_app_ctor2_inv hirr2 hirr_app1 hirr_c hnone hctor he2
  have hla : la2 = la1 := erase_unique E n (Fe + 2) (Fe + 1) [] a1 la2 la1 ha2 ha1
  rw [hla] at hl2 ha2
  subst hl2
  have hga1 : noGlobL la1 = true := noGlobL_erase E n (Fe + 1) [] a1 la1 ha1
  obtain ⟨Fr, dv1, dv2, hGFr, hca1, _, hr1, hr2_val, hdv_b⟩ :=
    run_app_ctor2_inv la1 la1 (G + 1) c dv_b hga1 hga1 hcb hr2
  have hFeFr : Fe = Fr := Nat.succ.inj (Nat.succ.inj (Nat.succ.inj (hGFe.symm.trans hGFr)))
  subst hFeFr
  have hdv : dv2 = dv1 :=
    run_unique (defunc la1).2 (Fe + 2) (Fe + 1) [] (defunc la1).1 dv2 dv1 hr2_val hr1
  rw [hdv] at hdv_b hr2_val
  subst hdv_b
  have ha1_4 : erase E n (Fe + 4) [] a1 = some la1 :=
    erase_mono E n (Fe + 2) (Fe + 4) [] a1 la1 (Nat.le_add_right (Fe + 2) 2) ha2
  have hb_4 : erase E n (Fe + 4) (.assumption A :: [])
      (.app (.app (.const c lsc) (.bvar 0)) (.bvar 0)) =
      some (.app (.app (.ctor c) (.bvar 0)) (.bvar 0)) :=
    erase_app_ctor2_diag_body hE hnone hctor hi1 hirr1 hirr_a1
  have hr1_4 : run (defunc la1).2 (Fe + 4) [] (defunc la1).1 = some dv1 :=
    run_mono (defunc la1).2 (Fe + 2) (Fe + 4) [] (defunc la1).1 dv1
      (Nat.le_add_right (Fe + 2) 2) hr2_val
  have hrb_4 : run (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).2 (Fe + 4) [dv1]
      (defunc (.app (.app (.ctor c) (.bvar 0)) (.bvar 0))).1 =
      some (.ctor c [dv1, dv1]) :=
    run_app_ctor2_diag_env (Fe + 1) c dv1 hca1
  have hG_eq : G = Fe + 2 := Nat.succ.inj hGFe
  have hle : G ≤ Fe + 3 := hG_eq ▸ Nat.le_succ (Fe + 2)
  exact ⟨Fe + 3, la1, .app (.app (.ctor c) (.bvar 0)) (.bvar 0), dv1,
    hle, ha1_4, hb_4, hr1_4, hca1, hrb_4⟩

/-! ### General `k`-ary constructor spine normalization, SCM denotation, and snoc
    compositional adequacy (`foldApps_append`, `foldApps_snoc`, `list_mapM_snoc`,
    `list_all_snoc`, `isCtorSpineL_erase_foldApps_const`, `norm_foldApps_rigid_const_eq`,
    `norm_foldApps_rigid_const_inv`, `scmValOf_foldApps_const_inv`, `valFits_inj_inv`,
    `lowerF_const_ctor_nil_eval`, `lowerF_app_ctor_spine_snoc_eval`, `CtorSpineEval`,
    `ctorSpineEval_nil`, `ctorSpineEval_snoc`, `good_of_ctorSpineEval`,
    `good_app_ctor_spine_snoc_of_eval`) -/

theorem foldApps_append :
    ∀ (xs ys : List (Expr Nat)) (f : Expr Nat),
      foldApps f (xs ++ ys) = foldApps (foldApps f xs) ys
  | [], _, _ => rfl
  | x :: xs, ys, f => foldApps_append xs ys (.app f x)

theorem foldApps_snoc (f : Expr Nat) (xs : List (Expr Nat)) (x : Expr Nat) :
    foldApps f (xs ++ [x]) = .app (foldApps f xs) x :=
  foldApps_append xs [x] f

theorem foldApps_app_is_app :
    ∀ (as : List (Expr Nat)) (g a : Expr Nat),
      ∃ g' a', foldApps (.app g a) as = .app g' a'
  | [], g, a => ⟨g, a, rfl⟩
  | x :: xs, g, a => foldApps_app_is_app xs (.app g a) x

theorem list_mapM_snoc {α β : Type} (f : α → Option β) :
    ∀ (xs : List α) (x : α),
      (xs ++ [x]).mapM f =
        match xs.mapM f, f x with
        | some ys, some y => some (ys ++ [y])
        | _, _ => none
  | [], x => by
      simp only [List.nil_append, List.mapM_cons, List.mapM_nil,
        Option.pure_def, Option.bind]
      cases f x <;> rfl
  | a :: xs, x => by
      simp only [List.cons_append, List.mapM_cons, list_mapM_snoc f xs x]
      cases f a with
      | none => rfl
      | some _ =>
          cases xs.mapM f with
          | none => rfl
          | some _ =>
              cases f x with
              | none => rfl
              | some _ => rfl

theorem list_mapM_snoc_inv {α β : Type} {f : α → Option β}
    {xs : List α} {x : α} {zs : List β}
    (h : (xs ++ [x]).mapM f = some zs) :
    ∃ ys y, xs.mapM f = some ys ∧ f x = some y ∧ zs = ys ++ [y] := by
  rw [list_mapM_snoc f xs x] at h
  cases hxs : xs.mapM f with
  | none =>
      rw [hxs] at h
      exact Option.noConfusion h
  | some ys =>
      rw [hxs] at h
      cases hx : f x with
      | none =>
          rw [hx] at h
          exact Option.noConfusion h
      | some y =>
          rw [hx] at h
          exact ⟨ys, y, rfl, rfl, (Option.some.inj h).symm⟩

theorem list_all_append {α : Type} (p : α → Bool) :
    ∀ (xs ys : List α), (xs ++ ys).all p = (xs.all p && ys.all p)
  | [], _ => by simp only [List.nil_append, List.all_nil, Bool.true_and]
  | a :: xs, ys => by
      rw [List.cons_append, List.all_cons, List.all_cons,
        list_all_append p xs ys, Bool.and_assoc]

theorem list_all_snoc {α : Type} (p : α → Bool) (xs : List α) (x : α) :
    (xs ++ [x]).all p = (xs.all p && p x) := by
  rw [list_all_append p xs [x], List.all_cons, List.all_nil, Bool.and_true]

theorem isCtorSpineL_erase_foldApps (E : ResolvedEnv) (n c : Nat) :
    ∀ (args : List (Expr Nat)) {f : Expr Nat}
      (hf : ∀ F0 Tf lf,
        inferT E n [] f = some Tf →
        irrelevant E n [] f = false →
        erase E n F0 [] f = some lf →
        isCtorSpineL c lf = true)
      {F : Nat} {T : Expr Nat} {l : LExpr},
      inferT E n [] (foldApps f args) = some T →
      irrelevant E n [] (foldApps f args) = false →
      erase E n F [] (foldApps f args) = some l →
      isCtorSpineL c l = true
  | [], _, hf, F, T, l, hi, hirr, he =>
      hf F T l hi hirr he
  | a :: as, f, hf, F, T, l, hi, hirr, he => by
      refine isCtorSpineL_erase_foldApps E n c as ?_ hi hirr he
      intro F0 Tap lap hi_app hirr_app he_app
      obtain ⟨F1, lf, la, _, he_f, _, hlap⟩ := erase_app_keep_inv hirr_app he_app
      subst hlap
      obtain ⟨A, B, hf_ty, _, _⟩ := inferT_app_some.mp hi_app
      have hirr_f : irrelevant E n [] f = false :=
        irrelevant_fun_false_of_app_irr hi_app hirr_app
      simp only [isCtorSpineL]
      exact hf F1 (.pi A B) lf hf_ty hirr_f he_f

theorem isCtorSpineL_erase_foldApps_const {E : ResolvedEnv} {n c F : Nat}
    {lsc : List Level} {args : List (Expr Nat)} {T : Expr Nat} {l : LExpr}
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hi : inferT E n [] (foldApps (.const c lsc) args) = some T)
    (hirr : irrelevant E n [] (foldApps (.const c lsc) args) = false)
    (he : erase E n F [] (foldApps (.const c lsc) args) = some l) :
    isCtorSpineL c l = true := by
  refine isCtorSpineL_erase_foldApps E n c args ?_ hi hirr he
  intro F0 _ lf _ hirrC heC
  obtain ⟨_, _, hlf⟩ := erase_const_ctor_inv hirrC hnone hctor heC
  subst hlf
  simp only [isCtorSpineL, decide_eq_true_eq]

theorem whnf_foldApps_rigid_const (E : ResolvedEnv) (k c : Nat) (lsc : List Level)
    (args : List (Expr Nat))
    (hnone : transparentBody E c lsc = none) :
    whnfFuel E (k + 1) (foldApps (.const c lsc) args) =
      some (foldApps (.const c lsc) args) := by
  have hsp : appsSpine (foldApps (.const c lsc) args) = (.const c lsc, args) := by
    rw [appsSpine_foldApps]
    simp only [appsSpine, List.nil_append]
  unfold whnfFuel
  rw [hsp]
  dsimp only
  rw [hnone]

theorem norm_foldApps_rigid_const_eq (E : ResolvedEnv) (k c : Nat) (lsc : List Level)
    (args : List (Expr Nat))
    (hnone : transparentBody E c lsc = none) :
    norm E (k + 2) (foldApps (.const c lsc) args) =
      match args.mapM (norm E (k + 1)) with
      | some vargs => some (foldApps (.const c lsc) vargs)
      | none => none := by
  cases args with
  | nil =>
      have hw : whnfFuel E (k + 1) (.const c lsc) = some (.const c lsc) :=
        whnf_foldApps_rigid_const E k c lsc [] hnone
      unfold norm
      rw [foldApps, hw]
      rfl
  | cons a as =>
      have hw : whnfFuel E (k + 1) (foldApps (.const c lsc) (a :: as)) =
          some (foldApps (.const c lsc) (a :: as)) :=
        whnf_foldApps_rigid_const E k c lsc (a :: as) hnone
      have hsp : appsSpine (foldApps (.const c lsc) (a :: as)) =
          (.const c lsc, a :: as) := by
        rw [appsSpine_foldApps]
        simp only [appsSpine, List.nil_append]
      obtain ⟨g', a', happ⟩ := foldApps_app_is_app as (.const c lsc) a
      have happ' : foldApps (.const c lsc) (a :: as) = .app g' a' := happ
      conv =>
        lhs
        unfold norm
        rw [hw]
      rw [happ']
      dsimp only
      rw [← happ', hsp]

theorem norm_foldApps_rigid_const_inv (E : ResolvedEnv) (lf c : Nat) (lsc : List Level)
    (args : List (Expr Nat)) (v : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (hn : norm E lf (foldApps (.const c lsc) args) = some v) :
    ∃ k vargs, lf = k + 2 ∧
      args.mapM (norm E (k + 1)) = some vargs ∧
      v = foldApps (.const c lsc) vargs := by
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          rw [norm_foldApps_rigid_const_eq E k c lsc args hnone] at hn
          cases hm : args.mapM (norm E (k + 1)) with
          | none =>
              rw [hm] at hn
              exact Option.noConfusion hn
          | some vargs =>
              rw [hm] at hn
              exact ⟨k, vargs, rfl, hm, (Option.some.inj hn).symm⟩

theorem scmValOf_foldApps_const_inv {E : ResolvedEnv} {fv c : Nat}
    {lsc : List Level} {vargs : List (Expr Nat)} {w : Val}
    (hs : scmValOf E fv (foldApps (.const c lsc) vargs) = some w) :
    ∃ m ws, fv = m + 1 ∧
      isCtor E c = true ∧
      vargs.mapM (scmValOf E m) = some ws ∧
      w = .inj c (.list ws) := by
  have hctor : isCtor E c = true := isCtor_of_scmValOf_foldApps hs
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      have hne : ∀ k, foldApps (.const c lsc) vargs ≠ .lit k :=
        foldApps_ne_lit vargs (.const c lsc) (fun _ h => Expr.noConfusion h)
      have hsp : appsSpine (foldApps (.const c lsc) vargs) = (.const c lsc, vargs) := by
        rw [appsSpine_foldApps]
        simp only [appsSpine, List.nil_append]
      have hs' : (match appsSpine (foldApps (.const c lsc) vargs) with
          | (.const r _, as) =>
              match E.members r with
              | some mm =>
                  if mm.mclass = .constructorM then
                    match as.mapM (scmValOf E m) with
                    | some vs => some (.inj r (.list vs))
                    | none => none
                  else none
              | none => none
          | _ => none) = some w := by
        cases h : foldApps (.const c lsc) vargs with
        | lit k => exact absurd h (hne k)
        | bvar _ | sort _ | const _ _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ =>
            simpa [scmValOf, h] using hs
      rw [hsp] at hs'
      dsimp only at hs'
      cases hm : E.members c with
      | none =>
          rw [hm] at hs'
          exact Option.noConfusion hs'
      | some mm =>
          rw [hm] at hs'
          dsimp only at hs'
          by_cases hcm : mm.mclass = .constructorM
          · rw [if_pos hcm] at hs'
            cases hmap : vargs.mapM (scmValOf E m) with
            | none =>
                rw [hmap] at hs'
                exact Option.noConfusion hs'
            | some ws =>
                rw [hmap] at hs'
                exact ⟨m, ws, rfl, hctor, hmap, (Option.some.inj hs').symm⟩
          · rw [if_neg hcm] at hs'
            exact Option.noConfusion hs'

theorem valFits_inj_inv {m c : Nat} {t : BootTy} {ws : List Val}
    (hf : valFits (m + 1) t (.inj c (.list ws)) = true) :
    ∃ ts τ, t = .sum ts ∧
      ts.get? c = some (.list τ) ∧
      ws.all (valFits m τ) = true := by
  cases t with
  | sum ts =>
      simp only [valFits] at hf
      cases hg : ts.get? c with
      | none =>
          rw [hg] at hf
          exact Bool.noConfusion hf
      | some tc =>
          rw [hg] at hf
          cases tc with
          | list τ => exact ⟨ts, τ, rfl, hg, hf⟩
          | i64 | bool | str | bytes | sum _ | pair _ _ | record _ | option _ | residue _ =>
              exact Bool.noConfusion hf
  | i64 | bool | str | bytes | list _ | pair _ _ | record _ | option _ | residue _ =>
      simp only [valFits] at hf
      exact Bool.noConfusion hf

theorem lowerF_const_ctor_nil_eval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level)
    (ts : List BootTy) (τ : BootTy)
    (hirrC : irrelevant E n [] (.const c lsc) = false)
    (hnone : transparentBody E c lsc = none)
    (hctor : isCtor E c = true)
    (hg_ty : ts.get? c = some (.list τ)) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (lowerF E n 2 (S := S) (.sum ts) (.const c lsc)) =
      some (.inj c (.list [])) := by
  have heC : erase E n 2 [] (.const c lsc) = some (.ctor c) := by
    simp only [erase, eraseWith, hirrC, Bool.false_eq_true, if_false,
      noGlobals, hnone, hctor, if_true]
  have hrC : run (defunc (.ctor c)).2 2 [] (defunc (.ctor c)).1 =
      some (.ctor c []) := by
    change run [] 2 [] (.ctor c) = some (.ctor c [])
    rw [run_ctor_eq]
  rw [lowerF_eq_of_erase_run E n 2 (.sum ts) (.const c lsc) (.ctor c) (.ctor c []) heC hrC]
  have hnil : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (listOf ((relevantArgs []).map (emitWith relevantArgs (S := S) (G := []) 1 τ))) =
      some (.list []) := by
    simp [relevantArgs, listOf, Residua.Bootstrap.Semantics.eval]
  exact eval_emit_ctor_of_list progs 0 c ts τ [] [] hg_ty hnil

theorem lowerF_app_ctor_spine_snoc_eval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n G1 G2 lfe1 lfe2 c : Nat)
    (ts : List BootTy) (τ : BootTy) (g a : Expr Nat)
    (ws : List Val) (wa : Val)
    (hirr : irrelevant E n [] (.app g a) = false)
    (hcs : ∀ lg, erase E n G1 [] g = some lg → isCtorSpineL c lg = true)
    (hg_ty : ts.get? c = some (.list τ))
    (hev_g : Residua.Bootstrap.Semantics.eval lawsA progs lfe1 []
      (lowerF E n G1 (S := S) (.sum ts) g) = some (.inj c (.list ws)))
    (hev_a : Residua.Bootstrap.Semantics.eval lawsA progs lfe2 []
      (lowerF E n G2 (S := S) τ a) = some wa) :
    Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (lowerF E n (G1 + G2 + 2) (S := S) (.sum ts) (.app g a)) =
      some (.inj c (.list (ws ++ [wa]))) := by
  unfold lowerF pipeline at hev_g hev_a
  cases hg : erase E n G1 [] g with
  | none =>
      simp only [hg] at hev_g
      exact absurd hev_g (eval_refuse_ne progs lfe1 [] (.inj c (.list ws)))
  | some lg =>
      simp only [hg] at hev_g
      have hcs_lg : isCtorSpineL c lg = true := hcs lg hg
      cases hrg : run (defunc lg).2 G1 [] (defunc lg).1 with
      | none =>
          simp only [hrg] at hev_g
          exact absurd hev_g (eval_refuse_ne progs lfe1 [] (.inj c (.list ws)))
      | some dvg =>
          simp only [hrg] at hev_g
          obtain ⟨dvs, hdvg⟩ :=
            run_isCtorSpineL_shape c lg id [] (defunc lg).2 G1 [] dvg hcs_lg hrg
          subst hdvg
          cases ha : erase E n G2 [] a with
          | none =>
              simp only [ha] at hev_a
              exact absurd hev_a (eval_refuse_ne progs lfe2 [] wa)
          | some la =>
              simp only [ha] at hev_a
              have hga : noGlobL la = true := noGlobL_erase E n G2 [] a la ha
              cases hra : run (defunc la).2 G2 [] (defunc la).1 with
              | none =>
                  simp only [hra] at hev_a
                  exact absurd hev_a (eval_refuse_ne progs lfe2 [] wa)
              | some dva =>
                  simp only [hra] at hev_a
                  have hca : noCloD dva = true :=
                    noCloD_emitWith progs G2 lfe2 τ dva wa hev_a
                  have hev_g1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                      (emit (S := S) (G := []) G1 (.sum ts) (.ctor c dvs)) =
                      some (.inj c (.list ws)) :=
                    emit_eval_fuel1 progs G1 lfe1 (.sum ts) (.ctor c dvs) (.inj c (.list ws)) hev_g
                  have hev_a1 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                      (emit (S := S) (G := []) G2 τ dva) = some wa :=
                    emit_eval_fuel1 progs G2 lfe2 τ dva wa hev_a
                  have hle1 : G1 ≤ G1 + G2 + 1 :=
                    Nat.le_trans (Nat.le_add_right G1 G2) (Nat.le_succ (G1 + G2))
                  have hle1' : G1 ≤ G1 + G2 + 2 :=
                    Nat.le_trans hle1 (Nat.le_succ (G1 + G2 + 1))
                  have hle2 : G2 ≤ G1 + G2 + 1 :=
                    Nat.le_trans (Nat.le_add_left G2 G1) (Nat.le_succ (G1 + G2))
                  have hg' : erase E n (G1 + G2 + 1) [] g = some lg :=
                    erase_mono E n G1 (G1 + G2 + 1) [] g lg hle1 hg
                  have ha' : erase E n (G1 + G2 + 1) [] a = some la :=
                    erase_mono E n G2 (G1 + G2 + 1) [] a la hle2 ha
                  have he_app : erase E n (G1 + G2 + 2) [] (.app g a) =
                      some (.app lg la) := by
                    rw [erase_app_keep E n (G1 + G2 + 1) [] g a hirr, hg', ha']
                  have hrg' : run (defunc lg).2 (G1 + G2 + 1) [] (defunc lg).1 =
                      some (.ctor c dvs) :=
                    run_mono (defunc lg).2 G1 (G1 + G2 + 1) [] (defunc lg).1
                      (.ctor c dvs) hle1 hrg
                  have hra' : run (defunc la).2 (G1 + G2 + 1) [] (defunc la).1 =
                      some dva :=
                    run_mono (defunc la).2 G2 (G1 + G2 + 1) [] (defunc la).1 dva hle2 hra
                  have hr_app : run (defunc (.app lg la)).2 (G1 + G2 + 2) []
                      (defunc (.app lg la)).1 = some (.ctor c (dvs ++ [dva])) :=
                    run_app_ctor_spine_step lg la (G1 + G2) c dvs dva hga hca hrg' hra'
                  have hev_gF : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                      (emit (S := S) (G := []) (G1 + G2 + 2) (.sum ts) (.ctor c dvs)) =
                      some (.inj c (.list ws)) :=
                    emitWith_evalStable relevantArgs progs 1 [] G1 (G1 + G2 + 2)
                      (.sum ts) (.ctor c dvs) (.inj c (.list ws)) hle1' hev_g1
                  have hev_aF : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
                      (emit (S := S) (G := []) (G1 + G2 + 1) τ dva) = some wa :=
                    emitWith_evalStable relevantArgs progs 1 [] G2 (G1 + G2 + 1)
                      τ dva wa hle2 hev_a1
                  rw [lowerF_eq_of_erase_run E n (G1 + G2 + 2) (.sum ts) (.app g a)
                    (.app lg la) (.ctor c (dvs ++ [dva])) he_app hr_app]
                  exact eval_emit_ctor_snoc progs (G1 + G2) c ts τ dvs dva ws wa
                    hg_ty hev_gF hev_aF

def CtorSpineEval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (xs : List (Expr Nat)) : Prop :=
  ∀ (k m : Nat) (vxs : List (Expr Nat)) (ts : List BootTy) (τ : BootTy) (ws : List Val)
    (T : Expr Nat),
    inferT E n [] (foldApps (.const c lsc) xs) = some T →
    irrelevant E n [] (foldApps (.const c lsc) xs) = false →
    isCtor E c = true →
    xs.mapM (norm E (k + 1)) = some vxs →
    vxs.mapM (scmValOf E m) = some ws →
    vxs.all (fun a => !irrelevant E n [] a && relevantSpine E n m a) = true →
    ts.get? c = some (.list τ) →
    ws.all (valFits m τ) = true →
    ∃ G lfe,
      Residua.Bootstrap.Semantics.eval lawsA progs lfe []
        (lowerF E n G (S := S) (.sum ts) (foldApps (.const c lsc) xs)) =
        some (.inj c (.list ws))

theorem ctorSpineEval_nil {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level)
    (hnone : transparentBody E c lsc = none) :
    CtorSpineEval progs E n c lsc [] := by
  intro k m vxs ts τ ws T _ hirrC hctor hnorm hscm _ hg_ty _
  simp only [List.mapM_nil, Option.pure_def] at hnorm
  have hvxs : vxs = [] := (Option.some.inj hnorm).symm
  subst hvxs
  simp only [List.mapM_nil, Option.pure_def] at hscm
  have hws : ws = [] := (Option.some.inj hscm).symm
  subst hws
  exact ⟨2, 1, lowerF_const_ctor_nil_eval progs E n c lsc ts τ hirrC hnone hctor hg_ty⟩

theorem ctorSpineEval_snoc {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level)
    (xs : List (Expr Nat)) (x : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (hxs : CtorSpineEval progs E n c lsc xs)
    (hx : ∀ (lf1 fv1 : Nat) (vx : Expr Nat) (τ : BootTy) (wx : Val),
      norm E lf1 x = some vx →
      scmValOf E fv1 vx = some wx →
      relevantSpine E n fv1 vx = true →
      irrelevant E n [] vx = false →
      valFits fv1 τ wx = true →
      ∃ G2 lfe2,
        Residua.Bootstrap.Semantics.eval lawsA progs lfe2 []
          (lowerF E n G2 (S := S) τ x) = some wx) :
    CtorSpineEval progs E n c lsc (xs ++ [x]) := by
  intro k m vargs ts τ ws_all T hi hirr hctor hnorm hscm hrel hg_ty hfits
  rw [foldApps_snoc (.const c lsc) xs x] at hi hirr ⊢
  obtain ⟨Ax, Bx, hi_xs, _, _⟩ := inferT_app_some.mp hi
  have hirr_xs : irrelevant E n [] (foldApps (.const c lsc) xs) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  obtain ⟨vxs, vx, hnorm_xs, hnorm_x, hvargs⟩ := list_mapM_snoc_inv hnorm
  subst hvargs
  obtain ⟨ws, wx, hscm_xs, hscm_x, hws_all⟩ := list_mapM_snoc_inv hscm
  subst hws_all
  rw [list_all_snoc] at hrel
  simp only [Bool.and_eq_true] at hrel
  have hirr_vx : irrelevant E n [] vx = false :=
    irrelevant_false_of_not_eq_true hrel.2.1
  rw [list_all_snoc] at hfits
  simp only [Bool.and_eq_true] at hfits
  obtain ⟨G1, lfe1, hev_g⟩ :=
    hxs k m vxs ts τ ws (.pi Ax Bx) hi_xs hirr_xs hctor
      hnorm_xs hscm_xs hrel.1 hg_ty hfits.1
  obtain ⟨G2, lfe2, hev_x⟩ :=
    hx (k + 1) m vx τ wx hnorm_x hscm_x hrel.2.2 hirr_vx hfits.2
  have hcs : ∀ lg, erase E n G1 [] (foldApps (.const c lsc) xs) = some lg →
      isCtorSpineL c lg = true :=
    fun _ he_g => isCtorSpineL_erase_foldApps_const hnone hctor hi_xs hirr_xs he_g
  exact ⟨G1 + G2 + 2, 1,
    lowerF_app_ctor_spine_snoc_eval progs E n G1 G2 lfe1 lfe2 c ts τ
      (foldApps (.const c lsc) xs) x ws wx hirr hcs hg_ty hev_g hev_x⟩

theorem good_of_ctorSpineEval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (xs : List (Expr Nat))
    (hnone : transparentBody E c lsc = none)
    (hxs : CtorSpineEval progs E n c lsc xs) :
    Good progs E n (foldApps (.const c lsc) xs) := by
  refine good_of_exists progs E n (foldApps (.const c lsc) xs) ?_
  intro lf fv T v t w _ hi _ hn hs hrel hirrv hf hvinf _
  have hirr : irrelevant E n [] (foldApps (.const c lsc) xs) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  obtain ⟨k, vxs, _, hnorm_xs, hv⟩ :=
    norm_foldApps_rigid_const_inv E lf c lsc xs v hnone hn
  subst hv
  obtain ⟨m, ws, hfv, hctor, hscm_xs, hw⟩ :=
    scmValOf_foldApps_const_inv hs
  subst hfv
  subst hw
  obtain ⟨m', hm', hrel_xs⟩ :=
    relevantSpine_foldApps_const hrel
  have hmm : m' = m := Nat.succ.inj hm'.symm
  rw [hmm] at hrel_xs
  obtain ⟨ts, τ, ht, hg_ty, hfits_xs⟩ := valFits_inj_inv hf
  subst ht
  exact hxs k m vxs ts τ ws T hi hirr hctor hnorm_xs hscm_xs hrel_xs hg_ty hfits_xs

theorem good_app_ctor_spine_snoc_of_eval {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level)
    (xs : List (Expr Nat)) (x : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (hxs : CtorSpineEval progs E n c lsc xs)
    (hx : ∀ (lf1 fv1 : Nat) (vx : Expr Nat) (τ : BootTy) (wx : Val),
      norm E lf1 x = some vx →
      scmValOf E fv1 vx = some wx →
      relevantSpine E n fv1 vx = true →
      irrelevant E n [] vx = false →
      valFits fv1 τ wx = true →
      ∃ G2 lfe2,
        Residua.Bootstrap.Semantics.eval lawsA progs lfe2 []
          (lowerF E n G2 (S := S) τ x) = some wx) :
    Good progs E n (.app (foldApps (.const c lsc) xs) x) := by
  rw [← foldApps_snoc (.const c lsc) xs x]
  exact good_of_ctorSpineEval progs E n c lsc (xs ++ [x]) hnone
    (ctorSpineEval_snoc progs E n c lsc xs x hnone hxs hx)

/-! ### Canonical data value self-normalization (`foldApps_appsSpine`,
    `scmValOf_non_lit_spine`, `norm_self_of_scmValOf`, `norm_eq_self_of_scmValOf`),
    universal canonical value lowering evaluation (`eval_lowerF_foldApps_of_scmValOf`,
    `eval_lowerF_of_scmValOf`), universal canonical value adequacy (`good_of_scmValOf`),
    and canonical value δ/β/ζ/constructor lifting corollaries
    (`good_const_delta_of_scmValOf`, `good_foldApps_const_delta_of_scmValOf`,
    `good_let_id_of_scmValOf`, `good_beta_id_of_scmValOf`, `good_app_ctor_of_scmValOf`,
    `good_let_ctor_of_scmValOf`, `good_beta_ctor_of_scmValOf`,
    `good_app_ctor2_of_scmValOf`, `good_let_ctor2_left_of_scmValOf`,
    `good_beta_ctor2_left_of_scmValOf`, `good_let_ctor2_right_of_scmValOf`,
    `good_beta_ctor2_right_of_scmValOf`, `good_let_ctor2_diag_of_scmValOf`,
    `good_beta_ctor2_diag_of_scmValOf`) -/

theorem foldApps_appsSpine :
    ∀ (e : Expr Nat), foldApps (appsSpine e).1 (appsSpine e).2 = e
  | .bvar _ => rfl
  | .sort _ => rfl
  | .const _ _ => rfl
  | .lam _ _ => rfl
  | .pi _ _ => rfl
  | .letE _ _ _ => rfl
  | .lit _ => rfl
  | .app g a => by
      simp only [appsSpine]
      rw [foldApps_snoc (appsSpine g).1 (appsSpine g).2 a, foldApps_appsSpine g]

theorem scmValOf_non_lit_spine {E : ResolvedEnv} {m : Nat} {v : Expr Nat} {w : Val}
    (hne : ∀ k, v ≠ .lit k)
    (hs : scmValOf E (m + 1) v = some w) :
    ∃ c lsc args, v = foldApps (.const c lsc) args := by
  have hs' : (match appsSpine v with
      | (.const r _, as) =>
          match E.members r with
          | some mm =>
              if mm.mclass = .constructorM then
                match as.mapM (scmValOf E m) with
                | some vs => some (.inj r (.list vs))
                | none => none
              else none
          | none => none
      | _ => none) = some w := by
    cases h : v with
    | lit k => exact absurd h (hne k)
    | bvar _ | sort _ | const _ _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ =>
        simpa [scmValOf, h] using hs
  cases hsp : appsSpine v with
  | mk head args =>
      rw [hsp] at hs'
      cases head with
      | const c lsc =>
          refine ⟨c, lsc, args, ?_⟩
          have hfold := (foldApps_appsSpine v).symm
          rw [hsp] at hfold
          exact hfold
      | bvar _ | sort _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ | lit _ =>
          exact Option.noConfusion hs'

theorem list_mapM_cons_inv {α β : Type} {f : α → Option β}
    {a : α} {as : List α} {zs : List β}
    (h : (a :: as).mapM f = some zs) :
    ∃ y ys, f a = some y ∧ as.mapM f = some ys ∧ zs = y :: ys := by
  rw [List.mapM_cons] at h
  cases ha : f a with
  | none =>
      simp only [ha, Option.bind, Option.none_bind] at h
      exact Option.noConfusion h
  | some y =>
      simp only [ha, Option.bind] at h
      cases has : as.mapM f with
      | none =>
          simp only [has] at h
          exact Option.noConfusion h
      | some ys =>
          simp only [has, Option.pure_def] at h
          exact ⟨y, ys, rfl, rfl, (Option.some.inj h).symm⟩

theorem list_mapM_id_of_mapM_some {α β : Type} {f : α → Option β} {g : α → Option α}
    (hfg : ∀ a b, f a = some b → g a = some a) :
    ∀ (xs : List α) (ys : List β), xs.mapM f = some ys → xs.mapM g = some xs
  | [], _, _ => rfl
  | a :: xs, ys, h => by
      obtain ⟨b, bs, ha, hxs, _⟩ := list_mapM_cons_inv h
      simp only [List.mapM_cons, hfg a b ha,
        list_mapM_id_of_mapM_some hfg xs bs hxs]
      rfl

theorem lit_or_ne_lit :
    ∀ (v : Expr Nat), (∃ k, v = .lit k) ∨ (∀ k, v ≠ .lit k)
  | .lit k => Or.inl ⟨k, rfl⟩
  | .bvar _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .sort _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .const _ _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .app _ _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .lam _ _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .pi _ _ => Or.inr (fun _ h => Expr.noConfusion h)
  | .letE _ _ _ => Or.inr (fun _ h => Expr.noConfusion h)

theorem norm_self_of_scmValOf (E : ResolvedEnv) :
    ∀ (fv : Nat) (v : Expr Nat) (w : Val),
      scmValOf E fv v = some w →
      norm E (fv + 1) v = some v := by
  intro fv
  induction fv with
  | zero =>
      intro _ _ hs
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m ih =>
      intro v w hs
      rcases lit_or_ne_lit v with ⟨k, rfl⟩ | hne
      · have hw : whnfFuel E (m + 1) (.lit k) = some (.lit k) := rfl
        unfold norm
        rw [hw]
      · obtain ⟨c, lsc, args, hv⟩ := scmValOf_non_lit_spine hne hs
        subst hv
        obtain ⟨m', ws, hm', hctor, hscm, _⟩ := scmValOf_foldApps_const_inv hs
        have hmm : m' = m := Nat.succ.inj hm'.symm
        rw [hmm] at hscm
        have hnone : transparentBody E c lsc = none :=
          transparentBody_eq_none_of_isCtor E c lsc hctor
        have hnorm_args : args.mapM (norm E (m + 1)) = some args :=
          list_mapM_id_of_mapM_some ih args ws hscm
        rw [norm_foldApps_rigid_const_eq E m c lsc args hnone, hnorm_args]

theorem norm_eq_self_of_scmValOf {E : ResolvedEnv} {fv lf : Nat}
    {v v' : Expr Nat} {w : Val}
    (hs : scmValOf E fv v = some w)
    (hn : norm E lf v = some v') :
    v' = v :=
  norm_unique E lf (fv + 1) v v' v hn (norm_self_of_scmValOf E fv v w hs)

theorem eval_lowerF_foldApps_of_scmValOf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n m c : Nat) (ts : List BootTy) (τ : BootTy)
    (hg_ty : ts.get? c = some (.list τ))
    (ih : ∀ (v' T' : Expr Nat) (w' : Val),
      inferT E n [] v' = some T' →
      scmValOf E m v' = some w' →
      relevantSpine E n m v' = true →
      irrelevant E n [] v' = false →
      valFits m τ w' = true →
      ∃ F,
        Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (lowerF E n F (S := S) τ v') = some w') :
    ∀ (args : List (Expr Nat)) (f T : Expr Nat) (ws_acc ws_rem : List Val) (G1 : Nat),
      inferT E n [] (foldApps f args) = some T →
      irrelevant E n [] (foldApps f args) = false →
      (∀ F0 Tf lf,
        inferT E n [] f = some Tf →
        irrelevant E n [] f = false →
        erase E n F0 [] f = some lf →
        isCtorSpineL c lf = true) →
      Residua.Bootstrap.Semantics.eval lawsA progs 1 []
        (lowerF E n G1 (S := S) (.sum ts) f) = some (.inj c (.list ws_acc)) →
      args.mapM (scmValOf E m) = some ws_rem →
      args.all (fun a => !irrelevant E n [] a && relevantSpine E n m a) = true →
      ws_rem.all (valFits m τ) = true →
      ∃ F,
        Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (lowerF E n F (S := S) (.sum ts) (foldApps f args)) =
          some (.inj c (.list (ws_acc ++ ws_rem)))
  | [], f, _, ws_acc, ws_rem, G1, _, _, _, hev_f, hscm, _, _ => by
      simp only [List.mapM_nil, Option.pure_def] at hscm
      have hws : ws_rem = [] := (Option.some.inj hscm).symm
      subst hws
      simp only [List.append_nil, foldApps]
      exact ⟨G1, hev_f⟩
  | a :: as, f, T, ws_acc, ws_rem, G1, hi, hirr, hcs_f, hev_f, hscm, hrel, hfits => by
      obtain ⟨Tap, hi_app⟩ := inferT_foldApps_head_some E n as (.app f a) T hi
      have hirr_app : irrelevant E n [] (.app f a) = false :=
        irrelevant_foldApps_head_false E n as (.app f a) T hi hirr
      obtain ⟨A, B, hi_f, hi_a, _⟩ := inferT_app_some.mp hi_app
      have hirr_f : irrelevant E n [] f = false :=
        irrelevant_fun_false_of_app_irr hi_app hirr_app
      obtain ⟨wa, ws_tail, hscm_a, hscm_as, hws_rem⟩ := list_mapM_cons_inv hscm
      subst hws_rem
      simp only [List.all_cons, Bool.and_eq_true] at hrel hfits
      have hirr_a : irrelevant E n [] a = false :=
        irrelevant_false_of_not_eq_true hrel.1.1
      obtain ⟨G2, hev_a⟩ := ih a A wa hi_a hscm_a hrel.1.2 hirr_a hfits.1
      have hev_app : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (lowerF E n (G1 + G2 + 2) (S := S) (.sum ts) (.app f a)) =
          some (.inj c (.list (ws_acc ++ [wa]))) :=
        lowerF_app_ctor_spine_snoc_eval progs E n G1 G2 1 1 c ts τ f a ws_acc wa
          hirr_app (fun lg hg => hcs_f G1 (.pi A B) lg hi_f hirr_f hg)
          hg_ty hev_f hev_a
      have hcs_app : ∀ F0 Tap0 lap,
          inferT E n [] (.app f a) = some Tap0 →
          irrelevant E n [] (.app f a) = false →
          erase E n F0 [] (.app f a) = some lap →
          isCtorSpineL c lap = true := by
        intro F0 _ lap hi_app0 hirr_app0 he_app0
        obtain ⟨F1, lf, _, _, he_f0, _, hlap⟩ := erase_app_keep_inv hirr_app0 he_app0
        subst hlap
        obtain ⟨A0, B0, hi_f0, _, _⟩ := inferT_app_some.mp hi_app0
        have hirr_f0 : irrelevant E n [] f = false :=
          irrelevant_fun_false_of_app_irr hi_app0 hirr_app0
        simp only [isCtorSpineL]
        exact hcs_f F1 (.pi A0 B0) lf hi_f0 hirr_f0 he_f0
      obtain ⟨F, hev_as⟩ :=
        eval_lowerF_foldApps_of_scmValOf progs E n m c ts τ hg_ty ih
          as (.app f a) T (ws_acc ++ [wa]) ws_tail (G1 + G2 + 2)
          hi hirr hcs_app hev_app hscm_as hrel.2 hfits.2
      rw [List.append_assoc, List.singleton_append] at hev_as
      exact ⟨F, hev_as⟩

theorem eval_lowerF_of_scmValOf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) :
    ∀ (fv : Nat) (v T : Expr Nat) (t : BootTy) (w : Val),
      inferT E n [] v = some T →
      scmValOf E fv v = some w →
      relevantSpine E n fv v = true →
      irrelevant E n [] v = false →
      valFits fv t w = true →
      ∃ F,
        Residua.Bootstrap.Semantics.eval lawsA progs 1 []
          (lowerF E n F (S := S) t v) = some w := by
  intro fv
  induction fv with
  | zero =>
      intro _ _ _ _ _ hs _ _ _
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m ih =>
      intro v T t w hi hs hrel hirr hf
      rcases lit_or_ne_lit v with ⟨k, rfl⟩ | hne
      · have hs2 : scmValOf E (m + 1) (.lit k) = some (.int (Int.ofNat k)) := rfl
        rw [hs2] at hs
        cases hs
        cases t with
        | i64 =>
            have hk : inI64Range (Int.ofNat k) = true := hf
            refine ⟨1, ?_⟩
            rw [lowerF_lit, if_pos hk]
            exact eval_litI progs _ hk
        | bool | str | bytes | list _ | sum _ | pair _ _ | record _ |
          option _ | residue _ =>
            simp only [valFits] at hf
            exact Bool.noConfusion hf
      · obtain ⟨c, lsc, args, hv⟩ := scmValOf_non_lit_spine hne hs
        subst hv
        obtain ⟨m1, ws, hm1, hctor, hscm, hw⟩ := scmValOf_foldApps_const_inv hs
        have hmm1 : m1 = m := Nat.succ.inj hm1.symm
        rw [hmm1] at hscm
        subst hw
        obtain ⟨m2, hm2, hrel_args⟩ := relevantSpine_foldApps_const hrel
        have hmm2 : m2 = m := Nat.succ.inj hm2.symm
        rw [hmm2] at hrel_args
        obtain ⟨ts, τ, ht, hg_ty, hfits_ws⟩ := valFits_inj_inv hf
        subst ht
        have hnone : transparentBody E c lsc = none :=
          transparentBody_eq_none_of_isCtor E c lsc hctor
        have hirrC : irrelevant E n [] (.const c lsc) = false :=
          irrelevant_foldApps_head_false E n args (.const c lsc) T hi hirr
        have hev_c : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
            (lowerF E n 2 (S := S) (.sum ts) (.const c lsc)) =
            some (.inj c (.list [])) :=
          lowerF_const_ctor_nil_eval progs E n c lsc ts τ hirrC hnone hctor hg_ty
        have hcs_c : ∀ F0 Tf lf,
            inferT E n [] (.const c lsc) = some Tf →
            irrelevant E n [] (.const c lsc) = false →
            erase E n F0 [] (.const c lsc) = some lf →
            isCtorSpineL c lf = true := by
          intro F0 _ lf _ hirrC0 heC0
          obtain ⟨_, _, hlf⟩ := erase_const_ctor_inv hirrC0 hnone hctor heC0
          subst hlf
          simp only [isCtorSpineL, decide_eq_true_eq]
        obtain ⟨F, hev⟩ :=
          eval_lowerF_foldApps_of_scmValOf progs E n m c ts τ hg_ty
            (fun v' T' w' hi' hs' hrel' hirr' hf' =>
              ih v' T' τ w' hi' hs' hrel' hirr' hf')
            args (.const c lsc) T [] ws 2 hi hirr hcs_c hev_c hscm hrel_args hfits_ws
        simp only [List.nil_append] at hev
        exact ⟨F, hev⟩

theorem good_of_scmValOf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n fv0 : Nat) (e : Expr Nat) (w0 : Val)
    (hs0 : scmValOf E fv0 e = some w0) :
    Good progs E n e := by
  refine good_of_exists progs E n e ?_
  intro lf fv T v t w _ hi _ hn hs hrel hirrv hf _ _
  have hv : v = e := norm_eq_self_of_scmValOf hs0 hn
  subst hv
  obtain ⟨F, hev⟩ := eval_lowerF_of_scmValOf progs E n fv v T t w hi hs hrel hirrv hf
  exact ⟨F, 1, hev⟩

theorem lowerF_eval_inv {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n F lfe : Nat) (t : BootTy) (e : Expr Nat) (w : Val)
    (hev : Residua.Bootstrap.Semantics.eval lawsA progs lfe []
      (lowerF E n F (S := S) t e) = some w) :
    ∃ l dv,
      erase E n F [] e = some l ∧
      run (defunc l).2 F [] (defunc l).1 = some dv ∧
      noCloD dv = true ∧
      Residua.Bootstrap.Semantics.eval lawsA progs 1 []
        (emit (S := S) (G := []) F t dv) = some w := by
  unfold lowerF pipeline at hev
  cases he : erase E n F [] e with
  | none =>
      simp only [he] at hev
      exact absurd hev (eval_refuse_ne progs lfe [] w)
  | some l =>
      simp only [he] at hev
      cases hr : run (defunc l).2 F [] (defunc l).1 with
      | none =>
          simp only [hr] at hev
          exact absurd hev (eval_refuse_ne progs lfe [] w)
      | some dv =>
          simp only [hr] at hev
          exact ⟨l, dv, rfl, hr,
            noCloD_emitWith progs F lfe t dv w hev,
            emit_eval_fuel1 progs F lfe t dv w hev⟩

theorem good_of_norm_run_lift {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat)
    (hLift : ∀ (lf fv Fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val)
      (lv : LExpr) (dv : DVal),
      BodiesTyped E n →
      inferT E n [] e = some T →
      DataTy E T →
      norm E lf e = some v →
      scmValOf E fv v = some w →
      relevantSpine E n fv v = true →
      irrelevant E n [] v = false →
      valFits fv t w = true →
      inferT E n [] v = some T →
      Erasable E n e →
      irrelevant E n [] e = false →
      erase E n Fv [] v = some lv →
      run (defunc lv).2 Fv [] (defunc lv).1 = some dv →
      noCloD dv = true →
      ∃ Fe le, Fv ≤ Fe ∧
        erase E n Fe [] e = some le ∧
        run (defunc le).2 Fe [] (defunc le).1 = some dv) :
    Good progs E n e := by
  refine good_of_exists progs E n e ?_
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  have hirre : irrelevant E n [] e = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  obtain ⟨Fv, hev_v⟩ :=
    eval_lowerF_of_scmValOf (S := S) progs E n fv v T t w hvinf hs hrel hirrv hf
  obtain ⟨lv, dv, he_v, hr_v, hcdv, hemit_v⟩ :=
    lowerF_eval_inv progs E n Fv 1 t v w hev_v
  obtain ⟨Fe, le, hle, he_e, hr_e⟩ :=
    hLift lf fv Fv T v t w lv dv hB hi hD hn hs hrel hirrv hf hvinf her hirre he_v hr_v hcdv
  refine ⟨Fe, 1, ?_⟩
  rw [lowerF_eq_of_erase_run E n Fe t e le dv he_e hr_e]
  exact emitWith_evalStable relevantArgs progs 1 [] Fv Fe t dv w hle hemit_v

/-! ### Passive and higher-order defunctionalization simulation (`evalL_run_passive`,
    `ValRel`, `evalL_run_sim`, `evalL_run_defunc`), Stage-1 reduction-trace lifting
    (`whnfFuel_stepEvalL`, `stepEvalL_foldApps`, `norm_stepEvalL`, `good_of_envWf`),
    and compositional adequacy combinators -/

def renameD (ρ : Nat → Nat) : LExpr → DExpr
  | .bvar i => .var (ρ i)
  | .box => .box
  | .lit k => .lit k
  | .ctor r => .ctor r
  | .rigid r => .rigid r
  | .glob i => .glob i
  | .app f a => .apply (renameD ρ f) (renameD ρ a)
  | .lam _ => .box
  | .letE v b => .letE (renameD ρ v) (renameD (liftRen ρ) b)

theorem liftRen_id : liftRen id = id := by
  funext i
  cases i <;> rfl

theorem convWith_passive : ∀ (l : LExpr) (ρ : Nat → Nat) (code : List Code),
    passive l = true → convWith capRen ρ code l = (renameD ρ l, code)
  | .bvar _, _, _, _ => rfl
  | .box, _, _, _ => rfl
  | .lit _, _, _, _ => rfl
  | .ctor _, _, _, _ => rfl
  | .rigid _, _, _, _ => rfl
  | .glob _, _, _, h => by simp [passive] at h
  | .lam _, _, _, h => by simp [passive] at h
  | .app f a, ρ, code, h => by
      simp only [passive, Bool.and_eq_true] at h
      have hf := convWith_passive f ρ code h.1
      have ha := convWith_passive a ρ code h.2
      simp only [convWith, hf]
      simp only [ha, renameD]
  | .letE v b, ρ, code, h => by
      simp only [passive, Bool.and_eq_true] at h
      have hv := convWith_passive v ρ code h.1
      have hb := convWith_passive b (liftRen ρ) code h.2
      simp only [convWith, hv]
      simp only [hb, renameD]

theorem defunc_passive (l : LExpr) (h : passive l = true) :
    defunc l = (renameD id l, []) := by
  simpa [defunc] using convWith_passive l id [] h

theorem toDEnv_nil : toDEnv [] = some [] := rfl

theorem toDEnv_get? : ∀ {envL envD} (he : toDEnv envL = some envD) (i : Nat) (v : LVal),
    envL.get? i = some v → ∃ d, lToD v = some d ∧ envD.get? i = some d
  | [], _, _, _, _, hg => by simp at hg
  | x :: xs, envD, he, 0, v, hg => by
      simp only [List.get?_cons_zero, Option.some.injEq] at hg
      subst hg
      simp only [toDEnv] at he
      cases hx : lToD x with
      | none => simp [hx] at he
      | some d =>
          cases hxs : toDEnv xs with
          | none => simp [hx, hxs] at he
          | some ds =>
              simp only [hx, hxs, Option.some.injEq] at he
              subst he
              exact ⟨d, rfl, rfl⟩
  | x :: xs, envD, he, i + 1, v, hg => by
      simp only [List.get?_cons_succ] at hg
      simp only [toDEnv] at he
      cases hx : lToD x with
      | none => simp [hx] at he
      | some d =>
          cases hxs : toDEnv xs with
          | none => simp [hx, hxs] at he
          | some ds =>
              simp only [hx, hxs, Option.some.injEq] at he
              subst he
              exact toDEnv_get? hxs i v hg

theorem lToDList_snoc : ∀ (xs : List LVal) (x : LVal),
    lToDList (xs ++ [x]) =
      match lToDList xs, lToD x with
      | some ys, some y => some (ys ++ [y])
      | _, _ => none
  | [], x => by cases h : lToD x <;> simp [lToDList, h]
  | a :: as, x => by
      cases ha : lToD a <;> cases has : lToDList as <;> cases hx : lToD x <;>
        simp [lToDList, List.cons_append, ha, has, hx, lToDList_snoc as x]

theorem noCloList_get? : ∀ (xs : List LVal) (i : Nat) (a : LVal),
    xs.get? i = some a → noCloList xs = true → noClo a = true
  | [], _, _, h, _ => by simp at h
  | _ :: _, 0, _, h, hall => by
      simp only [List.get?_cons_zero, Option.some.injEq] at h
      subst h
      simp only [noCloList, Bool.and_eq_true] at hall
      exact hall.1
  | _ :: xs, i + 1, a, h, hall => by
      simp only [List.get?_cons_succ] at h
      simp only [noCloList, Bool.and_eq_true] at hall
      exact noCloList_get? xs i a h hall.2

theorem noCloList_snoc : ∀ (xs : List LVal) (x : LVal),
    noCloList (xs ++ [x]) = (noCloList xs && noClo x)
  | [], _ => by simp [noCloList]
  | y :: ys, x => by
      simp [noCloList, noCloList_snoc ys x, Bool.and_assoc]

mutual
theorem lToD_of_noClo : ∀ v, noClo v = true → ∃ d, lToD v = some d
  | .box, _ => ⟨.box, rfl⟩
  | .lit k, _ => ⟨.lit k, rfl⟩
  | .clo _ _, h => by simp [noClo] at h
  | .ctor r xs, h => by
      simp only [noClo] at h
      obtain ⟨ys, hys⟩ := lToDList_of_noClo xs h
      exact ⟨.ctor r ys, by simp [lToD, hys]⟩
  | .rigid r xs, h => by
      simp only [noClo] at h
      obtain ⟨ys, hys⟩ := lToDList_of_noClo xs h
      exact ⟨.rigid r ys, by simp [lToD, hys]⟩
termination_by v => sizeOf v

theorem lToDList_of_noClo : ∀ xs, noCloList xs = true → ∃ ys, lToDList xs = some ys
  | [], _ => ⟨[], rfl⟩
  | x :: xs, h => by
      simp only [noCloList, Bool.and_eq_true] at h
      obtain ⟨d, hd⟩ := lToD_of_noClo x h.1
      obtain ⟨ys, hys⟩ := lToDList_of_noClo xs h.2
      exact ⟨d :: ys, by simp [lToDList, hd, hys]⟩
termination_by xs => sizeOf xs

theorem noClo_of_lToD : ∀ v d, lToD v = some d → noClo v = true
  | .box, _, _ => rfl
  | .lit _, _, _ => rfl
  | .clo _ _, _, h => by simp [lToD] at h
  | .ctor _ xs, _, h => by
      simp only [lToD] at h
      cases hm : lToDList xs with
      | none => simp [hm] at h
      | some ys =>
          simp only [hm, Option.map_some] at h
          simpa [noClo] using noCloList_of_lToDList xs ys hm
  | .rigid _ xs, _, h => by
      simp only [lToD] at h
      cases hm : lToDList xs with
      | none => simp [hm] at h
      | some ys =>
          simp only [hm, Option.map_some] at h
          simpa [noClo] using noCloList_of_lToDList xs ys hm
termination_by v => sizeOf v

theorem noCloList_of_lToDList : ∀ xs ys, lToDList xs = some ys → noCloList xs = true
  | [], _, _ => rfl
  | x :: xs, _, h => by
      simp only [lToDList] at h
      cases hd : lToD x with
      | none => simp [hd] at h
      | some d =>
          cases hxs : lToDList xs with
          | none => simp [hd, hxs] at h
          | some zs =>
              simp only [noCloList, Bool.and_eq_true]
              exact ⟨noClo_of_lToD x d hd, noCloList_of_lToDList xs zs hxs⟩
termination_by xs => sizeOf xs
end

theorem toDEnv_noClo : ∀ {envL envD}, toDEnv envL = some envD → noCloList envL = true
  | [], _, _ => rfl
  | x :: xs, envD, he => by
      simp only [toDEnv] at he
      cases hx : lToD x with
      | none => simp [hx] at he
      | some d =>
          cases hxs : toDEnv xs with
          | none => simp [hx, hxs] at he
          | some _ =>
              simp only [hx, hxs, Option.some.injEq] at he
              subst he
              simp [noCloList, noClo_of_lToD x d hx, toDEnv_noClo hxs]

theorem evalL_noClo : ∀ (F : Nat) (env : List LVal) (l : LExpr),
    passive l = true → noCloList env = true →
    ∀ w, evalL F env l = some w → noClo w = true
  | 0, _, _, _, _, _, h => by simp [evalL] at h
  | _ + 1, env, .bvar i, _, henv, w, hw => by
      simp only [evalL] at hw
      exact noCloList_get? env i w hw henv
  | _ + 1, _, .box, _, _, w, hw => by simp [evalL] at hw; subst hw; rfl
  | _ + 1, _, .lit _, _, _, w, hw => by simp [evalL] at hw; subst hw; rfl
  | _ + 1, _, .ctor _, _, _, w, hw => by simp [evalL] at hw; subst hw; rfl
  | _ + 1, _, .rigid _, _, _, w, hw => by simp [evalL] at hw; subst hw; rfl
  | _ + 1, _, .glob _, hp, _, _, _ => by simp [passive] at hp
  | _ + 1, _, .lam _, hp, _, _, _ => by simp [passive] at hp
  | F + 1, env, .app g a, hp, henv, w, hw => by
      simp only [passive, Bool.and_eq_true] at hp
      simp only [evalL] at hw
      cases hg : evalL F env g with
      | none => simp [hg] at hw
      | some vg =>
          cases ha : evalL F env a with
          | none => simp [hg, ha] at hw
          | some va =>
              have hvg := evalL_noClo F env g hp.1 henv vg hg
              have hva := evalL_noClo F env a hp.2 henv va ha
              cases vg with
              | clo _ _ =>
                  simp [noClo] at hvg
              | box =>
                  simp only [hg, ha, Option.some.injEq] at hw
                  subst hw
                  rfl
              | lit _ =>
                  simp only [hg, ha] at hw
                  exact Option.noConfusion hw
              | ctor _ args =>
                  simp only [hg, ha, Option.some.injEq] at hw
                  subst hw
                  have hargs : noCloList args = true := by simpa [noClo] using hvg
                  simp only [noClo]
                  rw [noCloList_snoc, hargs, hva]
                  rfl
              | rigid _ args =>
                  simp only [hg, ha, Option.some.injEq] at hw
                  subst hw
                  have hargs : noCloList args = true := by simpa [noClo] using hvg
                  simp only [noClo]
                  rw [noCloList_snoc, hargs, hva]
                  rfl
  | F + 1, env, .letE v b, hp, henv, w, hw => by
      simp only [passive, Bool.and_eq_true] at hp
      simp only [evalL] at hw
      cases hv : evalL F env v with
      | none => simp [hv] at hw
      | some vv =>
          have hvv := evalL_noClo F env v hp.1 henv vv hv
          simp only [hv] at hw
          exact evalL_noClo F (vv :: env) b hp.2
            (by simp [noCloList, hvv, henv]) w hw

theorem lToD_box : lToD .box = some .box := rfl
theorem lToD_lit (k : Nat) : lToD (.lit k) = some (.lit k) := rfl
theorem lToD_ctor (r : Nat) (xs : List LVal) :
    lToD (.ctor r xs) = (lToDList xs).map (DVal.ctor r) := rfl
theorem lToD_rigid (r : Nat) (xs : List LVal) :
    lToD (.rigid r xs) = (lToDList xs).map (DVal.rigid r) := rfl

theorem runWith_zero (code : List Code) (env : List DVal) (e : DExpr) :
    runWith bindArg code 0 env e = none := by
  cases e <;> rfl

theorem run_apply_none (code : List Code) (F : Nat) (env : List DVal) (g a : DExpr)
    (h : run code F env g = none) :
    run code (F + 1) env (.apply g a) = none := by
  cases hrun : run code F env a <;> rw [run_apply_eq, h, hrun]

theorem run_apply_lit (code : List Code) (F : Nat) (env : List DVal) (k : Nat)
    (g a : DExpr) (h : run code F env g = some (.lit k)) :
    run code (F + 1) env (.apply g a) = none := by
  cases hrun : run code F env a <;> rw [run_apply_eq, h, hrun]

theorem run_apply_box (code : List Code) (F : Nat) (env : List DVal) (g a : DExpr)
    (va : DVal) (hg : run code F env g = some .box) (ha : run code F env a = some va) :
    run code (F + 1) env (.apply g a) = some .box := by
  rw [run_apply_eq, hg, ha]

theorem run_apply_ctor (code : List Code) (F : Nat) (env : List DVal) (r : Nat)
    (args : List DVal) (g a : DExpr) (av : DVal)
    (hg : run code F env g = some (.ctor r args)) (ha : run code F env a = some av) :
    run code (F + 1) env (.apply g a) = some (.ctor r (args ++ [av])) := by
  rw [run_apply_eq, hg, ha]

theorem run_apply_rigid (code : List Code) (F : Nat) (env : List DVal) (r : Nat)
    (args : List DVal) (g a : DExpr) (av : DVal)
    (hg : run code F env g = some (.rigid r args)) (ha : run code F env a = some av) :
    run code (F + 1) env (.apply g a) = some (.rigid r (args ++ [av])) := by
  rw [run_apply_eq, hg, ha]

theorem run_apply_arg_none (code : List Code) (F : Nat) (env : List DVal) (g a : DExpr)
    (h : run code F env a = none) :
    run code (F + 1) env (.apply g a) = none := by
  cases hg : run code F env g with
  | none => rw [run_apply_eq, h, hg]
  | some vg => cases vg <;> rw [run_apply_eq, h, hg]

theorem run_let_none (code : List Code) (F : Nat) (env : List DVal) (v b : DExpr)
    (h : run code F env v = none) :
    run code (F + 1) env (.letE v b) = none := by
  rw [run_let_eq, h]

theorem evalL_app_eq (F : Nat) (env : List LVal) (g a : LExpr) :
    evalL (F + 1) env (.app g a) =
      match evalL F env g, evalL F env a with
      | some (.clo env' b), some av => evalL F (av :: env') b
      | some (.ctor r args), some av => some (.ctor r (args ++ [av]))
      | some (.rigid r args), some av => some (.rigid r (args ++ [av]))
      | some .box, some _ => some .box
      | _, _ => none := by
  simpa only [evalL]

theorem evalL_app_box (F : Nat) (env : List LVal) (g a : LExpr) (va : LVal)
    (hg : evalL F env g = some .box) (ha : evalL F env a = some va) :
    evalL (F + 1) env (.app g a) = some .box := by
  rw [evalL_app_eq, hg, ha]

theorem evalL_app_lit (F : Nat) (env : List LVal) (k : Nat) (g a : LExpr) (va : LVal)
    (hg : evalL F env g = some (.lit k)) (ha : evalL F env a = some va) :
    evalL (F + 1) env (.app g a) = none := by
  rw [evalL_app_eq, hg, ha]

theorem evalL_app_ctor (F : Nat) (env : List LVal) (r : Nat) (args : List LVal)
    (g a : LExpr) (va : LVal)
    (hg : evalL F env g = some (.ctor r args)) (ha : evalL F env a = some va) :
    evalL (F + 1) env (.app g a) = some (.ctor r (args ++ [va])) := by
  rw [evalL_app_eq, hg, ha]

theorem evalL_app_rigid (F : Nat) (env : List LVal) (r : Nat) (args : List LVal)
    (g a : LExpr) (va : LVal)
    (hg : evalL F env g = some (.rigid r args)) (ha : evalL F env a = some va) :
    evalL (F + 1) env (.app g a) = some (.rigid r (args ++ [va])) := by
  rw [evalL_app_eq, hg, ha]

theorem evalL_run_passive (code : List Code) :
    ∀ (F : Nat) (ρ : Nat → Nat) (envL : List LVal) (envD : List DVal) (l : LExpr),
      passive l = true → toDEnv envL = some envD →
      (∀ i, (envL.get? i).bind lToD = envD.get? (ρ i)) →
      (evalL F envL l).bind lToD = run code F envD (renameD ρ l) := by
  intro F
  induction F with
  | zero =>
      intro ρ envL envD l _ _ _
      simp [evalL, run, runWith_zero]
  | succ F ih =>
      intro ρ envL envD l hp he hlook
      cases l with
      | bvar i =>
          simp only [evalL, renameD, run]
          exact hlook i
      | box => rfl
      | lit _ => rfl
      | ctor _ => rfl
      | rigid _ => rfl
      | glob _ => simp [passive] at hp
      | lam _ => simp [passive] at hp
      | app g a =>
          simp only [passive, Bool.and_eq_true] at hp
          have ihg := ih ρ envL envD g hp.1 he hlook
          have iha := ih ρ envL envD a hp.2 he hlook
          simp only [renameD]
          cases hg : evalL F envL g with
          | none =>
              cases ha : evalL F envL a <;>
                (simp only [hg, Option.bind_none] at ihg;
                 simp only [evalL, hg, ha, Option.bind_none];
                 exact (run_apply_none code F envD (renameD ρ g) (renameD ρ a) ihg.symm).symm)
          | some vg =>
              cases ha : evalL F envL a with
              | none =>
                  simp only [ha, Option.bind_none] at iha
                  cases vg with
                  | clo env' b =>
                      have hfalse :=
                        evalL_noClo F envL g hp.1 (toDEnv_noClo he) (.clo env' b) hg
                      simp [noClo] at hfalse
                  | box | lit _ | ctor _ _ | rigid _ _ =>
                      simp only [evalL, hg, ha, Option.bind_none]
                      exact (run_apply_arg_none code F envD (renameD ρ g) (renameD ρ a)
                        iha.symm).symm
              | some va =>
                  cases vg with
                  | clo env' b =>
                      have hfalse :=
                        evalL_noClo F envL g hp.1 (toDEnv_noClo he) (.clo env' b) hg
                      simp [noClo] at hfalse
                  | box =>
                      rw [hg] at ihg
                      rw [ha] at iha
                      change lToD .box = run code F envD (renameD ρ g) at ihg
                      rw [lToD_box] at ihg
                      have hva := evalL_noClo F envL a hp.2 (toDEnv_noClo he) va ha
                      obtain ⟨dv, hdv⟩ := lToD_of_noClo va hva
                      change lToD va = run code F envD (renameD ρ a) at iha
                      rw [hdv] at iha
                      have happ := run_apply_box code F envD (renameD ρ g) (renameD ρ a)
                        dv ihg.symm iha.symm
                      rw [evalL_app_box F envL g a va hg ha]
                      change lToD .box =
                        run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                      rw [lToD_box, happ]
                  | lit k =>
                      rw [hg] at ihg
                      change lToD (.lit k) = run code F envD (renameD ρ g) at ihg
                      rw [lToD_lit] at ihg
                      rw [evalL_app_lit F envL k g a va hg ha]
                      change (none : Option DVal) =
                        run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                      rw [run_apply_lit code F envD k (renameD ρ g) (renameD ρ a) ihg.symm]
                  | ctor r args =>
                      rw [hg] at ihg
                      change lToD (.ctor r args) = run code F envD (renameD ρ g) at ihg
                      rw [lToD_ctor] at ihg
                      rw [evalL_app_ctor F envL r args g a va hg ha]
                      change (lToDList (args ++ [va])).map (DVal.ctor r) =
                        run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                      cases hargs : lToDList args with
                      | none =>
                          rw [hargs] at ihg
                          change (none : Option DVal) = run code F envD (renameD ρ g) at ihg
                          have hsn := lToDList_snoc args va
                          cases hdv : lToD va <;> rw [hargs, hdv] at hsn <;>
                            (rw [hsn];
                             change (none : Option DVal) =
                               run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a));
                             rw [run_apply_none code F envD (renameD ρ g) (renameD ρ a)
                               ihg.symm])
                      | some ds =>
                          rw [hargs] at ihg
                          change some (.ctor r ds) = run code F envD (renameD ρ g) at ihg
                          rw [ha] at iha
                          change lToD va = run code F envD (renameD ρ a) at iha
                          have hva := evalL_noClo F envL a hp.2 (toDEnv_noClo he) va ha
                          obtain ⟨dv, hdv⟩ := lToD_of_noClo va hva
                          rw [hdv] at iha
                          have hsn := lToDList_snoc args va
                          rw [hargs, hdv] at hsn
                          have happ :=
                            run_apply_ctor code F envD r ds (renameD ρ g) (renameD ρ a) dv
                              ihg.symm iha.symm
                          rw [hsn]
                          change some (.ctor r (ds ++ [dv])) =
                            run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                          rw [happ]
                  | rigid r args =>
                      rw [hg] at ihg
                      change lToD (.rigid r args) = run code F envD (renameD ρ g) at ihg
                      rw [lToD_rigid] at ihg
                      rw [evalL_app_rigid F envL r args g a va hg ha]
                      change (lToDList (args ++ [va])).map (DVal.rigid r) =
                        run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                      cases hargs : lToDList args with
                      | none =>
                          rw [hargs] at ihg
                          change (none : Option DVal) = run code F envD (renameD ρ g) at ihg
                          have hsn := lToDList_snoc args va
                          cases hdv : lToD va <;> rw [hargs, hdv] at hsn <;>
                            (rw [hsn];
                             change (none : Option DVal) =
                               run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a));
                             rw [run_apply_none code F envD (renameD ρ g) (renameD ρ a)
                               ihg.symm])
                      | some ds =>
                          rw [hargs] at ihg
                          change some (.rigid r ds) = run code F envD (renameD ρ g) at ihg
                          rw [ha] at iha
                          change lToD va = run code F envD (renameD ρ a) at iha
                          have hva := evalL_noClo F envL a hp.2 (toDEnv_noClo he) va ha
                          obtain ⟨dv, hdv⟩ := lToD_of_noClo va hva
                          rw [hdv] at iha
                          have hsn := lToDList_snoc args va
                          rw [hargs, hdv] at hsn
                          have happ :=
                            run_apply_rigid code F envD r ds (renameD ρ g) (renameD ρ a) dv
                              ihg.symm iha.symm
                          rw [hsn]
                          change some (.rigid r (ds ++ [dv])) =
                            run code (F + 1) envD ((renameD ρ g).apply (renameD ρ a))
                          rw [happ]
      | letE v b =>
          simp only [passive, Bool.and_eq_true] at hp
          have ihv := ih ρ envL envD v hp.1 he hlook
          simp only [evalL, renameD]
          cases hv : evalL F envL v with
          | none =>
              simp only [hv, Option.bind_none] at ihv ⊢
              exact (run_let_none code F envD (renameD ρ v) (renameD (liftRen ρ) b)
                ihv.symm).symm
          | some vv =>
              have hvn := evalL_noClo F envL v hp.1 (toDEnv_noClo he) vv hv
              obtain ⟨dv, hdv⟩ := lToD_of_noClo vv hvn
              rw [hv] at ihv
              change lToD vv = run code F envD (renameD ρ v) at ihv
              rw [hdv] at ihv
              have he' : toDEnv (vv :: envL) = some (dv :: envD) := by
                simp [toDEnv, hdv, he]
              have hlook' : ∀ i, ((vv :: envL).get? i).bind lToD =
                  (dv :: envD).get? (liftRen ρ i) := by
                intro i
                cases i with
                | zero => simp [hdv, liftRen, List.get?_cons_zero]
                | succ j =>
                    simp only [List.get?_cons_succ, liftRen]
                    exact hlook j
              have ihb := ih (liftRen ρ) (vv :: envL) (dv :: envD) b hp.2 he' hlook'
              have hlet := run_let_some code F envD (renameD ρ v) (renameD (liftRen ρ) b)
                dv ihv.symm
              simpa [hv, hlet] using ihb

theorem noGlobL_of_passive : ∀ (l : LExpr), passive l = true → noGlobL l = true
  | .bvar _, _ => rfl
  | .box, _ => rfl
  | .lit _, _ => rfl
  | .ctor _, _ => rfl
  | .rigid _, _ => rfl
  | .glob _, h => by simp [passive] at h
  | .lam _, h => by simp [passive] at h
  | .app f a, h => by
      simp only [passive, Bool.and_eq_true] at h
      simp only [noGlobL, Bool.and_eq_true]
      exact ⟨noGlobL_of_passive f h.1, noGlobL_of_passive a h.2⟩
  | .letE v b, h => by
      simp only [passive, Bool.and_eq_true] at h
      simp only [noGlobL, Bool.and_eq_true]
      exact ⟨noGlobL_of_passive v h.1, noGlobL_of_passive b h.2⟩

mutual
theorem noCloD_of_lToD : ∀ (v : LVal) (d : DVal), lToD v = some d → noCloD d = true
  | .box, d, h => by
      simp only [lToD, Option.some.injEq] at h
      subst h
      rfl
  | .lit _, d, h => by
      simp only [lToD, Option.some.injEq] at h
      subst h
      rfl
  | .clo _ _, _, h => by simp [lToD] at h
  | .ctor _ xs, d, h => by
      simp only [lToD] at h
      cases hm : lToDList xs with
      | none => rw [hm] at h; exact Option.noConfusion h
      | some ys =>
          rw [hm] at h
          cases h
          exact noCloAll_of_lToDList xs ys hm
  | .rigid _ xs, d, h => by
      simp only [lToD] at h
      cases hm : lToDList xs with
      | none => rw [hm] at h; exact Option.noConfusion h
      | some ys =>
          rw [hm] at h
          cases h
          exact noCloAll_of_lToDList xs ys hm

theorem noCloAll_of_lToDList : ∀ (xs : List LVal) (ys : List DVal),
    lToDList xs = some ys → noCloAll ys = true
  | [], ys, h => by
      simp only [lToDList, Option.some.injEq] at h
      subst h
      rfl
  | x :: xs, ys, h => by
      simp only [lToDList] at h
      cases hd : lToD x with
      | none => simp [hd] at h
      | some d =>
          cases hxs : lToDList xs with
          | none => simp [hd, hxs] at h
          | some zs =>
              simp only [hd, hxs, Option.some.injEq] at h
              subst h
              simp only [noCloAll, Bool.and_eq_true]
              exact ⟨noCloD_of_lToD x d hd, noCloAll_of_lToDList xs zs hxs⟩
end

theorem evalL_run_passive_nil (F : Nat) (l : LExpr) (hp : passive l = true) :
    (evalL F [] l).bind lToD = run (defunc l).2 F [] (defunc l).1 := by
  rw [defunc_passive l hp]
  exact evalL_run_passive [] F id [] [] l hp rfl (fun i => by cases i <;> rfl)

/-! ### Higher-order closure simulation (`ValRel`, `evalL_run_sim`, `evalL_run_defunc`) -/

def CodeExt (c1 c2 : List Code) : Prop :=
  ∃ s, c2 = c1 ++ s

theorem codeExt_refl (c : List Code) : CodeExt c c :=
  ⟨[], (List.append_nil c).symm⟩

theorem codeExt_trans {c1 c2 c3 : List Code}
    (h1 : CodeExt c1 c2) (h2 : CodeExt c2 c3) : CodeExt c1 c3 := by
  rcases h1 with ⟨s1, rfl⟩
  rcases h2 with ⟨s2, rfl⟩
  exact ⟨s1 ++ s2, List.append_assoc c1 s1 s2⟩

theorem codeExt_append (c s : List Code) : CodeExt c (c ++ s) :=
  ⟨s, rfl⟩

theorem codeExt_convWith (ρ : Nat → Nat) (code : List Code) (l : LExpr) :
    CodeExt code (convWith capRen ρ code l).2 :=
  convWith_suffix capRen ρ code l

theorem mem_of_contains :
    ∀ (xs : List Nat) (x : Nat), xs.contains x = true → x ∈ xs
  | [], _, h => Bool.noConfusion h
  | y :: ys, x, h => by
      simp only [List.contains, List.elem] at h
      cases hbeq : (x == y) with
      | true =>
          have hxy : x = y := eq_of_beq hbeq
          subst hxy
          exact List.mem_cons_self x ys
      | false =>
          rw [hbeq] at h
          exact List.mem_cons_of_mem y (mem_of_contains ys x h)

theorem mem_addUniq_self (xs : List Nat) (x : Nat) :
    x ∈ addUniq xs x := by
  unfold addUniq
  cases hc : xs.contains x with
  | true => exact mem_of_contains xs x hc
  | false => exact List.mem_append_right xs (List.mem_singleton_self x)

theorem mem_addUniq_of_mem {xs : List Nat} {y : Nat} (x : Nat) (h : y ∈ xs) :
    y ∈ addUniq xs x := by
  unfold addUniq
  cases xs.contains x with
  | true => exact h
  | false => exact List.mem_append_left [x] h

theorem mem_unionL_left :
    ∀ (ys xs : List Nat) {z : Nat}, z ∈ xs → z ∈ unionL xs ys
  | [], _, _, h => h
  | y :: ys, xs, _, h =>
      mem_unionL_left ys (addUniq xs y) (mem_addUniq_of_mem y h)

theorem mem_unionL_right :
    ∀ (ys xs : List Nat) {z : Nat}, z ∈ ys → z ∈ unionL xs ys
  | [], _, _, h => nomatch h
  | y :: ys, xs, _, h => by
      cases h with
      | head =>
          exact mem_unionL_left ys (addUniq xs y) (mem_addUniq_self xs y)
      | tail _ hmem =>
          exact mem_unionL_right ys (addUniq xs y) hmem

theorem mem_freeVars_succ :
    ∀ (l : LExpr) (c j : Nat),
      j + 1 ∈ freeVars c l → j ∈ freeVars (c + 1) l
  | .bvar i, c, j, h => by
      simp only [freeVars] at h ⊢
      by_cases hle : c ≤ i
      · simp only [hle, ite_true, List.mem_singleton] at h
        have hle1 : c + 1 ≤ i := by omega
        have hsub : i - (c + 1) = j := by omega
        simp only [hle1, ite_true, hsub, List.mem_singleton]
      · simp only [hle, ite_false] at h
        nomatch h
  | .box, _, _, h => nomatch h
  | .lit _, _, _, h => nomatch h
  | .ctor _, _, _, h => nomatch h
  | .rigid _, _, _, h => nomatch h
  | .glob _, _, _, h => nomatch h
  | .app f a, c, j, h => by
      simp only [freeVars] at h ⊢
      rcases mem_unionL (freeVars c a) (freeVars c f) h with hf | ha
      · exact mem_unionL_left (freeVars (c + 1) a) (freeVars (c + 1) f)
          (mem_freeVars_succ f c j hf)
      · exact mem_unionL_right (freeVars (c + 1) a) (freeVars (c + 1) f)
          (mem_freeVars_succ a c j ha)
  | .lam b, c, j, h => by
      simp only [freeVars] at h ⊢
      exact mem_freeVars_succ b (c + 1) j h
  | .letE v b, c, j, h => by
      simp only [freeVars] at h ⊢
      rcases mem_unionL (freeVars (c + 1) b) (freeVars c v) h with hv | hb
      · exact mem_unionL_left (freeVars (c + 2) b) (freeVars (c + 1) v)
          (mem_freeVars_succ v c j hv)
      · exact mem_unionL_right (freeVars (c + 2) b) (freeVars (c + 1) v)
          (mem_freeVars_succ b (c + 1) j hb)

mutual
inductive ValRel (code : List Code) : LVal → DVal → Prop
  | box : ValRel code .box .box
  | lit (k : Nat) : ValRel code (.lit k) (.lit k)
  | ctor (r : Nat) (xs : List LVal) (ys : List DVal) :
      ValRelList code xs ys → ValRel code (.ctor r xs) (.ctor r ys)
  | rigid (r : Nat) (xs : List LVal) (ys : List DVal) :
      ValRelList code xs ys → ValRel code (.rigid r xs) (.rigid r ys)
  | clo (envL capsL : List LVal) (b : LExpr) (code0 : List Code) (capsD : List DVal) :
      noGlobL b = true →
      (freeVars 1 b).mapM (fun j => envL.get? j) = some capsL →
      CodeExt ((convWith capRen (capRen (freeVars 1 b)) code0 b).2 ++
        [{ ncap := (freeVars 1 b).length,
           body := (convWith capRen (capRen (freeVars 1 b)) code0 b).1 }]) code →
      ValRelList code capsL capsD →
      ValRel code (.clo envL b)
        (.clo (convWith capRen (capRen (freeVars 1 b)) code0 b).2.length capsD)

inductive ValRelList (code : List Code) : List LVal → List DVal → Prop
  | nil : ValRelList code [] []
  | cons (x : LVal) (y : DVal) (xs : List LVal) (ys : List DVal) :
      ValRel code x y → ValRelList code xs ys → ValRelList code (x :: xs) (y :: ys)
end

theorem valRelList_snoc {code : List Code} :
    ∀ (xs : List LVal) (ys : List DVal) (x : LVal) (y : DVal),
      ValRelList code xs ys → ValRel code x y →
      ValRelList code (xs ++ [x]) (ys ++ [y])
  | _, _, x, y, .nil, hxy => .cons x y [] [] hxy .nil
  | _, _, x, y, .cons a b as bs hab has, hxy =>
      .cons a b (as ++ [x]) (bs ++ [y]) hab (valRelList_snoc as bs x y has hxy)

mutual
theorem lToD_eq_of_valRel (code : List Code) :
    ∀ (vL : LVal) (vD : DVal) (d : DVal),
      ValRel code vL vD → lToD vL = some d → vD = d
  | .box, _, d, .box, hd => Option.some.inj hd
  | .lit _, _, d, .lit _, hd => Option.some.inj hd
  | .clo _ _, _, _, .clo _ _ _ _ _ _ _ _ _, hd => Option.noConfusion hd
  | .ctor r xs, _, d, .ctor _ _ ys hrel, hd => by
      simp only [lToD] at hd
      cases hm : lToDList xs with
      | none => rw [hm] at hd; exact Option.noConfusion hd
      | some ds =>
          rw [hm, option_map_some] at hd
          have hd' : d = .ctor r ds := (Option.some.inj hd).symm
          subst hd'
          exact congrArg (DVal.ctor r) (lToDList_eq_of_valRelList code xs ys ds hrel hm)
  | .rigid r xs, _, d, .rigid _ _ ys hrel, hd => by
      simp only [lToD] at hd
      cases hm : lToDList xs with
      | none => rw [hm] at hd; exact Option.noConfusion hd
      | some ds =>
          rw [hm, option_map_some] at hd
          have hd' : d = .rigid r ds := (Option.some.inj hd).symm
          subst hd'
          exact congrArg (DVal.rigid r) (lToDList_eq_of_valRelList code xs ys ds hrel hm)

theorem lToDList_eq_of_valRelList (code : List Code) :
    ∀ (xs : List LVal) (ys ds : List DVal),
      ValRelList code xs ys → lToDList xs = some ds → ys = ds
  | [], _, ds, .nil, hd => Option.some.inj hd
  | x :: xs, _, ds, .cons _ y _ ys hxy hxs, hd => by
      simp only [lToDList] at hd
      cases hx : lToD x with
      | none => rw [hx] at hd; exact Option.noConfusion hd
      | some dx =>
          cases hrest : lToDList xs with
          | none => rw [hx, hrest] at hd; exact Option.noConfusion hd
          | some dxs =>
              rw [hx, hrest] at hd
              have hds : ds = dx :: dxs := (Option.some.inj hd).symm
              subst hds
              rw [lToD_eq_of_valRel code x y dx hxy hx,
                  lToDList_eq_of_valRelList code xs ys dxs hxs hrest]
end

def EnvRel (code : List Code) (ρ : Nat → Nat) (envL : List LVal) (envD : List DVal)
    (l : LExpr) : Prop :=
  ∀ i ∈ freeVars 0 l,
    match envL.get? i with
    | none => envD.get? (ρ i) = none
    | some v => ∃ d, envD.get? (ρ i) = some d ∧ ValRel code v d

theorem mapM_envRel_of_mapM (code : List Code) (ρ : Nat → Nat)
    (envL : List LVal) (envD : List DVal) :
    ∀ (xs : List Nat) (capsL : List LVal),
      xs.mapM (fun j => envL.get? j) = some capsL →
      (∀ j ∈ xs,
        match envL.get? j with
        | none => envD.get? (ρ j) = none
        | some v => ∃ d, envD.get? (ρ j) = some d ∧ ValRel code v d) →
      ∃ capsD,
        (xs.map ρ).mapM (fun k => envD.get? k) = some capsD ∧
        ValRelList code capsL capsD
  | [], capsL, hL, _ => by
      simp only [List.mapM_nil, Option.pure_def] at hL
      have hc : capsL = [] := (Option.some.inj hL).symm
      subst hc
      exact ⟨[], rfl, .nil⟩
  | j :: xs, capsL, hL, hrel => by
      obtain ⟨v, vs, hv, hvs, hcaps⟩ := list_mapM_cons_inv hL
      subst hcaps
      have hj := hrel j (List.mem_cons_self j xs)
      rw [hv] at hj
      obtain ⟨d, hd, hvd⟩ := hj
      obtain ⟨ds, hds, hrel_ds⟩ :=
        mapM_envRel_of_mapM code ρ envL envD xs vs hvs
          (fun x hx => hrel x (List.mem_cons_of_mem j hx))
      refine ⟨d :: ds, ?_, .cons v d vs ds hvd hrel_ds⟩
      simp only [List.map_cons, List.mapM_cons, hd, hds, Option.bind]
      rfl

theorem envRel_of_mapM_idxOf (code : List Code) (envL : List LVal) :
    ∀ (xs : List Nat) (capsL : List LVal) (capsD : List DVal),
      xs.mapM (fun j => envL.get? j) = some capsL →
      ValRelList code capsL capsD →
      ∀ j ∈ xs,
        ∃ k v d,
          idxOf j xs = some k ∧
          envL.get? j = some v ∧
          capsD.get? k = some d ∧
          ValRel code v d
  | [], _, _, _, _, _, hj => nomatch hj
  | x :: xs, _, _, hL, hrel, j, hj => by
      obtain ⟨vx, vxs, hvx, hvxs, hcaps⟩ := list_mapM_cons_inv hL
      subst hcaps
      cases hrel with
      | cons _ dx _ dxs hvd hrel_xs =>
          by_cases hjx : j = x
          · subst hjx
            exact ⟨0, vx, dx, by simp [idxOf], hvx, rfl, hvd⟩
          · have hj' : j ∈ xs := by
              cases hj with
              | head => exact absurd rfl hjx
              | tail _ hmem => exact hmem
            obtain ⟨k, v, d, hidx, hv, hd, hrel_vd⟩ :=
              envRel_of_mapM_idxOf code envL xs vxs dxs hvxs hrel_xs j hj'
            refine ⟨k + 1, v, d, ?_, hv, hd, hrel_vd⟩
            simp [idxOf, if_neg hjx, hidx, option_map_some]

theorem evalL_run_sim (code : List Code) :
    ∀ (F : Nat) (ρ : Nat → Nat) (envL : List LVal) (envD : List DVal)
      (code0 : List Code) (l : LExpr) (vL : LVal),
      noGlobL l = true →
      CodeExt (convWith capRen ρ code0 l).2 code →
      EnvRel code ρ envL envD l →
      evalL F envL l = some vL →
      ∃ vD,
        run code F envD (convWith capRen ρ code0 l).1 = some vD ∧
        ValRel code vL vD := by
  intro F
  induction F with
  | zero =>
      intro _ _ _ _ _ _ _ _ _ hev
      exact Option.noConfusion hev
  | succ F ih =>
      intro ρ envL envD code0 l vL hng hext henv hev
      cases l with
      | bvar i =>
          simp only [evalL] at hev
          have hi : i ∈ freeVars 0 (.bvar i) := by
            simp [freeVars]
          have hlook := henv i hi
          rw [hev] at hlook
          obtain ⟨d, hd, hrel⟩ := hlook
          refine ⟨d, ?_, hrel⟩
          simp only [convWith]
          rw [run_var_eq]
          exact hd
      | box =>
          simp only [evalL] at hev
          have hv : vL = .box := (Option.some.inj hev).symm
          subst hv
          refine ⟨.box, ?_, .box⟩
          simp only [convWith]
          exact run_box_eq code F envD
      | lit k =>
          simp only [evalL] at hev
          have hv : vL = .lit k := (Option.some.inj hev).symm
          subst hv
          refine ⟨.lit k, ?_, .lit k⟩
          simp only [convWith]
          exact run_lit_eq code F envD k
      | ctor r =>
          simp only [evalL] at hev
          have hv : vL = .ctor r [] := (Option.some.inj hev).symm
          subst hv
          refine ⟨.ctor r [], ?_, .ctor r [] [] .nil⟩
          simp only [convWith]
          exact run_ctor_eq code F envD r
      | rigid r =>
          simp only [evalL] at hev
          have hv : vL = .rigid r [] := (Option.some.inj hev).symm
          subst hv
          refine ⟨.rigid r [], ?_, .rigid r [] [] .nil⟩
          simp only [convWith]
          exact run_rigid_eq code F envD r
      | glob _ =>
          exact Bool.noConfusion hng
      | lam b =>
          simp only [noGlobL] at hng
          simp only [evalL] at hev
          cases hmapL : (freeVars 1 b).mapM (fun i => envL.get? i) with
          | none =>
              rw [hmapL] at hev
              exact Option.noConfusion hev
          | some capsL =>
              rw [hmapL] at hev
              have hv : vL = .clo envL b := (Option.some.inj hev).symm
              subst hv
              obtain ⟨capsD, hmapD, hrelCaps⟩ :=
                mapM_envRel_of_mapM code ρ envL envD (freeVars 1 b) capsL hmapL henv
              let fs := freeVars 1 b
              let p := convWith capRen (capRen fs) code0 b
              refine ⟨.clo p.2.length capsD, ?_,
                .clo envL capsL b code0 capsD hng hmapL hext hrelCaps⟩
              simp only [convWith]
              rw [run_clo_eq, hmapD, option_map_some]
      | app g a =>
          simp only [noGlobL, Bool.and_eq_true] at hng
          let p := convWith capRen ρ code0 g
          let q := convWith capRen ρ p.2 a
          have hext_p : CodeExt p.2 code :=
            codeExt_trans (codeExt_convWith ρ p.2 a) hext
          have hext_q : CodeExt q.2 code := hext
          have henv_g : EnvRel code ρ envL envD g :=
            fun i hi => henv i (mem_unionL_left (freeVars 0 a) (freeVars 0 g) hi)
          have henv_a : EnvRel code ρ envL envD a :=
            fun i hi => henv i (mem_unionL_right (freeVars 0 a) (freeVars 0 g) hi)
          rw [evalL_app_eq] at hev
          cases hg : evalL F envL g with
          | none =>
              rw [hg] at hev
              exact Option.noConfusion hev
          | some vg =>
              rw [hg] at hev
              cases ha : evalL F envL a with
              | none =>
                  rw [ha] at hev
                  cases vg <;> exact Option.noConfusion hev
              | some va =>
                  rw [ha] at hev
                  obtain ⟨dg, hrun_g, hrel_g⟩ :=
                    ih ρ envL envD code0 g vg hng.1 hext_p henv_g hg
                  obtain ⟨da, hrun_a, hrel_a⟩ :=
                    ih ρ envL envD p.2 a va hng.2 hext_q henv_a ha
                  cases hrel_g with
                  | box =>
                      have hv : vL = .box := (Option.some.inj hev).symm
                      subst hv
                      refine ⟨.box, ?_, .box⟩
                      simp only [convWith]
                      exact run_apply_box code F envD p.1 q.1 da hrun_g hrun_a
                  | lit _ =>
                      exact Option.noConfusion hev
                  | ctor r xs ys hrel_args =>
                      have hv : vL = .ctor r (xs ++ [va]) := (Option.some.inj hev).symm
                      subst hv
                      refine ⟨.ctor r (ys ++ [da]), ?_,
                        .ctor r (xs ++ [va]) (ys ++ [da])
                          (valRelList_snoc xs ys va da hrel_args hrel_a)⟩
                      simp only [convWith]
                      exact run_apply_ctor code F envD r ys p.1 q.1 da hrun_g hrun_a
                  | rigid r xs ys hrel_args =>
                      have hv : vL = .rigid r (xs ++ [va]) := (Option.some.inj hev).symm
                      subst hv
                      refine ⟨.rigid r (ys ++ [da]), ?_,
                        .rigid r (xs ++ [va]) (ys ++ [da])
                          (valRelList_snoc xs ys va da hrel_args hrel_a)⟩
                      simp only [convWith]
                      exact run_apply_rigid code F envD r ys p.1 q.1 da hrun_g hrun_a
                  | clo envL' capsL b code0' capsD hng_b hmapL hext_b hrelCaps =>
                      let fs := freeVars 1 b
                      let pb := convWith capRen (capRen fs) code0' b
                      let entry : Code := { ncap := fs.length, body := pb.1 }
                      have hext_pb : CodeExt pb.2 code :=
                        codeExt_trans (codeExt_append pb.2 [entry]) hext_b
                      have hget : code.get? pb.2.length = some entry := by
                        rcases hext_b with ⟨s, hcode_eq⟩
                        rw [hcode_eq]
                        exact list_get?_append_of_some (pb.2 ++ [entry]) s pb.2.length entry
                          (list_get?_append_last pb.2 entry)
                      have henv_b : EnvRel code (capRen fs) (va :: envL') (da :: capsD) b := by
                        intro i hi
                        cases i with
                        | zero =>
                            simp only [List.get?_cons_zero, capRen]
                            exact ⟨da, rfl, hrel_a⟩
                        | succ j =>
                            have hj : j ∈ fs := mem_freeVars_succ b 0 j hi
                            obtain ⟨k, vj, dj, hidx, hvj, hdj, hrel_j⟩ :=
                              envRel_of_mapM_idxOf code envL' fs capsL capsD hmapL hrelCaps j hj
                            simp only [List.get?_cons_succ, hvj, capRen, hidx, Option.getD_some]
                            exact ⟨dj, hdj, hrel_j⟩
                      obtain ⟨db, hrun_b, hrel_b⟩ :=
                        ih (capRen fs) (va :: envL') (da :: capsD) code0' b vL
                          hng_b hext_pb henv_b hev
                      refine ⟨db, ?_, hrel_b⟩
                      simp only [convWith]
                      rw [run_apply_eq, hrun_g, hrun_a]
                      change (match code.get? pb.2.length with
                        | some c => run code F (bindArg da capsD) c.body
                        | none => none) = some db
                      rw [hget]
                      exact hrun_b
      | letE v b =>
          simp only [noGlobL, Bool.and_eq_true] at hng
          let p := convWith capRen ρ code0 v
          let q := convWith capRen (liftRen ρ) p.2 b
          have hext_p : CodeExt p.2 code :=
            codeExt_trans (convWith_suffix capRen (liftRen ρ) p.2 b) hext
          have hext_q : CodeExt q.2 code := hext
          have henv_v : EnvRel code ρ envL envD v :=
            fun i hi => henv i (mem_unionL_left (freeVars 1 b) (freeVars 0 v) hi)
          simp only [evalL] at hev
          cases hv : evalL F envL v with
          | none =>
              rw [hv] at hev
              exact Option.noConfusion hev
          | some vv =>
              rw [hv] at hev
              obtain ⟨dv, hrun_v, hrel_v⟩ :=
                ih ρ envL envD code0 v vv hng.1 hext_p henv_v hv
              have henv_b : EnvRel code (liftRen ρ) (vv :: envL) (dv :: envD) b := by
                intro i hi
                cases i with
                | zero =>
                    simp only [List.get?_cons_zero, liftRen]
                    exact ⟨dv, rfl, hrel_v⟩
                | succ j =>
                    have hj : j ∈ freeVars 0 (.letE v b) :=
                      mem_unionL_right (freeVars 1 b) (freeVars 0 v)
                        (mem_freeVars_succ b 0 j hi)
                    simp only [List.get?_cons_succ, liftRen]
                    exact henv j hj
              obtain ⟨db, hrun_b, hrel_b⟩ :=
                ih (liftRen ρ) (vv :: envL) (dv :: envD) p.2 b vL
                  hng.2 hext_q henv_b hev
              refine ⟨db, ?_, hrel_b⟩
              simp only [convWith]
              rw [run_let_some code F envD p.1 q.1 dv hrun_v]
              exact hrun_b

theorem evalL_run_defunc (F : Nat) (l : LExpr) (vL : LVal) (dv : DVal)
    (hng : noGlobL l = true)
    (hev : evalL F [] l = some vL)
    (hd : lToD vL = some dv) :
    run (defunc l).2 F [] (defunc l).1 = some dv := by
  have henv : EnvRel (defunc l).2 id [] [] l := fun _ _ => rfl
  obtain ⟨vD, hrun, hrel⟩ :=
    evalL_run_sim (defunc l).2 F id [] [] [] l vL hng
      (codeExt_refl (defunc l).2) henv hev
  rw [lToD_eq_of_valRel (defunc l).2 vL vD dv hrel hd] at hrun
  exact hrun

/-! ### Canonical data value Stage-1 passive erasure and `NormErasable` -/

def noLamConstBody (E : ResolvedEnv) : Expr Nat → Bool
  | .bvar _ => true
  | .sort _ => true
  | .lit _ => true
  | .pi _ _ => true
  | .lam _ _ => false
  | .letE _ _ _ => false
  | .const r ls => (transparentBody E r ls).isNone
  | .app f a => noLamConstBody E f && noLamConstBody E a

theorem passive_of_erase_noLamConstBody (E : ResolvedEnv) (n : Nat) :
    ∀ (F : Nat) (Γ : LCtx) (e : Expr Nat) (l : LExpr),
      noLamConstBody E e = true →
      erase E n F Γ e = some l →
      passive l = true
  | 0, _, _, _, _, h => Option.noConfusion h
  | _ + 1, _, .sort _, _, _, h => by simp only [erase, eraseWith] at h; cases h; rfl
  | _ + 1, _, .pi _ _, _, _, h => by simp only [erase, eraseWith] at h; cases h; rfl
  | _ + 1, _, .lit _, _, _, h => by simp only [erase, eraseWith] at h; cases h; rfl
  | _ + 1, Γ, .bvar i, _, _, h => by
      simp only [erase, eraseWith] at h
      split at h <;> (cases h; rfl)
  | _ + 1, _, .lam _ _, _, hnl, _ => Bool.noConfusion hnl
  | _ + 1, _, .letE _ _ _, _, hnl, _ => Bool.noConfusion hnl
  | _ + 1, _, .const r ls, _, hnl, h => by
      simp only [noLamConstBody, Option.isNone_iff_eq_none] at hnl
      simp only [erase, eraseWith] at h
      split at h
      · cases h; rfl
      · simp only [noGlobals, hnl] at h
        split at h <;> (cases h; rfl)
  | F + 1, Γ, .app g a, _, hnl, h => by
      simp only [noLamConstBody, Bool.and_eq_true] at hnl
      simp only [erase, eraseWith] at h
      split at h
      · cases h; rfl
      · cases hg : eraseWith (irrelevant E n) noGlobals E F Γ g with
        | none => rw [hg] at h; exact Option.noConfusion h
        | some lg =>
            cases ha : eraseWith (irrelevant E n) noGlobals E F Γ a with
            | none => rw [hg, ha] at h; exact Option.noConfusion h
            | some la =>
                rw [hg, ha] at h
                cases h
                simp only [passive, Bool.and_eq_true]
                exact ⟨passive_of_erase_noLamConstBody E n F Γ g lg hnl.1 hg,
                  passive_of_erase_noLamConstBody E n F Γ a la hnl.2 ha⟩

theorem noLamConstBody_foldApps (E : ResolvedEnv) :
    ∀ (args : List (Expr Nat)) (f : Expr Nat),
      noLamConstBody E f = true →
      (∀ a ∈ args, noLamConstBody E a = true) →
      noLamConstBody E (foldApps f args) = true
  | [], _, hf, _ => hf
  | a :: as, f, hf, hargs =>
      noLamConstBody_foldApps E as (.app f a)
        (by simp only [noLamConstBody, hf, hargs a (List.mem_cons_self a as), Bool.and_self])
        (fun x hx => hargs x (List.mem_cons_of_mem a hx))

theorem list_mapM_mem_some {α β : Type} {f : α → Option β} :
    ∀ {xs : List α} {ys : List β},
      xs.mapM f = some ys →
      ∀ x ∈ xs, ∃ y, f x = some y
  | [], _, _, _, hx => nomatch hx
  | a :: as, _, h, x, hx => by
      obtain ⟨y, _, ha, has, _⟩ := list_mapM_cons_inv h
      cases hx with
      | head => exact ⟨y, ha⟩
      | tail _ hmem => exact list_mapM_mem_some has x hmem

theorem noLamConstBody_of_scmValOf (E : ResolvedEnv) :
    ∀ (fv : Nat) (v : Expr Nat) (w : Val),
      scmValOf E fv v = some w →
      noLamConstBody E v = true
  | 0, _, _, hs => Option.noConfusion hs
  | m + 1, v, _, hs => by
      rcases lit_or_ne_lit v with ⟨k, rfl⟩ | hne
      · rfl
      · obtain ⟨c, lsc, args, hv⟩ := scmValOf_non_lit_spine hne hs
        subst hv
        obtain ⟨m', ws, hm', hctor, hscm, _⟩ := scmValOf_foldApps_const_inv hs
        have hmm : m' = m := Nat.succ.inj hm'.symm
        rw [hmm] at hscm
        have hnone : transparentBody E c lsc = none :=
          transparentBody_eq_none_of_isCtor E c lsc hctor
        have hc : noLamConstBody E (.const c lsc) = true := by
          simp only [noLamConstBody, hnone, Option.isNone_none]
        refine noLamConstBody_foldApps E args (.const c lsc) hc ?_
        intro a ha
        obtain ⟨wa, hwa⟩ := list_mapM_mem_some hscm a ha
        exact noLamConstBody_of_scmValOf E m a wa hwa

theorem passive_erase_of_scmValOf {E : ResolvedEnv} {n fv F : Nat}
    {v : Expr Nat} {w : Val} {lv : LExpr}
    (hs : scmValOf E fv v = some w)
    (he : erase E n F [] v = some lv) :
    passive lv = true :=
  passive_of_erase_noLamConstBody E n F [] v lv
    (noLamConstBody_of_scmValOf E fv v w hs) he

/-! ### Stage-1 reduction-trace lifting (`whnfFuel_stepEvalL`, `stepEvalL_foldApps`,
    `norm_stepEvalL`, `good_of_envWf`) -/

theorem stepEvalL_refl (E : ResolvedEnv) (n : Nat) (e : Expr Nat) :
    StepEvalL E n e e :=
  fun F' le' _ he' hev' _ => ⟨F', le', he', hev'⟩

theorem stepEvalL_trans {E : ResolvedEnv} {n : Nat} {e1 e2 e3 : Expr Nat}
    (h12 : StepEvalL E n e1 e2) (h23 : StepEvalL E n e2 e3) :
    StepEvalL E n e1 e3 := by
  intro F3 le3 vL he3 hev3 hnc
  obtain ⟨F2, le2, he2, hev2⟩ := h23 F3 le3 vL he3 hev3 hnc
  exact h12 F2 le2 vL he2 hev2 hnc

theorem stepEvalL_delta_spine (E : ResolvedEnv) (n r : Nat) (ls : List Level)
    (b : Expr Nat) (args : List (Expr Nat)) {T : Expr Nat}
    (hb : transparentBody E r ls = some b)
    (hTy : ∀ T0, inferT E n [] (.const r ls) = some T0 → inferT E n [] b = some T0)
    (hi : inferT E n [] (foldApps (.const r ls) args) = some T)
    (hirr : irrelevant E n [] (foldApps (.const r ls) args) = false) :
    StepEvalL E n (foldApps (.const r ls) args) (foldApps b args) := by
  intro F' le' vL he' hev' _
  exact ⟨F' + 1, le',
    erase_foldApps_const_delta E n r F' ls b args hb hTy hi hirr he',
    evalL_mono F' (F' + 1) [] le' vL (Nat.le_succ F') hev'⟩

theorem whnfFuel_preserves_inferT {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E) :
    ∀ (fuel : Nat) (e w T : Expr Nat),
      inferT E n [] e = some T →
      whnfFuel E fuel e = some w →
      WhnfErasable E n fuel e →
      inferT E n [] w = some T
  | 0, _, _, _, _, hw, _ => Option.noConfusion hw
  | f + 1, e, w, T, hi, hw, hwhnf => by
      unfold whnfFuel at hw
      unfold WhnfErasable at hwhnf
      generalize hsp : appsSpine e = sp at hw hwhnf
      have hfold : foldApps sp.1 sp.2 = e := by
        rw [← hsp]
        exact foldApps_appsSpine e
      rcases sp with ⟨hd, args⟩
      cases hd with
      | lam A b =>
          cases args with
          | nil =>
              have hw' : w = e := (Option.some.inj hw).symm
              rwa [hw']
          | cons a as =>
              simp only at hw hwhnf
              have hi' : inferT E n [] (foldApps (instantiate0 a b) as) = some T :=
                inferT_beta_spine_some hE (hfold.symm ▸ hi)
              exact whnfFuel_preserves_inferT hE f
                (foldApps (instantiate0 a b) as) w T hi' hw hwhnf.2
      | letE A v b =>
          simp only at hw hwhnf
          have hi' : inferT E n [] (foldApps (instantiate0 v b) args) = some T :=
            inferT_zeta_spine_some hE (hfold.symm ▸ hi)
          exact whnfFuel_preserves_inferT hE f
            (foldApps (instantiate0 v b) args) w T hi' hw hwhnf.2
      | const r ls =>
          simp only at hw hwhnf
          cases htb : transparentBody E r ls with
          | none =>
              rw [htb] at hw
              have hw' : w = e := (Option.some.inj hw).symm
              rwa [hw']
          | some body =>
              rw [htb] at hw hwhnf
              have hi' : inferT E n [] (foldApps body args) = some T :=
                inferT_delta_spine_some hwhnf.1 (hfold.symm ▸ hi)
              exact whnfFuel_preserves_inferT hE f
                (foldApps body args) w T hi' hw hwhnf.2
      | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
          have hw' : w = e := (Option.some.inj hw).symm
          rwa [hw']

theorem whnfFuel_stepEvalL {E : ResolvedEnv} {n : Nat} (hE : EnvClosed E) :
    ∀ (fuel : Nat) (e w T : Expr Nat),
      inferT E n [] e = some T →
      irrelevant E n [] e = false →
      whnfFuel E fuel e = some w →
      WhnfErasable E n fuel e →
      StepEvalL E n e w
  | 0, _, _, _, _, _, hw, _ => Option.noConfusion hw
  | f + 1, e, w, T, hi, hirr, hw, hwhnf => by
      unfold whnfFuel at hw
      unfold WhnfErasable at hwhnf
      generalize hsp : appsSpine e = sp at hw hwhnf
      have hfold : foldApps sp.1 sp.2 = e := by
        rw [← hsp]
        exact foldApps_appsSpine e
      rcases sp with ⟨hd, args⟩
      cases hd with
      | lam A b =>
          cases args with
          | nil =>
              have hw' : w = e := (Option.some.inj hw).symm
              rw [hw']
              exact stepEvalL_refl E n e
          | cons a as =>
              simp only at hw hwhnf
              have hi' : inferT E n [] (foldApps (instantiate0 a b) as) = some T :=
                inferT_beta_spine_some hE (hfold.symm ▸ hi)
              have hirr' : irrelevant E n [] (foldApps (instantiate0 a b) as) = false :=
                irrelevant_false_of_same_type hi' hi hirr
              exact stepEvalL_trans hwhnf.1
                (whnfFuel_stepEvalL hE f (foldApps (instantiate0 a b) as) w T
                  hi' hirr' hw hwhnf.2)
      | letE A v b =>
          simp only at hw hwhnf
          have hi' : inferT E n [] (foldApps (instantiate0 v b) args) = some T :=
            inferT_zeta_spine_some hE (hfold.symm ▸ hi)
          have hirr' : irrelevant E n [] (foldApps (instantiate0 v b) args) = false :=
            irrelevant_false_of_same_type hi' hi hirr
          exact stepEvalL_trans hwhnf.1
            (whnfFuel_stepEvalL hE f (foldApps (instantiate0 v b) args) w T
              hi' hirr' hw hwhnf.2)
      | const r ls =>
          simp only at hw hwhnf
          cases htb : transparentBody E r ls with
          | none =>
              rw [htb] at hw
              have hw' : w = e := (Option.some.inj hw).symm
              rw [hw']
              exact stepEvalL_refl E n e
          | some body =>
              rw [htb] at hw hwhnf
              have hi' : inferT E n [] (foldApps body args) = some T :=
                inferT_delta_spine_some hwhnf.1 (hfold.symm ▸ hi)
              have hirr' : irrelevant E n [] (foldApps body args) = false :=
                irrelevant_false_of_same_type hi' hi hirr
              have hstep1 : StepEvalL E n e (foldApps body args) := by
                rw [← hfold]
                exact stepEvalL_delta_spine E n r ls body args htb hwhnf.1
                  (hfold.symm ▸ hi) (hfold.symm ▸ hirr)
              exact stepEvalL_trans hstep1
                (whnfFuel_stepEvalL hE f (foldApps body args) w T
                  hi' hirr' hw hwhnf.2)
      | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
          have hw' : w = e := (Option.some.inj hw).symm
          rw [hw']
          exact stepEvalL_refl E n e

theorem appsSpine_fst_appsSpine :
    ∀ (e : Expr Nat), appsSpine (appsSpine e).1 = ((appsSpine e).1, [])
  | .bvar _ | .sort _ | .const _ _ | .lam _ _ | .pi _ _ | .letE _ _ _ | .lit _ => rfl
  | .app g _ => appsSpine_fst_appsSpine g

theorem appsSpine_foldApps_fst (w : Expr Nat) (as : List (Expr Nat)) :
    appsSpine (foldApps (appsSpine w).1 as) = ((appsSpine w).1, as) := by
  rw [appsSpine_foldApps, appsSpine_fst_appsSpine w, List.nil_append]

theorem evalL_isCtorSpineL_shape (c : Nat) :
    ∀ (lg : LExpr) (F : Nat) (env : List LVal) (vL : LVal),
      isCtorSpineL c lg = true →
      evalL F env lg = some vL →
      ∃ vs, vL = .ctor c vs
  | .bvar _, _, _, _, h, _ => Bool.noConfusion h
  | .box, _, _, _, h, _ => Bool.noConfusion h
  | .lit _, _, _, _, h, _ => Bool.noConfusion h
  | .rigid _, _, _, _, h, _ => Bool.noConfusion h
  | .lam _, _, _, _, h, _ => Bool.noConfusion h
  | .letE _ _, _, _, _, h, _ => Bool.noConfusion h
  | .glob _, _, _, _, h, _ => Bool.noConfusion h
  | .ctor _, 0, _, _, _, hev => Option.noConfusion hev
  | .ctor r, _ + 1, _, vL, h, hev => by
      have hrc : r = c := of_decide_eq_true h
      subst hrc
      simp only [evalL] at hev
      exact ⟨[], (Option.some.inj hev).symm⟩
  | .app _ _, 0, _, _, _, hev => Option.noConfusion hev
  | .app g a, F + 1, env, vL, h, hev => by
      simp only [isCtorSpineL] at h
      rw [evalL_app_eq] at hev
      cases hg : evalL F env g with
      | none => rw [hg] at hev; exact Option.noConfusion hev
      | some vg =>
          rw [hg] at hev
          obtain ⟨vs, hvg⟩ := evalL_isCtorSpineL_shape c g F env vg h hg
          subst hvg
          cases ha : evalL F env a with
          | none => rw [ha] at hev; exact Option.noConfusion hev
          | some va =>
              rw [ha] at hev
              exact ⟨vs ++ [va], (Option.some.inj hev).symm⟩

theorem stepEvalL_app_ctor_spine (E : ResolvedEnv) (n c : Nat)
    (f1 f2 a1 a2 : Expr Nat)
    (hirr1 : irrelevant E n [] (.app f1 a1) = false)
    (hirr2 : irrelevant E n [] (.app f2 a2) = false)
    (hcs2 : ∀ F lf2, erase E n F [] f2 = some lf2 → isCtorSpineL c lf2 = true)
    (hf : StepEvalL E n f1 f2)
    (ha : StepEvalL E n a1 a2) :
    StepEvalL E n (.app f1 a1) (.app f2 a2) := by
  intro F2 le2 vL he2 hev2 hnc
  obtain ⟨F2', lf2, la2, rfl, he_f2, he_a2, rfl⟩ := erase_app_keep_inv hirr2 he2
  rw [evalL_app_eq] at hev2
  cases hg : evalL F2' [] lf2 with
  | none => rw [hg] at hev2; exact Option.noConfusion hev2
  | some vf2 =>
      rw [hg] at hev2
      obtain ⟨vs, hvf2⟩ :=
        evalL_isCtorSpineL_shape c lf2 F2' [] vf2 (hcs2 F2' lf2 he_f2) hg
      subst hvf2
      cases harg : evalL F2' [] la2 with
      | none => rw [harg] at hev2; exact Option.noConfusion hev2
      | some va2 =>
          rw [harg] at hev2
          have hvL : vL = .ctor c (vs ++ [va2]) := (Option.some.inj hev2).symm
          subst hvL
          simp only [noClo, noCloList_snoc, Bool.and_eq_true] at hnc
          obtain ⟨Ff1, lf1, he_f1, hev_f1⟩ :=
            hf F2' lf2 (.ctor c vs) he_f2 hg hnc.1
          obtain ⟨Fa1, la1, he_a1, hev_a1⟩ :=
            ha F2' la2 va2 he_a2 harg hnc.2
          refine ⟨Ff1 + Fa1 + 1, .app lf1 la1, ?_, ?_⟩
          · rw [erase_app_keep E n (Ff1 + Fa1) [] f1 a1 hirr1,
                erase_mono E n Ff1 (Ff1 + Fa1) [] f1 lf1 (Nat.le_add_right Ff1 Fa1) he_f1,
                erase_mono E n Fa1 (Ff1 + Fa1) [] a1 la1 (Nat.le_add_left Fa1 Ff1) he_a1]
          · exact evalL_app_ctor (Ff1 + Fa1) [] c vs lf1 la1 va2
              (evalL_mono Ff1 (Ff1 + Fa1) [] lf1 (.ctor c vs)
                (Nat.le_add_right Ff1 Fa1) hev_f1)
              (evalL_mono Fa1 (Ff1 + Fa1) [] la1 va2
                (Nat.le_add_left Fa1 Ff1) hev_a1)

theorem stepEvalL_foldApps (E : ResolvedEnv) (n fuel c : Nat) (T : Expr Nat) :
    ∀ (args vargs : List (Expr Nat)) (f1 f2 : Expr Nat),
      args.mapM (norm E fuel) = some vargs →
      (∀ arg ∈ args,
        (∀ varg, norm E fuel arg = some varg → StepEvalL E n arg varg) ∧
        NormErasable E n fuel arg) →
      inferT E n [] (foldApps f1 args) = some T →
      irrelevant E n [] (foldApps f1 args) = false →
      inferT E n [] (foldApps f2 vargs) = some T →
      irrelevant E n [] (foldApps f2 vargs) = false →
      (∀ F0 Tf lf2,
        inferT E n [] f2 = some Tf →
        irrelevant E n [] f2 = false →
        erase E n F0 [] f2 = some lf2 →
        isCtorSpineL c lf2 = true) →
      StepEvalL E n f1 f2 →
      StepEvalL E n (foldApps f1 args) (foldApps f2 vargs)
  | [], vargs, _, _, hnorm, _, _, _, _, _, _, hf => by
      simp only [List.mapM_nil, Option.pure_def] at hnorm
      have hv : vargs = [] := (Option.some.inj hnorm).symm
      subst hv
      exact hf
  | a :: as, vargs, f1, f2, hnorm, hargs, hi1, hirr1, hi2, hirr2, hcs2, hf => by
      obtain ⟨va, vas, hnorm_a, hnorm_as, rfl⟩ := list_mapM_cons_inv hnorm
      have hirr_app1 : irrelevant E n [] (.app f1 a) = false :=
        irrelevant_foldApps_head_false E n as (.app f1 a) T hi1 hirr1
      obtain ⟨Tap2, hi_app2⟩ := inferT_foldApps_head_some E n vas (.app f2 va) T hi2
      have hirr_app2 : irrelevant E n [] (.app f2 va) = false :=
        irrelevant_foldApps_head_false E n vas (.app f2 va) T hi2 hirr2
      obtain ⟨A2, B2, hi_f2, _, _⟩ := inferT_app_some.mp hi_app2
      have hirr_f2 : irrelevant E n [] f2 = false :=
        irrelevant_fun_false_of_app_irr hi_app2 hirr_app2
      have hstep_a : StepEvalL E n a va :=
        (hargs a (List.mem_cons_self a as)).1 va hnorm_a
      have hstep_app : StepEvalL E n (.app f1 a) (.app f2 va) :=
        stepEvalL_app_ctor_spine E n c f1 f2 a va hirr_app1 hirr_app2
          (fun F0 lf2 he_f2 => hcs2 F0 (.pi A2 B2) lf2 hi_f2 hirr_f2 he_f2)
          hf hstep_a
      have hcs_app2 : ∀ F0 Tap0 lap,
          inferT E n [] (.app f2 va) = some Tap0 →
          irrelevant E n [] (.app f2 va) = false →
          erase E n F0 [] (.app f2 va) = some lap →
          isCtorSpineL c lap = true := by
        intro F0 _ lap hi_app0 hirr_app0 he_app0
        obtain ⟨F1, lf2, _, _, he_f0, _, hlap⟩ := erase_app_keep_inv hirr_app0 he_app0
        subst hlap
        obtain ⟨A0, B0, hi_f0, _, _⟩ := inferT_app_some.mp hi_app0
        have hirr_f0 : irrelevant E n [] f2 = false :=
          irrelevant_fun_false_of_app_irr hi_app0 hirr_app0
        simp only [isCtorSpineL]
        exact hcs2 F1 (.pi A0 B0) lf2 hi_f0 hirr_f0 he_f0
      exact stepEvalL_foldApps E n fuel c T as vas (.app f1 a) (.app f2 va)
        hnorm_as (fun x hx => hargs x (List.mem_cons_of_mem a hx))
        hi1 hirr1 hi2 hirr2 hcs_app2 hstep_app

theorem scmValOf_letE (E : ResolvedEnv) (fv : Nat) (A v b : Expr Nat) :
    scmValOf E fv (.letE A v b) = none := by
  cases fv <;> rfl

theorem norm_stepEvalL {E : ResolvedEnv} {n lf fv : Nat}
    {e T v : Expr Nat} {w_val : Val}
    (hE : EnvClosed E)
    (hi : inferT E n [] e = some T)
    (hn : norm E lf e = some v)
    (hs : scmValOf E fv v = some w_val)
    (hirrv : irrelevant E n [] v = false)
    (hiv : inferT E n [] v = some T)
    (her : NormErasable E n lf e) :
    StepEvalL E n e v := by
  have hirre : irrelevant E n [] e = false :=
    irrelevant_false_of_same_type hi hiv hirrv
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ fuel =>
      rcases her with ⟨hwhnf, hspine⟩
      unfold norm at hn
      cases hw : whnfFuel E fuel e with
      | none =>
          rw [hw] at hn
          exact Option.noConfusion hn
      | some w =>
          rw [hw] at hn hspine
          have hw_ty : inferT E n [] w = some T :=
            whnfFuel_preserves_inferT hE fuel e w T hi hw hwhnf
          have hw_irr : irrelevant E n [] w = false :=
            irrelevant_false_of_same_type hw_ty hiv hirrv
          have hstep_ew : StepEvalL E n e w :=
            whnfFuel_stepEvalL hE fuel e w T hi hirre hw hwhnf
          cases w with
          | bvar _ | sort _ | const _ _ | lit _ =>
              have hv : v = _ := (Option.some.inj hn).symm
              subst hv
              exact hstep_ew
          | lam A b =>
              dsimp only at hn
              split at hn
              · have hv : v = _ := (Option.some.inj hn).symm
                rw [hv, scmValOf_lam] at hs
                exact Option.noConfusion hs
              · exact Option.noConfusion hn
          | pi A B =>
              dsimp only at hn
              split at hn
              · have hv : v = _ := (Option.some.inj hn).symm
                rw [hv, scmValOf_pi] at hs
                exact Option.noConfusion hs
              · exact Option.noConfusion hn
          | letE A x b =>
              dsimp only at hn
              split at hn
              · have hv : v = _ := (Option.some.inj hn).symm
                rw [hv, scmValOf_letE] at hs
                exact Option.noConfusion hs
              · exact Option.noConfusion hn
          | app g a =>
              dsimp only at hn
              cases hmap : (appsSpine (.app g a)).2.mapM (norm E fuel) with
              | none =>
                  rw [hmap] at hn
                  exact Option.noConfusion hn
              | some vargs =>
                  rw [hmap] at hn
                  have hv : v = foldApps (appsSpine (.app g a)).1 vargs :=
                    (Option.some.inj hn).symm
                  have hsp_v : appsSpine v = ((appsSpine (.app g a)).1, vargs) := by
                    rw [hv]
                    exact appsSpine_foldApps_fst (.app g a) vargs
                  have hne_lit : ∀ k, v ≠ .lit k := by
                    intro k hlit
                    have hsp_lit : appsSpine v = (.lit k, []) := by
                      rw [hlit]
                      rfl
                    rw [hsp_v] at hsp_lit
                    have hvargs_nil : vargs = [] := (Prod.mk.inj hsp_lit).2
                    subst hvargs_nil
                    have hlen : (appsSpine (.app g a)).2 ≠ [] := by
                      simp [appsSpine]
                    cases hsp2 : (appsSpine (.app g a)).2 with
                    | nil => exact hlen hsp2
                    | cons x xs =>
                        rw [hsp2] at hmap
                        obtain ⟨_, _, _, _, hnil⟩ := list_mapM_cons_inv hmap
                        exact List.noConfusion hnil
                  cases fv with
                  | zero => exact Option.noConfusion hs
                  | succ m =>
                      obtain ⟨c, lsc, vargs', hv'⟩ := scmValOf_non_lit_spine hne_lit hs
                      have hsp_v' : appsSpine v = (.const c lsc, vargs') := by
                        rw [hv', appsSpine_foldApps]
                        simp [appsSpine]
                      rw [hsp_v] at hsp_v'
                      have hhd : (appsSpine (.app g a)).1 = .const c lsc :=
                        (Prod.mk.inj hsp_v').1
                      have hv_eq : v = foldApps (.const c lsc) vargs := by
                        rw [hv, hhd]
                      have hw_eq : Expr.app g a =
                          foldApps (.const c lsc) (appsSpine (.app g a)).2 := by
                        rw [← hhd]
                        exact (foldApps_appsSpine (.app g a)).symm
                      have hs_fold : scmValOf E (m + 1)
                          (foldApps (.const c lsc) vargs) = some w_val :=
                        hv_eq ▸ hs
                      have hctor : isCtor E c = true :=
                        isCtor_of_scmValOf_foldApps hs_fold
                      have hnone : transparentBody E c lsc = none :=
                        transparentBody_eq_none_of_isCtor E c lsc hctor
                      have hcs_c : ∀ F0 Tf lf2,
                          inferT E n [] (.const c lsc) = some Tf →
                          irrelevant E n [] (.const c lsc) = false →
                          erase E n F0 [] (.const c lsc) = some lf2 →
                          isCtorSpineL c lf2 = true := by
                        intro F0 _ lf2 _ hirrC0 heC0
                        obtain ⟨_, _, hlf⟩ := erase_const_ctor_inv hirrC0 hnone hctor heC0
                        subst hlf
                        simp only [isCtorSpineL, decide_eq_true_eq]
                      have hstep_wv : StepEvalL E n (.app g a) v := by
                        rw [hw_eq, hv_eq]
                        exact stepEvalL_foldApps E n fuel c T
                          (appsSpine (.app g a)).2 vargs (.const c lsc) (.const c lsc)
                          hmap hspine
                          (hw_eq ▸ hw_ty) (hw_eq ▸ hw_irr)
                          (hv_eq ▸ hiv) (hv_eq ▸ hirrv)
                          hcs_c (stepEvalL_refl E n (.const c lsc))
                      exact stepEvalL_trans hstep_ew hstep_wv

theorem good_of_envWf {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat) (hWf : EnvWf E) :
    Good progs E n e := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  refine lowerF_eventual_of_exists progs E n t e w ?_
  have _hB : BodiesTyped E n := hB
  have _hArity : isArity T = false := isArity_false_of_dataTy E hD
  have _hTyE : HasTyT E n [] e T := hasTyT_of_inferT hi
  obtain ⟨Fv, hev_v⟩ :=
    eval_lowerF_of_scmValOf (S := S) progs E n fv v T t w hvinf hs hrel hirrv hf
  obtain ⟨lv, dv, he_v, hr_v, _, hemit_v⟩ :=
    lowerF_eval_inv progs E n Fv 1 t v w hev_v
  have hp_lv : passive lv = true :=
    passive_erase_of_scmValOf hs he_v
  have hsim_v : (evalL Fv [] lv).bind lToD = some dv := by
    rw [evalL_run_passive_nil Fv lv hp_lv]
    exact hr_v
  cases hevL_v : evalL Fv [] lv with
  | none =>
      rw [hevL_v] at hsim_v
      exact Option.noConfusion hsim_v
  | some vL =>
      rw [hevL_v] at hsim_v
      change lToD vL = some dv at hsim_v
      have hnc : noClo vL = true := noClo_of_lToD vL dv hsim_v
      have hstep : StepEvalL E n e v :=
        norm_stepEvalL hWf.1 hi hn hs hirrv hvinf her.2
      obtain ⟨Fe0, le, he_e0, hevL_e0⟩ :=
        hstep Fv lv vL he_v hevL_v hnc
      have hr_e0 : run (defunc le).2 Fe0 [] (defunc le).1 = some dv :=
        evalL_run_defunc Fe0 le vL dv
          (noGlobL_erase E n Fe0 [] e le he_e0) hevL_e0 hsim_v
      have he_e : erase E n (Fe0 + Fv) [] e = some le :=
        erase_mono E n Fe0 (Fe0 + Fv) [] e le (Nat.le_add_right Fe0 Fv) he_e0
      have hr_e : run (defunc le).2 (Fe0 + Fv) [] (defunc le).1 = some dv :=
        run_mono (defunc le).2 Fe0 (Fe0 + Fv) [] (defunc le).1 dv
          (Nat.le_add_right Fe0 Fv) hr_e0
      refine ⟨Fe0 + Fv, 1, ?_⟩
      rw [lowerF_eq_of_erase_run E n (Fe0 + Fv) t e le dv he_e hr_e]
      exact emitWith_evalStable relevantArgs progs 1 [] Fv (Fe0 + Fv) t dv w
        (Nat.le_add_left Fv Fe0) hemit_v

/-! ### Compositional `NormErasable` projections and `Good → Good` combinators -/

def whnfStep (E : ResolvedEnv) (e : Expr Nat) : Option (Expr Nat) :=
  match appsSpine e with
  | (.lam _ b, a :: args) => some (foldApps (instantiate0 a b) args)
  | (.letE _ v b, args) => some (foldApps (instantiate0 v b) args)
  | (.const r ls, args) =>
      match transparentBody E r ls with
      | some body => some (foldApps body args)
      | none => none
  | _ => none

def whnfIter (E : ResolvedEnv) : Nat → Expr Nat → Option (Expr Nat)
  | 0, e => some e
  | d + 1, e =>
      match whnfStep E e with
      | some e' => whnfIter E d e'
      | none => none

theorem whnfFuel_of_whnfStep {E : ResolvedEnv} {e1 e2 : Expr Nat}
    (h : whnfStep E e1 = some e2) (m : Nat) :
    whnfFuel E (m + 1) e1 = whnfFuel E m e2 := by
  unfold whnfStep at h
  rw [whnfFuel.eq_2]
  generalize hsp : appsSpine e1 = sp at h ⊢
  rcases sp with ⟨hd, args⟩
  cases hd with
  | lam _ b =>
      cases args with
      | nil => exact Option.noConfusion h
      | cons a as =>
          simp only at h ⊢
          have he2 : e2 = foldApps (instantiate0 a b) as := (Option.some.inj h).symm
          rw [he2]
  | letE _ v b =>
      simp only at h ⊢
      have he2 : e2 = foldApps (instantiate0 v b) args := (Option.some.inj h).symm
      rw [he2]
  | const r ls =>
      simp only at h ⊢
      cases htb : transparentBody E r ls with
      | none =>
          rw [htb] at h
          exact Option.noConfusion h
      | some body =>
          rw [htb] at h
          simp only at h ⊢
          have he2 : e2 = foldApps body args := (Option.some.inj h).symm
          rw [he2]
  | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
      exact Option.noConfusion h

theorem whnfErasable_of_whnfStep {E : ResolvedEnv} {n m : Nat} {e1 e2 : Expr Nat}
    (h : whnfStep E e1 = some e2)
    (hw : WhnfErasable E n (m + 1) e1) :
    WhnfErasable E n m e2 := by
  unfold whnfStep at h
  unfold WhnfErasable at hw
  generalize hsp : appsSpine e1 = sp at h hw
  rcases sp with ⟨hd, args⟩
  cases hd with
  | lam _ b =>
      cases args with
      | nil => exact Option.noConfusion h
      | cons a as =>
          simp only at h hw
          have he2 : e2 = foldApps (instantiate0 a b) as := (Option.some.inj h).symm
          rw [he2]
          exact hw.2
  | letE _ v b =>
      simp only at h hw
      have he2 : e2 = foldApps (instantiate0 v b) args := (Option.some.inj h).symm
      rw [he2]
      exact hw.2
  | const r ls =>
      simp only at h hw
      cases htb : transparentBody E r ls with
      | none =>
          rw [htb] at h
          exact Option.noConfusion h
      | some body =>
          rw [htb] at h hw
          have he2 : e2 = foldApps body args := (Option.some.inj h).symm
          rw [he2]
          exact hw.2
  | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
      exact Option.noConfusion h

theorem whnfErasable_mono_of_whnfFuel (E : ResolvedEnv) (n : Nat) :
    ∀ (k fuel : Nat) (e w : Expr Nat),
      k ≤ fuel →
      whnfFuel E k e = some w →
      WhnfErasable E n k e →
      WhnfErasable E n fuel e
  | 0, _, _, _, _, hw, _ => Option.noConfusion hw
  | k + 1, fuel, e, w, hle, hw, hwhnf => by
      obtain ⟨fuel', rfl⟩ : ∃ fuel', fuel = fuel' + 1 := ⟨fuel - 1, by omega⟩
      have hk : k ≤ fuel' := by omega
      unfold whnfFuel at hw
      unfold WhnfErasable at hwhnf ⊢
      generalize hsp : appsSpine e = sp at hw hwhnf ⊢
      rcases sp with ⟨hd, args⟩
      cases hd with
      | lam _ b =>
          cases args with
          | nil => exact True.intro
          | cons a as =>
              simp only at hw hwhnf ⊢
              exact ⟨hwhnf.1,
                whnfErasable_mono_of_whnfFuel E n k fuel' _ w hk hw hwhnf.2⟩
      | letE _ v b =>
          simp only at hw hwhnf ⊢
          exact ⟨hwhnf.1,
            whnfErasable_mono_of_whnfFuel E n k fuel' _ w hk hw hwhnf.2⟩
      | const r ls =>
          simp only at hw hwhnf ⊢
          cases htb : transparentBody E r ls with
          | none =>
              exact True.intro
          | some body =>
              rw [htb] at hw hwhnf
              simp only at hw hwhnf ⊢
              exact ⟨hwhnf.1,
                whnfErasable_mono_of_whnfFuel E n k fuel' _ w hk hw hwhnf.2⟩
      | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
          exact True.intro

theorem normErasable_of_whnfStep {E : ResolvedEnv} {n lf : Nat} {e1 e2 v : Expr Nat}
    (hstep : whnfStep E e1 = some e2)
    (hn : norm E lf e1 = some v)
    (her : NormErasable E n lf e1) :
    NormErasable E n lf e2 := by
  cases lf with
  | zero => exact True.intro
  | succ fuel =>
      cases fuel with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          rcases her with ⟨hw1, hsp1⟩
          unfold norm at hn
          cases hwk : whnfFuel E (k + 1) e1 with
          | none =>
              rw [hwk] at hn
              exact Option.noConfusion hn
          | some w =>
              have hwe2_k : whnfFuel E k e2 = some w := by
                rw [← whnfFuel_of_whnfStep hstep k]
                exact hwk
              have hwe2_k1 : whnfFuel E (k + 1) e2 = some w :=
                whnfFuel_mono E k e2 w hwe2_k
              have hw2_k : WhnfErasable E n k e2 :=
                whnfErasable_of_whnfStep hstep hw1
              have hw2_k1 : WhnfErasable E n (k + 1) e2 :=
                whnfErasable_mono_of_whnfFuel E n k (k + 1) e2 w
                  (Nat.le_succ k) hwe2_k hw2_k
              refine ⟨hw2_k1, ?_⟩
              rw [hwe2_k1]
              rw [hwk] at hsp1
              exact hsp1

theorem whnfFuel_of_whnfIter {E : ResolvedEnv} :
    ∀ (d : Nat) {e1 e2 : Expr Nat},
      whnfIter E d e1 = some e2 →
      ∀ m, whnfFuel E (m + d) e1 = whnfFuel E m e2
  | 0, _, _, h, m => by
      have he : _ = _ := Option.some.inj h
      rw [Nat.add_zero, he]
  | d + 1, e1, e2, h, m => by
      unfold whnfIter at h
      cases h1 : whnfStep E e1 with
      | none =>
          rw [h1] at h
          exact Option.noConfusion h
      | some e' =>
          rw [h1] at h
          rw [← Nat.add_assoc m d 1,
              whnfFuel_of_whnfStep h1 (m + d),
              whnfFuel_of_whnfIter d h m]

theorem normErasable_of_whnfIter {E : ResolvedEnv} {n lf : Nat} {v : Expr Nat} :
    ∀ (d : Nat) {e1 e2 : Expr Nat},
      whnfIter E d e1 = some e2 →
      norm E lf e1 = some v →
      NormErasable E n lf e1 →
      NormErasable E n lf e2
  | 0, _, _, h, _, her => by
      have he : _ = _ := Option.some.inj h
      rwa [← he]
  | d + 1, e1, e2, h, hn, her => by
      unfold whnfIter at h
      cases h1 : whnfStep E e1 with
      | none =>
          rw [h1] at h
          exact Option.noConfusion h
      | some e' =>
          rw [h1] at h
          have hn' : norm E lf e' = some v :=
            norm_of_whnf_steps E 1 lf e1 e' v
              (fun m => whnfFuel_of_whnfStep h1 m) hn
          have her' : NormErasable E n lf e' :=
            normErasable_of_whnfStep h1 hn her
          exact normErasable_of_whnfIter d h hn' her'

theorem normErasable_of_app_ctor {E : ResolvedEnv} {n k c : Nat}
    {lsc : List Level} {arg : Expr Nat}
    (hnone : transparentBody E c lsc = none)
    (h : NormErasable E n (k + 2) (.app (.const c lsc) arg)) :
    NormErasable E n (k + 1) arg := by
  have hw : whnfFuel E (k + 1) (.app (.const c lsc) arg) =
      some (.app (.const c lsc) arg) := by
    simp only [whnfFuel, appsSpine, List.nil_append, hnone]
  have h2 := h.2
  rw [hw] at h2
  exact (h2 arg (by simp [appsSpine])).2

theorem good_const_delta_of_good_body {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n r : Nat) (ls : List Level) (b : Expr Nat)
    (hb : transparentBody E r ls = some b)
    (hTy : ∀ T, inferT E n [] (.const r ls) = some T → inferT E n [] b = some T)
    (hGood : Good progs E n b) :
    Good progs E n (.const r ls) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  refine lowerF_eventual_of_exists progs E n t (.const r ls) w ?_
  have hirr : irrelevant E n [] (.const r ls) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have herb : Erasable E n b := erasable_of_const_delta hirr hb her.1
  have hib : inferT E n [] b = some T := hTy T hi
  have hstep : whnfStep E (.const r ls) = some b := by
    simp only [whnfStep, appsSpine, hb]
    rfl
  cases lf with
  | zero =>
      rw [norm_fuel0] at hn
      exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hn' : norm E (k + 2) (foldApps (.const r ls) []) = some v := hn
          have hbn : norm E (k + 2) b = some v :=
            norm_delta_spine_eq E k r ls b [] v hb hn'
          have hnb : NormErasable E n (k + 2) b :=
            normErasable_of_whnfStep hstep hn her.2
          obtain ⟨F₀, hF⟩ :=
            hGood (k + 2) fv T v t w hB hib hD hbn hs hrel hirrv hf hvinf ⟨herb, hnb⟩
          obtain ⟨lfe, he⟩ := hF F₀ (Nat.le_refl F₀)
          exact ⟨F₀ + 1, lfe,
            lowerF_const_delta_eval progs E n F₀ r lfe ls b t w hirr hb he⟩

theorem good_beta_id_of_good_arg {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (A arg : Expr Nat) (hE : EnvClosed E)
    (hGood : Good progs E n arg) :
    Good progs E n (.app (.lam A (.bvar 0)) arg) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  refine lowerF_eventual_of_exists progs E n t (.app (.lam A (.bvar 0)) arg) w ?_
  have hirr : irrelevant E n [] (.app (.lam A (.bvar 0)) arg) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrL : irrelevant E n [] (.lam A (.bvar 0)) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  have hirrB : irrelevant E n (.assumption A :: []) (.bvar 0) = false :=
    irrelevant_body_false_of_beta hE hi hirr
  have herArg : Erasable E n arg := (erasable_of_app_keep hirr her.1).2
  have hiArg : inferT E n [] arg = some T := inferT_beta_id_arg_eq hi
  have hstep : whnfStep E (.app (.lam A (.bvar 0)) arg) = some arg := rfl
  cases lf with
  | zero =>
      rw [norm_fuel0] at hn
      exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hargn : norm E (k + 2) arg = some v :=
            norm_beta_id_eq E k A arg v hn
          have hnArg : NormErasable E n (k + 2) arg :=
            normErasable_of_whnfStep hstep hn her.2
          obtain ⟨G, hF⟩ :=
            hGood (k + 2) fv T v t w hB hiArg hD hargn hs hrel hirrv hf hvinf
              ⟨herArg, hnArg⟩
          obtain ⟨lfe, he⟩ := hF G (Nat.le_refl G)
          unfold lowerF pipeline at he
          cases ha : erase E n G [] arg with
          | none =>
              simp only [ha] at he
              exact absurd he (eval_refuse_ne progs lfe [] w)
          | some la =>
              simp only [ha] at he
              cases hr : run (defunc la).2 G [] (defunc la).1 with
              | none =>
                  simp only [hr] at he
                  exact absurd he (eval_refuse_ne progs lfe [] w)
              | some dv =>
                  simp only [hr] at he
                  cases G with
                  | zero =>
                      simp only [erase, eraseWith] at ha
                      exact Option.noConfusion ha
                  | succ F =>
                      have hc : noCloD dv = true :=
                        noCloD_emitWith progs (F + 1) lfe t dv w he
                      exact ⟨F + 3, lfe, lowerF_beta_id_eval progs E n F lfe A arg t w
                        hirr hirrL hirrB la ha dv hr hc he⟩

theorem good_let_id_of_good_bound {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (A bound : Expr Nat) (hE : EnvClosed E)
    (hGood : Good progs E n bound) :
    Good progs E n (.letE A bound (.bvar 0)) := by
  intro lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  refine lowerF_eventual_of_exists progs E n t (.letE A bound (.bvar 0)) w ?_
  have hirr : irrelevant E n [] (.letE A bound (.bvar 0)) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrB : irrelevant E n (.letBinding A bound :: []) (.bvar 0) = false :=
    irrelevant_body_false_of_let hE hi hirr
  have herBnd : Erasable E n bound := erasable_of_let_keep hirr her.1
  have hiBnd : inferT E n [] bound = some T := inferT_let_id_bound_eq hi
  have hstep : whnfStep E (.letE A bound (.bvar 0)) = some bound := rfl
  cases lf with
  | zero =>
      rw [norm_fuel0] at hn
      exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hbnd : norm E (k + 2) bound = some v :=
            norm_let_id_eq E k A bound v hn
          have hnBnd : NormErasable E n (k + 2) bound :=
            normErasable_of_whnfStep hstep hn her.2
          obtain ⟨G, hF⟩ :=
            hGood (k + 2) fv T v t w hB hiBnd hD hbnd hs hrel hirrv hf hvinf
              ⟨herBnd, hnBnd⟩
          obtain ⟨lfe, he⟩ := hF G (Nat.le_refl G)
          unfold lowerF pipeline at he
          cases ha : erase E n G [] bound with
          | none =>
              simp only [ha] at he
              exact absurd he (eval_refuse_ne progs lfe [] w)
          | some lv =>
              simp only [ha] at he
              cases hr : run (defunc lv).2 G [] (defunc lv).1 with
              | none =>
                  simp only [hr] at he
                  exact absurd he (eval_refuse_ne progs lfe [] w)
              | some dv =>
                  simp only [hr] at he
                  cases G with
                  | zero =>
                      simp only [erase, eraseWith] at ha
                      exact Option.noConfusion ha
                  | succ F =>
                      exact ⟨F + 3, lfe, lowerF_let_id_eval progs E n F lfe A bound t w
                        hirr hirrB lv ha dv hr he⟩

theorem good_app_ctor_of_good_arg {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (arg : Expr Nat)
    (hnone : transparentBody E c lsc = none)
    (hDA : ∀ A, inferT E n [] arg = some A → DataTy E A)
    (hGood : Good progs E n arg) :
    Good progs E n (.app (.const c lsc) arg) := by
  intro lf fv T v t w hB hi _ hn hs hrel hirrv hf hvinf her
  refine lowerF_eventual_of_exists progs E n t (.app (.const c lsc) arg) w ?_
  have hirr : irrelevant E n [] (.app (.const c lsc) arg) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have hirrC : irrelevant E n [] (.const c lsc) = false :=
    irrelevant_fun_false_of_app_irr hi hirr
  have herArg : Erasable E n arg := (erasable_of_app_keep hirr her.1).2
  obtain ⟨k, varg, hlf, hargn, hv⟩ :=
    norm_app_ctor_arg_of_norm E lf c lsc arg v hnone hn
  subst hv
  subst hlf
  have hnArg : NormErasable E n (k + 1) arg :=
    normErasable_of_app_ctor hnone her.2
  obtain ⟨A, _, _, harg_ty, hvarg_ty⟩ := inferT_app_same_head_arg hi hvinf
  cases fv with
  | zero =>
      simp only [scmValOf] at hs
      exact Option.noConfusion hs
  | succ m =>
      cases m with
      | zero =>
          have hs0 : scmValOf E 1 (.app (.const c lsc) varg) = none := by
            simp only [scmValOf, appsSpine, List.nil_append, List.mapM_cons,
              List.mapM_nil, Option.bind, Option.pure_def]
            split
            · rename_i mm hm
              by_cases hc : mm.mclass = .constructorM
              · simp [hm, hc, scmValOf]
              · simp [hm, hc]
            · rename_i hm
              simp [hm]
          rw [hs0] at hs
          exact Option.noConfusion hs
      | succ q =>
          have hs' : (match E.members c with
              | some mm =>
                  if mm.mclass = .constructorM then
                    match List.mapM (scmValOf E (q + 1)) [varg] with
                    | some vs => some (.inj c (.list vs))
                    | none => none
                  else none
              | none => none) = some w := by
            simpa [scmValOf, appsSpine, List.nil_append] using hs
          cases hm : E.members c with
          | none =>
              simp only [hm] at hs'
              exact Option.noConfusion hs'
          | some mm =>
              simp only [hm] at hs'
              by_cases hcm : mm.mclass = .constructorM
              · simp only [hcm, ite_true] at hs'
                rw [List.mapM_cons, List.mapM_nil] at hs'
                cases hfield : scmValOf E (q + 1) varg with
                | none =>
                    simp only [hfield, Option.bind, Option.pure_def] at hs'
                    exact Option.noConfusion hs'
                | some wfield =>
                    simp only [hfield, Option.bind, Option.pure_def] at hs'
                    have hw : w = .inj c (.list [wfield]) := (Option.some.inj hs').symm
                    subst hw
                    have hctor : isCtor E c = true := by simp [isCtor, hm, hcm]
                    have hrel1 :
                        (!irrelevant E n [] varg &&
                          relevantSpine E n (q + 1) varg) = true := by
                      simpa [relevantSpine, appsSpine, List.nil_append, List.all_cons,
                        List.all_nil, Bool.and_true] using hrel
                    cases hirrF : irrelevant E n [] varg with
                    | true =>
                        simp only [hirrF, Bool.not_true, Bool.false_and] at hrel1
                        exact Bool.noConfusion hrel1
                    | false =>
                        simp only [hirrF, Bool.not_false, Bool.true_and] at hrel1
                        cases t with
                        | sum ts =>
                            have hf' : (match ts.get? c with
                                | some (.list τ) =>
                                    valFits (q + 1) τ wfield
                                | _ => false) = true := by
                              simpa [valFits, List.all_cons, List.all_nil, Bool.and_true]
                                using hf
                            split at hf'
                            · rename_i τ hg
                              obtain ⟨G, hF⟩ :=
                                hGood (k + 1) (q + 1) A varg τ wfield hB harg_ty
                                  (hDA A harg_ty) hargn hfield hrel1 hirrF hf'
                                  hvarg_ty ⟨herArg, hnArg⟩
                              obtain ⟨lfe, he⟩ := hF G (Nat.le_refl G)
                              unfold lowerF pipeline at he
                              cases ha : erase E n G [] arg with
                              | none =>
                                  simp only [ha] at he
                                  exact absurd he (eval_refuse_ne progs lfe [] wfield)
                              | some la =>
                                  simp only [ha] at he
                                  cases hr : run (defunc la).2 G [] (defunc la).1 with
                                  | none =>
                                      simp only [hr] at he
                                      exact absurd he (eval_refuse_ne progs lfe [] wfield)
                                  | some dv =>
                                      simp only [hr] at he
                                      cases G with
                                      | zero =>
                                          simp only [erase, eraseWith] at ha
                                          exact Option.noConfusion ha
                                      | succ F =>
                                          have ha2 : erase E n (F + 2) [] arg = some la :=
                                            erase_mono E n (F + 1) (F + 2) [] arg la
                                              (Nat.le_succ (F + 1)) ha
                                          have hr2 : run (defunc la).2 (F + 2) []
                                              (defunc la).1 = some dv :=
                                            run_mono (defunc la).2 (F + 1) (F + 2) []
                                              (defunc la).1 dv (Nat.le_succ (F + 1)) hr
                                          have heC := eval_emit_ctor_one progs F lfe c ts τ
                                            dv wfield hg he
                                          exact ⟨F + 3, lfe,
                                            lowerF_app_ctor_eval progs E n (F + 1) lfe c lsc arg
                                              (.sum ts) (.inj c (.list [wfield])) hnone hctor
                                              hirr hirrC la ha2 dv hr2 heC⟩
                            · exact Bool.noConfusion hf'
                        | i64 | bool | str | bytes | list _ | pair _ _ | record _ |
                          option _ | residue _ =>
                            simp only [valFits] at hf
                            exact Bool.noConfusion hf
              · simp only [hcm, ite_false] at hs'
                exact Option.noConfusion hs'

theorem good_of_whnf_steps_and_run_eq {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n d F₁ F₂ : Nat) (e1 e2 : Expr Nat) (l1 l2 : LExpr) (dv : DVal)
    (hiter : whnfIter E d e1 = some e2)
    (hTy : ∀ T, inferT E n [] e1 = some T → inferT E n [] e2 = some T)
    (he1 : erase E n F₁ [] e1 = some l1)
    (hr1 : run (defunc l1).2 F₁ [] (defunc l1).1 = some dv)
    (he2 : erase E n F₂ [] e2 = some l2)
    (hr2 : run (defunc l2).2 F₂ [] (defunc l2).1 = some dv)
    (hGood : Good progs E n e2) :
    Good progs E n e1 := by
  intro lf fv T v t w hB hi1 hD hn1 hs hrel hirrv hf hvinf her1
  refine lowerF_eventual_of_exists progs E n t e1 w ?_
  have hi2 : inferT E n [] e2 = some T := hTy T hi1
  have hn2 : norm E lf e2 = some v :=
    norm_of_whnf_steps E d lf e1 e2 v (whnfFuel_of_whnfIter d hiter) hn1
  have her2 : TraceErasable E n lf e2 :=
    ⟨⟨F₂, l2, he2⟩, normErasable_of_whnfIter d hiter hn1 her1.2⟩
  obtain ⟨G, hF⟩ := hGood lf fv T v t w hB hi2 hD hn2 hs hrel hirrv hf hvinf her2
  obtain ⟨lfe, hev2⟩ := hF (F₁ + F₂ + G) (Nat.le_add_left G (F₁ + F₂))
  have hle1 : F₁ ≤ F₁ + F₂ + G := by omega
  have hle2 : F₂ ≤ F₁ + F₂ + G := by omega
  have he1' : erase E n (F₁ + F₂ + G) [] e1 = some l1 :=
    erase_mono E n F₁ (F₁ + F₂ + G) [] e1 l1 hle1 he1
  have hr1' : run (defunc l1).2 (F₁ + F₂ + G) [] (defunc l1).1 = some dv :=
    run_mono (defunc l1).2 F₁ (F₁ + F₂ + G) [] (defunc l1).1 dv hle1 hr1
  have he2' : erase E n (F₁ + F₂ + G) [] e2 = some l2 :=
    erase_mono E n F₂ (F₁ + F₂ + G) [] e2 l2 hle2 he2
  have hr2' : run (defunc l2).2 (F₁ + F₂ + G) [] (defunc l2).1 = some dv :=
    run_mono (defunc l2).2 F₂ (F₁ + F₂ + G) [] (defunc l2).1 dv hle2 hr2
  rw [lowerF_eq_of_erase_run E n (F₁ + F₂ + G) t e2 l2 dv he2' hr2',
      ← lowerF_eq_of_erase_run E n (F₁ + F₂ + G) t e1 l1 dv he1' hr1'] at hev2
  exact ⟨F₁ + F₂ + G, lfe, hev2⟩

theorem good_app_const_delta_of_good {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n r : Nat) (ls : List Level) (f arg : Expr Nat)
    (hb : transparentBody E r ls = some f)
    (hTy : ∀ T, inferT E n [] (.app (.const r ls) arg) = some T →
      inferT E n [] (.app f arg) = some T)
    (hGood : Good progs E n (.app f arg)) :
    Good progs E n (.app (.const r ls) arg) := by
  intro lf fv T v t w hB hi1 hD hn1 hs hrel hirrv hf hvinf her1
  refine lowerF_eventual_of_exists progs E n t (.app (.const r ls) arg) w ?_
  have hirr1 : irrelevant E n [] (.app (.const r ls) arg) = false :=
    irrelevant_false_of_same_type hi1 hvinf hirrv
  have hirrC : irrelevant E n [] (.const r ls) = false :=
    irrelevant_fun_false_of_app_irr hi1 hirr1
  have hi2 : inferT E n [] (.app f arg) = some T := hTy T hi1
  have hirr2 : irrelevant E n [] (.app f arg) = false :=
    irrelevant_false_of_same_type hi2 hvinf hirrv
  obtain ⟨herC, herA⟩ := erasable_of_app_keep hirr1 her1.1
  have herF : Erasable E n f := erasable_of_const_delta hirrC hb herC
  obtain ⟨Ff, lf_er, hf_er⟩ := herF
  obtain ⟨Fa, la_er, ha_er⟩ := herA
  have her2 : Erasable E n (.app f arg) := by
    refine ⟨Ff + Fa + 1, .app lf_er la_er, ?_⟩
    rw [erase_app_keep E n (Ff + Fa) [] f arg hirr2,
        erase_mono E n Ff (Ff + Fa) [] f lf_er (Nat.le_add_right Ff Fa) hf_er,
        erase_mono E n Fa (Ff + Fa) [] arg la_er (Nat.le_add_left Fa Ff) ha_er]
  have hstep : whnfStep E (.app (.const r ls) arg) = some (.app f arg) := by
    simp only [whnfStep, appsSpine, List.nil_append, hb]
    rfl
  have hn2 : norm E lf (.app f arg) = some v :=
    norm_of_whnf_steps E 1 lf (.app (.const r ls) arg) (.app f arg) v
      (fun m => whnf_delta_spine E m r ls f [arg] hb) hn1
  have hnorm2 : NormErasable E n lf (.app f arg) :=
    normErasable_of_whnfStep hstep hn1 her1.2
  obtain ⟨G, hF⟩ := hGood lf fv T v t w hB hi2 hD hn2 hs hrel hirrv hf hvinf ⟨her2, hnorm2⟩
  obtain ⟨lfe, hev⟩ := hF (G + 1) (Nat.le_succ G)
  unfold lowerF pipeline at hev
  rw [erase_app_keep E n G [] f arg hirr2] at hev
  cases hfe : erase E n G [] f with
  | none =>
      simp only [hfe] at hev
      exact absurd hev (eval_refuse_ne progs lfe [] w)
  | some lfe_f =>
      cases hae : erase E n G [] arg with
      | none =>
          simp only [hfe, hae] at hev
          exact absurd hev (eval_refuse_ne progs lfe [] w)
      | some lfe_a =>
          simp only [hfe, hae] at hev
          cases hr : run (defunc (.app lfe_f lfe_a)).2 (G + 1) [] (defunc (.app lfe_f lfe_a)).1 with
          | none =>
              simp only [hr] at hev
              exact absurd hev (eval_refuse_ne progs lfe [] w)
          | some dv =>
              simp only [hr] at hev
              have he1 : erase E n (G + 2) [] (.app (.const r ls) arg) =
                  some (.app lfe_f lfe_a) :=
                erase_app_const_delta E n G r ls f arg lfe_f lfe_a hb hirr1 hirrC hfe hae
              have hr2 : run (defunc (.app lfe_f lfe_a)).2 (G + 2) []
                  (defunc (.app lfe_f lfe_a)).1 = some dv :=
                run_mono (defunc (.app lfe_f lfe_a)).2 (G + 1) (G + 2) []
                  (defunc (.app lfe_f lfe_a)).1 dv (Nat.le_succ (G + 1)) hr
              have hev2 : Residua.Bootstrap.Semantics.eval lawsA progs lfe []
                  (lowerF E n (G + 2) (S := S) t (.app (.const r ls) arg)) = some w := by
                rw [lowerF_eq_of_erase_run E n (G + 2) t (.app (.const r ls) arg)
                  (.app lfe_f lfe_a) dv he1 hr2]
                exact emitWith_evalStable relevantArgs progs lfe [] (G + 1) (G + 2) t dv w
                  (Nat.le_succ (G + 1)) hev
              exact ⟨G + 2, lfe, hev2⟩

theorem good_beta_ctor_of_good_arg {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (A arg : Expr Nat)
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (hDA : DataTy E A)
    (hGood : Good progs E n arg) :
    Good progs E n (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) := by
  intro lf fv T v t w hB hi hDT hn hs hrel hirrv hf hvinf her
  have hirr : irrelevant E n []
      (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have herArg : Erasable E n arg := (erasable_of_app_keep hirr her.1).2
  have hstep : whnfStep E (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) =
      some (.app (.const c lsc) arg) := rfl
  refine good_beta_ctor_of_eval_wf progs E n c lsc A arg hE hnone ?_
    lf fv T v t w hB hi hDT hn hs hrel hirrv hf hvinf her
  intro lf' fv' varg τ wfield hargn hfield hrel1 hirrF hf'
  obtain ⟨k, varg0, hlf, hargn0, hv⟩ :=
    norm_beta_ctor_arg_of_norm E lf c lsc A arg v hnone hn
  have hvinf' : inferT E n [] (.app (.const c lsc) varg0) = some T := hv ▸ hvinf
  obtain ⟨harg_ty, hvarg0_ty⟩ := inferT_beta_ctor_arg hE hi hvinf'
  have hvarg_eq : varg = varg0 := norm_unique E lf' _ arg varg varg0 hargn hargn0
  have hvarg_ty : inferT E n [] varg = some A := hvarg_eq ▸ hvarg0_ty
  have hn_app : NormErasable E n (k + 3) (.app (.const c lsc) arg) :=
    normErasable_of_whnfStep hstep (hlf ▸ hn) (hlf ▸ her.2)
  have hnArg : NormErasable E n (k + 2) arg :=
    normErasable_of_app_ctor hnone hn_app
  obtain ⟨G, hF⟩ :=
    hGood (k + 2) fv' A varg τ wfield hB harg_ty hDA (hvarg_eq ▸ hargn0)
      hfield hrel1 hirrF hf' hvarg_ty ⟨herArg, hnArg⟩
  obtain ⟨lfe, he⟩ := hF G (Nat.le_refl G)
  exact ⟨G, lfe, he⟩

theorem good_let_ctor_of_good_arg {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c : Nat) (lsc : List Level) (A arg : Expr Nat)
    (hE : EnvClosed E)
    (hnone : transparentBody E c lsc = none)
    (hDA : DataTy E A)
    (hGood : Good progs E n arg) :
    Good progs E n (.letE A arg (.app (.const c lsc) (.bvar 0))) := by
  intro lf fv T v t w hB hi hDT hn hs hrel hirrv hf hvinf her
  have hirr : irrelevant E n []
      (.letE A arg (.app (.const c lsc) (.bvar 0))) = false :=
    irrelevant_false_of_same_type hi hvinf hirrv
  have herArg : Erasable E n arg := erasable_of_let_keep hirr her.1
  have hiBeta : inferT E n [] (.app (.lam A (.app (.const c lsc) (.bvar 0))) arg) = some T := by
    rw [← inferT_let_eq_beta E n [] A arg (.app (.const c lsc) (.bvar 0))]
    exact hi
  have hstep : whnfStep E (.letE A arg (.app (.const c lsc) (.bvar 0))) =
      some (.app (.const c lsc) arg) := rfl
  refine good_let_ctor_of_eval_wf progs E n c lsc A arg hE hnone ?_
    lf fv T v t w hB hi hDT hn hs hrel hirrv hf hvinf her
  intro lf' fv' varg τ wfield hargn hfield hrel1 hirrF hf'
  obtain ⟨k, varg0, hlf, hargn0, hv⟩ :=
    norm_let_ctor_arg_of_norm E lf c lsc A arg v hnone hn
  have hvinf' : inferT E n [] (.app (.const c lsc) varg0) = some T := hv ▸ hvinf
  obtain ⟨harg_ty, hvarg0_ty⟩ := inferT_beta_ctor_arg hE hiBeta hvinf'
  have hvarg_eq : varg = varg0 := norm_unique E lf' _ arg varg varg0 hargn hargn0
  have hvarg_ty : inferT E n [] varg = some A := hvarg_eq ▸ hvarg0_ty
  have hn_app : NormErasable E n (k + 3) (.app (.const c lsc) arg) :=
    normErasable_of_whnfStep hstep (hlf ▸ hn) (hlf ▸ her.2)
  have hnArg : NormErasable E n (k + 2) arg :=
    normErasable_of_app_ctor hnone hn_app
  obtain ⟨G, hF⟩ :=
    hGood (k + 2) fv' A varg τ wfield hB harg_ty hDA (hvarg_eq ▸ hargn0)
      hfield hrel1 hirrF hf' hvarg_ty ⟨herArg, hnArg⟩
  obtain ⟨lfe, he⟩ := hF G (Nat.le_refl G)
  exact ⟨G, lfe, he⟩

/-! ### Full per-construct adequacy closure (`adeqConstDelta`, `adeqConst`,
    `adeqApp`, `adeqLetE`, `lowerF_adequacyClosed`, 8/8 constructs) and
    compositional proofs of all 14 `ctlEnv` positive controls -/

theorem good_at_of_whnfStep {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {n k fv : Nat} {e1 e2 T v : Expr Nat} {t : BootTy} {w : Val}
    (hE : EnvClosed E)
    (hB : BodiesTyped E n)
    (hi1 : inferT E n [] e1 = some T)
    (hD : DataTy E T)
    (hn1 : norm E (k + 2) e1 = some v)
    (hs : scmValOf E fv v = some w)
    (hrel : relevantSpine E n fv v = true)
    (hirrv : irrelevant E n [] v = false)
    (hf : valFits fv t w = true)
    (hvinf : inferT E n [] v = some T)
    (her1 : TraceErasable E n (k + 2) e1)
    (hstep : whnfStep E e1 = some e2)
    (hTy : inferT E n [] e2 = some T)
    (hStepL : StepEvalL E n e1 e2) :
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e1) = some w := by
  refine lowerF_eventual_of_exists progs E n t e1 w ?_
  have _hB : BodiesTyped E n := hB
  have _hArity : isArity T = false := isArity_false_of_dataTy E hD
  have hn2 : norm E (k + 2) e2 = some v :=
    norm_of_whnf_steps E 1 (k + 2) e1 e2 v
      (fun m => whnfFuel_of_whnfStep hstep m) hn1
  have hnorm2 : NormErasable E n (k + 2) e2 :=
    normErasable_of_whnfStep hstep hn1 her1.2
  obtain ⟨Fv, hev_v⟩ :=
    eval_lowerF_of_scmValOf (S := S) progs E n fv v T t w hvinf hs hrel hirrv hf
  obtain ⟨lv, dv, he_v, hr_v, _, hemit_v⟩ :=
    lowerF_eval_inv progs E n Fv 1 t v w hev_v
  have hp_lv : passive lv = true :=
    passive_erase_of_scmValOf hs he_v
  have hsim_v : (evalL Fv [] lv).bind lToD = some dv := by
    rw [evalL_run_passive_nil Fv lv hp_lv]
    exact hr_v
  cases hevL_v : evalL Fv [] lv with
  | none =>
      rw [hevL_v] at hsim_v
      exact Option.noConfusion hsim_v
  | some vL =>
      rw [hevL_v] at hsim_v
      change lToD vL = some dv at hsim_v
      have hnc : noClo vL = true := noClo_of_lToD vL dv hsim_v
      have hstep2 : StepEvalL E n e2 v :=
        norm_stepEvalL hE hTy hn2 hs hirrv hvinf hnorm2
      have hstep1 : StepEvalL E n e1 v :=
        stepEvalL_trans hStepL hstep2
      obtain ⟨Fe0, le, he_e0, hevL_e0⟩ :=
        hstep1 Fv lv vL he_v hevL_v hnc
      have hr_e0 : run (defunc le).2 Fe0 [] (defunc le).1 = some dv :=
        evalL_run_defunc Fe0 le vL dv
          (noGlobL_erase E n Fe0 [] e1 le he_e0) hevL_e0 hsim_v
      have he_e : erase E n (Fe0 + Fv) [] e1 = some le :=
        erase_mono E n Fe0 (Fe0 + Fv) [] e1 le (Nat.le_add_right Fe0 Fv) he_e0
      have hr_e : run (defunc le).2 (Fe0 + Fv) [] (defunc le).1 = some dv :=
        run_mono (defunc le).2 Fe0 (Fe0 + Fv) [] (defunc le).1 dv
          (Nat.le_add_right Fe0 Fv) hr_e0
      refine ⟨Fe0 + Fv, 1, ?_⟩
      rw [lowerF_eq_of_erase_run E n (Fe0 + Fv) t e1 le dv he_e hr_e]
      exact emitWith_evalStable relevantArgs progs 1 [] Fv (Fe0 + Fv) t dv w
        (Nat.le_add_left Fv Fe0) hemit_v

theorem adeqConstDelta {S : SigTable} (progs : Programs S S) : AdeqConstDelta progs := by
  intro E n r ls b hWf hb lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hwhnf : WhnfErasable E n (k + 1) (.const r ls) := her.2.1
          simp only [WhnfErasable, appsSpine, hb] at hwhnf
          exact good_const_delta_of_good_body progs E n r ls b hb hwhnf.1
            (good_of_envWf progs E n b hWf)
            (k + 2) fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem adeqConst {S : SigTable} (progs : Programs S S) : AdeqConst progs :=
  adeqConst_of_split progs (adeqConstHead progs) (adeqConstDelta progs)

theorem adeqLetE {S : SigTable} (progs : Programs S S) : AdeqLetE progs := by
  intro E n A x b hWf lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hstep : whnfStep E (.letE A x b) = some (instantiate0 x b) := rfl
          have hTy : inferT E n [] (instantiate0 x b) = some T :=
            inferT_zeta_spine_some (args := []) hWf.1 hi
          have hwhnf : WhnfErasable E n (k + 1) (.letE A x b) := her.2.1
          simp only [WhnfErasable, appsSpine, foldApps] at hwhnf
          exact good_at_of_whnfStep progs hWf.1 hB hi hD hn hs hrel hirrv hf hvinf her
            hstep hTy hwhnf.1

theorem adeqApp {S : SigTable} (progs : Programs S S) : AdeqApp progs := by
  intro E n f a hWf lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
  cases lf with
  | zero => exact Option.noConfusion hn
  | succ lf1 =>
      cases lf1 with
      | zero =>
          unfold norm at hn
          rw [whnfFuel_fuel0] at hn
          exact Option.noConfusion hn
      | succ k =>
          have hwhnf : WhnfErasable E n (k + 1) (.app f a) := her.2.1
          unfold WhnfErasable at hwhnf
          have hstep_def : whnfStep E (.app f a) =
              match appsSpine (.app f a) with
              | (.lam _ b, a0 :: args) => some (foldApps (instantiate0 a0 b) args)
              | (.letE _ x b, args) => some (foldApps (instantiate0 x b) args)
              | (.const r ls, args) =>
                  match transparentBody E r ls with
                  | some body => some (foldApps body args)
                  | none => none
              | _ => none := rfl
          generalize hsp : appsSpine (.app f a) = sp at hwhnf hstep_def
          have hfold : foldApps sp.1 sp.2 = .app f a := by
            rw [← hsp]
            exact foldApps_appsSpine (.app f a)
          rcases sp with ⟨hd, args⟩
          cases hd with
          | lam A b =>
              cases args with
              | nil =>
                  exact good_of_envWf progs E n (.app f a) hWf
                    (k + 2) fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
              | cons a0 as =>
                  simp only at hwhnf hstep_def
                  have hTy : inferT E n [] (foldApps (instantiate0 a0 b) as) = some T :=
                    inferT_beta_spine_some hWf.1 (hfold.symm ▸ hi)
                  exact good_at_of_whnfStep progs hWf.1 hB hi hD hn hs hrel hirrv hf hvinf her
                    hstep_def hTy hwhnf.1
          | letE A x b =>
              simp only at hwhnf hstep_def
              have hTy : inferT E n [] (foldApps (instantiate0 x b) args) = some T :=
                inferT_zeta_spine_some hWf.1 (hfold.symm ▸ hi)
              exact good_at_of_whnfStep progs hWf.1 hB hi hD hn hs hrel hirrv hf hvinf her
                hstep_def hTy hwhnf.1
          | const r ls =>
              simp only at hwhnf hstep_def
              cases htb : transparentBody E r ls with
              | none =>
                  exact good_of_envWf progs E n (.app f a) hWf
                    (k + 2) fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her
              | some body =>
                  rw [htb] at hwhnf hstep_def
                  have hTy : inferT E n [] (foldApps body args) = some T :=
                    inferT_delta_spine_some hwhnf.1 (hfold.symm ▸ hi)
                  have hirre : irrelevant E n [] (.app f a) = false :=
                    irrelevant_false_of_same_type hi hvinf hirrv
                  have hStepL : StepEvalL E n (.app f a) (foldApps body args) := by
                    rw [← hfold]
                    exact stepEvalL_delta_spine E n r ls body args htb hwhnf.1
                      (hfold.symm ▸ hi) (hfold.symm ▸ hirre)
                  exact good_at_of_whnfStep progs hWf.1 hB hi hD hn hs hrel hirrv hf hvinf her
                    hstep_def hTy hStepL
          | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
              exact good_of_envWf progs E n (.app f a) hWf
                (k + 2) fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem lowerF_adequacyClosed {S : SigTable} (progs : Programs S S) :
    adequacyClosed (S := S) progs :=
  adequacy_of_constructs progs
    (adeqBvar progs) (adeqSort progs) (adeqConst progs) (adeqApp progs)
    (adeqLam progs) (adeqPi progs) (adeqLetE progs) (adeqLit progs)

theorem good_ctl_g01 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g01 :=
  adeqLit progs ctlEnv 0 5

theorem good_ctl_g02 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g02 :=
  adeqConstHead progs ctlEnv 0 1 [] rfl

theorem good_ctl_g03 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g03 :=
  good_app_ctor_lit_any progs ctlEnv 0 2 4 [] rfl

theorem good_ctl_g04 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g04 :=
  good_beta_ctor_lit_wf progs ctlEnv 0 2 4 [] cN ctlEnv_closed rfl

theorem good_ctl_g05 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g05 :=
  good_let_ctor_lit_wf progs ctlEnv 0 2 7 [] cN ctlEnv_closed rfl

theorem good_ctl_one {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 (.app cSucc cZero) := by
  refine good_app_ctor_of_good_arg progs ctlEnv 0 2 [] cZero rfl ?_
    (good_ctl_g02 progs)
  intro A h
  have h0 : inferT ctlEnv 0 [] cZero = some cN := rfl
  rw [h0] at h
  cases h
  exact ctlNData

theorem good_ctl_two {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 (.app cSucc (.app cSucc cZero)) := by
  refine good_app_ctor_of_good_arg progs ctlEnv 0 2 [] (.app cSucc cZero) rfl ?_
    (good_ctl_one progs)
  intro A h
  have h1 : inferT ctlEnv 0 [] (.app cSucc cZero) = some cN := rfl
  rw [h1] at h
  cases h
  exact ctlNData

theorem good_ctl_g06 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g06 := by
  refine good_const_delta_of_good_body progs ctlEnv 0 11 []
    (.app cSucc (.app cSucc cZero)) rfl ?_ (good_ctl_two progs)
  intro T h
  have h11 : inferT ctlEnv 0 [] (.const 11 []) = some cN := rfl
  rw [h11] at h
  cases h
  rfl

theorem good_ctl_g11 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g11 :=
  adeqConstHead progs ctlEnv 0 8 [] rfl

theorem good_ctl_g07 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g07 :=
  good_beta_discard_irr_any progs ctlEnv 0 3 cTrue cIntro rfl
    (fun k => const_ne_lit 5 k [])

theorem good_ctl_g08 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g08 := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 2 6 1 g08 (.lit 9)
    (.app (.app (.lam (.lam (.bvar 0))) .box) (.lit 9)) (.lit 9) (.lit 9)
    rfl ?_ rfl rfl rfl rfl (adeqLit progs ctlEnv 0 9)
  intro T h
  have h8 : inferT ctlEnv 0 [] g08 = some cN := rfl
  rw [h8] at h
  cases h
  rfl

theorem good_ctl_g09 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g09 := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 2 6 3 g09
    (.app cSucc (.lit 1))
    (.app (.lam (.app (.bvar 0) (.lit 1))) (.lam (.app (.ctor 2) (.bvar 0))))
    (.app (.ctor 2) (.lit 1)) (.ctor 2 [.lit 1])
    rfl ?_ rfl rfl rfl rfl
    (good_app_ctor_lit_any progs ctlEnv 0 2 1 [] rfl)
  intro T h
  have h9 : inferT ctlEnv 0 [] g09 = some cN := rfl
  rw [h9] at h
  cases h
  rfl

theorem good_ctl_g10 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g10 := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 2 8 4 g10
    (.app (.app cMk (.lit 2)) (.lit 1))
    (.app (.app (.lam (.lam (.app (.app (.ctor 10) (.bvar 0)) (.bvar 1))))
      (.lit 1)) (.lit 2))
    (.app (.app (.ctor 10) (.lit 2)) (.lit 1))
    (.ctor 10 [.lit 2, .lit 1])
    rfl ?_ rfl rfl rfl rfl
    (good_app_ctor2_lit_any progs ctlEnv 0 10 2 1 [] rfl)
  intro T h
  have h10 : inferT ctlEnv 0 [] g10 = some (.const 9 []) := rfl
  rw [h10] at h
  cases h
  rfl

theorem good_ctl_succ_succ_lit0 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 (.app cSucc (.app cSucc (.lit 0))) := by
  refine good_app_ctor_of_good_arg progs ctlEnv 0 2 [] (.app cSucc (.lit 0)) rfl ?_
    (good_app_ctor_lit_any progs ctlEnv 0 2 0 [] rfl)
  intro A h
  have h1 : inferT ctlEnv 0 [] (.app cSucc (.lit 0)) = some cN := rfl
  rw [h1] at h
  cases h
  exact ctlNData

theorem good_ctl_g12_body {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0
      (.app (.lam cN (.app cSucc (.app cSucc (.bvar 0)))) (.lit 0)) := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 1 6 4
    (.app (.lam cN (.app cSucc (.app cSucc (.bvar 0)))) (.lit 0))
    (.app cSucc (.app cSucc (.lit 0)))
    (.app (.lam (.app (.ctor 2) (.app (.ctor 2) (.bvar 0)))) (.lit 0))
    (.app (.ctor 2) (.app (.ctor 2) (.lit 0)))
    (.ctor 2 [.ctor 2 [.lit 0]])
    rfl ?_ rfl rfl rfl rfl
    (good_ctl_succ_succ_lit0 progs)
  intro T h
  have h12 : inferT ctlEnv 0 []
      (.app (.lam cN (.app cSucc (.app cSucc (.bvar 0)))) (.lit 0)) = some cN := rfl
  rw [h12] at h
  cases h
  rfl

theorem good_ctl_g12 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g12 := by
  refine good_app_const_delta_of_good progs ctlEnv 0 12 []
    (.lam cN (.app cSucc (.app cSucc (.bvar 0)))) (.lit 0) rfl ?_
    (good_ctl_g12_body progs)
  intro T h
  have h12 : inferT ctlEnv 0 [] (.app (.const 12 []) (.lit 0)) = some cN := rfl
  rw [h12] at h
  cases h
  rfl

theorem good_ctl_g13_reduct {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0
      (.app cSucc (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0))) := by
  refine good_app_ctor_of_good_arg progs ctlEnv 0 2 []
    (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0)) rfl ?_
    (good_beta_ctor_lit_wf progs ctlEnv 0 2 0 [] cN ctlEnv_closed rfl)
  intro A h
  have h1 : inferT ctlEnv 0 []
      (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0)) = some cN := rfl
  rw [h1] at h
  cases h
