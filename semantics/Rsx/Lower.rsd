  rfl

/-! ### Two-step universe-conversion flip under `EnvWf` with `inferT E n [] v = some T`
    (`convFlip2Env`, `not_adeqAppWfSameTy`, `not_adeqLetEWfSameTy`,
    `not_adeqConstDeltaWfSameTy`) -/

def vfD : CheckedMember := ⟨.definitionM, 0, .const 0 [lvl00], some (.const 2 [])⟩

def convFlip2Env : ResolvedEnv where
  members := fun r =>
    match r with
    | 0 => some vfI
    | 1 => some vfK
    | 2 => some vfC
    | 3 => some vfD
    | _ => none

def vfDelta2 : Expr Nat := .const 3 []
def vfLam2 : Expr Nat := .lam vfValTy (.bvar 0)
def vfApp2 : Expr Nat := .app vfLam2 vfDelta2
def vfLet2 : Expr Nat := .letE vfValTy vfDelta2 (.bvar 0)

theorem convFlip2Env_closed : EnvClosed convFlip2Env := by
  intro r m hm
  match r, hm with
  | 0, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 1, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 2, hm =>
      cases hm
      exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | 3, hm =>
      cases hm
      exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | _ + 4, hm => exact Option.noConfusion hm

theorem vf2Val_ty : inferT convFlip2Env 0 [] vfVal = some vfValTy := rfl
theorem vf2Ty_infer : inferT convFlip2Env 0 [] vfTy = some (.sort .zero) := rfl
theorem vf2ValTy_infer : inferT convFlip2Env 0 [] vfValTy = some (.sort lvl00) := rfl
theorem vf2Delta_infer : inferT convFlip2Env 0 [] vfDelta = some vfTy := rfl
theorem vf2Delta2_infer : inferT convFlip2Env 0 [] vfDelta2 = some vfValTy := rfl
theorem vf2App2_infer : inferT convFlip2Env 0 [] vfApp2 = some vfValTy := rfl
theorem vf2Let2_infer : inferT convFlip2Env 0 [] vfLet2 = some vfValTy := rfl

def vf2KTy : HasTyT convFlip2Env 0 [] vfVal vfValTy :=
  hasTyT_of_inferT vf2Val_ty

def vf2IConv : ConvT convFlip2Env 0 [] vfValTy vfTy (.sort lvl00) :=
  .consts [] 0 [lvl00] [.zero] vfI rfl rfl rfl rfl ⟨lvl00_eqN, True.intro⟩

def vf2CBodyTy : HasTyT convFlip2Env 0 [] vfVal vfTy :=
  .conv [] vfVal vfValTy vfTy lvl00 vf2KTy vf2IConv

def vf2CTy : HasTyT convFlip2Env 0 [] vfDelta vfTy :=
  hasTyT_of_inferT vf2Delta_infer

def vf2DBodyTy : HasTyT convFlip2Env 0 [] vfDelta vfValTy :=
  .conv [] vfDelta vfTy vfValTy lvl00 vf2CTy (.symm [] vfValTy vfTy (.sort lvl00) vf2IConv)

theorem convFlip2Env_wf : EnvWf convFlip2Env := by
  refine ⟨convFlip2Env_closed, ?_⟩
  intro r m hm
  match r, hm with
  | 0, hm =>
      cases hm
      exact ⟨⟨.succ (.param 0), ⟨hasTyT_of_inferT rfl⟩⟩, fun _ hb => nomatch hb⟩
  | 1, hm =>
      cases hm
      exact ⟨⟨lvl00, ⟨hasTyT_of_inferT rfl⟩⟩, fun _ hb => nomatch hb⟩
  | 2, hm =>
      cases hm
      refine ⟨⟨.zero, ⟨hasTyT_of_inferT rfl⟩⟩, fun b hb => ?_⟩
      cases hb
      exact ⟨vf2CBodyTy⟩
  | 3, hm =>
      cases hm
      refine ⟨⟨lvl00, ⟨hasTyT_of_inferT rfl⟩⟩, fun b hb => ?_⟩
      cases hb
      exact ⟨vf2DBodyTy⟩
  | _ + 4, hm => exact Option.noConfusion hm

theorem vf2Bodies : BodiesTyped convFlip2Env 0 := by
  intro r m b ls hm _ hb hlen _
  match r, hm with
  | 0, hm => cases hm; cases hb
  | 1, hm => cases hm; cases hb
  | 2, hm =>
      cases hm
      cases hb
      cases ls with
      | nil => exact ⟨vf2CBodyTy⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 3, hm =>
      cases hm
      cases hb
      cases ls with
      | nil => exact ⟨vf2DBodyTy⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | _ + 4, hm => exact Option.noConfusion hm

theorem vf2Data : DataTy convFlip2Env vfValTy :=
  ⟨0, [lvl00], [], vfI, rfl, rfl, rfl⟩

theorem vf2Delta2_tb : transparentBody convFlip2Env 3 [] = some vfDelta := rfl
theorem vf2Delta2_norm : norm convFlip2Env 4 vfDelta2 = some vfVal := rfl
theorem vf2App2_norm : norm convFlip2Env 5 vfApp2 = some vfVal := rfl
theorem vf2Let2_norm : norm convFlip2Env 5 vfLet2 = some vfVal := rfl
theorem vf2Val_scm : scmValOf convFlip2Env 1 vfVal = some (.inj 1 (.list [])) := rfl
theorem vf2Val_spine : relevantSpine convFlip2Env 0 1 vfVal = true := rfl
theorem vf2Val_rel : irrelevant convFlip2Env 0 [] vfVal = false := rfl

theorem vf2Delta2_er : Erasable convFlip2Env 0 vfDelta2 := ⟨2, .box, rfl⟩
theorem vf2App2_er : Erasable convFlip2Env 0 vfApp2 :=
  ⟨3, .app (.lam (.bvar 0)) .box, rfl⟩
theorem vf2Let2_er : Erasable convFlip2Env 0 vfLet2 :=
  ⟨3, .letE .box (.bvar 0), rfl⟩

theorem emit_box_eq_refuse {S : SigTable} {G : Ctx} (F : Nat) (t : BootTy) :
    emit (S := S) (G := G) F t .box = refuse := by
  cases F <;> cases t <;> rfl

theorem eval_lowerF_ne_of_erase_run_box {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n F₀ : Nat) (t : BootTy) (e : Expr Nat) (l : LExpr) (w : Val)
    (he : erase E n F₀ [] e = some l)
    (hr : run (defunc l).2 F₀ [] (defunc l).1 = some .box)
    (F lf : Nat) (hF : F₀ ≤ F) :
    Residua.Bootstrap.Semantics.eval lawsA progs lf [] (lowerF E n F (S := S) t e) ≠ some w := by
  rw [lowerF_eq_of_erase_run E n F t e l .box
    (erase_mono E n F₀ F [] e l hF he)
    (run_mono (defunc l).2 F₀ F [] (defunc l).1 .box hF hr),
    emit_box_eq_refuse F t]
  exact eval_refuse_ne progs lf [] w

def AdeqAppWfSameTy {S : SigTable} (progs : Programs S S) : Prop :=
  ∀ E n f a, EnvWf E → GoodWfSameTy progs E n (.app f a)

def AdeqLetEWfSameTy {S : SigTable} (progs : Programs S S) : Prop :=
  ∀ E n A v b, EnvWf E → GoodWfSameTy progs E n (.letE A v b)

def AdeqConstDeltaWfSameTy {S : SigTable} (progs : Programs S S) : Prop :=
  ∀ E n r ls b, EnvWf E →
    transparentBody E r ls = some b → GoodWfSameTy progs E n (.const r ls)

theorem not_adeqAppWfSameTy {S : SigTable} (progs : Programs S S) :
    ¬ AdeqAppWfSameTy progs := by
  intro h
  obtain ⟨F₀, hF⟩ := h convFlip2Env 0 vfLam2 vfDelta2 convFlip2Env_wf 5 1 vfValTy vfVal
      (sumL 2 .i64) (.inj 1 (.list [])) vf2Bodies vf2App2_infer vf2Data
      vf2App2_norm vf2Val_scm vf2Val_spine vf2Val_rel vfFits
      vf2Val_ty vf2App2_er
  obtain ⟨lf, he⟩ := hF (F₀ + 3) (Nat.le_add_right F₀ 3)
  exact eval_lowerF_ne_of_erase_run_box progs convFlip2Env 0 3 (sumL 2 .i64) vfApp2
    (.app (.lam (.bvar 0)) .box) (.inj 1 (.list [])) rfl rfl
    (F₀ + 3) lf (Nat.le_add_left 3 F₀) he

theorem not_adeqLetEWfSameTy {S : SigTable} (progs : Programs S S) :
    ¬ AdeqLetEWfSameTy progs := by
  intro h
  obtain ⟨F₀, hF⟩ := h convFlip2Env 0 vfValTy vfDelta2 (.bvar 0) convFlip2Env_wf 5 1 vfValTy
      vfVal (sumL 2 .i64) (.inj 1 (.list [])) vf2Bodies vf2Let2_infer vf2Data
      vf2Let2_norm vf2Val_scm vf2Val_spine vf2Val_rel vfFits
      vf2Val_ty vf2Let2_er
  obtain ⟨lf, he⟩ := hF (F₀ + 3) (Nat.le_add_right F₀ 3)
  exact eval_lowerF_ne_of_erase_run_box progs convFlip2Env 0 3 (sumL 2 .i64) vfLet2
    (.letE .box (.bvar 0)) (.inj 1 (.list [])) rfl rfl
    (F₀ + 3) lf (Nat.le_add_left 3 F₀) he

theorem not_adeqConstDeltaWfSameTy {S : SigTable} (progs : Programs S S) :
    ¬ AdeqConstDeltaWfSameTy progs := by
  intro h
  obtain ⟨F₀, hF⟩ := h convFlip2Env 0 3 [] vfDelta convFlip2Env_wf vf2Delta2_tb 4 1 vfValTy
      vfVal (sumL 2 .i64) (.inj 1 (.list [])) vf2Bodies vf2Delta2_infer vf2Data
      vf2Delta2_norm vf2Val_scm vf2Val_spine vf2Val_rel vfFits
      vf2Val_ty vf2Delta2_er
  obtain ⟨lf, he⟩ := hF (F₀ + 2) (Nat.le_add_right F₀ 2)
  exact eval_lowerF_ne_of_erase_run_box progs convFlip2Env 0 2 (sumL 2 .i64) vfDelta2
    .box (.inj 1 (.list [])) rfl rfl
    (F₀ + 2) lf (Nat.le_add_left 2 F₀) he

theorem vfDelta2_not_normErasable : ¬ NormErasable convFlip2Env 0 4 vfDelta2 := by
  rintro ⟨⟨hTy, _⟩, _⟩
  have h1 : inferT convFlip2Env 0 [] vfDelta = some vfValTy := hTy vfValTy rfl
  rw [vf2Delta_infer] at h1
  exact absurd h1 (by decide)

theorem vfApp2_not_normErasable : ¬ NormErasable convFlip2Env 0 5 vfApp2 := by
  rintro ⟨⟨_, hTy, _⟩, _⟩
  have h1 : inferT convFlip2Env 0 [] vfDelta = some vfValTy := hTy vfValTy rfl
  rw [vf2Delta_infer] at h1
  exact absurd h1 (by decide)

theorem vfLet2_not_normErasable : ¬ NormErasable convFlip2Env 0 5 vfLet2 := by
  rintro ⟨⟨_, hTy, _⟩, _⟩
  have h1 : inferT convFlip2Env 0 [] vfDelta = some vfValTy := hTy vfValTy rfl
  rw [vf2Delta_infer] at h1
  exact absurd h1 (by decide)

theorem vfDelta2_not_traceErasable : ¬ TraceErasable convFlip2Env 0 4 vfDelta2 :=
  fun h => vfDelta2_not_normErasable h.2

theorem vfApp2_not_traceErasable : ¬ TraceErasable convFlip2Env 0 5 vfApp2 :=
  fun h => vfApp2_not_normErasable h.2

theorem vfLet2_not_traceErasable : ¬ TraceErasable convFlip2Env 0 5 vfLet2 :=
  fun h => vfLet2_not_normErasable h.2

/-! ### Decidable `rsx -> scm` source certification (`checkRsxCert`,
    `checkRsxCert_sound`, `checkRsxCert_sound_via_adequacyClosed`,
    `walkExprConstructs`, `certifyBatch`, `allCertified_sound`) and
    positive/negative controls (`P1-SOURCE-CERT-CLOSE` `rsx -> scm` layer) -/

def isDataTy (E : ResolvedEnv) (T : Expr Nat) : Bool :=
  match appsSpine T with
  | (.const r _, _) =>
      match E.members r with
      | some m => decide (m.mclass = .inductiveM)
      | none => false
  | _ => false

theorem dataTy_of_isDataTy {E : ResolvedEnv} {T : Expr Nat}
    (h : isDataTy E T = true) : DataTy E T := by
  unfold isDataTy at h
  generalize hsp : appsSpine T = sp at h
  rcases sp with ⟨hd, args⟩
  cases hd with
  | const r ls =>
      simp only at h
      cases hm : E.members r with
      | none =>
          rw [hm] at h
          exact Bool.noConfusion h
      | some m =>
          rw [hm] at h
          simp only [decide_eq_true_eq] at h
          exact ⟨r, ls, args, m, hsp, hm, h⟩
  | bvar _ | sort _ | app _ _ | lam _ _ | pi _ _ | letE _ _ _ | lit _ =>
      exact Bool.noConfusion h

theorem isDataTy_of_dataTy {E : ResolvedEnv} {T : Expr Nat}
    (h : DataTy E T) : isDataTy E T = true := by
  rcases h with ⟨r, ls, args, m, hsp, hm, hmc⟩
  simp only [isDataTy, hsp, hm, hmc, decide_True]

mutual
def dvalEq : DVal → DVal → Bool
  | .box, b =>
      match b with
      | .box => true
      | _ => false
  | .lit k1, b =>
      match b with
      | .lit k2 => decide (k1 = k2)
      | _ => false
  | .ctor r1 xs1, b =>
      match b with
      | .ctor r2 xs2 => decide (r1 = r2) && dvalListEq xs1 xs2
      | _ => false
  | .rigid r1 xs1, b =>
      match b with
      | .rigid r2 xs2 => decide (r1 = r2) && dvalListEq xs1 xs2
      | _ => false
  | .clo l1 xs1, b =>
      match b with
      | .clo l2 xs2 => decide (l1 = l2) && dvalListEq xs1 xs2
      | _ => false

def dvalListEq : List DVal → List DVal → Bool
  | [], ys =>
      match ys with
      | [] => true
      | _ :: _ => false
  | x :: xs, ys =>
      match ys with
      | [] => false
      | y :: ys' => dvalEq x y && dvalListEq xs ys'
end

mutual
theorem dvalEq_eq : ∀ (a b : DVal), dvalEq a b = true → a = b
  | .box, b, h => by
      cases b with
      | box => rfl
      | lit _ | ctor _ _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .lit k1, b, h => by
      cases b with
      | lit k2 =>
          simp only [dvalEq, decide_eq_true_eq] at h
          exact congrArg DVal.lit h
      | box | ctor _ _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .ctor r1 xs1, b, h => by
      cases b with
      | ctor r2 xs2 =>
          simp only [dvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, dvalListEq_eq xs1 xs2 h.2]
      | box | lit _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .rigid r1 xs1, b, h => by
      cases b with
      | rigid r2 xs2 =>
          simp only [dvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, dvalListEq_eq xs1 xs2 h.2]
      | box | lit _ | ctor _ _ | clo _ _ => exact Bool.noConfusion h
  | .clo l1 xs1, b, h => by
      cases b with
      | clo l2 xs2 =>
          simp only [dvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, dvalListEq_eq xs1 xs2 h.2]
      | box | lit _ | ctor _ _ | rigid _ _ => exact Bool.noConfusion h

theorem dvalListEq_eq : ∀ (xs ys : List DVal), dvalListEq xs ys = true → xs = ys
  | [], ys, h => by
      cases ys with
      | nil => rfl
      | cons _ _ => exact Bool.noConfusion h
  | x :: xs, ys, h => by
      cases ys with
      | nil => exact Bool.noConfusion h
      | cons y ys' =>
          simp only [dvalListEq, Bool.and_eq_true] at h
          rw [dvalEq_eq x y h.1, dvalListEq_eq xs ys' h.2]
end

mutual
theorem dvalEq_self : ∀ (a : DVal), dvalEq a a = true
  | .box => rfl
  | .lit _ => by simp only [dvalEq, decide_True]
  | .ctor _ xs => by simp only [dvalEq, decide_True, Bool.true_and, dvalListEq_self xs]
  | .rigid _ xs => by simp only [dvalEq, decide_True, Bool.true_and, dvalListEq_self xs]
  | .clo _ xs => by simp only [dvalEq, decide_True, Bool.true_and, dvalListEq_self xs]

theorem dvalListEq_self : ∀ (xs : List DVal), dvalListEq xs xs = true
  | [] => rfl
  | x :: xs => by simp only [dvalListEq, dvalEq_self x, dvalListEq_self xs, Bool.and_self]
end

mutual
def lvalEq : LVal → LVal → Bool
  | .box, b =>
      match b with
      | .box => true
      | _ => false
  | .lit k1, b =>
      match b with
      | .lit k2 => decide (k1 = k2)
      | _ => false
  | .ctor r1 xs1, b =>
      match b with
      | .ctor r2 xs2 => decide (r1 = r2) && lvalListEq xs1 xs2
      | _ => false
  | .rigid r1 xs1, b =>
      match b with
      | .rigid r2 xs2 => decide (r1 = r2) && lvalListEq xs1 xs2
      | _ => false
  | .clo env1 b1, b =>
      match b with
      | .clo env2 b2 => decide (b1 = b2) && lvalListEq env1 env2
      | _ => false

def lvalListEq : List LVal → List LVal → Bool
  | [], ys =>
      match ys with
      | [] => true
      | _ :: _ => false
  | x :: xs, ys =>
      match ys with
      | [] => false
      | y :: ys' => lvalEq x y && lvalListEq xs ys'
end

mutual
theorem lvalEq_eq : ∀ (a b : LVal), lvalEq a b = true → a = b
  | .box, b, h => by
      cases b with
      | box => rfl
      | lit _ | ctor _ _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .lit k1, b, h => by
      cases b with
      | lit k2 =>
          simp only [lvalEq, decide_eq_true_eq] at h
          exact congrArg LVal.lit h
      | box | ctor _ _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .ctor r1 xs1, b, h => by
      cases b with
      | ctor r2 xs2 =>
          simp only [lvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, lvalListEq_eq xs1 xs2 h.2]
      | box | lit _ | rigid _ _ | clo _ _ => exact Bool.noConfusion h
  | .rigid r1 xs1, b, h => by
      cases b with
      | rigid r2 xs2 =>
          simp only [lvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, lvalListEq_eq xs1 xs2 h.2]
      | box | lit _ | ctor _ _ | clo _ _ => exact Bool.noConfusion h
  | .clo env1 b1, b, h => by
      cases b with
      | clo env2 b2 =>
          simp only [lvalEq, Bool.and_eq_true, decide_eq_true_eq] at h
          rw [h.1, lvalListEq_eq env1 env2 h.2]
      | box | lit _ | ctor _ _ | rigid _ _ => exact Bool.noConfusion h

theorem lvalListEq_eq : ∀ (xs ys : List LVal), lvalListEq xs ys = true → xs = ys
  | [], ys, h => by
      cases ys with
      | nil => rfl
      | cons _ _ => exact Bool.noConfusion h
  | x :: xs, ys, h => by
      cases ys with
      | nil => exact Bool.noConfusion h
      | cons y ys' =>
          simp only [lvalListEq, Bool.and_eq_true] at h
          rw [lvalEq_eq x y h.1, lvalListEq_eq xs ys' h.2]
end

mutual
theorem lvalEq_self : ∀ (a : LVal), lvalEq a a = true
  | .box => rfl
  | .lit _ => by simp only [lvalEq, decide_True]
  | .ctor _ xs => by simp only [lvalEq, decide_True, Bool.true_and, lvalListEq_self xs]
  | .rigid _ xs => by simp only [lvalEq, decide_True, Bool.true_and, lvalListEq_self xs]
  | .clo env _ => by simp only [lvalEq, decide_True, Bool.true_and, lvalListEq_self env]

theorem lvalListEq_self : ∀ (xs : List LVal), lvalListEq xs xs = true
  | [] => rfl
  | x :: xs => by simp only [lvalListEq, lvalEq_self x, lvalListEq_self xs, Bool.and_self]
end

theorem stepEvalL_of_evalL_eq {E : ResolvedEnv} {n F1 F2 : Nat}
    {e e' : Expr Nat} {le le' : LExpr} {vL : LVal}
    (he : erase E n F1 [] e = some le)
    (he' : erase E n F2 [] e' = some le')
    (hev : evalL F1 [] le = some vL)
    (hev' : evalL F2 [] le' = some vL) :
    StepEvalL E n e e' := by
  intro F' le1' vL' he1' hev1' _
  have hle : le1' = le' := erase_unique E n F' F2 [] e' le1' le' he1' he'
  rw [hle] at hev1'
  have hv : vL' = vL := evalL_unique F' F2 [] le' vL' vL hev1' hev'
  subst hv
  exact ⟨F1, le, he, hev⟩

def checkStepEvalL (E : ResolvedEnv) (n F : Nat) (e e' : Expr Nat) : Bool :=
  match erase E n F [] e, erase E n F [] e' with
  | some le, some le' =>
      match evalL F [] le, evalL F [] le' with
      | some ve, some ve' => lvalEq ve ve'
      | _, _ => false
  | _, _ => false

theorem stepEvalL_of_checkStepEvalL {E : ResolvedEnv} {n F : Nat} {e e' : Expr Nat}
    (h : checkStepEvalL E n F e e' = true) :
    StepEvalL E n e e' := by
  unfold checkStepEvalL at h
  cases he : erase E n F [] e with
  | none => simp only [he] at h; exact Bool.noConfusion h
  | some le =>
      cases he' : erase E n F [] e' with
      | none => simp only [he, he'] at h; exact Bool.noConfusion h
      | some le' =>
          simp only [he, he'] at h
          cases hev : evalL F [] le with
          | none => simp only [hev] at h; exact Bool.noConfusion h
          | some ve =>
              cases hev' : evalL F [] le' with
              | none => simp only [hev, hev'] at h; exact Bool.noConfusion h
              | some ve' =>
                  simp only [hev, hev'] at h
                  have hve : ve = ve' := lvalEq_eq ve ve' h
                  subst hve
                  exact stepEvalL_of_evalL_eq he he' hev hev'

def checkWhnfErasable (E : ResolvedEnv) (n F : Nat) : Nat → Expr Nat → Bool
  | 0, _ => true
  | fuel + 1, e =>
      match appsSpine e with
      | (.lam _ b, a :: args) =>
          let e' := foldApps (instantiate0 a b) args
          checkStepEvalL E n (F + F) e e' && checkWhnfErasable E n F fuel e'
      | (.letE _ v b, args) =>
          let e' := foldApps (instantiate0 v b) args
          checkStepEvalL E n (F + F) e e' && checkWhnfErasable E n F fuel e'
      | (.const r ls, args) =>
          match transparentBody E r ls with
          | some body =>
              let e' := foldApps body args
              (match inferT E n [] (.const r ls) with
               | none => true
               | some T0 => decide (inferT E n [] body = some T0)) &&
              checkWhnfErasable E n F fuel e'
          | none => true
      | _ => true

theorem whnfErasable_of_checkWhnfErasable (E : ResolvedEnv) (n F : Nat) :
    ∀ (fuel : Nat) (e : Expr Nat),
      checkWhnfErasable E n F fuel e = true →
      WhnfErasable E n fuel e
  | 0, _, _ => True.intro
  | fuel + 1, e, h => by
      unfold checkWhnfErasable at h
      unfold WhnfErasable
      generalize hsp : appsSpine e = sp at h ⊢
      rcases sp with ⟨hd, args⟩
      cases hd with
      | lam _ b =>
          cases args with
          | nil => exact True.intro
          | cons a as =>
              simp only [Bool.and_eq_true] at h ⊢
              exact ⟨stepEvalL_of_checkStepEvalL h.1,
                whnfErasable_of_checkWhnfErasable E n F fuel _ h.2⟩
      | letE _ v b =>
          simp only [Bool.and_eq_true] at h ⊢
          exact ⟨stepEvalL_of_checkStepEvalL h.1,
            whnfErasable_of_checkWhnfErasable E n F fuel _ h.2⟩
      | const r ls =>
          simp only at h ⊢
          cases htb : transparentBody E r ls with
          | none =>
              exact True.intro
          | some body =>
              rw [htb] at h
              simp only [Bool.and_eq_true] at h ⊢
              refine ⟨?_, whnfErasable_of_checkWhnfErasable E n F fuel _ h.2⟩
              intro T0 hi
              have h1 := h.1
              rw [hi, decide_eq_true_eq] at h1
              exact h1
      | bvar _ | sort _ | app _ _ | pi _ _ | lit _ =>
          exact True.intro

def checkNormErasable (E : ResolvedEnv) (n F : Nat) : Nat → Expr Nat → Bool
  | 0, _ => true
  | fuel + 1, e =>
      checkWhnfErasable E n F fuel e &&
      match whnfFuel E fuel e with
      | some (.app g a) =>
          (appsSpine (.app g a)).2.all (fun arg =>
            (match norm E fuel arg with
             | none => true
             | some varg => checkStepEvalL E n (F + F) arg varg) &&
            checkNormErasable E n F fuel arg)
      | _ => true

theorem list_all_mem {α : Type} (p : α → Bool) :
    ∀ (xs : List α) (x : α), xs.all p = true → x ∈ xs → p x = true
  | [], _, _, hmem => nomatch hmem
  | y :: ys, x, hall, hmem => by
      simp only [List.all_cons, Bool.and_eq_true] at hall
      cases hmem with
      | head => exact hall.1
      | tail _ hm => exact list_all_mem p ys x hall.2 hm

theorem normErasable_of_checkNormErasable (E : ResolvedEnv) (n F : Nat) :
    ∀ (lf : Nat) (e : Expr Nat),
      checkNormErasable E n F lf e = true →
      NormErasable E n lf e
  | 0, _, _ => True.intro
  | fuel + 1, e, h => by
      simp only [checkNormErasable, Bool.and_eq_true] at h
      refine ⟨whnfErasable_of_checkWhnfErasable E n F fuel e h.1, ?_⟩
      cases hw : whnfFuel E fuel e with
      | none => exact True.intro
      | some w =>
          cases w with
          | bvar _ | sort _ | const _ _ | lam _ _ | pi _ _ | letE _ _ _ | lit _ =>
              exact True.intro
          | app g a =>
              have h2 := h.2
              rw [hw] at h2
              intro arg hmem
              have harg := list_all_mem _ (appsSpine (.app g a)).2 arg h2 hmem
              simp only [Bool.and_eq_true] at harg
              refine ⟨?_, normErasable_of_checkNormErasable E n F fuel arg harg.2⟩
              intro varg hnorm
              have h1 := harg.1
              rw [hnorm] at h1
              exact stepEvalL_of_checkStepEvalL h1

theorem traceErasable_ctl_g01 : TraceErasable ctlEnv 0 8 g01 :=
  ⟨⟨1, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g01 rfl⟩
theorem traceErasable_ctl_g02 : TraceErasable ctlEnv 0 8 g02 :=
  ⟨⟨1, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g02 rfl⟩
theorem traceErasable_ctl_g03 : TraceErasable ctlEnv 0 8 g03 :=
  ⟨⟨2, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g03 rfl⟩
theorem traceErasable_ctl_g04 : TraceErasable ctlEnv 0 8 g04 :=
  ⟨⟨4, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g04 rfl⟩
theorem traceErasable_ctl_g05 : TraceErasable ctlEnv 0 8 g05 :=
  ⟨⟨4, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g05 rfl⟩
theorem traceErasable_ctl_g06 : TraceErasable ctlEnv 0 8 g06 :=
  ⟨⟨4, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g06 rfl⟩
theorem traceErasable_ctl_g07 : TraceErasable ctlEnv 0 8 g07 :=
  ⟨⟨4, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g07 rfl⟩
theorem traceErasable_ctl_g08 : TraceErasable ctlEnv 0 8 g08 :=
  ⟨⟨6, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g08 rfl⟩
theorem traceErasable_ctl_g09 : TraceErasable ctlEnv 0 8 g09 :=
  ⟨⟨6, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g09 rfl⟩
theorem traceErasable_ctl_g10 : TraceErasable ctlEnv 0 8 g10 :=
  ⟨⟨8, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g10 rfl⟩
theorem traceErasable_ctl_g11 : TraceErasable ctlEnv 0 8 g11 :=
  ⟨⟨1, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g11 rfl⟩
theorem traceErasable_ctl_g12 : TraceErasable ctlEnv 0 8 g12 :=
  ⟨⟨8, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g12 rfl⟩
theorem traceErasable_ctl_g13 : TraceErasable ctlEnv 0 8 g13 :=
  ⟨⟨8, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g13 rfl⟩
theorem traceErasable_ctl_g14 : TraceErasable ctlEnv 0 8 g14 :=
  ⟨⟨6, _, rfl⟩, normErasable_of_checkNormErasable ctlEnv 0 8 8 g14 rfl⟩

def checkRsxCert (E : ResolvedEnv) (n lf fv F : Nat) (t : BootTy) (e : Expr Nat) :
    Except String (Expr Nat × Val) :=
  match decide (lf = 0) with
  | true => .error "[rsx_cert_norm_fuel]"
  | false =>
    match decide (fv = 0) with
    | true => .error "[rsx_cert_val_fuel]"
    | false =>
      match decide (F = 0) with
      | true => .error "[rsx_cert_lower_fuel]"
      | false =>
        match inferT E n [] e with
        | none => .error "[rsx_cert_untyped]"
        | some T =>
          match isDataTy E T with
          | false => .error "[rsx_cert_not_data_ty]"
          | true =>
            match norm E lf e with
            | none => .error "[rsx_cert_norm_timeout]"
            | some v =>
              match scmValOf E fv v with
              | none => .error "[rsx_cert_not_scm_val]"
              | some w =>
                match relevantSpine E n fv v with
                | false => .error "[rsx_cert_irrelevant_spine]"
                | true =>
                  match irrelevant E n [] v with
                  | true => .error "[rsx_cert_irrelevant_root]"
                  | false =>
                    match valFits fv t w with
                    | false => .error "[rsx_cert_val_not_fitting]"
                    | true =>
                      match inferT E n [] v with
                      | none => .error "[rsx_cert_untyped_value]"
                      | some Tv =>
                        match decide (Tv = T) with
                        | false => .error "[rsx_cert_value_type_mismatch]"
                        | true =>
                          match erase E n F [] e with
                          | none => .error "[rsx_cert_erase_fuel]"
                          | some le =>
                            match erase E n F [] v with
                            | none => .error "[rsx_cert_erase_val_fuel]"
                            | some lv =>
                              match evalL F [] le with
                              | none => .error "[rsx_cert_run_fuel]"
                              | some vLe =>
                                match evalL F [] lv with
                                | none => .error "[rsx_cert_run_val_fuel]"
                                | some vLv =>
                                  match lvalEq vLe vLv && checkNormErasable E n F lf e with
                                  | false => .error "[rsx_cert_erasable_val_mismatch]"
                                  | true => .ok (v, w)

theorem checkRsxCert_ok_inv {E : ResolvedEnv} {n lf fv F : Nat}
    {t : BootTy} {e v : Expr Nat} {w : Val}
    (h : checkRsxCert E n lf fv F t e = .ok (v, w)) :
    ∃ T,
      inferT E n [] e = some T ∧
      DataTy E T ∧
      norm E lf e = some v ∧
      scmValOf E fv v = some w ∧
      relevantSpine E n fv v = true ∧
      irrelevant E n [] v = false ∧
      valFits fv t w = true ∧
      inferT E n [] v = some T ∧
      StepEvalL E n e v ∧
      TraceErasable E n lf e := by
  unfold checkRsxCert at h
  cases hlf : decide (lf = 0) with
  | true =>
      simp only [hlf] at h
      exact Except.noConfusion h
  | false =>
      simp only [hlf] at h
      cases hfv : decide (fv = 0) with
      | true =>
          simp only [hfv] at h
          exact Except.noConfusion h
      | false =>
          simp only [hfv] at h
          cases hF : decide (F = 0) with
          | true =>
              simp only [hF] at h
              exact Except.noConfusion h
          | false =>
              simp only [hF] at h
              cases hi : inferT E n [] e with
              | none =>
                  simp only [hi] at h
                  exact Except.noConfusion h
              | some T =>
                  simp only [hi] at h
                  cases hdt : isDataTy E T with
                  | false =>
                      simp only [hdt] at h
                      exact Except.noConfusion h
                  | true =>
                      simp only [hdt] at h
                      cases hn : norm E lf e with
                      | none =>
                          simp only [hn] at h
                          exact Except.noConfusion h
                      | some v' =>
                          simp only [hn] at h
                          cases hs : scmValOf E fv v' with
                          | none =>
                              simp only [hs] at h
                              exact Except.noConfusion h
                          | some w' =>
                              simp only [hs] at h
                              cases hrel : relevantSpine E n fv v' with
                              | false =>
                                  simp only [hrel] at h
                                  exact Except.noConfusion h
                              | true =>
                                  simp only [hrel] at h
                                  cases hirr : irrelevant E n [] v' with
                                  | true =>
                                      simp only [hirr] at h
                                      exact Except.noConfusion h
                                  | false =>
                                      simp only [hirr] at h
                                      cases hfit : valFits fv t w' with
                                      | false =>
                                          simp only [hfit] at h
                                          exact Except.noConfusion h
                                      | true =>
                                          simp only [hfit] at h
                                          cases hiv : inferT E n [] v' with
                                          | none =>
                                              simp only [hiv] at h
                                              exact Except.noConfusion h
                                          | some Tv =>
                                              simp only [hiv] at h
                                              cases hteq : decide (Tv = T) with
                                              | false =>
                                                  simp only [hteq] at h
                                                  exact Except.noConfusion h
                                              | true =>
                                                  simp only [hteq] at h
                                                  cases hee : erase E n F [] e with
                                                  | none =>
                                                      simp only [hee] at h
                                                      exact Except.noConfusion h
                                                  | some le =>
                                                      simp only [hee] at h
                                                      cases hev : erase E n F [] v' with
                                                      | none =>
                                                          simp only [hev] at h
                                                          exact Except.noConfusion h
                                                      | some lv =>
                                                          simp only [hev] at h
                                                          cases hre : evalL F [] le with
                                                          | none =>
                                                              simp only [hre] at h
                                                              exact Except.noConfusion h
                                                          | some vLe =>
                                                              simp only [hre] at h
                                                              cases hrv : evalL F [] lv with
                                                              | none =>
                                                                  simp only [hrv] at h
                                                                  exact Except.noConfusion h
                                                              | some vLv =>
                                                                  simp only [hrv] at h
                                                                  cases hdeq : (lvalEq vLe vLv && checkNormErasable E n F lf e) with
                                                                  | false =>
                                                                      simp only [hdeq] at h
                                                                      exact Except.noConfusion h
                                                                  | true =>
                                                                      simp only [hdeq] at h
                                                                      have hvw : (v', w') = (v, w) := Except.ok.inj h
                                                                      have hv : v' = v := congrArg Prod.fst hvw
                                                                      have hw : w' = w := congrArg Prod.snd hvw
                                                                      subst hv
                                                                      subst hw
                                                                      have hTv : Tv = T := of_decide_eq_true hteq
                                                                      rw [hTv] at hiv
                                                                      simp only [Bool.and_eq_true] at hdeq
                                                                      have hvL : vLe = vLv := lvalEq_eq vLe vLv hdeq.1
                                                                      subst hvL
                                                                      exact ⟨T, rfl, dataTy_of_isDataTy hdt, rfl, hs, hrel, hirr, hfit, hiv,
                                                                        stepEvalL_of_evalL_eq hee hev hre hrv,
                                                                        ⟨⟨F, le, hee⟩,
                                                                         normErasable_of_checkNormErasable E n F lf e hdeq.2⟩⟩

theorem checkRsxCert_traceErasable {E : ResolvedEnv} {n lf fv F : Nat}
    {t : BootTy} {e v : Expr Nat} {w : Val}
    (h : checkRsxCert E n lf fv F t e = .ok (v, w)) :
    TraceErasable E n lf e := by
  obtain ⟨_, _, _, _, _, _, _, _, _, _, htr⟩ := checkRsxCert_ok_inv h
  exact htr

theorem checkRsxCert_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {n lf fv F : Nat} {t : BootTy} {e v : Expr Nat} {w : Val}
    (hWf : EnvWf E) (hB : BodiesTyped E n)
    (h : checkRsxCert E n lf fv F t e = .ok (v, w)) :
    norm E lf e = some v ∧
    scmValOf E fv v = some w ∧
    ∃ F₀, ∀ F', F₀ ≤ F' →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F' (S := S) t e) = some w := by
  obtain ⟨T, hi, hD, hn, hs, hrel, hirr, hfit, hiv, _, her⟩ := checkRsxCert_ok_inv h
  exact ⟨hn, hs, lowerF_adequacyClosed progs E n lf fv e T v t w
    hWf hB hi hD hn hs hrel hirr hfit hiv her⟩

theorem checkRsxCert_sound {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {n lf fv F : Nat} {t : BootTy} {e v : Expr Nat} {w : Val}
    (h : checkRsxCert E n lf fv F t e = .ok (v, w)) :
    norm E lf e = some v ∧
    scmValOf E fv v = some w ∧
    ∃ F₀, ∀ F', F₀ ≤ F' →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F' (S := S) t e) = some w := by
  obtain ⟨T, _, _, hn, hs, hrel, hirr, hfit, hiv, hstep, _⟩ := checkRsxCert_ok_inv h
  obtain ⟨Fv, hev_v⟩ :=
    eval_lowerF_of_scmValOf (S := S) progs E n fv v T t w hiv hs hrel hirr hfit
  obtain ⟨lv, dv, he_v, hr_v, _, hemit_v⟩ :=
    lowerF_eval_inv progs E n Fv 1 t v w hev_v
  have hp_lv : passive lv = true :=
    passive_erase_of_scmValOf hs he_v
  have hsim_v : (evalL Fv [] lv).bind lToD = some dv := by
    rw [evalL_run_passive_nil Fv lv hp_lv]
    exact hr_v
  cases hevL_v : evalL Fv [] lv with
  | none =>
      rw [hevL_v] at hsim_v
      exact Option.noConfusion hsim_v
  | some vL =>
      rw [hevL_v] at hsim_v
      change lToD vL = some dv at hsim_v
      have hnc : noClo vL = true := noClo_of_lToD vL dv hsim_v
      obtain ⟨Fe0, le, he_e0, hevL_e0⟩ :=
        hstep Fv lv vL he_v hevL_v hnc
      have hr_e0 : run (defunc le).2 Fe0 [] (defunc le).1 = some dv :=
        evalL_run_defunc Fe0 le vL dv
          (noGlobL_erase E n Fe0 [] e le he_e0) hevL_e0 hsim_v
      have he_e : erase E n (Fe0 + Fv) [] e = some le :=
        erase_mono E n Fe0 (Fe0 + Fv) [] e le (Nat.le_add_right Fe0 Fv) he_e0
      have hr_e : run (defunc le).2 (Fe0 + Fv) [] (defunc le).1 = some dv :=
        run_mono (defunc le).2 Fe0 (Fe0 + Fv) [] (defunc le).1 dv
          (Nat.le_add_right Fe0 Fv) hr_e0
      refine ⟨hn, hs, lowerF_eventual_of_exists progs E n t e w ⟨Fe0 + Fv, 1, ?_⟩⟩
      rw [lowerF_eq_of_erase_run E n (Fe0 + Fv) t e le dv he_e hr_e]
      exact emitWith_evalStable relevantArgs progs 1 [] Fv (Fe0 + Fv) t dv w
        (Nat.le_add_left Fv Fe0) hemit_v

/-- Sound `rsx -> scm` closed-term certificate classifier backed by `checkRsxCert`:
    returns `none` when `checkRsxCert E n lf fv F t e` succeeds, and `some reason`
    with the named refusal tag when `checkRsxCert` refuses. -/
def certClosed (E : ResolvedEnv) (n lf fv F : Nat) (t : BootTy) (e : Expr Nat) : Option String :=
  match checkRsxCert E n lf fv F t e with
  | .ok _ => none
  | .error err => some err

theorem certClosed_none_sound {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {n lf fv F : Nat} {t : BootTy} {e : Expr Nat}
    (h : certClosed E n lf fv F t e = none) :
    ∃ v w,
      norm E lf e = some v ∧
      scmValOf E fv v = some w ∧
      ∃ F₀, ∀ F', F₀ ≤ F' →
        ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF E n F' (S := S) t e) = some w := by
  unfold certClosed at h
  cases hc : checkRsxCert E n lf fv F t e with
  | error err =>
      rw [hc] at h
      exact Option.noConfusion h
  | ok vw =>
      rcases vw with ⟨v, w⟩
      exact ⟨v, w, checkRsxCert_sound progs hc⟩

theorem certClosed_ctl_g01 :
    certClosed ctlEnv 0 8 4 8 .i64 g01 = none := rfl

theorem certClosed_refuses_untyped :
    certClosed ctlEnv 0 8 4 8 tyNat1 (.bvar 0) = some "[rsx_cert_untyped]" := rfl

structure RsxConstructCounts where
  bvar : Nat := 0
  sort : Nat := 0
  constHead : Nat := 0
  constDelta : Nat := 0
  app : Nat := 0
  lam : Nat := 0
  pi : Nat := 0
  letE : Nat := 0
  lit : Nat := 0
  deriving DecidableEq, Repr

def RsxConstructCounts.add (a b : RsxConstructCounts) : RsxConstructCounts :=
  { bvar := a.bvar + b.bvar,
    sort := a.sort + b.sort,
    constHead := a.constHead + b.constHead,
    constDelta := a.constDelta + b.constDelta,
    app := a.app + b.app,
    lam := a.lam + b.lam,
    pi := a.pi + b.pi,
    letE := a.letE + b.letE,
    lit := a.lit + b.lit }

def RsxConstructCounts.total (c : RsxConstructCounts) : Nat :=
  c.bvar + c.sort + c.constHead + c.constDelta + c.app + c.lam + c.pi + c.letE + c.lit

def walkExprConstructs (E : ResolvedEnv) : Nat → Expr Nat → Except String RsxConstructCounts
  | 0, _ => .error "[rsx_walk_fuel]"
  | _ + 1, .bvar _ => .ok { bvar := 1 }
  | _ + 1, .sort _ => .ok { sort := 1 }
  | _ + 1, .lit _ => .ok { lit := 1 }
  | _ + 1, .const r ls =>
      match transparentBody E r ls with
      | some _ => .ok { constDelta := 1 }
      | none => .ok { constHead := 1 }
  | fw + 1, .app f a =>
      match walkExprConstructs E fw f, walkExprConstructs E fw a with
      | .ok cf, .ok ca => .ok (RsxConstructCounts.add { app := 1 } (RsxConstructCounts.add cf ca))
      | .error e, _ => .error e
      | _, .error e => .error e
  | fw + 1, .lam A b =>
      match walkExprConstructs E fw A, walkExprConstructs E fw b with
      | .ok cA, .ok cb => .ok (RsxConstructCounts.add { lam := 1 } (RsxConstructCounts.add cA cb))
      | .error e, _ => .error e
      | _, .error e => .error e
  | fw + 1, .pi A B =>
      match walkExprConstructs E fw A, walkExprConstructs E fw B with
      | .ok cA, .ok cB => .ok (RsxConstructCounts.add { pi := 1 } (RsxConstructCounts.add cA cB))
      | .error e, _ => .error e
      | _, .error e => .error e
  | fw + 1, .letE A v b =>
      match walkExprConstructs E fw A, walkExprConstructs E fw v, walkExprConstructs E fw b with
      | .ok cA, .ok cv, .ok cb =>
          .ok (RsxConstructCounts.add { letE := 1 }
            (RsxConstructCounts.add cA (RsxConstructCounts.add cv cb)))
      | .error e, _, _ => .error e
      | _, .error e, _ => .error e
      | _, _, .error e => .error e

structure RsxBatchReport where
  certifiedDecls : Nat := 0
  refusedReasons : List String := []
  certifiedConstructs : RsxConstructCounts := {}
  refusedConstructs : RsxConstructCounts := {}
  deriving DecidableEq, Repr

def RsxBatchReport.append (a b : RsxBatchReport) : RsxBatchReport :=
  { certifiedDecls := a.certifiedDecls + b.certifiedDecls,
    refusedReasons := a.refusedReasons ++ b.refusedReasons,
    certifiedConstructs := RsxConstructCounts.add a.certifiedConstructs b.certifiedConstructs,
    refusedConstructs := RsxConstructCounts.add a.refusedConstructs b.refusedConstructs }

def certifyOne (E : ResolvedEnv) (n fw lf fv F : Nat) (t : BootTy) (e : Expr Nat) :
    RsxBatchReport :=
  match walkExprConstructs E fw e with
  | .error err => { certifiedDecls := 0, refusedReasons := [err] }
  | .ok cs =>
      match checkRsxCert E n lf fv F t e with
      | .ok _ =>
          { certifiedDecls := 1, refusedReasons := [],
            certifiedConstructs := cs, refusedConstructs := {} }
      | .error err =>
          { certifiedDecls := 0, refusedReasons := [err],
            certifiedConstructs := {}, refusedConstructs := cs }

def certifyBatch (E : ResolvedEnv) (n fw lf fv F : Nat) :
    List (BootTy × Expr Nat) → RsxBatchReport
  | [] => {}
  | p :: rest =>
      RsxBatchReport.append (certifyOne E n fw lf fv F p.1 p.2)
        (certifyBatch E n fw lf fv F rest)

def AllCertified (E : ResolvedEnv) (n lf fv F : Nat) : List (BootTy × Expr Nat) → Bool
  | [] => true
  | p :: rest =>
      match checkRsxCert E n lf fv F p.1 p.2 with
      | .ok _ => AllCertified E n lf fv F rest
      | .error _ => false

theorem allCertified_sound {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      AllCertified E n lf fv F decls = true →
      ∀ p, p ∈ decls →
        ∃ v w,
          norm E lf p.2 = some v ∧
          scmValOf E fv v = some w ∧
          ∃ F₀, ∀ F', F₀ ≤ F' →
            ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
              (lowerF E n F' (S := S) p.1 p.2) = some w
  | [], _, _, hp => by cases hp
  | q :: rest, hall, p, hp => by
      simp only [AllCertified] at hall
      cases hcert : checkRsxCert E n lf fv F q.1 q.2 with
      | error _ =>
          rw [hcert] at hall
          exact Bool.noConfusion hall
      | ok vw =>
          rw [hcert] at hall
          rcases vw with ⟨v, w⟩
          cases hp with
          | head =>
              exact ⟨v, w, checkRsxCert_sound progs hcert⟩
          | tail _ hmem =>
              exact allCertified_sound progs E n lf fv F rest hall p hmem

theorem allCertified_traceErasable (E : ResolvedEnv) (n lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      AllCertified E n lf fv F decls = true →
      ∀ p, p ∈ decls → TraceErasable E n lf p.2
  | [], _, _, hp => by cases hp
  | q :: rest, hall, p, hp => by
      simp only [AllCertified] at hall
      cases hcert : checkRsxCert E n lf fv F q.1 q.2 with
      | error _ =>
          rw [hcert] at hall
          exact Bool.noConfusion hall
      | ok vw =>
          rw [hcert] at hall
          rcases vw with ⟨v, w⟩
          cases hp with
          | head =>
              exact checkRsxCert_traceErasable hcert
          | tail _ hmem =>
              exact allCertified_traceErasable E n lf fv F rest hall p hmem

theorem allCertified_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n lf fv F : Nat)
    (hWf : EnvWf E) (hB : BodiesTyped E n) :
    ∀ (decls : List (BootTy × Expr Nat)),
      AllCertified E n lf fv F decls = true →
      ∀ p, p ∈ decls →
        TraceErasable E n lf p.2 ∧
        ∃ v w,
          norm E lf p.2 = some v ∧
          scmValOf E fv v = some w ∧
          ∃ F₀, ∀ F', F₀ ≤ F' →
            ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
              (lowerF E n F' (S := S) p.1 p.2) = some w
  | [], _, _, hp => by cases hp
  | q :: rest, hall, p, hp => by
      simp only [AllCertified] at hall
      cases hcert : checkRsxCert E n lf fv F q.1 q.2 with
      | error _ =>
          rw [hcert] at hall
          exact Bool.noConfusion hall
      | ok vw =>
          rw [hcert] at hall
          rcases vw with ⟨v, w⟩
          cases hp with
          | head =>
              exact ⟨checkRsxCert_traceErasable hcert,
                v, w, checkRsxCert_sound_via_adequacyClosed progs hWf hB hcert⟩
          | tail _ hmem =>
              exact allCertified_sound_via_adequacyClosed progs E n lf fv F hWf hB rest hall p hmem

theorem allCertified_of_certifyBatch_no_refusals (E : ResolvedEnv) (n fw lf fv F : Nat) :
    ∀ (decls : List (BootTy × Expr Nat)),
      (certifyBatch E n fw lf fv F decls).refusedReasons = [] →
      AllCertified E n lf fv F decls = true
  | [], _ => rfl
  | p :: rest, h => by
      simp only [certifyBatch, certifyOne, RsxBatchReport.append] at h
      cases hw : walkExprConstructs E fw p.2 with
      | error err =>
          rw [hw] at h
          exact List.noConfusion h
      | ok cs =>
          rw [hw] at h
          simp only [AllCertified]
          cases hc : checkRsxCert E n lf fv F p.1 p.2 with
          | error err =>
              rw [hc] at h
              exact List.noConfusion h
          | ok _ =>
              rw [hc] at h
              simp only [List.nil_append] at h
              exact allCertified_of_certifyBatch_no_refusals E n fw lf fv F rest h

theorem certifyBatch_no_refusals_traceErasable (E : ResolvedEnv) (n fw lf fv F : Nat)
    (decls : List (BootTy × Expr Nat))
    (hnil : (certifyBatch E n fw lf fv F decls).refusedReasons = []) :
    ∀ p, p ∈ decls → TraceErasable E n lf p.2 :=
  allCertified_traceErasable E n lf fv F decls
    (allCertified_of_certifyBatch_no_refusals E n fw lf fv F decls hnil)

theorem certifyBatch_no_refusals_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n fw lf fv F : Nat)
    (hWf : EnvWf E) (hB : BodiesTyped E n)
    (decls : List (BootTy × Expr Nat))
    (hnil : (certifyBatch E n fw lf fv F decls).refusedReasons = []) :
    ∀ p, p ∈ decls →
      TraceErasable E n lf p.2 ∧
      ∃ v w,
        norm E lf p.2 = some v ∧
        scmValOf E fv v = some w ∧
        ∃ F₀, ∀ F', F₀ ≤ F' →
          ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
            (lowerF E n F' (S := S) p.1 p.2) = some w :=
  allCertified_sound_via_adequacyClosed progs E n lf fv F hWf hB decls
    (allCertified_of_certifyBatch_no_refusals E n fw lf fv F decls hnil)

/-- Certified `rsx -> scm` entry admission for a named program `(declName, t, e)`:
    discharges `TraceErasable E n lf e` via the decidable Stage-1 certificate checker
    `checkRsxCert E n lf fv F t e` before emitting `lowerF E n F t e`, and refuses by
    `(declName, err)` any program whose certificate fails. -/
def lowerCertEntry (E : ResolvedEnv) (n lf fv F : Nat) {S : SigTable}
    (declName : String) (t : BootTy) (e : Expr Nat) :
    Except (String × String) (BootExpr S [] t) :=
  match checkRsxCert E n lf fv F t e with
  | .ok _ => .ok (lowerF E n F (S := S) t e)
  | .error err => .error (declName, err)

theorem lowerCertEntry_traceErasable {E : ResolvedEnv} {n lf fv F : Nat}
    {S : SigTable} {declName : String} {t : BootTy} {e : Expr Nat}
    {code : BootExpr S [] t}
    (h : lowerCertEntry E n lf fv F (S := S) declName t e = .ok code) :
    TraceErasable E n lf e := by
  unfold lowerCertEntry at h
  cases hc : checkRsxCert E n lf fv F t e with
  | error err =>
      rw [hc] at h
      exact Except.noConfusion h
  | ok vw =>
      rcases vw with ⟨v, w⟩
      exact checkRsxCert_traceErasable hc

theorem lowerCertEntry_ok_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    {E : ResolvedEnv} {n lf fv F : Nat}
    {declName : String} {t : BootTy} {e : Expr Nat}
    {code : BootExpr S [] t}
    (hWf : EnvWf E) (hB : BodiesTyped E n)
    (h : lowerCertEntry E n lf fv F (S := S) declName t e = .ok code) :
    code = lowerF E n F (S := S) t e ∧
    TraceErasable E n lf e ∧
    ∃ v w,
      norm E lf e = some v ∧
      scmValOf E fv v = some w ∧
      ∃ F₀, ∀ F', F₀ ≤ F' →
        ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF E n F' (S := S) t e) = some w := by
  unfold lowerCertEntry at h
  cases hc : checkRsxCert E n lf fv F t e with
  | error err =>
      rw [hc] at h
      exact Except.noConfusion h
  | ok vw =>
      rw [hc] at h
      rcases vw with ⟨v, w⟩
      have hcode : code = lowerF E n F (S := S) t e := (Except.ok.inj h).symm
      exact ⟨hcode, checkRsxCert_traceErasable hc,
        v, w, checkRsxCert_sound_via_adequacyClosed progs hWf hB hc⟩

theorem lowerCertEntry_refuses_by_name {E : ResolvedEnv} {n lf fv F : Nat}
    {S : SigTable} {declName : String} {t : BootTy} {e : Expr Nat} {err : String}
    (hc : checkRsxCert E n lf fv F t e = .error err) :
    lowerCertEntry E n lf fv F (S := S) declName t e = .error (declName, err) := by
  unfold lowerCertEntry
  rw [hc]

def certifyNamedBatch (E : ResolvedEnv) (n lf fv F : Nat) :
    List (String × BootTy × Expr Nat) → List (String × String)
  | [] => []
  | (declName, t, e) :: rest =>
      match checkRsxCert E n lf fv F t e with
      | .ok _ => certifyNamedBatch E n lf fv F rest
      | .error err => (declName, err) :: certifyNamedBatch E n lf fv F rest

theorem certifyNamedBatch_nil_traceErasable (E : ResolvedEnv) (n lf fv F : Nat) :
    ∀ (decls : List (String × BootTy × Expr Nat)),
      certifyNamedBatch E n lf fv F decls = [] →
      ∀ d, d ∈ decls → TraceErasable E n lf d.2.2
  | [], _, _, hd => by cases hd
  | (declName, t, e) :: rest, hnil, d, hd => by
      simp only [certifyNamedBatch] at hnil
      cases hc : checkRsxCert E n lf fv F t e with
      | error err =>
          rw [hc] at hnil
          exact List.noConfusion hnil
      | ok vw =>
          rw [hc] at hnil
          rcases vw with ⟨v, w⟩
          cases hd with
          | head =>
              exact checkRsxCert_traceErasable hc
          | tail _ hmem =>
              exact certifyNamedBatch_nil_traceErasable E n lf fv F rest hnil d hmem

theorem certifyNamedBatch_nil_sound_via_adequacyClosed {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n lf fv F : Nat)
    (hWf : EnvWf E) (hB : BodiesTyped E n) :
    ∀ (decls : List (String × BootTy × Expr Nat)),
      certifyNamedBatch E n lf fv F decls = [] →
      ∀ d, d ∈ decls →
        TraceErasable E n lf d.2.2 ∧
        ∃ v w,
          norm E lf d.2.2 = some v ∧
          scmValOf E fv v = some w ∧
          ∃ F₀, ∀ F', F₀ ≤ F' →
            ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
              (lowerF E n F' (S := S) d.2.1 d.2.2) = some w
  | [], _, _, hd => by cases hd
  | (declName, t, e) :: rest, hnil, d, hd => by
      simp only [certifyNamedBatch] at hnil
      cases hc : checkRsxCert E n lf fv F t e with
      | error err =>
          rw [hc] at hnil
          exact List.noConfusion hnil
      | ok vw =>
          rw [hc] at hnil
          rcases vw with ⟨v, w⟩
          cases hd with
          | head =>
              exact ⟨checkRsxCert_traceErasable hc,
                v, w, checkRsxCert_sound_via_adequacyClosed progs hWf hB hc⟩
          | tail _ hmem =>
              exact certifyNamedBatch_nil_sound_via_adequacyClosed progs E n lf fv F hWf hB rest hnil d hmem

theorem certifyNamedBatch_mem_of_error (E : ResolvedEnv) (n lf fv F : Nat) :
    ∀ (decls : List (String × BootTy × Expr Nat))
      (declName : String) (t : BootTy) (e : Expr Nat) (err : String),
      (declName, t, e) ∈ decls →
      checkRsxCert E n lf fv F t e = .error err →
      (declName, err) ∈ certifyNamedBatch E n lf fv F decls
  | [], _, _, _, _, hmem, _ => by cases hmem
  | (name0, t0, e0) :: rest, declName, t, e, err, hmem, hc => by
      simp only [certifyNamedBatch]
      cases hmem with
      | head =>
          rw [hc]
          exact List.Mem.head _
      | tail _ htail =>
          have ih := certifyNamedBatch_mem_of_error E n lf fv F rest declName t e err htail hc
          cases checkRsxCert E n lf fv F t0 e0 with
          | ok _ => exact ih
          | error err0 => exact List.Mem.tail (name0, err0) ih

theorem checkRsxCert_ctl_g01 :
    checkRsxCert ctlEnv 0 8 4 8 .i64 g01 = .ok (.lit 5, .int 5) := rfl
theorem checkRsxCert_ctl_g02 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g02 = .ok (cZero, .inj 1 (.list [])) := rfl
theorem checkRsxCert_ctl_g03 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g03 = .ok (.app cSucc (.lit 4), .inj 2 (.list [.int 4])) := rfl
theorem checkRsxCert_ctl_g04 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g04 = .ok (.app cSucc (.lit 4), .inj 2 (.list [.int 4])) := rfl
theorem checkRsxCert_ctl_g05 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g05 = .ok (.app cSucc (.lit 7), .inj 2 (.list [.int 7])) := rfl
theorem checkRsxCert_ctl_g06 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat3 g06 =
      .ok (.app cSucc (.app cSucc cZero), .inj 2 (.list [.inj 2 (.list [.inj 1 (.list [])])])) := rfl
theorem checkRsxCert_ctl_g07 :
    checkRsxCert ctlEnv 0 8 4 8 .i64 g07 = .ok (.lit 3, .int 3) := rfl
theorem checkRsxCert_ctl_g08 :
    checkRsxCert ctlEnv 0 8 4 8 .i64 g08 = .ok (.lit 9, .int 9) := rfl
theorem checkRsxCert_ctl_g09 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g09 = .ok (.app cSucc (.lit 1), .inj 2 (.list [.int 1])) := rfl
theorem checkRsxCert_ctl_g10 :
    checkRsxCert ctlEnv 0 8 4 8 (sumL 11 .i64) g10 =
      .ok (.app (.app cMk (.lit 2)) (.lit 1), .inj 10 (.list [.int 2, .int 1])) := rfl
theorem checkRsxCert_ctl_g11 :
    checkRsxCert ctlEnv 0 8 4 8 (sumL 9 .i64) g11 = .ok (.const 8 [], .inj 8 (.list [])) := rfl
theorem checkRsxCert_ctl_g12 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat2 g12 =
      .ok (.app cSucc (.app cSucc (.lit 0)), .inj 2 (.list [.inj 2 (.list [.int 0])])) := rfl
theorem checkRsxCert_ctl_g13 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat2 g13 =
      .ok (.app cSucc (.app cSucc (.lit 0)), .inj 2 (.list [.inj 2 (.list [.int 0])])) := rfl
theorem checkRsxCert_ctl_g14 :
    checkRsxCert ctlEnv 0 8 4 8 tyNat2 g14 =
      .ok (.app cSucc cZero, .inj 2 (.list [.inj 1 (.list [])])) := rfl

def ctlBatch : List (BootTy × Expr Nat) :=
  [(.i64, g01),
   (tyNat1, g02),
   (tyNat1, g03),
   (tyNat1, g04),
   (tyNat1, g05),
   (tyNat3, g06),
   (.i64, g07),
   (.i64, g08),
   (tyNat1, g09),
   (sumL 11 .i64, g10),
   (sumL 9 .i64, g11),
   (tyNat2, g12),
   (tyNat2, g13),
   (tyNat2, g14)]

theorem allCertified_ctlBatch : AllCertified ctlEnv 0 8 4 8 ctlBatch = true := rfl

theorem ctlBatch_all_sound {S : SigTable} (progs : Programs S S)
    (p : BootTy × Expr Nat) (hp : p ∈ ctlBatch) :
    ∃ v w,
      norm ctlEnv 8 p.2 = some v ∧
      scmValOf ctlEnv 4 v = some w ∧
      ∃ F₀, ∀ F', F₀ ≤ F' →
        ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
          (lowerF ctlEnv 0 F' (S := S) p.1 p.2) = some w :=
  allCertified_sound progs ctlEnv 0 8 4 8 ctlBatch allCertified_ctlBatch p hp

theorem certifyBatch_ctlBatch_report :
    certifyBatch ctlEnv 0 8 8 4 8 ctlBatch =
      { certifiedDecls := 14,
        refusedReasons := [],
        certifiedConstructs :=
          { bvar := 11, sort := 1, constHead := 25, constDelta := 2,
            app := 20, lam := 10, pi := 2, letE := 2, lit := 11 },
        refusedConstructs := {} } := rfl

def irrSpineEnv : ResolvedEnv where
  members := fun r =>
    match r with
    | 3 => some ⟨.constructorM, 0, .pi cTrue cN, none⟩
    | r => ctlEnv.members r

def irrSpineTerm : Expr Nat := .app (.const 3 []) cIntro

def eraseValCapTerm : Expr Nat :=
  .letE (.pi cN cN) (.lam cN (.app cSucc (.app cSucc (.bvar 0))))
    (.app (.bvar 0) (.app (.bvar 0) (.app cSucc cZero)))

theorem checkRsxCert_refuses_norm_fuel0 :
    checkRsxCert ctlEnv 0 0 4 8 .i64 g01 = .error "[rsx_cert_norm_fuel]" := rfl
theorem checkRsxCert_refuses_val_fuel0 :
    checkRsxCert ctlEnv 0 8 0 8 .i64 g01 = .error "[rsx_cert_val_fuel]" := rfl
theorem checkRsxCert_refuses_lower_fuel0 :
    checkRsxCert ctlEnv 0 8 4 0 .i64 g01 = .error "[rsx_cert_lower_fuel]" := rfl
theorem checkRsxCert_refuses_untyped :
    checkRsxCert ctlEnv 0 8 4 8 .i64 (.bvar 0) = .error "[rsx_cert_untyped]" := rfl
theorem checkRsxCert_refuses_not_data_ty :
    checkRsxCert ctlEnv 0 8 4 8 tyNat1 g15 = .error "[rsx_cert_not_data_ty]" := rfl
theorem checkRsxCert_refuses_wC_not_data_ty :
    checkRsxCert lvlEnv 0 8 4 8 tyNat1 wC = .error "[rsx_cert_not_data_ty]" := rfl
