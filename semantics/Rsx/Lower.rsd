theorem emitMut_ctor2_eq (F : Nat) {S : SigTable} :
    emitWith (fun _ => []) (S := S) (G := []) (F + 1) tyNat1 (.ctor 2 [.lit 4]) =
      .inj ⟨2, by decide⟩ .emptyList := rfl

theorem eval_inj_emptyList_ne {S : SigTable} (progs : Programs S S) (lf : Nat) :
    Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (BootExpr.inj (S := S) (G := []) (ts := List.replicate 3 (.list .i64))
        ⟨2, by decide⟩ .emptyList) ≠
      some (.inj 2 (.list [.int 4])) := by
  cases lf with
  | zero =>
      rw [eval_fuel0]
      intro h
      exact Option.noConfusion h
  | succ k =>
      simp only [Residua.Bootstrap.Semantics.eval, option_map_some]
      intro h
      injection h with h1
      injection h1 with _ h2
      injection h2 with h3
      exact List.noConfusion h3

theorem lowerEmitMut_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerEmitMut E n F t e) progs := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h ctlEnv 0 8 4 g03 cN (.app cSucc (.lit 4)) tyNat1 (.inj 2 (.list [.int 4]))
      ctlEnv_wf ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl rfl
      traceErasable_ctl_g03
  obtain ⟨lf, hev⟩ := hF (F₀ + 2) (Nat.le_add_right F₀ 2)
  dsimp only at hev
  simp only [lowerEmitMut, pipeline, erase_g03_succ F₀, run_g03_succ F₀,
    emitMut_ctor2_eq (F₀ + 1)] at hev
  exact eval_inj_emptyList_ne progs lf hev

/-! ### Exact planted stage-mutant refutations (`irrelevantAnySort`, `capRenOff`,
    `bindLast`, `fieldsRev` from `Lower.rsd:4420-4455` and `AuditR1`) -/

/-- Planted Stage-1 mutant (`irrelevantAnySort`, `mutErase` at `Lower.rsd:4420`):
    treats every term whose type's type is any sort as irrelevant (erasing data). -/
def lowerMutErase (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (eraseWith (irrelevantAnySort E n) noGlobals E) defunc run emit F t e

/-- Planted Stage-2 mutant (`capRenOff`, `mutDefunc` at `Lower.rsd:4430`):
    captured slot `k` read at `k` instead of `1 + k`. -/
def lowerCapRenOffMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) (convWith capRenOff id []) run emit F t e

/-- Planted Stage-3 mutant (`bindLast`, `mutRun` at `Lower.rsd:4435`):
    `apply` binds the argument after the captured values (`caps ++ [a]`). -/
def lowerBindLastMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) defunc (runWith bindLast) emit F t e

/-- Planted Stage-4 mutant (`fieldsRev`, `mutEmit` at `Lower.rsd:4438`):
    emits constructor fields in reverse order. -/
def lowerFieldsRevMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) defunc run (emitWith fieldsRev) F t e

theorem lowerMutErase_g03_eq_refuse {S : SigTable} (F : Nat) :
    lowerMutErase ctlEnv 0 (F + 1) (S := S) tyNat1 g03 = refuse := by
  have he : eraseWith (irrelevantAnySort ctlEnv 0) noGlobals ctlEnv (F + 1) [] g03 =
      some .box := rfl
  have hr : run (defunc .box).2 (F + 1) [] (defunc .box).1 = some .box := rfl
  simp only [lowerMutErase, pipeline, he, hr, emit_box_eq_refuse]

theorem lowerMutErase_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerMutErase E n F t e) progs := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h ctlEnv 0 8 4 g03 cN (.app cSucc (.lit 4)) tyNat1 (.inj 2 (.list [.int 4]))
      ctlEnv_wf ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl rfl
      traceErasable_ctl_g03
  obtain ⟨lf, hev⟩ := hF (F₀ + 1) (Nat.le_succ F₀)
  dsimp only at hev
  rw [lowerMutErase_g03_eq_refuse F₀] at hev
  exact eval_refuse_ne progs lf [] (.inj 2 (.list [.int 4])) hev

def leG10 : LExpr :=
  .app (.app (.lam (.lam (.app (.app (.ctor 10) (.bvar 0)) (.bvar 1)))) (.lit 1)) (.lit 2)

theorem erase_g10_succ (F : Nat) :
    erase ctlEnv 0 (F + 8) [] g10 = some leG10 := by
  have h8 : erase ctlEnv 0 8 [] g10 = some leG10 := rfl
  exact erase_mono ctlEnv 0 8 (F + 8) [] g10 leG10 (by omega) h8

theorem run_capRenOff_g10_succ (F : Nat) :
    run (convWith capRenOff id [] leG10).2 (F + 8) []
      (convWith capRenOff id [] leG10).1 = some (.ctor 10 [.lit 2, .lit 2]) := by
  have h8 : run (convWith capRenOff id [] leG10).2 8 []
      (convWith capRenOff id [] leG10).1 = some (.ctor 10 [.lit 2, .lit 2]) := rfl
  exact run_mono (convWith capRenOff id [] leG10).2 8 (F + 8) []
    (convWith capRenOff id [] leG10).1 (.ctor 10 [.lit 2, .lit 2]) (by omega) h8

theorem run_bindLast_g10_succ (F : Nat) :
    runWith bindLast (defunc leG10).2 (F + 8) [] (defunc leG10).1 =
      some (.ctor 10 [.lit 1, .lit 2]) := by
  have h8 : runWith bindLast (defunc leG10).2 8 [] (defunc leG10).1 =
      some (.ctor 10 [.lit 1, .lit 2]) := rfl
  exact runWith_mono bindLast (defunc leG10).2 8 (F + 8) []
    (defunc leG10).1 (.ctor 10 [.lit 1, .lit 2]) (by omega) h8

theorem run_g10_succ (F : Nat) :
    run (defunc leG10).2 (F + 8) [] (defunc leG10).1 =
      some (.ctor 10 [.lit 2, .lit 1]) := by
  have h8 : run (defunc leG10).2 8 [] (defunc leG10).1 =
      some (.ctor 10 [.lit 2, .lit 1]) := rfl
  exact run_mono (defunc leG10).2 8 (F + 8) []
    (defunc leG10).1 (.ctor 10 [.lit 2, .lit 1]) (by omega) h8

theorem emitWith_fieldsRev_ctor10_eq {S : SigTable} (F : Nat) :
    emitWith fieldsRev (S := S) (G := []) (F + 2) (sumL 11 .i64)
      (.ctor 10 [.lit 2, .lit 1]) =
    emit (S := S) (G := []) (F + 2) (sumL 11 .i64)
      (.ctor 10 [.lit 1, .lit 2]) := rfl

theorem eval_emit_ctor10_two_ne_2_1 {S : SigTable} (progs : Programs S S)
    (n1 n2 F lf : Nat)
    (hk1 : inI64Range (Int.ofNat n1) = true)
    (hk2 : inI64Range (Int.ofNat n2) = true)
    (hne : (Int.ofNat n1, Int.ofNat n2) ≠ ((2 : Int), (1 : Int))) :
    Residua.Bootstrap.Semantics.eval lawsA progs lf []
      (emit (S := S) (G := []) (F + 8) (sumL 11 .i64) (.ctor 10 [.lit n1, .lit n2])) ≠
      some (.inj 10 (.list [.int 2, .int 1])) := by
  have he3 : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emit (S := S) (G := []) 3 (sumL 11 .i64) (.ctor 10 [.lit n1, .lit n2])) =
      some (.inj 10 (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)])) :=
    eval_emit_ctor2_lit progs n1 n2 10 (List.replicate 11 (.list .i64)) rfl hk1 hk2
  have heF : Residua.Bootstrap.Semantics.eval lawsA progs 1 []
      (emitWith relevantArgs (S := S) (G := []) (F + 8) (sumL 11 .i64)
        (.ctor 10 [.lit n1, .lit n2])) =
      some (.inj 10 (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)])) :=
    emitWith_evalStable relevantArgs progs 1 [] 3 (F + 8) (sumL 11 .i64)
      (.ctor 10 [.lit n1, .lit n2])
      (.inj 10 (.list [.int (Int.ofNat n1), .int (Int.ofNat n2)])) (by omega) he3
  cases lf with
  | zero =>
      rw [eval_fuel0]
      intro h
      exact Option.noConfusion h
  | succ m =>
      unfold emit
      rw [emitWith_lf_indep relevantArgs progs m 0 (F + 8) (sumL 11 .i64)
        (.ctor 10 [.lit n1, .lit n2]), heF]
      intro h
      injection h with h1
      injection h1 with _ h2
      injection h2 with h3
      injection h3 with h4 h5
      injection h4 with hx1
      injection h5 with h6 _
      injection h6 with hx2
      exact hne (Prod.ext hx1 hx2)

theorem lowerCapRenOffMut_g10_eq {S : SigTable} (F : Nat) :
    lowerCapRenOffMut ctlEnv 0 (F + 8) (S := S) (sumL 11 .i64) g10 =
      emit (S := S) (G := []) (F + 8) (sumL 11 .i64) (.ctor 10 [.lit 2, .lit 2]) := by
