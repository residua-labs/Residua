    lf fv T v t w hB hi hD hn hs hrel hirrv hf hvinf her

theorem good_app_ctor_lit_any {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n c nlit : Nat) (lsc : List Level)
    (hnone : transparentBody E c lsc = none) :
