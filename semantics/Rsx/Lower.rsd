theorem good_ctl_g14 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g14 := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 1 5 3 g14
    (.app cSucc cZero)
    (.app (.lam (.app (.ctor 2) (.ctor 1))) .box)
    (.app (.ctor 2) (.ctor 1))
    (.ctor 2 [.ctor 1 []])
    rfl ?_ rfl rfl rfl rfl
    (good_ctl_one progs)
  intro T h
  have h14 : inferT ctlEnv 0 [] g14 = some cN := rfl
  rw [h14] at h
