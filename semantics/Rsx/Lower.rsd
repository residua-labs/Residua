      (sumL 11 .i64) (.inj 10 (.list [.int 2, .int 1]))
      ctlEnv_wf ctlBodiesTyped rfl
      ⟨9, [], [], ⟨.inductiveM, 0, .sort (.succ .zero), none⟩, rfl, rfl, rfl⟩
      rfl rfl rfl rfl rfl rfl traceErasable_ctl_g10
  obtain ⟨lf, hev⟩ := hF (F₀ + 8) (Nat.le_add_right F₀ 8)
  dsimp only at hev
  rw [lowerBindLastMut_g10_eq F₀] at hev
  exact eval_emit_ctor10_two_ne_2_1 progs 1 2 F₀ lf (by decide) (by decide) (by decide) hev

theorem lowerFieldsRevMut_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerFieldsRevMut E n F t e) progs := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h ctlEnv 0 8 4 g10 (.const 9 []) (.app (.app cMk (.lit 2)) (.lit 1))
      (sumL 11 .i64) (.inj 10 (.list [.int 2, .int 1]))
      ctlEnv_wf ctlBodiesTyped rfl
      ⟨9, [], [], ⟨.inductiveM, 0, .sort (.succ .zero), none⟩, rfl, rfl, rfl⟩
      rfl rfl rfl rfl rfl rfl traceErasable_ctl_g10
  obtain ⟨lf, hev⟩ := hF (F₀ + 8) (Nat.le_add_right F₀ 8)
  dsimp only at hev
  rw [lowerFieldsRevMut_g10_eq F₀] at hev
  exact eval_emit_ctor10_two_ne_2_1 progs 1 2 F₀ lf (by decide) (by decide) (by decide) hev

/-- Negative control showing `norm E lf e = some v` cannot be omitted from `Good`:
    when `norm E lf (.lit 5) = some v` is omitted, `v := .lit 0` satisfies every
    other premise of `Good` on `e := .lit 5` (`TraceErasable`, `inferT`, `scmValOf`,
    `relevantSpine`, `irrelevant`, `valFits`), while `lowerF` evaluates to `.int 5 ≠ .int 0`. -/
def GoodWithoutNorm {S : SigTable} (progs : Programs S S) (E : ResolvedEnv) (n : Nat)
    (e : Expr Nat) : Prop :=
  ∀ (lf fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val),
    BodiesTyped E n →
    inferT E n [] e = some T → DataTy E T →
    scmValOf E fv v = some w →
    relevantSpine E n fv v = true → irrelevant E n [] v = false → valFits fv t w = true →
    inferT E n [] v = some T →
    TraceErasable E n lf e →
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e) = some w

theorem not_good_without_norm {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutNorm progs ctlEnv 0 (.lit 5) := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 8 4 cN (.lit 0) .i64 (.int 0)
      ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl
      (traceErasable_lit ctlEnv 0 8 5)
  obtain ⟨lf, hev⟩ := hF (F₀ + 1) (Nat.le_succ F₀)
  rw [lowerF_lit ctlEnv 0 5 F₀] at hev
  have hk : inI64Range (Int.ofNat 5) = true := by decide
  rw [if_pos hk] at hev
  cases lf with
  | zero =>
      rw [eval_fuel0] at hev
      exact Option.noConfusion hev
  | succ _ =>
      simp only [Residua.Bootstrap.Semantics.eval, hk] at hev
      injection hev with h1
      injection h1 with h2
      exact absurd h2 (by decide)

def GoodWithoutIrrelevantFalse {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat) : Prop :=
  ∀ (lf fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val),
    BodiesTyped E n →
    inferT E n [] e = some T → DataTy E T →
    norm E lf e = some v → scmValOf E fv v = some w →
    relevantSpine E n fv v = true → valFits fv t w = true →
    inferT E n [] v = some T →
    TraceErasable E n lf e →
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e) = some w

theorem not_good_without_irrelevant_false {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutIrrelevantFalse progs ctlEnv 0 cIntro := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 2 1 cTrue cIntro cIntroTyNat (.inj 5 (.list []))
      ctlBodiesTyped rfl cIntroData rfl cIntroVal cIntroRel cIntroFits rfl
      (traceErasable_const_head ctlEnv 0 2 5 [] rfl)
  obtain ⟨lf, hev⟩ := hF F₀ (Nat.le_refl F₀)
  rw [lowerF_cIntro] at hev
  exact eval_refuse_ne progs lf [] (.inj 5 (.list [])) hev

def GoodWithoutValFits {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat) : Prop :=
  ∀ (lf fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val),
    BodiesTyped E n →
    inferT E n [] e = some T → DataTy E T →
    norm E lf e = some v → scmValOf E fv v = some w →
    relevantSpine E n fv v = true → irrelevant E n [] v = false →
    inferT E n [] v = some T →
    TraceErasable E n lf e →
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e) = some w

theorem lowerF_lit_tyNat1_refuse {S : SigTable} (E : ResolvedEnv) (n k F : Nat) :
    lowerF E n F (S := S) tyNat1 (.lit k) = refuse := by
  cases F with
  | zero => rfl
  | succ _ => rfl

theorem not_good_without_valFits {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutValFits progs ctlEnv 0 (.lit 5) := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 2 1 cN (.lit 5) tyNat1 (.int 5)
      ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl
      (traceErasable_lit ctlEnv 0 2 5)
  obtain ⟨lf, hev⟩ := hF F₀ (Nat.le_refl F₀)
  rw [lowerF_lit_tyNat1_refuse ctlEnv 0 5 F₀] at hev
  exact eval_refuse_ne progs lf [] (.int 5) hev

theorem cfValData : DataTy closedFlipEnv cfValTy :=
  ⟨5, [], [.app (.lam (.app cfP (.lit 0)) (.bvar 0)) cfY],
    ⟨.inductiveM, 0, .pi (.app cfP cfRedex) (.sort .zero), none⟩, rfl, rfl, rfl⟩

theorem traceErasable_cfApp : TraceErasable closedFlipEnv 0 4 cfApp :=
  ⟨cfApp_er, normErasable_of_checkNormErasable closedFlipEnv 0 4 4 cfApp rfl⟩

theorem traceErasable_cfDelta : TraceErasable closedFlipDeltaEnv 0 5 cfDelta :=
  ⟨cfDelta_er, normErasable_of_checkNormErasable closedFlipDeltaEnv 0 4 5 cfDelta rfl⟩

/-- Negative control showing `inferT E n [] e = some T` cannot be omitted from `Good`
    under `TraceErasable E n lf e`: on `(closedFlipEnv, cfApp)` with `T := cfValTy`,
    `BodiesTyped`, `DataTy`, `norm`, `scmValOf`, `relevantSpine`, `irrelevant v = false`,
    `valFits`, `inferT v = some T`, and `TraceErasable` all hold, yet `lowerF` refuses. -/
def GoodWithoutInferTE {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat) : Prop :=
  ∀ (lf fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val),
    BodiesTyped E n →
    DataTy E T →
    norm E lf e = some v → scmValOf E fv v = some w →
    relevantSpine E n fv v = true → irrelevant E n [] v = false → valFits fv t w = true →
    inferT E n [] v = some T →
    TraceErasable E n lf e →
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e) = some w

theorem not_good_without_inferT_e {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutInferTE progs closedFlipEnv 0 cfApp := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 4 2 cfValTy cfVal (sumL 7 .i64) (.inj 6 (.list [.int 0]))
      (cfBodies 0) cfValData cfApp_norm cfVal_scm cfVal_spine cfVal_rel cfFits
      cfVal_ty traceErasable_cfApp
  obtain ⟨lf, he⟩ := hF F₀ (Nat.le_refl F₀)
  exact eval_irrelevant_ne progs closedFlipEnv 0 (sumL 7 .i64) cfApp _
    cfApp_irr (fun k => app_ne_lit cfK cfRedex k) F₀ lf he

/-- Negative control showing `inferT E n [] v = some T` cannot be weakened to
    `(inferT E n [] v).isSome = true` in `Good` even under `TraceErasable E n lf e`:
    on `(closedFlipEnv, cfApp)` with `T := cfTy`, every premise including
    `TraceErasable closedFlipEnv 0 4 cfApp` holds, yet `lowerF` refuses. -/
def GoodWithoutInferTV {S : SigTable} (progs : Programs S S)
    (E : ResolvedEnv) (n : Nat) (e : Expr Nat) : Prop :=
  ∀ (lf fv : Nat) (T v : Expr Nat) (t : BootTy) (w : Val),
    BodiesTyped E n →
    inferT E n [] e = some T → DataTy E T →
    norm E lf e = some v → scmValOf E fv v = some w →
    relevantSpine E n fv v = true → irrelevant E n [] v = false → valFits fv t w = true →
    (inferT E n [] v).isSome = true →
    TraceErasable E n lf e →
    ∃ F₀, ∀ F, F₀ ≤ F →
      ∃ lf', Residua.Bootstrap.Semantics.eval lawsA progs lf' []
        (lowerF E n F (S := S) t e) = some w

theorem not_good_without_inferT_v {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutInferTV progs closedFlipEnv 0 cfApp := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 4 2 cfTy cfVal (sumL 7 .i64) (.inj 6 (.list [.int 0]))
      (cfBodies 0) cfApp_infer cfData cfApp_norm cfVal_scm cfVal_spine cfVal_rel cfFits
      cfVal_vinfer traceErasable_cfApp
  obtain ⟨lf, he⟩ := hF F₀ (Nat.le_refl F₀)
  exact eval_irrelevant_ne progs closedFlipEnv 0 (sumL 7 .i64) cfApp _
    cfApp_irr (fun k => app_ne_lit cfK cfRedex k) F₀ lf he

theorem not_good_without_inferT_v_delta {S : SigTable} (progs : Programs S S) :
    ¬ GoodWithoutInferTV progs closedFlipDeltaEnv 0 cfDelta := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 5 2 cfTy cfVal (sumL 7 .i64) (.inj 6 (.list [.int 0]))
      cfDeltaBodies cfDelta_infer cfDeltaData cfDelta_norm cfVal_scm_delta
      cfVal_spine_delta cfVal_rel_delta cfFits cfVal_vinfer_delta traceErasable_cfDelta
  obtain ⟨lf, he⟩ := hF F₀ (Nat.le_refl F₀)
  exact eval_irrelevant_ne progs closedFlipDeltaEnv 0 (sumL 7 .i64) cfDelta _
    cfDelta_irr (fun k => const_ne_lit 7 k []) F₀ lf he

/-! ### Conversion-free CBN-vs-CBV counterexample (`litAppEnv`) -/

def litAppEnv : ResolvedEnv where
  members := fun r =>
    match r with
    | 0 => some ⟨.inductiveM, 0, .sort (.succ .zero), none⟩
    | 1 => some ⟨.constructorM, 0, .pi (.const 0 []) (.const 0 []), none⟩
    | 2 => some ⟨.constructorM, 0, .const 0 [], none⟩
    | _ => none

def litAppN : Expr Nat := .const 0 []
def litAppTerm : Expr Nat :=
  .app (.lam litAppN (.const 2 [])) (.app (.lit 0) (.const 2 []))

theorem litAppEnv_closed : EnvClosed litAppEnv := by
  intro r m hm
  match r, hm with
  | 0, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 1, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 2, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | _ + 3, hm => exact Option.noConfusion hm

theorem litAppEnv_wf : EnvWf litAppEnv := by
  refine ⟨litAppEnv_closed, ?_⟩
  intro r m hm
  match r, hm with
  | 0, hm => cases hm; exact ⟨⟨_, ⟨hasTyT_of_inferT rfl⟩⟩, fun _ hb => nomatch hb⟩
  | 1, hm => cases hm; exact ⟨⟨_, ⟨hasTyT_of_inferT rfl⟩⟩, fun _ hb => nomatch hb⟩
  | 2, hm => cases hm; exact ⟨⟨_, ⟨hasTyT_of_inferT rfl⟩⟩, fun _ hb => nomatch hb⟩
  | _ + 3, hm => exact Option.noConfusion hm

theorem litAppBodies : BodiesTyped litAppEnv 0 := by
  intro r m b _ hm _ hb _ _
  match r, hm with
  | 0, hm => cases hm; cases hb
  | 1, hm => cases hm; cases hb
  | 2, hm => cases hm; cases hb
  | _ + 3, hm => exact Option.noConfusion hm

theorem litAppData : DataTy litAppEnv litAppN :=
  ⟨0, [], [], ⟨.inductiveM, 0, .sort (.succ .zero), none⟩, rfl, rfl, rfl⟩

theorem litAppTerm_er : Erasable litAppEnv 0 litAppTerm :=
  ⟨3, .app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2)), rfl⟩

theorem erase_litAppTerm_succ (F : Nat) :
    erase litAppEnv 0 (F + 3) [] litAppTerm =
      some (.app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2))) := by
  have h3 : erase litAppEnv 0 3 [] litAppTerm =
      some (.app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2))) := rfl
  exact erase_mono litAppEnv 0 3 (F + 3) [] litAppTerm _ (by omega) h3

theorem run_litAppTerm_none :
    ∀ (F : Nat),
      run (defunc (.app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2)))).2 F []
        (defunc (.app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2)))).1 = none
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | _ + 3 => rfl

theorem evalL_litAppTerm_none :
    ∀ (F : Nat),
      evalL F [] (.app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2))) = none
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | _ + 3 => rfl

theorem litAppTerm_not_normErasable : ¬ NormErasable litAppEnv 0 3 litAppTerm := by
  rintro ⟨⟨hstep, _⟩, _⟩
  obtain ⟨F, le, he, hev⟩ :=
    hstep 1 (.ctor 2) (.ctor 2 []) rfl rfl rfl
  have hle : le = .app (.lam (.ctor 2)) (.app (.lit 0) (.ctor 2)) :=
    erase_unique litAppEnv 0 F 3 [] litAppTerm le _ he rfl
  subst hle
  rw [evalL_litAppTerm_none F] at hev
  exact Option.noConfusion hev

theorem litAppTerm_not_traceErasable : ¬ TraceErasable litAppEnv 0 3 litAppTerm :=
  fun h => litAppTerm_not_normErasable h.2

theorem not_goodWfSameTy_litAppTerm {S : SigTable} (progs : Programs S S) :
    ¬ GoodWfSameTy progs litAppEnv 0 litAppTerm := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h 3 2 litAppN (.const 2 []) (sumL 3 .i64) (.inj 2 (.list []))
      litAppBodies rfl litAppData rfl rfl rfl rfl rfl rfl litAppTerm_er
  obtain ⟨lf, hev⟩ := hF (F₀ + 3) (Nat.le_add_right F₀ 3)
  simp only [lowerF, pipeline, erase_litAppTerm_succ F₀, run_litAppTerm_none (F₀ + 3)] at hev
  exact eval_refuse_ne progs lf [] (.inj 2 (.list [])) hev

/-! ### `lib/Kernel/Chain.rsd` environment model (`chainEnv`) satisfiability -/

def chNat : Expr Nat := .const 0 []
def chZero : Expr Nat := .const 1 []
def chSucc : Expr Nat := .const 2 []

/-- `lib/Kernel/Chain.rsd` model:
    - 0: inductive `Nat`
    - 1: constructor `zero : Nat`
    - 2: constructor `succ : Nat → Nat`
    - 3: `layersOff : Nat := zero` (`Chain.rsd` `def layersOff : Int := 0`)
    - 4: `keyVal : Nat := succ (succ zero)` (`Chain.rsd` `def keyVal : Int := 2`)
    - 5: `bumpLayer : Nat → Nat := λ x : Nat, succ x`
    - 6: `chAppBeta : Nat := bumpLayer keyVal`
    - 7: `chLetLayers : Nat := let l : Nat := layersOff in bumpLayer (bumpLayer l)` -/
def chainEnv : ResolvedEnv where
  members := fun r =>
    match r with
    | 0 => some ⟨.inductiveM, 0, .sort (.succ .zero), none⟩
    | 1 => some ⟨.constructorM, 0, chNat, none⟩
    | 2 => some ⟨.constructorM, 0, .pi chNat chNat, none⟩
    | 3 => some ⟨.definitionM, 0, chNat, some chZero⟩
    | 4 => some ⟨.definitionM, 0, chNat, some (.app chSucc (.app chSucc chZero))⟩
    | 5 => some ⟨.definitionM, 0, .pi chNat chNat, some (.lam chNat (.app chSucc (.bvar 0)))⟩
    | 6 => some ⟨.definitionM, 0, chNat, some (.app (.const 5 []) (.const 4 []))⟩
    | 7 => some ⟨.definitionM, 0, chNat,
        some (.letE chNat (.const 3 [])
          (.app (.const 5 []) (.app (.const 5 []) (.bvar 0))))⟩
    | _ => none

def chLayersOff : Expr Nat := .const 3 []
def chKeyVal : Expr Nat := .const 4 []
def chAppBeta : Expr Nat := .const 6 []
def chLetLayers : Expr Nat := .const 7 []

theorem chainEnv_closed : EnvClosed chainEnv := by
  intro r m hm
  match r, hm with
  | 0, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 1, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 2, hm => cases hm; exact ctl_member_closed _ rfl (fun _ hb => nomatch hb)
  | 3, hm => cases hm; exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | 4, hm => cases hm; exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | 5, hm => cases hm; exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | 6, hm => cases hm; exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | 7, hm => cases hm; exact ctl_member_closed _ rfl (fun b hb => by cases hb; rfl)
  | _ + 8, hm => exact Option.noConfusion hm

private theorem chain_member_wf (m : CheckedMember) (u : Level)
    (ht : inferT chainEnv m.arity [] m.mtype = some (.sort u))
    (hb : ∀ b, m.body = some b → inferT chainEnv m.arity [] b = some m.mtype) :
    (∃ u, Nonempty (HasTyT chainEnv m.arity [] m.mtype (.sort u))) ∧
      (∀ b, m.body = some b → Nonempty (HasTyT chainEnv m.arity [] b m.mtype)) :=
  ⟨⟨u, ⟨hasTyT_of_inferT ht⟩⟩,
   fun b hsome => ⟨hasTyT_of_inferT (hb b hsome)⟩⟩

theorem chainEnv_wf : EnvWf chainEnv := by
  refine ⟨chainEnv_closed, ?_⟩
  intro r m hm
  match r, hm with
  | 0, hm => cases hm; exact chain_member_wf _ _ rfl (fun _ hb => nomatch hb)
  | 1, hm => cases hm; exact chain_member_wf _ _ rfl (fun _ hb => nomatch hb)
  | 2, hm => cases hm; exact chain_member_wf _ _ rfl (fun _ hb => nomatch hb)
  | 3, hm => cases hm; exact chain_member_wf _ _ rfl (fun b hb => by cases hb; rfl)
  | 4, hm => cases hm; exact chain_member_wf _ _ rfl (fun b hb => by cases hb; rfl)
  | 5, hm => cases hm; exact chain_member_wf _ _ rfl (fun b hb => by cases hb; rfl)
  | 6, hm => cases hm; exact chain_member_wf _ _ rfl (fun b hb => by cases hb; rfl)
  | 7, hm => cases hm; exact chain_member_wf _ _ rfl (fun b hb => by cases hb; rfl)
  | _ + 8, hm => exact Option.noConfusion hm

theorem chainEnv_bodiesTyped : BodiesTyped chainEnv 0 := by
  intro r m b ls hm _ hb hlen _
  match r, hm with
  | 0, hm => cases hm; cases hb
  | 1, hm => cases hm; cases hb
  | 2, hm => cases hm; cases hb
  | 3, hm =>
      cases hm; cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 4, hm =>
      cases hm; cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 5, hm =>
      cases hm; cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 6, hm =>
      cases hm; cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 7, hm =>
      cases hm; cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | _ + 8, hm => exact Option.noConfusion hm

theorem traceErasable_chain_layersOff : TraceErasable chainEnv 0 8 chLayersOff :=
  ⟨⟨2, _, rfl⟩, normErasable_of_checkNormErasable chainEnv 0 8 8 chLayersOff rfl⟩

theorem traceErasable_chain_keyVal : TraceErasable chainEnv 0 8 chKeyVal :=
  ⟨⟨4, _, rfl⟩, normErasable_of_checkNormErasable chainEnv 0 8 8 chKeyVal rfl⟩

theorem traceErasable_chain_appBeta : TraceErasable chainEnv 0 8 chAppBeta :=
  ⟨⟨6, _, rfl⟩, normErasable_of_checkNormErasable chainEnv 0 8 8 chAppBeta rfl⟩

theorem traceErasable_chain_letLayers : TraceErasable chainEnv 0 8 chLetLayers :=
  ⟨⟨8, _, rfl⟩, normErasable_of_checkNormErasable chainEnv 0 8 8 chLetLayers rfl⟩

theorem checkRsxCert_chain_layersOff :
    checkRsxCert chainEnv 0 8 4 8 tyNat1 chLayersOff =
      .ok (chZero, .inj 1 (.list [])) := rfl

theorem checkRsxCert_chain_keyVal :
    checkRsxCert chainEnv 0 8 4 8 tyNat3 chKeyVal =
      .ok (.app chSucc (.app chSucc chZero),
        .inj 2 (.list [.inj 2 (.list [.inj 1 (.list [])])])) := rfl

theorem checkRsxCert_chain_appBeta :
    checkRsxCert chainEnv 0 8 6 8 (sumL 3 tyNat3) chAppBeta =
      .ok (.app chSucc (.app chSucc (.app chSucc chZero)),
        .inj 2 (.list [.inj 2 (.list [.inj 2 (.list [.inj 1 (.list [])])])])) := rfl

theorem checkRsxCert_chain_letLayers :
    checkRsxCert chainEnv 0 8 4 8 tyNat3 chLetLayers =
      .ok (.app chSucc (.app chSucc chZero),
        .inj 2 (.list [.inj 2 (.list [.inj 1 (.list [])])])) := rfl

end Lower
end Rsx

