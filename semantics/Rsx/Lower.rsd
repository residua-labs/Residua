theorem erase_g03_succ (F : Nat) :
    erase ctlEnv 0 (F + 2) [] g03 = some (.app (.ctor 2) (.lit 4)) := by
  have h2 : erase ctlEnv 0 2 [] g03 = some (.app (.ctor 2) (.lit 4)) := rfl
