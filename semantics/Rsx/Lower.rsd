theorem good_ctl_g13 {S : SigTable} (progs : Programs S S) :
    Good progs ctlEnv 0 g13 := by
  refine good_of_whnf_steps_and_run_eq progs ctlEnv 0 2 6 6 g13
    (.app cSucc (.app (.lam cN (.app cSucc (.bvar 0))) (.lit 0)))
    (.letE (.lam (.app (.ctor 2) (.bvar 0)))
      (.app (.bvar 0) (.app (.bvar 0) (.lit 0))))
    (.app (.ctor 2) (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 0)))
    (.ctor 2 [.ctor 2 [.lit 0]])
    rfl ?_ rfl rfl rfl rfl
    (good_ctl_g13_reduct progs)
  intro T h
  have h13 : inferT ctlEnv 0 [] g13 = some cN := rfl
