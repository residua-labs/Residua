theorem lowerCapRenOffMut_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerCapRenOffMut E n F t e) progs := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h ctlEnv 0 8 4 g10 (.const 9 []) (.app (.app cMk (.lit 2)) (.lit 1))
      (sumL 11 .i64) (.inj 10 (.list [.int 2, .int 1]))
      ctlEnv_wf ctlBodiesTyped rfl
      ⟨9, [], [], ⟨.inductiveM, 0, .sort (.succ .zero), none⟩, rfl, rfl, rfl⟩
      rfl rfl rfl rfl rfl rfl traceErasable_ctl_g10
  obtain ⟨lf, hev⟩ := hF (F₀ + 8) (Nat.le_add_right F₀ 8)
  dsimp only at hev
  rw [lowerCapRenOffMut_g10_eq F₀] at hev
  exact eval_emit_ctor10_two_ne_2_1 progs 2 2 F₀ lf (by decide) (by decide) (by decide) hev

theorem lowerBindLastMut_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerBindLastMut E n F t e) progs := by
  intro h
