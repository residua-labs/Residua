theorem runMut_g04_none :
    ∀ (F : Nat),
      runWith (fun _ caps => caps)
        (defunc (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4))).2
        F []
        (defunc (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4))).1 = none
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | _ + 3 => rfl

theorem lowerRunMut_g04_eq_refuse {S : SigTable} (F : Nat) :
