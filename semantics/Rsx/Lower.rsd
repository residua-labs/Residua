/-! ### Four stage-parameter mutant refutations (`lowerEraseMut_not_adequacyClosed`,
    `lowerDefuncMut_not_adequacyClosed`, `lowerRunMut_not_adequacyClosed`,
    `lowerEmitMut_not_adequacyClosed`), conversion-free CBN-vs-CBV separation
    (`litAppEnv`), `not_good_without_norm`, and `lib/Kernel/Chain.rsd` (`chainEnv`)
    satisfiability -/

theorem ctlBodiesTyped : BodiesTyped ctlEnv 0 := by
  intro r m b ls hm _ hb hlen _
  match r, hm with
  | 0, hm => cases hm; cases hb
  | 1, hm => cases hm; cases hb
  | 2, hm => cases hm; cases hb
  | 3, hm => exact Option.noConfusion hm
  | 4, hm => cases hm; cases hb
  | 5, hm => cases hm; cases hb
  | 6, hm => cases hm; cases hb
  | 7, hm => cases hm; cases hb
  | 8, hm => cases hm; cases hb
  | 9, hm => cases hm; cases hb
  | 10, hm => cases hm; cases hb
  | 11, hm =>
      cases hm
      cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 12, hm =>
      cases hm
      cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | 13, hm => cases hm; cases hb
  | 14, hm =>
      cases hm
      cases hb
      cases ls with
      | nil => exact ⟨hasTyT_of_inferT rfl⟩
      | cons _ _ => exact Nat.noConfusion hlen
  | _ + 15, hm => exact Option.noConfusion hm

/-- Stage-1 mutant: replaces `irrelevant E n` in `eraseWith` with `fun _ _ => true`. -/
def lowerEraseMut (E : ResolvedEnv) (_ : Nat) (F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (eraseWith (fun _ _ => true) noGlobals E) defunc run emit F t e

/-- Stage-2 mutant: replaces `capRen` in `convWith` with `fun _ _ => 1`. -/
def lowerDefuncMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) (convWith (fun _ _ => 1) id []) run emit F t e

/-- Stage-3 mutant: replaces `bindArg` in `runWith` with `fun _ caps => caps`. -/
def lowerRunMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) defunc (runWith (fun _ caps => caps)) emit F t e

/-- Stage-4 mutant: replaces `relevantArgs` in `emitWith` with `fun _ => []`. -/
def lowerEmitMut (E : ResolvedEnv) (n F : Nat) {S : SigTable}
    (t : BootTy) (e : Expr Nat) : BootExpr S [] t :=
  pipeline (erase E n) defunc run (emitWith (fun _ => [])) F t e

theorem lowerEraseMut_g02_eq_refuse {S : SigTable} (F : Nat) :
    lowerEraseMut ctlEnv 0 (F + 1) (S := S) tyNat1 g02 = refuse := by
  have he : eraseWith (fun _ _ => true) noGlobals ctlEnv (F + 1) [] g02 = some .box := rfl
  have hr : run (defunc .box).2 (F + 1) [] (defunc .box).1 = some .box := rfl
  simp only [lowerEraseMut, pipeline, he, hr, emit_box_eq_refuse]

theorem lowerEraseMut_not_adequacyClosed {S : SigTable} (progs : Programs S S) :
    ¬ adequacyClosedFor (S := S) (fun E n F t e => lowerEraseMut E n F t e) progs := by
  intro h
  obtain ⟨F₀, hF⟩ :=
    h ctlEnv 0 8 4 g02 cN cZero tyNat1 (.inj 1 (.list []))
      ctlEnv_wf ctlBodiesTyped rfl ctlNData rfl rfl rfl rfl rfl rfl
      traceErasable_ctl_g02
  obtain ⟨lf, hev⟩ := hF (F₀ + 1) (Nat.le_succ F₀)
  dsimp only at hev
  rw [lowerEraseMut_g02_eq_refuse F₀] at hev
  exact eval_refuse_ne progs lf [] (.inj 1 (.list [])) hev

theorem erase_g04_succ (F : Nat) :
    erase ctlEnv 0 (F + 4) [] g04 =
      some (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4)) := by
  have h4 : erase ctlEnv 0 4 [] g04 =
      some (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4)) := rfl
  exact erase_mono ctlEnv 0 4 (F + 4) [] g04 _ (by omega) h4

theorem run_defuncMut_g04_none :
    ∀ (F : Nat),
      run (convWith (fun _ _ => 1) id []
            (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4))).2
        F []
        (convWith (fun _ _ => 1) id []
            (.app (.lam (.app (.ctor 2) (.bvar 0))) (.lit 4))).1 = none
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | _ + 3 => rfl

theorem lowerDefuncMut_g04_eq_refuse {S : SigTable} (F : Nat) :
    lowerDefuncMut ctlEnv 0 (F + 4) (S := S) tyNat1 g04 = refuse := by
  simp only [lowerDefuncMut, pipeline, erase_g04_succ F, run_defuncMut_g04_none (F + 4)]

