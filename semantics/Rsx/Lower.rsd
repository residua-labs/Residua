theorem run_g03_succ (F : Nat) :
    run (defunc (.app (.ctor 2) (.lit 4))).2 (F + 2) []
      (defunc (.app (.ctor 2) (.lit 4))).1 = some (.ctor 2 [.lit 4]) := by
  have h2 : run (defunc (.app (.ctor 2) (.lit 4))).2 2 []
      (defunc (.app (.ctor 2) (.lit 4))).1 = some (.ctor 2 [.lit 4]) := rfl
