#guard heapLen (progOf pPushShared) .counted [5] == some 2

-- the non-consuming new primitives are inside the fragment; every consuming one is outside
#guard [pIsScalar, pBox, pUnbox, pBoxS, pShrW, pDivRemU, pRemU, pDivU, pArrEmpty, pGetEmpty,
        pWAdd, pWSub, pWMul, pWDivRem, pWDiv, pWRem, pWLt, pWLe, pWAnd, pWOr, pWXor, pWNot,
        pWShl, pWShr, pFAdd, pFSub, pFMul, pFDiv, pFLt, pFLe, pFEq, pFNeg, pFAbs, pFSqrt,
        pFFloor, pFCeil, pFRound, pFOfW, pFOfI, pFToW, pFBits].all (Sem.rcObsFreeDepth 64)
#guard [pRead, pPush, pPushShared, pPushList, pSet, pSetShared, pSetList, pSetObj, pGetObj, pOfList, pOfListShared,
        pToList, pToListShared, pSlice, pSliceEmpty].all (fun b => !Sem.rcObsFreeDepth 64 b)
#guard [121, 126, 119, 120, 107, 108, 109, 116, 117, 118, 127, 128,
        65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77,
        78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94,
        55, 56, 57, 61, 62, 97].all (fun p => !Sem.consumes p)
#guard [122, 123, 124, 125, 58, 59, 60, 63, 95, 96, 98].all Sem.consumes

-- ARRAY-0: the two index words
#guard bothValue (progOf pAUSize) [5] "2 #[5 3]"
#guard bothValue (progOf pAUSizeFree) [5] "0"
#guard bothValue (progOf pWToN) [5] "5"
#guard bothValue (progOf pWToN) [-1] "18446744073709551615"
-- aEmpty is an array object; aMk repeats its element; a u8 element keeps a byte
#guard bothValue (progOf pAEmpty) [5] "0 #[]"
#guard bothValue (progOf pAMk) [5] "#[7 7 7]"
#guard bothValue (progOf pAMkU8) [5] "#[44]"
-- the two crossings
#guard bothValue (progOf pAOfList) [5] "#[5 3]"
#guard bothValue (progOf pAToList) [5] "[5 3]"
-- size, get, and the refusal past the size
#guard bothValue (progOf pASize) [5] "2 #[5 3]"
#guard bothValue (progOf pAGet) [5] "3"
#guard bothStop (progOf pAGetOut) [5]
-- set unique (in place when counted), set shared (a copy), and a byte set
#guard bothValue (progOf pASet) [5] "#[9 3]"
#guard bothValue (progOf pASetShared) [5] "#[5 3] #[9 3]"
#guard bothValue (progOf pASetU8) [5] "#[44 5]"
-- push, pop, its empty case, a clamped slice, append with an empty half
#guard bothValue (progOf pAPush) [5] "#[5 3 7]"
#guard bothValue (progOf pAPop) [5] "#[5]"
#guard bothValue (progOf pAPopEmpty) [5] "#[]"
#guard bothValue (progOf pASlice) [5] "#[5 3] #[5]"
