-- the non-consuming seq operators are inside the fragment; every consuming one is outside
#guard [pAUSizeFree, pWToN, pAEmpty, pAGetFree, pASliceFree].all (Sem.rcObsFreeDepth 64)
#guard [pASize, pAUSize, pAGet, pAGetOut, pASlice, pASlicePast, pAMk, pAMkU8, pAOfList, pAToList, pASet, pASetShared,
        pASetU8, pAPush, pAPop, pAPopEmpty, pAAppend, pAAppendEmpty].all (fun b => !Sem.rcObsFreeDepth 64 b)

/-! ### Garbage freedom of the array primitives: every program releases what it made and returns x0.
A count the semantics forgot (an element a copy shares, a cell or an array not released) leaves a
live object that nothing reaches, or frees one twice. -/
def gPushShared : N :=
  mkVDecl 1 tyObj (mkCtor cNil []) (mkVDecl 2 tyObj (mkPrim 122 0 0 [1, 0]) (mkInc 2 1 false false
    (mkVDecl 3 tyI64 (mkLit 7) (mkVDecl 4 tyObj (mkPrim 122 0 0 [2, 3]) (mkDec 2 1 false false (mkDec 4 1 false false (mkRet [0])))))))
def gPushSharedObj : N :=
  withObjArr (mkInc 3 1 false false (mkVDecl 5 tyObj (mkCtor cBox [0, 0]) (mkVDecl 6 tyObj (mkPrim 122 1 0 [3, 5])
    (mkDec 3 1 false false (mkDec 6 1 false false (mkRet [0]))))))
def gSetObj : N :=
  withObjArr (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyObj (mkCtor cBox [4, 4]) (mkVDecl 6 tyObj (mkPrim 123 1 0 [3, 4, 5])
    (mkDec 6 1 false false (mkRet [0])))))
def gSetSharedObj : N :=
  withObjArr (mkInc 3 1 false false (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyObj (mkCtor cBox [4, 4])
    (mkVDecl 6 tyObj (mkPrim 123 1 0 [3, 4, 5]) (mkDec 3 1 false false (mkDec 6 1 false false (mkRet [0])))))))
-- two object elements, the array shared, element 0 replaced: the copy shares element 1
def gSetSharedObj2 : N :=
  withObjArr (mkVDecl 4 tyObj (mkCtor cBox [0, 0]) (mkVDecl 5 tyObj (mkPrim 122 1 0 [3, 4]) (mkInc 5 1 false false
    (mkVDecl 6 tyI64 (mkLit 0) (mkVDecl 7 tyObj (mkCtor cBox [6, 6]) (mkVDecl 8 tyObj (mkPrim 123 1 0 [5, 6, 7])
      (mkDec 5 1 false false (mkDec 8 1 false false (mkRet [0])))))))))
def gGetObj : N :=
  withObjArr (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyObj (mkPrim 121 1 0 [3, 4]) (mkDec 3 1 false false (mkDec 5 1 false false (mkRet [0])))))
def gOfList : N := withList (mkVDecl 5 tyObj (mkPrim 124 0 0 [4]) (mkDec 5 1 false false (mkRet [0])))
def gOfListShared : N :=
  withList (mkInc 4 1 false false (mkVDecl 5 tyObj (mkPrim 124 0 0 [4]) (mkDec 4 1 false false (mkDec 5 1 false false (mkRet [0])))))
-- x4: the object list [{x0 x0}]
def gOfListSharedObj : N :=
  mkVDecl 2 tyObj (mkCtor cNil []) (mkVDecl 3 tyObj (mkCtor cBox [0, 0]) (mkVDecl 4 tyObj (mkCtor cConsO [3, 2])
    (mkInc 4 1 false false (mkVDecl 5 tyObj (mkPrim 124 1 0 [4]) (mkDec 4 1 false false (mkDec 5 1 false false (mkRet [0])))))))
def gToList : N := withArr (mkVDecl 5 tyObj (mkPrim 125 0 0 [4]) (mkDec 5 1 false false (mkRet [0])))
def gToListObj : N := withObjArr (mkVDecl 4 tyObj (mkPrim 125 0 0 [3]) (mkDec 4 1 false false (mkRet [0])))
def gToListSharedObj : N :=
  withObjArr (mkInc 3 1 false false (mkVDecl 4 tyObj (mkPrim 125 0 0 [3]) (mkDec 3 1 false false (mkDec 4 1 false false (mkRet [0])))))
def gSliceObj : N :=
  withObjArr (mkVDecl 4 tyI64 (mkLit 0) (mkVDecl 5 tyI64 (mkLit 1) (mkVDecl 6 tyObj (mkPrim 126 1 0 [3, 4, 5])
    (mkDec 3 1 false false (mkDec 6 1 false false (mkRet [0]))))))

#guard [gPushShared, gPushSharedObj, gSetObj, gSetSharedObj, gSetSharedObj2, gGetObj, gOfList, gOfListShared, gOfListSharedObj,
        gToList, gToListObj, gToListSharedObj, gSliceObj].all
  (fun b => Sem.garbageFreeRun (progOf b) 0 [5] 10 1000 == some true && bothValue (progOf b) [5] "5")

/-! ### The consuming primitives observe the count: the fifth counterexample.
An array held by two references (x2 itself and the box x3, stored with no inc: its count is 1, one too
low), pushed in place in the counted run and read through the box: counted 2, pure 1. With the
count right (two incs before the box is made) both runs copy and give 1. -/
def cexArrUndercount : N :=
  mkVDecl 1 tyObj (mkCtor cNil []) (mkVDecl 2 tyObj (mkPrim 122 0 0 [1, 0])
    (mkVDecl 3 tyObj (mkCtor cBox [2, 2]) (mkVDecl 5 tyI64 (mkLit 7)
      (mkVDecl 4 tyObj (mkPrim 122 0 0 [2, 5]) (mkVDecl 6 tyObj (mkProj 0 3)
        (mkVDecl 7 tyI64 (mkPrim 120 0 0 [6]) (mkRet [7])))))))
def cexArrSound : N :=
  mkVDecl 1 tyObj (mkCtor cNil []) (mkVDecl 2 tyObj (mkPrim 122 0 0 [1, 0]) (mkInc 2 2 false false
    (mkVDecl 3 tyObj (mkCtor cBox [2, 2]) (mkVDecl 5 tyI64 (mkLit 7)
      (mkVDecl 4 tyObj (mkPrim 122 0 0 [2, 5]) (mkVDecl 6 tyObj (mkProj 0 3)
        (mkVDecl 7 tyI64 (mkPrim 120 0 0 [6]) (mkRet [7]))))))))

#guard Sem.rcObsFreeDepth 64 cexArrUndercount == false
#guard Sem.runEntry (progOf cexArrUndercount) 0 [5] 10 100 .counted != Sem.runEntry (progOf cexArrUndercount) 0 [5] 10 100 .pure
#guard Sem.runEntry (progOf cexArrUndercount) 0 [5] 10 100 .counted == .value "2"
#guard Sem.runEntry (progOf cexArrUndercount) 0 [5] 10 100 .pure == .value "1"
#guard bothValue (progOf cexArrSound) [5] "1"

/-! ### The stage's own functions: `Lrc.nHelpers` = 20 of them after the image's take no fuel.
With one image function, f20 is the last helper (it runs at fuel 0) and f21 is not (it refuses). -/
def progHelpers : List Decl :=
  [{ f := 0, xs := [], rets := [tyI64], body := mkVDecl 1 tyI64 (mkLit 1) (mkRet [1]), ext := false },
   { f := 20, xs := [], rets := [tyI64], body := mkVDecl 1 tyI64 (mkLit 3) (mkRet [1]), ext := false },
   { f := 21, xs := [], rets := [tyI64], body := mkVDecl 1 tyI64 (mkLit 4) (mkRet [1]), ext := false }]

#guard Lrc.nHelpers == 20
#guard Sem.runEntry progHelpers 20 [] 0 100 .counted 1 == .value "3"
#guard Sem.runEntry progHelpers 20 [] 0 100 .pure 1 == .value "3"
#guard Sem.runEntry progHelpers 21 [] 0 100 .counted 1 == .stop "refusal:fuel"
#guard Sem.runEntry progHelpers 21 [] 1 100 .counted 1 == .value "4"

/-! ### Revision 2 (swe-lrcrev2): the six forms of the `Lrc` section above

`pap`/`ap` as lean.h `lean_alloc_closure`/`lean_closure_set` and src/runtime/apply.cpp
`lean_apply_n`; `box`/`unbox` as lean.h:290-291 and the typed variants
(src/include/lean/lean.h:1948-1999); `uproj`/`uset` as lean.h:572/:602 beside `sproj`/`sset`.
`r2ds` holds the callees the programs below share: f1 = x0 + x1 + x2 (primAddW), f2 = its last
argument with its object arguments released (the call lent them), f3 = a closure of f1 over x0. -/

def r2ds : List Decl :=
  [{ f := 1,
     xs := [{ x := 0, borrow := false, ty := tyI64 }, { x := 1, borrow := false, ty := tyI64 }, { x := 2, borrow := false, ty := tyI64 }],
     rets := [tyI64],
     body := mkVDecl 3 tyI64 (mkPrim 103 0 0 [0, 1]) (mkVDecl 4 tyI64 (mkPrim 103 0 0 [3, 2]) (mkRet [4])), ext := false },
   { f := 2,
     xs := [{ x := 0, borrow := false, ty := tyObj }, { x := 1, borrow := false, ty := tyObj }, { x := 2, borrow := false, ty := tyI64 }],
     rets := [tyI64],
     body := mkDec 0 1 false false (mkDec 1 1 false false (mkRet [2])), ext := false },
   { f := 3,
     xs := [{ x := 0, borrow := false, ty := tyI64 }], rets := [tyObj],
     body := mkVDecl 1 tyObj (mkPap 4 [0]) (mkRet [1]), ext := false },
   { f := 4,
     xs := [{ x := 0, borrow := false, ty := tyI64 }, { x := 1, borrow := false, ty := tyI64 }],
     rets := [tyI64],
     body := mkVDecl 2 tyI64 (mkPrim 103 0 0 [0, 1]) (mkRet [2]), ext := false }]

def progR2 (b : N) : List Decl :=
  { f := 0, xs := [{ x := 0, borrow := false, ty := tyI64 }], rets := [tyObj], body := b, ext := false } :: r2ds

-- under-application (apply.cpp `fix_args`: the exclusive closure's fields move) then exact:
-- c1 = f1[x0] (1 of 3), c2 = c1[x0] (2 of 3), c2[x0] = 15
def apUnder : N :=
  mkVDecl 1 tyObj (mkPap 1 [0]) (mkVDecl 2 tyObj (mkAp 1 [0]) (mkVDecl 3 tyI64 (mkAp 2 [0]) (mkRet [3])))

-- exact application of a shared closure that captured the same object twice (apply.cpp: a
-- lean_inc of each captured field, the call, lean_dec_ref; the remaining reference released
-- below); f2 releases the two references the call lent it
def apSharedTwice : N :=
  mkVDecl 1 tyObj (mkCtor info1 [0, 0]) (mkInc 1 1 false false
    (mkVDecl 2 tyObj (mkPap 2 [1, 1]) (mkInc 2 1 false false
      (mkVDecl 3 tyI64 (mkAp 2 [0]) (mkDec 2 1 false false (mkRet [3]))))))

-- over-application onto a scalar result (apply.cpp: the rest applies to the result; a scalar
-- applied returns itself — the erased proof): f1[x0][x0, x0, x0] = 15
def apOverScalar : N :=
  mkVDecl 1 tyObj (mkPap 1 [0]) (mkVDecl 2 tyI64 (mkAp 1 [0, 0, 0]) (mkRet [2]))

-- over-application through a closure result: d = f3[] applied to two arguments calls f3(7) for
-- the closure f1[7], then applies it to 20: 7 + 20 = 27
def apOverClo : N :=
  mkVDecl 1 tyI64 (mkLit 7) (mkVDecl 2 tyI64 (mkLit 20)
    (mkVDecl 3 tyObj (mkPap 3 []) (mkVDecl 4 tyI64 (mkAp 3 [1, 2]) (mkRet [4]))))

-- a scalar boxed and unboxed as `ty`: the tagged word for u8/u16/u32 (and any tagged type), the
-- boxed word for usize/uint64/float
def boxTrip (ty : Int) : N :=
  mkVDecl 1 tyObj (mkBox ty 0) (mkVDecl 2 tyI64 (mkUnbox ty 1) (mkRet [2]))

-- a ctor of one object field and two usize words; usize[1] := 77 read back, usize[0] still 0
def infoU : CtorInfo := { cidx := 7, size := 1, ssize := 0, tid := 7 }
def usizeRw : N :=
  mkVDecl 1 tyObj (mkUCtor infoU 2 [0])
    (mkVDecl 2 tyI64 (mkLit 77) (mkUSet 1 1 2
      (mkVDecl 3 tyI64 (mkUProj 1 1) (mkVDecl 4 tyI64 (mkUProj 0 1)
        (mkVDecl 5 tyI64 (mkPrim 103 0 0 [3, 4]) (mkRet [5]))))))

#guard bothValue (progR2 apUnder) [5] "15"
#guard bothValue (progR2 apSharedTwice) [5] "5"
-- the shared closure's fields were counted and released as lean.h counts them: nothing left live
#guard Sem.garbageFreeRun (progR2 apSharedTwice) 0 [5] 10 1000 == some true
#guard bothValue (progR2 apOverScalar) [5] "15"
#guard bothValue (progR2 apOverClo) [5] "27"
#guard Sem.garbageFreeRun (progR2 apUnder) 0 [5] 10 1000 == some true
#guard Sem.garbageFreeRun (progR2 apOverClo) 0 [5] 10 1000 == some true
#guard [tyI64, 10, 11, 12, 13, 14].all (fun ty => bothValue (progOf (boxTrip ty)) [42] "42")
#guard bothValue (progOf usizeRw) [5] "77"

/-! #### Refusals (the mutants the six forms must reject) -/

-- applying a constructor object, which is no closure
def apNonClo : N := mkVDecl 1 tyObj (mkCtor info1 [0, 0]) (mkVDecl 2 tyObj (mkAp 1 [0]) (mkRet [2]))
-- a pap holding as many arguments as the arity (lean.h:639 `assert(num_fixed < arity)`)
def papFull : N := mkVDecl 1 tyObj (mkPap 1 [0, 0, 0]) (mkRet [1])
-- a field read of a closure object
def projClo : N := mkVDecl 1 tyObj (mkPap 1 [0]) (mkVDecl 2 tyI64 (mkProj 0 1) (mkRet [2]))
-- a case on a closure
def caseClo : N := mkVDecl 1 tyObj (mkPap 1 [0]) (mkCase 1 tyI64 [mkAltDefault (mkRet [0])])
-- unboxing the tagged word as usize
def unboxTag : N := mkVDecl 1 tyObj (mkBox 10 0) (mkVDecl 2 tyI64 (mkUnbox 13 1) (mkRet [2]))
-- unboxing an object with no usize lane
def unboxNoLane : N := mkVDecl 1 tyObj (mkCtor info1 [0, 0]) (mkVDecl 2 tyI64 (mkUnbox 13 1) (mkRet [2]))
-- a uset on a shared object: the counted run refuses, the pure run writes
def usetShared : N :=
  mkVDecl 1 tyObj (mkUCtor infoU 1 [0]) (mkInc 1 1 false false (mkUSet 1 0 0 (mkRet [0])))
-- a uproj out of the usize area
def uprojOut : N := mkVDecl 1 tyObj (mkUCtor infoU 1 [0]) (mkVDecl 2 tyI64 (mkUProj 3 1) (mkRet [2]))

#guard bothStop (progR2 apNonClo) [5]
#guard Sem.runEntry (progR2 apNonClo) 0 [5] 10 100 .counted == .stop "application of object 0 with tag 1, which is no closure"
#guard bothStop (progR2 papFull) [5]
#guard bothStop (progR2 projClo) [5]
#guard bothStop (progR2 caseClo) [5]
#guard bothStop (progOf unboxTag) [42]
#guard bothStop (progOf unboxNoLane) [42]
#guard Sem.runEntry (progOf usetShared) 0 [5] 10 100 .counted == .stop "uset on object 0 with count 2"
#guard Sem.runEntry (progOf usetShared) 0 [5] 10 100 .pure == .value "5"
#guard bothStop (progOf uprojOut) [5]

/-! #### The r2 forms inside the fragment, the r1 fragment of the earlier controls, `listSet` -/

-- none of the six forms observes the reference count in the outcome sense: `ap`'s
-- exclusive/shared split is heap bookkeeping (the same values either way, as the counted and
-- pure guards above show), so `rcObsFree` needs no new exclusion
#guard [apUnder, apSharedTwice, apOverScalar, apOverClo, usizeRw].all (Sem.rcObsFreeDepth 64)
#guard [tyI64, 10, 11, 12, 13, 14].all (fun ty => Sem.rcObsFreeDepth 64 (boxTrip ty))
#guard [apNonClo, papFull, projClo, caseClo, unboxTag, unboxNoLane, usetShared, uprojOut].all (Sem.rcObsFreeDepth 64)

-- every earlier control is a program of the r1 IR (the r2 programs are not)
#guard [prog0, prog1, prog2, prog3, prog3m, prog4, prog4m, prog5, progHelpers].all
  (fun ds => ds.all (fun d => Sem.r1NodeDepth 64 d.body))
#guard [body0, body1, body2, body3, body3m, body4, body4m, body5, cexIsShared, cexResetEscape, cexReuseTag, cexUndercount,
        pIsScalar, pBox, pUnbox, pBoxS, pShrW, pDivRemU, pRemU, pDivU, pArrEmpty, pGetEmpty, pRead, pPush, pPushShared,
        pPushList, pSet, pSetShared, pSetList, pSetObj, pGetObj, pOfList, pOfListShared, pToList, pToListShared,
        pSlice, pSliceEmpty, pCaseArr, pProjArr, pGetOut, pSetOut, gPushShared, gPushSharedObj, gSetObj,
        gSetSharedObj, gSetSharedObj2, gGetObj, gOfList, gOfListShared, gOfListSharedObj, gToList, gToListObj,
        gToListSharedObj, gSliceObj, cexArrUndercount, cexArrSound].all (Sem.r1NodeDepth 64)
#guard !(Sem.r1NodeDepth 64 apUnder) && !(Sem.r1NodeDepth 64 usizeRw) && !(Sem.r1NodeDepth 64 (boxTrip 10))

-- listSet is `List.set`, and tail-recursive now (the r1 recursion overflowed the stack on
-- irsem's eqat7 and rr-append): a write past a hundred thousand cells returns the element
#guard Sem.listSet ['a', 'b', 'c'] 1 'z' == ['a', 'z', 'c']
#guard (Sem.listSet (List.replicate 100000 (7 : Int)) 99999 (-1)).get? 99999 == some (-1)

/-! ### Revision 3: the widths of a scalar field (lib/lrc/Ir.rsd `tyWidth`, instruments/lrc-host/Interp.rsd)
A cell with one scalar word; `sset` of type `ty` writes `v`, `sproj` reads `rw` bytes (0: a word). The semantics refuses what
the interpreter refuses: a value outside the stored width, and a read of other bytes than were written (the module would read
other bytes). Counterexamples are the rows that must be refused; the others are the rows the stage emits. -/
def wInfo : CtorInfo := { cidx := 1, size := 0, ssize := 8, tid := 9 }
def wBody (ty v rw : Int) : N :=
  mkVDecl 1 tyObj (mkCtor wInfo []) (mkVDecl 2 tyI64 (mkLit v)
    (mkSSet 1 0 0 2 ty (mkVDecl 3 tyI64 { mkSProj 0 0 1 with c := rw } (mkRet [3]))))
def wProg (ty v rw : Int) : List Decl :=
  [{ f := 0, xs := [{ x := 0, borrow := false, ty := tyI64 }], rets := [tyI64], body := wBody ty v rw, ext := false }]
def wRefused (ty v rw : Int) (prefix_ : String) : Bool :=
  match Sem.runEntry (wProg ty v rw) 0 [0] 10 100 .counted with
  | .stop s => s.startsWith prefix_
  | _ => false
#guard Sem.runEntry (wProg 10 255 1) 0 [0] 10 100 .counted == .value "255"
#guard Sem.runEntry (wProg 11 65535 2) 0 [0] 10 100 .counted == .value "65535"
#guard Sem.runEntry (wProg 12 4294967295 4) 0 [0] 10 100 .counted == .value "4294967295"
#guard Sem.runEntry (wProg 0 4294967296 0) 0 [0] 10 100 .counted == .value "4294967296"
#guard wRefused 10 256 1 "sset of 256 into a byte field"
#guard wRefused 11 65536 2 "sset of 65536 into a field of 2 bytes"
#guard wRefused 12 4294967296 4 "sset of 4294967296 into a field of 4 bytes"
#guard wRefused 11 (-1) 2 "sset of -1 into a field of 2 bytes"
#guard wRefused 11 7 4 "sproj of 4 bytes at byte 0 of object"
#guard wRefused 12 7 2 "sproj of 2 bytes at byte 0 of object"
#guard wRefused 0 7 4 "sproj of 4 bytes at byte 0 of object"
#guard wRefused 10 7 0 "sproj of 8 bytes at byte 0 of object"

end Lrc.SemControls

#print axioms Lrc.Sem.exec
#print axioms Lrc.Sem.runEntry
#print axioms Lrc.Sem.rcErasureStatement
#print axioms Lrc.Sem.hopPreservesStatement
#print axioms Lrc.Sem.garbageFreeStatement
#print axioms Lrc.Sem.garbageFreeRun
#print axioms Lrc.Sem.listSet_eq
#print axioms Lrc.Sem.conservativeStatement
