        let cen := { cen with memo := { cen.memo with reuseShapes := candidates.cache } }
        let argsBi := reuseKeep g lay arr bi candidates env tys
        let a := (lower lay) g argsBi tbl k 0 0 arr sigs env tys roots (d + 2) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks elem [] rest cen
        if a.ok != profile.cOk then a
        else
          let packed := if memT g arr ty then storageArrayOne g lay arr elem a.slot d a.nxt
            else reuseConsWithLayers g lay bi arr elem candidates.slots a.slot (d + 1) d a.nxt
          if !packed.ok then lwFail packed.err a.rest
          else ownReleaseWithLayers lay [ownRootWithLayers g lay arr elem a.slot]
            (lwOk a.rest (push a.code ((if memT g arr ty then [] else i64Const profile.emptyAt ++ ls (d + 1)) ++ packed.code)) packed.nxt d (cenAddType g 1 ty a.cen))

      else if ph == 9 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let d := nxt
          -- len has a borrowed argument. A variable already has an enclosing
          -- root (or the caller's borrow), so this read needs no owned copy.
          let argVar := if biOnWithLayers lay then peekVar g env t.rest else -1
          let a := if argVar < 0 then
            (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + 1) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          else
            let wire := (drE g t.rest).tail
            let actual := envTy tys (readLeb wire).n.toNat
            let v := lowerVar env (d + 1) wire cen
            if !typeEq g actual t.acc then lwFail profile.cType t.rest
            else { v with cen := ((markReadWithLayers g) lay) arr selfIdx (pbase grp) npw v.slot (sigOf sigs selfIdx) (-1) v.cen }
          let release := if argVar < 0 then [((ownRootWithLayers g) lay) arr t.acc a.slot] else []
          if a.ok != profile.cOk then a
          else if memW arr t.acc then (ownReleaseWithLayers lay) release (lwOfE (emitTE tbl 24 repArr (hbOf (stdLs a.slot a.slot a.slot d) [(((arrStrideWithLayers g) lay) arr ((innerTy g) t.acc) : Int)] [a.code])) a.rest a.nxt d a.cen)
          else (ownReleaseWithLayers lay) release (lwOfE (emitTE tbl 24 repFlat (hbOf (stdLs a.slot a.slot a.slot d) [((tailOffWithLayers g) lay) arr ((innerTy g) t.acc)] [a.code])) a.rest a.nxt d a.cen)

      else if ph == 10 then
        let elem := (innerTy g) ty
        let w := wordsOfWithLayers g lay arr elem
        let d := nxt
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + w + 2) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks (4 :: elem) [] rest cen
        if a.ok != profile.cOk then a
        else
          let isArr := memT g arr (4 :: elem)
          let ptr := d + w + 1
          let load := storageLoadField g lay arr elem (if isArr then ptr else a.slot) (if isArr then 24 else cellPayWithLayers g lay arr elem) (d + 1) a.nxt
          let empty := if isArr then ldW a.slot 8 ++ lg (a.slot + 1) ++ [81]
            else lg a.slot ++ i64Const profile.emptyAt ++ [81]
          let code := empty ++ [4, 64] ++ zeroW d (w + 1) ++ [5]
            ++ i64Const 1 ++ ls d
            ++ (if isArr then arrAddrWithLayers g lay arr elem a.slot ptr else []) ++ load.code ++ [11]
          if !load.ok then lwFail profile.cWide a.rest
          else ownReleaseWithLayers lay [ownRootWithLayers g lay arr (4 :: elem) a.slot]
            (lwOk a.rest (push a.code code) load.nxt d a.cen)

      else if ph == 11 then
        let elem := (innerTy g) ty
        let d := nxt
        -- The source constructor x :: xs is singleton x ++ xs in RSCM.
        -- Lean's constructor simplification exposes one allocation, then
        -- ResetReuse can consume the dead list root instead of that cell.
        let cons := if lay.rc && lay.reuse && !memT g arr ty then drE g rest else []
        if cons.headD (-1) == 23 then
          let ew := wordsOfWithLayers g lay arr elem
          let candidates := reuseCandidates g lay bi arr cen.memo.reuseShapes ty env tys roots
          let candidates := if candidates.slots.isEmpty then candidates else
            let headEnd := skipE g profile.skipFuel cons.tail
            let stored := reuseStoredJoin (reuseStoredSlots g lay arr env tys elem cons.tail)
              (if headEnd.ok == profile.cOk then reuseStoredSlots g lay arr env tys ty headEnd.rest else {})
            reuseExcludeStored candidates stored
          let candidates := reuseAtCtor candidates
          let cen := { cen with memo := { cen.memo with reuseShapes := candidates.cache } }
          let argsBi := reuseKeep g lay arr bi candidates env tys
          let a := lower lay g (biFollowingWithLayers lay g argsBi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + 1 + ew) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks elem [] cons.tail cen
          if a.ok != profile.cOk then a
          else
            let b := lower lay g argsBi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] a.rest a.cen
            if b.ok != profile.cOk then b
            else
              -- Representation selection is a census of the source append,
              -- independent of the constructor code chosen by ResetReuse.
              let forced := !litChain g k a.rest
              let cen2 := cenAddType g 1 ty (if forced then cenAddType g 2 ty b.cen else b.cen)
              let packed := reuseConsWithLayers g lay bi arr elem candidates.slots a.slot b.slot d b.nxt
              if !packed.ok then lwFail packed.err b.rest
              else ownReleaseWithLayers lay [ownRootWithLayers g lay arr elem a.slot, ownRootWithLayers g lay arr ty b.slot]
                (lwOk b.rest (push (join a.code b.code) packed.code) packed.nxt d cen2)
        else
          let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + 2) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] rest cen
          if a.ok != profile.cOk then a
          else
            let b := (lower lay) g bi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] a.rest a.cen
            if b.ok != profile.cOk then b
            else
              let forced := !litChain g k a.rest
              let cen2 := cenAddType g 1 ty (if forced then cenAddType g 2 ty b.cen else b.cen)
              if (memT g) arr ty then
                (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr ty a.slot, ((ownRootWithLayers g) lay) arr ty b.slot] (lwOfE (emitTE tbl 26 repArr (hbOf (stdLs a.slot b.slot a.slot d) [((tyView g elem).headD (-1))] [a.code, b.code])) b.rest b.nxt d cen2)
              else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr ty a.slot, ((ownRootWithLayers g) lay) arr ty b.slot] (lwOfE (emitTE tbl 26 repFlat (hbOf (stdLs a.slot b.slot a.slot d) [((tyView g elem).headD (-1))] [a.code, b.code])) b.rest b.nxt d cen2)

      else if ph == 12 then
        let elem := (innerTy g) ty
        let d := nxt
        -- teDropArr uses d+5 and d+6 until the final offset add.
        -- Reserve those slots before lowering either owning operand.
        let operands := if memW arr ty then d + 7 else d + 2
        let n := lower lay g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots operands npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] rest cen
        if n.ok != profile.cOk then n
        else
          let a := lower lay g bi tbl k 0 0 arr sigs env tys roots n.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] n.rest n.cen
          if a.ok != profile.cOk then a
          else if memW arr ty then
            (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr ty a.slot] (lwOfE (emitTE tbl 27 repArr (hbOf (stdLs n.slot a.slot n.slot d) [(((arrStrideWithLayers g) lay) arr elem : Int)] [n.code, a.code])) a.rest (a.nxt + 1) d a.cen)
          else
            let lit := peekLitI g rest
            if lay.rc && lay.dropSpec && lit.ok == profile.cOk && lit.n == 1 then
              let code := lg a.slot ++ i64Const profile.emptyAt ++ [81, 4, 64]
                ++ i64Const profile.emptyAt ++ ls d ++ [5]
                ++ ldW a.slot (tailOffWithLayers g lay arr elem) ++ ls d
                ++ ownDropConsWithLayers g lay arr elem a.slot d a.nxt (a.nxt + 1) ++ [11]
              { (lwOk a.rest (push (join n.code a.code) code) (a.nxt + 2) d a.cen) with resultOwned := true }
            else
              let v := lwOfE (emitTE tbl 27 repFlat (hbOf (stdLs n.slot a.slot n.slot d) [tailOffWithLayers g lay arr elem] [n.code, a.code])) a.rest a.nxt d a.cen
              { (ownReleaseWithLayers lay [ownRootWithLayers g lay arr ty a.slot] v) with resultOwned := true }

      else if ph == 13 then
        let nm := skipName rest
        if nm.ok != profile.cOk then lwFail nm.ok nm.rest
        else
          let f := ((recFieldWithLayers g) lay) arr 0 ty
          if f.ok != profile.cOk then lwFail f.ok nm.rest
          else
            let restTy := (recRest g) ty
            let w := ((wordsOfWithLayers g) lay) arr ty
            let wf := ((wordsOfWithLayers g) lay) arr f.ty
            let d := nxt
            let v := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 nm.rest) tbl k 0 0 arr sigs env tys roots (d + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks f.ty [] nm.rest cen
            if v.ok != profile.cOk then v
            else
              let r := (lower lay) g bi tbl k 0 0 arr sigs env tys roots v.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks restTy [] v.rest v.cen
              if r.ok != profile.cOk then r
              else lwOfE (emitTE tbl 34 repFlat (hbOf [v.slot, r.slot, v.slot, d, d + wf] [(wf : Int), ((w - wf : Nat) : Int)] [v.code, r.code])) r.rest r.nxt d r.cen
      else if ph == 14 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else if lay.rc && (isHeapHandle g) t.acc then lwFail profile.cType t.rest
        else
          let ix := readLeb t.rest
          if ix.ok != profile.cOk then lwFail ix.ok ix.rest
          else if ix.n < 0 || ix.n > (profile.fieldMax : Int) then lwFail profile.cBody ix.rest
          else
            let f := ((recFieldWithLayers g) lay) arr ix.n.toNat t.acc
            if f.ok != profile.cOk then lwFail f.ok ix.rest
            else if lay.rc && !(typeEq g) f.ty ty then lwFail profile.cType ix.rest
            else
              match drE g ix.rest with
              | 3 :: vb =>
                let a := lowerVar env nxt vb cen
                let vi := readLeb vb
                if a.ok != profile.cOk then a
                else if lay.rc && !(typeEq g) (envTy tys vi.n.toNat) t.acc then lwFail profile.cType vb
                else lwOfE (emitTE tbl 35 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [[]])) a.rest a.nxt (a.slot + f.off) (((markReadWithLayers g) lay) arr selfIdx (pbase grp) npw (a.slot + f.off) (sigOf sigs selfIdx) ix.n a.cen)
              | _ =>
                let operand := drE g ix.rest
                if lay.rc && lay.reuse && operand.headD (-1) == 5 then
                  lower lay g bi tbl k 39 ix.n arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty t.acc operand.tail cen
                else
                  let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] ix.rest cen
                  if a.ok != profile.cOk then a
                  else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl 35 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (a.slot + f.off) a.cen)

      else if ph == 15 then
        match drE g rest with
        | 25 :: ibs =>
          let elem := ty
          let w := ((wordsOfWithLayers g) lay) arr elem
          let d := nxt
          let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + w + 1) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks (4 :: elem) [] ibs cen
          if a.ok != profile.cOk then a
          else
            let isArr := memT g arr (4 :: elem)
            let ptr := d + w
            let load := storageLoadField g lay arr elem (if isArr then ptr else a.slot) (if isArr then 24 else cellPayWithLayers g lay arr elem) d a.nxt
            let empty := if isArr then ldW a.slot 8 ++ lg (a.slot + 1) ++ [81]
              else lg a.slot ++ i64Const profile.emptyAt ++ [81]
            let code := empty ++ voidIf (refuseStuck stTypeMismatch)
              ++ (if isArr then arrAddrWithLayers g lay arr elem a.slot ptr else []) ++ load.code
            if !load.ok then lwFail profile.cWide a.rest
            else ownReleaseWithLayers lay [ownRootWithLayers g lay arr (4 :: elem) a.slot]
              (lwOk a.rest (push a.code code) load.nxt d a.cen)
        | _ =>
          let v := peekVar g env rest
          let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks (8 :: ty) [] rest cen
          if a.ok != profile.cOk then a
          else if v >= 0 && v == ks then (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr (8 :: ty) a.slot] (lwOfE (emitTE tbl 39 repSome (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (a.slot + 1) a.cen)
          else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr (8 :: ty) a.slot] (lwOfE (emitTE tbl 39 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (a.slot + 1) a.cen)

      else if ph == 16 then
        let ix := readLeb rest
        if ix.ok != profile.cOk then lwFail ix.ok ix.rest
        else if ix.n < 0 then lwFail profile.cCall ix.rest
        else
          let sig := sigOf sigs ix.n.toNat
          if sig.length == 0 then lwFail profile.cCall ix.rest
          else if !(typeEq g) ((sigResult g) sig) ty then lwFail profile.cTypeMis ix.rest
          else if ix.n == (selfIdx : Int) && env.length == sigCount sig && (identArgs g k 0 (sigCount sig) ix.rest).ok == profile.cOk then
            let ia := identArgs g k 0 (sigCount sig) ix.rest
            lwOk ia.rest [refuseTo profile.tagFuel profile.detNone] (nxt + (wordsOfWithLayers g) lay arr ty) nxt cen
          else if tail > 0 && (ix.n == (selfIdx : Int) || memI grp ix.n)
              && biCanTail lay g profile.arityMax env arr roots ((biArgTysWithLayers g) lay bi ix.n.toNat sig false) ix.rest then
            let stash := nxt
            let cw := ((paramWordsWithLayers g) lay) arr (sigCount sig) (sigParams sig)
            let cmap := ((paramMapWithLayers g) lay) arr (sigCount sig) (sigParams sig)
            let rw := ((wordsOfWithLayers g) lay) arr ty
            let args := (lower lay) g bi tbl k 17 (stash : Int) arr sigs env tys roots (nxt + (if rw > cw then rw else cw)) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty (((biArgTysWithLayers g) lay) bi ix.n.toNat sig false) ix.rest cen
            if args.ok != profile.cOk then args
            else
              lwOfE (emitTE tbl opTail repFlat (hbOf [stash, pbase grp] [(cw : Int), (br : Int)] [push args.code ((ownEffectsWithLayers lay) 7 roots), if grp.length == 0 then [] else [i64Const ix.n ++ ls 2], [(regionResetShallowWithLayers lay) m0 m1 (pbase grp) cmap (((paramAMapWithLayers g) lay) arr (sigCount sig) (sigParams sig)) (m1 + 1) stash]])) args.rest args.nxt nxt (cenAdd 5 [(selfIdx : Int), ix.n] args.cen)
          else
            let w := ((wordsOfWithLayers g) lay) arr ty
            let aw := ((paramWordsWithLayers g) lay) arr (sigCount sig) (sigParams sig)
            let d := nxt
            let st := d + w
            let stash := st + 1
            let reuseNode := lay.rc && lay.reuse && (bi.heapKinds[ix.n.toNat]?).getD 0 == 3
            let node := if reuseNode then nthTy g 0 (sigParams sig) else []
            let candidates := if reuseNode then reuseCandidates g lay bi arr cen.memo.reuseShapes (heapHandleOf g node) env tys roots
              else { cache := cen.memo.reuseShapes }
            let candidates := reuseAtCtor candidates
            let cen := { cen with memo := { cen.memo with reuseShapes := candidates.cache } }
            let argsBi := reuseKeep g lay arr bi candidates env tys
            let args := (lower lay) g argsBi tbl k 17 (stash : Int) arr sigs env tys roots (stash + aw) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty (((biArgTysWithLayers g) lay) bi ix.n.toNat sig false) ix.rest cen
            -- tail 2: no epilogue work but the region exit, so a call in tail
            -- position is wasm return_call; the solo i64 form returns slot +
            -- acc, so it takes return_call only while acc is still 0.
            let op := if tail < 2 || !(reuseTokens roots).isEmpty then 52
              else if grp.length == 0 && (typeEq g) ty [0] then opRetCallAcc else opRetCall
            if args.ok != profile.cOk then args
            else if reuseNode then
              let packed := storagePackHeapNodeTokens g lay arr node candidates.slots
                (reuseTokens roots) stash d args.nxt
              if !packed.ok then lwFail packed.err args.rest
              else
                -- Retain call-boundary fuel semantics even though the
                -- intrinsic's allocation is emitted in the caller.
                let guard := passFuel ++ [80] ++ voidIf (refuseTo profile.tagFuel profile.detNone)
                ownReleaseWithLayers lay args.release
                  (lwOk args.rest (push args.code (guard ++ packed.code ++ i64Const 0 ++ ls (d + 1))) packed.nxt d
                    (cenAdd 5 [(selfIdx : Int), ix.n] args.cen))
            else
              let wide := abiWideSignature g lay arr sig
              let frame := args.nxt
              let iw := abiIndirectWords g lay arr (sigCount sig) (sigParams sig)
              let rw := if w > profile.resWords then w else 0
              let roff : Int := 24 + 8 * (iw : Int)
              let setup := storageAlloc frame (24 + 8 * ((iw + rw : Nat) : Int)) 248 8
                ++ stW frame 8 (i64Const ((iw + rw : Nat) : Int))
                ++ stW frame 16 (i64Const ((iw + rw : Nat) : Int))
                ++ abiStashParams g lay arr (sigCount sig) (sigParams sig) stash frame 24
              let release := if lay.rc then lg 0 ++ lg frame ++ callFn 9 else []
              let call := if wide then
                emitTE tbl opWideCall repFlat (hbOf [st] [((ix.n.toNat + biCallBaseWithLayers lay bi rtBase : Nat) : Int)]
                  [push args.code setup,
                   [abiPushParams g lay arr (sigCount sig) (sigParams sig) stash frame 24
                     ++ (if rw > 0 then lg frame ++ i64Const roff ++ [124] else [])],
                   [release], [if rw > 0 then ldWs frame roff d w else ldWs 0 profile.resAt d w]])
                else emitTE tbl op repFlat (hbOf [stash, st, d, 0, m0 - 1] [(aw : Int), ((ix.n.toNat + biCallBaseWithLayers lay bi rtBase : Nat) : Int), profile.resAt, (w : Int)] [args.code])
              (ownReleaseWithLayers lay) (if (biOnWithLayers lay) then args.release else [((stash : Int) :: ((paramMapWithLayers g) lay) arr (sigCount sig) (sigParams sig))]) (lwOfE call args.rest (args.nxt + (if wide then 1 else 0)) d (cenAdd 5 [(selfIdx : Int), ix.n] (if tail > 0 then cenAdd 3 [(selfIdx : Int), ix.n] args.cen else args.cen)))

      else if ph == 17 then
        let bi := if !biOnWithLayers lay then bi
          else if lay.reuse then biArgKeeps g lay arr profile.arityMax true bi env tys ty2 rest
          else biBorrowArgs g profile.arityMax bi env ty2 rest
        if bi.err != profile.cOk then lwFail bi.err rest else match rest with
        | [] => lwFail profile.cTrunc []
        | b :: bs =>
          if b == 0 then
            match ty2 with
            | [] => lwOk bs [] nxt nxt cen
            | _ => lwFail profile.cCall bs
          else if b == 1 then
            let passingB := (biOnWithLayers lay) && ty2.headD 0 == 1
            let pt := (readTyD g) (if (biOnWithLayers lay) then ty2.tail else ty2)
            if pt.ok != profile.cOk then lwFail profile.cCall bs
            else
              let w := ((wordsOfWithLayers g) lay) arr pt.acc
              let argVar := if passingB then peekVar g env bs else -1
              let argBi := if !biOnWithLayers lay || !lay.reuse then
                  biFollowingWithLayers lay g bi env 0 1 0 bs
                else
                  let after := skipE g profile.v2Fuel bs
                  if after.ok != profile.cOk then { bi with live := biUnion env bi.live }
                  else biArgKeeps g lay arr profile.arityMax false bi env tys pt.rest after.rest
              let e := if argBi.err != profile.cOk then lwFail argBi.err bs else if argVar < 0 then
                (lower lay) g argBi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks pt.acc [] bs cen
              else
                let wire := (drE g bs).tail
                let actual := envTy tys (readLeb wire).n.toNat
                let v := lowerVar env nxt wire cen
                if !typeEq g actual pt.acc then lwFail profile.cType bs
                else { v with cen := ((markReadWithLayers g) lay) arr selfIdx (pbase grp) npw v.slot (sigOf sigs selfIdx) (-1) v.cen }
              if e.ok != profile.cOk then e
              else
                let r := (lower lay) g bi tbl k 17 (which + (w : Int)) arr sigs env tys roots e.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty pt.rest e.rest e.cen
                if r.ok != profile.cOk then r
                else
                  let one := emitTE tbl opArgCopy repFlat (hbOf [e.slot, which.toNat] [(w : Int)] [e.code])
                  if one.ok != profile.cOk then lwFail one.ok bs
                  else { r with
                    code := join one.code r.code
                    release := if passingB && argVar < 0 then
                      ((ownRootWithLayers g) lay) arr pt.acc which.toNat :: r.release else r.release }
          else lwFail profile.cBody rest
      else if ph == 18 then
        let elem := (innerTy g) ty
        let w := ((wordsOfWithLayers g) lay) arr elem
        let d := nxt
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + 1 + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks elem [] rest cen
        if a.ok != profile.cOk then a
        else lwOfE (emitTE tbl 36 repFlat (hbOf (stdLs a.slot a.slot a.slot d) [(w : Int)] [a.code])) a.rest a.nxt d a.cen
      else if ph == 19 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          if a.ok != profile.cOk then a else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl 38 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt a.slot a.cen)

      else if ph == 20 then
        let ix := readLeb rest
        if ix.ok != profile.cOk then lwFail ix.ok ix.rest
        else if ix.n < 0 then lwFail profile.cBody ix.rest
        else
          let arm := ((sumArmWithLayers g) lay) arr ix.n.toNat ty
          if arm.ok != profile.cOk then lwFail arm.ok ix.rest
          else
            let w := ((wordsOfWithLayers g) lay) arr ty
            let wa := ((wordsOfWithLayers g) lay) arr arm.ty
            let d := nxt
            let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks arm.ty [] ix.rest cen
            if a.ok != profile.cOk then a
            else lwOfE (emitTE tbl 31 repFlat (hbOf [a.slot, a.slot, a.slot, d, d + 1, d + arm.off] [ix.n, ((w - 1 : Nat) : Int), (wa : Int)] [a.code])) a.rest a.nxt d a.cen
      else if ph == 21 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let w := ((wordsOfWithLayers g) lay) arr ty
          let d := nxt
          let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 3 0 t.rest) tbl k 0 0 arr sigs env tys roots (d + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          if a.ok != profile.cOk then a
          else
            let brs := (lower lay) g bi tbl k 22 0 arr sigs env tys (((ownRootWithLayers g) lay) arr t.acc a.slot :: roots) a.nxt npw selfIdx br d a.slot m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty t.acc a.rest a.cen
            if brs.ok != profile.cOk then brs
            else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl 32 repFlat (hbOf (stdLs a.slot a.slot a.slot d) [] [a.code, brs.code])) brs.rest brs.nxt d brs.cen)

      else if ph == 22 then
        match rest with
        | [] => lwFail profile.cTrunc []
        | b :: bs =>
          if b == 0 then lwOfE (emitTE tbl opMatchNone repFlat (hbOf (stdLs nxt nxt nxt nxt) [] [])) bs nxt nxt cen
          else if b == 1 then
            let arm := ((sumArmWithLayers g) lay) arr which.toNat ty2
            if arm.ok != profile.cOk then lwFail arm.ok bs
            else
              let w := ((wordsOfWithLayers g) lay) arr ty
              let e := (lower lay) g bi tbl k 0 0 arr sigs ((scr + arm.off : Int) :: env) (arm.ty :: tys) roots nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty [] bs cen
              if e.ok != profile.cOk then e
              else
                let r := (lower lay) g bi tbl k 22 (which + 1) arr sigs env tys roots nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty ty2 e.rest e.cen
                if r.ok != profile.cOk then r
                else lwOfE (emitTE tbl opMatchArm repFlat (hbOf [scr, e.slot, dst] [which, (w : Int)] [e.code, r.code])) r.rest (if e.nxt > r.nxt then e.nxt else r.nxt) dst r.cen
          else lwFail profile.cBody rest
      else if ph == 23 then
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + 1) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [1] [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g bi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [1] [] a.rest a.cen
          if b.ok != profile.cOk then b
          else if a.slot == b.slot then
            let cp := emitTE tbl opArgCopy repFlat (hbOf [b.slot, b.nxt] [(1 : Int)] [b.code])
            if cp.ok != profile.cOk then lwFail cp.ok b.rest
            else lwOfE (emitTE tbl (if which == 131 then 15 else 16) repFlat (hbOf (stdLs a.slot b.nxt a.slot d) [] [a.code, cp.code])) b.rest (b.nxt + 1) d b.cen
          else lwOfE (emitTE tbl (if which == 131 then 15 else 16) repFlat (hbOf (stdLs a.slot b.slot a.slot d) [] [a.code, b.code])) b.rest b.nxt d b.cen
      else if ph == 24 then
        let ta := ((readTyD g) ((innerTy g) ty)).acc
        let tb := (pairSnd g) ty
        let wa := ((wordsOfWithLayers g) lay) arr ta
        let wb := ((wordsOfWithLayers g) lay) arr tb
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + wa + wb) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ta [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g bi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks tb [] a.rest a.cen
          if b.ok != profile.cOk then b
          else lwOfE (emitTE tbl 28 repFlat (hbOf [a.slot, b.slot, a.slot, d, d + wa] [(wa : Int), (wb : Int)] [a.code, b.code])) b.rest b.nxt d b.cen
      else if ph == 25 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let ta := ((readTyD g) ((innerTy g) t.acc)).acc
          let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          if a.ok != profile.cOk then a
          else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl (if which == 0 then 29 else 30) repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (if which == 0 then a.slot else a.slot + ((wordsOfWithLayers g) lay) arr ta) a.cen)

      else if ph == 26 then
        let elem := (innerTy g) ty
        let w := ((wordsOfWithLayers g) lay) arr elem
        let d := nxt
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + 2 + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks elem [] rest cen
        if a.ok != profile.cOk then a
        else lwOfE (emitTE tbl 40 repFlat (hbOf [a.slot, a.slot, a.slot, d, d + 1, d + 1 + w] [(w : Int)] [a.code])) a.rest a.nxt d a.cen
      else if ph == 27 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let w := ((wordsOfWithLayers g) lay) arr ((innerTy g) t.acc)
          let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          if a.ok != profile.cOk then a
          else if which == 0 then (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl 42 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt a.slot a.cen)
          else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr t.acc a.slot] (lwOfE (emitTE tbl 43 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (a.slot + 1 + w) a.cen)

      else if ph == 28 then
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks (9 :: ty) [] rest cen
        if a.ok != profile.cOk then a
        else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr (9 :: ty) a.slot] (lwOfE (emitTE tbl 44 repFlat (hbOf (stdLs a.slot a.slot a.slot a.slot) [] [a.code])) a.rest a.nxt (a.slot + 1) a.cen)

      else if ph == 29 then
        let d := nxt
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [2] [] rest cen
        if a.ok != profile.cOk then a
        else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [2] a.slot] (lwOfE (emitTE tbl which.toNat repStr (hbOf (stdLs a.slot a.slot a.slot d) [] [a.code])) a.rest (a.nxt + 10) d a.cen)

      else if ph == 30 then
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [2] [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g bi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [2] [] a.rest a.cen
          if b.ok != profile.cOk then b
          else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [2] a.slot, ((ownRootWithLayers g) lay) arr [2] b.slot] (lwOfE (emitTE tbl 19 repStr (hbOf (stdLs a.slot b.slot a.slot d) [] [a.code, b.code])) b.rest (b.nxt + 10) d (cenAddType g 2 [4, 2] b.cen))

      else if ph == 31 then
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 2 rest) tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [2] [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 a.rest) tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] a.rest a.cen
          if b.ok != profile.cOk then b
          else
            let c := (lower lay) g bi tbl k 0 0 arr sigs env tys roots b.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] b.rest b.cen
            if c.ok != profile.cOk then c
            else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [2] a.slot] (lwOfE (emitTE tbl 20 repStr (hbOf (stdLs a.slot b.slot c.slot d) [] [a.code, b.code, c.code])) c.rest (c.nxt + 10) d c.cen)

      else if ph == 32 then
        let d := nxt
        let a := (lower lay) g bi tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [4, 0] [] rest cen
        if a.ok != profile.cOk then a
        else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [4, 0] a.slot] (lwOfE (emitTE tbl which.toNat repFlat (hbOf (stdLs a.slot a.slot a.slot d) [0, 0, 0, ((cellPayWithLayers g) lay) arr [0], ((tailOffWithLayers g) lay) arr [0]] [a.code])) a.rest (a.nxt + 10) d (cenAddType g 2 [4, 0] a.cen))

      else if ph == 33 then
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 rest) tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [4, 0] [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g bi tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [4, 0] [] a.rest a.cen
          if b.ok != profile.cOk then b
          else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [4, 0] a.slot, ((ownRootWithLayers g) lay) arr [4, 0] b.slot] (lwOfE (emitTE tbl 47 repFlat (hbOf (stdLs a.slot b.slot a.slot d) [0, 0, 0, ((cellPayWithLayers g) lay) arr [0], ((tailOffWithLayers g) lay) arr [0], 0] [a.code, b.code])) b.rest (b.nxt + 10) d (cenAddType g 2 [4, 0] b.cen))

      else if ph == 34 then
        let d := nxt
        let a := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 2 rest) tbl k 0 0 arr sigs env tys roots (d + 10) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [4, 0] [] rest cen
        if a.ok != profile.cOk then a
        else
          let b := (lower lay) g (biFollowingWithLayers lay g bi env 0 2 1 a.rest) tbl k 0 0 arr sigs env tys roots a.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] a.rest a.cen
          if b.ok != profile.cOk then b
          else
            let c := (lower lay) g bi tbl k 0 0 arr sigs env tys roots b.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] b.rest b.cen
            if c.ok != profile.cOk then c
            else
              let byteHeader := storageHeader 1 1 1
              if b.slot == c.slot then
                let cp := emitTE tbl opArgCopy repFlat (hbOf [c.slot, c.nxt] [(1 : Int)] [c.code])
                if cp.ok != profile.cOk then lwFail cp.ok c.rest
                else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [4, 0] a.slot] (lwOfE (emitTE tbl 48 repFlat (hbOf (stdLs a.slot b.slot c.nxt d) [24, byteHeader, 0, ((cellPayWithLayers g) lay) arr [0], ((tailOffWithLayers g) lay) arr [0]] [a.code, b.code, cp.code])) c.rest (c.nxt + 11) d (cenAddType g 2 [4, 0] c.cen))
              else (ownReleaseWithLayers lay) [((ownRootWithLayers g) lay) arr [4, 0] a.slot] (lwOfE (emitTE tbl 48 repFlat (hbOf (stdLs a.slot b.slot c.slot d) [24, byteHeader, 0, ((cellPayWithLayers g) lay) arr [0], ((tailOffWithLayers g) lay) arr [0]] [a.code, b.code, c.code])) c.rest (c.nxt + 10) d (cenAddType g 2 [4, 0] c.cen))

      else if ph == 35 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let elem := (innerTy g) t.acc
          let wa := ((wordsOfWithLayers g) lay) arr elem
          let wb := ((wordsOfWithLayers g) lay) arr ty
          let zWire := (skipE g profile.skipFuel t.rest).rest
          let bodyWire := (skipE g profile.skipFuel zWire).rest
          let loopBi := if biOnWithLayers lay then
            biKeep bi env 2 (biFree g profile.v2Fuel 0 0 { rest := bodyWire, cache := bi.free }) else bi
          let xsBi := if biOnWithLayers lay then
            biKeep loopBi env 0 (biFree g profile.v2Fuel 0 0 { rest := zWire, cache := bi.free }) else bi
          let xs := (lower lay) g xsBi tbl k 0 0 arr sigs env tys roots nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] t.rest cen
          if xs.ok != profile.cOk then xs
          else
            let z := (lower lay) g loopBi tbl k 0 0 arr sigs env tys roots xs.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] xs.rest xs.cen
            if z.ok != profile.cOk then z
            else
              let ptr := z.nxt
              let el := ptr + 1
              let acc := el + wa
              let body := (lower lay) g loopBi tbl k 0 0 arr sigs ((el : Int) :: (acc : Int) :: env) (elem :: ty :: tys) (((ownRootWithLayers g) lay) arr ty acc :: roots) (acc + wb) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty [] z.rest z.cen
              if body.ok != profile.cOk then body
              else
                let load := storageLoadField g lay arr elem ptr (cellPayWithLayers g lay arr elem) el body.nxt
                if !load.ok then lwFail profile.cWide body.rest
                else ownReleaseWithLayers lay [ownRootWithLayers g lay arr t.acc xs.slot]
                  (lwOfE (emitTE tbl 50 repFlat (hbOf [xs.slot, z.slot, body.slot, ptr, el, acc] [cellPayWithLayers g lay arr elem, (wa : Int), (wb : Int), tailOffWithLayers g lay arr elem] [xs.code, z.code, push body.code (ownEffectsWithLayers lay 7 [ownRootWithLayers g lay arr ty acc]), [load.code]])) body.rest load.nxt acc (cenAddType g 2 t.acc body.cen))

      else if ph == 36 then
        let t := readTyD g rest
        if t.ok != profile.cOk then lwFail t.ok t.rest
        else
          let w := ((wordsOfWithLayers g) lay) arr t.acc
          let d := nxt
          let st := d + w + 2
          let steps := st + w
          let bnd := steps + 1
          let conv := bnd + 1
          let stopFree := biFree g profile.v2Fuel 0 0 { rest := t.rest, cache := bi.free }
          let stepFree := biFree g profile.v2Fuel 0 0 { rest := stopFree.rest, cache := bi.free }
          let loopBi := if biOnWithLayers lay then biKeep (biKeep bi env 1 stopFree) env 1 stepFree else bi
          let stopBi := { loopBi with live := (st : Int) :: loopBi.live }
          let stop := (lower lay) g stopBi tbl k 0 0 arr sigs ((st : Int) :: env) (t.acc :: tys) (((ownRootWithLayers g) lay) arr t.acc st :: roots) (conv + 1) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [1] [] t.rest cen
          if stop.ok != profile.cOk then stop
          else
            let step := (lower lay) g loopBi tbl k 0 0 arr sigs ((st : Int) :: env) (t.acc :: tys) (((ownRootWithLayers g) lay) arr t.acc st :: roots) stop.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] stop.rest stop.cen
            if step.ok != profile.cOk then step
            else
              let z := (lower lay) g (biFollowingWithLayers lay g loopBi env 0 0 0 step.rest) tbl k 0 0 arr sigs env tys roots step.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks t.acc [] step.rest step.cen
              if z.ok != profile.cOk then z
              else
                let bd := (lower lay) g loopBi tbl k 0 0 arr sigs env tys roots z.nxt npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [0] [] z.rest z.cen
                if bd.ok != profile.cOk then bd
                else lwOfE (emitTE tbl 51 repFlat (hbOf [z.slot, bd.slot, stop.slot, step.slot, d, st, steps, bnd, conv, d + 1, d + 1 + w] [(w : Int)] [z.code, bd.code, stop.code, push step.code ((ownEffectsWithLayers lay) 7 [((ownRootWithLayers g) lay) arr t.acc st])])) bd.rest bd.nxt d bd.cen
      else if ph == 37 then
        -- Push a direct projection binding into only the arms that use it.
        -- The condition still sees the original binder depth. Its dummy
        -- slot is inaccessible by the checked free-variable premise.
        let bound := skipE g profile.skipFuel rest
        let wire := (drE g bound.rest).tail
        let cf := biFree g profile.v2Fuel 0 0 { rest := wire, cache := bi.free }
        let af := biFree g profile.v2Fuel 0 0 { rest := cf.rest, cache := bi.free }
        let bf := biFree g profile.v2Fuel 0 0 { rest := af.rest, cache := bi.free }
        let d := nxt
        let w := wordsOfWithLayers g lay arr ty
        let dummy := d + w
        let branchBi := biKeep (biKeep bi env 1 af) env 1 bf
        let condBi := if memI af.vars 0 || memI bf.vars 0 then
            { branchBi with live := biUnion [which] branchBi.live } else branchBi
        let c := lower lay g condBi tbl k 0 0 arr sigs ((dummy : Int) :: env) (ty2 :: tys) roots (dummy + wordsOfWithLayers g lay arr ty2) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [1] [] wire cen
        if c.ok != profile.cOk then c
        else
          let av := if memI af.vars 0 then
              lower lay g (biKeep bi env 1 af) tbl k 0 0 arr sigs env tys roots c.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty2 [] rest c.cen
            else lwOk bound.rest [] c.nxt dummy c.cen
          if av.ok != profile.cOk then av
          else
            let ar := if memI af.vars 0 then [ownRootWithLayers g lay arr ty2 av.slot] else []
            let a := lower lay g bi tbl k 0 0 arr sigs ((av.slot : Int) :: env) (ty2 :: tys) (ar ++ roots) av.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty [] c.rest av.cen
            if a.ok != profile.cOk then a
            else
              let bv := if memI bf.vars 0 then
                  lower lay g (biKeep bi env 1 bf) tbl k 0 0 arr sigs env tys roots c.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks ty2 [] rest a.cen
                else lwOk bound.rest [] c.nxt dummy a.cen
              if bv.ok != profile.cOk then bv
              else
                let brs := if memI bf.vars 0 then [ownRootWithLayers g lay arr ty2 bv.slot] else []
                let b := lower lay g bi tbl k 0 0 arr sigs ((bv.slot : Int) :: env) (ty2 :: tys) (brs ++ roots) bv.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty [] a.rest bv.cen
                if b.ok != profile.cOk then b
                else lwOfE (emitTE tbl 5 repFlat (hbOf [c.slot, a.slot, b.slot, d] [(w : Int)]
                  [c.code, join av.code (push a.code (ownEffectsWithLayers lay 7 ar)),
                    join bv.code (push b.code (ownEffectsWithLayers lay 7 brs))])) b.rest
                  (maxN a.nxt b.nxt) d b.cen
      else if ph == 39 then
        -- structProjCases: retain the selected field in the selected arm,
        -- without materializing the complete record at the case join.
        let d := nxt
        let w := wordsOfWithLayers g lay arr ty
        let c := lower lay g (biFollowingWithLayers lay g bi env 0 2 2 rest) tbl k 0 0 arr sigs env tys roots (d + w) npw selfIdx br dst scr m0 m1 pmap grp bodies eqt eqb rtBase 0 ks [1] [] rest cen
        if c.ok != profile.cOk then c
        else
          let a := lower lay g bi tbl k 0 0 arr sigs env tys roots c.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty [] ([35] ++ ty2 ++ lebU which.toNat ++ c.rest) c.cen
          if a.ok != profile.cOk then a
          else
            let b := lower lay g bi tbl k 0 0 arr sigs env tys roots c.nxt npw selfIdx (br + 1) dst scr m0 m1 pmap grp bodies eqt eqb rtBase tail ks ty [] ([35] ++ ty2 ++ lebU which.toNat ++ a.rest) a.cen
            if b.ok != profile.cOk then b
            else { (lwOfE (emitTE tbl 5 repFlat (hbOf [c.slot, a.slot, b.slot, d] [(w : Int)] [c.code, a.code, b.code])) b.rest (maxN a.nxt b.nxt) d b.cen) with resultOwned := true }
      else lwFail profile.cBody rest

  let closed := if hit.ok == profile.cOk || ph != 0 || !lay.rc || raw.ok != profile.cOk then raw
    else
      let tag := (drE g opened).headD (-1)
      let borrowed := tag == 3 || tag == 25 || tag == 27 || tag == 35 || tag == 39
        || tag == 29 || tag == 30 || tag == 44 || tag == 45
      let transfer := if biOnWithLayers lay && (tag == 3 || tag == 35) then
          let owned := ownTransfers roots raw.slot ((mapOfWithLayers g) lay arr ty)
          if lay.reuse then
            -- A multiword value can contain both dead and still-borrowed
            -- leaves. Test each owned leaf, never just the first slot.
            owned.filter (fun p => !memI bi.liveSlots p
              && !biLiveSlot g lay arr raw.cen.memo.reuseShapes bi.live p.toNat env tys)
          else if biLiveSlot g lay arr raw.cen.memo.reuseShapes bi.live raw.slot env tys then []
          else owned
        else []
      ownCloseWithLayers g lay arr ty borrowed raw transfer
  if hit.ok == profile.cOk || !isRef then closed
  else
    let v := { closed with rest := ref.rest }
    if eligible && v.ok == profile.cOk then dmSave key fuel nxt v else v
termination_by structural fuel


def edgesOf : List (List Int) → List (List Int)
  | [] => []
  | (3 :: a :: b :: _) :: rest => [a, b] :: edgesOf rest
  | _ :: rest => edgesOf rest

def stepReach (edges : List (List Int)) (seen : List Int) : List (List Int) → List Int
  | [] => seen
  | (a :: b :: _) :: rest =>
    if memI seen a && !(memI seen b) then stepReach edges (b :: seen) rest
    else stepReach edges seen rest
  | _ :: rest => stepReach edges seen rest

def reachGo : Nat → List (List Int) → List Int → List Int
  | 0, _, seen => seen
  | k + 1, edges, seen =>
    let more := stepReach edges seen edges
    if more.length == seen.length then seen else reachGo k edges more

def reach (edges : List (List Int)) (f : Int) : List Int :=
  reachGo profile.fnMax edges [f]

def mutualOf (edges : List (List Int)) (f : Int) : List Int → List Int
  | [] => []
  | g :: gs =>
    if g != f && memI (reach edges g) f then g :: mutualOf edges f gs
    else mutualOf edges f gs

def insertAsc (x : Int) : List Int → List Int
  | [] => [x]
  | y :: ys => if x < y then x :: y :: ys else if x == y then y :: ys else y :: insertAsc x ys

def sortAsc : List Int → List Int
  | [] => []
  | x :: xs => insertAsc x (sortAsc xs)

def groupsGo (edges : List (List Int)) (acc : List (List Int)) : Nat → List (List Int)
  | 0 => acc
  | k + 1 =>
    let f : Int := (k : Int)
    let ms := mutualOf edges f (reach edges f)
    match ms with
    | [] => groupsGo edges acc k
    | _ =>
      let g := sortAsc (f :: ms)
      groupsGo edges (if memW acc g then acc else g :: acc) k

def groupsOf (cen : List (List Int)) (n : Nat) : List (List Int) :=
  groupsGo (edgesOf cen) [] n

def groupOf : List (List Int) → Int → List (List Int)
  | [], _ => []
  | g :: gs, f => if memI g f then [g] else groupOf gs f

-- Member i's body sits inside i nested ifs within the loop: its loop label depth.
def groupDepth (g : List Int) (f : Nat) (d : Nat) : Nat :=
  match g with
  | [] => d
  | x :: xs => if x == (f : Int) then d else groupDepth xs f (d + 1)

def maxI : List Int → Nat → Nat
  | [], m => m
  | x :: xs, m => maxI xs (if x.toNat > m then x.toNat else m)

def insertN (n : Nat) : List Nat → List Nat
  | [] => [n]
  | x :: xs => if n < x then n :: x :: xs else if n == x then x :: xs else x :: insertN n xs

def addOff (base : Nat) : Nat → List Nat → List Nat
  | 0, acc => acc
  | k + 1, acc => addOff base k (insertN (base + k) acc)

-- Source coordinate (param, field) to final-layout words, relative to the
-- parameter base. field < 0 is every word of the parameter.
def coverOneWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) (pi field : Int) (acc : List Nat) : List Nat :=
  let cnt := sigCount sig
  if pi < 0 || pi.toNat ≥ cnt then acc
  else
    let ty := (nthTy tg) pi.toNat (sigParams sig)
    let base := ((paramStartWithLayers tg) lay) arr pi.toNat cnt (sigParams sig)
    if field < 0 then addOff base (((wordsOfWithLayers tg) lay) arr ty) acc
    else
      let f := ((recFieldWithLayers tg) lay) arr field.toNat ty
      if f.ok != profile.cOk then acc else addOff (base + f.off) (((wordsOfWithLayers tg) lay) arr f.ty) acc



def sigmaGoWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) (f : Int) : List (List Int) → List Nat → List Nat
  | [], acc => acc
  | (4 :: g :: pi :: field :: _) :: rest, acc =>
    ((sigmaGoWithLayers tg) lay) arr sig f rest (if g == f then ((coverOneWithLayers tg) lay) arr sig pi field acc else acc)
  | _ :: rest, acc => ((sigmaGoWithLayers tg) lay) arr sig f rest acc

-- The read parameter words of f, ascending, relative to the parameter base,
-- in the layout `arr` names. The census holds source coordinates, not slots
-- from the round before arrays widened a list.


def sigmaOfWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) (f : Int) (cen : List (List Int)) : List Nat :=
  ((sigmaGoWithLayers tg) lay) arr sig f cen []

-- All of the words named are scalar under the map.


def allScalar (map : List Int) : List Nat → Bool
  | [] => true
  | w :: ws => envGet map w == 0 && allScalar map ws

-- f is recursive when a callee reaches it over the call edges `5 :: a :: b`.
def callEdgesOf : List (List Int) → List (List Int)
  | [] => []
  | (5 :: a :: b :: _) :: rest => [a, b] :: callEdgesOf rest
  | _ :: rest => callEdgesOf rest

def calleesOf (f : Int) : List (List Int) → List Int
  | [] => []
  | (a :: b :: _) :: rest => if a == f then b :: calleesOf f rest else calleesOf f rest
  | _ :: rest => calleesOf f rest

def anyReaches (edges : List (List Int)) (f : Int) : List Int → Bool
  | [] => false
  | g :: gs => memI (reach edges g) f || anyReaches edges f gs

def isRecursive (edges : List (List Int)) (f : Int) : Bool :=
  anyReaches edges f (calleesOf f edges)

-- Memo plan: `[f, table base, key count, result words, sigma words...]` for each memoized
-- function, tables laid out from memoAt below the heap, each memoSlots
-- entries of (1 + keys + results) words. A function pays when it is
-- recursive, its sigma and result are scalar and at most memoKeyMax words,
-- and it is in no group; a table that would not fit is not assigned.
def natsToInts : List Nat → List Int
  | [] => []
  | n :: ns => (n : Int) :: natsToInts ns

def intsToNats : List Int → List Nat
  | [] => []
  | n :: ns => n.toNat :: intsToNats ns

def memoPlanGoWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sigs : List (List Int)) (cen : List (List Int)) (edges groups : List (List Int)) (base : Int) : Nat → Nat → List (List Int)
  | _, 0 => []
  | f, k + 1 =>
    let sig := sigOf sigs f
    let pm := ((paramMapWithLayers tg) lay) arr (sigCount sig) (sigParams sig)
    let sg := ((sigmaOfWithLayers tg) lay) arr sig (f : Int) cen
    let rty := (sigResult tg) sig
    let w := ((wordsOfWithLayers tg) lay) arr rty
    let ok := isRecursive edges (f : Int) && allScalar pm sg && sg.length ≤ profile.memoKeyMax
      && w ≤ profile.memoKeyMax && allZero (((mapOfWithLayers tg) lay) arr rty) && (groupOf groups (f : Int)).length == 0
    let bytes : Int := 8 * (profile.memoSlots : Int) * (1 + (sg.length : Int) + (w : Int))
    if ok && base + bytes ≤ profile.heapAt then
      ((f : Int) :: base :: (sg.length : Int) :: (w : Int) :: natsToInts sg) :: ((memoPlanGoWithLayers tg) lay) arr sigs cen edges groups (base + bytes) (f + 1) k
    else ((memoPlanGoWithLayers tg) lay) arr sigs cen edges groups base (f + 1) k



def memoPlanWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sigs : List (List Int)) (cen groups : List (List Int)) (n : Nat) : List (List Int) :=
  if profile.memoSlots == 0 then [] else ((memoPlanGoWithLayers tg) lay) arr sigs cen (callEdgesOf cen) groups profile.memoAt 0 n



def memoOf : List (List Int) → Int → List Int
  | [], _ => []
  | (f :: e) :: rest, g => if f == g then e else memoOf rest g
  | _ :: rest, g => memoOf rest g

-- Snapshot the key words into locals from kl; hash them into the entry
-- address local ma; `e` is the entry's byte size.
def memoKeys : List Nat → Nat → Nat → List Int
  | [], _, _ => []
  | w :: ws, pb, kl => lg (pb + w) ++ ls kl ++ memoKeys ws pb (kl + 1)

-- acc = ((acc + key) * 1000003); acc = acc xor (acc >> 29); `ma` is scratch.
def memoHash : Nat → Nat → Nat → List Int
  | _, _, 0 => []
  | kl, ma, k + 1 =>
    lg kl ++ [124] ++ i64Const 1000003 ++ [126] ++ ls ma ++ lg ma ++ lg ma ++ i64Const 29 ++ [136] ++ [133]
      ++ memoHash (kl + 1) ma k

def memoAddr (kl k : Nat) (tbl e : Int) (ma : Nat) : List Int :=
  i64Const 0 ++ memoHash kl ma k
    ++ i64Const ((profile.memoSlots : Int) - 1) ++ [131] ++ i64Const e ++ [126] ++ i64Const tbl ++ [124] ++ ls ma

def memoKeysEq : Nat → Nat → Nat → List Int
  | _, _, 0 => []
  | ma, kl, k + 1 => ldW ma (8 * (k + 1 : Int)) ++ lg (kl + k) ++ [81] ++ [113] ++ memoKeysEq ma kl k

def memoCopy : Nat → Int → Nat → List Int
  | _, _, 0 => []
  | ma, off, j + 1 => stW 0 (profile.resAt + 8 * ((j : Int))) (ldW ma (off + 8 * (j : Int))) ++ memoCopy ma off j

-- Hit: the entry is set, its fuel witness is at most ours, the keys match:
-- copy the results to the result area and return 0.
def memoLookup (ma kl k w : Nat) : List Int :=
  ldW ma 0 ++ [80, 69]
    ++ voidIf (ldW ma 0 ++ lg 1 ++ [88]
      ++ memoKeysEq ma kl k
      ++ voidIf (memoCopy ma (8 * (1 + k : Int)) w ++ i64Const 0 ++ [15]))

def memoStoreKeys : Nat → Nat → Nat → List Int
  | _, _, 0 => []
  | ma, kl, k + 1 => stW ma (8 * (k + 1 : Int)) (lg (kl + k)) ++ memoStoreKeys ma kl k

def memoStore (ma kl fw k src w : Nat) : List Int :=
  stW ma 0 (lg fw) ++ memoStoreKeys ma kl k ++ stWs ma (8 * (1 + k : Int)) src w

-- A function body. Alone: fuel prologue, marks, loop, body, result stores,
-- region exit, status 0. In a group (grp nonempty): the body is lowered with
-- parameters at local 3 and locals from `lbase`; it ends in its own return.
def lowerFn (lay : Layers) (dg : Dg) (bi : BiPlan) (tbl : List TE) (rtBase : Nat) (arr : List (List Int)) (sigs : List (List Int)) (selfIdx : Nat) (sig : List Int) (rest : List Int) (cen : Cen) (grp : List (List Int)) (lbase : Nat) (memo : List Int) (bodies eqt : List (List Int)) (eqb : Nat) : Lw :=
  let cen := { cen with memo := lowerMemoEmpty }
  let g := match grp with
    | [] => []
    | gs :: _ => gs
  let pb := pbase g
  let e := ((envFromWithLayers dg) lay) arr (sigCount sig) pb (sigParams sig) [] []
  let npw := e.nxt - pb
  let rty := (sigResult dg) sig
  let w := ((wordsOfWithLayers dg) lay) arr rty
  let wide := abiWideSignature dg lay arr sig
  let wire := abiParamWords dg lay arr (sigCount sig) (sigParams sig)
  let indirect := wire < npw
  let outWords := if w > profile.resWords then 1 else 0
  let outLocal := 2 + npw
  let saved := outLocal + outWords
  let entry := (if outWords > 0 then cpW (2 + wire) outLocal 1 else [])
    ++ (if indirect then cpW 2 saved wire ++ abiReadParams dg lay arr (sigCount sig) (sigParams sig) saved 2 else [])
    ++ (if wide then abiArenaEntry 2 (sizeGoWithLayers dg lay profile.v2Fuel arr 3 [] 1 (sigCount sig) 0 [] (sigParams sig)).map else [])
  let lbase := lbase + outWords + (if indirect then wire else 0)
  let memo := if wide then [] else memo
  let resultStore := fun slot => if outWords > 0 then stWs outLocal 0 slot w else stWs 0 profile.resAt slot w
  -- Solo i64: local `acc` sits immediately before the entry bump. A tail
  -- constant-add writes it; the return adds it. Zero leaves every other value.
  let useAcc := !lay.rc && g.length == 0 && (typeEq dg) rty [0]
  let acc := lbase
  let m0 := if useAcc then lbase + 1 else lbase
  let m1 := if useAcc then lbase + 2 else lbase + 1
  let off0 := if useAcc then lbase + 1 else lbase
  let mk := match memo with
    | _ :: k :: _ => k.toNat
    | _ => 0
  -- m1 + 1 is the arena count at entry (the generation mark).
  let m2 := m1 + 1
  let ma := off0 + 3
  let fw := off0 + 4
  let kl := off0 + 5
  let lbase := match memo with
    | [] => off0
    | _ => off0 + 5 + mk
  let pmap := ((paramMapWithLayers dg) lay) arr (sigCount sig) (sigParams sig)
  let ownedMap := ((biOwnedMapWithLayers dg) lay) bi arr selfIdx sig
  let entryMap := if !(biOnWithLayers lay) then pmap else []
  let br := match g with
    | [] => 0
    | _ => groupDepth g selfIdx 1
  let lw := (lower lay) dg bi tbl (if dg.on then profile.v2Fuel else rest.length * profile.lowerMul + profile.lowerAdd) 0 0 arr sigs (reverse e.env) (revW e.tys []) [((pb : Int) :: ownedMap)] (lbase + 3) npw selfIdx br 0 0 m0 m1 pmap g bodies eqt eqb rtBase (if lay.tail && !lay.rc && memo.length == 0 then 2 else 1) (-1) rty [] rest cen
  let result :=
    if lw.ok != profile.cOk then lw
    else
      let dest := if lw.slot == lw.nxt then lw.nxt + 1 else lw.nxt
      let addI := if useAcc then emitTE tbl 6 repFlat (hbOf (stdLs lw.slot acc 0 dest) [] [[], []]) else { ok := profile.cOk, code := [], rts := [] }
      if useAcc && addI.ok != profile.cOk then lwFail addI.ok lw.rest
      else
        let lw := if useAcc then { lw with nxt := dest + 1, code := addI.code ++ lw.code } else lw
        let slot := if useAcc then dest else lw.slot
        let pro := entry ++ (ownEffectsWithLayers lay) 6 [((pb : Int) :: entryMap)] ++ (if useAcc then i64Const 0 ++ ls acc else []) ++ fuelPrologue ++ blkGet offBump ++ ls m0 ++ arenaCount ++ ls m2
        match g with
        | [] =>
          match memo with
          | mt :: k :: _ :: sgw =>
            let e : Int := 8 * (1 + k + (w : Int))
            let sg := intsToNats sgw
            -- A refusal returns before this point. Store only when status is
            -- still 0, so a residue cannot become a cached success.
            let store := blkGet offStatus ++ [80] ++ voidIf (memoStore ma kl fw mk slot w)
            { lw with code := (blkGet offStatus ++ [11, opEnd])
                :: (push (push (push lw.code (resultStore slot)) store) ((regionResetShallowWithLayers lay) m0 m0 slot (((mapOfWithLayers dg) lay) arr rty) (((arenaMapOfWithLayers dg) lay) arr rty) (m1 + 1) m1)
                    ++ [blkGet offBump ++ ls m1, [3, 126],
                        pro ++ lg 1 ++ ls fw
                          ++ memoKeys sg 2 kl ++ memoAddr kl mk mt e ma ++ memoLookup ma kl mk w]) }
          | _ =>
            { lw with code := (i64Const 0 ++ [11, opEnd])
                :: (push (push lw.code (resultStore slot ++ (ownEffectsWithLayers lay) 7 [((pb : Int) :: ownedMap)])) ((regionResetShallowWithLayers lay) m0 m0 slot (((mapOfWithLayers dg) lay) arr rty) (((arenaMapOfWithLayers dg) lay) arr rty) (m1 + 1) m1)
                    ++ [blkGet offBump ++ ls m1, [3, 126], pro]) }
        | _ =>
          { lw with code := push (push (push lw.code (resultStore lw.slot ++ (ownEffectsWithLayers lay) 7 [((pb : Int) :: ownedMap)])) ((regionResetShallowWithLayers lay) m0 m0 lw.slot (((mapOfWithLayers dg) lay) arr rty) (((arenaMapOfWithLayers dg) lay) arr rty) (m1 + 1) m1)) (i64Const 0 ++ [15]) }

  dmFinish result

def wfnOf (npw : Nat) (lw : Lw) : WFn :=
  { params := repI64 (npw + 2)
  , results := [vtI64]
  , locals := repI64 (lw.nxt - (npw + 2))
  , code := flushAll lw.code [] }

-- Lib.Arena as an intrinsic: `alloc` and `read` over one flat block rather
-- than the `List Node` encoding. The arena value `ar` is a repArr view
-- (block pointer, logical length); a handle is an element index, so `alloc`
-- bumps and `read` loads, both O(1). Its private ScalarArray has an 8-byte
-- header, size/capacity at +8/+16, a scalar count at +24 and flat elements
-- at +32. The descriptor's provenance controls movement. A stale view
-- (logical length below the block count) keeps reading its own prefix; an
-- `alloc` through it copies the prefix to a fresh block, matching
-- `ar ++ [n]` exactly. `intern` is a normal function.
def isArenaRAi (tg : Dg) (r arTy : List Int) : Bool :=
  match (tyView tg) r with
  | 7 :: 2 :: bs =>
    let n0 := skipName bs
    if n0.ok != profile.cOk then false
    else
      let t0 := (readTyD tg) n0.rest
      if t0.ok != profile.cOk || !(typeEq tg) t0.acc [0] then false
      else
        let n1 := skipName t0.rest
        if n1.ok != profile.cOk then false
        else
          let t2 := (readTyD tg) n1.rest
          t2.ok == profile.cOk && (typeEq tg) t2.acc arTy && t2.rest.isEmpty
  | _ => false

def badIdxGo (tg : Dg) (sigs : List (List Int)) (r : List Int) (i : Nat) : Int :=
  match sigs with
  | [] => -1
  | s :: ss =>
    if (typeEq tg) ((sigResult tg) s) r
        && (sigCount s == 0
            || (sigCount s == 1 && (typeEq tg) ((nthTy tg) 0 (sigParams s)) [0])) then (i : Int)
    else (badIdxGo tg) ss r (i + 1)

-- 1 = alloc (record-element, list, RAi result, direct record body), 2 = read
-- (list, i64, element result, a body that consults the out-of-range node).
def arenaKind (tg : Dg) (sigs : List (List Int)) (s : List Int) (bs : List Int) : Nat :=
  if sigCount s != 2 then 0
  else
    let p := sigParams s
    let t0 := (nthTy tg) 0 p
    let t1 := (nthTy tg) 1 p
    let r := (sigResult tg) s
    if (isArenaNode tg) t0 && (typeEq tg) t1 (4 :: t0) && (isArenaRAi tg) r t1 && bs.headD 0 == 34 then 1
    else if (isArenaNode tg) r && (typeEq tg) t0 (4 :: r) && (typeEq tg) t1 [0] && (bs.headD 0 == 4 || bs.headD 0 == 5) && (badIdxGo tg) sigs r 0 >= 0 then 2
    else 0

-- The list type carrying the arena, for the census entry that keeps it repArr.
-- The legacy census also reads the first two words of a 3-entry as an edge.
-- Preserve that prefix without expanding any transitive type children.
def arenaListTy (tg : Dg) (ak : Nat) (s : List Int) : List Int :=
  let ty := (nthTy tg) (if ak == 1 then 1 else 0) (sigParams s)
  match tyView tg ty with
  | 4 :: elem => 4 :: tyView tg elem
  | body => body

-- Stores `emptyAt` at every pointer position of one element at local `lea`.
def storeMarked (lea : Nat) (em : List Int) (k : Nat) : List Int :=
  match em with
  | [] => []
  | m :: ms => (if m != 0 then stW lea (8 * (k : Int)) (i64Const profile.emptyAt) else []) ++ storeMarked lea ms (k + 1)

def arenaKids : Nat := 4
-- The stored element: f0, the kid count, arenaKids kid handles, f2..f7.
def arenaStored : Nat := 2 + arenaKids + 6
-- Word 2 is marked: past arenaKids kids the slot holds the kids list itself
-- (a heap pointer, pinned like f7); inline it holds a handle, never a pointer.
def arenaStoredMap : List Int := zeros 2 ++ [1] ++ zeros (arenaKids + 4) ++ [1]

-- The kids of the node, the `list i64` in local 3 (linked: head at +16,
-- tail at +8; array: base in 3, offset in 4), stored inline at lea[2..]
-- with the count at lea[1]. Past arenaKids the inline run stops and lea[2]
-- holds the whole list instead (linked) or base and offset (array): a count
-- over arenaKids can only mean that form, so the count word discriminates.
-- `li` is the cursor, `lk` the count.
def kidsStore (kidsArr : Bool) (lea li lk : Nat) : List Int :=
  i64Const 0 ++ ls lk
  ++ (if kidsArr then
        ldW 3 8 ++ lg 4 ++ [125] ++ ls li
        ++ lg li ++ i64Const (arenaKids : Int) ++ [85] ++ [4, 64]
            ++ lg li ++ ls lk ++ stW lea 16 (lg 3) ++ stW lea 24 (lg 4)
          ++ [5]
            ++ [2, 64] ++ [3, 64]
              ++ lg lk ++ lg li ++ [89] ++ [13, 1]
              ++ lg lea ++ i64Const 16 ++ [124] ++ lg lk ++ i64Const 8 ++ [126] ++ [124] ++ [167]
              ++ lg 3 ++ i64Const 24 ++ [124] ++ lg 4 ++ lg lk ++ [124] ++ i64Const 8 ++ [126] ++ [124] ++ [167] ++ i64LoadAt 0 ++ i64StoreAt 0
              ++ lg lk ++ i64Const 1 ++ [124] ++ ls lk
              ++ [12, 0] ++ [11] ++ [11]
          ++ [11]
      else
        lg 3 ++ ls li
        ++ [2, 64] ++ [3, 64]
          ++ lg li ++ i64Const profile.emptyAt ++ [81] ++ [13, 1]
          ++ lg lk ++ i64Const (arenaKids : Int) ++ [83] ++ voidIf (
            lg lea ++ i64Const 16 ++ [124] ++ lg lk ++ i64Const 8 ++ [126] ++ [124] ++ [167] ++ ldW li 16 ++ i64StoreAt 0)
          ++ ldW li 8 ++ ls li
          ++ lg lk ++ i64Const 1 ++ [124] ++ ls lk
          ++ [12, 0] ++ [11] ++ [11]
        ++ lg lk ++ i64Const (arenaKids : Int) ++ [85] ++ voidIf (stW lea 16 (lg 3)))
  ++ stW lea 8 (lg lk)

-- The kids list of the element at local `lea`, built back to front in the
-- bump heap into local `lc` (`li` scratch): fresh cells, young, private to
-- the caller's region. `relea` recomputes `lea` after an allocation, since a
-- grow moves the block.
def kidsLoad (kidsArr : Bool) (lea lc li : Nat) (relea : List Int) : List Int :=
  if kidsArr then
    ldW lea 8 ++ ls li
    ++ lg li ++ i64Const (arenaKids : Int) ++ [85] ++ [4, 64]
        ++ ldW lea 16 ++ ls lc
      ++ [5]
        ++ lg li ++ i64Const 8 ++ [126] ++ i64Const 24 ++ [124] ++ ls li
        ++ allocTo lc (lg li)
        ++ relea
        ++ stW lc 0 (i64Const (storageHeader 1 248 8))
        ++ stW lc 8 (ldW lea 8) ++ stW lc 16 (ldW lea 8)
        ++ i64Const 0 ++ ls li
        ++ [2, 64] ++ [3, 64]
          ++ lg li ++ ldW lea 8 ++ [89] ++ [13, 1]
          ++ lg lc ++ i64Const 24 ++ [124] ++ lg li ++ i64Const 8 ++ [126] ++ [124] ++ [167]
          ++ lg lea ++ i64Const 16 ++ [124] ++ lg li ++ i64Const 8 ++ [126] ++ [124] ++ [167] ++ i64LoadAt 0 ++ i64StoreAt 0
          ++ lg li ++ i64Const 1 ++ [124] ++ ls li
          ++ [12, 0] ++ [11] ++ [11]
      ++ [11]
  else
    ldW lea 8 ++ ls li
    ++ lg li ++ i64Const (arenaKids : Int) ++ [85] ++ [4, 64]
        ++ ldW lea 16 ++ ls lc
      ++ [5]
        ++ i64Const profile.emptyAt ++ ls lc
        ++ [2, 64] ++ [3, 64]
          ++ lg li ++ [80] ++ [13, 1]
          ++ lg li ++ i64Const 1 ++ [125] ++ ls li
          ++ lg lc ++ ls (lc + 1)
          ++ allocTo lc (i64Const 24)
          ++ relea
          ++ stW lc 0 (i64Const (storageHeader 1 1 1))
          ++ stW lc 16 (lg lea ++ i64Const 16 ++ [124] ++ lg li ++ i64Const 8 ++ [126] ++ [124] ++ [167] ++ i64LoadAt 0)
          ++ stW lc 8 (lg (lc + 1))
          ++ [12, 0] ++ [11] ++ [11]
      ++ [11]

-- Sets offPin when a pointer word of the element at local `lea` holds a
-- heap address: the block then reaches into the bump heap.
def pinCheck (lea : Nat) (em : List Int) (k : Nat) : List Int :=
  match em with
  | [] => []
  | m :: ms => (if m != 0 then ldW lea (8 * (k : Int)) ++ i64Const profile.heapAt ++ [90] ++ voidIf (blkSet offPin (i64Const 1)) else []) ++ pinCheck lea ms (k + 1)

-- alloc(n, ar): one i64 packs count (low 32) and block version (high 32).
-- A version is the block's distance from memory end, invariant under growth.
-- Append in place only at the block's current count. A stale prefix gets a
-- fresh block and a copy of that prefix; its old suffix remains readable.
-- Method: Conchon/Filliatre, A Persistent Union-Find Data Structure (ML 2007),
-- persistent arrays section, following Baker's version trees. This uses the
-- simple copy-on-stale variant, not their rerooting optimization. S3 replaces
-- version tests with RC'd Array uniqueness. Overflow: capacity.arenaLayout.
-- All retained blocks occupy one top-space span and move together on growth.
def wfnArenaAllocWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) : WFn :=
  let p := sigParams sig
  let ety := (nthTy tg) 0 p
  let kidsArr := (memT tg) arr [4, 0]
  let w := arenaStored
  let sw : Int := 8 * (w : Int)
  let cap0 : Int := 1024
  let npw := ((paramWordsWithLayers tg) lay) arr (sigCount sig) p
  let arP := 2 + ((wordsOfWithLayers tg) lay) arr ety
  let lblk := 2 + npw
  let lcap := lblk + 1
  let li := lblk + 2
  let lea := lblk + 3
  let lcnt := lblk + 4
  let lnb := lblk + 5
  let lsz := lblk + 6
  let lnl := lblk + 7
  let lpg := lblk + 8
  -- the pages of a block of `lsz` bytes, and half of memory's pages
  let needPages := lg lsz ++ i64Const 65535 ++ [124] ++ i64Const 65536 ++ [127]
  let halfPages := [63, 0, 173] ++ i64Const 1 ++ [136]
  -- The private raw arena region is an rc-0 SArray of checked words.
  -- Its first data word is the persistent count, followed by packed nodes.
  let hdrOf (p : Nat) (cap : List Int) :=
    stW p 0 (i64Const (storageHeader 0 248 8))
      ++ stW p 8 (cap ++ i64Const (w : Int) ++ [126] ++ i64Const 1 ++ [124])
      ++ stW p 16 (cap ++ i64Const (w : Int) ++ [126] ++ i64Const 1 ++ [124])
      ++ stW p 24 (i64Const 0)
  -- bytes for `cap` elements
  let arenaBytes (cap : List Int) := cap ++ i64Const (w : Int) ++ [126] ++ i64Const 2 ++ [124] ++ i64Const 8 ++ [126] ++ i64Const 16 ++ [124]
  -- pointer-slot initialisation of elements [loCode, hiCode) in local `blk`;
  -- br to the block label exits, br to the loop label repeats.
  let initElems (blk : Nat) (loCode hiCode : List Int) :=
    loCode ++ ls li
      ++ [2, 64]
        ++ [3, 64]
          ++ lg li ++ hiCode ++ [83] ++ [4, 64]
            ++ lg blk ++ lg li ++ i64Const sw ++ [126] ++ [124] ++ i64Const 32 ++ [124] ++ ls lea
            ++ storeMarked lea arenaStoredMap 0
            ++ lg li ++ i64Const 1 ++ [124] ++ ls li
            ++ [12, 1]
          ++ [11]
        ++ [11]
      ++ [11]
  -- a fresh block of capacity `capCode` on new pages at the top of memory;
  -- afterwards lnb names it and it is the top space's edge.
  let newBlock (capCode : List Int) :=
    arenaBytes capCode ++ ls lsz
      ++ lg lsz ++ i64Const arenaMask ++ [86]
      ++ voidIf (refuseTo profile.tagCapacity detArenaLayout)
      ++ memoryEnd ++ ls lnl
      -- Existing version distances plus this block must fit in 32 bits.
      ++ blkGet offABump ++ [80, 69] ++ voidIf (
          lg lnl ++ blkGet offABump ++ [125] ++ lg lsz ++ [124]
          ++ i64Const arenaMask ++ [86]
          ++ voidIf (refuseTo profile.tagCapacity detArenaLayout))
      -- Room between the heap's bump and the top space: the block goes there, and memory does not grow.
      -- (The top space's low edge is the heap's limit, lib/rt/V1.rsd `bump`: what lies between is free.)
      ++ blkGet offABump ++ [80, 69]
      ++ blkGet offABump ++ blkGet offBump ++ lg lsz ++ [124] ++ [90]
      ++ [113, 69]
      ++ voidIf (
      blkGet offCap ++ [80, 69]
      ++ voidIf (lg lnl ++ lg lsz ++ i64Const 65535 ++ [124]
          ++ i64Const 65536 ++ [127] ++ i64Const 65536 ++ [126] ++ [124]
          ++ blkGet offCap ++ [85]
          ++ voidIf (refuseTo profile.tagCapacity profile.detGrow))
      -- The pages to grow by: the block's own for the first block. After it at least half as many as memory
      -- has: every growth moves all blocks, so the growths must be few (a fork of the arena makes a block, and a
      -- program may fork at every allocation). Under a cap that this would pass, the block's own pages.
      ++ needPages ++ ls lpg
      ++ blkGet offABump ++ [80, 69] ++ voidIf (
          halfPages ++ lg lpg ++ [85] ++ voidIf (halfPages ++ ls lpg)
          ++ blkGet offCap ++ [80, 69] ++ voidIf (
              [63, 0, 173] ++ lg lpg ++ [124] ++ i64Const 65536 ++ [126] ++ blkGet offCap ++ [85]
              ++ voidIf (needPages ++ ls lpg)))
      ++ lg lpg ++ [167] ++ [64, 0] ++ i32Const (-1) ++ [70]
      ++ voidIf (needPages ++ [167] ++ [64, 0] ++ i32Const (-1) ++ [70]
          ++ voidIf (refuseTo profile.tagCapacity profile.detGrow))
      ++ memoryEnd ++ ls lnb
      ++ lg lnb ++ lg lnl ++ [125] ++ ls li
      ++ blkGet offABump ++ [80] ++ [4, 64]
          ++ blkSet offABump (lg lnb)
        ++ [5]
          ++ blkGet offABump ++ lg li ++ [124] ++ [167]
          ++ blkGet offABump ++ [167]
          ++ lg lnl ++ blkGet offABump ++ [125] ++ [167]
          ++ [252, 10, 0, 0]
          ++ blkSet offABump (blkGet offABump ++ lg li ++ [124])
          ++ lg lblk ++ [80, 69] ++ voidIf (lg lblk ++ lg li ++ [124] ++ ls lblk)
        ++ [11])
      ++ blkGet offABump ++ lg lsz ++ [125] ++ ls lnb
      ++ blkSet offLimit (memoryEnd)
      ++ blkSet offABump (lg lnb)
      ++ hdrOf lnb capCode
  -- move `blk` to a fresh block of capacity `capCode`, copying the first
  -- `lcnt` elements; afterwards `blk` names the new block.
  let moveTo (capCode : List Int) :=
    newBlock capCode
      ++ lg lnb ++ i64Const 24 ++ [124] ++ [167]
      ++ lg lblk ++ i64Const 24 ++ [124] ++ [167]
      ++ lg lcnt ++ i64Const (w : Int) ++ [126] ++ i64Const 1 ++ [124] ++ i64Const 8 ++ [126] ++ [167]
      ++ [252, 10, 0, 0]
      ++ initElems lnb (lg lcnt) capCode
      ++ lg lnb ++ ls lblk
  { params := repI64 (npw + 2)
  , results := [vtI64]
  , locals := repI64 9
  , code := fuelPrologue
      ++ blkSet 312 (blkGet 312 ++ i64Const 1 ++ [124])
      ++ arenaLen (lg arP) ++ ls lcnt
      ++ i64Const 0 ++ ls lblk
      ++ arenaVersion (lg arP) ++ [80]
      ++ [4, 64]
        -- All high-zero spellings denote the empty arena (also host nil).
        ++ i64Const 0 ++ ls lcnt
        ++ newBlock (i64Const cap0)
        ++ initElems lnb (i64Const 0) (i64Const cap0)
        ++ lg lnb ++ ls lblk
      ++ [5]
        ++ arenaBlock (lg arP) ++ ls lblk
        ++ ldW lblk 8 ++ i64Const 1 ++ [125] ++ i64Const (w : Int) ++ [127] ++ ls lcap
        ++ lg lcnt ++ i64Const arenaMask ++ [90]
        ++ voidIf (refuseTo profile.tagCapacity detArenaLayout)
        ++ lg lcnt ++ lg lcap ++ [81] ++ [4, 64]
          ++ lg lcap ++ i64Const 4 ++ [126] ++ ls lcap
          ++ blkSet 320 (blkGet 320 ++ i64Const 1 ++ [124]) ++ moveTo (lg lcap)
        ++ [5]
          -- A live suffix belongs to another retained version: never rewind. The fresh block is as large as
          -- the prefix it takes, an eighth of that again and eight elements, not as the block it leaves: a program
          -- that forks at every allocation would otherwise take a whole block's bytes for each of them.
          ++ lg lcnt ++ ldW lblk 24 ++ [82]
          ++ voidIf (lg lcnt ++ lg lcnt ++ i64Const 3 ++ [136] ++ [124] ++ i64Const 8 ++ [124] ++ ls lcap
              ++ moveTo (lg lcap))
        ++ [11]
      ++ [11]
      ++ lg lblk ++ lg lcnt ++ i64Const sw ++ [126] ++ [124] ++ i64Const 32 ++ [124] ++ ls lea
      ++ stW lea 0 (lg 2)
      ++ kidsStore kidsArr lea li lnl
      ++ stWs lea (8 * (2 + arenaKids : Int)) (if kidsArr then 5 else 4) 6
      ++ pinCheck lea arenaStoredMap 0
      ++ stW lblk 24 (lg lcnt ++ i64Const 1 ++ [124])
      ++ stW 0 profile.resAt (lg lcnt)
      ++ memoryEnd ++ lg lblk ++ [125] ++ i64Const 32 ++ [134]
      ++ lg lcnt ++ i64Const 1 ++ [124] ++ [132] ++ ls lnl
      ++ blkSet offArena (lg lnl)
      ++ stW 0 (profile.resAt + 8) (lg lnl)
      ++ i64Const 0 ++ [opEnd] }

-- resAt[k] = lea[8k] for the element words.


def copyRes (lea w k : Nat) : List Int :=
  match k with
  | 0 => []
  | k + 1 => copyRes lea w k ++ stW 0 (profile.resAt + 8 * ((w - 1 - k : Nat) : Int)) (ldW lea (8 * ((w - 1 - k : Nat) : Int)))

-- read(ar, h): decode its own version, never the latest global version.
-- Element h when 0 <= h < count; otherwise call the out-of-range node.
-- resAt[r + k] = lea[8 (2 + arenaKids + k)] for the six trailing fields.
def copyTail (lea r : Nat) : Nat → List Int
  | 0 => []
  | k + 1 => copyTail lea r k ++ stW 0 (profile.resAt + 8 * ((r + k : Nat) : Int)) (ldW lea (8 * ((2 + arenaKids + k : Nat) : Int)))

def wfnArenaReadWithLayers (tg : Dg) (lay : Layers) (rtBase : Nat) (arr sigs : List (List Int)) (sig : List Int) : WFn :=
  let p := sigParams sig
  let ety := (innerTy tg) ((nthTy tg) 0 p)
  let kidsArr := (memT tg) arr [4, 0]
  let w := arenaStored
  let sw : Int := 8 * (w : Int)
  let npw := ((paramWordsWithLayers tg) lay) arr (sigCount sig) p
  let lea := 2 + npw
  let lc := lea + 1
  let li := lc + 2
  let bad := (badIdxGo tg) sigs ety 0
  let badArg := if bad >= 0 && sigCount (sigOf sigs bad.toNat) == 1 then lg 3 else []
  { params := repI64 (npw + 2)
  , results := [vtI64]
  , locals := repI64 4
  , code := fuelPrologue
      ++ lg 3 ++ i64Const 0 ++ [83] ++ lg 3 ++ arenaLen (lg 2) ++ [89] ++ [114] ++ arenaVersion (lg 2) ++ [80] ++ [114]
      ++ voidIf (lg 0 ++ passFuel ++ badArg ++ callFn (bad.toNat + rtBase) ++ [15])
      ++ arenaBlock (lg 2) ++ lg 3 ++ i64Const sw ++ [126] ++ [124] ++ i64Const 32 ++ [124] ++ ls lea
      ++ kidsLoad kidsArr lea lc li (arenaBlock (lg 2) ++ lg 3 ++ i64Const sw ++ [126] ++ [124] ++ i64Const 32 ++ [124] ++ ls lea)
      ++ stW 0 profile.resAt (ldW lea 0)
      ++ stW 0 (profile.resAt + 8) (lg lc)
      ++ (if kidsArr then stW 0 (profile.resAt + 16)
            (ldW lea 8 ++ i64Const (arenaKids : Int) ++ [85] ++ [4, 126] ++ ldW lea 24 ++ [5] ++ i64Const 0 ++ [11])
          else [])
      ++ copyTail lea (if kidsArr then 3 else 2) 6
      ++ i64Const 0 ++ [opEnd] }

-- Compare the complete reference helper body after opening DAG references.
-- Only its small grammar is accepted; changing an operation, type, variable,
-- field, callee, argument order or leaf prevents intrinsic recognition.


structure Hm where
  ok : Bool
  plain : List Int
  rest : List Int

def hmFail : Hm := { ok := false, plain := [], rest := [] }

def heapMatch (g : Dg) : Nat → Nat → Nat → List Int → List Int → Hm
  | 0, _, _, _, _ => hmFail
  | k + 1, ph, n, p, r =>
    if ph == 1 then
      if n == 0 then { ok := true, plain := p, rest := r }
      else
        let a := heapMatch g k 0 0 p r
        if !a.ok then a else heapMatch g k 1 (n - 1) a.plain a.rest
    else if ph == 2 then
      match p, r with
      | 0 :: ps, 0 :: rs => { ok := true, plain := ps, rest := rs }
      | 1 :: ps, 1 :: rs =>
        let a := heapMatch g k 0 0 ps rs
        if !a.ok then a else heapMatch g k 2 0 a.plain a.rest
      | _, _ => hmFail
    else
      match p, drE g r with
      | t :: ps, u :: rs =>
        if t != u then hmFail
        else if t == 33 then { ok := true, plain := ps, rest := rs }
        else if t == 0 then
          let a := takeBytes 9 0 [] ps
          let b := takeBytes 9 0 [] rs
          if a.ok == profile.cOk && b.ok == profile.cOk && eqW a.bs b.bs then
            { ok := true, plain := a.rest, rest := b.rest } else hmFail
        else if t == 3 || t == 52 then
          let a := readLeb ps
          let b := readLeb rs
          if a.ok != profile.cOk || b.ok != profile.cOk || a.n != b.n then hmFail
          else if t == 3 then { ok := true, plain := a.rest, rest := b.rest }
          else heapMatch g k 2 0 a.rest b.rest
        else if t == 34 then
          let a := skipName ps
          let b := skipName rs
          if a.ok != profile.cOk || b.ok != profile.cOk || a.n != b.n then hmFail
          else if !eqW (takeBytes a.n.toNat 0 [] ps).bs (takeBytes b.n.toNat 0 [] rs).bs then hmFail
          else heapMatch g k 1 2 a.rest b.rest
        else if t == 14 || t == 24 || t == 35 then
          let a := (readTyD g) ps
          let b := readTyD g rs
          if a.ok != profile.cOk || b.ok != profile.cOk || !(typeEq g) a.acc b.acc then hmFail
          else if t == 35 then
            let ai := readLeb a.rest
            let bi := readLeb b.rest
            if ai.ok != profile.cOk || bi.ok != profile.cOk || ai.n != bi.n then hmFail
            else heapMatch g k 1 1 ai.rest bi.rest
          else heapMatch g k 1 (if t == 14 then 2 else 1) a.rest b.rest
        else if t == 5 then heapMatch g k 1 3 ps rs
        else if t == 7 || t == 26 || t == 27 then heapMatch g k 1 2 ps rs
        else if t == 23 || t == 25 || t == 39 then heapMatch g k 1 1 ps rs
        else hmFail
      | _, _ => hmFail

def heapName (i : Int) : List Int := [1, 2, 102, 48 + i]
def heapMarker (tg : Dg) (node : List Int) : List Int := ((heapHandleOf tg) node).drop 2 |>.take 18

def heapAllocBody (tg : Dg) (node : List Int) : List Int :=
  [34] ++ heapName 0 ++ [34] ++ (heapMarker tg) node ++ [24, 4] ++ node ++ [3, 1, 33, 34] ++ heapName 1 ++ [26, 3, 1, 23, 3, 0, 33]

def heapReadBody (tg : Dg) (node : List Int) (idx : Nat) : List Int :=
  let h := [35] ++ (heapHandleOf tg) node ++ [0, 3, 1]
  let z := [0, 0] ++ zeros 8
  let one := [0, 0, 1] ++ zeros 7
  [5, 14, 0] ++ h ++ z ++ [39, 25, 3, 0, 52] ++ lebU idx
    ++ [1, 27] ++ one ++ [3, 0, 1, 34] ++ (heapMarker tg) node ++ [7] ++ h ++ one ++ [33, 0]

-- The child getter the frontend emits beside `alloc` and `read`: `kid xs i` is the i-th handle of a node's
-- children, written as `if i == 0 then unwrap (head? xs) else kid (drop 1 xs) (i - 1)`.
def heapKidBody (idx : Nat) : List Int :=
  let z := [0, 0] ++ zeros 8
  let one := [0, 0, 1] ++ zeros 7
  [5, 14, 0, 3, 1] ++ z ++ [39, 25, 3, 0, 52] ++ lebU idx ++ [1, 27] ++ one ++ [3, 0, 1, 7, 3, 1] ++ one ++ [0]

def heapKindWithLayers (lay : Layers) (g : Dg) (idx : Nat) (sig bs : List Int) : Nat :=
  if !lay.rc || sigCount sig != 2 then 0
  else
    let p := sigParams sig
    let t0 := (nthTy g) 0 p
    let t1 := (nthTy g) 1 p
    let r := (sigResult g) sig
    let f0 := [7, 2] ++ heapName 0 ++ (heapHandleOf g) t0 ++ heapName 1
    if (isHeapNode g) t0 && (typeEq g) t1 (4 :: t0) && (typeEq g) r (f0 ++ t1) then
      let m := heapMatch g 200 0 0 ((heapAllocBody g) t0) bs
      if m.ok && m.plain.isEmpty then 3 else 0
    else if (isHeapNode g) r && (typeEq g) t0 (4 :: r) && (typeEq g) t1 ((heapHandleOf g) r) then
      let m := heapMatch g 200 0 0 ((heapReadBody g) r idx) bs
      if m.ok && m.plain.isEmpty then 4 else 0
    -- Kind 5, the child getter (layer `ctor`). The children are a linked list here; a word with `arr` may hold
    -- them as an array, and keeps the source body.
    else if lay.ctor && !lay.arr && (isHeapHandle g) r && (typeEq g) t0 (4 :: r) && (typeEq g) t1 [0] then
      let m := heapMatch g 200 0 0 (heapKidBody idx) bs
      if m.ok && m.plain.isEmpty then 5 else 0
    else 0

-- Parameters are borrowed, as at ordinary call boundaries. The new owning
-- node acquires its two payload references before the caller releases args.
-- Lean IR's nullary/static constructor case: the complete payload is
-- determined by a small tag, with no heap references. The reserved table
-- does not overlap the ABI block, allocation bins, or counted heap.


def biParams : Nat → Nat → List Nat
  | _, 0 => []
  | pos, n + 1 => pos :: biParams (pos + 1) n


def biParamEnv : List Nat → List Int
  | [] => []
  | p :: ps => (p : Int) :: biParamEnv ps


structure BiFns where
  fns : List Lib.Beans.FlowFn := []
  err : Int := profile.cOk
  opens : Nat := 0
  hits : Nat := 0
  heapKinds : List Nat := []


def biScanFnsWithLayers (lay : Layers) (g : Dg) : List (List Int) → Nat → List Int → BiFns
  | [], _, [0] => {}
  | [], _, _ => { err := profile.cTrail }
  | sig :: sigs, i, 1 :: bs =>
    let count := sigCount sig
    let params := biParams 0 count
    let walk := biWalk g (if g.on then profile.v2Fuel else bs.length * profile.lowerMul + profile.lowerAdd)
      0 0 0 0 (biParamEnv params) { rest := bs, next := count, self := (i : Int) } true
    if walk.ok != profile.cOk then { err := walk.ok }
    else
      let more := (biScanFnsWithLayers lay) g sigs (i + 1) walk.rest
      if more.err != profile.cOk then more
      else
        -- Heap intrinsics replace their source bodies and borrow all inputs.
        -- Keep their ABI in this plan instead of inferring an erased body.
        let heapKind := (heapKindWithLayers lay) g i sig bs
        -- The child getter (kind 5) keeps its source body's facts: its intrinsic takes each parameter as the
        -- plan infers it for that body, so the plan and every caller are as without the intrinsic.
        let facts := if heapKind == 3 || heapKind == 4 then [] else [0, walk.value] :: walk.facts
        { more with
          fns := { params := params, facts := facts } :: more.fns
          opens := more.opens + walk.opens
          hits := more.hits + walk.hits
          heapKinds := heapKind :: more.heapKinds }
  | _ :: _, _, _ => { err := profile.cBody }


-- Lean inserts ResetReuse before inferBorrow: reset consumes its source.
-- Intrinsic heap reads/allocations erase that source-level demand here.
-- Conservatively approximate R/D/S across branches: if a function reads a
-- node and constructs the same node type, its read handle may supply reset
-- storage. Seed that handle Owned before the ordinary SCC solver. Actual
-- lowering still requires a dead Owned root and a dynamic unique check.
def biReuseNodeTypes (g : Dg) (sigs : List (List Int)) (kinds : List Nat)
    : List (List Int) → List (List Int) → List (List Int)
  | [], nodes => nodes
  | fact :: facts, nodes =>
    let f := fact.tail.headD (-1)
    let call := fact.headD (-1) == 2 || fact.headD (-1) == 4
    let node := nthTy g 0 (sigParams (sigOf sigs f.toNat))
    let nodes := if call && f >= 0 && (kinds[f.toNat]?).getD 0 == 3
        && !memT g nodes node then node :: nodes else nodes
    biReuseNodeTypes g sigs kinds facts nodes

-- R030: retain demand order without one native stack frame per fact.
def biReuseDemandsGo (g : Dg) (sigs : List (List Int)) (kinds : List Nat)
    (nodes : List (List Int)) : List (List Int) → List (List Int) → List (List Int)
  | [], acc => revW acc []
  | fact :: facts, acc =>
    let f := fact.tail.headD (-1)
    let source := (fact.drop 3).headD (-1)
    let call := fact.headD (-1) == 2 || fact.headD (-1) == 4
    let acc := if call && f >= 0 && source >= 0 && (kinds[f.toNat]?).getD 0 == 4
        && memT g nodes (sigResult g (sigOf sigs f.toNat)) then [0, source] :: acc else acc
    biReuseDemandsGo g sigs kinds nodes facts acc

def biReuseDemands (g : Dg) (sigs : List (List Int)) (kinds : List Nat)
    (nodes : List (List Int)) (facts : List (List Int)) : List (List Int) :=
  biReuseDemandsGo g sigs kinds nodes facts []

def biInferWithLayers (lay : Layers) (g : Dg) (sigs : List (List Int)) (bs : List Int) : BiPlan :=
  if !(biOnWithLayers lay) then {}
  else
    let scanned := (biScanFnsWithLayers lay) g sigs 0 bs
    if scanned.err != profile.cOk then { err := scanned.err }
    else
      let free := biFree g (if g.on then profile.v2Fuel else bs.length * profile.lowerMul + profile.lowerAdd) 1 0 { rest := bs }
      let fns := if !lay.reuse then scanned.fns else scanned.fns.map (fun fn =>
        let nodes := biReuseNodeTypes g sigs scanned.heapKinds fn.facts []
        { fn with facts := biReuseDemands g sigs scanned.heapKinds nodes fn.facts ++ fn.facts })
      let flow := Lib.Beans.flowInfer fns
      { flow := flow
        free := free.cache
        heapKinds := scanned.heapKinds
        err := (if free.ok != profile.cOk then free.ok else if flow.err == 0 then profile.cOk else 600 + flow.err)
        opens := scanned.opens
        hits := scanned.hits }


-- Heap handles hold one boxed value. Packing/unpacking shares ObjectLayout
-- with list/array fields; local and source-call arguments remain flat.
def wfnHeapAllocWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) : WFn :=
  let ty := (nthTy tg) 0 (sigParams sig)
  let npw := ((paramWordsWithLayers tg) lay) arr (sigCount sig) (sigParams sig)
  let ptr := 2 + npw
  let packed := storagePackHeapNode tg lay arr ty 2 ptr (ptr + 1)
  { params := repI64 ptr, results := [vtI64], locals := repI64 (packed.nxt - ptr),
    code := fuelPrologue ++ (if packed.ok then packed.code else refuseTo profile.tagCapacity detRepr)
      ++ stW 0 profile.resAt (lg ptr)
      ++ stW 0 (profile.resAt + 8) (i64Const 0)
      ++ i64Const 0 ++ [opEnd] }

def wfnHeapReadWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) : WFn :=
  let ty := (sigResult tg) sig
  let w := wordsOfWithLayers tg lay arr ty
  let unpacked := storageUnpackHeapNode tg lay arr ty 3 4 (4 + w)
  { params := repI64 4, results := [vtI64], locals := repI64 (unpacked.nxt - 4),
    code := fuelPrologue
      ++ (if unpacked.ok then unpacked.code else refuseTo profile.tagCapacity detRepr)
      ++ ownEffectsWithLayers lay 6 [ownRootWithLayers tg lay arr ty 4]
      ++ stWs 0 profile.resAt 4 w ++ i64Const 0 ++ [opEnd] }

-- The child getter as an intrinsic (Lean 4.14.0 include/lean/lean.h:550 `lean_ctor_get`, object field i, and the
-- `lean_inc` its caller adds). One walk of at most i cells; the handle returned is retained. `owned` is the plan's
-- ownership of the list parameter for the source body: an owned list is released after the handle is retained, as
-- the source body's walk releases it, so a caller's last use leaves the child as unique as before. Without a plan
-- (a word with `rc` alone) the caller keeps the list, and the intrinsic releases nothing.
-- Walking off the end is the source body's `unwrap` of none.
-- Parameters: 2 the list (the cursor), 3 the index; locals: 4 the handle, 5 the list as passed.
def wfnHeapKidWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sig : List Int) (owned : Bool) : WFn :=
  let elem := (sigResult tg) sig
  let listTy := (nthTy tg) 0 (sigParams sig)
  let tailOff := ((tailOffWithLayers tg) lay) arr elem
  let pay := ((cellPayWithLayers tg) lay) arr elem
  { params := repI64 4, results := [vtI64], locals := repI64 2,
    code := fuelPrologue
      ++ lg 2 ++ ls 5
      ++ [2, 64, 3, 64]
      ++ lg 3 ++ [80, 13, 1]
      ++ lg 2 ++ i64Const profile.emptyAt ++ [81, 13, 1]
      ++ ldW 2 tailOff ++ ls 2
      ++ lg 3 ++ i64Const 1 ++ [125] ++ ls 3
      ++ [12, 0, 11, 11]
      ++ lg 2 ++ i64Const profile.emptyAt ++ [81] ++ voidIf (refuseStuck stTypeMismatch)
      ++ ldW 2 pay ++ ls 4
      ++ ownEffectsWithLayers lay 6 [ownRootWithLayers tg lay arr elem 4]
      ++ (if owned then ownEffectsWithLayers lay 7 [ownRootWithLayers tg lay arr listTy 5] else [])
      ++ stW 0 profile.resAt (lg 4)
      ++ i64Const 0 ++ [opEnd] }

structure ReuseListWorkers where
  ok : Bool := true
  err : Int := profile.cWide
  fns : List WFn := []

def reuseListWorker (g : Dg) (lay : Layers) (arr : List (List Int)) (elem : List Int) (reset : Bool) : StorageCode :=
  let src := if reset then 2 else 1
  let tail := src + wordsOfWithLayers g lay arr elem
  let dst := tail + 1
  let packed := storageConsReuse g lay arr elem (if reset then [1] else []) src tail dst (dst + 1)
  { packed with code := packed.code ++ stW 0 profile.resAt (lg dst)
      ++ (if reset then stW 0 (profile.resAt + 8) (lg 1) else [])
      ++ i64Const 0 ++ [opEnd] }

def reuseListWorkers (g : Dg) (lay : Layers) (arr : List (List Int)) : List (List Int) → ReuseListWorkers
  | [] => {}
  | ty :: rest =>
    let elem := innerTy g ty
    let w := wordsOfWithLayers g lay arr elem
    let fresh := reuseListWorker g lay arr elem false
    let reset := reuseListWorker g lay arr elem true
    let more := reuseListWorkers g lay arr rest
    let freshFn : WFn :=
      { params := repI64 (w + 2)
        results := [vtI64]
        locals := repI64 (fresh.nxt - (w + 2))
        code := fresh.code }
    let resetFn : WFn :=
      { params := repI64 (w + 3)
        results := [vtI64]
        locals := repI64 (reset.nxt - (w + 3))
        code := reset.code }
    { ok := fresh.ok && reset.ok && more.ok,
      err := if !fresh.ok then fresh.err else if !reset.ok then reset.err else more.err,
      fns := (if storageClass g elem > 0 then [resetFn] else [freshFn, resetFn]) ++ more.fns }

-- A group member's lowered body, kept until its group function is assembled.


structure GB where
  idx : Nat
  code : List Int
  nxt : Nat

structure Fs where
  ok : Int
  fns : List WFn
  rest : List Int
  cen : Cen
  gb : List GB
  bodies : List (List Int)

def fsFail (c : Int) (rest : List Int) : Fs :=
  { ok := c, fns := [], rest := rest, cen := cenEmpty, gb := [], bodies := [] }

def groupMaxWWithLayers (tg : Dg) (lay : Layers) (arr : List (List Int)) (sigs : List (List Int)) : List Int → Nat
  | [] => 0
  | f :: fs =>
    let sig := sigOf sigs f.toNat
    let w := ((paramWordsWithLayers tg) lay) arr (sigCount sig) (sigParams sig)
    let m := ((groupMaxWWithLayers tg) lay) arr sigs fs
    if w > m then w else m



def groupPos : List (List Int) → List Int → Nat
  | [], _ => 0
  | g :: gs, x => if eqW g x then 0 else groupPos gs x + 1

-- Padding is i64.const 0. A raw 0 byte is unreachable and traps the narrow entry.
def padWords : Nat → List Int
  | 0 => []
  | k + 1 => i64Const 0 ++ padWords k

-- A member's exported function forwards to the group: tag, its words, zero padding.
def stubFn (f npw maxw gidx : Nat) : WFn :=
  { params := repI64 (npw + 2)
  , results := [vtI64]
  , locals := []
  , code := lg 0 ++ lg 1 ++ i64Const f ++ argWords 2 npw ++ padWords (maxw - npw) ++ callFn gidx ++ [opEnd] }

-- Classify runtime intrinsics before expression rewriting. Their source bodies
-- are certificates for the reserved ABI, rather than executable function IR.
-- Keep that classification when CSE rewrites expressions inside the certificate.
def intrinsicKinds (lay : Layers) (g : Dg) : Nat → List (List Int) → List Int → List Int
  | _, [], _ => []
  | i, s :: ss, 1 :: bs =>
    let e := skipE g profile.v2Fuel bs
    if e.ok != profile.cOk then []
    else (heapKindWithLayers lay g i s bs : Int) :: intrinsicKinds lay g (i + 1) ss e.rest
  | _, _, _ => []

def lowerFnsWithIntrinsics (lay : Layers) (intrinsics : List Int) (dg : Dg) (bi : BiPlan) (tbl : List TE) (rtBase : Nat) (arr : List (List Int)) (sigs : List (List Int)) (groups memos bodies eqt : List (List Int)) (eqb : Nat) (nfns : Nat) : Nat → List (List Int) → List Int → Cen → Fs
  | _, [], [], _ => fsFail profile.cBody []
  | _, [], b :: bs, cen =>
    if b == 0 then
      match bs with
      | [] => { ok := profile.cOk, fns := [], rest := [], cen := cen, gb := [], bodies := [] }
      | _ => fsFail profile.cTrail bs
    else fsFail profile.cBody (b :: bs)
  | _, _, [], _ => fsFail profile.cTrunc []
  | i, s :: ss, b :: bs, cen =>
    if b != 1 then fsFail profile.cBody (b :: bs)
    else
      let npw := ((paramWordsWithLayers dg) lay) arr (sigCount s) (sigParams s)
      let g := groupOf groups (i : Int)
      match g with
      | [] =>
        let hk := ((intrinsics.drop i).headD 0).toNat
        let ak := if abiWideSignature dg lay arr s then 0 else if hk > 0 then hk else if lay.rc then 0 else (arenaKind dg) sigs s (drE dg bs)
        if ak != 0 then
          let sk := skipE dg profile.skipFuel bs
          if sk.ok != profile.cOk then fsFail sk.ok sk.rest
          else
            -- The wfn rep is a one-word handle, so the arena list type must
            -- never be array-admitted; the 3:: mark tells compileWith to
            -- strip it from `arr`, keeping params one word in every layer.
            -- The child getter has no arena parameter; it adds nothing to the census.
            let cen1 := if ak == 5 then cen else cenAddType dg 3 ((arenaListTy dg) (if ak == 3 then 1 else ak) s) (if ak == 2 then cenAdd 8 [0] cen else cen)
            let more := (lowerFnsWithIntrinsics lay intrinsics) dg bi tbl rtBase arr sigs groups memos bodies eqt eqb nfns (i + 1) ss sk.rest cen1
            if more.ok != profile.cOk then more
            else { more with
              bodies := (takeBytes (bs.length - sk.rest.length) 0 [] bs).bs :: more.bodies
              fns := (if ak == 3 then ((wfnHeapAllocWithLayers dg) lay) arr s else if ak == 4 then ((wfnHeapReadWithLayers dg) lay) arr s else if ak == 5 then ((wfnHeapKidWithLayers dg) lay) arr s (biOnWithLayers lay && (biBits bi i).headD 0 == 1) else if ak == 1 then ((wfnArenaAllocWithLayers dg) lay) arr s else ((wfnArenaReadWithLayers dg) lay) rtBase arr sigs s) :: more.fns }
        else
          -- RC lowers the old arena helpers as ordinary owning functions.
          -- Keep their arena list's public one-word ABI even though the
          -- non-RC arena intrinsics are not selected. Other list types can
          -- still be array-admitted, including a node's children.
          let legacy := if lay.rc then (arenaKind dg) sigs s (drE dg bs) else 0
          let cen0 := if legacy == 0 then cen else cenAddType dg 3 ((arenaListTy dg) legacy s) cen
          let lw := (lowerFn lay) dg bi tbl rtBase arr sigs i s bs cen0 [] (2 + npw) (memoOf memos (i : Int)) bodies eqt eqb
          if lw.ok != profile.cOk then fsFail lw.ok lw.rest
          else
            let more := (lowerFnsWithIntrinsics lay intrinsics) dg bi tbl rtBase arr sigs groups memos bodies eqt eqb nfns (i + 1) ss lw.rest lw.cen
            if more.ok != profile.cOk then more
            else { more with fns := wfnOf (abiParamWords dg lay arr (sigCount s) (sigParams s) + (if wordsOfWithLayers dg lay arr (sigResult dg s) > profile.resWords then 1 else 0)) lw :: more.fns, bodies := (takeBytes (bs.length - lw.rest.length) 0 [] bs).bs :: more.bodies }
      | gs :: _ =>
        let maxw := ((groupMaxWWithLayers dg) lay) arr sigs gs
        let lw := (lowerFn lay) dg bi tbl rtBase arr sigs i s bs cen g (3 + maxw) [] bodies eqt eqb
        if lw.ok != profile.cOk then fsFail lw.ok lw.rest
        else
          let more := (lowerFnsWithIntrinsics lay intrinsics) dg bi tbl rtBase arr sigs groups memos bodies eqt eqb nfns (i + 1) ss lw.rest lw.cen
          if more.ok != profile.cOk then more
          else { more with
            bodies := (takeBytes (bs.length - lw.rest.length) 0 [] bs).bs :: more.bodies
            fns := stubFn i npw maxw (rtBase + nfns + groupPos groups gs) :: more.fns
            gb := { idx := i, code := flushAll lw.code [], nxt := lw.nxt } :: more.gb }


def gbOf : List GB → Nat → GB
  | [], _ => { idx := 0, code := [], nxt := 0 }
  | g :: gs, i => if g.idx == i then g else gbOf gs i

-- The loop body of a group: a chain of tag tests, one member each.
def groupChain (gb : List GB) : List Int → List Int
  | [] => refuseTo profile.tagCapacity detRepr
  | f :: fs =>
    let b := gbOf gb f.toNat
    lg 2 ++ i64Const f ++ [81] ++ [4, 64] ++ b.code ++ [5] ++ groupChain gb fs ++ [11]

def groupNxt (gb : List GB) : List Int → Nat
  | [] => 0
  | f :: fs =>
    let n := (gbOf gb f.toNat).nxt
    let m := groupNxt gb fs
    if n > m then n else m

-- The exported stub borrows its arguments, just like a solo call. Retain
-- only the incoming member's owning parameters once, before the loop.
-- Tail transfers already retain their new arguments and drop old roots;
-- dispatching a transferred member must not retain them a second time.
def groupOwnParams (tg : Dg) (lay : Layers) (bi : BiPlan) (arr : List (List Int)) (sigs : List (List Int)) : List Int → List Int
  | [] => []
  | f :: fs =>
    let s := sigOf sigs f.toNat
    lg 2 ++ i64Const f ++ [81] ++ [4, 64]
      ++ (ownEffectsWithLayers lay) 6 [(3 : Int) :: ((biBorrowedMapWithLayers tg) lay) bi arr f.toNat s]
      ++ [5] ++ ((groupOwnParams tg) lay) bi arr sigs fs ++ [11]


def groupFnWithLayers (tg : Dg) (lay : Layers) (bi : BiPlan) (arr : List (List Int)) (sigs : List (List Int)) (gb : List GB) (g : List Int) : WFn :=
  let maxw := ((groupMaxWWithLayers tg) lay) arr sigs g
  let m0 := 3 + maxw
  let m1 := m0 + 1
  let m2 := m0 + 2
  { params := repI64 (3 + maxw)
  , results := [vtI64]
  , locals := repI64 (groupNxt gb g - (3 + maxw))
  , code := (if lay.rc then ((groupOwnParams tg) lay) bi arr sigs g else [])
      ++ fuelPrologue ++ blkGet offBump ++ ls m0 ++ arenaCount ++ ls m2
      ++ [3, 126] ++ blkGet offBump ++ ls m1 ++ groupChain gb g ++ i64Const 0 ++ [11, opEnd] }


def groupFnsWithLayers (tg : Dg) (lay : Layers) (bi : BiPlan) (arr : List (List Int)) (sigs : List (List Int)) (gb : List GB) : List (List Int) → List WFn
  | [] => []
  | g :: gs => ((groupFnWithLayers tg) lay) bi arr sigs gb g :: ((groupFnsWithLayers tg) lay) bi arr sigs gb gs


def biGetParams : Nat → Nat → List Int
  | _, 0 => []
  | pos, n + 1 => lg pos ++ biGetParams (pos + 1) n


def biWrappersWithLayers (tg : Dg) (lay : Layers) (bi : BiPlan) (arr : List (List Int)) : List (List Int) → Nat → List WFn
  | [], _ => []
  | sig :: sigs, f =>
    let npw := ((paramWordsWithLayers tg) lay) arr (sigCount sig) (sigParams sig)
    let wide := abiWideSignature tg lay arr sig
    let wire := abiParamWords tg lay arr (sigCount sig) (sigParams sig)
    let params := 2 + wire + (if wordsOfWithLayers tg lay arr (sigResult tg sig) > profile.resWords then 1 else 0)
    let flat := if wide then params else 2
    let wrapper : WFn := {
      params := repI64 params, results := [vtI64], locals := repI64 (if wide then npw else 0),
      code := (if wide then abiReadParams tg lay arr (sigCount sig) (sigParams sig) 2 flat else [])
        ++ (ownEffectsWithLayers lay) 6 [((flat : Int) :: ((biOwnedMapWithLayers tg) lay) bi arr f sig)]
        ++ biGetParams 0 params ++ callFn (bi.base + f) ++ [opEnd] }
    wrapper :: ((biWrappersWithLayers tg) lay) bi arr sigs (f + 1)


-- Only public entries accept the host's empty-arena word 0. The flat
-- type walk covers arenas inside records and pairs without changing scalar
-- zeroes or storage descriptors. Adapt before any ownership effects.
def arenaEntryWords : Nat → List Int → List Int
  | _, [] => []
  | p, m :: ms =>
    (if m == 1 then lg p ++ [80] ++ voidIf (i64Const profile.emptyAt ++ ls p) else [])
      ++ arenaEntryWords (p + 1) ms

def arenaPublicFnsWithLayers (g : Dg) (lay : Layers) (arr : List (List Int)) : List (List Int) → List WFn → List WFn
  | s :: ss, f :: fs =>
    let mask := sizeGoWithLayers g lay profile.v2Fuel arr 3 [] 1 (sigCount s) 0 [] (sigParams s)
    { f with code := (if abiWideSignature g lay arr s then [] else arenaEntryWords 2 mask.map) ++ f.code } :: arenaPublicFnsWithLayers g lay arr ss fs
  | _, fs => fs

structure Out where
  ok : Int
  bytes : List Int

-- Native observers may enter at a suffix of the function stream.
def lowerFnsWithLayers (lay : Layers) (dg : Dg) (bi : BiPlan) (tbl : List TE) (rtBase : Nat) (arr : List (List Int)) (sigs : List (List Int)) (groups memos bodies eqt : List (List Int)) (eqb nfns i : Nat) (ss : List (List Int)) (rest : List Int) (cen : Cen) : Fs :=
  lowerFnsWithIntrinsics lay (List.replicate i 0 ++ intrinsicKinds lay dg i ss rest) dg bi tbl rtBase arr sigs groups memos bodies eqt eqb nfns i ss rest cen


def outFail (c : Int) : Out :=
  { ok := c, bytes := [] }

def outOk (bytes : List Int) : Out :=
  { ok := profile.cOk, bytes := bytes }

structure OutP where
  ok : Int
  words : List UInt32

def outPFail (c : Int) : OutP :=
  { ok := c, words := [] }

def outPOk (words : List UInt32) : OutP :=
  { ok := profile.cOk, words := words }

def tableWithLayers (lay : Layers) : List TE :=
  tableA ++ (tableBWithLayers lay) ++ (tableCWithLayers lay)



def rtReach (cen : List (List Int)) : List Nat :=
  let r1 := memW cen [8, 1]
  let r2 := memW cen [8, 2]
  let r3 := memW cen [8, 3]
  let r4 := memW cen [8, 4]
  let r5 := memW cen [8, 5]
  let r0 := memW cen [8, 0] || r1 || r4 || r5
  (if r0 then [0] else [])
    ++ (if r1 then [1] else [])
    ++ (if r2 then [2] else [])
    ++ (if r3 then [3] else [])
    ++ (if r4 then [4] else [])
    ++ (if r5 then [5] else [])

def rtPos : List Nat → Nat → Nat → Nat
  | [], _, _ => 0
  | x :: xs, r, i => if x == r then i else rtPos xs r (i + 1)

def rtMapOf (rts : List Nat) : List Nat :=
  List.range rts.length ++ [rts.length]

def bindRtItems (rtMap : List Nat) : List TI → List TI
  | [] => []
  | t :: ts => (if t.k == 8 then { t with bs := callFn (lsAt rtMap t.h2) } else t) :: bindRtItems rtMap ts

def bindRt (rtMap : List Nat) : List TE → List TE
  | [] => []
  | e :: es => { e with items := bindRtItems rtMap e.items } :: bindRt rtMap es

-- The only representation-specific implementation is the pinned lib/rt
-- member. Decode and lower once per configuration rather than re-evaluating
-- unmemoized 0-arity source/table definitions at every runtime function slot.
structure RtCompiled where
  error : Nat
  fns : List WFn

def rtDecodeSource (rc : Bool) : RtDecoded :=
  let pfx := rtDecodeModule (if rc then runtimeSourceWire else runtimeSourceWire)
  let reu := rtDecodeModule runtimeReuseSourceWire
  { pfx with
    functions := pfx.functions ++ reu.functions
    error := if pfx.error != 0 then pfx.error else reu.error }

def runtimeAllocDecoded : RtDecoded := rtDecodeModule runtimeAllocSourceWire

def rtFunctionAt : Nat → List RtFunction → RtFunction
  | _, [] => { name := "", params := [], result := 2, locals := [], body := rtNil }
  | 0, fn :: _ => fn
  | n + 1, _ :: fns => rtFunctionAt n fns

def rtCompileFns (primRows : List (List RtPrim)) (rc : Bool) (sigs : List RtSignature) :
    List RtFunction → Nat → List WFn → RtCompiled
  | [], err, acc => { error := err, fns := acc.reverse }
  | fn :: rest, err, acc =>
    let e := rtLowerFunctionWith primRows rc sigs fn
    let err2 := if err != 0 then err else e.error
    let w : WFn := {
      params := fn.params.map rtWasmType,
      results := if fn.result == 2 then [] else [rtWasmType fn.result],
      locals := fn.locals.map rtWasmType,
      code := e.bytes }
    rtCompileFns primRows rc sigs rest err2 (w :: acc)

def rtCompileSource (rc : Bool) : RtCompiled :=
  let dec := rtDecodeSource rc
  if dec.error != 0 then { error := dec.error, fns := [] }
  else if dec.functions.length != 17 then { error := 20, fns := [] }
  else
    let primRows := rtPrimRows 16 rtPrimitives
    let sigs := rtSignaturesOf dec.functions
    rtCompileFns primRows rc sigs dec.functions 0 []

def runtimeRcCompiled : RtCompiled := rtCompileSource true

def runtimePrefixDecoded : RtDecoded := rtDecodeModule runtimeSourceWire
def runtimeReuseDecoded : RtDecoded := rtDecodeModule runtimeReuseSourceWire
def runtimeSourceDecoded : RtDecoded := rtDecodeSource true
def runtimeSourceSignatures : List RtSignature := rtSignaturesOf runtimeSourceDecoded.functions
def runtimeSourceError (rc : Bool) : Nat := (rtCompileSource rc).error
def runtimeOffError : Nat := runtimeSourceError false
def runtimeRcError : Nat := runtimeRcCompiled.error
def runtimeOffFunctions : List WFn := (rtCompileSource false).fns
def runtimeRcFunctions : List WFn := runtimeRcCompiled.fns

-- Memory64 versions of the same typed memory primitives. The stage uses
-- the runtime compiler's checked call path for these stencils and expands
-- them before any module is written. Their indices follow the last source
-- runtime function and do not enter the module's callable index space.
def rt64StencilsFrom (prims : List RtPrim) : List RtPrim :=
  prims.filter (fun p =>
    p.memory || p.name == "RT.memoryCopy" || p.name == "RT.memorySize" || p.name == "RT.memoryGrow")

def rt64Stencils : List RtPrim := rt64StencilsFrom rtPrimitives

def rt64StencilBase : Nat := 17

def rt64Signature (p : RtPrim) : RtSignature :=
  if p.memory then { name := p.name, params := [0] ++ p.args.drop 2 ++ [0], result := p.result }
  else if p.name == "RT.memoryCopy" then { name := p.name, params := [0, 0, 0], result := 2 }
  else { name := p.name, params := if p.name == "RT.memoryGrow" then [0] else [], result := 0 }

def rtNamedWith (primRows : List (List RtPrim)) (node : RtNode) (name : String) : Bool :=
  node.tag == 2 && node.val >= 0 && (rtPrimFast node.val.toNat primRows).name == name

def rt64AddressWith (primRows : List (List RtPrim)) (node : RtNode) : RtNode :=
  if rtNamedWith primRows node "RT.addr" && node.args.length == 1 then rtAt 0 node.args
  else if node.tag == 0 && node.ty == 1 && node.val >= 0 && node.val < 4294967296 then
    { node with ty := 0 }
  else node

def rt64ShiftWith (prims : List RtPrim) (name : String) (node : RtNode) : RtNode :=
  { tag := 2, val := rtPrimIndex 0 prims name, ty := 0,
    args := [node, { tag := 0, val := 3, ty := 0, args := [] }] }

def rt64MemoryNodeWith (prims : List RtPrim) (primRows : List (List RtPrim)) (node : RtNode) : RtNode :=
  if node.tag != 2 then node
  else
    let p := if node.val < 0 then rtPrimAt 0 [] else rtPrimFast node.val.toNat primRows
    match node.args with
    | first :: rest =>
      if p.memory then { node with args := rt64AddressWith primRows first :: rest }
      else if p.name == "RT.memoryCopy" then { node with args := node.args.map (rt64AddressWith primRows) }
      else if p.name == "RT.memoryGrow" then { node with args := [rt64AddressWith primRows first], ty := 0 }
      else if p.name == "RT.widen" && rtNamedWith primRows first "RT.memorySize" then { first with ty := 0 }
      else if p.name == "RT.eq32" && rtNamedWith primRows first "RT.memoryGrow" then
        let failed := rtAt 1 node.args
        if failed.tag == 0 && failed.ty == 1 && failed.val == 4294967295 then
          { node with val := rtPrimIndex 0 prims "RT.eq64", args := [first, { failed with ty := 0, val := -1 }] }
        else node
      else node
    | [] => if p.name == "RT.memorySize" then { node with ty := 0 } else node

-- Put a load/store's constant offset last so expansion can replace the
-- operand with the instruction's immediate, leaving the address and value.
def rt64StencilCallWith (primRows : List (List RtPrim)) (stencilBase : Nat) (stencils : List RtPrim) (node : RtNode) : RtNode :=
  if node.tag != 2 || node.val < 0 then node
  else
    let p := rtPrimFast node.val.toNat primRows
    let i := rtPrimIndex stencilBase stencils p.name
    if i < 0 then node
    else
      let args := if p.memory then [rtAt 0 node.args] ++ node.args.drop 2 ++ [rtAt 1 node.args] else node.args
      { node with tag := 3, val := i, args := args }

-- The first local (after two parameters) of drop_cold is 'queue'.
-- The dead object's count field stores queue / 8: every cell is aligned
-- to eight bytes and lies below 16 GiB. Zero still ends the queue.
def rt64ReleaseLinkWith (prims : List RtPrim) (primRows : List (List RtPrim)) (node : RtNode) : RtNode :=
  let first := rtAt 0 node.args
  if node.tag == 6 && node.val == 2 && rtNamedWith primRows first "RT.load32" then
    { node with args := [rt64ShiftWith prims "RT.shl64" first] }
  else if rtNamedWith primRows node "RT.store32" then
    let stored := rtAt 2 node.args
    if stored.tag == 1 && stored.val == 2 then
      { node with args := node.args.take 2 ++ [rt64ShiftWith prims "RT.shrU64" stored] }
    else node
  else node

mutual
  def rt64Node (prims : List RtPrim) (primRows : List (List RtPrim)) (stencilBase : Nat) (stencils : List RtPrim)
      (cap release : Bool) : Nat → RtNode → RtNode
    | 0, node => node
    | fuel + 1, node =>
      let node := rt64MemoryNodeWith prims primRows node
      let node := if cap && node.tag == 0 && node.ty == 0 && node.val == 4294967296 then
          { node with val := (addr64PageCap * 65536 : Nat) }
        else if release then rt64ReleaseLinkWith prims primRows node else node
      rt64StencilCallWith primRows stencilBase stencils
        { node with args := rt64Nodes prims primRows stencilBase stencils cap release fuel node.args }

  def rt64Nodes (prims : List RtPrim) (primRows : List (List RtPrim)) (stencilBase : Nat) (stencils : List RtPrim)
      (cap release : Bool) : Nat → List RtNode → List RtNode
    | 0, nodes => nodes
    | _ + 1, [] => []
    | fuel + 1, node :: nodes =>
      rt64Node prims primRows stencilBase stencils cap release fuel node
        :: rt64Nodes prims primRows stencilBase stencils cap release fuel nodes
end

-- Decode instructions, never scan individual bytes for call opcodes.
-- A memarg comes from the offset already checked by rtCompileSource.
-- Its nonnegative signed LEB is also an unsigned encoding of that value.
def rt64Expand : Nat → List (List Int) → List Int → RtEmission
  | 0, _, _ => rtEmitError 20
  | _ + 1, acc, [] => rtEmitOk (riJoin acc)
  | fuel + 1, acc, bs =>
    let i := rgStep bs
    if !i.ok then rtEmitError 20
    else if i.op == 16 && i.n >= rt64StencilBase then
      let p := rtPrimAt (i.n - rt64StencilBase) rt64Stencils
      if p.opcode.isEmpty then rtEmitError 20
      else if !p.memory then rt64Expand fuel (p.opcode :: acc) i.rest
      else match acc with
        | (66 :: offset) :: rest => rt64Expand fuel ((p.opcode ++ offset) :: rest) i.rest
        | _ => rtEmitError 20
    else rt64Expand fuel (i.bs :: acc) i.rest

def rtCompile64Fns (prims : List RtPrim) (primRows : List (List RtPrim)) (stencilBase : Nat)
    (stencils : List RtPrim) (sigs64 : List RtSignature) : List RtFunction → Nat → List WFn → RtCompiled
  | [], err, acc => { error := err, fns := acc.reverse }
  | f :: rest, err, acc =>
    let f64 : RtFunction := { f with body := rt64Node prims primRows stencilBase stencils (f.name == "bump") (f.name == "rsd_rt_v1_drop_cold") 200000 f.body }
    let e0 := rtLowerFunctionWith primRows true sigs64 f64
    let e := if e0.error != 0 then e0 else rt64Expand (e0.bytes.length + 1) [] e0.bytes
    let err2 := if err != 0 then err else e.error
    let w : WFn := {
      params := f.params.map rtWasmType,
      results := if f.result == 2 then [] else [rtWasmType f.result],
      locals := f.locals.map rtWasmType,
      code := e.bytes }
    rtCompile64Fns prims primRows stencilBase stencils sigs64 rest err2 (w :: acc)

def rtCompile64 (addr64 : Bool) : RtCompiled :=
  if !addr64 then { error := 20, fns := [] }
  else
    let dec := rtDecodeSource true
    if dec.error != 0 then { error := dec.error, fns := [] }
    else if dec.functions.length != rt64StencilBase then { error := 20, fns := [] }
    else
      let prims := rtPrimitives
      let primRows := rtPrimRows 16 prims
      let stencils := rt64StencilsFrom prims
      let sigs := rtSignaturesOf dec.functions
      let sigs64 := sigs ++ stencils.map rt64Signature
      rtCompile64Fns prims primRows rt64StencilBase stencils sigs64 dec.functions 0 []

def rtCompileForLayers (lay : Layers) : RtCompiled :=
  let base := if lay.rc then runtimeRcCompiled else rtCompileSource false
  if base.error != 0 || !lay.addr64 then base
  else rtCompile64 true

def rtWFnAt : Nat → List WFn → WFn
  | _, [] => { params := [], results := [], locals := [], code := [] }
  | 0, fn :: _ => fn
  | n + 1, _ :: fns => rtWFnAt n fns

def rtFnsFrom (fns : List WFn) : List Nat → List WFn
  | [] => []
  | r :: rs => rtWFnAt r fns :: rtFnsFrom fns rs

def rtFnListForLayers (lay : Layers) : List WFn :=
  if lay.addr64 then (rtCompile64 true).fns
  else if lay.rc then runtimeRcCompiled.fns
  else (rtCompileSource false).fns

def rtFnOfWithLayers (lay : Layers) (r : Nat) : WFn :=
  rtWFnAt r (rtFnListForLayers lay)

def rtFnsOfWithLayers (lay : Layers) (rts : List Nat) : List WFn :=
  rtFnsFrom (rtFnListForLayers lay) rts



def shiftFns (base : Nat) : List Nat → List Nat
  | [] => []
  | f :: fs => (base + f) :: shiftFns base fs

def shiftExps (rtBase : Nat) : List WEx → List WEx
  | [] => []
  | e :: es => { e with idx := e.idx + rtBase } :: shiftExps rtBase es

def hasArenaMark : List (List Int) → Bool
  | [] => false
  | (3 :: _) :: _ => true
  | _ :: rest => hasArenaMark rest

-- Switch reg (CHAIN-CLOSE-0, Methods by source): local coalescing on each
-- finished function. Liveness as Binaryen's CoalesceLocals
-- (src/passes/CoalesceLocals.cpp, algorithm only): a local is live from a
-- write to its last read, and a read that a path from entry reaches with no
-- write reads the zero the entry wrote, so that local is live from entry.
-- On structured code a write dominates a later read when the write's
-- innermost block is still open at the read; a local used inside a loop is
-- live over the whole outermost such loop (its back edge). The intervals
-- are allocated by Poletto and Sarkar's linear scan (Linear Scan Register
-- Allocation, TOPLAS 21(5), 1999): by increasing start, expire the active
-- intervals that ended, take the lowest free slot; no spills, one scan per
-- value type. Parameters keep their indices. A function with an opcode
-- outside the decoder's set, or a local type other than i64 and i32, is
-- left as it is.
--
-- One record for every list the pass sorts; `k` is the sort key.
-- Event: loc, pos, get, cl (innermost block's close), fs (the open blocks,
-- innermost first). Close: k open, cl close, get and hi the end of an
-- `if` that has an `else`. Interval: loc, lo (first position), rs (its
-- live ranges, sorted and disjoint), cl type.
-- A block: open, close, kind (0 block, 1 loop, 2 then arm with an else,
-- 3 else arm), ie (the `if`'s end, for an arm).
structure RgF where
  o : Nat
  cl : Nat
  kind : Nat
  ie : Nat

-- A live range [s, e] of positions.
structure RgQ where
  s : Nat
  e : Nat

structure RgR where
  k : Nat
  loc : Nat
  pos : Nat
  get : Bool
  cl : Nat
  lo : Nat
  hi : Nat
  fs : List RgF
  rs : List RgQ

def rgR0 : RgR := { k := 0, loc := 0, pos := 0, get := false, cl := 0, lo := 0, hi := 0, fs := [], rs := [] }


def rgNil : List Int → Bool
  | [] => true
  | _ => false

def rgRev : List RgR → List RgR → List RgR
  | [], acc => acc
  | x :: xs, acc => rgRev xs (x :: acc)

structure RgSp where
  l : List RgR
  r : List RgR

def rgTake : Nat → List RgR → List RgR → RgSp
  | 0, xs, acc => { l := rgRev acc [], r := xs }
  | _, [], acc => { l := rgRev acc [], r := [] }
  | k + 1, x :: xs, acc => rgTake k xs (x :: acc)

-- Stable: on equal keys the left run goes first.
def rgMerge : Nat → List RgR → List RgR → List RgR → List RgR
  | 0, xs, ys, acc => rgRev acc (xs ++ ys)
  | _, [], ys, acc => rgRev acc ys
  | _, xs, [], acc => rgRev acc xs
  | k + 1, x :: xs, y :: ys, acc =>
    if x.k ≤ y.k then rgMerge k xs (y :: ys) (x :: acc) else rgMerge k (x :: xs) ys (y :: acc)

def rgSortGo : Nat → Nat → List RgR → List RgR
  | 0, _, xs => xs
  | f + 1, n, xs =>
    if n ≤ 1 then xs
    else
      let h := n / 2
      let sp := rgTake h xs []
      rgMerge (n + 1) (rgSortGo f h sp.l) (rgSortGo f (n - h) sp.r) []

def rgSort (xs : List RgR) : List RgR :=
  rgSortGo (xs.length + 1) xs.length xs

-- Pass 1: each block's open and close position (`else` closes the then arm
-- and opens the else arm). Positions count instructions from 1. A stack
-- entry is (open, then arm's open for an else arm, else 0).
structure RgO where
  o : Nat
  t : Nat

def rgClosesGo : Nat → Nat → List RgO → List RgR → List Int → Option (List RgR)
  | 0, _, _, _, _ => none
  | k + 1, pos, st, acc, bs =>
    let i := rgStep bs
    if !i.ok then none
    else if i.op == 2 || i.op == 3 || i.op == 4 then rgClosesGo k (pos + 1) ({ o := pos, t := 0 } :: st) acc i.rest
    else if i.op == 5 then
      match st with
      | e :: st2 => rgClosesGo k (pos + 1) ({ o := pos, t := e.o } :: st2) acc i.rest
      | [] => none
    else if i.op == 11 then
      match st with
      | [] => if rgNil i.rest then some acc else none
      | e :: st2 =>
        let acc2 := if e.t > 0 then { rgR0 with k := e.t, cl := e.o, get := true, hi := pos } :: acc else acc
        rgClosesGo k (pos + 1) st2 ({ rgR0 with k := e.o, cl := pos } :: acc2) i.rest
    else rgClosesGo k (pos + 1) st acc i.rest

-- Pass 2: the local events; the stack of open blocks is each event's fs.
-- `q` is pass 1 sorted by open position.
def rgEvsGo : Nat → Nat → List RgF → List RgR → List RgR → List Int → Option (List RgR)
  | 0, _, _, _, _, _ => none
  | k + 1, pos, st, q, acc, bs =>
    match st with
    | [] => none
    | top :: below =>
      let i := rgStep bs
      if !i.ok then none
      else if i.op == 2 || i.op == 3 || i.op == 4 then
        match q with
        | h :: q2 =>
          if h.k != pos then none
          else
            let kind := if i.op == 3 then 1 else if i.op == 4 && h.get then 2 else 0
            rgEvsGo k (pos + 1) ({ o := pos, cl := h.cl, kind := kind, ie := h.hi } :: st) q2 acc i.rest
        | [] => none
      else if i.op == 5 then
        match q with
        | h :: q2 =>
          if h.k != pos then none else rgEvsGo k (pos + 1) ({ o := pos, cl := h.cl, kind := 3, ie := h.cl } :: below) q2 acc i.rest
        | [] => none
      else if i.op == 11 then
        match below with
        | [] => some (rgRev acc [])
        | _ => rgEvsGo k (pos + 1) below q acc i.rest
      else if i.op == 32 || i.op == 33 || i.op == 34 then
        let ev := { rgR0 with k := i.n, loc := i.n, pos := pos, get := i.op == 32, cl := top.cl, fs := st }
        rgEvsGo k (pos + 1) st q (ev :: acc) i.rest
      else rgEvsGo k (pos + 1) st q acc i.rest

def rgMin (a b : Nat) : Nat := if a < b then a else b
def rgMax (a b : Nat) : Nat := if a < b then b else a

-- The writes that still dominate: (position, close, blocks), closes
-- non-increasing toward the head, so the expired ones are on top. A write
-- that reaches the end of a then arm and one that reaches the end of its
-- else arm make a write at the `if`'s end in the enclosing block
-- (definite assignment at the join); `ext` carries the two arm writes'
-- ranges to their arms' closes (and, nested, theirs), which a read of the
-- join write adds to its own: the value is live from each arm's write to
-- the join, as CoalesceLocals' backward liveness has it.
structure RgD where
  o : Nat
  c : Nat
  fs : List RgF
  ext : List RgQ

def rgLive (x : Nat) : List RgD → List RgD
  | [] => []
  | s :: ss => if s.c ≤ x then rgLive x ss else s :: ss

-- The latest then-arm write of the `if` whose end is `ie` (pend is a stack).
def rgPend (ie : Nat) : List RgD → Option RgD
  | [] => none
  | d :: ds =>
    match d.fs with
    | f :: _ => if f.ie == ie then some d else rgPend ie ds
    | [] => rgPend ie ds

structure RgP where
  ss : List RgD
  pend : List RgD

def rgPush : Nat → RgD → List RgD → List RgD → RgP
  | 0, d, ss, pend => { ss := d :: ss, pend := pend }
  | k + 1, d, ss, pend =>
    match d.fs with
    | f :: up =>
      if f.kind == 2 then { ss := d :: ss, pend := d :: pend }
      else if f.kind == 3 then
        match rgPend f.ie pend, up with
        | some d1, g :: _ =>
          let j : RgD := { o := f.ie, c := g.cl, fs := up, ext := { s := d1.o, e := d1.c } :: { s := d.o, e := d.c } :: (d1.ext ++ d.ext) }
          let r := rgPush k j ss pend
          { r with ss := d :: r.ss }
        | _, _ => { ss := d :: ss, pend := pend }
      else { ss := d :: ss, pend := pend }
    | [] => { ss := d :: ss, pend := pend }

-- The outermost open loop that opened after the dominating write `pm`
-- (every open loop when no write dominates): the read is exposed at its
-- header, so the local is live over that whole loop.
def rgOuter (pm : Nat) (any : Bool) : List RgF → List RgF → List RgF
  | [], best => best
  | f :: fs, best =>
    if f.kind != 1 then rgOuter pm any fs best
    else if any || f.o > pm then rgOuter pm any fs [f]
    else best

structure RgS where
  cur : RgR
  ss : List RgD
  pend : List RgD

-- Events sorted by local (then position) to its live ranges, as
-- CoalesceLocals' liveness: a write is live at its own position; a read is
-- live from its dominating write, or from 0 when none dominates, and over
-- every loop at whose header it is exposed; a read of a join write is also
-- live over the join's arm ranges (`ext`). The ranges keep their holes.
def rgIvStep (e : RgR) (r : RgS) : RgS :=
  let cur := r.cur
  let ss2 := rgLive e.pos r.ss
  if !e.get then
    let p := rgPush e.fs.length { o := e.pos, c := e.cl, fs := e.fs, ext := [] } ss2 r.pend
    { r with cur := { cur with rs := { s := e.pos, e := e.pos } :: cur.rs }, ss := p.ss, pend := p.pend }
  else
    let nd := match ss2 with
      | [] => true
      | _ => false
    let pm := match ss2 with
      | s :: _ => s.o
      | [] => 0
    let jx := match ss2 with
      | s :: _ => s.ext
      | [] => []
    let ext := match rgOuter pm nd e.fs [] with
      | f :: _ => f
      | [] => { o := e.pos, cl := e.pos, kind := 0, ie := 0 }
    { r with cur := { cur with rs := { s := rgMin pm ext.o, e := rgMax e.pos ext.cl } :: (jx ++ cur.rs) }, ss := ss2 }

def rgQRev : List RgQ → List RgQ → List RgQ
  | [], acc => acc
  | x :: xs, acc => rgQRev xs (x :: acc)

structure RgQSp where
  l : List RgQ
  r : List RgQ

def rgQTake : Nat → List RgQ → List RgQ → RgQSp
  | 0, xs, acc => { l := rgQRev acc [], r := xs }
  | _, [], acc => { l := rgQRev acc [], r := [] }
  | k + 1, x :: xs, acc => rgQTake k xs (x :: acc)

def rgQMerge : Nat → List RgQ → List RgQ → List RgQ → List RgQ
  | 0, xs, ys, acc => rgQRev acc (xs ++ ys)
  | _, [], ys, acc => rgQRev acc ys
  | _, xs, [], acc => rgQRev acc xs
  | k + 1, x :: xs, y :: ys, acc =>
    if x.s ≤ y.s then rgQMerge k xs (y :: ys) (x :: acc) else rgQMerge k (x :: xs) ys (y :: acc)

def rgQSortGo : Nat → Nat → List RgQ → List RgQ
  | 0, _, xs => xs
  | f + 1, n, xs =>
    if n ≤ 1 then xs
    else
      let h := n / 2
      let sp := rgQTake h xs []
      rgQMerge (n + 1) (rgQSortGo f h sp.l) (rgQSortGo f (n - h) sp.r) []

-- Sorted ranges to disjoint ones (touching ranges join).
def rgQJoin : List RgQ → RgQ → List RgQ → List RgQ
  | [], c, acc => rgQRev (c :: acc) []
  | r :: rs, c, acc => if r.s ≤ c.e + 1 then rgQJoin rs { s := c.s, e := rgMax c.e r.e } acc else rgQJoin rs r (c :: acc)

def rgQNorm (rs : List RgQ) : List RgQ :=
  match rgQSortGo (rs.length + 1) rs.length rs with
  | [] => []
  | r :: rest => rgQJoin rest r []

def rgIvDone (r : RgS) : RgR :=
  let rs := rgQNorm r.cur.rs
  let lo := match rs with
    | q :: _ => q.s
    | [] => 0
  { r.cur with lo := lo, rs := rs, fs := [] }

def rgIv0 (e : RgR) : RgS :=
  rgIvStep e { cur := { rgR0 with loc := e.loc }, ss := [], pend := [] }

def rgIvsGo : List RgR → RgS → List RgR → List RgR
  | [], r, acc => rgRev (rgIvDone r :: acc) []
  | e :: es, r, acc =>
    if e.loc != r.cur.loc then rgIvsGo es (rgIv0 e) (rgIvDone r :: acc)
    else rgIvsGo es (rgIvStep e r) acc

def rgIvs : List RgR → List RgR
  | [] => []
  | e :: es => rgIvsGo es (rgIv0 e) []

-- Each interval's type from the declaration (locals from index np), in cl.
def rgTyped : Nat → List Int → List RgR → List RgR → Option (List RgR)
  | _, _, [], acc => some (rgRev acc [])
  | _, [], _ :: _, _ => none
  | i, t :: ts, iv :: ivs, acc =>
    if iv.loc < i then none
    else if iv.loc == i then rgTyped (i + 1) ts ivs ({ iv with cl := t.toNat } :: acc)
    else rgTyped (i + 1) ts (iv :: ivs) acc

-- Two sorted disjoint range lists meet.
def rgQHit : Nat → List RgQ → List RgQ → Bool
  | 0, _, _ => true
  | _, [], _ => false
  | _, _, [] => false
  | k + 1, a :: as, b :: bs =>
    if a.e < b.s then rgQHit k as (b :: bs)
    else if b.e < a.s then rgQHit k (a :: as) bs
    else true

-- A slot's ranges that end before x: no later interval can meet them.
def rgQFrom (x : Nat) : List RgQ → List RgQ
  | [] => []
  | r :: rs => if r.e < x then rgQFrom x rs else r :: rs

def rgSlRev : List (List RgQ) → List (List RgQ) → List (List RgQ)
  | [], acc => acc
  | x :: xs, acc => rgSlRev xs (x :: acc)

structure RgFt where
  slot : Nat
  sl : List (List RgQ)

-- The lowest slot none of whose ranges meets rs (linear scan with
-- lifetime holes, no splitting), or a new slot.
def rgFit (rs : List RgQ) (lo : Nat) : Nat → List (List RgQ) → List (List RgQ) → RgFt
  | i, [], acc => { slot := i, sl := rgSlRev acc [rs] }
  | i, s :: ss, acc =>
    let s2 := rgQFrom lo s
    if rgQHit (rs.length + s2.length + 1) rs s2 then rgFit rs lo (i + 1) ss (s2 :: acc)
    else { slot := i, sl := rgSlRev acc (rgQMerge (rs.length + s2.length + 1) s2 rs [] :: ss) }

structure RgA where
  out : List RgR
  n : Nat

-- Intervals sorted by start; each takes the lowest slot it fits.
def rgScan : List RgR → List (List RgQ) → List RgR → RgA
  | [], sl, out => { out := out, n := sl.length }
  | iv :: ivs, sl, out =>
    let f := rgFit iv.rs iv.lo 0 sl []
    rgScan ivs f.sl ({ rgR0 with k := iv.loc, pos := f.slot } :: out)

def rgOfTy (t : Nat) : List RgR → List RgR → List RgR
  | [], acc => rgRev acc []
  | iv :: ivs, acc => rgOfTy t ivs (if iv.cl == t then iv :: acc else acc)

def rgByStart (m : Nat) : List RgR → List RgR → List RgR
  | [], acc => rgRev acc []
  | iv :: ivs, acc => rgByStart m ivs ({ iv with k := iv.lo * m + iv.loc } :: acc)

def rgShift (b : Nat) : List RgR → List RgR → List RgR
  | [], acc => rgRev acc []
  | r :: rs, acc => rgShift b rs ({ r with pos := r.pos + b } :: acc)

def rgAllTy : List RgR → Bool
  | [] => true
  | iv :: ivs => (iv.cl == vtI64.toNat || iv.cl == vtI32.toNat) && rgAllTy ivs

def rgRep (t : Int) : Nat → List Int
  | 0 => []
  | k + 1 => t :: rgRep t k

-- Events (by local) and the map (by local) to (pos, new index), by position.
def rgQueue : List RgR → List RgR → List RgR → Option (List RgR)
  | [], _, acc => some acc
  | _ :: _, [], _ => none
  | e :: es, m :: ms, acc =>
    if m.k < e.loc then rgQueue (e :: es) ms acc
    else if m.k > e.loc then none
    else rgQueue es (m :: ms) ({ rgR0 with k := e.pos, pos := m.pos } :: acc)

def rgCat : List (List Int) → List Int → List Int
  | [], acc => acc
  | c :: cs, acc => rgCat cs (c ++ acc)

def rgRewrite : Nat → Nat → Nat → List RgR → List (List Int) → List Int → Option (List Int)
  | 0, _, _, _, _, _ => none
  | _, _, _, _, acc, [] => some (rgCat acc [])
  | k + 1, np, pos, q, acc, bs =>
    let i := rgStep bs
    if !i.ok then none
    else if (i.op == 32 || i.op == 33 || i.op == 34) && i.n ≥ np then
      match q with
      | h :: q2 => if h.k != pos then none else rgRewrite k np (pos + 1) q2 ((i.op :: lebU h.pos) :: acc) i.rest
      | [] => none
    else rgRewrite k np (pos + 1) q (i.bs :: acc) i.rest

def rgDrop (np : Nat) : List RgR → List RgR → List RgR
  | [], acc => rgRev acc []
  | e :: es, acc => rgDrop np es (if e.loc < np then acc else e :: acc)

-- Slice-free Wasm instruction metadata decoder and Int-scalar local coalescer
-- for `rgFnO` (preserving all existing `RgF .. rgDrop` definitions and types above
-- for external callers such as `rsc/NativeCompile.lean`).
structure RgM where
  ok : Bool
  op : Int
  n : Int
  span : Nat
  rest : List Int

def rgMFail : RgM := { ok := false, op := 0, n := 0, span := 0, rest := [] }

def rgMLebGo (orig : List Int) : Nat → Int → Int → Nat → List Int → RgM
  | 0, _, _, _, _ => rgMFail
  | _, _, _, _, [] => rgMFail
  | k + 1, v, place, sp, b :: bs =>
    if place > 562949953421312 then
      let fb := rgLeb orig
      if !fb.ok then rgMFail else { ok := true, op := 0, n := (fb.n : Int), span := 1 + fb.bs.length, rest := fb.rest }
    else
      let low : Int := if b ≥ 128 then b - 128 else b
      let v2 := v + (if low < 0 then 0 else low) * place
      if b < 128 then { ok := true, op := 0, n := v2, span := sp + 1, rest := bs }
      else rgMLebGo orig k v2 (place * 128) (sp + 1) bs

def rgSkipLebs : Nat → Nat → Nat → List Int → RgM
  | 0, _, sp, bs => { ok := true, op := 0, n := 0, span := sp, rest := bs }
  | _ + 1, 0, _, _ => rgMFail
  | _ + 1, _, _, [] => rgMFail
  | m + 1, k + 1, sp, b :: bs =>
    if b < 128 then rgSkipLebs m profile.lebSFuel (sp + 1) bs
    else rgSkipLebs (m + 1) k (sp + 1) bs

def rgStepMeta : List Int → RgM
  | [] => rgMFail
  | b :: r =>
    if b == 65 || b == 66 then
      let l := rgSkipLebs 1 profile.lebSFuel 1 r
      if !l.ok then rgMFail else { l with op := b }
    else if b == 32 || b == 33 || b == 34 || b == 12 || b == 13 || b == 16 || b == 18 || b == 8 then
      let l : RgM := match r with
        | b0 :: rest0 => if b0 < 128 then { ok := true, op := b, n := (if b0 < 0 then 0 else b0), span := 2, rest := rest0 }
                         else rgMLebGo r profile.lebSFuel 0 1 1 r
        | [] => rgMFail
      if !l.ok then rgMFail else { l with op := b }
    else if b == 2 || b == 3 || b == 4 then
      match r with
      | t :: r2 => if t == 64 || (t ≥ 123 && t ≤ 127) then { ok := true, op := b, n := 0, span := 2, rest := r2 } else rgMFail
      | [] => rgMFail
    else if b ≥ 40 && b ≤ 62 then
      let l := rgSkipLebs 2 profile.lebSFuel 1 r
      if !l.ok then rgMFail else { l with op := b }
    else if b == 63 || b == 64 then
      match r with
      | 0 :: r2 => { ok := true, op := b, n := 0, span := 2, rest := r2 }
      | _ => rgMFail
    else if b == 14 then
      let c : RgM := match r with
        | b0 :: rest0 => if b0 < 128 then { ok := true, op := 0, n := (if b0 < 0 then 0 else b0), span := 2, rest := rest0 }
                         else rgMLebGo r profile.lebSFuel 0 1 1 r
        | [] => rgMFail
      if !c.ok then rgMFail
      else
        let l := rgSkipLebs (c.n.toNat + 1) profile.lebSFuel c.span c.rest
        if !l.ok then rgMFail else { l with op := b }
    else if b == 252 then
      match r with
      | 10 :: 0 :: 0 :: r2 => { ok := true, op := b, n := 0, span := 4, rest := r2 }
      | 11 :: 0 :: r2 => { ok := true, op := b, n := 0, span := 3, rest := r2 }
      | _ => rgMFail
    else if b == 0 || b == 1 || b == 5 || b == 11 || b == 15 || b == 26 || b == 27 || (b ≥ 69 && b ≤ 196) then
      { ok := true, op := b, n := 0, span := 1, rest := r }
    else rgMFail

def rgValidNoLocals : Nat → Int → List Bool → List Int → Bool
  | 0, _, _, _ => false
  | k + 1, np, st, bs =>
    let i := rgStepMeta bs
    if !i.ok then false
    else if i.op == 2 || i.op == 3 || i.op == 4 then rgValidNoLocals k np (false :: st) i.rest
    else if i.op == 5 then
      match st with
      | false :: st2 => rgValidNoLocals k np (true :: st2) i.rest
      | _ => false
    else if i.op == 11 then
      match st with
      | [] => i.rest.isEmpty
      | _ :: st2 => rgValidNoLocals k np st2 i.rest
    else if (i.op == 32 || i.op == 33 || i.op == 34) && i.n ≥ np then false
    else rgValidNoLocals k np st i.rest

structure RgFI where
  o : Int
  cl : Int
  kind : Int
  ie : Int

structure RgQI where
  s : Int
  e : Int

structure RgRI where
  k : Int
  loc : Int
  pos : Int
  get : Bool
  cl : Int
  lo : Int
  hi : Int
  fs : List RgFI
  rs : List RgQI

def rgR0I : RgRI := { k := 0, loc := 0, pos := 0, get := false, cl := 0, lo := 0, hi := 0, fs := [], rs := [] }

def rgRevI : List RgRI → List RgRI → List RgRI
  | [], acc => acc
  | x :: xs, acc => rgRevI xs (x :: acc)

structure RgSpI where
  l : List RgRI
  r : List RgRI

def rgTakeI : Nat → List RgRI → List RgRI → RgSpI
  | 0, xs, acc => { l := rgRevI acc [], r := xs }
  | _, [], acc => { l := rgRevI acc [], r := [] }
  | k + 1, x :: xs, acc => rgTakeI k xs (x :: acc)

def rgMergeI : Nat → List RgRI → List RgRI → List RgRI → List RgRI
  | 0, xs, ys, acc => rgRevI acc (xs ++ ys)
  | _, [], ys, acc => rgRevI acc ys
  | _, xs, [], acc => rgRevI acc xs
  | k + 1, x :: xs, y :: ys, acc =>
    if x.k ≤ y.k then rgMergeI k xs (y :: ys) (x :: acc) else rgMergeI k (x :: xs) ys (y :: acc)

def rgSortGoI : Nat → Nat → List RgRI → List RgRI
  | 0, _, xs => xs
  | f + 1, n, xs =>
    if n ≤ 1 then xs
    else
      let h := n / 2
      let sp := rgTakeI h xs []
      rgMergeI (n + 1) (rgSortGoI f h sp.l) (rgSortGoI f (n - h) sp.r) []

def rgSortI (xs : List RgRI) : List RgRI :=
  rgSortGoI (xs.length + 1) xs.length xs

structure RgOI where
  o : Int
  t : Int

def rgClosesGoI : Nat → Int → List RgOI → List RgRI → List Int → Option (List RgRI)
  | 0, _, _, _, _ => none
  | k + 1, pos, st, acc, bs =>
    let i := rgStepMeta bs
    if !i.ok then none
    else if i.op == 2 || i.op == 3 || i.op == 4 then rgClosesGoI k (pos + 1) ({ o := pos, t := 0 } :: st) acc i.rest
    else if i.op == 5 then
      match st with
      | e :: st2 => rgClosesGoI k (pos + 1) ({ o := pos, t := e.o } :: st2) acc i.rest
      | [] => none
    else if i.op == 11 then
      match st with
      | [] => if i.rest.isEmpty then some acc else none
      | e :: st2 =>
        let acc2 := if e.t > 0 then { rgR0I with k := e.t, cl := e.o, get := true, hi := pos } :: acc else acc
        rgClosesGoI k (pos + 1) st2 ({ rgR0I with k := e.o, cl := pos } :: acc2) i.rest
    else rgClosesGoI k (pos + 1) st acc i.rest

def rgEvsGoI : Nat → Int → List RgFI → List RgRI → List RgRI → List Int → Option (List RgRI)
  | 0, _, _, _, _, _ => none
  | k + 1, pos, st, q, acc, bs =>
    match st with
    | [] => none
    | top :: below =>
      let i := rgStepMeta bs
      if !i.ok then none
      else if i.op == 2 || i.op == 3 || i.op == 4 then
        match q with
        | h :: q2 =>
          if h.k != pos then none
          else
            let kind : Int := if i.op == 3 then 1 else if i.op == 4 && h.get then 2 else 0
            rgEvsGoI k (pos + 1) ({ o := pos, cl := h.cl, kind := kind, ie := h.hi } :: st) q2 acc i.rest
        | [] => none
      else if i.op == 5 then
        match q with
        | h :: q2 =>
          if h.k != pos then none else rgEvsGoI k (pos + 1) ({ o := pos, cl := h.cl, kind := 3, ie := h.cl } :: below) q2 acc i.rest
        | [] => none
      else if i.op == 11 then
        match below with
        | [] => some (rgRevI acc [])
        | _ => rgEvsGoI k (pos + 1) below q acc i.rest
      else if i.op == 32 || i.op == 33 || i.op == 34 then
        let ev := { rgR0I with k := i.n, loc := i.n, pos := pos, get := i.op == 32, cl := top.cl, fs := st }
        rgEvsGoI k (pos + 1) st q (ev :: acc) i.rest
      else rgEvsGoI k (pos + 1) st q acc i.rest

structure RgDI where
  o : Int
  c : Int
  fs : List RgFI
  ext : List RgQI

def rgLiveI (x : Int) : List RgDI → List RgDI
  | [] => []
  | s :: ss => if s.c ≤ x then rgLiveI x ss else s :: ss

def rgPendI (ie : Int) : List RgDI → Option RgDI
  | [] => none
  | d :: ds =>
    match d.fs with
    | f :: _ => if f.ie == ie then some d else rgPendI ie ds
    | [] => rgPendI ie ds

structure RgPI where
  ss : List RgDI
  pend : List RgDI

def rgPushI : Nat → RgDI → List RgDI → List RgDI → RgPI
  | 0, d, ss, pend => { ss := d :: ss, pend := pend }
  | k + 1, d, ss, pend =>
    match d.fs with
    | f :: up =>
      if f.kind == 2 then { ss := d :: ss, pend := d :: pend }
      else if f.kind == 3 then
        match rgPendI f.ie pend, up with
        | some d1, g :: _ =>
          let j : RgDI := { o := f.ie, c := g.cl, fs := up, ext := { s := d1.o, e := d1.c } :: { s := d.o, e := d.c } :: (d1.ext ++ d.ext) }
          let r := rgPushI k j ss pend
          { r with ss := d :: r.ss }
        | _, _ => { ss := d :: ss, pend := pend }
      else { ss := d :: ss, pend := pend }
    | [] => { ss := d :: ss, pend := pend }

def rgOuterI (pm : Int) (any : Bool) : List RgFI → List RgFI → List RgFI
  | [], best => best
  | f :: fs, best =>
    if f.kind != 1 then rgOuterI pm any fs best
    else if any || f.o > pm then rgOuterI pm any fs [f]
    else best

structure RgSI where
  cur : RgRI
  ss : List RgDI
  pend : List RgDI

def rgIvStepI (e : RgRI) (r : RgSI) : RgSI :=
  let cur := r.cur
  let ss2 := rgLiveI e.pos r.ss
  if !e.get then
    let p := rgPushI e.fs.length { o := e.pos, c := e.cl, fs := e.fs, ext := [] } ss2 r.pend
    { r with cur := { cur with rs := { s := e.pos, e := e.pos } :: cur.rs }, ss := p.ss, pend := p.pend }
  else
    let nd := match ss2 with
      | [] => true
      | _ => false
    let pm : Int := match ss2 with
      | s :: _ => s.o
      | [] => 0
    let jx := match ss2 with
      | s :: _ => s.ext
      | [] => []
    let ext := match rgOuterI pm nd e.fs [] with
      | f :: _ => f
      | [] => { o := e.pos, cl := e.pos, kind := 0, ie := 0 }
    let sMin := if pm < ext.o then pm else ext.o
    let eMax := if e.pos < ext.cl then ext.cl else e.pos
    { r with cur := { cur with rs := { s := sMin, e := eMax } :: (jx ++ cur.rs) }, ss := ss2 }

def rgQRevI : List RgQI → List RgQI → List RgQI
  | [], acc => acc
  | x :: xs, acc => rgQRevI xs (x :: acc)

structure RgQSpI where
  l : List RgQI
  r : List RgQI

def rgQTakeI : Nat → List RgQI → List RgQI → RgQSpI
  | 0, xs, acc => { l := rgQRevI acc [], r := xs }
  | _, [], acc => { l := rgQRevI acc [], r := [] }
  | k + 1, x :: xs, acc => rgQTakeI k xs (x :: acc)

partial def rgQMergeI : List RgQI → List RgQI → List RgQI → List RgQI
  | [], ys, acc => rgQRevI acc ys
  | xs, [], acc => rgQRevI acc xs
  | x :: xs, y :: ys, acc =>
    if x.s ≤ y.s then rgQMergeI xs (y :: ys) (x :: acc) else rgQMergeI (x :: xs) ys (y :: acc)

def rgQSortGoI : Nat → Nat → List RgQI → List RgQI
  | 0, _, xs => xs
  | f + 1, n, xs =>
    if n ≤ 1 then xs
    else
      let h := n / 2
      let sp := rgQTakeI h xs []
      rgQMergeI (rgQSortGoI f h sp.l) (rgQSortGoI f (n - h) sp.r) []

def rgQJoinI : List RgQI → RgQI → List RgQI → List RgQI
  | [], c, acc => rgQRevI (c :: acc) []
  | r :: rs, c, acc =>
    if r.s ≤ c.e + 1 then rgQJoinI rs { s := c.s, e := (if c.e < r.e then r.e else c.e) } acc
    else rgQJoinI rs r (c :: acc)

def rgIvDoneI (r : RgSI) : RgRI :=
  let rs := match rgQSortGoI (r.cur.rs.length + 1) r.cur.rs.length r.cur.rs with
    | [] => []
    | q :: rest => rgQJoinI rest q []
  let lo : Int := match rs with
    | q :: _ => q.s
    | [] => 0
  { r.cur with lo := lo, rs := rs, fs := [] }

def rgIv0I (e : RgRI) : RgSI :=
  rgIvStepI e { cur := { rgR0I with loc := e.loc }, ss := [], pend := [] }

def rgIvsGoI : List RgRI → RgSI → List RgRI → List RgRI
  | [], r, acc => rgRevI (rgIvDoneI r :: acc) []
  | e :: es, r, acc =>
    if e.loc != r.cur.loc then rgIvsGoI es (rgIv0I e) (rgIvDoneI r :: acc)
    else rgIvsGoI es (rgIvStepI e r) acc

def rgTypedI : Int → List Int → List RgRI → List RgRI → Option (List RgRI)
  | _, _, [], acc => some (rgRevI acc [])
  | _, [], _ :: _, _ => none
  | i, t :: ts, iv :: ivs, acc =>
    if iv.loc < i then none
    else if iv.loc == i then
      if t != vtI64 && t != vtI32 then none
      else rgTypedI (i + 1) ts ivs ({ iv with cl := t } :: acc)
    else rgTypedI (i + 1) ts (iv :: ivs) acc

def rgNoHitI : RgQI := { s := -1, e := -1 }

partial def rgQHitWI (dflt : RgQI) : List RgQI → List RgQI → RgQI
  | [], _ => dflt
  | _, [] => dflt
  | a :: as, b :: bs =>
    if a.e < b.s then rgQHitWI dflt as (b :: bs)
    else if b.e < a.s then rgQHitWI dflt (a :: as) bs
    else b

partial def rgWitBlocksI (w : RgQI) : List RgQI → Bool
  | [] => false
  | a :: as => if a.e < w.s then rgWitBlocksI w as else a.s ≤ w.e

def rgQLastI : List RgQI → RgQI
  | [] => { s := 0, e := 0 }
  | r :: [] => r
  | _ :: rs => rgQLastI rs

def rgQFromI (x : Int) : List RgQI → List RgQI
  | [] => []
  | r :: rs => if r.e < x then rgQFromI x rs else r :: rs

def rgSlRevI : List (List RgQI) → List (List RgQI) → List (List RgQI)
  | [], acc => acc
  | x :: xs, acc => rgSlRevI xs (x :: acc)

structure RgFtI where
  slot : Int
  sl : List (List RgQI)
  wl : List RgQI

def rgFitI (rs : List RgQI) (lo : Int) : Int → List (List RgQI) → List RgQI → List (List RgQI) → List RgQI → RgFtI
  | i, [], _, acc, wacc => { slot := i, sl := rgSlRevI acc [rs], wl := rgQRevI wacc [rgQLastI rs] }
  | i, s :: ss, w :: ws, acc, wacc =>
    let s2 := rgQFromI lo s
    if w.e ≥ lo && rgWitBlocksI w rs then rgFitI rs lo (i + 1) ss ws (s2 :: acc) (w :: wacc)
    else
      let w3 := rgQHitWI rgNoHitI rs s2
      if w3.e ≥ 0 then rgFitI rs lo (i + 1) ss ws (s2 :: acc) (w3 :: wacc)
      else
        let m := rgQMergeI s2 rs []
        { slot := i, sl := rgSlRevI acc (m :: ss), wl := rgQRevI wacc (rgQLastI m :: ws) }
  | _, _, _, _, _ => { slot := 0, sl := [], wl := [] }

structure RgAI where
  out : List RgRI
  n : Nat

def rgScanI : List RgRI → List (List RgQI) → List RgQI → List RgRI → RgAI
  | [], sl, _, out => { out := out, n := sl.length }
  | iv :: ivs, sl, wl, out =>
    let f := rgFitI iv.rs iv.lo 0 sl wl [] []
    rgScanI ivs f.sl f.wl ({ rgR0I with k := iv.loc, pos := f.slot } :: out)

def rgOfTyI (t : Int) : List RgRI → List RgRI → List RgRI
  | [], acc => rgRevI acc []
  | iv :: ivs, acc => rgOfTyI t ivs (if iv.cl == t then iv :: acc else acc)

def rgByStartI (m : Int) : List RgRI → List RgRI → List RgRI
  | [], acc => rgRevI acc []
  | iv :: ivs, acc => rgByStartI m ivs ({ iv with k := iv.lo * m + iv.loc } :: acc)

def rgShiftI (b : Int) : List RgRI → List RgRI → List RgRI
  | [], acc => rgRevI acc []
  | r :: rs, acc => rgShiftI b rs ({ r with pos := r.pos + b } :: acc)

def rgQueueI : List RgRI → List RgRI → List RgRI → Option (List RgRI)
  | [], _, acc => some acc
  | _ :: _, [], _ => none
  | e :: es, m :: ms, acc =>
    if m.k < e.loc then rgQueueI (e :: es) ms acc
    else if m.k > e.loc then none
    else rgQueueI es (m :: ms) ({ rgR0I with k := e.pos, pos := m.pos } :: acc)

def rgSameMapI : List RgRI → Bool
  | [] => true
  | r :: rs => r.k == r.pos && rgSameMapI rs

def rgPushSpan : Nat → List Int → List Int → List Int
  | 0, _, acc => acc
  | k + 1, b :: bs, acc => rgPushSpan k bs (b :: acc)
  | _, [], acc => acc

def rgRewriteI : Nat → Int → Int → List RgRI → List Int → List Int → Option (List Int)
  | 0, _, _, _, _, _ => none
  | _, _, _, _, accRev, [] => some (reverse accRev)
  | k + 1, np, pos, q, accRev, bs =>
    let i := rgStepMeta bs
    if !i.ok then none
    else if (i.op == 32 || i.op == 33 || i.op == 34) && i.n ≥ np then
      match q with
      | h :: q2 =>
        if h.k != pos then none
        else
          let nw := h.pos.toNat
          let acc2 := if nw < 128 then (nw : Int) :: i.op :: accRev else pushBytes (lebU nw) (i.op :: accRev)
          rgRewriteI k np (pos + 1) q2 acc2 i.rest
      | [] => none
    else rgRewriteI k np (pos + 1) q (rgPushSpan i.span bs accRev) i.rest

def rgDropI (np : Int) : List RgRI → List RgRI → List RgRI
  | [], acc => rgRevI acc []
  | e :: es, acc => rgDropI np es (if e.loc < np then acc else e :: acc)

def rgFnO (f : WFn) : Option WFn :=
  let np : Int := (f.params.length : Int)
  let fuel := f.code.length + 1
  if f.locals.isEmpty then
    if rgValidNoLocals fuel np [] f.code then some f else none
  else
  match rgClosesGoI fuel 1 [] [] f.code with
  | none => none
  | some cs =>
    let inf : Int := (fuel + 1 : Nat)
    match rgEvsGoI fuel 1 [{ o := 0, cl := inf, kind := 0, ie := 0 }] (rgSortI cs) [] f.code with
    | none => none
    | some evs0 =>
      let evs := rgSortI (rgDropI np evs0 [])
      let ivs0 := match evs with
        | [] => []
        | e :: es => rgIvsGoI es (rgIv0I e) []
      match rgTypedI np f.locals ivs0 [] with
      | none => none
      | some ivs =>
        let m : Int := ((f.params.length + f.locals.length + 1 : Nat) : Int)
        let a := rgScanI (rgSortI (rgByStartI m (rgOfTyI vtI64 ivs []) [])) [] [] []
        let b := rgScanI (rgSortI (rgByStartI m (rgOfTyI vtI32 ivs []) [])) [] [] []
        let mp := rgSortI (rgShiftI np a.out [] ++ rgShiftI (np + (a.n : Int)) b.out [])
        let newLocs := rgRep vtI64 a.n ++ rgRep vtI32 b.n
        if rgSameMapI mp then
          some { f with locals := newLocs, code := f.code }
        else
          match rgQueueI evs mp [] with
          | none => none
          | some q0 =>
            match rgRewriteI fuel np 1 (rgSortI q0) [] f.code with
            | none => none
            | some code => some { f with locals := newLocs, code := code }

def rgFn (f : WFn) : WFn :=
  match rgFnO f with
  | some g => g
  | none => f

def rgFns : List WFn → List WFn
  | [] => []
  | f :: fs => rgFn f :: rgFns fs

-- The v2 node table: `K` nodes, each decoded once, children before parents.
structure Dd where
  ok : Int
  g : Dg
  rest : List Int

def ddFail (c : Int) : Dd := { ok := c, g := dgNone, rest := [] }

def dgRead (lay : Layers) (g : Dg) : Nat → List Int → Dd
  | 0, rest => { ok := profile.cOk, g := g, rest := rest }
  | k + 1, rest =>
    match rest with
    | [] => ddFail profile.cTrunc
    | kd :: bs =>
      let n := readLeb bs
      if n.ok != profile.cOk then ddFail n.ok
      else if n.n < 0 then ddFail profile.cBody
      else
        let b := takeBytes n.n.toNat n.n [] n.rest
        if b.ok != profile.cOk then ddFail b.ok
        else if kd == 0 then
          let t := tyNode g b.bs
          if t.ok != profile.cOk then ddFail t.ok
          else
            match t.rest with
            | [] => dgRead lay (dgPushType g t.need (reverse t.acc)) k b.rest
            | _ => ddFail profile.cTrail
        else if kd == 1 then
          let e := skipEWith g (lrcOn lay) profile.v2Fuel 0 0 b.bs
          if e.ok != profile.cOk then ddFail e.ok
          else
            match e.rest with
            | [] => dgRead lay (dgPush (if lay.facts && !lrcOn lay then tfRemember g b.bs else g) (1 :: e.n :: b.bs)) k b.rest
            | _ => ddFail profile.cTrail
        else if kd == 2 then
          dgRead lay (dgPush (if lay.facts && !lrcOn lay then tfAnnotation g b.bs else g) [2]) k b.rest
        else ddFail profile.cBody

-- Validate v2 references and catch the first W tag in present lowering, even in a dead arm.
def chkBodies (g : Dg) (word64 : Bool) : Nat → List Int → Rd
  | 0, rest => rdOk 0 rest
  | k + 1, rest =>
    match rest with
    | 1 :: bs =>
      let e := skipEWith g word64 profile.v2Fuel 0 0 bs
      if e.ok != profile.cOk then e else chkBodies g word64 k e.rest
    | _ => rdFail profile.cBody rest


-- Group functions share flat parameter locals and the fixed result area.
-- A group containing an indirect signature stays as individual loop functions.
def abiDirectGroup (g : Dg) (lay : Layers) (arr sigs : List (List Int)) : List Int → Bool
  | [] => true
  | f :: fs => !abiWideSignature g lay arr (sigOf sigs f.toNat) && abiDirectGroup g lay arr sigs fs

-- DERIV-HANG: the typed emitter emits one IR call node per textual
-- application, so `d "x" x` written twice lowers to two evaluations where
-- stock Lean binds the application once (func[44] carries two `call 42`
-- sites for func[42]).  The repair is the value-numbering CSE below
-- (`cseBodies`), which binds every repeated pure expression once in its
-- dominating scope.
def nodeBody (e : List Int) : List Int :=
  match e with | 1 :: _ :: bs => bs | _ => []

structure LetParts where
  ok : Bool := false
  bound : List Int := []
  body : List Int := []

def letParts (g : Dg) (bs : List Int) : LetParts :=
  match bs with
  | 4 :: bs =>
    let t := (readTyD g) bs
    if t.ok != profile.cOk then {}
    else
      let e := skipE g profile.v2Fuel t.rest
      if e.ok != profile.cOk then {}
      else { ok := true
           , bound := (takeBytes (t.rest.length - e.rest.length) 0 [] t.rest).bs
           , body := e.rest }
  | _ => {}

-- `1 <leb-len> <name>` field prefix inside a canonical record ty, then a tyD.
def fieldAcc (g : Dg) (bs : List Int) : Ty :=
  match bs with
  | 1 :: nb =>
    let nm := readLeb nb
    if nm.ok != profile.cOk || nm.n < 0 then tyFail profile.cType bs
    else
      let sk := skipBytes nm.n.toNat nm.rest
      if sk.ok != profile.cOk then tyFail sk.ok sk.rest else (readTyD g) sk.rest
  | _ => tyFail profile.cType bs

-- ---------------------------------------------------------------------
-- DERIV-HANG exit 2: common-subexpression elimination of pure
-- expressions by dominator-scoped value numbering (Click 1995, "Global
-- code motion / global value numbering": a scoped hash table walked down
-- the dominator tree; here the dominator tree is the lexical nesting of
-- the expression tree, so the scoped table is the lexical scope).
--
-- Numbering.  Every expression of a function body gets a value number
-- from (operator, payload, numbers of its operands).  A de Bruijn
-- variable takes the number of its binder: a let binder carries its
-- bound expression's number, a parameter or pattern binder is opaque,
-- keyed by its scope depth.  A `53` reference is the referenced node's
-- expression read at the reference's scope.  An operand of a call whose
-- parameter type is the storage arena list (the threaded token) does not
-- enter the call's number, for every callee.
--
-- Blocks.  A block is a let chain (bound expressions and tail) that is
-- evaluated unconditionally once its head is reached.  `if` arms, `match`
-- branches and the bodies of `boundedFold`/`boundedFix` open sub-blocks.
-- Availability is dominance: a binder of an enclosing block is available
-- in every sub-block; a binder of a sub-block is not available outside.
--
-- Rewrite.  An expression whose number is available is replaced by the
-- binder that holds it.  An expression in a block whose number recurs
-- later in the block's region (the block and everything nested in it)
-- is bound by a fresh `let` placed before the statement that contains
-- it, and every later occurrence in the region reads that binder.
-- Nothing moves out of a sub-block: an expression computed in two arms
-- stays in both unless a dominating binder already holds it.
-- ---------------------------------------------------------------------

-- A parsed expression: the wire tag, its payload bytes (type, index,
-- name or literal, as on the wire), its children in wire order, the
-- binder ids it introduces (`bids`; for a variable, the binder it reads),
-- its value number, its post-order index, `src` = the node index when the
-- subtree is a `53` reference as parsed (-1 otherwise), `mf` = its
-- largest free de Bruijn index relative to its root (-1 when closed).
structure Ex where
  tag : Int
  ty : List Int := []
  pay : List Int
  kids : List Ex
  bids : List Int
  vn : Int
  seq : Int
  src : Int
  mf : Int
  deriving Inhabited

def exNil : Ex := { tag := -1, pay := [], kids := [], bids := [], vn := -1, seq := 0, src := -1, mf := -1 }

-- Parse state: next binder id, next post-order index, the value table
-- (open addressing on a 48-bit hash; `extra` holds the exact key), the
-- next value number, the occurrence lists (number -> post-order indexes,
-- latest first), and the results of the last step.
structure CS where
  ok : Bool := true
  nb : Int := 0
  seq : Int := 0
  vt : Map := map0 0
  nv : Int := 0
  occ : Map := map0 0
  cur : Int := -1
  e : Ex := exNil
  es : List Ex := []
  bl : List Int := []
  sc : List (List Int) := []
  rest : List Int := []

def csFail (st : CS) : CS := { st with ok := false }

def vnHashGo : List Int → Int → Int
  | [], h => h
  | x :: xs, h => vnHashGo xs ((h * 33 + x + 7) % 281474976710656)

-- the number of `key`: the recorded one on an exact match, else the next
-- number; linear probing from the hash slot
def vnIntern (st : CS) (key : List Int) : Nat → Int → CS
  | 0, _ => csFail st
  | f + 1, h =>
    let r := get st.vt h
    if r.v < 0 then { st with vt := (ins st.vt h st.nv 0 0 key).m, nv := st.nv + 1, cur := st.nv }
    else if eqW r.xs key then { st with cur := r.v }
    else vnIntern st key f (h + 1)

def vnKey (st : CS) (key : List Int) : CS := vnIntern st key (st.nv + 1).toNat (vnHashGo key 17)

def occAdd (st : CS) (v s : Int) : CS :=
  { st with occ := (ins st.occ v 0 0 0 (s :: (get st.occ v).xs)).m }

-- an occurrence after index `s` and inside the region ending at `exit`
-- (`xs` is latest first)
def occLater : List Int → Int → Int → Bool
  | [], _, _ => false
  | x :: xs, s, exit => if x > exit then occLater xs s exit else x > s

def scNth : Nat → List (List Int) → List Int
  | _, [] => []
  | 0, x :: _ => x
  | k + 1, _ :: xs => scNth k xs

def scBid (en : List Int) : Int := match en with | b :: _ => b | _ => -1
def scVn (en : List Int) : Int := match en with | _ :: v :: _ => v | _ => -1

def imaxI (a b : Int) : Int := if a > b then a else b

-- largest free index over `ks`, each read under `n` more binders
def mfUnder : List Ex → Int → Int → Int
  | [], _, m => m
  | k :: ks, n, m => mfUnder ks n (imaxI m (imaxI (-1) (k.mf - n)))

def vnsOf : List Ex → List Int
  | [] => []
  | k :: ks => k.vn :: vnsOf ks

def exKid : List Ex → Nat → Ex
  | [], _ => exNil
  | k :: _, 0 => k
  | _ :: ks, i + 1 => exKid ks i

def kidsTail : List Ex → List Ex
  | [] => []
  | _ :: ks => ks

-- an opaque binder at scope depth `d`: its number in `cur`
def opaqueVn (st : CS) (d : Nat) : CS := vnKey st [62, (d : Int)]

-- the operand numbers of a call, skipping every operand whose parameter
-- type is the storage arena list (the threaded token); `tys` is the
-- callee's parameter type run
def callVns (g : Dg) (tys : List Int) : List Ex → List Int
  | [] => []
  | k :: ks =>
    let t := readTyD g tys
    if t.ok == profile.cOk then
      (if isNodeArenaList g t.acc then [] else [k.vn]) ++ callVns g t.rest ks
    else k.vn :: callVns g [] ks

-- finish one parsed node: number it (`key`, or the given `v` when key is
-- empty), record it as an occurrence when it is a candidate, stamp the
-- post-order index, leave `rest` after it
def cseType (g : Dg) (ty : List Int) : List Int :=
  let h := typeDigest g profile.v2Fuel 0 0 0 ty
  if h.ok != profile.cOk then ty
  else
    let id := typeFind g ty (get g.typeIndex h.n).xs
    if id < 0 then ty else 54 :: lebU id.toNat

def cseMk (g : Dg) (st : CS) (ty rest : List Int) (tag : Int) (pay : List Int) (kids : List Ex) (bids : List Int) (key : List Int) (v : Int) (cand : Bool) (mf : Int) : CS :=
  let keyTy := cseType g ty
  let st := if key.isEmpty then { st with cur := v } else vnKey st (key ++ [-1] ++ keyTy)
  if !st.ok then st
  else
    let st := if cand then occAdd st st.cur st.seq else st
    { st with e := { tag := tag, ty := ty, pay := pay, kids := kids, bids := bids, vn := st.cur, seq := st.seq, src := -1, mf := mf }
            , seq := st.seq + 1, rest := rest }

def payOf (bs rest : List Int) : List Int := (takeBytes (bs.length - rest.length) 0 [] bs).bs

def isBin (t : Int) : Bool :=
  t == 6 || t == 7 || t == 8 || t == 10 || t == 11 || t == 12 || t == 13 || t == 15 || t == 16
    || t == 19 || t == 26 || t == 27 || t == 28 || t == 47

def isUn (t : Int) : Bool :=
  t == 9 || t == 17 || t == 18 || t == 21 || t == 23 || t == 25 || t == 36 || t == 39 || t == 40
    || t == 44 || t == 45 || t == 46 || t == 49

def isTyOp (t : Int) : Bool :=
  t == 14 || t == 24 || t == 29 || t == 30 || t == 38 || t == 42 || t == 43

def isLeafTag (t : Int) : Bool :=
  t == 0 || t == 1 || t == 2 || t == 3 || t == 22 || t == 33 || t == 37 || t == 41

mutual
-- kind 0: one expression (`e`); kind 1: an `01 e* 00` list (`es`); kind 2:
-- `n` expressions (`es`); kind 3: an `01 e* 00` list of match branches,
-- each under a fresh opaque binder (`es`, `bl` their binder ids).
def cseParse (g : Dg) (sigs : List (List Int)) (sc : List (List Int)) (ty : List Int) (fuel : Nat) (kind n : Nat) (st : CS) (rest : List Int) : CS :=
  match fuel with
  | 0 => csFail st
  | f + 1 =>
    if !st.ok then st
    else if kind == 1 || kind == 3 then
      match rest with
      | 0 :: bs => { st with es := [], bl := [], rest := bs }
      | 1 :: bs =>
        let b := st.nb
        let st1 := if kind == 3 then opaqueVn { st with nb := st.nb + 1 } sc.length else st
        let sc1 := if kind == 3 then [b, st1.cur] :: sc else sc
        let t := readTyD g ty
        let a := cseParse g sigs sc1 (if kind == 3 then ty else t.acc) f 0 0 st1 bs
        if !a.ok then a
        else
          let e := a.e
          let r := cseParse g sigs sc (if kind == 3 then ty else t.rest) f kind 0 a a.rest
          if !r.ok then r else { r with es := e :: r.es, bl := if kind == 3 then b :: r.bl else r.bl }
      | _ => csFail st
    else if kind == 2 then
      match n with
      | 0 => { st with es := [], rest := rest }
      | m + 1 =>
        let t := readTyD g ty
        let a := cseParse g sigs sc t.acc f 0 0 st rest
        if !a.ok then a
        else
          let e := a.e
          let r := cseParse g sigs sc t.rest f 2 m a a.rest
          if !r.ok then r else { r with es := e :: r.es }
    else
      match rest with
      | [] => csFail st
      | tag :: bs =>
        if tag == 53 && g.on then
          let r := readLeb bs
          if r.ok != profile.cOk || r.n < 0 then csFail st
          else
            let a := cseParse g sigs sc ty f 0 0 st (nodeBody (dgAt g r.n.toNat))
            if !a.ok || !a.rest.isEmpty then csFail st
            else { a with e := { a.e with src := r.n }, rest := r.rest }
        else if tag == 0 || tag == 41 then
          let t := takeBytes 9 0 [] bs
          if t.ok != profile.cOk then csFail st else cseMk g st ty t.rest tag t.bs [] [] (tag :: t.bs) 0 false (-1)
        else if tag == 1 then
          let t := takeBytes 1 0 [] bs
          if t.ok != profile.cOk then csFail st else cseMk g st ty t.rest 1 t.bs [] [] (1 :: t.bs) 0 false (-1)
        else if tag == 2 then
          let s := skipName bs
          if s.ok != profile.cOk then csFail st
          else
            let pay := payOf bs s.rest
            cseMk g st ty s.rest 2 pay [] [] (2 :: pay) 0 false (-1)
        else if tag == 3 then
          let r := readLeb bs
          if r.ok != profile.cOk || r.n < 0 then csFail st
          else
            let en := scNth r.n.toNat sc
            if en.isEmpty then csFail st
            else cseMk g st ty r.rest 3 [] [] [scBid en] [] (scVn en) false r.n
        else if tag == 4 then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let pay := payOf bs t.rest
            let a := cseParse g sigs sc t.acc f 0 0 st t.rest
            if !a.ok then a
            else
              let eb := a.e
              let b := a.nb
              let c := cseParse g sigs ([b, eb.vn] :: sc) ty f 0 0 { a with nb := a.nb + 1 } a.rest
              if !c.ok then c
              else cseMk g c ty c.rest 4 pay [eb, c.e] [b] [] c.e.vn false (imaxI eb.mf (imaxI (-1) (c.e.mf - 1)))
        else if tag == 52 then
          let r := readLeb bs
          if r.ok != profile.cOk || r.n < 0 then csFail st
          else
            let pay := payOf bs r.rest
            let a := cseParse g sigs sc (sigParams (sigOf sigs r.n.toNat)) f 1 0 st r.rest
            if !a.ok then a
            else
              let ks := a.es
              cseMk g a ty a.rest 52 pay ks [] ([52] ++ pay ++ callVns g (sigParams (sigOf sigs r.n.toNat)) ks) 0 true (mfUnder ks 0 (-1))
        else if tag == 35 then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let i := readLeb t.rest
            if i.ok != profile.cOk || i.n < 0 then csFail st
            else
              let pay := payOf bs i.rest
              let a := cseParse g sigs sc t.acc f 0 0 st i.rest
              if !a.ok then a
              else cseMk g a ty a.rest 35 pay [a.e] [] ([35] ++ pay ++ [a.e.vn]) 0 true a.e.mf
        else if tag == 31 then
          let r := readLeb bs
          if r.ok != profile.cOk then csFail st
          else
            let pay := payOf bs r.rest
            let arm := sumArmWithLayers g layersOff [] r.n.toNat ty
            let a := cseParse g sigs sc arm.ty f 0 0 st r.rest
            if !a.ok then a
            else cseMk g a ty a.rest 31 pay [a.e] [] ([31] ++ pay ++ [a.e.vn]) 0 true a.e.mf
        else if tag == 34 then
          let nm := skipName bs
          if nm.ok != profile.cOk then csFail st
          else
            let pay := payOf bs nm.rest
            let field := recFieldWithLayers g layersOff [] 0 ty
            let a := cseParse g sigs sc (field.ty ++ recRest g ty) f 2 2 st nm.rest
            if !a.ok then a
            else cseMk g a ty a.rest 34 pay a.es [] ([34] ++ pay ++ vnsOf a.es) 0 true (mfUnder a.es 0 (-1))
        else if tag == 32 then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let pay := payOf bs t.rest
            let a := cseParse g sigs sc t.acc f 0 0 st t.rest
            if !a.ok then a
            else
              let es := a.e
              let c := cseParse g sigs sc ty f 3 0 a a.rest
              if !c.ok then c
              else cseMk g c ty c.rest 32 pay (es :: c.es) c.bl ([32] ++ pay ++ [es.vn] ++ vnsOf c.es) 0 true
                     (imaxI es.mf (mfUnder c.es 1 (-1)))
        else if tag == 50 then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let pay := payOf bs t.rest
            let a := cseParse g sigs sc t.acc f 0 0 st t.rest
            if !a.ok then a
            else
              let exs := a.e
              let z := cseParse g sigs sc ty f 0 0 a a.rest
              if !z.ok then z
              else
                let ez := z.e
                let b1 := z.nb
                let s1 := opaqueVn { z with nb := z.nb + 2 } sc.length
                let v1 := s1.cur
                let s2 := opaqueVn s1 (sc.length + 1)
                let v2 := s2.cur
                let c := cseParse g sigs ([b1 + 1, v2] :: [b1, v1] :: sc) ty f 0 0 s2 z.rest
                if !c.ok then c
                else cseMk g c ty c.rest 50 pay [exs, ez, c.e] [b1 + 1, b1] ([50] ++ pay ++ [exs.vn, ez.vn, c.e.vn]) 0 true
                       (imaxI exs.mf (imaxI ez.mf (imaxI (-1) (c.e.mf - 2))))
        else if tag == 51 then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let pay := payOf bs t.rest
            let b := st.nb
            let s0 := opaqueVn { st with nb := st.nb + 1 } sc.length
            let sc1 := [b, s0.cur] :: sc
            let a := cseParse g sigs sc1 [1] f 0 0 s0 t.rest
            if !a.ok then a
            else
              let est := a.e
              let c := cseParse g sigs sc1 t.acc f 0 0 a a.rest
              if !c.ok then c
              else
                let esp := c.e
                let z := cseParse g sigs sc t.acc f 0 0 c c.rest
                if !z.ok then z
                else
                  let ez := z.e
                  let d := cseParse g sigs sc [0] f 0 0 z z.rest
                  if !d.ok then d
                  else cseMk g d ty d.rest 51 pay [est, esp, ez, d.e] [b] ([51] ++ pay ++ [est.vn, esp.vn, ez.vn, d.e.vn]) 0 true
                         (imaxI (imaxI (-1) (est.mf - 1)) (imaxI (imaxI (-1) (esp.mf - 1)) (imaxI ez.mf d.e.mf)))
        else if tag == 5 || tag == 20 || tag == 48 then
          let tys := if tag == 5 then [1] ++ ty ++ ty else (if tag == 20 then [2] else [4, 0]) ++ [0, 0]
          let a := cseParse g sigs sc tys f 2 3 st bs
          if !a.ok then a else cseMk g a ty a.rest tag [] a.es [] (tag :: vnsOf a.es) 0 true (mfUnder a.es 0 (-1))
        else if isBin tag then
          let tys := if tag == 15 || tag == 16 then [1, 1] else if tag == 19 then [2, 2]
            else if tag == 26 then ty ++ ty else if tag == 27 then [0] ++ ty
            else if tag == 28 then innerTy g ty else if tag == 47 then [4, 0, 4, 0] else [0, 0]
          let a := cseParse g sigs sc tys f 2 2 st bs
          if !a.ok then a else cseMk g a ty a.rest tag [] a.es [] (tag :: vnsOf a.es) 0 true (mfUnder a.es 0 (-1))
        else if isUn tag then
          let argTy := if tag == 17 then [1] else if tag == 18 || tag == 21 then [2]
            else if tag == 23 || tag == 36 || tag == 40 then innerTy g ty
            else if tag == 25 then 4 :: innerTy g ty else if tag == 39 then 8 :: ty
            else if tag == 44 then 9 :: ty else if tag >= 45 then [4, 0] else [0]
          let a := cseParse g sigs sc argTy f 2 1 st bs
          if !a.ok then a else cseMk g a ty a.rest tag [] a.es [] (tag :: vnsOf a.es) 0 true (mfUnder a.es 0 (-1))
        else if isTyOp tag then
          let t := readTyD g bs
          if t.ok != profile.cOk then csFail st
          else
            let pay := payOf bs t.rest
            let a := cseParse g sigs sc (if tag == 14 then t.acc ++ t.acc else t.acc) f 2 (if tag == 14 then 2 else 1) st t.rest
            if !a.ok then a else cseMk g a ty a.rest tag pay a.es [] ([tag] ++ pay ++ vnsOf a.es) 0 true (mfUnder a.es 0 (-1))
        else if tag == 22 || tag == 33 || tag == 37 then cseMk g st ty bs tag [] [] [] [tag] 0 false (-1)
        else csFail st
termination_by (fuel, 0)
end

-- `[bid, number]` entries for the `pc` parameters: index i reads entry i,
-- binder id i, number keyed by the index
def seedParams (st : CS) (pc : Nat) : Nat → CS
  | 0 => st
  | k + 1 =>
    let i := pc - (k + 1)
    let st := vnKey st [61, (i : Int)]
    seedParams { st with sc := st.sc ++ [[(i : Int), st.cur]], nb := st.nb + 1 } pc k

-- a hoisted let: type, binder id, bound expression
structure HL where
  ty : List Int := []
  bid : Int := -1
  e : Ex := exNil

-- Rewrite state: next binder id, the occurrence lists, the table of
-- available numbers (number -> holding binder), the hoisted lets of the
-- current statement (latest first), whether anything changed, results.
structure RS where
  nb : Int := 0
  occ : Map := map0 0
  avail : Map := map0 0
  pre : List HL := []
  changed : Bool := false
  e : Ex := exNil
  es : List Ex := []

-- Rewrite context: the binders in scope (innermost first), the binders in
-- scope at the current statement's hoist point, the block region's last
-- post-order index.
structure RX where
  scope : List Int := []
  scopeB : List Int := []
  exit : Int := 0

def preBids : List HL → List Int
  | [] => []
  | h :: hs => h.bid :: preBids hs

-- the binder holding `v` when that binder is in `scope`, else -1
def availIn (st : RS) (scope : List Int) (v : Int) : Int :=
  let r := get st.avail v
  if r.v >= 0 && memI scope r.v then r.v else -1

-- record `b` as the holder of `v` unless an in-scope holder exists (the
-- recorded holder is then the outermost in scope)
def availAdd (st : RS) (scope : List Int) (v b : Int) : RS :=
  if availIn st scope v >= 0 then st else { st with avail := (ins st.avail v b 0 0 []).m }

def mkVar (b v : Int) : Ex := { exNil with tag := 3, bids := [b], vn := v }

def letNode (h : HL) (body : Ex) : Ex :=
  { exNil with tag := 4, pay := h.ty, kids := [h.e, body], bids := [h.bid], vn := body.vn }

def wrapPre : List HL → Ex → Ex
  | [], body => body
  | h :: hs, body => wrapPre hs (letNode h body)

-- Remap of a hoisted expression to the hoist point: a variable whose
-- binder is neither bound inside the expression nor in scope there reads
-- the in-scope holder of its number instead; without one, no hoist.
structure RM where
  ok : Bool := true
  ch : Bool := false
  e : Ex := exNil
  es : List Ex := []

mutual
def remapE (st : RS) (scB : List Int) (inner : List Int) (fuel : Nat) (e : Ex) : RM :=
  match fuel with
  | 0 => { ok := false }
  | f + 1 =>
    if e.tag == 3 then
      let b := e.bids.headD (-1)
      if memI inner b || memI scB b then { e := e }
      else
        let h := availIn st scB e.vn
        if h >= 0 then { ch := true, e := mkVar h e.vn } else { ok := false }
    else if e.kids.isEmpty then { e := e }
    else
      let r := remapKids st scB (e.bids ++ inner) f e.kids
      if !r.ok then r
      else if r.ch then { ch := true, e := { e with kids := r.es, src := -1 } }
      else { e := e }
termination_by (fuel, 0)

def remapKids (st : RS) (scB : List Int) (inner : List Int) (fuel : Nat) : List Ex → RM
  | [] => { es := [] }
  | k :: ks =>
    match fuel with
    | 0 => { ok := false }
    | f + 1 =>
      let a := remapE st scB inner f k
      if !a.ok then a
      else
        let b := remapKids st scB inner f ks
        if !b.ok then b else { ch := a.ch || b.ch, es := a.e :: b.es }
termination_by (fuel, 1)
end

def scopeNow (st : RS) (cx : RX) : List Int := preBids st.pre ++ cx.scope
def scopeBNow (st : RS) (cx : RX) : List Int := preBids st.pre ++ cx.scopeB

-- the candidate decision for a compound node whose children are already
-- rewritten (`ks`, `st.changed` says whether they changed; `c0` is the
-- caller's flag): an available number reads its holder; a number that
-- recurs later in the region, with a known type and operands reachable
-- at the hoist point, is bound by a hoisted let; `top` (the root of a
-- block statement) is never hoisted
def rwCand (g : Dg) (sigs : List (List Int)) (cx : RX) (top : Bool) (c0 : Bool) (st : RS) (e : Ex) (ks : List Ex) : RS :=
  let kc := st.changed
  let v := e.vn
  let h := availIn st (scopeNow st cx) v
  if h >= 0 then { st with e := mkVar h v, changed := true }
  else
    let e' := if kc then { e with kids := ks, src := -1 } else e
    let keep : RS := { st with e := e', changed := c0 || kc }
    if top || !(occLater (get st.occ v).xs e.seq cx.exit) then keep
    else
      let ty := e.ty
      if ty.isEmpty then keep
      else
        let scB := scopeBNow st cx
        let rm := remapE st scB [] profile.v2Fuel e'
        if !rm.ok then keep
        else
          let b := st.nb
          let st := { st with nb := st.nb + 1, pre := { ty := ty, bid := b, e := rm.e } :: st.pre, changed := true, e := mkVar b v }
          availAdd st (b :: scB) v b

mutual
-- one expression in statement position (evaluated unconditionally once
-- the statement is reached)
def rwE (g : Dg) (sigs : List (List Int)) (fuel : Nat) (cx : RX) (top : Bool) (st : RS) (e : Ex) : RS :=
  match fuel with
  | 0 => { st with e := e }
  | f + 1 =>
    let t := e.tag
    if isLeafTag t then { st with e := e }
    else if t == 4 then
      -- a let inside a statement: its binder is in scope for its body only
      let c0 := st.changed
      let a := rwE g sigs f cx false { st with changed := false } (exKid e.kids 0)
      let b := e.bids.headD (-1)
      let a := availAdd a (scopeNow a cx) (exKid e.kids 0).vn b
      let c := rwE g sigs f { cx with scope := b :: cx.scope } false a (exKid e.kids 1)
      let e' := if c.changed then { e with kids := [a.e, c.e], src := -1 } else e
      { c with e := e', changed := c0 || c.changed }
    else if t == 5 then
      let c0 := st.changed
      let a := rwE g sigs f cx false { st with changed := false } (exKid e.kids 0)
      let b := rwBlock g sigs f cx a (exKid e.kids 1)
      let c := rwBlock g sigs f cx b (exKid e.kids 2)
      rwCand g sigs cx top c0 c e [a.e, b.e, c.e]
    else if t == 32 then
      let c0 := st.changed
      let a := rwE g sigs f cx false { st with changed := false } (exKid e.kids 0)
      let r := rwBranches g sigs f cx a e.bids (kidsTail e.kids)
      rwCand g sigs cx top c0 r e (a.e :: r.es)
    else if t == 50 then
      let c0 := st.changed
      let a := rwE g sigs f cx false { st with changed := false } (exKid e.kids 0)
      let b := rwE g sigs f cx false a (exKid e.kids 1)
      let c := rwBlock g sigs f { cx with scope := e.bids ++ cx.scope } b (exKid e.kids 2)
      rwCand g sigs cx top c0 c e [a.e, b.e, c.e]
    else if t == 51 then
      let c0 := st.changed
      let cx1 := { cx with scope := e.bids ++ cx.scope }
      let a := rwBlock g sigs f cx1 { st with changed := false } (exKid e.kids 0)
      let b := rwBlock g sigs f cx1 a (exKid e.kids 1)
      let c := rwE g sigs f cx false b (exKid e.kids 2)
      let d := rwE g sigs f cx false c (exKid e.kids 3)
      rwCand g sigs cx top c0 d e [a.e, b.e, c.e, d.e]
    else
      let c0 := st.changed
      let r := rwKids g sigs f cx { st with changed := false } e.kids
      rwCand g sigs cx top c0 r e r.es
termination_by (fuel, 0)

def rwKids (g : Dg) (sigs : List (List Int)) (fuel : Nat) (cx : RX) (st : RS) : List Ex → RS
  | [] => { st with es := [] }
  | k :: ks =>
    match fuel with
    | 0 => { st with es := k :: ks }
    | f + 1 =>
      let a := rwE g sigs f cx false st k
      let b := rwKids g sigs f cx a ks
      { b with es := a.e :: b.es }
termination_by (fuel, 1)

def rwBranches (g : Dg) (sigs : List (List Int)) (fuel : Nat) (cx : RX) (st : RS) : List Int → List Ex → RS
  | _, [] => { st with es := [] }
  | bids, k :: ks =>
    match fuel with
    | 0 => { st with es := k :: ks }
    | f + 1 =>
      let b := bids.headD (-1)
      let a := rwBlock g sigs f { cx with scope := b :: cx.scope } st k
      let r := rwBranches g sigs f cx a (bids.tail) ks
      { r with es := a.e :: r.es }
termination_by (fuel, 2)

-- a sub-block: its own hoist point (its head) and region; hoisted lets of
-- the enclosing statement stay in scope inside it
def rwBlock (g : Dg) (sigs : List (List Int)) (fuel : Nat) (cx : RX) (st : RS) (e : Ex) : RS :=
  match fuel with
  | 0 => { st with e := e }
  | f + 1 =>
    let saved := st.pre
    let sc := scopeNow st cx
    let r := rwChain g sigs f { scope := sc, scopeB := sc, exit := e.seq } { st with pre := [] } e
    { r with pre := saved }
termination_by (fuel, 3)

-- the let chain of a block: each bound expression and the tail is a
-- statement; hoisted lets wrap the statement that produced them
def rwChain (g : Dg) (sigs : List (List Int)) (fuel : Nat) (cx : RX) (st : RS) (e : Ex) : RS :=
  match fuel with
  | 0 => { st with e := e }
  | f + 1 =>
    if e.tag == 4 then
      let c0 := st.changed
      let a := rwE g sigs f cx true { st with changed := false } (exKid e.kids 0)
      let b := e.bids.headD (-1)
      let pres := preBids a.pre
      let a := availAdd a (pres ++ cx.scope) (exKid e.kids 0).vn b
      let cx1 : RX := { scope := b :: pres ++ cx.scope, scopeB := b :: pres ++ cx.scopeB, exit := cx.exit }
      let c := rwChain g sigs f cx1 { a with pre := [] } (exKid e.kids 1)
      let ch := a.changed || c.changed || !a.pre.isEmpty
      let e' := if ch then wrapPre a.pre { e with kids := [a.e, c.e], src := -1 } else e
      { c with e := e', changed := c0 || ch, pre := [] }
    else
      let c0 := st.changed
      let a := rwE g sigs f cx true { st with changed := false } e
      let ch := a.changed || !a.pre.isEmpty
      let e' := if ch then wrapPre a.pre a.e else e
      { a with e := e', changed := c0 || ch, pre := [] }
termination_by (fuel, 4)
end

-- Serialization back to the wire.  An unchanged `53` subtree is written
-- as its reference when no hoisted binder (id >= `nb0`) sits among the
-- scope entries its free variables reach, so every index it carries is
-- still right; otherwise it is written out.
structure SR where
  ok : Bool := true
  bs : List Int := []

def idxOf : List Int → Int → Int → Int
  | [], _, _ => -1
  | x :: xs, b, i => if x == b then i else idxOf xs b (i + 1)

def refSafe (nb0 : Int) : List Int → Nat → Bool
  | _, 0 => true
  | [], _ => true
  | x :: xs, k + 1 => x < nb0 && refSafe nb0 xs k

mutual
def serE (g : Dg) (nb0 : Int) (fuel : Nat) (scope : List Int) (e : Ex) : SR :=
  match fuel with
  | 0 => { ok := false }
  | f + 1 =>
    if e.src >= 0 && refSafe nb0 scope (e.mf + 1).toNat then { bs := 53 :: lebU e.src.toNat }
    else
      let t := e.tag
      if t == 3 then
        let i := idxOf scope (e.bids.headD (-1)) 0
        if i < 0 then { ok := false } else { bs := 3 :: lebU i.toNat }
      else if t == 4 then
        let a := serE g nb0 f scope (exKid e.kids 0)
        let b := serE g nb0 f (e.bids.headD (-1) :: scope) (exKid e.kids 1)
        if !a.ok || !b.ok then { ok := false } else { bs := [4] ++ e.pay ++ a.bs ++ b.bs }
      else if t == 32 then
        let a := serE g nb0 f scope (exKid e.kids 0)
        let b := serBranches g nb0 f scope e.bids (kidsTail e.kids)
        if !a.ok || !b.ok then { ok := false } else { bs := [32] ++ e.pay ++ a.bs ++ b.bs }
      else if t == 50 then
        let a := serE g nb0 f scope (exKid e.kids 0)
        let b := serE g nb0 f scope (exKid e.kids 1)
        let c := serE g nb0 f (e.bids ++ scope) (exKid e.kids 2)
        if !a.ok || !b.ok || !c.ok then { ok := false } else { bs := [50] ++ e.pay ++ a.bs ++ b.bs ++ c.bs }
      else if t == 51 then
        let a := serE g nb0 f (e.bids ++ scope) (exKid e.kids 0)
        let b := serE g nb0 f (e.bids ++ scope) (exKid e.kids 1)
        let c := serE g nb0 f scope (exKid e.kids 2)
        let d := serE g nb0 f scope (exKid e.kids 3)
        if !a.ok || !b.ok || !c.ok || !d.ok then { ok := false }
        else { bs := [51] ++ e.pay ++ a.bs ++ b.bs ++ c.bs ++ d.bs }
      else if t == 52 then
        let a := serList g nb0 f scope e.kids
        if !a.ok then a else { bs := [52] ++ e.pay ++ a.bs }
      else if e.kids.isEmpty then { bs := t :: e.pay }
      else
        let a := serKids g nb0 f scope e.kids
        if !a.ok then a else { bs := [t] ++ e.pay ++ a.bs }
termination_by (fuel, 0)

def serKids (g : Dg) (nb0 : Int) (fuel : Nat) (scope : List Int) : List Ex → SR
  | [] => { bs := [] }
  | k :: ks =>
    match fuel with
    | 0 => { ok := false }
    | f + 1 =>
      let a := serE g nb0 f scope k
      let b := serKids g nb0 f scope ks
      if !a.ok || !b.ok then { ok := false } else { bs := a.bs ++ b.bs }
termination_by (fuel, 1)

def serList (g : Dg) (nb0 : Int) (fuel : Nat) (scope : List Int) : List Ex → SR
  | [] => { bs := [0] }
  | k :: ks =>
    match fuel with
    | 0 => { ok := false }
    | f + 1 =>
      let a := serE g nb0 f scope k
      let b := serList g nb0 f scope ks
      if !a.ok || !b.ok then { ok := false } else { bs := 1 :: a.bs ++ b.bs }
termination_by (fuel, 2)

def serBranches (g : Dg) (nb0 : Int) (fuel : Nat) (scope : List Int) : List Int → List Ex → SR
  | _, [] => { bs := [0] }
  | bids, k :: ks =>
    match fuel with
    | 0 => { ok := false }
    | f + 1 =>
      let a := serE g nb0 f (bids.headD (-1) :: scope) k
      let b := serBranches g nb0 f scope bids.tail ks
      if !a.ok || !b.ok then { ok := false } else { bs := 1 :: a.bs ++ b.bs }
termination_by (fuel, 3)
end

def intRange : Nat → List Int → List Int
  | 0, acc => acc
  | k + 1, acc => intRange k ((k : Int) :: acc)

-- one function body: parsed and numbered, rewritten, written back; a body
-- the pass does not change, or cannot read, keeps its bytes
def cseOne (g : Dg) (sigs : List (List Int)) (i : Nat) (body : List Int) : List Int :=
  let pc := (sigOf sigs i).headD 0
  if pc < 0 then body
  else
    let st0 := seedParams {} pc.toNat pc.toNat
    let p := cseParse g sigs st0.sc (sigResult g (sigOf sigs i)) profile.v2Fuel 0 0 st0 body
    if !p.ok || !p.rest.isEmpty then body
    else
      let scope := intRange pc.toNat []
      let r := rwBlock g sigs profile.v2Fuel { scope := scope, scopeB := scope, exit := p.e.seq } { nb := p.nb, occ := p.occ } p.e
      if !r.changed then body
      else
        let s := serE g p.nb profile.v2Fuel scope r.e
        if !s.ok then body else s.bs

-- the body stream after CSE of every function
def cseBodies (g : Dg) (sigs : List (List Int)) (intrinsics : List Int) : Nat → Nat → List Int → List Int
  | 0, _, rest => rest
  | k + 1, i, rest =>
    match rest with
    | 1 :: bs =>
      let e := skipE g profile.v2Fuel bs
      if e.ok != profile.cOk then rest
      else
        -- Runtime intrinsic bodies are certificates consumed by ownership
        -- inference and lowering. Their calls remain CSE candidates in users.
        -- A body that is a bare `53` reference is already factored through
        -- the node table: inlining it under fresh binder ids duplicates the
        -- shared tree and rewrites its scope, which the rc env check then
        -- reads as a var/type mismatch. Leave it byte-identical.
        let body := payOf bs e.rest
        1 :: (if (intrinsics.drop i).headD 0 != 0 || body.headD (-1) == 53 then body else cseOne g sigs i body) ++ cseBodies g sigs intrinsics k (i + 1) e.rest
    | _ => rest


-- LRC (reports/backend-opt-fable/PLAN-LRC.md): the stage runs under the ctor layer, with counting
-- and reuse on and arrays off. The emitter names the runtime's functions by their index under
-- those layers, and `kid` is a reserved form only there (`heapKindWithLayers`).
-- LRC: an image the stage does not take is a failed compile under the stage's word, never a quiet
-- build by the present lowering (GOAL-fable, revision of 2026-11-16). The outcome's code holds the
-- refusal's class and the function the stage stopped at (lib/lrc/FromWire.rsd `Residue`,
-- `refusalClass`, `refusalFn`; a function past 998 reads 999). The present lowering is asked for by
-- a word without the ctor bit.
def lrcRefusedBase : Int := 7000000
def lrcRefused (e : Lrc.Residue) : Int :=
  lrcRefusedBase + ((Lrc.refusalClass e * 1000 + (if Lrc.refusalFn e < 1000 then Lrc.refusalFn e else 999) : Nat) : Int)

def postWFns (doRi doReg : Bool) (dup drop : WFn) : List WFn → List WFn → List WFn
  | [], acc => revWFns acc []
  | f :: fs, acc =>
    let f1 := if doRi then riFunction dup drop f else f
    let f2 := if doReg then rgFn f1 else f1
    postWFns doRi doReg dup drop fs (f2 :: acc)

-- LRC: the module of an image whose functions are IR declarations. The runtime functions come first, then the image's public entries, then its
-- internal functions (lib/lrc/Emit.rsd `emitFns`).
def lrcModuleWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (sigs : List (List Int)) (n : Nat) (pubs : List Int) (decls : List Lrc.Decl) : Out :=
  let rts := List.range (runtimeCountWithLayers lay)
  let rtBase := rts.length
  let clRefs := Lrc.clRefsDecls decls Lrc.vsEmpty
  let emitDecls := Lrc.clTrimTailV (n + Lrc.nHelpers) clRefs decls
  -- under the alloc layer the stage's own heap (lib/lrc/Emit.rsd, "The stage's heap"): its three
  -- functions follow the internal ones, one for each declaration
  let heap := if lay.alloc then rtBase + n + emitDecls.length else 0
  -- the bytes of an object field: 4 under the layer `narrow`, which is a layout of the stage's own heap
  -- (docs/OBJECT-ABI.md "Narrow fields"); such a module has one more function, exported as `fw`, that says so
  let fw := if lay.narrow && lay.alloc then 4 else 8
  -- under the facts bit, which the stage does not use otherwise: internal functions return their
  -- results and a refusal is thrown to the entry (lib/lrc/Emit.rsd "How a function ends")
  let conv := if lay.facts then 1 else 0
  -- string literals as persistent objects in the module's data (lib/lrc/Emit.rsd)
  let lits := Lrc.litPool emitDecls
  let cg := Lrc.clGroundRefs n fw lits clRefs decls
  if !cg.ok then outFail (lrcRefused (Lrc.Residue.nodeNotWritten cg.fn))
  else
  let lowData := Lrc.litData lits
  let ground := if cg.pool.chunks.isEmpty then [] else [cg.pool]
  let staticEnd := if cg.pool.chunks.isEmpty then profile.heapAt else cg.pool.next
  let useArr := if heap == 0 then false else Lrc.declsUseArr n emitDecls
  -- the functions that stay functions of their own, by their numbers in the module (lib/lrc/Emit.rsd `keptFns`)
  let kept := shiftFns (rtBase + n) (Lrc.keptFns emitDecls)
  let inl := Lrc.inlOf conv n emitDecls
  let tab := if conv == 0 then Lrc.dtOfList (Lrc.inlKeepBodies Lrc.imEmpty emitDecls) else inl.tab
  let pubMap := Lrc.pubMapOf pubs Lrc.it0
  let em := Lrc.emitFnsStreamG inl tab g sigs rtBase n heap conv lits cg.addrs staticEnd pubMap fw lay.addr64 emitDecls
  if !em.ok then outFail (lrcRefused (Lrc.Residue.nodeNotWritten em.fn))
  else
    let preFns0 := rtFnsFrom rtFns rts
    let emPubs := em.publics
    let emInts := em.internals
    let emptyFn : WFn := { params := [], results := [], locals := [], code := [] }
    let dup := if lay.rc then preFns0.getD 6 emptyFn else emptyFn
    let drop := if lay.rc then preFns0.getD 7 emptyFn else emptyFn
    let preFns := if lay.reg then rgFns preFns0 else preFns0
    let tailFns := (if heap == 0 then [] else Lrc.heapFnsFor useArr heap fw lay.addr64)
      ++ (if fw == 4 then [Lrc.narrowFn] else []) ++ (if lay.addr64 then [Lrc.addr64Fn] else [])
    -- the runtime's dup and drop, where the emitter still calls them (`compileFrom` does the same)
    let pubs1 := postWFns lay.rc lay.reg dup drop emPubs []
    let ints1 := postWFns lay.rc lay.reg dup drop emInts []
    let tail1 := postWFns lay.rc lay.reg dup drop tailFns []
    let fns := preFns ++ (pubs1 ++ (ints1 ++ tail1))
    -- the module's last function is the one that names the width (lib/lrc/Emit.rsd `narrowFn`)
    let last := fns.length - 1
    let exps := shiftExps rtBase (expsFor n) ++ (if fw == 4 then [{ name := Lrc.narrowName, idx := last }] else [])
      ++ (if lay.addr64 then [{ name := Lrc.addr64Name, idx := last }] else [])
    outOk (encode { fns := fns, exps := exps, ground := ground, tags := conv,
                    lowData := lowData, addr64 := lay.addr64, kept := kept })

def lrcModule (lay : Layers) (g : Dg) (sigs : List (List Int)) (n : Nat) (pubs : List Int) (decls : List Lrc.Decl) : Out :=
  lrcModuleWithRt (rtFnListForLayers lay) lay g sigs n pubs decls

-- LRC: the stage on an image. One gate admits it (lib/lrc/FromWire.rsd `q` and `admit`, an NF
-- instance); what is admitted goes through the passes under the word's options and is written as
-- a module. The module's functions read the class's type context, as the translation did.
def lrcCompileWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (intr : List Int) (sigs : List (List Int)) (n : Nat) (bodies : List Int) (ws : List (List Int)) : Out :=
  -- arrays are cells of the stage's own heap: without it a list stays cells (lib/lrc/FromWire.rsd "Arrays")
  let c := Lrc.q { types := g, intr := intr, sigs := sigs, n := n, bodies := bodies, arrays := lay.alloc, narrow := lay.narrow && lay.alloc,
                   widths := ws }
  let types := c.types
  match Lrc.admit c with
  | Except.error e => outFail (lrcRefused e)
  | Except.ok im =>
    let pubs := im.pubs
    let imN := im.n
    let decls0 := im.decls
    lrcModuleWithRt rtFns lay types sigs n pubs (Lrc.pipelineWith ((if lay.cte then 1 else if lay.fuse then 0 else Lrc.pipelineDefault) + (if lay.qbe then 4 else 0) + (if lay.tail then 8 else 0) + (if lay.static then 16 else 0) + (if lay.dropSpec then 0 else 256) + (if lay.narrow && lay.alloc then 2048 else 0)) imN decls0)

def lrcCompile (lay : Layers) (g : Dg) (intr : List Int) (sigs : List (List Int)) (n : Nat) (bodies : List Int) (ws : List (List Int)) : Out :=
  lrcCompileWithRt (rtFnListForLayers lay) lay g intr sigs n bodies ws

def compileFromWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (tbl : List TE) (hrest : List Int) : Out :=
    let g := { g with nodeUse := if g.on && !lrcOn lay then nodeUsed g else [] }
    let c := readLeb hrest
    if c.ok != profile.cOk then outFail c.ok
    else if c.n < (profile.fnMin : Int) || c.n > (profile.fnMax : Int) then outFail profile.cArity
    else
      let ss := readSigs g c.n.toNat [] c.rest
      let word64 := lrcOn lay
      let chk := if ss.ok == profile.cOk && (g.on || !word64) then chkBodies g word64 c.n.toNat ss.rest else rdOk 0 ss.rest
      if ss.ok != profile.cOk then outFail ss.ok
      -- Keep v1's existing malformed-input diagnostics apart from the new named refusals.
      else if chk.ok != profile.cOk && (g.on || (chk.ok >= profile.cUnsup + 64 && chk.ok <= profile.cUnsup + 77)) then outFail chk.ok
      else
        -- DERIV-HANG exit 2: the body stream after value-numbering CSE
        -- (`cseBodies`), under lay.rc on a v2 container; off keeps its bytes.
        let intrinsics := intrinsicKinds lay g 0 ss.ss ss.rest
        -- LRC: under the stage's word the stage compiles the image or refuses it (`lrcCompile`);
        -- with the layer off every image takes the path below.
        if lrcOn lay then lrcCompileWithRt rtFns lay g intrinsics ss.ss c.n.toNat ss.rest (readSigWs g c.n.toNat c.rest)
        else
        let bodies := if lay.rc && g.on then cseBodies g ss.ss intrinsics c.n.toNat 0 ss.rest else ss.rest
        let n := c.n.toNat
        let bi := (biInferWithLayers lay) g ss.ss bodies
        let fs1 := (lowerFnsWithIntrinsics lay intrinsics) g bi tbl (runtimeCountWithLayers lay) [] ss.ss [] [] [] [] 0 n 0 ss.ss bodies cenEmpty
        if bi.err != profile.cOk then outFail bi.err
        else if fs1.ok != profile.cOk then outFail fs1.ok
        else
          let arr0 := if lay.arr then arrOf g fs1.cen.es fs1.cen.es else []
          let arr := stripArr g arr0 fs1.cen.es []
          let groups := if lay.tail then (revW (groupsOf fs1.cen.es n) []).filter (abiDirectGroup g lay arr ss.ss) else []
          -- A memo keys on scalar words, so on handles; the arena rewind reuses
          -- handles, so a program with an arena gets no memo tables.
          let memos := if lay.qbe && !lay.rc && !(hasArenaMark fs1.cen.es) then ((memoPlanWithLayers g) lay) arr ss.ss fs1.cen.es groups n else []
          let closed := memW fs1.cen.es [6, 0]
          let eqt := (eqTysOf g) fs1.cen.es fs1.cen.es
          let eqb1 := runtimeCountWithLayers lay + n + groups.length
          let reusePlan := if lay.rc && lay.reuse then reuseListTypes g lay arr fs1.cen.es else {}
          let reuseLists := reusePlan.tys
          let bi1 :=
            { bi with
              base := eqb1 + eqt.length
              reuseLists := reuseLists
              reuseListBase := eqb1 + eqt.length + n }
          let hasEq := hasEqOf fs1.cen.es
          let fs2 := match arr, groups, memos, closed, hasEq, hasArenaMark fs1.cen.es with
            | [], [], [], false, false, false => fs1
            | _, _, _, _, _, _ => (lowerFnsWithIntrinsics lay intrinsics) g bi1 tbl (runtimeCountWithLayers lay) arr ss.ss groups memos fs1.bodies eqt eqb1 n 0 ss.ss bodies cenEmpty
          if reusePlan.ok != profile.cOk then outFail reusePlan.ok
          else if fs2.ok != profile.cOk then outFail fs2.ok
          else
            let rts := List.range (runtimeCountWithLayers lay)
            let rtBase := rts.length
            let tbl2 := bindRt (rtMapOf rts) tbl
            let eqb := rtBase + n + groups.length
            let bi :=
              { bi1 with
                base := eqb + eqt.length
                reuseListBase := eqb + eqt.length + n }
            let fs := (lowerFnsWithIntrinsics lay intrinsics) g bi tbl2 rtBase arr ss.ss groups memos fs1.bodies eqt eqb n 0 ss.ss bodies cenEmpty
            let workers := reuseListWorkers g lay arr reuseLists
            if fs.ok != profile.cOk then outFail fs.ok
            else if !workers.ok then outFail workers.err
            else
              let public := groundPublicFns fs.cen.ground (((arenaPublicFnsWithLayers g) lay) arr ss.ss (if (biOnWithLayers lay) then ((biWrappersWithLayers g) lay) bi arr ss.ss 0 else fs.fns))
              let internal := if (biOnWithLayers lay) then fs.fns else []
              let fns := rtFnsFrom rtFns rts ++ public ++ ((groupFnsWithLayers g) lay) bi arr ss.ss fs.gb groups
                ++ ((eqFnsWithLayers g) lay) arr eqt eqb eqt ++ internal ++ workers.fns
              let allocDec := if lay.alloc then runtimeAllocDecoded else rtDecoded []
              let fns := runtimeAllocFns lay rtBase
                (if allocDec.error == 0 then allocDec.functions else []) fns
              let fns := runtimeInlineFns lay rtBase fns
              outOk (encode {
                  fns := if lay.reg then rgFns fns else fns
                  exps := shiftExps rtBase (expsFor fs.fns.length)
                  ground := fs.cen.ground })

def compileFrom (lay : Layers) (g : Dg) (tbl : List TE) (hrest : List Int) : Out :=
  compileFromWithRt (rtFnListForLayers lay) lay g tbl hrest


def compileWithLayers (lay : Layers) (tbl : List TE) (bs : List Int) : Out :=
  if !(layerConflict lay).isEmpty then outFail profile.cLayerBits
  else
    let rt := rtCompileForLayers lay
    if rt.error != 0 then outFail profile.cBody
    else match bs with
    | 82 :: 83 :: 67 :: 77 :: 2 :: rest =>
      let k := readLeb rest
      if k.ok != profile.cOk then outFail k.ok
      else if k.n < 0 then outFail profile.cArity
      else
        let d := dgRead lay dgEmpty k.n.toNat k.rest
        if d.ok != profile.cOk then outFail d.ok else compileFromWithRt rt.fns lay d.g tbl d.rest
    | _ =>
      let h := eatAll [82, 83, 67, 77, 1] bs
      if h.ok != profile.cOk then outFail h.ok else compileFromWithRt rt.fns lay dgNone tbl h.rest



-- One emitted entry, with an explicit i64 configuration word.
def compile (config : Int) (bs : List Int) : Out :=
  match layersFromBits config with
  | none => outFail profile.cLayerBits
  | some lay => compileWithLayers lay (if lrcOn lay then [] else tableWithLayers lay) bs

structure EmitPackR where
  ok : Bool
  fn : Nat
  pubs : List WFnP
  ints : List WFnP

def postPackOne (doRi doReg : Bool) (dup drop : WFn) (f : WFn) : WFnP :=
  let f1 := if doRi then riFunction dup drop f else f
  let f2 := if doReg then rgFn f1 else f1
  packWFn f2

def postWFnsPack (doRi doReg : Bool) (dup drop : WFn) : List WFn → List WFnP → List WFnP
  | [], acc => revWFnsP acc []
  | f :: fs, acc => postWFnsPack doRi doReg dup drop fs (postPackOne doRi doReg dup drop f :: acc)

def emitPackDecls (doRi doReg : Bool) (dup drop : WFn) (inl : Lrc.Inl) (tab : Lrc.DeclTab)
    (g : Dg) (sigs : List (List Int)) (sigIdx : Nat) (sigsTail : List (List Int))
    (rtBase n heap conv : Nat) (lits : List Int) (closed : Lrc.IMap) (staticEnd : Int) (pubMap : Lrc.ITree) (fw : Nat) (addr64 : Bool) :
    List Lrc.Decl → List WFnP → List WFnP → EmitPackR
  | [], pubAcc, intAcc => { ok := true, fn := 0, pubs := revWFnsP pubAcc [], ints := revWFnsP intAcc [] }
  | d :: ds, pubAcc, intAcc =>
    let r := Lrc.emitOneDeclG inl tab g sigs sigIdx sigsTail rtBase n heap conv lits closed staticEnd pubMap fw addr64 d
    if !r.ok then { ok := false, fn := r.fn, pubs := [], ints := [] }
    else
      let intP := postPackOne doRi doReg dup drop r.intFn
      let pubAcc1 := match r.pub with
        | p :: _ => postPackOne doRi doReg dup drop p :: pubAcc
        | [] => pubAcc
      emitPackDecls doRi doReg dup drop inl tab g sigs r.nextSigIdx r.nextSigsTail rtBase n heap conv lits closed staticEnd pubMap fw addr64 ds pubAcc1 (intP :: intAcc)

def appendWFnsP : List WFnP → List WFnP → List WFnP
  | [], tail => tail
  | f :: fs, tail => appendWFnsP fs (f :: tail)

def joinWFnsP (a b : List WFnP) : List WFnP :=
  appendWFnsP (revWFnsP a []) b

def lrcModulePackedWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (sigs : List (List Int)) (n : Nat) (pubs : List Int) (decls : List Lrc.Decl) : OutP :=
  let rts := List.range (runtimeCountWithLayers lay)
  let rtBase := rts.length
  let clRefs := Lrc.clRefsDecls decls Lrc.vsEmpty
  let emitDecls := Lrc.clTrimTailV (n + Lrc.nHelpers) clRefs decls
  let heap := if lay.alloc then rtBase + n + emitDecls.length else 0
  let fw := if lay.narrow && lay.alloc then 4 else 8
  let conv := if lay.facts then 1 else 0
  let lits := Lrc.litPool emitDecls
  let cg := Lrc.clGroundRefs n fw lits clRefs decls
  if !cg.ok then outPFail (lrcRefused (Lrc.Residue.nodeNotWritten cg.fn))
  else
  let lowData := Lrc.litData lits
  let ground := if cg.pool.chunks.isEmpty then [] else [cg.pool]
  let staticEnd := if cg.pool.chunks.isEmpty then profile.heapAt else cg.pool.next
  let useArr := if heap == 0 then false else Lrc.declsUseArr n emitDecls
  let kept := shiftFns (rtBase + n) (Lrc.keptFns emitDecls)
  let inl := Lrc.inlOf conv n emitDecls
  let tab := if conv == 0 then Lrc.dtOfList (Lrc.inlKeepBodies Lrc.imEmpty emitDecls) else inl.tab
  let pubMap := Lrc.pubMapOf pubs Lrc.it0
  let preFns0 := rtFnsFrom rtFns rts
  let emptyFn : WFn := { params := [], results := [], locals := [], code := [] }
  let dup := if lay.rc then preFns0.getD 6 emptyFn else emptyFn
  let drop := if lay.rc then preFns0.getD 7 emptyFn else emptyFn
  let pre1 := postWFnsPack false lay.reg dup drop preFns0 []
  let tailFns := (if heap == 0 then [] else Lrc.heapFnsFor useArr heap fw lay.addr64)
    ++ (if fw == 4 then [Lrc.narrowFn] else []) ++ (if lay.addr64 then [Lrc.addr64Fn] else [])
  let tail1 := postWFnsPack lay.rc lay.reg dup drop tailFns []
  let em := emitPackDecls lay.rc lay.reg dup drop inl tab g sigs 0 sigs rtBase n heap conv lits cg.addrs staticEnd pubMap fw lay.addr64 emitDecls [] []
  if !em.ok then outPFail (lrcRefused (Lrc.Residue.nodeNotWritten em.fn))
  else
    let pubs1 := em.pubs
    let ints1 := em.ints
    let fns := joinWFnsP pre1 (joinWFnsP pubs1 (joinWFnsP ints1 tail1))
    let lastIdx := fns.length - 1
    let narrowExps : List WEx := if fw == 4 then [{ idx := lastIdx, name := Lrc.narrowName }] else []
    let addr64Exps : List WEx := if lay.addr64 then [{ idx := lastIdx, name := Lrc.addr64Name }] else []
    let expsP := shiftExps rtBase (expsFor n) ++ narrowExps ++ addr64Exps
    outPOk (encodePacked { fns := fns, exps := expsP, ground := ground, tags := conv,
                           lowData := lowData, addr64 := lay.addr64, kept := kept })

def lrcCompilePackedWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (intr : List Int) (sigs : List (List Int)) (n : Nat) (bodies : List Int) (ws : List (List Int)) : OutP :=
  let c := Lrc.q { types := g, intr := intr, sigs := sigs, n := n, bodies := bodies, arrays := lay.alloc, narrow := lay.narrow && lay.alloc,
                   widths := ws }
  let types := c.types
  match Lrc.admit c with
  | Except.error e => outPFail (lrcRefused e)
  | Except.ok im =>
    let pubs := im.pubs
    let imN := im.n
    let decls0 := im.decls
    lrcModulePackedWithRt rtFns lay types sigs n pubs (Lrc.pipelineWith ((if lay.cte then 1 else if lay.fuse then 0 else Lrc.pipelineDefault) + (if lay.qbe then 4 else 0) + (if lay.tail then 8 else 0) + (if lay.static then 16 else 0) + (if lay.dropSpec then 0 else 256) + (if lay.narrow && lay.alloc then 2048 else 0)) imN decls0)

def compileFromPackedWithRt (rtFns : List WFn) (lay : Layers) (g : Dg) (tbl : List TE) (hrest : List Int) : OutP :=
  let g := { g with nodeUse := if g.on && !lrcOn lay then nodeUsed g else [] }
  let c := readLeb hrest
  if c.ok != profile.cOk then outPFail c.ok
  else if c.n < (profile.fnMin : Int) || c.n > (profile.fnMax : Int) then outPFail profile.cArity
  else
    let ss := readSigs g c.n.toNat [] c.rest
    let word64 := lrcOn lay
    let chk := if ss.ok == profile.cOk && (g.on || !word64) then chkBodies g word64 c.n.toNat ss.rest else rdOk 0 ss.rest
    if ss.ok != profile.cOk then outPFail ss.ok
    else if chk.ok != profile.cOk && (g.on || (chk.ok >= profile.cUnsup + 64 && chk.ok <= profile.cUnsup + 77)) then outPFail chk.ok
    else
      let intrinsics := intrinsicKinds lay g 0 ss.ss ss.rest
      if lrcOn lay then lrcCompilePackedWithRt rtFns lay g intrinsics ss.ss c.n.toNat ss.rest (readSigWs g c.n.toNat c.rest)
      else
        let o := compileFromWithRt rtFns lay g tbl hrest
        if o.ok != profile.cOk then outPFail o.ok
        else outPOk (packChunkU32 o.bytes [])

def compileWithLayersPacked (lay : Layers) (tbl : List TE) (bs : List Int) : OutP :=
  if !(layerConflict lay).isEmpty then outPFail profile.cLayerBits
  else
    let rt := rtCompileForLayers lay
    if rt.error != 0 then outPFail profile.cBody
    else match bs with
    | 82 :: 83 :: 67 :: 77 :: 2 :: rest =>
      let k := readLeb rest
      if k.ok != profile.cOk then outPFail k.ok
      else if k.n < 0 then outPFail profile.cArity
      else
        let d := dgRead lay dgEmpty k.n.toNat k.rest
        if d.ok != profile.cOk then outPFail d.ok else compileFromPackedWithRt rt.fns lay d.g tbl d.rest
    | _ =>
      let h := eatAll [82, 83, 67, 77, 1] bs
      if h.ok != profile.cOk then outPFail h.ok else compileFromPackedWithRt rt.fns lay dgNone tbl h.rest

def compilePacked (config : Int) (bs : List Int) : OutP :=
  match layersFromBits config with
  | none => outPFail profile.cLayerBits
  | some lay => compileWithLayersPacked lay (if lrcOn lay then [] else tableWithLayers lay) bs
