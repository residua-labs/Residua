namespace Web.Net.CompletionWire
open Web.Net Web.Net.Completions Web.Net.Wire

def statusNumber : Status → Nat
  | .success => 0 | .eof => 1 | .osError => 2 | .cancelled => 3

def decodeStatus : Nat → Except Web.Net.Wire.Residue Status
  | 0 => .ok .success | 1 => .ok .eof | 2 => .ok .osError | 3 => .ok .cancelled
  | _ => .error .status

def putErrno (errno : Int) : Except Web.Net.Wire.Residue ByteArray :=
  if errno < -2147483648 || errno > 2147483647 then .error .integerWidth
  else putNat 4 (if errno < 0 then (errno + 4294967296).toNat else errno.toNat)

def encodeCompletion (reply : Completion) : Except Web.Net.Wire.Residue ByteArray := do
  let op ← putNat 1 (opNumber reply.op)
  let id ← putNat 8 reply.id
  let status ← putNat 1 (statusNumber reply.status)
  let handle ← putNat 8 reply.handle
  let result ← putNat 4 reply.result
  let errno ← putErrno reply.errno
  let length ← putNat 4 reply.payload.size
  return op ++ id ++ status ++ handle ++ result ++ errno ++ length ++ reply.payload

def encodeCompletions : List Completion → Except Web.Net.Wire.Residue ByteArray
  | [] => .ok ByteArray.empty
  | reply :: rest => do return (← encodeCompletion reply) ++ (← encodeCompletions rest)

def encodeBatch (replies : List Completion) : Except Web.Net.Wire.Residue ByteArray := do
  let count ← putNat 4 replies.length
  return "NQC1".toUTF8 ++ count ++ (← encodeCompletions replies)

def decodeCompletion (c : Config) (cursor : Cursor) :
    Except Web.Net.Wire.Residue (Completion × Cursor) := do
  let (tag, cursor) ← getNat 1 cursor
  let op ← getOp tag
  let (id, cursor) ← getNat 8 cursor
  let (status, cursor) ← getNat 1 cursor
  let status ← decodeStatus status
  let (handle, cursor) ← getNat 8 cursor
  let (result, cursor) ← getNat 4 cursor
  let (rawErrno, cursor) ← getNat 4 cursor
  let errno := if rawErrno >= 2147483648 then (Int.ofNat rawErrno) - 4294967296 else Int.ofNat rawErrno
  let (length, cursor) ← getNat 4 cursor
  if length > c.maxPayload then throw .payload
  let (payload, cursor) ← readBytes length cursor
  return (⟨op, id, status, handle, result, errno, payload⟩, cursor)

def decodeCompletions (c : Config) : Nat → Cursor →
    Except Web.Net.Wire.Residue (List Completion × Cursor)
  | 0, cursor => .ok ([], cursor)
  | n + 1, cursor => do
    let (reply, cursor) ← decodeCompletion c cursor
    let (rest, cursor) ← decodeCompletions c n cursor
    return (reply :: rest, cursor)

def decodeBatch (c : Config) (bytes : ByteArray) :
    Except Web.Net.Wire.Residue (List Completion) := do
  if bytes.size > c.dataCap then throw .frameCap
  let (magic, cursor) ← readBytes 4 ⟨bytes, 0⟩
  if magic.data != "NQC1".toUTF8.data then throw .magic
  let (count, cursor) ← getNat 4 cursor
  if count > c.maxBatch then throw .batchCount
  let (replies, cursor) ← decodeCompletions c count cursor
  if cursor.position != bytes.size then throw .trailing
  return replies
end Web.Net.CompletionWire
