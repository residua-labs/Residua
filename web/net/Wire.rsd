namespace Web.Net.Wire
open Web.Net

inductive Residue where
  | integerWidth | truncated | magic | operation | status | batchCount | payload | trailing | frameCap
  deriving BEq, Repr, DecidableEq

def residueName : Residue → String
  | Residue.integerWidth => "nf_net_wire_integer_width"
  | Residue.truncated => "nf_net_wire_truncated"
  | Residue.magic => "nf_net_wire_magic"
  | Residue.operation => "nf_net_wire_operation"
  | Residue.status => "nf_net_wire_status"
  | Residue.batchCount => "nf_net_wire_batch_count"
  | Residue.payload => "nf_net_wire_payload"
  | Residue.trailing => "nf_net_wire_trailing"
  | Residue.frameCap => "nf_net_wire_frame_cap"

structure Cursor where
  bytes : ByteArray
  position : Nat := 0

def readBytes (n : Nat) (cursor : Cursor) : Except Residue (ByteArray × Cursor) :=
  if cursor.position + n > cursor.bytes.size then .error .truncated
  else .ok (cursor.bytes.extract cursor.position (cursor.position + n),
    { cursor with position := cursor.position + n })

def getNat (width : Nat) (cursor : Cursor) : Except Residue (Nat × Cursor) := do
  let (bytes, next) ← readBytes width cursor
  let (_, value) := bytes.data.foldl (fun (place, value) byte =>
    (place * 256, value + byte.toNat * place)) (1, 0)
  return (value, next)

-- The only truncating conversion is dominated by the mathematical width guard.
def putNat (width value : Nat) : Except Residue ByteArray :=
  -- Shifts, not `256 ^ i`: Nat.pow goes through GMP even for small operands.
  if value >>> (8 * width) != 0 then .error .integerWidth
  else .ok ⟨((List.range width).map (fun i => UInt8.ofNat (value >>> (8 * i) % 256))).toArray⟩

def opNumber : Operation → Nat
  | .listen => 1 | .accept => 2 | .read => 3 | .write => 4 | .close => 5 | .readFile => 6

def getOp : Nat → Except Residue Operation
  | 1 => .ok .listen | 2 => .ok .accept | 3 => .ok .read | 4 => .ok .write
  | 5 => .ok .close | 6 => .ok .readFile | _ => .error .operation

def encodeRequest (r : Submission) : Except Residue ByteArray := do
  let op ← putNat 1 (opNumber r.op)
  let id ← putNat 8 r.id
  let handle ← putNat 8 r.handle
  let argument ← putNat 4 r.argument
  let length ← putNat 4 r.payload.size
  return op ++ id ++ handle ++ argument ++ length ++ r.payload

def encodeRequests : List Submission → Except Residue ByteArray
  | [] => .ok ByteArray.empty
  | r :: rs => do return (← encodeRequest r) ++ (← encodeRequests rs)

-- A mathematical field that does not fit never silently becomes a low-bit alias.
def encodeBatch (requests : List Submission) : Except Residue ByteArray := do
  let count ← putNat 4 requests.length
  let bytes ← encodeRequests requests
  return "NQS1".toUTF8 ++ count ++ bytes

def decodeRequest (c : Config) (cursor : Cursor) : Except Residue (Submission × Cursor) := do
  let (tag, cursor) ← getNat 1 cursor
  let op ← getOp tag
  let (id, cursor) ← getNat 8 cursor
  let (handle, cursor) ← getNat 8 cursor
  let (argument, cursor) ← getNat 4 cursor
  let (length, cursor) ← getNat 4 cursor
  if length > c.maxPayload then throw .payload
  let (payload, cursor) ← readBytes length cursor
  return (⟨id, op, handle, argument, payload⟩, cursor)

def decodeRequests (c : Config) : Nat → Cursor → Except Residue (List Submission × Cursor)
  | 0, cursor => .ok ([], cursor)
  | n + 1, cursor => do
    let (request, cursor) ← decodeRequest c cursor
    let (rest, cursor) ← decodeRequests c n cursor
    return (request :: rest, cursor)

def decodeBatch (c : Config) (bytes : ByteArray) : Except Residue (List Submission) := do
  if bytes.size > c.dataCap then throw .frameCap
  let (magic, cursor) ← readBytes 4 ⟨bytes, 0⟩
  if magic.data != "NQS1".toUTF8.data then throw .magic
  let (count, cursor) ← getNat 4 cursor
  if count == 0 || count > c.maxBatch then throw .batchCount
  let (requests, cursor) ← decodeRequests c count cursor
  if cursor.position != bytes.size then throw .trailing
  return requests

-- Typed encoder admission belongs before encodeBatch: Web.Net.step. The wire
-- encoder also guards every width independently, so it remains safe in isolation.
inductive Fault where
  | wire (residue : Residue)
  | admission (failure : Failure)
  deriving BEq, Repr

structure Encoded where
  bytes : ByteArray
  next : State

structure Decoded where
  requests : List Submission
  next : State

def submit (i : Input) : Except Fault Encoded := do
  let next ← (Web.Net.runNF i).mapError Fault.admission
  let bytes ← (encodeBatch i.batch).mapError Fault.wire
  return ⟨bytes, next⟩

def receive (c : Config) (s : State) (bytes : ByteArray) : Except Fault Decoded := do
  let requests ← (decodeBatch c bytes).mapError Fault.wire
  let next ← (Web.Net.runNF ⟨c, s, requests⟩).mapError Fault.admission
  return ⟨requests, next⟩

end Web.Net.Wire
