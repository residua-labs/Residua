namespace Web.Net.HostProbe
open Web.Net Web.Net.Rows Lean
abbrev Child := IO.Process.Child { stdin := .piped, stdout := .piped, stderr := .piped }
def defaultDirectory := "out/web-net-host-r1/live"
-- This fixed baseline launches the owned endpoint only after typed resolution.
-- The namespace selector is the typed namespace value q, not a fixture file q.
def declaredContextWith (profile : Context.Profile) : IO Context.Resolved := do
  let contract : Context.Contract := {
    submissionGrammar := ← IO.FS.readBinFile "web/net/Wire.rsd"
    completionGrammar := ← IO.FS.readBinFile "web/net/CompletionWire.rsd"
    admissionMachine := ← IO.FS.readBinFile "web/net/Admission.rsd"
    completionMachine := ← IO.FS.readBinFile "web/net/Completions.rsd"
    conformance := (← IO.FS.readBinFile "web/net/Rows.rsd") ++
      (← IO.FS.readBinFile "web/net/BoundaryRows.rsd") }
  let r ← IO.ofExcept ((Context.declare contract {} profile).mapError reprStr)
  IO.ofExcept ((Context.check contract r).mapError reprStr)
def declaredContext : IO Context.Resolved := declaredContextWith {}
def hex (bs : ByteArray) : String := String.mk (bs.data.toList.flatMap fun b =>
  let digits := "0123456789abcdef".toList
  [digits[b.toNat / 16]!,digits[b.toNat % 16]!])
def config : Config := { maxPayload := 4096, dataCap := 8168 }
def require (b : Bool) (s : String) : IO Unit := unless b do throw (IO.userError s)
def lift {α : Type} {ε : Type} [Repr ε] (r : Except ε α) : IO α :=
  IO.ofExcept (r.mapError reprStr)
def spawn (cmd : String) (args : Array String) : IO Child :=
  IO.Process.spawn { cmd, args, stdin := .piped, stdout := .piped, stderr := .piped }
def stop (child : Child) : IO Unit := do
  match ← child.tryWait with
  | some _ => pure ()
  | none =>
    try child.kill catch _ => pure ()
    let _ ← child.wait
    pure ()
def readExactGo : Nat → IO.FS.Handle → Nat → ByteArray → IO ByteArray
  | 0, _, _, _ => throw (IO.userError "read-budget")
  | fuel+1, h, n, acc => do
    if n == 0 then return acc
    let b ← h.read (USize.ofNat n)
    require (!b.isEmpty && b.size <= n) "pipe-EOF"
    readExactGo fuel h (n-b.size) (acc ++ b)
def readExact (h : IO.FS.Handle) (n : Nat) := readExactGo (n+1) h n ByteArray.empty
def u (width value : Nat) : IO ByteArray := lift (Wire.putNat width value)
def str (s : String) : IO ByteArray := do return (← u 2 s.utf8ByteSize) ++ s.toUTF8
structure Session where
  pipe : Child
  directory : String
  state : IO.Ref State
  transactions : IO.Ref (Array Json)
  checks : IO.Ref (Array Json)
  namespaceQ : String

def exchange (s : Session) (kind tag : Nat) (payload : ByteArray) : IO ByteArray := do
  let frame := (← u 4 (7+payload.size)) ++ (← u 1 kind) ++ (← u 2 tag) ++ payload
  let index := (← s.transactions.get).size
  let tfile := s.directory ++ s!"/transaction-{index}-T.bin"
  let rfile := s.directory ++ s!"/transaction-{index}-R.bin"
  IO.FS.writeBinFile tfile frame
  s.pipe.stdin.write frame
  s.pipe.stdin.flush
  let frameHead ← readExact s.pipe.stdout 4
  let (len, _) ← lift (Wire.getNat 4 ⟨frameHead, 0⟩)
  require (7 <= len && len <= 8192) "response-size"
  let response := frameHead ++ (← readExact s.pipe.stdout (len-4))
  require (response[5]!.toNat + 256*response[6]!.toNat == tag) "response-tag"
  IO.FS.writeBinFile rfile response
  s.transactions.modify (·.push (Json.mkObj [("request",toJson tfile),("response",toJson rfile),
    ("request_type",toJson kind),("response_type",toJson response[4]!.toNat)]))
  return response

-- Assert the device's declared named refusal, not just any nonzero outcome.
def refused (s : Session) (label : String) (kind : Nat) (payload : ByteArray)
    (expected : String) : IO Unit := do
  let r ← exchange s kind 0 payload
  require (r[4]!.toNat == 107) (label ++ ":Rerror")
  let (n, _) ← lift (Wire.getNat 2 ⟨r,7⟩)
  require (r.size == n+9 && String.fromUTF8? (r.extract 9 r.size) == some expected)
    (label ++ ":residue:" ++ reprStr (String.fromUTF8? (r.extract 9 r.size)))
  s.checks.modify (·.push (Json.mkObj [("name",toJson label),("residue",toJson expected),("pass",toJson true)]))

def refusedBytes (s : Session) (label : String) (raw : ByteArray) (expected : String) : IO Unit := do
  refused s label 118 ((← u 4 1) ++ (← u 8 0) ++ (← u 4 raw.size) ++ raw) expected

def refusedRequests (s : Session) (label : String) (requests : List Submission)
    (expected : String) : IO Unit := do
  refusedBytes s label (← lift (Wire.encodeBatch requests)) expected

def readCount (s : Session) (label : String) (count : Nat) : IO Unit := do
  refused s label 116 ((← u 4 1) ++ (← u 8 0) ++ (← u 4 count)) "read_count"

def emptyQueueChecks (s : Session) : IO Unit := do
  let encoded ← lift (Wire.encodeBatch [listen 1])
  refusedBytes s "wire-empty" ByteArray.empty "truncated"
  refusedBytes s "wire-magic" ("NOPE".toUTF8 ++ (← u 4 0)) "magic"
  refusedBytes s "wire-count-truncated" "NQS1".toUTF8 "truncated"
  refusedBytes s "wire-count-zero" ("NQS1".toUTF8 ++ (← u 4 0)) "batch_count"
  refusedBytes s "wire-count-cap+1" ("NQS1".toUTF8 ++ (← u 4 65)) "batch_count"
  refusedBytes s "wire-record-missing" ("NQS1".toUTF8 ++ (← u 4 1)) "truncated"
  refusedBytes s "wire-operation" (encoded.set! 8 0) "operation"
  refusedBytes s "wire-record-truncated" (encoded.extract 0 (encoded.size-1)) "truncated"
  refusedBytes s "wire-trailing" (encoded.push 0) "trailing"
  refusedRequests s "wire-payload-cap+1" [write 1 99 (bytes (List.replicate 4097 42))] "payload"
  refusedRequests s "unknown-handle" [read 1 99 1] "unknown_handle"
  refusedRequests s "id-zero" [listen 0] "id_order"
  refusedRequests s "id-cap+1" [listen (maxId+1)] "integer_width"
  refusedRequests s "handle-cap+1" [read 1 (maxId+1) 1] "integer_width"
  refusedRequests s "unauthorized-port" [{ (listen 1) with argument := 1 }] "arguments"
  refusedRequests s "port-width-cap+1" [{ (listen 1) with argument := 65536 }] "arguments"
  refusedRequests s "read-zero" [read 1 99 0] "arguments"
  refusedRequests s "read-payload-cap+1" [read 1 99 4097] "arguments"
  refusedRequests s "write-empty" [write 1 99 ByteArray.empty] "arguments"
  refused s "write-offset" 118 ((← u 4 1) ++ (← u 8 1) ++ (← u 4 encoded.size) ++ encoded) "write_offset"
  refused s "read-offset" 116 ((← u 4 1) ++ (← u 8 1) ++ (← u 4 8168)) "read_offset"
  readCount s "read-count-zero" 0
  readCount s "read-count-b-1" 4133
  readCount s "read-count-cap+1" 8169

def setup (s : Session) : IO Unit := do
  let v ← exchange s 100 65535 ((← u 4 8192) ++ (← str "9P2000"))
  require (v[4]!.toNat == 101) "Rversion"
  let a ← exchange s 104 0 ((← u 4 0) ++ (← u 4 4294967295) ++ (← str "") ++ (← str s.namespaceQ))
  require (a[4]!.toNat == 105) "Rattach"
  let w ← exchange s 110 0 ((← u 4 0) ++ (← u 4 1) ++ (← u 2 2) ++ (← str "net") ++ (← str "queue"))
  require (w[4]!.toNat == 111 && w.size == 35 && w[7]!.toNat == 2 && w[8]!.toNat == 0) "Rwalk-full-path"
  refused s "open-write-only" 112 ((← u 4 1) ++ (← u 1 1)) "open_mode"
  let o ← exchange s 112 0 ((← u 4 1) ++ (← u 1 2))
  require (o[4]!.toNat == 113) "Ropen"

def submit (s : Session) (requests : List Submission) : IO Unit := do
  let encoded ← lift (Wire.submit ⟨config, ← s.state.get, requests⟩)
  let r ← exchange s 118 0 ((← u 4 1) ++ (← u 8 0) ++ (← u 4 encoded.bytes.size) ++ encoded.bytes)
  require (r[4]!.toNat == 119 && r.size == 11) "Rwrite"
  let (n, _) ← lift (Wire.getNat 4 ⟨r, 7⟩)
  require (n == encoded.bytes.size) "short-submission"
  s.state.set encoded.next

def reap (s : Session) (count : Nat := 8168) : IO (List Reply) := do
  let r ← exchange s 116 0 ((← u 4 1) ++ (← u 8 0) ++ (← u 4 count))
  require (r[4]!.toNat == 117) "Rread"
  let (n, _) ← lift (Wire.getNat 4 ⟨r, 7⟩)
  require (n+11 == r.size) "Rread-count"
  let replies ← lift (CompletionWire.decodeBatch config (r.extract 11 r.size))
  let next ← lift (Web.Net.Completions.runNF ⟨config, ← s.state.get, replies⟩)
  require (stateValid config next) "completion-state-invariant"
  s.state.set next
  return replies

def terminal : Nat → Session → IO (List Reply)
  | 0, _ => throw (IO.userError "completion-budget")
  | n+1, s => do
    let rs ← reap s
    if rs.isEmpty then terminal n s else return rs

def getOne (s : Session) (id : Nat) : IO Reply := do
  let rs ← terminal 32 s
  match rs with
  | [r] =>
    require (r.id == id && r.status == .success) ("completion:" ++ toString id)
    return r
  | _ => throw (IO.userError ("completion-count:" ++ toString id))

def received : Nat → Session → Nat → ByteArray → IO (Nat × ByteArray)
  | 0, _, _, _ => throw (IO.userError "read-split-budget")
  | fuel+1, s, id, acc => do
    if acc.size == 5 then return (id, acc)
    submit s [read id 2 (5-acc.size)]
    let r ← getOne s id
    received fuel s (id+1) (acc ++ r.payload)

def sent : Nat → Session → Nat → ByteArray → IO Nat
  | 0, _, _, _ => throw (IO.userError "write-split-budget")
  | fuel+1, s, id, bs => do
    if bs.isEmpty then return id
    submit s [write id 2 bs]
    let r ← getOne s id
    sent fuel s (id+1) (bs.extract r.result bs.size)

def run (serverBinary dir : String) : IO UInt32 := do
  let socket := dir ++ "/device.sock"
  IO.FS.createDirAll dir
  let context ← declaredContext
  require (Web.Net.Context.admissible context.contract context) "context-before-device-open"
  let namespaceQ := hex context.namespaceQ
  for (name,b) in [("namespace",Context.namespaceBytes context.manifest),
    ("config",Context.configBytes context.config),("profile",Context.profileBytes context.profile),
    ("contract",Context.contractBytes context.contract)] do
    IO.FS.writeBinFile (dir ++ "/" ++ name ++ ".rval") b
  let server ← spawn serverBinary #[socket,namespaceQ]
  try
    let ready ← server.stdout.getLine
    if ready.trim != "ready" then
      let errors ← server.stderr.readToEnd
      IO.FS.writeFile (dir ++ "/server.stderr") errors
      throw (IO.userError ("server-ready:" ++ errors))
    let nc ← spawn "nc" #["-U",socket]
    try
      let session : Session := ⟨nc, dir, ← IO.mkRef {}, ← IO.mkRef #[], ← IO.mkRef #[], namespaceQ⟩
      setup session
      emptyQueueChecks session
      require (← reap session 4134).isEmpty "read-count-b"
      require (← reap session 4135).isEmpty "read-count-b+1"
      require (← reap session).isEmpty "empty-reap"
      submit session [listen 1]
      refusedRequests session "creation-not-visible-before-reap" [accept 2 1] "unknown_handle"
      readCount session "small-read-does-not-consume-completion" 4133
      let listening ← getOne session 1
      refusedRequests session "listeners-cap+1" [listen 2] "listeners"
      refusedRequests session "read-listener-kind" [read 2 1 1] "handle_kind"
      let peer ← spawn "nc" #["127.0.0.1",toString listening.result]
      try
        submit session [accept 2 1]
        refusedRequests session "duplicate-accept-before-reap" [accept 3 1] "duplicate_operation"
        let accepted ← getOne session 2
        require (accepted.handle == 2) "creation-handle"
        refusedRequests session "accept-stream-kind" [accept 3 2] "handle_kind"
        refusedRequests session "atomic-no-early-write" [write 3 2 (bytes [42]),read 4 99 1] "unknown_handle"
        refusedRequests session "atomic-no-early-close" [close 3 2,write 4 2 (bytes [42])] "closing"
        refusedRequests session "atomic-duplicate-read" [read 3 2 1,read 4 2 1] "duplicate_operation"
        refusedRequests session "atomic-duplicate-id" [write 3 2 (bytes [42]),write 3 2 (bytes [43])] "id_order"
        let payload := bytes [0,255,42,13,10]
        peer.stdin.write payload
        peer.stdin.flush
        let (id, actual) ← received 16 session 3 ByteArray.empty
        require (actual.data == payload.data) "binary-read"
        let id ← sent 16 session id payload
        let observed ← readExact peer.stdout payload.size
        require (observed.data == payload.data) "binary-write"
        -- Pending read followed by close must each produce one terminal result.
        submit session [read id 2 1, close (id+1) 2]
        refusedRequests session "closing-before-reap" [write (id+2) 2 (bytes [42])] "closing"
        let terminalReplies ← terminal 32 session
        require (terminalReplies.length == 2) "cancellation-count"
        require (terminalReplies.any (fun r => r.id == id && r.status == .cancelled)) "pending-read-cancelled"
        require (terminalReplies.any (fun r => r.id == id+1 && r.status == .success)) "close-success"
        require ((← session.state.get).resources.length == 1) "stream-released"
        refusedRequests session "closed-handle" [read (id+2) 2 1] "unknown_handle"
        -- A rejected batch must not consume the next ID or issue a socket call.
        refusedRequests session "id-reuse-after-reap" [accept (id+1) 1] "id_order"
        submit session [close (id+2) 1]
        let _ ← getOne session (id+2)
        require ((← session.state.get).resources.isEmpty && (← session.state.get).pending.isEmpty) "resources-released"
        let clunk ← exchange session 120 0 (← u 4 1)
        require (clunk[4]!.toNat == 121) "Rclunk"
        let report := Json.mkObj [("scope",toJson "loopback device probe through raw 9P; stock-Lean adapter"),
          ("namespace_q",toJson namespaceQ),("config_q",toJson (hex context.configQ)),
          ("contract_q",toJson (hex context.contractQ)),("profile_q",toJson (hex context.profileQ)),
          ("context_admitted_before_open",toJson true),("named_refusals",toJson (← session.checks.get)),("transactions",toJson (← session.transactions.get)),("port",toJson listening.result),
          ("payload",toJson ([0,255,42,13,10] : List Nat)),("closure_claim",toJson (0 : Nat)),
          ("gaps",toJson (["generic effect plan admission", "Proc client", "extended fault conformance",
            "HTTP", "fault simulation", "load baseline"] : List String))]
        IO.FS.writeFile (dir ++ "/report.json") (report.pretty ++ "\n")
        IO.println report.compress
      finally stop peer
    finally stop nc
  finally
    stop server
    try IO.FS.removeFile socket catch _ => pure ()
  return 0
end Web.Net.HostProbe

def main (args : List String) : IO UInt32 := Web.Net.HostProbe.run
  (args.headD "out/web-net-host-r1/target/debug/residua-net-device")
  ((args[1]?).getD Web.Net.HostProbe.defaultDirectory)
