namespace Web.Http.Codec
open Lean Web.StdHttp Web.StdHttp.Protocol.H1

-- Explicit data-only schema for the persistent H1 machine. No host handles,
-- closures or hidden maps occur here. Header lookup indexes are rebuilt from
-- their ordered entries; all protocol state and counters are retained.
inductive Residue where
  | array | index | natural | boolean | string | octet | tag | value
  | inputPosition | readerDepth | configuration
  deriving BEq, Repr

def residueName : Residue → String
  | .array => "http_codec_array"
  | .index => "http_codec_index"
  | .natural => "http_codec_nat"
  | .boolean => "http_codec_bool"
  | .string => "http_codec_string"
  | .octet => "http_codec_octet"
  | .tag => "http_codec_tag"
  | .value => "http_codec_value"
  | .inputPosition => "http_codec_input_position"
  | .readerDepth => "http_codec_reader_depth"
  | .configuration => "http_codec_configuration"

def arr (xs : List Json) : Json := Json.arr xs.toArray
def nat (x : Nat) : Json := toJson x
def bool (x : Bool) : Json := toJson x
def str (x : String) : Json := toJson x
def optional (f : α → Json) : Option α → Json
  | none => Json.null
  | some v => arr [f v]
def array (f : α → Json) (xs : Array α) : Json := Json.arr (xs.map f)
-- Octets are one lowercase hex string: buffers dominate the continuation, and one JSON
-- string per buffer replaces one JSON number per octet.
def hexDigit (n : Nat) : Char := Char.ofNat (if n < 10 then 48 + n else 87 + n)
def byteArray (b : ByteArray) : Json :=
  Json.str (b.foldl (fun s x => (s.push (hexDigit (x.toNat / 16))).push (hexDigit (x.toNat % 16))) "")
def hexValue? (c : UInt8) : Option UInt8 :=
  if c >= 48 && c <= 57 then some (c - 48) else if c >= 97 && c <= 102 then some (c - 87) else none
def unhex? (t : String) : Option ByteArray := do
  let raw := t.toUTF8
  if raw.size % 2 != 0 then failure
  let mut out := ByteArray.mkEmpty (raw.size / 2)
  for i in [0:raw.size / 2] do
    out := out.push (16 * (← hexValue? (raw.get! (2 * i))) + (← hexValue? (raw.get! (2 * i + 1))))
  return out

def field (j : Json) (i : Nat) : Except Residue Json := do
  let xs ← j.getArr?.mapError (fun _ => .array)
  match xs[i]? with | none => throw .index | some x => pure x
def natural (j : Json) : Except Residue Nat := j.getNat?.mapError (fun _ => .natural)
def boolean (j : Json) : Except Residue Bool := j.getBool?.mapError (fun _ => .boolean)
def string (j : Json) : Except Residue String := j.getStr?.mapError (fun _ => .string)
def n (j : Json) (i : Nat) := field j i >>= natural
def b (j : Json) (i : Nat) := field j i >>= boolean
def s (j : Json) (i : Nat) := field j i >>= string
def need (x : Option α) : Except Residue α := match x with | some v => .ok v | none => .error .value
def decodeOptional (f : Json → Except Residue α) (j : Json) : Except Residue (Option α) :=
  if j == Json.null then pure none else some <$> (field j 0 >>= f)
def decodeArray (f : Json → Except Residue α) (j : Json) : Except Residue (Array α) := do
  let xs ← j.getArr?.mapError (fun _ => .array)
  xs.mapM f
def decodeByteArray (j : Json) : Except Residue ByteArray := do
  match unhex? (← string j) with | some b => pure b | none => throw .octet

def limits (c : Web.Http.Limits) : Json := arr [nat c.lineBytes,nat c.headerBytes,nat c.headerCount,nat c.bodyBytes,nat c.bufferBytes]
def decodeLimits (j : Json) : Except Residue Web.Http.Limits := do
  return ⟨← n j 0,← n j 1,← n j 2,← n j 3,← n j 4⟩

def headers (h : Headers) := array (fun (k,v) => arr [str k.value,str v.value]) h.map.toArray
def decodeHeaders (j : Json) : Except Residue Headers := do
  let pairs ← decodeArray (fun x => do
    let k ← s x 0 >>= fun x => need (Header.Name.ofString? x)
    let v ← s x 1 >>= fun x => need (Header.Value.ofString? x)
    return (k,v)) j
  return pairs.foldl (fun h (k,v) => h.insert k v) Headers.empty

def version : Version → Json
  | .v10 => nat 10 | .v11 => nat 11 | .v20 => nat 20 | .v30 => nat 30
def decodeVersion (j : Json) : Except Residue Version := do
  match ← natural j with
  | 10 => pure .v10 | 11 => pure .v11 | 20 => pure .v20 | 30 => pure .v30
  | _ => throw .tag

def userInfo (u : URI.UserInfo) : Json := arr [byteArray u.username.toByteArray,optional (byteArray ∘ (·.toByteArray)) u.password]
def decodeUserInfo (j : Json) : Except Residue URI.UserInfo := do
  let u ← field j 0 >>= decodeByteArray >>= fun x => need (URI.EncodedUserInfo.ofByteArray? x)
  let p ← field j 1 >>= decodeOptional (fun j => decodeByteArray j >>= fun x => need (URI.EncodedUserInfo.ofByteArray? x))
  return ⟨u,p⟩
def host : URI.Host → Json
  | .name x => arr [nat 0,str x.val]
  | .ipv4 x => arr [nat 1,byteArray (ByteArray.mk x.octets)]
  | .ipv6 x => arr [nat 2,array (nat ∘ UInt16.toNat) x.segments]
def decodeHost (j : Json) : Except Residue URI.Host := do
  match ← n j 0 with
  | 0 => .name <$> (s j 1 >>= fun x => need (URI.DomainName.ofString? x))
  | 1 =>
    let xs ← field j 1 >>= decodeByteArray
    if h : xs.data.size = 4 then return .ipv4 ⟨xs.data,h⟩ else throw .value
  | 2 =>
    let xs ← field j 1 >>= decodeArray (fun j => do
      let n ← natural j
      if n > 65535 then throw .value
      pure n.toUInt16)
    if h : xs.size = 8 then return .ipv6 ⟨xs,h⟩ else throw .value
  | _ => throw .tag

def port : URI.Port → Json
  | .omitted => arr [nat 0] | .empty => arr [nat 1] | .value x => arr [nat 2,nat x.toNat]
def decodePort (j : Json) : Except Residue URI.Port := do
  match ← n j 0 with
  | 0 => pure .omitted | 1 => pure .empty
  | 2 =>
    let n ← n j 1
    if n > 65535 then throw .value
    pure (.value n.toUInt16)
  | _ => throw .tag

def authority (a : URI.Authority) : Json := arr [optional userInfo a.userInfo,host a.host,port a.port]
def decodeAuthority (j : Json) : Except Residue URI.Authority := do
  return ⟨← field j 0 >>= decodeOptional decodeUserInfo,← field j 1 >>= decodeHost,← field j 2 >>= decodePort⟩
def path (p : URI.Path) : Json := arr [array (byteArray ∘ (·.toByteArray)) p.segments,bool p.absolute]
def decodePath (j : Json) : Except Residue URI.Path := do
  let xs ← field j 0 >>= decodeArray (fun j => decodeByteArray j >>= fun x => need (URI.EncodedSegment.ofByteArray? x))
  return ⟨xs,← b j 1⟩
def query (q : URI.Query) : Json := array (fun (k,v) => arr [byteArray k.toByteArray,optional (byteArray ∘ (·.toByteArray)) v]) q

def decodeQuery (j : Json) : Except Residue URI.Query := decodeArray (fun j => do
  let k ← field j 0 >>= decodeByteArray >>= fun x => need (URI.EncodedQueryParam.ofByteArray? x)
  let v ← field j 1 >>= decodeOptional (fun j => decodeByteArray j >>= fun x => need (URI.EncodedQueryParam.ofByteArray? x))
  return (k,v)) j

def uri (u : URI) : Json := arr [str u.scheme.val,optional authority u.authority,path u.path,query u.query,optional str u.fragment]
def decodeUri (j : Json) : Except Residue URI := do
  let scheme ← s j 0 >>= fun x => need (URI.Scheme.ofString? x)
  return ⟨scheme,← field j 1 >>= decodeOptional decodeAuthority,← field j 2 >>= decodePath,
    ← field j 3 >>= decodeQuery,← field j 4 >>= decodeOptional string⟩
def target : RequestTarget → Json
  | .originForm p q => arr [nat 0,path p,optional query q]
  | .absoluteForm u => arr [nat 1,uri u]
  | .authorityForm a => arr [nat 2,authority a]
  | .asteriskForm => arr [nat 3]
def decodeTarget (j : Json) : Except Residue RequestTarget := do
  match ← n j 0 with
  | 0 => return .originForm (← field j 1 >>= decodePath) (← field j 2 >>= decodeOptional decodeQuery)
  | 1 => .absoluteForm <$> (field j 1 >>= decodeUri)
  | 2 => .authorityForm <$> (field j 1 >>= decodeAuthority)
  | 3 => pure .asteriskForm
  | _ => throw .tag

def requestHead (h : Web.StdHttp.Request.Head) : Json := arr [str (toString h.method),version h.version,target h.uri,headers h.headers]
def decodeRequestHead (j : Json) : Except Residue Web.StdHttp.Request.Head := do
  let method ← s j 0 >>= fun x => need (Method.ofString? x)
  return ⟨method,← field j 1 >>= decodeVersion,← field j 2 >>= decodeTarget,← field j 3 >>= decodeHeaders⟩
def status (x : Status) : Json := arr [nat x.toCode.toNat,str x.reasonPhrase]
def decodeStatus (j : Json) : Except Residue Status := do
  let code ← n j 0
  if code > 65535 then throw .value
  let phrase ← s j 1
  if h : IsValidReasonPhrase phrase then
    need (Status.ofCode (some ⟨phrase,h⟩) code.toUInt16)
  else throw .value

def responseHead (h : Web.StdHttp.Response.Head) : Json := arr [status h.status,version h.version,headers h.headers]
def decodeResponseHead (j : Json) : Except Residue Web.StdHttp.Response.Head := do
  return ⟨← field j 0 >>= decodeStatus,← field j 1 >>= decodeVersion,← field j 2 >>= decodeHeaders⟩

def extension (x : Chunk.ExtensionName × Option Chunk.ExtensionValue) : Json := arr [str x.1.value,optional (str ∘ (·.value)) x.2]
def decodeExtension (j : Json) : Except Residue (Chunk.ExtensionName × Option Chunk.ExtensionValue) := do
  let k ← s j 0 >>= fun x => need (Chunk.ExtensionName.ofString? x)
  let v ← field j 1 >>= decodeOptional (fun j => string j >>= fun x => need (Chunk.ExtensionValue.ofString? x))
  return (k,v)
def chunk (x : Chunk) : Json := arr [byteArray x.data,array extension x.extensions]
def decodeChunk (j : Json) : Except Residue Chunk := do
  return ⟨← field j 0 >>= decodeByteArray,← field j 1 >>= decodeArray decodeExtension⟩
def bodyLength : Body.Length → Json
  | .fixed n => arr [nat 0,nat n] | .chunked => arr [nat 1]
def decodeBodyLength (j : Json) : Except Residue Body.Length := do
  match ← n j 0 with | 0 => .fixed <$> n j 1 | 1 => pure .chunked | _ => throw .tag

def bodyState : Reader.BodyState → Json
  | .fixed n => arr [nat 0,nat n] | .chunkedSize => arr [nat 1]
  | .chunkedBody ex n => arr [nat 2,array extension ex,nat n]
  | .closeDelimited => arr [nat 3]
def decodeBodyState (j : Json) : Except Residue Reader.BodyState := do
  match ← n j 0 with
  | 0 => .fixed <$> n j 1 | 1 => pure .chunkedSize
  | 2 => return .chunkedBody (← field j 1 >>= decodeArray decodeExtension) (← n j 2)
  | 3 => pure .closeDelimited | _ => throw .tag

def error : Error → Json
  | .invalidStatusLine => arr [nat 0] | .invalidHeader => arr [nat 1]
  | .timeout => arr [nat 2] | .entityTooLarge => arr [nat 3]
  | .uriTooLong => arr [nat 4] | .unsupportedVersion => arr [nat 5]
  | .invalidChunk => arr [nat 6] | .connectionClosed => arr [nat 7]
  | .badMessage => arr [nat 8] | .tooManyHeaders => arr [nat 9]
  | .headersTooLarge => arr [nat 10] | .other x => arr [nat 11,str x]
def decodeError (j : Json) : Except Residue Error := do
  match ← n j 0 with
  | 0 => pure .invalidStatusLine | 1 => pure .invalidHeader
  | 2 => pure .timeout | 3 => pure .entityTooLarge | 4 => pure .uriTooLong
  | 5 => pure .unsupportedVersion | 6 => pure .invalidChunk
  | 7 => pure .connectionClosed | 8 => pure .badMessage
  | 9 => pure .tooManyHeaders | 10 => pure .headersTooLarge
  | 11 => .other <$> s j 1 | _ => throw .tag

def readerState : Reader.State .receiving → Json
  | .needStartLine => arr [nat 0] | .needHeader n => arr [nat 1,nat n]
  | .readBody x => arr [nat 2,bodyState x] | .«continue» x => arr [nat 3,readerState x]
  | .pending => arr [nat 4] | .complete => arr [nat 5] | .closed => arr [nat 6]
  | .failed e => arr [nat 7,error e]
def decodeReaderState : Nat → Json → Except Residue (Reader.State .receiving)
  | 0, _ => .error .readerDepth
  | fuel+1, j => do
    match ← n j 0 with
    | 0 => pure .needStartLine | 1 => .needHeader <$> n j 1
    | 2 => .readBody <$> (field j 1 >>= decodeBodyState)
    | 3 => .«continue» <$> (field j 1 >>= decodeReaderState fuel)
    | 4 => pure .pending | 5 => pure .complete | 6 => pure .closed
    | 7 => .failed <$> (field j 1 >>= decodeError) | _ => throw .tag

def writerState : Writer.State → Json
  | .pending => arr [nat 0] | .waitingHeaders => arr [nat 1]
  | .waitingForFlush => arr [nat 2] | .writingBodyFixed n => arr [nat 3,nat n]
  | .writingBodyChunked => arr [nat 4] | .writingBodyClosingFrame => arr [nat 5]
  | .complete => arr [nat 6] | .closed => arr [nat 7]
def decodeWriterState (j : Json) : Except Residue Writer.State := do
  match ← n j 0 with
  | 0 => pure .pending | 1 => pure .waitingHeaders | 2 => pure .waitingForFlush
  | 3 => .writingBodyFixed <$> n j 1 | 4 => pure .writingBodyChunked
  | 5 => pure .writingBodyClosingFrame | 6 => pure .complete
  | 7 => pure .closed | _ => throw .tag

def event : Web.StdHttp.Protocol.H1.Event .receiving → Json
  | .endHeaders h => arr [nat 0,requestHead h] | .needMoreData n => arr [nat 1,optional nat n]
  | .failed e => arr [nat 2,error e] | .close => arr [nat 3] | .closeBody => arr [nat 4]
  | .needAnswer => arr [nat 5] | .next => arr [nat 6] | .«continue» => arr [nat 7]
def decodeEvent (j : Json) : Except Residue (Web.StdHttp.Protocol.H1.Event .receiving) := do
  match ← n j 0 with
  | 0 => .endHeaders <$> (field j 1 >>= decodeRequestHead)
  | 1 => .needMoreData <$> (field j 1 >>= decodeOptional natural)
  | 2 => .failed <$> (field j 1 >>= decodeError) | 3 => pure .close
  | 4 => pure .closeBody | 5 => pure .needAnswer | 6 => pure .next
  | 7 => pure .«continue» | _ => throw .tag

def reader (r : Reader .receiving) : Json := arr [readerState r.state,byteArray r.input.array,nat r.input.pos,
  requestHead r.messageHead,nat r.messageCount,nat r.bodyBytesRead,nat r.headerBytesRead,bool r.noMoreInput]
def decodeReader (j : Json) : Except Residue (Reader .receiving) := do
  let data ← field j 1 >>= decodeByteArray
  let pos ← n j 2
  if pos > data.size then throw .inputPosition
  return ⟨← field j 0 >>= decodeReaderState 2,⟨data,pos⟩,← field j 3 >>= decodeRequestHead,
    ← n j 4,← n j 5,← n j 6,← b j 7⟩
def writer (w : Writer .receiving) : Json := arr [array chunk w.userData,array byteArray w.outputData.data,nat w.outputData.size,
  writerState w.state,optional bodyLength w.knownSize,responseHead w.messageHead,bool w.sentMessage,
  bool w.userClosedBody,bool w.omitBody,nat w.userDataBytes]
def decodeWriter (j : Json) : Except Residue (Writer .receiving) := do
  let data ← field j 0 >>= decodeArray decodeChunk
  let output ← field j 1 >>= decodeArray decodeByteArray
  let size ← n j 2
  let dataBytes ← n j 9
  if size != output.foldl (fun n b => n+b.size) 0 || dataBytes != data.foldl (fun n c => n+c.data.size) 0 then throw .value
  return ⟨data,⟨output,size⟩,← field j 3 >>= decodeWriterState,← field j 4 >>= decodeOptional decodeBodyLength,
    ← field j 5 >>= decodeResponseHead,← b j 6,← b j 7,← b j 8,dataBytes⟩

def config (c : Config) : Json := arr [nat c.maxMessages,
  nat c.maxHeaders,
  nat c.maxHeaderBytes,
  bool c.enableKeepAlive,
  optional (str ∘ (·.value)) c.agentName,
  nat c.maxUriLength,
  nat c.maxStartLineLength,
  nat c.maxHeaderNameLength,
  nat c.maxHeaderValueLength,
  nat c.maxSpaceSequence,
  nat c.maxLeadingEmptyLines,
  nat c.maxChunkExtensions,
  nat c.maxChunkExtNameLength,
  nat c.maxChunkExtValueLength,
  nat c.maxChunkLineLength,
  nat c.maxChunkSize,
  nat c.maxBodySize,
  nat c.maxReasonPhraseLength,
  nat c.maxTrailerHeaders]
def decodeConfig (j : Json) : Except Residue Config := do
  return ⟨← n j 0,
    ← n j 1,
    ← n j 2,
    ← b j 3,
    ← field j 4 >>= decodeOptional (fun j => string j >>= fun x => need (Header.Value.ofString? x)),
    ← n j 5,
    ← n j 6,
    ← n j 7,
    ← n j 8,
    ← n j 9,
    ← n j 10,
    ← n j 11,
    ← n j 12,
    ← n j 13,
    ← n j 14,
    ← n j 15,
    ← n j 16,
    ← n j 17,
    ← n j 18⟩

-- The configuration is a function of the limits; it is written out only when it differs,
-- and decoding refuses any written configuration exactly as it refused a differing one.
def machine (l : Web.Http.Limits) (m : Web.Http.Core) : Json :=
  let c := config m.config
  arr [reader m.reader,writer m.writer,if c == config (Web.Http.coreConfig l) then Json.null else c,
    array event m.events,optional error m.error,bool m.keepAlive,bool m.forcedFlush,bool m.pullBodyStalled]
def decodeMachine (l : Web.Http.Limits) (j : Json) : Except Residue Web.Http.Core := do
  if (← field j 2) != Json.null then throw .configuration
  return ⟨← field j 0 >>= decodeReader,← field j 1 >>= decodeWriter,Web.Http.coreConfig l,
    ← field j 3 >>= decodeArray decodeEvent,← field j 4 >>= decodeOptional decodeError,← b j 5,← b j 6,← b j 7⟩

def applicationRequest (r : Web.Request) : Json := arr [str r.method,str r.target,
  arr (r.headers.map fun h => arr [str h.name,str h.value]),byteArray r.body]
def decodeApplicationRequest (j : Json) : Except Residue Web.Request := do
  let hs ← field j 2 >>= decodeArray (fun x => do return (⟨← s x 0,← s x 1⟩ : Web.Header))
  return ⟨← s j 0,← s j 1,hs.toList,← field j 3 >>= decodeByteArray⟩
def waiting (w : Web.Http.Waiting) : Json := arr [applicationRequest w.request,bool w.keepAlive]
def decodeWaiting (j : Json) : Except Residue Web.Http.Waiting := do
  return ⟨← field j 0 >>= decodeApplicationRequest,← b j 1⟩

def encode (s : Web.Http.State) : Json := arr [nat 2,limits s.limits,optional (machine s.limits) s.core,byteArray s.body,
  optional waiting s.waiting,bool s.closed,bool s.eof,nat s.completed]
def decode (j : Json) : Except Residue Web.Http.State := do
  if (← n j 0) != 2 then throw .tag
  let c ← field j 1 >>= decodeLimits
  let m ← field j 2 >>= decodeOptional (decodeMachine c)
  return ⟨m,c,← field j 3 >>= decodeByteArray,← field j 4 >>= decodeOptional decodeWaiting,
    ← b j 5,← b j 6,← n j 7⟩
end Web.Http.Codec
