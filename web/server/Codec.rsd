namespace Web.Server.Codec
open Lean

inductive Residue where
  | jsonArray | jsonIndex (index : Nat) | jsonNat | jsonBool | jsonString
  | jsonSyntax | octet | netState | connections
  | operation (cause : Net.Wire.Residue)
  | continuationCap | continuationBytes | utf8 | canonical
  | httpState (cause : Http.Codec.Residue)
  deriving BEq, Repr

def residueName : Residue → String
  | .jsonArray => "server_codec_json_array"
  | .jsonIndex i => "server_codec_json_index:" ++ toString i
  | .jsonNat => "server_codec_json_nat"
  | .jsonBool => "server_codec_json_bool"
  | .jsonString => "server_codec_json_string"
  | .jsonSyntax => "server_codec_json_syntax"
  | .octet => "server_codec_octet"
  | .netState => "server_codec_net_state"
  | .connections => "server_codec_connections"
  | .operation cause => Net.Wire.residueName cause
  | .continuationCap => "server_continuation_cap"
  | .continuationBytes => "server_continuation_bytes"
  | .utf8 => "server_continuation_utf8"
  | .canonical => "server_continuation_canonical"
  | .httpState cause => Http.Codec.residueName cause

def arr (xs : List Json) := Json.arr xs.toArray
def nat := toJson (α := Nat)
def boolean := toJson (α := Bool)
def bytes := Http.Codec.byteArray
def field (j : Json) (n : Nat) : Except Residue Json := do
  let a ← j.getArr?.mapError (fun _ => .jsonArray)
  match a[n]? with
  | some value => return value
  | none => throw (.jsonIndex n)
def n (j : Json) (i : Nat) : Except Residue Nat := do (← field j i).getNat?.mapError (fun _ => .jsonNat)
def b (j : Json) (i : Nat) : Except Residue Bool := do (← field j i).getBool?.mapError (fun _ => .jsonBool)
def text (j : Json) (i : Nat) : Except Residue String := do (← field j i).getStr?.mapError (fun _ => .jsonString)
def list (f : Json → Except Residue α) (j : Json) : Except Residue (List α) := do
  (← j.getArr?.mapError (fun _ => Residue.jsonArray)).toList.mapM f
def decodeBytes (j : Json) : Except Residue ByteArray := do
  let t ← j.getStr?.mapError (fun _ => Residue.jsonString)
  match Http.Codec.unhex? t with | some b => pure b | none => throw .octet

def header (h : Header) := arr [toJson h.name,toJson h.value]
def decodeHeader (j : Json) : Except Residue Header := do return ⟨← text j 0,← text j 1⟩
def request (r : Request) := arr [toJson r.method,toJson r.target,arr (r.headers.map header),bytes r.body]
def decodeRequest (j : Json) : Except Residue Request := do
  return ⟨← text j 0,← text j 1,← list decodeHeader (← field j 2),← decodeBytes (← field j 3)⟩
def http := Http.Codec.encode
def decodeHttp (j : Json) : Except Residue Http.State :=
  (Http.Codec.decode j).mapError Residue.httpState
def resource (r : Net.Resource) := arr [nat r.handle,boolean r.listener,boolean r.closing,boolean r.closed,boolean r.eof]
def decodeResource (j : Json) : Except Residue Net.Resource := do return ⟨← n j 0,← b j 1,← b j 2,← b j 3,← b j 4⟩
def submission (r : Net.Submission) := arr [nat r.id,nat (Net.Wire.opNumber r.op),nat r.handle,nat r.argument,bytes r.payload]
def decodeSubmission (j : Json) : Except Residue Net.Submission := do
  let op ← (Net.Wire.getOp (← n j 1)).mapError Residue.operation
  return ⟨← n j 0,op,← n j 2,← n j 3,← decodeBytes (← field j 4)⟩
def connection (c : Connection) := arr [nat c.handle,http c.http,bytes c.output,boolean c.closing,
  arr (c.file.toList.map request),nat c.fileId]
def decodeConnection (j : Json) : Except Residue Connection := do
  let file ← list decodeRequest (← field j 4)
  if file.length > 1 then throw .connections
  return ⟨← n j 0,← decodeHttp (← field j 1),← decodeBytes (← field j 2),← b j 3,file.head?,← n j 5⟩
def state (s : State) := arr [nat s.net.lastId,arr (s.net.resources.map resource),arr (s.net.pending.map submission),
  arr (s.connections.map connection),nat s.listener,nat s.port,nat s.requests,nat s.protocolRefusals]
def decodeState (j : Json) : Except Residue State := do
  let net : Net.State := ⟨← list decodeResource (← field j 1),← list decodeSubmission (← field j 2),← n j 0⟩
  if !Net.stateValid netConfig net then throw .netState
  let connections ← list decodeConnection (← field j 3)
  if connections.length > connectionCap ||
      (connections.map (·.handle)).eraseDups.length != connections.length ||
      !connections.all (fun c => c.output.size <= outputCap && c.http.buffer.size <= httpLimits.bufferBytes &&
        (net.resources.find? (fun r => r.handle == c.handle && !r.listener)).isSome) then
    throw .connections
  return ⟨net,connections,← n j 4,← n j 5,← n j 6,← n j 7⟩

-- Continuation environment is explicit canonical JSON octets, not a hidden IO map.
-- The finite bound is also checked on deserialization before parsing.
def cap : Nat := 16777216
def encodeBytes (s : State) : Except Residue ByteArray := do
  let raw := (state s).compress.toUTF8
  if raw.size > cap then throw .continuationCap
  return raw
def encodeCore (s : State) : Except Residue (List Int) := do
  return (← encodeBytes s).data.foldr (fun b xs => Int.ofNat b.toNat :: xs) []
-- One pass: the length bound and the octet range are checked while the bytes are built.
def octetBytes (raw : List Int) : Except Residue ByteArray := do
  let mut out := ByteArray.empty
  for x in raw do
    if out.size >= cap || x < 0 || x > 255 then throw .continuationBytes
    out := out.push (UInt8.ofNat x.toNat)
  return out
def decodeCore (raw : List Int) : Except Residue State := do
  let raw ← octetBytes raw
  let text ← match String.fromUTF8? raw with | none => throw .utf8 | some s => pure s
  let j ← (Json.parse text).mapError (fun _ => .jsonSyntax)
  let s ← decodeState j
  -- Exact re-encoding rejects ignored extra fields, alternate JSON and stale schema.
  if (← encodeBytes s).data != raw.data then throw .canonical
  return s
inductive Input where
  | encode (state : State)
  | decode (raw : List Int)

def Output : Input → Type
  | .encode _ => List Int
  | .decode _ => State

def runNF (i : Input) : Except Residue (Output i) :=
  match i with
  | .encode s => encodeCore s
  | .decode raw => decodeCore raw
def residue? (i : Input) : Option Residue :=
  match runNF i with
  | .error cause => some cause
  | .ok _ => none
def admissible (i : Input) := (residue? i).isNone

def encode (s : State) : Except String (List Int) :=
  (runNF (.encode s)).mapError residueName
def decode (raw : List Int) : Except String State :=
  (runNF (.decode raw)).mapError residueName

end Web.Server.Codec
