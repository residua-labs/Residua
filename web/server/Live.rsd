namespace Web.Server.Live
open Lean
abbrev Child := Net.HostProbe.Child
abbrev Client := Child × String × String

def require := Net.HostProbe.require
def spawn := Net.HostProbe.spawn
def stop := Net.HostProbe.stop

def exchange (pipe : Child) (p : Driver.Proc) (dir : String) (index : Nat) (record : Bool) : IO ByteArray := do
  require (p.tag == 1) ("proc-refused:" ++ reprStr p.res)
  let raw ← IO.ofExcept (Driver.fromOctets p.req)
  pipe.stdin.write raw
  pipe.stdin.flush
  let frameHead ← Net.HostProbe.readExact pipe.stdout 4
  let n ← IO.ofExcept (Driver.get 4 frameHead 0)
  require (7 <= n && n <= 8192) "live-frame-length"
  let reply := frameHead ++ (← Net.HostProbe.readExact pipe.stdout (n-4))
  if record then
    IO.FS.writeBinFile (dir ++ s!"/{index}-T.bin") raw
    IO.FS.writeBinFile (dir ++ s!"/{index}-R.bin") reply
  return reply

def clients (port : Nat) : IO (List Client) := do
  let mut cs := []
  for (name,path,body,expected) in [
      ("hello","/hello","","Hello, world!\n"),
      ("static","/index.txt","","residua static asset\n"),
      ("echo","/echo"," {\"seed\":42,\"v\":[true,null]}\n","{\"seed\":42,\"v\":[true,null]}")] do
    let args := #["--silent","--show-error","--fail-with-body","--http1.1","--max-time","10",
      "--noproxy","*","--header","Connection: close","--write-out","\n%{http_code}"] ++
      (if name == "echo" then #["--header","Content-Type: application/json","--data-binary",body] else #[]) ++
      #[s!"http://127.0.0.1:{port}{path}"]
    let child ← spawn "curl" args
    cs := cs ++ [(child,expected ++ "\n200",name)]
  return cs

def pump (fuel : Nat) (sy : Http.Syntax) (pipe : Child) (dir : String)
    (initial : Driver.Proc) (probe : Bool) (children : IO.Ref (List Client)) : IO Json := do
  let mut p := initial
  let mut port := 0
  let mut ticks := 0
  for _ in List.range fuel do
    let r ← exchange pipe p dir ticks probe
    p := Driver.resume sy p (Driver.octets r)
    let s ← IO.ofExcept (Driver.state? p)
    ticks := ticks+1
    if port == 0 && s.port != 0 then
      port := s.port
      IO.println (Json.mkObj [("port",toJson port)]).compress
      (← IO.getStdout).flush
      if probe then children.set (← clients port)
    if probe && port != 0 && s.requests >= 3 && s.connections.isEmpty then
      let mut checks := #[]
      for (child,expected,name) in ← children.get do
        let exit ← child.wait
        children.modify (·.filter (fun (_,_,n) => n != name))
        let stdout ← child.stdout.readToEnd
        let stderr ← child.stderr.readToEnd
        require (exit == 0 && stdout == expected) ("client:" ++ name ++ ":" ++ stdout ++ ":" ++ stderr)
        checks := checks.push (Json.mkObj [("name",toJson name),("exit",toJson exit.toNat),
          ("actual",toJson stdout),("expected",toJson expected)])
      return Json.mkObj [("schema",toJson "WEB-SERVER-LIVE-r1"),("port",toJson port),
        ("transactions",toJson ticks),("requests",toJson s.requests),("checks",toJson checks),
        ("connections",toJson s.connections.length),("protocol_refusals",toJson s.protocolRefusals),
        ("context_admitted_before_open",toJson true),("closure_claim",toJson (0 : Nat))]
  throw (IO.userError "server_step_cap")

def replay (sy : Http.Syntax) (initial : Driver.Proc) (dir : String) : IO Json := do
  let saved ← IO.ofExcept (Json.parse (← IO.FS.readFile (dir ++ "/report.json")))
  let detail ← IO.ofExcept (saved.getObjVal? "run")
  let count ← IO.ofExcept (detail.getObjValAs? Nat "transactions")
  require (0 < count && count <= 4096) "replay-step-cap"
  let mut p := initial
  for i in List.range count do
    let sent ← IO.FS.readBinFile (dir ++ s!"/{i}-T.bin")
    let received ← IO.FS.readBinFile (dir ++ s!"/{i}-R.bin")
    require (p.tag == 1 && p.req == Driver.octets sent) s!"replay-request:{i}"
    p := Driver.resume sy p (Driver.octets received)
  let state ← IO.ofExcept (Driver.state? p)
  require (state.requests == 3 && state.connections.isEmpty && state.protocolRefusals == 0) "replay-final-state"
  return Json.mkObj [("transactions",toJson count),("requests",toJson state.requests),
    ("connections",toJson state.connections.length),("request_bytes_equal",toJson true),
    ("closure_claim",toJson (0 : Nat))]

def run (args : List String) : IO UInt32 := do
  let binary := args.headD "out/web-server-r1/target/debug/residua-net-device"
  let dir := (args[1]?).getD "out/web-server-r1/session"
  let mode := (args[2]?).getD "probe"
  let probe := mode == "probe"
  require (["probe","serve","replay"].contains mode) "server-mode"
  IO.FS.createDirAll dir
  let context ← Net.HostProbe.declaredContext
  require (Web.Net.Context.admissible context.contract context) "server-context-before-open"
  let q := Net.HostProbe.hex context.namespaceQ
  for (name,b) in [("namespace",Net.Context.namespaceBytes context.manifest),
      ("config",Net.Context.configBytes context.config),("profile",Net.Context.profileBytes context.profile),
      ("contract",Net.Context.contractBytes context.contract)] do
    IO.FS.writeBinFile (dir ++ "/" ++ name ++ ".rval") b
  let sy ← IO.ofExcept (Http.buildSyntax.mapError reprStr)
  let initial ← IO.ofExcept (Driver.start q)
  if mode == "replay" then
    let report ← replay sy initial dir
    IO.FS.writeFile (dir ++ "/replay.json") (report.pretty ++ "\n")
    IO.println report.compress
    return 0
  let socket := dir ++ "/device.sock"
  let server ← spawn binary #[socket,q,"web/load/assets"]
  try
    require ((← server.stdout.getLine).trim == "ready") "server-host-ready"
    let pipe ← spawn "nc" #["-U",socket]
    let cs ← IO.mkRef []
    try
      let result ← pump context.profile.maxSteps sy pipe dir initial probe cs
      let report := Json.mkObj [("run",result),("namespace_q",toJson q),
        ("config_q",toJson (Net.HostProbe.hex context.configQ)),
        ("profile_q",toJson (Net.HostProbe.hex context.profileQ)),
        ("contract_q",toJson (Net.HostProbe.hex context.contractQ))]
      IO.FS.writeFile (dir ++ "/report.json") (report.pretty ++ "\n")
      IO.println report.compress
    finally
      for (child,_,_) in ← cs.get do stop child
      stop pipe
  finally
    stop server
    try IO.FS.removeFile socket catch _ => pure ()
  return 0
end Web.Server.Live

def main (args : List String) : IO UInt32 := Web.Server.Live.run args
