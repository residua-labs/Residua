namespace Web.HttpGrammar.Matcher

-- Thompson construction and an ordered epsilon closure (Pike's capture rule).
-- Inputs are octets, including obs-text; UTF-8 is not a lexical prerequisite.
-- All instructions are generated from ABNF data. No HTTP field parser is here.
inductive Inst where
  | accept
  | consume (lo hi next : Nat)
  | jump (next : Nat)
  | split (first second : Nat)
  | save (slot next : Nat)
  deriving Repr, Inhabited

structure Program where
  code : Array Inst
  start : Nat
  groups : Array String

inductive Residue where
  | ruleName | duplicateRule | unresolvedRule | cyclicRule | rangeBounds
  | repeatBounds | instructionLimit | grammarDepth | programInvalid
  | closureBudget | inputLimit
  deriving BEq, Repr, DecidableEq

def residueName : Residue → String
  | .ruleName => "nf_http_grammar_rule_name"
  | .duplicateRule => "nf_http_grammar_duplicate_rule"
  | .unresolvedRule => "nf_http_grammar_unresolved_rule"
  | .cyclicRule => "nf_http_grammar_cyclic_rule"
  | .rangeBounds => "nf_http_grammar_range"
  | .repeatBounds => "nf_http_grammar_repeat"
  | .instructionLimit => "nf_http_grammar_instructions"
  | .grammarDepth => "nf_http_grammar_depth"
  | .programInvalid => "nf_http_matcher_program"
  | .closureBudget => "nf_http_matcher_closure_budget"
  | .inputLimit => "nf_http_matcher_input_limit"

structure Build where
  code : Array Inst := #[.accept]
  groups : Array String := #[]
  cap : Nat
abbrev Compiler := StateT Build (Except Residue)

def emit (inst : Inst) : Compiler Nat := do
  let state ← get
  if state.code.size >= state.cap then throw .instructionLimit
  set { state with code := state.code.push inst }
  return state.code.size

def compileNode : Nat → List Rule → List String → ABNF → Nat → Compiler Nat
  | 0, _, _, _, _ => throw .grammarDepth
  | fuel+1, rules, active, node, next => do
    match node with
    | .empty => return next
    | .range lo hi =>
      if lo > hi || hi > 255 then throw .rangeBounds
      emit (.consume lo hi next)
    | .literal text =>
      text.toUTF8.data.toList.reverse.foldlM (fun tail b => emit (.consume b.toNat b.toNat tail)) next
    | .sequence parts =>
      parts.reverse.foldlM (fun tail body => compileNode fuel rules active body tail) next
    | .alternative choices =>
      match choices.reverse with
      | [] => throw .repeatBounds
      | last :: rest =>
        let tail ← compileNode fuel rules active last next
        rest.foldlM (fun tail body => do
          let first ← compileNode fuel rules active body next
          emit (.split first tail)) tail
    | .reference name =>
      if active.contains name then throw .cyclicRule
      match rules.find? (fun r => r.name == name) with
      | none => throw .unresolvedRule
      | some rule => compileNode fuel rules (name :: active) rule.body next
    | .capture name body =>
      let state ← get
      let slot := state.groups.size*2
      set { state with groups := state.groups.push name }
      let finish ← emit (.save (slot+1) next)
      let middle ← compileNode fuel rules active body finish
      emit (.save slot middle)
    | .repeat min max body =>
      if min > 64 then throw .repeatBounds
      let tail ← match max with
        | some max => do
          if max < min || max > 64 then throw .repeatBounds
          (List.range (max-min)).foldlM (fun tail _ => do
            let first ← compileNode fuel rules active body tail
            emit (.split first tail)) next
        | none => do
          let loop ← emit (.jump next)
          let first ← compileNode fuel rules active body loop
          modify (fun s => { s with code := s.code.set! loop (.split first next) })
          pure loop
      (List.range min).foldlM (fun tail _ => compileNode fuel rules active body tail) tail

def programValid (p : Program) : Bool :=
  p.start < p.code.size && p.code.toList.all (fun inst => match inst with
    | .accept => true
    | .consume lo hi n => lo <= hi && hi <= 255 && n < p.code.size
    | .jump n => n < p.code.size
    | .split a b => a < p.code.size && b < p.code.size
    | .save slot n => slot < p.groups.size*2 && n < p.code.size)

def compile (rules : List Rule) (root : String) (cap : Nat := 65536) : Except Residue Program := do
  if rules.any (fun r => r.name.isEmpty) then throw .ruleName
  let names := rules.map (·.name)
  if names.eraseDups.length != names.length then throw .duplicateRule
  if cap == 0 then throw .instructionLimit
  let (start,state) ← (compileNode 128 rules [] (.reference root) 0).run { cap }
  let program := { code := state.code, start, groups := state.groups : Program }
  if !programValid program then throw .programInvalid
  return program

structure Thread where
  pc : Nat
  captures : Array (Option Nat)

-- Each PC is expanded once. At most two successors are queued per expanded PC;
-- roots + 2*code.size + 1 is therefore a finite work allowance per input byte.
def closureGo : Nat → Program → Nat → List Thread → Array Bool → List Thread → Except Residue (List Thread)
  | _, _, _, [], _, output => .ok output.reverse
  | 0, _, _, _ :: _, _, _ => .error .closureBudget
  | fuel+1, p, position, t :: rest, seen, output => do
    if t.pc >= p.code.size then throw .programInvalid
    if seen[t.pc]! then closureGo fuel p position rest seen output
    else
      let seen := seen.set! t.pc true
      match p.code[t.pc]! with
      | .accept | .consume _ _ _ => closureGo fuel p position rest seen (t :: output)
      | .jump next => closureGo fuel p position ({ t with pc := next } :: rest) seen output
      | .split first second => closureGo fuel p position ({ t with pc := first } :: { t with pc := second } :: rest) seen output
      | .save slot next => do
        if slot >= t.captures.size then throw .programInvalid
        closureGo fuel p position ({ pc := next, captures := t.captures.set! slot (some position) } :: rest) seen output

def closure (p : Program) (position : Nat) (roots : List Thread) :=
  closureGo (roots.length + 2*p.code.size + 1) p position roots (Array.mkArray p.code.size false) []

def advance (p : Program) (byte : Nat) (threads : List Thread) : List Thread := threads.filterMap fun t =>
  match p.code[t.pc]! with
  | .consume lo hi next => if lo <= byte && byte <= hi then some { t with pc := next } else none
  | _ => none

def walk (p : Program) : List UInt8 → Nat → List Thread → Except Residue (List Thread)
  | [], _, threads => .ok threads
  | byte :: rest, position, threads => do
    let threads ← closure p (position+1) (advance p byte.toNat threads)
    if threads.isEmpty then return []
    walk p rest (position+1) threads

structure Capture where
  name : String
  start : Nat
  stop : Nat
  value : ByteArray

-- Full matching only: a successful prefix never accepts trailing bytes.
-- Priority is deterministic, with greedy repeats and first alternative first.
def fullMatch (p : Program) (input : ByteArray) (inputCap : Nat := 8192) : Except Residue (Option (Array Capture)) := do
  if input.size > inputCap then throw .inputLimit
  if !programValid p then throw .programInvalid
  let roots := [{ pc := p.start, captures := Array.mkArray (p.groups.size*2) none : Thread }]
  let initial ← closure p 0 roots
  let finished ← walk p input.data.toList 0 initial
  match finished.find? (fun t => match p.code[t.pc]! with | .accept => true | _ => false) with
  | none => return none
  | some winner =>
    let mut captures := #[]
    for i in List.range p.groups.size do
      match winner.captures[2*i]!,winner.captures[2*i+1]! with
      | some start,some stop =>
        if start > stop || stop > input.size then throw .programInvalid
        captures := captures.push { name := p.groups[i]!, start, stop, value := input.extract start stop }
      | _, _ => pure ()
    return some captures

end Web.HttpGrammar.Matcher
