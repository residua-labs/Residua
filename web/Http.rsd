namespace Web.Http
open Web.HttpGrammar Web.HttpGrammar.Matcher

structure Limits where
  lineBytes : Nat := 8192
  headerBytes : Nat := 32768
  headerCount : Nat := 100
  bodyBytes : Nat := 1048576
  bufferBytes : Nat := 1114112
  deriving BEq, Repr

inductive Residue where
  | configuration | matcher | lineTooLarge | bareNewline | badRequestLine
  | version | target | headerTooLarge | headerCount | badHeader | host
  | contentLength | conflictingLength | transferEncoding | ambiguousFraming
  | bodyTooLarge | chunkSize | chunkTerminator | trailer | unexpectedEOF
  | bufferTooLarge | connectionClosed | responseUnexpected | responseStatus
  | responseHeader | responseFraming | unsupportedUpgrade | state
  | coreTimeout | coreBadMessage | coreOther (message : String) | actionBudget
  | head (status : Nat) | notImplemented | headDisagreement
  deriving BEq, Repr, DecidableEq

def residueName : Residue → String
  | .configuration => "nf_http_limits"
  | .matcher => "nf_http_grammar_matcher"
  | .lineTooLarge => "nf_http_line_cap"
  | .bareNewline => "nf_http_line_ending"
  | .badRequestLine => "nf_http_request_line"
  | .version => "nf_http_version"
  | .target => "nf_http_target_form"
  | .headerTooLarge => "nf_http_header_bytes"
  | .headerCount => "nf_http_header_count"
  | .badHeader => "nf_http_header_syntax"
  | .host => "nf_http_host"
  | .contentLength => "nf_http_content_length"
  | .conflictingLength => "nf_http_content_length_conflict"
  | .transferEncoding => "nf_http_transfer_encoding"
  | .ambiguousFraming => "nf_http_transfer_encoding_content_length"
  | .bodyTooLarge => "nf_http_body_cap"
  | .chunkSize => "nf_http_chunk_size"
  | .chunkTerminator => "nf_http_chunk_terminator"
  | .trailer => "nf_http_trailer"
  | .unexpectedEOF => "nf_http_unexpected_eof"
  | .bufferTooLarge => "nf_http_buffer_cap"
  | .connectionClosed => "nf_http_connection_closed"
  | .responseUnexpected => "nf_http_response_without_request"
  | .responseStatus => "nf_http_response_status"
  | .responseHeader => "nf_http_response_header"
  | .responseFraming => "nf_http_response_framing"
  | .unsupportedUpgrade => "nf_http_upgrade_unsupported"
  | .state => "nf_http_state"
  | .coreTimeout => "nf_http_core_timeout"
  | .coreBadMessage => "nf_http_core_bad_message"
  | .coreOther message => "nf_http_core_other:" ++ message
  | .actionBudget => "nf_http_action_budget"
  | .head status => "nf_http_head_" ++ toString status
  | .notImplemented => "nf_http_method_not_implemented"
  | .headDisagreement => "nf_http_head_decider_disagreement"

structure Syntax where
  requestLine : Program
  fieldLine : Program
  chunkLine : Program
  contentLength : Program
  host : Program
  token : Program
  origin : Program
  absolute : Program
  authority : Program

def buildSyntax : Except Matcher.Residue Syntax := do
  return ⟨← compile rules "request-line", ← compile rules "field-line", ← compile rules "chunk-line",
    ← compile rules "content-length", ← compile rules "host", ← compile rules "token",
    ← compile rules "origin-form", ← compile rules "absolute-form", ← compile rules "authority-form"⟩

def limitsValid (c : Limits) : Bool :=
  16 <= c.lineBytes && 2 <= c.headerBytes && 0 < c.headerCount &&
  c.lineBytes <= c.bufferBytes && c.headerBytes <= c.bufferBytes && c.bodyBytes <= c.bufferBytes &&
  c.bufferBytes <= 16777216 && c.headerCount <= 65536

inductive Fault where
  | more
  | refused (residue : Residue)
  deriving Repr
abbrev Parser := Except Fault

def reject (r : Residue) : Parser α := .error (.refused r)

def matchesRule (p : Program) (b : ByteArray) (cap : Nat) : Parser Bool :=
  match fullMatch p b cap with
  | .error _ => reject .matcher
  | .ok value => .ok value.isSome

def captures (p : Program) (b : ByteArray) (cap : Nat) (failure : Residue) : Parser (Array Capture) :=
  match fullMatch p b cap with
  | .error _ => reject .matcher
  | .ok none => reject failure
  | .ok (some groups) => .ok groups

def capturedBytes (gs : Array Capture) (name : String) : ByteArray :=
  ((gs.find? (·.name == name)).map (·.value)).getD ByteArray.empty

-- HTTP fields are byte strings. The application String representation lifts
-- each octet to the same code point; response lowering is its checked inverse.
def latin1 (b : ByteArray) : String := String.mk (b.data.toList.map (fun b => Char.ofNat b.toNat))
def octets (s : String) : Option ByteArray :=
  if s.toList.all (fun c => c.toNat <= 255) then
    some (ByteArray.mk (s.toList.map (fun c => UInt8.ofNat c.toNat)).toArray)
  else none

def trimOWS (s : String) : String :=
  String.mk ((s.toList.dropWhile (fun c => c == ' ' || c == '\t')).reverse.dropWhile
    (fun c => c == ' ' || c == '\t')).reverse

def lower (s : String) : String := s.toLower

structure Waiting where
  request : Request
  keepAlive : Bool

-- The machine is initialized on the first event, then its configuration is
-- immutable. It persists across receives and explicit continuation encoding.
abbrev Core := Web.StdHttp.Protocol.H1.Machine .receiving
structure State where
  core : Option Core := none
  limits : Limits := {}
  body : ByteArray := ByteArray.empty
  waiting : Option Waiting := none
  closed : Bool := false
  eof : Bool := false
  completed : Nat := 0

def State.buffer (s : State) : ByteArray := match s.core with
  | none => ByteArray.empty
  | some m => m.reader.input.array.extract m.reader.input.pos m.reader.input.array.size

inductive Event where
  | receive (bytes : ByteArray)
  | respond (response : Response)
  | eof
  | reset

inductive Action where
  | handler (request : Request)
  | send (bytes : ByteArray)
  | close
  | refuse (residue : Residue)

structure Transition where
  state : State
  actions : List Action := []

def requireSome (value : Option α) (cause : Residue) : Except Residue α :=
  match value with | some x => .ok x | none => .error cause

def coreResidue : Web.StdHttp.Protocol.H1.Error → Residue
  | .invalidStatusLine => .badRequestLine
  | .invalidHeader => .badHeader
  | .timeout => .coreTimeout
  | .entityTooLarge => .bodyTooLarge
  | .uriTooLong => .target
  | .unsupportedVersion => .version
  | .invalidChunk => .chunkSize
  | .connectionClosed => .unexpectedEOF
  | .badMessage => .coreBadMessage
  | .tooManyHeaders => .headerCount
  | .headersTooLarge => .headerTooLarge
  | .other message => .coreOther message

def coreConfig (c : Limits) : Web.StdHttp.Protocol.H1.Config :=
  { maxHeaders := c.headerCount, maxHeaderBytes := c.headerBytes,
    maxUriLength := c.lineBytes, maxStartLineLength := c.lineBytes,
    maxHeaderNameLength := c.lineBytes, maxHeaderValueLength := c.lineBytes,
    maxChunkLineLength := c.lineBytes, maxChunkSize := c.bodyBytes,
    maxBodySize := c.bodyBytes, maxTrailerHeaders := c.headerCount }

def coreRequest (m : Core) (body : ByteArray) : Request :=
  let h := m.reader.messageHead
  ⟨toString h.method,toString h.uri,
    h.headers.map.toArray.toList.map (fun (k,v) => ⟨k.value,v.value⟩),body⟩

/-! Card revision 14, condition 1: one decision about a head.

`H1Stream.step` is the proved decider (`web/h1`). It reads the bytes of the
next request before the machine does and its answer is the one in effect:
- no answer yet: the machine is not run on these bytes;
- a refusal: the status is sent and the connection is closed;
- a head: the machine then reads the same bytes, and it must take exactly the
  head's length and arrive at the head's framing. Anything else is
  `headDisagreement` and the connection is closed.
The body is read by the machine, which is not proved. -/

/-- RFC 9112 §2.2 empty lines ignored (the machine's own bound); a head within
one line cap, so no line or field total of an accepted head is over a cap of
the machine; hyper's 100 field lines. -/
def headLimits (c : Limits) : H1Stream.Limits := ⟨8, c.lineBytes, c.bodyBytes, c.headerCount⟩

inductive Gate where
  | wait
  | refuse (status : Nat) (residue : Residue)
  | head (length : Nat) (framing : H1Valid.Framing)

/-- A prefix this long has the decider's answer for the whole input: past
the empty lines there are more bytes than a head may have. -/
def gateWindow (c : Limits) : Nat := c.lineBytes + 2 * 8 + 4

/-- Does a head carry both Content-Length and Transfer-Encoding? RFC 9112 §6.1
lets the server reject such a request and requires the close; no status is
required, and the shared simulator expects none (card: "the shared simulator
is not changed"). Only the choice between 400-then-close and close depends on
this scan; the refusal itself is the decider's. -/
def bothFramings (raw : List Nat) : Bool := Id.run do
  let mut line : List Nat := []
  let mut names : List String := []
  let mut previous := 0
  for b in raw do
    if b == 10 && previous == 13 then
      if line.length ≤ 1 then
        if !names.isEmpty then break
      else names := (String.mk ((line.takeWhile (· != 58)).map Char.ofNat)).toLower :: names
      line := []
    else line := line ++ [b]
    previous := b
  return names.contains "content-length" && names.contains "transfer-encoding"

def gate (c : Limits) (m : Core) : Gate :=
  let input := m.reader.input
  let raw := (input.array.extract input.pos (input.pos + gateWindow c)).toList.map (·.toNat)
  match H1Stream.step (headLimits c) raw with
  | .more => .wait
  | .refuse status => if status == 400 && bothFramings raw then .refuse 0 (.head 400) else .refuse status (.head status)
  | .head skipped length r _ framing =>
    let method := String.mk (r.method.map Char.ofNat)
    -- RFC 9110 §9.1: a method that is not implemented is answered 501. This
    -- server has no tunnel, so CONNECT is one of them.
    if method == "CONNECT" || (Web.StdHttp.Method.ofString? method).isNone then .refuse 501 .notImplemented
    else .head (skipped + length) framing

/-- Where the machine is once it has read a head: its framing of the body. -/
def coreFraming : Web.StdHttp.Protocol.H1.Reader.State .receiving → Option H1Valid.Framing
  | .readBody (.fixed 0) => some .empty
  | .readBody (.fixed n) => some (.length n)
  | .readBody .chunkedSize => some .chunked
  | .«continue» (.readBody (.fixed 0)) => some .empty
  | .«continue» (.readBody (.fixed n)) => some (.length n)
  | .«continue» (.readBody .chunkedSize) => some .chunked
  | _ => none

def sameFraming : H1Valid.Framing → H1Valid.Framing → Bool
  | .empty, .empty | .length 0, .empty | .chunked, .chunked => true
  | .length a, .length b => a == b
  | _, _ => false

def refusalBytes (status : Nat) : ByteArray :=
  let reason := if status == 431 then "Request Header Fields Too Large"
    else if status == 501 then "Not Implemented" else "Bad Request"
  s!"HTTP/1.1 {status} {reason}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".toUTF8

-- Drive the upstream machine until input is needed or one complete request is
-- ready. Each body pull yields bytes or a final marker; the finite action cap
-- bounds corrupted/injected states as well as normal inputs. No framing
-- decision is duplicated here. The upstream parser and writer own those.
def drive (c : Limits) : Nat → State → List Action → Except Residue Transition
  | 0, _, _ => .error .actionBudget
  | fuel+1, s, actions => do
    if s.waiting.isSome || s.closed then return ⟨s,actions⟩
    let m ← match s.core with | none => throw .state | some m => pure m
    -- Deliver completion before a new core step can close a non-persistent
    -- reader. The handler still owes its final response on this connection.
    if m.isReaderComplete then
      let request := coreRequest m s.body
      return ⟨{s with body := ByteArray.empty,waiting := some ⟨request,m.keepAlive⟩},actions ++ [.handler request]⟩
    let gated := if (m.reader.state matches .needStartLine) && m.reader.input.remainingBytes != 0
      then some (gate c m) else none
    if let some .wait := gated then
      if s.eof then throw .unexpectedEOF else return ⟨s,actions⟩
    if let some (.refuse 413 _) := gated then throw .bodyTooLarge
    if let some (.refuse status residue) := gated then
      return ⟨{s with core := none,body := ByteArray.empty,closed := true},
        actions ++ (if status == 0 then [] else [.send (refusalBytes status)]) ++ [.refuse residue,.close]⟩
    let before := m.reader.input.remainingBytes
    let (m,result) := m.step
    if let some (.head length framing) := gated then
      let agrees := m.error.isNone && before - m.reader.input.remainingBytes == length &&
        (match coreFraming m.reader.state with | some f => sameFraming framing f | none => false)
      if !agrees then throw .headDisagreement
    let actions := if result.output.isEmpty then actions else actions ++ [.send result.output.toByteArray]
    if let some error := m.error then throw (coreResidue error)
    if m.isReaderAwaitingContinue then
      drive c fuel {s with core := some (m.canContinue .«continue»)} actions
    else if m.isReaderClosed then
      return ⟨{s with core := some m,closed := true},actions ++ [.close]⟩
    else if m.isReaderComplete then
      let request := coreRequest m s.body
      return ⟨{s with core := some m,body := ByteArray.empty,waiting := some ⟨request,m.keepAlive⟩},actions ++ [.handler request]⟩
    else if m.canPullBody then
      let (m,pulled) := m.pullBody
      if let some error := m.error then throw (coreResidue error)
      match pulled with
      | none =>
        if m.isReaderComplete then drive c fuel {s with core := some m} actions
        else if m.isReaderClosed then return ⟨{s with core := some m,closed := true},actions ++ [.close]⟩
        else return ⟨{s with core := some m},actions⟩
      | some chunk =>
        if s.body.size+chunk.chunk.data.size > c.bodyBytes then throw .bodyTooLarge
        drive c fuel {s with core := some m,body := s.body ++ chunk.chunk.data} actions
    else if s.eof && m.reader.input.remainingBytes == 0 then
      if m.reader.state matches .needStartLine then
        return ⟨{s with core := some m,closed := true},actions ++ [.close]⟩
      else throw .unexpectedEOF
    else return ⟨{s with core := some m},actions⟩

def progress (_sy : Syntax) (c : Limits) (s : State) : Except Residue Transition :=
  drive c (s.buffer.size+4) s []

-- Only handler policy is checked here. Typed headers and the upstream writer
-- produce the start line, Connection and length framing and HEAD suppression.
def responseHead (c : Limits) (w : Waiting) (response : Response) : Except Residue Web.StdHttp.Response.Head := do
  if response.status < 200 || response.status > 599 then throw .responseStatus
  if w.request.method == "CONNECT" && response.status < 300 then throw .unsupportedUpgrade
  if response.body.size > c.bodyBytes then throw .bodyTooLarge
  if (response.status == 204 || response.status == 304) && response.body.size != 0 then throw .responseFraming
  if response.headers.length > c.headerCount then throw .headerCount
  let mut headers := Web.StdHttp.Headers.empty
  for h in response.headers do
    if ["content-length","transfer-encoding","connection","upgrade"].contains (lower h.name) then throw .responseFraming
    let name ← requireSome (Web.StdHttp.Header.Name.ofString? h.name) .responseHeader
    -- ofString? trims surrounding whitespace; do not silently repair a name.
    if name.value != lower h.name then throw .responseHeader
    let value ← requireSome (Web.StdHttp.Header.Value.ofString? h.value) .responseHeader
    -- The typed constructor trims all whitespace; only HTTP OWS may be
    -- trimmed. In particular a leading/trailing CR or LF is an injection.
    if value.value != trimOWS h.value then throw .responseHeader
    if h.name.toUTF8.size+h.value.toUTF8.size+4 > c.lineBytes then throw .responseHeader
    headers := headers.insert name value
  let status ← requireSome (Web.StdHttp.Status.ofCode none response.status.toUInt16) .responseStatus
  let head : Web.StdHttp.Response.Head := {status,headers}
  -- Include the core-owned framing fields when enforcing the output header cap.
  let lengthBytes := if response.status == 204 || response.status == 304 then 0 else
    "Content-Length: ".length + (toString response.body.size).length + 2
  let closeBytes := if w.keepAlive then 0 else "Connection: close\r\n".length
  if (toString head).toUTF8.size + lengthBytes + closeBytes > c.headerBytes then throw .headerTooLarge
  return head

-- q is the full identity preimage, not a hash of only the limits. A receipt
-- codec must encode every field before hashing this value.
structure Identity where
  revision : Nat
  grammar : List Rule
  compiled : Syntax
  limits : Limits
  state : State
  event : Event

def q (sy : Syntax) (c : Limits) (s : State) (e : Event) : Identity :=
  ⟨2, rules, sy, c, s, e⟩

def runNF (sy : Syntax) (c : Limits) (s : State) (e : Event) : Except Residue Transition := do
  if !limitsValid c then throw .configuration
  if s.core.isSome && s.limits != c then throw .configuration
  if s.buffer.size > c.bufferBytes || s.body.size > c.bodyBytes || (s.closed && s.waiting.isSome) then throw .state
  let s := if s.core.isNone then {s with core := some {config := coreConfig c},limits := c} else s
  let m ← requireSome s.core .state
  match e with
  | .reset => return ⟨{s with core := none,body := ByteArray.empty,waiting := none,closed := true},[.close]⟩
  | .receive bytes =>
    if s.closed || s.eof then throw .connectionClosed
    if s.buffer.size+bytes.size > c.bufferBytes then throw .bufferTooLarge
    progress sy c {s with core := some (m.feed bytes)}
  | .eof =>
    if s.closed then throw .connectionClosed
    progress sy c {s with core := some m.noMoreInput,eof := true}
  | .respond response =>
    if s.closed then throw .connectionClosed
    let waiting ← requireSome s.waiting .responseUnexpected
    let head ← responseHead c waiting response
    -- A zero-length fixed body has no queued chunks. The core deliberately
    -- rejects a nonempty producer queue at fixed length zero.
    let chunks := if response.body.isEmpty then #[] else #[Web.StdHttp.Chunk.ofByteArray response.body]
    let m := ((m.setKnownSize (.fixed response.body.size)).send head).sendData chunks
    -- The next request's bytes are kept from the machine while it finishes this
    -- response: `drive` shows them to the decider first.
    let reader := m.reader
    let m := {m with reader := {reader with input := ByteArray.empty.iter,noMoreInput := false}}
    let (m,result) := m.userClosedBody.step
    let m := {m with reader := {m.reader with input := reader.input,noMoreInput := reader.noMoreInput}}
    if let some error := m.error then throw (coreResidue error)
    let next := {s with core := some m,waiting := none,completed := s.completed+1}
    let actions := if result.output.isEmpty then [] else [.send result.output.toByteArray]
    if !waiting.keepAlive || m.isReaderClosed || m.writer.isClosed then
      return ⟨{next with core := none,body := ByteArray.empty,closed := true},actions ++ [.close]⟩
    match drive c (next.buffer.size+4) next actions with
    | .ok transition => return transition
    | .error r => return ⟨{next with core := none,body := ByteArray.empty,closed := true},actions ++ [.refuse r,.close]⟩

-- NF-CORRECT-0 r2: the checked decision; runNF retains the original
-- transition and its failure-state observations for existing callers.
def admit (observation : Identity) : Except Residue Transition :=
  runNF observation.compiled observation.limits observation.state observation.event

def decide (sy : Syntax) (c : Limits) (s : State) (e : Event) : Except Residue Transition :=
  runNF sy c s e

def residue? (sy : Syntax) (c : Limits) (s : State) (e : Event) : Option Residue :=
  match runNF sy c s e with | .error r => some r | .ok _ => none

def admissible (sy : Syntax) (c : Limits) (s : State) (e : Event) : Prop := ∃ t, runNF sy c s e = .ok t

end Web.Http
