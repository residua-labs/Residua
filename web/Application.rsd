import Lean

namespace Web

structure Header where
  name : String
  value : String
  deriving BEq, Repr

structure Request where
  method : String
  target : String
  headers : List Header := []
  body : ByteArray := ByteArray.empty

structure Response where
  status : Nat
  headers : List Header := []
  body : ByteArray := ByteArray.empty

abbrev Handler := Request → Response
abbrev Middleware := Handler → Handler

def identityMiddleware : Middleware := fun handler => handler

-- Outer sees the request first and the response last.
def compose (outer inner : Middleware) : Middleware :=
  fun handler => outer (inner handler)

def appendHeader (header : Header) : Middleware := fun handler request =>
  let response := handler request
  { response with headers := response.headers ++ [header] }

def textResponse (status : Nat) (text : String) : Response :=
  { status, headers := [⟨"content-type", "text/plain; charset=utf-8"⟩], body := text.toUTF8 }

-- Transport framing (including HEAD body suppression) belongs to the protocol core.
def hello : Handler := fun _ => textResponse 200 "Hello, world!\n"

structure Asset where
  target : String
  contentType : String
  body : ByteArray

-- Assets are supplied by the execution layer at startup. No target becomes an
-- OS path. Percent escapes are not decoded, and lookup is exact and case-sensitive.
def staticFile (assets : List Asset) : Handler := fun request =>
  match assets.find? (fun asset => asset.target == request.target) with
  | none => textResponse 404 "Not found\n"
  | some asset =>
      { status := 200, headers := [⟨"content-type", asset.contentType⟩], body := asset.body }

-- Shared JSON request checks; `render` produces the response body from the
-- request and its parsed value.
def jsonHandler (render : Request → Lean.Json → Option ByteArray) (maxBytes : Nat) : Handler :=
  fun request =>
  if request.body.size > maxBytes then textResponse 413 "Body too large\n"
  else
    match String.fromUTF8? request.body with
    | none => textResponse 400 "Invalid UTF-8\n"
    | some text =>
        match Lean.Json.parse text with
        | .error _ => textResponse 400 "Invalid JSON\n"
        | .ok json =>
            match render request json with
            | none => textResponse 400 "Invalid JSON\n"
            | some body => { status := 200, headers := [⟨"content-type", "application/json"⟩], body }

def jsonEcho : Nat → Handler :=
  jsonHandler fun request _ => let body := request.body; some body

def methodNotAllowed (allowed : String) : Response :=
  let response := textResponse 405 "Method not allowed\n"
  { response with headers := response.headers ++ [⟨"allow", allowed⟩] }

-- This example application uses origin-form targets. Query is not part of asset
-- lookup. Fragments, absolute-form and authority-form are protocol concerns.
-- Compact rendering with object keys in ascending code-point order (the order of
-- UTF-8 bytes). Nesting depth is below the body size, so that size bounds the fuel.
def canonicalJson : Nat → Lean.Json → Option String
  | 0, _ => none
  | n+1, .arr xs => do
      let parts ← xs.toList.mapM (canonicalJson n)
      pure ("[" ++ ",".intercalate parts ++ "]")
  | n+1, .obj kvs => do
      let fields := kvs.fold (fun acc k v => acc.push (k, v)) (#[] : Array (String × Lean.Json))
      let parts ← fields.toList.mapM fun (k, v) => do
        pure ((Lean.Json.str k).compress ++ ":" ++ (← canonicalJson n v))
      pure ("{" ++ ",".intercalate parts ++ "}")
  | _+1, json => some json.compress

def jsonReserialise : Nat → Handler :=
  jsonHandler fun request json => (canonicalJson (request.body.size + 1) json).map String.toUTF8

def routes (echo : Handler) (assets : List Asset) : Handler := fun request =>
  let target := (request.target.splitOn "?").head!
  let routed := { request with target }
  if target == "/hello" then
    if request.method == "GET" || request.method == "HEAD" then hello routed
    else methodNotAllowed "GET, HEAD"
  else if target == "/echo" then
    if request.method == "POST" then echo routed
    else methodNotAllowed "POST"
  else if request.method == "GET" || request.method == "HEAD" then staticFile assets routed
  else methodNotAllowed "GET, HEAD"

def application (assets : List Asset) (maxJsonBytes : Nat) : Handler :=
  routes (jsonEcho maxJsonBytes) assets

-- P2-WEB-0 workload: echo parses the body and serialises it again.
def workloadApplication (assets : List Asset) (maxJsonBytes : Nat) : Handler :=
  routes (jsonReserialise maxJsonBytes) assets

end Web
