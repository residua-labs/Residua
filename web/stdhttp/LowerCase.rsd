/-!
# LowerCase

This module provides predicates and normalization functions for handling ASCII case-insensitivity.
It includes proofs of idempotency for lowercase transformations, as well as utilities for validating
the lowercase state of a String.
-/

namespace Web.StdHttp.Internal
private theorem lower_nat (c : Char) (h : 65 ≤ c.toNat ∧ c.toNat ≤ 90) :
    (Char.ofNat (c.toNat + 32)).toNat = c.toNat + 32 := by
  have valid : (c.toNat + 32).isValidChar := Or.inl (by omega)
  unfold Char.ofNat
  rw [dif_pos valid]
  rfl
private theorem Char.toLower_eq_self_iff {c : Char} : c.toLower = c ↔ c.isUpper = false := by
  have upper : c.isUpper = decide (65 ≤ c.toNat ∧ c.toNat ≤ 90) := by
    simp only [Char.isUpper, Bool.and_eq_decide]
    rfl
  rw [upper]
  by_cases h : 65 ≤ c.toNat ∧ c.toNat ≤ 90
  · have neq : Char.ofNat (c.toNat + 32) ≠ c := by
      intro eq
      have hn := congrArg Char.toNat eq
      rw [lower_nat c h] at hn
      omega
    simp [Char.toLower, h, neq]
  · simp [Char.toLower, h]
def lower (s : String) : String := ⟨s.toList.map Char.toLower⟩
def IsLowerCase (s : String) : Prop := lower s = s
private theorem lower_eq_self {s : String} : lower s = s ↔ s.toList.any Char.isUpper = false := by
  cases s with
  | mk cs =>
    change String.mk (cs.map Char.toLower) = String.mk cs ↔ cs.any Char.isUpper = false
    have eq : String.mk (cs.map Char.toLower) = String.mk cs ↔ cs.map Char.toLower = cs :=
      ⟨fun h => congrArg String.data h, fun h => congrArg String.mk h⟩
    rw [eq]
    clear eq
    induction cs with
    | nil => simp
    | cons c cs ih =>
      simp only [List.map_cons, List.cons.injEq, List.any_cons, Bool.or_eq_false_iff, Char.toLower_eq_self_iff, ih]
instance : Decidable (IsLowerCase s) :=
 decidable_of_decidable_of_iff (p := s.toList.any Char.isUpper = false) lower_eq_self.symm
private theorem Char.toLower_idempotent (c : Char) : c.toLower.toLower = c.toLower := by
  by_cases h : 65 ≤ c.toNat ∧ c.toNat ≤ 90
  · have hn := lower_nat c h
    have outside : ¬(65 ≤ (Char.ofNat (c.toNat + 32)).toNat ∧
        (Char.ofNat (c.toNat + 32)).toNat ≤ 90) := by omega
    simp only [Char.toLower, if_pos h, if_neg outside]
  · simp [Char.toLower, h]

theorem IsLowerCase.isLowerCase_toLower {s : String} : IsLowerCase (lower s) := by
  cases s with
  | mk cs =>
    change String.mk ((cs.map Char.toLower).map Char.toLower) = String.mk (cs.map Char.toLower)
    congr 1
    simp only [List.map_map, Function.comp_def, Char.toLower_idempotent]

theorem IsLowerCase.isLowerCase_empty : IsLowerCase "" := rfl


end Web.StdHttp.Internal
