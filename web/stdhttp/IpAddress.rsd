/- Lean address representation port: Copyright (c) 2025 Lean FRO, LLC.
Apache-2.0; Authors: Henrik Böving. See LICENSE. Algorithms: libuv v1.51.0
src/inet.c (ISC above); offsets into C buffers become indices into pure arrays.
No network or OS operation is performed. -/
namespace Web.StdHttp.Net

structure IPv4Addr where
  octets : Array UInt8
  octets_size : octets.size = 4
  deriving DecidableEq
instance : Inhabited IPv4Addr := ⟨⟨#[0,0,0,0],rfl⟩⟩
structure IPv6Addr where
  segments : Array UInt16
  segments_size : segments.size = 8
  deriving DecidableEq
instance : Inhabited IPv6Addr := ⟨⟨#[0,0,0,0,0,0,0,0],rfl⟩⟩

private def cBytes (s : String) : Array UInt8 :=
  (s.toUTF8.data.toList.takeWhile (· != 0)).toArray

/-- libuv inet_pton4: saw_digit, octets, and current byte are carried explicitly. -/
private def pton4 (src : Array UInt8) : Option (Array UInt8) := Id.run do
  let mut sawDigit := false
  let mut octets := 0
  let mut tp := 0
  let mut tmp : Array UInt8 := #[0,0,0,0]
  for ch in src do
    if ch >= 48 && ch <= 57 then
      let nw := tmp[tp]!.toNat * 10 + (ch.toNat - 48)
      if sawDigit && tmp[tp]! == 0 then return none
      if nw > 255 then return none
      tmp := tmp.set! tp (UInt8.ofNat nw)
      if !sawDigit then
        octets := octets + 1
        if octets > 4 then return none
        sawDigit := true
    else if ch == 46 && sawDigit then
      if octets == 4 then return none
      tp := tp + 1
      tmp := tmp.set! tp 0
      sawDigit := false
    else return none
  if octets < 4 then return none
  return some tmp

namespace IPv4Addr

def ofParts (a b c d : UInt8) : IPv4Addr := ⟨#[a,b,c,d],rfl⟩
def ofString (s : String) : Option IPv4Addr := do
  if s.toUTF8.data.any (· == 0) then none else do
    let bytes ← pton4 (cBytes s)
    if h : bytes.size = 4 then some ⟨bytes,h⟩ else none
/-- libuv inet_ntop4 decimal formatting. -/
def toString (addr : IPv4Addr) : String :=
  String.intercalate "." (addr.octets.toList.map (fun b => ToString.toString b.toNat))
instance : ToString IPv4Addr := ⟨toString⟩
end IPv4Addr

private def hexValue (ch : UInt8) : Option Nat :=
  if ch >= 48 && ch <= 57 then some (ch.toNat-48)
  else if ch >= 97 && ch <= 102 then some (ch.toNat-97+10)
  else if ch >= 65 && ch <= 70 then some (ch.toNat-65+10)
  else none

/-- libuv inet_pton6, including trailing embedded IPv4 and in-place expansion
of the single compression hole. Index bounds mirror its endp checks. -/
private def pton6 (src : Array UInt8) : Option (Array UInt8) := Id.run do
  let mut tmp : Array UInt8 := mkArray 16 0
  let mut tp := 0
  let mut colonp : Option Nat := none
  let mut i := 0
  if src[0]?.getD 0 == 58 then
    i := 1
    if src[i]?.getD 0 != 58 then return none
  let mut curtok := i
  let mut seenDigits := 0
  let mut val := 0
  let mut dotted := false
  while i < src.size && !dotted do
    let ch := src[i]!
    i := i+1
    if let some digit := hexValue ch then
      val := val * 16 + digit
      seenDigits := seenDigits+1
      if seenDigits > 4 then return none
    else if ch == 58 then
      curtok := i
      if seenDigits == 0 then
        if colonp.isSome then return none
        colonp := some tp
      else
        if i == src.size then return none
        if tp+2 > 16 then return none
        tmp := tmp.set! tp (UInt8.ofNat (val/256))
        tmp := tmp.set! (tp+1) (UInt8.ofNat val)
        tp := tp+2
        seenDigits := 0
        val := 0
    else if ch == 46 && tp+4 <= 16 then
      let some tail := pton4 (src.extract curtok src.size) | return none
      for j in [0:4] do tmp := tmp.set! (tp+j) tail[j]!
      tp := tp+4
      seenDigits := 0
      dotted := true
    else return none
  if seenDigits != 0 then
    if tp+2 > 16 then return none
    tmp := tmp.set! tp (UInt8.ofNat (val/256))
    tmp := tmp.set! (tp+1) (UInt8.ofNat val)
    tp := tp+2
  if let some hole := colonp then
    let n := tp-hole
    if tp == 16 then return none
    for offset in [1:n+1] do
      tmp := tmp.set! (16-offset) tmp[hole+n-offset]!
      tmp := tmp.set! (hole+n-offset) 0
    tp := 16
  if tp != 16 then return none
  return some tmp

private def wordHex (n : Nat) : String :=
  let digits := "0123456789abcdef".toList
  let cs := ([12,8,4,0].map fun shift => digits[(n / 2^shift) % 16]!).dropWhile (· == '0')
  if cs.isEmpty then "0" else ⟨cs⟩

namespace IPv6Addr

def ofParts (a b c d e f g h : UInt16) : IPv6Addr := ⟨#[a,b,c,d,e,f,g,h],rfl⟩
def ofString (s : String) : Option IPv6Addr := do
  if s.toUTF8.data.any (· == 0) then none else do
    let bytes := cBytes s
    -- uv_inet_pton removes a zone suffix, bounded by its 46-byte temporary buffer.
    let zone := bytes.toList.findIdx? (· == 37)
    let bytes ← match zone with
      | some pos => if pos > 45 then none else some (bytes.extract 0 pos)
      | none => some bytes
    let bytes ← pton6 bytes
    let words := (List.range 8).toArray.map fun i =>
      UInt16.ofNat (bytes[2*i]!.toNat * 256 + bytes[2*i+1]!.toNat)
    if h : words.size = 8 then some ⟨words,h⟩ else none

/-- libuv inet_ntop6: first longest zero run, then optional IPv4 encapsulation. -/
def toString (addr : IPv6Addr) : String := Id.run do
  let words := addr.segments
  let mut bestBase : Option Nat := none
  let mut bestLen := 0
  let mut curBase : Option Nat := none
  let mut curLen := 0
  for i in [0:8] do
    if words[i]! == 0 then
      if curBase.isNone then
        curBase := some i
        curLen := 1
      else curLen := curLen+1
    else if curBase.isSome then
      if bestBase.isNone || curLen > bestLen then
        bestBase := curBase
        bestLen := curLen
      curBase := none
  if curBase.isSome then
    if bestBase.isNone || curLen > bestLen then
      bestBase := curBase
      bestLen := curLen
  if bestBase.isSome && bestLen < 2 then bestBase := none
  let mut out := ""
  let mut dotted := false
  for i in [0:8] do
    if !dotted then
      if bestBase.isSome && i >= bestBase.getD 0 && i < bestBase.getD 0+bestLen then
        if i == bestBase.getD 0 then out := out ++ ":"
      else
        if i != 0 then out := out ++ ":"
        if i == 6 && bestBase == some 0 &&
            (bestLen == 6 || (bestLen == 7 && words[7]! != 1) ||
              (bestLen == 5 && words[5]! == 65535)) then
          let v4 := IPv4Addr.ofParts (UInt8.ofNat (words[6]!.toNat/256))
            (UInt8.ofNat words[6]!.toNat) (UInt8.ofNat (words[7]!.toNat/256))
            (UInt8.ofNat words[7]!.toNat)
          out := out ++ v4.toString
          dotted := true
        else out := out ++ wordHex words[i]!.toNat
  if bestBase.isSome && bestBase.getD 0+bestLen == 8 then out := out ++ ":"
  return out
instance : ToString IPv6Addr := ⟨toString⟩
end IPv6Addr
end Web.StdHttp.Net
