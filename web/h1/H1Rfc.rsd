/-!
# The heads this server accepts: RFC 9112 with the server's bounds

`H1Valid.ValidHead` is h5i's policy, which is narrower than RFC 9112 in
places. `RfcHead` is the accept set of card revisions 13 and 14 (Q12 (c)):
the same grammar, widened where RFC 9112 asks a server to accept, with the
field bound a parameter.

- request-target: origin-form (§3.2.1); absolute-form with the `http`
  scheme (§3.2.2, "a server MUST accept the absolute-form"); `*` with
  OPTIONS only (§3.2.4); authority-form with CONNECT only (§3.2.3).
- trailing OWS after a `Content-Length` or `Transfer-Encoding` value: it is
  not part of the value (§5, RFC 9110 §5.5), so it is not a reason to refuse.
- at most `mf` field lines instead of 16.

Kept from `ValidHead`: one `Host` on HTTP/1.1 and never two (§3.2, 400);
one `Content-Length`; `Transfer-Encoding` is `chunked` alone, on HTTP/1.1,
and never with `Content-Length` (§6.1, §6.3).

`decide` reads a head back from bytes and returns it exactly when it is an
`RfcHead` (`decide_sound`, `decide_complete`); otherwise a status.
The empty lines before a request line (§2.2) are not part of a head; they
are a step of their own in `H1Stream.rsd`.
-/
namespace H1Rfc
open H1Valid H1Valid.Decide

/-! ## Targets -/

/-- `uri-host [ ":" port ]` with a host that is not empty (RFC 9110 §4.2.1:
an `http` URI with an empty host is invalid). -/
def authority (a : List Nat) : Prop := hostValue a ∧ a ≠ [] ∧ a.head? ≠ some 58

def notPathStart (b : Nat) : Bool := b != 47 && b != 63

/-- What follows the authority: nothing, a path with an optional query, or
a query alone (`path-abempty [ "?" query ]`, RFC 3986 §3). -/
def afterAuthority (p : List Nat) : Prop := p = [] ∨ originForm p ∨ (p.head? = some 63 ∧ query p.tail)

/-- `absolute-form` (RFC 9112 §3.2.2) for `http`: the scheme and `://`,
case ignored (RFC 3986 §3.1); the authority, which "is terminated by the next
slash, question mark ... or by the end of the URI" (RFC 3986 §3.2); the rest. -/
def absoluteForm (t : List Nat) : Prop :=
  named (t.take 7) "http://" = true ∧ authority ((t.drop 7).takeWhile notPathStart) ∧
  afterAuthority ((t.drop 7).dropWhile notPathStart)

/-- `authority-form = uri-host ":" port` (§3.2.3), the port not empty: the
target splits at some `:` into a host and digits. -/
def authorityForm (t : List Nat) : Prop :=
  ∃ k, k < t.length ∧ t.getD k 0 = 58 ∧ t.take k ≠ [] ∧ (regName (t.take k) ∨ ipLiteral (t.take k)) ∧
    t.drop (k + 1) ≠ [] ∧ (t.drop (k + 1)).all isDigit = true

/-- The four forms of §3.2, each with the methods it is for. -/
def targetOk (r : RequestLine) : Prop :=
  originForm r.target ∨ absoluteForm r.target ∨ (r.target = [42] ∧ r.method = ascii "OPTIONS") ∨
  (r.method = ascii "CONNECT" ∧ authorityForm r.target)

/-- The host a request is for: the target's when it has one ("the origin
server MUST ignore the received Host header field", §3.2.2), else `Host`'s. -/
def effectiveHost (r : RequestLine) (fs : List FieldLine) : List Nat :=
  if named (r.target.take 7) "http://" then (r.target.drop 7).takeWhile notPathStart
  else match fs.find? isHost with
    | some f => f.value
    | none => []

/-! ## The heads -/

/-- `H` is the head `r`, `fs`, and one this server accepts with limits `mh`
(head bytes), `mb` (body bytes) and `mf` (field lines). -/
def RfcHead (mh mb mf : Nat) (H : List Nat) (r : RequestLine) (fs : List FieldLine) : Prop :=
  H = headBytes r fs ∧ H.length ≤ mh ∧
  r.method ≠ [] ∧ r.method.all tchar = true ∧ targetOk r ∧ (r.minor = 0 ∨ r.minor = 1) ∧
  (∀ f ∈ fs, f.ok) ∧ fs.length ≤ mf ∧
  (fs.filter isHost).length ≤ 1 ∧ (r.minor = 1 → (fs.filter isHost).length = 1) ∧
  (∀ f ∈ fs, isHost f = true → hostValue f.value) ∧
  (fs.filter isContentLength).length ≤ 1 ∧
  (∀ f ∈ fs, isContentLength f = true → f.value ≠ [] ∧ f.value.all isDigit = true ∧ decimal f.value ≤ mb) ∧
  (fs.filter isTransferEncoding).length ≤ 1 ∧
  (∀ f ∈ fs, isTransferEncoding f = true → named f.value "chunked" = true ∧ r.minor = 1) ∧
  ¬ (fs.any isContentLength = true ∧ fs.any isTransferEncoding = true)

/-- Every head h5i accepts is one this server accepts, when its field bound
is at least h5i's 16. -/
instance (a : List Nat) : Decidable (authority a) := by unfold authority; infer_instance
instance (p : List Nat) : Decidable (afterAuthority p) := by unfold afterAuthority query; infer_instance
instance (t : List Nat) : Decidable (absoluteForm t) := by unfold absoluteForm; infer_instance
instance (t : List Nat) : Decidable (authorityForm t) := by unfold authorityForm; infer_instance
instance (r : RequestLine) : Decidable (targetOk r) := by unfold targetOk; infer_instance
instance (mh mb mf : Nat) (H : List Nat) (r : RequestLine) (fs : List FieldLine) :
    Decidable (RfcHead mh mb mf H r fs) := by unfold RfcHead; infer_instance

/-- The parts of `l` between commas. -/
def commaParts : List Nat → List Nat → List (List Nat)
  | cur, [] => [cur.reverse]
  | cur, b :: t => if b = 44 then cur.reverse :: commaParts [] t else commaParts (b :: cur) t

/-- The codings of the `Transfer-Encoding` lines, in order, lowercased
(RFC 9110 §5.3: several lines are one list; §5.6.1: OWS around elements). -/
def codings (fs : List FieldLine) : List (List Nat) :=
  ((fs.filter isTransferEncoding).map (fun f =>
    (commaParts [] f.value).map (fun c => ((c.dropWhile isWs).reverse.dropWhile isWs).reverse.map lc))).flatten

/-- The status for bytes that are not an `RfcHead`.
431: more than `mh` bytes or `mf` field lines (RFC 6585 §5; hyper answers a head over its limits so).
501: a transfer coding this server does not implement, with `chunked` last (RFC 9112 §6.1).
413: a `Content-Length` of digits over `mb` (RFC 9110 §15.5.14).
400: everything else. -/
def refusal (mh mb mf : Nat) (H : List Nat) : Nat :=
  if mh < H.length then 431
  else match split H with
    | none => 400
    | some (r, fs) =>
      if mf < fs.length then 431
      else if fs.any (fun f => isContentLength f && f.value.all isDigit && Nat.blt mb (decimal f.value)) then 413
      else if r.minor = 1 ∧ fs.any isContentLength = false ∧ 2 ≤ (codings fs).length ∧
          (codings fs).getLast? = some (ascii "chunked") ∧ ¬ (ascii "chunked") ∈ (codings fs).dropLast then 501
      else 400

/-- The decider: the head read back from `H` when it is an `RfcHead`, else a status. -/
def decide (mh mb mf : Nat) (H : List Nat) : Except Nat (RequestLine × List FieldLine) :=
  match split H with
  | none => .error (refusal mh mb mf H)
  | some (r, fs) => if RfcHead mh mb mf H r fs then .ok (r, fs) else .error (refusal mh mb mf H)

end H1Rfc
